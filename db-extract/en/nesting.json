                    {
                        "sense_id": "6e47c10d-abe6-3d71-8b1a-42fea6d1d070",
                        "entry_id": "e411452f-e9ed-3a1b-b383-45a6ba240586",
                        "glosses": [
                            "An arrangement by which one thing is nested inside another."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7c4b8e02-f5a2-4b20-a33e-2245d6bc38a4",
                                "sense_id": "6e47c10d-abe6-3d71-8b1a-42fea6d1d070",
                                "text": "the nesting of Russian dolls"
                            }
                        ]
                    },
                    {
                        "sense_id": "600dc291-69b4-301f-b68e-0ad9714d5b6b",
                        "entry_id": "e411452f-e9ed-3a1b-b383-45a6ba240586",
                        "glosses": [
                            "The enclosure of one self-contained element of code inside another."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9f09c258-417c-47a1-8fb2-ad956d3a7b15",
                                "sense_id": "600dc291-69b4-301f-b68e-0ad9714d5b6b",
                                "text": "The positioning of a control structure inside another control structure is called nesting e.g. nested-IF and nested-loop."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f63d360f-9ea3-469d-b67f-25a38b3852d2",
                        "source_entry_id": "e411452f-e9ed-3a1b-b383-45a6ba240586",
                        "source_sense_description": "the process by which a bird nests",
                        "target_lang_word": "nidification",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nidification",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c5c97ac1-08e7-38b5-a9ff-d0dc384b600a",
                                        "entry_id": "9f12ed2c-5989-3234-91d9-ee8ae438146a",
                                        "glosses": [
                                            "Construction du nid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9ced67d-96aa-43fe-a59a-bb7f1568f629",
                                                "sense_id": "c5c97ac1-08e7-38b5-a9ff-d0dc384b600a",
                                                "text": "Si tous les Oiseaux n’emploient pas le même art dans l’acte de la nidification, tous par conséquent ne doivent pas donner à leur ouvrage la même forme."
                                            },
                                            {
                                                "example_id": "2439fd4b-42da-4d18-a87d-57d56eff2b2f",
                                                "sense_id": "c5c97ac1-08e7-38b5-a9ff-d0dc384b600a",
                                                "text": "En laboratoire, les scientifiques leur ont présenté deux matériaux de nidification : des cordelettes de coton souples et fragiles ou une variété beaucoup plus rigide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c82f9dbd-08f3-30c6-9504-1c1c9e1f01ca",
                                        "entry_id": "9f12ed2c-5989-3234-91d9-ee8ae438146a",
                                        "glosses": [
                                            "Incubation, couvaison, période pendant laquelle les oiseaux couvent leurs œufs."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3faffa1b-b6aa-426c-88d4-f671129b2289",
                                                "sense_id": "c82f9dbd-08f3-30c6-9504-1c1c9e1f01ca",
                                                "text": "En période de nidification, l’élevage conservatoire d’outardes canepetières à Zoodyssée à Villiers-en-Bois, dans les Deux-Sèvres, ne doit en aucun cas être dérangé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e236a55a-ac77-3917-9c98-0daa1e9f2bd9",
                                        "entry_id": "9f12ed2c-5989-3234-91d9-ee8ae438146a",
                                        "glosses": [
                                            "Lieu où les oiseaux nidifient."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "553f3090-ace4-4bfa-9c2c-9cd67f7ad9f4",
                                                "sense_id": "e236a55a-ac77-3917-9c98-0daa1e9f2bd9",
                                                "text": "[…]: les espèces d’oiseaux d’eau gibier et les poissons trouvent tour à tour dans les roselières des zones de nidification, de refuge et d’alimentation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
