                "senses": [
                    {
                        "sense_id": "06069f19-b3fd-3fc8-89c8-37a578c1eb18",
                        "entry_id": "5efe6052-f78a-395c-a8af-38c1955c8166",
                        "glosses": [
                            "Perle."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "4c52d493-79f1-4bd7-a725-f3337fd75257",
                                "sense_id": "06069f19-b3fd-3fc8-89c8-37a578c1eb18",
                                "text": "[…], quand une nuit v’là l’Dudule qui rapplique, les fouilles pleines de fafiots et d’perlouses, qui pose tout ça d’ssus l’plume et qui m’regarde."
                            },
                            {
                                "example_id": "60c00e91-6979-4987-859d-27c0c1a3aac5",
                                "sense_id": "06069f19-b3fd-3fc8-89c8-37a578c1eb18",
                                "text": "En tout cas, nous avons travaillé pour lui, on a lavé des perlouses et que sais-je, moi ! Alors, il faudra qu'il nous aboule notre part de pognon !"
                            },
                            {
                                "example_id": "8ecb7a27-c471-4583-b822-e31c24455495",
                                "sense_id": "06069f19-b3fd-3fc8-89c8-37a578c1eb18",
                                "text": "J’étais rencardé sur un boulot plutôt pépère\nTrois kilos de diams de la perlouse et puis du jonc\nC’est pas si souvent que l’on dégote une bonne affaire\nCe soir entre tous fallait pas faire les cornichons"
                            },
                            {
                                "example_id": "dae239f4-9612-4ec9-84b4-017e26a41989",
                                "sense_id": "06069f19-b3fd-3fc8-89c8-37a578c1eb18",
                                "text": "Ouf, pas besoin de compléter la panoplie avec le vison et des perlouses !"
                            }
                        ]
                    },
                    {
                        "sense_id": "0c7ffed4-667c-383e-95ae-a58a4b5340dd",
                        "entry_id": "5efe6052-f78a-395c-a8af-38c1955c8166",
                        "glosses": [
                            "Pet."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "342b8ccc-3705-4539-9807-3af838e4108e",
                                "sense_id": "0c7ffed4-667c-383e-95ae-a58a4b5340dd",
                                "text": "Je m’en suis aperçu, lorsque le gros tas sous les berlues, a lâché une vigoureuse perlouse, un pet sec et sans bavure."
                            }
                        ]
                    }
