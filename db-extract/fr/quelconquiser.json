                "senses": [
                    {
                        "sense_id": "35e9e2be-18b8-3372-ba7d-88135a6ae836",
                        "entry_id": "6a7322c0-caaa-3aa9-ae0e-3795c16fdad8",
                        "glosses": [
                            "Donner un caractère quelconque à."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "c4798c2d-7c99-49a6-90af-3a1ea6ce3bce",
                                "sense_id": "35e9e2be-18b8-3372-ba7d-88135a6ae836",
                                "text": "Je n'ai pas parlé de quelconquiser les pièces en question, j'ai dit que peut-être nervurer les feuilles serait un fignolage superfaitatoire."
                            },
                            {
                                "example_id": "b6707d38-e8cb-406a-a33b-99db3f4e9e97",
                                "sense_id": "35e9e2be-18b8-3372-ba7d-88135a6ae836",
                                "text": "D'ailleurs à l'époque de GGG j'avais opéré une critique similaire pour GOT7, qu'on avait vu passé dans WIN et qui me semblait \"quelconquisé\""
                            },
                            {
                                "example_id": "477163ec-cba8-4cc8-9e70-42e296467a48",
                                "sense_id": "35e9e2be-18b8-3372-ba7d-88135a6ae836",
                                "text": "Non non... normaliser comme qui dirait \"quelconquiser\" ..."
                            }
                        ]
                    }
