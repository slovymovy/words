        "fr-extract.jsonl": [
            {
                "entry_id": "298e97ab-49d2-35f4-a11d-19efc83ad1e0",
                "word": "imprécation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "239433e3-d287-43ac-badc-638935d0bccd",
                        "entry_id": "298e97ab-49d2-35f4-a11d-19efc83ad1e0",
                        "tags": [
                            "plural"
                        ],
                        "form": "imprécations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5ba33cb9-32c5-3f7c-8e08-a0881be84742",
                        "entry_id": "298e97ab-49d2-35f4-a11d-19efc83ad1e0",
                        "glosses": [
                            "Souhait de malheurs qu’on fait contre quelqu’un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2217e493-8e12-41dd-bedd-d27149cc57cb",
                                "sense_id": "5ba33cb9-32c5-3f7c-8e08-a0881be84742",
                                "text": "[…] et je m’assis, rêvant à quoi ? à cette pauvre reine que j’avais vue si belle, si heureuse, si aimée ; qui, la veille, poursuivie des imprécations de tout un peuple, avait été conduite en charrette à l’échafaud."
                            },
                            {
                                "example_id": "b408cf98-d320-48a7-988b-8461b679cca6",
                                "sense_id": "5ba33cb9-32c5-3f7c-8e08-a0881be84742",
                                "text": "La Moussotte ne se connaissait plus ; elle en oublia de se peigner, cassa de la vaisselle et se répandit par tout le village en imprécations dont l’énergie ne cédait en rien à celle des prophètes de la Bible."
                            },
                            {
                                "example_id": "f47ab645-2f1d-4bdc-a0e0-e2f40135e223",
                                "sense_id": "5ba33cb9-32c5-3f7c-8e08-a0881be84742",
                                "text": "Henri eut un petit rire. Il se souvint tout à coup d’une vieille chronique où il avait, pour flétrir, stigmatiser, juvénaliser les comportements bourgeois, accumulé des bataillons d’imprécations pétaradantes, de prosopopées incendiaires, d’antithèses fulgurantes."
                            },
                            {
                                "example_id": "1fc9fb06-0e51-40a7-b672-dcf2d7d87d32",
                                "sense_id": "5ba33cb9-32c5-3f7c-8e08-a0881be84742",
                                "text": "Nous voici devisant avec des Montalbanais de toutes sortes, gens fins et subtils, très avertis du fléau dont nous recherchons les causes, le dénonçant, le déplorant même, le vitupérant, le décrivant, l’analysant, l’exécrant, l’accablant d’imprécations, mais s’en tenant là."
                            },
                            {
                                "example_id": "9ba4ec98-5669-4f79-83a7-46f34e386806",
                                "sense_id": "5ba33cb9-32c5-3f7c-8e08-a0881be84742",
                                "text": "Elle était envoyée chez le proviseur presque aussi souvent que Dan Swansea, à cause de sa propension à siffler des imprécations du genre : « Tu mourras en enfer, sodomite » aux filles qui roulaient des patins à leurs copains dans les couloirs."
                            }
                        ]
                    },
                    {
                        "sense_id": "ffafc2e5-6cba-321b-be55-b74544de7c53",
                        "entry_id": "298e97ab-49d2-35f4-a11d-19efc83ad1e0",
                        "glosses": [
                            "Figure par laquelle on souhaite des malheurs à celui dont on parle ou à qui l’on parle."
                        ],
                        "tags": [
                            "especially",
                            "rhetoric"
                        ],
                        "examples": [
                            {
                                "example_id": "27def5ed-290f-4cd3-a601-4579a282c9a8",
                                "sense_id": "ffafc2e5-6cba-321b-be55-b74544de7c53",
                                "text": "Florence tournait définitivement le dos aux imprécations des savonaroles au petit pied. Elle renouait avec les cérémonies, avec la magnificence, avec la vie."
                            }
                        ]
                    },
                    {
                        "sense_id": "4a0b47c4-9955-3b3f-8c25-3848e6df3358",
                        "entry_id": "298e97ab-49d2-35f4-a11d-19efc83ad1e0",
                        "glosses": [
                            "Prière solennelle faite contre quelqu’un pour attirer sur lui la vengeance, la punition divine."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3fb0519f-facf-4888-9d06-0aad95cc6b9a",
                        "source_entry_id": "298e97ab-49d2-35f4-a11d-19efc83ad1e0",
                        "target_lang_word": "curse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "curse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f226011d-e216-3785-92f3-d4c5600edd6a",
                                        "entry_id": "07895232-050d-3c23-825e-e65c139773ed",
                                        "glosses": [
                                            "A supernatural detriment or hindrance; a bane."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1fed9ae-0f33-4b95-97af-4ac93ad58318",
                                                "sense_id": "f226011d-e216-3785-92f3-d4c5600edd6a",
                                                "text": "If ye will not heare, and if yee will not lay it to heart, to giue glory vnto my name, saith the Lord of hostes; I will euen send a curse vpon you, and will curse your blessings: yea, I haue cursed them already, because yee doe not lay it to heart."
                                            },
                                            {
                                                "example_id": "4a46e150-3605-48fc-8a1d-9336ea72b359",
                                                "sense_id": "f226011d-e216-3785-92f3-d4c5600edd6a",
                                                "text": "Oh Portius, is there not some choſen Curſe,\nSome hidden Thunder in the Stores of Heav’n,\nRed with uncommon Wrath, to blaſt the Man\nWho owes his Greatneſs to his Country’s Ruin?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34bd3e04-2685-3681-90b0-e1d809931896",
                                        "entry_id": "07895232-050d-3c23-825e-e65c139773ed",
                                        "glosses": [
                                            "A prayer or imprecation that harm may befall someone."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "068566ba-44ee-3daa-a6a0-d5af6e21631f",
                                        "entry_id": "07895232-050d-3c23-825e-e65c139773ed",
                                        "glosses": [
                                            "The cause of great harm, evil, or misfortune; that which brings evil or severe affliction; torment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4d1d21b-4fd7-42fb-a8a4-237eb3f704bc",
                                                "sense_id": "068566ba-44ee-3daa-a6a0-d5af6e21631f",
                                                "text": "The common curſe of mankinde, Folly and Ignorance[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1770f9b-fb37-345d-ba43-ff813216e721",
                                        "entry_id": "07895232-050d-3c23-825e-e65c139773ed",
                                        "glosses": [
                                            "A vulgar epithet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6af0c0a-7538-427e-af4a-e6d8f5552aa7",
                                                "sense_id": "e1770f9b-fb37-345d-ba43-ff813216e721",
                                                "text": "Swearing doesn't just mean what we now understand by \"dirty words\". It is entwined, in social and linguistic history, with the other sort of swearing: vows and oaths. Consider for a moment the origins of almost any word we have for bad language – \"profanity\", \"curses\", \"oaths\" and \"swearing\" itself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e779498c-895c-38c8-8e48-68e84fdbf620",
                                        "entry_id": "07895232-050d-3c23-825e-e65c139773ed",
                                        "glosses": [
                                            "A woman's menses."
                                        ],
                                        "tags": [
                                            "dated",
                                            "derogatory",
                                            "slang",
                                            "usually",
                                            "with-definite-article"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "curse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78c51a55-adfa-356d-8a29-16955f262f1f",
                                        "entry_id": "051bb820-0318-31f5-ada0-d5fa81840b43",
                                        "glosses": [
                                            "To place a curse upon (a person or object)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f6466a9-5476-454e-8b94-67400aa7ba5e",
                                                "sense_id": "78c51a55-adfa-356d-8a29-16955f262f1f",
                                                "text": "And Balaam said unto God, Balak the son of Zippor, king of Moab, hath sent unto me, saying,\nBehold, there is a people come out of Egypt, which covereth the face of the earth: come now, curse me them; peradventure I shall be able to overcome them, and drive them out.\nAnd God said unto Balaam, Thou shalt not go with them; thou shalt not curse the people: for they are blessed."
                                            },
                                            {
                                                "example_id": "9fb6ed70-1cde-43c1-b920-341436d6f8d5",
                                                "sense_id": "78c51a55-adfa-356d-8a29-16955f262f1f",
                                                "text": "Captain Edward Carlisle[…]felt a curious sensation of helplessness seize upon him as he met her steady gaze,[…]; he could not tell what this prisoner might do. He cursed the fate which had assigned such a duty, cursed especially that fate which forced a gallant soldier to meet so superb a woman as this under handicap so hard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23d2f5b9-5b5a-3fab-8de6-657df98202b3",
                                        "entry_id": "051bb820-0318-31f5-ada0-d5fa81840b43",
                                        "glosses": [
                                            "To call upon divine or supernatural power to send injury upon; to imprecate evil upon; to execrate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "295b8be6-db08-45fa-bd41-2471f51442c5",
                                                "sense_id": "23d2f5b9-5b5a-3fab-8de6-657df98202b3",
                                                "text": "Thou ſhalt not[…]curſe the ruler of thy people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a94fa5c8-ecf5-3cef-a440-684f8f61f4b2",
                                        "entry_id": "051bb820-0318-31f5-ada0-d5fa81840b43",
                                        "glosses": [
                                            "To speak or shout a vulgar curse or epithet."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8224fa6d-bec9-3c71-aedd-1b93eff5a363",
                                        "entry_id": "051bb820-0318-31f5-ada0-d5fa81840b43",
                                        "glosses": [
                                            "To use offensive or morally inappropriate language."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "998e7f81-6ed2-4764-8df3-14a0fd9bda43",
                                                "sense_id": "8224fa6d-bec9-3c71-aedd-1b93eff5a363",
                                                "text": "Then beganne hee to curſe and to ſweare[…]"
                                            },
                                            {
                                                "example_id": "75c4d704-0e36-444f-876b-443223de4218",
                                                "sense_id": "8224fa6d-bec9-3c71-aedd-1b93eff5a363",
                                                "text": "[…]his Spirits heare me, / And yet I needes muſt curſe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0dfae06-8bb3-3029-9f15-341a81fa0817",
                                        "entry_id": "051bb820-0318-31f5-ada0-d5fa81840b43",
                                        "glosses": [
                                            "To bring great evil upon; to be the cause of serious harm or unhappiness to; to furnish with that which will be a cause of deep trouble; to afflict or injure grievously; to harass or torment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0313dad2-f819-4bb1-b800-347ce4030223",
                                                "sense_id": "b0dfae06-8bb3-3029-9f15-341a81fa0817",
                                                "text": "On Impious Realms, and barb’rous Kings, impoſe / Thy Plagues, and curſe 'em with ſuch Sons as thoſe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73b66ee3-2feb-427f-b5a5-cac0c5afbe71",
                        "source_entry_id": "298e97ab-49d2-35f4-a11d-19efc83ad1e0",
                        "target_lang_word": "imprecation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imprecation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8569d2d5-71ed-3a93-ad7f-0b2677c266fb",
                                        "entry_id": "94e02c69-205d-3f17-9ca3-e7bcd4d5c278",
                                        "glosses": [
                                            "The act of imprecating, or invoking evil upon someone; a prayer that a curse or calamity may befall someone."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0167bee-0038-47a8-8b7e-556172f8fdc4",
                                                "sense_id": "8569d2d5-71ed-3a93-ad7f-0b2677c266fb",
                                                "text": "Hear then this dreadful imprecation; hear it: / 'Tis lay'd on all; not any one exempt: […]"
                                            },
                                            {
                                                "example_id": "c33b7148-c3f3-4de1-9f49-bf82d70643ba",
                                                "sense_id": "8569d2d5-71ed-3a93-ad7f-0b2677c266fb",
                                                "text": "Her son turned to look at her as she reeled and swayed in the middle of the room, her fierce face convulsed with passion, her blotched arms raised high in imprecation. \"May Gawd curse her forever,\" she shrieked."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37a754b6-ee38-3e2e-ac15-1994a4f4f8a1",
                                        "entry_id": "94e02c69-205d-3f17-9ca3-e7bcd4d5c278",
                                        "glosses": [
                                            "A curse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db468dbb-81be-45f8-a18e-5881f10367be",
                                                "sense_id": "37a754b6-ee38-3e2e-ac15-1994a4f4f8a1",
                                                "text": "Mr. Gamfield growled a fierce imprecation on the donkey generally, but more particularly on his eyes; and, running after him, bestowed a blow on his head."
                                            },
                                            {
                                                "example_id": "90677c55-772b-4551-ac02-b2410ab67ea0",
                                                "sense_id": "37a754b6-ee38-3e2e-ac15-1994a4f4f8a1",
                                                "text": "He drank the spirits and impatiently bade us go; terminating his command with a sequel of horrid imprecations too bad to repeat or remember."
                                            },
                                            {
                                                "example_id": "1e3ba77f-4348-467c-8804-03fb1c63d022",
                                                "sense_id": "37a754b6-ee38-3e2e-ac15-1994a4f4f8a1",
                                                "text": "All life had turned to rottenness and stench in them--love was a beastliness, joy was a snare, and God was an imprecation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "348b8734-5ab2-4e80-91d4-a5a429181163",
