                "senses": [
                    {
                        "sense_id": "bff594dd-f881-3569-82b4-e59e9d9977c5",
                        "entry_id": "2724571d-b8c6-37f8-9f58-c830f3c6f343",
                        "glosses": [
                            "verward"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b0a026c-8a8f-4ac3-b8f2-43ba98cef85c",
                                "sense_id": "bff594dd-f881-3569-82b4-e59e9d9977c5",
                                "text": "Ook de nationale dopingautoriteiten lijken confuus. Niemand weet precies hoe er nu gehandeld moet worden.”"
                            },
                            {
                                "example_id": "0fb53652-a8dd-4a9b-8d5a-8bd88a4579ab",
                                "sense_id": "bff594dd-f881-3569-82b4-e59e9d9977c5",
                                "text": "Hij was blijkbaar uit een diepe slaap gekomen en leek confuus."
                            }
                        ]
                    },
                    {
                        "sense_id": "e4b7d03e-dc57-3bce-ba68-7344a736703f",
                        "entry_id": "2724571d-b8c6-37f8-9f58-c830f3c6f343",
                        "glosses": [
                            "verlegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9142bae1-ce9d-4ad1-b698-7ccf95fe601b",
                                "sense_id": "e4b7d03e-dc57-3bce-ba68-7344a736703f",
                                "text": "Onze neuzen raakten elkaar bijkans, ik voelde zijn adem langs mijn wang strijken. ‘Don’t be afraid’, zei hij bemoedigend. Ik raakte confuus, maar hij bedoelde enkel dat ik niet bang hoefde te zijn hem pijn te doen. Hoe ik ook gluurde, en hoe hij ook rolde met zijn oog: ik kon niets ongewoons ontdekken."
                            }
                        ]
                    }
