                                        "glosses": [
                                            "Moral laxity; licentiousness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3a6c8b4-443c-4f2d-8b0d-221701915984",
                                                "sense_id": "ca914e78-544e-377b-9b5d-f8e577f2f0ab",
                                                "text": "Yet goodly court he made still to his Dame, / Pourd out in loosnesse on the grassy grownd [...]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b09587fa-e9ad-4d3b-b605-366c60109ab2",
                        "source_entry_id": "e037f40a-39a3-32dc-971c-d9805f5d65ab",
