                        "glosses": [
                            "Any of several temperate succulent plants of the family Crassulaceae, that have clusters of purple flowers, especially Hylotelephium telephium."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67cb09a6-4ca8-4cd0-a284-ea4dc965f906",
                                "sense_id": "8f1404be-0b94-37c6-a56f-ada9ac592a67",
                                "text": "Common Orpine rises up with diverse round, brittle stalks, thick set with fat and fleshy leaves without any order, and little or nothing dented about the edges; of a pale green colour."
                            },
                            {
                                "example_id": "b7478e9f-7735-4003-bdb5-689cfbdb249d",
                                "sense_id": "8f1404be-0b94-37c6-a56f-ada9ac592a67",
                                "text": "A plant of orpine was often set by a young girl on her window sill on Midsummer Eve."
                            }
                        ]
