                    {
                        "sense_id": "7550c642-2964-3e26-a1f8-30fb4117a465",
                        "entry_id": "24c4eb2d-5aa0-3dc3-8c01-35b714bff75b",
                        "glosses": [
                            "Vernehmung, bei welcher Zeugen oder Sachverständige allein durch Staatsanwaltschaft und Strafverteidiger befragt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32c9eaa9-5cf8-4499-b858-11d0d64ebd4c",
                                "sense_id": "7550c642-2964-3e26-a1f8-30fb4117a465",
                                "text": "„Während des Kreuzverhörs schreibt er fleißig mit, und ich werde später erfahren, dass die Anwälte immer froh sind, wenn er den Vorsitz führt, weil er schneller schreibt als die meisten anderen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0b0ceda-f1e6-42fe-a58b-764f60852a16",
                        "source_entry_id": "24c4eb2d-5aa0-3dc3-8c01-35b714bff75b",
                        "source_sense_id": "7550c642-2964-3e26-a1f8-30fb4117a465",
                        "source_sense_description": "Vernehmung durch Staatsanwaltschaft und Strafverteidiger",
