                "translations": [
                    {
                        "translation_id": "507f143c-d78f-4e96-971f-61e27191e23a",
                        "source_entry_id": "53084b84-e319-3411-b528-fd17fb36b086",
                        "source_sense_id": "5345d1e9-acba-3d01-b0fc-c95623ed5c7d",
                        "source_sense_description": "een apparaat om grammofoonplaten af te spelen",
                        "target_lang_word": "Plattenspieler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Plattenspieler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b4118c9-d80d-3a11-8d30-b2f2a2fe13c5",
                                        "entry_id": "507c2cdd-117e-341e-b8e6-0c329e74a5be",
                                        "glosses": [
                                            "Schallplattenspieler; ein elektrisches Gerät zum Abspielen von Schallplatten"
                                        ],
                                        "tags": [
                                            "Kurzform"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccbbf9a9-8665-4cfc-bf74-882b4b2d4611",
                                                "sense_id": "3b4118c9-d80d-3a11-8d30-b2f2a2fe13c5",
                                                "text": "Er hat einen alten Plattenspieler auf dem Flohmarkt gekauft."
                                            },
                                            {
                                                "example_id": "883022a2-6f57-4cf9-8532-b95ef522d0c8",
                                                "sense_id": "3b4118c9-d80d-3a11-8d30-b2f2a2fe13c5",
                                                "text": "„Mit Mamas Erlaubnis hatte Renate den alten Plattenspieler bei sich im Zimmer angeschlossen und die Weihnachtsplatte aufgelegt: Musik für festliche Stunden.“"
                                            },
                                            {
                                                "example_id": "4878a605-a937-4ef2-b8b1-1ccc5d7b02a6",
                                                "sense_id": "3b4118c9-d80d-3a11-8d30-b2f2a2fe13c5",
                                                "text": "„Sabina glitt zu Boden, blieb nahe beim Plattenspieler sitzen.“"
                                            },
                                            {
                                                "example_id": "5d2422cc-c5bc-402e-bb04-7c63b51045c6",
                                                "sense_id": "3b4118c9-d80d-3a11-8d30-b2f2a2fe13c5",
                                                "text": "„Zur Feier des Tages wurde dann wie verrückt Charleston getanzt, der Plattenspieler spielte pausenlos, die Dielenbalken bogen sich, und das ganze Haus bebte.“"
                                            },
                                            {
                                                "example_id": "2d9d66fa-05f0-45a8-b2cf-fd18af0ac2e5",
                                                "sense_id": "3b4118c9-d80d-3a11-8d30-b2f2a2fe13c5",
                                                "text": "„Ein Plattenspieler ließ durch zwei Lautsprecher leicht kratzend nostalgische Unterhaltungsmusik hören.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83906552-7a18-4723-b8f2-36a1b5918cdc",
