                "senses": [
                    {
                        "sense_id": "3603994c-60ac-3452-a7f3-ec46a0166baf",
                        "entry_id": "3b422421-aaee-3f63-a2fd-f3614005ad6c",
                        "glosses": [
                            "Combattre et vaincre un ennemi ou finir un donjon, seul, sans alliés, dans un jeu multijoueur."
                        ],
                        "tags": [
                            "Jeux vidéo"
                        ],
                        "examples": [
                            {
                                "example_id": "da451143-ce12-4c7c-800d-9e5356101efe",
                                "sense_id": "3603994c-60ac-3452-a7f3-ec46a0166baf",
                                "text": "Salut, je voulais savoir s'il était possible de soloter certaines (ou toutes) les instances de cata […] ? — (site http://eu.battle.net)"
                            },
                            {
                                "example_id": "84802bdf-1d24-40da-b8ad-97409114bbd8",
                                "sense_id": "3603994c-60ac-3452-a7f3-ec46a0166baf",
                                "text": "Crôm !\nIl a soloté tous les donjons\nSans armure et sans pantalon !"
                            }
                        ]
                    },
                    {
                        "sense_id": "9d292449-adff-3850-9a48-26c33f55e83a",
                        "entry_id": "3b422421-aaee-3f63-a2fd-f3614005ad6c",
                        "glosses": [
                            "Jouer une partie en solo (par opposition à multijoueur)."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "e11faf3f-efaa-41d7-8083-7c9c013c2511",
                                "sense_id": "9d292449-adff-3850-9a48-26c33f55e83a",
                                "text": "Le mode Armageddon ne peut pas être soloté. — (site diablo3.judgehype.com)"
                            }
                        ]
                    }
