                    },
                    {
                        "translation_id": "4c67dbfd-1b8b-41a7-8aff-2150efc31e47",
                        "source_entry_id": "bd7f425e-e689-39b6-b40d-ce8ebfb7bc7c",
                        "source_sense_id": "f275422a-22f9-3114-90b7-f09097629f75",
                        "target_lang_word": "cocon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cocon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ef3abe4-3107-3bbd-8892-93dad4a5f4d8",
                                        "entry_id": "21e40e97-d698-3d60-bbd9-26ea4533f2f1",
                                        "glosses": [
                                            "Enveloppe que se filent beaucoup de larves d’insectes, et dans laquelle doit s’opérer leur dernière mue."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c43884d6-fb3d-3c0b-991e-62cacd796fac",
                                        "entry_id": "21e40e97-d698-3d60-bbd9-26ea4533f2f1",
                                        "glosses": [
                                            "Coque qui renferme le ver à soie quand il a achevé de filer et dont on obtient la soie en la dévidant."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91284fff-0190-446d-afa3-73d335e1d5e6",
                                                "sense_id": "c43884d6-fb3d-3c0b-991e-62cacd796fac",
                                                "text": "Le travail de filature consiste à retirer le fil du cocon dont la longueur est d’environ 480 mètres et à le dévider sans le briser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad4a4a10-e8bb-3ec8-b12d-19230551c302",
                                        "entry_id": "21e40e97-d698-3d60-bbd9-26ea4533f2f1",
                                        "glosses": [
                                            "Tout ce qui protège un être fragile ou immature."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73702346-cff2-4fe8-bab6-94c1f651e5f8",
                                                "sense_id": "ad4a4a10-e8bb-3ec8-b12d-19230551c302",
                                                "text": "Le cocooning remonte à la fin des années 1980 : ce terme, forgé par la futurologue américaine Faith Popcorn, désignait la tendance à se renfermer dans un cocon, au sein d'une intimité protégée, afin de se défendre des agressions du monde extérieur."
                                            },
                                            {
                                                "example_id": "f4c633e6-a67e-450b-a91a-2870081dc8d7",
                                                "sense_id": "ad4a4a10-e8bb-3ec8-b12d-19230551c302",
                                                "text": "L’école, les copines, la zumba et les petits restaus : il ne lui en faudrait pas plus pour se sentir bien, à l’aise dans le cocon qu’elle s’était tissé. Pas plus, mais elle en avait besoin plus que jamais."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cocon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "36e2748e-1b2c-3628-9223-472547774346",
                                        "entry_id": "5ef9e037-9d38-3515-a560-555cfe36ab99",
                                        "glosses": [
                                            "Élève polytechnicien."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a44867f1-a6f3-4a8a-90c7-3a0a9ceabd4f",
                        "source_entry_id": "bd7f425e-e689-39b6-b40d-ce8ebfb7bc7c",
                        "source_sense_id": "f275422a-22f9-3114-90b7-f09097629f75",
                        "target_lang_word": "Kokon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kokon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "57ba37d7-076d-3ff9-bbf9-63fac9d8227c",
                                        "entry_id": "e8793bb4-be48-3d8b-bda2-fa0384d27df7",
                                        "glosses": [
                                            "Schutzhülle eines Insekts, einer Spinne oder eines Wurms während des Übergangs zwischen Entwicklungsstadien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "362a42bb-2387-4078-a721-dc900fd16847",
                                                "sense_id": "57ba37d7-076d-3ff9-bbf9-63fac9d8227c",
                                                "text": "„Der Überlieferung nach studierte die Kaiserin vor fast 5000 Jahren jene Raupen, die sich einen Kokon aus Seide spinnen.“"
                                            },
                                            {
                                                "example_id": "915e4094-c4a6-4f53-b49f-e8bea8be66e0",
                                                "sense_id": "57ba37d7-076d-3ff9-bbf9-63fac9d8227c",
                                                "text": "„Die beiden lateinischen Worte umspannten ihr Leben wie ein Kokon, denn es war tatsächlich nichts anderes als eine Folge falscher Entscheidungen.“"
                                            },
                                            {
                                                "example_id": "652955b7-06b0-4a6a-a209-830499f1df93",
                                                "sense_id": "57ba37d7-076d-3ff9-bbf9-63fac9d8227c",
                                                "text": "„Sie bekam, worum sie bat. Indem sie ihren Gast in einen Kokon aus grimmiger, gegenseitig verpflichtender Höflichkeit einspann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
