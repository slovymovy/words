                "senses": [
                    {
                        "sense_id": "dbc0b272-739a-3aee-8637-876412b24a64",
                        "entry_id": "e62fbe80-9dee-38db-82a3-7457a1e906f7",
                        "glosses": [
                            "Schrift, der man noch anmerkt, dass sie nicht von einem routinierten, erwachsenen Schreiber stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0774aebc-6c8f-4fae-8987-bf52f9b38f6b",
                                "sense_id": "dbc0b272-739a-3aee-8637-876412b24a64",
                                "text": "„Die Gläser hatte Dete mit ihrer großen Kinderschrift etikettiert, auf einem grob gezimmerten Tablett in den Keller getragen und dort sorgfältig hinter die älteren Jahrgänge eingeordnet.“"
                            },
                            {
                                "example_id": "bbacf0a3-5739-479e-91d1-34578e5929ca",
                                "sense_id": "dbc0b272-739a-3aee-8637-876412b24a64",
                                "text": "„Ich achtete jetzt erst im Vergleichen auf die Schrift, eine enge reinliche Schrift, eine Kinderschrift, ich meine rein, nicht reinlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
