                                "target_senses": [
                                    {
                                        "sense_id": "bd17df89-cb11-3ecd-bf26-8e140a7c6430",
                                        "entry_id": "ff312254-c9ac-3c7e-af18-bb3a7b1fb6ae",
                                        "glosses": [
                                            "einen bestimmten allgemeinen Typ verkörpernd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08c81f40-ddb8-4be4-845e-046316c870e8",
                                                "sense_id": "bd17df89-cb11-3ecd-bf26-8e140a7c6430",
                                                "text": "Typisch ist die dunkelrot gefärbte Brustbefederung."
                                            },
                                            {
                                                "example_id": "d948803a-ccc7-4022-a391-e7b6c43bf01c",
                                                "sense_id": "bd17df89-cb11-3ecd-bf26-8e140a7c6430",
                                                "text": "Solch eine Antwort ist natürlich typisch für einen Politiker - weder ja noch nein."
                                            },
                                            {
                                                "example_id": "e67ba258-2571-4a37-acfb-723b1b910fb7",
                                                "sense_id": "bd17df89-cb11-3ecd-bf26-8e140a7c6430",
                                                "text": "Der typische Leser des Magazins ist unter 30 und Alleinstehender."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f049b36e-a92a-3478-b6d5-30416974d152",
                                        "entry_id": "ff312254-c9ac-3c7e-af18-bb3a7b1fb6ae",
                                        "glosses": [
                                            "für ein bestimmtes Individuum charakteristisch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "424c85f6-2b35-412b-8043-073042663534",
                                                "sense_id": "f049b36e-a92a-3478-b6d5-30416974d152",
                                                "text": "Es ist typisch für ihn, hier gleich aufzubrausen."
                                            },
                                            {
                                                "example_id": "293d4e92-a3fa-4322-bf24-0fc3e4ba7ec5",
                                                "sense_id": "f049b36e-a92a-3478-b6d5-30416974d152",
                                                "text": "Ja, was soll ich sagen, das war typisch meine Schwester - direkt und unverblümt."
                                            },
                                            {
                                                "example_id": "8243da06-3ff6-4f4e-b461-946fa5cab8cc",
                                                "sense_id": "f049b36e-a92a-3478-b6d5-30416974d152",
                                                "text": "„Diese in erster Linie von Angst-Lust-Gefühlen geprägte Art, Fallen zu gustieren, ist jedoch nicht allein und durchgängig kennzeichnend für das Fallerleben. Sie ist vornehmlich für den Erstfaller und Neuling des Bungeejumping typisch.“"
                                            },
                                            {
                                                "example_id": "5218e672-c22a-42a3-a121-768e152441ec",
                                                "sense_id": "f049b36e-a92a-3478-b6d5-30416974d152",
                                                "text": "Das war natürlich typisch für meine Kollegin, dass sie hintenherum Geschichten erzählt hat."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2d7fa0ce-fecc-31de-b339-765b623d6f2c",
                                        "entry_id": "ff312254-c9ac-3c7e-af18-bb3a7b1fb6ae",
                                        "glosses": [
                                            "als Muster/Vorbild geltend"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa3a4df5-5c3c-4523-baf9-2acaa54c48a6",
