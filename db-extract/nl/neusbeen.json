                "senses": [
                    {
                        "sense_id": "d61e98b7-4e26-3093-adb4-b98cb558d69c",
                        "entry_id": "70c289cf-b9a6-3b23-a96c-49a21bb28367",
                        "glosses": [
                            "een van de beenderen van de schedel, midden in het gelaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35ed3d45-99c4-486e-b47a-150203645f9c",
                                "sense_id": "d61e98b7-4e26-3093-adb4-b98cb558d69c",
                                "text": "De kogel raakte het neusbeen."
                            },
                            {
                                "example_id": "3647a00a-e1c4-4572-bc15-cbe266933013",
                                "sense_id": "d61e98b7-4e26-3093-adb4-b98cb558d69c",
                                "text": "Uit het julinummer citeer ik het antwoord op de vraag: „Wat moet ik doen als ik een bloedneus heb?’’ Jasper Rebel, arts van de Spoedeisende Hulp: „Ga rustig zitten en snuit uw neus zodat eventuele bloedpropjes eruit zijn. Houd uw hoofd licht voorover en knijp dan uw neus dicht, vlak onder het hard aanvoelende neusbeen. Adem rustig door de mond. Blijf zo minstens 20 minuten zitten met uw neus dichtgeknepen.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bdd00a68-2a47-44bd-a68c-eabb22129352",
                        "source_entry_id": "70c289cf-b9a6-3b23-a96c-49a21bb28367",
                        "source_sense_id": "d61e98b7-4e26-3093-adb4-b98cb558d69c",
                        "source_sense_description": "een van de beenderen van de schedel",
                        "target_lang_word": "Nasenbein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nasenbein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d53ac2f7-b0ea-3d75-8ae5-482922b9bb39",
                                        "entry_id": "374b2fee-bb29-3de4-b052-fda9ca92c447",
                                        "glosses": [
                                            "paariger, vor dem Stirnbein und oberhalb der Maxilla gelegener, beim Menschen eher länglicher Schädelknochen, der den obersten Teil der Nase beziehungsweise des Nasenrückens bildet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bd1a2fc-b3a7-42a8-a079-787058f789b6",
                                                "sense_id": "d53ac2f7-b0ea-3d75-8ae5-482922b9bb39",
                                                "text": "„Die Männchen der Altweltaffen besitzen rechts und links des Nasenbeins Knochenwülste, die zusammen mit dem Farbenspiel der Haut der Kommunikation dienen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
