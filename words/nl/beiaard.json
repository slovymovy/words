{
    "word_family": [
        "beiaardier",
        "beiaarden"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ae8e0b36-c2c5-3803-b418-2862cf7da64a",
                    "sense_definition": "Een muziekinstrument bestaande uit een reeks afgestemde klokken die vanuit een klavier of mechanisch bespeeld worden, vaak in een kerktoren.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De sfeer van de stad wordt mede bepaald door de klanken van draaiorgel en <w>beiaard</w>.",
                            "target_lang_translations": {
                                "fr": "L'atmosphère de la ville est en partie déterminée par les sons de l'orgue de Barbarie et du <w>carillon</w>."
                            }
                        },
                        {
                            "text": "Tijdens de zomermarkt hoorden we het geluid van de <w>beiaard</w> over het plein schallen.",
                            "target_lang_translations": {
                                "fr": "Pendant le marché d'été, nous avons entendu le son du <w>carillon</w> résonner sur la place."
                            }
                        }
                    ],
                    "synonyms": [
                        "carillon",
                        "klokkenspel"
                    ],
                    "common_phrases": [
                        "geluid van de beiaard"
                    ],
                    "target_lang_definitions": {
                        "fr": "Instrument de musique composé d'une série de cloches accordées, jouées depuis un clavier ou mécaniquement, souvent situé dans un clocher."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "carillon",
                                "target_lang_sense_clarification": "ensemble de cloches accordées"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d673e0aa-8ea6-3c47-869e-35e86b3ddf5b",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>beiaarden</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "conjugation_beiaarden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>beiaard</w> graag op feestdagen voor de buurtbewoners.",
                            "target_lang_translations": {
                                "fr": "Je <w>joue</w> volontiers <w>du carillon</w> les jours de fête pour les habitants du quartier."
                            }
                        },
                        {
                            "text": "Elke zondag <w>beiaard</w> ik op de oude klokken van de kerk.",
                            "target_lang_translations": {
                                "fr": "Chaque dimanche, je <w>joue du carillon</w> sur les anciennes cloches de l'église."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "1st person singular present"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Première personne du singulier du présent de l'indicatif du verbe « beiaarden » (jouer du carillon)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "joue du carillon",
                                "target_lang_sense_clarification": "forme conjuguée (1re pers. sing.)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71d427de-1bb6-3724-8126-cce28f5b2b7d",
                    "sense_definition": "Gebiedende wijs van <w>beiaarden</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "conjugation_beiaarden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Beiaard</w> luid op deze feestelijke middag!",
                            "target_lang_translations": {
                                "fr": "<w>Joue du carillon</w> bien fort en ce bienheureux après-midi !"
                            }
                        },
                        {
                            "text": "<w>Beiaard</w> voor de stad en laat de klokken klinken!",
                            "target_lang_translations": {
                                "fr": "<w>Joue du carillon</w> pour la ville et fais sonner les cloches !"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Impératif du verbe « beiaarden » (jouer du carillon)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "joue du carillon",
                                "target_lang_sense_clarification": "impératif"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7f72b91-3599-37f4-b794-69d7cd35de2b",
                    "sense_definition": "Tweede persoon enkelvoud tegenwoordige tijd (inversie) van <w>beiaarden</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "conjugation_beiaarden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Beiaard</w> je weer op de feestdag van de stad?",
                            "target_lang_translations": {
                                "fr": "<w>Joues-tu</w> à nouveau <w>du carillon</w> le jour de la fête de la ville ?"
                            }
                        },
                        {
                            "text": "Waarom <w>beiaard</w> je vandaag niet zoals gewoonlijk?",
                            "target_lang_translations": {
                                "fr": "Pourquoi ne <w>joues-tu</w> pas <w>du carillon</w> aujourd'hui comme d'habitude ?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "2nd person singular present inversion"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Deuxième personne du singulier du présent de l'indicatif avec inversion du verbe « beiaarden » (jouer du carillon)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "joues-tu du carillon",
                                "target_lang_sense_clarification": "forme interrogative avec inversion (2e pers. sing.)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}