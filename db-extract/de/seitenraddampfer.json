                "senses": [
                    {
                        "sense_id": "9b0317cc-d922-3e15-918c-7e7b023775fd",
                        "entry_id": "15bd1536-18b7-3b61-bb83-ec87e08a8397",
                        "glosses": [
                            "Dampfschiff, das von seitlich angebrachten Schaufelrädern angetrieben wird"
                        ],
                        "tags": [
                            "Schiffswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "b872385d-5922-419c-ba19-abab64447bd2",
                                "sense_id": "9b0317cc-d922-3e15-918c-7e7b023775fd",
                                "text": "„Der historische Seitenraddampfer von 1929, einst prachtvolles Ausflugsschiff auf dem Rhein und für 2500 Passagiere ausgelegt, ist nicht nur das größte Ausstellungsstück des TECHNOSEUMS, sondern auch Ausstellungsort.“"
                            },
                            {
                                "example_id": "25f73d76-97a5-4f81-855d-be1b2ebd7a36",
                                "sense_id": "9b0317cc-d922-3e15-918c-7e7b023775fd",
                                "text": "„Insgesamt sind neun Seitenraddampfer der Baujahre 1879 – 1929 auf der Elbe zwischen Bad Schandau, Deci, Dresden und Meissen unterwegs.“"
                            },
                            {
                                "example_id": "4497a3eb-fe3a-4ec9-ba2d-9d72713a7b53",
                                "sense_id": "9b0317cc-d922-3e15-918c-7e7b023775fd",
                                "text": "„Die beiden Seitenraddampfer auf den Fotos ähneln sich so sehr, dass es einem schwer fällt sich für ein bestimmtes Vorbild zu entscheiden.“"
                            },
                            {
                                "example_id": "7cc7ed61-ea15-47b5-acde-62fa55281fb1",
                                "sense_id": "9b0317cc-d922-3e15-918c-7e7b023775fd",
                                "text": "„Dieser Satz ist eine sinnvolle Ergänzung, wenn man den Seitenraddampfer D/S Skibladner als ferngesteuertes Modell zu Wasser lassen will. Neben dem Antriebsmotor mit Schneckengetriebe beinhaltet der Satz auch das passende Mikrolenkservo und weiteres Zubehör.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
