                                        "glosses": [
                                            "связанный с производством (переработкой, хранением и т. д.) продуктов питания"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "65067cd0-bc6b-39bc-a598-165995bf7c1a",
                                        "entry_id": "f533c9dc-74f2-3eff-a2f3-9f7daadb355a",
