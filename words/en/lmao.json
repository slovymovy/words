{
    "word_family": [
        "lmfao"
    ],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "acc88d98-b606-3036-8679-5fea7454879b",
                    "sense_definition": "An internet slang abbreviation for \"laughing my ass off\", used to indicate that something is extremely funny.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That video you sent was hilarious, <w>lmao</w>!",
                            "target_lang_translations": {
                                "ru": "То видео, что ты скинул, просто угар, <w>ржу</w>!",
                                "zh": "你发给我的那个视频太搞笑了，<w>笑死</w>！"
                            }
                        },
                        {
                            "text": "<w>Lmao</w>, I cannot believe he actually said that to the teacher.",
                            "target_lang_translations": {
                                "ru": "<w>Ору</w>, поверить не могу, что он реально сказал это учителю.",
                                "zh": "<w>笑死</w>，我真不敢相信他竟然对老师说了那种话。"
                            }
                        }
                    ],
                    "synonyms": [
                        "LOL",
                        "ROFL",
                        "haha"
                    ],
                    "common_phrases": [
                        "lmao dead",
                        "lmao same"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "internet slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Интернет-сленг, аббревиатура от \"laughing my ass off\", используется для выражения бурного смеха, когда что-то кажется очень смешным.",
                        "zh": "网络俚语，意为“笑死我了”，用于表示某事非常滑稽可笑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ржу",
                                "target_lang_sense_clarification": "сленг: очень смешно (букв. издаю звуки как лошадь)"
                            },
                            {
                                "target_lang_word": "ору",
                                "target_lang_sense_clarification": "современный сленг: смеюсь в голос, до крика"
                            },
                            {
                                "target_lang_word": "ахаха",
                                "target_lang_sense_clarification": "стандартное выражение смеха в переписке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "笑死",
                                "target_lang_sense_clarification": "网络用语，表示极度好笑"
                            },
                            {
                                "target_lang_word": "哈哈",
                                "target_lang_sense_clarification": "表示大笑的常用词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57fb5d46-f0ac-398c-bed7-1dedb952b5ac",
                    "sense_definition": "Used to make a message feel more casual, light-hearted, or less serious, often when nothing is actually funny.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have no idea what I am doing right now <w>lmao</w>.",
                            "target_lang_translations": {
                                "ru": "Я вообще без понятия, что я сейчас делаю, <w>лол</w>.",
                                "zh": "我完全不知道自己现在在干什么，<w>哈</w>。"
                            }
                        },
                        {
                            "text": "It is not a big deal <w>lmao</w>, do not worry about it.",
                            "target_lang_translations": {
                                "ru": "Да ничего страшного, <w>хах</w>, не парься.",
                                "zh": "这没什么大不了的，<w>哈</w>，别担心。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lol"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "internet slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется, чтобы сделать сообщение более непринужденным, легким или менее серьезным, часто когда на самом деле ничего смешного нет.",
                        "zh": "用于使语气显得更随意、轻松或不那么严肃，即使内容本身并不好笑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лол",
                                "target_lang_sense_clarification": "используется как частица для смягчения тона"
                            },
                            {
                                "target_lang_word": "хах",
                                "target_lang_sense_clarification": "короткий смешок, часто выражающий иронию или неловкость"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "哈",
                                "target_lang_sense_clarification": "用于句末缓解语气，表示轻松"
                            },
                            {
                                "target_lang_word": "呵呵",
                                "target_lang_sense_clarification": "用于非正式场合，有时带有自嘲或随意的意味"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "83189349-ca83-32ba-becd-97bd5f3e5ea8",
                    "sense_definition": "To laugh very hard or uncontrollably.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We were <w>LMAOing</w> at the funny pictures all night long.",
                            "target_lang_translations": {
                                "ru": "Мы всю ночь <w>угорали</w> над смешными картинками.",
                                "zh": "我们整晚都在对着那些搞笑图片<w>狂笑</w>。"
                            }
                        },
                        {
                            "text": "She <w>LMAOed</w> when she saw the dog wearing a costume.",
                            "target_lang_translations": {
                                "ru": "Она <w>заржала</w>, когда увидела собаку в костюме.",
                                "zh": "她看到那只穿着戏服的狗时<w>大笑</w>不止。"
                            }
                        }
                    ],
                    "synonyms": [
                        "crack up",
                        "roar"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "internet slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Смеяться очень сильно или неудержимо.",
                        "zh": "指非常剧烈或无法控制地大笑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угорать",
                                "target_lang_sense_clarification": "сильно смеяться над чем-то"
                            },
                            {
                                "target_lang_word": "ржать",
                                "target_lang_sense_clarification": "громко и безудержно смеяться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "狂笑",
                                "target_lang_sense_clarification": "形容笑得非常厉害"
                            },
                            {
                                "target_lang_word": "大笑",
                                "target_lang_sense_clarification": "指放声大笑"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}