{
    "word_family": [
        "non-sens",
        "non-lieu",
        "nonchalant"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "3dc9625a-1cac-3e12-a824-da16edb30bba",
                    "sense_definition": "Mot exprimant le refus, le désaccord ou une réponse négative à une question.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "negation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu veux un café avec ton dessert ? — <w>Non</w>, merci, j'en ai déjà bu trois aujourd'hui."
                        },
                        {
                            "text": "Il m'a demandé si j'avais fini mes devoirs et j'ai dû dire <w>non</w>."
                        }
                    ],
                    "synonyms": [
                        "nan",
                        "négatif"
                    ],
                    "antonyms": [
                        "oui",
                        "ouais",
                        "affirmatif"
                    ],
                    "common_phrases": [
                        "dire non",
                        "ou non"
                    ]
                },
                {
                    "sense_id": "2e5bb0ce-4264-31e2-b116-8e8077bfc173",
                    "sense_definition": "Employé en fin de phrase pour solliciter l'assentiment de l'interlocuteur, équivalant à n'est-ce pas.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "interrogation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce restaurant italien est vraiment excellent pour dîner en famille, <w>non</w> ?"
                        },
                        {
                            "text": "Tu avais bien promis de m'aider à faire ce déménagement, <w>non</w> ?"
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "fréquent à l'oral"
                        }
                    ]
                },
                {
                    "sense_id": "ecc0aa5b-abe4-36ad-a59d-0f9249cede11",
                    "sense_definition": "Placé devant un adjectif ou un participe pour marquer l'absence d'une qualité ou la négation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "privation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette association <w>non</w> gouvernementale aide les personnes défavorisées à trouver un logement décent."
                        },
                        {
                            "text": "Les zones fumeurs et les espaces <w>non</w> fumeurs sont clairement séparés dans cette gare."
                        }
                    ],
                    "synonyms": [
                        "pas"
                    ],
                    "common_phrases": [
                        "organisation non gouvernementale"
                    ]
                },
                {
                    "sense_id": "2a3ac886-82ca-3cd4-901e-357d08c9d960",
                    "sense_definition": "Sert à opposer une négation à une affirmation, souvent en corrélation avec mais.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "opposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est venu <w>non</w> par plaisir, mais par devoir envers toute sa famille."
                        },
                        {
                            "text": "Nous agissons ainsi <w>non</w> pour nous vanter, mais pour faire avancer la science."
                        }
                    ],
                    "common_phrases": [
                        "non seulement",
                        "non pas que"
                    ]
                },
                {
                    "sense_id": "36afab90-3c0b-3d7e-9a3e-7598808b4a17",
                    "sense_definition": "Sert à atténuer une affirmation par une litote ou à apporter une nuance restrictive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attenuation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a accepté cette proposition difficile, <w>non</w> sans hésiter pendant quelques jours."
                        },
                        {
                            "text": "Elle a terminé cette longue course en montagne, <w>non</w> sans grande difficulté."
                        }
                    ],
                    "common_phrases": [
                        "non sans raison",
                        "non sans peine"
                    ]
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "107962c0-061e-3fdb-bde1-11ab1f0ff3a8",
                    "sense_definition": "Cri ou exclamation exprimant un refus catégorique, l'indignation ou la protestation.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "exclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Non</w> ! Laissez-moi tranquille tout de suite et ne revenez plus jamais ici !"
                        },
                        {
                            "text": "<w>Non</w>, ce n'est absolument pas ce que j'avais demandé pour mon travail."
                        }
                    ],
                    "synonyms": [
                        "pas question",
                        "niet",
                        "nope"
                    ],
                    "antonyms": [
                        "oui"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9857a870-b381-385c-951c-bf7e6f62de11",
                    "sense_definition": "Parole, réponse ou décision négative.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "reponse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son père lui a opposé un <w>non</w> ferme et définitif à sa demande de sortie."
                        },
                        {
                            "text": "Je veux une réponse claire, je ne vous demande qu'un oui ou un <w>non</w>."
                        }
                    ],
                    "antonyms": [
                        "oui"
                    ],
                    "common_phrases": [
                        "un non catégorique"
                    ]
                },
                {
                    "sense_id": "f1633117-2430-3aaf-ac98-d52456eca301",
                    "sense_definition": "Suffrage ou bulletin rejetant une proposition lors d'un vote ou d'un référendum.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le camp du <w>non</w> a mené une intense campagne avant le référendum sur la constitution."
                        },
                        {
                            "text": "Les analystes prévoient une victoire du <w>non</w> lors de cette consultation populaire historique."
                        }
                    ],
                    "antonyms": [
                        "Oui"
                    ],
                    "common_phrases": [
                        "partisans du non",
                        "victoire du non"
                    ]
                },
                {
                    "sense_id": "250af7a8-288e-31b5-b7bd-c98c8422be7e",
                    "sense_definition": "Opérateur unaire de l'algèbre de Boole inversant la valeur de vérité d'une proposition.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "logique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En logique formelle, la fonction du <w>non</w> inverse l'état logique de la variable d'entrée."
                        },
                        {
                            "text": "La table de vérité montre que le <w>non</w> transforme le vrai en faux."
                        }
                    ],
                    "synonyms": [
                        "négation",
                        "négation logique",
                        "NOT"
                    ],
                    "common_phrases": [
                        "porte non"
                    ]
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "8bb4fe22-c17b-3f28-a46e-3000654e209e",
                    "sense_definition": "Marque une exclusion ou une alternative négative entre deux termes d'une proposition.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "opposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut agir avec prudence, <w>non</w> avec précipitation face à un tel danger."
                        },
                        {
                            "text": "Nous cherchons des solutions durables, <w>non</w> des compromis temporaires pour résoudre ce problème."
                        }
                    ]
                }
            ]
        }
    ]
}