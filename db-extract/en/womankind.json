                        "sense_id": "752b7060-2292-3235-9d11-e533af622807",
                        "entry_id": "82eda9f3-3276-3053-8f51-81df696c0ba7",
                        "glosses": [
                            "Women, taken collectively."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "956eab0c-93c0-4389-b5eb-0a65b0ee5b12",
                                "sense_id": "752b7060-2292-3235-9d11-e533af622807",
                                "text": "The infinite simplicity and silliness of mankind and womankind at large were too well known to the Serjeant to cause him dismay, let them be shown in ever so egregious a fashion."
                            }
                        ]
                    }
                ],
                "translations": [
