                                        "entry_id": "2eea7136-81ff-3a05-8ff6-4653cca5f0f8",
                                        "glosses": [
                                            "Without scruples; immoral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54ad1109-608b-46f2-b703-54ece89cc834",
                                                "sense_id": "b249b134-5562-3424-937a-e2e53ae0fdb1",
                                                "text": "The real difficulty is with the vast wealth and power in the hands of the few and the unscrupulous who represent or control capital."
                                            },
                                            {
                                                "example_id": "5b2e695b-79b5-47bd-b2a3-a586613b6006",
                                                "sense_id": "b249b134-5562-3424-937a-e2e53ae0fdb1",
                                                "text": "Nazism, they wrote, had turned German youth into godless, shameless, unscrupulous murderers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cd8b375-aa11-346f-b923-f5b5e8ba14d8",
                                        "entry_id": "2eea7136-81ff-3a05-8ff6-4653cca5f0f8",
                                        "glosses": [
                                            "Contemptuous of what is right or honorable."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
