                ],
                "senses": [
                    {
                        "sense_id": "21a0cd35-9b73-3c9b-af6e-09031d135ee3",
                        "entry_id": "0cd35094-1ade-333b-b7cc-9a980d59cc0f",
                        "glosses": [
                            "imię żeńskie"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "04d464fd-e5d5-4309-81ba-f600d6def403",
                                "sense_id": "21a0cd35-9b73-3c9b-af6e-09031d135ee3",
                                "text": "Moja przyszywana ciotka z Cieszyna ma na imię Dąbrówka."
                            },
                            {
                                "example_id": "91de0bc3-7ef4-4cbf-a235-9a8949c95b5d",
                                "sense_id": "21a0cd35-9b73-3c9b-af6e-09031d135ee3",
                                "text": "Spotkanie odbyło się w szerszym gronie niż poprzednie, ponieważ do zaangażowanych w projekt stowarzyszeń morskich dołączyli przedstawiciele Politechniki Gdańskiej: dr inż. Maria Głowacka, dr inż. Krzysztof Krzysztofowicz, dr inż. Jacek Łubiński, dr Dąbrówka Tyślewicz oraz przedstawiciele Pomorskiego Związku Żeglarskiego reprezentowanego przez prezesa Bogusława Witkowskiego"
                            },
                            {
                                "example_id": "259e9645-a0ce-48c3-951d-1a1c8e6d16c5",
                                "sense_id": "21a0cd35-9b73-3c9b-af6e-09031d135ee3",
                                "text": "Jedna z legend mówi o nieznanym królu, który wraz z całym hufcem rycerzy legł na dnie jeziora; inna mówi, że w grodzie na wyspie przyszedł na świat Bolesław Chrobry, syn Mieszka I i Dąbrówki"
                            },
                            {
                                "example_id": "9a36c0e5-4d76-4c35-bfd4-0d1a2bd5b76e",
                                "sense_id": "21a0cd35-9b73-3c9b-af6e-09031d135ee3",
                                "text": "Dąbrówki imieniny obchodzą 15 stycznia."
                            },
                            {
                                "example_id": "dba36d18-928c-4899-9f63-645be8eae0d0",
                                "sense_id": "21a0cd35-9b73-3c9b-af6e-09031d135ee3",
                                "text": "Poważną rolę w historii Polski odgrywają żony książąt, jak Niemki – Oda, Ryksa i Judyta Maria, Czeszki – Dąbrówka i Judyta, Rusinki – Maria Dobrogniewa i Zbysława, żona Mieszka, syna Bolesława Śmiałego."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
