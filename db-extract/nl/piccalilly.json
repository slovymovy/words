                        "examples": [
                            {
                                "example_id": "a22b0d51-1bd2-4097-8244-11778e3703cf",
                                "sense_id": "0070975c-74f9-3286-8115-25e5cda2583a",
                                "text": "Twee dikke boterhammen zijn rijkelijk voorzien van kipsla, groene sla en piccalilly-uitjes voor crunchy plezier, en van verrukkelijke pastrami van het Holsteinrund met zuurkool."
                            },
                            {
                                "example_id": "97bbe0b3-e7ad-43d1-baa0-1e9fd704a359",
                                "sense_id": "0070975c-74f9-3286-8115-25e5cda2583a",
                                "text": "Ingeborg ontwikkelt haar ‘frietje stoofvlees’, Marco legt eer in met de door hem gecreëerde piccalilly. En soms hangt ineens Jonnie Boer van sterrenrestaurant De Librije aan de lijn omdat hij friet voor het hele personeel wil hebben."
                            }
                        ]
                    }
