                "senses": [
                    {
                        "sense_id": "47498705-add9-3b62-976f-b5ea36b3eb79",
                        "entry_id": "5a90c4d5-7004-35f2-b616-86c151b09451",
                        "glosses": [
                            "To speak or write in the manner of a tragedy; to adopt a grandiloquent style."
                        ],
                        "tags": [
                            "obsolete",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "96bf36b3-0079-40ef-b376-12aa41750add",
                                "sense_id": "47498705-add9-3b62-976f-b5ea36b3eb79",
                                "text": "How shall I omit those ungardenlike gardens, void of pot-herbs? or the Augean store, which we cleared out and spread over them; what time we worked the hillside plough, vine-planter I, and awful you, with this neck and hands, which still bear the marks of the toil (O earth and sun, air and virtue! for I will tragicize a bit), not the Hellespont to yoke, but to level the steep."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e47e6ed-323c-34ed-9608-e6f4c425d3b9",
                        "entry_id": "5a90c4d5-7004-35f2-b616-86c151b09451",
                        "glosses": [
                            "To turn (someone or something) into tragedy; to make tragic."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "67edc1cd-b9d6-478d-9422-ce3a1c039869",
                                "sense_id": "8e47e6ed-323c-34ed-9608-e6f4c425d3b9",
                                "text": "I like to be tragic, I like to be funny / For in less than a century / Comic will have been tragicized / Tragedy comicalized."
                            },
                            {
                                "example_id": "49fec4ba-13a9-441e-af95-e4e476142268",
                                "sense_id": "8e47e6ed-323c-34ed-9608-e6f4c425d3b9",
                                "text": "Fired and, in effect, executed too, Phillip Loeb had to be tragicized, like the Rosenbergs […]."
                            }
                        ]
                    }
