                        "examples": [
                            {
                                "example_id": "66f196c3-6195-42fc-88e9-df0b81a6ab0d",
                                "sense_id": "8a32a669-279d-3b0c-8992-4f6adc9b2c14",
                                "text": "Que la plupart des prostituées s'auto-affilient à la première catégorie — celle des non-vicieuses — n'invalide pas la distinction."
                            },
                            {
                                "example_id": "c5c55cd3-db89-4848-a93c-5d816c727c6d",
                                "sense_id": "8a32a669-279d-3b0c-8992-4f6adc9b2c14",
                                "text": "Attention, il est interdit de s'auto-affilier."
                            },
                            {
                                "example_id": "20ad0224-589b-4646-a553-4ba157b70886",
                                "sense_id": "8a32a669-279d-3b0c-8992-4f6adc9b2c14",
                                "text": "Avant tout achat il faudrait toujours s'auto-affilier non?"
