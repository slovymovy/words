{
    "word_family": [
        "injury",
        "injurious",
        "uninjured"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "89cb4dc2-0b00-313f-823c-5d896988be2a",
                    "sense_definition": "To wound or cause physical harm to a living creature.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_harm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rugby team's star player got <w>injured</w> in a violent collision.",
                            "target_lang_translations": {
                                "ru": "Звездный игрок команды по регби получил <w>травму</w> в результате сильного столкновения."
                            }
                        },
                        {
                            "text": "I <w>injured</w> my ankle while playing tennis yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера во время игры в теннис я <w>повредил</w> лодыжку."
                            }
                        }
                    ],
                    "synonyms": [
                        "harm",
                        "hurt",
                        "wound"
                    ],
                    "antonyms": [
                        "help"
                    ],
                    "common_phrases": [
                        "injure my ankle",
                        "injure a player"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ранить или причинить физический вред живому существу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "травмировать",
                                "target_lang_sense_clarification": "нанести травму"
                            },
                            {
                                "target_lang_word": "повредить",
                                "target_lang_sense_clarification": "часть тела или орган"
                            },
                            {
                                "target_lang_word": "ранить",
                                "target_lang_sense_clarification": "нанести рану"
                            },
                            {
                                "target_lang_word": "поранить",
                                "target_lang_sense_clarification": "несильно ранить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3b0d674-63a3-34aa-9f69-4f914b78205c",
                    "sense_definition": "To damage or impair something non-physical, such as a reputation or a business.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "damage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scandal could seriously <w>injure</w> his reputation as a reliable politician.",
                            "target_lang_translations": {
                                "ru": "Скандал может серьезно <w>повредить</w> его репутации надежного политика."
                            }
                        },
                        {
                            "text": "High interest rates may <w>injure</w> the economy by reducing consumer spending.",
                            "target_lang_translations": {
                                "ru": "Высокие процентные ставки могут <w>нанести ущерб</w> экономике, сокращая потребительские расходы."
                            }
                        }
                    ],
                    "synonyms": [
                        "damage",
                        "impair",
                        "harm",
                        "ruin"
                    ],
                    "antonyms": [
                        "benefit",
                        "preserve"
                    ],
                    "common_phrases": [
                        "injure his reputation",
                        "injure the economy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Повредить или ухудшить что-то нематериальное, например, репутацию или бизнес."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повредить",
                                "target_lang_sense_clarification": "причинить ущерб"
                            },
                            {
                                "target_lang_word": "нанести ущерб",
                                "target_lang_sense_clarification": "экономике или репутации"
                            },
                            {
                                "target_lang_word": "подорвать",
                                "target_lang_sense_clarification": "авторитет или здоровье"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba4285f2-eeca-322f-8a92-228f00a20999",
                    "sense_definition": "To do injustice to or treat someone unfairly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "injustice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge's biased decision served to <w>injure</w> the rights of the defendant.",
                            "target_lang_translations": {
                                "ru": "Предвзятое решение судьи послужило тому, чтобы <w>ущемить</w> права подсудимого."
                            }
                        },
                        {
                            "text": "To <w>injure</w> a person's dignity is often worse than physical pain.",
                            "target_lang_translations": {
                                "ru": "<w>Оскорбить</w> достоинство человека часто хуже, чем причинить физическую боль."
                            }
                        }
                    ],
                    "synonyms": [
                        "wrong",
                        "abuse"
                    ],
                    "antonyms": [
                        "praise"
                    ],
                    "common_phrases": [
                        "injure someone's dignity",
                        "injure the rights"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поступать несправедливо или ущемлять чьи-либо права или достоинство."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ущемлять",
                                "target_lang_sense_clarification": "права или интересы"
                            },
                            {
                                "target_lang_word": "оскорблять",
                                "target_lang_sense_clarification": "достоинство или чувства"
                            },
                            {
                                "target_lang_word": "задевать",
                                "target_lang_sense_clarification": "самолюбие или честь"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}