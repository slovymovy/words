                ],
                "senses": [
                    {
                        "sense_id": "e677a2d5-d58c-32a6-8e7e-c123e3fc7c2b",
                        "entry_id": "724d751d-93d2-3ef8-9659-aede1b649cd0",
                        "glosses": [
                            "von fortgeschrittenem Alter; erkennbar älter seiend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fd2219d-2a43-4136-b57a-3854ad56a333",
                                "sense_id": "e677a2d5-d58c-32a6-8e7e-c123e3fc7c2b",
                                "text": "„An einem Abend vor nicht allzu langer Zeit saß Herr Schüt, altgeworden und müde, im Sorgenstuhl.“"
                            },
                            {
                                "example_id": "940a5c0d-3baa-4ffa-9992-09b1a9e5dc04",
                                "sense_id": "e677a2d5-d58c-32a6-8e7e-c123e3fc7c2b",
                                "text": "„Von Jahr zu Jahr wächst die Zahl der altgewordenen Diabetiker, schon beträgt die Krankheitsdauer bei 20–25% aller Zuckerkranken mehr als 15 Jahre […].“"
                            },
                            {
                                "example_id": "2ce2bbcd-4a58-47e5-ae90-56134a5e9110",
                                "sense_id": "e677a2d5-d58c-32a6-8e7e-c123e3fc7c2b",
                                "text": "„Nun muß es gerade der junge Arzt sein, bei dem sie und ihr Mann einmal im Jahr ihre altgewordenen Körper untersuchen lassen […].“"
                            },
                            {
                                "example_id": "e2735793-fe16-4f05-b8a4-73bb1ad980f7",
                                "sense_id": "e677a2d5-d58c-32a6-8e7e-c123e3fc7c2b",
                                "text": "„Lediglich schleppten altgewordene Institutionen altgewordene Normen weiter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
