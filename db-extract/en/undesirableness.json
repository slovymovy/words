                "senses": [
                    {
                        "sense_id": "9f462fb4-de1e-3058-b1ea-15c7bce5ce0a",
                        "entry_id": "258d854d-48d8-38d4-b893-99a3ddeb22c4",
                        "glosses": [
                            "The condition or quality of being undesirable."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b660a398-c1d4-4d28-891c-30f345ace917",
                                "sense_id": "9f462fb4-de1e-3058-b1ea-15c7bce5ce0a",
                                "text": "These are the things that are in the world; from these doth sin take all its baits, whereby it enticeth and entangleth our souls. If the heart be filled with the cross of Christ, it casts death and undesirableness upon them all, it leaves no seeming beauty, no appearing pleasure or comeliness in them."
                            },
                            {
                                "example_id": "9e2f263f-d19b-46ab-bda1-78a06c16ecf9",
                                "sense_id": "9f462fb4-de1e-3058-b1ea-15c7bce5ce0a",
                                "text": "The undesirableness of any other house in the same neighbourhood for Sir Walter was certainly much strengthened by one part, and a very material part of the scheme, which had been happily engrafted on the beginning. He was not only to quit his home, but to see it in the hands of others; a trial of fortitude, which stronger heads than Sir Walter’s have found too much."
                            },
                            {
                                "example_id": "ed90af35-4fad-438e-9a21-41a630492f45",
                                "sense_id": "9f462fb4-de1e-3058-b1ea-15c7bce5ce0a",
                                "text": "To discredit the Negro officers in general all sorts of reports were circulated as to their undesirableness. In addition to being humiliated, they were sent to labor battalions or to some remote position to please those who could not bear the thought of having Negro officers in their sight."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc4579ce-780a-3cd8-bed7-47062cf8fbde",
                        "entry_id": "258d854d-48d8-38d4-b893-99a3ddeb22c4",
                        "glosses": [
                            "An undesirable quality or thing."
                        ],
                        "tags": [
                            "countable",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "983ebd18-f4c9-449a-aa3e-e1b377007e86",
                                "sense_id": "bc4579ce-780a-3cd8-bed7-47062cf8fbde",
                                "text": "[…] Harcourt Street combined within its precincts all the undesirablenesses that had existed separately in all the other streets she had visited. It was old and dirty, noisy yet dull, swarming with children, and overrun with costermongers, hand-organs, and cats."
                            }
                        ]
                    }
