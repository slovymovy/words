                "senses": [
                    {
                        "sense_id": "cde9459e-d0ce-3a51-a76a-2f2892f4004f",
                        "entry_id": "184e0723-4544-34d1-8f49-a3971fe9659b",
                        "glosses": [
                            "rzecz. odczas. od rokować"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "89b2e08e-48a4-30c9-8066-9844b995d934",
                        "entry_id": "184e0723-4544-34d1-8f49-a3971fe9659b",
                        "glosses": [
                            "prognoza, prognostyk, przepowiednia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3970b2e-cc7b-4543-88d0-22be914e1c7b",
                                "sense_id": "89b2e08e-48a4-30c9-8066-9844b995d934",
                                "text": "Jeżeli nieleczony pies przeżyje fazę ostrą zatrucia i nie wystąpi u niego wstrząs, wówczas rokowanie jest pomyślne."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6154c14-5aef-4d0c-b344-972063135f0f",
                        "source_entry_id": "184e0723-4544-34d1-8f49-a3971fe9659b",
                        "source_sense_id": "89b2e08e-48a4-30c9-8066-9844b995d934",
                        "target_lang_word": "pronostic",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pronostic",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "deee28a7-8917-3f03-af5e-92080e934aaf",
                                        "entry_id": "c8cad2ca-5bc6-3b2b-8677-f81bd39c109d",
                                        "glosses": [
                                            "Jugement conjectural sur ce qui doit arriver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12a837c4-440e-4575-a379-86439ec3c82f",
                                                "sense_id": "deee28a7-8917-3f03-af5e-92080e934aaf",
                                                "text": "Plus la situation sera critique, plus le pronostic devra être positif pour profiter d’un respirateur. Et il ne s’agit pas d’un choix entre deux personnes."
                                            },
                                            {
                                                "example_id": "b82289d4-2dd4-43f8-991b-29e063a3be25",
                                                "sense_id": "deee28a7-8917-3f03-af5e-92080e934aaf",
                                                "text": "Son expérience des affaires donne une particulière autorité à ses pronostics."
                                            },
                                            {
                                                "example_id": "7cb3906d-8f03-4c5c-9362-966ea54b72fa",
                                                "sense_id": "deee28a7-8917-3f03-af5e-92080e934aaf",
                                                "text": "Il n’est généralement pas heureux dans ses pronostics."
                                            },
                                            {
                                                "example_id": "7316bdd6-20e0-478e-9f29-b44835eff160",
                                                "sense_id": "deee28a7-8917-3f03-af5e-92080e934aaf",
                                                "text": "Le pronostic des médecins a été peu rassurant."
                                            },
                                            {
                                                "example_id": "30db0830-71dc-4f36-a331-8fc8c1dd8ded",
                                                "sense_id": "deee28a7-8917-3f03-af5e-92080e934aaf",
                                                "text": "Les hommes politiques se trompent souvent dans leurs pronostics."
                                            },
                                            {
                                                "example_id": "b739ff64-2d50-4a4f-b788-f68fae1a2899",
                                                "sense_id": "deee28a7-8917-3f03-af5e-92080e934aaf",
                                                "text": "Il m’a donné ses pronostics pour cette course."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de5085e2-f64f-3415-9fae-b10797a1f924",
                                        "entry_id": "c8cad2ca-5bc6-3b2b-8677-f81bd39c109d",
                                        "glosses": [
                                            "Signe par lequel on conjecture ce qui doit arriver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dc186b4-34c9-4d9f-ab08-a11e63aa48bf",
                                                "sense_id": "de5085e2-f64f-3415-9fae-b10797a1f924",
                                                "text": "Ce revers fut le pronostic de sa chute."
                                            },
                                            {
                                                "example_id": "94b7c2cb-e0af-4617-b919-72d7a38c807c",
                                                "sense_id": "de5085e2-f64f-3415-9fae-b10797a1f924",
                                                "text": "Cela me paraît être d’un heureux pronostic."
                                            },
                                            {
                                                "example_id": "ea80d3a1-3636-46d9-b357-48c3439e7b9d",
                                                "sense_id": "de5085e2-f64f-3415-9fae-b10797a1f924",
                                                "text": "Je regarde ce petit événement comme un pronostic favorable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
