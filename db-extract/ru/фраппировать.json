                ],
                "senses": [
                    {
                        "sense_id": "df3e33a1-0639-3fc1-a8f3-5e8c233566de",
                        "entry_id": "6c2d86cc-6a8c-321e-a600-e95f2f41e9e2",
                        "glosses": [
                            "устар. неприятно поражать, удивлять, ошеломлять"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b066d348-af99-4150-bfa5-7c703935f595",
                                "sense_id": "df3e33a1-0639-3fc1-a8f3-5e8c233566de",
                                "text": "Знал бы только, что это вас так фраппирует, так я бы совсем и не начал-с… А я-то ведь думал, что вам уже всё известно от самой Варвары Петровны!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed8b2a4e-3c41-48cc-9dfc-7f6af6a9a1be",
                        "source_entry_id": "6c2d86cc-6a8c-321e-a600-e95f2f41e9e2",
                        "source_sense_id": "df3e33a1-0639-3fc1-a8f3-5e8c233566de",
                        "target_lang_word": "frapper",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frapper",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "75b883f1-ef75-3147-9951-072c5993a0f8",
                                        "entry_id": "37dc7b30-33fc-3b6d-beb7-21734a7a2b62",
                                        "glosses": [
                                            "Donner un ou plusieurs coups à quelqu’un, à quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2418e49-a228-46b6-83a3-1f6973b4e0df",
                                                "sense_id": "75b883f1-ef75-3147-9951-072c5993a0f8",
                                                "text": "Le visage de Félicité s’empourpra d’une joie chaude. Elle se mit sur son séant, frappant comme une enfant dans ses mains sèches de petite vieille."
                                            },
                                            {
                                                "example_id": "0d954346-cf2e-48e0-a9d2-1c8755c9e472",
                                                "sense_id": "75b883f1-ef75-3147-9951-072c5993a0f8",
                                                "text": "Dans les premiers âges historiques, on ne voit pas seulement les maîtres frapper et fouetter leurs esclaves ; les rois eux-mêmes administrent le supplice de la bastonnade."
                                            },
                                            {
                                                "example_id": "1285b983-408d-40fc-a8b7-92b97b444773",
                                                "sense_id": "75b883f1-ef75-3147-9951-072c5993a0f8",
                                                "text": "Surprenant un homme qui volait la ration d’un camarade, il l’invectiva et le frappa à la face."
                                            },
                                            {
                                                "example_id": "6ff58aa2-350a-410b-8190-7041df0fc7f7",
                                                "sense_id": "75b883f1-ef75-3147-9951-072c5993a0f8",
                                                "text": "Les deux danseurs à tour de rôle s’agitaient en frappant sur un tambourin de peaux de phoque. Ce n’était pas beaucoup plus étrange que le charleston ou le black-bottom."
                                            },
                                            {
                                                "example_id": "1ac2b159-75f3-4e9e-82dc-79293981deef",
                                                "sense_id": "75b883f1-ef75-3147-9951-072c5993a0f8",
                                                "text": "L’infortuné n’avait pas eu le temps de presser ce bouton. Déjà ses assaillants le frappaient, sauvagement, par derrière."
                                            },
                                            {
                                                "example_id": "45bf66a2-172c-4d2c-a9ce-91dfe2d0ed74",
                                                "sense_id": "75b883f1-ef75-3147-9951-072c5993a0f8",
                                                "text": "Il reste à trouver celui qui t’a frappé avec une barre de fer. Celui qui ordonna à quelqu’un d’ordonner à quelqu’un qui ordonna à quelqu’un d’autre de te tuer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d233312e-bc00-30e3-8638-b55c43880dd8",
                                        "entry_id": "37dc7b30-33fc-3b6d-beb7-21734a7a2b62",
                                        "glosses": [
                                            "Donner des coups à une porte pour signaler sa présence et se faire ouvrir."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6aea273b-b799-400e-9a78-16142f02be67",
                                                "sense_id": "d233312e-bc00-30e3-8638-b55c43880dd8",
                                                "text": "Ne m’avez-vous pas dit qu’un instant avant que nous arrivassions, un homme sans chapeau, […], était venu frapper à la porte, et qu’on lui avait ouvert ?"
                                            },
                                            {
                                                "example_id": "a5e182ed-d438-434f-94f9-4f0f922bd6c3",
                                                "sense_id": "d233312e-bc00-30e3-8638-b55c43880dd8",
                                                "text": "Toute la nuit, nous entendons marcher, devant les chambres, des gens chaussés de souliers. De temps en temps, les pas s’arrêtent : on frappe à quelque porte, d’un doigt seulement, et il est amusant de se dire que malgré cela, la dame qui habite cette chambre a bien reconnu tout de suite, à sa manière de frapper, celui qui est là."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e235ce7c-222d-3f7d-b79e-1e078bd7e274",
                                        "entry_id": "37dc7b30-33fc-3b6d-beb7-21734a7a2b62",
                                        "glosses": [
                                            "Donner une empreinte à quelque chose, au moyen d’une matrice ou autrement."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f4989b8-4470-4483-87f6-96a50d4c22c1",
                                                "sense_id": "e235ce7c-222d-3f7d-b79e-1e078bd7e274",
                                                "text": "Frapper de la monnaie. Frapper des médailles."
                                            },
                                            {
                                                "example_id": "0935ba78-6be2-4003-a4ca-412b92a0f1e0",
                                                "sense_id": "e235ce7c-222d-3f7d-b79e-1e078bd7e274",
                                                "text": "Retenant et prodiguant les phrases toutes faites qui se frappent régulièrement à Paris pour donner en petite monnaie aux sots le sens des grandes idées ou des faits, les gens du monde le réputèrent homme de goût et de savoir. — (Honoré de Balzac, La Femme de trente ans, Paris, 1832)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9176982f-8de3-3b6d-be2c-3778360e0634",
                                        "entry_id": "37dc7b30-33fc-3b6d-beb7-21734a7a2b62",
                                        "glosses": [
                                            "Battre de la monnaie physique, des espèces."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ba14b9c-2113-46ec-98b3-868c9b155a2c",
                                                "sense_id": "9176982f-8de3-3b6d-be2c-3778360e0634",
                                                "text": "Banassac, qui avait fabriqué des poteries sous les Romains, frappa alors des monnaies et ce village peut « revendiquer la dixième partie des monnaies mérovingiennes éparses dans tous les cabinets du monde »."
                                            },
                                            {
                                                "example_id": "b27297b1-7368-41a2-bc93-fc7e97a126fa",
                                                "sense_id": "9176982f-8de3-3b6d-be2c-3778360e0634",
                                                "text": "Il s'agit d'une version adaptée du portrait créé par le sculpteur Martin Jennings pour Royal Mint, l'organisme chargé de frapper la monnaie britannique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95ed9721-5a8a-3a79-a30b-1aed606b2f45",
                                        "entry_id": "37dc7b30-33fc-3b6d-beb7-21734a7a2b62",
                                        "glosses": [
                                            "Se diriger vers, tomber sur, en parlant de la lumière"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b61c3418-ac3a-4428-9dcc-6bc106d68cf9",
                                                "sense_id": "95ed9721-5a8a-3a79-a30b-1aed606b2f45",
                                                "text": "Les parties d’un objet que la lumière frappe, où la lumière frappe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90c1143f-4ddb-3d14-b11b-679eab2cf229",
                                        "entry_id": "37dc7b30-33fc-3b6d-beb7-21734a7a2b62",
                                        "glosses": [
                                            "Faire de l’impression sur les sens, sur l’esprit, sur l’âme."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da05064c-4e69-4861-9f68-d6681c1b9596",
                                                "sense_id": "90c1143f-4ddb-3d14-b11b-679eab2cf229",
                                                "text": "Le bruit sourd de la chute, les flots de sang qui jaillirent du corps et diaprèrent au loin le pavé, frappèrent d’épouvante jusqu’au duc lui-même."
                                            },
                                            {
                                                "example_id": "840aa496-396a-4a21-964d-531b2828477a",
                                                "sense_id": "90c1143f-4ddb-3d14-b11b-679eab2cf229",
                                                "text": "Mais un appel connu des Bretons frappa son oreille : le chant du hibou, qui fut le cri de ralliement des Chouans et qu'on n'entend jamais à Paris."
                                            },
                                            {
                                                "example_id": "97abe48d-5e90-43fe-8b93-c5b75ccb36bb",
                                                "sense_id": "90c1143f-4ddb-3d14-b11b-679eab2cf229",
                                                "text": "Ce qui me frappait le plus en lui, c’était le sourire le plus franc, le plus engageant que j’aie jamais vu sur aucune face humaine."
                                            },
                                            {
                                                "example_id": "0ff16482-ed85-4628-9148-f98575006b28",
                                                "sense_id": "90c1143f-4ddb-3d14-b11b-679eab2cf229",
                                                "text": "Si l’on met à part les simples témoignages d’argotiers proprement dits ou de personnes les fréquentant professionnellement (policiers, magistrats), ce qui frappe c’est le caractère relativement tardif des études consacrées aux argots."
                                            },
                                            {
                                                "example_id": "103e41e9-275e-4b5e-b176-58ad0d500fca",
                                                "sense_id": "90c1143f-4ddb-3d14-b11b-679eab2cf229",
                                                "text": "Ce qui m’a frappé est la capacité des États à suspendre les libertés en invoquant un principe supérieur qui est « la santé », qui pourrait être très bien un jour la sécurité, qui pourrait être d’autres maladies. Et ce qui m’a frappé aussi est qu’un conseil de défense, occulte et opaque, puisse décider, sans qu’on sache sur quelles bases, qu’on ne peut pas sortir de chez soi sans que la police mette une amende sauf si l’on va travailler et faire des courses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38ca174f-6231-3b74-9169-9253f842f375",
                                        "entry_id": "37dc7b30-33fc-3b6d-beb7-21734a7a2b62",
                                        "glosses": [
                                            "Faire périr, exterminer, ou affliger par quelque grand malheur, par une calamité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1de6f6ba-4f44-4cfc-8be2-354ed517ce3d",
                                                "sense_id": "38ca174f-6231-3b74-9169-9253f842f375",
                                                "text": "C'était un de ces copains-là, un de ceux dont les parents travaillaient depuis toujours dans les usines de « Sainté », et dont les familles étaient frappées de plein fouet par la brutalité des licenciements, qui était venu me parler le lendemain, quand j'étais rentrée de l'enterrement."
                                            },
                                            {
                                                "example_id": "138b40c5-798e-43cd-bebd-43d13fe6c5f2",
                                                "sense_id": "38ca174f-6231-3b74-9169-9253f842f375",
                                                "text": "Le précédent record de 1,85 million de kilos de denrées avait été établi en janvier. À titre de comparaison, un peu plus de 1,2 million de kilos avaient été distribués en février 2020, avant que l'épidémie ne frappe le Québec."
                                            },
                                            {
                                                "example_id": "cadcb195-7c09-424f-8916-b6017274267a",
                                                "sense_id": "38ca174f-6231-3b74-9169-9253f842f375",
                                                "text": "Mais il comprit que oui, ils l'imaginaient et qu'il fallait frapper un grand coup s'il voulait les mettre à genoux, les obliger à capituler et terminer ainsi des combats aussi sanglants qu’inutiles et démoralisants pour ses hommes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e66a55c-77bb-36b1-a15c-bba07ad1c3e8",
                                        "entry_id": "37dc7b30-33fc-3b6d-beb7-21734a7a2b62",
                                        "glosses": [
                                            "Être établi, assigné sur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11a1a825-3077-41ea-8a3a-a01b4d689832",
                                                "sense_id": "5e66a55c-77bb-36b1-a15c-bba07ad1c3e8",
                                                "text": "Je le répète, il n’entre pas dans ma pensée, ni dans mon sujet, d’insister particulièrement sur ce personnage […] qui, d’ailleurs, vient d’être frappé durement par un rigoureux arrêt de cour d’assises."
                                            },
                                            {
                                                "example_id": "d6cb05b7-164f-4276-90b9-2b377ef35d2a",
                                                "sense_id": "5e66a55c-77bb-36b1-a15c-bba07ad1c3e8",
                                                "text": "Une hypothèque qui frappe tous les biens du débiteur. Un immeuble frappé d’hypothèques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb88cc22-cd9a-3e4f-8274-2df170c55a1b",
                                        "entry_id": "37dc7b30-33fc-3b6d-beb7-21734a7a2b62",
                                        "glosses": [
                                            "Rafraîchir ; rendre extrêmement frais par le moyen de la glace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec76ea4b-8a1b-4338-be92-e0abbb01a984",
                                                "sense_id": "eb88cc22-cd9a-3e4f-8274-2df170c55a1b",
                                                "text": "Frapper le champagne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60537bf6-026a-3078-880b-130dabe970e8",
                                        "entry_id": "37dc7b30-33fc-3b6d-beb7-21734a7a2b62",
                                        "glosses": [
                                            "Se donner des coups à soi-même."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "498aee16-d021-4c9c-b7e4-280d7cd48104",
                                                "sense_id": "60537bf6-026a-3078-880b-130dabe970e8",
                                                "text": "Se frapper la poitrine, montrer qu’on se sent coupable, qu’on s’en veut d’avoir mal agi. → voir battre sa coulpe."
                                            },
                                            {
                                                "example_id": "79b9f17d-9211-4fd4-9c5e-b7b496095436",
                                                "sense_id": "60537bf6-026a-3078-880b-130dabe970e8",
                                                "text": "Se frapper le front, montrer qu’on vient de trouver la solution d’un problème ou qu’on met en doute la santé mentale de quelqu’un."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7adee8ea-7dd5-39d0-b340-88f68535bde2",
                                        "entry_id": "37dc7b30-33fc-3b6d-beb7-21734a7a2b62",
                                        "glosses": [
                                            "Avoir des pensées négatives, se faire du souci."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a87ec8d1-c225-4df9-b764-28e766be3e96",
                                                "sense_id": "7adee8ea-7dd5-39d0-b340-88f68535bde2",
                                                "text": "Ne vous frappez pas pour ces balivernes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8bd0a95-bd59-3087-a629-13c946837b84",
                                        "entry_id": "37dc7b30-33fc-3b6d-beb7-21734a7a2b62",
                                        "glosses": [
                                            "Fixer, attacher avec un nœud."
                                        ],
                                        "tags": [],
                                        "note": "Ne pas confondre avec l’expression québécoise frapper un nœud",
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "63760ee5-8d51-310a-8ffb-118d32baf598",
                                        "entry_id": "37dc7b30-33fc-3b6d-beb7-21734a7a2b62",
                                        "glosses": [
                                            "Escroquer."
                                        ],
                                        "tags": [
                                            "Cameroun"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
