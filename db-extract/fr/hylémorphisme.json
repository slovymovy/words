                ],
                "senses": [
                    {
                        "sense_id": "adb98f86-aebf-34ff-b9c3-b05c0350233b",
                        "entry_id": "4b4d63d8-1187-3f17-ab5d-496937152a4d",
                        "glosses": [
                            "Philosophie aristotélicienne qui considère que tout être, — objet ou individu —, est composé de manière indissociable d’une matière et d’une forme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "887a68b3-9050-45dc-b983-7847bf6e079b",
                                "sense_id": "adb98f86-aebf-34ff-b9c3-b05c0350233b",
                                "text": "Pour se soustraire à cette disgrâce suprême qui consisterait à choir dans le polythéisme, il faut, ou bien recourir à l’expédient des Augustiniens de Duns Scot et de Suarez : soutenir l’hylémorphisme des Anges et des âmes désincarnées, et se mettre en contradiction avec la lettre des Écritures ; ou bien…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6cc86e34-8e80-4c6d-862d-c609be20b168",
                        "source_entry_id": "4b4d63d8-1187-3f17-ab5d-496937152a4d",
                        "source_sense_id": "adb98f86-aebf-34ff-b9c3-b05c0350233b",
                        "target_lang_word": "Hylemorphismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hylemorphismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dd5e016f-5a9e-33dc-b4ba-237e6cff998c",
                                        "entry_id": "02d139ee-199a-3c7e-a815-e59b6348a442",
                                        "glosses": [
                                            "naturphilosophische Lehre des Aristoteles, nach der sich alle körperlichen Einzeldinge aus den beiden Prinzipien des Stoffes und der Form zusammensetzen"
                                        ],
                                        "tags": [
                                            "ὕλη (hylē^☆) ^(→ grc",
                                            "μορφή (morphē^☆) ^(→ grc"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb446260-8dce-4840-85f2-79935173addd",
                                                "sense_id": "dd5e016f-5a9e-33dc-b4ba-237e6cff998c",
                                                "text": "„Wenn aber Natur für Aristoteles der Inbegriff bewegter Körper ist, so fragt sich, woran und wie sich Bewegungen vollziehen. Hierfür prägt er das Begriffspaar von „Stoff (hylê)“ und „Form (morphê […])“, so dass diese Theorie später auch Hylemorphismus genannt wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
