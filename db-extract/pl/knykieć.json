                                "target_senses": [
                                    {
                                        "sense_id": "7e7fa7ab-db47-323b-b997-07f9701cb270",
                                        "entry_id": "7fdbf9d9-3c4a-37f8-a736-c9878d465ddb",
                                        "glosses": [
                                            "Any of the joints between the bones of the fingers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "743f5771-d042-344f-84f4-17abdd3a5f6d",
                                        "entry_id": "7fdbf9d9-3c4a-37f8-a736-c9878d465ddb",
                                        "glosses": [
                                            "A mechanical joint."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0c3fbf01-2905-3a1f-a777-c2b05132d64f",
                                        "entry_id": "7fdbf9d9-3c4a-37f8-a736-c9878d465ddb",
                                        "glosses": [
                                            "The curved part of the cushion at the entrance to the pockets on a cue sports table."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "15e48852-077f-3199-b179-33658d9f11a0",
                                        "entry_id": "7fdbf9d9-3c4a-37f8-a736-c9878d465ddb",
                                        "glosses": [
                                            "The kneejoint of a quadruped, especially of a calf; formerly, the kneejoint of a human being."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9aad35bf-1f06-434d-80a7-2b14c50878d9",
                                                "sense_id": "15e48852-077f-3199-b179-33658d9f11a0",
                                                "text": "With wearie knockles on thy brim she kneeled sadly downe"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "375817d8-4e6c-3849-8077-3d3008ca8927",
                                        "entry_id": "7fdbf9d9-3c4a-37f8-a736-c9878d465ddb",
                                        "glosses": [
                                            "A cut of meat of various kinds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89ec45bc-d644-4898-a4de-8d77fe82103e",
                                                "sense_id": "375817d8-4e6c-3849-8077-3d3008ca8927",
                                                "text": "Beef knuckle is from the knee joint. Pork knuckle, or ham hock, is from the joint between the tibia/fibula and the metatarsals of the foot of a pig, where the foot was attached to the leg."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cc25060-7e92-3de5-9d18-e6147e0d9372",
                                        "entry_id": "7fdbf9d9-3c4a-37f8-a736-c9878d465ddb",
                                        "glosses": [
                                            "The joint of a plant."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdd213a4-e829-4382-b13d-f1a3d21cbe37",
                                                "sense_id": "2cc25060-7e92-3de5-9d18-e6147e0d9372",
                                                "text": "In the West Indies there are found, even in sandy deserts and very dry places, large canes, which at every joint or knuckle yield a good supply of fresh water"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a149a18e-57a8-3d87-9346-dc7b9f5baacf",
                                        "entry_id": "7fdbf9d9-3c4a-37f8-a736-c9878d465ddb",
                                        "glosses": [
                                            "A convex portion of a vessel's figure where a sudden change of shape occurs, as in a canal boat, where a nearly vertical side joins a nearly flat bottom."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c2d9b3bc-5e75-3759-8bda-9b69c3d3a1a7",
                                        "entry_id": "7fdbf9d9-3c4a-37f8-a736-c9878d465ddb",
                                        "glosses": [
                                            "A contrivance, usually of brass or iron, and furnished with points, worn to protect the hand, to add force to a blow, and to disfigure the person struck; a knuckle duster."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c897977-e263-4283-bb3b-2118b0e4f760",
                                                "sense_id": "c2d9b3bc-5e75-3759-8bda-9b69c3d3a1a7",
                                                "text": "brass knuckles"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46849ae8-a2bf-3d8a-9e19-a6383d3efc2b",
                                        "entry_id": "7fdbf9d9-3c4a-37f8-a736-c9878d465ddb",
                                        "glosses": [
                                            "The rounded point where a flat changes to a slope on a piste."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "knuckle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f2560c4-7e6e-32ad-80bc-97f12c4391ff",
                                        "entry_id": "b5b58d48-c598-309a-a03a-532901937338",
                                        "glosses": [
                                            "To apply pressure, or rub or massage with one's knuckles (sense 1)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1257399-420b-4368-8a27-324d4c42de44",
                                                "sense_id": "0f2560c4-7e6e-32ad-80bc-97f12c4391ff",
                                                "text": "He knuckled the sleep from his eyes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e91fc777-31c2-3f1b-b56b-deacacadf6f4",
                                        "entry_id": "b5b58d48-c598-309a-a03a-532901937338",
                                        "glosses": [
                                            "To strike or punch."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59e27b83-7dd5-4bbd-92f1-889efe6189ba",
                                                "sense_id": "e91fc777-31c2-3f1b-b56b-deacacadf6f4",
                                                "text": "I could feel my big toe snap, but as he's gone down on his good knee and half swung round I knuckled him in the kidney as hard as I could hit. He's gone all the way down, so I dropped my 19 stone into the middle of his back."
                                            },
                                            {
                                                "example_id": "70ef0a73-df84-44c4-96a4-3a571b17f5ce",
                                                "sense_id": "e91fc777-31c2-3f1b-b56b-deacacadf6f4",
                                                "text": "Only then I knuckled him. He had to be taught a hard lesson."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c605a508-002d-327e-854f-a2f0881ad8de",
                                        "entry_id": "b5b58d48-c598-309a-a03a-532901937338",
                                        "glosses": [
                                            "To bend the fingers."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5e7cee56-1929-3874-a251-d49b60251ce5",
                                        "entry_id": "b5b58d48-c598-309a-a03a-532901937338",
                                        "glosses": [
                                            "To touch one's forehead as a mark of respect."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9ddae966-b8f8-39dc-9d15-4e017f4f73ef",
                                        "entry_id": "b5b58d48-c598-309a-a03a-532901937338",
                                        "glosses": [
                                            "To yield."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3fe75104-4020-3e5b-8973-515a837251b5",
                                        "entry_id": "b5b58d48-c598-309a-a03a-532901937338",
                                        "glosses": [
