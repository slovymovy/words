                                    {
                                        "sense_id": "0d24e30c-de07-3c11-805e-2ab42eb44e34",
                                        "entry_id": "d7ee702f-fb2b-30f9-ac4d-432028efb521",
                                        "glosses": [
                                            "umieszczać rzeczy razem w paczce, bagażu, plecaku"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f71ed2d3-aa83-4e4c-995b-6bf6b7b70095",
                                                "sense_id": "0d24e30c-de07-3c11-805e-2ab42eb44e34",
                                                "text": "Pakuję plecak, zabieram aparat i jadę w góry."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "995f34a9-c8af-3ae1-8dd2-d47bacdbcaf3",
                                        "entry_id": "d7ee702f-fb2b-30f9-ac4d-432028efb521",
                                        "glosses": [
                                            "wysiłkowo ćwiczyć na siłowni, podnosić ciężary w celu wzmocnienia mięśni"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f6d5729-7d95-4731-a1e6-21ee38de73c3",
                                                "sense_id": "995f34a9-c8af-3ae1-8dd2-d47bacdbcaf3",
                                                "text": "Od roku pakuję codziennie rano po pół godziny."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "2cf67311-9df1-3fb0-bf42-ddba80860cae",
                                        "entry_id": "d7ee702f-fb2b-30f9-ac4d-432028efb521",
                                        "glosses": [
                                            "(często przenośnie) umieszczać, wsadzać coś gdzieś (najczęściej w dużych ilościach) w sposób szybki, niechlujny"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd4b7e1b-e8be-43e4-9430-d9ef546887c1",
                                                "sense_id": "2cf67311-9df1-3fb0-bf42-ddba80860cae",
                                                "text": "W Chinach za takie coś pakują do pierdla."
                                            },
                                            {
                                                "example_id": "998f2c6a-37c4-4e54-99bc-4f5649d8d488",
                                                "sense_id": "2cf67311-9df1-3fb0-bf42-ddba80860cae",
                                                "text": "(…) i przyznam, że ona pakuje w siebie niezłą kasę, żeby wyglądać, jak wygląda"
