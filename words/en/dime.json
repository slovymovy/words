                {
                    "sense_id": "31dbbb84-ddae-3153-ab71-f1255802f84f",
                    "sense_definition": "An assist in basketball.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sports_terms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The point guard dropped a <dime> to his teammate for an easy dunk.",
                            "target_lang_translations": {
                                "ru": "Разыгрывающий отдал <w>передачу</w> товарищу по команде для легкого данка.",
                                "zh": "控球后卫给队友送出一记<w>助攻</w>，让他轻松完成扣篮。"
                            }
