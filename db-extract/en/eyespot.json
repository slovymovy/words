                        "entry_id": "a74487a8-373a-37a5-8096-e676e48441fd",
                        "glosses": [
                            "Any of various primitive light-sensitive organs or regions in many diverse organisms."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "719338e2-c039-4c2b-881d-cb584d158397",
                                "sense_id": "40ed40ee-7e42-364b-93bc-fed3ab12ec1d",
                                "text": "The eyespot is a complex sandwich of membranes with rows of granules that contain around 200 different proteins, including the same rhodopsins found in the retina of our own eye."
                            }
                        ]
                    },
                    {
                        "sense_id": "5b938550-487b-304c-a7d4-2768a7adc6ec",
                        "entry_id": "a74487a8-373a-37a5-8096-e676e48441fd",
                        "glosses": [
                            "An eye-like marking on the tail of a peacock or the wing of a butterfly."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7b4aac6c-5e35-3db4-b49c-fa0f5a4b2d8e",
                        "entry_id": "a74487a8-373a-37a5-8096-e676e48441fd",
                        "glosses": [
                            "A coloured spot in a motile gamete or spore, which is sensitive to light."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "328a5853-25fb-3e5a-b68f-9611e2737433",
                        "entry_id": "a74487a8-373a-37a5-8096-e676e48441fd",
                        "glosses": [
                            "Any of a group of fungal infections of grasses that are characterized by oval spots; strawbreaker."
                        ],
