                        "cross_references": [
                            {
                                "target_word": "bayou",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ed13382b-716a-3375-aaa7-0dd879a2997f",
                                        "entry_id": "9d9381ed-7efc-3cbb-9cf9-bed6c99cb523",
                                        "glosses": [
                                            "Étendue d’eau stagnante formée par les anciens bras et méandres du Mississippi en Louisiane."
                                        ],
                                        "tags": [
                                            "Louisiane"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06f29259-6b81-40c7-beb5-eb5dec92e3cc",
                                                "sense_id": "ed13382b-716a-3375-aaa7-0dd879a2997f",
                                                "text": "Mais Wright ne peut songer non plus à destiner ses livres aux racistes blancs de Virginie ou de Caroline, dont le siège est fait d’avance et qui ne les ouvriront pas. Ni aux paysans noirs des bayous, qui ne savent pas lire."
                                            },
                                            {
                                                "example_id": "faf25913-2bcd-4742-9c42-0dc37dc78a6c",
                                                "sense_id": "ed13382b-716a-3375-aaa7-0dd879a2997f",
                                                "text": "Des barrages flottants ont été déployés sur près de 50 km pour tenter de limiter l’avancée du pétrole et l’empêcher d’atteindre les côtes de la Louisiane et ses « bayous »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbaac24a-265a-3db7-8e28-e00f0d255d30",
                                        "entry_id": "9d9381ed-7efc-3cbb-9cf9-bed6c99cb523",
                                        "glosses": [
                                            "Grande région marécageuse du sud de la Louisiane."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10be1c8c-8f54-4032-8198-489d89e18ccf",
                                                "sense_id": "dbaac24a-265a-3db7-8e28-e00f0d255d30",
                                                "text": "Comme la majorité des habitants de l’Isle de Jean Charles, Wenceslas et Robert sont des membres de la nation biloxi-chitimacha-choctaw. Un des groupes autochtones de la grande famille des Houmas, qui se sont réfugiés dans les bayous de la Louisiane autour de 1830."
                                            },
                                            {
                                                "example_id": "06b1140b-54f8-4456-ba28-6514dc5cf88c",
                                                "sense_id": "dbaac24a-265a-3db7-8e28-e00f0d255d30",
                                                "text": "Le bureau se trouve au dix-septième étage avec vue sur les gratte-ciel de Houston et sur les basses terres et sur le chenal navigable et jusqu'au bayou. — (Cormac McCarthy, No country for old men - Non, ce pays n'est pas pour le vieil homme, traduction par François Hirsch, 2005, édition de l'Olivier, 2006, Collection Points, page 133)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
