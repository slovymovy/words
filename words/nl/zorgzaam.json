            "senses": [
                {
                    "sense_id": "59e97c67-7eaf-3556-bab8-7e0de8b195b4",
                    "sense_definition": "geneigd tot het verlenen van liefdevolle aandacht en hulp aan anderen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>zorgzame</w> verpleegkundige was zeer vriendelijk tegen haar oude patiënt.",
                            "target_lang_translations": {
                                "en": "The <w>caring</w> nurse was very friendly to her elderly patient."
                            }
                        },
                        {
                            "text": "Zij is een erg <w>zorgzame</w> moeder die altijd voor haar kinderen klaarstaat.",
                            "target_lang_translations": {
                                "en": "She is a very <w>nurturing</w> mother who is always there for her children."
                            }
                        }
                    ],
                    "synonyms": [
