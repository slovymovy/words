            "senses": [
                {
                    "sense_id": "9f47999c-d830-3aec-b507-618b0410cb1d",
                    "sense_definition": "Attendre avec confiance la réalisation d'un souhait ou d'un événement favorable.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'<w>espère</w> que tu vas bien et que nous nous verrons très bientôt."
                        },
                        {
                            "text": "Nous <w>espérons</w> passer d'excellentes vacances à la mer cet été."
                        }
                    ],
                    "common_phrases": [
                        "espérer le meilleur",
                        "oser espérer"
                    ]
                },
                {
                    "sense_id": "12e6cad5-d2d0-3bb5-a27a-32758f754eca",
                    "sense_definition": "Mettre sa confiance et sa foi en quelqu'un ou en quelque chose, particulièrement en une puissance supérieure.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans les moments les plus sombres, il continuait d'<w>espérer</w> en l'avenir."
                        },
                        {
                            "text": "Le vieil homme continue d'<w>espérer</w> en Dieu malgré toutes les difficultés de l'existence."
                        }
                    ],
                    "common_phrases": [
                        "espérer en Dieu"
                    ]
                },
                {
                    "sense_id": "2b5f9de0-458a-3841-900e-5ecdd75283d8",
                    "sense_definition": "Attendre quelqu'un ou quelque chose, patienter.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Espère</w> un instant, je finis ce travail et je viens tout de suite avec toi."
                        },
                        {
                            "text": "Ils ont dû <w>espérer</w> le passage du bus sous la pluie battante."
                        }
                    ],
                    "synonyms": [
                        "attendre",
                        "patienter"
                    ],
                    "common_phrases": [
