                    {
                        "translation_id": "d5523e10-8b76-4502-910d-6b240df87147",
                        "source_entry_id": "dabd8f19-8422-375c-9833-b9446652533f",
                        "source_sense_id": "1082641d-27c8-37ec-a8a4-d5921d65f9fe",
                        "target_lang_word": "Geophysik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geophysik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "925c9981-3b45-3c4f-97c3-1a484bd027df",
                                        "entry_id": "c51446b3-a14f-3a17-b0cd-ee23a9afbeeb",
                                        "glosses": [
                                            "Wissenschaft von den physikalischen Eigenschaften und Vorgängen der Erdkruste und des Erdinnern"
                                        ],
                                        "tags": [
                                            "im engeren Sinn"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea743b0b-a646-444f-a3c2-fdc5b6ae1018",
                                                "sense_id": "925c9981-3b45-3c4f-97c3-1a484bd027df",
                                                "text": "„Mit der Entdeckung der Röntgenbeugung konnte man die mineralogische Zusammensetzung auch von feinkristallinen Gesteinen bestimmen, mit der Entwicklung der Geophysik gewann man erstmals Erkenntnisse über das Innere der Erde.“"
                                            },
                                            {
                                                "example_id": "fca111e3-5100-44bc-9446-1c226b7a88b7",
                                                "sense_id": "925c9981-3b45-3c4f-97c3-1a484bd027df",
                                                "text": "„Savage und Peterson fanden 1963 mit Hilfe der Geophysik heraus, das sich der obere Teil des Gletschers schneller als der untere Teil bewegt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ff2e4754-8aec-3345-9f55-26ed0f2bd752",
                                        "entry_id": "c51446b3-a14f-3a17-b0cd-ee23a9afbeeb",
                                        "glosses": [
                                            "zusätzlich zu ^([1]) Physik der Ozeane und der Atmosphäre"
                                        ],
                                        "tags": [
                                            "im erweiterten Sinn"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db973487-8dca-447a-a198-10f01bec61e8",
                                                "sense_id": "ff2e4754-8aec-3345-9f55-26ed0f2bd752",
                                                "text": "Im Studium der Geophysik kann man auch Vorlesungen zur tropische und subtropische Meteorologie besuchen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd6e48a3-9185-439b-ad7c-5efdeefeaf0a",
                        "source_entry_id": "dabd8f19-8422-375c-9833-b9446652533f",
