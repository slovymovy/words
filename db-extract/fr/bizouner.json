                "senses": [
                    {
                        "sense_id": "65855a2d-5efa-35f7-9128-e0507455b7fa",
                        "entry_id": "ae304a0c-5290-389a-a922-19288e3b0412",
                        "glosses": [
                            "Bricoler."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "2279e324-db5a-47e0-aca7-4e785aacc7f8",
                                "sense_id": "65855a2d-5efa-35f7-9128-e0507455b7fa",
                                "text": "Ainsi, hier, j’en ai profité pour bizouner dans ma forêt et j’ai découvert un châtaignier d’Amérique."
                            },
                            {
                                "example_id": "d5183072-0a2b-4080-818d-e13cad125f55",
                                "sense_id": "65855a2d-5efa-35f7-9128-e0507455b7fa",
                                "text": "Rarement vu une machine aussi difficile à ouvrir et bizouner."
                            },
                            {
                                "example_id": "6eb2fa01-c8fc-4e5e-923c-298710063b79",
                                "sense_id": "65855a2d-5efa-35f7-9128-e0507455b7fa",
                                "text": "Alors, tu vas varnousser et zigonner... mais n’oublie pas de bizouner!"
                            },
                            {
                                "example_id": "9ddc0506-f941-4cfa-b1da-b508101bbc9e",
                                "sense_id": "65855a2d-5efa-35f7-9128-e0507455b7fa",
                                "text": "Y'a monté des cuves, pis des incubateurs …. C’est des êtres humains synthétiques. Y peut les bizouner presquement comme y veut."
                            }
                        ]
                    }
