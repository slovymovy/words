                        "translation_id": "f2348d4d-e92d-4694-8f7b-716d366132ae",
                        "source_entry_id": "79e82a13-2658-3f25-bc29-d177f843225d",
                        "source_sense_id": "f958e2aa-bfa8-3419-89e8-60887332cd31",
                        "source_sense_description": "Ethnologie, Tanz, Musik: Haka",
                        "target_lang_word": "haka",
