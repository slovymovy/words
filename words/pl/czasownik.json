                {
                    "sense_id": "fb8fad8b-7e6a-3ead-8288-10b3fcb93e8e",
                    "sense_definition": "odmienna część mowy oznaczająca czynności, procesy lub stany",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "gramatyka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W języku polskim każdy <w>czasownik</w> odmienia się przez osoby, liczby i czasy.",
                            "target_lang_translations": {
                                "ru": "В польском языке каждый <w>глагол</w> спрягается по лицам, числам и временам."
                            }
                        },
                        {
                            "text": "Orzeczenie w zdaniu najczęściej jest wyrażone osobową formą <w>czasownika</w>.",
                            "target_lang_translations": {
                                "ru": "Сказуемое в предложении чаще всего выражается личной формой <w>глагола</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "słowo"
                    ],
                    "common_phrases": [
                        "forma czasownika",
                        "odmiana czasownika",
                        "czasownik posiłkowy",
                        "czasownik zwrotny"
                    ],
                    "target_lang_definitions": {
                        "ru": "самостоятельная часть речи, обозначающая действие, процесс или состояние"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глагол",
                                "target_lang_sense_clarification": "часть речи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ab99bc8-9c85-3b18-812c-dca60ea7cce2",
                    "sense_definition": "kronika, latopis zawierający chronologiczny opis wydarzeń",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "historia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Badacz odnalazł w archiwum stary <w>czasownik</w> opisujący dzieje klasztoru.",
                            "target_lang_translations": {
                                "ru": "Исследователь обнаружил в архиве старую <w>летопись</w>, описывающую историю монастыря."
                            }
                        },
                        {
                            "text": "Średniowieczny <w>czasownik</w> zawierał szczegółowe wzmianki o ówczesnych bitwach.",
                            "target_lang_translations": {
                                "ru": "Средневековая <w>хроника</w> содержала подробные упоминания о тогдашних битвах."
                            }
                        }
                    ],
                    "synonyms": [
                        "kronika",
                        "latopis"
                    ],
                    "traits": [
