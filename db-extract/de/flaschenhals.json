                "senses": [
                    {
                        "sense_id": "7fdc577d-1248-3a66-9b9c-5f55e92b681c",
                        "entry_id": "0179533f-4971-3467-a234-54243576a04e",
                        "glosses": [
                            "oberer, dünnerer Teil einer Flasche, an dessen Ende sich (normalerweise) die Öffnung befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1b3d97c-92f2-434f-8e9d-6aedcbcaf664",
                                "sense_id": "7fdc577d-1248-3a66-9b9c-5f55e92b681c",
                                "text": "Am Flaschenhals lässt sich die Flasche gut festhalten."
                            },
                            {
                                "example_id": "3754eb3e-a1eb-473d-9b9b-2ba91f84c152",
                                "sense_id": "7fdc577d-1248-3a66-9b9c-5f55e92b681c",
                                "text": "„Als er fertig war, stopfte er den feuchten Wattebausch in den Flaschenhals.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "dd667bbb-069b-3db9-a77a-c7fcb89a1322",
                        "entry_id": "0179533f-4971-3467-a234-54243576a04e",
                        "glosses": [
                            "Teil eines Systems, das wegen seiner geringeren Kapazität das Gesamtsystem verlangsamt"
                        ],
                        "tags": [
                            "colloquial",
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "92a5e12e-a233-4ca8-afd8-f662ed8aea9c",
                                "sense_id": "dd667bbb-069b-3db9-a77a-c7fcb89a1322",
                                "text": "Der Arbeitsspeicher ist wegen seiner geringen Taktfrequenz der Flaschenhals in diesem Computer."
                            },
                            {
                                "example_id": "1f7a3a16-1f0d-407d-b558-be1c6c659838",
                                "sense_id": "dd667bbb-069b-3db9-a77a-c7fcb89a1322",
                                "text": "Die kleine Gasse ist der Flaschenhals, an dem sich der ganze Verkehr staut."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3fe4ce26-b2e1-4a82-891d-66bc236b4542",
                        "source_entry_id": "0179533f-4971-3467-a234-54243576a04e",
                        "source_sense_id": "7fdc577d-1248-3a66-9b9c-5f55e92b681c",
                        "source_sense_description": "oberer, dünnerer Teil einer Flasche, an dessen Ende sich (normalerweise) die Öffnung befindet",
                        "target_lang_word": "bottleneck",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bottleneck",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "45e397c0-10c1-3375-b534-6be4816ecb09",
                                        "entry_id": "dceb6445-a59a-3172-9336-53422e9541f4",
                                        "glosses": [
                                            "The narrow portion that forms the pouring spout of a bottle; the neck of a bottle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "473a0c70-a521-3b06-959b-34691af1c85f",
                                        "entry_id": "dceb6445-a59a-3172-9336-53422e9541f4",
                                        "glosses": [
                                            "The narrow portion that forms the pouring spout of a bottle; the neck of a bottle.",
                                            "A portion of a bottleneck placed on the finger and used as a guitar slide."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f120d9f5-1518-3923-8dd0-667d6e85d16a",
                                        "entry_id": "dceb6445-a59a-3172-9336-53422e9541f4",
                                        "glosses": [
                                            "In traffic, any narrowing of the road, especially resulting in a delay."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e98138f-852d-44b8-8f33-37c09a44e45b",
                                                "sense_id": "f120d9f5-1518-3923-8dd0-667d6e85d16a",
                                                "text": "\"Permissive\" working allows more than one train to be in a block section at one time but trains must be run at low speed in order to stop on sight behind the train in front. Such working is often authorised to allow freight trains to \"bunch\" together to await a path through a bottleneck instead of being strung out over several block sections, as would be necessary if absolute working were in force."
                                            },
                                            {
                                                "example_id": "d692a00e-dfc9-40f5-9163-dfa38baa30ca",
                                                "sense_id": "f120d9f5-1518-3923-8dd0-667d6e85d16a",
                                                "text": "At one time, Reading was regarded as a notorious bottleneck in the rail network, almost incapable of managing the number of services that needed to pass through the station each day. [...]\n A road widening scheme at Cow Lane has also allowed two-way traffic to run beneath the railway for the first time, helping to remove a notorious road traffic bottleneck in the town."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "179c8ecd-da89-393d-9aa6-f12b1c2c9205",
                                        "entry_id": "dceb6445-a59a-3172-9336-53422e9541f4",
                                        "glosses": [
                                            "The part of a process that is too slow or cumbersome."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3b13406-aa2c-4236-a74b-faf2ade1e823",
                                                "sense_id": "179c8ecd-da89-393d-9aa6-f12b1c2c9205",
                                                "text": "It is easy to create entries; processing the paperwork is the bottleneck."
                                            },
                                            {
                                                "example_id": "7ea9ef38-15f5-4ef6-8f65-711280727791",
                                                "sense_id": "179c8ecd-da89-393d-9aa6-f12b1c2c9205",
                                                "text": "The bottleneck in this computer program is the inefficient sorting process; we should replace it with a faster one."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bottleneck",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8189304-c543-37bd-9666-2becbe71b67c",
                                        "entry_id": "9181b3d7-5b0d-3744-966e-49155eb8d663",
                                        "glosses": [
                                            "To slow by causing a bottleneck."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfbeb5af-5efe-4678-a93b-69d5dae9e446",
                                                "sense_id": "d8189304-c543-37bd-9666-2becbe71b67c",
                                                "text": "The merge bottlenecked the traffic every morning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d66de4d4-8352-3f9a-b3a4-7f48ae807e4d",
                                        "entry_id": "9181b3d7-5b0d-3744-966e-49155eb8d663",
                                        "glosses": [
                                            "To form a bottleneck."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80ea53d1-28e0-4c5f-b21d-c5495a489eba",
                                                "sense_id": "d66de4d4-8352-3f9a-b3a4-7f48ae807e4d",
                                                "text": "The traffic bottlenecked at the merge every morning."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f3e878f-03fd-404c-837a-df6c6afe11cd",
                        "source_entry_id": "0179533f-4971-3467-a234-54243576a04e",
                        "source_sense_id": "7fdc577d-1248-3a66-9b9c-5f55e92b681c",
                        "source_sense_description": "oberer, dünnerer Teil einer Flasche, an dessen Ende sich (normalerweise) die Öffnung befindet",
                        "target_lang_word": "goulot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "goulot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "28075a47-8427-37c1-8402-e23263c3f574",
                                        "entry_id": "5917ab47-72e4-3ab4-ba8e-529302eb06a1",
                                        "glosses": [
                                            "Col d’une bouteille, d’une cruche, ou de tout autre récipient dont l’entrée est étroite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e50b0b06-c702-446c-ac6b-39fa419f4ae3",
                                                "sense_id": "28075a47-8427-37c1-8402-e23263c3f574",
                                                "text": "Belhumeur introduisit entre ses dents serrées le goulot d’une bouteille de cuir pleine de rhum, et l’obligea à boire quelques gouttes de liqueur."
                                            },
                                            {
                                                "example_id": "db2a567a-6739-4f98-9b97-35ce8eb9ea44",
                                                "sense_id": "28075a47-8427-37c1-8402-e23263c3f574",
                                                "text": "La codia saisit alors une bouteille d’eau de fleurs d’oranger ; elle porte le goulot à ses lèvres, gonfle sa bouche de liquide qu’elle recrache à la façon des repasseurs aspergeant leur linge."
                                            },
                                            {
                                                "example_id": "f32f87e4-9766-4578-8a16-2d36190102bb",
                                                "sense_id": "28075a47-8427-37c1-8402-e23263c3f574",
                                                "text": "On me proposa du café et, chose curieuse, je fus convié à l’arroser d’une dose de rhum qu’on fit basculer d’une bouteille, emmanchée d’un goulot-verseur."
                                            },
                                            {
                                                "example_id": "8f88bda5-046c-4fa2-99cf-b453d93727dd",
                                                "sense_id": "28075a47-8427-37c1-8402-e23263c3f574",
                                                "text": "Il aurait ouvert le tiroir du bas d’un bras nonchalant, en crochetant la poignée inoxydable avec deux doigts, et aurait pêché par le goulot une bouteille de bourbon ou de rye."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2059ff18-c5be-373c-a622-ce98f572a8cf",
                                        "entry_id": "5917ab47-72e4-3ab4-ba8e-529302eb06a1",
                                        "glosses": [
                                            "Goulet d’étranglement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "096f66e9-0b86-4604-9d85-18e91fb4513d",
                                                "sense_id": "2059ff18-c5be-373c-a622-ce98f572a8cf",
                                                "text": "Il leur fallut encore dix minutes pour franchir l’étroit goulot où tous se ruaient avec exaspération, compromettant l’évacuation des quatre voies de circulation paralysées sur plusieurs centaines de mètres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "630e9a7e-51a9-3f1a-b5da-b3d72eac406a",
