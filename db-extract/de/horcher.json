                ],
                "senses": [
                    {
                        "sense_id": "3e5130ac-3226-3d3c-a45a-50ddd361ba51",
                        "entry_id": "f20e8470-c141-3314-88b1-5b9312a6c002",
                        "glosses": [
                            "jemand, der horcht (lauscht)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9abef650-c769-41fb-b850-739d273cab1d",
                                "sense_id": "3e5130ac-3226-3d3c-a45a-50ddd361ba51",
                                "text": "In Diktaturen sprechen Menschen leise, weil sie auf Horcher gefasst sind."
                            },
                            {
                                "example_id": "e903fdcf-04b9-48dd-a436-7cce8a4e8e87",
                                "sense_id": "3e5130ac-3226-3d3c-a45a-50ddd361ba51",
                                "text": "„Der Horcher oder Voyeur an der Tür des neuvermählten Paares wird Zeuge ungewöhnlicher Praktiken oder er mißversteht das, was er hört oder sieht.“"
                            },
                            {
                                "example_id": "fff89498-69b1-45f9-b5c9-9743d9c18757",
                                "sense_id": "3e5130ac-3226-3d3c-a45a-50ddd361ba51",
                                "text": "„Der Gedanke, den Horcher zu spielen, war ihm aber zu fatal, und schon wollte er durch einen Anruf seine Gegenwart verraten, als ihn die Äußerung des einen aufs neue in seinem Vorsatze wankend machte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "52d452e2-0442-3134-a8c3-565bba136ed0",
                        "entry_id": "f20e8470-c141-3314-88b1-5b9312a6c002",
                        "glosses": [
                            "bildlich für Ohr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b607b2c-5a93-4a2f-92b9-adc3dc40af71",
                                "sense_id": "52d452e2-0442-3134-a8c3-565bba136ed0",
                                "text": "Sperr deine Horcher auf!"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "e85a0d4c-299f-3925-a0b7-baa2327cc92a",
                        "entry_id": "f20e8470-c141-3314-88b1-5b9312a6c002",
                        "glosses": [
                            "jemand, der an einem Horchgerät arbeitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85169f52-29b3-47b6-a220-d0b8823c825a",
                                "sense_id": "e85a0d4c-299f-3925-a0b7-baa2327cc92a",
                                "text": "„Der Horcher meldet laufend die Peilung.“"
                            },
                            {
                                "example_id": "de54d53b-3f46-4223-8bef-9555b525c529",
                                "sense_id": "e85a0d4c-299f-3925-a0b7-baa2327cc92a",
                                "text": "„Der Horcher hörte permanent Schraubengeräusche, aber U 96 schaffte es, aus der unmittelbaren Gefahrenzone zu entkommen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
