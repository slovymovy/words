                            {
                                "example_id": "b23c8012-85e7-44a8-a3e0-1b6195d2758a",
                                "sense_id": "09d2b61e-5645-33d8-a049-d1f6843bcbf9",
                                "text": "„Wieland gibt sich die Lizenz nicht zur Beliebigkeit, sondern zur systematischen Abweichung, um sich Raum für das Spiel zu schaffen, das nicht beliebiges Allotria ist – sonst setzte die Nähe zu letztlich nur merkwürdiger Prosa ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "433770e2-7f34-3e55-9f22-d4bff02622fa",
                        "entry_id": "af0b88d9-2e10-37ee-887d-be76a666eb55",
                        "glosses": [
                            "lärmendes, wirres Treiben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "691c7a41-0618-4d66-b73f-264a39a51f47",
                                "sense_id": "433770e2-7f34-3e55-9f22-d4bff02622fa",
                                "text": "„Sie rempeln sich in den Kurven mutwillig an und treiben ihr Allotria, als wäre ich gar nicht vorhanden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
