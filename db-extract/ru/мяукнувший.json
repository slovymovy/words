                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "840a6459-9609-4f5f-be8f-3b642e1698a1",
                                                "sense_id": "676d98b3-cac8-331b-aa98-64ac7bb37a03",
                                                "text": "“The last thing they had seen in 2012 before that break was a short from Simon’s Cat called ‘Cat Man Do,’” said Lamothe. “When you leave 800 people in the dark, they will do something. That’s what Fantasia is. But because they had just seen that cat go meow, they meowed.”"
                                            }
                                        ]
