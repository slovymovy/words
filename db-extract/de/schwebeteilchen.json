                ],
                "senses": [
                    {
                        "sense_id": "f1cb9f20-a334-3df9-8bd8-e891af3ce063",
                        "entry_id": "94e95c9a-7ae2-36ae-abc7-e53566b55e36",
                        "glosses": [
                            "in Wasser, Luft oder dergleichen enthaltener, sehr kleiner Teil von etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67dc9f2d-7ae2-4eae-92d6-45cb26bc55a6",
                                "sense_id": "f1cb9f20-a334-3df9-8bd8-e891af3ce063",
                                "text": "„In den unteren Schichten der Atmosphäre, dort wo sich auch das Wettergeschehen abspielt, gibt es erhebliche Mengen an Schwebeteilchen, sog. Aerosole – Staub, Dämpfe und Rauch.“"
                            },
                            {
                                "example_id": "4dc44507-60df-49ea-a638-d69010b8cc88",
                                "sense_id": "f1cb9f20-a334-3df9-8bd8-e891af3ce063",
                                "text": "„Einer gängigen Theorie zufolge wirken feine Schwebeteilchen in der Atmosphäre, so genannte Aerosole, der Erderwärmung entgegen.“"
                            },
                            {
                                "example_id": "692a5a7f-8760-4e8b-8dec-03504e7cf830",
                                "sense_id": "f1cb9f20-a334-3df9-8bd8-e891af3ce063",
                                "text": "„Je mehr Schwebeteilchen als Kondensationskeime wirken, desto kleiner werden die Tröpfchen und desto länger bleiben sie als Sonnenschirm in der Luft, bevor sie ausregnen.“"
                            },
                            {
                                "example_id": "a2077115-d997-43ae-b19f-3bb2bb1d9a39",
                                "sense_id": "f1cb9f20-a334-3df9-8bd8-e891af3ce063",
                                "text": "„So steigt in durch Schwebeteilchen erzeugten Kumuluswolken die feuchte Luft durch die frei werdende Kondensationswärme weiter auf, kühlt dabei ab und bildet zusätzliche Wassertröpfchen in größerer Höhe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
