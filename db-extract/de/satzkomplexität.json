                ],
                "senses": [
                    {
                        "sense_id": "55084357-1109-31b4-8fee-4fbca65f9816",
                        "entry_id": "e89ff422-6f5a-378d-a964-5b42f0483c61",
                        "glosses": [
                            "Linguistik: Art, Menge und hierarchische Ordnung der in einem Satz enthaltenen Satzteile"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c28bd81b-19d5-4188-b01c-12435ccd9d97",
                                "sense_id": "55084357-1109-31b4-8fee-4fbca65f9816",
                                "text": "„Des Weiteren von Bedeutung sind die Satzkomplexität (100 = sehr komplex) und die Wortschatzkomplexität (100 = sehr komplex).“"
                            },
                            {
                                "example_id": "79085222-93ce-4fa2-ae22-bc7d36ca74a4",
                                "sense_id": "55084357-1109-31b4-8fee-4fbca65f9816",
                                "text": "„Zur Satzlänge hinzu kam in unserer Untersuchung eine hohe Satzkomplexität, beispielsweise eingebettete Nebensätze, Klammerausdrücke, Aufzählungen usw. “"
                            },
                            {
                                "example_id": "97d5c6f0-9ade-4f22-813a-794282ecfc21",
                                "sense_id": "55084357-1109-31b4-8fee-4fbca65f9816",
                                "text": "„Im Bereich des Satzbaus kommt es seit dem 19. Jahrhundert zu quantitativen Veränderungen, die sich in der Abnahme der Satzlänge und Satzkomplexität nachweisen lassen.“"
                            },
                            {
                                "example_id": "b0a2b390-2147-408a-9853-a8f8aef216b2",
                                "sense_id": "55084357-1109-31b4-8fee-4fbca65f9816",
                                "text": "„Ein besonders einfaches Kriterium für Satzkomplexität ist ihre Länge, die verschieden definiert werden kann: als die Zahl der Buchstaben, Silben, Wörter, Teilsätze usw. je Satz.“"
                            },
                            {
                                "example_id": "b92fd62e-4f35-44f1-8d64-c198b0808ee0",
                                "sense_id": "55084357-1109-31b4-8fee-4fbca65f9816",
                                "text": "„Beispielsweise könnte uns interessieren, ob die Satzkomplexität als metrisch skaliertes Merkmal in verschiedenen sozialen Schichten gleich bzw. unterschiedlich ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
