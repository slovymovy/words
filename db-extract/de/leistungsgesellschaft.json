                ],
                "senses": [
                    {
                        "sense_id": "4d1f9238-ca7d-3c45-a889-676dc8d81fdf",
                        "entry_id": "142ec467-3520-343f-8857-5fba03f678d2",
                        "glosses": [
                            "Gesellschaft, in der Verteilung des Einkommens wie des sozialen Ansehens und der Macht allein entsprechend der Leistung erfolgt, die der Einzelne erreicht"
                        ],
                        "tags": [
                            "Soziologie",
                            "als Modellvorstellung"
                        ],
                        "examples": [
                            {
                                "example_id": "ba090b41-9d32-4ca7-b963-22f86b85852e",
                                "sense_id": "4d1f9238-ca7d-3c45-a889-676dc8d81fdf",
                                "text": "In Leistungsgesellschaften werden humanitäre Werte kaum gefördert, wenn sie keine Leistung erbringen."
                            },
                            {
                                "example_id": "e8c36df6-36cb-4c48-9600-cec02f881da4",
                                "sense_id": "4d1f9238-ca7d-3c45-a889-676dc8d81fdf",
                                "text": "„In diesem Sinne wetterten die Obrigkeit und die intellektuelle Elite unaufhörlich gegen Liberalismus, Kapitalismus, Industrialisierung sowie die Konkurrenz- und Leistungsgesellschaft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3d36350e-32ab-3aa3-97ab-aa4c0afaaef0",
                        "entry_id": "142ec467-3520-343f-8857-5fba03f678d2",
                        "glosses": [
                            "eine Gesellschaft, die in (zu) hohem Maße Leistungsfähigkeit und -bereitschaft vom Einzelnen fordert, wobei weniger oder nur durchschnittlich leistungsstarke Menschen kaum soziale Anerkennung erhalten"
                        ],
                        "tags": [
                            "als Kritik an der modernen westlichen Gesellschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "9004145d-8fca-4d4c-94db-0dbc3d0de292",
                                "sense_id": "3d36350e-32ab-3aa3-97ab-aa4c0afaaef0",
                                "text": "Die Leistungsgesellschaft bereitet vielen Schülern heute Stress – ist es da verwunderlich, dass sich die Ellenbogenmentalität immer mehr ausbreitet?"
                            },
                            {
                                "example_id": "36864bed-0f73-4d82-9fba-007d9a07fe97",
                                "sense_id": "3d36350e-32ab-3aa3-97ab-aa4c0afaaef0",
                                "text": "„In der modernen Leistungsgesellschaft, glaubt Han, handle jeder wie sein eigener Unternehmer und sei damit Unterdrücker und Unterdrückter zugleich.“"
                            },
                            {
                                "example_id": "6b7517ba-e6b2-45db-848d-883ce508a664",
                                "sense_id": "3d36350e-32ab-3aa3-97ab-aa4c0afaaef0",
                                "text": "„Immerhin lebten sie jetzt in einer Leistungsgesellschaft, die von jedem Bürger vollen Einsatz in angepasster Sklavenarbeit erwartete.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
