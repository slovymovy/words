                        "entry_id": "ae8b6697-76eb-3cb1-a3a6-2e558063315f",
                        "glosses": [
                            "Nom vernaculaire de différentes espèces de mammifères marins appartenant à la famille des otariidés, dont les espèces les plus connues sont l'otarie de Californie, l’otarie d'eau douce ou l’otarie de Pabion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5437b346-d8f0-426b-aa34-3d3812494612",
                                "sense_id": "f1a747a8-db07-34b2-94aa-b46f40dd808f",
                                "text": "La marée n’échoue plus sur ces sables l’otarie moustachue, aux oreilles enroulées, aux mâchelières pointues, se traînant sur ses pattes sans ongles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7abe3663-2dee-40c4-9508-9bb011691540",
                        "source_entry_id": "ae8b6697-76eb-3cb1-a3a6-2e558063315f",
                        "source_sense_id": "f1a747a8-db07-34b2-94aa-b46f40dd808f",
