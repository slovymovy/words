                    {
                        "translation_id": "40b68fb6-8624-4772-8cee-dbb42ce47706",
                        "source_entry_id": "81f3d53a-1390-3dfb-b7e8-cbc40d2c5a01",
                        "source_sense_id": "bd9f0a58-f0e9-384a-98aa-2026fe1b424e",
                        "source_sense_description": "banking card game",
                        "target_lang_word": "фарао́н",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "фарао́н",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "648b2949-71bd-3514-bbef-8d02b8a4d740",
                                        "entry_id": "a4acd249-7576-345c-bc3c-5c5a580dbe1a",
                                        "glosses": [
                                            "истор. царский титул в Древнем Египте, а также носитель такого титула"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91695bb8-1de7-40d7-8936-9dcb8b929cf5",
                                                "sense_id": "648b2949-71bd-3514-bbef-8d02b8a4d740",
                                                "text": "Но и тут всегда безопаснее употреблять страдательные глаголы: Фараона вода потопила, Фараон водою потопился; последнее уже другую силу имеет: будто бы фараон потонул по своему желанию."
                                            },
                                            {
                                                "example_id": "882bf22e-ea82-403e-9245-d766c5919743",
                                                "sense_id": "648b2949-71bd-3514-bbef-8d02b8a4d740",
                                                "text": "Фараоны решили строить свои пирамиды в пустыне, чтобы их было видно отовсюду."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9da5f62-f689-3368-a488-1e0adf87292c",
                                        "entry_id": "a4acd249-7576-345c-bc3c-5c5a580dbe1a",
                                        "glosses": [
                                            "устар., жарг. полицейский"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d9b87e7-a5fc-441d-b011-20a01b94d68f",
                                                "sense_id": "e9da5f62-f689-3368-a488-1e0adf87292c",
                                                "text": "— Да я там кусочек саркофага отколупнул на память, а фараон как стукнет!"
                                            },
                                            {
                                                "example_id": "c160face-d8d0-4e31-9ea0-1b406c5123a0",
                                                "sense_id": "e9da5f62-f689-3368-a488-1e0adf87292c",
                                                "text": "– Сударь! – робко сказал старший. – А разве вы не боитесь полицейских? — Малыш! Говорят не «полицейские», а «фараоны»! – вот всё, что ответил ему Гаврош."
                                            },
                                            {
                                                "example_id": "da72a16e-6410-4aad-b016-6238080f56be",
                                                "sense_id": "e9da5f62-f689-3368-a488-1e0adf87292c",
                                                "text": "Рубль у мазуриков оказывался и «колесом», и «царем», — теперь, по-новому, это «дере»; полицейского же они звали «каплюжником», теперь согласились называть гуртом прежнего фараона и бутыря (буточника) — пауком; прежде «начудил», теперь наездил, если сделать неудачную кражу, сделавшуюся открытою, и проч."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "фарао́н",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "609da826-f61d-31ef-9977-b1bb9bc1c917",
                                        "entry_id": "6c914021-d478-36c6-8e28-05124727d8ec",
                                        "glosses": [
                                            "устар., карт. разновидность карточной игры"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb21d30c-5fef-478c-8c2d-48dc69d6beb4",
                                                "sense_id": "609da826-f61d-31ef-9977-b1bb9bc1c917",
                                                "text": "В Москве составилось общество богатых игроков, под председательством славного Чекалинского, проведшего весь век за картами и нажившего некогда миллионы, выигрывая векселя и проигрывая чистые деньги. ❬…❭ Молодежь к нему нахлынула, забывая балы для карт и предпочитая соблазны фараона обольщениям волокитства."
                                            },
                                            {
                                                "example_id": "f6b91049-929c-4b7d-a9e9-456f7fa9a55c",
                                                "sense_id": "609da826-f61d-31ef-9977-b1bb9bc1c917",
                                                "text": "Вслед за капитаном Пендедекой вошёл я в комнату, где на диване, свернув под себя ноги, сидел Дука, эфор этерии. ❬…❭ Перед ним стоял ломберный стол, а в жирной руке его утонула колода карт; он метал фараон."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
