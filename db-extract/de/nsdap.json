                ],
                "senses": [
                    {
                        "sense_id": "cc96f225-6e97-353a-8dad-c1add6140656",
                        "entry_id": "70f0885c-0d4e-384d-aa59-ceb86e398642",
                        "glosses": [
                            "Nationalsozialistische Deutsche Arbeiterpartei"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d946851-39a0-40c0-9825-cc1d11ab184d",
                                "sense_id": "cc96f225-6e97-353a-8dad-c1add6140656",
                                "text": "„Die Anziehungskraft, die der Nationalsozialismus auf die Mittelschichten ausübte, war so offenkundig, dass der sozialdemokratische Soziologe Theodor Geiger schon im Herbst 1930 den Erfolg der NSDAP als Ausdruck einer ‚Panik im Mittelstand‘ deutete.“"
                            },
                            {
                                "example_id": "af43e556-4765-467f-b032-19cdccac6fd2",
                                "sense_id": "cc96f225-6e97-353a-8dad-c1add6140656",
                                "text": "„Die NSDAP hatte sich, seit Hitler an ihre Spitze getreten war, rasant entwickelt.“"
                            },
                            {
                                "example_id": "641024ca-4454-4a6a-bf8b-7cfea6d3bae6",
                                "sense_id": "cc96f225-6e97-353a-8dad-c1add6140656",
                                "text": "„Um seinen Status – und den seiner Familie – zu heben, entschloss sich Johann Eckert, in die NSDAP einzutreten.“"
                            },
                            {
                                "example_id": "250197d9-b2fd-4c84-8a1d-daf9953390ce",
                                "sense_id": "cc96f225-6e97-353a-8dad-c1add6140656",
                                "text": "„Zunächst erscheint es notwendig, auf die Struktur der NSDAP und ihrer zahlreichen Nebenorganisationen einzugehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
