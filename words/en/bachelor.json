{
    "word_family": [
        "bachelorhood",
        "bachelorship",
        "bachelorette"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2ed2b48c-73a5-3d19-8901-b7c437f0dfdc",
                    "sense_definition": "A man who is not married and has never been married.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "marital_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He lived as a <w>bachelor</w> for many years before finally deciding to settle down.",
                            "target_lang_translations": {
                                "ru": "Он много лет жил как <w>холостяк</w>, прежде чем наконец решил остепениться."
                            }
                        },
                        {
                            "text": "My uncle is a confirmed <w>bachelor</w> who enjoys his independence and traveling alone.",
                            "target_lang_translations": {
                                "ru": "Мой дядя — убежденный <w>холостяк</w>, который ценит свою независимость и одиночные путешествия."
                            }
                        }
                    ],
                    "antonyms": [
                        "bachelorette"
                    ],
                    "common_phrases": [
                        "confirmed bachelor",
                        "eligible bachelor",
                        "bachelor pad"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужчина, который не состоит и никогда не состоял в браке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "холостяк",
                                "target_lang_sense_clarification": "неженатый мужчина"
                            },
                            {
                                "target_lang_word": "холостой",
                                "target_lang_sense_clarification": "о мужчине, не состоящем в браке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9aafd5b8-40cf-3b53-982a-0391f35f26da",
                    "sense_definition": "A person who has completed their first degree at a university or college.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "academic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After four years of hard study, she is now a <w>bachelor</w> of arts.",
                            "target_lang_translations": {
                                "ru": "После четырех лет усердной учебы она теперь <w>бакалавр</w> искусств."
                            }
                        },
                        {
                            "text": "The university welcomed every new <w>bachelor</w> of science at the graduation ceremony.",
                            "target_lang_translations": {
                                "ru": "Университет приветствовал каждого нового <w>бакалавра</w> наук на церемонии вручения дипломов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bachelor of arts",
                        "bachelor of science"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, получивший первую ученую степень в университете или колледже."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бакалавр",
                                "target_lang_sense_clarification": "лицо, имеющее первую академическую степень"
                            },
                            {
                                "target_lang_word": "выпускник",
                                "target_lang_sense_clarification": "в контексте получения первой степени"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d408441d-aa03-37d4-ac04-adcf20d30111",
                    "sense_definition": "The first or lowest academic degree awarded by a university.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "academic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is currently studying for his <w>bachelor</w> in computer science.",
                            "target_lang_translations": {
                                "ru": "В настоящее время он учится на <w>бакалавра</w> в области компьютерных наук."
                            }
                        },
                        {
                            "text": "Most professional jobs require at least a <w>bachelor</w> degree for entry-level positions.",
                            "target_lang_translations": {
                                "ru": "Для большинства профессиональных вакансий начального уровня требуется как минимум степень <w>бакалавра</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "baccalaureate"
                    ],
                    "common_phrases": [
                        "bachelor degree"
                    ],
                    "target_lang_definitions": {
                        "ru": "Первая или низшая академическая степень, присуждаемая университетом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бакалавр",
                                "target_lang_sense_clarification": "академическая степень"
                            },
                            {
                                "target_lang_word": "бакалавриат",
                                "target_lang_sense_clarification": "программа обучения на степень бакалавра"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "caa15040-d828-336d-b06d-9ab8f67cee21",
                    "sense_definition": "A small apartment designed for a single person to live in.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "housing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He moved into a small <w>bachelor</w> near the city center to be closer to work.",
                            "target_lang_translations": {
                                "ru": "Он переехал в небольшую <w>студию</w> недалеко от центра города, чтобы быть ближе к работе."
                            }
                        },
                        {
                            "text": "The building consists mostly of one-bedroom units and a few <w>bachelor</w> apartments.",
                            "target_lang_translations": {
                                "ru": "Здание состоит в основном из однокомнатных квартир и нескольких <w>квартир-студий</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bachelor apartment"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Commonly used in Canada"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая квартира, предназначенная для проживания одного человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "квартира-студия",
                                "target_lang_sense_clarification": "жилье для одного человека"
                            },
                            {
                                "target_lang_word": "однокомнатная квартира",
                                "target_lang_sense_clarification": "небольшое жилье"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "715c7e5b-584e-31e1-9ddf-91060daeb63a",
                    "sense_definition": "An unmarried woman.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "marital_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In some older texts, a woman living alone might be referred to as a <w>bachelor</w>.",
                            "target_lang_translations": {
                                "ru": "В некоторых старых текстах одинокую женщину могли называть <w>холостячкой</w>."
                            }
                        },
                        {
                            "text": "She remained a <w>bachelor</w> all her life, preferring her career over marriage.",
                            "target_lang_translations": {
                                "ru": "Она всю жизнь оставалась <w>незамужней</w>, предпочитая карьеру браку."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Now replaced by bachelorette or single woman"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Незамужняя женщина (устаревшее значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "незамужняя женщина",
                                "target_lang_sense_clarification": "устаревшее употребление слова bachelor"
                            },
                            {
                                "target_lang_word": "холостячка",
                                "target_lang_sense_clarification": "в ироничном или устаревшем смысле"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd95e616-945d-3c5f-8710-12495b939249",
                    "sense_definition": "A young knight who follows the banner of another because he is too young or poor to have his own.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "history",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young <w>bachelor</w> fought bravely under the count's standard during the battle.",
                            "target_lang_translations": {
                                "ru": "Молодой <w>рыцарь-бакалавр</w> храбро сражался под знаменем графа во время битвы."
                            }
                        },
                        {
                            "text": "As a knight <w>bachelor</w>, he hoped to one day lead his own company of men.",
                            "target_lang_translations": {
                                "ru": "Будучи <w>рыцарем-бакалавром</w>, он надеялся однажды возглавить собственный отряд."
                            }
                        }
                    ],
                    "common_phrases": [
                        "knight bachelor"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historical context of chivalry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Молодой рыцарь, служащий под знаменем другого, так как он слишком молод или беден, чтобы иметь собственное."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рыцарь-бакалавр",
                                "target_lang_sense_clarification": "исторический термин для молодого рыцаря"
                            },
                            {
                                "target_lang_word": "бакалавр",
                                "target_lang_sense_clarification": "в историческом контексте рыцарства"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}