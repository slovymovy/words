                "senses": [
                    {
                        "sense_id": "10692afb-b604-39ca-8ba0-1a60b6155e37",
                        "entry_id": "0853b191-7b3e-3da5-8452-07e2a60d6345",
                        "glosses": [
                            "Beschreibung der Erfahrungen und Erlebnisse eines Menschen mit dem Spielen im zurückliegenden Laufe seines Lebens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4122f16b-2139-47f2-a9d2-05e597a35122",
                                "sense_id": "10692afb-b604-39ca-8ba0-1a60b6155e37",
                                "text": "„Wenn Menschen der älteren Generation ihre Spielbiografien zurückverfolgen, erinnern sie sich mit Begeisterung an eine Fülle von Erlebnisräumen und aufregenden Entdeckungsmöglichkeiten.“"
                            },
                            {
                                "example_id": "9b079255-09b2-4471-8ec6-5945aaa32ab7",
                                "sense_id": "10692afb-b604-39ca-8ba0-1a60b6155e37",
                                "text": "„Die Spielbiografie des einzelnen Menschen ist zunächst vom spielfreudigen oder spielabstinenten Elternhaus geprägt.“"
                            },
                            {
                                "example_id": "eaf71333-6848-48d3-bf74-172601a41e28",
                                "sense_id": "10692afb-b604-39ca-8ba0-1a60b6155e37",
                                "text": "„Die Bedeutung der Spielbiografie als Ausdruck und Medium der psychodynamischen Konfliktbearbeitung und –bewältigung ist besonders von der klassischen Psychoanalyse herausgearbeitet worden.“"
                            },
                            {
                                "example_id": "c414d0a0-e719-42a7-b285-0c05087b7087",
                                "sense_id": "10692afb-b604-39ca-8ba0-1a60b6155e37",
                                "text": "„Ebenso werden gegenwärtige Spielsituationen häufig erst verstehbar, wenn wir einen Blick auf die Spielbiographie werfen.“"
                            },
                            {
                                "example_id": "73b17b40-e3b1-4ea8-b4cd-0bd8d8cb9f93",
                                "sense_id": "10692afb-b604-39ca-8ba0-1a60b6155e37",
                                "text": "„Spielen ist nicht von der eigenen Spielbiografie zu trennen: Der Erzieher wird sich ernstlich bemühen, seine Spielbiografie in der eigenen Kindheit zu erforschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
