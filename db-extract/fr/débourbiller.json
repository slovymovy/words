                "senses": [
                    {
                        "sense_id": "dea5f112-e977-3b1e-815f-9e02ec6eb4c5",
                        "entry_id": "19b8809f-d3b0-3c0f-889c-ae9fd5afcc7d",
                        "glosses": [
                            "Sortir de la bourbe, de la boue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b16b674b-babf-4d34-ba59-de2974131453",
                                "sense_id": "dea5f112-e977-3b1e-815f-9e02ec6eb4c5",
                                "text": "Au printemps, lorsque, sous un pâle rayon de soleil, les premières pousses des légumes commençaient à percer à travers les couches boueuses de nos jardins, elle se dilatait, à cette vue, en son cœur de propriétaire : — Ah ! disait-elle, voilà que ça commence à « débourbiller ! »"
                            }
                        ]
                    },
                    {
                        "sense_id": "502df5bb-a159-3396-ad83-7f8365c592d5",
                        "entry_id": "19b8809f-d3b0-3c0f-889c-ae9fd5afcc7d",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c500cba7-e88f-4628-9d34-bc1cdb90fb0e",
                                "sense_id": "502df5bb-a159-3396-ad83-7f8365c592d5",
                                "text": "Attention, y’a une racine, vous laissez pas débourbiller !"
                            }
                        ]
                    }
