{
    "word_family": [
        "point",
        "pointer",
        "pointless",
        "pointy",
        "pointedly",
        "pointedness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7d79768d-3cdd-358d-a317-ea905edf783c",
                    "sense_definition": "Having a sharp or tapered end; not blunt.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The warrior brandished a <w>pointed</w> spear during the ceremony.",
                            "target_lang_translations": {
                                "ru": "Воин размахивал <w>заострённым</w> копьем во время церемонии."
                            }
                        },
                        {
                            "text": "Be careful with that <w>pointed</w> object because it might hurt someone.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен с этим <w>острым</w> предметом, так как он может кого-нибудь поранить."
                            }
                        }
                    ],
                    "synonyms": [
                        "pointy",
                        "sharp"
                    ],
                    "antonyms": [
                        "blunt"
                    ],
                    "common_phrases": [
                        "pointed object",
                        "pointed end",
                        "pointed chin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий острый или сужающийся конец; не тупой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заострённый",
                                "target_lang_sense_clarification": "имеющий острый конец"
                            },
                            {
                                "target_lang_word": "острый",
                                "target_lang_sense_clarification": "сужающийся к концу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "549f87da-509d-3f74-9fc5-577a99a1e720",
                    "sense_definition": "Expressing criticism or a specific meaning in a direct and often unfriendly way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician faced <w>pointed</w> criticism regarding his recent policy changes.",
                            "target_lang_translations": {
                                "ru": "Политик столкнулся с <w>едкой</w> критикой по поводу его недавних изменений в политике."
                            }
                        },
                        {
                            "text": "She made a <w>pointed</w> remark about his constant lateness during the meeting.",
                            "target_lang_translations": {
                                "ru": "Она сделала <w>колючее</w> замечание по поводу его постоянных опозданий во время собрания."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pointed remark",
                        "pointed criticism",
                        "pointed question"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражающий критику или конкретный смысл прямым и часто недружелюбным образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колючий",
                                "target_lang_sense_clarification": "о замечании или критике"
                            },
                            {
                                "target_lang_word": "едкий",
                                "target_lang_sense_clarification": "остро критический"
                            },
                            {
                                "target_lang_word": "недвусмысленный",
                                "target_lang_sense_clarification": "явно намекающий на что-то"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3692a9f8-3810-343e-9047-e667d91b9611",
                    "sense_definition": "Having a specified number of points or tips.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children drew a large five-<w>pointed</w> star on the chalkboard.",
                            "target_lang_translations": {
                                "ru": "Дети нарисовали на доске большую пяти<w>конечную</w> звезду."
                            }
                        },
                        {
                            "text": "The compass rose features an eight-<w>pointed</w> design to show directions.",
                            "target_lang_translations": {
                                "ru": "Роза ветров имеет восьми<w>лучевой</w> дизайн для указания направлений."
                            }
                        }
                    ],
                    "common_phrases": [
                        "five-pointed star",
                        "multi-pointed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий определенное количество лучей, углов или наконечников."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "-конечный",
                                "target_lang_sense_clarification": "в составе сложных слов, например, пятиконечный"
                            },
                            {
                                "target_lang_word": "лучевой",
                                "target_lang_sense_clarification": "о форме звезды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ce29c2c-03c2-3f31-8ca6-614f57c7b9fb",
                    "sense_definition": "Having a clear relevance or pertinence to the subject being discussed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "relevance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer asked a <w>pointed</w> question that changed the course of the trial.",
                            "target_lang_translations": {
                                "ru": "Адвокат задал <w>меткий</w> вопрос, который изменил ход судебного процесса."
                            }
                        },
                        {
                            "text": "His observations were very <w>pointed</w> and addressed the core of the problem.",
                            "target_lang_translations": {
                                "ru": "Его замечания были очень <w>точными</w> и касались самой сути проблемы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pointed question",
                        "pointed observation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий четкое отношение или уместность к обсуждаемому предмету."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "меткий",
                                "target_lang_sense_clarification": "точно попадающий в суть"
                            },
                            {
                                "target_lang_word": "острый",
                                "target_lang_sense_clarification": "проницательный и актуальный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2b3345f-26b9-33e1-94ab-a79659a5d07e",
                    "sense_definition": "Occurring exactly at a specific or precise time.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With their usual punctuality, the boys arrive at the <w>pointed</w> hour of three.",
                            "target_lang_translations": {
                                "ru": "Со своей обычной пунктуальностью мальчики приходят в <w>назначенный</w> час — в три часа."
                            }
                        },
                        {
                            "text": "The ceremony began at the <w>pointed</w> time without any delay.",
                            "target_lang_translations": {
                                "ru": "Церемония началась в <w>установленное</w> время без каких-либо задержек."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pointed hour",
                        "pointed time"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This usage is less common in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий точно в определенное или назначенное время."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "назначенный",
                                "target_lang_sense_clarification": "об определенном часе"
                            },
                            {
                                "target_lang_word": "установленный",
                                "target_lang_sense_clarification": "о времени"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51ed0aa3-d39b-3743-9753-86a65fd3b359",
                    "sense_definition": "Describing an animal coat pattern where the extremities are darker than the rest of the body.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Siamese is a <w>pointed</w> breed of cat known for its dark ears and paws.",
                            "target_lang_translations": {
                                "ru": "Сиамская кошка — это порода с <w>поинтами</w>, известная своими темными ушами и лапами."
                            }
                        },
                        {
                            "text": "Breeders often look for consistent color in <w>pointed</w> rabbits.",
                            "target_lang_translations": {
                                "ru": "Заводчики часто ищут равномерный окрас у кроликов с <w>отметинами</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pointed breed",
                        "pointed pattern"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in animal breeding"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Окрас животного, при котором конечности темнее остального тела."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "акромеланический",
                                "target_lang_sense_clarification": "специальный термин для окраса"
                            },
                            {
                                "target_lang_word": "с поинтами",
                                "target_lang_sense_clarification": "в разведении кошек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e0ff723-433c-39ec-a09e-7e28f11c487f",
                    "sense_definition": "Relating to a mathematical space that has a designated basepoint.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The class of all <w>pointed</w> spaces forms a category in topology.",
                            "target_lang_translations": {
                                "ru": "Класс всех <w>пунктированных</w> пространств образует категорию в топологии."
                            }
                        },
                        {
                            "text": "We must define a basepoint before we can analyze the <w>pointed</w> set.",
                            "target_lang_translations": {
                                "ru": "Мы должны определить базовую точку, прежде чем сможем анализировать <w>отмеченное</w> множество."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pointed space",
                        "pointed set"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "mathematical terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к математическому пространству с выделенной точкой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пунктированный",
                                "target_lang_sense_clarification": "о пространстве с отмеченной точкой"
                            },
                            {
                                "target_lang_word": "отмеченный",
                                "target_lang_sense_clarification": "имеющий выделенную точку"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "db72a369-ed81-308b-a0f4-9ed4ad412945",
                    "sense_definition": "The simple past and past participle of <w>point</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>pointed</w> at the map to show us where the hidden treasure was.",
                            "target_lang_translations": {
                                "ru": "Он <w>указал</w> на карту, чтобы показать нам, где спрятаны сокровища."
                            }
                        },
                        {
                            "text": "She <w>pointed</w> her finger toward the door and asked him to leave.",
                            "target_lang_translations": {
                                "ru": "Она <w>направила</w> палец на дверь и попросила его уйти."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pointed at",
                        "pointed out",
                        "pointed toward"
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма прошедшего времени глагола 'point' (указывать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "указал",
                                "target_lang_sense_clarification": "направил внимание на что-то"
                            },
                            {
                                "target_lang_word": "показал",
                                "target_lang_sense_clarification": "жестом"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}