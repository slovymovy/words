{
    "word_family": [
        "silent",
        "silence"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "73db7210-4dfc-33b7-9d1d-a3d4c6c99ec3",
                    "sense_definition": "In a manner that makes no noise or sound.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat moved <w>silently</w> across the room to catch the mouse.",
                            "target_lang_translations": {
                                "ru": "Кошка <w>тихо</w> пробралась через комнату, чтобы поймать мышь."
                            }
                        },
                        {
                            "text": "Everyone sat <w>silently</w> while the teacher explained the lesson.",
                            "target_lang_translations": {
                                "ru": "Все сидели <w>молча</w>, пока учитель объяснял урок."
                            }
                        }
                    ],
                    "synonyms": [
                        "quietly",
                        "noiselessly"
                    ],
                    "antonyms": [
                        "loudly",
                        "noisily"
                    ],
                    "common_phrases": [
                        "walk silently",
                        "sit silently",
                        "wait silently"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способ, при котором не издается никаких звуков или шума."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ти́хо",
                                "target_lang_sense_clarification": "не издавая громких звуков"
                            },
                            {
                                "target_lang_word": "мо́лча",
                                "target_lang_sense_clarification": "сохраняя молчание, ничего не говоря"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0c4f1bd-e3dd-3db0-ac81-e039fd2f4797",
                    "sense_definition": "In a way that makes a change to a text or document without telling anyone or noting it.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor <w>silently</w> corrected the spelling errors in the manuscript.",
                            "target_lang_translations": {
                                "ru": "Редактор <w>тихо</w> исправил орфографические ошибки в рукописи."
                            }
                        },
                        {
                            "text": "The software <w>silently</w> updated the configuration files without asking the user.",
                            "target_lang_translations": {
                                "ru": "Программа <w>тихо</w> обновила файлы конфигурации, не спрашивая пользователя."
                            }
                        }
                    ],
                    "common_phrases": [
                        "silently updated",
                        "silently corrected"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способ внесения изменений в текст или документ без уведомления или фиксации этого факта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ти́хо",
                                "target_lang_sense_clarification": "незаметно, украдкой, без лишнего шума"
                            },
                            {
                                "target_lang_word": "незаме́тно",
                                "target_lang_sense_clarification": "скрытно, без привлечения внимания"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}