                ],
                "senses": [
                    {
                        "sense_id": "3221a39d-9e7c-305d-9b32-6ed2ea873d0f",
                        "entry_id": "2391e6c9-42d0-33f0-85ff-fafb4d23d891",
                        "glosses": [
                            "Transformer par anamorphose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6147304-ac4b-4c3d-8f75-ef01078ff870",
                                "sense_id": "3221a39d-9e7c-305d-9b32-6ed2ea873d0f",
                                "text": "Les négatifs de ces différentes scènes seront normaux, pris avec une caméra courante et seront, eux, « anamorphosées » dans la tireuse optique qui les juxtaposera et les tassera, puis ils seront reformés et agrandis à la projection."
                            },
                            {
                                "example_id": "8ada0b20-5f93-450b-a360-8de33f6789c5",
                                "sense_id": "3221a39d-9e7c-305d-9b32-6ed2ea873d0f",
                                "text": "'Anamorphoser est comme filmer."
                            },
                            {
                                "example_id": "63ebb5a0-ae77-4df0-a410-dca8f04a3793",
                                "sense_id": "3221a39d-9e7c-305d-9b32-6ed2ea873d0f",
                                "text": "Une suite de dioptres cylindriques parallèles à génératrices perpendiculaires peut aussi servir à anamorphoser (fig. 5-3d)."
                            }
                        ]
                    }
                ],
