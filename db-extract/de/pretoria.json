                                        "examples": [
                                            {
                                                "example_id": "3bcb023a-130e-4398-9116-83bbbec5a5a0",
                                                "sense_id": "7f982262-ba96-3cb9-b80e-4ea8cce9e963",
                                                "text": "Il suffit d’une tombe s’entrouvrant près de Pretoria et laissant émerger une statuette de rhinocéros endormi près d’un squelette bantou pour que courent les télégrammes et que vacillent à Buenos Aires, Londres ou Budapest des chapitres d’histoire de l’art et les prix du marché."
                                            },
                                            {
                                                "example_id": "15a6e67b-10ef-4998-bf88-676208e55d63",
                                                "sense_id": "7f982262-ba96-3cb9-b80e-4ea8cce9e963",
                                                "text": "Le président Paul Kruger (1825-1904) lance la construction d'une ligne de chemin de fer reliant Pretoria à l'océan, en territoire portugais."
                                            }
                                        ]
