                        "glosses": [
                            "Filin léger servant à divers usages."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b1423af-5758-4aeb-ae49-5dfa7fcfdb02",
                                "sense_id": "cd34f8bc-dbbe-3a38-9d3c-babc0bb2187d",
                                "text": "Du linge accroché à un cartahu voudrait sécher ; mouchoirs, chemises, caleçons sont devenu durs comme du carton […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "951af816-81e9-309a-b042-e96bf25d1483",
                        "entry_id": "cd0590c5-6e8c-361e-afe5-94d1347fe6ee",
                        "glosses": [
                            "Cordage passé dans une poulie, au bout d'un mât, pour hisser."
                        ],
                        "tags": [
                            "dated",
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "907be61a-1526-42af-b7f6-5cedea93ca26",
                                "sense_id": "951af816-81e9-309a-b042-e96bf25d1483",
                                "text": "Le nœud de chaise est une boucle solide qui sert, comme son nom l'indique, à soutenir un homme dans la mâture à l'extrémité d'un cartahu."
                            }
                        ]
                    },
                    {
                        "sense_id": "72a520c0-5082-3c04-9d31-a9b2b33d1a4d",
                        "entry_id": "cd0590c5-6e8c-361e-afe5-94d1347fe6ee",
