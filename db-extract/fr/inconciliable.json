                    }
                ],
                "senses": [
                    {
                        "sense_id": "5330eb39-a8df-38c7-a36d-0372c3011827",
                        "entry_id": "e9fd9cd7-b632-36c0-90ae-f0f2ddd848ca",
                        "glosses": [
                            "Qui ne peut se concilier avec une autre chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab996ca7-5aa2-4510-8d74-509f23f503b5",
                                "sense_id": "5330eb39-a8df-38c7-a36d-0372c3011827",
                                "text": "À peu près en même temps que Bonnet faisait ses curieuses observations, les naturalistes découvraient d’autres phénomènes bien autrement inconciliables avec les idées qu’on regardait alors comme les fondemens de la science."
                            },
                            {
                                "example_id": "1768345f-763d-467e-8d75-d8fc44d1f1c8",
                                "sense_id": "5330eb39-a8df-38c7-a36d-0372c3011827",
                                "text": "Loin de paraître comme inconciliables avec la piété, les commentaires nouveaux pouvaient sembler à certains mystiques parisiens un compromis heureux entre le néoplatonisme augustinien, l’abélardisme aristotélicien et l’esprit positif des savants ou des astrologues."
                            },
                            {
                                "example_id": "5b02d67f-1a52-41b1-9d5b-68e9c720ac6f",
                                "sense_id": "5330eb39-a8df-38c7-a36d-0372c3011827",
                                "text": "Religion et philosophie ayant été inconciliables face au pouvoir de la révélation, les mouvements réformistes de ces derniers temps ont échoué."
                            }
                        ]
                    },
                    {
                        "sense_id": "f3bda1bb-dc4b-33fa-b3a9-1334a214c11e",
                        "entry_id": "e9fd9cd7-b632-36c0-90ae-f0f2ddd848ca",
                        "glosses": [
                            "Qui ne peut se concilier avec une autre personne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5989a7fc-2210-48a8-a15f-71df35fbbd14",
                                "sense_id": "f3bda1bb-dc4b-33fa-b3a9-1334a214c11e",
                                "text": "Ces deux plaideurs sont inconciliables."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
