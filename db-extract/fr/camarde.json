                                        "entry_id": "a85e4a9f-3d70-39a7-9700-662267a6e027",
                                        "glosses": [
                                            "verpersoonlijking van de dood, voorgesteld als leven skelet, soms gehuld in een donker gewaad of met een zeis als attribuut"
                                        ],
                                        "tags": [
                                            "person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8078b92-d9a4-4d46-a605-47faa5c065f0",
                                                "sense_id": "1c4278a8-6bfb-3346-b133-e26e395595d5",
                                                "text": "Wielrennende vijftigers zijn een plaag. Vroeger kocht een man een sportauto bij zijn midlifecrisis, nu een racefiets. Denken ze Magere Hein uit het wiel te rijden?"
                                            }
                                        ]
                                    }
