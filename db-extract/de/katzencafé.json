                                "target_senses": [
                                    {
                                        "sense_id": "11e99598-7296-3a69-bb2a-cc732262eb13",
                                        "entry_id": "8470ec2a-fe4f-3724-8c6b-559da8988755",
                                        "glosses": [
                                            "café speciaal voor kattenliefhebbers waarin katten vrij rondlopen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8a0e4a4-7628-4c00-ac2b-f0a5ae8ee776",
                                                "sense_id": "11e99598-7296-3a69-bb2a-cc732262eb13",
                                                "text": "Na Tokyo, New York, Wenen, Londen en Parijs heeft Amsterdam vanaf morgen ook een kattencafé. Bij Kopjes kunnen mensen voor 3 euro twee uur lang met in totaal zeven katten knuffelen. Eigenaar Lenny Popelier kan niet wachten."
                                            },
                                            {
                                                "example_id": "ec266103-3d1f-4c96-a8b4-3766a79a0016",
                                                "sense_id": "11e99598-7296-3a69-bb2a-cc732262eb13",
                                                "text": "Kattencafé Parijs lijkt een succes"
                                            },
                                            {
                                                "example_id": "48d47231-32d7-4ab8-8556-b1dc1193ae41",
                                                "sense_id": "11e99598-7296-3a69-bb2a-cc732262eb13",
                                                "text": "De 47-jarige Japanse Takako Ishimitsu heeft in het centrum van Wenen het eerste Oostenrijkse kattencafé geopend: The Café Neko. Neko betekent 'kat' in het Japans. In het café wonen vijf katten, die Ishimitsu uit het dierenasiel in Wenen heeft gehaald. Sonja, Thomas, Morits, Luca en Momo laten zich verwennen door de gasten, die massaal afkomen op de nieuwe horecagelegenheid."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
