{
    "word_family": [],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "597b6dbc-1e52-3cf8-913e-bb7eeb7160f6",
                    "sense_definition": "Having a lower rank or position than others in an organization or profession.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "rank_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She started her career as a <w>junior</w> clerk in a large law firm.",
                            "target_lang_translations": {
                                "ru": "Она начала свою карьеру как <w>младший</w> клерк в крупной юридической фирме.",
                                "zh": "她职业生涯的起点是在一家大型律师事务所担任<w>初级</w>职员。"
                            }
                        },
                        {
                            "text": "The <w>junior</w> partner was responsible for managing the smaller accounts.",
                            "target_lang_translations": {
                                "ru": "<w>Младший</w> партнер отвечал за ведение мелких счетов.",
                                "zh": "<w>初级</w>合伙人负责管理较小的客户账户。"
                            }
                        }
                    ],
                    "antonyms": [
                        "senior"
                    ],
                    "common_phrases": [
                        "junior partner",
                        "junior staff",
                        "junior officer",
                        "junior minister"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий более низкий ранг или должность по сравнению с другими в организации или профессии.",
                        "zh": "在组织或职业中级别或职位较低的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "младший",
                                "target_lang_sense_clarification": "о должности или звании"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "初级",
                                "target_lang_sense_clarification": "指职位或级别"
                            },
                            {
                                "target_lang_word": "低级",
                                "target_lang_sense_clarification": "指地位较低"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ad1181d-00fd-3611-9ae3-26bc92e6ffe0",
                    "sense_definition": "Relating to young people, or involving competitions for younger players.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "age_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He played in the <w>junior</w> league before becoming a professional athlete.",
                            "target_lang_translations": {
                                "ru": "Он играл в <w>юношеской</w> лиге, прежде чем стать профессиональным спортсменом.",
                                "zh": "在成为职业运动员之前，他曾在<w>青少年</w>联赛中效力。"
                            }
                        },
                        {
                            "text": "The library has a large collection of books for <w>junior</w> readers.",
                            "target_lang_translations": {
                                "ru": "В библиотеке есть большая коллекция книг для <w>юных</w> читателей.",
                                "zh": "图书馆收藏了大量供<w>青少年</w>阅读的书籍。"
                            }
                        }
                    ],
                    "antonyms": [
                        "senior"
                    ],
                    "common_phrases": [
                        "junior league",
                        "junior team",
                        "junior high",
                        "junior champion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к молодежи или соревнованиям для молодых игроков.",
                        "zh": "与年轻人有关的，或涉及年轻选手比赛的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "юношеский",
                                "target_lang_sense_clarification": "о спорте или лиге"
                            },
                            {
                                "target_lang_word": "юниорский",
                                "target_lang_sense_clarification": "о спортивных соревнованиях"
                            },
                            {
                                "target_lang_word": "детский",
                                "target_lang_sense_clarification": "о книгах или товарах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "青少年",
                                "target_lang_sense_clarification": "指年龄段"
                            },
                            {
                                "target_lang_word": "少年",
                                "target_lang_sense_clarification": "指体育赛事"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ae909d2-81d4-3451-b517-782b12269c45",
                    "sense_definition": "Relating to the third year of a four-year high school or university.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "edu_us_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During her <w>junior</w> year, she decided to study abroad in Spain.",
                            "target_lang_translations": {
                                "ru": "На <w>третьем</w> курсе она решила поехать учиться за границу в Испанию.",
                                "zh": "在<w>大三</w>那年，她决定去西班牙留学。"
                            }
                        },
                        {
                            "text": "The <w>junior</w> prom is one of the most important social events of the school year.",
                            "target_lang_translations": {
                                "ru": "Бал <w>старшеклассников</w> — одно из самых важных светских событий учебного года.",
                                "zh": "<w>高三</w>舞会是学年中最重要的社交活动之一。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "junior year",
                        "junior prom",
                        "junior class"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "United States"
                        }
                    ],
                    "target_lang_definitions": {
