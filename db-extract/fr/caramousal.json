                        ],
                        "examples": [
                            {
                                "example_id": "d9883484-e3b4-432a-9cea-d340c8d356bc",
                                "sense_id": "6cf6a313-4f10-3b6f-bb6f-bf199a6f10bb",
                                "text": "L’année précédente un caramousal fut pris par le fameux chevalier de Malte Romegas qui trouva à son bord 32 esclaves dont la plupart étaient noirs, sauf quelques Turcs ou Maures."
                            },
                            {
                                "example_id": "4b4db53d-da3b-4269-93b5-9cd6ba4e82b4",
                                "sense_id": "6cf6a313-4f10-3b6f-bb6f-bf199a6f10bb",
                                "text": "Le fait est que, bon an, mal an, Garrote avait eu le temps de parcourir sur les galères du roi la côte de Barbarie et les îles d’Orient, dévastant les terres des infidèles, pillant leurs caramousals et leurs navires de guerre."
                            }
                        ]
