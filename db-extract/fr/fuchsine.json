                ],
                "senses": [
                    {
                        "sense_id": "e11ea0a2-1da7-32c6-b284-28bf9c349e44",
                        "entry_id": "963a260c-4eba-31c4-9ef8-609b589ed6b5",
                        "glosses": [
                            "Chlorhydrate de rosaniline, matière colorante rouge magenta."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33c7cec7-e0d1-4c97-b755-4dbf9c85b40b",
                                "sense_id": "e11ea0a2-1da7-32c6-b284-28bf9c349e44",
                                "text": "La fuchsine renferme une forte proportion d'acide arsénieux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30c25d14-b93f-4933-8a0b-c38bfff4d2cb",
                        "source_entry_id": "963a260c-4eba-31c4-9ef8-609b589ed6b5",
                        "source_sense_id": "e11ea0a2-1da7-32c6-b284-28bf9c349e44",
                        "target_lang_word": "Fuchsin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fuchsin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6feda785-99af-3657-9707-99cfd897ed6f",
                                        "entry_id": "90f8a1ce-68fa-3533-9db8-17d22eea193f",
                                        "glosses": [
                                            "ein synthetischer, magentaroter Farbstoff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d81e294-562f-4cf2-8891-3587ff5db31a",
                                                "sense_id": "6feda785-99af-3657-9707-99cfd897ed6f",
                                                "text": "Diese erste Farbe wurde sowohl in Höchst als auch bei Bayer und BASF unter dem Namen Fuchsin vermarktet."
                                            },
                                            {
                                                "example_id": "6bec1dbe-6042-420b-aa72-12bda73a6e54",
                                                "sense_id": "6feda785-99af-3657-9707-99cfd897ed6f",
                                                "text": "Rehn fand auch die Ursache heraus: Es war das damals in Färbereien häufig verwandte Fuchsin, ein sogenanntes aromatisches Amin."
                                            },
                                            {
                                                "example_id": "299808f8-4615-4463-939f-826d9e37d8df",
                                                "sense_id": "6feda785-99af-3657-9707-99cfd897ed6f",
                                                "text": "BASF-Gründer Friedrich Engelhorn stellte aus dem Abfallprodukt Steinkohlenteer Anilin und Fuchsin her und experimentierte mit künstlichen Farben."
                                            },
                                            {
                                                "example_id": "1170e608-82dc-4b4b-acf7-a093c4b36cd3",
                                                "sense_id": "6feda785-99af-3657-9707-99cfd897ed6f",
                                                "text": "Sie können nachträglich mittels Fuchsin rot gefärbt werden (bei Verwendung der Phasenkontrastmikroskopie ist dies nicht mehr notwendig.)"
                                            },
                                            {
                                                "example_id": "817702c0-1263-4417-b716-21bd57b49254",
                                                "sense_id": "6feda785-99af-3657-9707-99cfd897ed6f",
                                                "text": "Dies wurde ab Mitte des 19. Jahrhunderts durch die erstmalige Verfügbarkeit industriell gefertigter Farben (Teerfarben wie z. B. Mauvein und Fuchsin, insbesondere Azofarbstoff wie Anilingelb) und weiteren Künstlerbedarfs begünstigt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5842a51a-fa92-4f1e-bc29-c6c5759452e0",
                        "source_entry_id": "963a260c-4eba-31c4-9ef8-609b589ed6b5",
                        "source_sense_id": "e11ea0a2-1da7-32c6-b284-28bf9c349e44",
                        "target_lang_word": "fuchsine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fuchsine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31e07585-ee9c-397b-b971-aff2bf84c8af",
                                        "entry_id": "93d95246-4b0c-37f2-90b8-e1e01120c99f",
                                        "glosses": [
                                            "A dye (rosaniline hydrochloride, C₂₀H₁₉N₃·HCl) usually a deep red or magenta colour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7c125de-5ee0-466e-bfe6-e46a49786a6f",
                                                "sense_id": "31e07585-ee9c-397b-b971-aff2bf84c8af",
                                                "text": "By other experiments a much finer subdivision can be made. A solution of .00000002ᵍ of the red coloring matter, fuchsine, in 1ᶜᶜ of alcohol gives a distinct color."
                                            },
                                            {
                                                "example_id": "11b2cc96-8759-44da-bd22-dafeee6879da",
                                                "sense_id": "31e07585-ee9c-397b-b971-aff2bf84c8af",
                                                "text": "Acid members of this class include acid violets, soluble and alkali blues, wool blues, Acid Magenta which is the same as Acid Fuchsine, acid greens, patent blues, ketone blues, Neptune Green, Erioglaucine, and others."
                                            },
                                            {
                                                "example_id": "133199e3-da2f-471f-adc8-3cfcd8516c4b",
                                                "sense_id": "31e07585-ee9c-397b-b971-aff2bf84c8af",
                                                "text": "When skin is stained with Altmann’s acid fuchsin methyl green the spiral filaments of the epidermis are stained only moderately, but typical mitochondria stain clearly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
