                        "cross_references": [
                            {
                                "target_word": "Schwade",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a1311a2c-358a-3343-b8f5-8b7a5863512a",
                                        "entry_id": "669ea522-0f0d-3f83-b2b4-dde5015092c2",
                                        "glosses": [
                                            "abgemähtes Erntegut, das in einer Reihe liegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d242d29c-69d6-42e5-855c-cfa990747f21",
                                                "sense_id": "a1311a2c-358a-3343-b8f5-8b7a5863512a",
                                                "text": "„Auf einer Wiese am Rande des Waldes von Fontainebleau lag das Gras in Schwaden; drei junge Mädchen gingen jede an einer Schwade entlang mit Rechen und warfen es auseinander; sie hatten anmutige Kleider aus weißem Leinen, und ihre hübschen Gesichter, welche durch die Arbeit und Hitze gerötet waren, wurden durch die reizenden Hauben der Erntearbeiterinnen verschattet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schwade",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9906c569-07f7-3fa8-b82c-185bdbd707b7",
                                        "entry_id": "f1d3f099-7fe1-3cf6-ba81-f1648cbcc76f",
                                        "glosses": [
                                            "in der Luft sich bewegende, treibende oder auch dahinziehende wolkenähnliche Zusammenballung von Dunst, Nebel, Rauch oder Stoffen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b12650e0-f5d4-471d-aea9-2d1c968268ce",
                                                "sense_id": "9906c569-07f7-3fa8-b82c-185bdbd707b7",
                                                "text": "Nebel hing in dicken Schwaden über dem Wasser."
                                            },
                                            {
                                                "example_id": "4884042b-3e7c-4786-aa5e-56889d7ee520",
                                                "sense_id": "9906c569-07f7-3fa8-b82c-185bdbd707b7",
                                                "text": "„Der Himmel war grau und rot, und der Wind trieb Schwaden von Rauch vor sich her.“"
                                            },
                                            {
                                                "example_id": "a823904c-41a3-4c9b-b304-7d3ceba61118",
                                                "sense_id": "9906c569-07f7-3fa8-b82c-185bdbd707b7",
                                                "text": "„Ein feiner Regen fiel; fern stieg der Nebel in Schwaden wie große Gespenster.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8e1b26ec-4335-3e63-9478-2a95d89e0584",
                                        "entry_id": "f1d3f099-7fe1-3cf6-ba81-f1648cbcc76f",
                                        "glosses": [
                                            "mit hohem Gehalt an tödlichem Kohlendioxid beladene, schädliche Luft in der Grube oder auch im Schacht/Stollen"
                                        ],
                                        "tags": [
                                            "Bergmannssprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c906b33-6cc3-4784-adb3-40f268589c7b",
                                                "sense_id": "8e1b26ec-4335-3e63-9478-2a95d89e0584",
                                                "text": "Schwaden, in welchen kohlensaures Gas überhand genommen hat, verderben die Grubenwetter."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
