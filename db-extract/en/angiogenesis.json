                        "entry_id": "fbbe803b-6438-3853-823f-4677d295ad06",
                        "glosses": [
                            "The formation and development of new blood vessels."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1f8c0ac-df2c-4cc8-9fc2-e432ebb16eda",
                                "sense_id": "241bbcce-3e32-3e4c-be87-5424f6b875ba",
                                "text": "Some of the most promising new cancer drugs block this process of ‘angiogenesis’, or blood-vessel formation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d4240cf0-27ea-4591-891d-da185b5c42ec",
                        "source_entry_id": "fbbe803b-6438-3853-823f-4677d295ad06",
                        "source_sense_id": "241bbcce-3e32-3e4c-be87-5424f6b875ba",
                        "source_sense_description": "The formation and development of new blood vessels",
                        "target_lang_word": "angiogenèse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "angiogenèse",
