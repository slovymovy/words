        "fr-extract.jsonl": [
            {
                "entry_id": "54ed79d0-a28d-31ce-a8b2-0e5d3a5687a3",
                "word": "consumérisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "37d12a66-e062-4166-b171-11af27c4425d",
                        "entry_id": "54ed79d0-a28d-31ce-a8b2-0e5d3a5687a3",
                        "tags": [
                            "plural"
                        ],
                        "form": "consumérismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a732e76a-6222-302c-9012-e1c995b86922",
                        "entry_id": "54ed79d0-a28d-31ce-a8b2-0e5d3a5687a3",
                        "glosses": [
                            "Protection des intérêts du consommateur par des associations."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "595bf6eb-d448-4ad2-9e4a-d0c71438ac53",
                                "sense_id": "a732e76a-6222-302c-9012-e1c995b86922",
                                "text": "Les entreprises devaient cesser de considérer le consumérisme comme une menace à leurs intérêts, et y trouver plutôt une source de nouvelles possibilités."
                            }
                        ]
                    },
                    {
                        "sense_id": "fe72277f-b029-359c-842c-caa7c68b7c1f",
                        "entry_id": "54ed79d0-a28d-31ce-a8b2-0e5d3a5687a3",
                        "glosses": [
                            "Mode de vie centré sur la consommation."
                        ],
                        "tags": [
                            "hyperbole"
                        ],
                        "examples": [
                            {
                                "example_id": "c13e362e-8c8e-4ec2-95cd-416b26944b72",
                                "sense_id": "fe72277f-b029-359c-842c-caa7c68b7c1f",
                                "text": "Nous employons ici le mot « consumérisme » au sens répandu en sociologie (bien que douteux du point de vue étymologique) qui définit une attitude et un mode de vie centrés sur la consommation. Il ne s'agit donc pas ici du sens, lui aussi courant, qui définit l'« action concertée de consommateurs »."
                            },
                            {
                                "example_id": "860da6f9-e143-426d-8b05-a0dba27e1725",
                                "sense_id": "fe72277f-b029-359c-842c-caa7c68b7c1f",
                                "text": "C’est la victoire du consumérisme égoïste sur la responsabilité intergénérationnelle !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4e7b2264-28f7-4a58-8838-8d0a49606b82",
                        "source_entry_id": "54ed79d0-a28d-31ce-a8b2-0e5d3a5687a3",
                        "source_sense_id": "a732e76a-6222-302c-9012-e1c995b86922",
                        "source_sense_description": "(Économie)",
                        "target_lang_word": "Konsumismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "940c999c-b5c8-4fbf-b820-4cd94ec09afd",
                        "source_entry_id": "54ed79d0-a28d-31ce-a8b2-0e5d3a5687a3",
                        "source_sense_id": "a732e76a-6222-302c-9012-e1c995b86922",
                        "source_sense_description": "(Économie)",
                        "target_lang_word": "consumerism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consumerism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24465b4c-ea7f-306b-bfe7-a27785b52b2b",
                                        "entry_id": "817097b2-1bea-3e15-a311-410a4fddad38",
                                        "glosses": [
                                            "A materialistic attachment to possessions with a heavy use of consumables; a lifestyle based on such tendencies."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffead1a7-4c29-48df-a6b5-7b123c880ff2",
                                                "sense_id": "24465b4c-ea7f-306b-bfe7-a27785b52b2b",
                                                "text": "The fear of corporatism, consumerism, middle-browism and a mass reading public has driven twentieth-century cultural hierarchists."
                                            },
                                            {
                                                "example_id": "323d9b30-18ad-4c3c-ab5a-6250d233e846",
                                                "sense_id": "24465b4c-ea7f-306b-bfe7-a27785b52b2b",
                                                "text": "Insatiable consumerism has blinkered our vision and left us unable to distinguish between what we need and what we merely want."
                                            },
                                            {
                                                "example_id": "cad16efe-4d85-4a67-891f-df885a9a1ef5",
                                                "sense_id": "24465b4c-ea7f-306b-bfe7-a27785b52b2b",
                                                "text": "It’s easy to say, as I often do, that it’s capitalism at work. Yet I am actively involved in consumerism, triggered by my insecurities."
                                            },
                                            {
                                                "example_id": "77b2a1d5-ed24-4e1f-9402-198d5ea937a1",
                                                "sense_id": "24465b4c-ea7f-306b-bfe7-a27785b52b2b",
                                                "text": "“It’s where cultural identity and cheap viral consumerism intersect,” D. Andrew Price, head of content at Memes Media Group, said of how Mr. Kirk’s T-shirt has proliferated in recent days."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79568041-e1d7-36f4-a3ca-07a236493f67",
                                        "entry_id": "817097b2-1bea-3e15-a311-410a4fddad38",
                                        "glosses": [
                                            "An economic theory that increased consumption is beneficial to a nation's economy in the long run."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "089f6a4f-10ab-3058-abff-6256e7b6d321",
                                        "entry_id": "817097b2-1bea-3e15-a311-410a4fddad38",
                                        "glosses": [
                                            "A policy or social movement of protecting and informing consumers through honesty in advertising and packaging, as well as improved safety standards, among other measures."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
