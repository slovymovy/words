                "senses": [
                    {
                        "sense_id": "0ae54b31-61bb-3d7b-8a83-1ee17825ebea",
                        "entry_id": "1fa3e0fa-4132-378e-9808-98701f26dc7b",
                        "glosses": [
                            "Faire perdre son caractère béarnais à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3119bab5-3a79-431e-a77e-e2bfc7f54cd2",
                                "sense_id": "0ae54b31-61bb-3d7b-8a83-1ee17825ebea",
                                "text": "En Béarn, la recherche d’un gentilé est souvent l’affaire de communes rurbaines complètement débéarnisées de telle sorte que des trucs aussi laids que \"Vignois\" pour Vignes passent bien."
                            },
                            {
                                "example_id": "40a4cd17-7e79-4595-b3b5-23f77145a10d",
                                "sense_id": "0ae54b31-61bb-3d7b-8a83-1ee17825ebea",
                                "text": "Tendance lourde de l'occitanisme : ce sont dans les endroits les plus débéarnisés (grande banlieue paloise, bassin de Lacq, ...) qu'il fait ses coups d'éclat, dans le désintérêt total des populations."
                            },
                            {
                                "example_id": "09ff83f0-6da7-4659-953b-e9eedf71fd19",
                                "sense_id": "0ae54b31-61bb-3d7b-8a83-1ee17825ebea",
                                "text": "dire que Jurançon est débéarnisé est très exagéré."
                            }
                        ]
                    }
