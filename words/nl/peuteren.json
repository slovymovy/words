    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c47793a2-76c0-3e49-a0d9-23388c199ced",
                    "sense_definition": "met de vinger of een spits voorwerp in iets wroeten om er iets uit te halen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "wroeten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zit niet zo in je neus te <w>peuteren</w> terwijl we aan tafel zitten.",
                            "target_lang_translations": {
                                "en": "Don't <w>pick</w> your nose like that while we're sitting at the table."
                            }
                        },
                        {
                            "text": "Hij probeerde met een tandenstoker de etensresten tussen zijn tanden uit te <w>peuteren</w>.",
                            "target_lang_translations": {
                                "en": "He tried to <w>pick</w> the food scraps from between his teeth with a toothpick."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in je neus peuteren",
                        "tussen de tanden peuteren"
                    ],
                    "target_lang_definitions": {
                        "en": "to dig or poke into something with a finger or a sharp object to remove something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to pick",
                                "target_lang_sense_clarification": "as in picking one's nose or teeth"
                            },
                            {
                                "target_lang_word": "to dig",
                                "target_lang_sense_clarification": "poking into a small space to extract something"
                            },
                            {
                                "target_lang_word": "to poke",
                                "target_lang_sense_clarification": "using a finger or tool to reach inside"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21b86348-809d-30d7-8d2e-38f6a04ed1fb",
                    "sense_definition": "zenuwachtig of doelloos met de vingers aan iets zitten frunniken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "friemelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij zat zenuwachtig aan het etiket van haar flesje te <w>peuteren</w>.",
                            "target_lang_translations": {
                                "en": "She was nervously <w>picking at</w> the label on her bottle."
                            }
                        },
                        {
                            "text": "Tijdens het wachten begon hij aan een los draadje van zijn jas te <w>peuteren</w>.",
                            "target_lang_translations": {
                                "en": "While waiting, he started <w>fiddling</w> with a loose thread on his coat."
                            }
                        }
                    ],
                    "synonyms": [
                        "friemelen",
                        "frunniken"
                    ],
                    "common_phrases": [
                        "aan een korstje peuteren",
                        "aan een etiket peuteren"
                    ],
                    "target_lang_definitions": {
                        "en": "to nervously or aimlessly fiddle or fidget with something using the fingers"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to fiddle",
                                "target_lang_sense_clarification": "nervously playing with an object"
                            },
                            {
                                "target_lang_word": "to fidget",
                                "target_lang_sense_clarification": "restless movement with the hands"
                            },
                            {
                                "target_lang_word": "to pick at",
                                "target_lang_sense_clarification": "repeatedly touching or pulling at something like a scab or label"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c645330-10f0-3583-be97-89c6a68ce552",
                    "sense_definition": "op een geduldige en kleinschalige manier aan iets knutselen of werken",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "knutselen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij kan urenlang aan zijn oude brommer <w>peuteren</w> om hem weer aan de praat te krijgen.",
                            "target_lang_translations": {
                                "en": "He can <w>tinker</w> with his old moped for hours to get it running again."
                            }
                        },
                        {
                            "text": "De horlogemaker zat met uiterste precisie aan het kleine uurwerk te <w>peuteren</w>.",
                            "target_lang_translations": {
                                "en": "The watchmaker was <w>fiddling</w> with the small movement with extreme precision."
                            }
                        }
                    ],
                    "common_phrases": [
                        "aan een motor peuteren"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used for small-scale repairs or hobbies"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to tinker or work on something in a patient, small-scale, and detailed manner"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to tinker",
                                "target_lang_sense_clarification": "working on a machine or project in a casual way"
                            },
                            {
                                "target_lang_word": "to fiddle with",
                                "target_lang_sense_clarification": "making small adjustments to a mechanism"
                            },
                            {
                                "target_lang_word": "to mess around",
                                "target_lang_sense_clarification": "informal tinkering with a device"
                            }
                        ]
                    }
                }
            ]
        }
    ]
