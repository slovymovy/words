                        ],
                        "examples": [
                            {
                                "example_id": "9ed24e6d-7717-406e-96d8-5f7765a42fd1",
                                "sense_id": "bbf8c7b3-bdca-3fa5-981e-bde667fd67a3",
                                "text": "Ich esse äußerst gerne Faschiertes wie faschierte Laibchen oder einen richtigen faschierten Braten."
                            }
                        ],
