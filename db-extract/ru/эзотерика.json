                        ]
                    },
                    {
                        "translation_id": "23f11f77-9eda-4ee9-a86b-e4b867f08fd6",
                        "source_entry_id": "d363db2d-e93c-383f-9844-999fb0d94c4a",
                        "source_sense_id": "832d9b50-ea24-3e20-89ea-d5f854dfb265",
                        "target_lang_word": "esoterismo",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "esoterismo",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "e5aecbbb-d27b-3616-8c0f-51680ed49652",
                                        "entry_id": "bf8e0612-8547-38ff-ad4e-812a4814e839",
                                        "glosses": [
                                            "nell'occultismo e in alcune concezioni religiose e filosofiche, complesso di dottrine di carattere segreto i cui insegnamenti sono riservati agli adepti, gli unici ad avere la possibilità della rivelazione della verità occulta, del significato nascosto"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "426aab81-0b87-4bfa-902c-7d8e27e62cec",
                                                "sense_id": "e5aecbbb-d27b-3616-8c0f-51680ed49652",
                                                "text": "nell'esoterismo islamico viene discussa l'esistenza delle cosiddette \"essenze eterne\", archetipi divini"
                                            },
                                            {
                                                "example_id": "764f18b9-fde2-416b-8335-5ad129144fc9",
                                                "sense_id": "e5aecbbb-d27b-3616-8c0f-51680ed49652",
                                                "text": "i gesuiti cattolici sono a conoscenza di un esoterismo di cui non vogliono rivelare la natura segreta"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c900d3bc-c690-3f8d-8dc3-0657085d233f",
                                        "entry_id": "bf8e0612-8547-38ff-ad4e-812a4814e839",
                                        "glosses": [
                                            "tendenza di sette e gruppi segreti a non rivelare al di fuori del gruppo le loro dottrine e i loro riti"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "112c0cc2-58f0-4ad4-bf3f-47f1639ed5c5",
                        "source_entry_id": "d363db2d-e93c-383f-9844-999fb0d94c4a",
                        "source_sense_id": "832d9b50-ea24-3e20-89ea-d5f854dfb265",
                        "target_lang_word": "Esoterik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Esoterik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ee03e428-9a05-3ece-a8a1-ee7c3bac1ceb",
                                        "entry_id": "fb13a798-9c09-3fcb-865d-1797be640659",
                                        "glosses": [
                                            "Sammelbegriff für ein weites Spektrum an Weltanschauungen, welche die spirituelle Entwicklung des Individuums betonen, jedoch keine Religion im engeren Sinn sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2181247c-2a84-4f20-85e5-c0a8d34899f7",
                                                "sense_id": "ee03e428-9a05-3ece-a8a1-ee7c3bac1ceb",
                                                "text": "Die Esoterik hat in den letzten Jahrzehnten viele Anhänger gewonnen."
                                            },
                                            {
                                                "example_id": "22af7c25-382d-4feb-859b-55b7a221f16c",
                                                "sense_id": "ee03e428-9a05-3ece-a8a1-ee7c3bac1ceb",
                                                "text": "Die Esoterik nahm Einflüsse aus den asiatischen Religionen auf."
                                            },
                                            {
                                                "example_id": "a01b3cf4-bcf7-4601-ba12-1cb88888e3e7",
                                                "sense_id": "ee03e428-9a05-3ece-a8a1-ee7c3bac1ceb",
                                                "text": "„Daher ist das heutige Schlagwort »Esoterik« als Bezeichnung für eine neue und alternative Religiosität zu verstehen.“"
                                            },
                                            {
                                                "example_id": "e7f18b8f-db80-429c-932d-afbc6879792b",
                                                "sense_id": "ee03e428-9a05-3ece-a8a1-ee7c3bac1ceb",
                                                "text": "„Seit dem 16. Jahrhundert werden die Zigeuner für die Esoterik wichtige mögliche Träger alten paganen Wissens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7cd297e3-e98d-311f-96c9-10a8ef4f40f1",
                                        "entry_id": "fb13a798-9c09-3fcb-865d-1797be640659",
                                        "glosses": [
                                            "die Eigenschaft, ausgefallen, selten oder fernliegend zu sein und damit nur Eingeweihten zugänglich zu sein"
                                        ],
                                        "tags": [
                                            "Geistesleben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "126b34e7-7e1a-4807-a881-e97d4008e1d6",
                                                "sense_id": "7cd297e3-e98d-311f-96c9-10a8ef4f40f1",
                                                "text": "Die Esoterik ihrer Frage lässt mich vermuten, dass sie selbst auf diesem Feld geforscht haben?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
