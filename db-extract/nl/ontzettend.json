        "nl-extract.jsonl": [
            {
                "entry_id": "537d52e8-87aa-3d5a-9d74-cd8c47e115c0",
                "word": "ontzettend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5ccc2eab-2ce9-3ae2-b444-5a5671b36a7f",
                        "entry_id": "537d52e8-87aa-3d5a-9d74-cd8c47e115c0",
                        "glosses": [
                            "waarvan je schrikt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f03e0241-c98a-41d1-80d2-395e37dfcacf",
                                "sense_id": "5ccc2eab-2ce9-3ae2-b444-5a5671b36a7f",
                                "text": "Het weer was vreselijk slecht het was echt ontzettend hoe nat we geworden zijn."
                            }
                        ]
                    },
                    {
                        "sense_id": "afb41e27-42ab-3ddf-9ef5-25b80c1dbe26",
                        "entry_id": "537d52e8-87aa-3d5a-9d74-cd8c47e115c0",
                        "glosses": [
                            "heel erg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c34c34f1-d974-45e6-8d0a-ea935960afad",
                                "sense_id": "afb41e27-42ab-3ddf-9ef5-25b80c1dbe26",
                                "text": "Zij is een ontzettend mooi meisje."
                            },
                            {
                                "example_id": "84b6c099-e401-4da3-b8dc-a682a9077c1c",
                                "sense_id": "afb41e27-42ab-3ddf-9ef5-25b80c1dbe26",
                                "text": "„Elk incident, elke publicatie in de media is slecht voor de positie van Centric, want wij opereren in een markt waarin vertrouwen ontzettend belangrijk is”, schetste Luijten."
                            },
                            {
                                "example_id": "38bd0b0a-aa66-412a-98ac-2ea8cd4b261d",
                                "sense_id": "afb41e27-42ab-3ddf-9ef5-25b80c1dbe26",
                                "text": "Vaticaancorrespondent Andrea Vreede: \"Op deze tweede paasdag had werkelijk niemand verwacht dat opeens dit bericht zou komen over het overlijden van de paus. Gisteren leek het immers alsof hij terug was. Ook al was hij ontzettend kwetsbaar en fragiel, de paus was aanwezig. Hij was zelfs in staat om een beetje te spreken, al leek hij vermoeid."
                            }
                        ]
                    }
                ],
