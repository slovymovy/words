                    }
                ],
                "senses": [
                    {
                        "sense_id": "d98eaf61-385e-3813-9219-2f2c736815fc",
                        "entry_id": "b9d8a25c-6458-32b2-9ecd-66ee8887ba86",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным чердак"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb654018-ddf4-43c2-b229-f491093f7d86",
                                "sense_id": "d98eaf61-385e-3813-9219-2f2c736815fc",
                                "text": "Комната у меня бедная и маленькая, а окно чердачное, полукруглое."
                            },
                            {
                                "example_id": "e835b625-edc6-47f8-875e-387aaa575d2c",
                                "sense_id": "d98eaf61-385e-3813-9219-2f2c736815fc",
                                "text": "Сзади этих палаток, к улице, барахольщики второго сорта раскидывали рогожи, на которых был разложен всевозможный чердачный хлам: сломанная медная ручка, кусок подсвечника, обломок старинной канделябры, разрозненная посуда, ножны от кинжала."
                            }
                        ]
                    }
                ],
