                        "sense_id": "5f8bee83-c692-3af3-a81e-95dc06fb6024",
                        "entry_id": "e7eaf64b-abae-3968-9dee-4ac39452fe0b",
                        "glosses": [
                            "религ. складна́я икона с двумя створками; складень"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8a7f7d90-7624-369a-b3c0-24492989856d",
                        "entry_id": "e7eaf64b-abae-3968-9dee-4ac39452fe0b",
                        "glosses": [
