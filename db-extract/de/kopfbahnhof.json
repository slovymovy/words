                ],
                "senses": [
                    {
                        "sense_id": "d8e08d12-ed85-3f1e-871e-417bf140f4c5",
                        "entry_id": "7d111582-ab8d-30c5-bc19-a418de937ccb",
                        "glosses": [
                            "Bahnhof, in den die Züge nur aus einer Richtung einfahren und in umgekehrter Fahrtrichtung wieder ausfahren können, weil die Gleise im Bahnhof enden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d195d6b1-9da4-4a51-a97a-6af56ee2f642",
                                "sense_id": "d8e08d12-ed85-3f1e-871e-417bf140f4c5",
                                "text": "Viele Großstädte, wie Stuttgart oder Frankfurt, haben Kopfbahnhöfe."
                            },
                            {
                                "example_id": "3249e896-0b09-4420-8138-a8075098952e",
                                "sense_id": "d8e08d12-ed85-3f1e-871e-417bf140f4c5",
                                "text": "„Im Zuge des hoch umstrittenen Projekts Stuttgart soll aus dem Stuttgarter Kopfbahnhof ein Tiefbahnhof werden.“"
                            },
                            {
                                "example_id": "a3c513ac-dc56-4817-9225-90dce74a50c0",
                                "sense_id": "d8e08d12-ed85-3f1e-871e-417bf140f4c5",
                                "text": "„Man sollte glauben, die acht Gleise in der Tiefe leisteten mehr als die 16 im Kopfbahnhof.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
