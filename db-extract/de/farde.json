                                        "sense_id": "fd420a7d-5183-3d51-9a26-6d568d6540e5",
                                        "entry_id": "2c925614-14be-3f68-a59f-6139700c53de",
                                        "glosses": [
                                            "Cartouche de cigarettes."
                                        ],
                                        "tags": [
