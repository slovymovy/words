                                "target_senses": [
                                    {
                                        "sense_id": "7c230984-6215-3317-88a5-34e9e5b6c0f2",
                                        "entry_id": "8911e036-9548-32b4-9753-b14723d85689",
                                        "glosses": [
                                            "A theory of evolution, especially the scientific theory of evolution through natural selection."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b08dd241-cdeb-3639-99ce-4ab159766cc8",
                                        "entry_id": "8911e036-9548-32b4-9753-b14723d85689",
                                        "glosses": [
                                            "Any model of disequilibrium or accumulating change."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ba90aec-9e00-4f96-9754-30f04647e261",
                                                "sense_id": "b08dd241-cdeb-3639-99ce-4ab159766cc8",
                                                "text": "Opposed to the evolutionary theory of the universe is the theory of the steady state universe."
                                            },
                                            {
                                                "example_id": "244aac1d-3f4a-45c1-b638-957f68a6165a",
                                                "sense_id": "b08dd241-cdeb-3639-99ce-4ab159766cc8",
                                                "text": "A more refined version is the concept of restless capitalism developed by Metcalfe, working on the evolutionary theory of economic change by Nelson and Winter. In both cases, the economy is in a state of disequilibrium all of the time."
                                            }
                                        ]
                                    }
                                ]
                            }
