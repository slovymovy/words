                "senses": [
                    {
                        "sense_id": "5c97e7a3-8ea5-3dfa-b159-c9675481e72e",
                        "entry_id": "d6e74051-614f-3b3b-af96-a68a51725c93",
                        "glosses": [
                            "gekleurd vierkant velletje waarmee men kan knutselen door het te vouwen, te knippen en te plakken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f340a95-5ce8-4fb6-bf3b-797b7f27717c",
                                "sense_id": "5c97e7a3-8ea5-3dfa-b159-c9675481e72e",
                                "text": "Consumenten lopen dus over. Zo ook Ineke van Rooijen (41). „Vroeger kocht ik mijn schoonmaakmiddelen en decoratie voor in huis bij Blokker. Nu ga ik naar Action”, vertelt de moeder van drie. „Er is meer keus en het scheelt heel veel geld met drie kinderen. Vouwblaadjes koop ik voor 1 euro bij Action.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "dc3d0cec-6940-3407-9af2-34ff28131e47",
                        "entry_id": "d6e74051-614f-3b3b-af96-a68a51725c93",
                        "glosses": [
                            "gevouwen vel met informatie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1dc0add-e184-4475-bcf5-b9e8a973ec0a",
                                "sense_id": "dc3d0cec-6940-3407-9af2-34ff28131e47",
                                "text": "”Het Loo in oorlogstijd” is tot 16 september te bezichtigen. De expositie is toegankelijk vanaf 13.00 uur op de dagen waarop het paleis is geopend. Voor 50 cent is een vouwblad te koop dat bezoekers langs plaatsen in het paleis voert die aan die periode herinneren."
                            },
                            {
                                "example_id": "f5795dd8-a789-4db2-8f11-ff09fc60e9f0",
                                "sense_id": "dc3d0cec-6940-3407-9af2-34ff28131e47",
                                "text": "Museum Flehite heeft een vouwblad gemaakt, waarin wordt uitgelegd wat er in de kapel te zien is. Daarbij wordt uitleg gegeven over de gotische bouwstijl, maar ook over de vele liturgische voorwerpen. Deze geven een beeld van de traditionele rooms-katholieke geloofsovertuigingen."
                            }
                        ]
                    }
                ],
