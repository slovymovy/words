                "senses": [
                    {
                        "sense_id": "dd497612-c7b7-3eeb-a6dd-dd44ac4c2369",
                        "entry_id": "36b55153-3a77-3d36-8173-5b9f724125b2",
                        "glosses": [
                            "Flucht, Rückzug vor der realen Welt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2ce6f01-8cdc-4925-9ecf-dabb7b95a982",
                                "sense_id": "dd497612-c7b7-3eeb-a6dd-dd44ac4c2369",
                                "text": "„Im Negativen neigt Josua zum Abheben und zur Realitätsflucht.“"
                            },
                            {
                                "example_id": "0f7d2dcf-60b0-43bd-bbe3-faefb9052dbe",
                                "sense_id": "dd497612-c7b7-3eeb-a6dd-dd44ac4c2369",
                                "text": "„Schon in meiner Kindheit liebte ich die Realitätsflucht von Film und Fernsehen.“"
                            },
                            {
                                "example_id": "93c966dd-f67c-4a97-bd77-5605d35d3629",
                                "sense_id": "dd497612-c7b7-3eeb-a6dd-dd44ac4c2369",
                                "text": "„In berückend schöner, kraftvoller Sprache entfaltet Ava Farmehri eine Geschichte von politischem Aufruhr, von Realitätsflucht, Unterdrückung und Isolation – makaber und magisch zugleich.“"
                            },
                            {
                                "example_id": "589bd976-b44e-4cee-9551-32cc9886c70b",
                                "sense_id": "dd497612-c7b7-3eeb-a6dd-dd44ac4c2369",
                                "text": "„Die bereits stark ausgeprägte Identitätslosigkeit wird durch die ausgefeilte ‚Realitätsflucht‘ auffällig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
