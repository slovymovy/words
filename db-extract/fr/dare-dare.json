                    },
                    {
                        "form_id": "525e2e8a-6112-4e8c-b84a-bc50f4d16201",
                        "entry_id": "e1b92d55-df42-3ff7-b662-2a1e5175ee6f",
                        "tags": [],
                        "form": "dare, dare"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0ededc79-053e-3c11-b221-bd9443cd626e",
                        "entry_id": "e1b92d55-df42-3ff7-b662-2a1e5175ee6f",
                        "glosses": [
                            "Vite ; précipitamment ; promptement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4d5bf62-5459-4c2d-9048-0aa66c29b91c",
                                "sense_id": "0ededc79-053e-3c11-b221-bd9443cd626e",
                                "text": "– […] Je crois connaître assez la mère, pour être sûr qu’elle s’en ira dare-dare à Paris avec son peintre."
                            },
                            {
                                "example_id": "ca392c8d-2095-462d-be85-13846f6c7306",
                                "sense_id": "0ededc79-053e-3c11-b221-bd9443cd626e",
                                "text": "Il tombe comme une bombe à l’hôtel, et dare, dare, fait lever tout le monde."
                            },
                            {
                                "example_id": "559e65d0-0993-4ea7-b6fc-059d040046a7",
                                "sense_id": "0ededc79-053e-3c11-b221-bd9443cd626e",
                                "text": "Tu ne te souviens sans doute pas de moi, m'écrivait-il, mais il est impossible que tu aies complètement oublié nos petites aventures guerrières de l'été 1914, l'entrée en Belgique par Trelon, la rentrée en France, dare-dare, par Solre-le-Château, et cette sinistre nuit de Zorées, et cette traversée du bois du Nouvion, […]."
                            },
                            {
                                "example_id": "1e1f7c41-90bc-444a-826f-bb0fcf228c89",
                                "sense_id": "0ededc79-053e-3c11-b221-bd9443cd626e",
                                "text": "Certain d’être menacé de toutes parts, Jacques eut envie de déposer sa serviette sur un banc et de filer dare-dare."
                            },
                            {
                                "example_id": "df79e234-0bb4-4de5-be87-d4da012f04e3",
                                "sense_id": "0ededc79-053e-3c11-b221-bd9443cd626e",
                                "text": "J’aime mieux m’en tenir à ma première façon\nEt me gratter le ventre en chantant des chansons.\nSi le public en veut, je les sors dare-dare,\nS’il n'en veut pas je les remets dans ma guitare."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a690490-bf39-4c68-b3d4-3a748c921780",
                        "source_entry_id": "e1b92d55-df42-3ff7-b662-2a1e5175ee6f",
                        "source_sense_id": "0ededc79-053e-3c11-b221-bd9443cd626e",
