                            {
                                "example_id": "22fa61ea-61ca-43ae-af23-5ed098ff5f98",
                                "sense_id": "57336e99-7a7d-39c9-9100-fc0c4cff73fc",
                                "text": "Et la tétonnière de la troupe, débraillée dans sa robe mal agrafée, pour se gaver plus à l'aise, avait ôté son corset."
                            }
                        ]
                    },
