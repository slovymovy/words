                                        "glosses": [
                                            "Someone who attacks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "596cbbf8-23bc-4a7a-bdf1-eae80f447725",
                                                "sense_id": "1c85e5da-c06f-39a6-ae43-3c627ecfeb6a",
                                                "text": "[…] expecting the woman to take her attacker into physical custody is tantamount to preventing the arrest. If she could handle him, she probably would not need to call the police in the first place."
                                            },
                                            {
                                                "example_id": "5baaf9c5-d9c1-4440-be67-16845767a97d",
                                                "sense_id": "1c85e5da-c06f-39a6-ae43-3c627ecfeb6a",
                                                "text": "In this manner, the victim may be able to discover the one or many zombied systems that are causing the DoS attack but probably won't be able to track down the actual attacker."
                                            },
                                            {
                                                "example_id": "c6a4151d-5ed7-48be-adad-12459bd9fc72",
                                                "sense_id": "1c85e5da-c06f-39a6-ae43-3c627ecfeb6a",
                                                "text": "The targets suggest the attackers are sympathetic to the vast censorship apparatus known as the Great Firewall of China."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecaf6c8f-2090-387a-b46d-d93b8d6ea0a7",
                                        "entry_id": "f7fcc3ad-74d0-3f3c-8c86-85533649bc74",
                                        "glosses": [
                                            "One of the players on a team in football (soccer) in the row nearest to the opposing team's goal, who are therefore principally responsible for scoring goals."
