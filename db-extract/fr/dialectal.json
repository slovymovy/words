                    }
                ],
                "senses": [
                    {
                        "sense_id": "c793c44b-8b37-3733-9fed-dd24f5eb8271",
                        "entry_id": "639b7346-242e-3156-a48b-77e4d7d5e6ae",
                        "glosses": [
                            "Relatif au dialecte, au parler régional."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30f04b19-6f38-4053-8b2f-9509baf0f670",
                                "sense_id": "c793c44b-8b37-3733-9fed-dd24f5eb8271",
                                "text": "Dans ce sens, le « Théâtre Alsacien de Strasbourg » ne représente quʼune société supplémentaire qui cherche à faire vivre ce théâtre dialectal."
                            },
                            {
                                "example_id": "5c892899-5634-46be-aacb-885146377585",
                                "sense_id": "c793c44b-8b37-3733-9fed-dd24f5eb8271",
                                "text": "L’IGN a estimé qu'il y avait donc un très grand intérêt à établir un fichier de termes dialectaux attestés en toponymie ou susceptibles d'y être rencontrés ; […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7526b81c-f3ee-4b33-93f1-39d4c8fbc7fc",
                        "source_entry_id": "639b7346-242e-3156-a48b-77e4d7d5e6ae",
                        "source_sense_id": "c793c44b-8b37-3733-9fed-dd24f5eb8271",
                        "target_lang_word": "mundartlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mundartlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "095324b9-554f-3e45-a145-2d91e1ff6ee8",
                                        "entry_id": "a9f42198-7af0-3897-b7b9-eb5fc8b7b4b7",
                                        "glosses": [
                                            "die Mundart betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11ca2f30-607f-4d33-af81-a556535702fe",
                                                "sense_id": "095324b9-554f-3e45-a145-2d91e1ff6ee8",
                                                "text": "„Das liegt auch an der mundartlichen Vielfalt, der sich jeder schnell bewußt wird, der hier lebt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0514545f-5859-3f70-bc2a-a5ad90c2dd6f",
                                        "entry_id": "a9f42198-7af0-3897-b7b9-eb5fc8b7b4b7",
                                        "glosses": [
                                            "in einer Mundart"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f11baca-d3ee-4308-97ea-d6470ceb25f4",
                                                "sense_id": "0514545f-5859-3f70-bc2a-a5ad90c2dd6f",
                                                "text": "Heute sind bei Radio und Fernsehen die Regionalnachrichten mundartlich und dies, was besonders aufschlussreich ist, unter weitgehender Beibehaltung der genannten textsortentypischen Merkmale in Syntax und Lexikon."
                                            },
                                            {
                                                "example_id": "568a0def-2b36-4350-ad85-e9e6dfe96845",
                                                "sense_id": "0514545f-5859-3f70-bc2a-a5ad90c2dd6f",
                                                "text": "Apfelwein, mundartlich auch \"Äppelwoi\" oder liebevoll \"Stöffche\" genannt, in Hessen \"Nationalgetränk\", hat keine Lobby!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f5ecf92-5a0b-42fd-b732-56ad10b0e7ab",
                        "source_entry_id": "639b7346-242e-3156-a48b-77e4d7d5e6ae",
                        "source_sense_id": "c793c44b-8b37-3733-9fed-dd24f5eb8271",
                        "target_lang_word": "dialektal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dialektal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eee05846-1210-3707-a8df-8beafc3f0935",
                                        "entry_id": "738e7b82-1a17-3a30-b2bc-e2ce3540e127",
                                        "glosses": [
                                            "einen Dialekt betreffend; mundartlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e37e08d3-f212-4abf-802e-67f47471098b",
                                                "sense_id": "eee05846-1210-3707-a8df-8beafc3f0935",
                                                "text": "„Für Deutschland nimmt man ein Nord-Süd-Gefälle an, weil die südlichen regionalen Umgangssprachen deutlicher dialektal gefärbt sind.“"
                                            },
                                            {
                                                "example_id": "a8a0fb44-f829-4f8b-b89b-aa774cd8f374",
                                                "sense_id": "eee05846-1210-3707-a8df-8beafc3f0935",
                                                "text": "„Der aus Graz gebürtige Peter Simonischek liest die Novelle mit weicher, mild dialektaler Stimme, so innerlich und einfach, dass dezenteste Tempo- und Rhythmusänderungen hinreichen, um eine unendliche Vielfalt an Stimmungen zu erzeugen.“"
                                            },
                                            {
                                                "example_id": "d93dfb7c-38f8-4897-aec0-7d69207a19aa",
                                                "sense_id": "eee05846-1210-3707-a8df-8beafc3f0935",
                                                "text": "„Der Tendenz, Dialektismen mit dieser stilistischen (oder ideologiekritischen) Absicht bewußt einzusetzen, steht die andere entgegen, sie möglichst zu vermeiden, was dazu führt, daß Schweizer sprachliche Elemente als dialektal betrachten, die durchaus hochsprachlich oder zumindest süddeutsch sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ed209a4-0afc-4fc7-bca4-04575c95026f",
                        "source_entry_id": "639b7346-242e-3156-a48b-77e4d7d5e6ae",
                        "source_sense_id": "c793c44b-8b37-3733-9fed-dd24f5eb8271",
                        "target_lang_word": "dialectal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dialectal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20b91ae6-c58f-3b55-ac4e-59371c4ac17a",
                                        "entry_id": "752c21c0-02f3-3b76-ab28-bd4a09bc45fe",
                                        "glosses": [
                                            "Of or relating to a dialect."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "70c9c370-0fba-37a3-946e-c12f518ad2d1",
                                        "entry_id": "752c21c0-02f3-3b76-ab28-bd4a09bc45fe",
                                        "glosses": [
                                            "Peculiar to a (nonstandard) variety or lect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "537d90c7-c074-45be-9dcd-1c57781e63e3",
                                                "sense_id": "70c9c370-0fba-37a3-946e-c12f518ad2d1",
                                                "text": "Now (exc. in Nautical language, see b) it is only dialectal or an illiterate substitute for lie, its identity of form with the past tense of the latter no doubt accounting largely for the confusion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5294fcdb-c711-47e3-850e-da8086e679e6",
                        "source_entry_id": "639b7346-242e-3156-a48b-77e4d7d5e6ae",
                        "source_sense_id": "c793c44b-8b37-3733-9fed-dd24f5eb8271",
