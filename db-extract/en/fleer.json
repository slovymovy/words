                "senses": [
                    {
                        "sense_id": "55444422-103a-351b-9a5b-32b33f3137e9",
                        "entry_id": "e05dda1f-e3eb-34b5-b94c-68be944bdb1d",
                        "glosses": [
                            "One who flees."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb9ee3bd-a4df-4f14-a5ad-5d1cd8049328",
                                "sense_id": "55444422-103a-351b-9a5b-32b33f3137e9",
                                "text": "Which fear of the fleers away was no less ignominious, then if[…]they had turned their backs to the enemie."
                            }
                        ]
                    }
