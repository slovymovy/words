                                        "sense_id": "6602954b-935c-34d5-8f6f-fdf8c1d21435",
                                        "entry_id": "7c90c433-0ccd-3fc5-8ddc-9adc7d198115",
                                        "glosses": [
                                            "człowiek, który wykazał się męstwem, odwagą, poświęceniem itp."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05a0ef2f-7090-4018-967b-d25faefcab7a",
                                                "sense_id": "6602954b-935c-34d5-8f6f-fdf8c1d21435",
                                                "text": "Inna nadzieja demokratów to John Kerry, senator z Massachusetts, bohater wojny w Wietnamie, gdzie został kilkakrotnie ranny"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "1ce450fa-d20d-3434-b166-2f6a0df4a70b",
                                        "entry_id": "7c90c433-0ccd-3fc5-8ddc-9adc7d198115",
                                        "glosses": [
                                            "główna postać utworu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72f5fc50-8cd5-4b28-a0d1-e59f6a35206c",
                                                "sense_id": "1ce450fa-d20d-3434-b166-2f6a0df4a70b",
                                                "text": "Jak pamiętamy, główny bohater „Potopu” pan Andrzej Kmicic był najważniejszym bacą na Żmudzi, stąd słynna jego baranica, którą okrywał się, pędząc z Oleńką w rozpędzonych saniach z Wodoktów do Wołmontowicz"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "14e76e25-cd72-36a3-a187-4020fd2b22ec",
                                        "entry_id": "7c90c433-0ccd-3fc5-8ddc-9adc7d198115",
                                        "glosses": [
                                            "osoba budząca chwilowe zainteresowanie, chwilowo skupiająca na sobie uwagę otoczenia"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0862af8b-2cea-4437-b8a5-2d9e669233ac",
                                                "sense_id": "14e76e25-cd72-36a3-a187-4020fd2b22ec",
                                                "text": "To bohater krytycznych artykułów o wykorzystywaniu anteny publicznej telewizji do realizowania partyjnych interesów żony"
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    }
                                ]
