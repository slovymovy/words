                ],
                "senses": [
                    {
                        "sense_id": "89a1cf26-d2fa-3dc6-b790-b6d4067752ba",
                        "entry_id": "d14113b3-b6b0-3ee1-9ba4-3f27d2fa716c",
                        "glosses": [
                            "zich ~: een provisorische oplossing bedenken voor een probleem dat men heeft bij gebrek aan middelen"
                        ],
                        "tags": [
                            "reflexive"
                        ],
                        "examples": [
                            {
                                "example_id": "6d53a288-f56c-447b-a8a6-1c4daa955866",
                                "sense_id": "89a1cf26-d2fa-3dc6-b790-b6d4067752ba",
                                "text": "Wie nog geen familienaam had en niet door zijn beroep of bijnaam werd aangeduid, behielp zich met zijn uithangbord of gevelsteen."
                            },
                            {
                                "example_id": "a6a363c3-0f8f-4530-af47-5eef58366e6b",
                                "sense_id": "89a1cf26-d2fa-3dc6-b790-b6d4067752ba",
                                "text": "Op de natuurcamping moet je je maar behelpen met eenvoudige middelen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b73bcfb-c8b1-44e7-9fa1-4ac996670ace",
                        "source_entry_id": "d14113b3-b6b0-3ee1-9ba4-3f27d2fa716c",
                        "source_sense_id": "89a1cf26-d2fa-3dc6-b790-b6d4067752ba",
                        "source_sense_description": "zich ~: een provisorische oplossing bedenken voor een probleem dat men heeft bij gebrek aan middelen",
                        "target_lang_word": "sich behelfen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "dfd88175-15b4-4b66-8e92-1cf8aa0f906d",
                        "source_entry_id": "d14113b3-b6b0-3ee1-9ba4-3f27d2fa716c",
                        "source_sense_id": "89a1cf26-d2fa-3dc6-b790-b6d4067752ba",
                        "source_sense_description": "zich ~: een provisorische oplossing bedenken voor een probleem dat men heeft bij gebrek aan middelen",
                        "target_lang_word": "make do",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "make do",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "105387cc-5d0e-3630-bca9-0444e2352513",
                                        "entry_id": "1ba972db-a5a9-387b-a00d-ce660d1aad89",
                                        "glosses": [
                                            "To survive, get by (with), or use whatever is available (due to lack of resources)."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc716ac8-ac98-4888-8330-c0bdb3315f2f",
                                                "sense_id": "105387cc-5d0e-3630-bca9-0444e2352513",
                                                "text": "There is barely enough money, so we will have to make do with what we have."
                                            },
                                            {
                                                "example_id": "d0c9268a-aec3-44dc-ba87-669a57fb29c3",
                                                "sense_id": "105387cc-5d0e-3630-bca9-0444e2352513",
                                                "text": "Pep Guardiola’s team will have to make do with the Premier League title whereas Liverpool will go into Friday’s draw because over the two legs they were more clinical during their spells of superiority."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "280a23be-ed1f-3de5-a3da-31319781aae2",
                                        "entry_id": "1ba972db-a5a9-387b-a00d-ce660d1aad89",
                                        "glosses": [
                                            "To put into action."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f08ae8da-c583-47bd-bcee-54784e9ed2c7",
                                                "sense_id": "280a23be-ed1f-3de5-a3da-31319781aae2",
                                                "text": "Make the movie do! (Put on the movie!)"
                                            },
                                            {
                                                "example_id": "1f31e37f-01a9-47f8-abe9-2bdcddfd491a",
                                                "sense_id": "280a23be-ed1f-3de5-a3da-31319781aae2",
                                                "text": "Brandon’s makin’ the grill do so we can get to eatin’."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e93306f4-c653-3b1b-959c-b77cd95fb324",
                                        "entry_id": "1ba972db-a5a9-387b-a00d-ce660d1aad89",
                                        "glosses": [
                                            "To use for one's purpose something worn, defective, or intended for another purpose."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f73bb8d1-3e83-4c2a-ade2-ff1baddd13de",
                                                "sense_id": "e93306f4-c653-3b1b-959c-b77cd95fb324",
                                                "text": "A poor screw-driver is one of the most exasperating of poor tools, and a trial to one's patience and temper; besides, it is of little use attempting to \"make it do,\" for it seldom will do."
                                            },
                                            {
                                                "example_id": "eacded13-6230-466a-b94e-260144d28660",
                                                "sense_id": "e93306f4-c653-3b1b-959c-b77cd95fb324",
                                                "text": "It is not the same hide but we make it do. You work harder to make it into good leather and harder to make it into good shoes, and we get by."
                                            },
                                            {
                                                "example_id": "cd67f4fa-70cd-4c1f-b403-1264418130d6",
                                                "sense_id": "e93306f4-c653-3b1b-959c-b77cd95fb324",
                                                "text": "She had dozens of ways to make something ‘do’ for another week or month. Skillful with a needle, she could darn and re- darn our socks without making the heel or toe uncomfortably thick"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
