{
    "word_family": [
        "wringer",
        "wringing"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c5ef63b3-4921-3ec2-b178-5d4245a985db",
                    "sense_definition": "To squeeze or twist something moist tightly so that liquid is forced out.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "squeeze_liquid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I did not have a towel so I just <w>wrung</w> my hair dry.",
                            "target_lang_translations": {
                                "pl": "Nie miałem ręcznika, więc po prostu <w>wyżąłem</w> włosy do sucha."
                            }
                        },
                        {
                            "text": "Please <w>wring</w> the wet cloth before you start cleaning the table.",
                            "target_lang_translations": {
                                "pl": "Proszę <w>wyżyj</w> mokrą szmatkę, zanim zaczniesz wycierać stół."
                            }
                        }
                    ],
                    "synonyms": [
                        "squeeze"
                    ],
                    "common_phrases": [
                        "wring out"
                    ],
                    "target_lang_definitions": {
                        "pl": "Ściskać lub wykręcać coś wilgotnego, aby usunąć płyn."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wyżymać",
                                "target_lang_sense_clarification": "proces wyciskania wody z tkaniny"
                            },
                            {
                                "target_lang_word": "wyżąć",
                                "target_lang_sense_clarification": "dokonane wyciśnięcie wody z tkaniny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d29351ed-b391-3520-a226-de3834a1837c",
                    "sense_definition": "To hold someone or something tightly and press or twist.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hold_tightly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Margaret could not speak for crying, but she <w>wrung</w> his hand at parting.",
                            "target_lang_translations": {
                                "pl": "Margaret nie mogła mówić przez płacz, ale na pożegnanie mocno <w>uścisnęła</w> jego dłoń."
                            }
                        },
                        {
                            "text": "Jason stood, slowly <w>wringing</w> the brim of his hat in his hands.",
                            "target_lang_translations": {
                                "pl": "Jason stał, powoli <w>wykręcając</w> w dłoniach rondo swojego kapelusza."
                            }
                        }
                    ],
                    "synonyms": [
                        "squeeze"
                    ],
                    "common_phrases": [
                        "wring hand"
                    ],
                    "target_lang_definitions": {
                        "pl": "Mocno trzymać kogoś lub coś, ściskając lub wykręcając."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ściskać",
                                "target_lang_sense_clarification": "mocne trzymanie dłoni lub przedmiotu"
                            },
                            {
                                "target_lang_word": "wykręcać",
                                "target_lang_sense_clarification": "wyginanie przedmiotu w dłoniach"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54358f65-c2e0-3f66-81e5-a906a61cef2c",
                    "sense_definition": "To clasp and twist hands together due to distress or sorrow.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "hold_tightly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She began to <w>wring</w> her hands with worry when she heard the bad news.",
                            "target_lang_translations": {
                                "pl": "Zaczęła <w>łamać ręce</w> z niepokoju, gdy usłyszała złe wieści."
                            }
                        },
                        {
                            "text": "The mother <w>wrung</w> her hands in despair while waiting for the doctor.",
                            "target_lang_translations": {
                                "pl": "Matka <w>załamywała ręce</w> w rozpaczy, czekając na lekarza."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wring hands"
                    ],
                    "target_lang_definitions": {
                        "pl": "Zaciskać i wykręcać dłonie z powodu niepokoju lub smutku."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "łamać ręce",
                                "target_lang_sense_clarification": "gest wyrażający rozpacz lub bezradność"
                            },
                            {
                                "target_lang_word": "załamywać ręce",
                                "target_lang_sense_clarification": "gest wyrażający głęboki niepokój"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb23223b-cf90-340a-9d96-afc53ddba4f5",
                    "sense_definition": "To cause distress or pain to a person or their heart.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cause_pain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It <w>wrung</w> my heart to see the abandoned puppy in the rain.",
                            "target_lang_translations": {
                                "pl": "Serce mi się <w>krajało</w>, widząc porzuconego szczeniaka na deszczu."
                            }
                        },
                        {
                            "text": "The tragic story <w>wrung</w> the souls of everyone in the audience.",
                            "target_lang_translations": {
                                "pl": "Ta tragiczna historia <w>wstrząsnęła</w> duszami wszystkich widzów."
                            }
                        }
                    ],
                    "synonyms": [
                        "distress",
                        "torment"
                    ],
                    "common_phrases": [
                        "wring heart"
                    ],
                    "target_lang_definitions": {
                        "pl": "Powodować u kogoś wielki smutek lub ból emocjonalny."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rozdzierać serce",
                                "target_lang_sense_clarification": "powodować głęboki ból emocjonalny"
                            },
                            {
                                "target_lang_word": "ściskać za serce",
                                "target_lang_sense_clarification": "wywoływać silne wzruszenie lub smutek"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ed6094ad-de1c-3eb1-9e58-d3d8281631f4",
                    "sense_definition": "A powerful squeezing or twisting action.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "squeeze_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I grasped his hand and gave it a grateful <w>wring</w>.",
                            "target_lang_translations": {
                                "pl": "Chwyciłem go za rękę i z wdzięcznością ją <w>uścisnąłem</w>."
                            }
                        },
                        {
                            "text": "He gave the wet towel a final <w>wring</w> before hanging it up.",
                            "target_lang_translations": {
                                "pl": "Jeszcze raz <w>wyżył</w> mokry ręcznik, zanim go powiesił."
                            }
                        }
                    ],
                    "synonyms": [
                        "squeeze"
                    ],
                    "target_lang_definitions": {
                        "pl": "Silne ściśnięcie lub wykręcenie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "uścisk",
                                "target_lang_sense_clarification": "mocne zaciśnięcie dłoni"
                            },
                            {
                                "target_lang_word": "wykręcenie",
                                "target_lang_sense_clarification": "czynność wyżymania lub skręcania"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5f85fca-a8c3-3a04-995d-9da71d72ff5a",
                    "sense_definition": "A device for compressing or pressing, especially for making cheese or cider.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "squeeze_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cheese <w>wring</w> dripped monotonously downstairs.",
                            "target_lang_translations": {
                                "pl": "Z <w>prasy</w> do sera monotonnie kapało na dół."
                            }
                        },
                        {
                            "text": "They collected the juice coming from the <w>wring</w> to make fresh cider.",
                            "target_lang_translations": {
                                "pl": "Zbierali sok wypływający z <w>prasy</w>, aby zrobić świeży cydr."
                            }
                        }
                    ],
                    "synonyms": [
                        "press"
                    ],
                    "target_lang_definitions": {
                        "pl": "Urządzenie do wyciskania, używane np. do produkcji sera lub cydru."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "prasa",
                                "target_lang_sense_clarification": "urządzenie mechaniczne do wyciskania"
                            },
                            {
                                "target_lang_word": "wyciskarka",
                                "target_lang_sense_clarification": "urządzenie do wydobywania soku"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}