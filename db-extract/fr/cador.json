        "fr-extract.jsonl": [
            {
                "entry_id": "e1bcb4d0-20dc-3a6e-8703-23878db9ba8a",
                "word": "cador",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ee64f7db-ead9-4e75-a616-c0781b75cfa2",
                        "entry_id": "e1bcb4d0-20dc-3a6e-8703-23878db9ba8a",
                        "tags": [
                            "plural"
                        ],
                        "form": "cadors"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c3f08c81-ba37-3438-ad1b-e416965b0e05",
                        "entry_id": "e1bcb4d0-20dc-3a6e-8703-23878db9ba8a",
                        "glosses": [
                            "Champion, personne compétente, dominante, experte, performante dans un domaine particulier."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "3bbc1a85-ed24-47c2-9668-694d4d298476",
                                "sense_id": "c3f08c81-ba37-3438-ad1b-e416965b0e05",
                                "text": "Et le Mexicain, ç’a été une épée, un cador ; moi je suis objectif, on parlera encore de lui dans cent ans."
                            },
                            {
                                "example_id": "af33107e-4e8d-43c4-a1ad-d8458d3fc588",
                                "sense_id": "c3f08c81-ba37-3438-ad1b-e416965b0e05",
                                "text": "Alors que les autres salariés du groupe attendent un geste des joueurs, de nombreux cadors européens, parmi lesquels le Barça, le Real Madrid, le Bayern Munich ou la Juventus Turin, ont trouvé un accord."
                            },
                            {
                                "example_id": "dcb75a3c-3b5a-4c01-83e3-7b3fe4cdc6f5",
                                "sense_id": "c3f08c81-ba37-3438-ad1b-e416965b0e05",
                                "text": "Tandis que les cadors du parti s’agitent pour trouver une solution qui fasse l’unanimité, le porte-parole du candidat Fillon, lui, juge la situation intenable."
                            },
                            {
                                "example_id": "e576f216-f9cd-4bae-8e69-bdc28f3c8b1b",
                                "sense_id": "c3f08c81-ba37-3438-ad1b-e416965b0e05",
                                "text": "Bref, on parle bien d’une cador du football français."
                            },
                            {
                                "example_id": "e284117c-c9ee-4b29-a7ae-72f1e34972fe",
                                "sense_id": "c3f08c81-ba37-3438-ad1b-e416965b0e05",
                                "text": "Ces deux cadors-là ne ressemblaient pas à des perdreaux de l'année. Pouvaient-ils vraiment tomber dans le panneau qui leur était tendu ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "fc8c823d-88b8-3505-91a4-71d0e5ac68fa",
                        "entry_id": "e1bcb4d0-20dc-3a6e-8703-23878db9ba8a",
                        "glosses": [
                            "Chien. → voir cabot, clebs. (D'après un personnage de Binet)"
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "7a74c3c2-3a43-4b0b-9e9f-f0a790960871",
                                "sense_id": "fc8c823d-88b8-3505-91a4-71d0e5ac68fa",
                                "text": "La bonniche ne décarre jamais le cador plus d’un quart d’heure."
                            }
                        ]
                    }
                ],
