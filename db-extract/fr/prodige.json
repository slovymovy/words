                                "target_senses": [
                                    {
                                        "sense_id": "23217189-3491-32c3-8f8b-634eda011592",
                                        "entry_id": "cb63c128-6a0d-3ac4-9c41-d825b3664cc9",
                                        "glosses": [
                                            "An extraordinary occurrence or creature; an anomaly, especially a monster; a freak."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "13889f40-7205-3902-b7a3-1516e6153109",
                                        "entry_id": "cb63c128-6a0d-3ac4-9c41-d825b3664cc9",
                                        "glosses": [
                                            "An amazing or marvellous thing; a wonder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e303feb3-10d9-48d6-9b9b-2ef61fb5c721",
                                                "sense_id": "13889f40-7205-3902-b7a3-1516e6153109",
                                                "text": "He is never chased; he would run away with rope-walks of line. Prodigies are told of him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "912a78cb-5411-3bde-98b3-764d43cf93ed",
                                        "entry_id": "cb63c128-6a0d-3ac4-9c41-d825b3664cc9",
                                        "glosses": [
                                            "A wonderful example of something."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9bca5f80-2850-314e-b00d-a16172ea1f57",
                                        "entry_id": "cb63c128-6a0d-3ac4-9c41-d825b3664cc9",
                                        "glosses": [
                                            "An extremely talented person, especially a child."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0fa6fd94-a8b5-363f-b11b-3007d8328241",
                                        "entry_id": "cb63c128-6a0d-3ac4-9c41-d825b3664cc9",
                                        "glosses": [
                                            "An extraordinary thing seen as an omen; a portent."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "379802ed-9b40-4c56-959e-066b809afa48",
                                                "sense_id": "0fa6fd94-a8b5-363f-b11b-3007d8328241",
                                                "text": "These on the farther bank now stood and gazed, / By Heaven alarm’d, by prodigies amazed: / A signal omen stopp’d the passing host, / Their martial fury in their wonder lost."
                                            },
                                            {
                                                "example_id": "2fa0ec9b-6d66-492e-99fb-25868a4ecf7b",
                                                "sense_id": "0fa6fd94-a8b5-363f-b11b-3007d8328241",
                                                "text": "Prodigies and Portents have infected the beſt VVritings of Antiquity; and have ſo blotted and deformed our modern Annals, that (vvith greater Juſtice than Polybius has obſerv'd it, of the former) they may be rather called Tragedies than History."
                                            },
                                            {
                                                "example_id": "900287bf-1a17-4f1c-b1f9-5b928ceacfbf",
                                                "sense_id": "0fa6fd94-a8b5-363f-b11b-3007d8328241",
                                                "text": "John Foxe believed that special prodigies had heralded the Reformation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8814587f-1ceb-4246-b0e3-721a4ae80cfd",
                        "source_entry_id": "8502f1a9-4206-3065-baf3-6ef1ebf7f371",
