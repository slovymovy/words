                                        "sense_id": "797e013a-e8f2-375a-8e29-e1c54188edf3",
                                        "entry_id": "1b287d85-1aa4-31a3-9042-ee6a07f2bcb4",
                                        "glosses": [
                                            "A fine, closely woven fabric, made from cotton, polyester or a mix of these, and used for sheets and clothing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa08c7a6-3265-463e-8d1f-d2cd89984105",
                                                "sense_id": "797e013a-e8f2-375a-8e29-e1c54188edf3",
                                                "text": "In her percale bed. In her heaven of piled pillows."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1eee73b1-a928-4969-bd41-335aee165071",
                        "source_entry_id": "292141ea-66a1-3c4c-b811-289ba3f2b7ba",
                        "source_sense_id": "d3b3c9b5-a892-3c06-b916-188256748d9a",
