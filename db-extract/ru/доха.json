                ],
                "senses": [
                    {
                        "sense_id": "428c2cb4-1d61-30fd-9aa0-28d5179bda1c",
                        "entry_id": "413d8393-905c-3db2-a3c7-dc2e28cd33f4",
                        "glosses": [
                            "шуба мехом внутрь и наружу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fe548ea-1d22-435d-95ec-91284ecab534",
                                "sense_id": "428c2cb4-1d61-30fd-9aa0-28d5179bda1c",
                                "text": "Староста в дохе и тёплой шапке появился на пороге с ручным фонарём."
                            },
                            {
                                "example_id": "6e4b65f3-774f-442f-aa35-4e49d27e827e",
                                "sense_id": "428c2cb4-1d61-30fd-9aa0-28d5179bda1c",
                                "text": "Красноармеец, загребая дохой снег, идёт по сторожевой тропинке, смачно вдыхая дымок махорочной закрутки."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df366c7c-1848-4a97-8f5e-8d6bd6e0bae3",
                        "source_entry_id": "413d8393-905c-3db2-a3c7-dc2e28cd33f4",
