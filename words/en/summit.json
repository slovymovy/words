                    "sense_definition": "A surname.",
                    "learner_level": "A2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Summit</w> is the new manager of the department.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Саммит</w> — новый руководитель отдела.",
                                "tr": "Bay <w>Summit</w>, departmanın yeni müdürüdür."
                            }
