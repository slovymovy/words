                        "form": "die Endivie"
                    },
                    {
                        "form_id": "5f94b76f-dc29-49d4-8f8e-0055702cf432",
                        "entry_id": "ee14ed91-c542-3645-bc0f-5069dbb9d200",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Endivien"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e82d862a-172d-3b93-af41-bf086032123e",
                        "entry_id": "ee14ed91-c542-3645-bc0f-5069dbb9d200",
                        "glosses": [
                            "Pflanzenart aus der Gattung der Wegwarten, deren Blätter als Nahrungsmittel, beispielsweise für Salate, verwendet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be76fdcf-a380-4ed3-beb7-8d9203d9ad98",
                                "sense_id": "e82d862a-172d-3b93-af41-bf086032123e",
                                "text": "„In den ersten dreißig Sekunden erzählte ich, wie ich in Suppen gepinkelt, auf Crèmes brûlées gefurzt und auf geschmorte Endivien geniest hatte, und nun solle mir das Hotel jede Woche einen Scheck in Höhe meines durchschnittlichen Wochenlohns plus Trinkgelder schicken.“"
                            },
                            {
                                "example_id": "3ce4a45e-1e56-4219-b9b7-18c59f2fc966",
                                "sense_id": "e82d862a-172d-3b93-af41-bf086032123e",
                                "text": "„Immer mit der Ruhe, sage ich. Nichts Kompliziertes. Lachs ohne Gräten. Karotten, mundgerecht geschnitten. Geschmorte Endivien.“"
                            },
                            {
                                "example_id": "1442df3c-e448-4174-b63c-f3a616833d96",
                                "sense_id": "e82d862a-172d-3b93-af41-bf086032123e",
                                "text": "„Und es war ein eindrucksvolles Unternehmen, das zu gründen Charlie sich anschickte, und schon bald war sein Palast der Mittelpunkt weiter Flächen Krausblättriger Endivien, die sich mit riesigen Feldern voll Zuckerrüben, Koriander und Steckrüben abwechselten.“"
                            },
                            {
                                "example_id": "59f5f5e4-73da-4dd7-82d3-6e7144bcffef",
                                "sense_id": "e82d862a-172d-3b93-af41-bf086032123e",
                                "text": "„Wenn Sie mal acht Stunden lang Endivien zu Chiffonade verarbeiten, bekommen Sie vielleicht eine Vorstellung davon, wie es in meinem Leben aussieht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "728b4e79-d874-477e-a879-bee4dd0c689e",
                        "source_entry_id": "ee14ed91-c542-3645-bc0f-5069dbb9d200",
                        "source_sense_id": "e82d862a-172d-3b93-af41-bf086032123e",
                        "source_sense_description": "Pflanzenart aus der Gattung der Wegwarten, deren Blätter als Nahrungsmittel, beispielsweise für Salate, verwendet werden",
                        "target_lang_word": "endive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "endive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "598e80cc-227b-3215-ac8a-6712dea93577",
                                        "entry_id": "4bdf3eb8-aa1f-3148-8595-3efa8e47dced",
                                        "glosses": [
                                            "A leafy salad vegetable, Cichorium endivia, which is often confused with common chicory (Cichorium intybus)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f1a7510-636e-4cb7-9e38-901c094c89de",
                                                "sense_id": "598e80cc-227b-3215-ac8a-6712dea93577",
                                                "text": "When all this is ready, take some endive and Dutch lettuce, some chervil and celery, wash and drain them very well, cut them small, put them into a saucepan, and pour some of the broth upon them […]"
                                            },
                                            {
                                                "example_id": "d7d949ce-997c-4dcc-b0ae-c7fd76b361d2",
                                                "sense_id": "598e80cc-227b-3215-ac8a-6712dea93577",
                                                "text": "Take the three heads of endive out of the water, drain them, and leave the largest whole."
                                            },
                                            {
                                                "example_id": "718ac0f7-2aa4-4876-b949-8f18443e3805",
                                                "sense_id": "598e80cc-227b-3215-ac8a-6712dea93577",
                                                "text": "Broad leaved, green curled or white curled, the endive plants are good; the green sorts, on account of their coolness and their plentiful salts, are esteemed for the salad bowl, and the white-curled sorts are liked for soups, stews and as boiled vegetables."
                                            },
                                            {
                                                "example_id": "2e2144f4-de2b-4b30-b1b7-c7a55ff7f5e5",
                                                "sense_id": "598e80cc-227b-3215-ac8a-6712dea93577",
                                                "text": "Endive, like a number of similar plants, is both esculent and reputed to have some aphrodisiac property."
                                            },
                                            {
                                                "example_id": "e5bd3b45-0b02-483c-9d17-cf0da6690795",
                                                "sense_id": "598e80cc-227b-3215-ac8a-6712dea93577",
                                                "text": "Endive and escarole are the same vegetable, but endive has leaves that are cut and curled, while escarole has smooth, broad leaves."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "719110eb-8a2f-480f-86d7-32fc5e246309",
                        "source_entry_id": "ee14ed91-c542-3645-bc0f-5069dbb9d200",
                        "source_sense_id": "e82d862a-172d-3b93-af41-bf086032123e",
                        "source_sense_description": "Pflanzenart aus der Gattung der Wegwarten, deren Blätter als Nahrungsmittel, beispielsweise für Salate, verwendet werden",
                        "target_lang_word": "endive",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "endive",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd125202-c3a4-3773-bea3-22ace848c867",
                                        "entry_id": "3912ff4a-352e-395d-b211-38285bf428bd",
                                        "glosses": [
                                            "Bourgeon de la chicorée de Bruxelles, forcé dans l’obscurité, pour empêcher la photosynthèse et obtenir des feuilles blanches à bords jaunes, de goût amer, qui se mangent crues en salade ou cuites, en légume."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b706c72-580b-4ab7-b72f-75c080968c1f",
                                                "sense_id": "fd125202-c3a4-3773-bea3-22ace848c867",
                                                "text": "Une salade d'endive."
                                            },
                                            {
                                                "example_id": "fbf10038-8688-412a-85fd-4ef3a76fe7ae",
                                                "sense_id": "fd125202-c3a4-3773-bea3-22ace848c867",
                                                "text": "Endive : découverte tardivement et par hasard, en 1850, par Bréziers, jardinier chef de la Société d'horticulture Belge. Comme il gardait des pieds de chicorée dans un sous-sol obscur, il s'aperçut que lorsque les pieds recouverts de sable ou de terre faisaient pression sur le collet, les jeunes feuilles étaient obligées de s'imbriquer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e007e1b5-49a8-3ba3-9769-aeb2a1e1e13e",
                                        "entry_id": "3912ff4a-352e-395d-b211-38285bf428bd",
                                        "glosses": [
                                            "Terme générique par lequel on désigne les chicorées et les scaroles qu’on cultive en vue du forçage."
                                        ],
                                        "tags": [
                                            "Jardinage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3209442-fa68-4e24-9d25-c473d5882117",
                                                "sense_id": "e007e1b5-49a8-3ba3-9769-aeb2a1e1e13e",
                                                "text": "Dans le Nord, l’on voit des champs d’endives à perte de vue."
                                            },
                                            {
                                                "example_id": "4f35b1ff-c142-4834-a766-b6051a8eedd1",
                                                "sense_id": "e007e1b5-49a8-3ba3-9769-aeb2a1e1e13e",
                                                "text": "L’endive est issue d’une chicorée sauvage aux racines persistantes. Sa culture a été mise au point en Belgique, vers 1850."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
