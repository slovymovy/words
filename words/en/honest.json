{
    "word_family": [
        "honesty",
        "honestly",
        "dishonest",
        "dishonesty",
        "dishonestly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "50171bdd-1469-3df7-a67a-8fd991854b8d",
                    "sense_definition": "Telling the truth and not being willing to lie, cheat, or steal.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "truthfulness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To be <w>honest</w> with you, I did not really enjoy the movie we saw last night.",
                            "target_lang_translations": {
                                "ru": "Если быть с вами <w>честным</w>, мне не очень понравился фильм, который мы смотрели вчера вечером.",
                                "zh": "跟你<w>说实话</w>，昨晚看的电影我其实不太喜欢。"
                            }
                        },
                        {
                            "text": "She is a very <w>honest</w> person who would never take something that does not belong to her.",
                            "target_lang_translations": {
                                "ru": "Она очень <w>честный</w> человек, который никогда не возьмет то, что ей не принадлежит.",
                                "zh": "她是一个非常<w>诚实</w>的人，绝不会拿走不属于自己的东西。"
                            }
                        }
                    ],
                    "synonyms": [
                        "truthful",
                        "trustworthy",
                        "upfront",
                        "straightforward"
                    ],
                    "antonyms": [
                        "dishonest",
                        "insincere"
                    ],
                    "common_phrases": [
                        "be honest",
                        "honest person",
                        "brutally honest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорящий правду и не склонный ко лжи, обману или краже.",
                        "zh": "指为人诚实，不撒谎、不欺诈、不偷窃。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "честный",
                                "target_lang_sense_clarification": "о человеке"
                            },
                            {
                                "target_lang_word": "правдивый",
                                "target_lang_sense_clarification": "склонный говорить правду"
                            },
                            {
                                "target_lang_word": "искренний",
                                "target_lang_sense_clarification": "открытый в чувствах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "诚实",
                                "target_lang_sense_clarification": "指人的品格"
                            },
                            {
                                "target_lang_word": "正直",
                                "target_lang_sense_clarification": "指为人公正坦率"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6bf13b1c-404d-39bd-b0d3-08c7af696ca0",
                    "sense_definition": "Based on real facts and not hidden or changed to deceive people.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "truthfulness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The journalist provided an <w>honest</w> account of the events that took place during the protest.",
                            "target_lang_translations": {
                                "ru": "Журналист представил <w>правдивый</w> отчет о событиях, произошедших во время протеста.",
                                "zh": "记者对示威期间发生的事件提供了<w>真实</w>的报道。"
                            }
                        },
                        {
                            "text": "We need <w>honest</w> reporting to understand the true impact of the new policy.",
                            "target_lang_translations": {
                                "ru": "Нам нужны <w>честные</w> репортажи, чтобы понять истинное влияние новой политики.",
                                "zh": "我们需要<w>客观</w>的报道，才能了解新政策的真实影响。"
                            }
                        }
                    ],
                    "synonyms": [
                        "true",
                        "genuine",
                        "veracious"
                    ],
                    "antonyms": [
                        "dishonest"
                    ],
                    "common_phrases": [
                        "honest account",
                        "honest reporting",
                        "honest opinion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Основанный на реальных фактах, не скрытый и не измененный с целью обмана.",
                        "zh": "基于事实，不隐瞒或歪曲真相。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "правдивый",
                                "target_lang_sense_clarification": "соответствующий истине"
                            },
                            {
                                "target_lang_word": "честный",
                                "target_lang_sense_clarification": "объективный и прямой"
                            },
                            {
                                "target_lang_word": "откровенный",
                                "target_lang_sense_clarification": "без утайки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "真实",
                                "target_lang_sense_clarification": "指内容符合事实"
                            },
                            {
                                "target_lang_word": "坦诚",
                                "target_lang_sense_clarification": "指态度直率、不隐瞒"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "176ae173-3966-317b-8a27-4bf6559a0f50",
                    "sense_definition": "Done with good intentions, even if the result is wrong or unsuccessful.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "intent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am sorry I deleted your file; it was an <w>honest</w> mistake and I will try to recover it.",
                            "target_lang_translations": {
                                "ru": "Простите, что я удалил ваш файл; это была <w>добросовестная</w> ошибка, и я постараюсь его восстановить.",
                                "zh": "抱歉我删了你的文件；那是个<w>无心</w>之过，我会设法恢复它。"
                            }
                        },
                        {
                            "text": "The referee made an <w>honest</w> error when he missed the foul during the fast play.",
                            "target_lang_translations": {
                                "ru": "Судья допустил <w>непреднамеренную</w> ошибку, пропустив фол во время быстрой игры.",
                                "zh": "裁判在快节奏比赛中漏判犯规，那是一个<w>无意</w>的失误。"
                            }
                        }
                    ],
                    "synonyms": [
                        "earnest",
                        "genuine"
                    ],
                    "common_phrases": [
                        "honest mistake",
                        "honest error"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный с добрыми намерениями, даже если результат оказался неверным или неудачным.",
                        "zh": "出于好意，即使结果不尽如人意。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "добросовестный",
                                "target_lang_sense_clarification": "об ошибке или заблуждении"
                            },
                            {
                                "target_lang_word": "искренний",
                                "target_lang_sense_clarification": "о намерении"
                            },
                            {
                                "target_lang_word": "честный",
                                "target_lang_sense_clarification": "неумышленный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无心",
                                "target_lang_sense_clarification": "指非故意造成的错误"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e8752dc-d646-3d58-be09-f1a07f245016",
                    "sense_definition": "Earned or gained through hard work and fair means rather than by cheating.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fairness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was proud to earn an <w>honest</w> dollar working at the local construction site.",
                            "target_lang_translations": {
                                "ru": "Он гордился тем, что заработал <w>честный</w> доллар, работая на местной стройке.",
                                "zh": "他为能在当地建筑工地靠<w>正当</w>劳动赚钱而感到自豪。"
                            }
                        },
                        {
                            "text": "After years of struggle, she finally made an <w>honest</w> living as a freelance writer.",
                            "target_lang_translations": {
                                "ru": "После многих лет борьбы она наконец начала зарабатывать на <w>честную</w> жизнь в качестве писателя-фрилансера.",
                                "zh": "经过多年的奋斗，她终于靠做自由撰稿人过上了<w>正当</w>的生活。"
                            }
                        }
                    ],
                    "synonyms": [
                        "legitimate",
                        "square"
                    ],
                    "antonyms": [
                        "shady"
                    ],
                    "common_phrases": [
                        "honest dollar",
                        "honest living",
                        "honest pay"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заработанный или полученный тяжелым трудом и честными средствами, а не обманом.",
                        "zh": "通过辛勤劳动和正当手段获得的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "честный",
                                "target_lang_sense_clarification": "о заработке или труде"
                            },
                            {
                                "target_lang_word": "законный",
                                "target_lang_sense_clarification": "легальный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "正当",
                                "target_lang_sense_clarification": "指手段合法合规"
                            },
                            {
                                "target_lang_word": "靠劳动所得",
                                "target_lang_sense_clarification": "指收入来源"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "603388a1-0519-38c4-a862-dedcaf7ca8b9",
                    "sense_definition": "Complete and thorough, especially regarding effort or work.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fairness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager expects an <w>honest</w> day's work from every employee in the department.",
                            "target_lang_translations": {
                                "ru": "Менеджер ожидает <w>добросовестного</w> рабочего дня от каждого сотрудника отдела.",
                                "zh": "经理要求部门里的每位员工都能<w>尽职</w>地完成一天的工作。"
                            }
                        },
                        {
                            "text": "He felt tired but satisfied after giving an <w>honest</w> effort to finish the project on time.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал усталость, но удовлетворение после того, как приложил <w>максимум</w> усилий, чтобы закончить проект вовремя.",
                                "zh": "在为按时完成项目付出<w>踏实</w>的努力后，他感到疲惫但很满足。"
                            }
                        }
                    ],
                    "synonyms": [
                        "genuine"
                    ],
                    "common_phrases": [
                        "honest day's work",
                        "honest effort"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полный и тщательный, особенно в отношении усилий или работы.",
                        "zh": "指工作或努力非常认真、彻底。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "добросовестный",
                                "target_lang_sense_clarification": "об усилиях или труде"
                            },
                            {
                                "target_lang_word": "полноценный",
                                "target_lang_sense_clarification": "о рабочем дне"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "尽职",
                                "target_lang_sense_clarification": "指工作态度认真"
                            },
                            {
                                "target_lang_word": "踏实",
                                "target_lang_sense_clarification": "指努力程度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05a33463-1053-383d-8315-884e94fd80dc",
                    "sense_definition": "Giving a correct measurement or value without being adjusted to deceive.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "accuracy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The merchant used an <w>honest</w> scale to ensure every customer received the exact amount of grain.",
                            "target_lang_translations": {
                                "ru": "Торговец использовал <w>точные</w> весы, чтобы каждый покупатель получил именно столько зерна, сколько нужно.",
                                "zh": "商人使用<w>精准</w>的秤，以确保每位顾客收到的谷物分量准确无误。"
                            }
                        },
                        {
                            "text": "It is hard to find an <w>honest</w> weight in these unregulated street markets.",
                            "target_lang_translations": {
                                "ru": "На этих нерегулируемых уличных рынках трудно найти <w>честный</w> вес.",
                                "zh": "在这些缺乏监管的街头市场上，很难找到分量<w>足秤</w>的商品。"
                            }
                        }
                    ],
                    "synonyms": [
                        "straight",
                        "foursquare"
                    ],
                    "common_phrases": [
                        "honest scale",
                        "honest weight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дающий правильные измерения или значения без искажений для обмана.",
                        "zh": "指测量工具准确，没有为了欺骗而进行调整。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "точный",
                                "target_lang_sense_clarification": "о весах или измерениях"
                            },
                            {
                                "target_lang_word": "верный",
                                "target_lang_sense_clarification": "правильный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "精准",
                                "target_lang_sense_clarification": "指测量结果准确"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28518c6a-970e-3394-be30-9bb588380200",
                    "sense_definition": "Showing your real feelings or character openly in your appearance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young man had an <w>honest</w> countenance that made people trust him immediately.",
                            "target_lang_translations": {
                                "ru": "У молодого человека было <w>открытое</w> лицо, которое заставляло людей немедленно доверять ему.",
                                "zh": "那个年轻人有一张<w>坦率</w>的脸，让人立刻对他产生信任。"
                            }
                        },
                        {
                            "text": "Her <w>honest</w> face revealed her disappointment even though she tried to smile.",
                            "target_lang_translations": {
                                "ru": "Ее <w>искреннее</w> лицо выдавало разочарование, хотя она и пыталась улыбаться.",
                                "zh": "尽管她试图微笑，但她那<w>诚实</w>的面容还是流露出了失望。"
                            }
                        }
                    ],
                    "synonyms": [
                        "frank",
                        "forthright",
                        "upfront"
                    ],
                    "common_phrases": [
                        "honest countenance",
                        "honest face"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Открыто выражающий истинные чувства или характер через внешность.",
                        "zh": "通过外表流露出真实的感情或性格。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "открытый",
                                "target_lang_sense_clarification": "о лице или взгляде"
                            },
                            {
                                "target_lang_word": "честный",
                                "target_lang_sense_clarification": "внушающий доверие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "坦率",
                                "target_lang_sense_clarification": "指神情或面容"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d980584-0999-39bd-bdaa-46c571758217",
                    "sense_definition": "Respectable, decent, or socially acceptable.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "social_standing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They were known as <w>honest</w> folk who worked hard and attended church every Sunday.",
                            "target_lang_translations": {
                                "ru": "Они были известны как <w>почтенные</w> люди, которые много работали и каждое воскресенье посещали церковь.",
                                "zh": "他们以<w>正派</w>著称，工作勤恳，每周日都去教堂。"
                            }
                        },
                        {
                            "text": "He sought to find <w>honest</w> clothes that would be suitable for a formal dinner.",
                            "target_lang_translations": {
                                "ru": "Он старался найти <w>приличную</w> одежду, которая подошла бы для официального ужина.",
                                "zh": "他试图寻找适合正式晚宴的<w>体面</w>服装。"
                            }
                        }
                    ],
                    "synonyms": [
                        "legitimate",
                        "square"
                    ],
                    "common_phrases": [
                        "honest folk",
                        "honest clothes"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Почтенный, приличный или социально приемлемый.",
                        "zh": "体面、正派或符合社会规范的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "почтенный",
                                "target_lang_sense_clarification": "о людях"
                            },
                            {
                                "target_lang_word": "приличный",
                                "target_lang_sense_clarification": "об одежде или поведении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "正派",
                                "target_lang_sense_clarification": "指人品行端正"
                            },
                            {
                                "target_lang_word": "体面",
                                "target_lang_sense_clarification": "指符合社会礼仪"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d82887c-ef3e-3745-b9c4-8c35ba91f294",
                    "sense_definition": "Morally pure or faithful in a marriage or relationship.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "virtue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old play, the character insists that a wife can be merry and yet <w>honest</w> to her husband.",
                            "target_lang_translations": {
                                "ru": "В старинной пьесе герой настаивает на том, что жена может быть веселой и при этом <w>верной</w> своему мужу.",
                                "zh": "在那部老戏里，角色坚持认为妻子既可以活泼开朗，又能对丈夫保持<w>忠贞</w>。"
                            }
                        },
                        {
                            "text": "The knight swore to protect the <w>honest</w> maidens of the kingdom.",
                            "target_lang_translations": {
                                "ru": "Рыцарь поклялся защищать <w>целомудренных</w> дев королевства.",
                                "zh": "骑士发誓要保护王国里<w>贞洁</w>的少女。"
                            }
                        }
                    ],
                    "synonyms": [
                        "true"
                    ],
                    "common_phrases": [
                        "honest wife",
                        "honest woman"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "referring to chastity"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Морально чистый или верный в браке или отношениях.",
                        "zh": "道德纯洁，或在婚姻关系中忠诚。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "целомудренный",
                                "target_lang_sense_clarification": "архаично, о женщине"
                            },
                            {
                                "target_lang_word": "верный",
                                "target_lang_sense_clarification": "в браке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "忠贞",
                                "target_lang_sense_clarification": "指婚姻忠诚"
                            },
                            {
                                "target_lang_word": "贞洁",
                                "target_lang_sense_clarification": "指道德纯洁"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "961596b4-6b6f-3a11-ac5f-b3fd2aa2b621",
                    "sense_definition": "Used to emphasize that what you are saying is the truth.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "emphasis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I didn't break the vase, <w>honest</w>, I was in the other room when it happened.",
                            "target_lang_translations": {
                                "ru": "Я не разбивал вазу, <w>честное слово</w>, я был в другой комнате, когда это случилось.",
                                "zh": "我没打破花瓶，<w>真的</w>，出事的时候我在另一个房间。"
                            }
                        },
                        {
