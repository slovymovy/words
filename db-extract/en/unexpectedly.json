                                                "example_id": "d9f578ee-73bb-4d1d-a30b-42dfa27677de",
                                                "sense_id": "634f59b9-6dff-3e92-83e2-ae89403eaef6",
                                                "text": "Si Radio-Canada, surprenamment rapide, allait soudain s’écrier: « C’est dit. On le prend votre projet? »"
                                            },
                                            {
                                                "example_id": "1e1081dd-4b52-4d10-93ad-4ae21b6b1901",
                                                "sense_id": "634f59b9-6dff-3e92-83e2-ae89403eaef6",
                                                "text": "Avec ses 50.000 habitants, cette ville [Chieng-Maï] est surprenamment civilisée ; les routes y sont plus développées qu’à Bangkok ; on y comptait 500 bicyclettes en 1904 !"
                                            }
