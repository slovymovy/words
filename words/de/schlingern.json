                        "auf Glatteis schlingern"
                    ]
                },
                {
                    "sense_id": "fb9cd454-3464-385b-8b7f-d48278aba2dd",
                    "sense_definition": "sich als Wasserfahrzeug durch Wellenbewegung um die eigene Längsachse hin- und herdrehen",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das Frachtschiff <w>schlingerte</w> schwer in den hohen Wellen des offenen Ozeans."
                        },
                        {
                            "text": "Weil die Fähre bei dem Unwetter unaufhörlich <w>schlingert</w>, werden viele Passagiere seekrank."
                        }
                    ],
                    "synonyms": [
                        "schwanken"
                    ],
                    "antonyms": [
                        "stampfen"
                    ],
                    "common_phrases": [
