                ],
                "senses": [
                    {
                        "sense_id": "8476d0f1-fa57-3860-870e-d72c8aea7c9d",
                        "entry_id": "6c62a69a-23eb-3c4b-b2fc-f6a979bde04d",
                        "glosses": [
                            "Belastung einer Person oder eines Gegenstandes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a95c7edf-7396-4cea-b8a1-ba9cdd36156a",
                                "sense_id": "8476d0f1-fa57-3860-870e-d72c8aea7c9d",
                                "text": "„Kurschilgen verweist in Südkorea weiter auf eine ‚immense mentale Beanspruchung‘ bei Lambertz.“"
                            },
                            {
                                "example_id": "68c2b72f-4483-4c88-972b-098098e1d30b",
                                "sense_id": "8476d0f1-fa57-3860-870e-d72c8aea7c9d",
                                "text": "„Energetische Anforderungsprofile sind für die Beurteilung der Beanspruchung durch sportliche Belastung relevant.“"
                            },
                            {
                                "example_id": "78bd2e43-d660-4467-a39f-523f60fc5355",
                                "sense_id": "8476d0f1-fa57-3860-870e-d72c8aea7c9d",
                                "text": "„Die gefährlichen Beanspruchungen erfolgten, wenn die Fahrzeuge mit Kriechgeschwindigkeit nahe an der Außenecke der Platte fuhren.“"
                            },
                            {
                                "example_id": "d27b1559-80f6-44c0-ae3b-888dc87b9d7e",
                                "sense_id": "8476d0f1-fa57-3860-870e-d72c8aea7c9d",
                                "text": "„Als die zeitliche Beanspruchung aus dem Start-up einen Umfang annahm, der es Brandenburg nicht mehr erlaubte, auch noch in Vollzeit als Notarzt tätig zu sein, kam der Sprung ins kalte Wasser: Er nahm bei der Bank einen Privatkredit auf.“"
                            },
                            {
                                "example_id": "31fa1ca3-2668-4b53-874c-df1f27f1b643",
                                "sense_id": "8476d0f1-fa57-3860-870e-d72c8aea7c9d",
                                "text": "„Dementsprechend hängt bei vertikaler Beanspruchung des Mauerwerks dessen Druckfestigkeit wesentlich von der Querzugfestigkeit der Mauersteine ab.“"
                            },
                            {
                                "example_id": "09be9b96-1211-48be-a5fe-77e6b20c1d21",
                                "sense_id": "8476d0f1-fa57-3860-870e-d72c8aea7c9d",
                                "text": "„Die Beanspruchung des Mitarbeiters hingegen, macht sich durch die Belastung als ihre Folge erkennbar.“"
                            },
                            {
                                "example_id": "677597a3-c890-4e08-aed4-6834fccd5a1a",
                                "sense_id": "8476d0f1-fa57-3860-870e-d72c8aea7c9d",
                                "text": "„Bei Beanspruchung des Deiches von außen erfolgt ein Wegbrechen von Deichteilen entlang der Kernsprünge auf der Innenböschung.“"
                            },
                            {
                                "example_id": "f29846b1-eadb-4ac4-ba0b-09ad4550462c",
                                "sense_id": "8476d0f1-fa57-3860-870e-d72c8aea7c9d",
                                "text": "„Für diesen Lastfall kann in vielen Fällen angenommen werden, dass die Beanspruchung des Bodens einer reinen Scherung entspricht.“"
                            },
                            {
                                "example_id": "c8a08cf7-47da-4dda-a93f-d168ac57c107",
                                "sense_id": "8476d0f1-fa57-3860-870e-d72c8aea7c9d",
                                "text": "„Diese kann der Physiotherapeut beeinflussen und dadurch die Belastung/Beanspruchung des muskuloskeletalen Systems wie auch das Schmerz- und Bewegungsmuster im Nervensystem positiv verändern (Zusman 2013).“"
                            },
                            {
                                "example_id": "9e131e2c-ea9c-4c01-b935-ba37791466c4",
                                "sense_id": "8476d0f1-fa57-3860-870e-d72c8aea7c9d",
                                "text": "„Dabei kann es sich um eine physische oder kognitive Beanspruchung des Menschen handeln.“"
                            },
                            {
                                "example_id": "998cc799-8341-46ff-8859-b34e656a69ca",
                                "sense_id": "8476d0f1-fa57-3860-870e-d72c8aea7c9d",
                                "text": "„Bei zu starker Beanspruchung des Wasservorkommens könnte es zu Naturschäden kommen, es handelt sich nicht um eine reine Formalität in der Zuordnung.“"
                            },
                            {
                                "example_id": "a67edfb7-8f14-41ee-94ca-f0647c439eaf",
                                "sense_id": "8476d0f1-fa57-3860-870e-d72c8aea7c9d",
                                "text": "„Die Beanspruchung des Körpers, der Kalorienverbrauch und die Anstrengung für die Muskeln beim Schwimmen würden unterschätzt.“"
                            },
                            {
                                "example_id": "7bbaa348-634b-400f-8ec5-804de02c1b58",
                                "sense_id": "8476d0f1-fa57-3860-870e-d72c8aea7c9d",
                                "text": "„Mittlerweile seien zudem Ausfälle durch eine ‚maximale physische und psychische Beanspruchung des Personals‘ zu verzeichnen.“"
                            },
                            {
                                "example_id": "a2c43595-cbd3-4b3a-902a-d9c24bf8b4c6",
                                "sense_id": "8476d0f1-fa57-3860-870e-d72c8aea7c9d",
                                "text": "„Auf eine genaue Reichweitenangabe will man sich bei Kreidler nicht festlegen, doch mehr als 100 Kilometer sollten selbst bei maximaler Beanspruchung des Energiereservoirs drin sein.“"
                            },
                            {
                                "example_id": "ada5f3ba-9665-4c67-8593-92531f4f7820",
                                "sense_id": "8476d0f1-fa57-3860-870e-d72c8aea7c9d",
                                "text": "„Doch die angekündigte Beanspruchung des Kapitalmarktes dürfte den Elan zumindest zunächst noch etwas bremsen, auch wenn die Möglichkeit einer Kapitalerhöhung bereits ausgeschlossen wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
