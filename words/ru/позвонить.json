    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f4fcff90-14c9-3143-b8f6-9f96d07954a0",
                    "sense_definition": "Связаться с кем-либо, используя телефон.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я обещал <w>позвонить</w> маме сразу после работы.",
                            "target_lang_translations": {
                                "en": "I promised to <w>call</w> mom right after work.",
                                "de": "Ich habe versprochen, meine Mutter gleich nach der Arbeit <w>anzurufen</w>."
                            }
                        },
                        {
                            "text": "Если ты заблудишься в городе, ты можешь мне <w>позвонить</w>.",
                            "target_lang_translations": {
                                "en": "If you get lost in the city, you can <w>call</w> me.",
                                "de": "Wenn du dich in der Stadt verläufst, kannst du mich <w>anrufen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "набрать"
                    ],
                    "common_phrases": [
                        "позвонить другу",
                        "позвонить домой",
                        "позвонить в скорую",
                        "позвонить по номеру"
                    ],
                    "target_lang_definitions": {
                        "en": "To contact someone using a telephone.",
                        "de": "Jemanden telefonisch kontaktieren."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "call",
                                "target_lang_sense_clarification": "by phone"
                            },
                            {
                                "target_lang_word": "phone",
                                "target_lang_sense_clarification": "verb"
                            },
                            {
                                "target_lang_word": "ring",
                                "target_lang_sense_clarification": "British English, informal"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "anrufen",
                                "target_lang_sense_clarification": "jemanden per Telefon kontaktieren"
                            },
                            {
                                "target_lang_word": "telefonieren",
                                "target_lang_sense_clarification": "ein Gespräch am Telefon führen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f3c9492-77fa-3a6b-b9a0-0edaf903c695",
                    "sense_definition": "Издать звук с помощью звонка или колокола, обычно чтобы подать сигнал (например, у входной двери).",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Гость подошёл к дому и решил <w>позвонить</w> в дверь.",
                            "target_lang_translations": {
                                "en": "The guest approached the house and decided to <w>ring</w> the doorbell.",
                                "de": "Der Gast ging zum Haus und beschloss, an der Tür zu <w>klingeln</w>."
                            }
                        },
                        {
                            "text": "Священник должен громко <w>позвонить</w> в колокола перед службой.",
                            "target_lang_translations": {
                                "en": "The priest must loudly <w>ring</w> the bells before the service.",
                                "de": "Der Priester muss vor dem Gottesdienst laut die Glocken <w>läuten</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "позвонить в дверь",
                        "позвонить в колокол"
                    ],
                    "target_lang_definitions": {
                        "en": "To make a sound using a bell or doorbell, usually to signal something.",
                        "de": "Ein Geräusch mit einer Glocke oder Klingel erzeugen, um ein Signal zu geben."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ring",
                                "target_lang_sense_clarification": "a doorbell or bell"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "klingeln",
                                "target_lang_sense_clarification": "an einer Tür oder Glocke"
                            },
                            {
                                "target_lang_word": "läuten",
                                "target_lang_sense_clarification": "eine Glocke schlagen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e27b6e2c-4732-3c7f-b68d-8447b5d90867",
                    "sense_definition": "Позвать прислугу, используя специальный колокольчик.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Барыня взяла со стола колокольчик, чтобы <w>позвонить</w> горничной.",
                            "target_lang_translations": {
                                "en": "The lady took the bell from the table to <w>ring for</w> the maid.",
                                "de": "Die Herrin nahm das Glöckchen vom Tisch, um nach dem Dienstmädchen zu <w>läuten</w>."
                            }
                        },
                        {
                            "text": "Граф хотел <w>позвонить</w> слуге и потребовать горячий чай.",
                            "target_lang_translations": {
                                "en": "The count wanted to <w>ring for</w> the servant and demand hot tea.",
                                "de": "Der Graf wollte nach dem Diener <w>klingeln</w> und heißen Tee verlangen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "describes a practice common in past centuries"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To summon a servant using a special bell.",
                        "de": "Jemanden durch das Läuten einer Glocke herbeirufen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ring for",
                                "target_lang_sense_clarification": "summon by bell"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "herbeiklingeln",
                                "target_lang_sense_clarification": "durch Klingeln rufen"
                            },
                            {
                                "target_lang_word": "läuten nach",
                                "target_lang_sense_clarification": "nach einer Person klingeln"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}