                                "example_id": "4aad01dc-e88f-4a21-99f7-331806f1c3c7",
                                "sense_id": "93c22438-584b-3811-b355-7b532f0a0d53",
                                "text": "Le barillet permet d'obturer hermétiquement les chambres de distillation pendant le délutage et le remplissage de la houille."
                            },
                            {
                                "example_id": "065fd15a-f46b-499c-b45a-09ebf7b343a7",
                                "sense_id": "93c22438-584b-3811-b355-7b532f0a0d53",
                                "text": "Pour les cornues de 3 mètres, le déchargement se fait à la main ou avec des machines qui imitent le délutage à la main."
                            }
                        ]
