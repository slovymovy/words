{
    "word_family": [
        "claimant",
        "disclaim",
        "exclaim",
        "proclaim",
        "reclaim",
        "unclaimed"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3adb6297-f1cb-3db2-bf22-e3e6d1e94e13",
                    "sense_definition": "To state that something is true, typically without providing proof or evidence.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "assertion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>claims</w> to have seen a ghost in the old hallway last night.",
                            "target_lang_translations": {
                                "ru": "Он <w>утверждает</w>, что видел привидение в старом коридоре прошлой ночью.",
                                "tr": "Dün gece eski koridorda bir hayalet gördüğünü <w>iddia ediyor</w>."
                            }
                        },
                        {
                            "text": "The company <w>claims</w> that their new product is completely natural.",
                            "target_lang_translations": {
                                "ru": "Компания <w>заявляет</w>, что их новый продукт полностью натуральный.",
                                "tr": "Şirket, yeni ürünlerinin tamamen doğal olduğunu <w>öne sürüyor</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "assert",
                        "maintain",
                        "allege"
                    ],
                    "antonyms": [
                        "deny",
                        "disavow"
                    ],
                    "common_phrases": [
                        "claim to be",
                        "falsely claim"
                    ],
                    "target_lang_definitions": {
                        "ru": "Утверждать, что что-либо является правдой, обычно без предоставления доказательств или свидетельств.",
                        "tr": "Genellikle kanıt veya belge sunmaksızın bir şeyin doğru olduğunu öne sürmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утвержда́ть",
                                "target_lang_sense_clarification": "уверенно высказывать что-либо"
                            },
                            {
                                "target_lang_word": "заявля́ть",
                                "target_lang_sense_clarification": "сообщать о факте или намерении"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "iddia etmek",
                                "target_lang_sense_clarification": "bir durumu kesin bir dille öne sürmek"
                            },
                            {
                                "target_lang_word": "öne sürmek",
                                "target_lang_sense_clarification": "bir fikri veya beyanı ortaya atmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6511cfd3-b217-39e6-b544-a9aa31bb4dcd",
                    "sense_definition": "To demand or assert ownership of something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ownership",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to <w>claim</w> your luggage at the airport carousel.",
                            "target_lang_translations": {
                                "ru": "Вам нужно <w>забрать</w> свой багаж на ленте в аэропорту.",
                                "tr": "Havalimanındaki bagaj bandından bagajınızı <w>almanız</w> gerekiyor."
                            }
                        },
                        {
                            "text": "The explorer wanted to <w>claim</w> the territory for his country.",
                            "target_lang_translations": {
                                "ru": "Исследователь хотел <w>объявить</w> эту территорию владением своей страны.",
                                "tr": "Kâşif, bölgede ülkesi adına <w>hak iddia etmek</w> istedi."
                            }
                        }
                    ],
                    "synonyms": [
                        "demand",
                        "request"
                    ],
                    "antonyms": [
                        "abandon",
                        "relinquish"
                    ],
                    "common_phrases": [
                        "claim ownership",
                        "claim responsibility"
                    ],
                    "target_lang_definitions": {
                        "ru": "Требовать или заявлять о своем праве собственности на что-либо.",
                        "tr": "Bir şeyin mülkiyetini veya hakkını talep etmek, sahiplenmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заявля́ть о права́х",
                                "target_lang_sense_clarification": "на собственность или территорию"
                            },
                            {
                                "target_lang_word": "предъявля́ть прете́нзии",
                                "target_lang_sense_clarification": "на владение чем-либо"
                            },
                            {
                                "target_lang_word": "забира́ть",
                                "target_lang_sense_clarification": "получать свое (например, багаж)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "talep etmek",
                                "target_lang_sense_clarification": "sahipliğini veya hakkını istemek"
                            },
                            {
                                "target_lang_word": "hak iddia etmek",
                                "target_lang_sense_clarification": "üzerinde hakkı olduğunu belirtmek"
                            },
                            {
                                "target_lang_word": "almak",
                                "target_lang_sense_clarification": "bagaj vb. eşyayı gidip teslim almak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2151380c-b601-392e-8148-6f8da845b514",
                    "sense_definition": "To formally request money or compensation, especially from an insurance company or government.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_demand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to <w>claim</w> benefits after losing her job.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>подать на пособие</w> после потери работы.",
                                "tr": "İşini kaybettikten sonra işsizlik maaşına <w>başvurmaya</w> karar verdi."
                            }
                        },
                        {
                            "text": "You can <w>claim</w> damages if the accident was not your fault.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>требовать возмещения ущерба</w>, если авария произошла не по вашей вине.",
                                "tr": "Kaza sizin hatanız değilse <w>tazminat talep edebilirsiniz</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "request",
                        "apply for"
                    ],
                    "common_phrases": [
                        "claim damages",
                        "claim expenses"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально запрашивать деньги или компенсацию, особенно у страховой компании или государства.",
                        "tr": "Özellikle sigorta şirketinden veya devletten resmi olarak para veya tazminat talep etmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тре́бовать вы́платы",
                                "target_lang_sense_clarification": "денежных средств"
                            },
                            {
                                "target_lang_word": "тре́бовать компенса́ции",
                                "target_lang_sense_clarification": "возмещения ущерба"
                            },
                            {
                                "target_lang_word": "подава́ть на посо́бие",
                                "target_lang_sense_clarification": "запрашивать выплаты от государства"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tazminat talep etmek",
                                "target_lang_sense_clarification": "zararın karşılanmasını istemek"
                            },
                            {
                                "target_lang_word": "başvuruda bulunmak",
                                "target_lang_sense_clarification": "yardım veya ödenek almak için başvurmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be9d2e2d-beac-33d6-903b-c1de3f451683",
                    "sense_definition": "To cause the loss of life or property.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "loss",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tragic earthquake <w>claimed</w> the lives of thousands.",
                            "target_lang_translations": {
                                "ru": "Трагическое землетрясение <w>унесло</w> жизни тысяч людей.",
                                "tr": "Trajik deprem binlerce kişinin <w>canını aldı</w>."
                            }
                        },
                        {
                            "text": "The forest fire <w>claimed</w> several historic buildings in the town.",
                            "target_lang_translations": {
                                "ru": "Лесной пожар <w>уничтожил</w> несколько исторических зданий в городе.",
                                "tr": "Orman yangını kasabadaki birkaç tarihi binanın <w>yok olmasına yol açtı</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "take"
                    ],
                    "common_phrases": [
                        "claim lives"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стать причиной гибели людей или утраты имущества.",
                        "tr": "Can veya mal kaybına yol açmak, ölüme sebep olmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уноси́ть",
                                "target_lang_sense_clarification": "о жизнях"
                            },
                            {
                                "target_lang_word": "забира́ть",
                                "target_lang_sense_clarification": "о жизнях или зданиях"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "can almak",
                                "target_lang_sense_clarification": "ölümlere yol açmak"
                            },
                            {
                                "target_lang_word": "mal olmak",
                                "target_lang_sense_clarification": "kayıplara sebep olmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3c774d3-fe0b-3e61-be14-6af1d2465bce",
                    "sense_definition": "To win a prize, title, or victory in a competition.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "achievement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young athlete managed to <w>claim</w> victory in the final race.",
                            "target_lang_translations": {
                                "ru": "Молодому атлету удалось <w>одержать</w> победу в финальном забеге.",
                                "tr": "Genç atlet son yarışta zafer <w>kazanmayı</w> başardı."
                            }
                        },
                        {
                            "text": "She <w>claimed</w> the gold medal after a stunning performance.",
                            "target_lang_translations": {
                                "ru": "Она <w>взяла</w> золотую медаль после потрясающего выступления.",
                                "tr": "Göz alıcı bir performansın ardından altın madalyayı <w>aldı</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "win",
                        "secure"
                    ],
                    "antonyms": [
                        "lose"
                    ],
                    "common_phrases": [
                        "claim victory",
                        "claim a prize"
                    ],
                    "target_lang_definitions": {
                        "ru": "Завоевать приз, титул или победу в соревновании.",
                        "tr": "Bir yarışmada ödül, unvan veya zafer kazanmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завоева́ть",
                                "target_lang_sense_clarification": "победу или титул"
                            },
                            {
                                "target_lang_word": "взять",
                                "target_lang_sense_clarification": "приз или медаль"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kazanmak",
                                "target_lang_sense_clarification": "zafer veya ödül elde etmek"
                            },
                            {
                                "target_lang_word": "almak",
                                "target_lang_sense_clarification": "madalya veya derece elde etmek"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8cc27dbf-e3fc-36d1-88f6-39384678a003",
                    "sense_definition": "A statement that something is true, often when it has not been proven.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "assertion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist made a bold <w>claim</w> about the new discovery.",
                            "target_lang_translations": {
                                "ru": "Ученый сделал смелое <w>утверждение</w> о новом открытии.",
                                "tr": "Bilim insanı yeni keşif hakkında cesur bir <w>iddiada</w> bulundu."
                            }
                        },
                        {
                            "text": "I don't believe his <w>claim</w> that he can speak ten languages.",
                            "target_lang_translations": {
                                "ru": "Я не верю его <w>заявлениям</w> о том, что он говорит на десяти языках.",
                                "tr": "On dil konuşabildiği yönündeki <w>iddiasına</w> inanmıyorum."
                            }
                        }
                    ],
                    "synonyms": [
                        "assertion",
                        "allegation"
                    ],
                    "antonyms": [
                        "denial"
                    ],
                    "common_phrases": [
                        "make a claim",
                        "false claim"
                    ],
                    "target_lang_definitions": {
                        "ru": "Утверждение о том, что что-то является правдой, часто когда это еще не доказано.",
                        "tr": "Genellikle henüz kanıtlanmamış olsa da bir şeyin doğru olduğuna dair ifade veya beyan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утвержде́ние",
                                "target_lang_sense_clarification": "высказанная мысль"
                            },
                            {
                                "target_lang_word": "заявле́ние",
                                "target_lang_sense_clarification": "сообщение о факте"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "iddia",
                                "target_lang_sense_clarification": "öne sürülen düşünce veya beyan"
                            },
                            {
                                "target_lang_word": "sav",
                                "target_lang_sense_clarification": "ileri sürülen görüş"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "970f7e4f-15fd-329e-9ed7-82c6c07c5133",
                    "sense_definition": "A demand for something that one believes they have a right to own.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ownership",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family has a legitimate <w>claim</w> to the ancestral estate.",
                            "target_lang_translations": {
                                "ru": "Семья имеет законные <w>права</w> на родовое поместье.",
                                "tr": "Ailenin aile mülkü üzerinde meşru bir <w>hakkı</w> var."
                            }
                        },
                        {
                            "text": "He put in a <w>claim</w> for the lost umbrella at the station.",
                            "target_lang_translations": {
                                "ru": "Он подал <w>запрос</w> о потерянном зонтике на станции.",
                                "tr": "İstasyondaki kayıp şemsiye için bir <w>talepte</w> bulundu."
                            }
                        }
                    ],
                    "synonyms": [
                        "demand",
                        "entitlement"
                    ],
                    "common_phrases": [
                        "claim of ownership",
                        "lay claim"
                    ],
                    "target_lang_definitions": {
                        "ru": "Требование чего-либо, на что, по мнению человека, он имеет право собственности.",
                        "tr": "Kişinin sahip olma hakkı olduğuna inandığı bir şey üzerindeki talebi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прете́нзия",
                                "target_lang_sense_clarification": "предъявление своих прав"
                            },
                            {
                                "target_lang_word": "притяза́ние",
                                "target_lang_sense_clarification": "стремление получить что-либо по праву"
                            },
                            {
                                "target_lang_word": "права́",
                                "target_lang_sense_clarification": "законные основания на владение"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "hak",
                                "target_lang_sense_clarification": "bir şey üzerindeki mülkiyet veya yetki hakkı"
                            },
                            {
                                "target_lang_word": "talep",
                                "target_lang_sense_clarification": "sahiplik istemi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aaf27170-6297-3703-ab95-24ca2f0e8d2f",
                    "sense_definition": "A formal request for money, such as from an insurance policy or a legal case.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "legal_demand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The insurance company rejected her <w>claim</w> after the car accident.",
                            "target_lang_translations": {
                                "ru": "Страховая компания отклонила её <w>требование о выплате</w> после автомобильной аварии.",
                                "tr": "Sigorta şirketi, araba kazasından sonra onun <w>tazminat talebini</w> reddetti."
                            }
                        },
                        {
                            "text": "You must submit your <w>claim</w> for travel expenses by Friday.",
                            "target_lang_translations": {
                                "ru": "Вы должны подать <w>заявку</w> на возмещение транспортных расходов до пятницы.",
                                "tr": "Seyahat masrafları için <w>talebinizi</w> Cuma gününe kadar sunmalısınız."
                            }
                        }
                    ],
                    "synonyms": [
                        "application",
                        "petition"
                    ],
                    "common_phrases": [
                        "insurance claim",
                        "file a claim"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное требование выплаты денег, например, по страховому полису или судебному делу.",
                        "tr": "Sigorta poliçesi veya hukuki bir dava kapsamında yapılan resmi para veya tazminat talebi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иск",
                                "target_lang_sense_clarification": "судебное требование"
                            },
                            {
                                "target_lang_word": "прете́нзия",
                                "target_lang_sense_clarification": "требование к должнику или страховщику"
                            },
                            {
                                "target_lang_word": "заявка",
                                "target_lang_sense_clarification": "на возмещение расходов"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tazminat talebi",
                                "target_lang_sense_clarification": "zararın ödenmesi için yapılan başvuru"
                            },
                            {
                                "target_lang_word": "talep",
                                "target_lang_sense_clarification": "masraf veya para istemi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e4b5041-fb32-36f2-b98c-2a269c0e3d40",
                    "sense_definition": "A piece of land that someone has legally claimed for mining or settlement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "land",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The miner spent all day working on his gold <w>claim</w>.",
                            "target_lang_translations": {
                                "ru": "Шахтер весь день работал на своем золотоносном <w>участке</w>.",
                                "tr": "Madenci bütün günü kendi altın <w>arazisinde</w> çalışarak geçirdi."
                            }
                        },
                        {
                            "text": "They had to stake a <w>claim</w> before they could start digging.",
                            "target_lang_translations": {
                                "ru": "Им пришлось <w>застолбить участок</w>, прежде чем они смогли начать копать.",
                                "tr": "Kazmaya başlamadan önce bir alanda <w>hak iddia etmeleri</w> gerekiyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "plot",
                        "allotment"
                    ],
                    "common_phrases": [
                        "stake a claim"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Often used in historical contexts of mining"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Участок земли, на который кто-либо предъявил законные права для добычи полезных ископаемых или поселения.",
                        "tr": "Maden arama veya yerleşim amacıyla resmi olarak hak iddia edilen arazi parçası."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уча́сток",
                                "target_lang_sense_clarification": "земли для добычи ископаемых"
                            },
                            {
                                "target_lang_word": "отвод",
                                "target_lang_sense_clarification": "территория, закрепленная за кем-либо"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "arazi",
                                "target_lang_sense_clarification": "hak iddia edilen toprak parçası"
                            },
                            {
                                "target_lang_word": "parsel",
                                "target_lang_sense_clarification": "maden veya kullanım için ayrılmış alan"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}