                        "odeur suave"
                    ]
                },
                {
                    "sense_id": "14794bbd-a714-37b4-9a4b-98ad069c2729",
                    "sense_definition": "Qui manifeste une politesse raffinée, charmeuse et séduisante, parfois jusqu'à paraître affecté ou artificiel.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le diplomate accueillait chaque invité avec un sourire <w>suave</w> et une courtoisie irréprochable."
                        },
                        {
                            "text": "Malgré son ton <w>suave</w>, ses interlocuteurs se méfiaient de ses intentions réelles."
