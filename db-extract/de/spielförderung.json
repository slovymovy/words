                "senses": [
                    {
                        "sense_id": "21f29ef4-4df5-36a2-ad92-7b606ceeebf7",
                        "entry_id": "5f7f9568-1f04-31a6-8a60-643012958e57",
                        "glosses": [
                            "finanzielle, strukturelle und pädagogische Maßnahmen und Hilfen, die zu einer Verbesserung der Spielsituation führen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93aa96df-cf9a-490d-b916-ee82239636e2",
                                "sense_id": "21f29ef4-4df5-36a2-ad92-7b606ceeebf7",
                                "text": "„In Publikationen von 1972 und 1982 wird ebenfalls Spielförderung mit dem Einspielen in die Kultur begründet.“"
                            },
                            {
                                "example_id": "20e55ff4-79e2-4d6b-84b9-9c38beb4b6b3",
                                "sense_id": "21f29ef4-4df5-36a2-ad92-7b606ceeebf7",
                                "text": "„Es wird in der Literatur nicht ausdrücklich unterschieden zwischen den Begriffen Spielförderung und pädagogischer Nutzbarmachung, obwohl darüber zu diskutieren wäre, ob man unter dem Begriff Spielförderung nicht alle jene Versuche zusammenfassen sollte, die eine günstige Gestaltung der Variablen anstreben, die Spiel beeinflussen.“"
                            },
                            {
                                "example_id": "4d484694-097c-4d2e-b864-7e60b0da61d5",
                                "sense_id": "21f29ef4-4df5-36a2-ad92-7b606ceeebf7",
                                "text": "„Zur Spielförderung in der Grundschule werden in jüngster Zeit mehrere Modellversuche durchgeführt.“"
                            },
                            {
                                "example_id": "6fd158a7-a1d2-45a0-9aef-0616ddff5d50",
                                "sense_id": "21f29ef4-4df5-36a2-ad92-7b606ceeebf7",
                                "text": "„Diese wichtige Diskussion um Spielförderung und Spieleingriff wird in einem späteren Abschnitt aufgegriffen und weitergeführt werden.“"
                            },
                            {
                                "example_id": "d69b4a47-5a7b-4e79-940a-72c73784626a",
                                "sense_id": "21f29ef4-4df5-36a2-ad92-7b606ceeebf7",
                                "text": "„Einen Sonderfall stellt die heilpädagogische Spielförderung dar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
