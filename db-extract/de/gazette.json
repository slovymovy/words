                        "entry_id": "5118889f-d0bd-3afe-954d-5805dcbbd3f6",
                        "glosses": [
                            "Gazette, journal, avec plutôt une connotation de presse boulevardière."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "48e3921e-4a69-4d67-af94-0f7bb9cc7b72",
                                "sense_id": "f838c1c9-52ba-3a24-baa6-8abcc161b62c",
                                "text": "Alle Gazetten berichteten eifrig über die Affären des Prinzen.",
                                "translation": "Toutes les Gazettes ont relaté avec zèle les affaires du prince."
                            }
                        ]
                    }
