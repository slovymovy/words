                        "examples": [
                            {
                                "example_id": "77bddc7d-1183-4b47-8d45-3a0a9a131998",
                                "sense_id": "63531e2a-83e2-3da6-9b9a-3d2a32f6039e",
                                "text": "Dla żadnego komunisty nie była wtedy do przyjęcia teza, że PRL trzyma się na radzieckich bagnetach."
                            },
                            {
                                "example_id": "2537086f-04e3-45ab-8872-a8246ffda6c2",
                                "sense_id": "63531e2a-83e2-3da6-9b9a-3d2a32f6039e",
                                "text": "Dlatego w roku Gierek powitał w Polsce radzieckiego geneseka niezwykle \"bratersko\", a jak niektórzy wówczas twierdzili - wręcz czołobitnie."
                            }
                        ],
