                "senses": [
                    {
                        "sense_id": "214d3ae4-fd65-33f5-8725-e947edce2d78",
                        "entry_id": "f78c83c2-c6ab-3a74-942e-7e0ba9d00018",
                        "glosses": [
                            "Verbleib in einem Krankenhaus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "243f4527-8bed-4c61-90fd-84516adb6360",
                                "sense_id": "214d3ae4-fd65-33f5-8725-e947edce2d78",
                                "text": "„Ein Krankenhausaufenthalt folgte dem anderen.“"
                            },
                            {
                                "example_id": "8718e3f5-2728-438a-a182-f4286cc57296",
                                "sense_id": "214d3ae4-fd65-33f5-8725-e947edce2d78",
                                "text": "„Als er bei einem Unfall Verbrennungen erlitt, für deren Behandlung ein stationärer Krankenhausaufenthalt notwendig war, besuchte Sally ihn regelmäßig, und sie kamen sich näher.“"
                            },
                            {
                                "example_id": "7540e480-f6dc-4ede-892d-03663891b486",
                                "sense_id": "214d3ae4-fd65-33f5-8725-e947edce2d78",
                                "text": "„Nach seinem zweiten Krankenhausaufenthalt erzählte der Mann den Ärzten, dass er einige Tage zuvor an einem Familientreffen in South Dakota teilgenommen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
