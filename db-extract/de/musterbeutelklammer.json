                    {
                        "sense_id": "5ec0a95b-7b03-3aa8-b9da-3353efb5e14b",
                        "entry_id": "f3514c19-ee5b-3a1f-a421-215ac8f4270d",
                        "glosses": [
                            "Utensil aus Blech, mit dem durch das Umbiegen zweier Flügel eine Versandtasche, ein Briefumschlag oder ein Musterbeutel verschlossen werden kann"
                        ],
                        "tags": [
                            "Bürobedarf"
                        ],
                        "examples": [
                            {
                                "example_id": "a98b865d-558f-45f6-87f8-dc3e2297fc0e",
                                "sense_id": "5ec0a95b-7b03-3aa8-b9da-3353efb5e14b",
                                "text": "Früher durften Büchersendungen bei der deutschen Post nicht verklebt, sondern mussten mit einer Musterbeutelklammer verschlossen werden, damit sie bei Bedarf unbeschädigt geöffnet werden konnten."
                            }
                        ],
