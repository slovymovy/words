                        "examples": [
                            {
                                "example_id": "9e870e7a-60e3-4731-860a-80074ffda1c8",
                                "sense_id": "6d7f7cfe-9c94-3509-a6c2-fd6a8026b2fc",
                                "text": "Wat begon als een grap, groeide uit tot een bloedserieuze zaak."
                            },
                            {
                                "example_id": "a8564feb-d47e-4e16-bcce-9e7b526cb34f",
                                "sense_id": "6d7f7cfe-9c94-3509-a6c2-fd6a8026b2fc",
                                "text": "'Ik kan je verzekeren dat als wij het ouderwetse systeem van hotel met ontbijt hadden geboekt, het nu met onze gezondheid stukken slechter was gesteld.' Hij liet een stilte van enkele seconden vallen en keek bewust recht in het verbaasde gezicht van Jeroen. 'Dat meen ik dus bloedserieus, kerel.'"
                            }
                        ]
                    }
