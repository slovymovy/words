    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4cd93e72-5c4d-31c4-b3e2-7778fa103379",
                "word": "affectedly",
                "pos": "adv",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a7edbb16-205a-456d-ac2c-095f1c9497e8",
                        "entry_id": "4cd93e72-5c4d-31c4-b3e2-7778fa103379",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more affectedly"
                    },
                    {
                        "form_id": "c835f2f5-1088-426c-ad68-1409210952b0",
                        "entry_id": "4cd93e72-5c4d-31c4-b3e2-7778fa103379",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most affectedly"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "59bcc7d0-e1b1-3d39-b94d-a474ab1ea23d",
                        "entry_id": "4cd93e72-5c4d-31c4-b3e2-7778fa103379",
                        "glosses": [
                            "In an affected manner; hypocritically; with more show than reality."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "733f3ab7-87fb-4327-b40c-11f550498221",
                                "sense_id": "59bcc7d0-e1b1-3d39-b94d-a474ab1ea23d",
                                "text": "1614, Thomas Lodge (translator), The Workes of Lucius Annæus Seneca, London: William Stansby, Epistles to Lucilius, Epist. 115, p. 463,\nThe speech is the Image of the minde: if a man mince it, disguise and polish it ouer curiously, it is a signe that he which speaketh it, is an hypocrite, and little worth. It is no manly ornament to speake affectedly."
                            },
                            {
                                "example_id": "9eda3600-e060-461b-a353-bc96a6608345",
                                "sense_id": "59bcc7d0-e1b1-3d39-b94d-a474ab1ea23d",
                                "text": "I was resolved to decline all imitations for the future, and stick to the original, uncouth as it might be. Better, thought I, to be naturally clownish, than affectedly ridiculous […]"
                            },
                            {
                                "example_id": "b8354cf3-56ca-4a6b-9818-4d059095b5ac",
                                "sense_id": "59bcc7d0-e1b1-3d39-b94d-a474ab1ea23d",
                                "text": "Her manners shewed good sense and good breeding; they were neither shy, nor affectedly open […]"
                            },
                            {
                                "example_id": "02a3ea87-9a7f-4cdb-a153-16d4912a74d9",
                                "sense_id": "59bcc7d0-e1b1-3d39-b94d-a474ab1ea23d",
                                "text": "Schomberg turned up, yawning affectedly, almost before Davidson had regained his seat."
                            }
                        ]
                    },
                    {
                        "sense_id": "fbb13706-7f7d-3297-96a3-a0390a47b323",
                        "entry_id": "4cd93e72-5c4d-31c4-b3e2-7778fa103379",
                        "glosses": [
                            "Lovingly; with tender care."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "67e899a1-6e12-481d-9d49-b123000521b3",
                                "sense_id": "fbb13706-7f7d-3297-96a3-a0390a47b323",
                                "text": "[…] letters sadly penn’d in blood,\nWith sleided silk feat and affectedly\nEnswathed, and seal'd to curious secrecy."
                            },
                            {
                                "example_id": "d71bded1-382a-44d4-bb3f-47500874825a",
                                "sense_id": "fbb13706-7f7d-3297-96a3-a0390a47b323",
                                "text": "1628, John Earle, Micro-cosmographie, or, A Peece of the World Discovered; in Essayes and Characters, London: Edward Blount, 55. “A stayed Man,”\nOne not hasty to pursue the new Fashion, nor yet affectedly true to his old round Breeches."
                            }
                        ]
                    },
                    {
                        "sense_id": "a305c66d-7dd0-3793-a684-b8781d09ce33",
                        "entry_id": "4cd93e72-5c4d-31c4-b3e2-7778fa103379",
                        "glosses": [
                            "With intention, intentionally, deliberately."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "9cca70d9-93a3-4357-ada3-d7aaf23f6582",
                                "sense_id": "a305c66d-7dd0-3793-a684-b8781d09ce33",
                                "text": "[…] the Excelsi or high places mentioned in the sacred Story, wherein the Heathen performed idolatrous rites unto their Idols, were commonly groves, affectedly sited upon some mountainous place, without any House or Temple."
                            },
                            {
                                "example_id": "36165515-9e7a-4cbd-853b-893c2664f7e9",
                                "sense_id": "a305c66d-7dd0-3793-a684-b8781d09ce33",
                                "text": "I have affectedly made use of this measure here […] because, I think, it would be of general convenience, that this should be the common measure in the Commonwealth of Letters."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a6dced4-d742-4b40-8682-f08d14f514b7",
                        "source_entry_id": "4cd93e72-5c4d-31c4-b3e2-7778fa103379",
                        "source_sense_description": "in an affected manner",
                        "target_lang_word": "blasiert",
