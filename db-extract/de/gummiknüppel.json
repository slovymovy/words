                "senses": [
                    {
                        "sense_id": "3ebdeef2-5a31-3fb6-8b3b-c2489c1d4b6a",
                        "entry_id": "0cd8da93-3f15-3708-99d5-c64656a3247a",
                        "glosses": [
                            "Schlagwaffe aus hartem Gummi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8731308-9e09-4227-a089-a407f4d22d13",
                                "sense_id": "3ebdeef2-5a31-3fb6-8b3b-c2489c1d4b6a",
                                "text": "„Die Uniform verkaufte er, und den Gummiknüppel behielt er als Souvenir.“"
                            },
                            {
                                "example_id": "b9063a66-7eb7-4982-8af2-87e429d90e6f",
                                "sense_id": "3ebdeef2-5a31-3fb6-8b3b-c2489c1d4b6a",
                                "text": "„Die Polizisten drohten neckisch mit ihren Gummiknüppeln.“"
                            },
                            {
                                "example_id": "e1c85579-8aff-4464-b235-670043a73547",
                                "sense_id": "3ebdeef2-5a31-3fb6-8b3b-c2489c1d4b6a",
                                "text": "„Der zweite hat einen Gummiknüppel und schlägt mir damit auf den Arm.“"
                            },
                            {
                                "example_id": "221aa7d0-5bd5-4028-8307-5c6e747c3039",
                                "sense_id": "3ebdeef2-5a31-3fb6-8b3b-c2489c1d4b6a",
                                "text": "„Mit dem Moment, da sie die Uniform anzogen, die Polizeimützen aufsetzten und den Gummiknüppel in die Hand bekamen, wurden sie gemein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07b24325-f0b2-4ddd-9ee8-133277bc7f0d",
                        "source_entry_id": "0cd8da93-3f15-3708-99d5-c64656a3247a",
                        "source_sense_id": "3ebdeef2-5a31-3fb6-8b3b-c2489c1d4b6a",
                        "source_sense_description": "Schlagwaffe aus hartem Gummi",
                        "target_lang_word": "truncheon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "truncheon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ba06927-cf32-31cb-a88b-02e9fd2ef487",
                                        "entry_id": "8e20a6e6-4254-3b18-8f4f-91de96da63ad",
                                        "glosses": [
                                            "A short staff, a club; a cudgel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31930044-7927-4e5e-8dc4-29596ee12ab5",
                                                "sense_id": "7ba06927-cf32-31cb-a88b-02e9fd2ef487",
                                                "text": "with his troncheon he so rudely stroke / Cymochles twise"
                                            },
                                            {
                                                "example_id": "e6f2c615-f975-4710-b2b1-3ce6a91712f8",
                                                "sense_id": "7ba06927-cf32-31cb-a88b-02e9fd2ef487",
                                                "text": "One is a large ball of iron, fastened with three chains to a strong truncheon or staff of about two feet long; the other is of mixed metal, in the form of a channelled melon, fastened also to a staff by a triple chain; these balls weigh eight pounds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fda3078-6f72-32f9-ad8d-b91ea0e3b30d",
                                        "entry_id": "8e20a6e6-4254-3b18-8f4f-91de96da63ad",
                                        "glosses": [
                                            "A baton, or military staff of command, now especially the stick carried by a police officer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b45e890-8198-4d15-b9e9-992c8f89e20b",
                                                "sense_id": "3fda3078-6f72-32f9-ad8d-b91ea0e3b30d",
                                                "text": "Not the king's crown, nor the deputed sword / The marshal's truncheon, nor the judge's robe / Become them with one half so good a grace / As mercy does."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8cabb8e-575c-3069-9ba7-00879d3d4adb",
                                        "entry_id": "8e20a6e6-4254-3b18-8f4f-91de96da63ad",
                                        "glosses": [
                                            "A fragment or piece broken off from something, especially a broken-off piece of a spear or lance."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20931a33-0800-45da-bee6-9c83e00213df",
                                                "sense_id": "c8cabb8e-575c-3069-9ba7-00879d3d4adb",
                                                "text": "Therewith asunder in the midst it brast, / And in his hand nought but the troncheon left[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12b293b5-1948-3d71-926f-dd67c0fc8c9a",
                                        "entry_id": "8e20a6e6-4254-3b18-8f4f-91de96da63ad",
                                        "glosses": [
                                            "The shaft of a spear."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2cf777fe-94da-3e33-8a70-9f891a9da7d0",
                                        "entry_id": "8e20a6e6-4254-3b18-8f4f-91de96da63ad",
                                        "glosses": [
                                            "A stout stem, as of a tree, with the branches lopped off, to produce rapid growth."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0712868a-01a7-4467-94e0-2ef129312e6a",
                                                "sense_id": "2cf777fe-94da-3e33-8a70-9f891a9da7d0",
                                                "text": "Truncheons of seven or eight feet long, thrust two feet into the earth […] when once rooted, may be cut at six inches above ground"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "656fca4a-b9cd-3e7b-877c-b630e9ea1e97",
                                        "entry_id": "8e20a6e6-4254-3b18-8f4f-91de96da63ad",
                                        "glosses": [
                                            "A penis."
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecac17fe-f946-4c9f-b348-6367ba1ab073",
                                                "sense_id": "656fca4a-b9cd-3e7b-877c-b630e9ea1e97",
                                                "text": "Then, being on his knees between my legs, he drew up his shirt and bared all his hairy thighs, and stiff staring truncheon, red-topt and rooted into a thicket of curls",
                                                "translation": "Fanny Hill",
                                                "english": "Fanny Hill"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "truncheon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d7544868-b771-3eab-a66b-996c7a85cc61",
                                        "entry_id": "d8fa085b-e243-3982-8f51-bdabe777707f",
                                        "glosses": [
                                            "To strike with a truncheon."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e11e466f-49f9-4e26-bdd0-2c8bb2ce0216",
                                                "sense_id": "d7544868-b771-3eab-a66b-996c7a85cc61",
                                                "text": "If captains were of my wind they would truncheon you out"
                                            }
                                        ]
