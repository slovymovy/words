                    },
                    {
                        "translation_id": "73006076-ac07-4a08-a4c6-b2d660380995",
                        "source_entry_id": "ff494696-0a93-320a-93a7-f1d724c92ec6",
                        "source_sense_id": "e1877550-51af-31a6-958d-a9c220cef0c1",
                        "target_lang_word": "galvanize",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "galvanize",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be501271-2679-36c9-800c-0698749a0e70",
                                        "entry_id": "372dcc82-9a76-3e07-9e7a-b6454416abd7",
                                        "glosses": [
                                            "To coat with a layer of metal by electrochemical means."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "dated",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7e2f643c-dd6f-3f0c-9df2-89ebdd9c5952",
                                        "entry_id": "372dcc82-9a76-3e07-9e7a-b6454416abd7",
                                        "glosses": [
                                            "To coat with a layer of metal by electrochemical means.",
                                            "To coat with a layer of zinc (for rust resistance) by electrochemical means."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "dated",
                                            "transitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eda30a87-c3fd-433f-8d8c-981cd04ef7a1",
                                                "sense_id": "7e2f643c-dd6f-3f0c-9df2-89ebdd9c5952",
                                                "text": "We then galvanize the steel so that the zinc coating will sacrificially take the corrosion for many years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f2eb25d-fb9e-3d85-b4e7-3ba58ab196ce",
                                        "entry_id": "372dcc82-9a76-3e07-9e7a-b6454416abd7",
                                        "glosses": [
                                            "To shock or stimulate into sudden activity, as if by electric shock."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b231cd85-b6ed-4be5-842d-1f6a20e46e36",
                                                "sense_id": "1f2eb25d-fb9e-3d85-b4e7-3ba58ab196ce",
                                                "text": "The girl’s picture helped galvanize public opinion against the administration’s policy."
                                            },
                                            {
                                                "example_id": "eaa69e2d-9ff6-44d4-88bb-b7d4fae4df6a",
                                                "sense_id": "1f2eb25d-fb9e-3d85-b4e7-3ba58ab196ce",
                                                "text": "Republicans are hoping a proposed gas-tax repeal will galvanize their voters."
                                            },
                                            {
                                                "example_id": "632d8bd6-08b7-4a4d-a77f-de117ad5579e",
                                                "sense_id": "1f2eb25d-fb9e-3d85-b4e7-3ba58ab196ce",
                                                "text": "The arrival of the kett stunned and then divided the angara. As described by Jaal, infighting was used as a means of conquest by the kett, but the presence of a common enemy eventually galvanized the angara to work together. The various resistance groups merged into the organized Angaran Resistance roughly five years ago under Evfra de Tershaav's command, supported by prominent families and determined to stop their kett oppressors."
                                            },
                                            {
                                                "example_id": "091129ef-ff65-45ff-b1bf-f2c3411cc289",
                                                "sense_id": "1f2eb25d-fb9e-3d85-b4e7-3ba58ab196ce",
                                                "text": "U.S. President Donald Trump’s bombshell proposal to take over the Gaza Strip and relocate its Palestinian inhabitants has made the forced transfer of populations – a war crime – a policy discussion, galvanizing Arab states."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e00b2a87-d4df-35ae-90c2-59c35780f104",
                                        "entry_id": "372dcc82-9a76-3e07-9e7a-b6454416abd7",
                                        "glosses": [
                                            "To electrify, as by galvanism."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "026a2ab7-9829-4012-965b-70afb9e4d3f3",
                                                "sense_id": "e00b2a87-d4df-35ae-90c2-59c35780f104",
                                                "text": "The agitations resembled the grinnings and writhings of a galvanized corpse, not the struggles of an athletic man."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4355703-08ca-3d25-bfaf-21a24c210cd7",
                                        "entry_id": "372dcc82-9a76-3e07-9e7a-b6454416abd7",
                                        "glosses": [
                                            "To switch sides between Union and Confederate in the American Civil War."
                                        ],
                                        "tags": [
                                            "US",
                                            "historical",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "805e76b9-6f73-4a85-8f7c-d1aa58087ed7",
                                                "sense_id": "a4355703-08ca-3d25-bfaf-21a24c210cd7",
                                                "text": "Reenactors called this “galvanizing,” the Civil War term for soldiers who switched sides during the conflict."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
