                    }
                ],
                "senses": [
                    {
                        "sense_id": "7bfe1d30-8356-3403-ab1e-544051da636f",
                        "entry_id": "21aa459f-6cf7-3e7b-bac9-b291c89984ba",
                        "glosses": [
                            "(reibungsloser) Ablauf eines Spielgeschehens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab78495c-d6ae-4ffa-9541-feb70fce7e11",
                                "sense_id": "7bfe1d30-8356-3403-ab1e-544051da636f",
                                "text": "„Obwohl der Spielraum und die daran gebundene Spielstruktur nur bedingt das Aufkommen von Spielfluss zulassen, scheint es trotzdem so zu sein, dass die Kinder mit großem Interesse spielen.“"
                            },
                            {
                                "example_id": "f3b1c8b2-e1b2-4235-a065-485e2d0b195c",
                                "sense_id": "7bfe1d30-8356-3403-ab1e-544051da636f",
                                "text": "„Sekundenschnelle Entscheidungen passen in den Spielfluss, sie sind eingebettet in die Herausforderungen des Spiels, werden von den Spielern im Affekt getroffen.“"
                            },
                            {
                                "example_id": "50f80525-5a06-4ff4-8326-afd14f30c785",
                                "sense_id": "7bfe1d30-8356-3403-ab1e-544051da636f",
                                "text": "„Wenn der Spielfluss zu sehr und zu oft gestört wird und die älteren Kinder zu kurz kommen, sollte der Erwachsene eine Zeitlang allein die Rolle des Spielpartners für das kleine Kind übernehmen.“"
                            },
                            {
                                "example_id": "4ce88299-b928-4204-be2a-0afb47f0f5a6",
                                "sense_id": "7bfe1d30-8356-3403-ab1e-544051da636f",
                                "text": "„Da waren allerdings auch noch Jonathan Tah, Volland und Serge Gnabry eingewechselt worden, was den Spielfluss hemmte.“"
                            },
                            {
                                "example_id": "55418316-a6a8-4968-84fc-e4fffab57c86",
                                "sense_id": "7bfe1d30-8356-3403-ab1e-544051da636f",
                                "text": "„Nach gut 20 Minuten häuften sich zudem kleinere Fouls, die dem ohnehin schon zähen Spielfluss keinesfalls zuträglich waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
