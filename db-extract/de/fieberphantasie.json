                        "examples": [
                            {
                                "example_id": "84aebddc-ff97-4866-ac20-46b31f1c3d8d",
                                "sense_id": "ea769dbd-5861-3f33-a9af-50ba40a72676",
                                "text": "„Und nun wandte sich seine Aufmerksamkeit plötzlich einer anderen Welt zu, in der sich Wirklichkeit und Fieberphantasien mengten und in der irgend etwas ganz Besonderes vorging.“"
                            },
                            {
                                "example_id": "d42edb0d-2769-48d0-b81a-87f63216bb95",
                                "sense_id": "ea769dbd-5861-3f33-a9af-50ba40a72676",
                                "text": "„Bettina lag wirklich den ganzen Tag in Fieberphantasien; der Doktor, der sich der Ansicht des Arztes angeschlossen hatte, ließ seine Mutter reden und schickte nicht nach dem Jakobiner.“"
                            }
                        ],
