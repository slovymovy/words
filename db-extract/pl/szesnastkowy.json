                    {
                        "translation_id": "fca840ac-49ed-4323-8748-86bb701754a2",
                        "source_entry_id": "7125a92a-f281-33a6-abd7-39666442b836",
                        "source_sense_id": "26059f97-b23a-3948-8a83-48f023e54b26",
                        "target_lang_word": "hexadezimal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hexadezimal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "47af4247-f06b-3b85-a37b-1850f193fc2c",
                                        "entry_id": "fce6ceaf-c657-3481-aa8d-3cdc7e8386fe",
                                        "glosses": [
                                            "auf das Zahlensystem mit der Basis 16 bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2de81777-7e05-4973-b694-3a9c257212f7",
                                                "sense_id": "47af4247-f06b-3b85-a37b-1850f193fc2c",
                                                "text": "In der EDV-Welt wird die hexadezimale Darstellung oft zur Repräsentation eines Bytes verwendet."
                                            },
                                            {
                                                "example_id": "837d2823-412b-4770-bf13-d2cc5c97d066",
                                                "sense_id": "47af4247-f06b-3b85-a37b-1850f193fc2c",
                                                "text": "Eine hexadezimale Zahl hat 16 Ziffern (0-9, A-F) und kann damit 16 verschiedene Zustände abbilden."
                                            },
                                            {
                                                "example_id": "02bfac58-5a1f-4a90-a9f5-f6a7c1ecc443",
                                                "sense_id": "47af4247-f06b-3b85-a37b-1850f193fc2c",
                                                "text": "Der hexadezimale Wert „10“ entspricht dem dezimalen Wert „16“."
                                            },
                                            {
