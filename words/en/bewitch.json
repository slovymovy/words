{
    "word_family": [
        "witch",
        "witchcraft",
        "witchery"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e0806d69-c29c-309c-ac2c-4942acaf50bd",
                    "sense_definition": "To fascinate or charm someone deeply.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "charm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was <w>bewitched</w> by the sight of the girl dancing in the forest.",
                            "target_lang_translations": {
                                "zh": "我被森林里跳舞的女孩深深<w>迷住</w>了。"
                            }
                        },
                        {
                            "text": "The beautiful music <w>bewitched</w> the entire audience.",
                            "target_lang_translations": {
                                "zh": "美妙的音乐让全场观众都<w>着迷</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "completely bewitched"
                    ],
                    "target_lang_definitions": {
                        "zh": "深深地吸引或迷住某人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "迷住",
                                "target_lang_sense_clarification": "指因某人或某事物的魅力而入迷。"
                            },
                            {
                                "target_lang_word": "着迷",
                                "target_lang_sense_clarification": "指对某事物产生浓厚兴趣或沉迷其中。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a386c9f-3ee1-3cdf-87f0-9b8d454a6f01",
                    "sense_definition": "To cast a magical spell upon someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "magic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The evil sorcerer tried to <w>bewitch</w> the king.",
                            "target_lang_translations": {
                                "zh": "那个邪恶的巫师试图对国王<w>施法</w>。"
                            }
                        },
                        {
                            "text": "Legend says the forest is <w>bewitched</w> by ancient spirits.",
                            "target_lang_translations": {
                                "zh": "传说这座森林被远古的灵魂<w>蛊惑</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "forspeak"
                    ],
                    "target_lang_definitions": {
                        "zh": "对某人施加魔法或咒语。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "施法",
                                "target_lang_sense_clarification": "指使用魔法或咒语。"
                            },
                            {
                                "target_lang_word": "蛊惑",
                                "target_lang_sense_clarification": "指用邪术或手段迷惑人心。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c79e9427-7769-3e06-90c5-da6b3c9bfa2e",
                    "sense_definition": "To cause someone to feel astonished or amazed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "amaze",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden news left the workers <w>bewitched</w> and confused.",
                            "target_lang_translations": {
                                "zh": "突如其来的消息让工人们感到<w>惊呆</w>且困惑。"
                            }
                        },
                        {
                            "text": "The complex magic trick <w>bewitched</w> the young children.",
                            "target_lang_translations": {
                                "zh": "复杂的魔术让孩子们感到<w>惊叹</w>不已。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使某人感到惊讶或惊奇。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "惊呆",
                                "target_lang_sense_clarification": "指因极度惊讶而不知所措。"
                            },
                            {
                                "target_lang_word": "惊叹",
                                "target_lang_sense_clarification": "指因感到神奇或不可思议而发出赞叹。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}