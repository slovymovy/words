                    {
                        "sense_id": "0d2e0a69-5ec9-30ed-9d0c-0ac91f761113",
                        "entry_id": "147afbbc-4f2a-35a1-81ed-723355f02425",
                        "glosses": [
                            "een gebied waar een bepaalde taal gesproken wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35245546-7130-448e-9fb7-a6395fa2d90c",
                                "sense_id": "0d2e0a69-5ec9-30ed-9d0c-0ac91f761113",
                                "text": "Henk Westbroek heeft samen met Henk Temming een eigenzinnig hoofdstuk van de Nederlandstalige popmuziek geschreven en dat wordt in het Nederlands taalgebied nog altijd hooglijk gewaardeerd. Zeker in België."
                            }
                        ]
                    },
                    {
                        "sense_id": "24c067f1-b16c-3f35-8b2f-63fca44f7fdd",
                        "entry_id": "147afbbc-4f2a-35a1-81ed-723355f02425",
                        "glosses": [
                            "een geheel van zaken die op taal betrekking hebben"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0d613dd9-fe6f-4a39-aa23-af63cf5129df",
                        "source_entry_id": "147afbbc-4f2a-35a1-81ed-723355f02425",
                        "source_sense_id": "0d2e0a69-5ec9-30ed-9d0c-0ac91f761113",
                        "source_sense_description": "een gebied waar een bepaalde taal gesproken wordt",
                        "target_lang_word": "Sprachraum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sprachraum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e8d4a611-a8a3-3406-b4d5-3aabeea36afc",
                                        "entry_id": "405b38a4-c348-3ac4-9458-41c65c88fd6b",
                                        "glosses": [
                                            "Verbreitungsgebiet einer Sprache oder eines Dialekts"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3afca0b2-64d1-4385-9a80-f037a58687df",
                                                "sense_id": "e8d4a611-a8a3-3406-b4d5-3aabeea36afc",
                                                "text": "„Die erst nach der Siedlung zustandegekommene Bildung des politischen Territoriums hätte die entstehenden Sprachräume und den stattgefundenen Ausgleich stabilisiert und die Vereinheitlichung in größerem Maßstab ermöglicht.“"
                                            },
                                            {
                                                "example_id": "fb99a9a1-e1a1-441b-be5a-634fee5a91b5",
                                                "sense_id": "e8d4a611-a8a3-3406-b4d5-3aabeea36afc",
                                                "text": "„Den vorwiegend aktiven Sprachräumen des Bairischen und Fränkischen stehen die vorwiegend passiven des Alemannischen und Niedersächsischen gegenüber.“"
                                            },
                                            {
                                                "example_id": "c8e87314-06b0-429a-ac33-fb6e333a2346",
                                                "sense_id": "e8d4a611-a8a3-3406-b4d5-3aabeea36afc",
                                                "text": "„Im Südosten darf in jener Zeit - im 3. - 2. Jahrtausend vor unserer Zeitrechnung - der Raum der Balkanhalbinsel als indogermanisch gelten, während der indogermanische Sprachraum im westlichen Südeuropa das Küstengebiet des Mittelmeers kaum hat erreichen können.“"
                                            },
                                            {
                                                "example_id": "2a5662b6-f967-4d6b-b615-fbee0d2dde7b",
                                                "sense_id": "e8d4a611-a8a3-3406-b4d5-3aabeea36afc",
                                                "text": "„Das Althochdeutsche strahlt seinerseits auf die lebenden Nachbarsprachen mehr aus, als es von ihnen aufnimmt, was aus der zentralen Stellung des althochdeutschen Sprachraums im ostfränkischen Reichsverband zu erklären ist.“"
                                            },
                                            {
                                                "example_id": "05adae1e-3212-495c-935b-3f43a04540ec",
                                                "sense_id": "e8d4a611-a8a3-3406-b4d5-3aabeea36afc",
                                                "text": "„Um die Zeit, in der sich Beke, Cooley und andere wegen des Kilimandscharo auf teilweise unfeine englische Art und Weise befehden, entstehen im deutschen Sprachraum wichtige geographische Zeitschriften.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
