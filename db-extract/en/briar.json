                "senses": [
                    {
                        "sense_id": "2956d7f8-12af-3d35-828e-b12b9093e14d",
                        "entry_id": "78b33d29-04b0-38bb-909f-e8cbdc393599",
                        "glosses": [
                            "Any of many plants with thorny stems growing in dense clusters, such as many in the Rosa, Rubus, and Smilax genera"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33ea0efa-bb47-4f36-9548-264bb25263ad",
                                "sense_id": "2956d7f8-12af-3d35-828e-b12b9093e14d",
                                "text": "Youngthes folke now flocken in every where,\nTo gather May-buskets and smelling brere"
                            }
                        ]
                    },
                    {
                        "sense_id": "9868b4c1-10c3-3358-a710-a529af681be0",
                        "entry_id": "78b33d29-04b0-38bb-909f-e8cbdc393599",
                        "glosses": [
                            "Anything sharp or unpleasant to the feelings."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "6467b6c8-81bc-4b42-bb2a-65c6f896a972",
                                "sense_id": "9868b4c1-10c3-3358-a710-a529af681be0",
                                "text": "¶ And thou ſonne of man, be not afraid of them, neither be afraid of their wordes, though bryars and thornes be with thee, and thou doeſt dwell among ſcorpions: be not afraid of their words, nor be diſmayed at their lookes, though they be a rebellious houſe."
                            },
                            {
                                "example_id": "c40b1091-eea1-4390-ab8e-8501e5dcbd8b",
                                "sense_id": "9868b4c1-10c3-3358-a710-a529af681be0",
                                "text": "Rov'd far, and gather'd much : some harsh, 't is true, / Pick'd from the thorns and briers of reproof, / But wholesome, well-digested;[…]"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
