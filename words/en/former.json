    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "81cf03da-d1c9-3925-adfe-cafd932efc19",
                    "sense_definition": "Belonging to or occurring in the past; having previously filled a particular role or position.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>former</w> president gave a speech at the university yesterday.",
                            "target_lang_translations": {
                                "ru": "<w>Бывший</w> президент вчера выступил с речью в университете.",
                                "tr": "<w>Eski</w> cumhurbaşkanı dün üniversitede bir konuşma yaptı.",
                                "zh": "<w>前</w>总统昨天在大学发表了演讲。"
                            }
                        },
                        {
                            "text": "In <w>former</w> times, people traveled by horse and carriage.",
                            "target_lang_translations": {
                                "ru": "В <w>прежние</w> времена люди путешествовали в конных экипажах.",
                                "tr": "<w>Önceki</w> zamanlarda insanlar at ve faytonla seyahat ederlerdi.",
                                "zh": "在<w>从前</w>，人们靠马车出行。"
                            }
                        }
                    ],
                    "synonyms": [
                        "previous",
                        "past",
                        "earlier",
                        "prior",
                        "ex",
                        "old",
                        "erstwhile",
                        "sometime",
                        "quondam"
                    ],
                    "antonyms": [
                        "current"
                    ],
                    "common_phrases": [
                        "former president",
                        "former times",
                        "former glory",
                        "former self"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к прошлому; занимавший определенную должность ранее",
                        "tr": "Geçmişe ait olan veya geçmişte belli bir makam ya da rolde bulunmuş olan.",
                        "zh": "指过去曾担任某职务或处于某种状态的；属于过去的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бы́вший",
                                "target_lang_sense_clarification": "о человеке или должности"
                            },
                            {
                                "target_lang_word": "пре́жний",
                                "target_lang_sense_clarification": "о времени или состоянии"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "eski",
                                "target_lang_sense_clarification": "bir görev veya rolde geçmişte bulunmuş olan"
                            },
                            {
                                "target_lang_word": "önceki",
                                "target_lang_sense_clarification": "zaman veya sıra bakımından önde gelen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "前",
                                "target_lang_sense_clarification": "指以前的职务或身份"
                            },
                            {
                                "target_lang_word": "从前",
                                "target_lang_sense_clarification": "指过去的时间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe4932dd-d1b2-32cf-9cff-ce2d4d93eaa7",
                    "sense_definition": "The first of two people or things just mentioned.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I offered him tea or coffee, and he chose the <w>former</w>.",
                            "target_lang_translations": {
                                "ru": "Я предложил ему чай или кофе, и он выбрал <w>первый</w>.",
                                "tr": "Ona çay veya kahve ikram ettim, o <w>ilki</w> seçti.",
                                "zh": "我让他选茶或咖啡，他选了<w>前者</w>。"
                            }
                        },
                        {
                            "text": "Between the red car and the blue one, the <w>former</w> is much faster.",
                            "target_lang_translations": {
                                "ru": "Между красной машиной и синей, <w>первая</w> намного быстрее.",
                                "tr": "Kırmızı araba ile mavi araba arasında, <w>birincisi</w> çok daha hızlıdır.",
                                "zh": "在红色车和蓝色车之间，<w>前者</w>快得多。"
                            }
                        }
                    ],
                    "synonyms": [
                        "preceding",
                        "antecedent"
                    ],
                    "antonyms": [
                        "latter"
                    ],
                    "common_phrases": [
                        "the former"
                    ],
                    "target_lang_definitions": {
                        "ru": "Первый из двух только что упомянутых людей или предметов",
                        "tr": "Bahsedilen iki kişi veya şeyden birincisi.",
                        "zh": "指刚提到的两者中的前者。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пе́рвый",
                                "target_lang_sense_clarification": "из двух упомянутых"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ilki",
                                "target_lang_sense_clarification": "iki şeyden ilk bahsedileni"
                            },
                            {
                                "target_lang_word": "birincisi",
                                "target_lang_sense_clarification": "ilk sıradaki"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "前者",
                                "target_lang_sense_clarification": "指两者中的第一个"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5efa42f4-d609-366e-a465-b9eaced0fcd4",
                    "sense_definition": "A student in a particular year or grade at school.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every sixth <w>former</w> is expected to attend the assembly.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>шестиклассник</w> должен присутствовать на собрании.",
                                "tr": "Her altıncı <w>sınıf öğrencisinin</w> toplantıya katılması bekleniyor.",
                                "zh": "每位六年级<w>学生</w>都应参加集会。"
                            }
                        },
                        {
                            "text": "The school organized a trip for the fifth <w>formers</w>.",
                            "target_lang_translations": {
                                "ru": "Школа организовала поездку для <w>пятиклассников</w>.",
                                "tr": "Okul, beşinci <w>sınıf öğrencileri</w> için bir gezi düzenledi.",
                                "zh": "学校为五年级<w>学生</w>组织了一次旅行。"
                            }
