                    }
                ],
                "translations": [
                    {
                        "translation_id": "4afd7895-abea-422f-8b65-f10139dff113",
                        "source_entry_id": "9a78a529-14c8-33a4-a9eb-f2e3db93bb27",
                        "source_sense_id": "eea05dc0-66cf-3f9e-b727-e36e149062f0",
                        "target_lang_word": "overlord",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overlord",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "165df810-f2b4-361b-986a-6ac2015ce769",
                                        "entry_id": "b986ae7c-a371-373e-8bd6-f673987dd4c8",
                                        "glosses": [
                                            "A ruler of other rulers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bf1eb31-f591-4283-a973-6c411b806d5b",
                                                "sense_id": "165df810-f2b4-361b-986a-6ac2015ce769",
                                                "text": "The various tribal chieftains met each spring to elect an overlord that would lead them in time of war."
                                            },
                                            {
                                                "example_id": "41bc6b7f-3232-46cf-a362-4a62aa15982e",
                                                "sense_id": "165df810-f2b4-361b-986a-6ac2015ce769",
                                                "text": "The leader is the man who knows the way of the overlords but identifies with the life of the oppressed."
                                            },
                                            {
                                                "example_id": "62840cbd-43ec-4501-ac81-088b887fdd1d",
                                                "sense_id": "165df810-f2b4-361b-986a-6ac2015ce769",
                                                "text": "Warlords leveraged their veteran soldiers to seize living space while the Council races were still grateful. Over centuries, the krogan conquered world after world. There was always \"just one more\" needed. When the Council finally demanded withdrawal from the asari colony of Lusia, krogan Overlord Kredak stormed off the Citadel, daring the Council to take their worlds back."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44491aaa-404a-31dd-b22d-2f6bb6c5492e",
                                        "entry_id": "b986ae7c-a371-373e-8bd6-f673987dd4c8",
                                        "glosses": [
                                            "A feudal lord directly owed rent or personal service by a tenant of subinfeudated land, a tenant's liege lord."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f97264c9-d79c-4775-bbdf-8422de0222ca",
                                                "sense_id": "44491aaa-404a-31dd-b22d-2f6bb6c5492e",
                                                "text": "The tenant owed a variety of obligations to his overlord—usually including military service or serjeanty—but these were gradually converted into monetary rents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55bbbea8-832c-3a0b-a3c7-9dccacdd08ea",
                                        "entry_id": "b986ae7c-a371-373e-8bd6-f673987dd4c8",
                                        "glosses": [
                                            "Anyone with overarching power or authority in a given domain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11e1a234-b0ed-41ec-8641-b63f60a0b9e8",
                                                "sense_id": "55bbbea8-832c-3a0b-a3c7-9dccacdd08ea",
                                                "text": "The crusty old professor was overlord of the history department, and few dared to cross his will."
                                            },
                                            {
                                                "example_id": "1d0bf04e-660c-4b3d-9cdf-24fe692a68b7",
                                                "sense_id": "55bbbea8-832c-3a0b-a3c7-9dccacdd08ea",
                                                "text": "One thing is for certain, there is no stopping them; the ants will soon be here. And I, for one, welcome our new insect overlords."
                                            },
                                            {
                                                "example_id": "7a781ec0-e4f3-4965-99dc-b4ced82b0b27",
                                                "sense_id": "55bbbea8-832c-3a0b-a3c7-9dccacdd08ea",
                                                "text": "Fluffy is wearing a diamond collar that belongs in the Tower of London with a platoon of Beefeaters standing guard over it. \"I for one welcome our new feline overlords.\""
                                            },
                                            {
                                                "example_id": "0d58123c-b870-469c-b382-ca9a7d1d80ba",
                                                "sense_id": "55bbbea8-832c-3a0b-a3c7-9dccacdd08ea",
                                                "text": "“It’s not like young authors need to worry about being supplanted now,” Ms. Williams said. “It’s a worry. But it’s got a ways to go, at least. They haven’t become our overlords yet.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "overlord",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "726a9676-dad0-3c5b-ad4a-f3adfcf9fff4",
                                        "entry_id": "ff832c83-cbb4-32c7-a393-83dd370a4698",
                                        "glosses": [
                                            "To rule over; to domineer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c8104d2-bde6-4e3e-94ca-38f6e159adc6",
                                                "sense_id": "726a9676-dad0-3c5b-ad4a-f3adfcf9fff4",
                                                "text": "Poor Johnny one-note sang out with gusto / And just overlorded the place"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
