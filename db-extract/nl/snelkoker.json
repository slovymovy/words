                    {
                        "sense_id": "5a53a0a5-5aae-3a97-b891-8af027e55bc0",
                        "entry_id": "a525f7e0-4eb5-3c57-90db-b2975f0e5f04",
                        "glosses": [
                            "afsluitbare pan waarmee men snel etenswaren gaar kan koken"
                        ],
                        "tags": [
                            "huishouden"
                        ],
                        "examples": [
                            {
                                "example_id": "7ef3a36c-5a26-47db-9ae1-78b62f6f49be",
                                "sense_id": "5a53a0a5-5aae-3a97-b891-8af027e55bc0",
                                "text": "Dal: een bruine smurrie met zwarte bolletjes en een witte kwak in het midden. Qua look een miskleun, maar de smaak is zacht en romig, met verse zwarte linzen die een speelse mondsensatie geven. Ze zijn eerst gekookt en daarna nog eens gebakken. ‘Best in de snelkoker, zo deed mijn grootmoeder dat’, mompelt Ravi. ‘Eerst koken, ja?’ Hij antwoordt: ‘Nee, eerst bakken. Eerst bakken, eerst bakken.’ Tot ik vraag: ‘Eerst bakken?’ Dan zegt hij: ‘Nee, koken sir.’"
                            }
                        ]
                    },
                    {
                        "sense_id": "15029ca0-360a-3682-8b0e-7aad71542717",
                        "entry_id": "a525f7e0-4eb5-3c57-90db-b2975f0e5f04",
                        "glosses": [
                            "afsluitbare pan waarmee men snel etenswaren gaar kan koken",
                            "heel intensieve opleidingssituatie waarin je in korte tijd wordt klaargestoomd"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "f20f2b5c-c469-4c1d-a24c-e120b2d8db53",
                                "sense_id": "15029ca0-360a-3682-8b0e-7aad71542717",
                                "text": "Dal: een bruine smurrie met zwarte bolletjes en een witte kwak in het midden. Qua look een miskleun, maar de smaak is zacht en romig, met verse zwarte linzen die een speelse mondsensatie geven. Ze zijn eerst gekookt en daarna nog eens gebakken. ‘Best in de snelkoker, zo deed mijn grootmoeder dat’, mompelt Ravi. ‘Eerst koken, ja?’ Hij antwoordt: ‘Nee, eerst bakken. Eerst bakken, eerst bakken.’ Tot ik vraag: ‘Eerst bakken?’ Dan zegt hij: ‘Nee, koken sir.’"
                            },
                            {
                                "example_id": "e3e7dd50-d48d-4559-bd12-3f9dfb6b5f35",
                                "sense_id": "15029ca0-360a-3682-8b0e-7aad71542717",
                                "text": "Van Doremalen: ‘Sinds een paar maanden hebben wij de Loyens Loeff Academy. Het is een soort snelkoker voor nieuwe mensen met als doel kennismaking met het kantoor, je collega’s, maar ook het opdoen van praktijkervaring en trainingen in presentaties en sociale vaardigheden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "406ed481-bac2-4840-96a7-04c3866e8b4a",
                        "source_entry_id": "a525f7e0-4eb5-3c57-90db-b2975f0e5f04",
                        "source_sense_id": "d8a99ef7-076b-344e-9626-dc6c44222dab",
