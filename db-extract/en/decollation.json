                        ],
                        "examples": [
                            {
                                "example_id": "4e859da7-34fd-41a7-a5bc-6bf55d9ee6e7",
                                "sense_id": "9904a57d-f2bc-3ee9-9a1b-c2fcd993390c",
                                "text": "She was borne Jan. 29ᵗʰ, morning, scil. the day before the anniversary-day of the king's [Charles I of England] decollation."
                            },
                            {
                                "example_id": "a8814b2a-c833-4cc0-bde5-b80bd41f6556",
                                "sense_id": "9904a57d-f2bc-3ee9-9a1b-c2fcd993390c",
                                "text": "His Majeſty K. Ch. the firſt; to whoſe body after his decollation in the latter end of Jan. 1648 he put his hands to open and embalm, and when that was done, he ſewed his head to his body"
                            },
                            {
                                "example_id": "36520f85-53c6-4b2f-8f32-b510f91f972e",
                                "sense_id": "9904a57d-f2bc-3ee9-9a1b-c2fcd993390c",
                                "text": "The epoch of the Martyrs here [in Cordova] began with the decollation of the priest Perfecto, in 850."
                            }
                        ]
                    },
