                "senses": [
                    {
                        "sense_id": "703a4359-1b9c-3f43-9e50-e4b3e57b9d56",
                        "entry_id": "dc4c6283-c31d-3e48-87eb-6e704ee9bb9e",
                        "glosses": [
                            "техн. с одним плечом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12452a04-6be3-46c6-adad-6b4650c53711",
                                "sense_id": "703a4359-1b9c-3f43-9e50-e4b3e57b9d56",
                                "text": "Главный летательный аппарат – крыло, одноплечий рычаг, который вращается в плечевом суставе."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "539eeee1-7446-4d86-99eb-0a2f91212aab",
                        "source_entry_id": "dc4c6283-c31d-3e48-87eb-6e704ee9bb9e",
                        "source_sense_id": "703a4359-1b9c-3f43-9e50-e4b3e57b9d56",
                        "target_lang_word": "one-shouldered",
