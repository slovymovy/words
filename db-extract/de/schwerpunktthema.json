                ],
                "senses": [
                    {
                        "sense_id": "590905c5-707d-3190-9dcf-2657e791b906",
                        "entry_id": "e311106c-99b0-330e-991d-de02a3f976d4",
                        "glosses": [
                            "vorrangiges Thema, wichtigster Gedanke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bbad361-42c7-49b5-855d-7b12417e02ba",
                                "sense_id": "590905c5-707d-3190-9dcf-2657e791b906",
                                "text": "„Als Schwerpunktthema wurde ein Konzept zur Reduzierung von Bewegungsmangel und Prävention von Übergewicht und Adipositas bei Kindern und Jugendlichen durch gesundheitssportliche Aktivität gewählt.“"
                            },
                            {
                                "example_id": "7485689f-95ce-4a78-a849-827ec6d60705",
                                "sense_id": "590905c5-707d-3190-9dcf-2657e791b906",
                                "text": "„Zu fast jedem Treffen wird ein Schwerpunktthema festgelegt, verbunden mit der Einladung von Gästen.“"
                            },
                            {
                                "example_id": "088050f6-cf7d-46f8-9669-8ecadd8f429a",
                                "sense_id": "590905c5-707d-3190-9dcf-2657e791b906",
                                "text": "„Startpunkt ist dabei das Schwerpunktthema, das man in die Mitte des Blattes notiert, beispielsweise das Thema Magen-Darm-Erkrankungen (Gastroenterologie).“"
                            },
                            {
                                "example_id": "5bfab373-d9af-4701-bac1-5d804b46a97e",
                                "sense_id": "590905c5-707d-3190-9dcf-2657e791b906",
                                "text": "„Meist erfolgt noch auf dieser Tagung ein erster praktischer Einstieg in das Schwerpunktthema, um noch etwas mehr »Fleisch an die Knochen« zu bringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
