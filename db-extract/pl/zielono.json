                            {
                                "example_id": "4f1ca7ce-6cc9-4850-ae0d-bc726a3b9560",
                                "sense_id": "8e02d223-efab-35d4-b489-141c63b7a8a4",
                                "text": "Jeden z żartów mówi, że kiedy Kostarykanin chce cokolwiek sprzedać, najpierw maluje towar na zielono"
