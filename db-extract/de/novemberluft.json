                        "examples": [
                            {
                                "example_id": "e41d0900-1624-44a7-8ae8-76d081dff161",
                                "sense_id": "ef52b2da-f94c-3594-a717-52240c3004ad",
                                "text": "„Noch dazu mussten sie mit der eisigen Novemberluft zurechtkommen, die auf dem 2700 Meter hohen Berg dünn war und durch die hohen Felswände zu einem unbarmherzig starken Wind wurde.“"
                            },
                            {
                                "example_id": "fe9ae796-d855-49a2-8ff4-25df60b45fdf",
                                "sense_id": "ef52b2da-f94c-3594-a717-52240c3004ad",
                                "text": "„Während sich gestern eine eilig zusammengestellte Mannschaft bemühte, Vinerd Howse wieder einigermaßen in Ordnung zu bringen, machten wir drei einen Ausflug zum westlichen Zipfel der Insel und gingen den ganzen Nachmittag lang in der kühlen Novemberluft an den atemberaubenden Klippen von Gay Head spazieren.“"
                            }
                        ],
