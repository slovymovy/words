    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "28f8bf20-28df-345e-802f-71222d16d551",
                "word": "full-time",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "11b00b9e-5ae0-3e36-bb05-eb4079c3a158",
                        "entry_id": "28f8bf20-28df-345e-802f-71222d16d551",
                        "glosses": [
                            "Involving a full amount of time spent on some activity, especially a job."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "ca8d53a9-fb8f-4c4f-ab2b-7585a4bab6d4",
                                "sense_id": "11b00b9e-5ae0-3e36-bb05-eb4079c3a158",
                                "text": "I have a full-time job, working five days a week."
                            },
                            {
                                "example_id": "1d7f493a-b919-4825-9b6d-3da6a2d3ee3a",
                                "sense_id": "11b00b9e-5ae0-3e36-bb05-eb4079c3a158",
                                "text": "Bringing up a child is a full-time activity."
                            },
                            {
                                "example_id": "6a8c2058-d427-4e37-b221-7067ad777c06",
                                "sense_id": "11b00b9e-5ae0-3e36-bb05-eb4079c3a158",
                                "text": "\"I finished full-time work in 2005 and then switched to part time, because I liked working and it seemed a shame to leave something I enjoyed."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0547afe2-618b-4f48-b615-a8a431b5d579",
                        "source_entry_id": "28f8bf20-28df-345e-802f-71222d16d551",
                        "source_sense_id": "11b00b9e-5ae0-3e36-bb05-eb4079c3a158",
                        "source_sense_description": "Involving a full amount of time spent on some activity",
                        "target_lang_word": "voltijds",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voltijds",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "31687659-9fbd-3251-a21b-2109e5e8bbc9",
                                        "entry_id": "75fc9e8f-3dc4-3ea5-87f6-337395a699e1",
                                        "glosses": [
                                            "van banen en studie dat het de hele werktijd omvat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cbf9ef0-47be-468a-85ac-ce3749956844",
                                                "sense_id": "31687659-9fbd-3251-a21b-2109e5e8bbc9",
                                                "text": "Ik heb niet op een vrouw gestemd omdat ik het een treurig gebaar vind. Het is achteroverleunfeminisme: wel roepen dat er van alles moet gebeuren, maar zelf niets doen. Uiteindelijk is een voltijds werkende vrouw gewoon een zeldzaamheid in Nederland. Als er straks een kabinet aantreedt dat voor eenderde uit vrouwen bestaat, zou dat niet representatief zijn voor de verhoudingen binnen werkend Nederland. Ik vind die afwezigheid van ambitieuze vrouwen binnen de politieke, sociale, academische en culturele machtscentra van dit land een steeds groter probleem."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "voltijds",
                                "target_lang_code": "nl",
                                "target_senses": [
