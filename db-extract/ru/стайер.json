                        "target_lang_word": "Langstreckenläufer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Langstreckenläufer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07c40c74-8d72-3db1-b252-54bfc5d3e4ad",
                                        "entry_id": "f3421f0d-4d9c-3c74-9391-8290ea22aa10",
                                        "glosses": [
                                            "Sportler, der sich auf Langstrecken spezialisiert hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85948865-a24c-497d-8d58-f03b62be5c9d",
                                                "sense_id": "07c40c74-8d72-3db1-b252-54bfc5d3e4ad",
                                                "text": "Wusstest du, dass mein Cousin einer sehr talentierter Langstreckenläufer ist?"
                                            },
                                            {
                                                "example_id": "9e9df1f9-3c38-4306-b5a4-ad14adfc2416",
                                                "sense_id": "07c40c74-8d72-3db1-b252-54bfc5d3e4ad",
                                                "text": "Als Langstreckenläufer benötigt man besonders viel Ausdauer."
                                            },
                                            {
                                                "example_id": "8986bf84-137c-407d-8d32-af8df51c3164",
                                                "sense_id": "07c40c74-8d72-3db1-b252-54bfc5d3e4ad",
                                                "text": "„Der kenianische Langstreckenläufer Daniel Kinyua ist von der unabhängigen Integritätskommission AIU des Leichtathletik-Weltverbandes World Athletics wegen Verstößen gegen die Anti-Doping-Regeln vorläufig suspendiert worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8282d30-beef-4935-adbb-7c404daaade8",
                        "source_entry_id": "02f2b5db-9ede-35f4-a5f3-a8f2f1404fb5",
