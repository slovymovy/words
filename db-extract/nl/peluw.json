                                    {
                                        "sense_id": "5d07858c-5a72-320e-84a6-6ff4a77352df",
                                        "entry_id": "75afaafa-bbff-3a31-b2c9-d65ee6f22b87",
                                        "glosses": [
                                            "Something acting as a cushion, especially to absorb a shock or impact.",
