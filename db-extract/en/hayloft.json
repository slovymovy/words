                ],
                "senses": [
                    {
                        "sense_id": "dc82b058-c648-3f72-aa5c-2d8ace63e519",
                        "entry_id": "4282978e-cc4d-313b-9a29-16d52f37300f",
                        "glosses": [
                            "The upper storey of a barn used for storing hay."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8adb71c2-a78d-46c1-86f6-7e7dc29eb57a",
                                "sense_id": "dc82b058-c648-3f72-aa5c-2d8ace63e519",
                                "text": "\"I went into the stable first to see to the horse, and found him neighing and waiting for his hay, so I went up into the hay-loft for an armful[.]\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98f5eda2-1f7f-4b6c-87a6-b14f7e5e530a",
                        "source_entry_id": "4282978e-cc4d-313b-9a29-16d52f37300f",
                        "source_sense_id": "dc82b058-c648-3f72-aa5c-2d8ace63e519",
                        "source_sense_description": "upper storey of a barn",
                        "target_lang_word": "hooischuur",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hooischuur",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0ed249ed-cc4b-352b-95b4-c16896b792b2",
                                        "entry_id": "75d9292a-a185-33f3-8ccc-453d3768381d",
                                        "glosses": [
                                            "grote opslagruimte voor gedroogd gras"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff3cbeba-2eac-481a-bbc5-c3755b821ad0",
                                                "sense_id": "0ed249ed-cc4b-352b-95b4-c16896b792b2",
                                                "text": "Toen zij zich gewassen en verkleed hadden, gingen zij naar de keurig geveegde hooischuur, waar de koetsiers een bed voor de heren hadden gespreid."
                                            },
                                            {
                                                "example_id": "12fbf191-076a-4d96-9ed0-ba373c0fdd2d",
                                                "sense_id": "0ed249ed-cc4b-352b-95b4-c16896b792b2",
                                                "text": "In Praag is de dierentuin gesloten vanwege stormschade. De dieren zijn niet in gevaar geweest, schrijft de dierentuin op Facebook. Maar er zijn wel veel bomen omgewaaid en een hooischuur is beschadigd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "254e95eb-3114-3c8a-890d-ef660c2de81a",
                                        "entry_id": "75d9292a-a185-33f3-8ccc-453d3768381d",
                                        "glosses": [
                                            "koe met een opgezwollen buik"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "824d2144-78b9-48bd-bd20-9db6470e55b7",
                        "source_entry_id": "4282978e-cc4d-313b-9a29-16d52f37300f",
                        "source_sense_id": "dc82b058-c648-3f72-aa5c-2d8ace63e519",
                        "source_sense_description": "upper storey of a barn",
                        "target_lang_word": "grenier à foin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "61d9d1e5-5da2-46db-aa47-0acdb69f9ddb",
                        "source_entry_id": "4282978e-cc4d-313b-9a29-16d52f37300f",
                        "source_sense_id": "dc82b058-c648-3f72-aa5c-2d8ace63e519",
                        "source_sense_description": "upper storey of a barn",
                        "target_lang_word": "fenil",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fenil",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fbd56319-d8a2-31ad-a218-3ca1e7486aa3",
                                        "entry_id": "3853bab4-9cf4-3e01-8d4d-5beada9cde40",
                                        "glosses": [
                                            "Lieu où on entrepose le foin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c26b93c0-fd01-4709-bbee-3a3a141bfac8",
                                                "sense_id": "fbd56319-d8a2-31ad-a218-3ca1e7486aa3",
                                                "text": "Il entrait dans la grange et ouvrait la lucarne du fenil, sur l’écurie, pour donner le fourrage aux bêtes."
                                            },
                                            {
                                                "example_id": "0b870684-d461-4af4-87e6-c15001ce742c",
                                                "sense_id": "fbd56319-d8a2-31ad-a218-3ca1e7486aa3",
                                                "text": "Assez souvent, le matin, il voyait un chemineau descendre du fenil. Le chemineau lui donnait un grand coup de chapeau et le père Renon lui demandait s’il avait bien dormi."
                                            },
                                            {
                                                "example_id": "fe0c23e3-acba-41f9-a3c9-cc800a4679b4",
                                                "sense_id": "fbd56319-d8a2-31ad-a218-3ca1e7486aa3",
                                                "text": "La main de l’enfant, traînante, perçoit dans l’herbe l’humidité du soir. C’est l’heure des lampes. Un clapotis d’eau courante mêle les feuilles, la porte du fenil se met à battre le mur comme en hiver par la bourrasque."
                                            },
                                            {
                                                "example_id": "3dabcd0e-418a-4d2f-a43a-686c371de010",
                                                "sense_id": "fbd56319-d8a2-31ad-a218-3ca1e7486aa3",
                                                "text": "Il résistait, se dérobait, hennissait, et à la fin il n’eut plus d’autre moyen que de l’amener jusqu’à la cour, puis de pousser le lourd chariot à force d’homme assez près du fenil pour transborder le fourrage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b82cbe07-8bdf-45bb-abb7-2d6162d02642",
                        "source_entry_id": "4282978e-cc4d-313b-9a29-16d52f37300f",
                        "source_sense_id": "dc82b058-c648-3f72-aa5c-2d8ace63e519",
                        "source_sense_description": "upper storey of a barn",
                        "target_lang_word": "Heuboden",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heuboden",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f789ace7-7787-3385-95f0-77134e896807",
                                        "entry_id": "31ac69f5-fcec-332c-bd48-ba1fb49cdc6e",
                                        "glosses": [
                                            "Raum, der sich über den Stallungen oder in der Scheune befindet und zur Lagerung von Heu dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6511b8e1-eb3f-474f-8028-3d468fd3f12f",
                                                "sense_id": "f789ace7-7787-3385-95f0-77134e896807",
                                                "text": "„Auf einer schmalen Eisenleiter steigt er hinauf auf den Heuboden.“"
                                            },
                                            {
                                                "example_id": "679f143a-aeb2-42aa-8cbe-46f619abb7b9",
                                                "sense_id": "f789ace7-7787-3385-95f0-77134e896807",
                                                "text": "„Mein Bruder fing dann mit seinen Freunden an, die Katze zu suchen, natürlich auf dem Heuboden.“"
                                            },
                                            {
                                                "example_id": "d3ceaf4b-311e-4db6-ba70-20804c4cb3f5",
                                                "sense_id": "f789ace7-7787-3385-95f0-77134e896807",
                                                "text": "„Die meisten müssen im Stall, auf dem Heuboden über den Pferden und Kühen schlafen.“"
                                            },
                                            {
                                                "example_id": "aa34a4cc-240d-46a9-8a2a-17e4dcd8b6c7",
                                                "sense_id": "f789ace7-7787-3385-95f0-77134e896807",
                                                "text": "„Eine Handvoll Soldaten hielt sich noch auf dem Heuboden einer Scheune.“"
                                            },
                                            {
                                                "example_id": "883f33ae-8f72-46a5-b84b-67d590a815c0",
                                                "sense_id": "f789ace7-7787-3385-95f0-77134e896807",
                                                "text": "[…] „»in der Lüneburger Heide sind die Unterkünfte und Hotels nicht so reichlich, und da passierte es dann, dass wir auch auf Heuböden schlafen mussten«“ […]."
                                            },
                                            {
                                                "example_id": "68700758-42b3-4055-b870-bb8c70118a2d",
                                                "sense_id": "f789ace7-7787-3385-95f0-77134e896807",
                                                "text": "„Gemeinsam waren Tove und ihre Mutter in den letzten Septembertagen aus Kopenhagen aufgebrochen, um der Verfolgung der dänischen Juden durch die deutschen Besatzer zu entkommen. In Gilleleje wurden sie zusammen mit anderen auf einem Heuboden versteckt“ […]."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
