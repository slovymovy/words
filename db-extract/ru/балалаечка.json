                "senses": [
                    {
                        "sense_id": "2cb592fd-b929-325a-a4e0-87e77d68cbe5",
                        "entry_id": "fc4ddd0d-2e9b-3ebc-b6e7-3f837245fdb4",
                        "glosses": [
                            "разг. ласк. к балалайка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee663693-469f-49ca-ab48-7231b6a523f9",
                                "sense_id": "2cb592fd-b929-325a-a4e0-87e77d68cbe5",
                                "text": "Все девчата — на гулянке, // А моя милашка спит! // Заиграю в балалаечку, — // Сильнее захрапит!"
                            },
                            {
                                "example_id": "29fae337-98d4-4a36-99cd-feac966362ab",
                                "sense_id": "2cb592fd-b929-325a-a4e0-87e77d68cbe5",
                                "text": "Демьян пел вроде бы негромко, но лихо у него это выходило. ❬…❭ И чеченская балалаечка с тремя струнами играла-переливалась на русский манер под его рукой."
                            }
                        ]
                    }
