{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "88a22709-19fb-3db1-a1d8-4f1550f11ed2",
                    "sense_definition": "A prolonged and bitter feud, especially between families or clans, often involving retaliatory violence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "feud",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two families had been locked in a bitter <w>vendetta</w> for several generations.",
                            "target_lang_translations": {
                                "tr": "İki aile birkaç nesildir şiddetli bir <w>kan davasının</w> içine sürüklenmişti."
                            }
                        },
                        {
                            "text": "Local authorities intervened to stop the violent <w>vendetta</w> between the rival gangs.",
                            "target_lang_translations": {
                                "tr": "Yerel yetkililer, rakip çeteler arasındaki şiddetli <w>kan davasını</w> durdurmak için müdahale etti."
                            }
                        }
                    ],
                    "synonyms": [
                        "blood feud",
                        "feud"
                    ],
                    "common_phrases": [
                        "bitter vendetta",
                        "blood vendetta"
                    ],
                    "target_lang_definitions": {
                        "tr": "Özellikle aileler veya klanlar arasında süregelen, genellikle karşılıklı şiddet içeren uzun süreli ve şiddetli husumet; kan davası."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kan davası",
                                "target_lang_sense_clarification": "aileler veya klanlar arası ölümcül düşmanlık"
                            },
                            {
                                "target_lang_word": "kan davası güdüşü",
                                "target_lang_sense_clarification": "süregelen intikam mücadelesi"
                            },
                            {
                                "target_lang_word": "vendetta",
                                "target_lang_sense_clarification": "kan davası veya uzun süreli düşmanlık"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44c88993-626e-32dd-96a8-5c881613025e",
                    "sense_definition": "A persistent, bitter grudge or campaign against a particular person or group.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "feud",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He claimed the editor had launched a personal <w>vendetta</w> to ruin his career.",
                            "target_lang_translations": {
                                "tr": "Editörün kariyerini mahvetmek için kendisine karşı <w>kişisel bir savaş</w> başlattığını iddia etti."
                            }
                        },
                        {
                            "text": "The politician accused the media of pursuing a relentless <w>vendetta</w> against him.",
                            "target_lang_translations": {
                                "tr": "Siyasetçi, medyayı kendisine karşı amansız bir <w>karalama kampanyası</w> yürütmekle suçladı."
                            }
                        }
                    ],
                    "synonyms": [
                        "grudge"
                    ],
                    "common_phrases": [
                        "personal vendetta",
                        "wage a vendetta"
                    ],
                    "target_lang_definitions": {
                        "tr": "Belirli bir kişiye veya gruba karşı yürütülen sürekli, acımasız kin veya karalama kampanyası."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kişisel kan davası",
                                "target_lang_sense_clarification": "bir kişiye karşı takıntılı husumet"
                            },
                            {
                                "target_lang_word": "kin gütme",
                                "target_lang_sense_clarification": "süregelen düşmanlık veya hınç besleme"
                            },
                            {
                                "target_lang_word": "karalama kampanyası",
                                "target_lang_sense_clarification": "birine zarar vermek için yürütülen sistemli mücadele"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e9f53d0-29d4-3dd7-bb07-698751a5a627",
                    "sense_definition": "An act or state of taking revenge; vengeance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "revenge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Driven by pure <w>vendetta</w>, he refused to accept any peaceful compromise.",
                            "target_lang_translations": {
                                "tr": "Tamamen <w>öç alma</w> hırsıyla hareket ederek hiçbir barışçıl uzlaşmayı kabul etmedi."
                            }
                        },
                        {
                            "text": "Her search for justice soon turned into an obsessive <w>vendetta</w>.",
                            "target_lang_translations": {
                                "tr": "Onun adalet arayışı çok geçmeden saplantılı bir <w>intikam hırsına</w> dönüştü."
                            }
                        }
                    ],
                    "synonyms": [
                        "revenge",
                        "vengeance",
                        "retaliation"
                    ],
                    "antonyms": [
                        "forgiveness"
                    ],
                    "target_lang_definitions": {
                        "tr": "İntikam alma eylemi veya durumu; öç."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "öç alma",
                                "target_lang_sense_clarification": "intikam arayışı"
                            },
                            {
                                "target_lang_word": "intikam",
                                "target_lang_sense_clarification": "öç"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}