                            {
                                "example_id": "d130570a-26a9-47c6-9402-74778fccee1a",
                                "sense_id": "cc64f264-0e4f-3a4b-8f0e-f0b16d193f73",
                                "text": "Die katholische Filialkirche St. Peter liegt auf dem Petersberg, einem bewaldeteten Höhenzug im Dachauer Hügelland in Oberbayern."
                            },
                            {
                                "example_id": "1a0c28c2-f3af-4b77-8a06-0875ca2e79a9",
                                "sense_id": "cc64f264-0e4f-3a4b-8f0e-f0b16d193f73",
                                "text": "„Um 1500 bestanden in dem Raum der heutigen Kreise 112 Mutterkirchen mit Pfarreien und außerdem noch ca. 80 Filialkirchen.“"
                            }
                        ],
