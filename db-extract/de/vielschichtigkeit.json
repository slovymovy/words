                                        "sense_id": "fae01063-d530-3765-a2ae-fcd926918ed4",
                                        "entry_id": "a6323aef-30af-3900-a94f-706a9e42bc5b",
                                        "glosses": [
                                            "That which is and renders complex; intricacy; complication."
                                        ],
