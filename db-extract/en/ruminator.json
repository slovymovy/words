                        "glosses": [
                            "One who ruminates; one who meditates or reflects."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdb87927-39f5-41f9-9982-5fa0765bc7f1",
                                "sense_id": "006913a8-45b6-3ec1-9291-f12e7136bc9c",
                                "text": "An all-round terrific lady: sweet, compassionate, busty, pert-nosed, prone to floods of sudden tears, a lover of mini-skirts and tall leather boots and snug sweaters, which you somehow wore with total innocence, a worrier, a sweet ruminator by windows. a girl possessed of incredibly long. elegant eyelashes. and of course more flawlessly managed hair than a salonful of average girls could ever grow."
                            },
                            {
                                "example_id": "2cc1ebb3-aa0f-44fe-a1a0-bfd3677f9ae1",
                                "sense_id": "006913a8-45b6-3ec1-9291-f12e7136bc9c",
                                "text": "The narrator is a reader and ruminator, a provocateur."
                            },
                            {
                                "example_id": "2466d673-a198-4379-8514-6497d694de15",
                                "sense_id": "006913a8-45b6-3ec1-9291-f12e7136bc9c",
                                "text": "They’re also more likely to become unnerved by stressful events: for instance, Nolen-Hoeksema found that residents of San Francisco who self-identified as ruminators showed significantly more depressive symptoms after the 1989 Loma Prieta earthquake."
                            }
                        ]
                    }
