    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dfe8fd54-e325-31cb-9a28-b065b47cb5b4",
                    "sense_definition": "Распасться на куски от удара или падения",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "физическое_разрушение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Красивая тарелка упала на пол и <w>разбилась</w> на мелкие кусочки.",
                            "target_lang_translations": {
                                "en": "The beautiful plate fell onto the floor and <w>shattered</w> into tiny pieces.",
                                "es": "El plato bonito cayó al suelo y se <w>rompió</w> en pequeños pedazos.",
                                "fr": "La belle assiette est tombée par terre et <w>s'est brisée</w> en petits morceaux."
                            }
                        },
                        {
                            "text": "Стакан случайно <w>разбился</w> вдребезги во время мытья посуды.",
                            "target_lang_translations": {
                                "en": "The glass accidentally <w>broke</w> to smithereens while doing the dishes.",
                                "es": "El vaso se <w>hizo añicos</w> accidentalmente mientras lavaba los platos.",
                                "fr": "Le verre <w>a volé en éclats</w> par accident en faisant la vaisselle."
                            }
                        }
                    ],
                    "synonyms": [
                        "расколоться"
                    ],
                    "common_phrases": [
                        "разбиться вдребезги",
                        "разбиться на кусочки"
                    ],
                    "target_lang_definitions": {
                        "en": "To break into pieces, shatter, or smash upon impact or falling",
                        "es": "Romperse en pedazos debido a un golpe o caída.",
                        "fr": "Se casser en morceaux à la suite d'un choc ou d'une chute"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shatter",
                                "target_lang_sense_clarification": "break into many small pieces"
                            },
                            {
                                "target_lang_word": "break",
                                "target_lang_sense_clarification": "get damaged into pieces"
                            },
                            {
                                "target_lang_word": "smash",
                                "target_lang_sense_clarification": "break violently upon impact"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "romperse",
                                "target_lang_sense_clarification": "objetos frágiles en general"
                            },
                            {
                                "target_lang_word": "romperse en pedazos",
                                "target_lang_sense_clarification": "hacerse pedazos"
                            },
                            {
                                "target_lang_word": "destrozarse",
                                "target_lang_sense_clarification": "quedar completamente destruido"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "se briser",
                                "target_lang_sense_clarification": "en plusieurs morceaux"
                            },
                            {
                                "target_lang_word": "se casser",
                                "target_lang_sense_clarification": "général"
                            },
                            {
                                "target_lang_word": "voler en éclats",
                                "target_lang_sense_clarification": "se briser violemment"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82437eb7-2ca7-3c46-8267-5903648f4187",
                    "sense_definition": "Разделиться на отдельные части, группы или категории",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "разделение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для проведения игры студенты решили <w>разбиться</w> на группы.",
                            "target_lang_translations": {
                                "en": "For the game, the students decided to <w>split up</w> into groups.",
                                "es": "Para llevar a cabo el juego, los estudiantes decidieron <w>dividirse</w> en grupos.",
                                "fr": "Pour le jeu, les étudiants ont décidé de <w>se diviser</w> en groupes."
                            }
                        },
                        {
                            "text": "Участники семинара смогли <w>разбиться</w> на пары для выполнения упражнения.",
                            "target_lang_translations": {
                                "en": "The seminar participants were able to <w>divide</w> into pairs to do the exercise.",
                                "es": "Los participantes del seminario pudieron <w>agruparse</w> en parejas para hacer el ejercicio.",
                                "fr": "Les participants au séminaire ont pu <w>se mettre</w> deux par deux pour faire l'exercice."
                            }
                        }
                    ],
                    "common_phrases": [
                        "разбиться на группы",
                        "разбиться на пары"
                    ],
                    "target_lang_definitions": {
                        "en": "To split or divide into separate parts, groups, or categories",
                        "es": "Dividirse en partes, grupos o categorías individuales.",
                        "fr": "Se diviser en plusieurs parties, groupes ou catégories"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "split up",
                                "target_lang_sense_clarification": "divide into smaller groups"
                            },
                            {
                                "target_lang_word": "break up",
                                "target_lang_sense_clarification": "divide into parts or pairs"
                            },
                            {
                                "target_lang_word": "divide",
                                "target_lang_sense_clarification": "separate into groups"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "dividirse",
                                "target_lang_sense_clarification": "separarse en grupos o partes"
                            },
                            {
                                "target_lang_word": "agruparse",
                                "target_lang_sense_clarification": "organizarse en grupos"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "se diviser",
                                "target_lang_sense_clarification": "en groupes ou catégories"
                            },
                            {
                                "target_lang_word": "se séparer",
                                "target_lang_sense_clarification": "en sous-groupes"
                            },
                            {
                                "target_lang_word": "se mettre",
                                "target_lang_sense_clarification": "en groupes, en équipes"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a441ecd8-2a29-32ba-ae4e-4483d9830f39",
                    "sense_definition": "Разрушиться, потерпеть крах (о планах, мечтах, надеждах)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "абстрактное_разрушение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Все его мечты о путешествии <w>разбились</w> о реальность.",
                            "target_lang_translations": {
                                "en": "All his dreams of traveling <w>were shattered</w> by reality.",
                                "es": "Todos sus sueños de viajar se <w>estrellaron</w> contra la realidad.",
                                "fr": "Tous ses rêves de voyage <w>se sont brisés</w> contre la réalité."
                            }
                        },
                        {
                            "text": "Их совместная любовная лодка <w>разбилась</w> о быт.",
                            "target_lang_translations": {
                                "en": "Their love life <w>foundered</w> on the rocks of everyday routine.",
                                "es": "Su barco del amor se <w>rompió</w> con la rutina diaria.",
                                "fr": "Leur amour <w>s'est effondré</w> face à la routine quotidienne."
                            }
                        }
                    ],
                    "common_phrases": [
                        "разбиться о быт",
                        "надежды разбились"
                    ],
                    "target_lang_definitions": {
                        "en": "To be ruined or crushed (referring to plans, dreams, or hopes)",
                        "es": "Destruirse o fracasar (referido a planes, sueños o esperanzas).",
                        "fr": "S'effondrer, échouer complètement (en parlant d'espoirs, de rêves ou de projets)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be shattered",
                                "target_lang_sense_clarification": "for hopes, dreams, or plans to be destroyed"
                            },
                            {
                                "target_lang_word": "be dashed",
                                "target_lang_sense_clarification": "for hopes or expectations to be ruined"
                            },
                            {
                                "target_lang_word": "fall apart",
                                "target_lang_sense_clarification": "fail or break down completely"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "romperse",
                                "target_lang_sense_clarification": "destruirse figuradamente"
                            },
                            {
                                "target_lang_word": "desmoronarse",
                                "target_lang_sense_clarification": "arruinarse o venirse abajo"
                            },
                            {
                                "target_lang_word": "hacerse añicos",
                                "target_lang_sense_clarification": "dicho de sueños o esperanzas"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "s'effondrer",
                                "target_lang_sense_clarification": "pour des rêves ou espérances"
                            },
                            {
                                "target_lang_word": "se briser",
                                "target_lang_sense_clarification": "au sens figuré"
                            },
                            {
                                "target_lang_word": "voler en éclats",
                                "target_lang_sense_clarification": "pour des illusions ou projets"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f22930ff-09d2-323d-82fa-e7672d657247",
                    "sense_definition": "Сильно пострадать, получить травму или погибнуть при падении или аварии",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "травма_гибель",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Водитель не справился с управлением, и машина успела <w>разбиться</w> о дерево.",
                            "target_lang_translations": {
                                "en": "The driver lost control, and the car <w>crashed</w> into a tree.",
                                "es": "El conductor perdió el control y el coche se <w>estrelló</w> contra un árbol.",
                                "fr": "Le conducteur a perdu le contrôle et la voiture est allée <w>s'écraser</w> contre un arbre."
                            }
                        },
                        {
                            "text": "К счастью, упав с велосипеда, мальчик лишь немного ушибся и не <w>разбился</w> насмерть.",
                            "target_lang_translations": {
                                "en": "Fortunately, after falling off his bike, the boy only got a small bruise and was not <w>killed</w>.",
                                "es": "Afortunadamente, al caer de la bicicleta, el niño solo se golpeó un poco y no se <w>mató</w>.",
                                "fr": "Heureusement, en tombant de vélo, le garçon n'a eu que quelques bleuets et ne <w>s'est</w> pas <w>tué</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "разбиться насмерть",
                        "разбиться в аварии"
                    ],
                    "target_lang_definitions": {
                        "en": "To crash, get seriously injured, or die in a fall or accident",
                        "es": "Sufrir heridas graves o morir en un accidente o caída.",
                        "fr": "Être grièvement blessé ou tué lors d'un accident ou d'une chute"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crash",
                                "target_lang_sense_clarification": "in a vehicle or aircraft accident"
                            },
                            {
                                "target_lang_word": "be killed",
                                "target_lang_sense_clarification": "die in a crash or fall"
                            },
                            {
                                "target_lang_word": "get injured",
                                "target_lang_sense_clarification": "be hurt severely in a fall or crash"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "estrellarse",
                                "target_lang_sense_clarification": "chocar violentamente"
                            },
                            {
                                "target_lang_word": "matarse",
                                "target_lang_sense_clarification": "morir en un accidente"
                            },
                            {
                                "target_lang_word": "hacerse daño",
                                "target_lang_sense_clarification": "lastimarse en una caída"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "s'écraser",
                                "target_lang_sense_clarification": "dans un accident de véhicule ou chute"
                            },
                            {
                                "target_lang_word": "se tuer",
                                "target_lang_sense_clarification": "dans un accident"
                            },
                            {
                                "target_lang_word": "se faire très mal",
                                "target_lang_sense_clarification": "en tombant"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7172dfaa-1059-302b-b3cb-0f7030b16cc4",
                    "sense_definition": "Прийти в негодность или плохое состояние от долгого или небрежного использования",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "износ",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Старая дорога совсем <w>разбилась</w> из-за постоянного движения тяжелых грузовиков.",
                            "target_lang_translations": {
                                "en": "The old road <w>got</w> completely <w>ruined</w> due to the constant heavy truck traffic.",
                                "es": "El camino viejo se <w>estropeó</w> por completo debido al tráfico constante de camiones pesados.",
                                "fr": "La vieille route <w>s'est</w> complètement <w>défoncée</w> à cause du passage continuel de poids lourds."
                            }
                        },
                        {
                            "text": "За несколько лет активной носки моя любимая обувь сильно <w>разбилась</w>.",
                            "target_lang_translations": {
                                "en": "After several years of active wear, my favorite shoes <w>became</w> badly <w>worn out</w>.",
                                "es": "Tras varios años de uso activo, mi calzado favorito se <w>arruinó</w> bastante.",
                                "fr": "Après quelques années d'usage intensif, mes chaussures préférées <w>se sont</w> beaucoup <w>déformées</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "используется в разговорной речи"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To become worn out, ruined, or damaged through prolonged or careless use",
                        "es": "Deteriorarse o quedar inservible por uso prolongado o descuidado.",
                        "fr": "Se détériorer ou s'abîmer en raison d'un usage prolongé ou négligent"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "become worn out",
                                "target_lang_sense_clarification": "for shoes or items from heavy wear"
                            },
                            {
                                "target_lang_word": "get ruined",
                                "target_lang_sense_clarification": "for roads or objects from heavy usage"
                            },
                            {
                                "target_lang_word": "break down",
                                "target_lang_sense_clarification": "deteriorate or lose shape"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "estropearse",
                                "target_lang_sense_clarification": "deteriorarse por el uso"
                            },
                            {
                                "target_lang_word": "arruinarse",
                                "target_lang_sense_clarification": "quedar en mal estado"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "s'abîmer",
                                "target_lang_sense_clarification": "par l'usage"
                            },
                            {
                                "target_lang_word": "se défoncer",
                                "target_lang_sense_clarification": "familier, pour une route ou un objet"
                            },
                            {
                                "target_lang_word": "se déformer",
                                "target_lang_sense_clarification": "pour des chaussures"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43ea4b01-68af-3196-8aab-0d9206d01b1e",
                    "sense_definition": "Страдательный залог к глаголу <w>разбить</w>",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "грамматическая_форма",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В ходе битвы вражеский лагерь должен был <w>разбиться</w> нашими войсками.",
                            "target_lang_translations": {
                                "en": "During the battle, the enemy camp was to <w>be defeated</w> by our troops.",
                                "es": "Durante la batalla, el campamento enemigo debía <w>ser destruido</w> por nuestras tropas.",
                                "fr": "Au cours de la bataille, le camp ennemi devait <w>être détruit</w> par nos troupes."
                            }
                        },
                        {
                            "text": "Сад обещал <w>разбиться</w> по заранее утвержденному проекту архитектора.",
                            "target_lang_translations": {
                                "en": "The garden promised to <w>be laid out</w> according to the architect's pre-approved project.",
                                "es": "El jardín prometía <w>ser diseñado</w> según el proyecto previamente aprobado del arquitecto.",
                                "fr": "Le jardin devait <w>être aménagé</w> selon le projet préalablement approuvé par l'architecte."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Passive voice of the verb 'разбить' (to defeat, to break, to lay out)",
                        "es": "Voz pasiva del verbo romper, destruir o plantar/diseñar.",
                        "fr": "Forme passive du verbe 'разбить' (être détruit, être aménagé, être vaincu)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be broken",
                                "target_lang_sense_clarification": "passive form of break"
                            },
                            {
                                "target_lang_word": "be defeated",
                                "target_lang_sense_clarification": "passive form of defeat (a camp/army)"
                            },
                            {
                                "target_lang_word": "be laid out",
                                "target_lang_sense_clarification": "passive form of set up/arrange (a garden/park)"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "ser destruido",
                                "target_lang_sense_clarification": "referido a un campamento o tropa"
                            },
                            {
                                "target_lang_word": "ser instalado",
                                "target_lang_sense_clarification": "referido a un jardín o parque"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "être détruit",
                                "target_lang_sense_clarification": "voix passive"
                            },
                            {
                                "target_lang_word": "être aménagé",
                                "target_lang_sense_clarification": "pour un parc, un jardin"
                            },
                            {
                                "target_lang_word": "être vaincu",
                                "target_lang_sense_clarification": "pour une armée"
                            }
                        ]
                    }
                }
            ]
        }
