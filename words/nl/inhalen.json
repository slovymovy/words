                            "target_lang_translations": {
                                "ru": "На этой узкой дороге опасно <w>обгонять</w> грузовик.",
                                "en": "On this narrow road it is dangerous to <w>overtake</w> a truck.",
                                "pl": "Na tej wąskiej drodze niebezpiecznie jest <w>wyprzedzać</w> ciężarówkę.",
                                "de": "Auf dieser schmalen Straße ist es gefährlich, einen Lastwagen <w>zu überholen</w>.",
                                "fr": "Sur cette route étroite, il est dangereux de <w>dépasser</w> un camion.",
                                "it": "Su questa strada stretta è pericoloso <w>sorpassare</w> un camion.",
                                "cs": "Na této úzké silnici je nebezpečné <w>předjíždět</w> nákladní auto.",
                                "tr": "Bu dar yolda bir kamyonu <w>sollamak</w> tehlikelidir.",
                                "es": "En esta carretera estrecha es peligroso <w>adelantar</w> a un camión.",
                                "zh": "在这条狭窄的路上<w>超</w>卡车很危险。"
                            }
                        },
                        {
                            "text": "De snelle auto wilde de fietser <w>inhalen</w>.",
                            "target_lang_translations": {
                                "ru": "Быстрая машина хотела <w>обогнать</w> велосипедиста.",
                                "en": "The fast car wanted to <w>pass</w> the cyclist.",
                                "pl": "Szybki samochód chciał <w>wyprzedzić</w> rowerzystę.",
                                "de": "Das schnelle Auto wollte den Radfahrer <w>überholen</w>.",
                                "fr": "La voiture rapide voulait <w>doubler</w> le cycliste.",
                                "it": "L'auto veloce voleva <w>superare</w> il ciclista.",
                                "cs": "Rychlé auto chtělo <w>předjet</w> cyklistu.",
                                "tr": "Hızlı araba bisikletliyi <w>geçmek</w> istedi.",
                                "es": "El coche rápido quería <w>adelantar</w> al ciclista.",
                                "zh": "那辆快车想要<w>超过</w>骑自行车的人。"
                            }
                        }
