                ],
                "senses": [
                    {
                        "sense_id": "a9f0bde2-610b-300b-ab74-cdfcc87d04fc",
                        "entry_id": "c9adbc1c-3ae5-3f5b-aa52-aa39173bd521",
                        "glosses": [
                            "alle Personen, die ein bestimmtes Gebiet bevölkern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa7af90a-364d-4a25-b7b4-274ffcf57cfb",
                                "sense_id": "a9f0bde2-610b-300b-ab74-cdfcc87d04fc",
                                "text": "„Der Anteil der Homosexuellen an der Gesamtbevölkerung ist vermutlich in allen Kulturen und Epochen gleich; sehr unterschiedlich ist dagegen die Beurteilung der Homosexualität in der Öffentlichkeit.“"
                            },
                            {
                                "example_id": "8666d3f3-297a-4ae0-9f65-0e7eff02b6f9",
                                "sense_id": "a9f0bde2-610b-300b-ab74-cdfcc87d04fc",
                                "text": "„Die meisten auf dem Arbeitsmarkt aktiven älteren Personen sind erwerbstätig: Die Erwerbstätigenquote als Anteil der Erwerbstätigen an der Gesamtbevölkerung in der Altersgruppe von 65 bis 74 Jahren betrug im Jahresdurchschnitt 2005 12,9%.“"
                            },
                            {
                                "example_id": "20f05a8c-2ff6-4ae9-8817-600edcfad74b",
                                "sense_id": "a9f0bde2-610b-300b-ab74-cdfcc87d04fc",
                                "text": "„Die Gruppierung nach dem Alter und dem Geschlecht […] zeigt, ob die Bevölkerung wächst, stagniert oder schrumpft, und sie gibt den Anteil der Geschlechter an der Gesamtbevölkerung an.“"
                            },
                            {
                                "example_id": "546d44d7-fab2-428c-bbda-478d7af617aa",
                                "sense_id": "a9f0bde2-610b-300b-ab74-cdfcc87d04fc",
                                "text": "„Die genauen Anteile religiöser und konfessioneller Minderheiten an der Gesamtbevölkerung lassen sich nur schwer bestimmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
