                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25e7d909-7730-4a3f-b264-2260c56eaf37",
                                                "sense_id": "ad146ccc-5d3c-3c09-87e0-5d5a3b917da6",
                                                "text": "Die Grenadiere treten um neun Uhr zum Dienst an."
                                            },
                                            {
                                                "example_id": "331cf7c4-be74-42c1-98c5-486e24bb7bd9",
                                                "sense_id": "ad146ccc-5d3c-3c09-87e0-5d5a3b917da6",
                                                "text": "„Der alte Grenadier lebte in einem Häuschen am Dorfrand, und der kurze Spaziergang zu ihm war Ausgangspunkt für allerlei Abenteuer.“"
                                            },
                                            {
                                                "example_id": "3cd6b0e5-2f95-4f42-a193-25c2c5ad0ebf",
                                                "sense_id": "ad146ccc-5d3c-3c09-87e0-5d5a3b917da6",
                                                "text": "„Südöstlich Magdeburg warfen Grenadiere die über die Elbe vorgedrungenen Amerikaner zurück.“"
                                            },
                                            {
                                                "example_id": "2d7f866e-5d4d-49b0-9bb4-593635448b48",
                                                "sense_id": "ad146ccc-5d3c-3c09-87e0-5d5a3b917da6",
                                                "text": "„Zuletzt wurden die Kutschpferde ausgespannt, von Grenadieren bestiegen und, wild hinten ausschlagend, ein paarmal geknipst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9b9ba548-7b29-313e-bdee-26e36d72605b",
                                        "entry_id": "c83bed82-1c89-37de-9e44-ffb33a061f1c",
                                        "glosses": [
                                            "unterster Dienstgrad in der Infanterietruppe"
                                        ],
                                        "tags": [
                                            "Germany",
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13245641-8e42-4dca-a948-f5df3aadbeeb",
                                                "sense_id": "9b9ba548-7b29-313e-bdee-26e36d72605b",
                                                "text": "Der niedrigste Dienstgrad in einem Wachbataillon ist der Grenadier."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
