                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mit viel Geduld <w>pickte</w> er die kleinen Steine einzeln aus dem Sand heraus."
                        },
                        {
                            "text": "Sie <w>pickt</w> sich stets die süßesten Beeren aus der großen Schale heraus."
