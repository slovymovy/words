                "translations": [
                    {
                        "translation_id": "8d75ebfe-60cd-4ebc-ba73-aa7df308985f",
                        "source_entry_id": "a9ece1a9-e85a-351e-a70d-5117d777defb",
                        "source_sense_id": "fa7c55bb-082c-3158-81cf-8f8adb235588",
