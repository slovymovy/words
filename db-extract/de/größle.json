                ],
                "senses": [
                    {
                        "sense_id": "074ac4b9-826f-36ea-b053-d9e8344febd3",
                        "entry_id": "f153612f-aff3-373e-8e4a-e0f01e8b317c",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53603c52-e55c-4a77-8293-b655f7be4d63",
                                "sense_id": "074ac4b9-826f-36ea-b053-d9e8344febd3",
                                "text": "Frau Größle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5e3511df-a4bf-42d6-8816-aaa048778caf",
                                "sense_id": "074ac4b9-826f-36ea-b053-d9e8344febd3",
                                "text": "Herr Größle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "da8776d1-da61-4a97-b965-f6897c56d96d",
                                "sense_id": "074ac4b9-826f-36ea-b053-d9e8344febd3",
                                "text": "Die Größles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "8b64f886-51b3-45a5-b126-d2bedf3b1191",
                                "sense_id": "074ac4b9-826f-36ea-b053-d9e8344febd3",
                                "text": "Der Größle trägt nie die Schals, die die Größle ihm strickt."
                            },
                            {
                                "example_id": "00cd86ce-3659-4908-bd73-0c079452b8d3",
                                "sense_id": "074ac4b9-826f-36ea-b053-d9e8344febd3",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Größle kommt, geht der Herr Größle.“"
                            },
                            {
                                "example_id": "acd717e2-396f-4ab1-9d7c-b06dd4a1cf7e",
                                "sense_id": "074ac4b9-826f-36ea-b053-d9e8344febd3",
                                "text": "Größle kommt und geht."
                            },
                            {
                                "example_id": "9278069e-e016-4e4f-a85f-8277307982b7",
                                "sense_id": "074ac4b9-826f-36ea-b053-d9e8344febd3",
                                "text": "Größles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
