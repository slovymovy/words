                                    },
                                    {
                                        "sense_id": "2c40502b-a713-321d-8ef9-fc0635470aec",
                                        "entry_id": "5c91ed81-9913-370c-89b6-ed28f0d20c0b",
                                        "glosses": [
                                            "Functioning without an external wired connection"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9008aaee-8fb0-4a78-a4b3-cb220acb74a0",
                                                "sense_id": "2c40502b-a713-321d-8ef9-fc0635470aec",
                                                "text": "wireless headphones"
                                            },
                                            {
                                                "example_id": "a1f27164-069c-404f-9db7-021fa9418f10",
                                                "sense_id": "2c40502b-a713-321d-8ef9-fc0635470aec",
                                                "text": "wireless charging"
                                            },
                                            {
                                                "example_id": "ce01dd2c-c8de-4ade-9359-700792e6db86",
                                                "sense_id": "2c40502b-a713-321d-8ef9-fc0635470aec",
                                                "text": "Ozma, observing this action in her Magic Picture, at once caught up a similar instrument from a table beside her and held it to her own ear. The two instruments recorded the same delicate vibrations of sound and formed a wireless telephone, an invention of the Wizard. Those separated by any distance were thus enabled to converse together with perfect ease."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wireless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d366a384-d67e-3f45-9377-3e50c7a7a848",
                                        "entry_id": "5b1234c5-d4f9-3122-878d-9439c99fc04e",
                                        "glosses": [
                                            "The medium of radio communication."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a17635e-0480-49d8-bb19-0e42d3a0ef9d",
                                                "sense_id": "d366a384-d67e-3f45-9377-3e50c7a7a848",
                                                "text": "Only about a hundred years ago, wireless was a new technology."
                                            },
                                            {
                                                "example_id": "70b958d1-191c-451f-bcc3-865113cc4be3",
                                                "sense_id": "d366a384-d67e-3f45-9377-3e50c7a7a848",
                                                "text": "It had been his intention to go to Wimbledon, but as he himself said: “Why be blooming well frizzled when you can hear all the results over the wireless. And results are all that concern me. […]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cce5012e-b7e8-35f0-9f58-a1c1ac500700",
                                        "entry_id": "5b1234c5-d4f9-3122-878d-9439c99fc04e",
                                        "glosses": [
                                            "Wireless connectivity to a computer network."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a478d299-c6f9-472a-b899-d50b6d12a021",
                                                "sense_id": "cce5012e-b7e8-35f0-9f58-a1c1ac500700",
                                                "text": "If your wireless stops working, try restarting the router."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dddf6caf-2c51-3fab-94c1-454c4ffa426d",
                                        "entry_id": "5b1234c5-d4f9-3122-878d-9439c99fc04e",
                                        "glosses": [
                                            "A radio set."
                                        ],
                                        "tags": [
                                            "British",
                                            "dated",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08b19da6-811b-465e-84ea-2c1c2afb342b",
                                                "sense_id": "dddf6caf-2c51-3fab-94c1-454c4ffa426d",
                                                "text": "Let's switch on the wireless and listen to the news."
                                            },
                                            {
                                                "example_id": "ce3d97be-6f5b-4d53-92fa-69e507ba59e3",
                                                "sense_id": "dddf6caf-2c51-3fab-94c1-454c4ffa426d",
                                                "text": "I heard you on my wireless back in '52"
                                            },
                                            {
                                                "example_id": "3659e294-a206-438f-af51-e1630294a85a",
                                                "sense_id": "dddf6caf-2c51-3fab-94c1-454c4ffa426d",
                                                "text": "In the corner of that dark back room stood a black and white television—their one nod to modernity—and beside it, two old wirelesses and a headset that had not seen action since the TV arrived."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wireless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "723308a7-0575-3042-be99-e1946289e6c2",
                                        "entry_id": "992ffa64-1c1a-3b4c-8409-d67970a832fa",
                                        "glosses": [
                                            "To send (a message) by wireless/radio."
                                        ],
                                        "tags": [
                                            "dated",
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e53be571-14b8-4f4c-860d-214fda5f7557",
                                                "sense_id": "723308a7-0575-3042-be99-e1946289e6c2",
                                                "text": "At 3:30 A.M. a huge Zeppelin flew across the British battle line, wirelessing down to any Germans still to the westward the best way to get home."
                                            },
                                            {
                                                "example_id": "ca380df0-d893-4d09-ac6c-a0332ab818be",
                                                "sense_id": "723308a7-0575-3042-be99-e1946289e6c2",
                                                "text": "Just outside Piraeus we circled low over a capsized fishing-boat, a grisly wreck in the crystal blue water, and wirelessed a description of it to the mainland."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52c72f34-789d-4292-a688-a7cef73b42b1",
                        "source_entry_id": "63ae1ffe-6091-3bda-ab6b-db5e5cf13423",
                        "target_lang_word": "drahtlos",
                        "target_lang_code": "de",
