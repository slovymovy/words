                                            {
                                                "example_id": "424d0a9e-c51c-408a-b7c7-c5537e0a980e",
                                                "sense_id": "bd805864-a4cf-34d1-aff2-426540a1fa26",
                                                "text": "Het is onweerlegbaar dat Nederland een rijk land is."
