    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "05d2e330-72f9-3c69-bf97-67edb489c052",
                "word": "meritocracy",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8c9e97ed-8140-4da1-8102-840ea7cf1d50",
                        "entry_id": "05d2e330-72f9-3c69-bf97-67edb489c052",
                        "tags": [
                            "plural"
                        ],
                        "form": "meritocracies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1fb376de-a837-349b-81e4-08f7c13cbfdc",
                        "entry_id": "05d2e330-72f9-3c69-bf97-67edb489c052",
                        "glosses": [
                            "Rule by merit and talent."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b02c92f8-d26a-4536-a603-541b198f8b0a",
                                "sense_id": "1fb376de-a837-349b-81e4-08f7c13cbfdc",
                                "text": "As a small nation without natural resources, Singapore relies on education and meritocracy to develop its economy."
                            },
                            {
                                "example_id": "dea2ba90-68c3-4e26-8f59-bbfc02f5c25c",
                                "sense_id": "1fb376de-a837-349b-81e4-08f7c13cbfdc",
                                "text": "In Markovits’s telling, the rise of the meritocracy is a story of unintended consequences."
                            },
                            {
                                "example_id": "1d54dd56-9398-42e9-87b2-8ce9fa6c0985",
                                "sense_id": "1fb376de-a837-349b-81e4-08f7c13cbfdc",
                                "text": "Its faculty has also been a factory of books taking differing positions on the merits and demerits of meritocracy and elite education."
                            }
                        ]
                    },
                    {
                        "sense_id": "cac7b321-80a8-3884-8a94-43e4c0804560",
                        "entry_id": "05d2e330-72f9-3c69-bf97-67edb489c052",
                        "glosses": [
                            "A type of society where wealth, income, and social status are assigned through competition."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90ab8f25-48c7-4bf3-b776-654d57d55d5f",
                        "source_entry_id": "05d2e330-72f9-3c69-bf97-67edb489c052",
                        "source_sense_description": "rule by merit",
                        "target_lang_word": "meritokracie",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "fee8113f-cf9c-4216-95b8-8af0351d24ed",
                        "source_entry_id": "05d2e330-72f9-3c69-bf97-67edb489c052",
                        "source_sense_description": "rule by merit",
                        "target_lang_word": "meritocratie",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meritocratie",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a33958b3-fe91-3ec0-a21f-973215d9b82c",
                                        "entry_id": "e9287d82-d38d-3e56-ae51-0053456f71ee",
                                        "glosses": [
                                            "systeem, waarin sociale status is gebaseerd op verdiensten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f71a138-a8a9-40a6-8f15-4a7d96b2f46d",
                                                "sense_id": "a33958b3-fe91-3ec0-a21f-973215d9b82c",
                                                "text": "“Dat komt in de Verenigde Staten door het geloof in meritocratie: dat je je plek in de samenleving hebt verdiend op basis van wat je hebt gedaan. 95 procent van de Amerikaanse samenleving gelooft daarin. Daarmee erodeert de solidariteit en zegeviert het individualisme. Maar meritocratie veronderstelt dat iedereen een gelijke startpositie heeft. Dat is allesbehalve zo.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47a3437b-6e87-41c9-80fa-08735613d671",
                        "source_entry_id": "05d2e330-72f9-3c69-bf97-67edb489c052",
                        "source_sense_description": "rule by merit",
                        "target_lang_word": "méritocratie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "méritocratie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "57c5ce90-237f-3806-8658-a4a5330b3406",
                                        "entry_id": "67a8b1ec-8f67-3208-a39a-dc1d3b00e63b",
                                        "glosses": [
                                            "Système politique, économique et social fondé sur le mérite (c’est-à-dire le talent et l’effort individuels) et non sur la reproduction sociale (système de classe), la richesse ou les relations individuelles (système de copinage)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52f16203-d81d-4f4e-b011-2ac6cf39c5f7",
                                                "sense_id": "57c5ce90-237f-3806-8658-a4a5330b3406",
                                                "text": "Cette frustration s'explique principalement par les inégalités des chances d'accès aux différentes professions pour les individus appartenant aux diverses classes, ou encore par une absence de méritocratie."
                                            },
                                            {
                                                "example_id": "32434591-61c8-4862-8b51-5bdc76a36880",
                                                "sense_id": "57c5ce90-237f-3806-8658-a4a5330b3406",
                                                "text": "Rachida Dati représenterait la version classique : une beurette travailleuse, ayant gravi une à une les marches de la méritocratie, essayant successivement la chaussure de vair de comptable, puis de magistrate et enfin de ministre."
                                            },
                                            {
                                                "example_id": "2d83d9f0-0da2-4bab-8ca2-2f2b5941f11b",
                                                "sense_id": "57c5ce90-237f-3806-8658-a4a5330b3406",
                                                "text": "La méritocratie est d’abord un schéma mental, qui sert l’idéologie néolibérale, en portant le soupçon et la honte sur la masse des perdants ; un mode de détermination d’« inégalités justes » qui justifie, en les essentialisant, les inégalités et les procédés de domination les plus intolérables."
                                            },
                                            {
                                                "example_id": "51d9b4f4-783d-4549-8bcd-7cdf2e2c4456",
                                                "sense_id": "57c5ce90-237f-3806-8658-a4a5330b3406",
                                                "text": "Trop occupés à exalter le parcours exceptionnel des quelques miraculés scolaires parvenus à intégrer ces filières d’élite, les discours officiels vantant les bienfaits de la méritocratie oublient ainsi systématiquement le sort de tous les autres élèves issus de milieux défavorisés, vaincus d’une compétition inégale et auxquels on signifie qu’ils ne peuvent s’en prendre qu’à eux-mêmes."
                                            },
                                            {
                                                "example_id": "c41e6a4b-1abc-47c4-b638-4a31bb1be1cb",
                                                "sense_id": "57c5ce90-237f-3806-8658-a4a5330b3406",
                                                "text": "Cette méritocratie est un phénomène mondial : les étudiants américains bachotent avec un sérieux presque inquiétant; les enfants japonais, comme leurs parents, s’angoissent dès le primaire; va-t-on bientôt avoir raté sa vie dès l’âge de sept ans ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "854aab96-d98a-4b84-a503-bcfa8ea7f504",
                        "source_entry_id": "05d2e330-72f9-3c69-bf97-67edb489c052",
                        "source_sense_description": "rule by merit",
                        "target_lang_word": "Meritokratie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Meritokratie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7cdbf69e-1c50-34eb-8c67-b7553e2585bb",
                                        "entry_id": "16972036-88cd-392e-a383-d4ef78536bfc",
                                        "glosses": [
                                            "Prinzip, dass Amtsträger/Herrscher/Leiter/Führungspersonen gemäß ihren erbrachten Leistungen ausgewählt werden, – als Regierungsform eines Staates oder in anderen politischen oder wirtschaftlichen Organisationen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a441ea18-cf1c-4b53-adee-1a586f2aa41b",
                                                "sense_id": "7cdbf69e-1c50-34eb-8c67-b7553e2585bb",
                                                "text": "„Während in der Aristokratie die gesellschaftliche Position historisch tradiert wird, soll der Status eines Menschen in der Meritokratie ausschließlich durch das gegenwärtige, individuell messbare Verdienst legitimiert sein. Eine Privilegierung auf Grund der Herkunft wie Klasse und sozialer Schicht soll hier ebenso vermieden werden wie eine Benachteiligung aufgrund der Zugehörigkeit zu einer Religion, einer Ethnie oder einem Geschlecht. Die „ideale Meritokratie“ erfordert somit völlige Gleichheit der Chancen, wie Unabhängigkeit der Leistung von Beziehungen, Herkunft etc., und gesellschaftlich wirksame Anerkennung faktischer Leistungsunterschiede.“"
                                            },
                                            {
                                                "example_id": "feb696ab-feb2-4b5f-a108-39ac43607b5e",
                                                "sense_id": "7cdbf69e-1c50-34eb-8c67-b7553e2585bb",
                                                "text": "„Neben diesen anarchischen Zügen sind in der Wikipedia auch Elemente der Meritokratie, Demokratie, Autokratie und Technokratie zu finden.“"
                                            },
                                            {
                                                "example_id": "a87a485c-6560-4223-9e9f-bdc4fe87cd9a",
                                                "sense_id": "7cdbf69e-1c50-34eb-8c67-b7553e2585bb",
                                                "text": "„Trotz des historischen Fortschritts, den die Meritokratie bedeutet, birgt sie auch Gefahren.“"
                                            },
                                            {
                                                "example_id": "f948bab5-acca-4de5-abed-34ecf27d9e03",
                                                "sense_id": "7cdbf69e-1c50-34eb-8c67-b7553e2585bb",
                                                "text": "„Trump ist der Prototyp dieser Abneigung gegen die Meritokratie und die Intelligenzia, die ein auf Leistung beruhendes System unvermeidlich hervorbringt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a0d0659-2fe1-4cd2-ab00-6cbf29868199",
                        "source_entry_id": "05d2e330-72f9-3c69-bf97-67edb489c052",
                        "source_sense_description": "rule by merit",
                        "target_lang_word": "Leistungsgesellschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leistungsgesellschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4d1f9238-ca7d-3c45-a889-676dc8d81fdf",
                                        "entry_id": "142ec467-3520-343f-8857-5fba03f678d2",
                                        "glosses": [
                                            "Gesellschaft, in der Verteilung des Einkommens wie des sozialen Ansehens und der Macht allein entsprechend der Leistung erfolgt, die der Einzelne erreicht"
                                        ],
                                        "tags": [
                                            "Soziologie",
                                            "als Modellvorstellung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba090b41-9d32-4ca7-b963-22f86b85852e",
                                                "sense_id": "4d1f9238-ca7d-3c45-a889-676dc8d81fdf",
                                                "text": "In Leistungsgesellschaften werden humanitäre Werte kaum gefördert, wenn sie keine Leistung erbringen."
                                            },
                                            {
                                                "example_id": "e8c36df6-36cb-4c48-9600-cec02f881da4",
                                                "sense_id": "4d1f9238-ca7d-3c45-a889-676dc8d81fdf",
                                                "text": "„In diesem Sinne wetterten die Obrigkeit und die intellektuelle Elite unaufhörlich gegen Liberalismus, Kapitalismus, Industrialisierung sowie die Konkurrenz- und Leistungsgesellschaft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3d36350e-32ab-3aa3-97ab-aa4c0afaaef0",
                                        "entry_id": "142ec467-3520-343f-8857-5fba03f678d2",
                                        "glosses": [
                                            "eine Gesellschaft, die in (zu) hohem Maße Leistungsfähigkeit und -bereitschaft vom Einzelnen fordert, wobei weniger oder nur durchschnittlich leistungsstarke Menschen kaum soziale Anerkennung erhalten"
                                        ],
                                        "tags": [
                                            "als Kritik an der modernen westlichen Gesellschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9004145d-8fca-4d4c-94db-0dbc3d0de292",
                                                "sense_id": "3d36350e-32ab-3aa3-97ab-aa4c0afaaef0",
                                                "text": "Die Leistungsgesellschaft bereitet vielen Schülern heute Stress – ist es da verwunderlich, dass sich die Ellenbogenmentalität immer mehr ausbreitet?"
                                            },
                                            {
                                                "example_id": "36864bed-0f73-4d82-9fba-007d9a07fe97",
                                                "sense_id": "3d36350e-32ab-3aa3-97ab-aa4c0afaaef0",
                                                "text": "„In der modernen Leistungsgesellschaft, glaubt Han, handle jeder wie sein eigener Unternehmer und sei damit Unterdrücker und Unterdrückter zugleich.“"
                                            },
                                            {
                                                "example_id": "6b7517ba-e6b2-45db-848d-883ce508a664",
                                                "sense_id": "3d36350e-32ab-3aa3-97ab-aa4c0afaaef0",
                                                "text": "„Immerhin lebten sie jetzt in einer Leistungsgesellschaft, die von jedem Bürger vollen Einsatz in angepasster Sklavenarbeit erwartete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
