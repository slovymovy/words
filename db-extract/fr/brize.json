                                        "examples": [
                                            {
                                                "example_id": "d2e1abe3-8541-40c9-9981-443f4bae60a6",
                                                "sense_id": "b3909617-518e-3266-ab4b-80caa33a0050",
                                                "text": "Zittergras wird gerne in Blumensträußen verwendet."
                                            },
                                            {
                                                "example_id": "3fbfda89-d05e-44c0-bc89-ea626c3d6f7b",
                                                "sense_id": "b3909617-518e-3266-ab4b-80caa33a0050",
                                                "text": "„Um die Bilderchen und ihre Goldborte herum hingen zwei dicke Immortellenkränze mit schwarzen und weißen Schleifen daran, während auf dem kleinen, niedrigen Ofen eine Vase mit Zittergras stand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "385d461a-9222-31d4-ae9b-2a53bd235d6a",
                                        "entry_id": "e8ac7dee-28ab-3e5d-928d-b6a39b21a5ba",
                                        "glosses": [
                                            "speziell das heimische gewöhnliche Zittergras (Briza media)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f6fed68-6d3d-4c06-b831-5a07da9bdffd",
                                                "sense_id": "385d461a-9222-31d4-ae9b-2a53bd235d6a",
                                                "text": "Das Zittergras ist heute recht selten geworden."
                                            }
