                    },
                    {
                        "translation_id": "2894ab17-6e94-4cd1-b9c1-93a44297e84b",
                        "source_entry_id": "6e40cfb6-5777-3272-9729-d760008e86e0",
                        "source_sense_id": "1972d30d-d436-3e2c-9bf3-8ad590187a21",
                        "source_sense_description": "soms, geregeld, van tijd tot tijd",
                        "target_lang_word": "on occasion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "on occasion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27a483ec-45a0-32a7-aabe-b91617a6be87",
                                        "entry_id": "a3d52a30-3a57-3ec5-a377-0981a3e612af",
                                        "glosses": [
                                            "Occasionally, from time to time, now and then."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06fcc3e5-06c7-4991-8417-1cbe17231fd5",
                                                "sense_id": "27a483ec-45a0-32a7-aabe-b91617a6be87",
                                                "text": "Only on rare occasion."
                                            },
                                            {
                                                "example_id": "769139a2-5c71-433d-b920-bc1fc9901f9d",
                                                "sense_id": "27a483ec-45a0-32a7-aabe-b91617a6be87",
                                                "text": "It is not in itself surprising that a genuine advance of knowledge should in this manner become on occasion a source of new error."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47ce3ebc-a9f9-440e-82c2-2a8cdc59d3f1",
                        "source_entry_id": "6e40cfb6-5777-3272-9729-d760008e86e0",
                        "source_sense_id": "1972d30d-d436-3e2c-9bf3-8ad590187a21",
                        "source_sense_description": "soms, geregeld, van tijd tot tijd",
                        "target_lang_word": "parfois",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parfois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "787db53d-2124-31d7-8a9e-d9b9e4494f61",
                                        "entry_id": "41dffee8-437e-34ff-ad5d-84cef587bbe6",
                                        "glosses": [
                                            "Quelquefois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce081a8c-286e-4270-83d3-b7f029e8e1b1",
                                                "sense_id": "787db53d-2124-31d7-8a9e-d9b9e4494f61",
                                                "text": "Le père Cotton craignait si peu que ses pénitentes le quittassent, qu’au contraire il leur conseillait d’aller parfois aux autres confesseurs : […]."
                                            },
                                            {
                                                "example_id": "4ef2ee3f-fde7-4796-a1ce-b4a736fe910a",
                                                "sense_id": "787db53d-2124-31d7-8a9e-d9b9e4494f61",
                                                "text": "Cependant, au milieu de la chaussée, des nègres se poursuivaient à coup de boules de neige et parfois, une de ces boules, manquant son but, s’écrasait contre une devanture ; […]."
                                            },
                                            {
                                                "example_id": "b2db85de-7479-4225-93cb-22067e2785ae",
                                                "sense_id": "787db53d-2124-31d7-8a9e-d9b9e4494f61",
                                                "text": "La masse des véhicules s’avançait dans un grondement […], puis s’arrêtait, bloquée parfois pendant trois heures."
                                            },
                                            {
                                                "example_id": "5944037f-7ca8-4524-b30b-a6df107b8daa",
                                                "sense_id": "787db53d-2124-31d7-8a9e-d9b9e4494f61",
                                                "text": "Ce n'était pas la première fois que des boîtes de singe entraient dans la maison ; parfois des soldats nous en donnaient, mais jamais nous n’en avions rapporté autant."
                                            },
                                            {
                                                "example_id": "888e0b6c-f0b3-4cbd-84bf-92fe41361b15",
                                                "sense_id": "787db53d-2124-31d7-8a9e-d9b9e4494f61",
                                                "text": "[…], et je me rendis compte que même à Göttingen il pleuvait parfois, les gens pouvaient être maussades, […]."
                                            },
                                            {
                                                "example_id": "2b5829e1-297e-471c-aebc-40ea7d62e048",
                                                "sense_id": "787db53d-2124-31d7-8a9e-d9b9e4494f61",
                                                "text": "Parfois voulues, parfois subies, les migrations introduisent un mode d’organisation réticulaire dans le pavage territorial, d’autant qu’on constate que leur fonctionnement est de plus en plus de type diasporique."
                                            },
                                            {
                                                "example_id": "e82a3c43-c0dc-4408-9e06-fe1da33def02",
                                                "sense_id": "787db53d-2124-31d7-8a9e-d9b9e4494f61",
                                                "text": "Les cinquante titres récupèrent et déroutent, avec un zeste d’ironie et, parfois, avec un léger effet captieux, le lexique sur la pandémie de COVID-19, le vocabulaire et les syntagmes titrés dans les journaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
