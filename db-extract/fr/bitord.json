                        "glosses": [
                            "Petit cordage composé de deux, trois, ou même quatre fils de caret, goudronnés et tortillés ensemble."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6181a346-f27e-4b5c-a49a-adb015815195",
                                "sense_id": "849aec53-e9bc-3abc-9b08-b07ac983279a",
                                "text": "M. Monnard, le second, un carnet à la main, pointait les glènes de filin, le bitord, tout le matériel que déversaient les camions des shipchandlers."
                            },
                            {
                                "example_id": "0b00a210-6ee2-449b-8da1-acd24dc43d33",
                                "sense_id": "849aec53-e9bc-3abc-9b08-b07ac983279a",
                                "text": "Il portait une grosse chemise bleue à moitié usée qu’il attachait ordinairement autour de ses reins avec un bout de bitord."
                            }
                        ]
                    },
