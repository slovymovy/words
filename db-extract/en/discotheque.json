                                                "example_id": "30ee91ca-6f32-4507-bfe4-9486d1d99a24",
                                                "sense_id": "f67d9e13-0a6c-3cc2-bc14-3ad93e16e059",
                                                "text": "Zullen we naar de discotheek gaan om te dansen?"
                                            }
                                        ]
