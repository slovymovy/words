                "translations": [
                    {
                        "translation_id": "c0b2a9aa-7bd9-4a97-8012-b6e3b79f8f31",
                        "source_entry_id": "d1e80c49-4b10-33c9-bf94-731e4b770097",
                        "source_sense_id": "a64702c6-0c14-38d7-8af2-eca5896f216e",
                        "target_lang_word": "regularity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "regularity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5750acf4-10c8-3b1b-a9df-deb141a54e55",
                                        "entry_id": "2fed6c0c-8ac3-311f-b796-f76bd8389e35",
                                        "glosses": [
                                            "The condition or quality of being regular"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e09ed9b-688e-45ad-a664-a9ebfe6801ef",
                                                "sense_id": "5750acf4-10c8-3b1b-a9df-deb141a54e55",
                                                "text": "I have been watching that show with regularity."
                                            },
                                            {
                                                "example_id": "8ac15d33-546d-421b-8cb1-8f245ad38e2e",
                                                "sense_id": "5750acf4-10c8-3b1b-a9df-deb141a54e55",
                                                "text": "For Chelsea coach Andre Villas-Boas, this was his most sobering moment in the Premier League and he looked stunned on the sidelines at the regularity with which Chelsea's defence was exposed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49a239ea-8aaf-36af-88ba-5687d09f059a",
                                        "entry_id": "2fed6c0c-8ac3-311f-b796-f76bd8389e35",
                                        "glosses": [
                                            "A particular regular occurrence"
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8af56bf0-36c0-41a2-8cfc-6886760163d3",
                        "source_entry_id": "d1e80c49-4b10-33c9-bf94-731e4b770097",
                        "source_sense_id": "a64702c6-0c14-38d7-8af2-eca5896f216e",
                        "target_lang_word": "regularidad",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "90d93c57-deab-42d3-86cc-21e5bbab423a",
                        "source_entry_id": "d1e80c49-4b10-33c9-bf94-731e4b770097",
                        "source_sense_id": "a64702c6-0c14-38d7-8af2-eca5896f216e",
                        "target_lang_word": "Regularität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Regularität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8728aea1-909b-32a7-96f9-879df17d8fb7",
                                        "entry_id": "04989f00-a8b2-3fa0-8ea7-109b7d803c46",
                                        "glosses": [
                                            "Eigenschaft, nach Gesetzen/Vereinbarungen (regulär) abzulaufen"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e745aef-fb3a-4fe9-80cf-2d3b1db87af0",
                                                "sense_id": "8728aea1-909b-32a7-96f9-879df17d8fb7",
                                                "text": "„Regularität des Handelns bedeutet, dass Akteure in vergleichbaren Situationen aufgrund ähnlicher Wahrnehmungsweisen und geteilter Einschätzungen dazu tendieren werden, auf gleiche Weise zu handeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0d65777a-835c-357a-89a1-0334bff84bf9",
                                        "entry_id": "04989f00-a8b2-3fa0-8ea7-109b7d803c46",
                                        "glosses": [
                                            "Eigenschaft einer sprachlichen Erscheinung, der Norm/Üblichkeit zu entsprechen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f584fa74-966e-48d9-bf77-0ce5ee2c1504",
                                                "sense_id": "0d65777a-835c-357a-89a1-0334bff84bf9",
                                                "text": "„Diese drei Merkmale, die Regularität der Verwendung, das gemeinsame Wissen der Sprecher über die Regularität und das Wissen über den normativen Charakter der Regularität machen nach gängiger Auffassung eine Konvention aus.“"
                                            },
                                            {
                                                "example_id": "826f19a6-3260-4b34-b704-730ce33b1c3e",
                                                "sense_id": "0d65777a-835c-357a-89a1-0334bff84bf9",
                                                "text": "„Die Regularitäten des Schriftsystems, verstanden als grammatische Regularitäten im Sinne von Artikel 117, lassen sich übersichtlich ordnen in wortbezogene einerseits und satzbezogene andererseits.“"
                                            },
                                            {
                                                "example_id": "d9e47d49-981d-493f-9cf4-2bdf28097099",
                                                "sense_id": "0d65777a-835c-357a-89a1-0334bff84bf9",
                                                "text": "„Schon beim Spracherwerb zeigen sich ja Regularitäten, und zwar gerade in den vielen Fehlern, die Kinder machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ed41f800-c894-3996-b7dc-d3ae2b2c4d07",
                                        "entry_id": "04989f00-a8b2-3fa0-8ea7-109b7d803c46",
                                        "glosses": [
                                            "Eigenschaft, (im jeweiligen Sinnzusammenhang) regulär zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94542cc3-a51b-4911-8d8d-fb75dda135fa",
                                                "sense_id": "ed41f800-c894-3996-b7dc-d3ae2b2c4d07",
                                                "text": "„In Räumen mit abzählbarer Basis fällt die vollständige Regularität mit der Regularität zusammen […]. “"
                                            },
                                            {
                                                "example_id": "f9fcd924-294f-4486-b133-e282850d742f",
                                                "sense_id": "ed41f800-c894-3996-b7dc-d3ae2b2c4d07",
                                                "text": "„Somit stimmt die Singularität (bzw. Regularität) eines Operators mit der Singularität (bzw. Regularität) der ihm bei gegebener Basis entsprechenden Matrix überein.“"
                                            },
                                            {
                                                "example_id": "b4d74d69-c3df-4e36-bb54-e9ea1a1566d7",
                                                "sense_id": "ed41f800-c894-3996-b7dc-d3ae2b2c4d07",
                                                "text": "„Man unterscheidet zwischen der Regularität von innen und der Regularität von außen eines Maßes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04492e2f-f271-464c-8f60-ff872c679e88",
                        "source_entry_id": "d1e80c49-4b10-33c9-bf94-731e4b770097",
                        "source_sense_id": "a64702c6-0c14-38d7-8af2-eca5896f216e",
                        "target_lang_word": "régularité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "régularité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1b1841fb-9a24-366c-aab7-22ffa3a7a8d9",
                                        "entry_id": "6469ae88-451f-3f57-80e7-c6ee171f8696",
                                        "glosses": [
                                            "Conformité à un ordre, à des règles, soit naturelles, soit de convention ; constance ; uniformité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "feb3e95a-0b9d-4626-a88b-3c360f87ce60",
                                                "sense_id": "1b1841fb-9a24-366c-aab7-22ffa3a7a8d9",
                                                "text": "La nourriture incrassante qu’elles recevaient de la main de leur maître, en les faisant passer peu à peu à l’état de poulardes, nuisait à la régularité de leur pondaison."
                                            },
                                            {
                                                "example_id": "09bc0616-f87a-4b54-aaad-f7a3d76b98aa",
                                                "sense_id": "1b1841fb-9a24-366c-aab7-22ffa3a7a8d9",
                                                "text": "Comme tous les édifices de cette époque, le château des comtes de Montgommery ne présentait aucune régularité. Les pères l’avaient légué à leurs fils, et chaque propriétaire avait, selon son caprice ou son besoin, ajouté quelque chose au géant de pierre."
                                            },
                                            {
                                                "example_id": "d650c4dc-17bb-4a13-9e1c-bd83119c6a70",
                                                "sense_id": "1b1841fb-9a24-366c-aab7-22ffa3a7a8d9",
                                                "text": "La régularité de ses mœurs, de sa conduite lui a mérité l’estime publique."
                                            },
                                            {
                                                "example_id": "4869a8cc-47ee-4fda-bb95-05a6c9b097b7",
                                                "sense_id": "1b1841fb-9a24-366c-aab7-22ffa3a7a8d9",
                                                "text": "Sa régularité dans son travail est parfaite, est exemplaire."
                                            },
                                            {
                                                "example_id": "ff5d0a44-20f1-432c-b951-8e1d7db21b8d",
                                                "sense_id": "1b1841fb-9a24-366c-aab7-22ffa3a7a8d9",
                                                "text": "Cet ouvrage de tapisserie, de broderie est d’une grande régularité, d’une régularité parfaite."
                                            },
                                            {
                                                "example_id": "40125173-5f38-4712-944d-8c736c0638fc",
                                                "sense_id": "1b1841fb-9a24-366c-aab7-22ffa3a7a8d9",
                                                "text": "La régularité des traits d’un visage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "304aaa57-99fb-3801-8e9e-08771fd79cdb",
                                        "entry_id": "6469ae88-451f-3f57-80e7-c6ee171f8696",
                                        "glosses": [
                                            "Égalité de tous les côtés et de tous les angles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f80bd4a-b4c5-44ff-9717-5bb580026069",
                                                "sense_id": "304aaa57-99fb-3801-8e9e-08771fd79cdb",
                                                "text": "Régularité dans une figure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e32c08e1-5962-302d-9368-c1ba103c5495",
                                        "entry_id": "6469ae88-451f-3f57-80e7-c6ee171f8696",
                                        "glosses": [
                                            "Exacte observation des règles de chaque ordre, en parlant des ordres religieux,."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7acf6ed2-5e09-49dd-bdcf-7b3f04a6b7fc",
                                                "sense_id": "e32c08e1-5962-302d-9368-c1ba103c5495",
                                                "text": "Les religieux de cette maison vivent dans une grande régularité."
                                            },
                                            {
