                        "glosses": [
                            "Qui peut ou qui doit être consolidé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36386982-c21e-4c22-99ae-22b332cfa186",
                                "sense_id": "8875a0a0-6bfc-3dfa-9eac-eeddd286f7bf",
                                "text": "Quant à moi, je retiendrai de toutes mes forces l’Assemblée, la nation, la société sur le sol précaire, mais perfectibile et consolidable, de la Constitution républicaine."
                            },
                            {
                                "example_id": "2f7f6c4c-b120-4dd0-9f79-ad02e16c81c5",
                                "sense_id": "8875a0a0-6bfc-3dfa-9eac-eeddd286f7bf",
                                "text": "Grande fatigue, difficultés pour se déplacer, perte d’équilibre : pour l’avocate de la partie civile, la victime « ne sera pas consolidée et pas consolidable avant sa majorité »."
                            },
                            {
                                "example_id": "18b26c25-29f4-4f82-a75e-81e06be1aa23",
                                "sense_id": "8875a0a0-6bfc-3dfa-9eac-eeddd286f7bf",
                                "text": "Rappelons que les prêts spéciaux à moyen terme fonctionnent au taux d'escompte de la Banque de France, majoré de 1,55 % pour les opérations non consolidables et de 2,15 % pour les opérations consolidables (1,65 + 0,50 de commission de consolidation)."
                            }
                        ]
                    }
