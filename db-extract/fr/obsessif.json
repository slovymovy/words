                ],
                "senses": [
                    {
                        "sense_id": "61d84b64-98c7-3108-a3b8-8c2bba5e3feb",
                        "entry_id": "cf97062b-2d60-3288-871e-a65cdf3ac549",
                        "glosses": [
                            "Qui obsède."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44b5d35c-80ea-4840-b637-28d86e6141a9",
                                "sense_id": "61d84b64-98c7-3108-a3b8-8c2bba5e3feb",
                                "text": "Alors que les œuvres des maîtres anciens qui appliquaient avec une méticulosité obsessive leurs techniques artisanales résistaient au passage des siècles en conservant plus de dignité et de beauté."
                            },
                            {
                                "example_id": "576089d4-ebb7-4233-a143-70a72294480a",
                                "sense_id": "61d84b64-98c7-3108-a3b8-8c2bba5e3feb",
                                "text": "La plupart des sites d’extrême droite sur l’ensemble du continent européen, quasiment sans exception, et parfois même les sites simplement laïcistes issus de la gauche comme Riposte laïque en France, ne soulèvent qu’une seule question dans leurs colonnes, n’ont qu’une obsessive préoccupation, celle de l’occupation musulmane du territoire."
                            },
                            {
                                "example_id": "3ed2c68d-e9ce-4a97-8ea6-96c120c7e930",
                                "sense_id": "61d84b64-98c7-3108-a3b8-8c2bba5e3feb",
                                "text": "J’ai tout appris des réécritures obsessives de Madame Bovary par Flaubert..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc0813ba-db44-4616-90b8-516a5f87ca8a",
                        "source_entry_id": "cf97062b-2d60-3288-871e-a65cdf3ac549",
                        "source_sense_id": "61d84b64-98c7-3108-a3b8-8c2bba5e3feb",
                        "target_lang_word": "obsessive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obsessive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df9898d7-a56d-3898-89bd-a55ce568e7f3",
                                        "entry_id": "21f6248c-cb2c-3969-b886-0eb20d7cbdad",
                                        "glosses": [
                                            "Prone to cause obsession."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4990114e-52b8-444e-a94e-3f943b0be27d",
                                                "sense_id": "df9898d7-a56d-3898-89bd-a55ce568e7f3",
                                                "text": "The idea is too tempting, it's obsessive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "115bd23b-3ed4-30c7-a5e6-4c5d27a193c6",
                                        "entry_id": "21f6248c-cb2c-3969-b886-0eb20d7cbdad",
                                        "glosses": [
                                            "Having one thought or pursuing one activity to the absolute or nearly absolute exclusion of all others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d5f9c49-83e1-4174-aaf8-79943fee2e6a",
                                                "sense_id": "115bd23b-3ed4-30c7-a5e6-4c5d27a193c6",
                                                "text": "Hardcore fans' obsessive behavior may take over their lives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aacea472-0466-3be3-b717-92eb16cbb49a",
                                        "entry_id": "21f6248c-cb2c-3969-b886-0eb20d7cbdad",
                                        "glosses": [
                                            "Excessive, as results from obsession."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92523e4e-64aa-4aff-ad64-4763bc14de86",
                                                "sense_id": "aacea472-0466-3be3-b717-92eb16cbb49a",
                                                "text": "A workaholic's obsessive zeal may lead to success or burnout."
                                            },
                                            {
                                                "example_id": "c12d23b6-b1b4-4f79-8e95-393db9fba7d0",
                                                "sense_id": "aacea472-0466-3be3-b717-92eb16cbb49a",
                                                "text": "Yes, there were instances of grandstanding and obsessive behaviour, but many were concealed at the time to help protect an aggressively peddled narrative of [Oscar] Pistorius the paragon, the emblem, the trailblazer."
                                            }
                                        ]
                                    }
                                ]
                            },
