{
    "word_family": [
        "thematic",
        "thematically",
        "thematize",
        "thematization"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "36eb722f-a94e-320f-a515-9574d8bed5aa",
                    "sense_definition": "The main subject or topic of a talk, piece of writing, or artistic work.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "topic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The central <w>theme</w> of the novel is the struggle between good and evil.",
                            "target_lang_translations": {
                                "ru": "Центральная <w>тема</w> романа — борьба добра со злом."
                            }
                        },
                        {
                            "text": "The speaker chose a very interesting <w>theme</w> for her presentation today.",
                            "target_lang_translations": {
                                "ru": "Докладчик выбрала очень интересную <w>тему</w> для своей сегодняшней презентации."
                            }
                        }
                    ],
                    "common_phrases": [
                        "central theme",
                        "recurring theme",
                        "main theme"
                    ],
                    "target_lang_definitions": {
                        "ru": "Основной предмет или вопрос обсуждения, литературного произведения или произведения искусства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тема",
                                "target_lang_sense_clarification": "предмет обсуждения или произведения"
                            },
                            {
                                "target_lang_word": "предмет",
                                "target_lang_sense_clarification": "то, о чем идет речь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1dc88bf5-788b-37bd-8e9a-0bbe95235458",
                    "sense_definition": "A recurring idea or motif in a creative work.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "topic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Loss of innocence is a <w>theme</w> that appears in many of his poems.",
                            "target_lang_translations": {
                                "ru": "Утрата невинности — это <w>тема</w>, которая встречается во многих его стихотворениях."
                            }
                        },
                        {
                            "text": "The artist explores the <w>theme</w> of isolation through her use of dark colors.",
                            "target_lang_translations": {
                                "ru": "Художница исследует <w>тему</w> изоляции, используя темные цвета."
                            }
                        }
                    ],
                    "common_phrases": [
                        "common theme",
                        "underlying theme"
                    ],
                    "target_lang_definitions": {
                        "ru": "Повторяющаяся идея или мотив в творческой работе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тема",
                                "target_lang_sense_clarification": "сквозная идея"
                            },
                            {
                                "target_lang_word": "мотив",
                                "target_lang_sense_clarification": "повторяющийся элемент"
                            },
                            {
                                "target_lang_word": "лейтмотив",
                                "target_lang_sense_clarification": "главная повторяющаяся мысль"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab312dc7-2b3e-3488-bf4f-7ec36a365acb",
                    "sense_definition": "The main melody of a piece of music, often used as a basis for variations.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The composer introduces the musical <w>theme</w> softly before the full orchestra joins in.",
                            "target_lang_translations": {
                                "ru": "Композитор мягко вводит музыкальную <w>тему</w>, прежде чем вступает весь оркестр."
                            }
                        },
                        {
                            "text": "The second movement features several variations on the original <w>theme</w>.",
                            "target_lang_translations": {
                                "ru": "Во второй части представлено несколько вариаций на оригинальную <w>тему</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "musical theme",
                        "opening theme"
                    ],
                    "target_lang_definitions": {
                        "ru": "Основная мелодия музыкального произведения, часто служащая основой для вариаций."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тема",
                                "target_lang_sense_clarification": "музыкальная мелодия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dbde700e-9f65-3303-abd9-0ff9de2de9d2",
                    "sense_definition": "A specific setting for a computer interface that changes its visual appearance, such as colors and icons.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I prefer to use a dark <w>theme</w> on my phone to save battery life.",
                            "target_lang_translations": {
                                "ru": "Я предпочитаю использовать темную <w>тему</w> на телефоне, чтобы экономить заряд батареи."
                            }
                        },
                        {
                            "text": "You can download a new <w>theme</w> to change how your desktop looks.",
                            "target_lang_translations": {
                                "ru": "Вы можете скачать новую <w>тему</w>, чтобы изменить внешний вид рабочего стола."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dark theme",
                        "default theme",
                        "custom theme"
                    ],
                    "target_lang_definitions": {
                        "ru": "Специфический набор настроек компьютерного интерфейса, меняющий его внешний вид (цвета, иконки)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тема",
                                "target_lang_sense_clarification": "оформление интерфейса"
                            },
                            {
                                "target_lang_word": "тема оформления",
                                "target_lang_sense_clarification": "визуальный стиль"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9a14a42-f3c5-3300-a94b-d3f1fb044b51",
                    "sense_definition": "A short piece of music that identifies a specific film, television program, or character.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Everyone recognizes the iconic <w>theme</w> from the Star Wars movies.",
                            "target_lang_translations": {
                                "ru": "Все узнают культовую <w>тему</w> из фильмов «Звездные войны»."
                            }
                        },
                        {
                            "text": "The show's catchy <w>theme</w> song always gets stuck in my head.",
                            "target_lang_translations": {
                                "ru": "Запоминающаяся заглавная <w>песня</w> шоу всегда застревает у меня в голове."
                            }
                        }
                    ],
                    "common_phrases": [
                        "theme song",
                        "theme music"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткая музыкальная заставка, идентифицирующая фильм, телепередачу или персонажа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "музыкальная заставка",
                                "target_lang_sense_clarification": "мелодия из титров"
                            },
                            {
                                "target_lang_word": "главная тема",
                                "target_lang_sense_clarification": "основная мелодия фильма"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "468866d4-e93b-35bb-a6f7-2d0c2cbbb8b1",
                    "sense_definition": "A short essay or piece of writing assigned to a student.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher asked us to write a <w>theme</w> about our summer vacation.",
                            "target_lang_translations": {
                                "ru": "Учитель попросил нас написать <w>сочинение</w> о летних каникулах."
                            }
                        },
                        {
                            "text": "He spent all evening working on his weekly <w>theme</w> for English class.",
                            "target_lang_translations": {
                                "ru": "Он весь вечер работал над своим еженедельным <w>сочинением</w> для урока английского."
                            }
                        }
                    ],
                    "common_phrases": [
                        "write a theme"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often used in older educational contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Краткое эссе или письменная работа, заданная ученику."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сочинение",
                                "target_lang_sense_clarification": "школьная письменная работа"
                            },
                            {
                                "target_lang_word": "тема",
                                "target_lang_sense_clarification": "учебное эссе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "162c1a25-70e6-3d1b-b9d5-0be52fd45dd2",
                    "sense_definition": "The <w>stem</w> of a word to which inflections are added.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In linguistics, the <w>theme</w> is the part of the word that remains after removing endings.",
                            "target_lang_translations": {
                                "ru": "В лингвистике <w>основа</w> — это часть слова, которая остается после отсечения окончаний."
                            }
                        },
                        {
                            "text": "The Greek <w>theme</w> of this word provides the basis for its various forms.",
                            "target_lang_translations": {
                                "ru": "Греческая <w>основа</w> этого слова служит базой для его различных форм."
                            }
                        }
                    ],
                    "common_phrases": [
                        "word theme"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in linguistics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Основа слова, к которой добавляются словоизменительные морфемы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "основа",
                                "target_lang_sense_clarification": "лингвистический термин"
                            },
                            {
                                "target_lang_word": "тема",
                                "target_lang_sense_clarification": "часть слова без окончаний"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac857062-435a-351e-ab93-a6892506e644",
                    "sense_definition": "An administrative division or province of the Byzantine Empire.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "history",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Byzantine <w>theme</w> system was essential for the empire's military defense.",
                            "target_lang_translations": {
                                "ru": "Византийская система <w>фем</w> имела важное значение для военной обороны империи."
                            }
                        },
                        {
                            "text": "Each <w>theme</w> was governed by a military commander known as a strategos.",
                            "target_lang_translations": {
                                "ru": "Каждой <w>фемой</w> управлял военачальник, известный как стратег."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Byzantine theme"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "historical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Административно-территориальная единица (провинция) в Византийской империи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фема",
                                "target_lang_sense_clarification": "исторический термин"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "484c38c2-8ef9-31e2-9eba-ac88651afee2",
                    "sense_definition": "To design or organize something around a particular subject or motif.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "design",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>theme</w> the restaurant like an old Italian village.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>стилизовать</w> ресторан под старую итальянскую деревню."
                            }
                        },
                        {
                            "text": "The organizers will <w>theme</w> the party around a 1920s jazz club.",
                            "target_lang_translations": {
                                "ru": "Организаторы <w>посвятят</w> вечеринку джаз-клубу 1920-х годов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "theme a party",
                        "theme a room"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оформлять или организовывать что-либо в соответствии с определенной темой или мотивом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стилизовать",
                                "target_lang_sense_clarification": "оформлять в определенном стиле"
                            },
                            {
                                "target_lang_word": "посвящать",
                                "target_lang_sense_clarification": "делать темой чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4820297-aed5-3b4b-a748-37d6b9cca90f",
                    "sense_definition": "To apply a specific visual style or layout to software or a website.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is easy to <w>theme</w> your blog using one of the available templates.",
                            "target_lang_translations": {
                                "ru": "Легко <w>оформить</w> свой блог, используя один из доступных шаблонов."
                            }
                        },
                        {
                            "text": "The developer spent hours trying to <w>theme</w> the application for better accessibility.",
                            "target_lang_translations": {
                                "ru": "Разработчик потратил часы, пытаясь <w>настроить оформление</w> приложения для лучшей доступности."
                            }
                        }
                    ],
                    "common_phrases": [
                        "theme an app"
                    ],
                    "target_lang_definitions": {
                        "ru": "Применять определенный визуальный стиль или макет к программному обеспечению или веб-сайту."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "менять тему",
                                "target_lang_sense_clarification": "настраивать внешний вид"
                            },
                            {
                                "target_lang_word": "оформлять",
                                "target_lang_sense_clarification": "применять визуальный стиль"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}