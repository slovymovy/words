                    }
                ],
                "translations": [
                    {
                        "translation_id": "99456e90-2b12-4291-845b-822a4c9bffb0",
                        "source_entry_id": "68ebb8b1-e3a3-319a-9a53-b3c66116dc36",
                        "source_sense_id": "37c15c7e-f63e-3b71-bde4-d3ff46a834ac",
                        "source_sense_description": "Unternehmen mit unwahrscheinlicher Rückkehr der Einsatzkräfte",
                        "target_lang_word": "suicide mission",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suicide mission",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4bac4dd8-11e6-3f01-ab8d-c16301c8e23b",
                                        "entry_id": "8fc0c541-26e4-31ae-9302-ba5ed723d7c6",
                                        "glosses": [
                                            "A task which is so dangerous for the people involved that they are not expected to survive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b146b2ea-8567-4304-88f2-663e20270cef",
                                                "sense_id": "4bac4dd8-11e6-3f01-ab8d-c16301c8e23b",
                                                "text": "He said savagely, \"We're apt to catch it anyway—here. You're immune, you don't care, you're safe! The rest of us are on a suicide mission—and damn it, when I die I want to take a few of those monkeys with me!\""
                                            },
                                            {
                                                "example_id": "a94ddff4-1b92-41c8-96b3-3eac9dc6a874",
                                                "sense_id": "4bac4dd8-11e6-3f01-ab8d-c16301c8e23b",
                                                "text": "The soldiers, from a unit north of Baghdad, told family members that they considered the convoy destined for Taji to be a \"suicide mission\", citing the poor condition of their vehicles and the absence of ground and air support to protect the convoy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
