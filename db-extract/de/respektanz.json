                ],
                "senses": [
                    {
                        "sense_id": "f6eff812-7e17-3972-9830-1ad296fad3d9",
                        "entry_id": "4d40ccc4-5f03-3096-a250-9cf96eb7ab88",
                        "glosses": [
                            "Bereitschaft, etwas zu respektieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d69dcc5e-cdbe-4629-b18f-4928bc923e37",
                                "sense_id": "f6eff812-7e17-3972-9830-1ad296fad3d9",
                                "text": "„Eine Freundschaft lebt von gegenseitiger Respektanz und gegenseitigem Verstehen, auch in schwierigen Situationen.“"
                            },
                            {
                                "example_id": "c6af87c1-05de-45f3-8577-82a8dc77ae30",
                                "sense_id": "f6eff812-7e17-3972-9830-1ad296fad3d9",
                                "text": "„Der Weg der Publikation der katholischen Landschulordnung, in der die gegenseitige Akzeptanz und Respektanz zwischen katholischem Domkapitel und protestantischem Landesherrn eine neue Dimension gewann, ist auch das Ergebnis einer zaghaften Durchsetzung der Aufklärungsidee im Hochstift Osnabrück.“"
                            },
                            {
                                "example_id": "51933097-b784-464c-9a4f-a79dec11e767",
                                "sense_id": "f6eff812-7e17-3972-9830-1ad296fad3d9",
                                "text": "„Denn der Sachsenspiegel war nicht nur in einem bestimmten Gebiet geltendes territoriales Recht, sondern trug gleichzeitig mit der Respektanz anderer Rechtsordnungen personale Züge.“"
                            },
                            {
                                "example_id": "4143d308-fe16-41b9-9342-44f277adbc74",
                                "sense_id": "f6eff812-7e17-3972-9830-1ad296fad3d9",
                                "text": "„Andererseits ergeben sich in der Mittel- und beginnenden Spät-Latènezeit gerade aus der territorialen Respektanz durch Anrainerkulturen wie der Jastorf-Kultur in Pommern, der Przeworsk-Kultur in Schlesien sowie der keltischen Besiedlung in Kleinpolen Möglichkeiten für einen zeitlichen und in Zukunft auch für einen ethnischen Ansatz.“"
                            },
                            {
                                "example_id": "bf290eeb-9dcb-40e9-8fce-16f08897c783",
                                "sense_id": "f6eff812-7e17-3972-9830-1ad296fad3d9",
                                "text": "„In ihrem unermüdlichen Kampf um künstlerische Gleichberechtigung als Frau, in ihrem unermüdlichen Bemühen um Respektanz ihres eigenen Kunstschaffens und das ihrer z. T. weitaus berühmteren Kollegen hat sich Ida Gerhardi über die Kunst hinaus auch als Mensch einen wichtigen Platz im Kunstspektrum ihrer Zeit erarbeitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
