                ],
                "senses": [
                    {
                        "sense_id": "ece1fdd3-f93a-3d44-85d7-613ddb7aa049",
                        "entry_id": "4955f8f2-16aa-3452-bb0e-4bee13e0f173",
                        "glosses": [
                            "Celle qui fournit des informations, en particulier à la police."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "600e5733-2aa6-49d6-b4ff-8e2248813cf0",
                                "sense_id": "ece1fdd3-f93a-3d44-85d7-613ddb7aa049",
                                "text": "Ce que j'ai pas bien saisi, c’était si la fameuse Natacha était une informatrice ou un suspect."
                            },
                            {
                                "example_id": "4c74bb2b-0650-44e2-b6a2-000748832b0a",
                                "sense_id": "ece1fdd3-f93a-3d44-85d7-613ddb7aa049",
                                "text": "Les paroles crépitent du rouge-baiser sensuel et altruiste de l’informatrice."
                            }
                        ]
                    },
                    {
                        "sense_id": "f0a40e7a-c41c-3e9f-a558-55ca7c87ae07",
                        "entry_id": "4955f8f2-16aa-3452-bb0e-4bee13e0f173",
                        "glosses": [
                            "Celle qui est chargée d’identifier les défis de l’État et d'explorer les possibilités et conditions nécessaires à la formation du gouvernement fédéral."
                        ],
                        "tags": [
                            "Belgique"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2309fd70-82e0-4aec-84e8-088b609372f5",
                        "source_entry_id": "4955f8f2-16aa-3452-bb0e-4bee13e0f173",
                        "target_lang_word": "informant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "informant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f53a4079-f77d-3968-a911-4cae86da6366",
                                        "entry_id": "302dbfda-44d1-3020-9119-1ea7a9976fdf",
                                        "glosses": [
                                            "One who relays confidential information to someone, especially to the police; an informer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75ca2561-e6b4-4787-9d46-70fdace24098",
                                                "sense_id": "f53a4079-f77d-3968-a911-4cae86da6366",
                                                "text": "One of her chief informants is Alicent’s handmaiden Talya (Alexis Rabin), whose inside info runs so deep that she’s the first to catch wind of Viserys’ death."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66fba02d-e116-338f-b37f-091fc7cd30e0",
                                        "entry_id": "302dbfda-44d1-3020-9119-1ea7a9976fdf",
                                        "glosses": [
                                            "A native speaker who acts as a linguistic reference for a language being studied. The informant demonstrates native pronunciation, provides grammaticality judgments regarding linguistic well-formedness, and may also explain cultural references and other important contextual information."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "095f57e2-e6f4-46f8-bb56-fe70f763e126",
                                                "sense_id": "66fba02d-e116-338f-b37f-091fc7cd30e0",
                                                "text": "The only material the linguist has to begin with are the informant's grammatical utterances in the target language pronounced arbitrarily in a natural or assigned communicative situation or stimulated artificially by the investigator."
                                            },
                                            {
                                                "example_id": "6ec84dbd-cfb8-4378-9861-33c6b34c7a33",
                                                "sense_id": "66fba02d-e116-338f-b37f-091fc7cd30e0",
                                                "text": "The informant learns his language by formal training and, more importantly, by constant exposure to its use. He cannot repeat to the linguist what he has never seen or heard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5cea5f30-21f7-4d05-adec-5ca6e1ed3115",
                        "source_entry_id": "4955f8f2-16aa-3452-bb0e-4bee13e0f173",
                        "target_lang_word": "informer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "informer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db181c0a-4d11-304b-be3b-1388f4ded503",
                                        "entry_id": "47767531-84b8-38a7-b2f6-5474a77e223a",
                                        "glosses": [
                                            "One who informs someone else about something."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ec8dec7-697c-3c14-a315-a951ced95397",
                                        "entry_id": "47767531-84b8-38a7-b2f6-5474a77e223a",
                                        "glosses": [
                                            "A person who tells authorities about improper or illegal activity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b071e531-d399-4de0-af29-be4d470bb1cb",
                                                "sense_id": "6ec8dec7-697c-3c14-a315-a951ced95397",
                                                "text": "Being an informer often meant living in fear."
                                            },
                                            {
                                                "example_id": "67ec682d-553b-418f-b414-451e5adb63dc",
                                                "sense_id": "6ec8dec7-697c-3c14-a315-a951ced95397",
                                                "text": "The police relied on an informer to catch the gang."
                                            },
                                            {
                                                "example_id": "ae006e29-ea6f-4b46-a3e6-cf9d40bff675",
                                                "sense_id": "6ec8dec7-697c-3c14-a315-a951ced95397",
                                                "text": "He acted as an informer during the rebellion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "471ae915-8014-367b-977b-394d8f856bae",
                                        "entry_id": "47767531-84b8-38a7-b2f6-5474a77e223a",
                                        "glosses": [
                                            "One who informs, animates, or inspires."
                                        ],
