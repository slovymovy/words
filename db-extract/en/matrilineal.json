                "senses": [
                    {
                        "sense_id": "02fc4e76-a553-37da-bb1c-08248a4f9142",
                        "entry_id": "23d79cc3-2e2b-3b2f-8148-b82e2f046ab1",
                        "glosses": [
                            "Tracing descent only through female ancestors."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "6367ee96-968a-44e7-98da-67c297e7193d",
                                "sense_id": "02fc4e76-a553-37da-bb1c-08248a4f9142",
                                "text": "Kerala traditionally has matrilineal inheritance."
                            },
                            {
                                "example_id": "eb16429e-525f-4ca3-a22e-1b09bd2ed688",
                                "sense_id": "02fc4e76-a553-37da-bb1c-08248a4f9142",
                                "text": "Enkidu expresses the values of nature, matrilineal conservatism, and the populism of the assembly, the assembly of village elders from the days before military dictatorship."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ae23867-b69e-40e5-b65f-363bfef91561",
                        "source_entry_id": "23d79cc3-2e2b-3b2f-8148-b82e2f046ab1",
                        "source_sense_id": "02fc4e76-a553-37da-bb1c-08248a4f9142",
                        "source_sense_description": "Tracing descent only through female ancestors",
                        "target_lang_word": "matrilinéaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "matrilinéaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d680c18-6065-3aa5-ab25-deef5229014f",
                                        "entry_id": "a2aac12e-ddf7-3714-b9bc-547c72e95530",
                                        "glosses": [
                                            "Relatif au système de filiation dans lequel chacun relève du lignage de sa mère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab90c725-8aa9-4d0f-a0bb-cd3ca8c51b6a",
                                                "sense_id": "9d680c18-6065-3aa5-ab25-deef5229014f",
                                                "text": "De plus, les règles de résidence se combinent avec des règles de filiation (matrilinéaire, patrilinéaire, bilinéaire ou indifférenciée), fort importantes pour les modalités de contrôle et de transmission des biens […]."
                                            },
                                            {
                                                "example_id": "a4735b5d-33ef-4b65-b235-798851a8bc45",
                                                "sense_id": "9d680c18-6065-3aa5-ab25-deef5229014f",
                                                "text": "L’aigle et le corbeau, deux espèces très présentes dans tout l’archipel, divisent la société matrilinéaire exogamique en deux moitiés, subdivisées en une vingtaine de lignages chacune."
                                            },
                                            {
                                                "example_id": "b6167df0-2078-4117-a903-767b51b6d333",
                                                "sense_id": "9d680c18-6065-3aa5-ab25-deef5229014f",
                                                "text": "L’Empire tirait sa prospérité de ses richesses aurifères, de sa maîtrise du travail du fer, de son organisation politique structurée (avec ministres, gouverneurs, et armée hiérarchisée) et d’un système de succession matrilinéaire particulièrement avancé pour son époque."
                                            }
                                        ]
                                    }
                                ]
                            }
