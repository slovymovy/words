                                    {
                                        "sense_id": "a0a7af7f-4bdc-3510-a8ba-de2155a50957",
                                        "entry_id": "5701aac3-6aff-3dbe-bdf8-44df86e1d6d7",
                                        "glosses": [
                                            "de al dan niet vastgelegde manier waarop de woorden van een taal geschreven worden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "903a598b-5279-4d7d-a131-88fb7da2086c",
                                                "sense_id": "a0a7af7f-4bdc-3510-a8ba-de2155a50957",
                                                "text": "Het Nederlands heeft, in tegenstelling tot het Engels, een officieel vastgelegde spelling."
                                            },
                                            {
                                                "example_id": "4258173e-b6a8-4590-9620-6b550e64f9bb",
                                                "sense_id": "a0a7af7f-4bdc-3510-a8ba-de2155a50957",
                                                "text": "Dank aan de auteurs en uitgevers die overname toestonden (zie voor bijzonderheden 'Bronnen' aan het einde van het boek). De oorspronkelijke spelling hiervan is zoveel mogelijk gehandhaafd. Van enkele stukken bleken, tot onze spijt, auteur en uitgever niet te achterhalen."
                                            },
                                            {
                                                "example_id": "3bb37c56-6dd8-4b61-9163-8ccff5332959",
                                                "sense_id": "a0a7af7f-4bdc-3510-a8ba-de2155a50957",
                                                "text": "Mijn spelling was op z’n zachtst gezegd interessant omdat ik in Engeland op school heb gezeten en nooit foutloos Nederlands heb leren schrijven."
                                            }
                                        ]
