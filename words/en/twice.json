            "senses": [
                {
                    "sense_id": "9d26237e-f102-3731-a282-5c49643b5ff1",
                    "sense_definition": "Two times; on two separate occasions.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "frequency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should brush your teeth <w>twice</w> a day for good hygiene.",
                            "target_lang_translations": {
                                "ru": "Тебе следует чистить зубы <w>дважды</w> в день для соблюдения гигиены.",
                                "tr": "İyi bir hijyen için dişlerinizi günde <w>iki kez</w> fırçalamalısınız.",
                                "zh": "为了保持卫生，你应该每天刷牙<w>两次</w>。"
                            }
                        },
                        {
                            "text": "He checked the list <w>twice</w> to make sure he did not miss anything.",
                            "target_lang_translations": {
                                "ru": "Он проверил список <w>дважды</w>, чтобы убедиться, что ничего не пропустил.",
                                "tr": "Hiçbir şeyi kaçırmadığından emin olmak için listeyi <w>iki defa</w> kontrol etti.",
                                "zh": "他把清单检查了<w>两遍</w>，以确保没有遗漏任何东西。"
                            }
                        }
                    ],
                    "synonyms": [
                        "two times"
                    ],
                    "antonyms": [
                        "once"
                    ],
                    "common_phrases": [
                        "twice a day",
                        "twice a week",
                        "think twice",
                        "check twice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Два раза; в двух отдельных случаях.",
                        "tr": "İki kez; iki ayrı durumda.",
                        "zh": "两次；在两个不同的场合。"
                    },
                    "translations": {
