                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a71d3154-d43c-425d-89e8-074aee348c09",
                                                "sense_id": "6d9d3709-45e3-3f86-9253-82466236d4cb",
                                                "text": "The three occupation powers had complete discretion over dismantlings, however."
                                            }
                                        ]
