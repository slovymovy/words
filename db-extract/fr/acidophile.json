                "senses": [
                    {
                        "sense_id": "c95ba21b-b909-3d54-bda9-40ed6cfdff71",
                        "entry_id": "886bec2c-9a33-33ed-9c6c-c61b3968115b",
                        "glosses": [
                            "Leucocyte qui prend les colorants acides (→ voir granulocyte acidophile)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "442b1435-0494-43be-8f8a-dbf298212dca",
                                "sense_id": "c95ba21b-b909-3d54-bda9-40ed6cfdff71",
                                "text": "Il n'y a pas de cellules typiquement basophiles, mais des chromophobes et des acidophiles."
                            }
                        ]
                    },
                    {
                        "sense_id": "50ab4f1f-8dbf-387a-b5e7-acf8b2e4d35d",
                        "entry_id": "886bec2c-9a33-33ed-9c6c-c61b3968115b",
                        "glosses": [
                            "Microorganisme vivant dans des milieux acides."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dd273da-8991-4a81-993f-f1228af645f2",
                                "sense_id": "50ab4f1f-8dbf-387a-b5e7-acf8b2e4d35d",
                                "text": "Cet hyperthermophile est aussi un acidophile vivant dans des gammes de pH allant de 0,9 à 5,8 pour un optimum à 2-3."
                            },
                            {
                                "example_id": "1c6e533c-2a8e-4590-98f1-30e87d34ac64",
                                "sense_id": "50ab4f1f-8dbf-387a-b5e7-acf8b2e4d35d",
                                "text": "Deux catégories d’organismes acidophiles peuvent être distinguées (Johnson 1998, 2007): les acidotolérants (plus rarement nommés acidophiles modérés) et les acidophiles obligatoires."
                            }
                        ]
                    }
