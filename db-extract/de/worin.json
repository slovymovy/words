                "senses": [
                    {
                        "sense_id": "f304f23d-e67b-3f7a-9483-27b1d5163f16",
                        "entry_id": "4040621c-00fc-3503-b551-ee47e14ea937",
                        "glosses": [
                            "in welcher Sache"
                        ],
                        "tags": [
                            "interrogativ"
                        ],
                        "examples": [
                            {
                                "example_id": "c0c1db1a-9f99-49cc-a4e6-5029a9d44d94",
                                "sense_id": "f304f23d-e67b-3f7a-9483-27b1d5163f16",
                                "text": "Worin hast du gebadet? In Stutenmilch?"
                            },
                            {
                                "example_id": "af74a632-8f5d-4b46-8ae1-4fc79a38fa30",
                                "sense_id": "f304f23d-e67b-3f7a-9483-27b1d5163f16",
                                "text": "Worin unterscheiden sich Apfel und Birne genau?"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9ca8aa9c-9587-37ee-acd7-55efd999e327",
                        "entry_id": "4040621c-00fc-3503-b551-ee47e14ea937",
                        "glosses": [
                            "in welcher genannten Sache"
                        ],
                        "tags": [
                            "relativ"
                        ],
                        "examples": [
                            {
                                "example_id": "1df9486d-8de6-4510-a8ba-2769ed063397",
                                "sense_id": "9ca8aa9c-9587-37ee-acd7-55efd999e327",
                                "text": "Das Haus, worin Goethe damals gewohnt haben soll, ist mittlerweile abgerissen worden."
                            },
                            {
                                "example_id": "70582d41-1cf7-464c-b566-fbe5fae0457a",
                                "sense_id": "9ca8aa9c-9587-37ee-acd7-55efd999e327",
                                "text": "„Aber kann man wirklich nicht erklären, worin sich beispielsweise ein gesetzlicher Mindestlohn (Opposition) von einem Branchenmindestlohn (Regierung) unterscheidet?“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2faa5d63-f64a-4f8b-a63e-676c8718c81e",
