                    "target_lang_definitions": {
                        "en": "To form or express an opinion about a person or thing.",
                        "ru": "Составлять мнение о ком-либо или о чём-либо и высказывать его.",
                        "nl": "Een mening vormen over iemand of iets en die uitspreken.",
                        "de": "Eine Meinung über jemanden oder etwas bilden und äußern.",
                        "pl": "Wyrabiać sobie zdanie o kimś lub o czymś albo je wyrażać.",
                        "it": "Formarsi o esprimere un'opinione su qualcuno o qualcosa.",
                        "cs": "Vytvořit si nebo vyjádřit názor na někoho nebo na něco.",
                        "tr": "Birine veya bir şeye dair bir fikir oluşturmak ya da bu fikri dile getirmek.",
                        "es": "Formarse o expresar una opinión sobre alguien o algo.",
                        "zh": "对某人或某事形成或表达看法。"
                    },
