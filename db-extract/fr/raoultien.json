                        "glosses": [
                            "Partisan de Didier Raoult."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "429ebed9-682b-400f-b4f1-656aacf822d8",
                                "sense_id": "a84a0603-0f0f-398a-83a1-bc9b1414e798",
                                "text": "Depuis une semaine, je suis comme tous les Français. Je ne suis plus ni de droite, ni de gauche, je suis raoultien."
                            },
                            {
                                "example_id": "fec170fa-8ab2-46f8-a74c-2bfbb6a39f5f",
                                "sense_id": "a84a0603-0f0f-398a-83a1-bc9b1414e798",
                                "text": "« Amusant » votre démarche. Vous glanez absolument ts ls élément qui pourraient conforter votre thèse. Seriez-vous un raoultien caché ?"
                            }
                        ]
                    }
