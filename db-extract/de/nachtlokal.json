                "senses": [
                    {
                        "sense_id": "c7b2ef80-06a9-352a-a099-387503a0d863",
                        "entry_id": "225ce208-711e-3213-884b-1b7d9d1e6312",
                        "glosses": [
                            "Lokal, das vorwiegend nachts geöffnet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0190655-85b0-4d6b-8545-a6b0f4328a34",
                                "sense_id": "c7b2ef80-06a9-352a-a099-387503a0d863",
                                "text": "Wir gehen gerne in Nachtlokale."
                            },
                            {
                                "example_id": "99add8ba-5408-4f8d-a653-c9c28eb0fed8",
                                "sense_id": "c7b2ef80-06a9-352a-a099-387503a0d863",
                                "text": "„Wir suchten und fanden ein Nachtlokal in St. Georg - dessen aufgerüschte Mädchen lenkten uns nicht allzu sehr ab.“"
                            },
                            {
                                "example_id": "dc032e90-a549-4536-be72-c24771c6deb7",
                                "sense_id": "c7b2ef80-06a9-352a-a099-387503a0d863",
                                "text": "„Paris ist vom frischen Duft der Bäume erfüllt, als wir von einem Nachtlokal in das nächste fahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e80d8a5-1c94-4b4f-9ee8-860d00905ed9",
                        "source_entry_id": "225ce208-711e-3213-884b-1b7d9d1e6312",
                        "source_sense_id": "c7b2ef80-06a9-352a-a099-387503a0d863",
                        "source_sense_description": "Lokal, das vorwiegend nachts geöffnet ist",
                        "target_lang_word": "nightclub",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nightclub",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a60eb88-ecf5-38bc-9594-50b5b795adc6",
                                        "entry_id": "012498d6-f343-3fa7-9eb0-952d53653db4",
                                        "glosses": [
                                            "A public or private establishment that is open late at night to provide entertainment, food, drink, music or dancing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11f1813d-9323-4202-9b02-e3ea64de17b0",
                                                "sense_id": "5a60eb88-ecf5-38bc-9594-50b5b795adc6",
                                                "text": "They respond instantly to the faintest rustling in the covert of a sheaf of Ulysses S. Grants, or the homely, rustic tinkle of a wheelbarrow full of rubies being jounced along over a nightclub floor."
                                            },
                                            {
                                                "example_id": "2cee2c5e-dbfa-4544-89e9-295f5fe4667e",
                                                "sense_id": "5a60eb88-ecf5-38bc-9594-50b5b795adc6",
                                                "text": "EARLY this summer, Joshua J. Pelton decided that he was meant to live in Orlando, Fla. So he quit his sales job in Detroit, packed his car with all the belongings that fit, put the rest in storage, and drove southeast daydreaming about sundrenched winters and packed nightclubs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5d1364a-ab77-3e23-85b7-7512e40b5e2c",
                                        "entry_id": "012498d6-f343-3fa7-9eb0-952d53653db4",
                                        "glosses": [
                                            "A strip club."
                                        ],
                                        "tags": [
                                            "Philippines"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "nightclub",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc5dc0ca-8b80-31c7-837c-698a62b76e07",
                                        "entry_id": "c19aa120-9587-30f5-8793-f5b56429b656",
                                        "glosses": [
                                            "To visit a nightclub (or nightclubs) for entertainment."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad5fc043-5f75-4397-8c05-7641c44888ca",
                                                "sense_id": "fc5dc0ca-8b80-31c7-837c-698a62b76e07",
                                                "text": "Our first night in the big city we went out nightclubbing. The next morning we stayed in hung over."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
