                "senses": [
                    {
                        "sense_id": "989895b5-357b-3c64-93bd-4cbef49ac8dd",
                        "entry_id": "2cf9a4d1-bc70-350f-a69b-26822bc72e92",
                        "glosses": [
                            "Cyclomoteur très simple de la marque du même nom, caractérisé par le fait que le moteur est accroché au guidon et que l’entraînement est effectué directement par la friction d’un galet sur la roue avant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88523255-b6c6-4a5c-b989-f4942458a2f8",
                                "sense_id": "989895b5-357b-3c64-93bd-4cbef49ac8dd",
                                "text": "Cher payé pour ranger un Solex, mais le gardien, un maigrichon aux ongles noirs avec une cravate de singe, avait fixé le tarif."
                            },
                            {
                                "example_id": "0962cd48-680b-4440-8f06-2a78632d397b",
                                "sense_id": "989895b5-357b-3c64-93bd-4cbef49ac8dd",
                                "text": "Les Solex, ces années-là, proliféraient sur les parkings des lycées, côtoyant quelques solides Motobécanes qui, elles, se multipliaient dans les campagnes. On repérait les campagnards à ça. Le Solex, c'était fait exprès pour les citadins, le fils de paysan, lui, optait pour du robuste, en prévision de l’état des routes en hiver."
                            },
                            {
                                "example_id": "2ed7fc90-6804-4e67-8b8c-aa850242e88c",
                                "sense_id": "989895b5-357b-3c64-93bd-4cbef49ac8dd",
                                "text": "Noil dit avoir déjà reçu une centaine de commandes pour « rétrofiter » des Solex, et 75 autres pour des Peugeot 103."
                            }
                        ]
                    }
