                "senses": [
                    {
                        "sense_id": "4acae481-a1f6-3e87-8308-a550a0f33401",
                        "entry_id": "f6bfd1f2-c462-3e64-b0a6-27ab78e47f8c",
                        "glosses": [
                            "aus Sandstein bestehendes Gebäude"
