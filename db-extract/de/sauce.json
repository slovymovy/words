                    {
                        "form_id": "e23def20-798c-49cb-9850-b28a0f8a74b2",
                        "entry_id": "f09268f9-05aa-391b-bc78-b64b841c27d4",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Saucen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "afd56c47-46a7-3b0e-816b-59f2266ac178",
                        "entry_id": "f09268f9-05aa-391b-bc78-b64b841c27d4",
                        "glosses": [
                            "fachsprachlich: alternative Schreibweise von Soße^([1]) beziehungsweise Soß; in Österreich nicht fachsprachliche Hauptschreibweise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1563c4fc-8df1-4bf1-81db-4f47e0200b1c",
                                "sense_id": "afd56c47-46a7-3b0e-816b-59f2266ac178",
                                "text": "Die Sauce schmeckt sehr gut."
                            },
                            {
                                "example_id": "a2a3ade8-069a-4df0-9bb1-b674382f8afe",
                                "sense_id": "afd56c47-46a7-3b0e-816b-59f2266ac178",
                                "text": "„An der Sauce erkennt man den guten Koch, weswegen in vielen Restaurants der Chef persönlich dafür verantwortlich ist.“"
                            },
                            {
                                "example_id": "407bb4ea-5b95-4af5-a7ab-6833c795faa7",
                                "sense_id": "afd56c47-46a7-3b0e-816b-59f2266ac178",
                                "text": "„Wenn Saucen mit proteinreichen Stoffen wie Eigelb oder Blut gebunden werden, darf nicht zu heiß gearbeitet werden.“"
                            },
                            {
                                "example_id": "351b03bd-6e09-45d9-8aeb-47b8c4e5ac72",
                                "sense_id": "afd56c47-46a7-3b0e-816b-59f2266ac178",
                                "text": "„Alle sahen ihm zu, wie er die Sauce bereitete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
