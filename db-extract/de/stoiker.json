                    {
                        "sense_id": "adf93451-6367-33d7-95e4-e36596e9d975",
                        "entry_id": "51d3f1e7-a6f2-392b-ba70-0a2fffbb538e",
                        "glosses": [
                            "ein Vertreter des Stoizismus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "557db30f-7cad-4497-9b64-014ec092f8f6",
                                "sense_id": "adf93451-6367-33d7-95e4-e36596e9d975",
                                "text": "Stoiker wie Zenon und Kleanthes nahmen an, man könne durch naturgemäßes Leben die Glückseligkeit erreichen."
                            },
                            {
                                "example_id": "360be87f-0c59-45a3-b49b-2e41fcd3bf2e",
                                "sense_id": "adf93451-6367-33d7-95e4-e36596e9d975",
                                "text": "„Die Gesetzeswerke der verschiedenen Staaten galten den Stoikern als unvollständige Nachahmungen eines Rechtes, das in der Natur selber begründet liegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
