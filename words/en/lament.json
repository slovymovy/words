{
    "word_family": [
        "lamentation",
        "lamentable",
        "lamentably",
        "lamenter"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0320b4f2-e1ad-3837-8093-7f73d67f83ba",
                    "sense_definition": "To express great sorrow, regret, or disappointment about something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "expression of grief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many local residents will <w>lament</w> the loss of the historic cinema once it is demolished.",
                            "target_lang_translations": {
                                "ru": "Многие местные жители будут <w>оплакивать</w> утрату исторического кинотеатра после того, как его снесут.",
                                "es": "Muchos residentes locales <w>lamentarán</w> la pérdida del cine histórico una vez que sea demolido."
                            }
                        },
                        {
                            "text": "The coach <w>lamented</w> the lack of focus shown by the team during the final minutes of the game.",
                            "target_lang_translations": {
                                "ru": "Тренер <w>сетовал</w> на отсутствие концентрации у команды в последние минуты игры.",
                                "es": "El entrenador <w>lamentó</w> la falta de concentración mostrada por el equipo durante los minutos finales del partido."
                            }
                        }
                    ],
                    "synonyms": [
                        "bemoan",
                        "bewail",
                        "deplore",
                        "regret"
                    ],
                    "common_phrases": [
                        "lament the loss",
                        "lament the passing",
                        "lament the fact"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражать глубокое сожаление, разочарование или недовольство по какому-либо поводу.",
                        "es": "Expresar gran pesar, arrepentimiento o decepción por algo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "се́товать",
                                "target_lang_sense_clarification": "жаловаться на что-либо"
                            },
                            {
                                "target_lang_word": "сокруша́ться",
                                "target_lang_sense_clarification": "сильно огорчаться"
                            },
                            {
                                "target_lang_word": "опла́кивать",
                                "target_lang_sense_clarification": "сожалеть об утрате"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "lamentar",
                                "target_lang_sense_clarification": "sentir pesar o decepción por un hecho"
                            },
                            {
                                "target_lang_word": "lamentarse",
                                "target_lang_sense_clarification": "quejarse de una situación desfavorable"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97da2a4f-74cd-3625-acbe-f88d34c8e773",
                    "sense_definition": "To mourn aloud or express deep grief through weeping or wailing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "expression of grief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd began to <w>lament</w> loudly as the funeral procession passed through the village square.",
                            "target_lang_translations": {
                                "ru": "Толпа начала громко <w>стенать</w>, когда похоронная процессия проходила через деревенскую площадь.",
                                "es": "La multitud comenzó a <w>lamentarse</w> a gritos mientras el cortejo fúnebre pasaba por la plaza del pueblo."
                            }
                        },
                        {
                            "text": "In the ancient poem, the people <w>lament</w> for their fallen hero with songs of sorrow.",
                            "target_lang_translations": {
                                "ru": "В древней поэме народ <w>оплакивает</w> своего павшего героя песнями скорби.",
                                "es": "En el poema antiguo, el pueblo <w>llora</w> a su héroe caído con cantos de dolor."
                            }
                        }
                    ],
                    "synonyms": [
                        "mourn",
                        "wail",
                        "grieve",
                        "keen"
                    ],
                    "antonyms": [
                        "cheer up",
                        "gladden"
                    ],
                    "common_phrases": [
                        "weep and lament",
                        "lament for the dead"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in literary or formal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Громко оплакивать или выражать глубокое горе через плач и стенания.",
                        "es": "Guardar luto en voz alta o manifestar profundo dolor mediante llanto o gemidos."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стена́ть",
                                "target_lang_sense_clarification": "жалобно стонать или плакать"
                            },
                            {
                                "target_lang_word": "опла́кивать",
                                "target_lang_sense_clarification": "выражать скорбь по покойному"
                            },
                            {
                                "target_lang_word": "причита́ть",
                                "target_lang_sense_clarification": "сопровождать плач жалобами"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "lamentar",
                                "target_lang_sense_clarification": "llorar o manifestar aflicción por una pérdida"
                            },
                            {
                                "target_lang_word": "gemir",
                                "target_lang_sense_clarification": "emitir sonidos de dolor o queja"
                            },
                            {
                                "target_lang_word": "sollozar",
                                "target_lang_sense_clarification": "llorar convulsivamente"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "34b6ca2b-2c04-3547-9b01-79435912ea35",
                    "sense_definition": "A passionate expression of grief, sorrow, or regret.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "grief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His speech was a moving <w>lament</w> for the disappearing traditions of his childhood home.",
                            "target_lang_translations": {
                                "ru": "Его речь была трогательным <w>плачем</w> по исчезающим традициям его родного дома.",
                                "es": "Su discurso fue un conmovedor <w>lamento</w> por las tradiciones que desaparecían del hogar de su infancia."
                            }
                        },
                        {
                            "text": "The poem serves as a beautiful <w>lament</w> for a love that was lost too soon.",
                            "target_lang_translations": {
                                "ru": "Стихотворение служит прекрасной <w>элегией</w> о любви, которая была потеряна слишком рано.",
                                "es": "El poema sirve como una hermosa <w>elegía</w> a un amor que se perdió demasiado pronto."
                            }
                        }
                    ],
                    "synonyms": [
                        "complaint",
                        "moan",
                        "wail"
                    ],
                    "common_phrases": [
                        "a moving lament",
                        "poetic lament"
                    ],
                    "target_lang_definitions": {
                        "ru": "Страстное выражение горя, печали или сожаления.",
                        "es": "Expresión apasionada de dolor, pena o pesar."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стена́ние",
                                "target_lang_sense_clarification": "выражение сильного огорчения"
                            },
                            {
                                "target_lang_word": "плач",
                                "target_lang_sense_clarification": "выражение скорби"
                            },
                            {
                                "target_lang_word": "се́тование",
                                "target_lang_sense_clarification": "жалоба или сожаление"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "lamento",
                                "target_lang_sense_clarification": "expresión o queja dolorosa"
                            },
                            {
                                "target_lang_word": "lamentación",
                                "target_lang_sense_clarification": "queja expresada con gran dolor o pena"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f5bd2fc-4af7-347a-a7bd-0259dca217fe",
                    "sense_definition": "A song, piece of music, or poem expressing deep grief or mourning.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The piper played a traditional <w>lament</w> at the graveside to honor the fallen soldier.",
                            "target_lang_translations": {
                                "ru": "Волынщик сыграл традиционную <w>погребальную песнь</w> у могилы, чтобы почтить память павшего солдата.",
                                "es": "El gaitero tocó un <w>canto fúnebre</w> tradicional junto a la tumba para honrar al soldado caído."
                            }
                        },
                        {
                            "text": "The composer wrote a haunting <w>lament</w> for the cello that captured the sadness of the era.",
                            "target_lang_translations": {
                                "ru": "Композитор написал пронзительную <w>элегию</w> для виолончели, запечатлевшую печаль той эпохи.",
                                "es": "El compositor escribió un <w>lamento</w> sobrecogedor para violonchelo que capturaba la tristeza de la época."
                            }
                        }
                    ],
                    "synonyms": [
                        "dirge",
                        "elegy",
                        "requiem"
                    ],
                    "common_phrases": [
                        "funeral lament",
                        "haunting lament"
                    ],
                    "target_lang_definitions": {
                        "ru": "Песня, музыкальное произведение или стихотворение, выражающее глубокую скорбь или траур.",
                        "es": "Canción, pieza musical o poema que expresa profundo duelo o tristeza."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плач",
                                "target_lang_sense_clarification": "обрядовая песня"
                            },
                            {
                                "target_lang_word": "эле́гия",
                                "target_lang_sense_clarification": "грустное музыкальное или лит. произведение"
                            },
                            {
                                "target_lang_word": "погреба́льная песнь",
                                "target_lang_sense_clarification": "траурная музыка"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "lamento",
                                "target_lang_sense_clarification": "composición musical o poética fúnebre"
                            },
                            {
                                "target_lang_word": "elegía",
                                "target_lang_sense_clarification": "poema o canto de tono melancólico por una muerte"
                            },
                            {
                                "target_lang_word": "canto fúnebre",
                                "target_lang_sense_clarification": "música o canto de duelo"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}