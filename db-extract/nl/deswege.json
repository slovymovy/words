        "ru-extract.jsonl": [],
        "nl-extract.jsonl": [
            {
                "entry_id": "94a3f4c7-ca9a-3345-949c-55a8c1b9f6ef",
                "word": "deswege",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ec352063-0ad9-35b3-a872-9924cdb334d4",
                        "entry_id": "94a3f4c7-ca9a-3345-949c-55a8c1b9f6ef",
                        "glosses": [
                            "om die reden"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "1f5f9969-e470-4c65-862a-306a5e3d952f",
                                "sense_id": "ec352063-0ad9-35b3-a872-9924cdb334d4",
                                "text": "Natuurlijk sleepten de Vorsten in hun val alle leden van hun huis mee. Ook zij mochten zich op geen enkel terrein van het openbare leven meer bewegen. Zelfs degenen, die hun gehele leven in dienst van hun volk hadden gesteld en deswege algemeen hoogachting hadden genoten, was het bittere lot van de verworpene beschoren.”"
                            },
                            {
                                "example_id": "de046f78-f24f-4424-9dee-acc33006f0b4",
                                "sense_id": "ec352063-0ad9-35b3-a872-9924cdb334d4",
                                "text": "Niet dat Chanel overigens een uitgeblust oud vrouwtje was, verre van dat. Zij bleef zeer scherp en kritisch van geest, maar kon de mode van deze tijd niet meer navoelen en heeft haar collega’s couturiers deswegen[sic!] de hatelijke opmerkingen niet bespaard."
                            },
                            {
                                "example_id": "783ba567-0991-4f6c-93c7-03bd90e12ec7",
                                "sense_id": "ec352063-0ad9-35b3-a872-9924cdb334d4",
                                "text": "Zitten in het wonderschone dorp Tábara, aan de voet van de Sierra de la Culebra die we over een paar dagen over moeten. Zit me deswege moed in te drinken, plus typen, gaat best samen!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "770f45cd-7246-4465-bbac-7f7a7ed24f09",
                        "source_entry_id": "94a3f4c7-ca9a-3345-949c-55a8c1b9f6ef",
                        "source_sense_id": "ec352063-0ad9-35b3-a872-9924cdb334d4",
                        "source_sense_description": "om die reden",
                        "target_lang_word": "therefore",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "therefore",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5e39bb3-46ac-3429-9607-b48e87449b18",
                                        "entry_id": "dfe4845c-c283-3473-b130-6369e1ea8935",
                                        "glosses": [
                                            "Consequently, by or in consequence of that or this cause; referring to something previously stated."
                                        ],
                                        "tags": [
                                            "conjunctive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40fbf13c-cc31-47d7-806b-6082eb0202d9",
                                                "sense_id": "d5e39bb3-46ac-3429-9607-b48e87449b18",
                                                "text": "Traditional values will always have a place—therefore, they will never lose relevance."
                                            },
                                            {
                                                "example_id": "22f9500b-699f-476c-b3b5-d34d86fc9150",
                                                "sense_id": "d5e39bb3-46ac-3429-9607-b48e87449b18",
                                                "text": "I've been explicitly forbidden to leave and therefore must stay longer."
                                            },
                                            {
                                                "example_id": "04756caf-c792-423c-8861-8f44559bd973",
                                                "sense_id": "d5e39bb3-46ac-3429-9607-b48e87449b18",
                                                "text": "I left the office at 5 o'clock. I was therefore not there when the fire started a quarter of an hour later."
                                            },
                                            {
                                                "example_id": "34821ae0-beb5-4463-8426-8a75d84efa86",
                                                "sense_id": "d5e39bb3-46ac-3429-9607-b48e87449b18",
                                                "text": "I have married a wife, and therefore I can not come."
                                            },
                                            {
                                                "example_id": "db9c1fc7-05e9-44c6-ba04-91b1bc88e91b",
                                                "sense_id": "d5e39bb3-46ac-3429-9607-b48e87449b18",
                                                "text": "Je pense, donc je suis (I think, therefore I am)"
                                            },
                                            {
                                                "example_id": "a9c74313-de9b-4036-9e6b-e7e870b9eb8b",
                                                "sense_id": "d5e39bb3-46ac-3429-9607-b48e87449b18",
                                                "text": "In the old days, to my commonplace and unobserving mind, he gave no evidences of genius whatsoever. He never read me any of his manuscripts, […], and therefore my lack of detection of his promise may in some degree be pardoned."
                                            },
                                            {
                                                "example_id": "026260e6-ab62-4f9b-9d70-58e6897be38b",
                                                "sense_id": "d5e39bb3-46ac-3429-9607-b48e87449b18",
                                                "text": "Creating a complete map of the human connectome would therefore be a monumental milestone but not the end of the journey to understanding how our brains work."
                                            },
                                            {
                                                "example_id": "9d6442df-21d4-4bea-b78b-ffe4a6a9468b",
                                                "sense_id": "d5e39bb3-46ac-3429-9607-b48e87449b18",
                                                "text": "He blushes; therefore he is innocent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "643be500-cd4b-3d4e-81a0-8fafa6358794",
                                        "entry_id": "dfe4845c-c283-3473-b130-6369e1ea8935",
                                        "glosses": [
                                            "for that; for it (in reference to a previous statement)"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "conjunctive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1190b7a3-60b3-48fc-83ab-dbd453e9c927",
                                                "sense_id": "643be500-cd4b-3d4e-81a0-8fafa6358794",
                                                "text": "Behold, we have forsaken all, and followed thee; what shall we have therefore?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1fdb0d1-7612-49bc-92dd-04f7ca7f496f",
                        "source_entry_id": "94a3f4c7-ca9a-3345-949c-55a8c1b9f6ef",
                        "source_sense_id": "ec352063-0ad9-35b3-a872-9924cdb334d4",
                        "source_sense_description": "om die reden",
                        "target_lang_word": "hence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80842eae-c6f7-319d-b927-13319bcccd9d",
                                        "entry_id": "e75d82eb-3e47-3820-83fd-5f8ab39e7158",
                                        "glosses": [
                                            "From here, from this place, away."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64966e56-c40c-4a08-8596-bdc20ae5dec2",
                                                "sense_id": "80842eae-c6f7-319d-b927-13319bcccd9d",
                                                "text": "I'm going hence, because you have insulted me."
                                            },
                                            {
                                                "example_id": "58c58847-e1c7-4035-ac99-05321d00d6dd",
                                                "sense_id": "80842eae-c6f7-319d-b927-13319bcccd9d",
                                                "text": "Get thee hence, Satan!"
                                            },
                                            {
                                                "example_id": "70c824a6-bc10-47bb-9992-398be236947f",
                                                "sense_id": "80842eae-c6f7-319d-b927-13319bcccd9d",
                                                "text": "O Gertrude, come away: / The sun no ſooner ſhall the Mountaines touch, / But we will ſhip him hence,"
                                            },
                                            {
                                                "example_id": "8312b573-e58a-4581-9d88-3d458930abdc",
                                                "sense_id": "80842eae-c6f7-319d-b927-13319bcccd9d",
                                                "text": "Ye men of Galilee! / Why stand ye looking up to heaven, where Him ye ne’er may see, / Neither ascending hence, nor returning hither again?"
                                            },
                                            {
                                                "example_id": "37b87885-2d46-4947-a6b6-f3917f7386b8",
                                                "sense_id": "80842eae-c6f7-319d-b927-13319bcccd9d",
                                                "text": "`Now leave me,' she said, `and sleep if ye may. I must watch and think, for to-morrow night we go hence, and the time is long since I trod the path that we must follow.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "340a4c84-2ffb-34be-8053-8017301a464f",
                                        "entry_id": "e75d82eb-3e47-3820-83fd-5f8ab39e7158",
                                        "glosses": [
                                            "From the living or from this world."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "figuratively",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07630932-273c-4358-81a6-bd0a842b0dd4",
                                                "sense_id": "340a4c84-2ffb-34be-8053-8017301a464f",
                                                "text": "After a long battle, my poor daughter was taken hence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df741ed0-c8ab-3d93-8682-c66eb895b7e0",
                                        "entry_id": "e75d82eb-3e47-3820-83fd-5f8ab39e7158",
                                        "glosses": [
                                            "In the future from now."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67f076f7-e456-4b81-9de0-d759fa8d8476",
                                                "sense_id": "df741ed0-c8ab-3d93-8682-c66eb895b7e0",
                                                "text": "A year hence it will be forgotten."
                                            },
                                            {
                                                "example_id": "9c9da39b-ace4-411f-91f7-f662f30e8c85",
                                                "sense_id": "df741ed0-c8ab-3d93-8682-c66eb895b7e0",
                                                "text": "[…]And now farewell / Till half an hour hence."
                                            },
                                            {
                                                "example_id": "741b1716-f7b4-43ab-9ac4-d193ba1e7507",
                                                "sense_id": "df741ed0-c8ab-3d93-8682-c66eb895b7e0",
                                                "text": "There may be an occasion to do so two years hence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a05f711b-6b9b-385d-8ddd-9c9943de2887",
                                        "entry_id": "e75d82eb-3e47-3820-83fd-5f8ab39e7158",
                                        "glosses": [
                                            "As a result; therefore, for this reason."
                                        ],
                                        "tags": [
                                            "conjunctive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a408758-c12f-4541-b019-b18b0198f0a9",
                                                "sense_id": "a05f711b-6b9b-385d-8ddd-9c9943de2887",
                                                "text": "I shall go to Japan and hence will not be here in time for the party."
                                            },
                                            {
                                                "example_id": "3d685c49-b42f-4e13-a3a8-58822e0d1c1b",
                                                "sense_id": "a05f711b-6b9b-385d-8ddd-9c9943de2887",
                                                "text": "The purse is handmade and hence very expensive."
                                            },
                                            {
                                                "example_id": "93de815b-de18-43dd-9d39-edb990dc5142",
                                                "sense_id": "a05f711b-6b9b-385d-8ddd-9c9943de2887",
                                                "text": "Hence that general is skillful in attack whose opponent does not know what to defend; and he is skillful in defense whose opponent does not know what to attack."
                                            },
                                            {
                                                "example_id": "1302e753-dc26-43a0-919e-14de89639887",
                                                "sense_id": "a05f711b-6b9b-385d-8ddd-9c9943de2887",
                                                "text": "Hence it comes that all armed Prophets have been victorious, and all unarmed Prophets have been destroyed."
                                            },
                                            {
                                                "example_id": "5e573970-21bd-4232-948f-9e31153cee44",
                                                "sense_id": "a05f711b-6b9b-385d-8ddd-9c9943de2887",
                                                "text": "That hence arises the peculiar Unhappiness of that Business, which other Callings are no way liable to;"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8e3d3e4-d271-37f0-b426-8e35eb045f4b",
                                        "entry_id": "36b024bb-4967-38c4-975a-f44780fb9eb7",
                                        "glosses": [
                                            "Go away! Begone!"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59266aa6-70fe-4126-8d81-87eb07eb0efb",
                                                "sense_id": "f8e3d3e4-d271-37f0-b426-8e35eb045f4b",
                                                "text": "Zuc[cone]. Hence auant I will marie a woman with no wombe, a creature with two noſes, a wench with no haire rather then remarie thee, […]"
                                            },
                                            {
                                                "example_id": "990ba6f7-27d6-4d16-b1c5-f4edc34644e3",
                                                "sense_id": "f8e3d3e4-d271-37f0-b426-8e35eb045f4b",
                                                "text": "Mira[nda]. Beſeech you Father.\nProſ[pero]. Hence: hang not on my garments."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f2e68c2-266a-38ff-8236-d4c8e740e9e6",
                                        "entry_id": "36b173a9-64dc-3e50-bb78-25bd3ff4094b",
                                        "glosses": [
                                            "To utter \\\"hence!\\\" to; to send away."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "61d8f477-a031-378c-a1de-cbc5768995f9",
                                        "entry_id": "36b173a9-64dc-3e50-bb78-25bd3ff4094b",
                                        "glosses": [
                                            "To depart; to go away."
                                        ],
                                        "tags": [
                                            "dated",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
