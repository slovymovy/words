                    {
                        "sense_id": "6da078c8-9f06-3f5f-ab58-30212da85fdd",
                        "entry_id": "a5c91cee-c26d-3aa1-8679-f9f1639e74c4",
                        "glosses": [
                            "orgaan van een hoen, na het slachten gegeten als delicatesse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19303354-7918-4573-82d9-158b115d9f02",
                                "sense_id": "6da078c8-9f06-3f5f-ab58-30212da85fdd",
                                "text": "100 g kippenlever bevat de dagelijkse hoeveelheid ijzer en een grote hoeveelheid foliumzuur, die verantwoordelijk is voor de bloedvorming."
                            },
                            {
                                "example_id": "c7d25776-c953-43f4-b60b-1e1b01dee9ef",
                                "sense_id": "6da078c8-9f06-3f5f-ab58-30212da85fdd",
                                "text": "Maar kippenhartjes zijn in Nederland voor de poes, en kippenlever – ook een soort slachtafval – wordt vooral door oude mensen gegeten. Een vergissing, want er is maar weinig dat zo mals en zo zacht is als gebakken kippenlevertjes met ui, afgeblust met een scheutje cognac of marsala, op een geroosterd broodje."
                            }
                        ]
                    }
