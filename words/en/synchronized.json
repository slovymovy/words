{
    "word_family": [
        "synchronize",
        "synchronization",
        "synchrony",
        "synchronous",
        "asynchronous"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e5cf593b-70ec-3254-8caf-42047959d9b9",
                    "sense_definition": "Happening or moving at the same time or speed; coordinated.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "coordination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>synchronized</w> swimmers performed their routine with perfect timing.",
                            "target_lang_translations": {
                                "zh": "花样游泳运动员们<w>同步</w>完成了她们的表演，节奏精准无误。"
                            }
                        },
                        {
                            "text": "Our watches are <w>synchronized</w> so we arrive at the same time.",
                            "target_lang_translations": {
                                "zh": "我们的手表已经<w>同步</w>了，这样我们就能同时到达。"
                            }
                        }
                    ],
                    "synonyms": [
                        "coordinated",
                        "simultaneous"
                    ],
                    "antonyms": [
                        "unsynchronized"
                    ],
                    "common_phrases": [
                        "synchronized swimming"
                    ],
                    "target_lang_definitions": {
                        "zh": "指在同一时间或以相同速度发生、移动或运作；协调一致的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "同步的",
                                "target_lang_sense_clarification": "形容事物在时间或动作上保持一致。"
                            },
                            {
                                "target_lang_word": "协调的",
                                "target_lang_sense_clarification": "强调多个部分配合得当。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6f1c83cc-fe76-38eb-bb4d-794038f6c73d",
                    "sense_definition": "Simple past and past participle of <w>synchronize</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "coordination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>synchronized</w> their watches before starting the mission.",
                            "target_lang_translations": {
                                "zh": "他们在开始任务前<w>同步</w>了手表。"
                            }
                        },
                        {
                            "text": "The data was <w>synchronized</w> across all devices automatically.",
                            "target_lang_translations": {
                                "zh": "数据已在所有设备间自动完成了<w>同步</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使在时间或动作上保持一致（动词 synchronize 的过去式或过去分词）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "同步",
                                "target_lang_sense_clarification": "使两个或多个事物在时间上对齐。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}