    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "5ddf4471-2ef8-3ee9-b6fe-443e19fa4323",
                "word": "lowering",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "15af1d7a-319a-402a-a3ea-f07b150f7578",
                        "entry_id": "5ddf4471-2ef8-3ee9-b6fe-443e19fa4323",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more lowering"
                    },
                    {
                        "form_id": "0015d7c8-cca6-45ac-8ba1-db9b2d9b42c7",
                        "entry_id": "5ddf4471-2ef8-3ee9-b6fe-443e19fa4323",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most lowering"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "06176116-800a-3c1a-9e0e-781ba93d9d3a",
                        "entry_id": "5ddf4471-2ef8-3ee9-b6fe-443e19fa4323",
                        "glosses": [
                            "Dark and menacing."
                        ],
                        "tags": [
                            "of sky or environment"
                        ],
                        "examples": [
                            {
                                "example_id": "463f324d-f2da-4baa-8825-042afb3a1815",
                                "sense_id": "06176116-800a-3c1a-9e0e-781ba93d9d3a",
                                "text": "The morning had been intensely hot, with but little wind; and the lowering gloomy aspect of the clouds appeared to indicate the approach of one of those sudden gales peculiar to tropical climates, and which, although of short duration, are generally productive of mischief."
                            },
                            {
                                "example_id": "a4a7196f-3a30-47db-9949-a16216871201",
                                "sense_id": "06176116-800a-3c1a-9e0e-781ba93d9d3a",
                                "text": "The wide prospect up stream was grey and lowering, the long still-distant waterfront of Dundee, and the Fife shore were alike colourless, and there was ample evidence of rough weather not far ahead."
                            },
                            {
                                "example_id": "477af87b-f651-4a38-b053-fa174c646ed4",
                                "sense_id": "06176116-800a-3c1a-9e0e-781ba93d9d3a",
                                "text": "Ahead of us the lowering smoke-screen of Leeds and her gloomy satellites hung like an incubus over the land."
                            },
                            {
                                "example_id": "469c41a1-8a43-4571-818e-e96289e732f3",
                                "sense_id": "06176116-800a-3c1a-9e0e-781ba93d9d3a",
                                "text": "Jon crossed the pass into Glen Maraich in a stinging flurry of sleet, heading down between dark walls of rock under a lowering sky."
                            },
                            {
                                "example_id": "e689565b-88ee-4c2a-a62c-8269f4f0409f",
                                "sense_id": "06176116-800a-3c1a-9e0e-781ba93d9d3a",
                                "text": "Bleak fields stretched to the horizon beneath lowering clouds."
                            }
                        ]
                    },
                    {
                        "sense_id": "9bb5c1cb-c3f7-3e93-91ae-8a924324f12f",
                        "entry_id": "5ddf4471-2ef8-3ee9-b6fe-443e19fa4323",
                        "glosses": [
                            "That lowers or frowns."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d14214f-c87b-436b-aeb0-b599d4b5851a",
                                "sense_id": "9bb5c1cb-c3f7-3e93-91ae-8a924324f12f",
                                "text": "One glance sufficed to identify the intruder, for none but he could boast of such a dark, lowering countenance ; and all exclaimed in mingled wonder and terror at his unwonted presence in those sunlit regions:"
                            },
                            {
                                "example_id": "f7c86552-5764-4bf1-9ce2-0413b8083fe4",
                                "sense_id": "9bb5c1cb-c3f7-3e93-91ae-8a924324f12f",
                                "text": "A kind of dark pallor lent him a ghostly appearance in the uncertain light, an effect heightened by the satanic darkness of his lowering brows."
                            },
                            {
                                "example_id": "3e59c504-36e2-4f67-98bb-1d7ce6f88991",
                                "sense_id": "9bb5c1cb-c3f7-3e93-91ae-8a924324f12f",
                                "text": "The Countess had liked Elsa from the first moment when she saw her, ragged, unkempt and forlorn, among the lowering, suspicious men-at-arms in the courtyard, and now that she knew the dangers and the privations the girl had braved for the sake of Wilhelm, the affectionate heart of Beatrix found ample room for the motherless Elsa."
                            },
                            {
                                "example_id": "021dc9b3-718c-4e48-bdae-09e3acdaf7b9",
                                "sense_id": "9bb5c1cb-c3f7-3e93-91ae-8a924324f12f",
                                "text": "Crequy, for several moments, appeared not to have heard. His face became more lowering."
                            }
                        ]
                    },
                    {
                        "sense_id": "20d3feff-89ba-3f1a-917f-3679a345a53b",
                        "entry_id": "5ddf4471-2ef8-3ee9-b6fe-443e19fa4323",
                        "glosses": [
                            "Lurking, skulking, menacing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34affbe1-4ae3-4e61-aa7f-afcd898ad38d",
                                "sense_id": "20d3feff-89ba-3f1a-917f-3679a345a53b",
                                "text": "Klimov put on his greatcoat mechanically and left the train, and he felt as though it were not himself walking, but some one else, a stranger, and he felt that he was accompanied by the heat of the train, his thirst, and the ominous, lowering figures which all night long had prevented his sleeping."
                            },
                            {
                                "example_id": "2fe6a0e8-e5e8-479e-a979-d6e7c8f74a9a",
                                "sense_id": "20d3feff-89ba-3f1a-917f-3679a345a53b",
                                "text": "They might have stayed until dusk, undisturbed by Schmidt's casual customers, had it not been for the entrance of three grimy and lowering men."
                            },
                            {
                                "example_id": "07b0c44f-85ee-4a19-90ed-67c40c81c826",
                                "sense_id": "20d3feff-89ba-3f1a-917f-3679a345a53b",
                                "text": "The outsize nature of Norse mythological characters is well noted in Caselli's dramatic close-ups, in which the powerful, lowering figures of Odin or Thor are backed by ice and rock, massive trolls, gigantic eagles and wolves."
                            }
                        ]
                    }
                ],
