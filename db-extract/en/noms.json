            {
                "entry_id": "7a68cb7b-6d23-38b6-a986-318e397af54f",
                "word": "noms",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ddb3231d-65a3-3c67-8d88-d0479761358d",
                        "entry_id": "7a68cb7b-6d23-38b6-a986-318e397af54f",
                        "glosses": [
                            "Food, especially tasty food."
                        ],
                        "tags": [
                            "plural",
                            "plural-only",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "68330b48-d169-4a78-ab8e-be38c07c8c89",
                                "sense_id": "ddb3231d-65a3-3c67-8d88-d0479761358d",
                                "text": "Forget overpriced noms"
                            },
                            {
                                "example_id": "3e9cf6eb-ab8b-493e-adb6-f1a2c6040311",
                                "sense_id": "ddb3231d-65a3-3c67-8d88-d0479761358d",
                                "text": "She's quite the foodie herself, frequently posting some tasty looking noms to her Instagram, as well as some adorable family photos."
                            },
                            {
                                "example_id": "21b4be27-40a7-40ba-9dfa-9a8965923687",
                                "sense_id": "ddb3231d-65a3-3c67-8d88-d0479761358d",
                                "text": "This elegantly designed (highly Instagrammable), community-forward venue, opened by Mary and Josh Foss in April of 2018, has an impressive array of coffee drinks and brewing methods to complement their fresh-baked bready noms, a rotation of seven local craft beers on tap, and – yes! – a selection of ciders and meads."
                            },
                            {
                                "example_id": "80b055fa-a37a-4fe0-ba3e-97b1e6e09ccd",
                                "sense_id": "ddb3231d-65a3-3c67-8d88-d0479761358d",
                                "text": "For November is all about the noms, the elaborate eats, the sort of feasting that is layered with deep flavor and ingredients that are so un-run-of-the-mill, from fascinating fungi to spices you have to research ahead of purchasing."
                            },
                            {
                                "example_id": "7ebde55a-a213-463e-bfc4-ea8b572885e7",
                                "sense_id": "ddb3231d-65a3-3c67-8d88-d0479761358d",
                                "text": "With these culinary heavy hitters, you can be sure the winning dishes will truly represent the highest quality of airport noms!"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
