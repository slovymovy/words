        "fr-extract.jsonl": [
            {
                "entry_id": "b5559b68-a965-3213-b01f-cbcc3af4547d",
                "word": "grandiose",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0237ac65-6bb5-4449-bf04-baeb69c1ada6",
                        "entry_id": "b5559b68-a965-3213-b01f-cbcc3af4547d",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "grandioses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "af53b0c5-1529-3cd5-94a7-e9efeee1ba28",
                        "entry_id": "b5559b68-a965-3213-b01f-cbcc3af4547d",
                        "glosses": [
                            "Qui frappe l’imagination par un caractère de grandeur ou de majesté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9de4c3c4-bc66-4734-89ed-d746a235ac37",
                                "sense_id": "af53b0c5-1529-3cd5-94a7-e9efeee1ba28",
                                "text": "\"Depuis deux ans, j'ai présenté à l'Académie une série de travaux sur la figure des comètes et l'accélération de leurs mouvements, et j'ai montré que ces phénomènes grandioses accusaient nettement dans les espaces célestes l'existence d'une force nouvelle totalement différente de la gravitation\". — (Faye, Comptes rendus)"
                            },
                            {
                                "example_id": "df511173-0f7b-4d23-8695-84b0a447fbed",
                                "sense_id": "af53b0c5-1529-3cd5-94a7-e9efeee1ba28",
                                "text": "Les sabbats ont alors la forme grandiose et terrible de la Messe noire, de l’office à l’envers, où Jésus est défié, prié de foudroyer, s’il peut."
                            },
                            {
                                "example_id": "f65a7a1b-9839-4031-8759-ccb0e5990626",
                                "sense_id": "af53b0c5-1529-3cd5-94a7-e9efeee1ba28",
                                "text": "Quand on se présente devant la cité de Carcassonne, on est tout d’abord frappé de l’aspect grandiose et sévère de ces tours brunes si diverses de dimensions, […]."
                            },
                            {
                                "example_id": "9cb7b2f0-3a6a-43bd-b8c5-aeb9ed7d51d4",
                                "sense_id": "af53b0c5-1529-3cd5-94a7-e9efeee1ba28",
                                "text": "C'était magnifique, grandiose, magique. Vous savez, tous ces mots qui n'en peuvent plus d'être éblouis."
                            },
                            {
                                "example_id": "c8434256-5e28-4c71-83fd-4e5905d16003",
                                "sense_id": "af53b0c5-1529-3cd5-94a7-e9efeee1ba28",
                                "text": "Rainie adorait ces montagnes. […]. Elle pensait que la nature se devait d'être grandiose, une présence suffisamment majestueuse pour faire trembler dans leurs bottes les simples mortels."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "414869d9-6ccc-44aa-9825-6e5edf5bea77",
                        "source_entry_id": "b5559b68-a965-3213-b01f-cbcc3af4547d",
                        "source_sense_id": "af53b0c5-1529-3cd5-94a7-e9efeee1ba28",
                        "target_lang_word": "grandiose",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grandiose",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c90d422c-e102-330c-b426-09427a0502eb",
                                        "entry_id": "4ac1483c-6233-30a0-a361-42af8929358b",
                                        "glosses": [
                                            "Large and impressive, in size, scope or extent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7c30dfb-5e92-4864-aef1-0870a69a510c",
                                                "sense_id": "c90d422c-e102-330c-b426-09427a0502eb",
                                                "text": "Independence does not need to be a grandiose process of disconnection and severing ties."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ba4fb27-b4aa-3599-aadd-6c9e2fa3a1c6",
                                        "entry_id": "4ac1483c-6233-30a0-a361-42af8929358b",
                                        "glosses": [
                                            "Pompous or pretentious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eccd5850-a944-4bb2-8f1e-c2b3e80403b2",
                                                "sense_id": "7ba4fb27-b4aa-3599-aadd-6c9e2fa3a1c6",
                                                "text": "There is a station here, of course, opened as Didcot in June 1844 and renamed as the more grandiose-sounding Didcot Parkway in July 1985."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
