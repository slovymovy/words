                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a480f5a-0e87-4dbb-bc6b-678ec4c2523a",
                        "source_entry_id": "b77efb79-0050-3748-adcb-a85b2637d814",
                        "source_sense_id": "a04969a5-047f-3ff8-ba0b-7c1389c4673a",
                        "target_lang_word": "menstruation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "menstruation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca21879a-29e3-3a6d-838a-4c1dedd7c18d",
                                        "entry_id": "2c057c68-2b61-3fe2-82e9-3950d7df1932",
                                        "glosses": [
                                            "The periodic discharging of the menses, the flow of blood and cells from the lining of the uterus in unfertilized females of humans and other primates."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a1a4c63-70ce-4a5d-9b85-520e67a16c03",
                                                "sense_id": "ca21879a-29e3-3a6d-838a-4c1dedd7c18d",
                                                "text": "It would seem that in Avebury, Stonehenge, and Malta the mystery cult of menstruation/mensuration reached its most consummate development."
                                            },
                                            {
                                                "example_id": "12928bfd-4840-4b9c-9821-5ddac0f165d5",
                                                "sense_id": "ca21879a-29e3-3a6d-838a-4c1dedd7c18d",
                                                "text": "[T]he release of semen from the penis predominantly symbolizes a forceful masculine operation, an orgasmic ‘rush’ – ejaculate refers to a sudden happening, an ejection – while the ‘loss’ of blood during menstruation is viewed as a more or less passive occurrence. Even the metaphors employed to depict these two aspects of corporeality serve to situate them on differently gendered poles. Man ‘spoofs off’ or ‘shoots his load’, while woman ‘gets her visitor’, ‘has got her monthly’."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11c948ce-58c2-3655-bc27-23eeed3d5fed",
                                        "entry_id": "2c057c68-2b61-3fe2-82e9-3950d7df1932",
                                        "glosses": [
                                            "An instance of menstruation, the part of each month during which a fertile woman menstruates."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "127bbe2a-c801-411e-8f07-128cd157efeb",
                        "source_entry_id": "b77efb79-0050-3748-adcb-a85b2637d814",
                        "source_sense_id": "a04969a5-047f-3ff8-ba0b-7c1389c4673a",
                        "target_lang_word": "menstruation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "menstruation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "da6bfab2-69f5-32a5-801f-4379e9308eca",
                                        "entry_id": "4a20ceb1-3f50-3f7c-96f4-7c5394512d14",
                                        "glosses": [
                                            "Ensemble des phénomènes qui, à des intervalles quasi mensuels, se manifestent au cours du cycle menstruel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07bfa298-5b83-407c-9a25-c93600024114",
                                                "sense_id": "da6bfab2-69f5-32a5-801f-4379e9308eca",
                                                "text": "La menstruation marque le début de la période pendant laquelle une femme est apte à procréer."
                                            },
                                            {
                                                "example_id": "fa79a8d3-a398-4f24-aee3-274e1fc5cb41",
                                                "sense_id": "da6bfab2-69f5-32a5-801f-4379e9308eca",
                                                "text": "C’est la bourgeoisie qui a fait de l’argent une chose sacrée qui exige le mystère, analogue aux menstruations auxquelles on pense tout le temps et dont on ne parle jamais."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db94f1ab-44b0-4024-a025-c084ad4f97ef",
                        "source_entry_id": "b77efb79-0050-3748-adcb-a85b2637d814",
                        "source_sense_id": "a04969a5-047f-3ff8-ba0b-7c1389c4673a",
                        "target_lang_word": "menstruación",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "menstruación",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "273708fa-019b-3367-982f-f9ac5577d139",
                                        "entry_id": "944c089f-2ff2-3dc2-91a8-582ab5a092da",
                                        "glosses": [
                                            "Proceso cíclico fisiológico de las mujeres y hembras de los monos catarrínicos, sexualmente maduras, que ocurre con una frecuencia media aproximada de veintiocho días. Durante el ciclo menstrual, el cuerpo de la mujer se prepara para un eventual embarazo, produciéndose un sangrado vaginal fruto de la descamación del endometrio, como consecuencia de la brusca deprivación hormonal al final del ciclo femenino si no se ha producido la implantación de un blastocito."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0acd65ba-0fb2-4e25-8152-e9e4df1469ad",
                        "source_entry_id": "b77efb79-0050-3748-adcb-a85b2637d814",
                        "source_sense_id": "a04969a5-047f-3ff8-ba0b-7c1389c4673a",
                        "target_lang_word": "менструация",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "менструация",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "aa6eac9c-08f4-3709-9825-14138feae3ab",
                                        "entry_id": "bf6a6864-7dd4-3e51-9afc-f5043d9df53d",
                                        "glosses": [
                                            "физиол. у женщин и самок некоторых млекопитающих животных — происходящие в течение детородного периода ежемесячные кровотечения из матки, связанные с овуляцией; а также дни, в которые происходит это кровотечение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f90d3e1d-47fd-4c95-a62e-90e2c6b8a740",
                                                "sense_id": "aa6eac9c-08f4-3709-9825-14138feae3ab",
                                                "text": "Женщина порой становится неуравновешенной, мнительной, обеспокоенной, ― всё это может вас раздражать, но подавите раздражение. Пройдёт менструация ― всё станет хорошо."
                                            },
                                            {
                                                "example_id": "ec81e2d2-7120-45db-b835-3139f4632a86",
                                                "sense_id": "aa6eac9c-08f4-3709-9825-14138feae3ab",
                                                "text": "Если оплодотворение яйцеклетки не происходит, функциональный слой эндометрия отторгается, из половых путей появляются кровянистые выделения, называемые менструацией."
