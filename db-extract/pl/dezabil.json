                ],
                "senses": [
                    {
                        "sense_id": "2df40825-113b-3725-85c3-aee9c0006f85",
                        "entry_id": "963c5b9d-a8f0-3c18-8123-975c4f9f4bbe",
                        "glosses": [
                            "ubiór domowy, negliż"
                        ],
                        "tags": [
                            "humorous",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "3c8ab40d-4da4-49d0-9a59-04e6f06fcafb",
                                "sense_id": "2df40825-113b-3725-85c3-aee9c0006f85",
                                "text": "Była przybrana w czarny dezabil, zapięty pod szyję, a doskonale uwydatniający jej szczupłą i bardzo foremną figurę"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68497db1-ca2c-4eb9-8acc-0a2b8ac98fa1",
                        "source_entry_id": "963c5b9d-a8f0-3c18-8123-975c4f9f4bbe",
                        "source_sense_id": "2df40825-113b-3725-85c3-aee9c0006f85",
                        "target_lang_word": "dishabille",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dishabille",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ba79ded-37ff-3b11-8327-d9fef4b6ce19",
                                        "entry_id": "91aaa93d-0add-3b9d-a1d0-28ab18522570",
                                        "glosses": [
                                            "Extreme casual or disorderly dress, for example, with the shirt-tail out, sleeves unbuttoned, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "223e9022-3779-4549-bead-6188b9145c0a",
                                                "sense_id": "0ba79ded-37ff-3b11-8327-d9fef4b6ce19",
                                                "text": "When I rallied him for viſiting me in ſuch a diſhabille, he ſtood a tiptoe to view himſelf in the glaſs; and owning I was in the right, ſaid that he would go and dreſs himſelf before dinner."
                                            },
                                            {
                                                "example_id": "def52989-cb8e-482e-b932-2e68a2c5de60",
                                                "sense_id": "0ba79ded-37ff-3b11-8327-d9fef4b6ce19",
                                                "text": "Wherever they went, some pattened girl stopped to curtsy, or some footman in dishabille sneaked off. Yet this was an abbey!"
                                            },
                                            {
                                                "example_id": "f44e71d0-7b52-416b-95c3-de0867b4993f",
                                                "sense_id": "0ba79ded-37ff-3b11-8327-d9fef4b6ce19",
                                                "text": "A little after 3:15 o’clock yesterday afternoon a stream of people, hatless, coatless, some in an even worse state of dishabille rushed down the stairs or to the elevators of every one of the downtown buildings and onto the streets, their faces showing every sign of terror."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f9e30da-a62d-3dce-a469-a19c6ba25ae9",
                                        "entry_id": "91aaa93d-0add-3b9d-a1d0-28ab18522570",
                                        "glosses": [
                                            "A loose, negligent dress."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2bbc36d-1fe1-40ea-b4e4-f55a83852f49",
                                                "sense_id": "5f9e30da-a62d-3dce-a469-a19c6ba25ae9",
                                                "text": "She wore a dishabille of mignonette-green silk and bead-diapered head-dress that added several inches to her height […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fc6abd8f-9b4a-46a6-874d-0b45804f624f",
                        "source_entry_id": "963c5b9d-a8f0-3c18-8123-975c4f9f4bbe",
                        "source_sense_id": "2df40825-113b-3725-85c3-aee9c0006f85",
                        "target_lang_word": "deshabille",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deshabille",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1491d57d-d363-3112-ba53-66d52a2bfe1f",
                                        "entry_id": "57dc0e22-b690-31c6-8739-368c02dffb3a",
                                        "glosses": [
                                            "the state of being partially clothed"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9c6df0d-30a4-418a-8a1f-e16b33242644",
                                                "sense_id": "1491d57d-d363-3112-ba53-66d52a2bfe1f",
                                                "text": "We have witnessed the deshabille of Major Pendennis: will any man wish to be valet-de-chambre to our other hero, Costigan?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a31796fd-2ffc-3924-af66-f0fcfb76fb1f",
                                        "entry_id": "57dc0e22-b690-31c6-8739-368c02dffb3a",
                                        "glosses": [
                                            "a garment worn when one is in a state of undress; a négligée"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7337e8cc-2c6b-4aa5-a6db-34afdfcc46c1",
                        "source_entry_id": "963c5b9d-a8f0-3c18-8123-975c4f9f4bbe",
                        "source_sense_id": "2df40825-113b-3725-85c3-aee9c0006f85",
                        "target_lang_word": "déshabillé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déshabillé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ef181f19-1527-3520-9ee5-dbcd42fab3a2",
                                        "entry_id": "4c584d85-69ea-3f38-9744-6358dc223421",
                                        "glosses": [
                                            "Dépouillé de tout ou partie de ses vêtements, dévêtu, dénudé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec5afa2c-f812-4782-85ca-722ff55fc4a9",
                                                "sense_id": "ef181f19-1527-3520-9ee5-dbcd42fab3a2",
                                                "text": "À demi déshabillé, il se coucha."
                                            },
                                            {
                                                "example_id": "b4ed9b43-7d97-4d4a-a795-d46fa73f8177",
                                                "sense_id": "ef181f19-1527-3520-9ee5-dbcd42fab3a2",
                                                "text": "Elle allait et venait donc à travers la pièce Lola, un peu déshabillée et son corps me paraissait tout de même encore bien désirable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3569d73-ee9f-3ccb-9ae9-123bae9b3a22",
                                        "entry_id": "4c584d85-69ea-3f38-9744-6358dc223421",
                                        "glosses": [
                                            "Relatif à une toilette légère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78282621-3a08-4797-b2ec-6283032a35f6",
                                                "sense_id": "a3569d73-ee9f-3ccb-9ae9-123bae9b3a22",
                                                "text": "Vous étiez bien déshabillée hier à l'Opéra."
                                            },
                                            {
                                                "example_id": "8004d65d-e3e8-4ade-82a0-bc570ab00c21",
                                                "sense_id": "a3569d73-ee9f-3ccb-9ae9-123bae9b3a22",
                                                "text": "Des robes colletées ou décolletées, des robes habillées ou déshabillées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2af047c9-c19f-369a-9c82-51238782bf59",
                                        "entry_id": "4c584d85-69ea-3f38-9744-6358dc223421",
                                        "glosses": [
                                            "Dépouillé de tous ses accessoires, dénudé."
                                        ],
                                        "tags": [
                                            "Appliqué à une chose"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9683d912-e710-4ef1-bae9-25ea36c2c044",
                                                "sense_id": "2af047c9-c19f-369a-9c82-51238782bf59",
                                                "text": "Son unique maîtresse était désormais cette montagne aux flancs déshabillés, sauvages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e7b87d5-f02e-35b4-bfc8-31fd2b5855e4",
                                        "entry_id": "4c584d85-69ea-3f38-9744-6358dc223421",
                                        "glosses": [
                                            "Sans défense, désarmé."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63451aa4-aa8e-425a-ace0-5c48c6bd48aa",
                                                "sense_id": "2e7b87d5-f02e-35b4-bfc8-31fd2b5855e4",
                                                "text": "N'avez-vous donc pas compris quelle immense amitié il fallait que j'eusse pour vous pour me permettre de vous dire tout cela, pour me montrer à vous si nu, si déshabillé, si faible, vous qui m'accusez d'orgueil ?"
                                            },
                                            {
                                                "example_id": "476d7de0-0ad2-4c10-af83-82d3d7f93cd4",
                                                "sense_id": "2e7b87d5-f02e-35b4-bfc8-31fd2b5855e4",
                                                "text": "Déshabillée, épluchée, racontée, avec l'acharnement d'une domesticité oisive"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "déshabillé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1bf1bfae-4c68-351c-b7e4-f803028c6cad",
                                        "entry_id": "bf37f5ed-896a-35d5-b2b5-e349be2b505c",
                                        "glosses": [
                                            "Vêtement d’intérieur de femme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c08d3f0a-bfd4-46cf-be7d-f52f10afda21",
                                                "sense_id": "1bf1bfae-4c68-351c-b7e4-f803028c6cad",
                                                "text": "En déshabillé, tel que l’on est, sans artifice."
                                            },
                                            {
                                                "example_id": "c6e4b3c4-d44e-4a21-a385-b7243b53f89d",
                                                "sense_id": "1bf1bfae-4c68-351c-b7e4-f803028c6cad",
                                                "text": "Elle était si jolie avec son bonnet rond et son ruban rose, son déshabillé de cirsakas et ses petits souliers jonquille, que mon oncle s'arrêta un instant pour la regarder."
                                            },
                                            {
                                                "example_id": "79ec5267-95c8-4b43-bfec-95c44a6ac996",
                                                "sense_id": "1bf1bfae-4c68-351c-b7e4-f803028c6cad",
                                                "text": "Quant à votre servante vous l’avez vue une fois à sa fenêtre en déshabillé."
                                            },
                                            {
                                                "example_id": "fdcd5cc7-f0ba-403b-8d5e-6cc60925bdf5",
                                                "sense_id": "1bf1bfae-4c68-351c-b7e4-f803028c6cad",
                                                "text": "Au lever du rideau, Lucie, en déshabillé de nuit, entre avec précaution par la porte de gauche."
                                            },
                                            {
                                                "example_id": "772dbd06-1076-47e3-b81f-dbf21d1f5a33",
                                                "sense_id": "1bf1bfae-4c68-351c-b7e4-f803028c6cad",
                                                "text": "Elle nous recevait, allongée à la Mme Récamier sur la couchette de son compartiment, vêtue d’un déshabillé à dentelles, coiffée d’une marmotte pleine de grâce."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "déshabillé",
                                "target_lang_code": "fr",
