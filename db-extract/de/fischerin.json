                "translations": [
                    {
                        "translation_id": "51d21dcd-6b1b-4e50-8e54-21abf04473fd",
                        "source_entry_id": "ddbe61b0-0672-3839-a612-9203857085d4",
                        "source_sense_id": "f922c7c6-7f40-31fb-b9f6-8038728db067",
                        "source_sense_description": "Arbeiterin, Selbstständige, die erwerbsmäßig Fang von Fisch betreibt",
                        "target_lang_word": "pêcheuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pêcheuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aa3d44d2-2264-3ca2-b726-4a99f8f065b4",
                                        "entry_id": "b179fe28-112d-3b21-9354-3f39710b27c3",
                                        "glosses": [
                                            "Celle qui pêche, qui en a fait son métier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a038c159-f24d-4a77-8003-5e2f55a5dba8",
                                                "sense_id": "aa3d44d2-2264-3ca2-b726-4a99f8f065b4",
                                                "text": "Ce n’étaient plus un petit bûcheron et une petite pêcheuse, - mais un Sylphe et une Ondine, lesquels, plus tard, furent unis légitimement."
                                            },
                                            {
                                                "example_id": "0f9608e7-8126-412f-873b-19f89be26b80",
                                                "sense_id": "aa3d44d2-2264-3ca2-b726-4a99f8f065b4",
                                                "text": "À force de gongoriser, ses pêcheuses finissent par ressembler à des demoiselles du Lac."
                                            },
                                            {
                                                "example_id": "fdde1db6-99a3-4b1d-b393-f98974cbca27",
                                                "sense_id": "aa3d44d2-2264-3ca2-b726-4a99f8f065b4",
                                                "text": "Son fichu de pêcheuse entr’ouvert laissait voir la naissance de sa gorge, menue et délicate."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pêcheuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c3aa730d-7c92-3620-b214-3546f77e6422",
                                        "entry_id": "6f686430-af2e-31ff-b497-0f8fba59759b",
                                        "glosses": [
                                            "Féminin singulier de pêcheur."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2c15fa5-4f7f-42fd-8efd-7f15ca1cab25",
                                                "sense_id": "c3aa730d-7c92-3620-b214-3546f77e6422",
                                                "text": "Parmi les quadrupèdes digitigrades, qui sont en grand nombre, on distingue la martre vison et la martre pekan ou belette pêcheuse, dans les forêts du nord …."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
