                    {
                        "sense_id": "95336915-6af7-3a2d-8103-22b777c14416",
                        "entry_id": "1ee59116-d2a1-3889-9bff-45c9f71381c9",
                        "glosses": [
                            "die Auswirkungen des zunehmenden Alters zeigen, Alterung, der Alterungsprozess"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "867cc84c-c50f-4a81-8b64-9ae3b0a7d574",
                                "sense_id": "95336915-6af7-3a2d-8103-22b777c14416",
                                "text": "Ageing has a significant impact on society. - Die Alterung hat eine erhebliche Auswirkung auf die Gesellschaft."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "610b18ba-2195-37c0-bcb3-7665f213245c",
                        "entry_id": "1ee59116-d2a1-3889-9bff-45c9f71381c9",
                        "glosses": [
                            "eine gewünschte Qualität erreichen, Reifung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b6c2f8e-74bf-44e5-b693-a1cfc5945b64",
                                "sense_id": "610b18ba-2195-37c0-bcb3-7665f213245c",
                                "text": "In the process of ageing, the primary fruit characteristics of the wines change. - Im Reifungsprozess ändern sich die grundlegenden Fruchteigenschaften der Weine."
                            }
                        ],
                        "sense_index_json": "\"2\""
