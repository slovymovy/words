                                        "examples": [
                                            {
                                                "example_id": "a648aebb-b393-4add-9cc5-ce5b25a095bc",
                                                "sense_id": "4438159d-ca8a-3f81-961a-d3c1f70e220c",
                                                "text": "J’ajoute que j’ai reçu un téléphone discret de la Police judiciaire qui voulait savoir si la drogue y était pour quelque chose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18f5f299-1f2f-3a72-9465-edc1e1beae41",
                                        "entry_id": "7a65d2f4-2a1f-3b96-ac91-9d4e1ff5e741",
                                        "glosses": [
                                            "Toilettes."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc78f66d-f583-44ff-b979-e7aa07c74813",
                                                "sense_id": "18f5f299-1f2f-3a72-9465-edc1e1beae41",
                                                "text": "Ainsi on évitera le populaire chiottes, dénotativement fort bien fait et adéquat, mais auquel adhèrent des connotations déplaisantes. On lui substitue : lieux d’aisances, lieu, cabinet, lavabos, voire téléphone ou water-closet, w.-c. vécés, etc."
                                            }
                                        ]
                                    }
                                ]
