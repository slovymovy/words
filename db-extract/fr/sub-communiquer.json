                ],
                "senses": [
                    {
                        "sense_id": "ece1fd5e-f91e-3dcd-9204-af4d042db854",
                        "entry_id": "253904c1-f7d1-3f6c-80f1-db4b67e7d3ba",
                        "glosses": [
                            "Communiquer quelque chose, sans en parler explicitement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ca0232f-12c3-47d8-adf1-6f40284a2a99",
                                "sense_id": "ece1fd5e-f91e-3dcd-9204-af4d042db854",
                                "text": "Ici, toute anecdote permettant de sub-communiquer que vous êtes capable de bien vous entendre avec les autres, même dans des situations complexes, est extrêmement positive."
                            },
                            {
                                "example_id": "8e4c2267-8bef-4794-b17f-ff88a57c176c",
                                "sense_id": "ece1fd5e-f91e-3dcd-9204-af4d042db854",
                                "text": "Le but c'est de sub-communiquer à travers votre photo que vous avez une vie sociale très riche, et que chaque instant est un moment de bonheur."
                            },
                            {
                                "example_id": "6efea190-18e9-498b-af67-5780a9f2dede",
                                "sense_id": "ece1fd5e-f91e-3dcd-9204-af4d042db854",
                                "text": "Quand vous affichez un sourire, vous sub-communiquez un état d’esprit extrêmement positif qui ne peut que mettre votre cible à l’aise et toute ouïe à ce que vous avez à lui dire."
                            }
                        ]
                    }
                ],
