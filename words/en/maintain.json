{
    "word_family": [
        "maintenance",
        "maintainable",
        "maintainer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dd30672e-1ca9-3fcb-bcdb-e04432acfc28",
                    "sense_definition": "To make a situation, activity, or state continue in the same way or at the same standard.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to <w>maintain</w> close contact with our customers to keep them happy.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>поддерживать</w> тесный контакт с нашими клиентами, чтобы они были довольны.",
                                "tr": "Müşterilerimizi mutlu etmek için onlarla yakın teması <w>sürdürmemiz</w> gerekiyor.",
                                "zh": "我们需要与客户<w>保持</w>密切联系，以使他们满意。"
                            }
                        },
                        {
                            "text": "It can be difficult to <w>maintain</w> a healthy lifestyle while traveling for work.",
                            "target_lang_translations": {
                                "ru": "Бывает трудно <w>поддерживать</w> здоровый образ жизни во время рабочих поездок.",
                                "tr": "İş için seyahat ederken sağlıklı bir yaşam tarzını <w>korumak</w> zor olabilir.",
                                "zh": "出差时很难<w>维持</w>健康的生活方式。"
                            }
                        }
                    ],
                    "synonyms": [
                        "preserve",
                        "sustain",
                        "keep up",
                        "keep"
                    ],
                    "antonyms": [
                        "abandon"
                    ],
                    "common_phrases": [
                        "maintain order",
                        "maintain contact",
                        "maintain a relationship",
                        "maintain balance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать так, чтобы ситуация, деятельность или состояние продолжались таким же образом или на том же уровне.",
                        "tr": "Bir durumun, faaliyetin veya halin aynı şekilde veya aynı standartta devam etmesini sağlamak.",
                        "zh": "使某种情况、活动或状态以同样的方式或标准持续下去。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поддерживать",
                                "target_lang_sense_clarification": "сохранять на определенном уровне"
                            },
                            {
                                "target_lang_word": "сохранять",
                                "target_lang_sense_clarification": "беречь, не давать исчезнуть"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sürdürmek",
                                "target_lang_sense_clarification": "bir durumu devam ettirmek"
                            },
                            {
                                "target_lang_word": "korumak",
                                "target_lang_sense_clarification": "mevcut seviyeyi muhafaza etmek"
                            },
                            {
                                "target_lang_word": "muhafaza etmek",
                                "target_lang_sense_clarification": "aynı durumda tutmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "维持",
                                "target_lang_sense_clarification": "使某种状态持续下去"
                            },
                            {
                                "target_lang_word": "保持",
                                "target_lang_sense_clarification": "维持某种状态或水平"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73a66209-d239-375f-9844-a36683fce344",
                    "sense_definition": "To keep a building, machine, or road in good condition by checking or repairing it regularly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city council failed to <w>maintain</w> the roads properly during the winter.",
                            "target_lang_translations": {
                                "ru": "Городской совет не смог должным образом <w>содержать</w> дороги зимой.",
                                "tr": "Belediye meclisi kış boyunca yolların <w>bakımını</w> düzgün bir şekilde <w>yapmayı</w> başaramadı.",
                                "zh": "市议会没能在冬季对道路进行妥善的<w>维护</w>。"
                            }
                        },
                        {
                            "text": "You must <w>maintain</w> your car regularly to prevent expensive breakdowns.",
                            "target_lang_translations": {
                                "ru": "Вы должны регулярно <w>обслуживать</w> свой автомобиль, чтобы предотвратить дорогостоящие поломки.",
                                "tr": "Pahalı arızaları önlemek için arabanızın düzenli olarak <w>bakımını yapmalısınız</w>.",
                                "zh": "你必须定期对汽车进行<w>保养</w>，以防止昂贵的故障。"
                            }
                        }
                    ],
                    "synonyms": [
                        "service",
                        "repair"
                    ],
                    "common_phrases": [
                        "maintain the car",
                        "maintain equipment",
                        "properly maintain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Содержать здание, машину или дорогу в хорошем состоянии, регулярно проверяя или ремонтируя их.",
                        "tr": "Bir binayı, makineyi veya yolu düzenli olarak kontrol ederek veya onararak iyi durumda tutmak.",
                        "zh": "通过定期检查或修理，使建筑物、机器或道路保持良好状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обслуживать",
                                "target_lang_sense_clarification": "проводить техническое обслуживание"
                            },
                            {
                                "target_lang_word": "содержать",
                                "target_lang_sense_clarification": "в исправности"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "bakım yapmak",
                                "target_lang_sense_clarification": "düzenli onarım ve kontrol sağlamak"
                            },
                            {
                                "target_lang_word": "bakımını üstlenmek",
                                "target_lang_sense_clarification": "iyi durumda tutmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "维护",
                                "target_lang_sense_clarification": "对设备或设施进行保养和修理"
                            },
                            {
                                "target_lang_word": "保养",
                                "target_lang_sense_clarification": "通过定期检查使机器等保持良好状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24ffa960-8252-3bfb-a5f5-22c80410e5e3",
                    "sense_definition": "To say firmly that something is true, especially when others disagree or doubt it.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The suspect continued to <w>maintain</w> his innocence throughout the long trial.",
                            "target_lang_translations": {
                                "ru": "Подозреваемый продолжал <w>настаивать</w> на своей невиновности на протяжении всего долгого судебного процесса.",
                                "tr": "Şüpheli, uzun duruşma boyunca masum olduğunu <w>savunmaya</w> devam etti.",
                                "zh": "在漫长的审判过程中，嫌疑人一直<w>坚称</w>自己是无辜的。"
                            }
                        },
                        {
                            "text": "She <w>maintains</w> that the decision was made without her knowledge or consent.",
                            "target_lang_translations": {
                                "ru": "Она <w>утверждает</w>, что решение было принято без ее ведома или согласия.",
                                "tr": "Kararın kendi bilgisi veya rızası olmadan alındığını <w>iddia ediyor</w>.",
                                "zh": "她<w>坚持</w>认为该决定是在她不知情或未同意的情况下做出的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "assert",
                        "claim",
                        "insist",
                        "state"
                    ],
                    "common_phrases": [
                        "maintain innocence",
                        "maintain that"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твердо заявлять, что что-то является правдой, особенно когда другие не согласны или сомневаются в этом.",
                        "tr": "Özellikle başkaları aksi görüşte olduğunda veya şüphe duyduğunda, bir şeyin doğru olduğunu kararlılıkla ifade etmek.",
                        "zh": "坚定地声称某事是真实的，尤其是在他人不同意或怀疑时。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утверждать",
                                "target_lang_sense_clarification": "заявлять как факт"
                            },
                            {
                                "target_lang_word": "настаивать",
                                "target_lang_sense_clarification": "твердо стоять на своем мнении"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "savunmak",
                                "target_lang_sense_clarification": "bir iddiayı veya durumu kararlılıkla dile getirmek"
                            },
                            {
                                "target_lang_word": "iddia etmek",
                                "target_lang_sense_clarification": "doğru olduğunu ileri sürmek"
                            },
                            {
                                "target_lang_word": "ısrar etmek",
                                "target_lang_sense_clarification": "görüşünün arkasında durmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "坚持",
                                "target_lang_sense_clarification": "坚决主张或认为"
                            },
                            {
                                "target_lang_word": "坚称",
                                "target_lang_sense_clarification": "坚定地声称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d122c8e2-64df-3a00-b4b6-cc35e1a0f418",
                    "sense_definition": "To provide someone with the things they need to live, such as money, food, or a home.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His small salary is barely enough to <w>maintain</w> his wife and three children.",
                            "target_lang_translations": {
                                "ru": "Его маленькой зарплаты едва хватает, чтобы <w>содержать</w> жену и троих детей.",
                                "tr": "Düşük maaşı, karısını ve üç çocuğunu <w>geçindirmeye</w> ucu ucuna yetiyor.",
                                "zh": "他微薄的薪水勉强够<w>供养</w>妻子和三个孩子。"
                            }
                        },
                        {
                            "text": "The scholarship helped to <w>maintain</w> the student during his years of research.",
                            "target_lang_translations": {
                                "ru": "Стипендия помогала <w>содержать</w> студента в годы его исследований.",
                                "tr": "Burs, araştırma yılları boyunca öğrenciyi <w>geçindirmeye</w> yardımcı oldu.",
                                "zh": "奖学金帮助该学生度过了他的研究岁月，为他提供了生活<w>保障</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "support",
                        "provide for"
                    ],
                    "common_phrases": [
                        "maintain a family"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обеспечивать кого-либо необходимым для жизни, например деньгами, едой или жильем.",
                        "tr": "Birine yaşamak için ihtiyaç duyduğu para, yiyecek veya barınak gibi şeyleri sağlamak.",
                        "zh": "为某人提供生活必需品，如金钱、食物或住所。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "содержать",
                                "target_lang_sense_clarification": "материально обеспечивать"
                            },
                            {
                                "target_lang_word": "обеспечивать",
                                "target_lang_sense_clarification": "предоставлять средства к существованию"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "geçindirmek",
                                "target_lang_sense_clarification": "maddi ihtiyaçlarını karşılamak"
                            },
                            {
                                "target_lang_word": "bakmak",
                                "target_lang_sense_clarification": "birinin geçimini sağlamak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "供养",
                                "target_lang_sense_clarification": "提供生活所需"
                            },
                            {
                                "target_lang_word": "抚养",
                                "target_lang_sense_clarification": "供养子女或家人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}