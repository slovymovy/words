                "senses": [
                    {
                        "sense_id": "2b3fb662-fc23-3690-99d4-20bc400c86c2",
                        "entry_id": "e3021993-7274-3d56-9177-4215b13f9e73",
                        "glosses": [
                            "Celui qui organise selon un plan déterminé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81ac6f07-7139-4b03-905a-4b629280afe1",
                                "sense_id": "2b3fb662-fc23-3690-99d4-20bc400c86c2",
                                "text": "Or, en 1945, les planificateurs de la Marine canadienne avaient finalement des arguments convaincants pour justifier une marine qui servirait les intérêts nationaux plutôt qu’une simple unité de la flotte du Commonwealth, comme elle l’avait été avant la guerre. C’était un résultat naturel de la grande contribution du pays à la victoire et un résultat qui allait donner forme à la Marine d’aujourd’hui."
                            }
                        ]
                    },
                    {
                        "sense_id": "199a07b8-9b34-39f1-8a58-b68ccd13c4d9",
                        "entry_id": "e3021993-7274-3d56-9177-4215b13f9e73",
                        "glosses": [
                            "Celui qui bâtit des projets de développement économique."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "54706bd3-4ae5-4e28-b972-2f70f7cbfb84",
                                "sense_id": "199a07b8-9b34-39f1-8a58-b68ccd13c4d9",
                                "text": "Les planificateurs ont tous : 1 fait confiance aux résultats de l’économie de marché : 2 cherché dans les structures du passé le modèle des structures du présent et de l’avenir"
                            }
                        ]
                    }
                ],
