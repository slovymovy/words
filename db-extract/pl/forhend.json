                                        "glosses": [
                                            "All of the part of a horse which is before the rider."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab45ee7b-6fa2-4068-8ab9-492144e7db22",
                                                "sense_id": "f8d2755c-fb8d-33e8-adf8-755be40ff2b7",
                                                "text": "[…]those horses which are of a chicke Forehand, short necked"
