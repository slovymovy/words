                    {
                        "translation_id": "e6da8b36-ccd6-410a-8095-e595da7f9110",
                        "source_entry_id": "341f8558-2f6d-375f-87cc-dec7e458dd9a",
                        "source_sense_id": "dc864947-dffd-38c8-bfac-a9d306fdbece",
                        "source_sense_description": "writings recognized by some but not all Christians",
                        "target_lang_word": "apokryf",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apokryf",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "d0531550-f019-31f8-91e6-9f778d99e5f1",
                                        "entry_id": "b7e11f0b-49ed-3987-8606-4e5d3fd6ee9a",
                                        "glosses": [
                                            "pierwotnie teksty ukryte dotyczące religii, do których dostęp tylko posiadali nieliczni, posiadający określoną wiedzę"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "ae9d8e3c-dc55-3ee1-a227-a0a8ff0ae682",
                                        "entry_id": "b7e11f0b-49ed-3987-8606-4e5d3fd6ee9a",
                                        "glosses": [
                                            "teksty religijne, okołobiblijne, spisane w czasach starożytnych, ale które nie wchodzą do kanonu Biblii danego Kościoła"
                                        ],
                                        "tags": [
                                            "Biblical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "419a0f97-2d7b-4a68-af34-19bf2b990204",
                                                "sense_id": "ae9d8e3c-dc55-3ee1-a227-a0a8ff0ae682",
                                                "text": "Dawniej za apokryfy uznano pisma niepewnego pochodzenia, które nie zostały przyjęte do kanonu pism świętych."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "cf4b9b19-ac51-3ff6-82e8-a5ccedbdcf31",
                                        "entry_id": "b7e11f0b-49ed-3987-8606-4e5d3fd6ee9a",
                                        "glosses": [
                                            "utwór rzekomo autentyczny, np. podrobione dzieło wielkiego pisarza lub recenzja nienieistniejącej książki"
                                        ],
                                        "tags": [
                                            "metaphoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1039bdd-86bd-4c70-8355-08d393e71629",
                                                "sense_id": "cf4b9b19-ac51-3ff6-82e8-a5ccedbdcf31",
                                                "text": "Apokryfy Lema to zbiór recenzji i wstępów nieistniejących książek."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9cd277b5-7c97-4022-87ea-f3bbfda2c3d5",
                        "source_entry_id": "341f8558-2f6d-375f-87cc-dec7e458dd9a",
                        "source_sense_id": "dc864947-dffd-38c8-bfac-a9d306fdbece",
                        "source_sense_description": "writings recognized by some but not all Christians",
                        "target_lang_word": "апо́криф",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "апо́криф",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8228eae6-825c-37b3-a1cb-088e729fd07e",
                                        "entry_id": "9dfa6684-baf5-3f9b-9298-6d7e683a0fe9",
                                        "glosses": [
                                            "религ. произведение с библейским сюжетом, содержащее отступление от официального вероучения и потому отвергаемое церковью, не включённое в библейский канон"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "994d1799-0790-4272-8352-0f6a93d5fe54",
                                                "sense_id": "8228eae6-825c-37b3-a1cb-088e729fd07e",
                                                "text": "Достоевский был очень хорошо знаком не только с канонической христианской литературой, но и с апокрифами."
                                            },
                                            {
                                                "example_id": "cc5eb390-6a85-4f8c-a14c-629e298847a1",
                                                "sense_id": "8228eae6-825c-37b3-a1cb-088e729fd07e",
                                                "text": "Авторы апокрифов не скупились на описание чудес, которыми в детстве якобы поражал всех Иисус."
                                            },
                                            {
                                                "example_id": "392f1006-ec2a-4108-863c-0ff37198bb00",
                                                "sense_id": "8228eae6-825c-37b3-a1cb-088e729fd07e",
                                                "text": "Эти сочинения не признаются церковью священными; их принято называть апокрифами (тайными, подложными, от греческого апокрифос — тайный)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d89c141b-9b3b-3bbe-9986-e38201db7f3d",
                                        "entry_id": "9dfa6684-baf5-3f9b-9298-6d7e683a0fe9",
                                        "glosses": [
                                            "перен., разг. сочинение, произведение, предполагаемое авторство или подлинность которого не подтверждено или маловероятно"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32d15c9f-77c3-4125-aa7a-1a9892b2d25c",
                                                "sense_id": "d89c141b-9b3b-3bbe-9986-e38201db7f3d",
                                                "text": "Вообще, ходило и ходит множество слухов о планах Сталина в Израиле, множество апокрифов о помощи и репарациях, но нигде не было ничего конкретного."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
