{
    "word_family": [
        "shovelful",
        "shoveler",
        "snowshovel"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8d3a30de-c630-3534-9aaa-0c4da2a3a6e8",
                    "sense_definition": "A hand tool with a long handle and a broad blade used for lifting and moving loose material like earth, snow, or coal.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the heavy snowstorm, I had to use a <w>shovel</w> to clear the sidewalk in front of my house.",
                            "target_lang_translations": {
                                "ru": "После сильного снегопада мне пришлось использовать <w>лопату</w>, чтобы расчистить тротуар перед домом.",
                                "zh": "大雪过后，我不得不拿<w>铲子</w>清理屋前的便道。"
                            }
                        },
                        {
                            "text": "The gardener grabbed a garden <w>shovel</w> to move the pile of mulch into the flower beds.",
                            "target_lang_translations": {
                                "ru": "Садовник взял садовую <w>лопату</w>, чтобы перенести кучу мульчи на клумбы.",
                                "zh": "园丁拿了一把园艺<w>铲子</w>，把那堆覆盖物移到花坛里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "spade"
                    ],
                    "common_phrases": [
                        "garden shovel",
                        "snow shovel",
                        "coal shovel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ручной инструмент с длинной ручкой и широким лезвием, используемый для подъема и перемещения сыпучих материалов, таких как земля, снег или уголь.",
                        "zh": "一种带有长柄和宽刃的手动工具，用于提升和移动泥土、雪或煤等松散材料。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лопата",
                                "target_lang_sense_clarification": "инструмент для работы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "铲子",
                                "target_lang_sense_clarification": "通用的手动挖掘工具"
                            },
                            {
                                "target_lang_word": "铁锹",
                                "target_lang_sense_clarification": "金属材质的挖掘工具"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2069cb38-b8bd-3ef7-8c42-38ffea3909f3",
                    "sense_definition": "A large mechanical bucket or part of an excavator used for heavy digging and moving earth.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "machinery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The massive <w>shovel</w> of the excavator lifted tons of dirt in a single scoop.",
                            "target_lang_translations": {
                                "ru": "Массивный <w>ковш</w> экскаватора поднял тонны земли за один раз.",
                                "zh": "挖掘机巨大的<w>铲斗</w>一次就挖起了数吨泥土。"
                            }
                        },
                        {
                            "text": "Operators must be careful when maneuvering the mechanical <w>shovel</w> near the power lines.",
                            "target_lang_translations": {
                                "ru": "Операторы должны быть осторожны при маневрировании механическим <w>ковшом</w> вблизи линий электропередач.",
                                "zh": "操作员在靠近电线的地方操纵机械<w>铲斗</w>时必须格外小心。"
                            }
                        }
                    ],
                    "synonyms": [
                        "scoop",
                        "bucket"
                    ],
                    "common_phrases": [
                        "mechanical shovel",
                        "steam shovel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большой механический ковш или часть экскаватора, используемая для тяжелых земляных работ.",
                        "zh": "挖掘机上用于重型挖掘和移动土方的大型机械斗。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ковш",
                                "target_lang_sense_clarification": "механический, экскаваторный"
                            },
                            {
                                "target_lang_word": "черпак",
                                "target_lang_sense_clarification": "механический"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "铲斗",
                                "target_lang_sense_clarification": "挖掘机或装载机的机械部件"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "abbc3477-326b-3f6e-8ee5-69c7bc985631",
                    "sense_definition": "To lift and move material using a shovel.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "manual labor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers spent the entire afternoon <w>shoveling</w> gravel into the deep potholes on the road.",
                            "target_lang_translations": {
                                "ru": "Рабочие провели весь день, <w>засыпая лопатами</w> гравий в глубокие выбоины на дороге.",
                                "zh": "工人们整个下午都在往路上的深坑里<w>铲</w>碎石。"
                            }
                        },
                        {
                            "text": "It is much easier to <w>shovel</w> snow when it is fresh and light rather than icy.",
                            "target_lang_translations": {
                                "ru": "Гораздо проще <w>чистить</w> снег, когда он свежий и легкий, а не обледенелый.",
                                "zh": "趁雪还新鲜松软时<w>铲</w>雪，比结冰后要容易得多。"
                            }
                        }
                    ],
                    "synonyms": [
                        "scoop",
                        "dig"
                    ],
                    "common_phrases": [
                        "shovel snow",
                        "shovel coal",
                        "shovel dirt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поднимать и перемещать материал с помощью лопаты.",
                        "zh": "使用铲子提升和移动材料。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кидать лопатой",
                                "target_lang_sense_clarification": "перемещать материал"
                            },
                            {
                                "target_lang_word": "расчищать",
                                "target_lang_sense_clarification": "с помощью лопаты"
                            },
                            {
                                "target_lang_word": "перелопачивать",
                                "target_lang_sense_clarification": "перемещать большие объемы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "铲",
                                "target_lang_sense_clarification": "用铲子进行挖掘或移动动作"
                            },
                            {
                                "target_lang_word": "铲除",
                                "target_lang_sense_clarification": "用铲子清理掉某物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f105528-dde5-37d6-b04e-a72c45ced198",
                    "sense_definition": "To move something quickly and in large quantities, often in a rough or careless way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Because he was late for the meeting, he started <w>shoveling</w> food into his mouth.",
                            "target_lang_translations": {
                                "ru": "Так как он опаздывал на встречу, он начал <w>запихивать</w> еду в рот.",
                                "zh": "因为开会要迟到了，他开始往嘴里<w>塞</w>食物。"
                            }
                        },
                        {
                            "text": "The hungry teenager began to <w>shovel</w> breakfast as if he had not eaten in days.",
                            "target_lang_translations": {
                                "ru": "Голодный подросток начал <w>жадно поглощать</w> завтрак, как будто не ел несколько дней.",
                                "zh": "那个饥肠辘辘的少年开始<w>狼吞虎咽</w>地吃早餐，好像好几天没吃东西一样。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stuff",
                        "cram"
                    ],
                    "common_phrases": [
                        "shovel food",
                        "shovel into"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used regarding eating quickly"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро и в больших количествах перемещать что-либо, часто грубо или небрежно.",
                        "zh": "快速且大量地移动某物，通常指粗鲁或不小心地动作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запихивать",
                                "target_lang_sense_clarification": "жадно есть"
                            },
                            {
                                "target_lang_word": "заглатывать",
                                "target_lang_sense_clarification": "быстро есть"
                            },
                            {
                                "target_lang_word": "грести",
                                "target_lang_sense_clarification": "быстро перемещать что-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "塞",
                                "target_lang_sense_clarification": "指快速且不顾形象地进食"
                            },
                            {
                                "target_lang_word": "狼吞虎咽",
                                "target_lang_sense_clarification": "形容吃得又快又急"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}