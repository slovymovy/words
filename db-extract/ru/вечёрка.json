                            {
                                "example_id": "e27736da-eaac-4fe1-a0ed-57ddc3058192",
                                "sense_id": "7a3e845f-7c56-3329-bbb7-02faf89fb4b8",
                                "text": "Я раскрыл приложение к «Вечёрке» и стал читать объявления."
                            },
                            {
                                "example_id": "d4e2d99f-256b-4d38-8ef0-47d8eb3e9a71",
                                "sense_id": "7a3e845f-7c56-3329-bbb7-02faf89fb4b8",
                                "text": "Вам придется покупать её в киосках, хотя приобрести «Вечёрку» в киосках трудно ― она не залеживается."
                            }
                        ]
