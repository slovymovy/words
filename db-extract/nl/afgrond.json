                    {
                        "translation_id": "b6a3df36-d2c3-4ed8-8130-7a36059c2775",
                        "source_entry_id": "b614a5c7-33c5-38d9-b2c5-23d94b4b1ea3",
                        "source_sense_id": "4756c2c7-cb3a-3bce-976a-df905375c08b",
                        "source_sense_description": "een grote steile diepte",
                        "target_lang_word": "gouffre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gouffre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5db9bb54-0f01-376e-aba3-3402d1b89735",
                                        "entry_id": "fa3d3727-75a2-38f2-ad0a-4e640d8cc21e",
                                        "glosses": [
                                            "Cavité souterraine naturelle, large et profonde."
                                        ],
                                        "tags": [
                                            "Spéléologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a473429-6f42-4c14-8215-150286b99314",
                                                "sense_id": "5db9bb54-0f01-376e-aba3-3402d1b89735",
                                                "text": "A l’ouest du village de Mosnay, près du hameau des Jadrets, s’ouvre un gouffre explorable. Il s’agit de la perte d’un ruisseau coulant depuis le sud et qui, au nord de la D 30a, s’encaisse profondément dans un ravin […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e8a1fb8-6263-3186-ac08-68974a32d326",
                                        "entry_id": "fa3d3727-75a2-38f2-ad0a-4e640d8cc21e",
                                        "glosses": [
                                            "Cavité souterraine naturelle, large et profonde.",
                                            "Une telle cavité qui s’ouvre à la surface du sol."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ec363236-70c1-3332-b8f5-e1fec831279d",
                                        "entry_id": "fa3d3727-75a2-38f2-ad0a-4e640d8cc21e",
                                        "glosses": [
                                            "Ce qui donne une impression de vide abyssal, en parlant de certaines choses."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85044d2f-4955-4a7c-81ab-f166cf68a626",
                                                "sense_id": "ec363236-70c1-3332-b8f5-e1fec831279d",
                                                "text": "Et d’autres lames s’abattaient sans cesse sur l’épave. La mer achevait son œuvre. Encore quelques chocs, et la coque effondrée allait disparaître dans le gouffre tourbillonnant du chenal."
                                            },
                                            {
                                                "example_id": "fdf174ef-dd98-47a0-a085-1372c7b0334a",
                                                "sense_id": "ec363236-70c1-3332-b8f5-e1fec831279d",
                                                "text": "Il voit Paris, non comme un gouffre où l’on sombre et qui vous dévore, mais comme un rêve flamboyant, où l’or se gagne, s’enlève à larges pelletées, où le plaisir est sans fin."
                                            },
                                            {
                                                "example_id": "37c95866-1454-4f4b-8682-f8c26c4460a3",
                                                "sense_id": "ec363236-70c1-3332-b8f5-e1fec831279d",
                                                "text": "Le gouffre de l’oubli."
                                            },
                                            {
                                                "example_id": "85ba2d99-5a8f-4db7-a2ea-826b7a5d4976",
                                                "sense_id": "ec363236-70c1-3332-b8f5-e1fec831279d",
                                                "text": "Le gouffre du passé."
                                            },
                                            {
                                                "example_id": "ff29906e-9b3c-46d4-9722-bde8623a932d",
                                                "sense_id": "ec363236-70c1-3332-b8f5-e1fec831279d",
                                                "text": "Le gouffre de l’éternité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af7fe95b-2231-3733-9fec-31cbbc4b503b",
                                        "entry_id": "fa3d3727-75a2-38f2-ad0a-4e640d8cc21e",
                                        "glosses": [
                                            "Chose qui cause des frais, des sacrifices, des pertes immenses."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04aead6f-af0b-4178-bb3b-56c80cab7e1b",
                                                "sense_id": "af7fe95b-2231-3733-9fec-31cbbc4b503b",
                                                "text": "« Crossrail », une sorte de RER traversant Londres d’est en ouest, qui devait montrer la capacité du secteur privé à construire une grosse infrastructure dans les délais, se révèle être un gouffre financier que les pouvoirs publics sont sans cesse appelés à combler."
                                            },
                                            {
                                                "example_id": "b3c0b63b-67ef-4392-a775-eec0f75ae6a6",
                                                "sense_id": "af7fe95b-2231-3733-9fec-31cbbc4b503b",
                                                "text": "Les maisons de jeu sont des gouffres pour les jeunes gens."
                                            },
                                            {
                                                "example_id": "472e3829-fa19-4399-90d2-32728160b7c9",
                                                "sense_id": "af7fe95b-2231-3733-9fec-31cbbc4b503b",
                                                "text": "Ce pays devint un gouffre où s’engloutissaient nos armées et nos trésors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8d43781-3d3c-3fbb-994e-1e3c1c9abe61",
                                        "entry_id": "fa3d3727-75a2-38f2-ad0a-4e640d8cc21e",
                                        "glosses": [
                                            "Chose qui cause des frais, des sacrifices, des pertes immenses.",
                                            "Grand nombre de malheurs, de misères, de chagrins qui accablent à la fois une personne, une famille, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35dcaa52-df8a-4c5c-8292-2049bd864ff3",
                                                "sense_id": "c8d43781-3d3c-3fbb-994e-1e3c1c9abe61",
                                                "text": "Dans quel gouffre d’horreurs cet événement nous a plongés !"
                                            },
                                            {
                                                "example_id": "977a3617-a48b-4c11-bde0-258945e04279",
                                                "sense_id": "c8d43781-3d3c-3fbb-994e-1e3c1c9abe61",
                                                "text": "Tomber dans un gouffre de malheurs, de misères."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5ff2e3e-d0a0-39ba-8b1a-d4760ee513e4",
                                        "entry_id": "fa3d3727-75a2-38f2-ad0a-4e640d8cc21e",
                                        "glosses": [
                                            "Chose qui cause des frais, des sacrifices, des pertes immenses.",
                                            "Grand dissipateur de richesses."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f265f3cf-dafb-4610-8615-29ad62ab2929",
                                                "sense_id": "d5ff2e3e-d0a0-39ba-8b1a-d4760ee513e4",
                                                "text": "C’est un gouffre que cet homme-là."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eebbb915-8b41-31a7-aea2-c89c758bfd93",
                                        "entry_id": "fa3d3727-75a2-38f2-ad0a-4e640d8cc21e",
                                        "glosses": [
                                            "Grande distance qui sépare les humains, les choses."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b87bcdd-bf26-473f-bc00-3ac3b62eb565",
                                                "sense_id": "eebbb915-8b41-31a7-aea2-c89c758bfd93",
                                                "text": "Mais cela est impossible, il y a un gouffre entre nous ; notre éducation, notre culte nous défendent également de le franchir."
                                            },
                                            {
