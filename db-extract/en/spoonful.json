                                            {
                                                "example_id": "83a851f7-e99d-4d89-b639-e13556473f6b",
                                                "sense_id": "a0722439-77c5-32e4-a13d-f796101b1b00",
                                                "text": "Le médecin l’avait mise au régime de l’huile de foie de morue —c’était la mode alors—, une cuillerée à bouche tous les matins…"
                                            },
                                            {
                                                "example_id": "961f799b-d7ab-473f-9518-7b0b997415fa",
                                                "sense_id": "a0722439-77c5-32e4-a13d-f796101b1b00",
                                                "text": "– Je vais lui préparer du lait froid avec une goutte d'eau-de-vie et, si elle a soif, je lui en donnerai quelques cuillerées."
                                            },
                                            {
                                                "example_id": "9d5efe0d-b2ec-4e1e-8d25-1753de94c189",
                                                "sense_id": "a0722439-77c5-32e4-a13d-f796101b1b00",
                                                "text": "Le matin, comme les marins chinois, elle avale, à jeun, une cuillerée de « pétrole lampant » (huile de lampe) et se fait elle-même un café qu'elle savoure, attablée dans sa petite cuisine, une oreille collée à son transistor."
                                            },
                                            {
                                                "example_id": "309f32a9-3aa3-4692-b4ea-192f4bb23ff9",
                                                "sense_id": "a0722439-77c5-32e4-a13d-f796101b1b00",
                                                "text": "Elle s’approcha de la petite table, posa une tasse de chocolat épais et brûlant, me reprit des mains la petite cuiller et me mit elle-même quatre cuillerées de sucre."
                                            }
                                        ]
