                "senses": [
                    {
                        "sense_id": "b8367d5a-898d-39f3-bedf-5937daa0232d",
                        "entry_id": "adb7d49e-03e8-3ca3-be75-0b25dc5e9eea",
                        "glosses": [
                            "To cut into slices and pickle."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "139a4093-4e74-49d8-b007-74a82feb175e",
                                "sense_id": "b8367d5a-898d-39f3-bedf-5937daa0232d",
                                "text": "My foot-boy shall eat pheasants, calvered salmons, / Knots, godwits, lampreys: I myself will have / The beards of barbels, served instead of salads […]"
                            },
                            {
                                "example_id": "1a146133-2a3e-42a9-b5bf-622b73a12f37",
                                "sense_id": "b8367d5a-898d-39f3-bedf-5937daa0232d",
                                "text": "Great lords sometimes / For change leave calver'd salmon and eat sprats."
                            }
                        ]
                    },
                    {
                        "sense_id": "be2a92bc-7103-3652-829f-8fbe64cd2480",
                        "entry_id": "adb7d49e-03e8-3ca3-be75-0b25dc5e9eea",
                        "glosses": [
                            "To bear, or be susceptible of, being calvered."
                        ],
                        "tags": [
                            "intransitive",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "4b29bb09-3a36-4385-bc31-c770afa17bae",
                                "sense_id": "be2a92bc-7103-3652-829f-8fbe64cd2480",
                                "text": "[A Grayling's] flesh will so easily calver that […][it] is very good meat at all times."
                            }
                        ]
                    }
