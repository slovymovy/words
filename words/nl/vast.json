                    "frequency": "High",
                    "semantic_group_id": "zekerheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We gaan <w>vast</w> en zeker winnen tijdens de wedstrijd morgen.",
                            "target_lang_translations": {
                                "en": "We are <w>certainly</w> going to win during the match tomorrow."
