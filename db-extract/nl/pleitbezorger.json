        "nl-extract.jsonl": [
            {
                "entry_id": "55e8991c-cb0e-3ed1-91fe-ffdafe696ba7",
                "word": "pleitbezorger",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "6ea43ed0-ee90-4d7b-aed2-c83f5bffaf88",
                        "entry_id": "55e8991c-cb0e-3ed1-91fe-ffdafe696ba7",
                        "tags": [
                            "plural"
                        ],
                        "form": "pleitbezorgers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6aac430e-57f7-30d8-b6b0-4995ffec7bd1",
                        "entry_id": "55e8991c-cb0e-3ed1-91fe-ffdafe696ba7",
                        "glosses": [
                            "iemand die in woord en soms ook in daad, een bepaalde zaak of persoon verdedigt"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "11439c92-770c-4f87-981e-9731b4324004",
                                "sense_id": "6aac430e-57f7-30d8-b6b0-4995ffec7bd1",
                                "text": "In 2010 noemde Frieda Brepoels kernwapens een anachronisme en in 2013 was Theo Francken nog een grote pleitbezorger van een kernwapenvrij België. Het is dus voor ministers Jan Jambon en Steven Vandeput en staatssecretaris Francken nog niet te laat om een gênante bocht te vermijden."
                            },
                            {
                                "example_id": "a0b1199b-e415-45dc-adb8-fe21af4db44d",
                                "sense_id": "6aac430e-57f7-30d8-b6b0-4995ffec7bd1",
                                "text": "Het optuigen van het Europees Stabilisatie Mechanisme (ESM) en het op termijn omvormen hiervan in een Europees Monetair Fonds staan zeker niet haaks op het Nederlands belang. Ook de Duitse minister Schäuble is hier een pleitbezorger van."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "868f9aba-5ade-486e-8197-96bfc93a67c0",
                        "source_entry_id": "55e8991c-cb0e-3ed1-91fe-ffdafe696ba7",
                        "source_sense_id": "6aac430e-57f7-30d8-b6b0-4995ffec7bd1",
                        "source_sense_description": "iemand die in woorden een bepaalde zaak of persoon verdedigt",
                        "target_lang_word": "advocate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "advocate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6fc5f67f-35e8-3439-b1ad-4bea43faf001",
                                        "entry_id": "212f323c-ddb5-3560-b9dd-597dd73bf4a1",
                                        "glosses": [
                                            "Someone whose job is to speak for someone's case in a court of law; a counsel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bb336914-4a65-3068-b368-4c631418eb07",
                                        "entry_id": "212f323c-ddb5-3560-b9dd-597dd73bf4a1",
                                        "glosses": [
                                            "Anyone who argues the case of another; an intercessor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "978950c4-9f92-40dd-8e80-7386fc17c113",
                                                "sense_id": "bb336914-4a65-3068-b368-4c631418eb07",
                                                "text": "I neuer did incense his Maiestie / Against the Duke of Clarence, but haue bin / An earnest aduocate to plead for him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93afc1fd-bee3-34b2-9df7-b190db84971f",
                                        "entry_id": "212f323c-ddb5-3560-b9dd-597dd73bf4a1",
                                        "glosses": [
                                            "A person who speaks in support of something, or someone; proponent"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "590d52a3-30ff-463d-8bb1-d199528a5577",
                                                "sense_id": "93afc1fd-bee3-34b2-9df7-b190db84971f",
                                                "text": "\"I think,\" replied the young advocate, unwilling to give up a point in which his feelings were interested, \"that even you would believe in Walter Maynard's success in life, if you knew him. What has brought the world to its present state, but individual talent?\""
                                            },
                                            {
                                                "example_id": "8e104790-f0b5-404e-a5d7-f21d77cd987b",
                                                "sense_id": "93afc1fd-bee3-34b2-9df7-b190db84971f",
                                                "text": "He became a tireless advocate for the needs of adults with IMD throughout Britain and internationally."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd970d09-9700-38ee-9786-a1020a92b1c3",
                                        "entry_id": "212f323c-ddb5-3560-b9dd-597dd73bf4a1",
                                        "glosses": [
                                            "A person who supports others to make their voices heard, or ideally for them to speak up for themselves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71c58a7f-b2b8-4cc2-82c7-1d51328dc813",
                                                "sense_id": "cd970d09-9700-38ee-9786-a1020a92b1c3",
                                                "text": "Since she started working with her advocate, she has become much more confident."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "advocate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5f1b4c8-afd8-32b7-a867-91733b053c72",
                                        "entry_id": "c9ef5334-8687-3c23-b690-493d69ce4719",
                                        "glosses": [
                                            "To plead in favour of; to defend by argument, before a tribunal or the public; to support, vindicate, or recommend publicly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef261671-bfbe-4378-abd5-eb2cec0193d6",
                                                "sense_id": "f5f1b4c8-afd8-32b7-a867-91733b053c72",
                                                "text": "7 March, 1624, Robert Sanderson, sermon at the Assizes, at Lincoln\nTo advocate the cause of thy client."
                                            },
                                            {
                                                "example_id": "1d2e36a7-3c8f-4bd7-8901-5e078a456eb8",
                                                "sense_id": "f5f1b4c8-afd8-32b7-a867-91733b053c72",
                                                "text": "16 June, 1784, Edmund Burke, speech on reform of representation in the House of Commons\nThis is the only thing distinct and sensible, that has been advocated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16ac9866-372c-3eab-8ad4-043aceb0d1d8",
                                        "entry_id": "c9ef5334-8687-3c23-b690-493d69ce4719",
                                        "glosses": [
                                            "To encourage support for something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a248cddc-3757-4522-9a69-347ae971eb35",
                                                "sense_id": "16ac9866-372c-3eab-8ad4-043aceb0d1d8",
                                                "text": "I like trees, but I do not advocate living in them."
                                            },
                                            {
                                                "example_id": "8df54040-fa7a-46a5-894d-9dab93d634f0",
                                                "sense_id": "16ac9866-372c-3eab-8ad4-043aceb0d1d8",
                                                "text": "Those who have advocated the closure of the G.C. have so far failed to say by which alternative route this North-to-West traffic could be carried."
                                            },
                                            {
                                                "example_id": "28fa8113-857e-4b46-bb6c-b2c2ac8a9de4",
                                                "sense_id": "16ac9866-372c-3eab-8ad4-043aceb0d1d8",
                                                "text": "Varys even leans on Jon to assume the Iron Throne, which means he very well knew he wasn’t going to be around much longer, if he’s openly advocating others commit treason as well."
                                            },
                                            {
                                                "example_id": "bec56d7c-df63-4572-b7f4-9cfeb51eeac8",
                                                "sense_id": "16ac9866-372c-3eab-8ad4-043aceb0d1d8",
                                                "text": "Back in 1963, how could Beeching advocate closure of the electrified Liverpool-Southport commuter route, just because its books didn't balance? The busy North London line between Richmond and Broad Street was also for the axe, as was Leeds to Bradford and Ilkley."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77a21df7-9cba-3719-a5e7-fcfebe6acc02",
                                        "entry_id": "c9ef5334-8687-3c23-b690-493d69ce4719",
                                        "glosses": [
                                            "To engage in advocacy."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0b6a547-db8a-4db0-8002-4857e9a11f5f",
                                                "sense_id": "77a21df7-9cba-3719-a5e7-fcfebe6acc02",
                                                "text": "We have been advocating for changes in immigration law."
                                            },
                                            {
                                                "example_id": "5b90697b-0ea5-4b93-9bb5-8239a0a1123b",
                                                "sense_id": "77a21df7-9cba-3719-a5e7-fcfebe6acc02",
                                                "text": "And why has no one in the [rail] industry advocated for a universal requirement for face covering (even if it's just a scarf or old tea towel), [...]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29e1e4d1-baf7-3df5-afc9-1b5df3f06785",
                                        "entry_id": "c9ef5334-8687-3c23-b690-493d69ce4719",
                                        "glosses": [
                                            "To appeal from an inferior court to the Court of Session."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b9b29c91-4270-3711-811f-93aa4090dd04",
                                        "entry_id": "c9ef5334-8687-3c23-b690-493d69ce4719",
                                        "glosses": [
                                            "To call a case before itself for decision."
                                        ],
                                        "tags": [
                                            "in higher courts"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
