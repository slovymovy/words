                    "sense_definition": "Third-person singular simple present indicative of <w>brace</w>.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "grammatical_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>braces</w> herself against the wall during the earthquake.",
                            "target_lang_translations": {
                                "ru": "Во время землетрясения она <w>упирается</w> в стену."
                            }
                        },
                        {
                            "text": "He <w>braces</w> the structure to prevent it from collapsing.",
                            "target_lang_translations": {
                                "ru": "Он <w>укрепляет</w> конструкцию, чтобы она не рухнула."
