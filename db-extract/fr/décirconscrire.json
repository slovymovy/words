                ],
                "senses": [
                    {
                        "sense_id": "25d5968b-7efe-324a-b3cc-e0e5ea439ef7",
                        "entry_id": "981a326a-e864-39b7-8675-28ca1154a1ba",
                        "glosses": [
                            "Arrêter de circonscrire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56bc608b-3b91-49fe-8ac2-561fa907c8f0",
                                "sense_id": "25d5968b-7efe-324a-b3cc-e0e5ea439ef7",
                                "text": "Ils gardent, mais depuis un dehors décirconscrit, une « maison ouverte », au lieu et au non-lieu d’une menace toujours imminente."
                            },
                            {
                                "example_id": "5f3560f4-0760-45f6-be3e-ad92dd3fb058",
                                "sense_id": "25d5968b-7efe-324a-b3cc-e0e5ea439ef7",
                                "text": "Mais cette forme change incessamment dans tous les éléments qui la composent; la vie ne se circonscrit et ne se limite que pour se décirconscrire et se délimiter incessamment."
                            }
                        ]
                    }
                ],
