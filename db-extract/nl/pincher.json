                        "sense_id": "2c7c8fa8-bfea-3f05-9ebe-fe07cd7fa0f3",
                        "entry_id": "8f8729f8-8649-3485-af77-919d022d2bd0",
                        "glosses": [
                            "hondenras, hondensoort waarbij de oren en de staart gecoupeerd werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df570815-bb1b-4b9e-9704-0e3bdcb8d3a3",
                                "sense_id": "2c7c8fa8-bfea-3f05-9ebe-fe07cd7fa0f3",
                                "text": "De honden zijn er in alle maten en soorten: labrador, dalmatiër, poedel, Jack Russel, chihuahua, pincher, terriër en vuilnisbakras. Dagelijks gaat er 25 kilo vlees met brokken in de hongerige magen."
                            },
                            {
                                "example_id": "f742c0f5-b2a1-42e7-89ce-cf944eaca8e6",
                                "sense_id": "2c7c8fa8-bfea-3f05-9ebe-fe07cd7fa0f3",
                                "text": "Raquel Salden nam het mandje van de driekleurige pincher mee. Het teefje is een jaar oud en ontsnapte toen Raquel bij vrienden op bezoek was."
                            },
                            {
                                "example_id": "12954c81-2f1f-4b0f-b825-331692d0a310",
                                "sense_id": "2c7c8fa8-bfea-3f05-9ebe-fe07cd7fa0f3",
                                "text": "„Oh niet”, reageert Esther quasiverbaasd. „Nee, beetje vies voor andere reizigers als er straks allemaal haren op de bank liggen.” Gewillig pakt Esther haar pincher op. „Een derdehandsje, van Marktplaats.” Ze kijkt bezorgd. „Hij heeft een rugzakje.” Dan licht haar gezicht op. „Iedereen verdient een tweede kans.” Carlto blaft boos."
                            }
                        ]
                    }
