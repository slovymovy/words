                    {
                        "sense_id": "a4905ccb-63cb-3fc9-b849-137c246c5389",
                        "entry_id": "7c8d98e3-2607-3fe4-92c6-d34c67eacace",
                        "glosses": [
                            "wiedza na jakiś temat, umiejętność"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0a1ac20-df56-40f2-b628-5bb7b6b70655",
                                "sense_id": "a4905ccb-63cb-3fc9-b849-137c246c5389",
                                "text": "Znajomość ortografii przydaje się każdemu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "a5fa020d-0edb-354e-9334-ce9e25e0714a",
                        "entry_id": "7c8d98e3-2607-3fe4-92c6-d34c67eacace",
                        "glosses": [
                            "utrzymywanie z kimś ogólnych stosunków"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74c966b0-0c11-4e3a-86a2-90011e91c301",
                                "sense_id": "a5fa020d-0edb-354e-9334-ce9e25e0714a",
                                "text": "Znajomość z prezydentem miasta może przynieść korzyści."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "451de379-524c-37ee-b4ea-2b8fd2d0601d",
                        "entry_id": "7c8d98e3-2607-3fe4-92c6-d34c67eacace",
                        "glosses": [
                            "relacja osób, opierająca się na utrzymywaniu ogólnych, niezbyt bliskich stosunków"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0606104f-620d-411f-8686-f8cc38e4ece9",
                                "sense_id": "451de379-524c-37ee-b4ea-2b8fd2d0601d",
                                "text": "Ta znajomość przerodziła się w przyjaźń."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8b966f6-ec4b-4be3-9631-115cf94eb073",
                        "source_entry_id": "7c8d98e3-2607-3fe4-92c6-d34c67eacace",
                        "source_sense_id": "a4905ccb-63cb-3fc9-b849-137c246c5389",
                        "target_lang_word": "knowledge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "knowledge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81cf8837-b729-30c3-ae57-4a86de5eebd3",
                                        "entry_id": "4395da95-c501-3bc5-b595-1ad89b149b1d",
                                        "glosses": [
                                            "The fact of knowing about something; general understanding or familiarity with a subject, place, situation etc."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83cafedc-1b17-4364-8114-fb9d6df625d9",
                                                "sense_id": "81cf8837-b729-30c3-ae57-4a86de5eebd3",
                                                "text": "His knowledge of Iceland was limited to what he'd seen on the Travel Channel."
                                            },
                                            {
                                                "example_id": "3ecdec63-3302-445c-90e9-8f7c9435d89e",
                                                "sense_id": "81cf8837-b729-30c3-ae57-4a86de5eebd3",
                                                "text": "He has a lot of knowledge on the Indus Valley Civilization."
                                            },
                                            {
                                                "example_id": "0caf3bbe-2d79-4f9e-9e5b-94f617c72a13",
                                                "sense_id": "81cf8837-b729-30c3-ae57-4a86de5eebd3",
                                                "text": "[N]ow ſuch a liue vngodly, vvithout a care of doing the wil of the Lord (though they profeſſe him in their mouths, yea though they beleeue and acknowledge all the Articles of the Creed, yea haue knowledge of the Scripturs) yet if they liue vngodly, they deny God, and therefore ſhal be denied, […]"
                                            },
                                            {
                                                "example_id": "98b52466-7429-4fd0-8699-2970857640a6",
                                                "sense_id": "81cf8837-b729-30c3-ae57-4a86de5eebd3",
                                                "text": "The yawning gap in neuroscientists’ understanding of their topic is in the intermediate scale of the brain’s anatomy. Science has a passable knowledge of how individual nerve cells, known as neurons, work. It also knows which visible lobes and ganglia of the brain do what. But how the neurons are organised in these lobes and ganglia remains obscure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e56cddd-e2a5-35a7-a47d-578d67e05052",
                                        "entry_id": "4395da95-c501-3bc5-b595-1ad89b149b1d",
                                        "glosses": [
                                            "Awareness of a particular fact or situation; a state of having been informed or made aware of something."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17dda8ab-792f-4200-a756-d2e9325c20c0",
                                                "sense_id": "2e56cddd-e2a5-35a7-a47d-578d67e05052",
                                                "text": "He had always intended to visit him, though to the last always assuring his wife that he should not go; and till the evening after the visit was paid she had no knowledge of it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c15fe2da-c335-3116-aa1b-04dba0e54034",
                                        "entry_id": "4395da95-c501-3bc5-b595-1ad89b149b1d",
                                        "glosses": [
                                            "Intellectual understanding; the state of appreciating truth or information."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c23d8df-77a2-4314-9aa5-282b43bce60a",
                                                "sense_id": "c15fe2da-c335-3116-aa1b-04dba0e54034",
                                                "text": "Knowledge consists in recognizing the difference between good and bad decisions."
                                            },
                                            {
                                                "example_id": "0f186054-918d-42cd-9ccd-c2f6a1aec96d",
                                                "sense_id": "c15fe2da-c335-3116-aa1b-04dba0e54034",
                                                "text": "Our ſoules, whoſe faculties can comprehend\nThe wondrous Architecture of the world:\nAnd meaſure euery wandring planets courſe,\nStill climing after knowledge infinite, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "470ba5de-312c-3bf8-af3d-3ee959577aa4",
                                        "entry_id": "4395da95-c501-3bc5-b595-1ad89b149b1d",
                                        "glosses": [
                                            "Familiarity or understanding of a particular skill, branch of learning etc."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1857fd50-b26b-497a-90dd-47543885617e",
                                                "sense_id": "470ba5de-312c-3bf8-af3d-3ee959577aa4",
                                                "text": "Does your friend have any knowledge of hieroglyphs, perchance?"
                                            },
                                            {
                                                "example_id": "fe0b2b66-502c-4f39-a163-e5d7589537f7",
                                                "sense_id": "470ba5de-312c-3bf8-af3d-3ee959577aa4",
                                                "text": "A secretary should have a good knowledge of shorthand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f14a3f86-1141-3e15-8efb-3f519b6ecea9",
                                        "entry_id": "4395da95-c501-3bc5-b595-1ad89b149b1d",
                                        "glosses": [
                                            "Justified true belief"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "310b349b-42b3-3fbc-a037-155142b44fee",
                                        "entry_id": "4395da95-c501-3bc5-b595-1ad89b149b1d",
                                        "glosses": [
                                            "Sexual intimacy or intercourse (now usually in phrase carnal knowledge)."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8376b61f-32e8-49a8-a0d4-1da75429116c",
                                                "sense_id": "310b349b-42b3-3fbc-a037-155142b44fee",
                                                "text": "Every time that he had knowledge of her he would leave, either in the bed, or in her cushion-cloth, or by her looking-glass, or in some place where she must needs find it, a piece of money[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f15980f7-cd9f-326f-b4ed-1ff0f263c43f",
                                        "entry_id": "4395da95-c501-3bc5-b595-1ad89b149b1d",
                                        "glosses": [
                                            "Information or intelligence about something; notice."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82ee24c7-8773-4d65-9e03-f221bd0c1c04",
                                                "sense_id": "f15980f7-cd9f-326f-b4ed-1ff0f263c43f",
                                                "text": "Item, if any ship be in danger[…], every man to bear towards her, answering her with one light for a short time, and so to put it out again; thereby to give knowledge that they have seen her token."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ce225ab-78e6-39dd-954d-8d4288845d4a",
                                        "entry_id": "4395da95-c501-3bc5-b595-1ad89b149b1d",
                                        "glosses": [
                                            "The total of what is known; all information and products of learning."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5eca161-ffdc-4c4c-9537-c1bf803cacee",
                                                "sense_id": "2ce225ab-78e6-39dd-954d-8d4288845d4a",
                                                "text": "His library contained the accumulated knowledge of the Greeks and Romans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab0da668-f14e-3691-b909-e373964fab75",
                                        "entry_id": "4395da95-c501-3bc5-b595-1ad89b149b1d",
                                        "glosses": [
                                            "Something that can be known; a branch of learning; a piece of information; a science."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f376df47-f4ca-48c0-9e42-13036ac83b6c",
                                                "sense_id": "ab0da668-f14e-3691-b909-e373964fab75",
                                                "text": "he weakened his braines much, as all men doe, who over nicely and greedily will search out those knowledges [translating cognoissances], which hang not for their mowing, nor pertaine unto them."
                                            },
                                            {
                                                "example_id": "fc449520-0fe7-4018-85a1-8c413827e802",
                                                "sense_id": "ab0da668-f14e-3691-b909-e373964fab75",
                                                "text": "There is a great difference in the delivery of the mathematics, which are the most abstracted of knowledges."
                                            },
                                            {
                                                "example_id": "d02d1101-9dcd-49a3-b4af-a744b4104beb",
                                                "sense_id": "ab0da668-f14e-3691-b909-e373964fab75",
                                                "text": "There are by now many feminisms (Tong, 1989; Humm, 1992).[…]They are in shifting alliance or contest with postmodern critiques, which at times seem to threaten the very category 'women' and its possibilities for a feminist politics. These debates inform this attempt at worlding women—moving beyond white western power centres and their dominant knowledges[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "571a8314-e069-3f6d-ad49-ab6037c4d2fb",
                                        "entry_id": "4395da95-c501-3bc5-b595-1ad89b149b1d",
                                        "glosses": [
                                            "Acknowledgement."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "85f7f23d-4845-3770-aeb6-cb6044a63e0d",
                                        "entry_id": "4395da95-c501-3bc5-b595-1ad89b149b1d",
                                        "glosses": [
                                            "Notice, awareness."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a78dc2eb-11f9-4716-aa2c-bdf73623f9e2",
                                                "sense_id": "85f7f23d-4845-3770-aeb6-cb6044a63e0d",
                                                "text": "Then she fell on her face, and bowed herself to the ground, and said unto him, Why have I found grace in thine eyes, that thou shouldest take knowledge of me, seeing I am a stranger?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a9996b2-008b-354a-9445-59d63fdb3d7e",
                                        "entry_id": "4395da95-c501-3bc5-b595-1ad89b149b1d",
                                        "glosses": [
                                            "The deep familiarity with certain routes and places of interest required by taxicab drivers working in London, England."
                                        ],
                                        "tags": [
                                            "UK",
                                            "informal",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a14b1f7b-aca3-4a38-b941-c9aef26771f3",
                                                "sense_id": "0a9996b2-008b-354a-9445-59d63fdb3d7e",
                                                "text": "There is only one sure way to memorise the runs and that is to follow them, either on foot, cycle or motor cycle; hence, the familiar sight of would-be cabbies learning the knowledge during evenings and weekends."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "knowledge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ac12f406-deaf-3146-adc5-8941893ac4f0",
                                        "entry_id": "78c3fc20-b35b-36dc-83e6-5dcecb0fb9b8",
                                        "glosses": [
                                            "To confess as true; to acknowledge."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88ba2377-b7fa-4554-b8a8-c8f42a76c172",
                                                "sense_id": "ac12f406-deaf-3146-adc5-8941893ac4f0",
                                                "text": "Then went oute to hym Jerusalem, and all Jury, and all the region rounde aboute Jordan, and were baptised of hym in Jordan, knoledging their synnes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e7c5835-0924-44b9-8450-73336e929a0f",
                        "source_entry_id": "7c8d98e3-2607-3fe4-92c6-d34c67eacace",
                        "source_sense_id": "a4905ccb-63cb-3fc9-b849-137c246c5389",
                        "target_lang_word": "знание",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "знание",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "add01658-bb8b-3620-bfa8-4fa07883c5ac",
                                        "entry_id": "4010157d-ab1e-3e8a-accf-ea3167716ffd",
                                        "glosses": [
                                            "обладание какими-либо сведениями, осведомленность в какой-либо области"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43e19066-dc1f-42ba-b9a2-5af8ae04cf3b",
                                                "sense_id": "add01658-bb8b-3620-bfa8-4fa07883c5ac",
                                                "text": "Им не всегда необходимо детальное знание библиотеки ITIL; достаточно освоение общих принципов, которые они затем адаптируют к своей работе."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82fb71ec-2323-3a11-999e-d10bd5f0bb9f",
                                        "entry_id": "4010157d-ab1e-3e8a-accf-ea3167716ffd",
                                        "glosses": [
                                            "результат познания действительности, проверенный практикой, её верное отражение в сознании человека"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5d1452c-9d37-4c74-92f3-992e4bdcae1c",
                                                "sense_id": "82fb71ec-2323-3a11-999e-d10bd5f0bb9f",
                                                "text": "Совокупность усвоенных индивидом теорий образует «личное знание», которое носит субъективный характер."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c35a941-4aaa-34a5-89b3-157525b069a3",
                                        "entry_id": "4010157d-ab1e-3e8a-accf-ea3167716ffd",
                                        "glosses": [
                                            "совокупность сведений, составляющих какую-либо науку, её отрасль"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c2c5007-08ff-4770-830d-5098f02d2c85",
                                                "sense_id": "4c35a941-4aaa-34a5-89b3-157525b069a3",
                                                "text": "Не есть ли геометрия наука о фикциях, т. е., просто говоря, ложное знание?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
