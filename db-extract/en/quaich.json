                "senses": [
                    {
                        "sense_id": "22902941-290a-36ce-8b72-74c3e6fb2ec4",
                        "entry_id": "5d72bdd8-a081-333d-b222-a91b882ae1a4",
                        "glosses": [
                            "A traditional shallow, two-handled cup of Scottish origin symbolizing friendship, originally used to toast the arrival or departure of a visitor."
                        ],
                        "tags": [
                            "Scotland",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "10a1a33b-3d9b-4daf-a6d6-32cf5ca84c8d",
                                "sense_id": "22902941-290a-36ce-8b72-74c3e6fb2ec4",
                                "text": "The quaighs were deep, the liquor strong, / And on the tale the yeoman throng, / Had made a comment sage and long, [...]"
                            },
                            {
                                "example_id": "e8eff0f1-d328-409e-8ae0-8da012682c71",
                                "sense_id": "22902941-290a-36ce-8b72-74c3e6fb2ec4",
                                "text": "Every evening through all the summer Lampusa put out for them before her rock-hewn kitchen a silver quaich of milk; then she summoned the creatures with a low call."
                            },
                            {
                                "example_id": "578a01ac-c2b1-4dc8-9fff-b5e5de1c796a",
                                "sense_id": "22902941-290a-36ce-8b72-74c3e6fb2ec4",
                                "text": "A quaich was an ideal gift when made from the timber of the fifteenth-century Alloway Kirk, which, \"as you will have read in 'Tam O'Shanter', was a ruin in [Robert] Burns day but had the roof nearly intact until the turn of that century, (18th-19th). The rafters and other load bearing beams were ideal for souvenir makers\" (letter, Nov. 19, 1991)."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ba496f8-6169-37b1-8ba0-ae8d56a176fd",
                        "entry_id": "5d72bdd8-a081-333d-b222-a91b882ae1a4",
                        "glosses": [
                            "Any two-handled drinking vessel or trophy."
                        ],
