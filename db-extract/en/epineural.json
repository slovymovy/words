                        "entry_id": "7e8abd59-48bb-3b59-8817-b0191d695ac5",
                        "glosses": [
                            "Related to or situated upon a nerve or nerve structure, especially on the epineurium."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "41e38fee-60bb-481c-ba55-721b0c97a946",
                                "sense_id": "753dd46c-7c03-3835-b58c-4544f25b4198",
                                "text": "Additional one to two epineural stiches are placed between the holding stiches after completion of the fascicular repairs."
                            },
                            {
                                "example_id": "9d0d9635-62e0-465a-b27e-fd2d2c0b2dee",
                                "sense_id": "753dd46c-7c03-3835-b58c-4544f25b4198",
                                "text": "Another possibility for direct nerve repair is epineural sleeve neurorrhaphy ."
                            },
                            {
                                "example_id": "b35e45b8-0f8a-49dc-8b48-cfc3f98fd28f",
                                "sense_id": "753dd46c-7c03-3835-b58c-4544f25b4198",
                                "text": "The nerve graft was implanted using epineural suture according to standard technique on both sites of the nerve graft captation."
                            }
                        ]
                    },
                    {
                        "sense_id": "3f09668d-ab28-368f-bc1f-3c48aa85e6fd",
                        "entry_id": "7e8abd59-48bb-3b59-8817-b0191d695ac5",
                        "glosses": [
                            "Arising from or associated with the neurapophysis of a vertebra"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "1d119a5e-d1ea-46ca-96bb-45a7c1255da6",
                                "sense_id": "3f09668d-ab28-368f-bc1f-3c48aa85e6fd",
                                "text": "Thus it is clear that these investigators regarded the hyponeural canal as being connected with the anterior part of what we now know to be the radial epineural canal and the epineural ring canal."
                            },
                            {
                                "example_id": "7b0f438d-7674-4486-a65a-bdc0a28fa755",
                                "sense_id": "3f09668d-ab28-368f-bc1f-3c48aa85e6fd",
                                "text": "Epineural bones are primitively fused to neural arches in teleosts ( Patterson and Johnson , 1995 , p . 11 ) ."
                            }
                        ]
                    }
