                                        "examples": []
                                    },
                                    {
                                        "sense_id": "58858146-a25e-3e61-addb-2cd7b7b0b7ee",
                                        "entry_id": "31f07dc4-ad28-3eea-b41b-594662a379a1",
                                        "glosses": [
                                            "The central part of a human body; the waist."
                                        ],
                                        "tags": [],
                                        "examples": [
