                "senses": [
                    {
                        "sense_id": "21fbe1e9-3f53-3f65-9d69-cc8cc5a2e1de",
                        "entry_id": "d92ecc63-28a1-34c1-8208-86cda9c7e8d3",
                        "glosses": [
                            "elektrische Entladung durch Funken oder Blitzbildung"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "131945dc-2d49-4157-b83c-b150f5cd7e2e",
                                "sense_id": "21fbe1e9-3f53-3f65-9d69-cc8cc5a2e1de",
                                "text": "„Koronaentladungen zweier Spitzen unterschiedlicher Ladung.“"
                            },
                            {
                                "example_id": "7c628588-87bb-498a-bd5a-c8e9cc1270ee",
                                "sense_id": "21fbe1e9-3f53-3f65-9d69-cc8cc5a2e1de",
                                "text": "„An Hochspannungsleitungen finden ständig kleine Entladungen, die Koronaentladungen, statt.“"
                            },
                            {
                                "example_id": "2dd8551e-1023-41d1-b05a-9992b4f5e998",
                                "sense_id": "21fbe1e9-3f53-3f65-9d69-cc8cc5a2e1de",
                                "text": "„Die ultraviolette Strahlung und die stille elektrische Koronaentladung.“"
                            },
                            {
                                "example_id": "d3f9a51a-39b4-4158-84af-dd2d9c2741df",
                                "sense_id": "21fbe1e9-3f53-3f65-9d69-cc8cc5a2e1de",
                                "text": "„Insbesondere berechnet Aleksandrov in Computermodellen den Einfluss, den die sogenannten Korona-Entladungen auf einen sich anbahnenden Blitz haben. „Korona-Entladungen kennt man vielleicht eher unter dem Namen Elmsfeuer“, erläutert Aleksandrov. „Sie entstehen an hohen, spitzen Objekten, wenn ein starkes elektrisches Feld in der Luft liegt.“ Elmsfeuer sind bläulich züngelnde Lichterscheinungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
