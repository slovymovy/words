                    }
                },
                {
                    "sense_id": "365f4dd0-0853-3309-91ad-dcb44c610599",
                    "sense_definition": "A shortened term for a <w>Bulgarian</w> split squat, a lower-body exercise.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "exercise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should include <w>Bulgarians</w> in your leg day routine to target your glutes.",
