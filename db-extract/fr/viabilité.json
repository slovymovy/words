                    {
                        "translation_id": "f53d2f41-9092-4ca0-abfe-254937e5a6f4",
                        "source_entry_id": "aaeff03e-a4fa-3f15-925a-e89c3b39d4dc",
                        "source_sense_id": "e4369acc-cb1c-3f75-8303-070b49bb24cf",
                        "source_sense_description": "Caractère de ce qui est viable",
                        "target_lang_word": "viability",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "viability",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "748f2dae-3053-3c9c-b4e3-b2c49c665a44",
                                        "entry_id": "1fd38353-5962-312c-b678-f26cb3a2b86b",
                                        "glosses": [
                                            "The property of being viable; the ability to live or to succeed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3ea9381-7d9b-4702-9afa-460675b24484",
                                                "sense_id": "748f2dae-3053-3c9c-b4e3-b2c49c665a44",
                                                "text": "1904, Hugo DeVries, Species and Varieties, Their Origin by Mutation\nOrdinarily these altered organs are sterile, but in some instances a very small quantity of seed is produced, and when testing their viability I succeeded in raising a few plants from them."
                                            },
                                            {
                                                "example_id": "e7cc06a2-e779-442b-bbb1-9c6e04b15560",
                                                "sense_id": "748f2dae-3053-3c9c-b4e3-b2c49c665a44",
                                                "text": "1980, Jimmy Carter, State of the Union Address\nIn making its grants the Endowment will increase its emphasis on techniques which stimulate support for the humanities from non-Federal sources, in order to reinforce our tradition of private philanthropy in this field, and to insure and expand the financial, viability of our cultural institutions and life."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6f2f326-3976-4c6a-9d41-7516bcfa9426",
                        "source_entry_id": "aaeff03e-a4fa-3f15-925a-e89c3b39d4dc",
                        "source_sense_id": "e4369acc-cb1c-3f75-8303-070b49bb24cf",
                        "source_sense_description": "Caractère de ce qui est viable",
                        "target_lang_word": "βιωσιμότητα",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "βιωσιμότητα",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "8740b4ad-c1f1-3ff6-be8c-e8a0b63e544b",
                                        "entry_id": "f6e429b3-a0ec-38ed-8245-0ce08b2986f9",
                                        "glosses": [
                                            "η ιδιότητα του βιώσιμου, η ικανότητα ενός πράγματος να συνεχίσει την ύπαρξή του"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "501048e9-716d-46f9-b83e-1a236fc392e3",
                                                "sense_id": "8740b4ad-c1f1-3ff6-be8c-e8a0b63e544b",
                                                "text": "Η βιωσιμότητα μιας επιχείρησης εξαρτάται από προσωπικούς και οικονομικούς παράγοντες."
                                            },
                                            {
                                                "example_id": "bb6eb66b-d088-42b7-9e66-3e8f245d834d",
                                                "sense_id": "8740b4ad-c1f1-3ff6-be8c-e8a0b63e544b",
                                                "text": "Όταν μιλούν για «ισορροπίες» και «βιωσιμότητες» (*)"
                                            },
                                            {
                                                "example_id": "e610cd19-752d-4b90-91df-96204801003e",
                                                "sense_id": "8740b4ad-c1f1-3ff6-be8c-e8a0b63e544b",
                                                "text": "Σύμφωνα με τον κ. Θωμόπουλο, επισημαίνει η ΟΤΟΕ, όλα τα βήματα της ανακεφαλαιοποίησης των τραπεζών αφορούν «στοιχεία, δείκτες, περικοπές, κεφάλαια, βιωσιμότητες, μετοχική σύνθεση και άλλα τεχνικά χαρακτηριστικά». (*)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fac35416-8b62-4667-9ba5-6045937bbf91",
                        "source_entry_id": "aaeff03e-a4fa-3f15-925a-e89c3b39d4dc",
                        "source_sense_id": "e4369acc-cb1c-3f75-8303-070b49bb24cf",
