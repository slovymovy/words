                                        "entry_id": "90cc2a0c-e818-3500-be44-d8954f7c062b",
                                        "glosses": [
                                            "durch Fehlschläge oder Enttäuschungen deprimiert, entmutigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02871aaf-c20a-41c0-a95a-b19dee191cc1",
                                                "sense_id": "d02e059b-f4ac-3259-bc87-1ec2971c0b6b",
                                                "text": "„Wer niedergeschlagen ist, der fühlt seine Kräfte gelähmt, es fehlt ihm an der Freudigkeit und Munterkeit, die den Menschen zu frischer und anhaltender Tätigkeit fähig macht.“"
                                            },
                                            {
                                                "example_id": "ceb4f934-242f-41d3-b0e8-350cdfa2edd5",
                                                "sense_id": "d02e059b-f4ac-3259-bc87-1ec2971c0b6b",
                                                "text": "Zhao war niedergeschlagen bei dem Gedanken, dass seine Frau die bessere Lyrikerin sei. (Internetbeleg)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
