                    {
                        "translation_id": "70a142c6-6075-4e6e-9054-941efc173a93",
                        "source_entry_id": "b7759431-b3d3-303e-bb64-12ec45922d12",
                        "source_sense_id": "0c66f639-4b27-3cf5-a430-122b8a5fac25",
                        "source_sense_description": "durchtriebener, listiger Mensch",
                        "target_lang_word": "roublard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roublard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "42914f1d-d794-3034-b16d-22e6aa4f0602",
                                        "entry_id": "24db43c9-16c5-36b2-b294-2d48f7e233e2",
                                        "glosses": [
                                            "Plein d’astuce, malin, rusé."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec738a3c-c6e9-4fc7-9d9b-0f3a69c4af60",
                                                "sense_id": "42914f1d-d794-3034-b16d-22e6aa4f0602",
                                                "text": "Au milieu d'indicibles tripotages, ce grotesque filou n'abdiquait aucune de ses anciennes prétentions, et on retrouvait toujours en lui le désopilant roublard qui fit offrir, un jour, au comte de Chambord, de se convertir publiquement au catholicisme, si on le faisait marquis."
                                            },
                                            {
                                                "example_id": "587e4269-bc38-4ae4-8e10-322f32c3e897",
                                                "sense_id": "42914f1d-d794-3034-b16d-22e6aa4f0602",
                                                "text": "Duranthon, roublard nouveau jeu, enlevait aux métayers leurs dernières libertés, les réduisait au rôle de machines à travail."
                                            },
                                            {
                                                "example_id": "62b7c296-f8fa-42a1-adfe-5d2d6560618f",
                                                "sense_id": "42914f1d-d794-3034-b16d-22e6aa4f0602",
                                                "text": "Il est une proie toute désignée pour une fille coquette et roublarde."
                                            },
                                            {
                                                "example_id": "2b92154e-de34-4e86-8b3a-2da68e63750b",
                                                "sense_id": "42914f1d-d794-3034-b16d-22e6aa4f0602",
                                                "text": "Il est très roublard, méfiez-vous, il a plus d’un tour dans son sac."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "roublard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0650f365-5b85-399e-bf95-ed43cf443cc5",
                                        "entry_id": "dd0f86c1-e184-3f4b-9f78-2f2aa2795e7d",
                                        "glosses": [
                                            "Personne roublarde."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c51fc21-e7ed-4bec-be34-f23f84cb23d3",
                                                "sense_id": "0650f365-5b85-399e-bf95-ed43cf443cc5",
                                                "text": "Hollande le roublard contre Merkel la secrète : pour une fois le défi de ces deux animaux politiques n’est pas de se dévorer, mais de parvenir à s’entendre."
                                            },
                                            {
                                                "example_id": "bc0c7625-e7db-483e-aae3-030361040a61",
                                                "sense_id": "0650f365-5b85-399e-bf95-ed43cf443cc5",
                                                "text": "Il ne manque que deux noms sur cette liste de roublards, mais je les gardais pour la fin en raison de leur proximité avec l’ancien président et de leurs liens avec lui bien avant son arrivée sur la scène politique."
                                            },
                                            {
                                                "example_id": "18289535-8856-4d91-9f97-af05b6eaa058",
                                                "sense_id": "0650f365-5b85-399e-bf95-ed43cf443cc5",
                                                "text": "C’est un vieux roublard qui en a roulé plus d’un dans la farine !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58d522d3-4380-32a9-87d7-18c052576d31",
                                        "entry_id": "dd0f86c1-e184-3f4b-9f78-2f2aa2795e7d",
                                        "glosses": [
                                            "Classe de combattant, capable de combats sournois et de tours agiles."
                                        ],
                                        "tags": [
                                            "Jeux de rôle",
                                            "Jeux de rôle d’action-aventure"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
