                    {
                        "sense_id": "c67e8128-8209-3f10-bacb-180612d010d5",
                        "entry_id": "9abf55bd-363c-3127-8a9e-e0c8c318c69c",
                        "glosses": [
                            "eine weibliche Person, die von der Prostitution einer oder mehrerer Frauen (oder Männer) lebt und die Betroffenen dabei ausbeutet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "084df51d-5371-4867-b714-d174d2b7cc1d",
                                "sense_id": "c67e8128-8209-3f10-bacb-180612d010d5",
                                "text": "„Eine von der Schweiz mit internationalem Haftbefehl gesuchte mutmaßliche Zuhälterin ist der Polizei am Flughafen Frankfurt ins Netz gegangen.“"
                            },
                            {
                                "example_id": "53701866-eaf5-4057-8786-9d83ddd05105",
                                "sense_id": "c67e8128-8209-3f10-bacb-180612d010d5",
                                "text": "„Bei Suad kam hinzu, dass dieser Beruf in ihrer Familie einiges Ansehen genoss, denn ihre Mutter ist auch eine Hure gewesen, bevor sie die Zuhälterin für ihre Tochter wurde.“"
                            }
                        ],
