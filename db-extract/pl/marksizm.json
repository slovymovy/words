                                "target_senses": [
                                    {
                                        "sense_id": "ffa4710e-8d7c-3d7c-9f81-28cb5f72f475",
                                        "entry_id": "2a0f81f1-dc8d-361e-9b32-ee014d145c76",
                                        "glosses": [
                                            "The socialist and communist philosophy and political program founded by Karl Marx and Friedrich Engels."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6d08be2f-3ebd-3ed3-b541-6dc724cf30d6",
                                        "entry_id": "2a0f81f1-dc8d-361e-9b32-ee014d145c76",
                                        "glosses": [
                                            "The socialist and communist theory of the followers of Karl Marx and Friedrich Engels; a radical, revolutionary political philosophy that aims to capture state power, introduce a dictatorship of the proletariat, and then progress to communism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "664c6384-5a31-3229-82ff-89434e082195",
                                        "entry_id": "2a0f81f1-dc8d-361e-9b32-ee014d145c76",
                                        "glosses": [
                                            "Any left-wing ideology, government regulations, or policies promoting a welfare state, nationalisation, etc."
                                        ],
                                        "tags": [
                                            "Western",
                                            "colloquial",
                                            "countable",
                                            "derogatory",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff713607-5d41-433d-9520-27ab627b6b18",
                        "source_entry_id": "0569d8ee-7792-3d0c-9957-7900c755a6c8",
