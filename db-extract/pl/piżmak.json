                                    {
                                        "sense_id": "914d06ff-484d-3295-8a51-674f8ea54d00",
                                        "entry_id": "778f5131-5e91-36d8-9ebb-7995a69a3d7b",
                                        "glosses": [
                                            "A semiaquatic rodent of the tribe Ondatrini."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1992787d-f7c3-402d-9d02-e5f96dd4bd5a",
                                                "sense_id": "914d06ff-484d-3295-8a51-674f8ea54d00",
                                                "text": "1865, Henry David Thoreau, Cape Cod, Chapter IX. \"The Sea and the Desert\", page 187.\nHe also said that minks, muskrats, foxes, coons, and wild mice were found there, but no squirrels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dca854e-eed9-3fed-b3e3-9179affbd3ee",
                                        "entry_id": "778f5131-5e91-36d8-9ebb-7995a69a3d7b",
                                        "glosses": [
                                            "Any of several shrews in the family Soricidae, especially an Asian house shrew (Suncus murinus)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6b6a304e-e77b-31e4-a87e-343fbafcd237",
                                        "entry_id": "778f5131-5e91-36d8-9ebb-7995a69a3d7b",
                                        "glosses": [
                                            "A bandicoot rat."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "070df3ae-c78d-4532-89e5-62e5320d723a",
                        "source_entry_id": "4a26ed55-3d8e-3883-aca7-615122b0ba56",
                        "source_sense_id": "f8daa6de-f7e8-3005-870d-93ed39f923a9",
                        "target_lang_word": "rat musqué",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rat musqué",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "623a7c09-b9a9-3df6-a4bd-08e0d0047692",
                                        "entry_id": "2165b33b-63a4-3c1f-85ba-51d268fceb3e",
                                        "glosses": [
                                            "Gros rongeur trapu amphibie dont la queue écailleuse est comprimée latéralement."
                                        ],
                                        "tags": [
                                            "Glirologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "427cf38e-ab24-4345-8017-6a47bf564126",
                                                "sense_id": "623a7c09-b9a9-3df6-a4bd-08e0d0047692",
                                                "text": "Des rats musqués, émergeant des vieilles souches pourries, venaient sur le gazon du bord, leurs moustaches de lapins noirs toutes frémissantes."
                                            },
                                            {
                                                "example_id": "b036557c-650c-4d3b-aba3-86b56514046f",
                                                "sense_id": "623a7c09-b9a9-3df6-a4bd-08e0d0047692",
                                                "text": "Les rats musqués, c'est pareil : lorsqu'ils deviennent trop nombreux, ils affaiblissent les rigoles dans les champs des agriculteurs qui peuvent renverser avec leurs machineries et les briser."
                                            },
                                            {
                                                "example_id": "b01d22b7-9c48-4761-b38f-cb4e9b3cae94",
                                                "sense_id": "623a7c09-b9a9-3df6-a4bd-08e0d0047692",
                                                "text": "Le rat musqué vit à proximité des eaux dormantes ou courantes et cause parfois des dégâts aux digues et aux berges qu’il sape avec ses terriers."
                                            },
                                            {
                                                "example_id": "55103e89-e0e8-49ec-95be-0b892f4af6f6",
                                                "sense_id": "623a7c09-b9a9-3df6-a4bd-08e0d0047692",
                                                "text": "Le rat musqué est originaire de l’Amérique septentrionale et sa peau exhale l’odeur du musc"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9cb205d-c996-4134-9395-0acdecde40cd",
                        "source_entry_id": "4a26ed55-3d8e-3883-aca7-615122b0ba56",
                        "source_sense_id": "f8daa6de-f7e8-3005-870d-93ed39f923a9",
                        "target_lang_word": "Bisamratte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bisamratte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "851287e1-7ef2-3081-908f-7e650735cb12",
                                        "entry_id": "10acb454-4d95-37c1-ae23-2731060792b7",
                                        "glosses": [
                                            "eine große Wühlmaus mit zusammengedrücktem Schuppenschwanz, die in der Nähe von Wasser lebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1a810cd-2d90-405c-8477-7a0d6676878d",
                                                "sense_id": "851287e1-7ef2-3081-908f-7e650735cb12",
                                                "text": "Bisamratten wurden vor hundert Jahren zur Pelzzucht nach Europa gebracht."
                                            },
                                            {
                                                "example_id": "88564ea8-4b0e-4b3f-8e36-3bdf5fa0d728",
                                                "sense_id": "851287e1-7ef2-3081-908f-7e650735cb12",
                                                "text": "Für ungeübte Beobachter ähneln die Bisamratten den Ratten."
                                            },
                                            {
                                                "example_id": "7665f7ee-799e-4374-8808-830dad70d213",
                                                "sense_id": "851287e1-7ef2-3081-908f-7e650735cb12",
                                                "text": "Die Bisamratte lebte ursprünglich in Nordamerika und ist mittlerweile über die ganze Welt verbreitet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63ad4f86-84db-4fad-988b-6dac2fc94f33",
                        "source_entry_id": "4a26ed55-3d8e-3883-aca7-615122b0ba56",
                        "source_sense_id": "f8daa6de-f7e8-3005-870d-93ed39f923a9",
                        "target_lang_word": "ондатра",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ондатра",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b472a435-236f-3785-afa8-73c381181573",
                                        "entry_id": "99aa5d94-f84f-3856-8e49-2d745ef59bbd",
                                        "glosses": [
                                            "зоол. грызун с блестящим густым мехом бурого цвета; мускусная крыса (Ondatra zibethicus)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcdb2c93-6000-498c-876e-537b1eaec6dc",
                                                "sense_id": "b472a435-236f-3785-afa8-73c381181573",
                                                "text": "Вода кишит ондатрами, они плавают, ныряют, забираются на ветви полузатонувших кустов и что-то жрут, помогая себе передними лапками. Они совсем не безвинны, эти крысы, они истребляют нелепых, слабых выхухолей, последних представителей древнего рода десманов."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d82e9efc-fa8c-34b7-a304-0bfc582ad52b",
                                        "entry_id": "99aa5d94-f84f-3856-8e49-2d745ef59bbd",
                                        "glosses": [
                                            "мех такого животного"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fce93c0-79a6-45a5-a2fc-dfd633c32204",
                                                "sense_id": "d82e9efc-fa8c-34b7-a304-0bfc582ad52b",
                                                "text": "— А то бывают ещё шапки из ондатры, — сказал директор Некрасов, будто угадавши мысли своего спутника, — но самые лучшие — из песца."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
