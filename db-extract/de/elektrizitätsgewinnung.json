                        "sense_id": "dd3887b0-4701-3cdd-880e-06f34817610e",
                        "entry_id": "c1a60ef7-ad77-3079-b534-fac16f470a4e",
                        "glosses": [
                            "Herstellung/Gewinnung von elektrischer Energie, die in einen elektrischen Strom umgewandelt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4e33ccd-7391-4288-b43f-cc19353d8139",
                                "sense_id": "dd3887b0-4701-3cdd-880e-06f34817610e",
                                "text": "„Allerdings ist der Bereich der Elektrizitätsgewinnung aus Kohle auch zukünftig unsicher.“"
                            },
                            {
                                "example_id": "0315a9cc-c3a6-46bb-9fbc-35a72eefbba4",
                                "sense_id": "dd3887b0-4701-3cdd-880e-06f34817610e",
                                "text": "„Diesmal ging es Dietrich um die Nutzung der Wasserkräfte des Oberrheins zur Elektrizitätsgewinnung.“"
                            },
                            {
                                "example_id": "27f1678e-35e8-494d-8da7-01dbc09523fd",
                                "sense_id": "dd3887b0-4701-3cdd-880e-06f34817610e",
                                "text": "„Der höchste Wasserfall dient zur eigenen Elektrizitätsgewinnung, daneben ist die Wasseraufbereitungsanlage.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
