            {
                "entry_id": "0fef4dc6-525b-3166-8d87-7708651f8cd1",
                "word": "impressionniste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "14f7c08b-2164-4f85-9bf3-52ce42fe8a91",
                        "entry_id": "0fef4dc6-525b-3166-8d87-7708651f8cd1",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "impressionnistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e2d14066-494a-301d-a1b9-ea92111aca6b",
                        "entry_id": "0fef4dc6-525b-3166-8d87-7708651f8cd1",
                        "glosses": [
                            "Peintre de la fin du XIXᵉ siècle qui suit les préceptes de l’impressionnisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30bea6ad-c066-4815-8a73-ac0417a7999f",
                                "sense_id": "e2d14066-494a-301d-a1b9-ea92111aca6b",
                                "text": "Mais il la peint comme un impressionniste : avec des tons gris et des reflets luisants, il a recréé l’ambiance de la ville sous la pluie."
                            },
                            {
                                "example_id": "99a30e59-7000-4e51-ad79-a2c52d9787d1",
                                "sense_id": "e2d14066-494a-301d-a1b9-ea92111aca6b",
                                "text": "Que sa dénomination dérive d’un nom commun ou d’un nom propre, l’adepte ne prend jamais de majuscule initiale. L’adhérent, le disciple, le fidèle, le membre pas davantage. Toutes les catégories sont concernées (religion, philosophie, littérature, arts, politique, etc.) : un anglican, sept bouddhistes, trois catholiques, un dadaïste, deux existentialistes, un gnostique, un hindou, deux impressionnistes, trois jansénistes, quelques kharidjites, soixante laxistes, trois marxistes, quatre nudistes, deux oulipistes, dix presbytériennes, un quiétiste, un rexiste, des saint-simoniens, deux trotskistes, dix ultras, une voltairienne, un wahhabite, un zoroastrien."
                            },
                            {
                                "example_id": "c23e120b-d9ad-4a68-8cd9-5c4218e4759d",
                                "sense_id": "e2d14066-494a-301d-a1b9-ea92111aca6b",
                                "text": "Les impressionnistes, qui se veulent réalistes, choisissent leurs sujets dans la vie contemporaine, dans un quotidien librement interprété selon la vision personnelle de chacun d'eux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08fb89f7-ac7b-4f28-bda4-0b5769f788e4",
                        "source_entry_id": "0fef4dc6-525b-3166-8d87-7708651f8cd1",
                        "source_sense_id": "e2d14066-494a-301d-a1b9-ea92111aca6b",
                        "target_lang_word": "impressionist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impressionist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b8fc3bd-057f-3cdb-abfe-9dbc376e9d53",
                                        "entry_id": "99e68ec1-a4c3-3ab6-a3ac-6979539dc462",
                                        "glosses": [
                                            "One who adheres to the theory or method of impressionism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "874dd950-36c4-3129-bb24-142f0e359f95",
                                        "entry_id": "99e68ec1-a4c3-3ab6-a3ac-6979539dc462",
                                        "glosses": [
                                            "A performer who does impressions; a mimic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "939c1de7-adeb-457d-94ab-0c54d6d15118",
                                                "sense_id": "874dd950-36c4-3129-bb24-142f0e359f95",
                                                "text": "When impressionists (and especially lazy impressionists) delivered their comedic interpretation of [Bill] Clinton, the phrase they always used was “I feel your pain,” expressed with a sympathetic Southern drawl."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
