                                    {
                                        "sense_id": "2127db32-2b5a-3dc5-ade2-0a192f207f58",
                                        "entry_id": "a56766f3-a702-36f7-8e69-329eb164ee9c",
                                        "glosses": [
                                            "Exceeding proper limits; excessive or unduly high; extravagant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f62e82c-3a8c-4027-9d8f-d7d964a1a414",
                                                "sense_id": "2127db32-2b5a-3dc5-ade2-0a192f207f58",
                                                "text": "It’s a nice car, but they are charging an exorbitant price for it."
                                            },
                                            {
                                                "example_id": "8db8cb4c-5484-4496-9307-1f2bcb033d80",
                                                "sense_id": "2127db32-2b5a-3dc5-ade2-0a192f207f58",
                                                "text": "You also have to pay exorbitant interest if you have credit card debt."
                                            },
                                            {
                                                "example_id": "24ec9032-796a-4f6c-bbaa-ec9dae951704",
                                                "sense_id": "2127db32-2b5a-3dc5-ade2-0a192f207f58",
                                                "text": "But whatever might be the internal thoughts of Macedonian officers, they held their peace before Alexander [the Great], whose formidable character and exorbitant self-estimation would tolerate no criticism."
                                            },
                                            {
                                                "example_id": "d3cdbc41-9377-438f-ae27-1aa7cb4e89b7",
                                                "sense_id": "2127db32-2b5a-3dc5-ade2-0a192f207f58",
                                                "text": "Love, being an extremely exacting usurer (a sense of exorbitant profit, spiritually, by an exchange of hearts, being at the bottom of pure passions, as that of exorbitant profit, bodily or materially, is at the bottom of those of lower atmosphere), every morning his feelings were as sensitive as the money-market in calculations upon his chances."
                                            },
                                            {
                                                "example_id": "08f984e1-7876-4a72-949f-e7f3ab55f825",
                                                "sense_id": "2127db32-2b5a-3dc5-ade2-0a192f207f58",
                                                "text": "In addition, many low-income people are “unbanked” (not served by a financial institution), and thus nearly eaten alive by exorbitant fees."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
