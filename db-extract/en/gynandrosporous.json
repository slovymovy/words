                "senses": [
                    {
                        "sense_id": "5c334189-1947-3607-93aa-043a9add8eaa",
                        "entry_id": "f0600f09-eef7-3fba-9b24-e638d48ab299",
                        "glosses": [
                            "Having reproductive organs with both male and female functions."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "e339acbf-f1ec-4b26-b967-4538f34e98c8",
                                "sense_id": "5c334189-1947-3607-93aa-043a9add8eaa",
                                "text": "In Œdogonium, varies as are the conditions between monœcious, gynandrosporous, and diœcious, under which the essential elements concerned in the reproduction present themselves, there seems to be still less difference, on the whole, in form and size of the spermatozoid and the oogonium themselves, than in the other cases adverted to."
                            },
                            {
                                "example_id": "d25f6681-f2aa-4236-b54d-164320ba7615",
                                "sense_id": "5c334189-1947-3607-93aa-043a9add8eaa",
                                "text": "This variety differs from the type variety Oe. kozminskii Prescott. var. kozminskii (Prescott, 1944,1951) by its smaller size, gynandrosporous habit and by the strongly capitellate vegetative cells."
                            },
                            {
                                "example_id": "99c06858-51ec-4a74-9a26-37d15874ddb7",
                                "sense_id": "5c334189-1947-3607-93aa-043a9add8eaa",
                                "text": "The features of the oogonial opening and the possible existence of dwarf males point towards relationship with O. rothii N. Pringsheim ex Hirn, which, however, is gynandrosporous."
                            }
                        ]
                    }
