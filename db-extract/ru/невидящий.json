                ],
                "senses": [
                    {
                        "sense_id": "4e472846-063e-3616-9efd-bda18aec1409",
                        "entry_id": "b4cf540f-7d30-3d25-9662-c8fc7f9bbf0f",
                        "glosses": [
                            "такой, который не видит, плохо видит; слепой (о человеке, его глазах)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1591718b-1ef7-4925-8333-0357767c404a",
                                "sense_id": "4e472846-063e-3616-9efd-bda18aec1409",
                                "text": "Бессонов отвернулся и неровной походкой, как невидящий, пошёл по площади."
                            },
                            {
                                "example_id": "b3d70d6c-582a-46c4-b796-d8bc0437ffe0",
                                "sense_id": "4e472846-063e-3616-9efd-bda18aec1409",
                                "text": "Остался лежать на дороге недвижный, невидящий, неживой."
                            }
                        ]
                    },
                    {
                        "sense_id": "ef06ad7b-d3e0-3897-badc-b892f81f0a6d",
                        "entry_id": "b4cf540f-7d30-3d25-9662-c8fc7f9bbf0f",
                        "glosses": [
                            "ничего не замечающий, не воспринимающий зрительно, рассеянный (о взгляде)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "478241d0-2e39-4f33-b9e6-5363a571690f",
                                "sense_id": "ef06ad7b-d3e0-3897-badc-b892f81f0a6d",
                                "text": "И те, на кого упал этот тяжёлый, невидящий взгляд, испытали странное и мучительное чувство: будто из пустых орбит черепа на них взглянула самая равнодушная и немая смерть."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d994a99-7f00-4f38-9ee1-75c7604a57d2",
                        "source_entry_id": "b4cf540f-7d30-3d25-9662-c8fc7f9bbf0f",
                        "target_lang_word": "unseeing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unseeing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "51ca7aa0-b354-3692-9132-26be9b3c81ef",
                                        "entry_id": "baca8cd6-610f-316b-8409-c511ade4632b",
                                        "glosses": [
                                            "blind"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f43c964-f1ca-4164-b38c-8695e115ad8a",
                                                "sense_id": "51ca7aa0-b354-3692-9132-26be9b3c81ef",
                                                "text": "The cave frog's eyes have devolved into unseeing lumps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1c52074-24d2-3465-b2b3-a51436c8f270",
                                        "entry_id": "baca8cd6-610f-316b-8409-c511ade4632b",
                                        "glosses": [
                                            "Not aware of what is visible."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cea176e-89aa-4f40-8df1-cd09dc3f78b9",
                                                "sense_id": "b1c52074-24d2-3465-b2b3-a51436c8f270",
                                                "text": "Although his eyes were open, the sleepwalker headed, with unseeing eyes, towards the danger."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
