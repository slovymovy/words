                    {
                        "sense_id": "67dda664-4741-3018-9970-92298557978e",
                        "entry_id": "c7104c4f-cc71-3996-af2a-e4bc3d781cba",
                        "glosses": [
                            "Magnétron, dispositif de génération de micro-ondes."
                        ],
                        "tags": [
                            "Magnétisme"
                        ],
                        "examples": [
                            {
                                "example_id": "294a7062-17cd-46f8-818d-29800e8bf8dc",
                                "sense_id": "67dda664-4741-3018-9970-92298557978e",
                                "text": "Das Magnetron finded breite Anwendung in Mikrowellenöfen.",
                                "translation": "Le magnétron trouve une large utilisation dans les fours à micro-ondes."
                            }
                        ]
                    },
                    {
                        "sense_id": "787e5243-52a9-3b1d-ae6c-5c8e5b2e5d88",
                        "entry_id": "c7104c4f-cc71-3996-af2a-e4bc3d781cba",
                        "glosses": [
                            "Magnétron, dispositif de déposition de couches minces par pulvérisation cathodique."
                        ],
                        "tags": [
                            "Magnétisme"
                        ],
                        "examples": [
                            {
                                "example_id": "bd1d0664-1ca5-4681-ad1a-ac638d0b427d",
                                "sense_id": "787e5243-52a9-3b1d-ae6c-5c8e5b2e5d88",
                                "text": "In den 1970er Jahren erschienen, das Magnetron hat die breite Industrialisierung des Sputterns erlaubt.",
                                "translation": "Apparu dans les années 1970, le magnétron a permis l’industrialisation à large échelle de la pulvérisation cathodique."
                            },
                            {
                                "example_id": "06e69710-413c-4306-9d57-9a949956c980",
                                "sense_id": "787e5243-52a9-3b1d-ae6c-5c8e5b2e5d88",
                                "text": "Man erkennt ein funktionierendes Magnetron sofort am charakteristichen Plasma-Ring, der sich über dem Target bildet.",
                                "translation": "On reconnaît tout de suite un magnétron en fonctionnement à l’anneau caractéristique que forme le plasma sur la cible."
                            }
                        ]
                    }
