                                        "sense_id": "8f3d15d0-5d40-3c8b-ae91-fdf20805fde8",
                                        "entry_id": "7857570f-1ffe-35d1-b5f3-67319db185b1",
                                        "glosses": [
                                            "Coulée de boue d’origine volcanique, qui détruit tout sur son passage. Elle est principalement constituée de cendre et d’eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3caf7ad-bc40-44f8-afa5-c62d53195d31",
                                                "sense_id": "8f3d15d0-5d40-3c8b-ae91-fdf20805fde8",
                                                "text": "Les 23 000 morts d’Armero (Colombie, 1985) sont imputables au lahar déclenché par la fonte des neiges du Nevado del Ruiz, à cause du déferlement de projections à haute température expulsées par une éruption pourtant bien modeste (0,05 km³)."
                                            },
                                            {
                                                "example_id": "58822f94-2c9f-4f3f-a378-1737e6bf6e5a",
                                                "sense_id": "8f3d15d0-5d40-3c8b-ae91-fdf20805fde8",
                                                "text": "lahar dans la bibliothèque Wikisource"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2880c1f7-415d-4d19-aa9c-55fc18e8bfa3",
