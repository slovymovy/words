                                        "entry_id": "22955f90-14df-35d0-8bf0-e29f8cd3635d",
                                        "glosses": [
                                            "zu einer Gesamtheit führen"
                                        ],
                                        "tags": [
                                            "reflexive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77f68aa4-f058-4c79-940e-b9966f45834d",
                                                "sense_id": "4a8badc8-6617-3fe3-abac-0da5e02737c4",
                                                "text": "Er schaffte es, die drei Reiche zu vereinigen."
                                            },
                                            {
                                                "example_id": "e63ccba7-fc12-4b69-a804-077d92e5edae",
                                                "sense_id": "4a8badc8-6617-3fe3-abac-0da5e02737c4",
                                                "text": "Damake aber antwortete dem ersten, daß die Heuschrecke sieben Tiere in sich vereinige: dieweil sie einen Pferdekopf, einen Rinderhals, Adlerflügel, Kamelbeine, den Schwanz einer Schlange, Hirschhörner und den Bauch eines Skorpions habe."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba5dbccc-7679-44a3-bd77-25a264062a02",
                        "source_entry_id": "9a375c78-3c6d-32a7-878b-a40aeab5424b",
