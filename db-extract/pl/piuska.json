                    {
                        "translation_id": "3ca3f982-247d-4aaa-b64c-8269eec6392b",
                        "source_entry_id": "5b4e7d3a-7fca-3240-abab-9fbe46a0fec1",
                        "source_sense_id": "9b305e89-7e6a-3fa8-b9ee-7681b047f470",
                        "target_lang_word": "zucchetto",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zucchetto",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b23465b-4fcd-31c9-ad0d-26663bd6b073",
                                        "entry_id": "0027a243-4ba2-3925-8374-d3d1f331a90b",
                                        "glosses": [
                                            "A small skullcap worn by Roman Catholic clergy (the Pope's is white, a cardinal's red, a bishop's purple, and a priest's black), Anglican clergy, and Syriac or Malankara Orthodox clergy"
                                        ],
                                        "tags": [],
