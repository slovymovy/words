                "senses": [
                    {
                        "sense_id": "32b9f65f-275a-30e2-a5f0-6abd99fd69ae",
                        "entry_id": "44b8359b-46d0-3e37-a9d0-2c291e068111",
                        "glosses": [
                            "Caractéristique d’un animal à ressembler à son milieu par sa couleur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c57afb99-7568-4484-b53c-95f0f0aef735",
                                "sense_id": "32b9f65f-275a-30e2-a5f0-6abd99fd69ae",
                                "text": "L’homochromie désigne le fait qu’un animal cherche à imiter l’apparence, la couleur et les caractéristiques d’une partie de son habitat afin qu’on ne le distingue plus de son environnement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "635029a5-b97a-45c4-91b9-080bcf82e9ec",
                        "source_entry_id": "44b8359b-46d0-3e37-a9d0-2c291e068111",
                        "source_sense_id": "32b9f65f-275a-30e2-a5f0-6abd99fd69ae",
