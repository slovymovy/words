    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7458b975-e62f-301b-9c1e-c5c979a8afc5",
                    "sense_definition": "To swing indecisively from one course of action, opinion, or decision to another; to waver.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "indecision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee continues to <w>vacillate</w> between the two proposals, unable to reach a final decision."
                        },
                        {
                            "text": "It is fatal to <w>vacillate</w> when immediate action is required to resolve a crisis."
                        }
                    ],
                    "synonyms": [
                        "blow hot and cold",
                        "waffle"
                    ],
                    "common_phrases": [
                        "vacillate between options",
                        "tend to vacillate"
                    ]
                },
                {
                    "sense_id": "508899a1-c18b-3641-9090-f4d74dbae3d2",
                    "sense_definition": "To sway or fluctuate unsteadily from one side to the other; to oscillate physically.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The needle on the dial began to <w>vacillate</w> rapidly as the pressure in the chamber changed."
                        },
                        {
                            "text": "We watched the barometer <w>vacillate</w> between two different readings during the storm."
                        }
                    ],
                    "synonyms": [
                        "stagger"
                    ],
                    "common_phrases": [
                        "vacillate between readings"
                    ]
                }
            ]
        }
    ]
}