                        "examples": [
                            {
                                "example_id": "67874b18-b91c-46b4-bb2a-e366bd865a60",
                                "sense_id": "e323e4b4-62bb-3c00-a6e8-908f75e0cc57",
                                "text": "„Täglich lerne ich dazu und entdecke neue, spannende Facetten der Schriftgestaltung.“"
                            },
                            {
                                "example_id": "45a73a4a-f961-409b-9730-93ed786c7e88",
                                "sense_id": "e323e4b4-62bb-3c00-a6e8-908f75e0cc57",
                                "text": "„2014 entdeckte sie die Liebe zu schönen Buchstaben und der kreativen Schriftgestaltung und lettert seitdem mit Stift, Pinsel, Feder und Tablet.“"
                            },
                            {
                                "example_id": "7fb4da12-8b16-4d19-94f9-e10d5b830e03",
                                "sense_id": "e323e4b4-62bb-3c00-a6e8-908f75e0cc57",
                                "text": "„Eine Wort-/Bildmarke ist eine Marke, die in einer besonderen Schreibweise, Schriftanordnung, Schriftgestaltung oder Farbe dargestellt wird.“"
                            },
                            {
                                "example_id": "efaa17fe-b75d-436f-abf6-f4d4d83b9b61",
                                "sense_id": "e323e4b4-62bb-3c00-a6e8-908f75e0cc57",
                                "text": "Typografie definiert man am einfachsten als die Kunst und Praxis der Schriftgestaltung.“"
                            }
                        ],
