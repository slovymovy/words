{
    "word_family": [
        "blaster",
        "blasting",
        "blastoff",
        "sandblast",
        "counterblast",
        "bioblast"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f5e314ca-38b3-3725-8ffd-bce249e25924",
                    "sense_definition": "A very enjoyable experience, party, or event.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "enjoyment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had a <w>blast</w> at the concert last night.",
                            "target_lang_translations": {
                                "ru": "Мы отлично <w>повеселились</w> на концерте вчера вечером.",
                                "zh": "昨晚的音乐会我们<w>玩得非常开心</w>。"
                            }
                        },
                        {
                            "text": "Going to the amusement park was a total <w>blast</w> for the kids.",
                            "target_lang_translations": {
                                "ru": "Поход в парк аттракционов стал для детей настоящим <w>праздником</w>.",
                                "zh": "去游乐园对孩子们来说真是太<w>好玩</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fun",
                        "good time",
                        "great time",
                        "ball"
                    ],
                    "antonyms": [
                        "bore",
                        "drag"
                    ],
                    "common_phrases": [
                        "have a blast",
                        "total blast",
                        "absolute blast"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "very common in spoken English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень приятное событие, вечеринка или мероприятие.",
                        "zh": "一段非常愉快的经历、聚会或活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "веселье",
                                "target_lang_sense_clarification": "радостное времяпрепровождение"
                            },
                            {
                                "target_lang_word": "улёт",
                                "target_lang_sense_clarification": "сленг: что-то потрясающее"
                            },
                            {
                                "target_lang_word": "удовольствие",
                                "target_lang_sense_clarification": "приятное переживание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "玩得开心",
                                "target_lang_sense_clarification": "形容经历非常愉快"
                            },
                            {
                                "target_lang_word": "乐事",
                                "target_lang_sense_clarification": "指令人高兴的事情"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c67ae007-002a-34e1-b155-46693af811bc",
                    "sense_definition": "A destructive explosion, often used to break apart rock or demolish buildings.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "explosion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>blast</w> shattered windows in several nearby buildings.",
                            "target_lang_translations": {
                                "ru": "<w>Взрыв</w> выбил окна в нескольких соседних зданиях.",
                                "zh": "<w>爆炸</w>震碎了附近几栋建筑的窗户。"
                            }
                        },
                        {
                            "text": "Engineers planned a controlled <w>blast</w> to bring down the old bridge.",
                            "target_lang_translations": {
                                "ru": "Инженеры запланировали контролируемый <w>взрыв</w>, чтобы обрушить старый мост.",
                                "zh": "工程师计划进行一次受控<w>爆破</w>以拆除旧桥。"
                            }
                        }
                    ],
                    "synonyms": [
                        "explosion",
                        "detonation",
                        "burst",
                        "eruption"
                    ],
                    "common_phrases": [
                        "bomb blast",
                        "blast radius",
                        "blast wave",
                        "controlled blast"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разрушительный взрыв, часто используемый для разрушения скал или сноса зданий.",
                        "zh": "一种破坏性的爆炸，常用于炸开岩石或拆除建筑物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взрыв",
                                "target_lang_sense_clarification": "процесс детонации"
                            },
                            {
                                "target_lang_word": "подрыв",
                                "target_lang_sense_clarification": "действие по взрыванию чего-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "爆炸",
                                "target_lang_sense_clarification": "指剧烈的爆破过程"
                            },
                            {
                                "target_lang_word": "爆破",
                                "target_lang_sense_clarification": "指使用炸药进行拆除或开采"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e12dd3ec-30ec-3afb-a0d9-6d98f443f50d",
                    "sense_definition": "A sudden, strong gust of wind or a powerful stream of air.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "air_wind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sudden <w>blast</w> of cold air hit us when he opened the door.",
                            "target_lang_translations": {
                                "ru": "Внезапный <w>порыв</w> холодного воздуха ударил нас, когда он открыл дверь.",
                                "zh": "他开门时，<w>一股</w>冷风扑面而来。"
                            }
                        },
                        {
                            "text": "The heater sent a warm <w>blast</w> into the frozen car.",
                            "target_lang_translations": {
                                "ru": "Обогреватель направил <w>поток</w> теплого воздуха в замерзшую машину.",
                                "zh": "暖气向冰冷的汽车里送入了一股暖<w>气流</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gust",
                        "gale",
                        "blow"
                    ],
                    "common_phrases": [
                        "blast of air",
                        "icy blast",
                        "winter blast",
                        "full blast"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапный сильный порыв ветра или мощный поток воздуха.",
                        "zh": "突然的一阵强风或一股强劲的气流。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порыв ветра",
                                "target_lang_sense_clarification": "резкое движение воздуха"
                            },
                            {
                                "target_lang_word": "порыв",
                                "target_lang_sense_clarification": "внезапное усиление ветра"
                            },
                            {
                                "target_lang_word": "дутьё",
                                "target_lang_sense_clarification": "техническое: поток воздуха"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一阵",
                                "target_lang_sense_clarification": "用于形容风或气流的量词"
                            },
                            {
                                "target_lang_word": "气流",
                                "target_lang_sense_clarification": "指流动的空气"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d16a2890-a77a-3650-8856-276c1f256a39",
                    "sense_definition": "A loud, sudden sound, often made by a horn or whistle.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The referee blew a short <w>blast</w> on his whistle to stop the game.",
                            "target_lang_translations": {
                                "ru": "Судья дал короткий <w>свисток</w>, чтобы остановить игру.",
                                "zh": "裁判吹响了短促的<w>哨声</w>以暂停比赛。"
                            }
                        },
                        {
                            "text": "We were startled by the sudden <w>blast</w> of a truck horn.",
                            "target_lang_translations": {
                                "ru": "Мы вздрогнули от внезапного <w>гудка</w> грузовика.",
                                "zh": "我们被卡车突然的<w>鸣笛声</w>吓了一跳。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blare",
                        "honk",
                        "noise"
                    ],
                    "common_phrases": [
                        "trumpet blast",
                        "whistle blast",
                        "blast of noise"
                    ],
                    "target_lang_definitions": {
                        "ru": "Громкий, внезапный звук, часто издаваемый гудком или свистком.",
                        "zh": "一种响亮、突然的声音，通常由喇叭或哨子发出。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гудок",
                                "target_lang_sense_clarification": "звуковой сигнал"
                            },
                            {
                                "target_lang_word": "резкий звук",
                                "target_lang_sense_clarification": "внезапный шум"
                            },
                            {
                                "target_lang_word": "грохот",
                                "target_lang_sense_clarification": "сильный шум"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鸣笛",
                                "target_lang_sense_clarification": "指喇叭发出的声音"
                            },
                            {
                                "target_lang_word": "哨声",
                                "target_lang_sense_clarification": "指哨子发出的声音"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9dc81059-8a32-362b-af51-8f9f995c940c",
                    "sense_definition": "A promotional message sent to a large number of people at once, usually via email.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The marketing team sent an email <w>blast</w> to all our subscribers.",
                            "target_lang_translations": {
                                "ru": "Маркетинговая команда сделала email-<w>рассылку</w> по всем нашим подписчикам.",
                                "zh": "营销团队向我们所有的订阅者发送了邮件<w>群发</w>。"
                            }
                        },
                        {
                            "text": "We need to prepare the artwork for the next marketing <w>blast</w>.",
                            "target_lang_translations": {
                                "ru": "Нам нужно подготовить иллюстрации для следующей маркетинговой <w>рассылки</w>.",
                                "zh": "我们需要为下一次营销<w>群发</w>准备艺术素材。"
                            }
                        }
                    ],
                    "synonyms": [
                        "broadcast",
                        "mailing"
                    ],
                    "common_phrases": [
                        "email blast",
                        "marketing blast"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "business context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Рекламное сообщение, отправленное большому количеству людей одновременно, обычно по электронной почте.",
                        "zh": "一次性发送给大量人群的促销信息，通常通过电子邮件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рассылка",
                                "target_lang_sense_clarification": "массовая отправка писем"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "群发",
                                "target_lang_sense_clarification": "指大规模发送信息"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e8b554f-b361-3a45-ade2-6669dbe1d8ac",
                    "sense_definition": "A severe verbal attack or criticism.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "criticism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The senator delivered a fierce <w>blast</w> against the new policy.",
                            "target_lang_translations": {
                                "ru": "Сенатор выступил с жесткой <w>критикой</w> новой политики.",
                                "zh": "参议员对新政策进行了猛烈的<w>抨击</w>。"
                            }
                        },
                        {
                            "text": "He received a <w>blast</w> from his boss for being late again.",
                            "target_lang_translations": {
                                "ru": "Он получил <w>нагоняй</w> от начальника за очередное опоздание.",
                                "zh": "他因为再次迟到而遭到了老板的<w>痛斥</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reprimand",
                        "rebuke",
                        "condemnation"
                    ],
                    "antonyms": [
                        "praise",
                        "commendation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жесткая словесная атака или критика.",
                        "zh": "严厉的口头攻击或批评。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разнос",
                                "target_lang_sense_clarification": "разг. строгий выговор"
                            },
                            {
                                "target_lang_word": "резкая критика",
                                "target_lang_sense_clarification": "осуждение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "痛斥",
                                "target_lang_sense_clarification": "指严厉的批评"
                            },
                            {
                                "target_lang_word": "猛烈抨击",
                                "target_lang_sense_clarification": "指强烈的言语攻击"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46a9e2e8-089b-3993-8ff8-4ced99636fa2",
                    "sense_definition": "An immature or undifferentiated cell.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor identified a <w>blast</w> in the blood sample under the microscope.",
                            "target_lang_translations": {
                                "ru": "Врач обнаружил <w>бласт</w> в образце крови под микроскопом.",
                                "zh": "医生在显微镜下的血液样本中发现了<w>原始细胞</w>。"
                            }
                        },
                        {
                            "text": "An abnormal increase in <w>blasts</w> can indicate leukemia.",
                            "target_lang_translations": {
                                "ru": "Аномальное увеличение количества <w>бластов</w> может указывать на лейкемию.",
                                "zh": "<w>原始细胞</w>异常增多可能预示着白血病。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "medical/scientific context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Незрелая или недифференцированная клетка.",
                        "zh": "一种未成熟或未分化的细胞。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бласт",
                                "target_lang_sense_clarification": "медицинский термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "原始细胞",
                                "target_lang_sense_clarification": "生物学中的未分化细胞"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "529271b6-557a-3f07-a6cc-ef731b8a9a48",
                    "sense_definition": "To break something apart or open a hole using explosives.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "explosion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The construction crew had to <w>blast</w> through solid rock to build the tunnel.",
                            "target_lang_translations": {
                                "ru": "Строительной бригаде пришлось <w>взрывать</w> сплошную скалу, чтобы построить туннель.",
                                "zh": "施工队必须<w>炸开</w>坚硬的岩石才能修建隧道。"
                            }
                        },
                        {
                            "text": "They plan to <w>blast</w> the old stadium to make room for a new one.",
                            "target_lang_translations": {
                                "ru": "Они планируют <w>взорвать</w> старый стадион, чтобы освободить место для нового.",
                                "zh": "他们计划<w>爆破</w>旧体育场，为新体育场腾出空间。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blow up",
                        "explode",
                        "detonate",
                        "shatter"
                    ],
                    "common_phrases": [
                        "blast through",
                        "blast away",
                        "blast off"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разрушать что-либо или пробивать отверстие с помощью взрывчатки.",
                        "zh": "使用炸药将某物炸开或炸出一个洞。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взрывать",
                                "target_lang_sense_clarification": "разрушать взрывом"
                            },
                            {
                                "target_lang_word": "подрывать",
                                "target_lang_sense_clarification": "уничтожать взрывчаткой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "炸开",
                                "target_lang_sense_clarification": "指通过爆炸使物体破裂"
                            },
                            {
                                "target_lang_word": "爆破",
                                "target_lang_sense_clarification": "指使用炸药进行破坏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "954bc7fb-bf3c-3d54-94e3-a9279a387565",
                    "sense_definition": "To produce a very loud noise or play music at a high volume.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My neighbors were <w>blasting</w> music late into the night.",
                            "target_lang_translations": {
                                "ru": "Мои соседи <w>врубили</w> музыку на полную громкость поздно ночью.",
                                "zh": "我的邻居深夜还在<w>大声播放</w>音乐。"
                            }
                        },
                        {
                            "text": "The car drove by with its radio <w>blasting</w> a popular song.",
                            "target_lang_translations": {
                                "ru": "Машина проехала мимо, и из радио <w>гремела</w> популярная песня.",
                                "zh": "那辆车开过时，收音机里正<w>震耳欲聋</w>地放着流行歌曲。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blare",
                        "boom"
                    ],
                    "antonyms": [
                        "whisper",
                        "quiet"
                    ],
                    "common_phrases": [
                        "blast music",
                        "blast out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать очень громкий шум или воспроизводить музыку на высокой громкости.",
                        "zh": "发出非常响亮的声音或以高音量播放音乐。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "греметь",
                                "target_lang_sense_clarification": "издавать громкие звуки"
                            },
                            {
                                "target_lang_word": "грохотать",
                                "target_lang_sense_clarification": "сильно шуметь"
                            },
                            {
                                "target_lang_word": "орать",
                                "target_lang_sense_clarification": "разг. о громкой музыке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "震耳欲聋",
                                "target_lang_sense_clarification": "形容声音极大"
                            },
                            {
                                "target_lang_word": "大声播放",
                                "target_lang_sense_clarification": "指以高音量播放"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36f79a68-93d8-35ff-a218-e2b34cbb515a",
                    "sense_definition": "To criticize or reprimand someone severely.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "criticism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager <w>blasted</w> the team for their poor performance this quarter.",
                            "target_lang_translations": {
                                "ru": "Менеджер <w>раскритиковал</w> команду за плохие показатели в этом квартале.",
                                "zh": "经理因为团队本季度的糟糕表现而<w>痛斥</w>了他们。"
                            }
                        },
                        {
                            "text": "Critics <w>blasted</w> the new movie for its terrible script.",
                            "target_lang_translations": {
                                "ru": "Критики <w>разгромили</w> новый фильм за ужасный сценарий.",
                                "zh": "影评人因剧本太烂而<w>严厉批评</w>了这部新电影。"
                            }
                        }
                    ],
                    "synonyms": [
                        "criticize",
                        "slam",
                        "lambaste",
                        "scold",
                        "berate",
                        "castigate",
                        "tell off",
                        "rebuke",
                        "reprimand",
                        "censure"
                    ],
                    "antonyms": [
                        "praise",
                        "commend",
                        "laud"
                    ],
                    "common_phrases": [
                        "blast someone for",
                        "put on blast"
