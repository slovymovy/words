                                "target_senses": [
                                    {
                                        "sense_id": "5f24400c-8748-39e2-8d29-03fe8e47bdc4",
                                        "entry_id": "878dcf49-13ab-3199-ac8b-4ea65ab916ca",
                                        "glosses": [
