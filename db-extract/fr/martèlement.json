                                                "sense_id": "6c41b661-9c50-38cb-8e1b-77aae0474ba9",
                                                "text": "Repeated hammerings by the smith thin the metal and make it tough."
                                            },
                                            {
                                                "example_id": "7d3bd357-3418-4671-9ef3-0c4b750f94c8",
                                                "sense_id": "6c41b661-9c50-38cb-8e1b-77aae0474ba9",
                                                "text": "Hearing a hammering on the door, I ran downstairs to open it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92895b8d-e21a-365d-b6ab-17b4db07ff8f",
                                        "entry_id": "d11872ce-d66a-331e-941a-451964794452",
                                        "glosses": [
                                            "A dented appearance on silverware, produced by successive blows of a hammer."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c8527723-dc5d-3e08-adda-ba174504f9f4",
                                        "entry_id": "d11872ce-d66a-331e-941a-451964794452",
                                        "glosses": [
                                            "A heavy defeat."
                                        ],
                                        "tags": [
                                            "countable",
