                    {
                        "translation_id": "f4b5fe38-e1ed-4bc2-ab44-75700f0ddf46",
                        "source_entry_id": "c594c422-89a5-3a20-b66f-a6bad069dea8",
                        "source_sense_id": "0f7ec18a-17bf-3d69-90f9-4b0bfa88a193",
