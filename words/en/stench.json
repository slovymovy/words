{
    "word_family": [
        "stink"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c34be421-375a-3951-a08c-2738d23e046a",
                    "sense_definition": "A strong and very unpleasant smell.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "smell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>stench</w> of rotting garbage filled the entire alleyway.",
                            "target_lang_translations": {
                                "cs": "<w>Zápach</w> tlejících odpadků naplnil celou uličku."
                            }
                        },
                        {
                            "text": "He could not escape the <w>stench</w> of the swamp.",
                            "target_lang_translations": {
                                "cs": "Nemohl uniknout <w>smradu</w> z bažiny."
                            }
                        }
                    ],
                    "synonyms": [
                        "stink",
                        "reek",
                        "malodor"
                    ],
                    "antonyms": [
                        "aroma",
                        "fragrance",
                        "perfume"
                    ],
                    "common_phrases": [
                        "foul stench",
                        "overpowering stench"
                    ],
                    "target_lang_definitions": {
                        "cs": "Silný a velmi nepříjemný zápach."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zápach",
                                "target_lang_sense_clarification": "neutrální, formálnější označení pro nepříjemný pach"
                            },
                            {
                                "target_lang_word": "smrad",
                                "target_lang_sense_clarification": "běžné, expresivnější označení pro silný nepříjemný pach"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36905b15-4b93-327e-b662-ff606f2e9b40",
                    "sense_definition": "A figurative sense of a foul or corrupt quality.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "smell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The public was disgusted by the <w>stench</w> of political corruption in the city.",
                            "target_lang_translations": {
                                "cs": "Veřejnost byla znechucena <w>zápachem</w> politické korupce ve městě."
                            }
                        },
                        {
                            "text": "There was a lingering <w>stench</w> of dishonesty surrounding the entire business deal.",
                            "target_lang_translations": {
                                "cs": "Celý obchodní případ provázel přetrvávající <w>zápach</w> nepoctivosti."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stench of corruption"
                    ],
                    "target_lang_definitions": {
                        "cs": "Přenesený význam pro nečestné, zkažené nebo morálně závadné jednání."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zápach",
                                "target_lang_sense_clarification": "používá se v přeneseném smyslu (např. zápach korupce)"
                            },
                            {
                                "target_lang_word": "pachuť",
                                "target_lang_sense_clarification": "vyjadřuje nepříjemný dojem nebo dozvuk něčeho negativního"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b1127767-3ea0-326e-aea9-db2b07104afe",
                    "sense_definition": "To cause something to emit a very unpleasant smell.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "smell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rotting fish began to <w>stench</w> the whole kitchen.",
                            "target_lang_translations": {
                                "cs": "Zkažené ryby začaly <w>zamořovat</w> celou kuchyni svým zápachem."
                            }
                        },
                        {
                            "text": "Poor waste management will <w>stench</w> the local environment.",
                            "target_lang_translations": {
                                "cs": "Špatné nakládání s odpady bude <w>zamořovat</w> místní životní prostředí zápachem."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is rare and largely considered archaic."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Způsobit, že něco vydává velmi nepříjemný zápach (zastaralé)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zamořit zápachem",
                                "target_lang_sense_clarification": "popisuje stav, kdy se zápach rozšíří do prostoru"
                            },
                            {
                                "target_lang_word": "zapáchat",
                                "target_lang_sense_clarification": "vydat nepříjemný pach (v aktivním smyslu)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}