                    {
                        "sense_id": "50ab009c-a703-37d5-96ff-e36b7b838982",
                        "entry_id": "0fb9e487-9878-3ba6-a1fd-20d4c96dc138",
                        "glosses": [
                            "van aardewerk vervaardigd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e8952b4-3251-4657-b0c2-f9ad060f5143",
                                "sense_id": "50ab009c-a703-37d5-96ff-e36b7b838982",
                                "text": "Zij had een prachtig versierde aardewerken kruik op tafel staan."
                            },
                            {
                                "example_id": "07b594f8-fe36-4120-8958-ace6f20f3fc6",
                                "sense_id": "50ab009c-a703-37d5-96ff-e36b7b838982",
                                "text": "'Het is heel simpel,' zei Quick. Toen ik aanbood om het dienblad naar de tuin te dragen, wees ze dat met haar handen wapperend af. 'Maar misschien kun je die meenemen.' Ze wees naar een grote aardewerken waterkan en twee glazen, en ik nam die in haar kielzog mee naar buiten. Ze liep nog steeds stijfjes."
                            },
                            {
                                "example_id": "c4fff52d-3864-4211-b59b-18395bcf6c7e",
                                "sense_id": "50ab009c-a703-37d5-96ff-e36b7b838982",
                                "text": "De zuilengalerij was begroeid met klimop. Een van de grote aardewerken vazen waaruit bougainville golfde, was gebarsten. Onkruid groeide tussen het grind. Vredig, maar dat was het woord niet. Berustend. Men zou het verstrijken van de tijd en het verlies van alle dingen inderdaad net zo goed kunnen aanvaarden."
                            }
                        ]
                    }
