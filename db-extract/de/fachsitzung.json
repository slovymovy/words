                "senses": [
                    {
                        "sense_id": "fdc2b063-9fc1-3bd3-bc30-1e66f7ffb7f7",
                        "entry_id": "1b1f0e77-e468-3321-a8b5-ee8d0e41ad05",
                        "glosses": [
                            "thematische Konferenz (besonders im pädagogischen Bereich)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd201ac1-0fcd-4b1f-be49-bac930a04318",
                                "sense_id": "fdc2b063-9fc1-3bd3-bc30-1e66f7ffb7f7",
                                "text": "„Es wird ein gemeinsamer Termin, z.B. eine gemeinsame Fachsitzung, festgelegt, bei dem die Ergebnisse/Erkenntnisse verglichen werden.“"
                            },
                            {
                                "example_id": "ea729874-d856-47cb-b855-cfee463968d8",
                                "sense_id": "fdc2b063-9fc1-3bd3-bc30-1e66f7ffb7f7",
                                "text": "„In der beruflichen Fachrichtung zusätzlich wöchentliche, im Zweitfach zweiwöchentliche Fachsitzungen.“"
                            },
                            {
                                "example_id": "5c6fd80c-fc7f-4b03-b8e6-af88b63dbce1",
                                "sense_id": "fdc2b063-9fc1-3bd3-bc30-1e66f7ffb7f7",
                                "text": "„Für den 16. Oktober wurde eigens eine Fachsitzung mit der Kommission anberaumt.“"
                            },
                            {
                                "example_id": "a2dcf6ec-6130-41fd-8f97-67b62477ef44",
                                "sense_id": "fdc2b063-9fc1-3bd3-bc30-1e66f7ffb7f7",
                                "text": "„Am 2. Oktober 2015 hat im Rahmen des Deutschen Kongresses für Geographie in Berlin die Fachsitzung »Urbanization and Food Safety« stattgefunden.“"
                            },
                            {
                                "example_id": "62786cde-3a4a-4b29-8472-79331b9493b3",
                                "sense_id": "fdc2b063-9fc1-3bd3-bc30-1e66f7ffb7f7",
                                "text": "„Als klassischer Ort zur Weitergabe von Informationen an die Kolleginnen und Kollegen einer Fachschaft können derzeit sicherlich die regelmäßig stattfindenden Fachsitzungen gelten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
