                "senses": [
                    {
                        "sense_id": "465cbd49-02f8-3a9c-8c14-e0676dc3d2e4",
                        "entry_id": "3e9b0c1d-dc5f-32cd-85d9-dd14deab7a00",
                        "glosses": [
                            "Beschreibung des Sterbevorgangs zumeist einer Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc1c4130-264e-4721-8849-230c01369324",
                                "sense_id": "465cbd49-02f8-3a9c-8c14-e0676dc3d2e4",
                                "text": "Insofern Derrida das 'Ich bin' vom Tod her denkt, schreibt er seine Autobiografie als Thanatografie."
                            },
                            {
                                "example_id": "50dc347b-7af1-4418-931a-aed9ac709b94",
                                "sense_id": "465cbd49-02f8-3a9c-8c14-e0676dc3d2e4",
                                "text": "Die Automythographie überschneidet sich mit der Thanatographie des versprengten Volkes."
                            },
                            {
                                "example_id": "e8a4184b-047e-430a-9376-0a5e4f182902",
                                "sense_id": "465cbd49-02f8-3a9c-8c14-e0676dc3d2e4",
                                "text": "Sie bekommen Nahrung, wenn man nur Elisabeth Roudinescos Jacques Lacan mit den beiden Biographien - genauer, der erklärten „Thanatographie“ - vergleicht, die Bataille zum Gegenstand haben."
                            },
                            {
                                "example_id": "0228bd1e-63a4-4a03-9355-1ae346dabcdc",
                                "sense_id": "465cbd49-02f8-3a9c-8c14-e0676dc3d2e4",
                                "text": "Am Rande sei angemerkt, daß der Terminus „Thanatographie“ bereits älteren Datums ist. So spricht Jeremy Bentham sogar vom Projekt einer „Autothanatographie“, in: …"
                            },
                            {
                                "example_id": "54c5f7fa-a2af-4c7b-8d15-fd41293700be",
                                "sense_id": "465cbd49-02f8-3a9c-8c14-e0676dc3d2e4",
                                "text": "Die andere Autobiographie, um die es mir geht, heißt also Thanatographie. Literarisch die wirkungsmächtigste sind wohl die jesuanischen Evangelien."
                            },
                            {
                                "example_id": "161f8c07-7983-40e8-811a-af516a4ff8e1",
                                "sense_id": "465cbd49-02f8-3a9c-8c14-e0676dc3d2e4",
                                "text": "Wo dieses Urteil pauschalisiert wird, greift es zu kurz und verkennt die Möglichkeit der radikalen Alterität der Thanatographie gegenüber der Autopathographie."
                            },
                            {
                                "example_id": "ca261efe-87c5-44d6-85d9-a1a647c506c4",
                                "sense_id": "465cbd49-02f8-3a9c-8c14-e0676dc3d2e4",
                                "text": "Bernd Mattheus dokumentiert in seiner \"Thanatographie\" den Bericht über eine monatlich stattfindende Mischung von Initiation und Schwarzer Messe, die bei Neumond in einem Wald in der Nähe von Paris zelebriert wurde."
                            },
                            {
                                "example_id": "a5a695c8-1765-4a2b-abf2-ae8b60a17bce",
                                "sense_id": "465cbd49-02f8-3a9c-8c14-e0676dc3d2e4",
                                "text": "Eine internationale Tagung an der Uni Bern beschäftigt sich mit Biografien – und Thanatografien, Sterbensberichte, die Hinterbliebene verfassen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
