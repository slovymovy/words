                "senses": [
                    {
                        "sense_id": "66d0524c-b59f-3694-bd29-cec3be95b1ee",
                        "entry_id": "24150a10-14cf-3d1a-9df5-42704149fad8",
                        "glosses": [
                            "wypowiedź dwuznaczna z powodu niejednoznacznej składni"
                        ],
                        "tags": [],
