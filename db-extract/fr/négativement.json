                                    {
                                        "sense_id": "87e46cda-4fc8-38a3-ae1f-73086fa105d4",
                                        "entry_id": "0f760d28-84a5-3c0c-8729-06257b1f37c0",
                                        "glosses": [
                                            "in modo contrario, opposto ad una buona indole"
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f714a24-72db-4128-af9f-1e30d32fe709",
                                                "sense_id": "87e46cda-4fc8-38a3-ae1f-73086fa105d4",
                                                "text": "molti, anche quando bravi, vengono consigliati negativamente"
                                            }
