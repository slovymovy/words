{
    "word_family": [
        "наблюдение",
        "наблюдатель",
        "наблюдательный",
        "наблюдательность",
        "понаблюдать"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "834547d8-196b-3dcd-9e20-2b99c28b9340",
                    "sense_definition": "Внимательно смотреть на кого-либо или что-либо, следить глазами за действиями или изменениями.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "visual_observation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Туристы любили <наблюдать> за жизнью диких животных в парке.",
                            "target_lang_translations": {
                                "en": "The tourists loved to <watch> the life of wild animals in the park.",
                                "tr": "Turistler parktaki vahşi hayvanların yaşamını <w>izlemeyi</w> seviyordu."
                            }
                        },
                        {
                            "text": "Мы будем <наблюдать> за звездами всю ночь, если небо будет ясным.",
                            "target_lang_translations": {
                                "en": "We will <watch> the stars all night if the sky is clear.",
                                "tr": "Gökyüzü açık olursa bütün gece yıldızları <w>izleyeceğiz</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "следить",
                        "смотреть"
                    ],
                    "common_phrases": [
                        "наблюдать за игрой",
                        "наблюдать за звездами",
                        "наблюдать со стороны",
                        "наблюдать за природой"
                    ],
                    "target_lang_definitions": {
                        "en": "To look carefully at someone or something, to follow actions or changes with one's eyes.",
                        "tr": "Birine veya bir şeye dikkatlice bakmak, eylemleri veya değişiklikleri gözleriyle takip etmek."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "watch",
                                "target_lang_sense_clarification": "look at attentively"
                            },
                            {
                                "target_lang_word": "observe",
                                "target_lang_sense_clarification": "view carefully"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "izlemek",
                                "target_lang_sense_clarification": "dikkatle seyretmek"
                            },
                            {
                                "target_lang_word": "gözlemlemek",
                                "target_lang_sense_clarification": "dikkatle inceleyerek bakmak"
                            },
                            {
                                "target_lang_word": "gözlemek",
                                "target_lang_sense_clarification": "takip etmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7421312c-610c-3287-b929-b176d79752d6",
                    "sense_definition": "Изучать или исследовать что-либо, внимательно следя за ходом процесса или явления.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "visual_observation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Астрономы готовятся <наблюдать> редкое солнечное затмение.",
                            "target_lang_translations": {
                                "en": "Astronomers are preparing to <observe> a rare solar eclipse.",
                                "tr": "Gökbilimciler nadir görülen bir güneş tutulmasını <w>gözlemlemeye</w> hazırlanıyor."
                            }
                        },
                        {
                            "text": "Ученые продолжают <наблюдать> изменения климата в этом регионе.",
                            "target_lang_translations": {
                                "en": "Scientists continue to <monitor> climate changes in this region.",
                                "tr": "Bilim insanları bu bölgedeki iklim değişikliklerini <w>izlemeye</w> devam ediyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "изучать",
                        "исследовать",
                        "отслеживать"
                    ],
                    "common_phrases": [
                        "наблюдать затмение",
                        "наблюдать поведение",
                        "наблюдать изменения",
                        "наблюдать процесс"
                    ],
                    "target_lang_definitions": {
                        "en": "To study or investigate something, carefully following the course of a process or phenomenon.",
                        "tr": "Bir sürecin veya olgunun seyrini dikkatle takip ederek bir şeyi incelemek veya araştırmak."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "observe",
                                "target_lang_sense_clarification": "study scientifically"
                            },
                            {
                                "target_lang_word": "monitor",
                                "target_lang_sense_clarification": "track progress or changes"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "gözlemlemek",
                                "target_lang_sense_clarification": "bilimsel/sistemli incelemek"
                            },
                            {
                                "target_lang_word": "izlemek",
                                "target_lang_sense_clarification": "süreci takip etmek"
                            },
                            {
                                "target_lang_word": "takip etmek",
                                "target_lang_sense_clarification": "gelişmeleri izlemek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa3adb1e-a61d-3fa4-ae64-8003b4a12028",
                    "sense_definition": "Видеть или замечать появление чего-либо, становиться свидетелем какого-либо явления.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В последнее время мы можем <наблюдать> значительный рост цен на продукты.",
                            "target_lang_translations": {
                                "en": "Recently we can <observe> a significant rise in food prices.",
                                "tr": "Son zamanlarda gıda fiyatlarında önemli bir artış <w>gözlemleyebiliyoruz</w>."
                            }
                        },
                        {
                            "text": "Жители города могли <наблюдать> странную картину в вечернем небе.",
                            "target_lang_translations": {
                                "en": "The city residents could <observe> a strange scene in the evening sky.",
                                "tr": "Şehir sakinleri akşam gökyüzünde garip bir manzara <w>görebildiler</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "встречать"
                    ],
                    "common_phrases": [
                        "наблюдать картину",
                        "наблюдать явление",
                        "наблюдать рост",
                        "часто наблюдать"
                    ],
                    "target_lang_definitions": {
                        "en": "To see or notice the appearance of something, to become a witness to a phenomenon.",
                        "tr": "Bir şeyin ortaya çıktığını görmek veya fark etmek, bir olaya tanıklık etmek."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "observe",
                                "target_lang_sense_clarification": "notice or witness"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "gözlemlemek",
                                "target_lang_sense_clarification": "fark etmek, tanık olmak"
                            },
                            {
                                "target_lang_word": "görmek",
                                "target_lang_sense_clarification": "şahit olmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ba9900a-3623-347e-9d15-9065ee9cc161",
                    "sense_definition": "Осуществлять медицинский контроль за состоянием здоровья пациента и ходом лечения.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Врач должен <наблюдать> пациента в течение недели после операции.",
                            "target_lang_translations": {
                                "en": "The doctor must <monitor> the patient for a week after the surgery.",
                                "tr": "Doktor, ameliyattan sonra bir hafta boyunca hastayı <w>gözlem altında tutmalıdır</w>."
                            }
                        },
                        {
                            "text": "Специалисты решили <наблюдать> больного в условиях стационара.",
                            "target_lang_translations": {
                                "en": "The specialists decided to <observe> the patient in a hospital setting.",
                                "tr": "Uzmanlar hastayı hastane koşullarında <w>takip etmeye</w> karar verdi."
                            }
                        }
                    ],
                    "common_phrases": [
                        "наблюдать пациента",
                        "наблюдать больного",
                        "наблюдать беременность"
                    ],
                    "target_lang_definitions": {
                        "en": "To carry out medical control over a patient's health condition and the course of treatment.",
                        "tr": "Hastanın sağlık durumunu ve tedavi sürecini tıbbi kontrol altında tutmak."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "monitor",
                                "target_lang_sense_clarification": "check health status"
                            },
                            {
                                "target_lang_word": "observe",
                                "target_lang_sense_clarification": "keep under medical supervision"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "gözlem altında tutmak",
                                "target_lang_sense_clarification": "tıbbi denetim yapmak"
                            },
                            {
                                "target_lang_word": "takip etmek",
                                "target_lang_sense_clarification": "sağlık durumunu izlemek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64381f8c-4e5c-33d5-af94-c2c13e3411cd",
                    "sense_definition": "Строго придерживаться установленных правил, обычаев или порядка.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Слуги в этом доме должны были строго <наблюдать> чистоту и порядок.",
                            "target_lang_translations": {
                                "en": "The servants in this house had to strictly <observe> cleanliness and order.",
                                "tr": "Bu evdeki hizmetçiler temizlik ve düzene kesinlikle <w>uymak</w> zorundaydı."
                            }
                        },
                        {
                            "text": "Он старался во всем <наблюдать> правила этикета, чтобы произвести впечатление.",
                            "target_lang_translations": {
                                "en": "He tried to <observe> the rules of etiquette in everything to make an impression.",
                                "tr": "Etki bırakmak için her şeyde görgü kurallarına <w>uymaya</w> çalışıyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "соблюдать"
                    ],
                    "common_phrases": [
                        "наблюдать порядок",
                        "наблюдать тишину",
                        "наблюдать закон",
                        "наблюдать чистоту"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in historical or literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To strictly adhere to established rules, customs, or order.",
                        "tr": "Belirlenmiş kurallara, geleneklere veya düzene kesin olarak uymak."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "observe",
                                "target_lang_sense_clarification": "follow rules or customs"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "uymak",
                                "target_lang_sense_clarification": "kurallara riayet etmek"
                            },
                            {
                                "target_lang_word": "gözetmek",
                                "target_lang_sense_clarification": "dikkate almak, korumak"
                            }
                        ]
                    }
                }
            ]
        }
    ]
