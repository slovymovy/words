            {
                "entry_id": "3a6c5724-ad12-3fa9-bf79-7eb70f7dae82",
                "word": "bacchante",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9a648b37-b29d-4c26-aedd-f1cec4bf2537",
                        "entry_id": "3a6c5724-ad12-3fa9-bf79-7eb70f7dae82",
