                            {
                                "target_lang_word": "produce",
                                "target_lang_sense_clarification": "manufacture goods"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "çıkarman",
                                "target_lang_sense_clarification": "albüm, kitap veya ürün"
