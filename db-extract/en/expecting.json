                        "cross_references": []
                    },
                    {
                        "translation_id": "c7a0f3b7-57ce-42a5-bc0c-f236d360a622",
                        "source_entry_id": "f8c5df9b-26f4-3dd2-b3fb-52f9b887147b",
                        "source_sense_description": "in expectation of giving birth; pregnant",
                        "target_lang_word": "schwanger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schwanger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fa3f1476-d507-3082-a642-e5202e8b00ed",
                                        "entry_id": "133a5de6-aca0-3d12-9059-d9bc854838ef",
                                        "glosses": [
                                            "in dem Zustand, in dem ein Embryo (nach Herausbildung der inneren Organe ein Fötus) im Körper heranreift"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85fa0b24-7a68-4198-b4e8-7844c4cba9fa",
                                                "sense_id": "fa3f1476-d507-3082-a642-e5202e8b00ed",
                                                "text": "Ich bin schwanger, sagte Sandra und schaute ihren Freund frohgelaunt an."
                                            },
                                            {
                                                "example_id": "ae62c80b-7d13-4e91-b983-2cf869cf5ebe",
                                                "sense_id": "fa3f1476-d507-3082-a642-e5202e8b00ed",
                                                "text": "„Der Totemismus ist daher eine Schöpfung nicht des männlichen, sondern des weiblichen Geistes. Die Gelüste (sick fancies) des schwangeren Weibes sind die Wurzel desselben.“"
                                            },
                                            {
                                                "example_id": "b8ea0a80-6de7-4a51-a7c6-c922952f824a",
                                                "sense_id": "fa3f1476-d507-3082-a642-e5202e8b00ed",
                                                "text": "„Für mich gibt es kaum etwas Peinlicheres, als wenn eine Frau ihren Mann verbittert anschaut, weil sie schwanger ist.“"
                                            },
                                            {
                                                "example_id": "37a13084-1686-488b-b6e4-f9c917c1ac7d",
                                                "sense_id": "fa3f1476-d507-3082-a642-e5202e8b00ed",
                                                "text": "„Zusammengehörend sind sie auf die vierte Person, nämlich auf Jans Frau, Hedwig Bronski, geborene Lemke, die zu dem Zeitpunkt womöglich schon mit dem späteren Stephan schwanger ging, nur insofern angewiesen, als diese den Fotoapparat auf die drei und das Glück dieser drei Menschen richten muß, damit sich dreifaches Glück wenigstens mit den Mitteln der Fotografie festhalten läßt.“"
                                            },
                                            {
                                                "example_id": "44e2d2b6-34ee-405a-925b-3ee3e44618da",
                                                "sense_id": "fa3f1476-d507-3082-a642-e5202e8b00ed",
                                                "text": "„Sie war allein und glücklich, schwanger zu sein, und als sie zu Joachim ging, um sich überreden zu lassen, war Hanna bereits entschlossen, ihr Kind zu haben; es störte sie nicht, daß Joachim damals meinte, sie in einem entscheidenden Beschluß ihres Lebens bestimmt zu haben, und daß er sich in Hanna verliebte, was kurz darauf zur Heirat führte.“"
                                            },
                                            {
                                                "example_id": "88537783-6768-4fd7-8977-39b1ab085004",
                                                "sense_id": "fa3f1476-d507-3082-a642-e5202e8b00ed",
                                                "text": "„Aber ich glaub nicht, daß sie schwanger ist, nach meiner Rechnung ziemlich unwahrscheinlich.“"
                                            },
                                            {
                                                "example_id": "baf45c31-fb0a-43ab-8d46-433fda696264",
                                                "sense_id": "fa3f1476-d507-3082-a642-e5202e8b00ed",
                                                "text": "„Sie wisse nicht, wie sie es sagen solle, aber, na ja, sie sei jetzt schwanger.“"
                                            },
                                            {
                                                "example_id": "d88c0b12-6520-4eb8-85af-a3d0ac7baaba",
                                                "sense_id": "fa3f1476-d507-3082-a642-e5202e8b00ed",
                                                "text": "„Carla war schwanger, als sie zum Standesamt ging, und der weiße Schleier auf der Photographie war Lüge und doch nicht Lüge, weil niemand belogen wurde oder belogen werden konnte, denn der weiße Schleier hatte schon lange nur noch schmückenden Sinn und wurde eine peinliche dem Spott ausgelieferte Maskerade, wenn man ihn für das Zeichen der unverletzten Scham nahm, und keinesfalls war es frivol, daß man so dachte, denn die Zeit war eher geneigt, die Vorstellung, daß der Bräutigam nach vollzogener öffentlicher Zuführung und Feier sich auf die Braut stürze, auf das weiße Lamm, mit dem er das Hymenopfer vollzog, als frivol und schamlos zu empfinden, dennoch bedurfte es der Trauung, des Ordentlichen und der Amtlichkeit des Zusammentuns, des Segenspruches der Gemeinschaft, der Kinder wegen bedurfte es dies alles, der Kinder, die der Gemeinschaft geboren werden sollten und selbst mit Werbung ins Leben gelockt wurden,[…]“"
                                            },
                                            {
                                                "example_id": "fb69275a-ad17-4fdf-acd0-3b04db55574b",
                                                "sense_id": "fa3f1476-d507-3082-a642-e5202e8b00ed",
                                                "text": "„Er spielte wieder Handball und trainierte den örtlichen Nachwuchs, während seine Frau erneut schwanger wurde und eine Tochter zur Welt brachte.“"
                                            },
                                            {
                                                "example_id": "ba4f96e5-25d8-4af7-b9f3-a176939b30e6",
                                                "sense_id": "fa3f1476-d507-3082-a642-e5202e8b00ed",
                                                "text": "„Großer Überredungskünste von seiner Seite hatte es gewiß nicht bedurft, daß sie sich nach kurzem schwanger fühlte.“"
                                            },
                                            {
                                                "example_id": "6bd7491b-147c-4d1f-bdaa-9f6610cbda80",
                                                "sense_id": "fa3f1476-d507-3082-a642-e5202e8b00ed",
                                                "text": "„Sie schlief mit ihm und wurde mit Horus schwanger, der das Reich seines Vaters wieder errichtete und die Religion des alten Ägypten prägte.“"
                                            },
                                            {
                                                "example_id": "420ea74f-4d2d-4869-8c80-e55db904fcf4",
                                                "sense_id": "fa3f1476-d507-3082-a642-e5202e8b00ed",
                                                "text": "„Weil Mama schwanger war, erhielt sie mehr Lebensmittelkarten als vorher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
