                "senses": [
                    {
                        "sense_id": "eb50c721-b3f0-33d1-b24e-7f55f102e82c",
                        "entry_id": "6ca779d5-5808-3088-9311-b61fa26cacc8",
                        "glosses": [
                            "Protéine (globuline) extrait de l’arachide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a46b421-bfe6-4b8b-bc7b-31973af0a8c6",
                                "sense_id": "eb50c721-b3f0-33d1-b24e-7f55f102e82c",
                                "text": "Rappelons que les protides de l'arachide sont composés essentiellement de deux globulines : l'arachine et la conarachine, cette dernière ayant un équilibre en acides aminés nettement plus satisfaisant que la première."
                            },
                            {
                                "example_id": "29628804-3652-4448-985a-f21b37c2674b",
                                "sense_id": "eb50c721-b3f0-33d1-b24e-7f55f102e82c",
                                "text": "L’addition de cystine, de tryptophane, d’alanine, de valine, de proline, de leucine, n’améliore pas la valeur de l'arachine."
                            }
                        ]
                    },
                    {
                        "sense_id": "85a91102-a180-375a-ae03-f7d81947ba27",
                        "entry_id": "6ca779d5-5808-3088-9311-b61fa26cacc8",
                        "glosses": [
                            "Autre graphie rare d’arachide."
                        ],
                        "tags": [
                            "obsolete",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "fd12a23e-a63e-401d-9d74-5eb0beddc305",
                                "sense_id": "85a91102-a180-375a-ae03-f7d81947ba27",
                                "text": "Enfin à la page 67 j'observe que si le gouvernement encourageoit la culture de l'arachine, elle nous fourniroit une nouvelle branche de commerce, et diminueroit notablement l'importation du cacao en France."
                            }
                        ]
                    }
