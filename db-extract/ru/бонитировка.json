                    {
                        "translation_id": "099dd153-efd8-4fa5-945b-4d56ecf31aeb",
                        "source_entry_id": "adf65c70-37ff-38f5-a996-f727a9f11b9f",
                        "target_lang_word": "Schätzung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schätzung",
