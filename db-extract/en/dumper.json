                    },
                    {
                        "sense_id": "614e9040-9c91-3dce-aebd-9085478b0583",
                        "entry_id": "5f5b48dc-8c01-3463-b3fe-ba08f9f0f960",
                        "glosses": [
                            "A dropper of refuse, particularly not in landfill or recycling sites."
