                ],
                "senses": [
                    {
                        "sense_id": "3cc43931-cc7c-36b2-a573-437d56536d8d",
                        "entry_id": "fff5d438-a593-3eb6-a423-d3e508d28065",
                        "glosses": [
                            "geometrische Figur mit vierzig Ecken"
                        ],
                        "tags": [
                            "geometry"
                        ],
                        "examples": [
                            {
                                "example_id": "6f46d42d-718e-44c2-a3be-45a6d53cb0f5",
                                "sense_id": "3cc43931-cc7c-36b2-a573-437d56536d8d",
                                "text": "„3. für das regelmäßige Zehneck, Zwanzigeck, Vierzigeck usw., sowie für die aus den genannten Polygonen ableitbaren Polygone den Radius des einbeschriebenen Kreises und die Polygonseite durch den Radius r des umschriebenen Kreises ausdrücken kann.“"
                            },
                            {
                                "example_id": "873de91b-a124-4269-88ba-68ee717b633a",
                                "sense_id": "3cc43931-cc7c-36b2-a573-437d56536d8d",
                                "text": "„Beispielsweise aus dem Zehneck oder dem Vierzigeck oder irgendeinem Anderen, anstatt eines Pentagons“"
                            },
                            {
                                "example_id": "cabedb14-ba93-456a-9495-56bd223aab65",
                                "sense_id": "3cc43931-cc7c-36b2-a573-437d56536d8d",
                                "text": "„[…] so daß z. B. aus dem regelmäßigen Fünfeck in Fig. 20 zunächst ein regelmäßiges Zehneck, daraus ein regelmäßiges Zwanzigeck, Vierzigeck u. s. w. wird; gleichzeitig denke man sich jedesmal das zugehörige regelmäßige Prisma über der betrefl'enden Figur, so daß das regelmäßige fünfseitige I'risma nacheinander in ein regelmäßiges zehnseitiges, zwanzigseitiges, vierzigseitiges Prisma u. s. w. übergeht.“"
                            },
                            {
                                "example_id": "20602608-3dca-4703-8f77-8af583800079",
                                "sense_id": "3cc43931-cc7c-36b2-a573-437d56536d8d",
                                "text": "„Der Winkel 171 Grad, den Kepler nennt, tritt beim Vierzigeck auf.“"
                            },
                            {
                                "example_id": "cb3bfd3e-7d07-4920-a26c-e8f2714a684b",
                                "sense_id": "3cc43931-cc7c-36b2-a573-437d56536d8d",
                                "text": "„Pentagon und Quadrat lassen sich zum Zwanzigeck verbinden, Pentagon und Oktogon zum Vierzigeck.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
