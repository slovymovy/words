                "senses": [
                    {
                        "sense_id": "2fb9a55d-1520-3419-a719-fea66bf14a2b",
                        "entry_id": "77238aed-45cb-3d89-8ba5-8cd52df30480",
                        "glosses": [
                            "издавать прерывистый, дрожащий звук (обычно при сотрясении)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "463f62a7-fbe7-4e84-a36c-bd7ac930f620",
                                "sense_id": "2fb9a55d-1520-3419-a719-fea66bf14a2b",
                                "text": "А магнитофон у нас был очень старый. И весь дребезжал. И кассету я специально от неё спрятала."
                            }
                        ]
                    },
                    {
                        "sense_id": "482c10d4-4c1d-323d-ab35-e29fbf7b8097",
                        "entry_id": "77238aed-45cb-3d89-8ba5-8cd52df30480",
                        "glosses": [
                            "звучать прерывисто (о голосе)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4335150f-2cb8-4c50-843b-dfeeb0f961f8",
                                "sense_id": "482c10d4-4c1d-323d-ab35-e29fbf7b8097",
                                "text": "\"Да\", — сказал он. Голос в трубке слегка дребезжал. \"Да\", — повторял он время от времени, слушая голос трубке."
                            }
                        ]
                    }
                ],
