                            {
                                "example_id": "f16af040-01fa-47cd-b7e3-41b2c735f34a",
                                "sense_id": "12012c51-a7d4-3317-9b15-423a9d62f7f7",
                                "text": "Das Medianalter teilt die Bevölkerung in zwei gleiche Hälften, wobei 50% der Bevölkerung jünger als dieses Alter sind, und 50% älter."
                            },
                            {
                                "example_id": "5ee8e415-af75-4066-863b-70655e09443e",
                                "sense_id": "12012c51-a7d4-3317-9b15-423a9d62f7f7",
                                "text": "In Deutschland beträgt das Medianalter 40 Jahre, d.h., dass 50% der deutschen Bevölkerung jünger/älter als 40 Jahre sind."
                            }
