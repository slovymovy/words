                        "examples": [
                            {
                                "example_id": "d637750c-9985-45ce-8957-1cec2282ca13",
                                "sense_id": "fc9c90e6-a4bd-3342-8450-a641f74bc89b",
                                "text": "It is the good fortune of those who lay foundations to so inwrite their names in the annals of the institutions that they found that the historian can neither overlook them nor ignore them."
                            },
                            {
                                "example_id": "a4547e8d-62eb-4ff7-85d6-79f80ec36b56",
                                "sense_id": "fc9c90e6-a4bd-3342-8450-a641f74bc89b",
                                "text": "What wild heart histories seemed to lie enwritten / Upon those crystalline, celestial spheres!"
                            }
                        ]
                    }
