                "senses": [
                    {
                        "sense_id": "cf7e31cb-486b-371e-ae2a-c6b3ded21911",
                        "entry_id": "4e84acfb-c974-359a-9b45-2d4acdb52d59",
                        "glosses": [
                            "Person, die das Dreschen mit Dreschflegel besorgte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3cb6656-d24d-457c-8e78-cbca979b5bb9",
                                "sense_id": "cf7e31cb-486b-371e-ae2a-c6b3ded21911",
                                "text": "„Auf den rheinischen Landgütern werden häufig die Scheunendrescher in halbe Kost genommen.“"
                            },
                            {
                                "example_id": "bf46d08a-b119-428a-b3e6-2bad6a5c3d93",
                                "sense_id": "cf7e31cb-486b-371e-ae2a-c6b3ded21911",
                                "text": "„Es können auf einer Tenne 2 —8 Männer oder Frauen zu gleicher Zeit dreschen. — Scheunendrescher, die um den 12—16ten Scheffel dreschen, sind nur immer ihrer zwei auf einer Tenne.“"
                            },
                            {
                                "example_id": "a5b5b9d3-1f30-4d5a-a3f4-01d48c71a1b1",
                                "sense_id": "cf7e31cb-486b-371e-ae2a-c6b3ded21911",
                                "text": "„Gewiss, am Essen konnte man hier und da ein paar Kleinigkeiten bemängeln; doch hätten sich die Gäste vollgestopft wie die Scheunendrescher, ein Beweis, daß es gar nicht so schlecht gewesen sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
