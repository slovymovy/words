                "senses": [
                    {
                        "sense_id": "514f6481-870e-38a4-a707-5733c64f3a13",
                        "entry_id": "69e12aaa-d443-33b9-b054-1f4f7660fd6e",
                        "glosses": [
                            "taki, który dużo mówi (t. przen.)"
                        ],
                        "tags": [
                            "literary",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "ad792d3e-7937-4bc2-b845-59030455bc4c",
                                "sense_id": "514f6481-870e-38a4-a707-5733c64f3a13",
                                "text": "Po niewoli wzrok znowu przywierał do zgasłych końskich oczu, do ich siły wyczerpanej, do oczu przeżytych, a tak niedościgle mądrych, tak udręczająco wielomównych, że w ich wyrazie mieścił się cały jakiś świat (…) W mowie tych źrenic żałosnych, które przymusowo widziały płomień ogniska, bo je raził i nękał, można było wysłuchać słowa"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
