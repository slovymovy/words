                                        "glosses": [
                                            "породообразующий минерал, магнезиально-железистый силикат"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35d0e1b7-2bdf-42e5-a66d-9fb2232ec42c",
