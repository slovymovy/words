                    }
                ],
                "senses": [
                    {
                        "sense_id": "f3002cf1-8a05-3672-aaf9-4c55fd59adfa",
                        "entry_id": "14250af9-8dfd-3aed-b8c6-d021a22977d7",
                        "glosses": [
                            "Material, Stoff, aus dem durch Verarbeitung etwas Höherwertiges, Komplexeres entsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "425d1a9f-e63e-4754-bc91-e0b9fc5eda0f",
                                "sense_id": "f3002cf1-8a05-3672-aaf9-4c55fd59adfa",
                                "text": "„Bei natürlichen Aromastoffen muss das Ausgangsmaterial pflanzlicher oder tierischer Herkunft sein.“"
                            },
                            {
                                "example_id": "179a7f4d-5fc7-4b2d-8e89-2adf5a5c5b5f",
                                "sense_id": "f3002cf1-8a05-3672-aaf9-4c55fd59adfa",
                                "text": "„Auf seinen Platten sampelt er mit Vorliebe alte Soul- und Jazz-Stücke – wobei die Samples dann freilich derart fragmentiert und verfremdet werden, dass man das Ausgangsmaterial nicht mehr erkennt.“"
                            },
                            {
                                "example_id": "f197239c-d7ad-453d-ba0d-b31d1e27b70d",
                                "sense_id": "f3002cf1-8a05-3672-aaf9-4c55fd59adfa",
                                "text": "„Das Ausgangsmaterial war fetter Ton, den der Ingenieur mit Kalk und Quarz zu echter Pfeifenerde vermengt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "35e280cb-d211-4ff2-bd81-c498645f8e06",
                        "source_entry_id": "14250af9-8dfd-3aed-b8c6-d021a22977d7",
                        "source_sense_id": "f3002cf1-8a05-3672-aaf9-4c55fd59adfa",
                        "source_sense_description": "Material, Stoff, aus dem durch Verarbeitung etwas Höherwertiges, Komplexeres entsteht",
                        "target_lang_word": "feedstock",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feedstock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6c9100c6-d87a-360b-b058-6a335f0c7b4d",
                                        "entry_id": "98b9649d-a21f-3619-9e83-4c9975a722fd",
                                        "glosses": [
                                            "Any bulk raw material constituting the principal input for an industrial process."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0651bfe6-90b5-48b4-9184-a0eb04679102",
                                                "sense_id": "6c9100c6-d87a-360b-b058-6a335f0c7b4d",
                                                "text": "Bio-materials may be substituted for petrochemical feedstocks as petroleum prices rise."
                                            },
                                            {
                                                "example_id": "c75c5455-19e9-4743-988e-dba1d7f6018b",
                                                "sense_id": "6c9100c6-d87a-360b-b058-6a335f0c7b4d",
                                                "text": "The filtered extract of the mash is the feedstock for the fermenter."
                                            },
                                            {
                                                "example_id": "7bb6c217-3c19-4d96-9bcd-2dcfd8c8f2b2",
                                                "sense_id": "6c9100c6-d87a-360b-b058-6a335f0c7b4d",
                                                "text": "In 2006, about 6 percent of the world's crude oil production was used in non-energy applications, primarily as a petrochemical feedstock."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
