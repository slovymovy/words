                "senses": [
                    {
                        "sense_id": "a2605709-d89b-35f3-be0d-f62ebb2b9d34",
                        "entry_id": "5970d657-0857-35e6-bc91-5c2016abe716",
                        "glosses": [
                            "Teilnehmer in einem größeren Wettbewerb, der erst nach erfolgreicher Absolvierung einer Vorausscheidung in den Wettbewerb kommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f838a590-89db-4d35-985c-ddf3f09238b6",
                                "sense_id": "a2605709-d89b-35f3-be0d-f62ebb2b9d34",
                                "text": "Darauf, dass ein Qualifikant den Favoriten im Finale besiegen würde, hatten im Vorfeld nur wenige gewettet."
                            },
                            {
                                "example_id": "2721b8d4-e029-4fb8-9fb1-d6c261328952",
                                "sense_id": "a2605709-d89b-35f3-be0d-f62ebb2b9d34",
                                "text": "„Der spanische Tennis-Star Rafael Nadal ist beim ATP-Turnier in Peking überraschend im Viertelfinale an Qualifikant Martin Klizan gescheitert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
