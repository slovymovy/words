                "senses": [
                    {
                        "sense_id": "33de2d14-356a-324f-9741-ec6839b75713",
                        "entry_id": "d9f2dbcd-7102-3fc6-bd72-17819d2b8e80",
                        "glosses": [
                            "der Pazifische Ozean, insbesondere der südliche Teil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96ef4835-af45-4ed0-8a36-244390076fb0",
                                "sense_id": "33de2d14-356a-324f-9741-ec6839b75713",
                                "text": "Nächstes Jahr machen sie einen Urlaub in der Südsee."
                            },
                            {
                                "example_id": "c7f0d56f-f807-4c90-b1dc-2da4804dd8e3",
                                "sense_id": "33de2d14-356a-324f-9741-ec6839b75713",
                                "text": "„Die aktive deutsche Kolonialpolitik in der Südsee begann 1884 (zeitgleich wie in Afrika): Die Marine entsandte Kanonenboote, und auf zahlreichen Inseln wurde die schwarz-weiß-rote Reichsflagge gehisst.“"
                            },
                            {
                                "example_id": "f5ad8b72-fae9-4df2-b2ab-4dde1a6b1f0a",
                                "sense_id": "33de2d14-356a-324f-9741-ec6839b75713",
                                "text": "„Alles still hier. Und doch, von Zeit zu Zeit wird es an eben dieser Stelle lebendig. Das ist, wenn es weit draußen in der Welt, sei’s auf Island, sei’s auf Java, zu rollen und zu grollen beginnt oder gar der Aschenregen der hawaiischen Vulkane bis weit auf die Südsee hinausgetrieben wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
