                ],
                "senses": [
                    {
                        "sense_id": "e8962db2-e530-36d7-a1ad-1bf960322705",
                        "entry_id": "f01a4779-4ea5-3788-87c6-9e51ef3fa40a",
                        "glosses": [
                            "Versorgung der Kulturböden mit atmosphärischer Luft, für besseren Pflanzenwuchs, durch Bearbeitung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbb5594c-5746-4e82-a104-be67f34f5581",
                                "sense_id": "e8962db2-e530-36d7-a1ad-1bf960322705",
                                "text": "„Die Mittel zur Bodenlüftung sind 1. sorgfältige und tiefe Bearbeitung im günstigen physikalischen Zustande der Böden; 2. Entwässerung und Drainage; 3. schmale, hohe Beete mit tiefen Zwischenfurchen (Bifangbau).“"
                            },
                            {
                                "example_id": "429faf9d-0b1d-44b9-9133-75e70e838219",
                                "sense_id": "e8962db2-e530-36d7-a1ad-1bf960322705",
                                "text": "„Die Tiefenlockerung zur Bodenlüftung ist notwendig, damit die Fahrspuren gelockert werden und der Boden für das Bodenleben verbessert wird.“"
                            },
                            {
                                "example_id": "3a0a9224-4dfb-426b-86d7-9501f111529e",
                                "sense_id": "e8962db2-e530-36d7-a1ad-1bf960322705",
                                "text": "„Zielsetzung ist im Wesentlichen die Bodenlüftung, wobei sich in der Praxis nachfolgende Aerifiziermaßnahmen als besonders geeignet und praktikabel herausgestellt haben: […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "756035c8-1510-32d0-847f-86822213cc61",
                        "entry_id": "f01a4779-4ea5-3788-87c6-9e51ef3fa40a",
                        "glosses": [
                            "Öffnungen zu oder in einem Boden, durch die gezielt Luft in einen Raum strömen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2eb03cc6-a16d-4705-a10a-ae531146d67f",
                                "sense_id": "756035c8-1510-32d0-847f-86822213cc61",
                                "text": "„Die Bodenlüftung erfolgt in die Schränke und kollidiert mit der Querlüftung.“"
                            },
                            {
                                "example_id": "4ffa7e11-f319-4e7a-a251-fe0117acdc08",
                                "sense_id": "756035c8-1510-32d0-847f-86822213cc61",
                                "text": "„Bestens geeignet ist hierfür die räumlich diagonale Anbringung z.B. einer Dach- oder Seitenlüftung und einer Bodenlüftung.“"
                            },
                            {
                                "example_id": "5bab64e9-9a60-4d30-a3b4-f723c7eddc87",
                                "sense_id": "756035c8-1510-32d0-847f-86822213cc61",
                                "text": "„Flaschenschränke müssen verschließbar, aus nicht brennbaren Material bestehen und mit einer Bodenlüftung z. B. Gitterrost versehen sein.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
