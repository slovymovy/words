                    {
                        "translation_id": "6341d36c-90a5-4c43-b8a6-2925107b9079",
                        "source_entry_id": "d4798e48-7df6-36df-977f-19e8d8905863",
                        "source_sense_id": "5152b5b4-be67-3877-b8a2-7ccfd19d3e20",
                        "source_sense_description": "EDV: Interaktivität, Dialog",
                        "target_lang_word": "Interaktivität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Interaktivität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f462d46e-2d3f-34f2-9997-eaa51ae8c2dc",
                                        "entry_id": "33ba25eb-c4b7-31c2-bd06-bf03ef837c4b",
                                        "glosses": [
                                            "Eigenschaft/Handlung, die in deutlichem Maße austauschendes (interaktives) Verhalten zeigt, bei dem auf einen Impuls eine Reaktion erfolgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e67c33d-d27c-405a-927d-2b5917954b9b",
                                                "sense_id": "f462d46e-2d3f-34f2-9997-eaa51ae8c2dc",
                                                "text": "„Die Interaktivität ist für die Betrachtung digitaler Medienkunst zentral. Denn die Interaktivität ist das Schlüsselwort der neuen Medientechnologien, das die Differenz gegenüber den traditionellen Medien markiert.“"
                                            },
                                            {
                                                "example_id": "c0f9d34f-f1c5-4099-9286-9716cc0b17a6",
                                                "sense_id": "f462d46e-2d3f-34f2-9997-eaa51ae8c2dc",
                                                "text": "„Ein Dienstleistungsunternehmen muss mit Hilfe der Maßnahmen und Methoden eines Interaktivitätsmarketing die Interaktivitäten positiv steuern und ordnen, die auf den Dienstleistungsprozess Einfluss haben können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f51e9e6c-1669-452c-9f13-f59eded81696",
                        "source_entry_id": "d4798e48-7df6-36df-977f-19e8d8905863",
                        "source_sense_id": "5152b5b4-be67-3877-b8a2-7ccfd19d3e20",
                        "source_sense_description": "EDV: Interaktivität, Dialog",
                        "target_lang_word": "Dialog",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dialog",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0a10c01e-e40c-3a68-8aa5-26e5ded15635",
                                        "entry_id": "b5d16518-9fb8-3a3f-98ce-5d7cef452fb3",
                                        "glosses": [
                                            "Zwiegespräch, Gespräch mit anderen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2e6b474-da6c-4ec5-a5e8-daa73600b4f2",
                                                "sense_id": "0a10c01e-e40c-3a68-8aa5-26e5ded15635",
                                                "text": "Wir werden mit den Gegnern in einen Dialog treten müssen."
                                            },
                                            {
                                                "example_id": "3ccc6ed3-2aa6-42ef-8227-40bd80fd6d54",
                                                "sense_id": "0a10c01e-e40c-3a68-8aa5-26e5ded15635",
                                                "text": "„Jene, die sich ihre Gedanken über die Beschneidung und andere Rituale machen, fürchte ich nicht, denn sie sind bereit, den Dialog zu führen, den zu führen wir selbst seit Jahrzehnten anmahnen.“"
                                            },
                                            {
                                                "example_id": "3ccbc89e-fc9a-4120-83a2-961ba79a3124",
                                                "sense_id": "0a10c01e-e40c-3a68-8aa5-26e5ded15635",
                                                "text": "„Ein Dialog wird im Allgemeinen durch Respekt, Interesse, Empathie und Verständnis dem Dialogpartner gegenüber gespeist.“"
                                            },
                                            {
                                                "example_id": "00ac4af7-c571-46e1-a213-734a1958b353",
                                                "sense_id": "0a10c01e-e40c-3a68-8aa5-26e5ded15635",
                                                "text": "„Der öffentliche Dialog in Deutschland liegt größtenteils auf dem Gesprächsniveau einer Teenie-Clique auf dem Schulhof.“"
                                            },
                                            {
                                                "example_id": "9f0bec10-59b3-47dd-ac4b-412598dfd014",
                                                "sense_id": "0a10c01e-e40c-3a68-8aa5-26e5ded15635",
                                                "text": "„Im Originaltext sprechen die beiden lateinisch miteinander, was dem Dialog eine unfreiwillig komische Note verleiht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d46469f2-8461-32fd-b0ee-00070dc00fd8",
                                        "entry_id": "b5d16518-9fb8-3a3f-98ce-5d7cef452fb3",
                                        "glosses": [
                                            "schriftliche Sammlung von Gesprächen, Drehbuch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d092748d-7898-40f9-9895-e6024770606f",
                                                "sense_id": "d46469f2-8461-32fd-b0ee-00070dc00fd8",
                                                "text": "Der Autor hat alle Anweisungen im Dialog schriftlich festgehalten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "69c3eaa6-2939-354b-b239-2fe48be6a78b",
                                        "entry_id": "b5d16518-9fb8-3a3f-98ce-5d7cef452fb3",
                                        "glosses": [
                                            "spezielles, nichtprimäres Fenster einer Anwendung"
