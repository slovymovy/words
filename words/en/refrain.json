{
    "word_family": [
        "refrainment"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b6689dbb-6fd3-3709-966e-86b16c06e664",
                    "sense_definition": "To stop oneself from doing something; to deliberately abstain.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "restrain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>refrain</w> from smoking while inside the university library.",
                            "target_lang_translations": {
                                "nl": "Gelieve <w>u te onthouden</w> van roken in de universiteitsbibliotheek."
                            }
                        },
                        {
                            "text": "He wanted to yell in frustration, but he managed to <w>refrain</w> from making any noise.",
                            "target_lang_translations": {
                                "nl": "Hij wilde schreeuwen van frustratie, maar hij slaagde erin om <w>zich te onthouden</w> van enig geluid."
                            }
                        }
                    ],
                    "common_phrases": [
                        "refrain from doing",
                        "refrain from comment"
                    ],
                    "target_lang_definitions": {
                        "nl": "Zichzelf ervan weerhouden iets te doen; bewust nalaten."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "zich onthouden",
                                "target_lang_sense_clarification": "van een handeling, gewoonlijk met 'van'"
                            },
                            {
                                "target_lang_word": "nalaten",
                                "target_lang_sense_clarification": "iets niet doen"
                            },
                            {
                                "target_lang_word": "zich weerhouden",
                                "target_lang_sense_clarification": "zichzelf tegenhouden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5226f8c4-f585-37f0-a0cf-a24a1b293f80",
                    "sense_definition": "To show restraint; to hold oneself back.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "restrain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Overcome with excitement, she could barely <w>refrain</w> herself from shouting.",
                            "target_lang_translations": {
                                "nl": "Overmand door opwinding kon ze <w>zich</w> nauwelijks <w>inhouden</w> om niet te gaan schreeuwen."
                            }
                        },
                        {
                            "text": "He tried hard to <w>refrain</w> himself despite the persistent insults.",
                            "target_lang_translations": {
                                "nl": "Hij deed erg zijn best om <w>zich te beheersen</w> ondanks de aanhoudende beledigingen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used reflexively"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Zelfbeheersing tonen; zichzelf inhouden of beheersen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "zich inhouden",
                                "target_lang_sense_clarification": "zichzelf beheersen"
                            },
                            {
                                "target_lang_word": "zich bedwingen",
                                "target_lang_sense_clarification": "zelfbeheersing uitoefenen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38ac744d-fc48-39a0-9a8a-d005280d4c32",
                    "sense_definition": "To repress a desire or emotion; to curb or keep in check.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "restrain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He fought to <w>refrain</w> his rising anger during the tense negotiations.",
                            "target_lang_translations": {
                                "nl": "Hij vocht om zijn opkomende woede te <w>bedwingen</w> tijdens de gespannen onderhandelingen."
                            }
                        },
                        {
                            "text": "She could not <w>refrain</w> her natural curiosity when opening the package.",
                            "target_lang_translations": {
                                "nl": "Ze kon haar natuurlijke nieuwsgierigheid niet <w>bedwingen</w> toen ze het pakket opende."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used transitively"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een verlangen of emotie onderdrukken of in toom houden."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bedwingen",
                                "target_lang_sense_clarification": "van emoties of verlangens"
                            },
                            {
                                "target_lang_word": "onderdrukken",
                                "target_lang_sense_clarification": "van gevoelens"
                            },
                            {
                                "target_lang_word": "intomen",
                                "target_lang_sense_clarification": "in bedwang houden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d94cd6a-45fe-30b4-b3fc-4439a27c56e8",
                    "sense_definition": "To hold back or restrain someone or something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "restrain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guards were ordered to <w>refrain</w> the crowd from entering the palace.",
                            "target_lang_translations": {
                                "nl": "De bewakers kregen het bevel om de menigte <w>tegen te houden</w> het paleis te betreden."
                            }
                        },
                        {
                            "text": "He was urged to <w>refrain</w> his companion before another fight broke out.",
                            "target_lang_translations": {
                                "nl": "Hij werd aangespoord om zijn metgezel <w>in bedwang te houden</w> voordat er opnieuw ruzie uitbrak."
                            }
                        }
                    ],
                    "synonyms": [
                        "hold"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used transitively"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemand of iets tegenhouden of weerhouden."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "tegenhouden",
                                "target_lang_sense_clarification": "iemand beletten iets te doen"
                            },
                            {
                                "target_lang_word": "weerhouden",
                                "target_lang_sense_clarification": "iemand tegenhouden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95ff6dac-cd0f-34c5-9b57-d6aa74aa980e",
                    "sense_definition": "To abstain from consuming specific food or drink.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "restrain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient was advised to <w>refrain</w> cold drink until his throat healed.",
                            "target_lang_translations": {
                                "nl": "De patiënt werd aangeraden koude dranken te <w>mijden</w> totdat zijn keel genezen was."
                            }
                        },
                        {
                            "text": "During the fast, they chose to <w>refrain</w> all meat and sweets.",
                            "target_lang_translations": {
                                "nl": "Tijdens het vasten kozen ze ervoor om <w>zich te onthouden van</w> al het vlees en zoetigheden."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used transitively"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Zich onthouden van specifieke voeding of drank."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "zich onthouden van",
                                "target_lang_sense_clarification": "van eten of drinken"
                            },
                            {
                                "target_lang_word": "mijden",
                                "target_lang_sense_clarification": "uit de weg gaan, niet consumeren"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "381ffa21-4460-3d00-9575-7a4eaec6341a",
                    "sense_definition": "A repeated chorus, line, or phrase occurring at regular intervals in a song or poem.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "repetition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The audience sang along enthusiastically whenever the chorus reached the catchy <w>refrain</w>.",
                            "target_lang_translations": {
                                "nl": "Het publiek zong enthousiast mee telkens wanneer het koor het aanstekelijke <w>refrein</w> bereikte."
                            }
                        },
                        {
                            "text": "Each stanza of the traditional ballad concluded with the same haunting <w>refrain</w>.",
                            "target_lang_translations": {
                                "nl": "Elke strofe van de traditionele ballade eindigde met hetzelfde beklijvende <w>refrein</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "familiar refrain",
                        "catchy refrain"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een herhaald refrein, regel of frase in een lied of gedicht."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "refrein",
                                "target_lang_sense_clarification": "in een lied of gedicht"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0799980-c545-37bc-9f7c-c3812a5b44a8",
                    "sense_definition": "A frequently repeated comment, complaint, or statement.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "repetition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Complaining about local traffic has become a familiar <w>refrain</w> among residents.",
                            "target_lang_translations": {
                                "nl": "Klagen over het plaatselijke verkeer is een bekend <w>refrein</w> geworden onder de bewoners."
                            }
                        },
                        {
                            "text": "The politician repeated the same old <w>refrain</w> about lowering taxes.",
                            "target_lang_translations": {
                                "nl": "De politicus herhaalde hetzelfde oude <w>riedeltje</w> over belastingverlaging."
                            }
                        }
                    ],
                    "synonyms": [
                        "old saw"
                    ],
                    "common_phrases": [
                        "constant refrain",
                        "familiar refrain"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een veelvuldig herhaalde opmerking, klacht of uitspraak."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "refrein",
                                "target_lang_sense_clarification": "figuurlijk, telkens herhaalde uitspraak"
                            },
                            {
                                "target_lang_word": "cliché",
                                "target_lang_sense_clarification": "vaak herhaald gezegde"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}