                "senses": [
                    {
                        "sense_id": "e3411731-6f12-33cb-a0fc-743885cc0100",
                        "entry_id": "d6bb82ee-a1f4-369c-82e8-d982268f812b",
                        "glosses": [
                            "mehrgliedriger, paarweise auftretender, vom Rumpf ausgehender Körperteil; vordere, beim Menschen auch obere Gliedmaße"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "a90544de-0057-4619-857b-74d5b8e8c30f",
                                "sense_id": "e3411731-6f12-33cb-a0fc-743885cc0100",
                                "text": "„Flügel sind bei Vögeln zum Fliegen dienende Bewegungsorgane, die durch Umbildung der Vordergliedmaßen entstanden sind.“"
                            },
                            {
                                "example_id": "fec27f24-579b-4351-9a26-00fb437ea01c",
                                "sense_id": "e3411731-6f12-33cb-a0fc-743885cc0100",
                                "text": "„So furchterregend und gefährlich der Tyrannosaurier war, er hatte ein Manko: seine Arme. Mit seinen kümmerlichen Vordergliedmaßen, die nur zwei Finger aufwiesen, konnte er nicht einmal seinen Mund erreichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
