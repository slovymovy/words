                "senses": [
                    {
                        "sense_id": "01e66e79-fa63-3aed-98a0-93d81746a4b8",
                        "entry_id": "733b0575-9aa2-3b86-bda6-103c2ae997a8",
                        "glosses": [
                            "Weichgewebskern des Zahnes, der sich im Zahninneren, dem Pulpencavum und den Wurzelkanälen befindet und der aus Bindegewebe mit Blut- und Lymphgefäßen sowie Nervenfasern besteht"
                        ],
                        "tags": [
                            "Zahnmedizin"
                        ],
                        "examples": [
                            {
                                "example_id": "f829346e-dec7-4780-8983-b9a8060541a5",
                                "sense_id": "01e66e79-fa63-3aed-98a0-93d81746a4b8",
                                "text": "Ist die Zahnpulpa durch Karies eröffnet, dann verursacht der Zahn Zahnschmerzen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
