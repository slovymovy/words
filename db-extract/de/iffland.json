                "senses": [
                    {
                        "sense_id": "e64de1f5-5a36-3422-b495-5aceb35567c2",
                        "entry_id": "a78ed9f2-a407-3ed2-ab4d-ecaae0a3b7a3",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e425e8e-3d77-45ad-9f58-1996e8c39920",
                                "sense_id": "e64de1f5-5a36-3422-b495-5aceb35567c2",
                                "text": "Frau Iffland ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6f2e2de5-15bd-4393-8fcc-0a071eab4057",
                                "sense_id": "e64de1f5-5a36-3422-b495-5aceb35567c2",
                                "text": "Herr Iffland wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e16f60b3-71d6-4ab8-88a9-4b58abf59f0b",
                                "sense_id": "e64de1f5-5a36-3422-b495-5aceb35567c2",
                                "text": "Die Ifflands fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "94849c72-a350-4e5c-a2cf-307f26af9bd4",
                                "sense_id": "e64de1f5-5a36-3422-b495-5aceb35567c2",
                                "text": "Der Iffland trägt nie die Schals, die die Iffland ihm strickt."
                            },
                            {
                                "example_id": "b36da8b7-9ce9-44f2-8c14-c01961ee342a",
                                "sense_id": "e64de1f5-5a36-3422-b495-5aceb35567c2",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Iffland kommt, geht der Herr Iffland.“"
                            },
                            {
                                "example_id": "203ec1d6-2f98-47d3-b993-668c37b27b42",
                                "sense_id": "e64de1f5-5a36-3422-b495-5aceb35567c2",
                                "text": "Iffland kommt und geht."
                            },
                            {
                                "example_id": "f6766f87-89d2-4459-ba0e-3830f451b8da",
                                "sense_id": "e64de1f5-5a36-3422-b495-5aceb35567c2",
                                "text": "Ifflands kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
