                                "sense_id": "d3f3348e-cfc1-30d0-bdcd-06dbb11b8e91",
                                "text": "„Die Revolutionäre lehnten sich daraufhin immer stärker an die Sowjetunion an, die zu Kubas Schutzmacht aufstieg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
