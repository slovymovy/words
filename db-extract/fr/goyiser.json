                "senses": [
                    {
                        "sense_id": "cd3be757-8df7-310c-9b87-8cae02b32ca5",
                        "entry_id": "49650917-17e4-3f58-b11d-1fc5457a6513",
                        "glosses": [
                            "Donner un caractère goy à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b795dcc6-57cb-4ad3-99e1-35c5c58c620c",
                                "sense_id": "cd3be757-8df7-310c-9b87-8cae02b32ca5",
                                "text": "Mais il a demandé à son co-scénariste de la goyiser au maximum, en insistant notamment sur le fait que le héros devait avait un nom WASP, et passe-partout."
                            },
                            {
                                "example_id": "e0b52d35-d3cc-4d65-8b6f-c63b96d5641d",
                                "sense_id": "cd3be757-8df7-310c-9b87-8cae02b32ca5",
                                "text": "Pour la doctrine aryenne, plus du ressort d’Himmler que de Hitler, ce n’est pas la théosophie qui inspira Hitler mais l’Ancien Testament, avec la notion de « peuple élu » qui fut « goyisé » en « race supérieure »."
                            },
                            {
                                "example_id": "daba51cb-3189-4058-8120-5a1b28e046b8",
                                "sense_id": "cd3be757-8df7-310c-9b87-8cae02b32ca5",
                                "text": "En même temps, les ashke sont goyisés par leur histoire, c'est ce que je voulais dire."
                            }
                        ]
                    }
