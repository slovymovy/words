                "senses": [
                    {
                        "sense_id": "1c09ae01-9dfa-3bb2-b7ed-5a5dd0332091",
                        "entry_id": "123020f4-6bca-3ce9-928e-3bc67e2f34eb",
                        "glosses": [
                            "niederträchtige/schurkische Handlungsweise oder Tat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fa395d2-5ad1-43df-b740-ae73491de457",
                                "sense_id": "1c09ae01-9dfa-3bb2-b7ed-5a5dd0332091",
                                "text": "„Ich legte ihm dar, daß er unbedingt höchst vorsichtig sein müsse, denn es wäre die erbärmlichste Schurkerei, wenn seinetwegen das unvergleichliche Geschöpf, das er verführt hatte, ins Unglück geraten würde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
