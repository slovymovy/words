                    {
                        "translation_id": "b13fac16-a470-46b4-884b-bcbb6bfb0d1e",
                        "source_entry_id": "dcd862a0-3462-356c-94bc-d20e31ef7349",
                        "source_sense_id": "dbc81343-c4cc-3c81-832e-8245a8240d0f",
