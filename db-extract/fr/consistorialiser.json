                "senses": [
                    {
                        "sense_id": "90b3f874-53bd-3bf3-817e-fa9d036f075f",
                        "entry_id": "485ecd95-6607-3045-95df-e3fcb3eb0ce9",
                        "glosses": [
                            "Doter d’un consistoire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d56acf7d-a1b1-4554-baa5-a5df118bbd47",
                                "sense_id": "90b3f874-53bd-3bf3-817e-fa9d036f075f",
                                "text": "Peut-on «consistorialiser» l'islam de France en faisant fi de sa pluralité organisationnelle et de sa pluralité de pratiques?"
                            },
                            {
                                "example_id": "8e1dc582-253b-40fd-be5b-aa64caa22c06",
                                "sense_id": "90b3f874-53bd-3bf3-817e-fa9d036f075f",
                                "text": "A vouloir « ecclésifier » ou « consistorialiser » _ selon les néologismes proposés par Danièle Hervieu-Léger _ des groupes religieux, comme l'islam, qui ne sont pas encore dotés de structures représentatives centralisées, on prend le « risque de minorer ou, pire, d'ignorer des expériences locales, parfois originales et alternatives, de régulation concrète d'une réalité religieuse qui se diversifie », constate l'un des responsables de cet ouvrage collectif."
                            }
                        ]
                    }
