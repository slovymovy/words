                "senses": [
                    {
                        "sense_id": "4420e5f7-101f-3c87-b81c-5daa939687bd",
                        "entry_id": "e390b9e9-a5b1-334e-b452-fb66ab0e580f",
                        "glosses": [
                            "светильник в виде черепка, плошки, блюдечка с фитилём, опущенным в сало или растительное масло"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84d0719b-311b-4e8e-b217-e3e1ae1f5020",
                                "sense_id": "4420e5f7-101f-3c87-b81c-5daa939687bd",
                                "text": "По краям каганца воск застыл ровным жёлтым слоем, а на середине вздулся светлый пузырь величиной с фасолину."
                            },
                            {
                                "example_id": "f98c7306-b44c-4048-ad95-d6ac85345eb8",
                                "sense_id": "4420e5f7-101f-3c87-b81c-5daa939687bd",
                                "text": "Домна вернулась в избу, ни на кого не взглянула и молча засветила у каганца лучинную засветку."
                            }
                        ]
                    }
