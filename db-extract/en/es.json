                "senses": [
                    {
                        "sense_id": "78dd1edd-5f16-3311-8ea8-c32b2757862d",
                        "entry_id": "9344bb11-31a3-3313-a709-f5a745384815",
                        "glosses": [
                            "Initialism of Espírito Santo: a state of Brazil."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "initialism"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1439698b-8dc4-36b5-9e5e-3eccb395908e",
                        "entry_id": "9344bb11-31a3-3313-a709-f5a745384815",
                        "glosses": [
                            "Initialism of ECMAScript."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "initialism"
                        ],
                        "examples": [
                            {
                                "example_id": "aef17f9b-af64-4a7d-90eb-ecf64c8e1e20",
                                "sense_id": "1439698b-8dc4-36b5-9e5e-3eccb395908e",
                                "text": "Work is underway, though, on the next generation of ES, appropriately named ES.Next (ECMA-262 Edition 6), but commonly referred to as ES 6. / As consensus is reached on new ES features, they’re added to the existing draft specification. They’re also listed in ES compatibility tables, such as the ones Mozilla incorporates in much of its documentation, and the exceedingly helpful ECMAScript 6 Compatibility Table."
                            },
                            {
                                "example_id": "504208e7-e487-4a8f-984f-f42298a0ba33",
                                "sense_id": "1439698b-8dc4-36b5-9e5e-3eccb395908e",
                                "text": "Several implementations of ES exist, for example, JavaScript, JScript, and Nashorn JavaScript."
                            },
                            {
                                "example_id": "e2a79598-2cc8-4a02-bdf6-dfaeea497e1b",
                                "sense_id": "1439698b-8dc4-36b5-9e5e-3eccb395908e",
                                "text": "If you open the tsconfig.json file in the project root folder, you can check which ES version is used in building your application and which ES version is used to target your browser."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
