                "senses": [
                    {
                        "sense_id": "c1f427bf-94ae-3cd5-9f53-45874e0d4de3",
                        "entry_id": "76da07da-6b02-3ad2-87e8-76857e70d44b",
                        "glosses": [
                            "meist Mädchen beziehungsweise junge Frauen mit promiskuitiven Verhältnis(sen) mit vielzähligen Jungs beziehungsweise Männern aus ihrem Umfeld"
                        ],
                        "tags": [
                            "colloquial",
                            "figurative",
                            "pejorative",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "ef67bf47-9da2-4495-b153-482dc1499039",
                                "sense_id": "c1f427bf-94ae-3cd5-9f53-45874e0d4de3",
                                "text": "„›Landkreismatratze‹ oder ›Dorfmatratze‹ ist beispielsweise ein Ausdruck für ein Mädchen, das mit vielen Jungs aus [ihrer] Umgebung schläft.“"
                            },
                            {
                                "example_id": "35286ce5-d74a-4755-8a01-7809de300c68",
                                "sense_id": "c1f427bf-94ae-3cd5-9f53-45874e0d4de3",
                                "text": "„Eine Dorfmatratze war jede Frau, die mit mehr als drei Männern Sex gehabt hatte, ohne mit ihnen verheiratet oder wenigstens verlobt zu sein.“"
                            },
                            {
                                "example_id": "92181d13-2471-46c6-b1df-0c41833004dc",
                                "sense_id": "c1f427bf-94ae-3cd5-9f53-45874e0d4de3",
                                "text": "„Bei uns nennt man diese Art Frauen Dorfmatratze.“"
                            },
                            {
                                "example_id": "8b7894bf-8503-4324-9d54-b399c55a5111",
                                "sense_id": "c1f427bf-94ae-3cd5-9f53-45874e0d4de3",
                                "text": "„Hinzu kommt, dass Frauen gelernt haben, dass eine Frau mit vielen sexuellen Abenteuern als Flittchen gilt, als Schlampe, Dorfmatratze etc.“"
                            },
                            {
                                "example_id": "f6d23130-e177-4064-89ba-38acdb1bb17c",
                                "sense_id": "c1f427bf-94ae-3cd5-9f53-45874e0d4de3",
                                "text": "„Der Gedanke an ihren ermordeten Schwarm und die Annahme, dass er kurz vor seinem Tod ausgerechnet mit der schäbigen Dorfmatratze Sex gehabt haben soll, machten sie traurig und wütend zugleich.“"
                            },
                            {
                                "example_id": "69e70a32-fb62-4858-ad7e-83418a47d41f",
                                "sense_id": "c1f427bf-94ae-3cd5-9f53-45874e0d4de3",
                                "text": "„Eine Art Dorfmatratze auf Studentenniveau also, auf welcher jedermann mal liegen und seinen Spaß haben konnte, an welche sich aber niemand wirklich binden mochte, hatte sie mal Sorgen oder Probleme.“"
                            },
                            {
                                "example_id": "4a87ee0f-c206-483a-bbad-18d9f2b6458a",
                                "sense_id": "c1f427bf-94ae-3cd5-9f53-45874e0d4de3",
                                "text": "„Ein ‚Ausrutscher‘ mag ja noch irgendwie verdaubar sein, aber mit der ‚Dorfmatratze‘ willst du keine Beziehung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
