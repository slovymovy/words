                                "target_lang_word": "后防线",
                                "target_lang_sense_clarification": "美式橄榄球防守组"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04e65b84-4936-3f3a-9908-3fe0fc60570f",
                    "sense_definition": "A flight feather growing from the second joint (forearm) of a bird's wing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bird spread its wings, revealing the bright colors on its <w>secondaries</w>.",
                            "target_lang_translations": {
                                "ru": "Птица расправила крылья, открыв яркие цвета на <w>маховых перьях второго порядка</w>.",
