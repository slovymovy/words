                                        ],
                                        "examples": [
                                            {
                                                "example_id": "248339ea-aa8b-4915-91b1-851a941a8771",
                                                "sense_id": "62e06f3c-fbb0-3361-95bc-c5760a34ab1e",
                                                "text": "„Aus dem Horn, mit dem die Metzger seit jeher ihre Ankunft zum Vieheinkauf ankündigten, ging das Posthorn hervor.“"
                                            },
                                            {
                                                "example_id": "3262af72-46a4-431e-92ab-5800472504fa",
                                                "sense_id": "62e06f3c-fbb0-3361-95bc-c5760a34ab1e",
                                                "text": "„Auf die Metzgerposten, die bis Ende des 17. Jahrhunderts existierten, soll auch die Entstehung des Posthorns zurückgehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1b3445e0-9096-3a08-b5f7-8e1a12cd7482",
