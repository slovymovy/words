                                "sense_id": "12c8ebc1-2bd5-3e2d-839f-b3aaf8783208",
                                "text": "Film był niezły, ale ścieżka audio złej jakości."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "512250a2-70f4-3a4a-94aa-21e73246ecdf",
                        "entry_id": "ac12d658-e053-3ef6-ab69-894e2d823120",
                        "glosses": [
                            "zapisujący, odtwarzający, przetwarzający, wzmacniający lub przesyłający dźwięk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27814c02-a2ac-4a96-9b25-8527c9b49c98",
                                "sense_id": "512250a2-70f4-3a4a-94aa-21e73246ecdf",
                                "text": "Najtańszy sprzęt audio w internecie!"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bbe3a9db-7bb3-4efc-be80-9575c69f5591",
                        "source_entry_id": "ac12d658-e053-3ef6-ab69-894e2d823120",
                        "source_sense_id": "12c8ebc1-2bd5-3e2d-839f-b3aaf8783208",
                        "target_lang_word": "audio",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "audio",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dec6726f-e341-355d-9d52-b3285a077dfb",
                                        "entry_id": "9cb1ac51-5b67-3e53-a5ad-bdce81add46c",
                                        "glosses": [
                                            "Focused on audible sound, as opposed to sight."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89d79bfa-e2d0-4d29-9a9b-88bdc97269df",
                                                "sense_id": "dec6726f-e341-355d-9d52-b3285a077dfb",
                                                "text": "If you're more audio than visual, tune in on the \"A-V Soap Opera\" (page 375)."
                                            },
                                            {
                                                "example_id": "a0ee5bd2-86dd-4544-9060-1c6a765565ca",
                                                "sense_id": "dec6726f-e341-355d-9d52-b3285a077dfb",
                                                "text": "I'm very audio, so I hear words."
                                            },
                                            {
                                                "example_id": "9b4a9338-480f-4d80-b070-6adbab77ea9b",
                                                "sense_id": "dec6726f-e341-355d-9d52-b3285a077dfb",
                                                "text": "For example, if the person uses visual predicates such as “I see” or “I can't picture that,” the most powerful influencers will respond by saying “Let me show you,” as opposed to “let me explain,” the latter predicate being more audio than visual."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "audio",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5db7c949-1048-380b-81cd-632751ac32b8",
                                        "entry_id": "0f77786b-755f-3c69-b322-50d5d3289341",
                                        "glosses": [
                                            "Sound, or a sound signal."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1599c7c0-67ce-3d6f-a29d-81386608c468",
                                        "entry_id": "0f77786b-755f-3c69-b322-50d5d3289341",
                                        "glosses": [
                                            "A piece of sound that is recorded electronically."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4577fa1c-58c5-45ee-863e-493172f0d114",
                                                "sense_id": "1599c7c0-67ce-3d6f-a29d-81386608c468",
                                                "text": "I DMed him an audio of myself singing the South Park intro."
                                            },
                                            {
                                                "example_id": "3221cb90-8d15-40af-b8e7-d95500a1932f",
                                                "sense_id": "1599c7c0-67ce-3d6f-a29d-81386608c468",
                                                "text": "Others wryly illustrate appropriated audios, like instructions for quacking like a duck or a letter from an angry airline passenger."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
