                        "cross_references": [
                            {
                                "target_word": "Juche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "426b1c2d-b5a8-33b7-9ed6-5df24efed111",
                                        "entry_id": "15899ea9-7336-3033-833b-d2408e93a768",
                                        "glosses": [
                                            "Doctrine politique totalitaire basée sur l’indépendance nationale de la Corée du Nord et son autosuffisance économique."
                                        ],
                                        "tags": [
                                            "Juché"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7204d56-2efa-4724-8aae-1f5bf9344c1a",
                                                "sense_id": "426b1c2d-b5a8-33b7-9ed6-5df24efed111",
                                                "text": "Sur la rive opposée du Taedong, dans l’alignement exact de la statue géante de Kim Il-sung, se dresse, presque aussi haute qu’elle, la flèche du Juche, culmination de la théorie, immuable elle aussi, plus nécessaire aujourd’hui que jamais."
                                            },
                                            {
                                                "example_id": "88bcd23a-0936-467d-af69-03a8a757f8d0",
                                                "sense_id": "426b1c2d-b5a8-33b7-9ed6-5df24efed111",
                                                "text": "Le « Juche » est l’idéologie officielle du régime nord-coréen."
                                            },
                                            {
                                                "example_id": "2282c4b3-f107-446c-841d-7d413608b62d",
                                                "sense_id": "426b1c2d-b5a8-33b7-9ed6-5df24efed111",
                                                "text": "Le PCJF (parti communiste Juchéen de France) aussi appelé PCJ (parti communiste du Juche) est un parti politique français pro-Corée du nord."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
