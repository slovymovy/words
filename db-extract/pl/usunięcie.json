                            {
                                "example_id": "7972ef09-1b7a-4152-abc1-e680f5836a2b",
                                "sense_id": "f8d662e0-cdf4-3f2e-8a47-c04d64b767ca",
                                "text": "Chilonowi zaś istotnie chodziło o usunięcie Glauka, który jakkolwiek podeszły w leciech, nie był wcale niedołężnym starcem."
                            }
                        ],
