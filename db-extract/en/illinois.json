                    {
                        "translation_id": "d7c3e8c3-99d2-4a61-827f-d3d13ba45f45",
                        "source_entry_id": "c34d7f51-74b2-3dfc-8735-c70b20694458",
                        "source_sense_description": "a state of the United States of America",
                        "target_lang_word": "Illinois",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Illinois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "da2acdc7-68a0-3590-b4a2-8ff0235fca3a",
                                        "entry_id": "b4e77f01-c2b9-3bf3-936e-33ae9f9d1267",
                                        "glosses": [
                                            "Amérindiens vivant au sud des Grands Lacs dans la haute vallée du Mississippi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76dadf41-d7a2-4162-804b-23a5e27ed25c",
                                                "sense_id": "da2acdc7-68a0-3590-b4a2-8ff0235fca3a",
                                                "text": "Les Illinois parlaient plusieurs dialectes de la langue miami-illinois qui fait partie de la famille des langues algonquines."
                                            },
                                            {
                                                "example_id": "5eb0f08a-3452-4276-b29b-260098c24fd2",
                                                "sense_id": "da2acdc7-68a0-3590-b4a2-8ff0235fca3a",
                                                "text": "Le pays des Illinois est encore arrosé par d’autres grandes rivieres. […] Dans un si grand pays, on ne connoît que trois villages, dont l’un peuplé de huit ou neuf cent Illinois, est à plus de 50 lieues du second."
                                            },
                                            {
                                                "example_id": "eddd1ea4-c31b-4700-970e-15714de1a318",
                                                "sense_id": "da2acdc7-68a0-3590-b4a2-8ff0235fca3a",
                                                "text": "Sylvie devint ingénieuse et poussa les raffinements de sa tyrannie jusqu’aux recherches les plus sauvages. Les Illinois, les Chérokées, les Mohicans auraient pu s’instruire avec elle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Illinois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f792b76e-33fb-39cf-818c-6e184ddc4e3a",
                                        "entry_id": "b77b5330-5136-3704-8a10-29837fadea32",
                                        "glosses": [
                                            "Un des cinquante États des États-Unis d’Amérique (code postal IL), bordé par le Wisconsin au nord, le lac Michigan au nord-est, l’Indiana à l’est, le Kentucky au sud-est, le Missouri au sud-ouest, et l’Iowa au nord-ouest. Sa capitale est Springfield."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f178f347-d034-451e-a394-938ca84e9780",
                                                "sense_id": "f792b76e-33fb-39cf-818c-6e184ddc4e3a",
                                                "text": "Je vis en Illinois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36571bab-ae41-3fc5-a777-322f085fea68",
                                        "entry_id": "b77b5330-5136-3704-8a10-29837fadea32",
                                        "glosses": [
                                            "Affluent principal du fleuve Mississippi, dans l'État de l'Illinois au nord des États-Unis."
                                        ],
                                        "tags": [
                                            "Cours d’eau"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19f6bd90-3929-4aa6-ba79-23f19e5fa937",
                        "source_entry_id": "c34d7f51-74b2-3dfc-8735-c70b20694458",
                        "source_sense_description": "a state of the United States of America",
                        "target_lang_word": "Illinois",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Illinois",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a877ad89-23de-30ab-8d6d-91fc1726086d",
                                        "entry_id": "83c27d52-4790-3eeb-9cd2-919bff26a051",
                                        "glosses": [
                                            "US-Bundesstaat im mittleren Westen der USA"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53b7363f-2661-470d-a1c8-7fe5148b24f9",
                                                "sense_id": "a877ad89-23de-30ab-8d6d-91fc1726086d",
                                                "text": "Im Jahre 1818 wurde Illinois dann als 21. Bundesstaat in die USA aufgenommen."
                                            },
                                            {
                                                "example_id": "4f4d5506-f6da-44b6-bd7d-a05297ab8ec9",
                                                "sense_id": "a877ad89-23de-30ab-8d6d-91fc1726086d",
                                                "text": "„Illinois hat sehr fruchtbare Böden, die überwiegend zum Soja- und Maisanbau (Corn Belt) genutzt werden.“"
                                            },
                                            {
                                                "example_id": "dbb34be1-3c66-46d4-b167-fb6916ccaf33",
                                                "sense_id": "a877ad89-23de-30ab-8d6d-91fc1726086d",
                                                "text": "Dabei gilt der Sklavenbefreier Lincoln, ein Republikaner aus Illinois, als Vorbild Barack Obamas und gemeinhin als größter Präsident der US-Geschichte – und nebenbei auch als der größtgewachsene."
                                            },
                                            {
                                                "example_id": "bb288db1-6862-44f4-9ac1-ace777a814a9",
                                                "sense_id": "a877ad89-23de-30ab-8d6d-91fc1726086d",
                                                "text": "Die Amerikaner hatten den jungen Senator aus Illinois, der innerhalb kürzester Zeit zum Star der US-Demokraten aufgestiegen war, zu ihrem ersten afro-amerikanischen Präsidenten gemacht."
                                            },
                                            {
                                                "example_id": "e5cbbc6d-6d63-4995-8b99-cabafb0df723",
                                                "sense_id": "a877ad89-23de-30ab-8d6d-91fc1726086d",
                                                "text": "Dabei besucht er die Bundesstaaten Minnesota, Iowa und Illinois, die unter der Wirtschaftskrise sehr gelitten haben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
