                                    {
                                        "sense_id": "9ce464af-e2de-3154-b962-6606c7478748",
                                        "entry_id": "18be73c4-f369-3db9-993b-43a826295872",
                                        "glosses": [
                                            "A bag of wool, traditionally weighing 240 pounds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0496dbc0-36dd-4ddc-8ca1-bf77f2b69b14",
                                                "sense_id": "9ce464af-e2de-3154-b962-6606c7478748",
                                                "text": "There was a Fellow with a Wen in his Neck, larger than five Woolpacks, and another with a couple of wooden Legs, each about twenty foot high."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "166a455c-5678-3bb5-92ba-d98267519eb5",
                                        "entry_id": "18be73c4-f369-3db9-993b-43a826295872",
                                        "glosses": [
                                            "A cirrocumulus cloud."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59514e6e-116d-4a59-aa4c-1f3cc26388f9",
                                                "sense_id": "166a455c-5678-3bb5-92ba-d98267519eb5",
                                                "text": "During the following hour, the high white fleecy clouds lowered and congested and grayed into woolpack."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55f39ab1-0604-3084-ac66-2e1ff38f78c9",
                                        "entry_id": "18be73c4-f369-3db9-993b-43a826295872",
                                        "glosses": [
                                            "A charge resembling a pillow or cushion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99455a69-3f42-43a1-8db6-85ac36b71212",
                        "source_entry_id": "f3c71e1f-9e0b-3c90-9725-7d01187acbdb",
                        "source_sense_id": "abde1453-3534-343e-8514-765bd9bb9aa5",
