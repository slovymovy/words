                                "target_word": "Veräußerung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "82de2195-9da1-3844-92ed-8a00fa07f76a",
                                        "entry_id": "719627de-536b-309c-99f5-39d3f866c718",
                                        "glosses": [
                                            "Übertragung des Eigentums an Sachen oder Abtretung von Forderungen und sonstigen Rechten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e470271-ba8a-4d72-bcb4-211aaa65d7a3",
                                                "sense_id": "82de2195-9da1-3844-92ed-8a00fa07f76a",
                                                "text": "„Bei einer Immobilie im Wert von 500 000 Euro sind also im Falle einer schnellen Veräußerung 50 000 Euro oder mehr einfach verpufft.“"
                                            }
                                        ],
