                    {
                        "sense_id": "54251ba3-1238-3baa-9ef7-4cadac1feb8d",
                        "entry_id": "c6bfd22f-8af3-3564-9eff-8055894b7371",
                        "glosses": [
                            "Markierung, von der aus ein Eckball geschlagen wird"
                        ],
                        "tags": [
                            "Radball"
                        ],
                        "examples": [
                            {
                                "example_id": "d7951349-42a5-4d00-b7e1-50310f695855",
                                "sense_id": "54251ba3-1238-3baa-9ef7-4cadac1feb8d",
                                "text": "Die Eckballmarken sind 1 m von der Seitenlinie und 2 m von der Torauslinie entfernt, an allen vier Ecken durch Punkte zu kennzeichnen."
                            },
                            {
                                "example_id": "d233320f-6e03-44be-afbd-53ea0560beba",
                                "sense_id": "54251ba3-1238-3baa-9ef7-4cadac1feb8d",
                                "text": "Wird der Ball von einem Spieler, dessen Körper oder Rad über die eigene Torauslinie (außerhalb des Tores) befördert, muss der Kommissär das Spiel abpfeifen und den Ball auf der entsprechenden Seite auf die Eckballmarke legen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
