                                "target_senses": [
                                    {
                                        "sense_id": "58ef66b5-fa72-36f9-8ea6-bc32317858bb",
                                        "entry_id": "4151d344-09fc-3d17-9337-16af5dfeba48",
                                        "glosses": [
                                            "das Dehnen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2477ef31-d3b4-318d-967b-203629e64fa5",
                                        "entry_id": "4151d344-09fc-3d17-9337-16af5dfeba48",
                                        "glosses": [
                                            "das Dehnen",
                                            "die räumliche Vergrößerung eines Materials, etwa durch Ziehen an gegenüberliegenden Seiten, Anwendung von Elektrizität oder Wärme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7982f722-01b2-4f83-b34a-99610a499044",
                                                "sense_id": "2477ef31-d3b4-318d-967b-203629e64fa5",
                                                "text": "Durch Anlegen starker elektrischer Felder wird die Mehrzahl der Domänen in Richtung des Feldes orientiert – man spricht von „Polung“ –, die Keramik wird piezoelektrisch. Gleichzeitig wird durch Ausrichten der gestreckten Zellen und Kristallite in Feldrichtung eine starke Dehnung erzeugt, die in den Piezoaktoren genutzt wird."
                                            },
                                            {
                                                "example_id": "7ef9d607-fd6a-4f8c-88d6-5df4e2b497ab",
                                                "sense_id": "2477ef31-d3b4-318d-967b-203629e64fa5",
                                                "text": "42 wissenschaftliche Veröffentlichungen, sowohl auf chemischem als auch auf physikalisch-technologischem Gebiet, liegen bereits von dem Aachener Institut vor, wobei u. a. die Veränderung der Festigkeit und Dehnung von Wolle nach radioaktiver Bestrahlung und Kobaltstrahlung in Gegenwart von Luftsauerstoff untersucht wurde."
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "0c1e3ae1-9af9-326b-9408-6e1c53306c84",
                                        "entry_id": "4151d344-09fc-3d17-9337-16af5dfeba48",
                                        "glosses": [
                                            "das Dehnen",
                                            "Druck von innen nach außen (Venen, Bauchdecke und dergleichen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e231a062-40e4-4676-9a79-f7cb53d2678e",
                                                "sense_id": "0c1e3ae1-9af9-326b-9408-6e1c53306c84",
                                                "text": "Bei dieser häufigen Operation schiebt der Arzt mit einem Katheter einen kleinen, elastischen Ballon in die blockierte Ader, bläst ihn dort auf und dehnt das Gefäß, bis das Blut wieder ungehindert hindurchströmen kann."
                                            },
                                            {
                                                "example_id": "1d4696cd-fa0c-430e-bdc7-cf579faccd5e",
                                                "sense_id": "0c1e3ae1-9af9-326b-9408-6e1c53306c84",
                                                "text": "Der Blutdruck hängt von der Stärke und der Frequenz des Herzschlags sowie von der Dehnung feinster Blutgefäße, den Arteriolen, ab: Werden die Arteriolen verengt, dann steigt der Blutdruck."
                                            }
                                        ],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "7bb4546f-0047-3676-8248-caf20c5beacd",
                                        "entry_id": "4151d344-09fc-3d17-9337-16af5dfeba48",
                                        "glosses": [
                                            "das Strecken des Körpers und der Gliedmaßen, um Elastizität zu erreichen"
                                        ],
                                        "tags": [
                                            "Sportmedizin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b1f3d32-3633-4924-ab28-b35b04ee1a1d",
                                                "sense_id": "7bb4546f-0047-3676-8248-caf20c5beacd",
                                                "text": "Wenn sie nur etwas mehr Zeit hätte, würde sie auch noch mit Tai Chi anfangen. Es gibt Übungen zur Kräftigung, Dehnung und Abhärtung."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c3fc48f4-529d-33e2-95b4-a2923613b68f",
                                        "entry_id": "4151d344-09fc-3d17-9337-16af5dfeba48",
                                        "glosses": [
                                            "zeitliche Verlängerung"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "662a0cae-55d3-3d56-bd62-09e71e388318",
                                        "entry_id": "4151d344-09fc-3d17-9337-16af5dfeba48",
                                        "glosses": [
                                            "zeitliche Verlängerung",
                                            "in der Sprache von Lauten, Silben oder Wörtern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8ede543-49cc-4313-b565-53d09570c9ef",
                                                "sense_id": "662a0cae-55d3-3d56-bd62-09e71e388318",
                                                "text": "Die Dehnung der Vokale im Deutschen kann manchmal auch an der Schreibweise erkannt werden."
                                            },
                                            {
                                                "example_id": "e58f11b5-3801-48f3-8286-ab13262270a7",
                                                "sense_id": "662a0cae-55d3-3d56-bd62-09e71e388318",
                                                "text": "Dafür lernt man dann aber, dass das diakritische Dehnungszeichen á nur zu einer relativ kurzen Dehnung des Vokals führen darf."
                                            },
                                            {
                                                "example_id": "6ee36470-fe7c-48f7-80a4-3e85bff89fca",
                                                "sense_id": "662a0cae-55d3-3d56-bd62-09e71e388318",
                                                "text": "Sie singt gar nicht, sondern imitiert Singen, rezitiert mit langen Dehnungen und fast ohne Stimme."
                                            }
                                        ],
                                        "sense_index_json": "\"3a\""
                                    },
                                    {
                                        "sense_id": "d238ba49-3bb3-347a-b771-b8f6540f41c4",
                                        "entry_id": "4151d344-09fc-3d17-9337-16af5dfeba48",
                                        "glosses": [
                                            "zeitliche Verlängerung",
                                            "in der Musik von Tönen oder Tonfolgen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2eb7e073-c5a9-4fa6-af57-34b053b92075",
                                                "sense_id": "d238ba49-3bb3-347a-b771-b8f6540f41c4",
                                                "text": "Der Klang einer schwingenden Saite hängt von ihrer Masse, ihre Länge und von ihrer Dehnung ab."
                                            },
                                            {
                                                "example_id": "0098350a-90f5-47dc-a99e-a7db6fa55106",
                                                "sense_id": "d238ba49-3bb3-347a-b771-b8f6540f41c4",
                                                "text": "Abuehl hatte bei der grandiosen Jeanne Lee Gesang studiert, war beim indischen Sänger Prabha Atre in der Lehre; den Pausen, den Vorhalten, den Dehnungen ist es anzuhören."
                                            }
                                        ],
                                        "sense_index_json": "\"3b\""
                                    }
                                ]
                            }
                        ]
                    }
