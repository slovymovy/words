                                        "entry_id": "9213fee4-bca0-3073-9ca5-36b471becb5c",
                                        "glosses": [
                                            "Variante orthographique de dyshidrose."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66c9298f-9ce3-40fd-a02d-9cd1b27b57b4",
                                                "sense_id": "f20ea09a-11fc-3b2b-8c6e-ecdc35d30392",
                                                "text": "La dysidrose est un eczéma vésiculeux des régions palmoplantaires, typiquement au bord des doigts, et pouvant s’étendre aux zones de la paume et de la plante."
                                            }
                                        ]
                                    }
