                                    },
                                    {
                                        "sense_id": "c1c07e34-206a-31ff-980c-3178c505660d",
                                        "entry_id": "67818ab4-ef35-3683-be89-73c7ee5a3a94",
                                        "glosses": [
                                            "Épice obtenue par broyage du fruit de ce piment doux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6caedf9-1a34-49ae-99de-d0771c325ead",
                                                "sense_id": "c1c07e34-206a-31ff-980c-3178c505660d",
                                                "text": "Les Turcs l’introduisirent dans tout les Balkans à partir des années 1520 : il en restera le paprika hongrois, poudre de piment, épice nationale de ce pays où elle sert notamment à aromatiser le goulasch."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7b95d09-1846-4ba3-a781-1be4a6df8bf2",
                        "source_entry_id": "dca27e4e-a6f2-325b-b760-4df33e0f5679",
                        "source_sense_description": "пряность",
                        "target_lang_word": "paprika",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paprika",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29b42bb7-8418-3519-be38-75032801868e",
                                        "entry_id": "3cafe2a5-823b-34c3-9c62-b4531e3684e5",
                                        "glosses": [
                                            "Powdered spice made from dried and ground fruits of sweet pepper (bell pepper) or chili pepper (cultivars of Capsicum annuum), or mixtures of these (used especially in Hungarian cooking)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "846b207b-5753-4920-8d70-585fd3e17def",
                                                "sense_id": "29b42bb7-8418-3519-be38-75032801868e",
                                                "text": "As a condiment in food, paprika is reputed to be strongly aphrodisiac."
                                            },
                                            {
                                                "example_id": "6e86bafa-5d13-4528-9dfb-effb1602730d",
                                                "sense_id": "29b42bb7-8418-3519-be38-75032801868e",
                                                "text": "California is taking the lead, producing a paprika that is more standardized and more uniformly available than the European growers offer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89a93524-ff91-3e40-889c-4d3ba8f8199e",
                                        "entry_id": "3cafe2a5-823b-34c3-9c62-b4531e3684e5",
                                        "glosses": [
                                            "A variety of the spice."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b4e31b8-b055-4c00-8920-243b1f91debd",
                                                "sense_id": "89a93524-ff91-3e40-889c-4d3ba8f8199e",
                                                "text": "Using the trio of paprikas gives more flavour than you'd get using a single paprika."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e8fc59b-d3bd-3cc1-bf2c-ea03700dc20d",
                                        "entry_id": "3cafe2a5-823b-34c3-9c62-b4531e3684e5",
                                        "glosses": [
                                            "A dried but not yet ground fruit of sweet pepper (bell pepper) or chili pepper sold for use as a spice."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ddddac7-962b-4e9a-8d94-6cf5b82f4d3a",
                                                "sense_id": "3e8fc59b-d3bd-3cc1-bf2c-ea03700dc20d",
                                                "text": "strings of red paprikas hang outside to dry in the autumn"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "211260d3-0fa2-35fa-90af-5e64ff6e21b8",
                                        "entry_id": "3cafe2a5-823b-34c3-9c62-b4531e3684e5",
                                        "glosses": [
                                            "A bright reddish orange colour resembling that of the ground spice."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
