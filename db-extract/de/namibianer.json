                "senses": [
                    {
                        "sense_id": "87226595-2ac2-3d52-938a-87dad6a6c580",
                        "entry_id": "83399b9e-e0b1-3e43-8eaf-a9928d32962f",
                        "glosses": [
                            "Staatsbürger Namibias"
                        ],
                        "tags": [
                            "nicht amtlich"
                        ],
                        "examples": [
                            {
                                "example_id": "d4738e2c-8b60-4a02-a0ee-ddc83bbf5cb7",
                                "sense_id": "87226595-2ac2-3d52-938a-87dad6a6c580",
                                "text": "„Viele Hürden stehen auf dem Weg, den die Namibianer – Weiße und Schwarze – zwischen dem 1. April 1989 und dem 1. April 1990 zurücklegen müssen.“"
                            },
                            {
                                "example_id": "2775cf32-6e5c-4822-8130-bb8a6c5452b5",
                                "sense_id": "87226595-2ac2-3d52-938a-87dad6a6c580",
                                "text": "„Dass die Namibianer nicht ‚Goeie Reis‘ sagen, ist nur ein Indiz dafür, dass das namibische Afrikaans durchaus seine eigene Geschichte hat.“"
                            },
                            {
                                "example_id": "1644ae3b-24e7-4756-a34f-e8eb07f812b3",
                                "sense_id": "87226595-2ac2-3d52-938a-87dad6a6c580",
                                "text": "„Da die Insel nicht unbedingt als Hort rumänischer und namibianischer Einwanderer gilt, hat der Bürgermeister von Launceston angeordnet, dass alle Bewohner mit geraden Hausnummern für den Tag des Spiels zu Rumänen werden und die mit ungeraden Namibianer.“"
                            },
                            {
                                "example_id": "211263e0-8afc-4583-951d-333e9a5aaa04",
                                "sense_id": "87226595-2ac2-3d52-938a-87dad6a6c580",
                                "text": "„Nach Regierungsschätzungen ist jeder fünfte Namibianer mit dem HI-Virus infiziert.“"
                            },
                            {
                                "example_id": "c764062d-439a-401f-9371-9e22c567572a",
                                "sense_id": "87226595-2ac2-3d52-938a-87dad6a6c580",
                                "text": "„Ergänzt wird das Spektrum durch Schriftstellerporträts etwa des Senegalesen Ousmane Sembène, des Nigerianers Chinua Achebe und des Namibianers Giselher W. Hoffmann.“"
                            },
                            {
                                "example_id": "b9395881-f32d-4e7b-9c4f-290bf69ceca4",
                                "sense_id": "87226595-2ac2-3d52-938a-87dad6a6c580",
                                "text": "„Der 35-jährige Namibianer befindet sich im dritten Frühling, gewann die 200 m der Common-Wealth-Games in 20,06 Sekunden und peilt in Linz den Meeting-Rekord an.“"
                            },
                            {
                                "example_id": "0971f8e5-22e0-464f-9845-9612a465ab65",
                                "sense_id": "87226595-2ac2-3d52-938a-87dad6a6c580",
                                "text": "„Der 21-jährige Namibianer Stefan Ludik ist der einzige Weiße.“"
                            },
                            {
                                "example_id": "15dd796e-0f25-4b1e-80e9-c74a2933cafd",
                                "sense_id": "87226595-2ac2-3d52-938a-87dad6a6c580",
                                "text": "„Bleibt zu hoffen, dass Wohnkomfort und Preisgestaltung auch andere Namibianer von den Vorzügen der Bautechnik made in Austria überzeugt.“"
                            },
                            {
                                "example_id": "be287a21-4a51-4232-9269-e6ac8201eeb9",
                                "sense_id": "87226595-2ac2-3d52-938a-87dad6a6c580",
                                "text": "„Im Mittel geht es allen Namibianern recht gut, das Problem liegt aber darin, dass viele sehr arm sind und einige sehr reich und dazwischen relativ Wenige in der Mittelklasse sind.“"
                            },
                            {
                                "example_id": "606f4139-ca67-4d45-aa99-ebe41eb09734",
                                "sense_id": "87226595-2ac2-3d52-938a-87dad6a6c580",
                                "text": "„Zwar mussten die fleißigen Teilnehmer rasch noch ihre Stände abdecken, aber ein Namibianer lässt sich von ein bisschen Regen nicht unterkriegen.“"
                            },
                            {
                                "example_id": "5064dfbf-6007-48fd-80ef-041c5f2a482c",
                                "sense_id": "87226595-2ac2-3d52-938a-87dad6a6c580",
                                "text": "„Zu Beginn lag der eigentliche Schwerpunkt darin, eine Institution zu gründen, die das hiesige Kulturerbe in Wissenschaft und Kunst in Namibia von Namibianern erforscht und bewahrt.“"
                            },
                            {
                                "example_id": "cbe3a7d2-d65b-48f1-830c-780723e83fab",
                                "sense_id": "87226595-2ac2-3d52-938a-87dad6a6c580",
                                "text": "„Die Aussichten waren atemberaubend und von uns Namibianern, die die Natur so lieben, natürlich besonders geschätzt.“"
                            },
                            {
                                "example_id": "8d51deb8-3ea9-45be-8d5d-d6e33b441c01",
                                "sense_id": "87226595-2ac2-3d52-938a-87dad6a6c580",
                                "text": "„Nicht ohne Grund sind die Namibianer stolz auf ihr Land und teilen dies und ihre Lebenslust gerne mit Gästen.“"
                            },
                            {
                                "example_id": "225d156b-8f78-453c-839a-19cdf4a552e7",
                                "sense_id": "87226595-2ac2-3d52-938a-87dad6a6c580",
                                "text": "„Denn egal welche Kultur oder Sprache, wir alle sind Namibianer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
