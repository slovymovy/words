                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4576958-9ad8-40a6-b2ee-4a9fbb5f7fec",
                                "sense_id": "f0165d45-c393-3832-ba1a-085e80f90a64",
                                "text": "облека́ть в фо́рму чего́-либо",
                                "translation": "to give the shape/form of something",
                                "english": "to give the shape/form of something"
                            },
                            {
                                "example_id": "25e2d5d6-4d99-4964-864d-6b67da76f43c",
                                "sense_id": "f0165d45-c393-3832-ba1a-085e80f90a64",
                                "text": "облека́ть свою́ мысль в таку́ю фо́рму, что",
                                "translation": "to present one's ideas in such a form that; shape one's thoughts in such a way that",
                                "english": "to present one's ideas in such a form that; shape one's thoughts in such a way that"
                            },
