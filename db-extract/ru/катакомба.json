                    {
                        "translation_id": "0c12c856-06fa-4421-86bc-627aac5a3b49",
                        "source_entry_id": "4d58c350-ce86-3796-9f30-a73f19de3e34",
                        "source_sense_id": "b676d519-2f39-3f0c-b03d-9b277392e477",
                        "target_lang_word": "Katakombe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Katakombe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a0e33ebe-2561-36d8-bd4a-d7ab5c5c1824",
                                        "entry_id": "689968e2-0220-3244-af3a-9e6147462030",
                                        "glosses": [
                                            "unterirdische Beisetzungsstätte"
                                        ],
                                        "tags": [
                                            "(meist Plural) in frühchristlicher Zeit"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b97b9cd-3aa6-49e8-9029-90ae267da481",
                                                "sense_id": "a0e33ebe-2561-36d8-bd4a-d7ab5c5c1824",
                                                "text": "Katakomben wurden auch als Zufluchtsstätte genutzt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "94ae553f-591c-34f3-8361-d389bebf3b51",
                                        "entry_id": "689968e2-0220-3244-af3a-9e6147462030",
                                        "glosses": [
                                            "unterirdische, unübersichtliche Räumlichkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd274a1d-a647-407f-8fa2-2b994a1e19f8",
                                                "sense_id": "94ae553f-591c-34f3-8361-d389bebf3b51",
                                                "text": "„Als sie auf der nachtstillen Straße stehen, ist ihnen zumute, als tauchten sie aus dem schaurigen Dunkel einer Katakombe wieder an das Tageslicht zurück.“"
                                            },
                                            {
                                                "example_id": "aaf206f5-b0f5-4364-89f1-b413690a1217",
                                                "sense_id": "94ae553f-591c-34f3-8361-d389bebf3b51",
                                                "text": "„Dann fand ich in den Katakomben mein Auto nicht wieder.“"
                                            },
                                            {
                                                "example_id": "6ee0a45f-36f5-4298-8817-b1e051bd01e9",
                                                "sense_id": "94ae553f-591c-34f3-8361-d389bebf3b51",
                                                "text": "„Aber allzu tief trauten sie sich doch nicht in die Katakomben vorzudringen.“"
                                            },
                                            {
                                                "example_id": "e18f53e0-3519-4d73-9b8b-abfa09e79ad4",
                                                "sense_id": "94ae553f-591c-34f3-8361-d389bebf3b51",
                                                "text": "„Von den unterirdischen Räumen aus, die leer standen, gab es eine Verbindung zu den Schächten der Katakomben, die sich unter den Häusern der Stadtanlage überall hinzogen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e056898-1f91-4337-8e45-cd8d040f15fa",
                        "source_entry_id": "4d58c350-ce86-3796-9f30-a73f19de3e34",
                        "source_sense_id": "b676d519-2f39-3f0c-b03d-9b277392e477",
                        "target_lang_word": "catacombe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "catacombe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a5cd8d19-6a39-33f4-a405-f249f486c0d1",
                                        "entry_id": "808055a7-b1f3-36fd-ae30-7c61a6dd2a8f",
                                        "glosses": [
                                            "Cavité souterraine ou excavation d’anciennes carrières qui a servi quelquefois de sépulture ou d’ossuaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af238d56-be6e-4217-9461-4528901b0581",
                                                "sense_id": "a5cd8d19-6a39-33f4-a405-f249f486c0d1",
                                                "text": "On sait qu’Issoire est le nom d’un fameux brigand […]. Il fut un peu pendu, à ce que je crois, et enterré à l’endroit qui porte aujourd’hui son nom, à quelque distance de l’entrée des catacombes."
                                            },
                                            {
                                                "example_id": "e5d288b7-64ca-47ec-8630-27fb32225cd3",
                                                "sense_id": "a5cd8d19-6a39-33f4-a405-f249f486c0d1",
                                                "text": "Personne ne croit plus que les chrétiens se réfugiaient dans des carrières souter­raines pour échapper aux perquisitions de la police ; les catacombes furent creusées, à très grands frais, par des communautés disposant d'importantes ressources, […]."
                                            },
                                            {
                                                "example_id": "7ee7d0d8-4a8e-4cc4-9407-c62ebfbf4e92",
                                                "sense_id": "a5cd8d19-6a39-33f4-a405-f249f486c0d1",
                                                "text": "La vermine des catacombes s'épanouissait lentement au soleil ; les couvents et monastères champignonnaient, rongeant le sol gaulois comme une lèpre hideuse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
