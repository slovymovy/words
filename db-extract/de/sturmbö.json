                "senses": [
                    {
                        "sense_id": "2e216bdf-5687-3061-8fef-38b2518e6e0e",
                        "entry_id": "26fdad15-5c64-3cc5-a434-d48cfbf52b3e",
                        "glosses": [
                            "heftiger Windstoß mit Sturmstärke, in der Regel ab acht Beaufort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "227033c5-c8d8-42da-837c-8b4f6099e49d",
                                "sense_id": "2e216bdf-5687-3061-8fef-38b2518e6e0e",
                                "text": "Der Deutsche Wetterdienst warnt morgen vor Unwettern mit Hagel und Sturmböen bis zu Windstärke 11."
                            },
                            {
                                "example_id": "126bf9e2-7cc8-4db8-a6a1-a2603cbdd3a2",
                                "sense_id": "2e216bdf-5687-3061-8fef-38b2518e6e0e",
                                "text": "„Während der Regenzeit zerren Sturmböen an Reitern und Zelten.“"
                            },
                            {
                                "example_id": "23cc9f69-b58d-4f12-898d-a7cca6a6d613",
                                "sense_id": "2e216bdf-5687-3061-8fef-38b2518e6e0e",
                                "text": "„In diesem Zimmer finden nun auch wir Aufnahme, gerade noch rechtzeitig vor einem heftigen Gewitter mit Sturmböen, Hagel und Wolkenbruch.“"
                            },
                            {
                                "example_id": "97a801e2-0490-4b04-8119-31f41264f724",
                                "sense_id": "2e216bdf-5687-3061-8fef-38b2518e6e0e",
                                "text": "„In derartigen Sturmböen hielt sie ihre Tränen zurück, bis alles wieder ruhig war und sie erneut zu weinen anfing.“"
                            },
                            {
                                "example_id": "7888ab42-7ece-4b36-b235-f50dc9a2e10e",
                                "sense_id": "2e216bdf-5687-3061-8fef-38b2518e6e0e",
                                "text": "„Er ging geradewegs gegen die Sturmböen zwischen den Scheunen und Ställen, der Sturm zerrte an seinem Zeug, seine Beine schienen dünner denn je, die Knie noch mehr gekrümmt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4fdac4a1-0640-44a5-99cc-6bc6f10e7afc",
                        "source_entry_id": "26fdad15-5c64-3cc5-a434-d48cfbf52b3e",
                        "source_sense_id": "2e216bdf-5687-3061-8fef-38b2518e6e0e",
                        "source_sense_description": "heftiger Windstoß mit Sturmstärke, in der Regel ab acht Beaufort",
                        "target_lang_word": "шквал",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "шквал",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6e456b93-355e-3a7c-9e10-ffec4e2ff329",
                                        "entry_id": "fd6092b9-47b7-35e7-827c-8ecc8debe234",
                                        "glosses": [
                                            "сильный и резкий порыв ветра, часто сопровождающийся грозой, ливнем"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc6f7810-46e3-4b94-9a11-ba90432592b8",
                                                "sense_id": "6e456b93-355e-3a7c-9e10-ffec4e2ff329",
                                                "text": "Такой-то шквал налетел на фрегат «Надежду» и зарыл нос его в бурун, так что волна перекатилась по палубе до самой кормы."
                                            },
                                            {
                                                "example_id": "bdd92942-5021-46c1-94b2-ff1fb1e08042",
                                                "sense_id": "6e456b93-355e-3a7c-9e10-ffec4e2ff329",
                                                "text": "В 7 ч. сильным шквалом сорвало с причала две барки, стоявшие против городских богаделен."
                                            },
                                            {
                                                "example_id": "bbc595ca-51c8-43e2-b132-d4acbac913bd",
                                                "sense_id": "6e456b93-355e-3a7c-9e10-ffec4e2ff329",
                                                "text": "На обратном пути внезапно налетел шквал, ветер развёл сильную волну."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44a0470e-456e-345f-aaf8-cc834f377ada",
                                        "entry_id": "fd6092b9-47b7-35e7-827c-8ecc8debe234",
                                        "glosses": [
                                            "перен. бурное, обильное проявление, резкий наплыв чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df78897c-3cfd-4139-9581-bda1a1237a3c",
                                                "sense_id": "44a0470e-456e-345f-aaf8-cc834f377ada",
                                                "text": "В таких случаях надо давать шквал пулемётного и автоматного огня, смело атаковывать и продвигаться вперед на плечах противника."
                                            },
                                            {
                                                "example_id": "caa05fa7-8858-4f3f-b81d-252b6b9c123d",
                                                "sense_id": "44a0470e-456e-345f-aaf8-cc834f377ada",
                                                "text": "Сопровождаемый шквалом аплодисментов, он спустился с трибуны."
                                            },
                                            {
                                                "example_id": "bac635ec-474f-45eb-a2fe-81ea5222aadb",
                                                "sense_id": "44a0470e-456e-345f-aaf8-cc834f377ada",
                                                "text": "На меня обрушился шквал критики со стороны различных олигархов и подвластных им СМИ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "054b8952-852c-49aa-aad3-9775d51fbb60",
                        "source_entry_id": "26fdad15-5c64-3cc5-a434-d48cfbf52b3e",
                        "source_sense_id": "2e216bdf-5687-3061-8fef-38b2518e6e0e",
                        "source_sense_description": "heftiger Windstoß mit Sturmstärke, in der Regel ab acht Beaufort",
                        "target_lang_word": "шторм",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "шторм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "14d18ceb-d41d-372f-a024-c9d4ebcb0348",
                                        "entry_id": "2a2aec2e-045c-36e8-829a-f49c386ab6d1",
                                        "glosses": [
                                            "сильный ветер в океане или буря на суше"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08d74ce7-5da1-4efe-a2f5-86b58c34f796",
                                                "sense_id": "14d18ceb-d41d-372f-a024-c9d4ebcb0348",
                                                "text": "Яхта попала в сильнейший шторм и затонула, а четверо моряков оказались в спасательной шлюпке без еды и пресной воды."
                                            },
                                            {
                                                "example_id": "a2a1709b-b2de-427f-a27f-3cd13e80dd8f",
                                                "sense_id": "14d18ceb-d41d-372f-a024-c9d4ebcb0348",
                                                "text": "Добрались они до Груманта, там подхватили их штормы, вынесли в северную Атлантику и выбросили на берега Нормандии."
                                            },
                                            {
                                                "example_id": "7750bd43-67f3-426b-b3cf-d96ad01f0226",
                                                "sense_id": "14d18ceb-d41d-372f-a024-c9d4ebcb0348",
                                                "text": "Однажды я нашёл бутылку, выброшенную штормом, но записки в ней почему-то не оказалось, и я сдал её в магазин."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
