                    {
                        "sense_id": "45b84060-1c51-3040-aae2-20d72237d7a7",
                        "entry_id": "524b6222-94bf-305b-bb87-0ecf78efab61",
                        "glosses": [
                            "Mesure thermodynamique de la variation de la quantité de chaleur contenue dans un système physique ou chimique."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "de075355-308d-44af-bffb-d2d7d7aed88b",
                                "sense_id": "45b84060-1c51-3040-aae2-20d72237d7a7",
                                "text": "La nouvelle fonction thermodynamique (…), qui reçut de Kamerlingh Onnes le nom d'« enthalpie », joue, pour les transformations à pression constante, le rôle que joue l'énergie interne pour les transformations à volume constant."
                            },
                            {
                                "example_id": "fa426c00-b4ce-4e3b-a59d-aa83828eaf82",
                                "sense_id": "45b84060-1c51-3040-aae2-20d72237d7a7",
                                "text": "Cette technique permettra de déterminer la température de fusion T_f et de cristallisation T_c, l’enthalpie de fusion DH_f et de cristallisation DH_c et le taux de cristallinité χ_c."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
