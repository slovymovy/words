                        "entry_id": "b417fea0-387d-38f7-b9e4-6153de0e1012",
                        "glosses": [
                            "Used up, expended; of which nothing is left."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "eae5348f-8029-4b0f-a8f9-e5fcf5379646",
                                "sense_id": "9041a0d8-7828-3622-bb3f-b10ac2486c40",
                                "text": "The depleted aerosol can spray no more since there was no propellant left."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e10cf75-ce10-4943-b477-1a79d134df1f",
                        "source_entry_id": "b417fea0-387d-38f7-b9e4-6153de0e1012",
                        "source_sense_id": "9041a0d8-7828-3622-bb3f-b10ac2486c40",
                        "source_sense_description": "used up, expended",
                        "target_lang_word": "épuisé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "épuisé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ad40c473-0d60-3eca-8de5-5496598b5ee3",
                                        "entry_id": "4cb9ba40-a5fa-3bee-9f64-687ac9ecff33",
                                        "glosses": [
                                            "(En parlant d’un gisement, d’une source) Qui ne contient plus de produit exploitable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec4dd9b6-9117-4b7a-b2d0-271e5d8d5de0",
                                                "sense_id": "ad40c473-0d60-3eca-8de5-5496598b5ee3",
                                                "text": "Si les engrais verts donnent de fort bons résultats dans les sols infertiles et épuisés, à plus forte raison sont-ils avantageux dans les sols fertiles et riches."
                                            },
                                            {
                                                "example_id": "aa0aefcf-b480-41c1-8661-6e40755ed31b",
                                                "sense_id": "ad40c473-0d60-3eca-8de5-5496598b5ee3",
                                                "text": "Ce gisement d’uranium était épuisé, la mine a fermé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2061e1d-68ce-3008-b47f-ac8afe898d44",
                                        "entry_id": "4cb9ba40-a5fa-3bee-9f64-687ac9ecff33",
                                        "glosses": [
                                            "Dont il ne reste plus aucun exemplaire à vendre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83d8c5eb-7596-419b-a913-f7b1c9e7d34b",
                                                "sense_id": "d2061e1d-68ce-3008-b47f-ac8afe898d44",
                                                "text": "Ce livre est épuisé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e381eb19-b93e-3856-983a-eaad0bda465c",
                                        "entry_id": "4cb9ba40-a5fa-3bee-9f64-687ac9ecff33",
                                        "glosses": [
                                            "Qui ne peut plus rien produire de nouveau, en parlant d'un esprit, d'une imagination usés."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7bb35eed-9a3b-3178-b4bc-5dfa1fe5891c",
                                        "entry_id": "4cb9ba40-a5fa-3bee-9f64-687ac9ecff33",
                                        "glosses": [
                                            "(En parlant d’une personne, ou de son aspect) Très fatigué."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20c32d9a-fa7e-4565-98b6-aab7fee3d543",
                                                "sense_id": "7bb35eed-9a3b-3178-b4bc-5dfa1fe5891c",
                                                "text": "Avoir vu des ouvriers épuisés s’asperger d'eau pendant leur pause dej sous un cagnard, que pas grand monde n’ose affronter en plein jour, ne nous fera pas dire le contraire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "épuisé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8f174ac1-f8d2-3624-8db4-a9f49ddf5f25",
                                        "entry_id": "c5c044aa-793b-3454-a322-e696040b0d55",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe épuiser."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b3c6907-0f6c-4064-adab-b3a6b931100f",
                                                "sense_id": "8f174ac1-f8d2-3624-8db4-a9f49ddf5f25",
                                                "text": "Les sous-disciples du maître-géographe, ayant épuisé le genre et la veine, se sont tournés vers d’autres horizons, au risque de se perdre, ou d’éclater en chapelles et en hyper-spécialités ; mais ils ont eu raison."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
