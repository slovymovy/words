                ],
                "senses": [
                    {
                        "sense_id": "117ac17d-4b29-3347-b3a1-c6f738adf7b8",
                        "entry_id": "c4f49867-ab30-30a4-84e6-af668091e1c6",
                        "glosses": [
                            "Merkmal (Symptom), das ein erkrankter Patient (Mensch/Tier) zeigt und das Rückschlüsse auf die Erkrankung geben kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99fe5f53-283b-4b50-92a4-f135787df24b",
                                "sense_id": "117ac17d-4b29-3347-b3a1-c6f738adf7b8",
                                "text": "Detaillierte Informationen zum Schutz vor Ansteckung, zu den Krankheitssymptomen und zur Vorgangsweise bei Verdacht auf Ansteckung finden Sie auf unserer Homepage."
                            },
                            {
                                "example_id": "67b2ae59-c37b-4862-8088-ee3a988ea1d1",
                                "sense_id": "117ac17d-4b29-3347-b3a1-c6f738adf7b8",
                                "text": "„Häufige Krankheitssymptome sind Veränderungen im Fress-/Trinkverhalten, Apathie, Bewegungslosigkeit, Abmagerung, Haut-und Fellveränderungen, Durchfall, Verletzungen an Ohren und Schwanz.“"
                            },
                            {
                                "example_id": "6d419fa1-19e3-4e78-9dca-7f25e70d205d",
                                "sense_id": "117ac17d-4b29-3347-b3a1-c6f738adf7b8",
                                "text": "„Pinel erkannte, dass Krankheitssymptome auch sekundär entstehen können, nämlich als Reaktion auf inhumane Verhältnisse im Irrenhaus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
