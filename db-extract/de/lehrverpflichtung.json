                ],
                "senses": [
                    {
                        "sense_id": "d1450611-5fe1-3334-83b0-1cb04c5a4f37",
                        "entry_id": "caf693cf-ff10-3be1-aedf-523dda80019b",
                        "glosses": [
                            "verpflichtende Anzahl an Stunden/Lehrveranstaltungen, die jemand geben beziehungsweise unterrichten muss"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "95cc86c4-4ae0-442b-9013-248af885e43d",
                                "sense_id": "d1450611-5fe1-3334-83b0-1cb04c5a4f37",
                                "text": "„Nach acht Jahren entband man ihn von seinen Lehrverpflichtungen und er konzentrierte sich ganz auf das Forschen und Schreiben.“"
                            },
                            {
                                "example_id": "8935d103-6fac-44a4-a4f2-56c6480465da",
                                "sense_id": "d1450611-5fe1-3334-83b0-1cb04c5a4f37",
                                "text": "„Die Lehrergewerkschaft versteht sich als Schutzpatronin des schulischen Status quo, und dessen Allerheiligstes ist die Lehrverpflichtung.“"
                            },
                            {
                                "example_id": "c8a6bd1b-a51b-44f7-9c4f-a3d1bbc120be",
                                "sense_id": "d1450611-5fe1-3334-83b0-1cb04c5a4f37",
                                "text": "„Unterrichtet ein Landeslehrer an mehreren Schulen oder in mehreren Unterrichtsgegenständen, für die das Ausmaß der Lehrverpflichtung verschieden ist, so ist das zur Erfüllung der Lehrverpflichtung erforderliche Ausmaß seiner Beschäftigung in folgender Weise zu ermitteln: Zu der Zahl der Wochenstunden, für welche die zeitlich geringere Lehrverpflichtung gilt, sind die im Verhältnis der geringeren zur höheren Lehrverpflichtung umgerechneten Wochenstunden, für welche die zeitlich höhere Lehrverpflichtung gilt, zuzuzählen, bis das Ausmaß der geringeren Lehrverpflichtung erreicht ist.“"
                            },
                            {
                                "example_id": "b862336d-c582-4d8c-8691-74b25234218f",
                                "sense_id": "d1450611-5fe1-3334-83b0-1cb04c5a4f37",
                                "text": "„Die Unterrichtsstunden in den einzelnen Unterrichtsgegenständen sind auf die Lehrverpflichtung mit folgenden Werteinheiten je Wochenstunde anzurechnen: […]“"
                            },
                            {
                                "example_id": "1ff0e8da-9ab1-405d-8476-f5e0eb7989ad",
                                "sense_id": "d1450611-5fe1-3334-83b0-1cb04c5a4f37",
                                "text": "„In Schulen mit Fachlehrersystem hat der Schulleiter für jedes Unterrichtsjahr (an lehrgangsmäßigen Berufsschulen für jeden Lehrgang) nach Beratung der allgemeinen Gesichtspunkte in der Schulkonferenz die lehrplanmäßig vorgesehenen Wochenstunden der Unterrichtsgegenstände in den einzelnen Klassen den einzelnen Lehrern der Schule unter Beachtung pädagogischer und didaktischer Grundsätze, unter Bedachtnahme auf die Vorschriften über die Lehrverpflichtung oder den Lehrauftrag und über die Lehrbefähigung sowie unter Berücksichtigung hiemit vereinbarer Wünsche der Lehrer zuzuweisen (Lehrfächerverteilung).“"
                            },
                            {
                                "example_id": "cf3eef22-2633-44e0-9634-01fa6f099517",
                                "sense_id": "d1450611-5fe1-3334-83b0-1cb04c5a4f37",
                                "text": "„Der Vertragslehrer ist nach Möglichkeit im vollen Ausmaß der für ihn festgelegten Lehrverpflichtung unbeschadet der Bestimmungen nach Abs.3 und 4 zur Unterrichtserteilung heranzuziehen.“"
                            },
                            {
                                "example_id": "56741fbf-f404-4a92-a3fb-a48ec7d556e2",
                                "sense_id": "d1450611-5fe1-3334-83b0-1cb04c5a4f37",
                                "text": "„Übersteigt die Unterrichtserteilung eines Unterrichtspraktikanten wegen der Supplierung für einen länger als drei unmittelbar aufeinanderfolgende Kalendertage verhinderten Lehrer das halbe Ausmaß der Lehrverpflichtung eines Bundeslehrers gemäß dem Bundeslehrer-Lehrverpflichtungsgesetz, BGBl. Nr. 244/1965, so gebührt ihm für jede Supplierstunde 2,3 vH des Ausbildungsbeitrages.“"
                            },
                            {
                                "example_id": "bac4bc19-8379-4c18-8859-c69745542a86",
                                "sense_id": "d1450611-5fe1-3334-83b0-1cb04c5a4f37",
                                "text": "„Bis dahin lockt das Saarland mit direkter Verbeamtung und einer von 28,5 auf 28 Wochenstunden reduzierten Lehrverpflichtung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8b93e4fe-3693-3b7b-abe0-479b437d3b77",
                        "entry_id": "caf693cf-ff10-3be1-aedf-523dda80019b",
                        "glosses": [
                            "Zusage (Verpflichtung) von kirchlich gebundenem Personal, sich bei der Unterweisung an bestimmte Richtlinien zu halten"
                        ],
                        "tags": [
                            "Theologie",
                            "Lehre"
                        ],
                        "examples": [
                            {
                                "example_id": "1c4ca4dd-5444-469a-9719-89f28cb8d6e1",
                                "sense_id": "8b93e4fe-3693-3b7b-abe0-479b437d3b77",
                                "text": "„Der Pfarrer im Ruhestand untersteht weiter der Lehrverpflichtung und der Amtspflicht und damit der Lehraufsicht und der Amtszucht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
