                                        "entry_id": "57bcc690-ea26-34df-b53f-fba99914f5a6",
                                        "glosses": [
                                            "One who attempts syncretism, the fusion of different systems or beliefs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "207f023a-c57d-4ce6-934a-74013b05f85d",
                                                "sense_id": "aafd0c1b-fccd-3762-9f01-1385dd8d1505",
                                                "text": "Both are syncretist collaborations between a flexible jazz musician and a famously uncompromising genius who invented his or her own style  two musicians of putatively different worlds."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1ed1c51-eb67-4ce6-805b-6d4e349e82d4",
                        "source_entry_id": "19e4eb4f-7a77-34c3-8ecd-e419d12728af",
                        "source_sense_id": "ef9a4737-6b91-3da3-b7ea-935f521a4fb8",
