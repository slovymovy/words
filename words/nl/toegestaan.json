                                "ru": "Мои родители никогда не <w>разрешали</w> мне приходить домой поздно.",
                                "pl": "Moi rodzice nigdy nie <w>pozwalali</w> mi wracać późno do domu.",
                                "de": "Meine Eltern haben es mir nie <w>erlaubt</w>, spät nach Hause zu kommen.",
                                "fr": "Mes parents ne m'ont jamais <w>permis</w> de rentrer tard.",
                                "it": "I miei genitori non mi hanno mai <w>permesso</w> di tornare a casa tardi.",
                                "cs": "Moji rodiče mi nikdy <w>nedovolili</w> chodit domů pozdě.",
                                "tr": "Ailem eve geç gelmeme hiç <w>izin vermedi</w>.",
                                "es": "Mis padres nunca me han <w>permitido</w> llegar tarde a casa.",
                                "zh": "我父母从来没<w>允许</w>过我晚归。"
                            }
