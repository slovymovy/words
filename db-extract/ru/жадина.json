                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "penny-pincher",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f8b6e39-d86a-3927-a466-fbd96fc9359d",
                                        "entry_id": "cc693a6b-5d5f-3bba-8467-8669f118b009",
                                        "glosses": [
                                            "Alternative spelling of penny pincher."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59a23d18-8837-4833-99bc-b47881cb4ff1",
                                                "sense_id": "7f8b6e39-d86a-3927-a466-fbd96fc9359d",
                                                "text": "Hopefully, the penny-pinchers at the DfT/Treasury will finally agree to this. otherwise many of the proposed benefits will be lost."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d969d724-4650-43a5-ae79-682af9863750",
                        "source_entry_id": "8183e39e-0eac-3929-8d36-6e3ec798b9d1",
                        "source_sense_id": "e13589f6-3c2f-30b8-9bbb-a863d7875d40",
                        "target_lang_word": "scrooge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scrooge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d159afbc-2f2e-3c41-af6a-701436de023f",
                                        "entry_id": "d374e040-2de6-3684-884f-97b06e09dce7",
                                        "glosses": [
                                            "A miserly person; a person with an excessive dislike of spending money or other resources."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a197ea4-ba44-33ab-ade4-54ed3b3b1ec6",
                                        "entry_id": "d374e040-2de6-3684-884f-97b06e09dce7",
                                        "glosses": [
                                            "A person who is grumpy about the Christmas holidays."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "scrooge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff58ffbb-ee06-3741-aa75-63a8b6a63345",
                                        "entry_id": "fa2491b8-0f5c-3b0c-98b2-fdc47cf54954",
                                        "glosses": [
                                            "To behave in a greedy or miserly way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bf0513e-f302-408d-a1ba-d793b84ebeb2",
                                                "sense_id": "ff58ffbb-ee06-3741-aa75-63a8b6a63345",
                                                "text": "Mr. Chairman, $6 million is 15 times more than what the President earns and 30 times more than what a Cabinet Secretary earns. The Christmas Eve announcement of these bonuses was greeted by one commentator by saying the taxpayers got scrooged."
                                            },
                                            {
                                                "example_id": "14cbf64c-3689-4642-9799-8bbe915484a8",
                                                "sense_id": "ff58ffbb-ee06-3741-aa75-63a8b6a63345",
                                                "text": "He went back to live in Clayton with dad and tearfully explained to him about Aunt Eliza and her mean, scrooging ways."
                                            },
                                            {
                                                "example_id": "7182cde4-01c7-472d-8c3e-59b1042e80c7",
                                                "sense_id": "ff58ffbb-ee06-3741-aa75-63a8b6a63345",
                                                "text": "[…]corporations scrooging their way out of paying taxes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scrooge",
