                    "sense_id": "4df9997e-19a5-31ac-9817-f7c136e037ba",
                    "sense_definition": "het maken van lage, ongearticuleerde geluiden als uiting van pijn, verdriet of vermoeidheid",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid-van-pijn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gewonde man begon zachtjes te <w>kreunen</w> toen de dokter zijn been aanraakte.",
                            "target_lang_translations": {
                                "en": "The injured man began to <w>groan</w> softly when the doctor touched his leg."
                            }
                        },
                        {
                            "text": "Ik hoorde hem <w>kreunen</w> van pijn na die zware val.",
                            "target_lang_translations": {
                                "en": "I heard him <w>moaning</w> with pain after that heavy fall."
                            }
                        }
                    ],
                    "synonyms": [
                        "kermen",
                        "steunen"
                    ],
                    "common_phrases": [
                        "kreunen van pijn",
                        "zachtjes kreunen"
                    ],
                    "target_lang_definitions": {
                        "en": "making low, inarticulate sounds as an expression of pain, grief, or fatigue"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "groan",
                                "target_lang_sense_clarification": "a low sound of pain or grief"
                            },
                            {
                                "target_lang_word": "moan",
                                "target_lang_sense_clarification": "a low, mournful cry of pain or sorrow"
                            }
                        ]
