                ],
                "senses": [
                    {
                        "sense_id": "703231b5-ddbf-3098-82e0-d29a16a5e9b3",
                        "entry_id": "87c0790b-6b3a-3e27-b2bb-97171388aa4e",
                        "glosses": [
                            "такое положение двух или нескольких тел, предметов, при котором они соприкасаются своими гранями, частями"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e498e3ae-c888-31d0-81fa-36e8209b927f",
                        "entry_id": "87c0790b-6b3a-3e27-b2bb-97171388aa4e",
                        "glosses": [
                            "непосредственная близость, положение, при котором возможно непосредственное столкновение между кем-либо, чем-либо"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "39c23945-23df-3562-a540-85b67daf28f5",
                        "entry_id": "87c0790b-6b3a-3e27-b2bb-97171388aa4e",
                        "glosses": [
                            "перен. непосредственное общение, знакомство"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a760061b-a5b9-4f8b-9bf6-2293053e5ff8",
                                "sense_id": "39c23945-23df-3562-a540-85b67daf28f5",
                                "text": "В рисунке ярче всего осуществляется и своевластность импровизации, и первое, непосредственное соприкосновение с натурой."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5855175c-c855-42dd-8c89-2b293ea32484",
                        "source_entry_id": "87c0790b-6b3a-3e27-b2bb-97171388aa4e",
                        "target_lang_word": "contact",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contact",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7eacd507-f4a7-389a-a951-c672639a052b",
                                        "entry_id": "1b3dcad9-3486-3074-b9ed-c87d979aa65e",
                                        "glosses": [
                                            "Action de toucher physiquement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39522440-9acf-4acd-8b6c-d47a0b5d7504",
                                                "sense_id": "7eacd507-f4a7-389a-a951-c672639a052b",
                                                "text": "Il y a des maladies qui se communiquent par le contact."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "432cbd00-dbd2-394f-bd28-0b912233bbd6",
                                        "entry_id": "1b3dcad9-3486-3074-b9ed-c87d979aa65e",
                                        "glosses": [
                                            "État de deux ou plusieurs corps qui se touchent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc052160-f0d3-42bd-b56e-c5fcbba31416",
                                                "sense_id": "432cbd00-dbd2-394f-bd28-0b912233bbd6",
                                                "text": "L'avantage de fragmenter le bois raméal réside dans l'augmentation des surfaces de contact pour les décomposeurs et l'établissement de conditions abiotiques propices à l'évolution des populations microbiennes, ce qui est de nature à favoriser l'incorporation des composés azotés au sol."
                                            },
                                            {
                                                "example_id": "435697c6-3912-4a92-b4d6-90bbfcb925a9",
                                                "sense_id": "432cbd00-dbd2-394f-bd28-0b912233bbd6",
                                                "text": "Ces deux corps sont en contact."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6097045-fc8c-39eb-a512-d943c35a5f75",
                                        "entry_id": "1b3dcad9-3486-3074-b9ed-c87d979aa65e",
                                        "glosses": [
                                            "Liaison ; relation ; communication."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7241bb4c-ff09-43c6-ac86-9d0ffd1806d4",
                                                "sense_id": "c6097045-fc8c-39eb-a512-d943c35a5f75",
                                                "text": "L’opinion publique italienne ne fut pas informée de ces contacts, mais la presse transalpine publia dans les jours précédant l’entrée en guerre de nombreux articles très francophobes."
                                            },
                                            {
                                                "example_id": "3ebb4bd8-0203-49db-bd4d-ca1bab453c67",
                                                "sense_id": "c6097045-fc8c-39eb-a512-d943c35a5f75",
                                                "text": "Bientôt le candidat des forces vives devra se décider à battre les estrades. C'est alors que la vedettisation se dessine. Rien ne vaut bien souvent le contact direct que l'on songe par exemple à ces foules évaluées par White à dix millions de personnes qui ont vu Kennedy au cours des déplacements […]."
                                            },
                                            {
                                                "example_id": "ffc0d96f-dc30-4017-8002-67468c7e1918",
                                                "sense_id": "c6097045-fc8c-39eb-a512-d943c35a5f75",
                                                "text": "Plutôt que d’y aller avec des feux ou des panneaux, les traversées sont gérées par la communication, le contact visuel et la courtoisie entre usagers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c1bb48d-36ac-3056-9cb7-9f55948c5243",
                                        "entry_id": "1b3dcad9-3486-3074-b9ed-c87d979aa65e",
                                        "glosses": [
                                            "Personne avec laquelle on est en communication."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7b57dbce-81cc-3d1e-982e-63ffd2274304",
                                        "entry_id": "1b3dcad9-3486-3074-b9ed-c87d979aa65e",
                                        "glosses": [
                                            "Jonction de deux conducteurs laissant ainsi passer le courant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e109dd3c-ef23-4758-aa8b-e0252d3a6b44",
                                                "sense_id": "7b57dbce-81cc-3d1e-982e-63ffd2274304",
                                                "text": "Le contact s'établit et le courant venant de la dynamo (...) va charger la batterie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dc4d85b-871e-3ebc-a024-c1fd10110995",
                                        "entry_id": "1b3dcad9-3486-3074-b9ed-c87d979aa65e",
                                        "glosses": [
                                            "Jonction de deux conducteurs laissant ainsi passer le courant.",
                                            "Dispositif ou élément de dispositif permettant cette jonction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdee90b4-a715-47cb-b832-e4cba8567bc4",
                                                "sense_id": "6dc4d85b-871e-3ebc-a024-c1fd10110995",
                                                "text": "Bouton à vis solidaire d'un des contacts en platine servant à l'interruption."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac85b284-77dd-3a75-9856-9390fd82f2c6",
                                        "entry_id": "1b3dcad9-3486-3074-b9ed-c87d979aa65e",
                                        "glosses": [
                                            "En opérations navales, unité ennemie ou non identifiée dont la présence a été décelée."
                                        ],
                                        "tags": [
                                            "Opérations"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
