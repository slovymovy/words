                                                "sense_id": "9bac39f7-5330-31c6-9af0-1cd8c9c0ca41",
                                                "text": "He was broke after spending all his money into video games."
                                            },
                                            {
                                                "example_id": "521b5867-64e2-4034-b144-e873d1403c30",
                                                "sense_id": "9bac39f7-5330-31c6-9af0-1cd8c9c0ca41",
                                                "text": "It seems some of his Creditors have taken notice of it, and he was like to be broke yesterday in his absence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68925197-db72-3fdc-b402-ab5d2791f4b8",
                                        "entry_id": "37e1f1a2-d030-3639-9efd-6bc23b0bec16",
                                        "glosses": [
                                            "Without any money, penniless."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
