                        "glosses": [
                            "sale (a period of reduced prices)"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "ab4f34ff-540a-4720-be87-4cfd49530585",
                                "sense_id": "3c0169b8-6672-306b-bf27-c48a3b90fdfd",
                                "text": "Tijdens de zomer houden veel winkels een uitverkoop met kortingen op kleding en schoenen.",
                                "translation": "During the summer, many stores have a sale with discounts on clothing and shoes.",
                                "english": "During the summer, many stores have a sale with discounts on clothing and shoes."
                            },
                            {
                                "example_id": "7e4592f2-b7d7-4460-b453-e4fdd9a29cb5",
                                "sense_id": "3c0169b8-6672-306b-bf27-c48a3b90fdfd",
                                "text": "De uitverkoop begint morgen en duurt twee weken.",
                                "translation": "The sale starts tomorrow and lasts for two weeks.",
                                "english": "The sale starts tomorrow and lasts for two weeks."
                            },
                            {
                                "example_id": "73a6305b-b845-4d5f-bb14-911436521793",
                                "sense_id": "3c0169b8-6672-306b-bf27-c48a3b90fdfd",
                                "text": "De avocado's waren in de uitverkoop, dus ik heb een paar kilo gekocht om guacamole van te maken.",
                                "translation": "The avocados were on sale, so I bought a few kilos to make guacamole with.",
                                "english": "The avocados were on sale, so I bought a few kilos to make guacamole with."
                            }
                        ]
                    }
