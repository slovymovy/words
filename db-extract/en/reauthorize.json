                        "glosses": [
                            "To authorize again, to give authority to anew."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "523b0997-95ed-4c9d-a878-567d8ec6d2c7",
                                "sense_id": "462130a1-bec6-3a3b-9d5c-b43c498d50f2",
                                "text": "Even in the ultrapolarized atmosphere of Capitol Hill, it should be possible to secure broad bipartisan agreement on reauthorizing the Violence Against Women Act, the 1994 law at the center of the nation’s efforts to combat domestic violence, sexual assault and stalking."
                            },
                            {
                                "example_id": "d8d9916a-830e-4001-8955-5c320efa18fb",
                                "sense_id": "462130a1-bec6-3a3b-9d5c-b43c498d50f2",
                                "text": "The legislation, which passed both chambers of Congress this month by wide margins, essentially reauthorizes a Clinton-era law that provided money to states and cities for job retraining."
                            },
                            {
                                "example_id": "e0dcc893-620f-49ce-b84a-12cce4b846c8",
                                "sense_id": "462130a1-bec6-3a3b-9d5c-b43c498d50f2",
                                "text": "In April, Judge Brian M. Morris of the Federal District Court in Montana suspended the program, which is administered by the Army Corps of Engineers, saying that it had been improperly reauthorized in 2017."
                            },
                            {
                                "example_id": "bcb9ff37-34c1-4e8d-90f4-94b615afb7a7",
                                "sense_id": "462130a1-bec6-3a3b-9d5c-b43c498d50f2",
                                "text": "A top national security official at the Justice Department is expected to urge Congress to reauthorize Section 702 during a speech at the Brookings Institution on Tuesday."
                            }
                        ]
