                                "target_word": "perspicuity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e373ea0d-1b1e-3840-8c5a-998c9d73a38c",
                                        "entry_id": "ed3c5e85-346c-3672-90e4-fabd31a724ab",
                                        "glosses": [
                                            "Clarity, lucidity, especially in expression; the state or characteristic of being perspicuous."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4c7cb85-ae47-4e6f-9ad6-ab36b40ee2aa",
                                                "sense_id": "e373ea0d-1b1e-3840-8c5a-998c9d73a38c",
                                                "text": "[…]whether through the first officer's want of perspicuity or my own stupidity, I was not a bit the wiser for the explanation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1379235-3931-3d03-8687-4ba51f239f1e",
                                        "entry_id": "ed3c5e85-346c-3672-90e4-fabd31a724ab",
                                        "glosses": [
                                            "Perspicacity; insight."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fd7a033-1688-40a2-8931-45bcd48a243e",
                                                "sense_id": "e1379235-3931-3d03-8687-4ba51f239f1e",
                                                "text": "“Well,” I answered, at first with uncertainty, then with inspiration, “he would do splendidly to lead your cotillon, if you think of having one.” ¶ “So you do not dance, Mr. Crocker?” ¶ I was somewhat set back by her perspicuity."
                                            },
                                            {
                                                "example_id": "49e58249-d720-43b6-a6e2-91cb40743fbf",
                                                "sense_id": "e1379235-3931-3d03-8687-4ba51f239f1e",
                                                "text": "Thompson, a high school dropout, said with rare perspicuity that he doubted the FBI would hire him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "824b557d-9bbe-37f5-9485-d1a4e7b13a73",
                                        "entry_id": "ed3c5e85-346c-3672-90e4-fabd31a724ab",
                                        "glosses": [
                                            "Transparency; translucence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d45a159-2432-4b33-a10e-29e750363613",
                                                "sense_id": "824b557d-9bbe-37f5-9485-d1a4e7b13a73",
                                                "text": "It must have been on some such day of harsh sunlight, the incisive February brightness that gives perspicuity without warmth."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
