            "senses": [
                {
                    "sense_id": "eeceda99-5823-3ba6-9cff-b090a8c0602b",
                    "sense_definition": "Voorzien van een tafelkleed, borden, bestek en glazen voor een maaltijd.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "tafel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De tafel is al feestelijk <w>gedekt</w> voor het kerstdiner met de hele familie.",
                            "target_lang_translations": {
                                "en": "The table is already festively <w>set</w> for Christmas dinner with the whole family."
                            }
                        },
                        {
                            "text": "We zochten een plekje aan een mooi <w>gedekte</w> tafel bij het raam.",
                            "target_lang_translations": {
                                "en": "We looked for a spot at a beautifully <w>laid</w> table by the window."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een gedekte tafel"
                    ],
                    "target_lang_definitions": {
                        "en": "Provided with a tablecloth, plates, cutlery, and glasses for a meal."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "set",
                                "target_lang_sense_clarification": "of a table prepared for a meal"
                            },
                            {
                                "target_lang_word": "laid",
                                "target_lang_sense_clarification": "of a table prepared with dishes and cutlery"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba12fd4f-fbac-32d1-a03b-315e2db02304",
                    "sense_definition": "Door een verzekering, garantie of financiële reserve beschermd tegen kosten of risico's.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "financieel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn alle medische kosten tijdens uw buitenlandse reis volledig <w>gedekt</w>?",
                            "target_lang_translations": {
                                "en": "Are all medical expenses during your trip abroad fully <w>covered</w>?"
                            }
                        },
                        {
                            "text": "De schade aan de auto bleek helaas niet <w>gedekt</w> door de polis.",
                            "target_lang_translations": {
                                "en": "Unfortunately, the damage to the car turned out not to be <w>covered</w> by the policy."
                            }
                        }
                    ],
                    "synonyms": [
                        "verzekerd"
                    ],
                    "antonyms": [
                        "ongedekt"
                    ],
                    "common_phrases": [
                        "gedekt door de verzekering"
                    ],
                    "target_lang_definitions": {
                        "en": "Protected against costs or risks by insurance, a guarantee, or financial reserves."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "covered",
                                "target_lang_sense_clarification": "protected by insurance or financial means"
                            },
                            {
                                "target_lang_word": "insured",
                                "target_lang_sense_clarification": "financially protected against loss or damage"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c16da0b-2b6b-317d-bec4-2dd953bc02dd",
                    "sense_definition": "Rustig, stemmig en niet opvallend van kleur of toon.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "uiterlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voor de begrafenis koos hij kleding in sobere en <w>gedekte</w> kleuren.",
                            "target_lang_translations": {
                                "en": "For the funeral, he chose clothing in sober and <w>muted</w> colors."
                            }
                        },
                        {
                            "text": "Het kantoor is ingericht met meubels in <w>gedekte</w> tinten zoals grijs en beige.",
                            "target_lang_translations": {
                                "en": "The office is furnished with furniture in <w>subdued</w> shades such as gray and beige."
                            }
                        }
                    ],
                    "synonyms": [
                        "stemmig"
                    ],
                    "common_phrases": [
                        "gedekte kleuren",
                        "gedekte tinten"
                    ],
                    "target_lang_definitions": {
                        "en": "Subdued, muted, and not conspicuous in color or tone."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "muted",
                                "target_lang_sense_clarification": "of colors or tones, subdued and not bright"
                            },
                            {
                                "target_lang_word": "subdued",
                                "target_lang_sense_clarification": "soft and quiet in color"
                            },
                            {
                                "target_lang_word": "somber",
                                "target_lang_sense_clarification": "dark and dull in color"
                            }
                        ]
                    }
                }
            ]
        },
