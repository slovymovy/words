                {
                    "sense_id": "51a4ada3-8e27-3373-8206-72b2abdc8c38",
                    "sense_definition": "Een officiële of formele handeling verrichten, zoals een examen doen of een verklaring geven.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Alle studenten moeten aan het einde van het jaar een mondeling examen <w>afleggen</w>.",
                            "target_lang_translations": {
                                "ru": "Все студенты должны <w>сдать</w> устный экзамен в конце года.",
                                "en": "All students must <w>take</w> an oral exam at the end of the year.",
                                "fr": "Tous les étudiants doivent <w>passer</w> un examen oral à la fin de l'année."
                            }
                        },
                        {
                            "text": "De nieuwe ministers zullen morgen de eed <w>afleggen</w> bij de koning.",
                            "target_lang_translations": {
                                "ru": "Завтра новые министры <w>принесут</w> присягу королю.",
                                "en": "The new ministers will <w>swear</w> the oath before the king tomorrow.",
                                "fr": "Les nouveaux ministres vont <w>prêter</w> serment devant le roi demain."
                            }
                        }
                    ],
                    "synonyms": [
