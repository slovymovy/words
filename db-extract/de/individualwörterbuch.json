                "senses": [
                    {
                        "sense_id": "4e5e0047-a042-3206-a107-a8a43ae0473d",
                        "entry_id": "2071833e-9ade-3b6f-8f83-aa7a55f04885",
                        "glosses": [
                            "Wörterbuch, das den Wortschatz eines Autors auflistet und erklärt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cdb7fb1-4c3d-4b61-b297-cf1e6b359c6c",
                                "sense_id": "4e5e0047-a042-3206-a107-a8a43ae0473d",
                                "text": "„Eine besondere Rolle spielen Individualwörterbücher, die den Wortschatz von Personen oder berühmten Werken erfassen.“"
                            },
                            {
                                "example_id": "1ff013e0-436c-4620-8b17-bd9a670d56ae",
                                "sense_id": "4e5e0047-a042-3206-a107-a8a43ae0473d",
                                "text": "„Unter dem Namen Individualwörterbuch wird der Wortschatz von Einzelpersönlichkeiten gesammelt, vor allem von solchen, die mit ihrem Schaffen die deutsche Sprache bereichert haben.“"
                            },
                            {
                                "example_id": "2da31175-b17c-40b7-b5ea-9cdc2b5bee75",
                                "sense_id": "4e5e0047-a042-3206-a107-a8a43ae0473d",
                                "text": "„Als historisches Individualwörterbuch verfolgt das Goethe-Wörterbuch zunächst innerhalb der Goethe-Philologie die Sicherung des präzisen Textverständnisses…“"
                            },
                            {
                                "example_id": "76c3d5be-5eb0-4a4f-813d-4dd9efd5f902",
                                "sense_id": "4e5e0047-a042-3206-a107-a8a43ae0473d",
                                "text": "„Als andere Erscheinungsformen des Wörterbuchs führt Hausmann folgende auf: …- Sprachgemeinschaftswörterbuch versus Individualwörterbuch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
