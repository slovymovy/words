                                                "sense_id": "4194c497-94fd-3bd6-99c5-f43874caf617",
                                                "text": "Der Ausdruck Fahrrad ist ein Holonym zu den Ausdrücken Fahrradkette, Lenkstange, Pedal, Sattel und anderen Ausdrücken, welche die restlichen Bestandteile des Fahrrades bezeichnen."
                                            },
                                            {
                                                "example_id": "91e288bd-58ab-496d-b6ee-fd4fd1754c72",
                                                "sense_id": "4194c497-94fd-3bd6-99c5-f43874caf617",
                                                "text": "Computer ist ein Holonym von CPU."
                                            },
                                            {
                                                "example_id": "18f2d301-cb2c-4525-be44-d3635b909db6",
                                                "sense_id": "4194c497-94fd-3bd6-99c5-f43874caf617",
                                                "text": "Das Holonym Demokratie umfasst das Meronym „Recht auf freie Meinungsäußerung“."
                                            }
