                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20f7c266-debe-446c-a976-e2affd828014",
                                                "sense_id": "bfb248aa-7a0f-30b4-9cbf-26350973bef5",
