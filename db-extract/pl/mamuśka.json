                "senses": [
                    {
                        "sense_id": "d7572447-f217-3648-bd47-da2a2a1a3399",
                        "entry_id": "c25ab958-771b-38cf-a3a7-6c894ae0994c",
                        "glosses": [
                            "matka"
                        ],
                        "tags": [
                            "diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "9fd05b9b-c242-4aad-a78b-1b324c20253f",
                                "sense_id": "d7572447-f217-3648-bd47-da2a2a1a3399",
                                "text": "Nasza mamuśka dostaje od nas zawsze bukiet czerwonych róż."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "7ecb4ad0-656a-3ca6-bd25-65c39308e09a",
                        "entry_id": "c25ab958-771b-38cf-a3a7-6c894ae0994c",
                        "glosses": [
                            "kobieta przypuszczalnie mająca dzieci, dojrzała"
                        ],
                        "tags": [
                            "ironic"
                        ],
                        "examples": [
                            {
                                "example_id": "1f25595b-1244-49f2-8f5c-116016de49cf",
                                "sense_id": "7ecb4ad0-656a-3ca6-bd25-65c39308e09a",
                                "text": "Na ławce przed blokiem siedziały trzy mamuśki i lustrowały przechodzących, raz po raz wybuchając salwami śmiechu."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
