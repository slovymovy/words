                        "examples": [
                            {
                                "example_id": "911d7dfd-d0b7-4e82-a501-4cf32e2b6bac",
                                "sense_id": "0ff10474-7ed6-3ad0-a232-19fafd8c86fd",
                                "text": "Immer wieder hören wir die Frage von Personen, denen die Gedankenwelt des Anarchismus nicht vertraut ist: Was wollt ihr eigentlich? Wie stellt ihr euch eine Gesellschaft ohne Staat und Obrigkeit vor?",
                                "translation": "Again and again we hear the question from people who are not familiar with the world of ideas of anarchism: what do you actually want? How do you imagine a society without state and authorities?",
                                "english": "Again and again we hear the question from people who are not familiar with the world of ideas of anarchism: what do you actually want? How do you imagine a society without state and authorities?"
                            },
                            {
                                "example_id": "145db096-0ddf-4e44-a92d-8ae5c259064c",
                                "sense_id": "0ff10474-7ed6-3ad0-a232-19fafd8c86fd",
                                "text": "Das Problem ist, dass wahrscheinlich deutlich zu viele kichernde Thomase und Franks in dem Team der Werbeagentur saßen, die sich “Der life-saving Handjob“ ausgedacht hat. Das Problem ist, wie sich in dem Video deren Gedankenwelt offenbart."
                            }
                        ]
                    }
