                        "glosses": [
                            "Qui s’apparente au cyclone."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b3822ca7-ded0-4dfa-87be-7a74c7a11862",
                                "sense_id": "28a2f5b5-92ee-3d34-b949-d786db27340b",
                                "text": "C’est du « Bernstein », mais d’une élévation, d’une grandeur cyclonesque que les œuvres précédentes pouvaient à peine faire pressentir."
                            },
                            {
                                "example_id": "eb7d176d-83b8-47a4-a5ca-efe94450b177",
                                "sense_id": "28a2f5b5-92ee-3d34-b949-d786db27340b",
                                "text": "Ma doué, ce typhon cyclonesque !"
                            },
                            {
                                "example_id": "e8c02201-c189-436d-aaae-be2eea844fe2",
                                "sense_id": "28a2f5b5-92ee-3d34-b949-d786db27340b",
                                "text": "La grêle déferlait par rafales, mitraillant des volées de plomb glacé projetées par le souffle d’un vent cyclonesque. Mon parapluie aux frêles baleines n’était pas de taille."
                            }
                        ]
                    }
