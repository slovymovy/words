                "senses": [
                    {
                        "sense_id": "9db4a94b-42fd-3de5-9f11-f134db889f57",
                        "entry_id": "4586eb83-4b86-3b33-bf2a-047cd42a9e6d",
                        "glosses": [
                            "die Liebe einer Mutter zu ihren – auch erwachsenen – Kindern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf902b22-c9de-402f-8cdb-e5a6f169dbfe",
                                "sense_id": "9db4a94b-42fd-3de5-9f11-f134db889f57",
                                "text": "Vater- und Mutterliebe sind für die Entwicklung eines Kindes nicht ersetzbar."
                            },
                            {
                                "example_id": "edbee469-85e9-4286-ab7f-81f177a52e30",
                                "sense_id": "9db4a94b-42fd-3de5-9f11-f134db889f57",
                                "text": "„Und doch wäre es wohl besser gewesen, wenn sich die Mutterliebe auch in sichtbaren Zärtlichkeiten geäußert hätte, anstatt sich nur in vorbildlicher Pflichterfüllung und in der Vermittlerrolle zum Vater zu erschöpfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
