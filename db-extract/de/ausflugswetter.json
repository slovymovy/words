                    {
                        "sense_id": "73a70b30-1860-34b8-bb05-0fb3c8c577db",
                        "entry_id": "ea9f1d4d-4f2c-3a95-9532-74d758d4cef1",
                        "glosses": [
                            "Wetter, mit vorherrschendem Sonnenschein und wenig Bewölkung; sehr gut geeignet für die Durchführung eines Ausflugs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "baf8d7fb-e3ff-42aa-a763-c1d65171061c",
                                "sense_id": "73a70b30-1860-34b8-bb05-0fb3c8c577db",
                                "text": "„Das Narzissenfest im Ausseerland feiert heuer seine 60. Jubiläum. Für den großen Umzug ist perfektes Ausflugswetter angesagt.“"
                            },
                            {
                                "example_id": "93ed4bc7-ce27-4eb0-ac06-441a8f87fcf3",
                                "sense_id": "73a70b30-1860-34b8-bb05-0fb3c8c577db",
                                "text": "„Bei bestem Ausflugswetter am Sonntagnachmittag verkeilt sich eine der 32 Kabinen und macht damit eine Rückfahrt an den Drahtseilen unmöglich.“"
                            },
                            {
                                "example_id": "59633392-51f4-4ee3-8777-4ee6371ec467",
                                "sense_id": "73a70b30-1860-34b8-bb05-0fb3c8c577db",
                                "text": "„Die Wochenendprognosen verheißen Ausflugswetter bei Sonne und 25 Grad.“"
                            }
                        ],
