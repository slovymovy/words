                "senses": [
                    {
                        "sense_id": "d5ebda0c-5a23-3f08-a18e-c08200c89ee0",
                        "entry_id": "82d2dd2c-6b1e-34d5-b0c0-c8553a88184f",
                        "glosses": [
                            "Vorrichtung, die zur Ermittlung der Sehstärke beziehungsweise der Brechkraft des Auges dient und zur Anpassung von Sehhilfen verwendet wird"
                        ],
                        "tags": [
                            "Optometrie",
                            "Augenheilkunde"
                        ],
                        "examples": [
                            {
                                "example_id": "29a87ed0-4e9c-434b-9f3d-33b86d47e0fd",
                                "sense_id": "d5ebda0c-5a23-3f08-a18e-c08200c89ee0",
                                "text": "„Wenn Sie zum Optiker gehen, müssen Sie Symbole auf einer Tafel durch eine große metallene Apparatur mit Brillengläsern namens Phoropter erkennen.“"
                            },
                            {
                                "example_id": "fc713849-32c5-4a74-a8fd-07f57158929b",
                                "sense_id": "d5ebda0c-5a23-3f08-a18e-c08200c89ee0",
                                "text": "„Am häufigsten wird die Kreuzzylindermethode mit einem Stielkreuzzylinder oder am Phoropter durchgeführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
