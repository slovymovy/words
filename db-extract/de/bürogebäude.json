                    }
                ],
                "senses": [
                    {
                        "sense_id": "982bf1ba-38ae-3ad5-8afa-8b98646aa698",
                        "entry_id": "4eb7515b-10d5-3a48-9f5c-fa977449e860",
                        "glosses": [
                            "Bauwerk mit einem Büro/Büros"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c61fa89-0bfe-4cb0-9388-e10378cfafef",
                                "sense_id": "982bf1ba-38ae-3ad5-8afa-8b98646aa698",
                                "text": "„Im Bürogebäude im siebten Stockwerk hatte der festliche Taumel bereits ein wenig eingesetzt.“"
                            },
                            {
                                "example_id": "d0ca2dfb-8d2e-48e6-9026-64246b6ffa4f",
                                "sense_id": "982bf1ba-38ae-3ad5-8afa-8b98646aa698",
                                "text": "„Da, wo sie wohnt, stehen hohe Bürogebäude neben heruntergekommenen Lagerhäusern und schäbigen Gemüseläden, die von Türken oder Marokkanern geführt werden.“"
                            },
                            {
                                "example_id": "fe960b61-b1c9-4238-872e-1f1159b22326",
                                "sense_id": "982bf1ba-38ae-3ad5-8afa-8b98646aa698",
                                "text": "„Er beschlagnahmte das unbenutzte Dach eines alten Bürogebäudes und richtete es mit Hilfe einiger Bühnenarbeiter und Theatertechniker – indem er einiges Material verwendete, das er, wahrscheinlich nach der Methode eines Zauberkünstlers, selbst beschaffen mußte – zu mehreren Zimmern her, die als ziemlich angenehme Büros zu benutzen waren.“"
                            },
                            {
                                "example_id": "5b532e30-78d2-4448-91ef-d6e5bbc51ed1",
                                "sense_id": "982bf1ba-38ae-3ad5-8afa-8b98646aa698",
                                "text": "„Schnellen Schrittes überquerten wir eine breite Straße mit modernen Bürogebäuden und gelangten auf einen von alten und neuen Backsteinbauten gesäumten Fußgängerweg, der uns geradeaus direkt bis zur Millenium Bridge und zur Themse führte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a68f46cf-b458-450e-8c0f-e8b14245a181",
                        "source_entry_id": "4eb7515b-10d5-3a48-9f5c-fa977449e860",
                        "source_sense_id": "982bf1ba-38ae-3ad5-8afa-8b98646aa698",
                        "source_sense_description": "Bauwerk mit einem Büro/Büros",
                        "target_lang_word": "immeuble de bureaux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "immeuble de bureaux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "58bd212c-81e2-353e-81f7-24d01102263a",
                                        "entry_id": "0457afef-69dc-32cd-841f-b0cbb438d2f4",
                                        "glosses": [
                                            "Bâtiment servant essentiellement à héberger des utilisateurs de bureaux quoiqu’il puisse aussi inclure des espaces commerciaux accessoires, des locaux d’entreposage et très souvent des espaces de stationnement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccecedc4-1e91-48cc-95a1-5dfa7e2d44a6",
                                                "sense_id": "58bd212c-81e2-353e-81f7-24d01102263a",
                                                "text": "Par le biais des contacts qu'ils s'étaient faits au sein des radios et télévisions du West End, papa et maman avaient décroché un nouveau contrat de nettoyage dans un immeuble de bureaux situé à Kensington. C'était un vaste édifice tout en marbre, avec des vitres en verre fumé dont la rénovation avait coûté des millions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
