                        "examples": [
                            {
                                "example_id": "448e38c2-22e6-4e3e-ab76-67069e44fcc6",
                                "sense_id": "f7affd60-d6ac-3455-a05e-00c4a8d9969e",
                                "text": "Sylvestre suit la petite troupe dans la vallée. Il la perd à nouveau mais un chabrétaïre a mis en branle son instrument."
                            },
