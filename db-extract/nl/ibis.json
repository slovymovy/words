                                "target_senses": [
                                    {
                                        "sense_id": "71af7512-b4c2-3702-91ab-21675b37dd00",
                                        "entry_id": "29c606dc-e9ff-31df-a29a-bad173eabb39",
                                        "glosses": [
                                            "Any of various long-legged wading birds in the family Threskiornithidae, having long downcurved bills used to probe the mud for prey such as crustaceans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e158b75-b4f2-4820-b695-bc926f21cda2",
                                                "sense_id": "71af7512-b4c2-3702-91ab-21675b37dd00",
                                                "text": "It is out of the idolatrous dotings of the old Egyptians upon broiled ibis and roasted river horse, that you see the mummies of those creatures in their huge bake-houses the pyramids."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "857c4170-9001-4f5b-a60d-a715e8fd3d4a",
                        "source_entry_id": "7293ae39-a929-3b3a-a8de-3c970271127e",
                        "source_sense_id": "675712e4-2bb1-36ba-9652-9bd61e493651",
                        "source_sense_description": "een vogel met een lange gebogen snavel behorend tot de familie Threskiornithidae",
                        "target_lang_word": "ibis",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ibis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4c6492d5-b95f-3fe0-b52a-21e8a90a83fe",
                                        "entry_id": "dec11815-46f7-3e52-92c6-00ad57ded07b",
                                        "glosses": [
                                            "Espèce d'oiseau échassier de la famille des threskiornithidés, au bec long, mince et recourbé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "172d87f4-24dd-4b8b-8c0e-4aa1e3eb95df",
                                                "sense_id": "4c6492d5-b95f-3fe0-b52a-21e8a90a83fe",
                                                "text": "Hier, Néférou-Ra courait parmi les roses,\nLa joue et le front purs polis comme un bel or,\nEt souriait, son cœur étant paisible encor,\nDe voir dans le ciel bleu voler les ibis roses."
                                            },
                                            {
                                                "example_id": "c1d07a9a-a073-4177-b0be-16a5e1110ad8",
                                                "sense_id": "4c6492d5-b95f-3fe0-b52a-21e8a90a83fe",
                                                "text": "L’ibis et le babouin sont les animaux sacrés de Thot, dieu de la sagesse et de l’art de l'écriture."
                                            },
                                            {
                                                "example_id": "f75b25e1-f8aa-4a7e-9071-fd5e8b95ef69",
                                                "sense_id": "4c6492d5-b95f-3fe0-b52a-21e8a90a83fe",
                                                "text": "Des ibis, promeneurs mélancoliques, flânaient d'une démarche blasée. De leurs longs becs recourbés, ils fouillaient les berges humides à la recherche de grenouilles ou de petits reptiles. Dans un gracieux envol multicolore, deux de ces échassiers quittèrent le sol sableux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
