{
    "word_family": [
        "snauwen",
        "snauwerig"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "094362ad-c904-3fb5-8f9d-5b5c1d8f3174",
                    "sense_definition": "Een korte, onaangename of boze opmerking; een bits antwoord.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uitroep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tot mijn verbazing kreeg ik meteen een felle <w>snauw</w> van de winkelier.",
                            "target_lang_translations": {
                                "fr": "À ma grande surprise, j'ai tout de suite essuyé une vive <w>rebuffade</w> de la part du commerçant."
                            }
                        },
                        {
                            "text": "Hij reageerde met een kortaf antwoord en gaf haar een onvriendelijke <w>snauw</w>.",
                            "target_lang_translations": {
                                "fr": "Il a réagi par une réponse brève et lui a lancé une <w>parole blessante</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een snauw krijgen",
                        "een snauw geven"
                    ],
                    "target_lang_definitions": {
                        "fr": "Remarque brève, désagréable ou agressive ; réponse sèche ou cassante."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "rebuffade",
                                "target_lang_sense_clarification": "réponse ou accueil brusque et désagréable"
                            },
                            {
                                "target_lang_word": "aboiement",
                                "target_lang_sense_clarification": "parole agressive et abrupte"
                            },
                            {
                                "target_lang_word": "réplique cinglante",
                                "target_lang_sense_clarification": "réponse mordante ou sèche"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aed8983f-09a9-3ac2-b688-5b01cd9f366f",
                    "sense_definition": "Een historisch type zeilschip met twee masten en een scherpe boeg.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "schip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kapitein voer op een snelle <w>snauw</w> over de noordelijke wateren.",
                            "target_lang_translations": {
                                "fr": "Le capitaine naviguait sur les eaux du nord à bord d'un <w>senau</w> rapide."
                            }
                        },
                        {
                            "text": "In het maritiem museum staat een model van een achttiende-eeuwse <w>snauw</w>.",
                            "target_lang_translations": {
                                "fr": "Au musée maritime se trouve une maquette d'un <w>senau</w> du XVIIIe siècle."
                            }
                        }
                    ],
                    "synonyms": [
                        "snauwschip"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historisch scheepstype"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Type historique de voilier à deux mâts muni d'un mât de tape-cul ou d'artimon."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "senau",
                                "target_lang_sense_clarification": "navire à voile historique"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ffba99d9-e054-3c1b-9f73-5bae8264ef08",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>snauwen</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "snauwen_vormen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als ik erg gestrest ben, <w>snauw</w> ik soms zonder reden tegen mijn vrienden.",
                            "target_lang_translations": {
                                "fr": "Quand je suis très stressé, il m'arrive d'<w>aboyer</w> sans raison sur mes amis."
                            }
                        },
                        {
                            "text": "Ik <w>snauw</w> niet graag tegen anderen, maar vandaag ben ik heel moe.",
                            "target_lang_translations": {
                                "fr": "Je n'aime pas <w>rabrouer</w> les autres, mais aujourd'hui je suis très fatigué."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Vervoegde vorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Première personne du singulier au présent de l'indicatif de snauwen (aboyer, rudoyer, parler sèchement)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "aboie",
                                "target_lang_sense_clarification": "parler agressivement (je)"
                            },
                            {
                                "target_lang_word": "rabroue",
                                "target_lang_sense_clarification": "rudoyer verbalement (je)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "313ceeda-f91c-320c-90c9-d37a1beaa3bc",
                    "sense_definition": "Tweede persoon enkelvoud tegenwoordige tijd met inversie van <w>snauwen</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "snauwen_vormen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>snauw</w> je zo fel tegen je zusje?",
                            "target_lang_translations": {
                                "fr": "Pourquoi <w>aboies-tu</w> si vivement sur ta petite sœur ?"
                            }
                        },
                        {
                            "text": "<w>Snauw</w> je altijd als iemand je een gewone vraag stelt?",
                            "target_lang_translations": {
                                "fr": "<w>Réponds-tu toujours sèchement</w> quand quelqu'un te pose une question banale ?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Vervoegde vorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Deuxième personne du singulier au présent de l'indicatif (avec inversion) de snauwen."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "aboies",
                                "target_lang_sense_clarification": "parler agressivement (tu)"
                            },
                            {
                                "target_lang_word": "rabroues",
                                "target_lang_sense_clarification": "rudoyer verbalement (tu)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b799c691-7648-3d89-bcb4-13bde938ecc4",
                    "sense_definition": "Gebiedende wijs van <w>snauwen</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "snauwen_vormen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Snauw</w> toch niet zo ongeduldig tegen iedereen om je heen!",
                            "target_lang_translations": {
                                "fr": "<w>N'aboie</w> donc pas si impatiemment sur tout le monde autour de toi !"
                            }
                        },
                        {
                            "text": "<w>Snauw</w> niet naar mij, ik probeer je alleen maar te helpen.",
                            "target_lang_translations": {
                                "fr": "<w>Ne me rabroue</w> pas, j'essaie seulement de t'aider."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Vervoegde vorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Impératif singulier de snauwen."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "n'aboie pas",
                                "target_lang_sense_clarification": "ordre ou défense de parler agressivement"
                            },
                            {
                                "target_lang_word": "ne rabroue pas",
                                "target_lang_sense_clarification": "ordre ou défense de rudoyer verbalement"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}