                                "target_senses": [
                                    {
                                        "sense_id": "370c0d7b-9091-3263-9474-2b92900acd83",
                                        "entry_id": "b1b20f3e-2e53-313d-b38c-4b2bb6012bad",
                                        "glosses": [
                                            "The casting of a magical charm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c95fe1e-cb91-4f1f-9073-b37fc721660a",
                                                "sense_id": "370c0d7b-9091-3263-9474-2b92900acd83",
                                                "text": "They denied me often flour, barm and milk, / Goose-grease and tar, when I ne'er hurt their charmings, / Their brewlocks, nor their batches, nor forespoke / Any of their breedings."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "charming",
