                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f77a378a-ad26-4409-a417-3dc625245eae",
                                "sense_id": "3abacd66-c018-3d49-b9e7-c6e5880c8b29",
                                "text": "„Der Sandhafer ist eine sehr anspruchslose Haferart und vertritt den verwandten und heute ausschließlich angebauten Saathafer auf armen Böden, wie Sand und eben Hochmoor.“"
                            },
                            {
                                "example_id": "be0212bf-f2de-4d94-9895-770965923d31",
                                "sense_id": "3abacd66-c018-3d49-b9e7-c6e5880c8b29",
                                "text": "„Der Sandhafer hat eine lange und dünne Spelzfruchtbasis und Rachilla; die Deckspelzen besitzen eine dicke und gedrehte Granne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
