{
    "word_family": [
        "recharge",
        "discharge",
        "charger",
        "chargeable",
        "surcharge",
        "overcharge",
        "undercharge"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e6a158f6-ae7d-3158-b8b0-6c9ac1072299",
                    "sense_definition": "To require payment of a price or fee for goods or services.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "payment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel will <w>charge</w> you extra if you use the mini-bar.",
                            "target_lang_translations": {
                                "ru": "Отель <w>возьмет</w> с вас дополнительную плату, если вы воспользуетесь мини-баром."
                            }
                        },
                        {
                            "text": "How much do you <w>charge</w> for a haircut these days?",
                            "target_lang_translations": {
                                "ru": "Сколько вы сейчас <w>берете</w> за стрижку?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "charge a fee",
                        "charge for services"
                    ],
                    "target_lang_definitions": {
                        "ru": "Требовать оплаты цены или сбора за товары или услуги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взимать",
                                "target_lang_sense_clarification": "плату или налог"
                            },
                            {
                                "target_lang_word": "назначать цену",
                                "target_lang_sense_clarification": "устанавливать стоимость"
                            },
                            {
                                "target_lang_word": "брать",
                                "target_lang_sense_clarification": "деньги за услугу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15641bee-dbf0-3e1c-88ae-79b7bdd6d791",
                    "sense_definition": "To replenish energy to a battery or a device by connecting it to a power source.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "electricity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to <w>charge</w> my phone because the battery is almost dead.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>зарядить</w> телефон, потому что батарея почти села."
                            }
                        },
                        {
                            "text": "It takes about two hours to fully <w>charge</w> the laptop.",
                            "target_lang_translations": {
                                "ru": "Для полной <w>зарядки</w> ноутбука требуется около двух часов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "charge a battery",
                        "charge my phone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Восполнять энергию аккумулятора или устройства, подключая его к источнику питания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заряжать",
                                "target_lang_sense_clarification": "устройство или батарею"
                            },
                            {
                                "target_lang_word": "подзаряжать",
                                "target_lang_sense_clarification": "немного восполнить заряд"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "207bed0b-8c04-3a3f-ac0d-6cc10d88db93",
                    "sense_definition": "To move forward quickly and forcefully, especially in an attack.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers began to <w>charge</w> toward the enemy lines at dawn.",
                            "target_lang_translations": {
                                "ru": "На рассвете солдаты начали <w>атаковать</w> позиции противника."
                            }
                        },
                        {
                            "text": "The angry bull started to <w>charge</w> at the gate.",
                            "target_lang_translations": {
                                "ru": "Разъяренный бык начал <w>нестись</w> на ворота."
                            }
                        }
                    ],
                    "common_phrases": [
                        "charge forward",
                        "charge at someone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро и решительно двигаться вперед, особенно при атаке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "атаковать",
                                "target_lang_sense_clarification": "идти в наступление"
                            },
                            {
                                "target_lang_word": "нестись",
                                "target_lang_sense_clarification": "стремительно бежать"
                            },
                            {
                                "target_lang_word": "бросаться",
                                "target_lang_sense_clarification": "в атаку или на кого-то"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50a6bb02-3f2d-3f2a-af48-8c62c05526ea",
                    "sense_definition": "To formally accuse someone of a crime.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police decided to <w>charge</w> him with theft after finding the stolen goods.",
                            "target_lang_translations": {
                                "ru": "Полиция решила <w>обвинить</w> его в краже после обнаружения украденных вещей."
                            }
                        },
                        {
                            "text": "They cannot <w>charge</w> her without more evidence.",
                            "target_lang_translations": {
                                "ru": "Они не могут <w>предъявить</w> ей обвинение без дополнительных улик."
                            }
                        }
                    ],
                    "common_phrases": [
                        "charge with murder",
                        "charge with assault"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально обвинить кого-либо в совершении преступления."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обвинять",
                                "target_lang_sense_clarification": "в совершении преступления"
                            },
                            {
                                "target_lang_word": "предъявлять обвинение",
                                "target_lang_sense_clarification": "официальный юридический акт"
                            },
                            {
                                "target_lang_word": "инкриминировать",
                                "target_lang_sense_clarification": "вменять в вину"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64f19aa5-6a5a-316e-b0fa-60a969fe8754",
                    "sense_definition": "To assign a duty or responsibility to someone; to order or entrust.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "responsibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee will <w>charge</w> the director with overseeing the new project.",
                            "target_lang_translations": {
                                "ru": "Комитет <w>поручит</w> директору курирование нового проекта."
                            }
                        },
                        {
                            "text": "He was <w>charged</w> to keep the secret at all costs.",
                            "target_lang_translations": {
                                "ru": "Ему было <w>велено</w> хранить секрет любой ценой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "charge someone with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возлагать на кого-либо обязанность или ответственность; приказывать или поручать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поручать",
                                "target_lang_sense_clarification": "давать задание"
                            },
                            {
                                "target_lang_word": "возлагать",
                                "target_lang_sense_clarification": "ответственность или миссию"
                            },
                            {
                                "target_lang_word": "вменять в обязанность",
                                "target_lang_sense_clarification": "делать обязательным"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "23bae526-0bda-3485-a280-84543c9413c8",
                    "sense_definition": "The amount of money requested or paid for a service or goods.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "payment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a small <w>charge</w> for delivery if you live outside the city.",
                            "target_lang_translations": {
                                "ru": "За доставку за пределы города взимается небольшая <w>плата</w>."
                            }
                        },
                        {
                            "text": "The service <w>charge</w> is already included in the total bill.",
                            "target_lang_translations": {
                                "ru": "Сервисный <w>сбор</w> уже включен в общий счет."
                            }
                        }
                    ],
                    "common_phrases": [
                        "service charge",
                        "admission charge",
                        "extra charge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сумма денег, запрашиваемая или выплачиваемая за услугу или товар."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плата",
                                "target_lang_sense_clarification": "денежное вознаграждение"
                            },
                            {
                                "target_lang_word": "сбор",
                                "target_lang_sense_clarification": "дополнительный платеж"
                            },
                            {
                                "target_lang_word": "тариф",
                                "target_lang_sense_clarification": "установленная стоимость"
                            },
                            {
                                "target_lang_word": "цена",
                                "target_lang_sense_clarification": "стоимость товара"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d675bc0f-26be-35aa-a684-7df23c0d6660",
                    "sense_definition": "The state of being responsible for someone or something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "responsibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nurse is in <w>charge</w> of the pediatric ward tonight.",
                            "target_lang_translations": {
                                "ru": "Медсестра сегодня <w>отвечает</w> за педиатрическое отделение."
                            }
                        },
                        {
                            "text": "Who will take <w>charge</w> of the department while the manager is away?",
                            "target_lang_translations": {
                                "ru": "Кто возьмет на себя <w>руководство</w> отделом, пока менеджер в отъезде?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in charge",
                        "take charge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние ответственности за кого-либо или что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ответственность",
                                "target_lang_sense_clarification": "обязанность отвечать за что-то"
                            },
                            {
                                "target_lang_word": "руководство",
                                "target_lang_sense_clarification": "управление процессом"
                            },
                            {
                                "target_lang_word": "попечение",
                                "target_lang_sense_clarification": "забота и надзор"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae0a3113-2f86-358b-a623-1dc31e6be7f8",
                    "sense_definition": "An official statement by the police or a court accusing someone of a crime.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The suspect is facing a serious <w>charge</w> of armed robbery.",
                            "target_lang_translations": {
                                "ru": "Подозреваемому предъявлено серьезное <w>обвинение</w> в вооруженном ограблении."
                            }
                        },
                        {
                            "text": "The police dropped the <w>charge</w> due to a lack of evidence.",
                            "target_lang_translations": {
                                "ru": "Полиция сняла <w>обвинение</w> из-за отсутствия улик."
                            }
                        }
                    ],
                    "synonyms": [
                        "count"
                    ],
                    "common_phrases": [
                        "criminal charge",
                        "press charges",
                        "face charges"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное заявление полиции или суда, обвиняющее кого-либо в преступлении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обвинение",
                                "target_lang_sense_clarification": "юридический пункт"
                            },
                            {
                                "target_lang_word": "пункт обвинения",
                                "target_lang_sense_clarification": "конкретная статья"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "014b3813-8b7d-372e-9c2a-eaec0ddce041",
                    "sense_definition": "A sudden, rushing attack by soldiers or animals.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cavalry led a brave <w>charge</w> against the enemy's flank.",
                            "target_lang_translations": {
                                "ru": "Кавалерия предприняла смелую <w>атаку</w> на фланг противника."
                            }
                        },
                        {
                            "text": "We watched the elephant's <w>charge</w> from a safe distance.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали за <w>броском</w> слона с безопасного расстояния."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lead a charge",
                        "bayonet charge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапная, стремительная атака солдат или животных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "атака",
                                "target_lang_sense_clarification": "стремительное нападение"
                            },
                            {
                                "target_lang_word": "натиск",
                                "target_lang_sense_clarification": "сильное давление при атаке"
                            },
                            {
                                "target_lang_word": "бросок",
                                "target_lang_sense_clarification": "резкое движение вперед"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "474f6be1-f2ca-3929-bb02-ce3ed79f53a8",
                    "sense_definition": "A property of matter that causes it to experience a force when placed in an electromagnetic field.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "electricity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "An electron carries a negative electric <w>charge</w>.",
                            "target_lang_translations": {
                                "ru": "Электрон несет отрицательный электрический <w>заряд</w>."
                            }
                        },
                        {
                            "text": "The battery has lost its <w>charge</w> and needs to be replaced.",
                            "target_lang_translations": {
                                "ru": "Батарея потеряла свой <w>заряд</w> и нуждается в замене."
                            }
                        }
                    ],
                    "common_phrases": [
                        "electric charge",
                        "positive charge",
                        "negative charge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свойство материи, заставляющее её испытывать силу при помещении в электромагнитное поле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заряд",
                                "target_lang_sense_clarification": "электрический"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}