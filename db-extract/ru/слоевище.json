                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "9dcc8e0b-a880-39dd-b709-f77718f44209",
                                        "entry_id": "6399a9fe-62f6-3f3c-81a6-92f3e601a464",
                                        "glosses": [
                                            "Bauteil, das Lasten aufnimmt"
                                        ],
                                        "tags": [
                                            "Maschinenbau",
                                            "Statik",
                                            "nur Plural 1"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "41228a3b-0b52-3fd7-9a40-571474f902d3",
                                        "entry_id": "6399a9fe-62f6-3f3c-81a6-92f3e601a464",
                                        "glosses": [
                                            "Gesamtheit der Anhänger einer Weltanschauung"
                                        ],
                                        "tags": [
                                            "Soziologie",
                                            "nur Plural 1"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5c466d2-f380-46a8-92b9-a68c56fecf24",
                                                "sense_id": "41228a3b-0b52-3fd7-9a40-571474f902d3",
                                                "text": "Die Anhänger des konservativen Lagers waren mit dem Vorschlag nicht einverstanden."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "6d0e9974-3188-30df-afbb-e9cfca3f0fef",
                                        "entry_id": "6399a9fe-62f6-3f3c-81a6-92f3e601a464",
                                        "glosses": [
                                            "Kurzform für ein Konzentrations-, Inhaftierungs- oder Internierungslager"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6944e604-2014-4f2a-a272-ceb53ea4ea05",
                                                "sense_id": "6d0e9974-3188-30df-afbb-e9cfca3f0fef",
                                                "text": "„Das Dachauer Lager genoss außerordentliche Publizität. Die Tagespresse brachte Berichte über Häftlingstransporte, über die Pläne, die Lagerinsassen zur Kultivierung des Dachauer Mooses einzusetzen … dass die Häftlinge anlässlich des Geburtstages von Hitler Musik hören konnten und besonders gutes Essen und Zigaretten erhielten.“"
                                            },
                                            {
                                                "example_id": "aa019697-5b9c-499f-919b-bf93bd49bf6a",
                                                "sense_id": "6d0e9974-3188-30df-afbb-e9cfca3f0fef",
                                                "text": "„Die Karte aus dem Internet verzeichnet alle Lager auf österreichischem Boden, Kriegsgefangenen-, Arbeits- und Konzentrationslager.“"
                                            },
                                            {
                                                "example_id": "f3a75d7a-a0a3-47f6-9aca-4f7ba864a93b",
                                                "sense_id": "6d0e9974-3188-30df-afbb-e9cfca3f0fef",
                                                "text": "„Aus diesen Lagern gingen sie in die Emigration nach England und Frankreich, aber auch nach Schweden, Kanada und in die USA.“"
                                            },
                                            {
                                                "example_id": "4b99690f-5f19-44c9-8b2c-21450d081b3b",
                                                "sense_id": "6d0e9974-3188-30df-afbb-e9cfca3f0fef",
                                                "text": "„Um vier Uhr früh wird geweckt, um viertel vor fünf steht man auf dem Appellplatz, dann heißt es Steine einen Kilometer vom Steinbruch ins Lager schleppen, zwölf bis vierzehn Stunden lang – die Lagerstraße wird gerade gebaut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "d0150680-d3c0-322b-b632-87d57b6c37cd",
                                        "entry_id": "6399a9fe-62f6-3f3c-81a6-92f3e601a464",
                                        "glosses": [
                                            "Kurzform für Lagerbier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4d441fa-2075-4bdf-bc24-d7e98fc77be0",
                                                "sense_id": "d0150680-d3c0-322b-b632-87d57b6c37cd",
                                                "text": "Lager ist ein untergäriges Bier."
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "8c42183b-9494-3f5e-b363-5928190ded9c",
                                        "entry_id": "6399a9fe-62f6-3f3c-81a6-92f3e601a464",
                                        "glosses": [
                                            "Schlafstatt; Stelle, die einer Person zum Liegen beziehungsweise Schlafen zugedacht ist"
                                        ],
                                        "tags": [
                                            "altertümlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3e38d47-e37e-4525-a25a-1e93e02b6235",
                                                "sense_id": "8c42183b-9494-3f5e-b363-5928190ded9c",
                                                "text": "Er schob sich den Strohsack zurecht und legte sich auf sein Lager zur Nachtruhe."
                                            },
                                            {
                                                "example_id": "533f17a2-6619-43d6-8cf0-3740fda1cd15",
                                                "sense_id": "8c42183b-9494-3f5e-b363-5928190ded9c",
                                                "text": "„All die Lager der letzten Jahre, sie spürte sie noch in ihren Knochen: die Pritsche in Marseille, die Strohsäcke auf dem Frachter, in Casablanca die Krankenliegen.“"
                                            },
                                            {
                                                "example_id": "924a6c8f-b3d9-4a8f-959d-ae381301ac59",
                                                "sense_id": "8c42183b-9494-3f5e-b363-5928190ded9c",
                                                "text": "„Seine trübe Phantasie hatte ihn aufgejagt von seinem Lager und in den Wald getrieben, wo er umhergeschweift war, bis die naßkalte Nachtluft und das gedehnte gellende Gelächter der Eulen ihn wieder zurückjagte.“"
