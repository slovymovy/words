                        "entry_id": "853c0f4a-1c82-326d-964a-f32f75961f75",
                        "glosses": [
                            "(colloquial) To play a song or a portion of a song, usually on a percussion instrument such as a piano."
                        ],
                        "tags": [
                            "with \\\"out\\"
                        ],
                        "examples": [
                            {
                                "example_id": "d378874b-959e-49b8-ab06-a7f971f3b61f",
                                "sense_id": "c1bd3208-0863-30e0-8e68-4d9ca3d27b68",
                                "text": "He can plink out Let Me Call You Sweetheart for reporters on a piano or rib himself on television talk shows […]"
                            },
                            {
                                "example_id": "4b321430-70d4-42dc-a681-83af4eb0345c",
                                "sense_id": "c1bd3208-0863-30e0-8e68-4d9ca3d27b68",
                                "text": "Your child may also begin to plink out a few notes on a xylophone or toy piano before her first birthday."
                            },
                            {
                                "example_id": "ce9dd680-af3a-4523-9dd1-042f13bbdfd3",
                                "sense_id": "c1bd3208-0863-30e0-8e68-4d9ca3d27b68",
                                "text": "The female deputy sat down at the ramshackle piano and proceeded to plink out the opening notes of \"Heart and Soul.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "1d41f6a0-0f4f-3d28-9e70-a3d1f5e43dbf",
                        "entry_id": "853c0f4a-1c82-326d-964a-f32f75961f75",
                        "glosses": [
                            "To take part in the sport of plinking."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69edba84-9c6a-42aa-b520-3e49df870b10",
                                "sense_id": "1d41f6a0-0f4f-3d28-9e70-a3d1f5e43dbf",
                                "text": "We plinked all week long in the slow-moving days between hunting seasons. Life Savers or Necco Wafers at 25 yards offhand, or 50 yards prone, and vanilla wafers offhand at 50 yards or prone at 100, were challenging targets."
                            }
                        ]
                    }
