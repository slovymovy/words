                        "sense_id": "49a76d72-bb32-3739-8efa-0ea40f7c8672",
                        "entry_id": "61e84b65-bdeb-3002-940e-f70a8d12e801",
                        "glosses": [
                            "niet vatbaar voor omkoping en corruptie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fc2cad8-38c1-48b0-982f-1045811423dd",
                                "sense_id": "49a76d72-bb32-3739-8efa-0ea40f7c8672",
