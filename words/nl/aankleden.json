                    "antonyms": [
                        "uitkleden",
                        "ontkleden"
                    ],
                    "common_phrases": [
                        "de kinderen aankleden",
                        "de pop aankleden"
                    ],
                    "target_lang_definitions": {
                        "en": "To put clothes on someone else or something.",
                        "ru": "Надевать одежду на кого-то другого или на что-то.",
                        "it": "Mettere i vestiti a qualcun altro o a qualcosa.",
                        "zh": "给别人或某物穿上衣服。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dress",
                                "target_lang_sense_clarification": "to put clothes on someone"
