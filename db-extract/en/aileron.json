                                "target_senses": [
                                    {
                                        "sense_id": "12b05638-6069-37f0-acf2-c85a8e17d346",
                                        "entry_id": "f13345f5-37dd-3403-91d2-435599937877",
                                        "glosses": [
                                            "Superficie de mando y control que se encuentran en los extremos de las alas de los aviones y su misión es llevar a cabo los virajes del avión a ambos lados a través de un movimiento de alabeo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8843dc83-bc32-455f-8827-50fb83844839",
                                                "sense_id": "12b05638-6069-37f0-acf2-c85a8e17d346",
                                                "text": "En aviones de vuelo subsónico alto, se utilizan para el control longitudinal en vuelo dos tipos diferentes de alerones: los de alta velocidad y los de baja velocidad."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "141947f5-e0d9-39ed-a8f8-475f8b8fd607",
                                        "entry_id": "f13345f5-37dd-3403-91d2-435599937877",
                                        "glosses": [
                                            "Se denomina alerón a las plataformas adyacentes al puente de mando que se construyen a ambas bandas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b1c384c-ce25-4671-b581-5d0f75c12d8d",
                                                "sense_id": "141947f5-e0d9-39ed-a8f8-475f8b8fd607",
                                                "text": "Normalmente los alerones tienen la doble finalidad de servir de punto de observación para las mediciones astronómicas, y durante las maniobras de atraque o desatraque brindar un punto de observación que permita visualizar la banda o costado del buque que toca muelle."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5582ca0b-b98c-3349-bc7d-d561a1773e8e",
                                        "entry_id": "f13345f5-37dd-3403-91d2-435599937877",
                                        "glosses": [
                                            "En autos de competición, un alerón se dispone invertido respecto de los aviones de tal manera que en vez de empujar el vehículo hacia arriba lo hace hacia abajo."
                                        ],
                                        "tags": [
                                            "Automovilismo"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3e53bb5-4ad4-4914-8557-afe81cf8bae6",
                                                "sense_id": "5582ca0b-b98c-3349-bc7d-d561a1773e8e",
                                                "text": "En lugar de fabricar el alerón trasero, la rejilla del radiador, el parachoques y la aleta por separado, como se hacía anteriormente, ahora estas cuatro piezas se integran en una sola."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
