                        "source_sense_id": "538e7aad-1767-3410-9bd7-b84f7bdb8c17",
                        "source_sense_description": "hochbeiniger Stuhl in Lokalen an der Theke (= Bar) oder hohen Tischen",
                        "target_lang_word": "bar stool",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bar stool",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c5a1e36-9a92-3af4-80ed-0e1990a4b1fc",
                                        "entry_id": "40057b98-99cb-3ba2-965f-078d48d443d9",
                                        "glosses": [
                                            "A stool used for sitting, often taller than a chair and usually having a foot rest, commonly placed in bars and in front of kitchen counters."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83370303-5612-4e43-bf5c-4e1f6f19e79d",
                                                "sense_id": "7c5a1e36-9a92-3af4-80ed-0e1990a4b1fc",
                                                "text": "Although we are no longer consigned to the bar stool and bottle, we still generally frequent these places to enhance our difficult egos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e325231-c5cc-3480-a1e1-42f34ff16223",
                                        "entry_id": "40057b98-99cb-3ba2-965f-078d48d443d9",
                                        "glosses": [
                                            "The male-dominated milieu typically associated with bars, in particular sports bars."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a6318a0-f40f-416d-bf2d-99a3522e2cd4",
                                                "sense_id": "3e325231-c5cc-3480-a1e1-42f34ff16223",
                                                "text": "barstool conservatism"
                                            },
                                            {
                                                "example_id": "ef2283c1-fa01-45cd-8c87-dbcb92528c5c",
                                                "sense_id": "3e325231-c5cc-3480-a1e1-42f34ff16223",
                                                "text": "I have many male friends, and they frequently include me in barstool-punditry sessions where they pontificate, often with wisdom and insight, on the issues of the day."
                                            },
                                            {
                                                "example_id": "9b748ed0-5448-4782-8141-3221a075893a",
                                                "sense_id": "3e325231-c5cc-3480-a1e1-42f34ff16223",
                                                "text": "Accordingly, Trump and Von’s conversation rambled through classic barstool topics: their favorite fighters, Kid Rock’s golf swing, and the question of why people no longer have heart attacks from the excitement at sporting events."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
