                "senses": [
                    {
                        "sense_id": "c54f3af2-2094-35d3-ba99-42f4de3e095b",
                        "entry_id": "73541062-7b11-320d-9219-1da9f4593f6a",
                        "glosses": [
                            "Donner un caractère phraséologique à, faire devenir une locution figée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f7f51d2-7c82-459c-86f0-e93c31a585b3",
                                "sense_id": "c54f3af2-2094-35d3-ba99-42f4de3e095b",
                                "text": "On sait depuis longtemps que les expressions lexicales peuvent se phraséologiser; par exemple, le sens de “SE FAIRE UN SANG D’ENCRE” ne contient pas ceux de SANG ou de ENCRE."
                            }
                        ]
                    },
                    {
                        "sense_id": "aa4490ab-a121-3b02-9c0b-103cda37d9b4",
                        "entry_id": "73541062-7b11-320d-9219-1da9f4593f6a",
                        "glosses": [
                            "Tenir des discours creux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5ac35bd-6d4f-4a36-8741-09facb8bee6f",
                                "sense_id": "aa4490ab-a121-3b02-9c0b-103cda37d9b4",
                                "text": "Il se débat comme dans un sport un peu fou, il dépense, il phraséologise, il (se) tient des discours, le tout sidéré, figé dans un code statuaire."
                            },
                            {
                                "example_id": "f34abf09-47fc-4277-869a-69ee98980587",
                                "sense_id": "aa4490ab-a121-3b02-9c0b-103cda37d9b4",
                                "text": "En effet, par l’intermédiaire de sa Direction de la Communication, il a fait parvenir à tous les organes de presse, le communiqué suivant (Communiquer, c'est expliquer, expliquer, expliquer et non pas \"phraséologiser\" ni faire de la publicité politique) : (…)"
                            }
                        ]
                    }
                ],
