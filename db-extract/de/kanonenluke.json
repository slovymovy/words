                "senses": [
                    {
                        "sense_id": "d50192ac-3391-3641-8ccd-0c45311f34a1",
                        "entry_id": "1ecdbade-d3a7-35f0-8ca0-8d5289cec887",
                        "glosses": [
                            "Öffnung in einer Wand für die dahinter platzierte Kanone (zum Beispiel in der Schiffswand von Kriegsschiffen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fe7b1bb-fa52-49dd-a62d-25c69608846c",
                                "sense_id": "d50192ac-3391-3641-8ccd-0c45311f34a1",
                                "text": "„Die spanische Flagge wehte am Hauptmast, und sämtliche Kanonenluken an Steuerbordseite waren geöffnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef61c9ee-ff67-473e-8ecb-ddb9f0f29e52",
                        "source_entry_id": "1ecdbade-d3a7-35f0-8ca0-8d5289cec887",
                        "source_sense_id": "d50192ac-3391-3641-8ccd-0c45311f34a1",
                        "target_lang_word": "sabord",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sabord",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "88b80822-a0f3-30eb-af03-6c4b2ae1e395",
                                        "entry_id": "59448337-4295-3413-840f-7ae52b7bfc96",
                                        "glosses": [
                                            "Ouverture quadrangulaire pratiquée dans la muraille d’un vaisseau et par laquelle le canon tire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f45becd-01de-41dd-a226-03897c54bb39",
                                                "sense_id": "88b80822-a0f3-30eb-af03-6c4b2ae1e395",
                                                "text": "Ouvrir, fermer les sabords. — Il y avait deux rangs de sabords."
                                            },
                                            {
                                                "example_id": "3a0af10e-470d-47ca-9419-c2fd350e1e26",
                                                "sense_id": "88b80822-a0f3-30eb-af03-6c4b2ae1e395",
                                                "text": "Le boulet est entré au-dessous du couronnement, et est sorti par le troisième sabord de tribord."
                                            },
                                            {
                                                "example_id": "23582d8d-9ca2-4425-8912-d66e68e367d4",
                                                "sense_id": "88b80822-a0f3-30eb-af03-6c4b2ae1e395",
                                                "text": "Nous remarquâmes qu’elle eut la bonté de nous laisser passer plusieurs fois devant elle sans tirer un coup de canon, et même tout d’un coup, elle les retira tous dans l’intérieur et ferma tous ses sabords."
                                            },
                                            {
                                                "example_id": "539e929a-a73e-4051-87ae-273efeded13e",
                                                "sense_id": "88b80822-a0f3-30eb-af03-6c4b2ae1e395",
                                                "text": "On signale par tribord,\nUn navire d'apparence\nA mantelets de sabords !"
                                            },
                                            {
                                                "example_id": "33ae6d82-1d15-4d23-8547-e0ddd72b3499",
                                                "sense_id": "88b80822-a0f3-30eb-af03-6c4b2ae1e395",
                                                "text": "— […], et l’on voit encore comment, dans les étages supérieurs des tours, les créneaux étaient garnis de volets à rouleaux : sortes de sabords, manœuvrant sur un axe de bois posé sur deux crochets en fer ; […]."
                                            },
                                            {
                                                "example_id": "6c4ca3c8-83fc-4e8d-8a56-62f46b780870",
                                                "sense_id": "88b80822-a0f3-30eb-af03-6c4b2ae1e395",
                                                "text": "Les salles du château arrière, jadis transformées en entrepôt dans lequel maître Imbert et son second dormaient sans façon, redevinrent un appartement clair, où le soleil, réverbéré par la mer, entrait par la large ouverture des sabords d’arcasse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22c783f2-57f0-354a-8c34-d19cd1076784",
                                        "entry_id": "59448337-4295-3413-840f-7ae52b7bfc96",
                                        "glosses": [
                                            "Mille sabords ! : vieux juron plaisant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cb95b42-4705-4dee-879e-0de924b9a1b7",
                                                "sense_id": "22c783f2-57f0-354a-8c34-d19cd1076784",
                                                "text": "Gourgaud, furieux — Halte-là !\nMille sabords ! va-t-on m'expliquer ce mystère ?"
                                            },
                                            {
                                                "example_id": "bea395f4-47d2-4520-b5db-f5d35d20f616",
                                                "sense_id": "22c783f2-57f0-354a-8c34-d19cd1076784",
                                                "text": "Le capitaine a juré, sacré — mille sabords du diable ! — en me voyant sortir de ma cachette et m’offrir comme novice, mais il ne peut pas me jeter par-dessus bord ; je suis de l’équipage !"
                                            },
                                            {
                                                "example_id": "3db47222-5ccf-44ae-857b-dff63db16e7d",
                                                "sense_id": "22c783f2-57f0-354a-8c34-d19cd1076784",
                                                "text": "Mᵐᵉ Paimbœuf, commère puissante, robuste, se précipita vers l'intruse, lui lançant d'une voix mâle et sonore :\n— Mille sabords ! Qui êtes-vous et que venez-vous faire ici ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
