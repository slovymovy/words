{
    "word_family": [
        "instrumental",
        "instrumentation",
        "instrumentalist",
        "instrumentality"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ebd45ada-15aa-39d7-b342-de86220f40c5",
                    "sense_definition": "A device used to produce music.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The violinist was a master of her <w>instrument</w>.",
                            "target_lang_translations": {
                                "ru": "Скрипачка была мастером своего <w>инструмента</w>."
                            }
                        },
                        {
                            "text": "She decided to learn a new <w>musical</w> <w>instrument</w> during the summer break.",
                            "target_lang_translations": {
                                "ru": "Она решила освоить новый музыкальный <w>инструмент</w> во время летних каникул."
                            }
                        }
                    ],
                    "common_phrases": [
                        "musical instrument",
                        "play an instrument"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устройство, используемое для создания музыки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инструмент",
                                "target_lang_sense_clarification": "музыкальный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7c9b5da-77cd-38f2-ad6e-63e5c723f208",
                    "sense_definition": "A tool or implement used for precise work, manipulation, or measurement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dentist set down his tray of <w>instruments</w> before starting the procedure.",
                            "target_lang_translations": {
                                "ru": "Стоматолог поставил поднос с <w>инструментами</w> перед началом процедуры."
                            }
                        },
                        {
                            "text": "The scientist used a delicate <w>scientific</w> <w>instrument</w> to measure the chemical reaction.",
                            "target_lang_translations": {
                                "ru": "Ученый использовал высокоточный научный <w>прибор</w> для измерения химической реакции."
                            }
                        }
                    ],
                    "synonyms": [
                        "implement",
                        "tool",
                        "utensil"
                    ],
                    "common_phrases": [
                        "scientific instrument",
                        "surgical instrument"
                    ],
                    "target_lang_definitions": {
                        "ru": "Инструмент или приспособление, используемое для точной работы, манипуляций или измерений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инструмент",
                                "target_lang_sense_clarification": "орудие труда"
                            },
                            {
                                "target_lang_word": "орудие",
                                "target_lang_sense_clarification": "техническое приспособление"
                            },
                            {
                                "target_lang_word": "приспособление",
                                "target_lang_sense_clarification": "устройство для работы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f47de32-de30-3c03-9c65-4a370ebeb769",
                    "sense_definition": "A measuring or displaying device, especially one used for navigation or monitoring.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>instrument</w> detected a significant increase in radioactivity in the area.",
                            "target_lang_translations": {
                                "ru": "<w>Прибор</w> зафиксировал значительное повышение радиоактивности в этом районе."
                            }
                        },
                        {
                            "text": "Pilots must rely on their <w>flight</w> <w>instruments</w> when flying through thick clouds.",
                            "target_lang_translations": {
                                "ru": "Пилоты должны полагаться на свои пилотажные <w>приборы</w> при полете сквозь густые облака."
                            }
                        }
                    ],
                    "synonyms": [
                        "measure"
                    ],
                    "common_phrases": [
                        "flight instrument",
                        "instrument panel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Измерительное или отображающее устройство, особенно используемое для навигации или мониторинга."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прибор",
                                "target_lang_sense_clarification": "измерительное устройство"
                            },
                            {
                                "target_lang_word": "устройство",
                                "target_lang_sense_clarification": "технический аппарат"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a99e4cf-803a-3dc8-a7d9-e2bcdad766e1",
                    "sense_definition": "A formal legal document, such as a contract, deed, or will.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A bond indenture is the <w>legal</w> <w>instrument</w> that gives a bond its value.",
                            "target_lang_translations": {
                                "ru": "Облигационный договор — это юридический <w>акт</w>, который определяет стоимость облигации."
                            }
                        },
                        {
                            "text": "The lawyer prepared the necessary <w>instruments</w> for the transfer of property.",
                            "target_lang_translations": {
                                "ru": "Юрист подготовил необходимые <w>документы</w> для передачи собственности."
                            }
                        }
                    ],
                    "common_phrases": [
                        "legal instrument",
                        "negotiable instrument"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальный юридический документ, такой как контракт, акт или завещание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "акт",
                                "target_lang_sense_clarification": "юридический документ"
                            },
                            {
                                "target_lang_word": "инструмент",
                                "target_lang_sense_clarification": "правовой акт"
                            },
                            {
                                "target_lang_word": "грамота",
                                "target_lang_sense_clarification": "официальный документ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8049308a-9c4b-3210-b0bd-fc4eca53a292",
                    "sense_definition": "A means or agency used to achieve a specific effect or goal.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "agency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new law became an <w>instrument</w> of change for the entire education system.",
                            "target_lang_translations": {
                                "ru": "Новый закон стал <w>инструментом</w> перемен для всей системы образования."
                            }
                        },
                        {
                            "text": "Diplomacy is a powerful <w>instrument</w> <w>of</w> <w>policy</w> in international relations.",
                            "target_lang_translations": {
                                "ru": "Дипломатия — это мощное <w>орудие</w> политики в международных отношениях."
                            }
                        }
                    ],
                    "common_phrases": [
                        "instrument of policy",
                        "instrument of change"
                    ],
                    "target_lang_definitions": {
                        "ru": "Средство или посредник, используемый для достижения определенного эффекта или цели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инструмент",
                                "target_lang_sense_clarification": "средство влияния"
                            },
                            {
                                "target_lang_word": "орудие",
                                "target_lang_sense_clarification": "способ достижения цели"
                            },
                            {
                                "target_lang_word": "средство",
                                "target_lang_sense_clarification": "метод достижения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1770bd6-6919-33a6-ab0b-2b3edfb6da8a",
                    "sense_definition": "A person who is used by another as a tool to achieve a goal.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "agency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He realized too late that he was merely an <w>instrument</w> in their political game.",
                            "target_lang_translations": {
                                "ru": "Он слишком поздно понял, что был всего лишь <w>орудием</w> в их политической игре."
                            }
                        },
                        {
                            "text": "The dictator used his subordinates as <w>instruments</w> to carry out his plans.",
                            "target_lang_translations": {
                                "ru": "Диктатор использовал своих подчиненных как <w>инструменты</w> для осуществления своих планов."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, которого другой использует как средство для достижения цели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "орудие",
                                "target_lang_sense_clarification": "о человеке"
                            },
                            {
                                "target_lang_word": "инструмент",
                                "target_lang_sense_clarification": "в чужих руках"
                            },
                            {
                                "target_lang_word": "марионетка",
                                "target_lang_sense_clarification": "подвластный человек"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ceb62fa3-3705-37bc-b71a-b610f2b15ef4",
                    "sense_definition": "To arrange or orchestrate a piece of music for specific instruments.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "music_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The composer <w>instrumented</w> the sonata for a full symphony orchestra.",
                            "target_lang_translations": {
                                "ru": "Композитор <w>проинструментовал</w> сонату для полного симфонического оркестра."
                            }
                        },
                        {
                            "text": "She spent weeks <w>instrumenting</w> the score to achieve the right sound.",
                            "target_lang_translations": {
                                "ru": "Она потратила недели на <w>инструментовку</w> партитуры, чтобы добиться нужного звучания."
                            }
                        }
                    ],
                    "synonyms": [
                        "arrange"
                    ],
                    "target_lang_definitions": {
                        "ru": "Аранжировать или оркестровать музыкальное произведение для определенных инструментов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инструментовать",
                                "target_lang_sense_clarification": "делать оркестровку"
                            },
                            {
                                "target_lang_word": "оркестровать",
                                "target_lang_sense_clarification": "перелагать для оркестра"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b799dff8-9889-3d49-a5ad-6b78afe1feb4",
                    "sense_definition": "To equip a system or device with measuring instruments for monitoring.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Engineers <w>instrumented</w> the test vehicle with dozens of sensors.",
                            "target_lang_translations": {
                                "ru": "Инженеры <w>оснастили</w> испытательный автомобиль десятками датчиков."
                            }
                        },
                        {
                            "text": "The bridge was <w>instrumented</w> to monitor structural stress over time.",
                            "target_lang_translations": {
                                "ru": "Мост был <w>оборудован</w> приборами для мониторинга структурного напряжения с течением времени."
                            }
                        }
                    ],
                    "synonyms": [
                        "measure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оснастить систему или устройство измерительными приборами для мониторинга."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оснащать",
                                "target_lang_sense_clarification": "снабжать приборами"
                            },
                            {
                                "target_lang_word": "оборудовать",
                                "target_lang_sense_clarification": "устанавливать аппаратуру"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}