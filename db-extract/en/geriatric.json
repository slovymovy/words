                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc414f49-0593-4505-8e0f-2b997bd20f38",
                                "sense_id": "d28965e5-89eb-31d1-80e1-c508fd837d08",
                                "text": "At that moment he was practicing one of his professions—that of geriatric psychiatrist."
