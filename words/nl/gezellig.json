                    "frequency": "High",
                    "semantic_group_id": "atmosphere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We hebben gisteren een heel <w>gezellige</w> avond gehad met vrienden.",
                            "target_lang_translations": {
                                "en": "We had a very <w>pleasant</w> evening with friends yesterday.",
                                "ru": "Вчера мы провели очень <w>душевный</w> вечер с друзьями.",
                                "cs": "Včera jsme s přáteli prožili velmi <w>příjemný</w> večer.",
                                "de": "Wir hatten gestern einen sehr <w>gemütlichen</w> Abend mit Freunden.",
                                "it": "Ieri abbiamo passato una serata molto <w>piacevole</w> con gli amici."
                            }
                        },
                        {
                            "text": "Met al die kaarsjes aan is de woonkamer erg <w>gezellig</w>.",
