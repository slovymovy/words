        "fr-extract.jsonl": [
            {
                "entry_id": "3554ec66-cc77-34f0-8bd3-95ebbe37b728",
                "word": "niaisement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ea4f464b-54bd-3dc2-a1b4-6b679697f561",
                        "entry_id": "3554ec66-cc77-34f0-8bd3-95ebbe37b728",
                        "glosses": [
                            "D'une manière niaise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50156530-7e57-406d-bfe2-085d2d77d257",
                                "sense_id": "ea4f464b-54bd-3dc2-a1b4-6b679697f561",
                                "text": "Si vous m'eussiez permis dès le commencement de vous en envoyer [des poulets, des billets-doux], j'en saurais faire à cette heure de forts jolis, et je ne finirais pas niaisement comme je fais, en disant, mademoiselle, que je suis votre très humble et très obéissant serviteur."
                            },
                            {
                                "example_id": "3d7fbb6e-fdd2-4276-bf0d-674fe917c551",
                                "sense_id": "ea4f464b-54bd-3dc2-a1b4-6b679697f561",
                                "text": "Il n'ira pas niaisement interrogeant les autres sur tout ce qu'il voit."
                            },
                            {
                                "example_id": "30707d2e-8df0-4889-94ca-a35941e0f4b3",
                                "sense_id": "ea4f464b-54bd-3dc2-a1b4-6b679697f561",
                                "text": "[…] le Brillat-Savarin, espèce de brioche insipide dont le moindre défaut est de servir de prétexte à une dégoisade de maximes niaisement pédantesques tirées du fameux chef-d’œuvre."
                            },
                            {
                                "example_id": "3188185b-b3f1-437e-bc97-431b44844172",
                                "sense_id": "ea4f464b-54bd-3dc2-a1b4-6b679697f561",
                                "text": "Il mange lentement, handicapé par une mastication pénible, ne dit pas un mot, rit niaisement de loin en loin."
                            },
                            {
                                "example_id": "95e3a40f-d236-46bd-88fd-24d2d5729d27",
                                "sense_id": "ea4f464b-54bd-3dc2-a1b4-6b679697f561",
                                "text": "— Quoi ? demanda Jean-Philippe, niaisement.\n— Rien, dit Simon. Tu peux pas comprendre…"
                            },
                            {
                                "example_id": "7d3306a6-f5af-497a-b80a-a8992678e8e9",
                                "sense_id": "ea4f464b-54bd-3dc2-a1b4-6b679697f561",
                                "text": "Sofer se rendit compte qu'il souriait niaisement bien que les questions posées méritassent beaucoup plus de sérieux. Il se contrôla et reprit sa posture distante, plus ironique que vraiment sévère."
                            }
                        ]
                    }
                ],
                "translations": [
