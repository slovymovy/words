                                        "glosses": [
                                            "Se dit de toute plante qui produit le caoutchouc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc0122ae-e6db-4ef2-aee1-984bef82a60b",
                                                "sense_id": "c63ee83e-7eb1-3212-9d0b-77ff0a1884cf",
                                                "text": "La plante caoutchoutière la plus abondante, au Congo, est la liane Landolphia, qui fournit un caoutchouc de première qualité; mais la présence d’autres plantes à gomme a été signalée."
                                            }
