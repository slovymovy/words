                        "source_sense_id": "b00ac057-6ce1-300c-b7f1-6f3510b9b7c7",
                        "target_lang_word": "décalquer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "décalquer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fac1a883-b0d5-3dcf-b503-d9a8f1dd0be8",
                                        "entry_id": "c5f7def8-788d-3775-96b7-d9539556cfaa",
                                        "glosses": [
                                            "Reproduire par le calque un dessin ou un tableau sur du papier, sur une toile, sur une muraille, sur une planche de cuivre, etc."
                                        ],
                                        "tags": [
                                            "Dessin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39efea77-8e66-47d8-a040-d9de996032ac",
                                                "sense_id": "fac1a883-b0d5-3dcf-b503-d9a8f1dd0be8",
                                                "text": "Il s'agit, commente Granacci à voix basse, de reporter cette esquisse au fusain sur le mur que le maçon vient de recouvrir d'enduit frais. Pour cela, on va décalquer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1ea95d7-387a-340c-b2f7-b6c6b8f873b7",
                                        "entry_id": "c5f7def8-788d-3775-96b7-d9539556cfaa",
                                        "glosses": [
                                            "Épuiser par une mauvaise hygiène de vie (nuit blanche, drogue, etc)."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0d841b7-d763-4ab5-9dbf-020057a89adc",
                                                "sense_id": "e1ea95d7-387a-340c-b2f7-b6c6b8f873b7",
                                                "text": "Chaque matin je suis décalqué ! / Hier soir encore, j’ me suis éclaté / J’sais même plus combien j’ai claqué"
                                            },
                                            {
                                                "example_id": "6b548eec-d387-42e8-a5e9-b4fd6bcb36f3",
                                                "sense_id": "e1ea95d7-387a-340c-b2f7-b6c6b8f873b7",
                                                "text": "Tu t'éclates, hein. - Je veux rentrer, en fait. Je suis décalqué."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
