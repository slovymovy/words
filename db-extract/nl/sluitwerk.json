                                    },
                                    {
                                        "sense_id": "2463efdf-bac0-3ed8-b8c0-fccab3f41519",
                                        "entry_id": "147e995c-1bbe-35a2-97a4-03402055a351",
                                        "glosses": [
                                            "The smallest closed set which contains the given set."
                                        ],
                                        "tags": [
                                            "countable",
