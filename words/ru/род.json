            "pos": "noun",
            "senses": [
                {
                    "sense_id": "43e53678-00a1-3b29-be47-c274e82df3ab",
                    "sense_definition": "Совокупность всех поколений людей, происходящих от одного общего предка.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "family_lineage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это очень древний <w>род</w>, который берёт своё начало ещё в средние века.",
                            "target_lang_translations": {
                                "en": "This is a very ancient <w>lineage</w> that dates back to the Middle Ages."
                            }
                        },
                        {
                            "text": "Он гордится тем, что принадлежит к известному дворянскому <w>роду</w>.",
                            "target_lang_translations": {
                                "en": "He is proud to belong to a well-known noble <w>family</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "семья"
                    ],
                    "common_phrases": [
                        "древний род",
                        "дворянский род"
                    ],
                    "target_lang_definitions": {
                        "en": "All generations of people descended from a common ancestor; lineage or family line."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lineage",
                                "target_lang_sense_clarification": "ancestry or line of descent"
                            },
                            {
                                "target_lang_word": "family",
                                "target_lang_sense_clarification": "noble or ancestral line"
                            },
                            {
                                "target_lang_word": "clan",
                                "target_lang_sense_clarification": "extended family or group descended from a common ancestor"
                            },
                            {
                                "target_lang_word": "kin",
                                "target_lang_sense_clarification": "relatives or family lineage"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79fa6e57-840c-3d09-873e-72beb2ca827f",
                    "sense_definition": "Грамматическая категория имен существительных, указывающая на принадлежность к мужскому, женскому или среднему классу.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В русском языке существительное стол относится к мужскому <w>роду</w>.",
                            "target_lang_translations": {
                                "en": "In Russian, the noun \"стол\" belongs to the masculine <w>gender</w>."
                            }
                        },
                        {
                            "text": "Слово окно имеет средний <w>род</w>.",
                            "target_lang_translations": {
                                "en": "The word \"окно\" has neuter <w>gender</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "мужской род",
                        "женский род",
                        "средний род"
                    ],
                    "target_lang_definitions": {
                        "en": "A grammatical category of nouns indicating masculine, feminine, or neuter class."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gender",
                                "target_lang_sense_clarification": "grammatical classification of nouns"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5306c4cd-4d29-37c1-8535-4839988c4834",
                    "sense_definition": "Разновидность, тип или категория чего-либо.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "type_category",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Какой <w>род</w> занятий вы предпочитаете в свободное время?",
                            "target_lang_translations": {
                                "en": "What <w>kind</w> of activities do you prefer in your free time?"
                            }
                        },
                        {
                            "text": "Существуют разные <w>роды</w> войск, каждый из которых выполняет свои задачи.",
                            "target_lang_translations": {
                                "en": "There are different <w>branches</w> of the armed forces, each performing its own tasks."
                            }
                        }
                    ],
                    "synonyms": [
                        "вид",
                        "тип"
                    ],
                    "common_phrases": [
                        "род занятий",
                        "род войск",
                        "своего рода",
                        "такого рода"
                    ],
                    "target_lang_definitions": {
