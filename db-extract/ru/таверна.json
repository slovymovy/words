                    {
                        "translation_id": "9bbe5a2e-3c90-4610-afe5-3dc0c92f69fb",
                        "source_entry_id": "b5faa8bf-cb33-3997-9e4d-7d9874401f0d",
                        "source_sense_id": "c7ef31a5-f164-337f-9649-ed6c6e2017fb",
                        "target_lang_word": "hospoda",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hospoda",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "a3436553-27cd-3283-b58a-1446189a4cf5",
                                        "entry_id": "dcc7f3b0-fd13-3d08-a6c4-b7e76aa2eae7",
                                        "glosses": [
                                            "restaurační zařízení s nabídkou alkoholických nápojů"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d9e2e34-56b8-400b-8a5b-664e10c7d0aa",
                                                "sense_id": "a3436553-27cd-3283-b58a-1446189a4cf5",
                                                "text": "V hospodách ještě politizovali muži se zájmy všeobecnými."
                                            },
                                            {
                                                "example_id": "d1996f88-741c-4023-9f7f-7688d86147f9",
                                                "sense_id": "a3436553-27cd-3283-b58a-1446189a4cf5",
                                                "text": "Seděl jsem s přáteli před hospodou u přívozu a popíjel labužnicky dobré rakouské víno."
                                            },
                                            {
                                                "example_id": "060297a9-8014-4b7a-91e5-2e7feb2efefd",
                                                "sense_id": "a3436553-27cd-3283-b58a-1446189a4cf5",
                                                "text": "„Náš hostinský býval vojákem — tenkrát si po hospodách čárky z tácku tajně umazával — teď je tajně na tácek připisuje.“"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d436dd46-7602-3c59-96d5-98a54784ca98",
                                        "entry_id": "dcc7f3b0-fd13-3d08-a6c4-b7e76aa2eae7",
                                        "glosses": [
                                            "stávající osazenstvo tohoto zařízení, momentální hosté v hospodě (1)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "341d8482-4373-4bea-b97d-ed0290124e11",
                                                "sense_id": "d436dd46-7602-3c59-96d5-98a54784ca98",
                                                "text": "Platím za celou hospodu!"
                                            },
                                            {
                                                "example_id": "4c032a2e-6f31-47f3-8386-a68a1fab3d9f",
                                                "sense_id": "d436dd46-7602-3c59-96d5-98a54784ca98",
                                                "text": "„… husí kůže šupěla nám po zádech, když jsme viděli, jak hází Jírou a Bartíkem — jako by to byla pírka — byl by jimi vytřískal celou hospodu —“ vyprávěli Hradišťáci."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78239441-0b6f-3e6d-8ca4-add9ea1626d3",
                                        "entry_id": "dcc7f3b0-fd13-3d08-a6c4-b7e76aa2eae7",
                                        "glosses": [
                                            "osoba obsluhující v hospodě (1), hostinský (převážně jen ve vokativu singuláru)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9c8d5be-f176-4931-bb1e-79a9488a208d",
                                                "sense_id": "78239441-0b6f-3e6d-8ca4-add9ea1626d3",
                                                "text": "Hej, hospodo! Každému sklenku a chytro nalévej, což neznáš Hordubala a nejsem já majner z Ameriky?"
                                            }
                                        ]
                                    }
                                ]
                            },
