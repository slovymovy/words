                ],
                "senses": [
                    {
                        "sense_id": "1cf20107-ba33-3df8-b62f-7898ea89c53e",
                        "entry_id": "7266e8eb-9597-330c-94fa-dca517084f4b",
                        "glosses": [
                            "Insel, die sich im Gebiet des Pazifischen Ozeans befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df3aa622-2d7e-47fa-a9f2-4b90350a5530",
                                "sense_id": "1cf20107-ba33-3df8-b62f-7898ea89c53e",
                                "text": "„Ein Erdbeben der Stärke 5,6 hat am Dienstag die Pazifikinsel Guam erschüttert.“"
                            },
                            {
                                "example_id": "a909dc08-2e47-4753-b268-c340c44805d9",
                                "sense_id": "1cf20107-ba33-3df8-b62f-7898ea89c53e",
                                "text": "„Mit begrenztem Proviant und einer Notfallausrüstung war ein Paar auf der einsamen Pazifikinsel East Fayu gestrandet.“"
                            },
                            {
                                "example_id": "934e166a-0f3d-43d4-9418-d20d23c0af60",
                                "sense_id": "1cf20107-ba33-3df8-b62f-7898ea89c53e",
                                "text": "„Die Pazifikinsel war das reichste Land der Erde – dank Bergen von Vogelkot, der zu Phosphat geworden war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
