                                        "examples": [
                                            {
                                                "example_id": "ad6e3b70-beed-4e90-bcec-f96eb3358c54",
                                                "sense_id": "42f4147a-44f3-3701-87d7-b86f017f8852",
                                                "text": "„Selig die Trauernden; denn sie werden getröstet werden.“ (Aus den Seligpreisungen der Bergpredigt)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0071d79b-9a25-3d47-a346-b6cbfed725ca",
                                        "entry_id": "f09c37eb-fba2-36d6-a7c7-f5807943dd15",
                                        "glosses": [
                                            "aller Widrigkeiten des Lebens enthoben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03d84bb4-c98f-46e8-b1f4-0ac86d1412ae",
                                                "sense_id": "0071d79b-9a25-3d47-a346-b6cbfed725ca",
                                                "text": "„Dr. Adenauer bestieg sein Bett, drehte sich – so der sicherlich authentische Bericht meines Vaters selig – etwas herum, und fragte sodann: ‚Bete mer nicht, lieber Joest?‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cc44f22a-4fe0-3c32-8109-e5fe94856e02",
                                        "entry_id": "f09c37eb-fba2-36d6-a7c7-f5807943dd15",
                                        "glosses": [
                                            "von starkem Hochgefühl erfüllt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39d30557-00c9-46e3-b782-4edfa8f6391c",
                                                "sense_id": "cc44f22a-4fe0-3c32-8109-e5fe94856e02",
                                                "text": "Nach dem gelungenen Fest war sie nur noch selig."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
