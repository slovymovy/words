                {
                    "sense_id": "d8bf9f35-4ff3-34ee-8e89-1929f50200e4",
                    "sense_definition": "De ruimte boven de aarde die je ziet als je naar boven kijkt, waar wolken, de zon en sterren staan.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "group_sky",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kijk eens naar die mooie vogels hoog in de <w>lucht</w>.",
                            "target_lang_translations": {
                                "en": "Look at those beautiful birds high in the <w>sky</w>.",
                                "ru": "Посмотри на этих красивых птиц высоко в <w>небе</w>.",
                                "pl": "Spójrz na te piękne ptaki wysoko na <w>niebie</w>.",
                                "de": "Schau dir diese schönen Vögel hoch am <w>Himmel</w> an.",
                                "fr": "Regarde ces beaux oiseaux haut dans le <w>ciel</w>.",
                                "it": "Guarda quei bellissimi uccelli in alto nel <w>cielo</w>.",
                                "cs": "Podívej se na ty krásné ptáky vysoko na <w>nebi</w>.",
                                "tr": "Şu <w>gökyüzünde</w> yükseklerde uçan güzel kuşlara bak.",
                                "es": "Mira esos hermosos pájaros en lo alto del <w>cielo</w>."
                            }
                        },
                        {
                            "text": "De <w>lucht</w> is vandaag strakblauw en er is geen wolkje te zien.",
                            "target_lang_translations": {
                                "en": "The <w>sky</w> is clear blue today and there isn't a cloud to be seen.",
                                "ru": "<w>Небо</w> сегодня ярко-синее, и не видно ни облачка.",
                                "pl": "<w>Niebo</w> jest dziś bezchmurne i nie widać ani jednej chmurki.",
                                "de": "Der <w>Himmel</w> ist heute strahlend blau und es ist kein Wölkchen zu sehen.",
                                "fr": "Le <w>ciel</w> est d'un bleu pur aujourd'hui et on ne voit pas le moindre nuage.",
                                "it": "Il <w>cielo</w> oggi è di un azzurro limpido e non si vede nemmeno una nuvola.",
                                "cs": "<w>Obloha</w> je dnes jasně modrá a není vidět ani mráček.",
                                "tr": "Bugün <w>gökyüzü</w> masmavi ve hiç bulut görünmüyor.",
                                "es": "El <w>cielo</w> está hoy completamente azul y no se ve ni una sola nube."
                            }
                        }
                    ],
                    "synonyms": [
                        "hemel"
                    ],
                    "common_phrases": [
                        "in de lucht",
                        "de lucht in",
                        "uit de lucht vallen"
                    ],
                    "target_lang_definitions": {
                        "en": "The space above the earth that you see when you look up, where clouds, the sun, and stars are located.",
                        "ru": "Пространство над землей, которое видно при взгляде вверх, где находятся облака, солнце и звезды.",
                        "pl": "Przestrzeń nad Ziemią widoczna po spojrzeniu w górę, gdzie znajdują się chmury, słońce i gwiazdy.",
                        "de": "Der Raum über der Erde, den man sieht, wenn man nach oben blickt, wo sich Wolken, die Sonne und Sterne befinden.",
                        "fr": "L'espace au-dessus de la Terre que l'on voit quand on regarde vers le haut, où se trouvent les nuages, le soleil et les étoiles.",
                        "it": "Lo spazio sopra la terra che si vede quando si guarda in alto, dove si trovano le nuvole, il sole e le stelle.",
                        "cs": "Prostor nad Zemí, který vidíte, když se podíváte nahoru, kde se nacházejí mraky, slunce a hvězdy.",
                        "tr": "Yukarı bakıldığında görülen, bulutların, güneşin ve yıldızların bulunduğu yer, gökyüzü.",
                        "es": "El espacio sobre la Tierra que se ve al mirar hacia arriba, donde están las nubes, el sol y las estrellas."
                    },
