                                "target_senses": [
                                    {
                                        "sense_id": "f101b26a-fd5b-39d3-92c1-d7887f4e21f6",
                                        "entry_id": "f72269d8-8c84-3a9d-b33e-4fe9b10843b4",
                                        "glosses": [
                                            "szczególny kunszt w robieniu czegoś"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc55655c-6884-4065-9ad6-e7a2d10390d1",
                                                "sense_id": "f101b26a-fd5b-39d3-92c1-d7887f4e21f6",
                                                "text": "Ci podobni są malarzom lub pisarzom wyrzekającym się wirtuozji; plemionom artystów które się modernizują; ludom wojennym podejmującym inicjatywę powszechnego rozbrojenia; rządom absolutnym które się demokratyzują, wyrzekając się twardych praw"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c3395d9-d022-4386-8ff0-4f12df896af5",
                        "source_entry_id": "3fbba8d0-fcd3-3c13-bcd7-26ca3928b52d",
                        "source_sense_description": "technical skills and fluent style of a virtuoso",
                        "target_lang_word": "виртуозность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "виртуозность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a3f0d527-f6a2-3e0f-b9bf-fc636ed478e9",
                                        "entry_id": "aef0b4b0-52a2-3f9e-8588-a1b630a4a9d9",
                                        "glosses": [
                                            "свойство по значению прил. виртуозный, высокое, отточенное мастерство"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dcc39b6-7b62-4b58-a11f-1ca75ed4c2d3",
                                                "sense_id": "a3f0d527-f6a2-3e0f-b9bf-fc636ed478e9",
                                                "text": "Исполняя произведения, пианист проявил виртуозность."
                                            },
                                            {
                                                "example_id": "1a98c6b2-9f1a-4f8b-ac1c-b62acbe5ab2c",
                                                "sense_id": "a3f0d527-f6a2-3e0f-b9bf-fc636ed478e9",
                                                "text": "Какая легкость, какое изящество, какая итальянская виртуозность и законченность в ее движениях!"
                                            },
                                            {
                                                "example_id": "26b3a6e2-62c7-4ede-9f9d-ef69ca60f788",
                                                "sense_id": "a3f0d527-f6a2-3e0f-b9bf-fc636ed478e9",
                                                "text": "Но в парусном деле он доходил до виртуозности."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
