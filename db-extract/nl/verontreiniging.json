                    {
                        "sense_id": "e35da0f8-2b64-342f-956a-9228ee8c9de5",
                        "entry_id": "2403541e-5f87-3ccc-919a-f4335d90aa3d",
                        "glosses": [
                            "een dermate ernstige vervuiling dat het leven van mensen en/of andere organismen in gevaar kan brengen"
