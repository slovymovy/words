                "senses": [
                    {
                        "sense_id": "f049a927-eb81-32ca-a2ce-bb48d155edc8",
                        "entry_id": "0695b818-28d0-3f50-a8b2-40fb0a0f8851",
                        "glosses": [
                            "Hauptanteil der in der Milch höherer Säugetiere enthaltenen Proteine"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d8ee609-56fe-4136-acfc-225a4fe7c198",
                                "sense_id": "f049a927-eb81-32ca-a2ce-bb48d155edc8",
                                "text": "Kaseine kommen in jeder Milch vor, egal von welchem Tier sie stammt und der Aufbau der Kaseine ist immer nahezu identisch."
                            },
                            {
                                "example_id": "d39ac027-91b5-402f-a727-034146394af8",
                                "sense_id": "f049a927-eb81-32ca-a2ce-bb48d155edc8",
                                "text": "Auch die Kaseine in der Muttermilch sind denen in Kuh- oder Schafsmilch sehr ähnlich."
                            },
                            {
                                "example_id": "9fa797e6-7d94-477e-86dd-c03849775f32",
                                "sense_id": "f049a927-eb81-32ca-a2ce-bb48d155edc8",
                                "text": "Für die Käsebereitung wird das Kasein, der mengenmäßig bedeutendste Anteil des Milcheiweißes, gebraucht."
                            },
                            {
                                "example_id": "f2ea4eb6-e258-488e-b510-244ffd3a46e3",
                                "sense_id": "f049a927-eb81-32ca-a2ce-bb48d155edc8",
                                "text": "Der größte Teil der Kaseine liegt als sogenannte Mizellenform vor, in der Kasein mit verschiedenen Ionen (Calcium, Phosphat, Magnesium, Citrat) kolloidal verbunden ist."
                            },
                            {
                                "example_id": "66c50ea9-fe89-40ea-96cd-b081594f2cbd",
                                "sense_id": "f049a927-eb81-32ca-a2ce-bb48d155edc8",
                                "text": "Chymosin als spezifisches Ferment zur Spaltung von Kasein ist jedoch nicht in der Lage, andere Proteine zu spalten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a28dc5c8-dc07-4d28-8bc2-cc07b38b3adf",
                        "source_entry_id": "0695b818-28d0-3f50-a8b2-40fb0a0f8851",
                        "source_sense_id": "f049a927-eb81-32ca-a2ce-bb48d155edc8",
                        "source_sense_description": "Hauptanteil der in der Milch höherer Säugetiere enthaltenen Proteine",
                        "target_lang_word": "casein",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "casein",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62136fdb-590d-3a61-92d9-b3ea15a109b2",
                                        "entry_id": "d85960f0-4148-3b67-85c1-4d65a3a098f9",
                                        "glosses": [
                                            "A protein present in both milk and in the seeds of leguminous plants"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6284fd9-4ea2-47ea-923b-e768df9a7bac",
                                                "sense_id": "62136fdb-590d-3a61-92d9-b3ea15a109b2",
                                                "text": "It’s the clumping nature of the caseins that makes possible most thickened milk products, from yogurt to cheese. The whey proteins play a more minor role; they influence the texture of casein curds, and stabilize the milk foams on specialty coffees."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95b7efe5-d6fd-449e-b37c-031edbb1eb58",
                        "source_entry_id": "0695b818-28d0-3f50-a8b2-40fb0a0f8851",
                        "source_sense_id": "f049a927-eb81-32ca-a2ce-bb48d155edc8",
                        "source_sense_description": "Hauptanteil der in der Milch höherer Säugetiere enthaltenen Proteine",
                        "target_lang_word": "caséine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caséine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "af3c7eaf-6839-34c4-98e6-5c7b45c46c8a",
                                        "entry_id": "5ca80328-cdad-3708-b583-7ecac0f6eb3e",
                                        "glosses": [
                                            "Substance albuminoïde blanche que contient le lait, partie en dissolution, partie en suspension."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "944d973f-0af0-468f-9f80-2b8f11aae5de",
                                                "sense_id": "af3c7eaf-6839-34c4-98e6-5c7b45c46c8a",
                                                "text": "Ces produits, appelés matières albuminoïdes ou substances protéiques, jouent un rôle essentiel dans le développement des êtres vivants : l’albumine de l’œuf, la fibrine du sang, la caséine du lait, le gluten de la farine appartiennent à ce groupe."
                                            },
                                            {
                                                "example_id": "af9d1042-a4a9-4ec1-a54c-4227abf451d0",
                                                "sense_id": "af3c7eaf-6839-34c4-98e6-5c7b45c46c8a",
                                                "text": "Soie de caséine."
                                            },
                                            {
                                                "example_id": "27f1ef74-b8f7-4d02-80c8-15dcaa87ff54",
                                                "sense_id": "af3c7eaf-6839-34c4-98e6-5c7b45c46c8a",
                                                "text": "On emploie comme matière la caséine du lait précipitée par la présure ou un acide."
                                            },
                                            {
                                                "example_id": "b99e23df-b426-4f63-b90d-3a74fdcda95d",
                                                "sense_id": "af3c7eaf-6839-34c4-98e6-5c7b45c46c8a",
                                                "text": "Extraite de la caillette de veau, la présure, en présence d’ions calcium coagule la caséine."
                                            },
                                            {
                                                "example_id": "386de4e1-02cb-49d8-a123-bdee9fc77546",
                                                "sense_id": "af3c7eaf-6839-34c4-98e6-5c7b45c46c8a",
                                                "text": "— la présure ou labferment surtout abondante dans l’estomac du nourrisson provoque la coagulation du lait. Le coagulum ainsi formé contient la caséine et les globules gras du lait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
