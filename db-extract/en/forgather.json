                        "form": "forgathered"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6631b27b-2745-3166-9ca9-f6b0562c19c0",
                        "entry_id": "147733c0-7519-3f33-99ab-3708536ed546",
                        "glosses": [
                            "To assemble or gather together in one place, to gather up; to congregate."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6dcaa28a-ae9a-4582-b228-ff568f0b81d8",
                                "sense_id": "6631b27b-2745-3166-9ca9-f6b0562c19c0",
                                "text": "Dean’s California—wild, sweaty, important, the land of lonely and exiled and eccentric lovers come to forgather like birds, and the land where everybody somehow looked like broken-down, handsome, decadent movie actors."
                            },
                            {
                                "example_id": "6d5d50e7-3d6c-4ae2-96f4-0afa30628424",
                                "sense_id": "6631b27b-2745-3166-9ca9-f6b0562c19c0",
                                "text": "“And she caught you?” “Not once, but twice.” [...] “Half-way under the dressing-table, were you?” “The second time. When we first forgathered, I was sitting on the floor with a chair round my neck.”"
                            },
                            {
                                "example_id": "37ab9131-bdf3-40b8-8a1d-6d97bb863b1f",
                                "sense_id": "6631b27b-2745-3166-9ca9-f6b0562c19c0",
                                "text": "“I can tell you where to find them,’ she said, ‘with a fair degree of certainty; they foregather almost every evening about this time at a rather disreputable old pub.’"
                            },
                            {
                                "example_id": "26244281-884d-4ef1-8327-41b145581a5c",
                                "sense_id": "6631b27b-2745-3166-9ca9-f6b0562c19c0",
                                "text": "They found themselves obliged to forgather in Perugia, where few of them wished to be – least of all the French cardinals who would have preferred not to be in Italy at all."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4265bf76-6dda-4037-ad84-3023e59cf84b",
                        "source_entry_id": "147733c0-7519-3f33-99ab-3708536ed546",
                        "source_sense_id": "6631b27b-2745-3166-9ca9-f6b0562c19c0",
                        "source_sense_description": "To assemble or gather together in one place",
                        "target_lang_word": "se réunir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "se réunir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0341bd22-2d2b-37b1-869e-5fc7beed7dcf",
                                        "entry_id": "d074a3a2-05a5-3803-abd0-03d002c980e8",
                                        "glosses": [
                                            "Définition manquante ou à compléter. (Ajouter)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "814fe1a3-fdd8-41da-9754-3d1360a2be00",
                                                "sense_id": "0341bd22-2d2b-37b1-869e-5fc7beed7dcf",
                                                "text": "Les chairs de la plaie se sont réunies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d616165b-1f60-343c-adde-4544256a250d",
                                        "entry_id": "d074a3a2-05a5-3803-abd0-03d002c980e8",
                                        "glosses": [
                                            "Définition manquante ou à compléter. (Ajouter)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff31dfb1-bb9e-42e2-a0c7-2849ae8fa50e",
                                                "sense_id": "d616165b-1f60-343c-adde-4544256a250d",
                                                "text": "Ils se sont réunis contre l’ennemi commun."
                                            },
                                            {
                                                "example_id": "8cc652e4-c919-4b8a-9df2-a9902e5cfc8f",
                                                "sense_id": "d616165b-1f60-343c-adde-4544256a250d",
                                                "text": "Ils se sont réunis sur ce point-là."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec8954e4-7ed9-3c96-ad5a-fa1b9ed1ded0",
                                        "entry_id": "d074a3a2-05a5-3803-abd0-03d002c980e8",
                                        "glosses": [
                                            "Définition manquante ou à compléter. (Ajouter)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe88a024-4860-49f9-b7b0-6bce0c3cfd40",
                                                "sense_id": "ec8954e4-7ed9-3c96-ad5a-fa1b9ed1ded0",
                                                "text": "Ils se réunirent sous un même chef."
                                            },
                                            {
                                                "example_id": "f19a22b6-aecd-4461-bbd1-51429cbc6c1a",
                                                "sense_id": "ec8954e4-7ed9-3c96-ad5a-fa1b9ed1ded0",
                                                "text": "Nous nous réunissons une fois par semaine, à tel endroit."
                                            },
                                            {
                                                "example_id": "a1bb0fb2-479e-44f8-b113-983378b0bcad",
                                                "sense_id": "ec8954e4-7ed9-3c96-ad5a-fa1b9ed1ded0",
                                                "text": "J’espère me réunir à lui pour le reste de mes jours."
                                            },
                                            {
                                                "example_id": "6074ad20-0bcc-4f68-b704-be21df3b91f5",
                                                "sense_id": "ec8954e4-7ed9-3c96-ad5a-fa1b9ed1ded0",
                                                "text": "Ces deux rivières se réunissent à tel endroit."
                                            },
                                            {
                                                "example_id": "5246576a-c0d0-4a8b-9ae3-58cbe59337f1",
                                                "sense_id": "ec8954e4-7ed9-3c96-ad5a-fa1b9ed1ded0",
                                                "text": "Tous les suffrages se sont réunis sur lui."
                                            },
                                            {
                                                "example_id": "0ffe5f60-b0bd-48c3-8eb8-8dd40c4b3c69",
                                                "sense_id": "ec8954e4-7ed9-3c96-ad5a-fa1b9ed1ded0",
                                                "text": "Tous les arts se réunissaient pour donner de l’éclat à ces fêtes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
