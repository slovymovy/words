    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "101d8825-17c4-3ef6-92a8-704b0ffd4540",
                    "sense_definition": "A cat",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Get that <w>mog</w> out of here!",
                            "target_lang_translations": {
                                "ru": "Убери этого <w>кошака</w> отсюда!"
                            }
                        },
                        {
                            "text": "The reputation of this <w>mog</w> was damaged after he was brought in to catch mice.",
                            "target_lang_translations": {
                                "ru": "Репутация этого <w>котяры</w> пострадала после того, как его наняли ловить мышей."
                            }
                        }
                    ],
                    "synonyms": [
                        "cat",
                        "feline"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal term for a cat, often used in British English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разговорное название кошки, часто используемое в британском английском."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кошак",
                                "target_lang_sense_clarification": "разговорное, пренебрежительное или фамильярное название кота"
                            },
                            {
                                "target_lang_word": "котяра",
                                "target_lang_sense_clarification": "увеличительное или фамильярное название кота"
                            }
                        ]
