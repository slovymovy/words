                        "source_sense_id": "94697e28-f149-3aa3-b7e8-4c581e1993f7",
                        "source_sense_description": "die heißesten Tage des Hochsommers im Zeitraum vom 23. Juli bis 23. August",
                        "target_lang_word": "dog days",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dog days",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e43a8946-1fa5-3108-9fd7-30286b065446",
                                        "entry_id": "ce752951-6d19-3cef-a44d-00e5a99a1660",
                                        "glosses": [
                                            "The days following the heliacal rising of Sirius, now in early August (Gregorian) at dates varying by latitude."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "plural",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "407cb61a-77cb-4864-b5d1-410b55b56952",
                                                "sense_id": "e43a8946-1fa5-3108-9fd7-30286b065446",
                                                "text": "... a sterre, wherof canicular or dogge days be named Dies caniculares."
                                            },
                                            {
                                                "example_id": "ddf089fe-9514-41f3-9ca4-cb61208903b8",
                                                "sense_id": "e43a8946-1fa5-3108-9fd7-30286b065446",
                                                "text": "Dog days bright and clear\nIndicate a good year;\nBut when accompanied by rain,\nWe hope for better times in vain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26082cd7-09f5-3a0b-b510-6386260f352f",
                                        "entry_id": "ce752951-6d19-3cef-a44d-00e5a99a1660",
                                        "glosses": [
                                            "The unpleasantly hot days of late summer."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9183ab40-5c5f-48c7-8748-27eed12415e1",
                                                "sense_id": "26082cd7-09f5-3a0b-b510-6386260f352f",
                                                "text": "Why ſhould thoſe Eteſian and Eaſterne winds blow cōtinually in ſome places, at ſet times, one way ſtill, in the dog dayes only: heere perpetuall drought, there dropping ſhowres; [...]"
                                            },
                                            {
                                                "example_id": "dfaaf133-10d2-4263-96cc-93e25490d36a",
                                                "sense_id": "26082cd7-09f5-3a0b-b510-6386260f352f",
                                                "text": "The dog days of August have often spelled trouble for the world economy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "226020e7-0099-3094-b3b0-359c08a58a38",
                                        "entry_id": "ce752951-6d19-3cef-a44d-00e5a99a1660",
                                        "glosses": [
                                            "Any similar period of inactivity, laziness, or stagnation."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f1c1939-440a-42e6-8900-cbb962e9c0f2",
                                                "sense_id": "226020e7-0099-3094-b3b0-359c08a58a38",
                                                "text": "The two-cassette miniseries, produced by Oliver Stone, arrives in early August, in time to stir the dog days of summer rentals."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c39950ea-adf0-4d74-a863-729fbb20ed41",
                        "source_entry_id": "2192f885-1e34-381e-8383-15d5321f86fe",
                        "source_sense_id": "94697e28-f149-3aa3-b7e8-4c581e1993f7",
                        "source_sense_description": "die heißesten Tage des Hochsommers im Zeitraum vom 23. Juli bis 23. August",
                        "target_lang_word": "canicule",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "canicule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1195f204-3998-380d-bc1e-03cae8803874",
                                        "entry_id": "c136d9cb-41fc-37b5-b5c3-ea7b4697c1b4",
                                        "glosses": [
                                            "Période prolongée de chaleur intense et inhabituelle, durant plusieurs jours consécutifs, généralement accompagnée de nuits chaudes, et susceptible d’avoir des impacts sanitaires, agricoles et environnementaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "551dbee5-ab9a-4e19-bfb0-693ec4d8b975",
                                                "sense_id": "1195f204-3998-380d-bc1e-03cae8803874",
                                                "text": "On n’a plus eu de canicule aussi grave depuis 1912."
                                            },
                                            {
                                                "example_id": "83398e69-3b5f-454d-9d2d-67ad0324d606",
                                                "sense_id": "1195f204-3998-380d-bc1e-03cae8803874",
                                                "text": "Il est vrai que nous étions en pleine canicule, saison pendant laquelle l’Espagne n’est plus guère qu’un vaste tas de cendre sans végétation ni verdure."
                                            },
                                            {
                                                "example_id": "3a20793f-867d-499b-86ab-f53aee67b9d4",
                                                "sense_id": "1195f204-3998-380d-bc1e-03cae8803874",
                                                "text": "Qui n’aime, aux jours de la canicule dans les bois, lorsque les geais criards se disputent la ramée et l’ombre, un lit de mousse et la feuille à l’envers du chêne?"
                                            },
                                            {
                                                "example_id": "8d945cdd-4288-49e5-b9bf-f763fbb1e3cc",
                                                "sense_id": "1195f204-3998-380d-bc1e-03cae8803874",
                                                "text": "Des pluies éparses ou violentes, des épisodes cévenols, une tornade en Corse : après la vague des canicules et des grands incendies, la France connaît un « retour à la normale » chaotique."
                                            },
                                            {
                                                "example_id": "827013d0-52a4-434b-91a8-28bfd1b72c83",
                                                "sense_id": "1195f204-3998-380d-bc1e-03cae8803874",
                                                "text": "Tous les jours, partout en Occident, les machines nous protègent du froid, de la canicule, de la faim, de la souffrance et de la maladie."
                                            },
                                            {
                                                "example_id": "bdeff997-3d7a-4145-bc77-91750b7b4c71",
                                                "sense_id": "1195f204-3998-380d-bc1e-03cae8803874",
                                                "text": "Cet été, votre mission, si vous l’acceptez : vous passer de la climatisation ! (...) Calorifique, elle est en partie responsable de la « surchauffe urbaine », en augmentant à elle seule de 1 °C à 1,5 °C la température en ville par rapport à celle de la campagne environnante – le différentiel total pouvant atteindre 8 °C en cas de canicule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af9c4c99-f2ca-38dd-9cbb-ed074857b33d",
                                        "entry_id": "c136d9cb-41fc-37b5-b5c3-ea7b4697c1b4",
                                        "glosses": [
                                            "Canicule marine; épisode de réchauffement anormal et prolongé de la surface des océans, perturbant les écosystèmes marins."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fab0c858-6d11-46ca-b2d4-2751c2589ba7",
                                                "sense_id": "af9c4c99-f2ca-38dd-9cbb-ed074857b33d",
                                                "text": "Plus de 90% de la chaleur produite en raison des gaz à effets de serre est absorbée par les océans, causant des canicules marines dévastatrices pour la vie aquatique et modifiant les conditions météorologiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
