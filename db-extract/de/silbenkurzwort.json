                "senses": [
                    {
                        "sense_id": "92b6a5a9-92cb-3b5d-9380-7d2fb5a298b4",
                        "entry_id": "9be0993d-eb84-320d-ba17-eb7821826fc2",
                        "glosses": [
                            "Kurzwort, das aus Silben(teilen) des Wortes besteht, aus dem es durch Kürzung hervorgegangen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b418ec3d-d40b-4de9-a492-745ecb589044",
                                "sense_id": "92b6a5a9-92cb-3b5d-9380-7d2fb5a298b4",
                                "text": "„Kripo“ (für „Kriminalpolizei“), umgangssprachliches „Fuzo“ (für „Fußgängerzone“) sind Beispiele für Silbenkurzwörter im Deutschen."
                            },
                            {
                                "example_id": "03befeec-4e73-4a1a-a825-516dbce15b5a",
                                "sense_id": "92b6a5a9-92cb-3b5d-9380-7d2fb5a298b4",
                                "text": "„Analog zu SCHIRMERS Terminus für die aus Initialen gebildeten Kurzwörter führt er - allerdings für die ganze zuletzt genannte Gruppe - als erster den Begriff Silbenkurzwörter ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
