        "fr-extract.jsonl": [
            {
                "entry_id": "bfa02b54-f0ff-3fa8-99f3-620713d046b8",
                "word": "télévangéliste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "94c88031-0b98-48f1-b552-9e5099203eaf",
                        "entry_id": "bfa02b54-f0ff-3fa8-99f3-620713d046b8",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "télévangélistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e93af487-f216-3d37-a55a-4e7e8f5c2e5d",
                        "entry_id": "bfa02b54-f0ff-3fa8-99f3-620713d046b8",
                        "glosses": [
                            "Prédicateur qui se sert de la télévision pour produire son message d’évangélisation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c675ab5-c61b-4c6d-8fa8-dbdd8762aa10",
                                "sense_id": "e93af487-f216-3d37-a55a-4e7e8f5c2e5d",
                                "text": "Le télévangéliste est l’un des prédicateurs les plus connus au monde. Son utilisation de la télévision, sa voix de stentor et ses prêches fougueux lui ont permis de faire renaître le mouvement évangéliste aux États-Unis."
                            },
                            {
                                "example_id": "4262a2ab-bb74-41db-968b-9f3948bfc461",
                                "sense_id": "e93af487-f216-3d37-a55a-4e7e8f5c2e5d",
                                "text": "Les télévangélistes américains, dont la croisade déborde les frontières des États-Unis, ne peuvent être ignorés : ils reflètent, en les amplifiant, les tendances profondes d’une partie de la société dont l’obscurantisme favorise les pires idées conservatrices."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "329f26da-a8ba-414c-a94f-544fcf7d215e",
                        "source_entry_id": "bfa02b54-f0ff-3fa8-99f3-620713d046b8",
                        "source_sense_id": "e93af487-f216-3d37-a55a-4e7e8f5c2e5d",
                        "target_lang_word": "Fernsehprediger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fernsehprediger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05e279c9-4ddf-3889-9da9-e4856a663003",
                                        "entry_id": "1abe2189-5db9-38f6-9305-b593d505cfe8",
                                        "glosses": [
                                            "Geistlicher, dessen religiöse Ansprache an die Gläubigen über das Medium Fernsehen verbreitet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d2e24d8-db51-4000-9ae2-f894224e549d",
                                                "sense_id": "05e279c9-4ddf-3889-9da9-e4856a663003",
                                                "text": "„Auf der anderen Seite versichern uns populäre Bücher und Fernsehprediger ständig, dass wir allein durch die Ausübung des Glaubens an Christus sofort von allem geheilt werden können.“"
                                            },
                                            {
                                                "example_id": "dd765da4-cf1e-4e91-885d-a8742ccf27f5",
                                                "sense_id": "05e279c9-4ddf-3889-9da9-e4856a663003",
                                                "text": "„Der amerikanische Fernsehprediger Andrew Wommack empfiehlt, sich das Ziel mit ‚positiver Imagination‘ so intensiv vorzustellen, als würden wir es sehen, als würden wir in dem Ergebnis leben.“"
                                            },
                                            {
                                                "example_id": "6b8ed69d-d0fe-471a-b297-a5b7a3185a53",
                                                "sense_id": "05e279c9-4ddf-3889-9da9-e4856a663003",
                                                "text": "„Es fiel mir schwer, mir vorzustellen, daß ich einem der berühmtesten Fernsehprediger der Vereinigten Staaten gegenüberstand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d88c5294-bddb-478e-8e60-535d86bc1248",
                        "source_entry_id": "bfa02b54-f0ff-3fa8-99f3-620713d046b8",
                        "source_sense_id": "e93af487-f216-3d37-a55a-4e7e8f5c2e5d",
                        "target_lang_word": "televangelist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "televangelist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "23125c84-d9e3-37c2-903f-9a739cf012d2",
                                        "entry_id": "20b3aec9-743d-3bb0-8472-12bedc3a4ee3",
                                        "glosses": [
                                            "A religious minister (often a Christian priest or minister) who devotes a large portion of his or her ministry to television broadcasts to a regular viewing audience."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "848e0a2a-6612-45d4-8522-c2a0a601d5b9",
                                                "sense_id": "23125c84-d9e3-37c2-903f-9a739cf012d2",
                                                "text": "Pastor Walton had spent several years learning from the televangelist host of Success-N-Life, Robert Tilton, at his Bible school in Texas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
