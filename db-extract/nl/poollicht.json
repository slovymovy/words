                    {
                        "sense_id": "ee218979-34fb-36ea-878e-f304fd306dc9",
                        "entry_id": "cdbaac44-bbb9-32a0-ad9e-1401d82330ba",
                        "glosses": [
                            "lichtverschijnsel aan de hemel in polaire streken als gevolg van de botsing van elektrisch geladen deeltjes van de zon met de bovenste aardatmosfeer"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01729150-4440-4775-9071-ec1a65550076",
                        "source_entry_id": "cdbaac44-bbb9-32a0-ad9e-1401d82330ba",
                        "source_sense_id": "ee218979-34fb-36ea-878e-f304fd306dc9",
                        "target_lang_word": "Polarlicht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Polarlicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f3f7b96e-b5f0-3d28-b326-f129bf88ee5f",
                                        "entry_id": "015632f5-6e99-32ba-babb-d4a673445f7b",
                                        "glosses": [
                                            "vor allem in den Polargebieten durch elektrisch geladene Teilchen in der oberen Atmosphäre entstehende Leuchterscheinung am Himmel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f48b540-7042-4a23-b7f8-e0184295890b",
                                                "sense_id": "f3f7b96e-b5f0-3d28-b326-f129bf88ee5f",
                                                "text": "Polarlichter sind in nördlicheren Breiten beobachtbar."
                                            },
                                            {
                                                "example_id": "5a57cf94-3d80-4b05-a24f-ad5384c57231",
                                                "sense_id": "f3f7b96e-b5f0-3d28-b326-f129bf88ee5f",
                                                "text": "„Während die Polarlichter, wie schon ihr Name sagt, an höhere Breiten gebunden sind und in den Tropen zu den größten Seltenheiten gehören, gibt es noch eine andere Leuchterscheinung am Nachthimmel, die der Sonne ihre Entstehung verdankt und in der Hochatmosphäre beheimatet ist.“"
                                            },
                                            {
                                                "example_id": "77cd945f-1643-46b3-9e53-b342955fc758",
                                                "sense_id": "f3f7b96e-b5f0-3d28-b326-f129bf88ee5f",
                                                "text": "„Auf Jupiter hingegen werden die Polarlichter durch Partikel und Gase verursacht, die die gewaltigen Vulkane des Jupiter-Mondes Io auswerfen.“"
                                            },
                                            {
                                                "example_id": "af186a61-1646-4159-9938-88334d47a110",
                                                "sense_id": "f3f7b96e-b5f0-3d28-b326-f129bf88ee5f",
                                                "text": "„Gegen 16 Uhr Greenwich-Zeit erreichte eine Schockwelle des Sonnenwindes den SOHO-Satelliten. Danach hat sich das übliche Verbreitungsgebiet des Polarlichtes, das so genannte Polarlichtoval, über 1000 Kilometer bis nach Dänemark und Norddeutschland ausgedehnt.“"
                                            },
                                            {
                                                "example_id": "b5e31fac-3d8a-4820-bee2-442cb23864ac",
                                                "sense_id": "f3f7b96e-b5f0-3d28-b326-f129bf88ee5f",
                                                "text": "«Der optische Effekt des Polarlichts entsteht, wenn Sonnenpartikel auf die Erdatmosphäre treffen.»"
                                            },
                                            {
                                                "example_id": "7b1cf8e5-3747-4332-93ca-d47f9b53e4e6",
                                                "sense_id": "f3f7b96e-b5f0-3d28-b326-f129bf88ee5f",
                                                "text": "„Heute abend war das Polarlicht zum ersten Mal zu sehen, stark genug, daß es sich noch gegen den Tag ausnahm.“"
                                            },
                                            {
                                                "example_id": "8cf582a8-bb0e-48a3-a0d4-470309ad7001",
                                                "sense_id": "f3f7b96e-b5f0-3d28-b326-f129bf88ee5f",
                                                "text": "„Heute wissen wir, den Polarlichtern wohnt nichts Schlechtes inne, sondern eine magische Anziehungskraft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "381c3e4c-2286-4153-87b6-ee0076dfb338",
