                    ]
                },
                {
                    "sense_id": "30a6e513-2f6f-31a8-9e1b-465e924cde9d",
                    "sense_definition": "A state of being unable to choose or decide between two or more options.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "feelings",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>ambivalence</w> regarding which car to buy meant he spent weeks visiting different dealerships."
                        },
                        {
                            "text": "The committee's <w>ambivalence</w> prevented them from reaching a final decision before the deadline."
