                                "ru": "Я <w>вполне</w> уверен, что мы выбрали правильную дорогу.",
                                "de": "Ich bin mir <w>einigermaßen</w> sicher, dass wir den richtigen Weg genommen haben.",
                                "pl": "Jestem <w>całkiem</w> pewien, że wybraliśmy właściwą drogę.",
                                "fr": "Je suis <w>plutôt</w> sûr que nous avons pris le bon chemin.",
                                "it": "Sono <w>abbastanza</w> sicuro che abbiamo preso la strada giusta.",
                                "cs": "Jsem si <w>celkem</w> jistý, že jsme zvolili správnou cestu.",
                                "tr": "Doğru yolu seçtiğimizden <w>oldukça</w> eminim.",
                                "es": "Estoy <w>bastante</w> seguro de que tomamos el camino correcto.",
                                "zh": "我<w>比较</w>确定我们走对了路。"
                            }
                        }
