{
    "word_family": [
        "reverberate",
        "reverberant",
        "reverberator",
        "reverberatory"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "763019bd-69e8-3d27-8b53-19907d1fcc1f",
                    "sense_definition": "An echo, or a series of overlapping echoes that prolongs a sound.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "acoustic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The loud <w>reverberation</w> of the church bells filled the entire square."
                        },
                        {
                            "text": "The strong <w>reverberation</w> of sound made it hard to understand the speaker."
                        }
                    ],
                    "synonyms": [
                        "echo",
                        "resonance"
                    ],
                    "common_phrases": [
                        "reverberation of sound"
                    ]
                },
                {
                    "sense_id": "569fbe6b-413d-3ec8-b4ca-045232af443f",
                    "sense_definition": "A continuing or evolving effect produced by a remarkable event; a repercussion.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "consequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The political <w>reverberations</w> of the scandal were felt for decades."
                        },
                        {
                            "text": "Economic <w>reverberations</w> across the continent caused widespread business failures."
                        }
                    ],
                    "synonyms": [
                        "repercussion",
                        "aftermath",
                        "consequence"
                    ],
                    "common_phrases": [
                        "political reverberations"
                    ]
                },
                {
                    "sense_id": "0a5e125f-a70f-32c3-8d9e-c03ef2ede391",
                    "sense_definition": "A rapid shaking motion or physical vibration.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt a sharp <w>reverberation</w> traveling through his arm when the hammer struck the metal."
                        },
                        {
                            "text": "The massive explosion caused a sudden <w>reverberation</w> through the ground."
                        }
                    ],
                    "synonyms": [
                        "vibration",
                        "tremor"
                    ]
                },
                {
                    "sense_id": "e5894f71-4021-3e97-b28c-27b52edec0b4",
                    "sense_definition": "The reflection or bouncing back of light or heat.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "reflection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The intense <w>reverberation</w> of heat from the desert sand made midday travel impossible."
                        },
                        {
                            "text": "A soft <w>reverberation</w> of light glanced off the surface of the mirrored walls."
                        }
                    ],
                    "synonyms": [
                        "reflection"
                    ],
                    "common_phrases": [
                        "reverberation of heat"
                    ]
                }
            ]
        }
    ]
}