        "fr-extract.jsonl": [
            {
                "entry_id": "6c5e0f61-b669-3a38-a06f-ea24c0191304",
                "word": "сбить",
                "pos": "verb",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ea300eef-a97a-3f06-9bf6-cebda4915a4c",
                        "entry_id": "6c5e0f61-b669-3a38-a06f-ea24c0191304",
                        "glosses": [
                            "Battre en neige (le beurre, les œufs…)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b495e19e-bea1-3934-a86e-9d84604c1177",
                        "entry_id": "6c5e0f61-b669-3a38-a06f-ea24c0191304",
                        "glosses": [
                            "Abattre, faire tomber."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f16ce27-aede-47d2-a207-58283490d609",
                                "sense_id": "b495e19e-bea1-3934-a86e-9d84604c1177",
                                "text": "Мальчик с необычайной ловкостью сбивал яблоки с развесистого дерева на землю, а сестра подбирала их.",
                                "translation": "Le garçon, avec une dextérité inhabituelle, fit tomber les pommes des branches de l’arbre sur le sol, et sa sœur les ramassa."
                            },
                            {
                                "example_id": "3db4c416-2d1f-42c0-ad7e-2c5b6029a347",
                                "sense_id": "b495e19e-bea1-3934-a86e-9d84604c1177",
                                "text": "Ученики топали ногами, стараясь сбить с валенок налипший снег.",
                                "translation": "Les élèves tapèrent des pieds pour tenter de faire tomber la neige de leurs bottes."
                            },
                            {
                                "example_id": "2ab8cd56-399b-4f34-a415-c74840f0b22d",
                                "sense_id": "b495e19e-bea1-3934-a86e-9d84604c1177",
                                "text": "Брат умел сбивать противника с ног неожиданным ударом.",
                                "translation": "Mon frère réussit à abattre son adversaire d’une manière inattendue."
                            }
                        ]
                    },
                    {
                        "sense_id": "db1b8940-7d63-3a01-ac8a-10fe39d11c9a",
                        "entry_id": "6c5e0f61-b669-3a38-a06f-ea24c0191304",
                        "glosses": [
                            "Forcer un objet volant (avion, oiseau…) à se poser au sol après l’avoir endommagé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d54e049-8e4f-4c8a-8eda-878e58f9b8d8",
                                "sense_id": "db1b8940-7d63-3a01-ac8a-10fe39d11c9a",
                                "text": "Охотникам нравилось сбивать уток на лету.",
                                "translation": "Les chasseurs ont aimé abattre les canards en vol."
                            },
                            {
                                "example_id": "a9ec6148-49de-4196-9e39-de73336d3624",
                                "sense_id": "db1b8940-7d63-3a01-ac8a-10fe39d11c9a",
                                "text": "За три дня боев наши летчики сбили 10 вражеских самолётов.",
                                "translation": "Au cours des trois jours de combat, nos aviateurs ont abattu dix avions ennemis."
                            }
                        ]
                    },
                    {
                        "sense_id": "a41c104c-f8d1-39a9-a077-055b3c7801e0",
                        "entry_id": "6c5e0f61-b669-3a38-a06f-ea24c0191304",
                        "glosses": [
                            "Faire tomber quelque chose en tapant dessus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d911c67d-7028-4976-bf25-2c58263f89bb",
                                "sense_id": "a41c104c-f8d1-39a9-a077-055b3c7801e0",
                                "text": "Мальчишки палками и камнями сбивали яблоки с деревьев и не убежали даже тогда, когда на другом конце сада показался сторож.",
                                "translation": "Les enfants firent tomber des pommes des arbres avec des bâtons et des pierres, et ne s’enfuirent même pas lorsque de l’autre côté du jardin apparut le gardien."
                            },
                            {
                                "example_id": "06464113-4608-40f7-9106-54a5143b2b9e",
                                "sense_id": "a41c104c-f8d1-39a9-a077-055b3c7801e0",
                                "text": "Грабители в черных масках несколькими ударами молотка сбили с двери замок и ворвались в склад.",
                                "translation": "Les voleurs en masques noirs défoncèrent la serrure à coups de marteau et firent irruption dans l’entrepôt."
                            }
                        ]
                    }
                ],
