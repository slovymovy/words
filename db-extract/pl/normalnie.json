                "forms": [],
                "senses": [
                    {
                        "sense_id": "2d8340aa-aa1e-3b1c-aba3-9503e4566a83",
                        "entry_id": "1270f953-fdeb-33a5-90dc-1f1dfc65e1dc",
                        "glosses": [
                            "w sposób normalny, standardowo"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6330cfc6-14b1-413b-b874-679eea9e36c0",
                                "sense_id": "2d8340aa-aa1e-3b1c-aba3-9503e4566a83",
                                "text": "Normalnie odbijają się od osłony kokpitu, choć chętnie zagłębiłyby się w twoim kombinezonie i bebechach, by wydostać się po drugiej stronie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70afee0c-73d2-4cea-9edf-6d8905e167f8",
                        "source_entry_id": "1270f953-fdeb-33a5-90dc-1f1dfc65e1dc",
                        "source_sense_id": "2d8340aa-aa1e-3b1c-aba3-9503e4566a83",
                        "target_lang_word": "normally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "normally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b02faa76-9ade-3661-a4bb-0ad6f0c52286",
                                        "entry_id": "f64fdb18-7ad0-3827-a380-5b1033bca31a",
                                        "glosses": [
                                            "Under normal conditions or circumstances; usually; most of the time"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10e54816-de05-48ce-91b9-26f4c11cb0e2",
                                                "sense_id": "b02faa76-9ade-3661-a4bb-0ad6f0c52286",
                                                "text": "Normally, I eat breakfast at 6am, but today, I got up late and didn't eat until 9."
                                            },
                                            {
                                                "example_id": "fda4d575-5679-42ff-9dde-f75a17734f60",
                                                "sense_id": "b02faa76-9ade-3661-a4bb-0ad6f0c52286",
                                                "text": "A normally bustling border crossing between Tanzania and Malawi was noticeably quieter than usual on Thursday as a result of an escalating regional trade row."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f819836e-ca94-357e-b1dc-05fc181f4350",
                                        "entry_id": "f64fdb18-7ad0-3827-a380-5b1033bca31a",
                                        "glosses": [
                                            "In the expected or customary manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f02addb5-a54b-42f7-885e-2bb2077c91e2",
                                                "sense_id": "f819836e-ca94-357e-b1dc-05fc181f4350",
                                                "text": "Lisa ate normally, until she realised that she was late for choir, when she sped up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87510a4d-a420-3db2-906d-c9a6f0cd5439",
                                        "entry_id": "f64fdb18-7ad0-3827-a380-5b1033bca31a",
                                        "glosses": [
                                            "To a usual or customary extent or degree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f342f29b-9e22-4d00-a09d-d0edcf42b869",
                                                "sense_id": "87510a4d-a420-3db2-906d-c9a6f0cd5439",
                                                "text": "He was abnormally agitated, she only normally so."
                                            },
                                            {
                                                "example_id": "ebf8f08f-64e8-4fe9-9963-6d2768665c02",
                                                "sense_id": "87510a4d-a420-3db2-906d-c9a6f0cd5439",
                                                "text": "An even more important reason is that our generation is not only normally ignorant but abnormally so. That is, we not only have scholars who do not know the history of the church's testimony, but we have those who tell it like it was not."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7702faa-1fcb-3703-87cc-710e64f779cf",
                                        "entry_id": "f64fdb18-7ad0-3827-a380-5b1033bca31a",
                                        "glosses": [
                                            "In the manner of a variable with a Gaussian distribution."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
