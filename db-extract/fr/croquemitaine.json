            {
                "entry_id": "c8b0fcbc-5780-35f8-a73c-b59a19c0b280",
                "word": "croquemitaine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a60b8caa-09da-4096-a70e-4f09ffdad46a",
                        "entry_id": "c8b0fcbc-5780-35f8-a73c-b59a19c0b280",
                        "tags": [
