    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1811ba37-a392-3dd9-a564-61f2fd365205",
                    "sense_definition": "voortdurend oplettend om mogelijk gevaar of onregelmatigheden op te merken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "oplettendheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politie vraagt burgers om <w>waakzaam</w> te blijven na de recente reeks inbraken.",
                            "target_lang_translations": {
                                "en": "The police are asking citizens to remain <w>vigilant</w> after the recent series of burglaries."
                            }
                        },
                        {
                            "text": "Die man bezit een <w>waakzame</w> hond die bij elk vreemd geluid aanslaat.",
                            "target_lang_translations": {
                                "en": "That man owns a <w>watchful</w> dog that barks at every strange sound."
                            }
                        }
                    ],
                    "synonyms": [
                        "alert",
                        "oplettend",
                        "wakend"
                    ],
                    "antonyms": [
                        "onoplettend",
                        "onachtzaam"
                    ],
                    "common_phrases": [
                        "waakzaam blijven",
                        "een waakzaam oog"
                    ],
                    "target_lang_definitions": {
                        "en": "constantly attentive to notice possible danger or irregularities"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vigilant",
                                "target_lang_sense_clarification": "keeping careful watch for possible danger"
                            },
                            {
                                "target_lang_word": "watchful",
                                "target_lang_sense_clarification": "fully observant and aware"
                            },
                            {
                                "target_lang_word": "alert",
                                "target_lang_sense_clarification": "quick to notice any unusual and potentially dangerous circumstances"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "f281624e-16ec-37d6-a49d-a3d73b391547",
                    "sense_definition": "op een manier die getuigt van grote oplettendheid en alertheid",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "oplettendheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Waakzaam</w> schoten mijn ogen alle kanten op, speurend naar verborgen slangen in het struikgewas.",
                            "target_lang_translations": {
                                "en": "My eyes darted in all directions <w>watchfully</w>, searching for hidden snakes in the bushes."
                            }
                        },
                        {
                            "text": "De beveiliger keek <w>waakzaam</w> rond terwijl de gasten het gebouw verlieten.",
                            "target_lang_translations": {
                                "en": "The security guard looked around <w>vigilantly</w> while the guests left the building."
                            }
                        }
                    ],
                    "synonyms": [
                        "alert",
                        "oplettend"
                    ],
                    "antonyms": [
                        "onoplettend"
                    ],
                    "common_phrases": [
                        "waakzaam rondkijken"
                    ],
                    "target_lang_definitions": {
                        "en": "in a manner that demonstrates great attentiveness and alertness"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "watchfully",
                                "target_lang_sense_clarification": "in a manner that is observant and aware"
                            },
                            {
                                "target_lang_word": "vigilantly",
                                "target_lang_sense_clarification": "in a way that keeps careful watch for danger"
                            }
                        ]
                    }
                }
            ]
        }
    ]
