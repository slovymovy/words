                        "glosses": [
                            "In a rakish manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2568b19-d097-4c9a-bdf2-478f6b4e6957",
                                "sense_id": "0f63725f-49a9-3a34-9229-51382a3ed9de",
                                "text": "The stair carpets are hanging on lines in the back garden, and Susanna, with her cap rakishly on one side, is always to be seen polishing the stair rods."
                            },
                            {
                                "example_id": "7ef2aa57-d2cf-4263-b708-c5f92377db9e",
                                "sense_id": "0f63725f-49a9-3a34-9229-51382a3ed9de",
                                "text": "Wearing a suit the colour of a London bus, a rakishly tilted flat cap and carrying a walking cane, he resembles an eccentric country squire out for a ramble: the Day Tripper."
                            }
                        ]
                    }
                ],
