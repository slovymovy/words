    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "66b7f7c4-de08-338f-914a-462ded9a85d5",
                    "sense_definition": "Acte de violence prémédité et illégal commis contre des personnes ou des biens, particulièrement dans un but politique ou criminel.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La police a réussi à déjouer un <w>attentat</w> terroriste qui menaçait le centre de la capitale."
                        },
                        {
                            "text": "Plusieurs témoins ont raconté les détails effrayants de l'<w>attentat</w> survenu hier matin."
                        }
                    ],
                    "synonyms": [
                        "attaque",
                        "agression"
                    ],
                    "common_phrases": [
                        "attentat terroriste",
                        "attentat à la bombe",
                        "déjouer un attentat",
                        "revendiquer un attentat"
                    ]
                },
                {
                    "sense_id": "43cb8389-a2be-383f-9089-12ae45589210",
                    "sense_definition": "Atteinte grave portée à des lois, à des droits fondamentaux ou à des principes établis.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle mesure arbitraire constitue un véritable <w>attentat</w> à la liberté d'expression."
                        },
                        {
                            "text": "Les juges ont condamné cet <w>attentat</w> contre les principes démocratiques du pays."
                        }
                    ],
                    "synonyms": [
                        "atteinte",
                        "violation",
                        "transgression"
                    ],
                    "antonyms": [
                        "respect"
                    ],
                    "common_phrases": [
                        "attentat aux libertés",
                        "attentat à la pudeur"
                    ]
                },
                {
                    "sense_id": "64360d91-7eba-3f61-995a-dafdb1e22edb",
                    "sense_definition": "Acte ou propos qui choque vivement les conventions, le bon sens, la morale ou les convenances esthétiques.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Selon ce critique culinaire réputé, mélanger ces ingrédients est un pur <w>attentat</w> au bon goût."
                        },
                        {
                            "text": "La démolition de ce monument historique représentait un véritable <w>attentat</w> contre le patrimoine local."
                        }
                    ],
                    "synonyms": [
                        "offense",
                        "injure"
                    ],
                    "common_phrases": [
                        "attentat au bon goût",
                        "attentat au bon sens"
                    ]
                }
            ]
        }
    ]
