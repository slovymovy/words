                    "frequency": "Middle",
                    "semantic_group_id": "importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle organisation du travail a permis de réaliser une économie <w>appréciable</w> de temps."
                        },
                        {
                            "text": "Le musée a reçu une somme <w>appréciable</w> de la part d'un donateur anonyme."
                        }
                    ],
                    "synonyms": [
                        "considérable",
                        "notable",
                        "substantiel"
                    ],
                    "antonyms": [
                        "insignifiant",
                        "négligeable"
                    ],
                    "common_phrases": [
                        "économie appréciable",
                        "somme appréciable",
                        "gain appréciable"
                    ]
                },
                {
                    "sense_id": "e34132f5-d206-3869-b914-ce04c27c7463",
                    "sense_definition": "Qui mérite d'être aimé, valorisé ou estimé ; qui est digne d'intérêt ou agréable.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "valeur_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa grande patience avec les enfants est une qualité <w>appréciable</w> dans son métier d'enseignant."
                        },
                        {
                            "text": "Le calme de cet hôtel en bord de mer constitue un atout <w>appréciable</w> pour les vacanciers."
                        }
                    ],
                    "synonyms": [
                        "estimable",
                        "louable"
                    ],
                    "antonyms": [
                        "méprisable"
                    ],
                    "common_phrases": [
                        "qualité appréciable",
                        "atout appréciable"
                    ]
                },
                {
                    "sense_id": "8ad5a9b2-cbb9-3e73-b14d-42eae47e5589",
                    "sense_definition": "Qui peut être perçu par les sens ou mesuré par des instruments scientifiques.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mesurable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le thermomètre n'a révélé aucune variation <w>appréciable</w> de la température pendant toute la nuit."
                        },
                        {
                            "text": "Cette infime quantité de produit chimique n'est pas <w>appréciable</w> avec notre matériel actuel."
