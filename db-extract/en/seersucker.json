    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "0f0518fb-0541-3c4f-ab03-af4db060848f",
                "word": "seersucker",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "00169ac4-020e-44ab-aa7d-52ff9dc1d8dc",
                        "entry_id": "0f0518fb-0541-3c4f-ab03-af4db060848f",
                        "tags": [
                            "plural"
                        ],
                        "form": "seersuckers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "997668e5-1c67-3098-96bf-38025afcf052",
                        "entry_id": "0f0518fb-0541-3c4f-ab03-af4db060848f",
                        "glosses": [
                            "A thin, all-cotton fabric, commonly striped, used to make clothing for summer wear."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "bd675f4d-1342-4466-ab4f-fdcb7eca288c",
                                "sense_id": "997668e5-1c67-3098-96bf-38025afcf052",
                                "text": "I saw merely a lank, commonplace, and simple-looking farmer, going about his chores in faded blue overalls, a seersucker shirt, and a straw hat of the kind that is called a \"cow's breakfast.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "df1cdcf0-4d6c-36ce-9f08-9e5443c4b353",
                        "entry_id": "0f0518fb-0541-3c4f-ab03-af4db060848f",
                        "glosses": [
                            "An article made from such fabric."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c907e38f-4785-45a7-90ce-db996b59a351",
                        "source_entry_id": "0f0518fb-0541-3c4f-ab03-af4db060848f",
                        "source_sense_description": "Translations",
                        "target_lang_word": "gestreept cloqué",
