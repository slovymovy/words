                                                "sense_id": "617c3093-053f-37d7-ab19-323bda66607b",
                                                "text": "I see the air benighted\nAnd all the dusking dales,\nAnd lamps in England lighted,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08d5c0ec-e0dc-3fed-bdfc-bc7b9171dd69",
                                        "entry_id": "cf714817-7b0e-364e-a829-7da1888df892",
