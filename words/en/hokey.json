                    "frequency": "Middle",
                    "semantic_group_id": "contrived_sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie was filled with <w>hokey</w> dialogue that made the audience laugh instead of cry."
                        },
                        {
                            "text": "She rolled her eyes at the <w>hokey</w> love song playing on the radio."
                        }
                    ],
                    "synonyms": [
                        "cheesy",
                        "kitschy"
                    ],
                    "common_phrases": [
                        "hokey dialogue",
                        "hokey movie"
                    ],
                    "traits": [
