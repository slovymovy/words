                                "target_lang_sense_clarification": "в армию"
                            },
                            {
                                "target_lang_word": "мобилизовать",
                                "target_lang_sense_clarification": "на службу"
                            },
                            {
                                "target_lang_word": "набирать",
                                "target_lang_sense_clarification": "в организацию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34db1f16-c0f5-378d-a518-28bdc78a7069",
                    "sense_definition": "To drive or cycle very closely behind another vehicle to use its air current to reduce wind resistance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cyclist began to <w>draft</w> behind the lead rider to save energy.",
                            "target_lang_translations": {
                                "ru": "Велосипедист начал <w>ехать в потоке</w> за лидером, чтобы сэкономить силы."
                            }
                        },
                        {
                            "text": "In racing, drivers often <w>draft</w> each other to gain more speed on the straightaway.",
                            "target_lang_translations": {
                                "ru": "В гонках водители часто <w>используют воздушный поток</w> друг друга, чтобы набрать скорость на прямой."
                            }
                        }
