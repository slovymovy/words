                    {
                        "sense_id": "1d53075d-7251-3523-bda9-671a06e742d1",
                        "entry_id": "2a4f6a95-99a9-3b3d-abce-61e12bb3a176",
                        "glosses": [
                            "Concierge."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "1ac2c59f-a509-482e-8832-cba7ed482935",
                                "sense_id": "1d53075d-7251-3523-bda9-671a06e742d1",
                                "text": "— On la connaît, la fesse du Midi. Des bignoles, ou des charcutières avec le nichon en gant de toilette."
                            },
                            {
                                "example_id": "f05eec73-7935-48a6-90ad-9443d0440b9d",
                                "sense_id": "1d53075d-7251-3523-bda9-671a06e742d1",
                                "text": "Trompe que fringuait un lardeusse beige et un Borsalino noir se détourna à la seconde alors qu’il se préparait à réclamer le cordon à la bignole de son immeuble."
                            },
                            {
                                "example_id": "6910e97f-5491-475e-b9dc-ef3fb9abd271",
                                "sense_id": "1d53075d-7251-3523-bda9-671a06e742d1",
                                "text": "Sous une pluie de frites\nHier soir la bignole s'est pointée\nEt comme elle voulait encaisser\nElle a été servie tout de suite."
                            },
                            {
                                "example_id": "676d4012-29c8-46bd-b668-c83df6443daf",
                                "sense_id": "1d53075d-7251-3523-bda9-671a06e742d1",
                                "text": "– Dis, c’est quoi, une bignole ? – Une concierge, tiens !"
                            }
                        ]
                    }
