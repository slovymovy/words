                "senses": [
                    {
                        "sense_id": "388ca651-f6ec-30fa-a9d6-2a0d801e875c",
                        "entry_id": "556d74ff-39d3-3fdf-bf16-d7653c5a53cd",
                        "glosses": [
                            "spezielle Form des Psychoterrors, bei dem ein Mensch einen anderen Menschen fortgesetzt und über einen längeren Zeitraum verfolgt, belästigt, bedrängt oder terrorisiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d791bd41-ee8c-48b4-9289-857289b84f00",
                                "sense_id": "388ca651-f6ec-30fa-a9d6-2a0d801e875c",
                                "text": "Andrea hat über ein Jahr Stalking erleiden müssen."
                            },
                            {
                                "example_id": "19b7fdc5-17e7-4d00-8485-d06f772255f7",
                                "sense_id": "388ca651-f6ec-30fa-a9d6-2a0d801e875c",
                                "text": "Seit 2007 steht Stalking unter Strafe."
                            },
                            {
                                "example_id": "6203ffe8-064c-41a2-b722-d2624b1a767c",
                                "sense_id": "388ca651-f6ec-30fa-a9d6-2a0d801e875c",
                                "text": "Die wissenschaftliche Befundlage zeigt auf, dass in den meisten Stalking-Fällen (in Deutschland wird Stalking als „Nachstellung“ bezeichnet: § 238 StGB) bereits vor dem Beginn des Nachstellens (Stalkings) eine Beziehung zwischen dem Nachstellenden und dem Opfer besteht (Albrecht, 2006, S. 204; Stadler, 2006, S. 18)."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
