                },
                {
                    "sense_id": "25bd5642-0a98-359e-a1cf-3b24daa1a453",
                    "sense_definition": "alternatieve vorm van <w>lieden</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mensen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In oude teksten spreekt men vaak over deze <w>luiden</w>.",
