                "senses": [
                    {
                        "sense_id": "2bd90767-b50e-3111-b1da-f8b65b84a4a2",
                        "entry_id": "d633db22-cd40-39ec-8c95-32259832dc07",
                        "glosses": [
                            "Geld (aus Schokolade), das zu Chanukka verschenkt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9255696c-577e-4364-96fe-fa0b916b9daa",
                                "sense_id": "2bd90767-b50e-3111-b1da-f8b65b84a4a2",
                                "text": "„Weniger wegen des berühmten Brauchs, Chanukkageld zu verschenken, und auch nicht wegen der alten Tradition, Leckereien mit reichlich Öl zuzubereiten, sondern wegen der Sehnsucht.“"
                            },
                            {
                                "example_id": "a0741cd4-4129-4f8f-bac6-07bb3ec0dab9",
                                "sense_id": "2bd90767-b50e-3111-b1da-f8b65b84a4a2",
                                "text": "„Alle Spieler müssen einen Einsatz – in der Regel Chanukkageld aus Schokolade – in die Mitte auf den Tisch legen und abwechselnd den Kreisel drehen.“"
                            },
                            {
                                "example_id": "3aba2756-3837-4cc6-a58c-09b6a366b68c",
                                "sense_id": "2bd90767-b50e-3111-b1da-f8b65b84a4a2",
                                "text": "„Dazu gehört traditionell das Essen von Pfannkuchen, die Kinder bekommen das sogenannte ‚Chanukkageld‘ und spielen besondere Spiele.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
