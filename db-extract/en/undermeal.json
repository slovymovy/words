                "senses": [
                    {
                        "sense_id": "217ba44d-54d5-3d6b-954a-8f66b519f874",
                        "entry_id": "cfdacbf7-48e9-3dff-aaef-792527cfd513",
                        "glosses": [
                            "Synonym of undern: originally terce and the morning, later (UK, dialectal, obsolete) noon and the early afternoon."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d55a88a4-5cb3-4aec-8426-5bff97ae124a",
                                "sense_id": "217ba44d-54d5-3d6b-954a-8f66b519f874",
                                "text": "By the time—he hath din'd at a taverne, and slept his undermeals at a bawdy-house, his purse is [empty]."
                            }
                        ]
                    },
                    {
                        "sense_id": "c9b38783-7499-3b08-9600-5bd391958254",
                        "entry_id": "cfdacbf7-48e9-3dff-aaef-792527cfd513",
                        "glosses": [
                            "Synonym of siesta: an afternoon nap."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "fb26e20b-cffa-4c22-a3dd-f4b18220f2e9",
                                "sense_id": "c9b38783-7499-3b08-9600-5bd391958254",
                                "text": "In a narrower limit than the forty years' undermeal of the seven sleepers."
                            }
                        ]
                    },
                    {
                        "sense_id": "f65be882-9ab7-3c61-aaab-b8623725131b",
                        "entry_id": "cfdacbf7-48e9-3dff-aaef-792527cfd513",
                        "glosses": [
                            "An afternoon meal or snack."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "ab725c73-d790-47ac-9db0-43ecc3be8241",
                                "sense_id": "f65be882-9ab7-3c61-aaab-b8623725131b",
                                "text": "Another great supper, or undermeal, was made ready for them, coming home from ditching and plowing."
                            },
                            {
                                "example_id": "85bd124c-60a6-4b6f-b5c6-3b83ec817cc5",
                                "sense_id": "f65be882-9ab7-3c61-aaab-b8623725131b",
                                "text": "I think I am furnished for [=with] Cather'ne pears, [enough] for one undermeal."
                            },
                            {
                                "example_id": "9e410925-55de-49e1-beeb-2f430f537542",
                                "sense_id": "f65be882-9ab7-3c61-aaab-b8623725131b",
                                "text": "Why should not thy soul have her due drinks, breakfasts, meals, undermeals, bevers, and aftermeals, as well as thy body?'"
                            }
                        ]
                    }
                ],
