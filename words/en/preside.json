{
    "word_family": [
        "president",
        "presidency",
        "presidential",
        "presider"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "00b299fa-09e4-3162-badc-4fbb87208fd4",
                    "sense_definition": "To act as the person in charge of a meeting, court, or formal organization.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "leadership",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge will <w>preside</w> over the high-profile trial starting next Monday morning.",
                            "target_lang_translations": {
                                "ru": "Судья будет <w>председательствовать</w> на этом громком процессе, который начнется в следующий понедельник утром."
                            }
                        },
                        {
                            "text": "It is a great honor to <w>preside</w> over a meeting with such distinguished guests.",
                            "target_lang_translations": {
                                "ru": "Это большая честь — <w>вести</w> собрание с такими почетными гостями."
                            }
                        }
                    ],
                    "common_phrases": [
                        "preside over a meeting",
                        "preside over a trial"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выступать в качестве лица, ответственного за проведение собрания, судебного процесса или официальной организации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "председательствовать",
                                "target_lang_sense_clarification": "на собрании или заседании"
                            },
                            {
                                "target_lang_word": "вести",
                                "target_lang_sense_clarification": "собрание или процесс"
                            },
                            {
                                "target_lang_word": "руководить",
                                "target_lang_sense_clarification": "судебным процессом или организацией"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dcc0fb88-2381-31ce-9688-82a2ae457e14",
                    "sense_definition": "To exercise authority, control, or supervision over a particular process or department.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "leadership",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager has <w>presided</w> over the department during a period of significant technological change.",
                            "target_lang_translations": {
                                "ru": "Менеджер <w>возглавлял</w> отдел в период значительных технологических перемен."
                            }
                        },
                        {
                            "text": "She was chosen to <w>preside</w> over the restructuring of the entire corporate division.",
                            "target_lang_translations": {
                                "ru": "Ее выбрали для того, чтобы <w>руководить</w> реструктуризацией всего корпоративного подразделения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "preside over a department",
                        "preside over changes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Осуществлять власть, контроль или надзор над определенным процессом или отделом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возглавлять",
                                "target_lang_sense_clarification": "отдел или процесс изменений"
                            },
                            {
                                "target_lang_word": "руководить",
                                "target_lang_sense_clarification": "подразделением или реструктуризацией"
                            },
                            {
                                "target_lang_word": "курировать",
                                "target_lang_sense_clarification": "процесс или направление"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5b86690-a4d5-3af2-b2b5-de133d11f780",
                    "sense_definition": "To be the featured solo performer or the primary musician in a performance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "performance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The famous organist will <w>preside</w> at the console for the evening's grand recital.",
                            "target_lang_translations": {
                                "ru": "Знаменитый органист будет <w>играть</w> за пультом во время вечернего торжественного концерта."
                            }
                        },
                        {
                            "text": "He was invited to <w>preside</w> at the piano during the annual winter gala.",
                            "target_lang_translations": {
                                "ru": "Его пригласили <w>исполнять</w> партию на фортепиано во время ежегодного зимнего гала-концерта."
                            }
                        }
                    ],
                    "common_phrases": [
                        "preside at the piano",
                        "preside at the organ"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used with 'at'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть главным сольным исполнителем или основным музыкантом во время выступления."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "играть",
                                "target_lang_sense_clarification": "в качестве главного исполнителя за инструментом"
                            },
                            {
                                "target_lang_word": "исполнять",
                                "target_lang_sense_clarification": "сольную партию за инструментом"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}