                    },
                    {
                        "translation_id": "8d902506-8ee7-4b2f-b351-7e7d5374634c",
                        "source_entry_id": "dc0b0732-8af3-30f1-b1f3-6a2c2e151d73",
                        "target_lang_word": "Einstein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einstein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5def0374-f17a-3e76-9dc5-58aeb5bbefca",
                                        "entry_id": "824a9e91-b544-37b2-a2a7-2975aaa43b04",
                                        "glosses": [
                                            "besonders intelligenter Mensch, Person, die eine Binsenweisheit sagt"
                                        ],
                                        "tags": [
                                            "auch ironisch gemeint",
                                            "und dann das Gegenteil"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcaf07bf-1ec9-420b-8f7b-e59feeb32f21",
                                                "sense_id": "5def0374-f17a-3e76-9dc5-58aeb5bbefca",
                                                "text": "Um das zu wissen, muss man kein Einstein sein."
                                            },
                                            {
                                                "example_id": "5d7e8964-c7c3-4c79-9083-9a09fcf2dcd2",
                                                "sense_id": "5def0374-f17a-3e76-9dc5-58aeb5bbefca",
                                                "text": "Das hätte Einstein nicht besser formulieren können."
                                            },
                                            {
                                                "example_id": "27c9b15c-88db-435c-84d5-b48521576336",
                                                "sense_id": "5def0374-f17a-3e76-9dc5-58aeb5bbefca",
                                                "text": "Einstein, der an „Spinozas Gott“ glaubte, war ein Pantheist."
                                            },
                                            {
                                                "example_id": "47333e5f-c9bf-4cae-9cda-f9035dfb9840",
                                                "sense_id": "5def0374-f17a-3e76-9dc5-58aeb5bbefca",
                                                "text": "Du bist ja auch nicht gerade ein Einstein."
                                            },
                                            {
                                                "example_id": "a31b6bbc-daf2-4e8f-bc73-453167e3af2c",
                                                "sense_id": "5def0374-f17a-3e76-9dc5-58aeb5bbefca",
                                                "text": "Na, was sagt denn unser Einstein dazu?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Einstein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95ef7daa-4b02-30e2-8406-02df824830cc",
                                        "entry_id": "1b7e0cf5-5f1a-3740-92cc-15de98f899d7",
                                        "glosses": [
                                            "Maßeinheit für die Anzahl von Photonen, entspricht einem Mol Photonen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be46361b-e1d9-4587-93ef-15ae2eb2b0b2",
                                                "sense_id": "95ef7daa-4b02-30e2-8406-02df824830cc",
                                                "text": "Bei vollständiger Ausbeute des einfallenden Sonnenlichtes […] werden zur Produktion eines Mol Sauerstoff 8 Einstein benötigt, d. h. acht Photonen pro Molekül."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Einstein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "41a6d64b-1984-3cd0-a1f0-77a58b136db2",
                                        "entry_id": "0a26b4be-665b-345d-839e-a3ba9071dc9e",
                                        "glosses": [
                                            "Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "baa7c766-13e0-40a4-a148-c5686d33c54d",
                                                "sense_id": "41a6d64b-1984-3cd0-a1f0-77a58b136db2",
                                                "text": "Frau Einstein ist nett."
                                            },
                                            {
                                                "example_id": "11166771-f4f0-43f1-96fd-4c7ecbff8f7b",
                                                "sense_id": "41a6d64b-1984-3cd0-a1f0-77a58b136db2",
                                                "text": "Einsteins haben uns heute Abend eingeladen."
                                            },
                                            {
                                                "example_id": "f5000431-d287-436e-9289-b6a685e4dae3",
                                                "sense_id": "41a6d64b-1984-3cd0-a1f0-77a58b136db2",
                                                "text": "Die Einsteins von nebenan spazieren zum Deich."
                                            },
                                            {
                                                "example_id": "098e6185-dc42-4142-80ff-ad8fed56b833",
                                                "sense_id": "41a6d64b-1984-3cd0-a1f0-77a58b136db2",
