                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5089c07-9d31-4c2e-87b8-56def04ddb93",
                                "sense_id": "3945ad88-eace-32f1-bc6d-5a6cdf2b2926",
                                "text": "Like many people of his generation, open homosexuality was not an option, and so his desires were limited to more furtive couplings and rechanneled into a whirlwind of frenzied political activity."
                            },
                            {
                                "example_id": "751b4e9e-3765-4266-bb06-a77c666aba23",
                                "sense_id": "3945ad88-eace-32f1-bc6d-5a6cdf2b2926",
                                "text": "I wondered how some of that compassion for a hawk could be rechanneled to help human beings like those I had just seen dying in Darfur."
                            }
                        ]
                    }
