                    {
                        "sense_id": "adf9d11e-ffac-36f4-bb72-37efd34a772f",
                        "entry_id": "31315400-e8a0-37ea-93bd-f9a83b52b895",
                        "glosses": [
                            "korte formulering, gebruikt als aansporing naar een groot aantal mensen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf6cab84-075e-4017-9015-e443936fa251",
                                "sense_id": "adf9d11e-ffac-36f4-bb72-37efd34a772f",
                                "text": "Op het spandoek van de vredesdemonstranten stond de leuze 'kernwapens de wereld uit te beginnen in Nederland'."
                            },
                            {
                                "example_id": "afa815e9-f883-4ab9-a613-468fca145b87",
                                "sense_id": "adf9d11e-ffac-36f4-bb72-37efd34a772f",
                                "text": "Eind jaren zeventig/begin jaren tachtig werd in Nederland massaal gedemonstreerd tegen de aanwezigheid van kernwapens. Dat gebeurde onder de leuze ‘Help de kernwapens de wereld uit, om te beginnen uit Nederland’."
                            }
                        ]
                    }
