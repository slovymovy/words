                    {
                        "sense_id": "a4b6b6de-104e-37b8-9940-8ed046f1b753",
                        "entry_id": "3c878fe9-e820-3323-b6d3-e0b87358cbec",
                        "glosses": [
                            "The state or quality of being revolutionary."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5e5b73bd-cf70-4986-91e1-65e9cb37dc4b",
                                "sense_id": "a4b6b6de-104e-37b8-9940-8ed046f1b753",
                                "text": "His environment and mode of life may have aligned him with the old order politically; but none can deny the revolutionariness of his method, of his criticism, the boldness of his rejections."
                            },
                            {
                                "example_id": "0aa59f0c-d0fd-4f6b-b6b0-1dfb8285406b",
                                "sense_id": "a4b6b6de-104e-37b8-9940-8ed046f1b753",
                                "text": "It also demonstrates the innovativeness and revolutionariness of Mallarme's approach which is here being put to work by Derrida."
                            },
                            {
                                "example_id": "9ee3aae1-e468-4c03-9404-94e6b50ca0a0",
                                "sense_id": "a4b6b6de-104e-37b8-9940-8ed046f1b753",
                                "text": "The revolutionariness of St. Francis's individualistic approach is especially evident in the historical context within which it developed."
                            }
                        ]
                    }
