        "ru-extract.jsonl": [
            {
                "entry_id": "3481be81-0fe7-3fc5-9d55-11cdc0fa3a6d",
                "word": "алея",
                "pos": "verb",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d16e25f0-9f71-37f7-9b93-5ad30d3bad2e",
                        "entry_id": "3481be81-0fe7-3fc5-9d55-11cdc0fa3a6d",
                        "glosses": [
                            "дееприч. от алеть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea98a539-60ad-445f-b64a-65617003de46",
                                "sense_id": "d16e25f0-9f71-37f7-9b93-5ad30d3bad2e",
                                "text": "Жители, пестрея одеждами, голубея, алея кафтанами, шли в церковь."
                            },
                            {
                                "example_id": "fb612f64-5b1c-4b53-ae60-1c5bc5341bbb",
                                "sense_id": "d16e25f0-9f71-37f7-9b93-5ad30d3bad2e",
                                "text": "Об этом не стоило бы упоминать, если бы Оля, алея от гордости и смущения, не призналась мужу о цветении новой жизни."
                            },
                            {
                                "example_id": "2b133e86-7b64-444d-99a1-797a431e4a8e",
                                "sense_id": "d16e25f0-9f71-37f7-9b93-5ad30d3bad2e",
                                "text": "Алая утренняя заря поднималась высоко, птицы уходили в неё, алея и розовея пером и превращаясь в чудную сказку ли, волшебный сон."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d41874fe-ee5d-499d-add0-2e3c1904e47b",
                        "source_entry_id": "3481be81-0fe7-3fc5-9d55-11cdc0fa3a6d",
                        "source_sense_id": "d16e25f0-9f71-37f7-9b93-5ad30d3bad2e",
                        "target_lang_word": "crimsoning",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crimsoning",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "848911ff-3947-390b-b532-2e766b15701b",
                                        "entry_id": "6cc5cd1a-ad5d-3b97-aad2-78bcd62b4c2d",
                                        "glosses": [
                                            "present participle and gerund of crimson"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63139da2-ac41-407a-9eed-05805da8348d",
                                                "sense_id": "848911ff-3947-390b-b532-2e766b15701b",
                                                "text": "Gray Wolf came to his side and licked his neck, where fresh blood was crimsoning his tawny hide."
                                            },
                                            {
                                                "example_id": "04c69fed-5e7a-4863-bef6-0ba9f465e804",
                                                "sense_id": "848911ff-3947-390b-b532-2e766b15701b",
                                                "text": "Her breaths were coming in a happy storm, her face crimsoning, her nostrils playing in trembling dilation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
