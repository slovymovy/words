                        "cross_references": [
                            {
                                "target_word": "Notation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c6c3e115-232e-358f-bab6-d704f7362121",
                                        "entry_id": "530a0ffd-b4d7-33d7-91fe-83aa58dcbbdb",
                                        "glosses": [
                                            "grafisches Festhalten von Tonhöhen, -dauern und -lautstärken in einer Notenschrift"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "812299c6-1266-4da3-9e09-43daad18504d",
                                                "sense_id": "c6c3e115-232e-358f-bab6-d704f7362121",
                                                "text": "Die Notation komplexer Musikstücke fällt Musikern oftmals schwer."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7cbc8ec1-5e79-32f0-83f3-762abba8ac41",
                                        "entry_id": "530a0ffd-b4d7-33d7-91fe-83aa58dcbbdb",
                                        "glosses": [
                                            "Festlegung der Reihenfolge, in der mathematische Ausdrücke aufgeschrieben und ausgewertet werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2479cfa1-887e-4c29-b07f-8d8a09994682",
                                                "sense_id": "7cbc8ec1-5e79-32f0-83f3-762abba8ac41",
                                                "text": "Man unterscheidet zwischen drei Notationen, der Präfix-, der Infix- und der Postfixnotationen"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c982941a-4b2a-3e43-b2de-348dc59f605f",
                                        "entry_id": "530a0ffd-b4d7-33d7-91fe-83aa58dcbbdb",
                                        "glosses": [
                                            "verkürzte Darstellung einer Klasse und (oder) von Relationen zwischen Klassen in Klassifikationssystemen"
                                        ],
                                        "tags": [
                                            "Dokumentation"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "de2781e4-7ef8-372a-bab0-34e345904da9",
                                        "entry_id": "530a0ffd-b4d7-33d7-91fe-83aa58dcbbdb",
                                        "glosses": [
                                            "das Aufzeichnen von Schachzügen"
                                        ],
                                        "tags": [
                                            "Schach"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "1b4f90da-cd61-3f26-be75-d6365d3e061a",
                                        "entry_id": "530a0ffd-b4d7-33d7-91fe-83aa58dcbbdb",
                                        "glosses": [
                                            "System von Zeichen und Symbolen, um sprachliche Gegebenheiten formalisiert wiederzugeben."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3ad5b6a-1d8a-4631-a2aa-8d9f02bdd2db",
                                                "sense_id": "1b4f90da-cd61-3f26-be75-d6365d3e061a",
                                                "text": "Die Linguistik kennt etliche Notationen wie z.B. die verschiedenen Klammern , um graphemische (<…>), morphologische ({…}), phonetische ([…]) und phonologische (/…/) Wiedergaben sprachlicher Einheiten anzuzeigen. Auch die phonetische Schrift ist eine Art von Notation."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
