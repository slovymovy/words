                        "examples": [
                            {
                                "example_id": "f1a3c4fa-8c80-4264-85f0-6a7bcd2bc9f3",
                                "sense_id": "b09cfd73-b84d-31fe-8d24-e8905ae441d4",
                                "text": "Il a rehenni, il a vivement secoué la tête, il s’est enfoncé dans le sous-bois. (rehennit corrigé en rehenni)"
                            },
                            {
                                "example_id": "69b3ca84-146b-4169-9a19-3d5c7de8c8dd",
                                "sense_id": "b09cfd73-b84d-31fe-8d24-e8905ae441d4",
                                "text": "Ange III semblait apprécier la petite séance en liberté car il ne faisait que trotter, galoper, hennir, retrotter, regaloper, rehennir, … (apprécié corrigé en apprécier)"
                            }
                        ]
