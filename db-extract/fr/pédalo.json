                        ],
                        "form": "pédalos"
                    },
                    {
                        "form_id": "cb344489-462b-4d30-8fc1-70a28116f3cc",
                        "entry_id": "e2e38348-ce14-336f-8a3b-bce7d72f2960",
                        "tags": [],
                        "form": "pédal’eau"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "201143a5-04af-3936-9878-10c5c435da7d",
                        "entry_id": "e2e38348-ce14-336f-8a3b-bce7d72f2960",
                        "glosses": [
                            "Bateau vélocipède constitué de flotteurs parallèles et de sièges pour pédaler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7555db28-5ee8-400d-af82-2b1530abcac5",
                                "sense_id": "201143a5-04af-3936-9878-10c5c435da7d",
                                "text": "Brigitte doit payer le trajet en pédalo, les garçons étant à bout de ressources."
                            },
                            {
                                "example_id": "bb2359ba-c94c-4f66-9a7b-c8f7970c6f0d",
                                "sense_id": "201143a5-04af-3936-9878-10c5c435da7d",
                                "text": "Les familles peuvent ainsi s'adonner aux activités traditionnelles des camps de vacances — tir à l’arc, escalade ou activités nautiques comme le canot ou le pédalo — mais aussi aux formules plus novatrices — chasses au trésor avec GPS, activités artistiques et culturelles."
                            },
                            {
                                "example_id": "513a64ba-ee9e-4522-96ca-6c980a4155af",
                                "sense_id": "201143a5-04af-3936-9878-10c5c435da7d",
                                "text": "Le pédalo présent en effet le tripla avantage, de nous éloigner de la foule et des galets brûlants, de nous donner la possibilité d’admirer la falaise avec un peu de recul, et enfin de faire de l’exercice."
                            },
                            {
                                "example_id": "331f0875-ff2f-49b1-8860-ec7bbf9faa4c",
                                "sense_id": "201143a5-04af-3936-9878-10c5c435da7d",
                                "text": "Nous finîmes par arriver à un lac immense entouré de collines et de tori pittoresques. On venait y faire de petites excursions en bateau ou en pédalo. Ce dernier détail me donna envie de rire. Hakone était la promenade des Tokyoïtes lamartiniens."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d272b3b9-8cc6-486f-85a4-e285a9f40abc",
                        "source_entry_id": "e2e38348-ce14-336f-8a3b-bce7d72f2960",
                        "source_sense_id": "201143a5-04af-3936-9878-10c5c435da7d",
                        "target_lang_word": "Tretboot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tretboot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "58fa0a7c-b5de-32b3-8ea3-5b8a3473073b",
                                        "entry_id": "bda6afb3-6634-39ea-91c8-af4c0b9d4ed6",
                                        "glosses": [
                                            "kleineres Boot für Vergnügungsfahrten mit einer Tretkurbel als Antriebsquelle"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "Germany"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7ce0f94-661d-45b4-a4d1-74c9736e71f4",
                                                "sense_id": "58fa0a7c-b5de-32b3-8ea3-5b8a3473073b",
                                                "text": "Am Strand werden Tretboote vermietet, mit denen man aufs Meer hinausfahren kann."
                                            },
                                            {
                                                "example_id": "691c4115-1ce7-4977-aeb3-4b41ba48abc4",
                                                "sense_id": "58fa0a7c-b5de-32b3-8ea3-5b8a3473073b",
                                                "text": "„Dann hat der See sein Gesicht verloren, Völkerscharen von Touristen treffen sich hier, drängeln sich an den Ufern und tummeln sich in einer Armada von Tretbooten, schlaff dahinkriechenden Jollen, Ruder- und Motorbooten auf dem Wasser – ein Heerlager der Erholung.“"
                                            },
                                            {
                                                "example_id": "20233698-d638-418a-ba5a-268b615ce717",
                                                "sense_id": "58fa0a7c-b5de-32b3-8ea3-5b8a3473073b",
                                                "text": "„Am selben Küstenabschnitt soll auch die Besatzung eines Tretbootes eine Kollision mit einem Haifisch gehabt haben.“"
                                            },
                                            {
                                                "example_id": "b6edc05a-660b-4211-bafe-880394616acd",
                                                "sense_id": "58fa0a7c-b5de-32b3-8ea3-5b8a3473073b",
                                                "text": "„Eck folgte ihr und lud sie nach wenigen Sätzen zu einer Fahrt mit dem Tretboot ein.“"
                                            },
                                            {
                                                "example_id": "422a4cd3-5ff1-41c3-97f4-94d98a2e9777",
                                                "sense_id": "58fa0a7c-b5de-32b3-8ea3-5b8a3473073b",
                                                "text": "„Er bestand darauf, voll zu zahlen. Flanierte ein Stück weit durch den Alsterpark, beschwingt, ohne die leidigen Schmerzen im Knie, weiße Wolken pulsierten am Himmel, Segler flitzten übers Wasser, Tretboote mühten sich vorwärts, dazwischen die Dampfer der Alsterflotte, ruhevolle Schwäne, Wasserhühner.“"
                                            },
                                            {
                                                "example_id": "7072b34a-59fa-4155-b30f-7439572aec1b",
                                                "sense_id": "58fa0a7c-b5de-32b3-8ea3-5b8a3473073b",
                                                "text": "„Er liebte die Wellen, die Muscheln, den Sand, das Essen im Hotel und die Fruchtsäfte. Er durfte Tretboot fahren. Er schloß Freundschaft mit Jungen aus anderen Ländern.“"
                                            },
                                            {
                                                "example_id": "0b981ddc-61e8-4275-8ec3-15a704f7047f",
                                                "sense_id": "58fa0a7c-b5de-32b3-8ea3-5b8a3473073b",
                                                "text": "„Das unglaublich türkisblaue Wasser plätschert sanft an den Rand des Tretboots, bis sich Mann und Töchter (laut quietschend) gegenseitig in die Fluten katapultieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90e80dc7-f834-4ee7-b656-f359b6c2eace",
                        "source_entry_id": "e2e38348-ce14-336f-8a3b-bce7d72f2960",
