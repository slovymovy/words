                ],
                "senses": [
                    {
                        "sense_id": "ca7650b0-125e-3808-970f-c00258ebe3ec",
                        "entry_id": "775059b8-4585-3e8b-a6bd-d444371f9c77",
                        "glosses": [
                            "Continuer de piquer, de tourmenter."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a103fd52-f4b3-3859-b032-d5af12f1dd13",
                        "entry_id": "775059b8-4585-3e8b-a6bd-d444371f9c77",
                        "glosses": [
                            "Cacher, envelopper, coudre (littéralement : refermer avec la pointe de l’aiguille)."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "2b005417-47a4-4a53-835e-da1d081a193d",
                                "sense_id": "a103fd52-f4b3-3859-b032-d5af12f1dd13",
                                "text": "Seront aussy tenus de faire une paire de souillers de veau gras ou demi graissé, ainsy qu'il plaira ausdits maîtres, où il y aura un talon de vieux cuir et repoindre par le devant."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb8af9a1-cfc9-3e89-a8ab-e0b3a02e6cec",
                        "entry_id": "775059b8-4585-3e8b-a6bd-d444371f9c77",
                        "glosses": [
                            "(sens actuel) Réapparaître."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "54e2adee-6961-4301-bf8b-a46f6cc56b0e",
                                "sense_id": "eb8af9a1-cfc9-3e89-a8ab-e0b3a02e6cec",
                                "text": "Bref, on voit repoindre ici ce « sujet » tant abhorré ; et une fois engagés sur ce chemin, il n’est pas impossible qu’on aille jusqu’à la substance matérielle, quantitative, que les dynamistes ont lâchée depuis Leibnitz."
                            }
                        ]
                    }
