                "senses": [
                    {
                        "sense_id": "3b56479b-9baa-30f2-a5b1-c6feff6e6d74",
                        "entry_id": "9e98168b-541f-31d3-a5cc-4b4037a32e8f",
                        "glosses": [
                            "in der Regel das älteste Mitglied einer neu gewählten Körperschaft, das traditionsgemäß bis zur Wahl des eigentlichen Präsidenten den Vorsitz der Körperschaft führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b87132f-5865-4830-863d-7638b51b4e13",
                                "sense_id": "3b56479b-9baa-30f2-a5b1-c6feff6e6d74",
                                "text": "„Sind Präsident und Stellvertreter gleichzeitig verhindert, so übernimmt der Alterspräsident die Leitung.“"
                            },
                            {
                                "example_id": "7e38478f-8807-4548-8c21-ff03e7e1180c",
                                "sense_id": "3b56479b-9baa-30f2-a5b1-c6feff6e6d74",
                                "text": "„Alterspräsidentin oder Alterspräsident im sich konstituierenden Rat ist dasjenige Mitglied des Rates, das die längste ununterbrochene Amtsdauer aufweist.“"
                            },
                            {
                                "example_id": "d3a63a69-473e-4d2a-bdd2-690fa5f21f90",
                                "sense_id": "3b56479b-9baa-30f2-a5b1-c6feff6e6d74",
                                "text": "[Eröffnung der konstituierenden Sitzung des 21. Bundestags am 25.03.2025:] „Eröffnet wird die konstituierende Sitzung durch Alterspräsident Gysi von der Linken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
