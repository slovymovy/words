                "senses": [
                    {
                        "sense_id": "e07cc41e-137f-39d6-9483-ec1c64753b45",
                        "entry_id": "01d7f62b-52af-307f-9271-f1a2f38756c5",
                        "glosses": [
                            "eigenständiger Gottesdienst zur Verkündigung des Wortes Gottes ohne Eucharistiefeier"
                        ],
                        "tags": [
                            "Katholizismus"
                        ],
                        "examples": [
                            {
                                "example_id": "7f0ddcdb-1abc-4d6f-a0ca-470634d3df90",
                                "sense_id": "e07cc41e-137f-39d6-9483-ec1c64753b45",
                                "text": "„Die Kirche kennt eine Vielfalt von Gottesdienstformen wie Eucharistiefeiern, Wortgottesfeiern, Stundengebet, Eucharistische Anbetung, Andachten, Rosenkranz und Segnungen.“"
                            },
                            {
                                "example_id": "f03e66dc-dd8b-4aae-a170-73364494c3e7",
                                "sense_id": "e07cc41e-137f-39d6-9483-ec1c64753b45",
                                "text": "„Am Anfang taten sich viele schwer damit, dass es nun Sonntage ohne Eucharistiefeier gab, aber dafür mit Wortgottesfeiern und Kommunionausteilung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
