                                        "entry_id": "3b61a963-eff5-379e-90b7-a5a596b69bb9",
                                        "glosses": [
                                            "Zellen oder Drüsenhaare, die eine zuckerhaltige Flüssigkeit ausscheiden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af6bb500-9026-4e82-8c57-b9857dac68fe",
