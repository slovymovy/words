                "senses": [
                    {
                        "sense_id": "5524175c-87d5-3679-b2c4-16a761057098",
                        "entry_id": "d35f6151-a118-3afa-b9e2-52f226030e0f",
                        "glosses": [
                            "aus der Antike übernommene Denkmal-Darstellungsform zur öffentlichen Ehrung einer Person als Reiter"
                        ],
                        "tags": [
                            "Bildende Kunst"
                        ],
                        "examples": [
                            {
                                "example_id": "a636ec97-30d2-46ea-b447-9a0babc10a09",
                                "sense_id": "5524175c-87d5-3679-b2c4-16a761057098",
                                "text": "Vor dem Hauptbahnhof in Hannover steht ein Reiterstandbild, das Ernst August I. darstellt."
                            },
                            {
                                "example_id": "8c27215c-a0b5-4a58-ac88-2afe667c46f5",
                                "sense_id": "5524175c-87d5-3679-b2c4-16a761057098",
                                "text": "„Finanziert von den deutschen Kriegervereinen und im Andenken an ihren verstorbenen Kriegsherrn errichtet, besteht das Denkmal aus einem 81 Meter hohen Turm, dem ein elf Meter hohes Reiterstandbild von Wilhelm I. vorgelagert ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
