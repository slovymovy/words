                                "target_word": "fassförmig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "173050ce-4b8a-30c1-b96e-a262795e28b2",
                                        "entry_id": "7b6a3b16-70c6-3c4a-af9e-7dac7c897f19",
                                        "glosses": [
                                            "die Form eines Fasses habend, wie ein Fass geformt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83c8f3f8-c3c6-48ae-9986-c65ef5498590",
                                                "sense_id": "173050ce-4b8a-30c1-b96e-a262795e28b2",
                                                "text": "„Orrendorf und Watkins, mit Lampe in der Höhle, fanden um 21:45 Uhr ungeheures, fassförmiges Fossil völlig unbekannter Art; vermutlich pflanzlich, falls nicht übergroßer Vertreter unbekannter Meereshohltiere.“"
                                            },
                                            {
                                                "example_id": "cb153170-e47e-4a8e-a94e-c3281b95bc5e",
                                                "sense_id": "173050ce-4b8a-30c1-b96e-a262795e28b2",
                                                "text": "„Der Mann mit dem fassförmigen Bauch musste natürlich der Gastwirt sein, was sonst?“"
                                            },
                                            {
                                                "example_id": "3b93e32c-668e-47ba-accf-97d2a322a6b3",
                                                "sense_id": "173050ce-4b8a-30c1-b96e-a262795e28b2",
                                                "text": "„Der fassförmige Brustkorb, die relativ schlanke Hüfte und die stämmigen Beine passten nicht recht zusammen.“"
                                            },
                                            {
                                                "example_id": "c7bf89ed-6f5d-4ca5-91e6-d7a64035565e",
                                                "sense_id": "173050ce-4b8a-30c1-b96e-a262795e28b2",
                                                "text": "„Trotz der Flüchtigkeit der Berührung zerfiel der untere Teil des fassförmigen Torsos samt Beinen, Händen und Unterarmen augenblicklich zu Staub.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
