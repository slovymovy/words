                        ]
                    },
                    {
                        "translation_id": "8710703d-8827-4b25-85de-7904baea5769",
                        "source_entry_id": "52ebc620-770e-37a4-abb7-164f903dec55",
                        "source_sense_id": "5f2adf02-db4c-367f-9836-bb21d4d4a4fa",
                        "target_lang_word": "Nicée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nicée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7abab66b-9841-37fe-ad8b-59bba735dc75",
                                        "entry_id": "c3f32096-d9ac-3948-a8ff-5347d2881b96",
                                        "glosses": [
                                            "Ville d’Anatolie, connue pour avoir été le siège de deux conciles chrétiens où a été adopté le symbole de Nicée, confession de foi chrétienne."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1794816-7a91-4891-8b6d-65efc8112688",
                                                "sense_id": "7abab66b-9841-37fe-ad8b-59bba735dc75",
                                                "text": "En mai, juin et juillet 325, à Nicée, les évêques, qui étaient sans doute près de trois cents, débattirent longuement, puis ils donnèrent très majoritairement raison à Alexandre et tort à Arius."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "698c409f-949f-3c10-a40b-6bcdee98204f",
                                        "entry_id": "c3f32096-d9ac-3948-a8ff-5347d2881b96",
                                        "glosses": [
                                            "Une des naïades de la mythologie grecque."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa6b448f-9c12-4669-8dd2-8128d372991f",
                        "source_entry_id": "52ebc620-770e-37a4-abb7-164f903dec55",
                        "source_sense_id": "5f2adf02-db4c-367f-9836-bb21d4d4a4fa",
                        "target_lang_word": "Νίκαια",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Νίκαια",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "565610a1-b5f7-3514-a8fa-f1370ecae9c5",
                                        "entry_id": "00b68dde-3901-3d2a-ad7b-485b8cdcf9aa",
                                        "glosses": [
                                            "πόλη της Βιθυνίας, το σημερινό Ιζνίκ"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ee8372b-c3f8-42a0-9c79-bb453b560e30",
                                                "sense_id": "565610a1-b5f7-3514-a8fa-f1370ecae9c5",
                                                "text": "※ Στις 24 Σεπτεμβρίου του 787 θα συγκληθεί στη Νίκαια της Βιθυνίας (στο σημερινό Ιζνίκ της Τουρκίας) η Ζ΄ Οικουμενική Σύνοδος της χριστιανικής Εκκλησίας, με πρωτοβουλία της 35χρονης αυτοκράτειρας Ειρήνης της Αθηναίας, η οποία ασκούσε την αντιβασιλεία στο Βυζάντιο ως επίτροπος του ανήλικου γιου της Κωνσταντίνου ΣΤ΄.",
                                                "translation": "Γεώργιος Σαρρής, Νίκαια Βιθυνίας: Η Οικουμενική Σύνοδος που έσωσε τις εικόνες από την καταστροφή, Έθνος, 12 Δεκεμβρίου 2019"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05b0e3c8-d5d6-32d6-8fbe-53f0649a8cea",
                                        "entry_id": "00b68dde-3901-3d2a-ad7b-485b8cdcf9aa",
                                        "glosses": [
                                            "ονομασία αρχαίων πόλεων"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba029705-4313-3005-89b4-fe2099bd2ab7",
                                        "entry_id": "00b68dde-3901-3d2a-ad7b-485b8cdcf9aa",
                                        "glosses": [
                                            "προάστιο του Πειραιά"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60632b9f-1041-44cd-a100-3129d7f8097c",
                                                "sense_id": "ba029705-4313-3005-89b4-fe2099bd2ab7",
                                                "text": "※ Πάω μια βόλτα στα παλιά, / στη Νίκαια, στην Κοκκινιά / θα πιω κρασί και θα μεθύσω, / στον Πειραιά θα ξενυχτήσω.",
                                                "translation": "Θέλω να γυρίσω στα παλιά, στίχοι: Νίκος Βουρλιώτης, μουσική: Τάκης Μπουγάς, Μιχάλης Παπαθανασίου, εκτέλεση: Γιώργος Μαζωνάκης, Goin' Through, 1999"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c4e8554-5c80-32e2-a7ed-e5a89ca790c6",
                                        "entry_id": "00b68dde-3901-3d2a-ad7b-485b8cdcf9aa",
                                        "glosses": [
                                            "οικισμός της Λάρισας"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e7614121-fdf1-3dd2-a585-d04d71f7171e",
                                        "entry_id": "00b68dde-3901-3d2a-ad7b-485b8cdcf9aa",
                                        "glosses": [
                                            "πόλη της Γαλλίας, αρχαία αποικία Ελλήνων"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d69aa28-f0e2-4ac8-8e70-033bf9fc7fd9",
                                                "sense_id": "e7614121-fdf1-3dd2-a585-d04d71f7171e",
                                                "text": "※ Από την place Masséna μπαίνουμε απευθείας στο πιο γραφικό κομμάτι της Νίκαιας, την παλιά πόλη με τα στενά παλιά σοκάκια, τα καφέ, τα εστιατόρια και τα ταβερνεία, που κάνουν τη διαφορά εξαιτίας της ονομαστής γαστρονομίας.",
                                                "translation": "Μαρία Τσαρδάκα-Αθανασίου, Νίκαια / Γαλλία: Θεατρική και κοσμοπολίτικη, Έθνος, 29 Σεπτεμβρίου 2014"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
