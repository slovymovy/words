    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d644606b-93ef-370c-9e4d-fbd17ac59cb7",
                    "sense_definition": "In bezit hebben; eigenaar zijn van iets.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "possession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <heb> een nieuwe fiets gekregen voor mijn verjaardag.",
                            "target_lang_translations": {
                                "en": "I <have> received a new bike for my birthday.",
                                "ru": "Я <получил> новый велосипед на день рождения.",
                                "fr": "J' <w>ai</w> reçu un nouveau vélo pour mon anniversaire."
                            }
                        },
                        {
                            "text": "Hebt u even tijd om mij te helpen?",
                            "target_lang_translations": {
                                "en": "Do you <have> a moment to help me?",
                                "ru": "У вас <есть> минутка, чтобы помочь мне?",
                                "fr": "<w>Avez</w>-vous un moment pour m'aider ?"
                            }
                        }
                    ],
                    "synonyms": [
                        "bezitten"
                    ],
                    "common_phrases": [
                        "tijd hebben",
                        "geld hebben",
                        "zin hebben"
                    ],
                    "target_lang_definitions": {
                        "en": "To possess; to be the owner of something.",
                        "ru": "Владеть чем-либо; быть собственником чего-либо.",
                        "fr": "Posséder ; être le propriétaire de quelque chose."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "have",
                                "target_lang_sense_clarification": "to possess or own"
                            },
                            {
                                "target_lang_word": "own",
                                "target_lang_sense_clarification": "to have legal possession of"
                            },
                            {
                                "target_lang_word": "possess",
                                "target_lang_sense_clarification": "formal: to have or own"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "иметь",
                                "target_lang_sense_clarification": "владеть или обладать"
                            },
                            {
                                "target_lang_word": "есть",
                                "target_lang_sense_clarification": "быть в наличии (в конструкции 'у меня есть')"
                            },
                            {
                                "target_lang_word": "владеть",
                                "target_lang_sense_clarification": "быть собственником"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "avoir",
                                "target_lang_sense_clarification": "posséder ou détenir"
                            },
                            {
                                "target_lang_word": "posséder",
                                "target_lang_sense_clarification": "être propriétaire de"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "59914ac9-f938-36a9-9c69-cc1d554f3c6b",
                    "sense_definition": "Hulpwerkwoord dat samen met een voltooid deelwoord de voltooide tijd vormt.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "auxiliary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <heb> het koekje al opgegeten.",
                            "target_lang_translations": {
                                "en": "I <have> already eaten the cookie.",
                                "ru": "Я уже <съел> печенье.",
                                "fr": "J' <w>ai</w> déjà mangé le biscuit."
                            }
                        },
                        {
                            "text": "Zij <hadden> hun auto net gewassen toen het begon te regenen.",
                            "target_lang_translations": {
                                "en": "They <had> just washed their car when it started raining.",
                                "ru": "Они только что <помыли> машину, когда пошел дождь.",
                                "fr": "Ils <w>avaient</w> juste lavé leur voiture quand il a commencé à pleuvoir."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "hulpwerkwoord"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Auxiliary verb used with a past participle to form the perfect tense.",
                        "ru": "Вспомогательный глагол, используемый с причастием прошедшего времени для образования совершенного времени.",
                        "fr": "Verbe auxiliaire utilisé avec un participe passé pour former un temps composé."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "have",
                                "target_lang_sense_clarification": "auxiliary verb"
                            }
                        ],
                        "ru": [],
                        "fr": [
                            {
                                "target_lang_word": "avoir",
                                "target_lang_sense_clarification": "auxiliaire de conjugaison"
                            },
                            {
                                "target_lang_word": "être",
                                "target_lang_sense_clarification": "auxiliaire de conjugaison pour certains verbes"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e2f2417-d029-39fb-94a1-7f36166d58fb",
                    "sense_definition": "Als onderdeel of eigenschap bevatten; bestaan uit.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "characteristics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een auto <heeft> vier wielen en een stuur.",
                            "target_lang_translations": {
                                "en": "A car <has> four wheels and a steering wheel.",
                                "ru": "У автомобиля <есть> четыре колеса и руль.",
                                "fr": "Une voiture <w>a</w> quatre roues et un volant."
                            }
                        },
                        {
                            "text": "Deze kamer <heeft> twee grote ramen.",
                            "target_lang_translations": {
                                "en": "This room <has> two large windows.",
                                "ru": "В этой комнате <есть> два больших окна.",
                                "fr": "Cette pièce <w>a</w> deux grandes fenêtres."
                            }
