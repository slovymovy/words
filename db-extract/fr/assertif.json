                        "entry_id": "2a75f981-0745-3587-9c9e-7f80f9e7aff3",
                        "glosses": [
                            "Qui a le caractère de l’assertion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9d57a17-19d2-47bd-9e36-6d5861d8010c",
                                "sense_id": "1a8f5f5e-fb73-389a-afb0-2837d637efd4",
                                "text": "Une proposition assertive."
                            }
                        ]
                    },
                    {
                        "sense_id": "498e786c-5832-3f4e-811c-6d61d1bff5ed",
                        "entry_id": "2a75f981-0745-3587-9c9e-7f80f9e7aff3",
                        "glosses": [
                            "Affirmatif, affirmé, qui s’affirme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72743210-6c78-496b-a814-f4df537c3d82",
                                "sense_id": "498e786c-5832-3f4e-811c-6d61d1bff5ed",
                                "text": "Pour le maître, être assertif, c’est intervenir à bon escient, en favorisant la réflexion et l’initiative de chacun de ses élèves, et en préservant un climat de classe fondé sur ce respect mutuel."
                            },
                            {
                                "example_id": "71bf738c-25f1-424b-b4b0-f879c3a649e5",
                                "sense_id": "498e786c-5832-3f4e-811c-6d61d1bff5ed",
                                "text": "Le registre émotionnel de la colère […] est tout à fait accepté quand il sert l’idée d’être assertif et dans l’action."
                            }
                        ]
                    }
                ],
