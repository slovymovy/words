                    {
                        "translation_id": "7d796181-80b4-4361-bdc8-b0d4817ab310",
                        "source_entry_id": "8b49b5b9-08fe-3eec-8f26-695857edd538",
                        "source_sense_id": "237bd3dc-b267-37ef-9c5e-642ee1dbd4be",
                        "target_lang_word": "Mosel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mosel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "93a79afb-1289-362a-844c-f58456a70603",
                                        "entry_id": "3adee324-5e52-3128-b33c-94dc2074c1e4",
                                        "glosses": [
                                            "linker Nebenfluss des Rheins; entspringt in den südlichen Vogesen, durchfließt die lothringische Stufenlandschaft, tritt bei Trier in das mittelrheinische Schiefergebirge ein, das sie mit Weinbergen tief einschneidet und mündet in Koblenz in den Rhein."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "323299bb-0789-4df6-b820-9094aea7a2a0",
                                                "sense_id": "93a79afb-1289-362a-844c-f58456a70603",
                                                "text": "Die Mosel fließt in Koblenz in den Rhein."
                                            },
                                            {
                                                "example_id": "f8273112-7fe1-40a2-a5cb-0db87de8f443",
                                                "sense_id": "93a79afb-1289-362a-844c-f58456a70603",
                                                "text": "An der Mosel gibt es viele Staustufen."
                                            },
                                            {
                                                "example_id": "7dd87dc9-f99e-4392-90fc-e7eb8e5ef319",
                                                "sense_id": "93a79afb-1289-362a-844c-f58456a70603",
                                                "text": "„Die Mosel liegt abseits, ihre Reize sind abseits.“"
                                            },
                                            {
                                                "example_id": "40ba8468-a129-43c8-8dce-92c1870ae601",
                                                "sense_id": "93a79afb-1289-362a-844c-f58456a70603",
                                                "text": "„Die Mosel ist erwacht aus der mittelalterlichen Abgeschlossenheit.“"
                                            },
                                            {
                                                "example_id": "43bf334c-d028-4fbf-b3c7-f14f8afd1d41",
                                                "sense_id": "93a79afb-1289-362a-844c-f58456a70603",
                                                "text": "„Das Wandern war also ganz einfach, denn wir brauchten überhaupt keine Karten, wir gingen einfach immer an der Mosel entlang, die Mosel war unser Reiseführer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Mosel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3ad7d337-0c9b-3917-8f41-55475a4107c3",
                                        "entry_id": "cb44fbea-d6af-37a0-96a1-11b477131e87",
                                        "glosses": [
                                            "Wein von der Mosel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43442ec9-31c3-414b-9967-7de90b952463",
                                                "sense_id": "3ad7d337-0c9b-3917-8f41-55475a4107c3",
                                                "text": "„Wernicke gießt den Rest des Mosels in die Gläser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52634f80-fcd1-491f-b21d-6d1ae4ab5971",
                        "source_entry_id": "8b49b5b9-08fe-3eec-8f26-695857edd538",
