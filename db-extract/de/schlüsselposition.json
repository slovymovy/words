                "senses": [
                    {
                        "sense_id": "b067f6a0-d663-34d9-8cd0-fb834e7eab52",
                        "entry_id": "b4cb04a3-5d52-33df-9580-644b9fc199e8",
                        "glosses": [
                            "wichtige, entscheidende Position"
