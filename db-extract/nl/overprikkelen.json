                        "examples": [
                            {
                                "example_id": "15864a7d-90a5-4dea-8057-76d2a84ac80e",
                                "sense_id": "8ae2f105-140c-31f9-a36a-634bdc865e91",
                                "text": "Daarna staat ze overprikkeld op de non-foodafdeling en weet niet meer wat ze moet kopen."
                            },
                            {
                                "example_id": "0ed67674-46a0-4a20-a341-a4ca3ac04d10",
                                "sense_id": "8ae2f105-140c-31f9-a36a-634bdc865e91",
                                "text": "De grote hoeveelheid media-aandacht helpt daar natuurlijk niet bij. Camera's, microfoons en alles wat daarbij komt kijken zullen de kinderen alleen maar meer overprikkelen. Houd die dus weg, stelt de deskundige."
                            }
                        ]
                    }
