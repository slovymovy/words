                "senses": [
                    {
                        "sense_id": "cc48597b-8515-3d11-bd86-08531b98cc3f",
                        "entry_id": "5e54748d-1f12-3c05-9fce-68eec6e9059f",
                        "glosses": [
                            "Position der Sonne am Himmel über einem Beobachtungsort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56c798b7-e1d8-41a4-a39c-025ec1e735ff",
                                "sense_id": "cc48597b-8515-3d11-bd86-08531b98cc3f",
                                "text": "„Diese Konvektionsregen reichen nämlich meist nicht so weit vom Äquator weg wie der Zenitstand der Sonne, d.h. bis zu den Wendekreisen, und außerdem hinken sie zeitlich um 1–2 Monate dem Sonnenstande nach.“"
                            },
                            {
                                "example_id": "d7aafa1a-3ade-4760-b09f-fb8fad99c386",
                                "sense_id": "cc48597b-8515-3d11-bd86-08531b98cc3f",
                                "text": "„Nach der Mahlzeit besah sich der Ingenieur den Sonnenstand und stellte seine Taschenuhr danach ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
