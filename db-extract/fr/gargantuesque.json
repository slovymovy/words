                "word": "gargantuesque",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "159831e4-51f8-4503-8339-619892ebf953",
                        "entry_id": "649685b7-c8a3-3230-a173-0ba9a4560ec1",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "gargantuesques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f9f57e5c-00c5-3eb2-9f05-41246843ab6e",
                        "entry_id": "649685b7-c8a3-3230-a173-0ba9a4560ec1",
                        "glosses": [
                            "Relatif à Gargantua."
                        ],
                        "tags": [
                            "literally"
                        ],
                        "examples": [
                            {
                                "example_id": "ff6df8f5-3813-47b8-a0e0-88ff8a189892",
                                "sense_id": "f9f57e5c-00c5-3eb2-9f05-41246843ab6e",
                                "text": "La légende gargantuesque, l’épopée gargantuesque."
                            }
                        ]
                    },
                    {
                        "sense_id": "c5132ad0-3700-30b9-b9de-41ba7e31fa39",
                        "entry_id": "649685b7-c8a3-3230-a173-0ba9a4560ec1",
                        "glosses": [
                            "Gigantesque, en très grande proportion."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b8d3f841-c2b6-4453-b870-614218c77b46",
                                "sense_id": "c5132ad0-3700-30b9-b9de-41ba7e31fa39",
                                "text": "Elle disposa sur la table plusieurs entrées d’un hors-d’œuvre gargantuesque : acras - sorte de beignets épicés –, mousses d'avocat agrémentées de lait de coco, le fameux boudin créole et pour finir, du féroce de morue à l’avocat."
                            },
                            {
                                "example_id": "ed6c9107-aac1-4cbb-8899-1e6bf90f9906",
                                "sense_id": "c5132ad0-3700-30b9-b9de-41ba7e31fa39",
                                "text": "Le nom de code du code source de Navigator était Mozilla: une référence à la taille gargantuesque du programme (30 millions de lignes de code) et à son héritage."
                            }
                        ]
                    },
                    {
                        "sense_id": "45c0efb5-4eac-3fa2-83d4-3fbaacc7b290",
                        "entry_id": "649685b7-c8a3-3230-a173-0ba9a4560ec1",
                        "glosses": [
                            "Volumineux, démesuré."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "ca0df65e-b196-4c39-8db1-a88bfd1941e2",
                                "sense_id": "45c0efb5-4eac-3fa2-83d4-3fbaacc7b290",
                                "text": "Un rire gargantuesque."
                            },
                            {
                                "example_id": "f9fcddae-fd55-479e-be9f-097d5b153266",
                                "sense_id": "45c0efb5-4eac-3fa2-83d4-3fbaacc7b290",
                                "text": "Puis, c’est elle qu’on embarque, sa silhouette gargantuesque qui fait grincer les essieux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49b24dda-a72d-4857-a29e-78da7cfabf91",
                        "source_entry_id": "649685b7-c8a3-3230-a173-0ba9a4560ec1",
                        "target_lang_word": "gargantuan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gargantuan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "675036a1-5be8-3cc5-88a6-7ea45b4d91d8",
                                        "entry_id": "bd747d26-2441-3ddf-8ef1-0983eee28b2f",
                                        "glosses": [
                                            "Huge; immense; tremendous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1ac3bd8-4bbe-4af4-920e-53c84fc16ef7",
                                                "sense_id": "675036a1-5be8-3cc5-88a6-7ea45b4d91d8",
                                                "text": "Or the twinkling dining rooms: all frilly net curtains, pink walls, kaleidoscope-patterned carpets and tiny tables, crammed with teetering piles of hand-painted ceramic crockery (think plates covered in colorful swirls and cocktail mugs shaped like heaving bosoms or ladies’ faces) that showcase gargantuan portions of Italian fare."
                                            },
                                            {
                                                "example_id": "d7cf791c-1d3f-4a26-b77a-6e91b1415ce5",
                                                "sense_id": "675036a1-5be8-3cc5-88a6-7ea45b4d91d8",
                                                "text": "Some distant observers of the Scottish football scene reckon that all - all! - Gerrard has to do is beat Celtic to become a legend. Even if that was true - and, demonstrably, it is not - then it would be a gargantuan task all on its own."
                                            },
                                            {
                                                "example_id": "be61aaee-cf64-49fe-9ab9-9aced52ba1c2",
                                                "sense_id": "675036a1-5be8-3cc5-88a6-7ea45b4d91d8",
                                                "text": "Boxy and unrefined, the Hummer embodied an outlandishly masculine aesthetic that seemed to almost revel in its gargantuan fuel consumption."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a605181-5fde-3796-8bd3-7bff8e72f5f9",
                                        "entry_id": "bd747d26-2441-3ddf-8ef1-0983eee28b2f",
                                        "glosses": [
                                            "Of the giant Gargantua or his appetite."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
