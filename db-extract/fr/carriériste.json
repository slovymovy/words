                "forms": [
                    {
                        "form_id": "1b43a7d7-9e08-4050-b04a-603fc04b0db1",
                        "entry_id": "a69125ff-01df-3cba-8d76-2a6503b195b8",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "carriéristes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4643e87e-720c-3f7d-add7-f714ae6a2f75",
                        "entry_id": "a69125ff-01df-3cba-8d76-2a6503b195b8",
                        "glosses": [
                            "Celui qui ne travaille qu’à sa propre promotion sans souci particulier pour sa mission ou le bien de son entreprise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "969f9719-f175-4513-8689-0b2cad3a701e",
                                "sense_id": "4643e87e-720c-3f7d-add7-f714ae6a2f75",
                                "text": "Nus publiions des romans à l’eau de rose dont les héroïnes carriéristes cherchaient désespérément le grand amour."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4104a40b-eddc-46c3-9c2c-e383e96a3250",
                        "source_entry_id": "a69125ff-01df-3cba-8d76-2a6503b195b8",
                        "source_sense_id": "4643e87e-720c-3f7d-add7-f714ae6a2f75",
                        "target_lang_word": "careerist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "careerist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab20e96a-8645-3c1c-ae3e-8a6df222e115",
                                        "entry_id": "35631642-6b25-3021-9c11-5e7822b2d33d",
                                        "glosses": [
                                            "A person who pursues the advancement of their career at the expense of other values."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efa69441-b8c0-4d99-af92-d1c36013dbe6",
                                                "sense_id": "ab20e96a-8645-3c1c-ae3e-8a6df222e115",
                                                "text": "A careerist is a square-filler, a time-server. His talents and imagination have been circumscribed to perform managerial duties."
                                            },
                                            {
                                                "example_id": "0615bbd7-e902-4d2e-bb9f-669b1d760143",
                                                "sense_id": "ab20e96a-8645-3c1c-ae3e-8a6df222e115",
                                                "text": "Liu Hsin's famous jibe seems to have been directed not against Yang Hsiung but against the intellectual limitations of contemporary careerists. […] Yang's writings and personal character did not appeal to the careerists of his time"
                                            },
                                            {
                                                "example_id": "b4424adf-53eb-4e08-ba21-4a0db1474846",
                                                "sense_id": "ab20e96a-8645-3c1c-ae3e-8a6df222e115",
                                                "text": "You’ve got a lot of elite careerist women in the officer corps who have a certain set of desires usually related to their career."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b99f188a-849e-328a-a324-6ba11fa28cef",
                                        "entry_id": "35631642-6b25-3021-9c11-5e7822b2d33d",
                                        "glosses": [
                                            "A person who takes a job, especially in the military, for a long time rather than temporarily."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "careerist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "60428dc0-01cc-3027-9d1a-e2171fcde092",
                                        "entry_id": "8cd7bd94-c922-3714-818f-adf161334e3a",
                                        "glosses": [
                                            "Of or pertaining to such a person or way of life"
                                        ],
                                        "tags": [],
