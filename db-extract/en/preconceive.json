                                        "examples": [
                                            {
                                                "example_id": "dc5a4fae-4a8c-4017-85a0-6f7b179ad3c6",
                                                "sense_id": "378c2431-f9df-3b6f-9b53-096b83ed6ad6",
                                                "text": "Bedenke die Folgen!"
                                            },
                                            {
                                                "example_id": "030d1baa-3397-4965-a949-d473d0697530",
                                                "sense_id": "378c2431-f9df-3b6f-9b53-096b83ed6ad6",
                                                "text": "„Man muss bedenken, welche Sanktionen Abweichlern von der Linie des Nationalsozialismus drohten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "386ad201-1639-3047-b81b-f840799daec1",
                                        "entry_id": "ac26e0b4-a658-32f1-8874-7a16170648cb",
                                        "glosses": [
                                            "jemandem etwas zukommen lassen, jemandem etwas schenken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fa56f8d-87cf-41e2-85d3-40591a59be08",
                                                "sense_id": "386ad201-1639-3047-b81b-f840799daec1",
                                                "text": "Wir müssen auch unsere Freunde ausreichend bedenken."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2f5ed0d7-6873-36e1-8a37-55b907620a64",
                                        "entry_id": "ac26e0b4-a658-32f1-8874-7a16170648cb",
                                        "glosses": [
                                            "etwas für sich überlegen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fc549fb-22d1-432b-9eab-c5ecc8d36433",
                                                "sense_id": "2f5ed0d7-6873-36e1-8a37-55b907620a64",
                                                "text": "Über diese Sache muss ich mich noch etwas bedenken."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2297e53f-f062-4854-be6f-86e26fee88e0",
                        "source_entry_id": "2aaefa93-55f8-3410-b00d-46255cabcea0",
                        "source_sense_id": "1634065f-60a5-3b84-a08c-477084bbc298",
                        "source_sense_description": "ein Vorurteil formen, sich eine Meinung im Voraus bilden",
                        "target_lang_word": "vorverurteilen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vorverurteilen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ed60d279-6ede-3bf5-b7b9-8c45d4bf503b",
                                        "entry_id": "ec5c6bff-753d-3781-8420-a47348c6ee73",
                                        "glosses": [
                                            "eine (private/inoffizielle) Schlussfolgerung akzeptieren, bevor alle Tatsachen bekannt sind oder bevor ein (offizielles) Urteil gefallen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c7bd000-8565-48fe-a2c8-c6fdaf7087b3",
                                                "sense_id": "ed60d279-6ede-3bf5-b7b9-8c45d4bf503b",
                                                "text": "„Hier müssen Verantwortlichkeiten benannt werden, ohne vorzuverurteilen, aber auch ohne die vorschnelle Entlassung aus der Verantwortung in die Anonymität eigengesetzlicher Strukturen zuzulassen.“"
                                            },
                                            {
                                                "example_id": "1de462f1-3653-402f-99b2-2b7bedfd1cb5",
                                                "sense_id": "ed60d279-6ede-3bf5-b7b9-8c45d4bf503b",
                                                "text": "Die Medien verbreiteten, obwohl die Aussagen der Zeugen noch gar nicht aufgenommen waren, Falschmeldungen und vorverurteilten ihn somit öffentlich."
                                            },
                                            {
                                                "example_id": "4e1d3c6c-d2e2-487c-8812-8978733eb6fc",
                                                "sense_id": "ed60d279-6ede-3bf5-b7b9-8c45d4bf503b",
                                                "text": "Meine Beurteilungen zeigten stets, dass ich zielorientiert arbeiten kann, laut der Beurteilungen liegt meine Begabung im Vermitteln und ich vorverurteile nicht."
                                            },
                                            {
                                                "example_id": "bcf10f74-3ff0-4b36-a55f-1f88793f1a7e",
                                                "sense_id": "ed60d279-6ede-3bf5-b7b9-8c45d4bf503b",
                                                "text": "„[…] Du vorverurteilst die Leute immer noch, ohne mit ihnen jemals ein Wort gewechselt zu haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
