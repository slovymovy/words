                {
                    "sense_id": "4644620c-cd14-3b74-9af5-744c5c633fc6",
                    "sense_definition": "Een groot stuk steen of een brok gesteente.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "steen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er ligt een grote <w>kei</w> in de tuin als decoratie.",
                            "target_lang_translations": {
                                "en": "There is a large <w>rock</w> in the garden as decoration.",
                                "ru": "В саду в качестве украшения лежит большой <w>валун</w>."
                            }
                        },
                        {
                            "text": "De wandelaar struikelde over een losliggende <w>kei</w> op het pad.",
                            "target_lang_translations": {
                                "en": "The hiker tripped over a loose <w>stone</w> on the path.",
                                "ru": "Пешеход споткнулся о лежащий на тропе <w>камень</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "grote kei",
                        "gladde kei"
                    ],
                    "target_lang_definitions": {
                        "en": "A large piece of stone or a chunk of rock.",
                        "ru": "Большой кусок камня или обломок горной породы."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rock",
                                "target_lang_sense_clarification": "a large piece of stone"
                            },
