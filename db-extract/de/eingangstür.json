                ],
                "senses": [
                    {
                        "sense_id": "0948ea67-e597-3510-a695-93bfbc8ad6ee",
                        "entry_id": "82801f5a-2fba-3c0a-a6ea-edabd5186160",
                        "glosses": [
                            "Tür, durch die ein Gebäude hauptsächlich betreten werden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c8eff8c-539f-4ab0-887f-06c72c48cff1",
                                "sense_id": "0948ea67-e597-3510-a695-93bfbc8ad6ee",
                                "text": "An der Eingangstür hing ein selbst gebastelter Kranz."
                            },
                            {
                                "example_id": "fc5982b3-289c-4865-8026-6a2e236f1a27",
                                "sense_id": "0948ea67-e597-3510-a695-93bfbc8ad6ee",
                                "text": "Der Besuch klingelte an der Eingangstür und wurde hereingelassen."
                            },
                            {
                                "example_id": "293a584e-53a3-47a0-a9c1-dc0747ace2aa",
                                "sense_id": "0948ea67-e597-3510-a695-93bfbc8ad6ee",
                                "text": "Als die Familie Schmidt nach Hause kaum, sahen sie, dass die Eingangstür aufgebrochen war."
                            },
                            {
                                "example_id": "d119af78-269a-46af-a189-af2379880db4",
                                "sense_id": "0948ea67-e597-3510-a695-93bfbc8ad6ee",
                                "text": "„Sie wies auf die Kartons und Plastiksäcke, die sich vor der Küche türmten und die Eingangstür halb verstellten."
                            },
                            {
                                "example_id": "c466818e-8b7e-464e-88d8-4477703540c7",
                                "sense_id": "0948ea67-e597-3510-a695-93bfbc8ad6ee",
                                "text": "„Am Portal des gründerzeitlichen Eckhauses beißt sich ein blauer Schriftzug sehr schön mit dem giftigen Grün der Eingangstür.“"
                            },
                            {
                                "example_id": "c0ea3eb7-f03f-4336-88ce-e7847c737a9c",
                                "sense_id": "0948ea67-e597-3510-a695-93bfbc8ad6ee",
                                "text": "„Sie stand an der Eingangstür und sah ihn nicht kommen.“"
                            },
                            {
                                "example_id": "da10ea49-28a0-46f7-8387-1805a9f5c459",
                                "sense_id": "0948ea67-e597-3510-a695-93bfbc8ad6ee",
                                "text": "„Als die Beiden erschöpft und gestresst vom Wochenend-Einkauf um die Hausecke kommen, um zur Eingangstür zu gelangen, sehen sie Udo Deppe hinten in der Raucherecke, am Eingang zum Fahrradkeller, stehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
