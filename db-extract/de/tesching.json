                        "glosses": [
                            "Kleinkalibergewehr, das nach seinem französischen Erfinder auch „Flobert“ genannt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ac6fca1-b2e2-46b4-a613-8154c873ca4d",
                                "sense_id": "8f7e9970-96a8-3a00-8190-6e41e815dad6",
                                "text": "Er trug ein kleines Tesching bei sich."
                            },
                            {
                                "example_id": "99fcb0e9-8149-43c7-a0fb-ff09a05d04cf",
                                "sense_id": "8f7e9970-96a8-3a00-8190-6e41e815dad6",
                                "text": "„Das Johannis-Schießen müsse traditionsgemäß mit Armbrüsten stattfinden, fordert Schestawitscha, der Oppositionelle, aber die Radfahrer hören nicht auf ihn, sie werden mit einem Tesching und Sechs-Millimeter-Munition nach der Scheibe schießen.“"
                            }
