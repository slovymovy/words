                                        "entry_id": "838ba7e7-8dfa-3790-ae11-d477da4f0aaf",
                                        "glosses": [
                                            "A semiaquatic monotreme from eastern Australia with a bill resembling that of a duck, that has a mole-like body, a tail resembling that of a beaver, a waterproof pelt, and flat webbed feet (Ornithorhynchus anatinus)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2426f075-ccae-43a2-bcea-a2a642d817ab",
                                                "sense_id": "28171005-946f-3244-bbb2-8d2315c43f11",
                                                "text": "Victoria's Healesville Sanctuary is celebrating the births of two baby platypuses, in a major milestone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad28e7e2-4ea1-4216-8395-ed8a049d7126",
                        "source_entry_id": "37014f3b-c9a2-38f2-bc17-01caef7019f9",
                        "source_sense_id": "a015dd42-9a48-3ac5-8b0d-b023aa3e5438",
