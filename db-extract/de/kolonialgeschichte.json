                "senses": [
                    {
                        "sense_id": "ca8f02d8-cfda-3095-bf98-f47eab29724b",
                        "entry_id": "efe416b7-4455-34d9-a3a6-5233ff2a2f87",
                        "glosses": [
                            "historische Entwicklung der Kolonien/einer Kolonie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97bc0d8d-b92b-4ea7-b4a2-e40b8445db7a",
                                "sense_id": "ca8f02d8-cfda-3095-bf98-f47eab29724b",
                                "text": "„Die einseitige Quellenlage macht eine umfassende Nachzeichnung der Kolonialgeschichte Brasiliens unmöglich.“"
                            },
                            {
                                "example_id": "7c3a82c2-6c08-459b-ae2c-30384936aa41",
                                "sense_id": "ca8f02d8-cfda-3095-bf98-f47eab29724b",
                                "text": "„Das überraschendste Ereignis der gesamten Kolonialgeschichte war das Tempo, in dem die Imperien untergingen.“"
                            },
                            {
                                "example_id": "0ba50568-942a-4700-b673-ad7195efb2b9",
                                "sense_id": "ca8f02d8-cfda-3095-bf98-f47eab29724b",
                                "text": "„Beim Anblick zwingen sich deutsche Kolonialgeschichte in Ostafrika und Lettow-Vorbeck geradezu auf.“"
                            },
                            {
                                "example_id": "cc9eccfe-4e66-41b3-a000-1fa543b4d9f5",
                                "sense_id": "ca8f02d8-cfda-3095-bf98-f47eab29724b",
                                "text": "„Wer sich über die Denkweise wilhelminischer Deutscher und deren Sicht der deutschen Kolonialgeschichte informieren will, findet hier viel Material.“"
                            }
                        ],
