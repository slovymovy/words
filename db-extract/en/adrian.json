                                        "examples": [
                                            {
                                                "example_id": "a8569842-f34d-4365-b124-429bb5959da8",
                                                "sense_id": "3948f5f4-84be-3c4b-84ca-c3fdc772f572",
                                                "text": "Alle passie was voor Bassie. En ik, Adriaan, bekeek het vrolijk, nam nog een biertje en kroop 's nachts tegen de stevige billen van Lobbes."
                                            }
                                        ]
                                    }
                                ]
                            }
