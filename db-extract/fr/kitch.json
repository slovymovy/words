                "senses": [
                    {
                        "sense_id": "27a6c34e-31dd-3e90-bd6e-4bbe092cb8ba",
                        "entry_id": "8c9eb208-33dc-3f6e-8518-7c2631c22f2f",
                        "glosses": [
                            "Variante orthographique de kitsch, de mauvais goût."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a016045-5117-4eee-b966-e354d3b09132",
                                "sense_id": "27a6c34e-31dd-3e90-bd6e-4bbe092cb8ba",
                                "text": "Il y a des rubans roses, des fils dorés, des décorations kitch un peu partout."
                            },
                            {
                                "example_id": "972b72e5-9dcc-43ee-806d-425edbc74bda",
                                "sense_id": "27a6c34e-31dd-3e90-bd6e-4bbe092cb8ba",
                                "text": "Une chanson qui m'est familière, un chanteur super kitch que ma mère écoute souvent... Comment se nomme-t-il, déjà?… Jo Dassin, c'est ça!"
                            },
                            {
                                "example_id": "d1b5ec4c-83f7-4b9d-b72f-4e4d7e1f51df",
                                "sense_id": "27a6c34e-31dd-3e90-bd6e-4bbe092cb8ba",
                                "text": "Ce film musical nous baigne dans les années soixante-dix avec tout ce qu'il y a de plus kitch ; mais comme souvent, certains films comme celui-ci, qualifiés de « nanards » par les critiques, deviennent incontournables après leur sortie."
                            },
                            {
                                "example_id": "bf063f1a-d31b-4630-b06d-c1b0b62186d3",
                                "sense_id": "27a6c34e-31dd-3e90-bd6e-4bbe092cb8ba",
                                "text": "Le « Virtuosa » est un vaisseau clinquant, joyeux, coloré, kitch, digne représentant assumé du gigantisme et de tous les superlatifs, devant lequel il est difficile de rester impassible."
                            }
                        ]
                    }
