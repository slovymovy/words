                                "sense_id": "434cd5cf-605c-3694-b391-c677d5762a17",
                                "text": "„Antioxidationsmittel sind die Zaubermittel moderner und gesunder Ernährung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0776acc2-0c23-4278-a26b-6ecc108a311b",
