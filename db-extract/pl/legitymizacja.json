                                        "examples": [
                                            {
                                                "example_id": "66063bea-a5e7-47e1-baa7-11d4c7841c3e",
                                                "sense_id": "dfcf48b9-6096-31e4-a063-3a54f4d55bf3",
                                                "text": "I am not Sir Roberts sonne, / I haue disclaim'd Sir Robert and my land, / Legitimation, name, and all is gone […]."
