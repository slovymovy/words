                "translations": [
                    {
                        "translation_id": "d0525518-9dfa-4cd5-8102-b2bc0043c55d",
                        "source_entry_id": "89c2b500-3112-3778-b2b4-85ab789d8585",
                        "source_sense_id": "9672e8eb-aa5b-3996-b178-41aa1ea4b20d",
                        "target_lang_word": "Abstrich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abstrich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e6a4f77b-215b-387f-9013-55ec5d5072e2",
                                        "entry_id": "717f5383-e89b-3f18-a7f1-bbf7a00f0f98",
                                        "glosses": [
                                            "Linie in der Schreibschrift, die nach unten führt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e717baf1-e3f7-4dcf-9840-1d40b998aa40",
                                                "sense_id": "e6a4f77b-215b-387f-9013-55ec5d5072e2",
                                                "text": "Der Wendepunkt ist der Punkt, an dem Aufstrich und Abstrich zusammenlaufen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bbc3ff56-63d0-30d5-a329-9a8c334bbca4",
                                        "entry_id": "717f5383-e89b-3f18-a7f1-bbf7a00f0f98",
                                        "glosses": [
                                            "kleine, äußerlich genommene Probe von Zellmaterial, Probenahme"
                                        ],
                                        "tags": [
                                            "auch für den Vorgang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8eac3aa-65d2-484d-8f87-4c7b30aa20a4",
                                                "sense_id": "bbc3ff56-63d0-30d5-a329-9a8c334bbca4",
                                                "text": "Wann hat man das letzte Mal einen Abstrich bei Ihnen gemacht?"
                                            },
                                            {
                                                "example_id": "9baf4c29-1377-426b-8b2d-57fea21cc769",
                                                "sense_id": "bbc3ff56-63d0-30d5-a329-9a8c334bbca4",
                                                "text": "Der Abstrich wird ins Labor eingeschickt."
                                            },
                                            {
                                                "example_id": "165c4baf-a357-4a34-bbc5-37f2cdecf278",
                                                "sense_id": "bbc3ff56-63d0-30d5-a329-9a8c334bbca4",
                                                "text": "„Die Drive-In Teststelle in Elmshorn funktioniert fast wie beim Fastfood-Restaurant: Ranfahren, Scheibe runter, Abstrich machen, weiterfahren.“"
                                            },
                                            {
                                                "example_id": "9f7e708f-2ee7-4715-b70a-10c0fe579dd6",
                                                "sense_id": "bbc3ff56-63d0-30d5-a329-9a8c334bbca4",
                                                "text": "„Bis zu 70 Abstriche am Autofenster schaffen die freiwilligen Helfer pro Tag.“"
                                            },
                                            {
                                                "example_id": "a4d4a4a3-1227-4753-ac7d-492f0809847c",
                                                "sense_id": "bbc3ff56-63d0-30d5-a329-9a8c334bbca4",
                                                "text": "„Hausärzte überweisen die Patienten zum Abstrich an die Testzentren.“"
                                            },
                                            {
                                                "example_id": "45b72e5e-c10d-4a26-952c-15a239380468",
                                                "sense_id": "bbc3ff56-63d0-30d5-a329-9a8c334bbca4",
                                                "text": "„Ob es sich um einen gutartigen oder bösartigen Tumor handelt, soll ein Abstrich klären.“"
                                            },
                                            {
                                                "example_id": "2ec8412e-93a5-4f20-b2c8-57730f7a0203",
                                                "sense_id": "bbc3ff56-63d0-30d5-a329-9a8c334bbca4",
                                                "text": "„Weil Material fehlte, wurden die Abstriche im Rachen nicht durch die Nase gemacht. Dies sei zu unsicher, sagt ein Chefarzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8203b421-b45a-3613-b1d0-066d3bb9f58d",
                                        "entry_id": "717f5383-e89b-3f18-a7f1-bbf7a00f0f98",
                                        "glosses": [
                                            "Abwärtsbewegung des Bogens"
                                        ],
                                        "tags": [
                                            "Musik",
                                            "Streichinstrument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5b2cfe8-3a9f-437b-993a-7d61ea70d899",
                                                "sense_id": "8203b421-b45a-3613-b1d0-066d3bb9f58d",
                                                "text": "Der Abstrich bezeichnet das Streichen des Bogens in der Richtung vom Frosch zur Spitze, also bei einem Rechtshänder nach rechts."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "d2e0d1b2-533c-3f51-9ccb-69ea04c88e00",
                                        "entry_id": "717f5383-e89b-3f18-a7f1-bbf7a00f0f98",
                                        "glosses": [
                                            "Kürzung, zum Beispiel bei einer Anforderung oder Geldsumme"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d6d2686-c7a6-473f-b0f9-4ebeb0106ac4",
                                                "sense_id": "d2e0d1b2-533c-3f51-9ccb-69ea04c88e00",
                                                "text": "Da werden wir wohl bei den Anforderungen Abstriche machen müssen."
                                            },
                                            {
                                                "example_id": "9f06333c-9f65-49a3-aa02-fd1b93865ed1",
                                                "sense_id": "d2e0d1b2-533c-3f51-9ccb-69ea04c88e00",
                                                "text": "[Schlagzeile:] „Sanierung am Untersee - Mitarbeiter nehmen Abstriche hin“"
                                            },
                                            {
                                                "example_id": "5392e6c9-9cf2-46ed-8ceb-7369eba7da4a",
                                                "sense_id": "d2e0d1b2-533c-3f51-9ccb-69ea04c88e00",
                                                "text": "„Wirtschaftliche Überlegungen dürften nicht zu Abstrichen bei der Sicherheit von Atomkraftwerken führen. Das betont Hans Wanner, Direktor der Atomaufsichtsbehörde Ensi.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
