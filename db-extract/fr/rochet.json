        "fr-extract.jsonl": [
            {
                "entry_id": "76adf590-8741-360d-8cd6-b9e35f404b65",
                "word": "Rochet",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "83c873ba-6368-3020-a93f-dcd229d63bab",
                        "entry_id": "76adf590-8741-360d-8cd6-b9e35f404b65",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fc46c5a-adb0-4382-9b94-eea5e78cd6a3",
                                "sense_id": "83c873ba-6368-3020-a93f-dcd229d63bab",
                                "text": "Ce livre, écrit pour servir à notre Défense, est le récit d’un combat : celui de la D.S.T., chargée du contre-espionnage en France, celui que mena pendant cinq ans son ancien directeur, le préfet Jean Rochet dont les révélations, au cours d’une émission de télévision, le 27 janvier 1971, firent grand bruit."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "ef7f72a7-520d-3879-b46c-5057b4f622cb",
                "word": "rochet",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "aaafc993-6491-4501-a137-577f38421195",
                        "entry_id": "ef7f72a7-520d-3879-b46c-5057b4f622cb",
                        "tags": [
                            "plural"
                        ],
                        "form": "rochets"
                    },
                    {
                        "form_id": "17691859-8e2d-45e5-8479-7a4e6aba3a9c",
                        "entry_id": "ef7f72a7-520d-3879-b46c-5057b4f622cb",
                        "tags": [],
                        "form": "roquet"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8b2531a6-b882-358d-93f8-97810f17ada7",
                        "entry_id": "ef7f72a7-520d-3879-b46c-5057b4f622cb",
                        "glosses": [
                            "Sorte de surplis à manches étroites, que portent les évêques et divers autres ecclésiastiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a353487-cfc7-4685-8b72-c937e2e631c2",
                                "sense_id": "8b2531a6-b882-358d-93f8-97810f17ada7",
                                "text": "Le clergé en soutane avec un grand manteau et un bonnet carré, ou en robe violette et en rochet, marchait en avant."
                            },
                            {
                                "example_id": "3da1b3b3-f931-4d4b-96cf-f45a8156d35b",
                                "sense_id": "8b2531a6-b882-358d-93f8-97810f17ada7",
                                "text": "Au lieu du vieux prêtre attendu, c’était Monseigneur qui entrait, Monseigneur en rochet de dentelle, ayant l’étole violette et portant le vaisseau d’argent, où se trouvait l’huile des infirmes, bénite par lui-même le Jeudi saint."
                            },
                            {
                                "example_id": "6024500f-9fc5-417e-adc0-34ab1a6b0af0",
                                "sense_id": "8b2531a6-b882-358d-93f8-97810f17ada7",
                                "text": "On entraîne Arlette dans la sacristie, encombrée d’ornements d’église, de chasubles rutilantes, de surplis fragiles, de rochets de mousseline, qui attendent d’être rangés en de hautes armoires de chêne."
                            },
                            {
                                "example_id": "9d32b5b2-5f83-4332-a6b3-0653897c5240",
                                "sense_id": "8b2531a6-b882-358d-93f8-97810f17ada7",
                                "text": "Les évêques prêchent en rochet et en camail."
                            }
                        ]
                    },
                    {
                        "sense_id": "89b0986d-fe75-36bc-af0b-1f7a2828653b",
                        "entry_id": "ef7f72a7-520d-3879-b46c-5057b4f622cb",
                        "glosses": [
                            "Attribut symbolique de l'épiscopat."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "4ac5e2c3-3a3c-41a1-912a-749778f6e408",
                                "sense_id": "89b0986d-fe75-36bc-af0b-1f7a2828653b",
                                "text": "Tu dors! attends-tu donc que, sans bulle et sans titre,\nIl te ravisse encore le rochet et la mitre? — (Nicolas Boileau, Le Lutrin, chant I)"
                            }
                        ]
                    },
                    {
                        "sense_id": "797952c8-f314-333a-930f-ed3b175b373b",
                        "entry_id": "ef7f72a7-520d-3879-b46c-5057b4f622cb",
                        "glosses": [
                            "Mantelet."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e5b2f35-f907-4038-86d2-64b846c4815e",
                        "source_entry_id": "ef7f72a7-520d-3879-b46c-5057b4f622cb",
                        "source_sense_description": "Vêtement",
                        "target_lang_word": "rochet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rochet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80824fdf-524d-308a-8992-54bc9151f110",
                                        "entry_id": "7e74e3ee-d4be-3433-a7a4-28619c88cdc1",
                                        "glosses": [
                                            "A white vestment, worn by a bishop, similar to a surplice but with narrower sleeves, extending either to below the knee (in the Catholic church) or to the hem of the cassock in the Anglican church."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45fd25d2-6736-4c92-895a-63db37e8cc34",
                                                "sense_id": "80824fdf-524d-308a-8992-54bc9151f110",
                                                "text": "Each priest adorn'd was in a surplice white, / The bishops don'd their albes and copes of state, // Above their rochets button'd fair before, / And mitres on their heads like crowns they wore."
                                            },
                                            {
                                                "example_id": "0f1854b8-ae1e-447d-b42c-502ed5f4f8df",
                                                "sense_id": "80824fdf-524d-308a-8992-54bc9151f110",
                                                "text": "Or elſe they vvould ſtraine us out a certaine figurative Prelat, by vvringing the collective allegory of thoſe ſeven Angels into ſeven ſingle Rochets."
                                            },
                                            {
                                                "example_id": "c2a26e4e-be9c-479b-89bd-62253e974913",
                                                "sense_id": "80824fdf-524d-308a-8992-54bc9151f110",
                                                "text": "They will tell you that they see no difference between an idler with a hat and national cockade, and an idler in a cowl or in a rochet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0068efdb-7dbf-3b28-a1f6-b6a67a864f0d",
                                        "entry_id": "7e74e3ee-d4be-3433-a7a4-28619c88cdc1",
                                        "glosses": [
                                            "A frock or outer garment worn in the 13th and 14th centuries."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rochet",
                                "target_lang_code": "en",
                                "target_senses": [
