                        "examples": [
                            {
                                "example_id": "8cf6ac8a-2f52-4930-a260-da3ed7509694",
                                "sense_id": "013b7c46-dd77-33b3-bc39-aa9637b7347f",
                                "text": "Bij het zien van Tygo en Tasja kreeg Goscha tranen in de ogen: Tonio had haar zoveel over zijn Noorse boskatten verteld. Ze probeerde de twee aan te halen, maar misschien omdat ze Goscha's katten roken (een cyperse en een `schildpad'), bleven ze op afstand. Ja, wat moesten zij, met hun trotse stamboom en noordelijke aristocratie, ook met zwerfvolk van de Poezenboot?"
                            },
                            {
                                "example_id": "581fcf5a-f260-4c96-8373-d78c85f900cb",
                                "sense_id": "013b7c46-dd77-33b3-bc39-aa9637b7347f",
                                "text": "Ook Van Daalen is dik tevreden met de plaatsing van de cypers grijze Dunja en rood met witte Daisy die in het voorjaar zwanger bij het dierentehuis werden binnengebracht."
                            }
                        ]
                    }
