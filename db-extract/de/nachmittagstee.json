                "senses": [
                    {
                        "sense_id": "fd43909c-5c7d-32b7-a190-335508f77e73",
                        "entry_id": "0face618-c7c8-346c-9571-6699e28d1b54",
                        "glosses": [
                            "Tee, der am Nachmittag getrunken wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53a547c1-7075-46fd-b6c8-f4d3d562e667",
                                "sense_id": "fd43909c-5c7d-32b7-a190-335508f77e73",
                                "text": "„Die Straßen füllten sich mit jungen Leuten, die vor den Pubs den warmen Abend genießen wollten, und im Hotel Ritz auf der anderen Straßenseite tranken feine Damen ihren Nachmittagstee aus und verputzten die letzten Marmeladenscones und Gurkensandwiches.“"
                            },
                            {
                                "example_id": "0065e2f7-467f-4fad-8ca2-634e0c929494",
                                "sense_id": "fd43909c-5c7d-32b7-a190-335508f77e73",
                                "text": "„So möchte wohl niemand den drittschlimmsten Tag seines Lebens verbringen: einer traurigen Frau dabei zusehen, wie sie ihren Nachmittagstee zubereitet und ihre Gebetskette mit der Inbrunst eines onanierenden Teenagers bearbeitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c000b37e-7685-482b-88cf-e44c5a5da5d6",
                        "source_entry_id": "0face618-c7c8-346c-9571-6699e28d1b54",
                        "source_sense_id": "fd43909c-5c7d-32b7-a190-335508f77e73",
                        "source_sense_description": "Tee am Nachmittag",
                        "target_lang_word": "afternoon tea",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "afternoon tea",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d744e19-ae3b-3393-9914-b35c0fbe3ef4",
                                        "entry_id": "1971d499-09a3-382d-894b-650c38eca8c5",
                                        "glosses": [
                                            "A formal afternoon meal comprising light snacks, accompanied by tea."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adf658aa-6484-47ef-bc75-cecfc7e5c5ac",
                                                "sense_id": "6d744e19-ae3b-3393-9914-b35c0fbe3ef4",
                                                "text": "Afternoon tea remains at its present price of 4s, but the prices of all other main meals have risen by 1s. Thus a full breakfast now costs 10s, lunch 13s 6d and dinner 14s 6d or 16s 6d according to train."
                                            },
                                            {
                                                "example_id": "af0c9bdd-ff03-4e65-acb2-ccab02840358",
                                                "sense_id": "6d744e19-ae3b-3393-9914-b35c0fbe3ef4",
                                                "text": "As with luncheon, afternoon tea was often a women's gathering for reasons that take us back to the reign of Charles II."
                                            },
                                            {
                                                "example_id": "fe0636b3-04bf-4a84-be1b-f16de05e930e",
                                                "sense_id": "6d744e19-ae3b-3393-9914-b35c0fbe3ef4",
                                                "text": "Everyone should indulge in a formal afternoon tea at least once while in London. This relaxing, drawn-out, civilized affair consists of three courses, all elegantly served on fine china: dainty finger sandwiches (with the crusts cut off, of course); then fresh-baked scones served with jam and deliciously decadent clotted cream (the rich, thick cream is also known as Devonshire cream); and lastly, an array of bite-size sweets. All the while, an indulgent server keeps the pot of your choice fresh at hand."
                                            },
                                            {
                                                "example_id": "9bfa1ba1-6e16-49e3-9a2f-308b315d673a",
                                                "sense_id": "6d744e19-ae3b-3393-9914-b35c0fbe3ef4",
                                                "text": "At all the places listed below, it's perfectly acceptable to order one afternoon tea and one cream tea (at about £5) and split the afternoon tea goodies."
                                            },
                                            {
                                                "example_id": "d2f7907b-8e77-45a5-8efe-8d2a8eef15a8",
                                                "sense_id": "6d744e19-ae3b-3393-9914-b35c0fbe3ef4",
                                                "text": "The British tradition of afternoon tea is still observed on the last Friday of each month, from January to August, at the hilltop mansion of the governor-general in Nassau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcc252cb-0951-35a5-aeec-0a26e36d9ffe",
                                        "entry_id": "1971d499-09a3-382d-894b-650c38eca8c5",
                                        "glosses": [
                                            "A small meal or snack eaten between lunch and dinner (supper); a period of time set aside for this purpose, taken as a break from work or from a conference."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Hong-Kong",
                                            "New-Zealand",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "861cb5f4-237a-4989-a3fa-7be8b2f117f5",
                                                "sense_id": "fcc252cb-0951-35a5-aeec-0a26e36d9ffe",
                                                "text": "After afternoon tea we all combine again for a plenary session, followed by the UniForum NZ AGM."
                                            },
                                            {
                                                "example_id": "aa45b77b-20f6-497e-a9b2-d51de9680626",
                                                "sense_id": "fcc252cb-0951-35a5-aeec-0a26e36d9ffe",
                                                "text": "In looking at meal structures, Douglas (1972) made a clear distinction between the afternoon tea which is a snack and the high tea which is classified as a light meal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
