                ],
                "senses": [
                    {
                        "sense_id": "e3666543-7778-301b-917f-f7d0c1c02bc7",
                        "entry_id": "18c1262b-7932-3fae-a201-0a7914ddfd7a",
                        "glosses": [
                            "воспламениться, загореться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95fc4bd8-605c-4de6-8172-4b7cce1cded8",
                                "sense_id": "e3666543-7778-301b-917f-f7d0c1c02bc7",
                                "text": "Наш скорбный труд не пропадёт, / Из искры возгорится пламя, / И просвещённый наш народ / Сберётся под святое знамя."
                            }
                        ]
                    },
                    {
                        "sense_id": "b77ceafc-392e-3714-bc4d-d2c525f1023c",
                        "entry_id": "18c1262b-7932-3fae-a201-0a7914ddfd7a",
                        "glosses": [
                            "перен. внезапно возникнуть, начаться"
                        ],
                        "tags": [
                            "устаревающ."
                        ],
                        "examples": [
                            {
                                "example_id": "8843bda1-02c6-4abd-abaf-1556581c079e",
                                "sense_id": "b77ceafc-392e-3714-bc4d-d2c525f1023c",
                                "text": "А как война с турками возгорелась, то отец мой храбро двинулся со своею ротою, и к осени были все уже за границею."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb08ea94-f21e-36dd-b8d2-e41c7a33be6e",
                        "entry_id": "18c1262b-7932-3fae-a201-0a7914ddfd7a",
                        "glosses": [
                            "перен. оказаться внезапно охваченным сильным чувством, желанием"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "249d55b5-cfac-41a7-9750-29581898fd29",
                                "sense_id": "eb08ea94-f21e-36dd-b8d2-e41c7a33be6e",
                                "text": "Сановник мой возгорелся на меня гневом."
                            }
                        ]
                    }
                ],
