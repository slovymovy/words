                        "examples": [
                            {
                                "example_id": "24151939-04b0-4f2a-87f6-0f94efb9f482",
                                "sense_id": "6ef2ea54-08b0-3058-8de6-7a7a398b93c3",
                                "text": "Bovendien haalt Malcolm in haar vermakelijke boek ook nog eens acht Tsjechov-biografen aan die behoorlijk slordig met het stervensuur van hun held zijn omgegaan, wat je ernstig doet twijfelen over wat ze verder te melden hebben."
                            },
                            {
                                "example_id": "8652a49a-12f8-423d-8677-d78ad99f88f8",
                                "sense_id": "6ef2ea54-08b0-3058-8de6-7a7a398b93c3",
                                "text": "Nou Veer, ik nader het einde van mijn column. Ik wilde niet sentimenteel zijn, maar ik kan de juiste nuchterheid niet vinden om de diepte te suggereren van mijn kleine verdriet. Je stervensuur maakt alles verdrietig en aandoenlijk. Ik ga nu naar bed. Loop maar achter me aan, Veer. Alleen ik weet dat het je laatste keer is. Morgen vind ik ergens je kak. Geeft niet. Moor blaft straks tegen je, Helder blaast - en jij komt tegen me aan liggen."
                            }
                        ]
                    }
