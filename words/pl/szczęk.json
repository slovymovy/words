                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gramatyka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W tym muzeum znajduje się wiele skamieniałych <w>szczęk</w> prehistorycznych zwierząt.",
                            "target_lang_translations": {
                                "ru": "В этом музее находится много окаменелых <w>челюстей</w> доисторических животных."
                            }
