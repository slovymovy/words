                        "source_sense_id": "0e7cc2f7-71b4-37fa-9d1c-23d1e57ee82a",
                        "source_sense_description": "niet stelselmatig voorkomend",
                        "target_lang_word": "gelegentlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gelegentlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e761e36-59eb-3575-ac06-1915298b0209",
                                        "entry_id": "5d34752f-14fd-326e-b549-2e27d92f4839",
                                        "glosses": [
                                            "wenn sich eine günstige, passende Gelegenheit bietet, wenn es die Umstände erlauben, bei Gelegenheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bda79f4-91ac-4867-afcd-db2731be7d96",
                                                "sense_id": "2e761e36-59eb-3575-ac06-1915298b0209",
                                                "text": "Gelegentlich fahre ich bei ihm vorbei und bringe ihm seinen Regenschirm zurück."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7711994f-7dc1-3623-8954-ea8fde18f5aa",
                                        "entry_id": "5d34752f-14fd-326e-b549-2e27d92f4839",
                                        "glosses": [
                                            "mehr oder weniger oft, unterschiedlich häufig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5f0e5d2-5976-43d4-960c-42e329cbef86",
                                                "sense_id": "7711994f-7dc1-3623-8954-ea8fde18f5aa",
                                                "text": "Unsere gelegentlichen Treffen genügen mir nicht."
                                            },
                                            {
                                                "example_id": "f5e34b6b-935b-44b7-8685-00df1fa85a71",
                                                "sense_id": "7711994f-7dc1-3623-8954-ea8fde18f5aa",
                                                "text": "„Gelegentlich werden sie sogar verdächtigt, dass sie mit den Taliban, den Mullahs oder mit den Ultraorthodoxen sympathisieren und womöglich sogar Prügelstrafen oder Steinigungen klammheimlich in Kauf nehmen.“"
                                            },
                                            {
                                                "example_id": "744c6559-43e3-41f0-8bff-565382f09444",
                                                "sense_id": "7711994f-7dc1-3623-8954-ea8fde18f5aa",
                                                "text": "[…] eine gerechte Beurteilung mündlicher Beiträge [ist] keine einfache Sache; und bei 5 bis 10 Klassen zu je 30 Schülern misslingt sie gewiss auch gelegentlich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "gelegentlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2d30137a-bf3a-3e4b-8827-853f46cb1cb4",
                                        "entry_id": "3cde1de7-41a7-370c-819e-45fdae23e7c7",
                                        "glosses": [
                                            "aus oder bei einem bestimmten Anlass"
                                        ],
                                        "tags": [
                                            "mit Genitiv"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c58e7cda-85d6-494b-a404-fbb4d79ed049",
                                                "sense_id": "2d30137a-bf3a-3e4b-8827-853f46cb1cb4",
                                                "text": "„[…] ich mischte mich unter die Leute, die standen und schwatzten und sich anfreundeten gelegentlich ihres Mißgeschickes und aufschnitten und sich wichtig machten.“"
                                            },
                                            {
                                                "example_id": "b7ed2530-be2f-4674-8a59-870d022712e8",
                                                "sense_id": "2d30137a-bf3a-3e4b-8827-853f46cb1cb4",
                                                "text": "Es ist umstritten, ob das Verhalten und das Verschulden des Erfüllungsgehilfen dem Geschäftsherrn auch dann zugerechnet werden, wenn jener die schädigende Handlung nur gelegentlich der Erfüllung vorgenommen hat."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
