                                "example_id": "501567fb-db3e-4b7a-9ba9-47e4c5094865",
                                "sense_id": "ff51dd15-b4b0-3798-8d12-bc103d92011d",
                                "text": "Uczestniczyłam w nabożeństwie i pogrzebie na antwerpskim cmentarzu. Żegnałam go, dziękując za to, jakim był"
                            }
