                    {
                        "sense_id": "9c5dec49-171c-38b3-987e-f92e3a682b53",
                        "entry_id": "bc1fed5e-3c58-38ba-8a7a-fb21adf6920a",
                        "glosses": [
                            "Übersicht über ein Kalenderjahr im Dreiwochenzyklus der Rinder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74ed3282-0a03-4046-94df-0f2d4bede9e7",
                                "sense_id": "9c5dec49-171c-38b3-987e-f92e3a682b53",
                                "text": "„Also verfügte ich mich hinüber nach Ungenach, studierte den Brunstkalender an der Stalltür und machte mich durch Klopfzeichen am Küchenfenster bemerkbar.“"
                            },
                            {
                                "example_id": "97b2cbe8-ee07-44de-af4f-7d235522d7cb",
                                "sense_id": "9c5dec49-171c-38b3-987e-f92e3a682b53",
                                "text": "„Ergibt sich ein normaler Zyklusverlauf, notiert man die Brunstphase im Brunstkalender und beobachtet dann die folgenden Termine bis zur Besamung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
