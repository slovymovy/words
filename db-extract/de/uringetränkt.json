                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54fc3a57-d00f-49cc-a152-437b22f862af",
                                "sense_id": "fca0e762-db9f-3755-9963-110c47d445d6",
                                "text": "„Als sie auf dem uringetränkten Boden lag, machte er kehrt und lief ins Treppenhaus.“"
                            },
                            {
                                "example_id": "cd8257bb-2f22-4530-8fb7-83e4d4972dab",
                                "sense_id": "fca0e762-db9f-3755-9963-110c47d445d6",
                                "text": "„Dann ziehe ich mir eine frische Hose über und werfe das uringetränkte Paar in den Müll, es war sowieso angekokelt.“"
                            }
                        ],
