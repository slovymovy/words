                    }
                ],
                "senses": [
                    {
                        "sense_id": "a43a085d-c04a-329a-985c-9b9639917683",
                        "entry_id": "f9e25702-8873-3593-b374-610c3d9b2030",
                        "glosses": [
                            "Manière de s'habiller."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ee36f225-44d5-3961-b056-404b784708c8",
                        "entry_id": "f9e25702-8873-3593-b374-610c3d9b2030",
                        "glosses": [
                            "Ensemble des choses dont on est habillé, vêtu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eabc604e-2fdd-4cc7-ac9a-34a42febce11",
                                "sense_id": "ee36f225-44d5-3961-b056-404b784708c8",
                                "text": "Si le coupable ne paie pas immédiatement, les bandiers le « pignorent », c'est-à-dire qu'ils prennent en gage soit quelques têtes, soit une pièce de son habillement que le coupable retrouve lorsqu'il a acquitté l'amende due."
                            },
                            {
                                "example_id": "a2ebf266-589d-40ff-bbe4-85582b442648",
                                "sense_id": "ee36f225-44d5-3961-b056-404b784708c8",
                                "text": "Les habillements étaient fort élégants du temps de Henri IV."
                            },
                            {
                                "example_id": "d8f00def-3098-48b9-8f68-ef9b3764aed9",
                                "sense_id": "ee36f225-44d5-3961-b056-404b784708c8",
                                "text": "L’habillement des Égyptiens était fort simple."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b1179a7-c74d-3c6f-88a9-9af18aa5dbeb",
                        "entry_id": "f9e25702-8873-3593-b374-610c3d9b2030",
                        "glosses": [
                            "Vêtement."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "2e6ae80e-04bc-4d90-9afc-3c70fbba9040",
                                "sense_id": "4b1179a7-c74d-3c6f-88a9-9af18aa5dbeb",
                                "text": "Revêtons-nous d’habillements\nConformes à l’horrible fête"
                            }
                        ]
                    },
                    {
                        "sense_id": "85cfd6b0-beb7-3faa-b8be-b4ad82207854",
                        "entry_id": "f9e25702-8873-3593-b374-610c3d9b2030",
                        "glosses": [
                            "Action d’habiller, de pourvoir d’habits."
                        ],
                        "tags": [
                            "Administratif"
                        ],
                        "examples": [
                            {
                                "example_id": "583132f7-cb1e-4597-b0ab-5ff581eafb15",
                                "sense_id": "85cfd6b0-beb7-3faa-b8be-b4ad82207854",
                                "text": "L’habillement des troupes."
                            },
                            {
                                "example_id": "a8afbdce-31c6-4ba2-ae8a-e2f11461724c",
                                "sense_id": "85cfd6b0-beb7-3faa-b8be-b4ad82207854",
                                "text": "Des zouaves, des moblots, des francs-tireurs, des gardes forestiers, des cavaliers démontés, jusques à des gendarmes, des Espagnols et des Valaques ; il y avait de tout, et ce tout était commandé par un vieux capitaine d’habillement promu, pour la circonstance, au grade de lieutenant-colonel."
                            },
                            {
                                "example_id": "1a11fdfb-a152-4225-846a-ad4d6f33fae4",
                                "sense_id": "85cfd6b0-beb7-3faa-b8be-b4ad82207854",
                                "text": "LE MAÎTRE D’HÔTEL – J’ai fait la guerre comme caporal d’habillement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff146a34-fe6d-4b9e-bde1-4e0b8960a464",
                        "source_entry_id": "f9e25702-8873-3593-b374-610c3d9b2030",
                        "source_sense_id": "a43a085d-c04a-329a-985c-9b9639917683",
