                    {
                        "sense_id": "28256e15-28f8-31e4-b4ff-a03d385bb566",
                        "entry_id": "a774ea16-bb82-3564-bad4-1ec4fc21351c",
                        "glosses": [
                            "Ouvrage sorti des presses des fameux typographes hollandais qui portaient ce nom."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cca34f3a-5f5a-425a-a0ea-7982fd4231d0",
                                "sense_id": "28256e15-28f8-31e4-b4ff-a03d385bb566",
                                "text": "Raoul examina les livres et empocha trois elzévirs, tandis que la comtesse, à l’insu de Raoul, faisait main basse sur les médailles d’une vitrine."
                            },
                            {
                                "example_id": "72c21064-43cb-441a-ad1f-43a6e5f802bf",
                                "sense_id": "28256e15-28f8-31e4-b4ff-a03d385bb566",
                                "text": "[…] François à sa boutique, où il était charmant dans les crises d’enthousiasme que déclenchaient en lui un elzévir bien venu, une reliure de Derome ou de Padeloup […]."
                            },
                            {
                                "example_id": "7afa2218-647f-4d3f-88e5-855295904fcc",
                                "sense_id": "28256e15-28f8-31e4-b4ff-a03d385bb566",
                                "text": "Un elzévir bien conservé."
                            },
                            {
                                "example_id": "181e4ad6-594a-4753-8ba7-60a336e39853",
                                "sense_id": "28256e15-28f8-31e4-b4ff-a03d385bb566",
                                "text": "La collection des elzévirs."
                            }
                        ]
                    },
                    {
                        "sense_id": "0f89d572-c071-3d33-bf33-a3f0aaf84209",
                        "entry_id": "a774ea16-bb82-3564-bad4-1ec4fc21351c",
                        "glosses": [
                            "Caractère d’imprimerie qui se rapproche du type employé par les Elzévir. Il s’agit de lettres ayant des empattements triangulaires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5de7109e-718d-42a3-af1c-ec2ed28acda3",
                                "sense_id": "0f89d572-c071-3d33-bf33-a3f0aaf84209",
                                "text": "Puis ils rêvaient de porcelaines précieuses, à décors d’oiseaux exotiques, de livres reliés de cuir, imprimés en elzévir sur des feuilles de Japon à la cuve, avec de grandes marges blanches non rognées où l’œil se reposait délicieusement, de tables d’acajou, de vêtements de soie ou de lin, souples et confortables, pleins de couleurs, de chambres spacieuses et claires, de brassées de fleurs, de tapis de Boukhara, de dobermans bondissants."
                            }
                        ]
                    }
