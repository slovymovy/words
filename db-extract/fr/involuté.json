                        "entry_id": "c853a7dd-c13b-35ca-84b1-eb0b1170f639",
                        "glosses": [
                            "Qui est roulé en dedans."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5461b6c8-c43c-47de-ae00-88f4752f3962",
                                "sense_id": "86f2656d-07ca-39b8-b07d-4785c0a23239",
                                "text": "Le L. volemus ou vachotte ou vachette (5-12), associé aux bois mêlés, spécialement à la hêtraie, au chapeau orange ou jaune d'or, involuté, au pied concolore et trapu, aux lames épaisses et distantes, orangées, à la chair brunissante, possédant un lait blanc, abondant et doux […]."
                            },
                            {
                                "example_id": "664abbe7-bd6d-492e-9854-e647f7a5d3bf",
                                "sense_id": "86f2656d-07ca-39b8-b07d-4785c0a23239",
                                "text": "Pétales involutés."
                            }
                        ]
                    },
                    {
                        "sense_id": "3c8d734a-f8b5-33ff-9558-8b49478d0ebf",
                        "entry_id": "c853a7dd-c13b-35ca-84b1-eb0b1170f639",
                        "glosses": [
                            "Enroulé, roulé en dedans, considérant tout autre thème que la botanique."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "43ced382-cc9f-4257-9400-58a5b4042b7e",
                                "sense_id": "3c8d734a-f8b5-33ff-9558-8b49478d0ebf",
                                "text": "Tel un ludion imprévisible, notre âme, c’est à la fois le moi percevant qui jaillit à la surface pour folâtrer « sur les vagues » et le moi intérieur, introverti, poisson involuté sur lui-même qui plonge dans la paix ou dans la… boue des abysses."
                            }
                        ]
                    }
