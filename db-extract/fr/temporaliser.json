                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a13af164-80da-45ef-925e-c6fbd3a3f526",
                        "source_entry_id": "94d30300-9d8a-3b95-a181-25084d4916ff",
                        "source_sense_id": "d2eb19df-566e-3b8d-9c1f-0eb88e0b6387",
                        "target_lang_word": "temporalize",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "temporalize",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6df09f06-4363-3ade-a73b-5bc6f06354b3",
                                        "entry_id": "285b2d4a-4fcf-337c-914e-d91dc02757e4",
                                        "glosses": [
                                            "To situate in time."
                                        ],
                                        "tags": [
                                            "often",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6c65fea-e29b-46b2-8978-6f340a7577c9",
                                                "sense_id": "6df09f06-4363-3ade-a73b-5bc6f06354b3",
                                                "text": "There are probably innumerable rhythms in a sensation during the duration of a second. . . . We are unable to temporalize our sensations of phenomena."
                                            },
                                            {
                                                "example_id": "cac55ad2-1dce-477d-a425-52c15a7f9cb6",
                                                "sense_id": "6df09f06-4363-3ade-a73b-5bc6f06354b3",
                                                "text": "In each language, mechanisms are available which allow us to classify, serialize, localize, and temporalize the objects of possible experience."
                                            },
                                            {
                                                "example_id": "95d5213c-f46d-40e5-8348-444656ac6108",
                                                "sense_id": "6df09f06-4363-3ade-a73b-5bc6f06354b3",
                                                "text": "Spencer begins with an idea in the Platonist sense, which he proceeds to unfold, to spatialize and temporalize in the universe of fiction."
                                            },
                                            {
                                                "example_id": "8295c59a-7941-43c2-84c3-fc6daeff5256",
                                                "sense_id": "6df09f06-4363-3ade-a73b-5bc6f06354b3",
                                                "text": "By way of discourse, we break out of the immediate surround. . . . Whereas the other intentional threads spatialize and temporalize a surround with somewhat limited range . . ., discourse discloses world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f427a816-63a6-35fc-a21e-3dbe7564c405",
                                        "entry_id": "285b2d4a-4fcf-337c-914e-d91dc02757e4",
                                        "glosses": [
                                            "To secularize."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
