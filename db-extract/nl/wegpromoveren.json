                ],
                "senses": [
                    {
                        "sense_id": "dbf3ef09-36cc-354d-8c55-396526c51699",
                        "entry_id": "95133b25-bb4d-3498-89dc-b8bd2e96745d",
                        "glosses": [
                            "to kick upstairs or boot upstairs, that is, to promote a troublesome subject or employee to an apparently higher position which has less authority or influence"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21968ade-33b1-48f1-acf1-3944e139c365",
                                "sense_id": "dbf3ef09-36cc-354d-8c55-396526c51699",
                                "text": "Mevrouw Detry werd in het jaar 2000 weggepromoveerd naar de provinciale bibliotheek nadat haar onterecht een leidinggevende functie was geweigerd."
                            }
                        ]
                    }
                ],
