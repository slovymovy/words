                        ],
                        "form": "der Fürsorglichkeit"
                    },
                    {
                        "form_id": "c11f6be4-3e2d-4617-8707-6ce0ebfd2225",
                        "entry_id": "909fd681-6d37-3651-8646-2b780c9a5be0",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Fürsorglichkeit"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "19b042f2-9a29-3737-b83d-6a95a2d3c5c9",
                        "entry_id": "909fd681-6d37-3651-8646-2b780c9a5be0",
                        "glosses": [
                            "Eigenschaft/Haltung, sich um das Wohlbefinden anderer zu kümmern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16c66efc-7814-4f9b-b18e-e62fab4b8fbd",
                                "sense_id": "19b042f2-9a29-3737-b83d-6a95a2d3c5c9",
                                "text": "„Die Bewegung tat mit einem Mal gar nicht mehr weh, als habe allein seine Fürsorglichkeit schon Linderung gebracht.“"
                            },
                            {
                                "example_id": "25fc6687-d9d8-4cbd-be72-4186a4ebbb20",
                                "sense_id": "19b042f2-9a29-3737-b83d-6a95a2d3c5c9",
                                "text": "„Die Kolonialherren hatten die Schwarzen schon immer wie Unmündige behandelt, die man mit Zucht oder Fürsorglichkeit zu ihrem Glück zwingen musste.“"
                            },
                            {
                                "example_id": "612f9fde-7c9e-45c4-8c2f-320115e708df",
                                "sense_id": "19b042f2-9a29-3737-b83d-6a95a2d3c5c9",
                                "text": "„Kaum ist er dem Ortsnetz angeklemmt und fernmündlich erreichbar, schon füllt sich sein Briefkasten mit Drucksachen voll zwingender Fürsorglichkeit.“"
                            },
                            {
                                "example_id": "c98f07b5-d20d-4406-80d0-0e8355eab146",
                                "sense_id": "19b042f2-9a29-3737-b83d-6a95a2d3c5c9",
                                "text": "„Natascha hatte eigentlich gar nicht mitfahren wollen, konnte aber Marja Dmitrijewnas freundliche Fürsorglichkeit, die sich doch ausschließlich an sie richtete, nicht gut zurückweisen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff680aec-2062-4589-9808-c5fd44fed23f",
                        "source_entry_id": "909fd681-6d37-3651-8646-2b780c9a5be0",
                        "source_sense_id": "19b042f2-9a29-3737-b83d-6a95a2d3c5c9",
                        "source_sense_description": "Eigenschaft/Haltung, sich um das Wohlbefinden anderer zu kümmern",
                        "target_lang_word": "care",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "care",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "171faab7-6596-3394-98d4-b242a697a501",
                                        "entry_id": "4c43fe73-19fa-3d9a-83ea-39a4e37bb0fb",
                                        "glosses": [
                                            "Close attention; concern; responsibility."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31beaeb9-e2bd-4fd7-a54a-e0102f5d2633",
                                                "sense_id": "171faab7-6596-3394-98d4-b242a697a501",
                                                "text": "Care should be taken when holding babies."
                                            },
                                            {
                                                "example_id": "f7161746-269e-4805-8d46-59c86caa560b",
                                                "sense_id": "171faab7-6596-3394-98d4-b242a697a501",
                                                "text": "I thank thee for thy care and honest pains."
                                            },
                                            {
                                                "example_id": "0a56a186-ca90-48ad-9f31-49b14b59687e",
                                                "sense_id": "171faab7-6596-3394-98d4-b242a697a501",
                                                "text": "‘Have a care, Buquet—ghosts like not to be seen or talked about!’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2697342b-2e61-31f3-9523-aa9663228d62",
                                        "entry_id": "4c43fe73-19fa-3d9a-83ea-39a4e37bb0fb",
                                        "glosses": [
                                            "Worry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afb46190-4912-4093-8004-0147edc52f15",
                                                "sense_id": "2697342b-2e61-31f3-9523-aa9663228d62",
                                                "text": "I don’t have a care in the world."
                                            },
                                            {
                                                "example_id": "47841688-4f83-47aa-bdbc-8df0222973a1",
                                                "sense_id": "2697342b-2e61-31f3-9523-aa9663228d62",
                                                "text": "Yes, heaven, I’m in heaven / And the cares that hung around me through the week / Seem to vanish like a gambler’s lucky streak"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8736ee49-20e3-3ae2-9851-e182dc9dffff",
                                        "entry_id": "4c43fe73-19fa-3d9a-83ea-39a4e37bb0fb",
                                        "glosses": [
                                            "Maintenance, upkeep."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "817105c0-b510-40b8-acfe-61eb1816c770",
                                                "sense_id": "8736ee49-20e3-3ae2-9851-e182dc9dffff",
                                                "text": "dental care"
                                            },
                                            {
                                                "example_id": "4f5947a5-044e-46b6-8169-96a537937a7f",
                                                "sense_id": "8736ee49-20e3-3ae2-9851-e182dc9dffff",
                                                "text": "Beside those things that are without, that which cometh upon me daily, the care of all the churches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6adb29fe-1a0b-37c5-bd53-c1f55f91fd12",
                                        "entry_id": "4c43fe73-19fa-3d9a-83ea-39a4e37bb0fb",
                                        "glosses": [
                                            "The treatment of those in need (especially as a profession)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a238c125-210b-4cf0-b7b5-30ba9bd5551a",
                                                "sense_id": "6adb29fe-1a0b-37c5-bd53-c1f55f91fd12",
                                                "text": "The US supreme court has ruled unanimously that natural human genes cannot be patented, a decision that scientists and civil rights campaigners said removed a major barrier to patient care and medical innovation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c9dd463-c949-3630-98d7-fa8843432556",
                                        "entry_id": "4c43fe73-19fa-3d9a-83ea-39a4e37bb0fb",
                                        "glosses": [
                                            "The state of being cared for by others."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "419842e3-b4d6-426a-bdec-a5556dba1019",
                                                "sense_id": "1c9dd463-c949-3630-98d7-fa8843432556",
                                                "text": "in care"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbeefc60-eaa6-3053-9290-4309f78c7357",
                                        "entry_id": "4c43fe73-19fa-3d9a-83ea-39a4e37bb0fb",
                                        "glosses": [
                                            "The object of watchful attention or anxiety."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f25c51a3-517f-45d7-98d9-47bbae1723bd",
                                                "sense_id": "bbeefc60-eaa6-3053-9290-4309f78c7357",
                                                "text": "Right sorrowfully mourning her bereaved cares."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e8712aa-238b-3959-83d6-50267fd9bcbe",
                                        "entry_id": "4c43fe73-19fa-3d9a-83ea-39a4e37bb0fb",
                                        "glosses": [
                                            "Grief, sorrow."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c117ce8e-3323-46df-b3d7-43754a38fa7b",
                                                "sense_id": "7e8712aa-238b-3959-83d6-50267fd9bcbe",
                                                "text": "More health and happiness betide my liege / Than can my care-tuned tongue deliver him!"
                                            },
                                            {
                                                "example_id": "3a104570-28db-433a-a867-3025690e3356",
                                                "sense_id": "7e8712aa-238b-3959-83d6-50267fd9bcbe",
                                                "text": "Sleep, that knits up the ravell'd sleave of care."
                                            },
                                            {
                                                "example_id": "f3b811f4-f530-473b-bed1-475c0f2f1e16",
                                                "sense_id": "7e8712aa-238b-3959-83d6-50267fd9bcbe",
                                                "text": "One day, among the days, he bethought him of this and fell lamenting for that the most part of his existence was past and he had not been vouchsafed a son, to inherit the kingdom after him, even as he had inherited it from his fathers and forebears; by reason whereof there betided him sore cark and care and chagrin exceeding."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "care",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40fb1661-d05e-3911-8f8f-757def524f68",
                                        "entry_id": "1b2d2882-0709-3a24-bb39-db4fbc2d1ba3",
                                        "glosses": [
                                            "To be concerned (about), to have an interest (in); to feel concern (about)."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "325bbf11-cdfc-49d0-bd66-e4830a5d8d95",
                                                "sense_id": "40fb1661-d05e-3911-8f8f-757def524f68",
                                                "text": "She doesn’t care what you think."
                                            },
                                            {
                                                "example_id": "151cf3f4-66f9-4910-bc2e-b3867a2b5420",
                                                "sense_id": "40fb1661-d05e-3911-8f8f-757def524f68",
                                                "text": "I don’t care, I’m still going."
                                            },
                                            {
                                                "example_id": "8d7c989b-6f15-4c96-9568-f15c9f08b546",
                                                "sense_id": "40fb1661-d05e-3911-8f8f-757def524f68",
                                                "text": "[…] What cares these roarers [i.e. thunder] for the name of king?[…]"
                                            },
                                            {
                                                "example_id": "5d0755f3-f13d-403f-98ab-ab373d0ed02d",
                                                "sense_id": "40fb1661-d05e-3911-8f8f-757def524f68",
                                                "text": "And no use for anyone to tell Charles that this was because the Family was in mourning for Mr Granville Darracott […]: Charles might only have been second footman at Darracott Place for a couple of months when that disaster occurred, but no one could gammon him into thinking that my lord cared a spangle for his heir."
                                            },
                                            {
                                                "example_id": "52f4b134-67cb-42d4-a863-e13ceeda42cb",
                                                "sense_id": "40fb1661-d05e-3911-8f8f-757def524f68",
                                                "text": "This newfound infatuation renders Bart uncharacteristically vulnerable. He suddenly has something to care about beyond causing trouble and makes a dramatic transformation from hell-raiser to gentleman about town."
                                            },
                                            {
                                                "example_id": "861bce69-e77e-47c6-831e-5845d73ef337",
                                                "sense_id": "40fb1661-d05e-3911-8f8f-757def524f68",
                                                "text": "No longer mind if I go / You pray enough, I might fall / Down, down, down, down, down / Why should I care what happens to me? / Why should I care what happens to me?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c4a6bc9-2ccd-3e44-b9a5-5e056f0cb585",
                                        "entry_id": "1b2d2882-0709-3a24-bb39-db4fbc2d1ba3",
                                        "glosses": [
                                            "To want, to desire; to like; to be inclined towards or interested in."
                                        ],
                                        "tags": [
                                            "formal",
                                            "intransitive",
                                            "polite"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e2a3f49-f048-46ab-9d2c-e5dfe32e868c",
                                                "sense_id": "4c4a6bc9-2ccd-3e44-b9a5-5e056f0cb585",
                                                "text": "Would you care for another slice of cake?"
                                            },
                                            {
                                                "example_id": "5dc5548b-2937-4d1c-808a-cf9fa9230df8",
                                                "sense_id": "4c4a6bc9-2ccd-3e44-b9a5-5e056f0cb585",
                                                "text": "Would you care to dance?"
                                            },
                                            {
                                                "example_id": "0278912f-72a6-462c-bfa8-774f9f587d6c",
                                                "sense_id": "4c4a6bc9-2ccd-3e44-b9a5-5e056f0cb585",
                                                "text": "I don’t care to hear your opinion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe4c50da-8b3b-3227-b755-8430cc9751f8",
                                        "entry_id": "1b2d2882-0709-3a24-bb39-db4fbc2d1ba3",
                                        "glosses": [
                                            "To be affected by, to treat as relevant for a subsequent course of action."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2689cc0a-c202-46b4-a276-54f732297a7a",
                                                "sense_id": "fe4c50da-8b3b-3227-b755-8430cc9751f8",
                                                "text": "An event aggregator facilitates a fire-and-forget model of communication. The object triggering the event doesn’t care if there are any subscribers. It just fires the event and moves on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4691be94-c67e-3ba5-8bd1-a797e221701a",
                                        "entry_id": "1b2d2882-0709-3a24-bb39-db4fbc2d1ba3",
                                        "glosses": [
                                            "(with for) To look after or look out for."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbe5b0f5-7825-42e8-b7bf-01b0b30bb62f",
                                                "sense_id": "4691be94-c67e-3ba5-8bd1-a797e221701a",
                                                "text": "Young children can learn to care for a pet."
                                            },
                                            {
                                                "example_id": "b5311641-6baf-4a5e-b725-491f1208b0c9",
                                                "sense_id": "4691be94-c67e-3ba5-8bd1-a797e221701a",
                                                "text": "He cared for his mother while she was sick."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "835363d4-c3c3-3373-b665-e4dee07eb75c",
                                        "entry_id": "1b2d2882-0709-3a24-bb39-db4fbc2d1ba3",
                                        "glosses": [
                                            "To mind; to object."
                                        ],
                                        "tags": [
                                            "Appalachia",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5be04642-ba1e-4667-bddf-7014839cfd3c",
                                                "sense_id": "835363d4-c3c3-3373-b665-e4dee07eb75c",
                                                "text": "After introducing herself, the therapist then asked the patient if it would be all right to do the exercises which the doctor had ordered for her. The patient would response, \"Well, I don't care to.\" For several days, the therapist immediately left the room and officially recorded that the patient had \"refused\" therapy. […] It was not until months later that this therapist […] discovered that she should have been interpreting \"I don't care to\" as \"I don't mind\" doing those exercises now."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
