                "entry_id": "13a25da2-c489-350b-8427-cc9ccb17a923",
                "word": "supermoon",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3a6da3c9-7dd6-43c0-ac0b-7fabef3b29d4",
                        "entry_id": "13a25da2-c489-350b-8427-cc9ccb17a923",
                        "tags": [
                            "plural"
                        ],
                        "form": "supermoons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d22d3b40-133d-3eef-9554-b2fab5e968eb",
                        "entry_id": "13a25da2-c489-350b-8427-cc9ccb17a923",
                        "glosses": [
                            "A full moon or new moon, when the Earth–Moon distance is in the lowest tenth of its range."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e850c6f-ed79-4abf-b589-0e3521f6bebe",
                                "sense_id": "d22d3b40-133d-3eef-9554-b2fab5e968eb",
                                "text": "And should the moon happen to hit its ever-shifting orbital perigee at the same time that it lies athwart from the sun, we are treated to a so-called supermoon, a full moon that can seem close enough to embrace – as much as 12 percent bigger and 30 percent brighter than the average full moon. […] Some astronomers dislike the whole supermoon hoopla. They point out that the term originated with astrology, not astronomy; that perigee full moons are not all that rare, coming an average of every 13 months; and that their apparently swollen dimensions are often as much a matter of optical illusion and wishful blinking as of relative lunar nearness."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a65a876f-be07-4356-8398-759a26542032",
                        "source_entry_id": "13a25da2-c489-350b-8427-cc9ccb17a923",
                        "source_sense_id": "d22d3b40-133d-3eef-9554-b2fab5e968eb",
                        "source_sense_description": "a full moon or new moon, when the Earth–Moon distance is in the lowest tenth of its range",
                        "target_lang_word": "superúplněk",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "superúplněk",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "b41a3431-4af1-3f61-8f27-55f4ef816978",
                                        "entry_id": "b0b17b22-0955-3f3a-a0c4-1c85366153b0",
                                        "glosses": [
                                            "úplněk Měsíce současně s jeho největším přiblížením k Zemi"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b4c51ee-6a0e-447c-aa4c-62d973a1256c",
                                                "sense_id": "b41a3431-4af1-3f61-8f27-55f4ef816978",
                                                "text": "Radost z pozorování letošního superúplňku lidem kazily dvě věci. První je, že Měsíc v době přiblížení Zemi příliš nezářil. Z oblohy jej totiž začalo vytlačovat slunce. Navíc se místy Měsíc schoval za mraky."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
