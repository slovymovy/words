                                "target_lang_word": "Dandenong",
                                "target_lang_sense_clarification": "localidad suburbana de Australia"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5d918c9-9849-344e-80ea-d6eeb218c972",
                    "sense_definition": "Short for the Dandenong Ranges, a mountain range in Victoria, Australia.",
