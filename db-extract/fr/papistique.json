                        "glosses": [
                            "Relatif aux papistes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bf70cc4-737a-488a-a6e9-629dc224cf05",
                                "sense_id": "cf188ab9-158a-3944-9f01-96b10af18131",
                                "text": "La plupart des ceremonies papistiques n'ont d'autre usage que de rendre le peuple stupide, plutost que de l'enseigner."
                            },
                            {
                                "example_id": "1090a612-c2dc-4e58-b7ec-d5dc815f40a6",
                                "sense_id": "cf188ab9-158a-3944-9f01-96b10af18131",
                                "text": "Ne me parlez [dira un socinien] ni d'Église, ni d'antiquité, ni de synode ; ce sont tous moyens papistiques."
                            },
                            {
                                "example_id": "8f72ff15-6fd6-4071-a667-bbbd3ad1cc30",
                                "sense_id": "cf188ab9-158a-3944-9f01-96b10af18131",
                                "text": "Ces messieurs de Londres ont une étrange démangeaison d'imprimer : on leur attribue un commentaire philosophique sur les paroles de saint Luc : Contrains-les d'entrer, qui, en faisant semblant de combattre les persécutions papistiques, va à établir la tolérance des sociniens."
                            },
                            {
                                "example_id": "59ddad31-dd77-4ff8-b4d7-649fe5ae7c9f",
                                "sense_id": "cf188ab9-158a-3944-9f01-96b10af18131",
                                "text": "Elle détestait la consubstantiation luthérienne avec la transsubstantiation papistique."
                            }
                        ]
                    }
