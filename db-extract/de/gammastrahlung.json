                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1fc72ec3-e3b6-36cb-b975-3218f7a62d4b",
                                        "entry_id": "c73decdb-e661-3102-a097-6224dd34d3b8",
                                        "glosses": [
                                            "Very high frequency (and therefore very high energy) electromagnetic radiation emitted as a consequence of radioactivity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe7c30cd-0e49-492a-aed7-163f36b65c26",
                                                "sense_id": "1fc72ec3-e3b6-36cb-b975-3218f7a62d4b",
                                                "text": "Doc Bruce Banner, belted by gamma rays,\nTurns into the Hulk – Ain’t he unglamour-rays! [unglamorous]\nWreckin’ the town with the power of a bull,\nAin’t no monster, clown. Who is as lovable\nAs ever-lovin’ Hulk? - Hulk! Hulk!"
                                            },
                                            {
                                                "example_id": "b3b080d2-eaeb-4235-8340-66636625d3ad",
                                                "sense_id": "1fc72ec3-e3b6-36cb-b975-3218f7a62d4b",
                                                "text": "There’s a tongue-in-cheek book titled “Learn Greek in 25 years,” but you’ll be surprised at how straightforward it is to learn the alphabet: those alpha males, beta releases and gamma rays have seen to that."
                                            }
                                        ]
                                    }
                                ]
                            }
