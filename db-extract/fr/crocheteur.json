                "senses": [
                    {
                        "sense_id": "6127f26e-1174-3c57-8b90-0169d91aaafb",
                        "entry_id": "cff9cf6d-08b7-3738-9c70-84f7cf7bd4bb",
                        "glosses": [
                            "Celui qui crochète."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cd2a8cf-4293-401c-9d94-27b0230fb570",
                                "sense_id": "6127f26e-1174-3c57-8b90-0169d91aaafb",
                                "text": "Crocheteur de serrures."
                            },
                            {
                                "example_id": "d139a19b-7fe0-42b2-83f3-10a10d7bc028",
                                "sense_id": "6127f26e-1174-3c57-8b90-0169d91aaafb",
                                "text": "Crocheteur de portes."
                            },
                            {
                                "example_id": "593f37a1-ad0d-439c-9bda-660fe07646dd",
                                "sense_id": "6127f26e-1174-3c57-8b90-0169d91aaafb",
                                "text": "Il ne lui répugnait pas de se comparer à un habile crocheteur de serrures qui, par ruse ou par violence, va prendre sa part de la richesse commune."
                            }
                        ]
                    },
                    {
                        "sense_id": "c2f42748-52be-3231-bac1-322ea04b198c",
                        "entry_id": "cff9cf6d-08b7-3738-9c70-84f7cf7bd4bb",
                        "glosses": [
                            "Celui qui porte des fardeaux avec des crochets."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60db29d5-8036-48f9-a3f7-9970a0b32357",
                                "sense_id": "c2f42748-52be-3231-bac1-322ea04b198c",
                                "text": "La charge d’un crocheteur."
                            },
                            {
                                "example_id": "8a655a47-0a59-4985-92e1-570c0bdbd26a",
                                "sense_id": "c2f42748-52be-3231-bac1-322ea04b198c",
                                "text": "Fort comme un crocheteur."
                            },
                            {
                                "example_id": "ded1e3d4-1463-4cae-9bd8-b91d54544547",
                                "sense_id": "c2f42748-52be-3231-bac1-322ea04b198c",
                                "text": "Des injures de crocheteur."
                            },
                            {
                                "example_id": "bc6dea92-a57c-48a0-8d50-4a8f52482598",
                                "sense_id": "c2f42748-52be-3231-bac1-322ea04b198c",
                                "text": "Un valet.— Monsieur, il vient d’arriver un domestique qui demande à vous parler ; il est suivi d’un crocheteur qui porte une valise."
                            },
                            {
                                "example_id": "a85a8142-2e71-44d3-9be8-910d4b121bf8",
                                "sense_id": "c2f42748-52be-3231-bac1-322ea04b198c",
                                "text": "Saint Jean devait être tout à fait le contraire d’un athlète : c’était, je le parierais, un beau jeune homme pâle et frêle, avec une expression mélancolique, et non une espèce de crocheteur dont la mine farouche aurait suffi pour intimider Hérode et Pilate."
                            }
                        ]
                    }
