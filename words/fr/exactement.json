                },
                {
                    "sense_id": "2b6c1627-3975-3f92-872c-310a786a975f",
                    "sense_definition": "Sert à confirmer un propos, à marquer une adhésion totale ou un accord complet.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "accord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "C'est <w>exactement</w> ce que je voulais dire pendant la réunion."
                        },
                        {
                            "text": "— Donc la réunion est reportée à jeudi ? — <w>Exactement</w>, à la même heure."
