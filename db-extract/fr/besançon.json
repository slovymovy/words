        "fr-extract.jsonl": [
            {
                "entry_id": "f0db10e5-60b7-3dfc-afb0-13378d4e5733",
                "word": "Besançon",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8710e55a-f43c-36a6-8187-8ce85a391315",
                        "entry_id": "f0db10e5-60b7-3dfc-afb0-13378d4e5733",
                        "glosses": [
                            "Commune et chef-lieu de département français, située dans le département du Doubs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89aaa5f3-2a44-4d2d-828a-bdb1a85a45c3",
                                "sense_id": "8710e55a-f43c-36a6-8187-8ce85a391315",
                                "text": "Besançon n’est pas seulement une des plus jolies villes de France, elle abonde en gens de cœur et d’esprit."
                            },
                            {
                                "example_id": "ee1fad3a-73b2-4b0d-baa4-e8e9b041bdc6",
                                "sense_id": "8710e55a-f43c-36a6-8187-8ce85a391315",
                                "text": "Besançon est une vieille ville, pleine de débris espagnols du XVIᵉ et du XVIIᵉ siècle. Presque tous les bâtiments y sont en grosses pierres et quartiers de roches, assis fortement les uns sur les autres. Cette solidité et cette durée, à côté de nos improvisations parisiennes, au sortir des manufactures lyonnaises, fait le plus vif plaisir."
                            },
                            {
                                "example_id": "8813b5e7-a871-415f-8aff-dd04ac52011a",
                                "sense_id": "8710e55a-f43c-36a6-8187-8ce85a391315",
                                "text": "— Tout à l’heure, quand M. Robin était là, quand il nous parlait des fusillés de Besançon, tu n’as pas remarqué qu’il semblait se retenir pour ne pas en dire plus ?"
                            },
                            {
                                "example_id": "312c7b2b-e6c6-42c6-af28-fc51587a2cc7",
                                "sense_id": "8710e55a-f43c-36a6-8187-8ce85a391315",
                                "text": "La présence d'un kursaal (salle des fêtes pour les curistes des villes d'eau) à Besançon montre assez l'influence germanique des régions voisines et rappelle que la ville fut une destination thermale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac035ead-d6df-48f0-9848-a9fc7c584d39",
                        "source_entry_id": "f0db10e5-60b7-3dfc-afb0-13378d4e5733",
                        "source_sense_id": "8710e55a-f43c-36a6-8187-8ce85a391315",
