                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "33f020de-f591-4536-accb-d8b4f688d608",
                        "entry_id": "50725ad5-8607-3dd3-b84c-733f3588347b",
                        "tags": [
                            "plural"
                        ],
                        "form": "overlights"
