                "senses": [
                    {
                        "sense_id": "be6d8c39-afdb-3f77-a4c2-47775b6f7911",
                        "entry_id": "abd9cfae-1ca3-34cd-9b40-d75628b7fe71",
                        "glosses": [
                            "Prinzip der Trennung von gesetzgebender, ausführender und richterlicher Gewalt in einem Staat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e4da854-7569-41c8-8808-90417a1e2240",
                                "sense_id": "be6d8c39-afdb-3f77-a4c2-47775b6f7911",
                                "text": "Das Prinzip der Gewaltenteilung ist eine der größten Errungenschaften der Zivilisation."
                            },
                            {
                                "example_id": "21622da8-3708-4069-8038-2a93bc6f0481",
                                "sense_id": "be6d8c39-afdb-3f77-a4c2-47775b6f7911",
                                "text": "„Das System der Gewaltenteilung stellt neben dem Rechtsstaat und den Menschenrechten die Basis unserer Demokratie dar.“"
                            },
                            {
                                "example_id": "e5f4e7ad-3c55-4723-b838-01348a8009b9",
                                "sense_id": "be6d8c39-afdb-3f77-a4c2-47775b6f7911",
                                "text": "„Ein grundlegendes Prinzip des österreichischen Staates ist die Gewaltenteilung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de98e600-d65e-4190-88dc-687e7b3fa50f",
                        "source_entry_id": "abd9cfae-1ca3-34cd-9b40-d75628b7fe71",
                        "source_sense_id": "be6d8c39-afdb-3f77-a4c2-47775b6f7911",
                        "source_sense_description": "Prinzip der Trennung von gesetzgebender, ausführender und richterlicher Gewalt in einem Staat",
                        "target_lang_word": "separation of powers",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "separation of powers",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aa729c93-bd20-3ca7-b764-1e0c6311ea6f",
                                        "entry_id": "355aae0d-ac7b-3aa4-9184-07a927bbdebe",
                                        "glosses": [
                                            "A theoretical model for governance, common in democratic states, which features the division of sovereign power into at least three (but sometimes up to six) organs of state in order to forestall tyranny, by preventing the acquisition of a monopoly of power by a monarch or oligarchy; also, such an arrangement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2b7d2b5-fc8c-4b08-8f53-1839bdb8754e",
                        "source_entry_id": "abd9cfae-1ca3-34cd-9b40-d75628b7fe71",
                        "source_sense_id": "be6d8c39-afdb-3f77-a4c2-47775b6f7911",
                        "source_sense_description": "Prinzip der Trennung von gesetzgebender, ausführender und richterlicher Gewalt in einem Staat",
                        "target_lang_word": "checks and balances",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "checks and balances",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f03c7442-4ff1-30ca-82c6-a5401bbce14b",
                                        "entry_id": "b03f74f1-d8ae-37c1-a5bb-ca75cb772742",
                                        "glosses": [
                                            "A system for multiple branches of government wherein each has some control over the actions of each of the others."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1670e53c-73b4-47b0-a151-b8078d1b282d",
                                                "sense_id": "f03c7442-4ff1-30ca-82c6-a5401bbce14b",
                                                "text": "The Constitution deliberately makes the President and the Congress competitors as well as partners. The Founding Fathers created an elaborate system of checks and balances to keep each partner self-reliant while still assuring their interdependence. No brief account can fully capture the complexity of this relationship, in which each partner contributes his own share of stubbornness, pride, hostility, warmth, suspicion, skill, and affection."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6570b2ed-a1a0-394a-9cb8-aeeaa83a0b58",
                                        "entry_id": "b03f74f1-d8ae-37c1-a5bb-ca75cb772742",
                                        "glosses": [
                                            "Somebody or something that ensures a system remains safe, honest, etc."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
