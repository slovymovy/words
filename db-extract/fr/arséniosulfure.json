                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d1dd776-e837-4168-ae2a-40ede37db317",
                                "sense_id": "074e9cd5-ff9e-326f-8f96-b7611bf1ef16",
                                "text": "[Le nickel] se trouve dans la nature à l'état d’oxyde de sulfure, d’arséniure, d’arséniosulfure, d’arsénite, de silicate etc."
                            },
                            {
                                "example_id": "91fa4df3-6839-46de-b1d2-c197165f3ac7",
                                "sense_id": "074e9cd5-ff9e-326f-8f96-b7611bf1ef16",
                                "text": "L’arséniosulfure de nickel a été trouvé dans un certain nombre de localités, formant des veinules ou même des veines un peu puissantes, dans des filons qui traversent les micaschistes ou d’autres terrains très-anciens."
                            },
                            {
                                "example_id": "0bbbb1fb-b0f6-4921-aeb5-54334125600e",
                                "sense_id": "074e9cd5-ff9e-326f-8f96-b7611bf1ef16",
                                "text": "On trouve quelquefois l’arsenic à l’état natif […]. Son minerai le plus important est le mispickel ou arséniosulfure de fer."
                            }
                        ]
