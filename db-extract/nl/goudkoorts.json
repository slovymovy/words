        "nl-extract.jsonl": [
            {
                "entry_id": "aa589e7c-fec2-39e0-8b5e-706a8dfd6df5",
                "word": "goudkoorts",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ce817e71-057b-3697-9330-7752d18ae567",
                        "entry_id": "aa589e7c-fec2-39e0-8b5e-706a8dfd6df5",
                        "glosses": [
                            "koortsige hebzucht bij goudzoekers en beursspeculanten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d794b233-f875-4cd6-a7ec-3c8babade954",
                                "sense_id": "ce817e71-057b-3697-9330-7752d18ae567",
                                "text": "Werklui en de bemanningen van de schepen in de haven van San Francisco verlieten hun werk, de twee kranten in San Francisco moesten hun deuren sluiten omdat het personeel besmet was door de goudkoorts en de meeste kustplaatsen stroomden leeg omdat de inwoners als toekomstige goudzoekers naar de goudvelden vertrokken."
                            },
                            {
                                "example_id": "f64f58ba-34e0-4d54-8c40-9815fa23d5b1",
                                "sense_id": "ce817e71-057b-3697-9330-7752d18ae567",
                                "text": "Toch is de huidige ‘’boom’’ van digitale munten niet duurzaam, waarschuwt hij. “Er zal veel worden geleerd en er zal veel geld verloren worden. De hoge koersen die we nu zien worden niet gedreven door gebruik, maar door het speculeren op een stijging. Het lijkt op een goudkoorts-mentaliteit.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "281eed40-c244-3b18-9797-ca08b4b01185",
                        "entry_id": "aa589e7c-fec2-39e0-8b5e-706a8dfd6df5",
                        "glosses": [
                            "buitensporig verlangen naar rijkdom"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0a5e764-05f6-4b4a-8ad9-ed235a8fe588",
                                "sense_id": "281eed40-c244-3b18-9797-ca08b4b01185",
                                "text": "Door een goudkoorts liet een groot deel van de bevolking zich begin jaren negentig door lepe zakenlieden verleiden tot deelname aan een piramidespel. De hoop om snel rijk te worden verdween als sneeuw voor de zon toen deze investeringsconstructie uiteindelijk als een kaartenhuis ineenstortte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "397a0aa8-cd3d-4cde-b5f2-3ebac51224e0",
                        "source_entry_id": "aa589e7c-fec2-39e0-8b5e-706a8dfd6df5",
                        "target_lang_word": "gold fever",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gold fever",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "14b4a7f9-de90-35fd-8237-c0c354564842",
                                        "entry_id": "50e6d32e-bfca-3692-997e-57315f131c42",
                                        "glosses": [
                                            "A feverish obsession with seeking gold ore; an era (figuratively an epidemic) during which this obsession grips a large number of people."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc70d66a-29b1-417f-ba1f-9b637b362d59",
                                                "sense_id": "14b4a7f9-de90-35fd-8237-c0c354564842",
                                                "text": "That was during the gold fever, when strangers descended on the town and all the shovels were plum sold out at the general store."
                                            },
                                            {
                                                "example_id": "7f86bd1a-2786-40fd-8eee-e3d8cbaf7e0f",
                                                "sense_id": "14b4a7f9-de90-35fd-8237-c0c354564842",
                                                "text": "He caught a real bad case of the gold fever that was going around at the time."
                                            },
                                            {
                                                "example_id": "88cebe5d-194a-4bb7-82d8-e37c2a567d82",
                                                "sense_id": "14b4a7f9-de90-35fd-8237-c0c354564842",
                                                "text": "It appears that a compositor had been engaged for the Northern Territory Times, and for a considerable time the editor seems to have led a comparatively unruffled existence; till in an evil hour the compositor was smitten with gold fever, and struck work."
                                            },
                                            {
                                                "example_id": "fab298c3-2152-4446-b313-a248102c2d90",
                                                "sense_id": "14b4a7f9-de90-35fd-8237-c0c354564842",
                                                "text": "Johns worked with the gold-fever in his veins and urged the camels on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02e13d53-86e1-345a-b457-8881bfb45e5a",
                                        "entry_id": "50e6d32e-bfca-3692-997e-57315f131c42",
                                        "glosses": [
                                            "An excessive craving for profit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
