                    {
                        "sense_id": "87948012-1519-302a-bc31-fa0947bf134f",
                        "entry_id": "bfeaf8aa-f487-30bd-88a7-b60b22eb717d",
                        "glosses": [
                            "Type d’habitat où les maisons d’un village sont groupées de façon non linéaire, par exemple autour de l'église."
                        ],
                        "tags": [
                            "Urbanisme"
                        ],
                        "examples": [
                            {
                                "example_id": "6365611e-8b7d-42f9-a339-943e2eb26cf2",
                                "sense_id": "87948012-1519-302a-bc31-fa0947bf134f",
                                "text": "Dès cette époque, des structures mixtes coexistent, ici ou là, entre les villages \"tas\" et les villages \"linéaires\"."
                            },
                            {
                                "example_id": "45fbfd72-e688-4de4-a070-87ea8cb2024a",
                                "sense_id": "87948012-1519-302a-bc31-fa0947bf134f",
                                "text": "Ce paysage implique souvent un habitat groupé en village-tas ou en village-rue."
                            },
                            {
                                "example_id": "51d25818-ccf8-4c2d-a113-1e845ae8b053",
                                "sense_id": "87948012-1519-302a-bc31-fa0947bf134f",
                                "text": "Dans d’autres lieux, c’est une structure plus complexe, plus ramassée, avec plusieurs rues qui se croisent et des îlots de maisons. On l’appelle le village-tas."
                            }
                        ]
                    }
