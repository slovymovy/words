                "senses": [
                    {
                        "sense_id": "c1bd9539-637f-353d-adc2-60a44d40758e",
                        "entry_id": "85980ca3-1099-37f2-b1a3-f88a75a0eba9",
                        "glosses": [
                            "Haltung, sich auf möglichst wenig zu beschränken"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "4cb083de-8e6f-430e-854c-4fd1e380a58c",
                                "sense_id": "c1bd9539-637f-353d-adc2-60a44d40758e",
                                "text": "„Im Inneren schloss sich dieser vorsichtige Minimalismus an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "09f3d7c2-e217-3b49-b188-91b76af5ea02",
                        "entry_id": "85980ca3-1099-37f2-b1a3-f88a75a0eba9",
                        "glosses": [
                            "unterschiedliche Ausprägungen der Darstellung in den verschiedenen Künsten mit einer Grundtendenz zur Reduktion/Vereinfachung"
                        ],
                        "tags": [
                            "meist Singular",
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "caad9412-2982-49ca-a6c7-91eac954db44",
                                "sense_id": "09f3d7c2-e217-3b49-b188-91b76af5ea02",
                                "text": "„Wenn wir nicht auf die korrekte Anzahl der Zeichen achten und einfache Tastaturtechniken verwenden, erzeugen wir sowohl einen Minimalismus (das Fehlen von Absätzen oder Punkten, sogar von Wörtern), als auch einen Maximalismus (mühelose, kaugummiartige Verlängerung von Buchstaben, Zeichen und Bildern).“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
