                    "frequency": "VeryLow",
                    "semantic_group_id": "hofbeamter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das renommierte Erzamt des <w>Schenken</w> bekleidete jahrhundertelang der König von Böhmen.",
                            "target_lang_translations": {
