{
    "word_family": [
        "implicatie",
        "impliciet"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fed35a1b-5876-3a36-b5fd-513b5d8dea61",
                    "sense_definition": "iets onuitgesproken laten blijken of als logisch gevolg met zich meebrengen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "betekenis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn stilzwijgen zou kunnen <w>impliceren</w> dat hij het met het voorstel eens is.",
                            "target_lang_translations": {
                                "en": "His silence could <w>imply</w> that he agrees with the proposal."
                            }
                        },
                        {
                            "text": "Deze nieuwe wet zal een grote verandering voor alle burgers <w>impliceren</w>.",
                            "target_lang_translations": {
                                "en": "This new law will <w>entail</w> a major change for all citizens."
                            }
                        }
                    ],
                    "synonyms": [
                        "betekenen",
                        "inhouden",
                        "onderstellen"
                    ],
                    "antonyms": [
                        "expliciteren"
                    ],
                    "common_phrases": [
                        "zou kunnen impliceren",
                        "een verandering impliceren"
                    ],
                    "target_lang_definitions": {
                        "en": "To suggest something without stating it directly, or to have something as a necessary or logical consequence."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "imply",
                                "target_lang_sense_clarification": "to suggest or entail"
                            },
                            {
                                "target_lang_word": "entail",
                                "target_lang_sense_clarification": "to involve as a necessary consequence"
                            },
                            {
                                "target_lang_word": "mean",
                                "target_lang_sense_clarification": "to signify or result in"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ccaded22-8a90-352d-b6df-93355caa1721",
                    "sense_definition": "iemand of iets betrekken bij een misdaad, schandaal of een andere negatieve situatie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "betrokkenheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De getuige probeerde de directeur te <w>impliceren</w> in de fraudezaak.",
                            "target_lang_translations": {
                                "en": "The witness tried to <w>implicate</w> the director in the fraud case."
                            }
                        },
                        {
                            "text": "Er is geen bewijs om hem bij deze diefstal te <w>impliceren</w>.",
                            "target_lang_translations": {
                                "en": "There is no evidence to <w>implicate</w> him in this theft."
                            }
                        }
                    ],
                    "synonyms": [
                        "betrekken",
                        "verwikkelen"
                    ],
                    "antonyms": [
                        "vrijpleiten"
                    ],
                    "common_phrases": [
                        "in een schandaal impliceren",
                        "bij een misdaad impliceren"
                    ],
                    "target_lang_definitions": {
                        "en": "To involve someone or something in a crime, scandal, or other negative situation."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "implicate",
                                "target_lang_sense_clarification": "to show someone is involved in a crime"
                            },
                            {
                                "target_lang_word": "involve",
                                "target_lang_sense_clarification": "to connect someone to a situation"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}