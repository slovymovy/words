                "senses": [
                    {
                        "sense_id": "e671f487-e248-3767-972a-dfad4e3ffc0f",
                        "entry_id": "2f715a87-2b9b-3670-bd00-f849042dedab",
                        "glosses": [
                            "Aktienindex, bei dessen Berechnung die Ausschüttungen (Dividenden) mitberücksichtigt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1b7329e-258d-4810-9a30-85c9f78c81a3",
                                "sense_id": "e671f487-e248-3767-972a-dfad4e3ffc0f",
                                "text": "„Bei einem Performanceindex, wie etwa dem Dax, werden auch Dividendenzahlungen eingerechnet.“"
                            },
                            {
                                "example_id": "154a4e4d-358b-4f9e-a104-fe055bf93c08",
                                "sense_id": "e671f487-e248-3767-972a-dfad4e3ffc0f",
                                "text": "„Auch dem deutschen Aktienmarkt ist es seither nicht gelungen, das Kursniveau der Jahrtausendwende nachhaltig zu übertreffen. Denn der Leitindex Dax ist im Gegensatz zu den meisten anderen Börsenbarometern ein sogenannter Performanceindex, in dem Dividendenzahlungen der Unternehmen berücksichtigt werden.“"
                            },
                            {
                                "example_id": "40afef48-ce60-4a43-961a-00dde55d7713",
                                "sense_id": "e671f487-e248-3767-972a-dfad4e3ffc0f",
                                "text": "„Der Deutsche Aktienindex (DAX) der Deutsche Börse AG ist ebenfalls ein Performanceindex, der die Wertentwick-lung eines Portefeuilles von 30 Standardwerten abbildet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
