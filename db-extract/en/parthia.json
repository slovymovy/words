                                        "entry_id": "1f67a9a1-c6c4-37ad-b799-976d560744ef",
                                        "glosses": [
                                            "antike Landschaft im Norden des heutigen Iran und im Süden des heutigen Turkmenistan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "952255ee-bdff-4db4-9e72-066fe4d9571a",
                                                "sense_id": "72a55906-a6d7-31eb-a81f-9a513b4c422b",
                                                "text": "„Ich muss Dich davon überzeugen, dass nicht bloß in Parthien, sondern auch in Rom Barbaren leben, und dass die Art, wie sie Deine Treue und Gutmütigkeit ausnutzen, gefährlicher ist als jeder parthische Pfeil.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
