                        "sense_id": "b0fdc906-72c5-3702-abd9-46871d403555",
                        "entry_id": "cfd741b3-3707-37ed-8f52-29c656784658",
                        "glosses": [
                            "Zigarettenpapier, das länger und oft auch breiter als gewöhnliches ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3df9a715-66d1-4456-816d-84d56e5e58a2",
                                "sense_id": "b0fdc906-72c5-3702-abd9-46871d403555",
                                "text": "Mit dem Longpaper kann man länger rauchen."
                            },
                            {
                                "example_id": "fdb04398-3c0b-468c-bfe6-52b53e58f18c",
                                "sense_id": "b0fdc906-72c5-3702-abd9-46871d403555",
                                "text": "„Die Handlung ist schnell auf einem ausgerollten Longpaper notiert: Dimitri lebt in einer heruntergekommenen Wohnanlage irgendwo bei Osnabrück und hat ein ‚Scheißleben‘.“"
                            },
                            {
                                "example_id": "ce87b07e-e76f-46d2-8125-1a252ebc43d5",
                                "sense_id": "b0fdc906-72c5-3702-abd9-46871d403555",
                                "text": "„Wie sich herausstellte handelte es sich dabei um eine Tabak-Marihuanamischung samt Longpaper.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
