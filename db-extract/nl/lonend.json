                                                "sense_id": "744aa830-5303-3ac1-949a-b70f740055d7",
                                                "text": "effective immediately"
                                            },
                                            {
                                                "example_id": "e2a3dbee-98cf-4d48-9fc3-6cc9b9b931ce",
                                                "sense_id": "744aa830-5303-3ac1-949a-b70f740055d7",
                                                "text": "The curfew is effective at midnight."
