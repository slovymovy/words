                    }
                ],
                "senses": [
                    {
                        "sense_id": "55dcb52c-012c-3b44-a3c5-1941766ddc9a",
                        "entry_id": "7cff9d27-42c4-375c-aacb-e69b196ebf15",
                        "glosses": [
                            "nicht stimmungsgemäß; eine Gefühlserregung habend, die nicht zur Situation passt; einen inadäquaten Affekt habend (beispielsweise heiteres Lachen auf einer Beerdigung)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efa47fee-e232-4cc7-8aad-4fe2a62077ea",
                                "sense_id": "55dcb52c-012c-3b44-a3c5-1941766ddc9a",
                                "text": "Parathyme Affekte weisen auf Schizophrenie hin."
                            },
                            {
                                "example_id": "e3231a21-b86c-462f-8b7f-20774a5cbc44",
                                "sense_id": "55dcb52c-012c-3b44-a3c5-1941766ddc9a",
                                "text": "„Und was machen wir mit den schizophrenen Patienten, die in diesen Experimenten bis auf eine hin und wieder einschießende, parathym anmutende Gesichtsbewegung keine große Regung zeigten, aber hinterher berichteten, sie hätten sich seit Jahren nicht mehr so ‚beeumelt‘.“"
                            },
                            {
                                "example_id": "ffb645b5-1536-414e-8ffe-6190f67464a1",
                                "sense_id": "55dcb52c-012c-3b44-a3c5-1941766ddc9a",
                                "text": "„Parathyme psychotische Symptome bei affektiven Störungen rechtfertigen die Diagnose einer schizoaffektiven Störung nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
