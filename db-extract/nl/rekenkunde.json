                                "target_senses": [
                                    {
                                        "sense_id": "39a6d8c1-0be6-3955-9202-4183e60c84b7",
                                        "entry_id": "5eeb4a78-1a23-341d-b6b8-0936de15c78e",
                                        "glosses": [
                                            "Teilgebiet der Mathematik, welches sich mit dem Rechnen mit Zahlen, den Grundrechenarten und den entsprechenden Rechengesetzen befasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21718752-9208-43bd-96f5-91d87488aa60",
                                                "sense_id": "39a6d8c1-0be6-3955-9202-4183e60c84b7",
                                                "text": "„Im Sonderforschungsbereich/Transregio 45 werden 'Perioden, Modulräume und Arithmetik algebraischer Varietäten' erforscht.“"
                                            },
                                            {
                                                "example_id": "6583df70-259d-43a0-844f-68d954f9472d",
                                                "sense_id": "39a6d8c1-0be6-3955-9202-4183e60c84b7",
                                                "text": "„Sowohl in der Arithmetik als auch in der Geometrie entwickeln die Pythagoreer einen neuen Umgang mit Mathematik.“"
                                            },
                                            {
                                                "example_id": "3fb8b3f6-1c62-4d8e-a2af-9d1cb1d02bee",
                                                "sense_id": "39a6d8c1-0be6-3955-9202-4183e60c84b7",
                                                "text": "„Da nun alle Verschiedenheit der Arithmetiken von der Verschiedenheit dieser Bestimmung abhängt, so ist klar, daß unendlich viele verschiedene Arithmetiken möglich sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "64f15f28-caba-3e58-821b-6f8fdf2cfd80",
                                        "entry_id": "5eeb4a78-1a23-341d-b6b8-0936de15c78e",
                                        "glosses": [
                                            "Lehrbuch von [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61a6ff86-8864-428d-92a3-6a7d982a8ef8",
                                                "sense_id": "64f15f28-caba-3e58-821b-6f8fdf2cfd80",
                                                "text": "„Die zeitgenössischen Arithmetiken sind voll von Beispielen für derartige Rechnungen, die mit der Regeldetri beziehungsweise dem Kettensatz gelöst werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ae6d520-1067-4331-9e34-24274c82af98",
