                    {
                        "sense_id": "eeb1660e-a24f-3cf1-8712-ed991d225c76",
                        "entry_id": "9381afc6-f8a0-344a-98ad-08e4df1ce69d",
                        "glosses": [
                            "das spezielle Verfahren des Punktschweißens"
                        ],
                        "tags": [
                            "Metallverarbeitung"
                        ],
                        "examples": [
                            {
                                "example_id": "bf070d90-d9db-4f44-b653-08d85f5d8f7d",
                                "sense_id": "eeb1660e-a24f-3cf1-8712-ed991d225c76",
                                "text": "„Mit der Punktschweißung können eine ganze Reihe Arbeiten erledigt werden, so z.B. das Zusammenschweißen von zwei und mehreren Blechen, die Befestigung eines Winkeleisens an ein Blech, das Anschweißen des Winkeleisenringes als oberer Abschluß eines Blechgefäßes, das Anschweißen eines Henkelgriffes, das kreuzweise Verschweißen von Grundeisen und Profileisen, das Zusammenschweißen von zwei Ringen u.a.m.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1e6cd1ef-a279-354b-805d-bcb34a2b1332",
                        "entry_id": "9381afc6-f8a0-344a-98ad-08e4df1ce69d",
                        "glosses": [
                            "eine durch das Verfahren des Punktschweißens hergestellte Verbindung"
                        ],
                        "tags": [
                            "Metallverarbeitung"
                        ],
                        "examples": [
                            {
                                "example_id": "b54164ad-6c9a-4eae-970c-e1cb17928ffd",
                                "sense_id": "1e6cd1ef-a279-354b-805d-bcb34a2b1332",
                                "text": "Punktschweißungen können leider nur durch Zerstören geprüft werden."
                            }
                        ],
                        "sense_index_json": "\"2\""
