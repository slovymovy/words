                {
                    "sense_id": "8366b257-23ed-3ad2-9d72-5e478dd5fa61",
                    "sense_definition": "Initialism of Organization of American States.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "international_organizations",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "The <w>OAS</w> sent observers to monitor the democratic elections in the region.",
                            "target_lang_translations": {
                                "ru": "<w>ОАГ</w> направила наблюдателей для мониторинга демократических выборов в регионе."
                            }
                        },
                        {
                            "text": "Many countries in the Western Hemisphere are active members of the <w>OAS</w>.",
                            "target_lang_translations": {
                                "ru": "Многие страны Западного полушария являются активными членами <w>ОАГ</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "member of the OAS",
                        "OAS general assembly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Организация американских государств (ОАГ)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ОАГ",
                                "target_lang_sense_clarification": "Организация американских государств"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b025e8e-e0c1-3d7b-b9f6-5bc2cb5ccccd",
                    "sense_definition": "Initialism of Old Age Security, a Canadian government pension program.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "social_programs",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "Canadian seniors usually receive <w>OAS</w> pension payments once they turn sixty-five.",
