                "senses": [
                    {
                        "sense_id": "519ced84-e549-3384-8bbb-0171ef5e1bfd",
                        "entry_id": "ef45f259-47b0-37b5-8548-3ddc3f3fe25a",
                        "glosses": [
                            "Schicksal des unfreiwilligen Verlassens der Heimat"
                        ],
                        "tags": [
                            "nur Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "3c8581e0-e297-46c1-9ead-01415b81ede7",
                                "sense_id": "519ced84-e549-3384-8bbb-0171ef5e1bfd",
                                "text": "„Bei der einen Zielgruppe handelt es sich um junge Menschen zwischen 18 und 25 Jahren mit und ohne Fluchthintergrund; diese wurden vor ihrem Wechsel in das Wohnheim in einer Einrichtung der Jugendhilfe intensiv betreut.“"
                            },
                            {
                                "example_id": "e9e4cc46-1193-4378-a4dd-080639b7fc83",
                                "sense_id": "519ced84-e549-3384-8bbb-0171ef5e1bfd",
                                "text": "„Ein Wohnprojekt für Menschen mit und ohne Fluchthintergrund wird demnächst in Wien-Favoriten Realität.“"
                            },
                            {
                                "example_id": "c2c61ec4-2ced-404f-ad8d-e46fc94b8bfb",
                                "sense_id": "519ced84-e549-3384-8bbb-0171ef5e1bfd",
                                "text": "„Bisher ist nicht bekannt, inwieweit Kinder und Familien mit Fluchthintergrund explizit in die Planungen mit einbezogen werden.“"
                            },
                            {
                                "example_id": "29168785-e4bb-491a-94a4-957dce6a1ad5",
                                "sense_id": "519ced84-e549-3384-8bbb-0171ef5e1bfd",
                                "text": "„Dass Kinder mit Fluchthintergrund gerade in Schulen kommen, in denen die Schüler selber zu kämpfen haben, ist für Sadek-Stolz kontraproduktiv.“"
                            },
                            {
                                "example_id": "7c7e2e4e-0f09-46c5-b433-8be0ddfa34aa",
                                "sense_id": "519ced84-e549-3384-8bbb-0171ef5e1bfd",
                                "text": "„Welche Perspektiven haben und geben Journalisten mit Fluchthintergrund, welche Projekte gibt es bereits?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7a132d5b-4096-3079-b1d3-2ace4b3166a9",
                        "entry_id": "ef45f259-47b0-37b5-8548-3ddc3f3fe25a",
                        "glosses": [
                            "Gesamtheit der Ursachen und Begleitumstände des unfreiwilligen Verlassens der Heimat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17f99050-e50a-4dcd-82df-433d97dbde31",
                                "sense_id": "7a132d5b-4096-3079-b1d3-2ace4b3166a9",
                                "text": "„Zu den rechtlichen Hürden kommen die psychosozialen Folgen nicht nur der Flucht und der Fluchthintergründe sondern auch der hier vorgefundenen Lebensbedingungen, die von einem gesellschaftlichen Ausschluss geprägt sind.“"
                            },
                            {
                                "example_id": "82265b58-5f8b-4943-b31c-e9ce21dd3b43",
                                "sense_id": "7a132d5b-4096-3079-b1d3-2ace4b3166a9",
                                "text": "„Seit Inkrafttreten des Zuwanderungsgesetzes werden auch nichtstaatliche und geschlechtsspezifische Fluchthintergründe als asylrelevant anerkannt.“"
                            },
                            {
                                "example_id": "869aadda-a671-4191-9454-dd8b4998e494",
                                "sense_id": "7a132d5b-4096-3079-b1d3-2ace4b3166a9",
                                "text": "„Damit wird eine eklatante Verkennung der sozialen und Fluchthintergründe der Flüchtlinge immer wieder reproduziert.“"
                            },
                            {
                                "example_id": "295ab7ca-cd57-4cee-8cd0-9d94ec75c24c",
                                "sense_id": "7a132d5b-4096-3079-b1d3-2ace4b3166a9",
                                "text": "„Zum Auftakt am 18. November berichten ein syrischer Flüchtling und eine deutsche Sozialarbeiterin über Fluchthintergründe und -motive sowie über Zukunftsperspektiven.“"
                            },
                            {
                                "example_id": "93355eae-d96d-4f34-8779-bd59ccee1cf1",
                                "sense_id": "7a132d5b-4096-3079-b1d3-2ace4b3166a9",
                                "text": "„Dabei werde ich betrachten, inwiefern ein Zusammenhang zwischen der Religion Islam und Fluchtmotiven besteht, also ob islam-immanente Aspekte als Fluchthintergrund bestehen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
