                            {
                                "example_id": "f4b7525f-cc17-428e-8d95-570045f2479f",
                                "sense_id": "529a407d-fbce-3c0a-9e32-add3c60a977b",
                                "text": "Am 13. September 2012 wurde bekannt, dass Quaas einen Eintrag im Guinness-Buch der Rekorde als „älteste Turnerin der Welt“ erhält."
                            },
                            {
                                "example_id": "3293bd7b-7c00-4117-a066-a22b2020eb17",
                                "sense_id": "529a407d-fbce-3c0a-9e32-add3c60a977b",
                                "text": "Martin Quaas studierte von 1993 bis 1998 an der Universität Duisburg-Essen und erlangte dort 1998 sein Diplom in theoretischer Physik."
                            }
