{
    "word_family": [
        "vary",
        "variable",
        "variability",
        "variant",
        "variance",
        "variety",
        "various"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "68946ad5-9d34-3aef-bc8f-0ed6164d96f5",
                    "sense_definition": "A change or difference in amount, level, or condition.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a wide <w>variation</w> in house prices across the different regions.",
                            "target_lang_translations": {
                                "ru": "Существует большой <w>разброс</w> цен на жилье в разных регионах.",
                                "zh": "不同地区之间的房价存在巨大的<w>差异</w>。"
                            }
                        },
                        {
                            "text": "The slight <w>variation</w> in temperature can affect the outcome of the experiment.",
                            "target_lang_translations": {
                                "ru": "Незначительное <w>изменение</w> температуры может повлиять на результат эксперимента.",
                                "zh": "温度的轻微<w>变化</w>可能会影响实验结果。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wide variation",
                        "slight variation",
                        "seasonal variation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменение или различие в количестве, уровне или состоянии.",
                        "zh": "数量、水平或状态上的变化或差异。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изменение",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "разброс",
                                "target_lang_sense_clarification": "разница в значениях, диапазоне"
                            },
                            {
                                "target_lang_word": "колебание",
                                "target_lang_sense_clarification": "непостоянство уровня или состояния"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "变化",
                                "target_lang_sense_clarification": "一般意义上的改变"
                            },
                            {
                                "target_lang_word": "差异",
                                "target_lang_sense_clarification": "不同之处"
                            },
                            {
                                "target_lang_word": "波动",
                                "target_lang_sense_clarification": "水平或状态的不稳定"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72441db1-e8d4-38b8-9de8-f586a5842b9d",
                    "sense_definition": "A thing that is different from other things in the same general group; a different version of something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This soup is a delicious <w>variation</w> on a traditional family recipe.",
                            "target_lang_translations": {
                                "ru": "Этот суп — вкусная <w>вариация</w> на тему традиционного семейного рецепта.",
                                "zh": "这道汤是对传统家庭食谱的一种美味<w>变体</w>。"
                            }
                        },
                        {
                            "text": "We played a <w>variation</w> of the game that included extra rules.",
                            "target_lang_translations": {
                                "ru": "Мы играли в <w>вариант</w> этой игры, включающий дополнительные правила.",
                                "zh": "我们玩了这个游戏的另一种<w>变体</w>，其中包含额外的规则。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "variation on",
                        "variation of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нечто, отличающееся от других вещей той же группы; иная версия чего-либо.",
                        "zh": "同一大类中与其他事物不同的东西；某事物的不同版本。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вариант",
                                "target_lang_sense_clarification": "версия, видоизменение"
                            },
                            {
                                "target_lang_word": "разновидность",
                                "target_lang_sense_clarification": "вид, тип"
                            },
                            {
                                "target_lang_word": "вариация",
                                "target_lang_sense_clarification": "творческая переработка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "变体",
                                "target_lang_sense_clarification": "不同版本"
                            },
                            {
                                "target_lang_word": "变种",
                                "target_lang_sense_clarification": "不同种类"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ee70714-205e-3ed3-83fe-3d2297465833",
                    "sense_definition": "A difference in physical traits or genetic makeup among individuals of a group.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Genetic <w>variation</w> is essential for a species to adapt to changing environments.",
                            "target_lang_translations": {
                                "ru": "Генетическая <w>изменчивость</w> необходима виду для адаптации к меняющимся условиям среды.",
                                "zh": "遗传<w>变异</w>对于物种适应不断变化的环境至关重要。"
                            }
                        },
                        {
                            "text": "The study focused on the <w>variation</w> in beak size among the island birds.",
                            "target_lang_translations": {
                                "ru": "Исследование было сосредоточено на <w>различиях</w> в размере клюва среди птиц острова.",
                                "zh": "这项研究聚焦于岛上鸟类喙部大小的<w>差异</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "genetic variation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Различие в физических признаках или генетическом строении среди особей группы.",
                        "zh": "群体中个体在身体特征或遗传构成上的差异。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изменчивость",
                                "target_lang_sense_clarification": "биологическое свойство"
                            },
                            {
                                "target_lang_word": "различие",
                                "target_lang_sense_clarification": "отличие в признаках"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "变异",
                                "target_lang_sense_clarification": "生物学上的遗传差异"
                            },
                            {
                                "target_lang_word": "差异",
                                "target_lang_sense_clarification": "特征上的不同"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b358d30-dcc1-3132-8ca0-fb13afbe56ff",
                    "sense_definition": "A musical technique where a theme is repeated with changes to the rhythm, melody, or harmony.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The composer wrote a set of <w>variations</w> based on a popular folk tune.",
                            "target_lang_translations": {
                                "ru": "Композитор написал цикл <w>вариаций</w>, основанных на популярной народной мелодии.",
                                "zh": "作曲家根据一首流行的民间曲调写了一组<w>变奏</w>曲。"
                            }
                        },
                        {
                            "text": "Her performance of the final <w>variation</w> was technically flawless and moving.",
                            "target_lang_translations": {
                                "ru": "Её исполнение финальной <w>вариации</w> было технически безупречным и трогательным.",
                                "zh": "她对最后一段<w>变奏</w>的演绎在技术上无懈可击，且十分动人。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "theme and variations"
                    ],
                    "target_lang_definitions": {
                        "ru": "Музыкальная техника, при которой тема повторяется с изменениями ритма, мелодии или гармонии.",
                        "zh": "一种音乐技巧，通过改变节奏、旋律或和声来重复主题。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вариация",
                                "target_lang_sense_clarification": "музыкальный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "变奏",
                                "target_lang_sense_clarification": "音乐术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "835eb7a8-3688-3b3e-bf79-50ec4f49e234",
                    "sense_definition": "The angle between magnetic north and true north.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain adjusted the ship's course to account for magnetic <w>variation</w>.",
                            "target_lang_translations": {
                                "ru": "Капитан скорректировал курс корабля с учетом магнитного <w>склонения</w>.",
                                "zh": "船长调整了航向以考虑<w>磁偏角</w>的影响。"
                            }
                        },
                        {
                            "text": "You must calculate the <w>variation</w> correctly to navigate with a compass.",
                            "target_lang_translations": {
                                "ru": "Вы должны правильно рассчитать <w>склонение</w>, чтобы ориентироваться по компасу.",
                                "zh": "你必须正确计算<w>磁偏角</w>才能使用指南针导航。"
                            }
                        }
                    ],
                    "synonyms": [
                        "magnetic declination"
                    ],
                    "common_phrases": [
                        "magnetic variation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Угол между магнитным и истинным севером.",
                        "zh": "磁北与真北之间的夹角。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "склонение",
                                "target_lang_sense_clarification": "магнитное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "磁偏角",
                                "target_lang_sense_clarification": "地理与航海术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6a68aed-10bc-30bd-8b11-6fd33ce8096f",
                    "sense_definition": "The use of different linguistic forms to express the same meaning within a language.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Regional <w>variation</w> in pronunciation is common in large countries.",
                            "target_lang_translations": {
                                "ru": "Региональное <w>варьирование</w> произношения распространено в больших странах.",
                                "zh": "在大国中，发音的地域性<w>变体</w>很常见。"
                            }
                        },
                        {
                            "text": "Sociolinguists study language <w>variation</w> across different social groups.",
                            "target_lang_translations": {
                                "ru": "Социолингвисты изучают языковое <w>варьирование</w> в различных социальных группах.",
                                "zh": "社会语言学家研究不同社会群体之间的语言<w>变体</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "language variation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Использование различных языковых форм для выражения одного и того же значения.",
                        "zh": "在语言内部使用不同的语言形式来表达相同的意思。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "варьирование",
                                "target_lang_sense_clarification": "лингвистический процесс"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "变体",
                                "target_lang_sense_clarification": "语言学中的形式差异"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d87f62c3-8ef5-33e7-8e19-0e4e58442794",
                    "sense_definition": "A specific sequence of moves in a game like chess that differs from the main line of play.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The grandmaster analyzed a complex <w>variation</w> of the opening defense.",
                            "target_lang_translations": {
                                "ru": "Гроссмейстер проанализировал сложный <w>вариант</w> защиты в дебюте.",
                                "zh": "特级大师分析了开局防御中一种复杂的<w>变着</w>。"
                            }
                        },
                        {
                            "text": "He played a rare <w>variation</w> that surprised his opponent.",
                            "target_lang_translations": {
                                "ru": "Он разыграл редкий <w>вариант</w>, который удивил его соперника.",
                                "zh": "他走出了一步罕见的<w>变着</w>，令对手感到惊讶。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенная последовательность ходов в игре (например, в шахматах), отличающаяся от основной линии.",
                        "zh": "游戏中（如国际象棋）与主要走法不同的特定走法序列。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вариант",
                                "target_lang_sense_clarification": "шахматный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "变着",
                                "target_lang_sense_clarification": "棋类术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91d2afb6-8c3f-3901-a331-183434424605",
                    "sense_definition": "A deviation of a celestial body from its mean orbit or motion.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Astronomers calculated the <w>variation</w> in the moon's orbit.",
                            "target_lang_translations": {
                                "ru": "Астрономы вычислили <w>вариацию</w> орбиты Луны.",
                                "zh": "天文学家计算了月球轨道的<w>摄动</w>。"
                            }
                        },
                        {
                            "text": "This small <w>variation</w> led to the discovery of a new planet.",
                            "target_lang_translations": {
                                "ru": "Это небольшое <w>отклонение</w> привело к открытию новой планеты.",
                                "zh": "这种微小的<w>偏差</w>导致了一颗新行星的发现。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отклонение небесного тела от его средней орбиты или движения.",
                        "zh": "天体偏离其平均轨道或运动的现象。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отклонение",
                                "target_lang_sense_clarification": "девиация"
                            },
                            {
                                "target_lang_word": "вариация",
                                "target_lang_sense_clarification": "астрономический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "偏差",
                                "target_lang_sense_clarification": "偏离正常轨道"
                            },
                            {
                                "target_lang_word": "摄动",
                                "target_lang_sense_clarification": "天文学术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}