    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "957501d7-1c5f-3b8d-986e-03824edb113e",
                    "sense_definition": "Принадлежащий им; относящийся к третьему лицу множественного числа.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "possessive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это <w>их</w> новый дом за городом.",
                            "target_lang_translations": {
                                "pl": "To jest <w>ich</w> nowy dom za miastem."
                            }
                        },
                        {
                            "text": "Мы внимательно слушали <w>их</w> советы перед дальней поездкой.",
                            "target_lang_translations": {
                                "pl": "Uważnie słuchaliśmy <w>ich</w> rad przed daleką podróżą."
                            }
                        }
                    ],
                    "synonyms": [
                        "ихний"
                    ],
                    "common_phrases": [
                        "их дом",
                        "их дети",
                        "их мнение"
                    ],
                    "target_lang_definitions": {
                        "pl": "Należący do nich; zaimek dzierżawczy dla trzeciej osoby liczby mnogiej."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ich",
                                "target_lang_sense_clarification": "zaimek dzierżawczy (należący do nich)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8c5fe29-7ea2-3241-b41b-a1dd251b890e",
                    "sense_definition": "Форма винительного падежа местоимения <w>они</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "case_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Учитель давно знает <w>их</w> и всегда готов помочь.",
                            "target_lang_translations": {
                                "pl": "Nauczyciel zna <w>ich</w> od dawna i zawsze jest gotowy pomóc."
                            }
                        },
                        {
                            "text": "Мы часто видим <w>их</w> в парке по выходным.",
                            "target_lang_translations": {
                                "pl": "Często widujemy <w>ich</w> w parku w weekendy."
                            }
                        }
                    ],
                    "common_phrases": [
                        "видеть их",
                        "знать их"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "винительный падеж"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Forma biernika zaimka osobowego liczby mnogiej (oni / one)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ich",
                                "target_lang_sense_clarification": "biernik od oni (męskoosobowy)"
                            },
                            {
                                "target_lang_word": "je",
                                "target_lang_sense_clarification": "biernik od one (niemęskoosobowy)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfa9bae1-7302-321b-a8b7-2b408dac9010",
                    "sense_definition": "Форма родительного падежа местоимения <w>они</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "case_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Сегодня <w>их</w> нет дома, они уехали за город.",
                            "target_lang_translations": {
                                "pl": "Dzisiaj nie ma <w>ich</w> w domu, wyjechali za miasto."
                            }
                        },
                        {
                            "text": "Для <w>их</w> безопасности были приняты все необходимые меры.",
                            "target_lang_translations": {
                                "pl": "Dla <w>ich</w> bezpieczeństwa podjęto wszelkie niezbędne środki."
                            }
                        }
                    ],
                    "common_phrases": [
                        "нет их",
                        "для их"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "родительный падеж"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Forma dopełniacza zaimka osobowego liczby mnogiej (oni / one)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ich",
                                "target_lang_sense_clarification": "dopełniacz od oni / one"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb92c91a-c777-3468-9c71-ac577ce0e1a8",
                    "sense_definition": "Форма родительного и винительного падежей устаревшего местоимения женского рода <w>оне</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "case_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В старинном романе автор описывал сестёр и вспоминал <w>их</w> с глубокой нежностью.",
                            "target_lang_translations": {
                                "pl": "W dawnej powieści autor opisywał siostry i wspominał <w>je</w> z głęboką czułością."
                            }
                        },
                        {
                            "text": "Среди <w>их</w> подруг было немало образованных дам того времени.",
                            "target_lang_translations": {
                                "pl": "Wśród <w>ich</w> przyjaciółek było niemało wykształconych dam tamtych czasów."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "форма местоимения женского рода оне"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Archaiczna forma dopełniacza i biernika dawnego zaimka rodzaju żeńskiego liczby mnogiej."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ich",
                                "target_lang_sense_clarification": "dopełniacz od one"
                            },
                            {
                                "target_lang_word": "je",
                                "target_lang_sense_clarification": "biernik od one"
                            }
                        ]
                    }
                }
            ]
        },
        {
