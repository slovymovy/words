                "senses": [
                    {
                        "sense_id": "41190924-90ff-3566-8ace-4a4e6dd60f98",
                        "entry_id": "2ba3b932-f2d2-3537-91a8-2175af989502",
                        "glosses": [
                            "Mettre à jour (un logiciel, par exemple) en passant à une version plus récente."
                        ],
                        "tags": [
                            "Anglicism",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "911de5f2-ab74-471a-8658-e7d019fb89e3",
                                "sense_id": "41190924-90ff-3566-8ace-4a4e6dd60f98",
                                "text": "Ces crashs semblent liés à une opération de maintenance effectuée par les ingénieurs système à ces mêmes dates pour la mise en production de patch pour upgrader le serveur."
                            }
                        ]
                    },
                    {
                        "sense_id": "8a0e33d1-ecd9-30c6-aec1-cb0723211897",
                        "entry_id": "2ba3b932-f2d2-3537-91a8-2175af989502",
                        "glosses": [
                            "Promouvoir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b35c84b7-b6f1-4d57-9680-ea410842dbb4",
                                "sense_id": "8a0e33d1-ecd9-30c6-aec1-cb0723211897",
                                "text": "Ce n’est pas tendance, dans notre société adepte du jeunisme à tout crin, d’aimer vieillir. J’accepte avec bonheur de changer de place dans l’arbre des généations. J’ai été upgradée au niveau grand-mère au jeu de la vie."
                            }
                        ]
                    },
                    {
                        "sense_id": "2bf5adae-229a-311e-ab5c-41355ae06660",
                        "entry_id": "2ba3b932-f2d2-3537-91a8-2175af989502",
                        "glosses": [
                            "Surclasser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "562e584f-012f-46e3-a4d9-1afc21752239",
                                "sense_id": "2bf5adae-229a-311e-ab5c-41355ae06660",
                                "text": "J’ai pas pu faire upgrader mon billet, mais au moins, je vais avoir un bon siège, pas trop loin des toilettes."
                            }
                        ]
                    }
                ],
