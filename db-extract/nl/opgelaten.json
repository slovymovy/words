        "nl-extract.jsonl": [
            {
                "entry_id": "7e8ad5f9-e1b2-3cc5-80de-6492b48c08b6",
                "word": "opgelaten",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b22beb4e-62f7-3a5e-a1b8-8e98a87fabec",
                        "entry_id": "7e8ad5f9-e1b2-3cc5-80de-6492b48c08b6",
                        "glosses": [
                            "met het gevoel iets niet goed te doen, zonder dat anderen er iets van zeggen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94508e3f-aa88-4c47-a1cd-29d19680ab10",
                                "sense_id": "b22beb4e-62f7-3a5e-a1b8-8e98a87fabec",
                                "text": "‘Oké”, zei Bruno. „Ik zoek iemand die mijn problemen kent, want die hou ik tegenwoordig meestal voor me.” Hij pauzeerde om Job de mogelijkheid te bieden een paar warme woorden uit te spreken. Er volgde echter een opgelaten stilte."
                            },
                            {
                                "example_id": "44f7adad-f946-4511-ad94-bfd729e52c02",
                                "sense_id": "b22beb4e-62f7-3a5e-a1b8-8e98a87fabec",
                                "text": "Ik voelde me een beetje opgelaten tegenover de medewerkers van het postkantoor."
                            },
                            {
                                "example_id": "f186c515-9b5b-4aef-aa8f-211fee744e2d",
                                "sense_id": "b22beb4e-62f7-3a5e-a1b8-8e98a87fabec",
                                "text": "Waren ze gaan twijfelen? Nee, helemaal niet. Echt niet, verzekerde Karl hem opgelaten. Als hij en Louise het alleen konden beslissen, zouden ze allang getrouwd zijn. Maar dat was helaas niet zo."
                            }
                        ]
                    }
