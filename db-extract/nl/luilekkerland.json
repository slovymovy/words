                    {
                        "sense_id": "8d9653c5-de49-32e7-9646-721e0763018a",
                        "entry_id": "5fa3bb22-7db6-3e2b-b10c-9ba392947ca1",
                        "glosses": [
                            "fantasieland waarin men niet hoeft te werken en toch eten en drinken in overvloed heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79163369-29d0-432e-a4ca-945892730221",
                                "sense_id": "8d9653c5-de49-32e7-9646-721e0763018a",
                                "text": "Utopia, El Dorado, Luilekkerland, Ultima Thule, Zuidland, Atlantis... Wat zijn we verzot op plekken die niet bestaan. De wereldliteratuur zit er vol van. In dit boek verzamelt Eco deze bekende en minder bekende arcadia’s, en teksten die erover geschreven zijn."
                            },
                            {
                                "example_id": "030be4b0-5d60-42fb-802e-1c750bd421fb",
                                "sense_id": "8d9653c5-de49-32e7-9646-721e0763018a",
                                "text": "Het Achterhoekse platteland is (nog) geen luilekkerland voor drugscriminelen. Volgens cijfers van de politie is het aantal opgerolde wietplantages in de tien Achterhoekse gemeenten afgenomen met 30 procent. In 2013 werden er 112 hennepkwekerijen ontmanteld, in 2016 waren dat er 78."
                            }
                        ]
                    }
