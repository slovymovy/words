        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b86fc7c7-a966-37a6-8bb2-063a22fddd3a",
                "word": "Hamas",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e64b1953-95de-3dd4-ad15-efc69fe40fbf",
                        "entry_id": "b86fc7c7-a966-37a6-8bb2-063a22fddd3a",
                        "glosses": [
                            "A Palestinian Islamist militant group and political organization."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a328d768-f83a-4e31-b03e-afe10d2ef2c0",
                                "sense_id": "e64b1953-95de-3dd4-ad15-efc69fe40fbf",
                                "text": "Hamas knew there would be massive retaliations."
                            },
                            {
                                "example_id": "9f19ef6c-80e3-4e29-a704-4b823e95ac0a",
                                "sense_id": "e64b1953-95de-3dd4-ad15-efc69fe40fbf",
                                "text": "[W]hen a Hamas spokesman recently stood by his statement that Jews used the blood of non-Jewish children for their matzos – one of the oldest anti-Semitic canards around – European elites were largely silent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bb7dd07e-3c2a-436a-b643-ade8c9fa79d0",
                        "source_entry_id": "b86fc7c7-a966-37a6-8bb2-063a22fddd3a",
                        "source_sense_id": "e64b1953-95de-3dd4-ad15-efc69fe40fbf",
                        "source_sense_description": "Palestinian militant group",
                        "target_lang_word": "Hamas",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hamas",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6b8d3bb2-828f-3ed8-a19b-7a1084b450be",
                                        "entry_id": "38fac238-c983-3aa6-9771-2fa51db13c5c",
                                        "glosses": [
                                            "Organisation politique, religieuse et militaire palestinienne qui existe depuis 1987."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74fb8084-761d-4bb4-ac1c-86baeac663ec",
                                                "sense_id": "6b8d3bb2-828f-3ed8-a19b-7a1084b450be",
                                                "text": "Une terrible guerre proxy (où deux pouvoirs utilisent une tierce personne) éclata, les États-Unis finançant le Fatah en Cisjordanie à coups de centaines de millions de dollars, tandis que l’Iran envoyait clandestinement de l’argent et des armes au Hamas à Gaza."
                                            },
                                            {
                                                "example_id": "863d7020-10f0-451f-953b-87612378f6e2",
                                                "sense_id": "6b8d3bb2-828f-3ed8-a19b-7a1084b450be",
                                                "text": "Pourtant, Yahya Sinwar va construire l’image d’un Hamas de moins en moins belliqueux frontalement envers Israël, ce qui a pu tromper les services de renseignement."
                                            },
                                            {
                                                "example_id": "61d6fbd0-efa5-42ab-be77-2b54d0beae7f",
                                                "sense_id": "6b8d3bb2-828f-3ed8-a19b-7a1084b450be",
                                                "text": "Mardi, le chef du Hamas, Ismaïl Haniyeh, a affirmé que son mouvement avait reçu une proposition de trêve avec Israël, résultat d’une réunion organisée à Paris le week-end dernier entre le directeur de la CIA et des responsables égyptiens, israéliens et qataris."
                                            },
                                            {
                                                "example_id": "c460d078-9b05-4233-a98b-28229d0fa9e6",
                                                "sense_id": "6b8d3bb2-828f-3ed8-a19b-7a1084b450be",
                                                "text": "Hamas veut dire « enthousiasme », et les libérateurs imaginaires de la Palestine, dans ce monde dit « arabe », procèdent toujours par enthousiasme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c41876c0-53e6-4643-9a4f-9cc074e9309d",
                        "source_entry_id": "b86fc7c7-a966-37a6-8bb2-063a22fddd3a",
                        "source_sense_id": "e64b1953-95de-3dd4-ad15-efc69fe40fbf",
                        "source_sense_description": "Palestinian militant group",
                        "target_lang_word": "Hamas",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hamas",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6ff43561-966f-3661-b208-4342f37818f6",
                                        "entry_id": "fbf4ef35-d449-3d4b-a883-11d3a6a9800e",
                                        "glosses": [
                                            "sunnitisch-islamistische Organisation in Palästina, die mithilfe von terroristischen Aktionen einen islamischen Staat errichten will, der auch Israel und Teile Jordaniens umfassen soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8351be5c-4c6b-4d14-9d13-a0f673d6d9dc",
                                                "sense_id": "6ff43561-966f-3661-b208-4342f37818f6",
                                                "text": "Die Hamas ist eine radikalislamische Organisation."
                                            },
                                            {
                                                "example_id": "71001120-cd43-4d15-957a-b76c1ba11265",
                                                "sense_id": "6ff43561-966f-3661-b208-4342f37818f6",
                                                "text": "„Zu Beginn des Aufstandes erfolgte auch die Gründung der Hamas (Akronym für die Islamische Widerstandsbewegung, arab. für Eifer) aus den Reihen der palästinensischen Muslimbruderschaft.“"
                                            },
                                            {
                                                "example_id": "4ed4d458-a512-489b-a42e-24ca40e026a8",
                                                "sense_id": "6ff43561-966f-3661-b208-4342f37818f6",
                                                "text": "„Einer der Fahrer sagt, wenn er könnte, würde er nach Gaza gehen und sich der Hamas anschließen, nur um einen israelischen Soldaten zu töten.“"
                                            },
                                            {
                                                "example_id": "d22665ef-f1d8-447f-83f8-bfc2bf2062c6",
                                                "sense_id": "6ff43561-966f-3661-b208-4342f37818f6",
                                                "text": "„Durch den afghanischen Dschihad kannte er auch ranghöhere Figuren der Nationalen Islamischen Front im Sudan, der Hisbollah im Libanon und der Hamas, der radikalen islamischen Palästinenserbewegung im Gazastreifen und auf der West Bank.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
