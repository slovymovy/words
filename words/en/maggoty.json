    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9f17200e-c5e7-302d-8204-a705b48b5a29",
                    "sense_definition": "Infested with or partially eaten by maggots.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "decay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>maggoty</w> meat was thrown away immediately.",
                            "target_lang_translations": {
                                "pl": "<w>Robaczywe</w> mięso zostało natychmiast wyrzucone."
                            }
                        },
                        {
                            "text": "The <w>flyblown</w> carcass was left in the sun.",
                            "target_lang_translations": {
                                "pl": "Padlina <w>robaczywa</w> od much została pozostawiona na słońcu."
                            }
                        }
                    ],
                    "synonyms": [
                        "flyblown",
                        "worm-eaten",
                        "maggotish"
                    ],
                    "common_phrases": [
                        "maggoty meat"
                    ],
                    "target_lang_definitions": {
                        "pl": "Zainfekowany larwami much lub częściowo przez nie zjedzony."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "robaczywy",
                                "target_lang_sense_clarification": "pełen robaków lub nadjedzony przez robaki"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee974107-649a-33f0-841a-e2b65b35179f",
                    "sense_definition": "Full of strange whims or capricious behavior.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>maggoty</w> wit often confused his colleagues.",
                            "target_lang_translations": {
                                "pl": "Jego <w>kapryśny</w> dowcip często wprawiał kolegów w zakłopotanie."
                            }
                        },
                        {
                            "text": "She displayed a <w>maggoty</w> change of heart regarding the project.",
                            "target_lang_translations": {
                                "pl": "Wykazała <w>dziwaczną</w> zmianę zdania w kwestii tego projektu."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This usage is archaic and rarely encountered in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Pełen dziwnych kaprysów lub zmiennych nastrojów (użycie przestarzałe)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "kapryśny",
                                "target_lang_sense_clarification": "skłonny do nagłych zmian nastroju"
                            },
                            {
                                "target_lang_word": "dziwaczny",
                                "target_lang_sense_clarification": "odznaczający się nietypowym zachowaniem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5dac81e3-64ea-3c9a-bb3c-4c0ebc063e88",
                    "sense_definition": "Unpleasant or bad-tempered.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was in a <w>maggoty</w> mood all morning.",
                            "target_lang_translations": {
                                "pl": "Przez cały poranek był w <w>zrzędliwym</w> nastroju."
                            }
                        },
                        {
                            "text": "The <w>maggoty</w> customer complained about everything.",
                            "target_lang_translations": {
                                "pl": "<w>Zrzędliwy</w> klient narzekał na wszystko."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used in informal or offensive contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Nieprzyjemny, zrzędliwy lub w złym humorze."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zrzędliwy",
                                "target_lang_sense_clarification": "osoba często narzekająca i będąca w złym humorze"
                            },
                            {
                                "target_lang_word": "nieprzyjemny",
                                "target_lang_sense_clarification": "o kimś, kto zachowuje się w sposób irytujący"
                            }
                        ]
                    }
                }
            ]
        }
    ]
