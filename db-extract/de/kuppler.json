                        ],
                        "form": "die Kuppler"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "08f690be-8a54-37d4-9599-2bd57b45d766",
                        "entry_id": "a531fcab-24c4-3434-a542-038573028bef",
                        "glosses": [
                            "Hersteller oder Vermittler von Kontakten zwischen Personen zwecks Heirat oder - oft bezahlter - sexueller Aktivitäten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba8f82a4-0f76-4cd1-90c1-5c2108e60bfe",
                                "sense_id": "08f690be-8a54-37d4-9599-2bd57b45d766",
                                "text": "Er machte seinem Namen alle Ehre und verhalf als Kuppler so manch junger Frau zu einer lohnenden Liaison."
                            },
                            {
                                "example_id": "1399f00a-b323-452f-b6ee-2a6080d04352",
                                "sense_id": "08f690be-8a54-37d4-9599-2bd57b45d766",
                                "text": "„Der Staat selbst war dadurch offenbar zum Kuppler geworden, denn das zuständige Eisenbahnministerium hatte 17500 Mark profitiert dadurch, daß es nun zwar Herrn S. die Möglichkeit einräumte, sich seine 17500 Mark zu »verdienen«, aber andererseits indirekt – oder soll man sagen: direkt? – den Kunden des Herrn S. »Gelegenheit gewährte«, wie der Gesetzgeber so schön sagt.“"
                            },
                            {
                                "example_id": "f933995f-2dbb-4c47-bd98-56279ae344cd",
                                "sense_id": "08f690be-8a54-37d4-9599-2bd57b45d766",
                                "text": "„Der Mann, der mich erkannt hatte, war ein Kuppler, den ich vor einigen Wochen verprügelt hatte, weil er mich betrogen und vergeblich auf eine Tänzerin hatte warten lassen, die er mir bringen sollte.“"
                            },
                            {
                                "example_id": "b788dcfc-33b9-4c45-8c6d-8aab12c73b12",
                                "sense_id": "08f690be-8a54-37d4-9599-2bd57b45d766",
                                "text": "„Als ich dem Doktor Righellini die Mutter M. E. pries, die eine vollendete Schönheit war, flüsterte er mir ins Ohr, er mache sich anheischig, sie mir für Geld zu verschaffen, wenn ich neugierig auf sie sei. Hundert Zechinen für sie und zehn für den Kuppler waren der geforderte Preis.“"
                            },
                            {
                                "example_id": "317abb61-33f3-4153-ad19-35a6aff4d656",
                                "sense_id": "08f690be-8a54-37d4-9599-2bd57b45d766",
                                "text": "„Rétif, der Soziologe der Prostitution von Paris, ist eine Fundgrube für diese Erscheinung und die ihr in die Hände arbeitede der Kuppler und Agenten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b25a1761-c41d-41ae-bdd3-7328bc685562",
                        "source_entry_id": "a531fcab-24c4-3434-a542-038573028bef",
                        "source_sense_id": "08f690be-8a54-37d4-9599-2bd57b45d766",
                        "source_sense_description": "Hersteller oder Vermittler von Kontakten zwischen Personen zwecks Heirat oder - oft bezahlter - sexueller Aktivitäten",
                        "target_lang_word": "сводник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сводник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "266df42b-d075-3cd3-afce-352a78ca964e",
                                        "entry_id": "17cdace5-6ae0-37ec-becb-3882a26c744e",
                                        "glosses": [
                                            "неодобр. тот, кто занимается сводничеством, то есть посредничеством (обычно корыстным) между мужчинами и женщинами для содействия вступлению их в любовную связь"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f4c2d8d-1a65-436f-a71a-f5dc1c9b70e2",
                                                "sense_id": "266df42b-d075-3cd3-afce-352a78ca964e",
                                                "text": "Прохор, узнав повадку Пупкина, велел познакомить его со Стешенькой и Груней. Сводником был назначен Илья Сохатых."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "190e2583-d305-4853-9b37-a4e83ebe01f6",
                        "source_entry_id": "a531fcab-24c4-3434-a542-038573028bef",
                        "source_sense_id": "08f690be-8a54-37d4-9599-2bd57b45d766",
                        "source_sense_description": "Hersteller oder Vermittler von Kontakten zwischen Personen zwecks Heirat oder - oft bezahlter - sexueller Aktivitäten",
                        "target_lang_word": "kuplíř",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kuplíř",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "80e9c3d8-333a-355f-b3b0-49b4e20eddb7",
                                        "entry_id": "3e5dc9a1-2eab-3599-b37c-0d406dd9b947",
                                        "glosses": [
                                            "člověk, který obchoduje se ženami nebo zprostředkovává prostituci"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91c83398-e0cc-4f82-a37c-f5a6437a6fee",
                                                "sense_id": "80e9c3d8-333a-355f-b3b0-49b4e20eddb7",
                                                "text": "„Ty svině jedna, když prodáváš svoje tělo a pášeš smrtelnej hřích, nemyslí si, že ten tvůj nějakej šesták mně pomůže. Já nejsem žádnej kuplíř, nestoudná běhno. Já to dělám jedině z outrpnosti k tobě…“"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
