                                        "sense_id": "23e86102-ff20-3530-ac52-04e548febfa2",
                                        "entry_id": "692f40e9-2772-33df-9f3f-706692530ea9",
                                        "glosses": [
                                            "Contrary to reason or propriety; obviously and flatly opposed to manifest truth; inconsistent with the plain dictates of common sense; logically contradictory; nonsensical; ridiculous; silly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cf0bdeb-b629-416c-b4e4-1064d2ebee56",
                                                "sense_id": "23e86102-ff20-3530-ac52-04e548febfa2",
                                                "text": "This proffer is absurd and reasonless."
                                            },
                                            {
                                                "example_id": "27519144-87b5-4e6f-9292-cf9d7f2b34c8",
                                                "sense_id": "23e86102-ff20-3530-ac52-04e548febfa2",
                                                "text": "'Tis phrase absurd to call a villain great"
                                            },
                                            {
                                                "example_id": "54dad728-c01d-478a-b9d1-803933fc1b1a",
                                                "sense_id": "23e86102-ff20-3530-ac52-04e548febfa2",
                                                "text": "“Perhaps it is because I have been excommunicated. It's absurd, but I feel like the Jackdaw of Rheims.” ¶ She winced and bowed her head. Each time that he spoke flippantly of the Church he caused her pain."
                                            },
                                            {
                                                "example_id": "3580b0a7-3c67-4747-a556-e664a6c90218",
                                                "sense_id": "23e86102-ff20-3530-ac52-04e548febfa2",
                                                "text": "I know it sounds absurd / But please, tell me who I am"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f43f9f5-361e-38fa-a2ab-706f80ff4748",
                                        "entry_id": "692f40e9-2772-33df-9f3f-706692530ea9",
                                        "glosses": [
                                            "Inharmonious; dissonant."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "13cac2b4-3b3f-3d1b-b6d1-514c471203f3",
                                        "entry_id": "692f40e9-2772-33df-9f3f-706692530ea9",
                                        "glosses": [
                                            "Having no rational or orderly relationship to people's lives; meaningless; lacking order or value."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adb867fd-e7d6-485a-b6a9-df4eb8af986a",
                                                "sense_id": "13cac2b4-3b3f-3d1b-b6d1-514c471203f3",
                                                "text": "Adults have condemned them to live in what must seem like an absurd universe."
                                            }
                                        ]
                                    },
