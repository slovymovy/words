                "senses": [
                    {
                        "sense_id": "b868f739-486a-31f2-8ca2-230a1e587bb1",
                        "entry_id": "55b97890-17e7-3754-a2e8-3bd931460fd8",
                        "glosses": [
                            "nördlich gelegener Randbereich; im Norden befindliche Flanke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4bf8651-b616-49fc-b619-60250f000607",
                                "sense_id": "b868f739-486a-31f2-8ca2-230a1e587bb1",
                                "text": "„Wie die Wissenschafter nachweisen konnten, brachen vor etwa 3.750 Jahren rund 200 Millionen Kubikmeter Gestein aus der Nordflanke des Bergs ab und stürzten zu Tal.“"
                            },
                            {
                                "example_id": "1aa4fa1b-8038-4901-b056-516240a9a55c",
                                "sense_id": "b868f739-486a-31f2-8ca2-230a1e587bb1",
                                "text": "„Erhalten bzw. noch erkennbar sind die westlich vorgelagerte Bastion mit oberem Hof, der Kapellenturm, das mittlere und hintere Schloss, der Roßstall, sowie Grundmauern von Badhaus, Backhaus und weiterer Bauten an der Ost- und Nordflanke.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
