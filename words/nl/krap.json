                            },
                            {
                                "target_lang_word": "loquet",
                                "target_lang_sense_clarification": "dispositif simple de fermeture"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c9c91d6-6402-308e-91e9-24095b89d606",
                    "sense_definition": "Een ringvormige verdikking op de hoorn van een koe die ontstaat na het kalven.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Aan de <w>krap</w> kun je zien hoe vaak de koe gekalfd heeft.",
                            "target_lang_translations": {
                                "en": "You can tell by the <w>horn ring</w> how often the cow has calved.",
                                "ru": "По <w>кольцу</w> можно увидеть, сколько раз корова телилась.",
                                "fr": "On peut voir à <w>l'anneau</w> combien de fois la vache a vêlé."
                            }
                        },
                        {
                            "text": "De boer wees naar de nieuwe <w>krap</w> op de hoorn.",
                            "target_lang_translations": {
                                "en": "The farmer pointed to the new <w>ring</w> on the horn.",
                                "ru": "Фермер указал на новое <w>кольцо</w> на роге.",
                                "fr": "L'éleveur désigna le nouveau <w>bourrelet</w> sur la corne."
                            }
                        }
                    ],
                    "synonyms": [
                        "kalfring"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "agrarische term"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A ring-shaped thickening on a cow's horn formed after calving.",
                        "ru": "Кольцеобразное утолщение на роге коровы, возникающее после отела.",
                        "fr": "Épaississement annulaire sur la corne d'une vache qui apparaît après le vêlage."
                    },
                    "translations": {
                        "en": [
