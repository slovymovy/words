                ],
                "senses": [
                    {
                        "sense_id": "14e698b5-0cc1-3a76-947c-4b2ede91ba58",
                        "entry_id": "69826e5f-ccc6-3757-8834-c7c5961a2387",
                        "glosses": [
                            "een onzedelijke uiting of handeling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "997596ac-4fe8-4695-a61d-5492dec825bb",
                                "sense_id": "14e698b5-0cc1-3a76-947c-4b2ede91ba58",
                                "text": "Zijn satirische kijk op de mensheid zou Dix later nog danig parten spelen. Twee keer kreeg hij een proces aan zijn broek voor obsceniteit. Hij kwam in beide gevallen goed weg, door de heilige te spelen en zich listig voor te stellen als aanklager van zedenverval. De nazi’s verklaarden zijn kunst nadien ‘ontaard’. Een aantal van zijn sleutelwerken is nog altijd vermist."
                            },
                            {
                                "example_id": "c72b32d0-bd8a-4282-93f0-585d0287e133",
                                "sense_id": "14e698b5-0cc1-3a76-947c-4b2ede91ba58",
                                "text": "De feiten zouden tussen 1975 en 1978 hebben plaatsgevonden in het Newman Theological College in Edmonton, waar hij toen studeerde. Volgens CBC bekende Dejaeger twee aanklachten wegens grove obsceniteiten. Ook gaf hij toe een jongen en een meisje te hebben aangerand. Een gerechtelijke uitspraak wordt op 22 oktober verwacht."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9236d9d8-a682-4344-99b9-5b0fabd58b01",
                        "source_entry_id": "69826e5f-ccc6-3757-8834-c7c5961a2387",
                        "source_sense_id": "14e698b5-0cc1-3a76-947c-4b2ede91ba58",
                        "source_sense_description": "een onzedelijke uiting of handeling",
                        "target_lang_word": "obscenity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obscenity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ada05fa6-323a-3a39-93c0-bb856e2160fa",
                                        "entry_id": "d9b9842b-8ae1-30ad-a560-5660b00a15a9",
                                        "glosses": [
                                            "Something that is obscene."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bd5081a-97d4-4bab-a763-194aeec9c6e0",
                                                "sense_id": "ada05fa6-323a-3a39-93c0-bb856e2160fa",
                                                "text": "Martha wouldn't go into the art museum because, as she put it, \"They have obscenities just sitting out, on display!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9dcd21ca-c5f4-3736-b83b-c19140729ec6",
                                        "entry_id": "d9b9842b-8ae1-30ad-a560-5660b00a15a9",
                                        "glosses": [
                                            "An act of obscene behaviour."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0efa4aa7-fb6e-4ce7-9e19-388570266a90",
                                                "sense_id": "9dcd21ca-c5f4-3736-b83b-c19140729ec6",
                                                "text": "Bestiality was outlawed as an obscenity in the strongly conservative community."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "055ccf5a-2226-3ec5-a32b-b866374644e8",
                                        "entry_id": "d9b9842b-8ae1-30ad-a560-5660b00a15a9",
                                        "glosses": [
                                            "Specifically, an offensive word; a profanity; a dirty word."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "746667c9-4c36-40a5-9868-349e4d8f6726",
                                                "sense_id": "055ccf5a-2226-3ec5-a32b-b866374644e8",
                                                "text": "Eliza couldn't stand her daughter's music; as she saw it, it was just shouted obscenities and a heavy drum beat."
                                            },
                                            {
                                                "example_id": "4cc76525-d12e-49d3-a046-bd8dabfac4e1",
                                                "sense_id": "055ccf5a-2226-3ec5-a32b-b866374644e8",
                                                "text": "Her mother favored a multiyear project: obscenities carved in intricate and clever juxtapositions, descending every finger, curling in lettered whorls across the palm, fanning in offensive rays across the opisthenar, which is the name for the back of the hand, a word that Leilani knew because she had studied the structure of the human hand in detail, the better to understand her difference."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "256c2e2d-ec83-337d-8cb4-d332ea03a914",
                                        "entry_id": "d9b9842b-8ae1-30ad-a560-5660b00a15a9",
                                        "glosses": [
                                            "Lewdness, indecency, or offensive behaviour or material."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40b16a30-1088-4708-85b4-cce64e4c736e",
                                                "sense_id": "256c2e2d-ec83-337d-8cb4-d332ea03a914",
                                                "text": "The coalition of religious conservatives was campaigning against, in their view, rampant obscenity in the entertainment industry."
                                            },
                                            {
                                                "example_id": "8fa5001d-247a-455f-bdf9-c3caa52d39a2",
                                                "sense_id": "256c2e2d-ec83-337d-8cb4-d332ea03a914",
                                                "text": "Over three and a half decades, \"Deep Throat\" has been damned by religious groups, decried by feminists, defended by First Amendment advocates, derided by critics and debated by social scientists. It dragged for years through local and federal courts around the country in a welter of obscenity trials in which it was variously banned, unbanned and rebanned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d83bc206-78d5-3de4-8c34-7ac8a9241582",
                                        "entry_id": "d9b9842b-8ae1-30ad-a560-5660b00a15a9",
                                        "glosses": [
                                            "The fact of being obscene."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d8d526d-913e-4479-a442-33fc8f4354be",
                                                "sense_id": "d83bc206-78d5-3de4-8c34-7ac8a9241582",
                                                "text": "Henia Flint Goodman, a Holocaust survivor,spoke in outrage against the obscenity of anti-abortion literature which compares a woman's free choice to have an abortion with the crimes of the Nazi state."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
