                "senses": [
                    {
                        "sense_id": "a4c54474-bc48-3651-85dc-ce7a42d36cbf",
                        "entry_id": "05fe3bc9-f116-3c90-95e1-bc14dd27ae32",
                        "glosses": [
                            "female equivalent of батра́к (batrák): hired woman"
                        ],
                        "tags": [
                            "feminine",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "4d482ba2-0064-4d52-a711-ab444d2925ff",
                                "sense_id": "a4c54474-bc48-3651-85dc-ce7a42d36cbf",
                                "text": "Супру́жеская жизнь обходи́лась ему́ ничу́ть не доро́же холосто́й; напро́тив, тепе́рь ему́ ста́ло да́же вы́годнее, потому́ что он, приведя́ в дом жену́, то́тчас же отпусти́л батра́чку, кото́рой мно́го ли, ма́ло ли, а всё́-таки плати́л рубль ме́дью в ме́сяц.",
                                "translation": "Conjugal life cost him no more than bachelorhood; on the contrary, now it became even more profitable for him, because, having brought home a wife, he immediately dismissed the hired woman he had paid no less than a copper rouble a month.",
                                "english": "Conjugal life cost him no more than bachelorhood; on the contrary, now it became even more profitable for him, because, having brought home a wife, he immediately dismissed the hired woman he had paid no less than a copper rouble a month."
                            }
                        ]
                    }
                ],
