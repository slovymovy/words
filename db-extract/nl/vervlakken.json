        "nl-extract.jsonl": [
            {
                "entry_id": "5a53adfd-3320-3d73-a790-25d94c0051d2",
                "word": "vervlakken",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4052a01c-f848-3eab-a442-4919ec839e6c",
                        "entry_id": "5a53adfd-3320-3d73-a790-25d94c0051d2",
                        "glosses": [
                            "vervagen, verliezen van nuances"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea96b7c3-7617-42c3-8d7a-36a82f831dc6",
                                "sense_id": "4052a01c-f848-3eab-a442-4919ec839e6c",
                                "text": "Het lijkt wel of de seizoenen vervlakken en dat er geen echt winter- of zomerseizoen meer is. Dat is slecht nieuws voor kledingwinkels, want als het maar niet echt koud wil worden, blijven je naar verhouding dure winterjassen in de rekken hangen."
                            }
                        ]
                    },
                    {
                        "sense_id": "ab106b5e-2389-3ab1-b421-eb8017341a7c",
                        "entry_id": "5a53adfd-3320-3d73-a790-25d94c0051d2",
                        "glosses": [
                            "minder betekenis krijgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78a2980e-8d92-4a93-8638-c0639c0185d1",
                                "sense_id": "ab106b5e-2389-3ab1-b421-eb8017341a7c",
                                "text": "Als de organisatie te lang wacht met het maken van excuses, kan het een principekwestie worden of de betekenis ervan vervlakken. HP de Tijd 13/01"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "777a937e-281b-4de6-80c6-7db2ed9b08b1",
                        "source_entry_id": "5a53adfd-3320-3d73-a790-25d94c0051d2",
                        "source_sense_id": "4052a01c-f848-3eab-a442-4919ec839e6c",
                        "source_sense_description": "vervagen, verliezen van nuances",
                        "target_lang_word": "fade away",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fade away",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "73c2c1f7-f368-3c74-b7c6-0d47301af06c",
                                        "entry_id": "81eca19b-e976-3477-9ade-409b8aa654dd",
                                        "glosses": [
                                            "To lose strength, become weaker; to wane; to disappear or reduce slowly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b3a6efb-67c4-4659-a248-9f071833442d",
                                                "sense_id": "73c2c1f7-f368-3c74-b7c6-0d47301af06c",
                                                "text": "I was angry at first, but my rage faded away over time."
                                            },
                                            {
                                                "example_id": "2181c112-5809-4d91-a897-1a3cd7220e1f",
                                                "sense_id": "73c2c1f7-f368-3c74-b7c6-0d47301af06c",
                                                "text": "The stars shall fade away."
                                            },
                                            {
                                                "example_id": "ad7a8e56-5bf3-45eb-9cfa-901be2140495",
                                                "sense_id": "73c2c1f7-f368-3c74-b7c6-0d47301af06c",
                                                "text": "\"I felt my strength fading away, and I was in a half swoon. How long this horrible thing lasted I know not, but it seemed that a long time must have passed before he took his foul, awful, sneering mouth away. I saw it drip with the fresh blood!\""
                                            },
                                            {
                                                "example_id": "25316395-c64f-4d8e-9999-3a7168171704",
                                                "sense_id": "73c2c1f7-f368-3c74-b7c6-0d47301af06c",
                                                "text": "The sun is fading away\nThat's the end of the day"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fade away",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7983b283-a289-37a1-be56-d28aba9b9dd0",
                                        "entry_id": "3938903e-ba36-3a43-9933-c4de3279abf1",
                                        "glosses": [
                                            "A painting technique in which young women's clothes fade into the background."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1676797e-93c1-4946-9d0a-b1fa9045d0bd",
                                                "sense_id": "7983b283-a289-37a1-be56-d28aba9b9dd0",
                                                "text": "Hirschfeld captured many scenes in line and employed Coles Phillips's \"fade away\" technique in his painting on the left."
                                            },
                                            {
                                                "example_id": "a9715904-d7f3-4f78-8509-aab6c6769117",
                                                "sense_id": "7983b283-a289-37a1-be56-d28aba9b9dd0",
                                                "text": "In Phillip's \"Fade Away\" style, he is literally editing out elements (by making them the same flat color as the background), but those elements are still there."
                                            },
                                            {
                                                "example_id": "922193da-0c05-405f-a04e-41fbd7733196",
                                                "sense_id": "7983b283-a289-37a1-be56-d28aba9b9dd0",
                                                "text": "Phillips became known for the \"fade away, in which the main figures' clothing is the same color as the background, allowing the elements to partially blend."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
