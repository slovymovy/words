                "senses": [
                    {
                        "sense_id": "74479c48-08fa-32d0-9d89-002fb12b8b89",
                        "entry_id": "1ce28d8b-f7a2-3150-a454-44b398cf0f76",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba91b6f1-ca83-4769-a284-c0386cbfde82",
                                "sense_id": "74479c48-08fa-32d0-9d89-002fb12b8b89",
                                "text": "Frau Diesterweg ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7c408407-86ce-4d18-b895-837c9ceace0e",
                                "sense_id": "74479c48-08fa-32d0-9d89-002fb12b8b89",
                                "text": "Herr Diesterweg wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d93a2474-90c8-47c8-a452-41de5ae407ce",
                                "sense_id": "74479c48-08fa-32d0-9d89-002fb12b8b89",
                                "text": "Die Diesterwegs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "86a9734d-5e1f-49b0-bb8a-a068bef83c92",
                                "sense_id": "74479c48-08fa-32d0-9d89-002fb12b8b89",
                                "text": "Der Diesterweg trägt nie die Schals, die die Diesterweg ihm strickt."
                            },
                            {
                                "example_id": "fea44b1d-0fc7-4c11-99e0-5d0629271f85",
                                "sense_id": "74479c48-08fa-32d0-9d89-002fb12b8b89",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Diesterweg kommt, geht der Herr Diesterweg.“"
                            },
                            {
                                "example_id": "5d704fac-82f9-4908-a2f5-50d111c233c1",
                                "sense_id": "74479c48-08fa-32d0-9d89-002fb12b8b89",
                                "text": "Diesterweg kommt und geht."
                            },
                            {
                                "example_id": "46b7570a-87ac-46b5-84d2-83ec5ecfa59e",
                                "sense_id": "74479c48-08fa-32d0-9d89-002fb12b8b89",
                                "text": "Diesterwegs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
