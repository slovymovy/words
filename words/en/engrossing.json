    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a6106728-196e-3b34-98ce-32c721670d4e",
                    "sense_definition": "Completely absorbing one's attention or interest.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The novel was so <w>engrossing</w> that she lost track of time entirely.",
                            "target_lang_translations": {
                                "ru": "Роман был настолько <w>захватывающим</w>, что она совершенно потеряла счет времени."
                            }
                        },
                        {
                            "text": "They watched an <w>engrossing</w> documentary about deep sea exploration.",
                            "target_lang_translations": {
                                "ru": "Они смотрели <w>увлекательный</w> документальный фильм об исследовании морских глубин."
                            }
                        }
                    ],
                    "synonyms": [
                        "absorbing",
                        "fascinating"
                    ],
                    "common_phrases": [
                        "an engrossing read",
                        "an engrossing story"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью поглощающий внимание или интерес; захватывающий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "захватывающий",
                                "target_lang_sense_clarification": "увлекательный, держащий интерес"
                            },
                            {
                                "target_lang_word": "увлекательный",
                                "target_lang_sense_clarification": "вызывающий глубокий интерес"
                            },
                            {
                                "target_lang_word": "поглощающий",
                                "target_lang_sense_clarification": "забирающий все внимание"
                            }
                        ]
                    }
                }
            ]
        },
