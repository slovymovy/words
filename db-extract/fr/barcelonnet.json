                        "glosses": [
                            "Nom donné aux habitants de la vallée de l’Ubaye partis au XIX^(ème) siècle immigrer au Mexique et revenus riche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d1ec284-eb86-44df-8f95-501859081b67",
                                "sense_id": "6ad0eaae-aead-3ec8-9510-3d9caf457dea",
                                "text": "Ses villas mexicaines [de Barcelonette] ne manqueront pas de vous étonner ; elles furent construites entre 1880 et 1930 par des Barcelonnets ayant fait fortune au Mexique."
                            },
                            {
                                "example_id": "c3e1da28-52a8-4aa9-8a2f-efa22f0da6dd",
                                "sense_id": "6ad0eaae-aead-3ec8-9510-3d9caf457dea",
                                "text": "L’aventure des Barcelonnet- tes commençait. Sans doute aussi le sieur Germain Nicolas Prisette, émigré vers 1815, à l’époque de la Restauration et que l’on retrouve d'abord aux côtés du fringant empereur des Mexicains, Augustin 1ᵉʳ, ensuite comme fondateur du journal El Archivista […]."
                            }
                        ]
                    }
