                                        "glosses": [
                                            "zonder mogelijkheid om ongedaan gemaakt te worden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89ad92fc-c236-46b5-b20c-80203f105b86",
                                                "sense_id": "24e9aa26-7b60-3972-bdc8-f965ce3bce34",
                                                "text": "Dat is toch geen onherroepelijke zaak!"
                                            },
                                            {
                                                "example_id": "39f530a7-9dc4-40bf-91e9-3811e529a2b4",
                                                "sense_id": "24e9aa26-7b60-3972-bdc8-f965ce3bce34",
                                                "text": "Aan weerskanten brullen kerels als gekken om zichzelf te verdoven, om zichzelf moed te geven. Anderen rennen net als hij, geconcentreerd, de zenuwen in hun buik, met droge keel. Ze stormen allemaal op de vijand af, gewapend met een onherroepelijke woede, een verlangen naar wraak."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "onherroepelijk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "541679ec-cfb2-32da-af30-a9659fb90867",
                                        "entry_id": "71ac8ce5-6db7-350d-a2ed-f37bb32af797",
                                        "glosses": [
                                            "op onherroepelijke wijze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cd31525-cd6e-444f-95ed-3eb736b68ff9",
                                                "sense_id": "541679ec-cfb2-32da-af30-a9659fb90867",
                                                "text": "Dat gaat onherroepelijk mis!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
