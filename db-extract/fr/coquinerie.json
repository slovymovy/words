                        "form": "coquineries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c80db682-167f-39a3-aae5-efc9643cf52b",
                        "entry_id": "607cdcf1-51cf-31d9-aa08-d9abc5a2ff9f",
                        "glosses": [
                            "Action de coquin, de fripon."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "bdc31a76-b714-48fc-b1ca-86d73ae384ee",
                                "sense_id": "c80db682-167f-39a3-aae5-efc9643cf52b",
                                "text": "Il m’a fait une coquinerie de premier ordre."
                            },
                            {
                                "example_id": "eefd850e-ea75-4e7b-8a19-2cabd517a28f",
                                "sense_id": "c80db682-167f-39a3-aae5-efc9643cf52b",
                                "text": "Lorsque, à quinze ans, il commença à lire les journaux, la mystification qui finit par la mort du colonel Caron était la dernière grande action du gouvernement d’alors ; elle servait de texte à tous les journaux de l’opposition. Cette coquinerie célèbre était, de plus, fort intelligible pour un enfant, et il en possédait tous les détails, comme s’il se fût agi d’une démonstration géométrique."
                            },
                            {
                                "example_id": "ef227c44-02e7-4512-b059-0e2345c0ffd2",
                                "sense_id": "c80db682-167f-39a3-aae5-efc9643cf52b",
                                "text": "« […]. Et que vous n’avez pas fini d’en apprendre des coquineries avec lui !… »"
                            }
                        ]
                    },
                    {
                        "sense_id": "a2beb3d4-cddd-377b-8787-7d37077c91db",
                        "entry_id": "607cdcf1-51cf-31d9-aa08-d9abc5a2ff9f",
                        "glosses": [
                            "Caractère du coquin, du fripon."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "be6609ed-1c06-428a-8100-97fbb0fb4821",
                                "sense_id": "a2beb3d4-cddd-377b-8787-7d37077c91db",
                                "text": "Sa coquinerie est bien connue."
                            },
                            {
                                "example_id": "cc1440cd-82d8-4b08-a796-a4a3e6c50029",
                                "sense_id": "a2beb3d4-cddd-377b-8787-7d37077c91db",
                                "text": "Obéir aux injonctions de coquins pour agir comme d’autres coquins, c’est un genre encore de coquinerie."
                            }
                        ]
                    }
                ],
