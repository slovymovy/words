        "fr-extract.jsonl": [
            {
                "entry_id": "ecd99482-35a5-3b5b-b82a-670e7d2c44d8",
                "word": "malhonnêteté",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e8979463-7531-489a-afc5-3d1f65277bec",
                        "entry_id": "ecd99482-35a5-3b5b-b82a-670e7d2c44d8",
                        "tags": [
                            "plural"
                        ],
                        "form": "malhonnêtetés"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f428b64f-ce42-3b4f-b8ea-bc07bf9e3f3d",
                        "entry_id": "ecd99482-35a5-3b5b-b82a-670e7d2c44d8",
                        "glosses": [
                            "Défaut d’honnêteté, de probité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b285675-653a-44d9-a3aa-de3e515beb84",
                                "sense_id": "f428b64f-ce42-3b4f-b8ea-bc07bf9e3f3d",
                                "text": "Le groupe se doit d'être vigilant et de dénoncer sans réserve la supercherie, le charlatanisme et la malhonnêteté dont font preuves ceux dont le but est d'attirer des sympathisants."
                            }
                        ]
                    },
                    {
                        "sense_id": "2a335bea-688f-3801-94b3-f5ce70d7b9c4",
                        "entry_id": "ecd99482-35a5-3b5b-b82a-670e7d2c44d8",
                        "glosses": [
                            "Incivilité, manque de bienséance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15c17711-2b6e-432f-a800-26b7a5e792f8",
                                "sense_id": "2a335bea-688f-3801-94b3-f5ce70d7b9c4",
                                "text": "Il est d’une malhonnêteté révoltante."
                            },
                            {
                                "example_id": "7ec5bfb6-72bf-4a85-9eb8-9a310cf02596",
                                "sense_id": "2a335bea-688f-3801-94b3-f5ce70d7b9c4",
                                "text": "Il m’a parlé avec malhonnêteté."
                            }
                        ]
                    },
                    {
                        "sense_id": "7ded4941-c987-3432-8629-129e44f329af",
                        "entry_id": "ecd99482-35a5-3b5b-b82a-670e7d2c44d8",
                        "glosses": [
                            "Paroles et des actions inciviles."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "4afe38c0-4a98-47e3-abb7-e4a2d28d6158",
                                "sense_id": "7ded4941-c987-3432-8629-129e44f329af",
                                "text": "Il m’a fait une grande malhonnêteté."
                            },
                            {
                                "example_id": "0b297525-532f-4e71-aa7b-8c1d81718dee",
                                "sense_id": "7ded4941-c987-3432-8629-129e44f329af",
                                "text": "Il m’a dit des malhonnêtetés."
                            }
                        ]
                    }
                ],
