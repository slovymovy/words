{
    "word_family": [
        "obelżywy",
        "obelżywie"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1dc91575-e2e3-3d5a-9ae1-c05f352c6bc3",
                    "sense_definition": "obraźliwe słowo skierowane do kogoś",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "obraza",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie pozwolę, aby rzucano w moją stronę taką <w>obelgę</w>.",
                            "target_lang_translations": {
                                "ru": "Я не позволю бросать в мою сторону такое <w>оскорбление</w>."
                            }
                        },
                        {
                            "text": "Każda <w>obelga</w> wypowiedziana w gniewie rani drugiego człowieka.",
                            "target_lang_translations": {
                                "ru": "Каждое <w>оскорбление</w>, сказанное в гневе, ранит другого человека."
                            }
                        }
                    ],
                    "synonyms": [
                        "wyzwisko",
                        "zniewaga"
                    ],
                    "common_phrases": [
                        "rzucić obelgę"
                    ],
                    "target_lang_definitions": {
                        "ru": "оскорбительное слово или выражение, направленное на кого-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оскорбление",
                                "target_lang_sense_clarification": "словесное выражение, унижающее достоинство"
                            },
                            {
                                "target_lang_word": "ругательство",
                                "target_lang_sense_clarification": "бранное, грубое слово"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9fd604f3-5f48-3889-8c8b-779e9a0bfae4",
                    "sense_definition": "zachowanie lub słowa mające na celu znieważenie kogoś",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obraza",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Publiczna <w>obelga</w> była dla niego ogromnym upokorzeniem.",
                            "target_lang_translations": {
                                "ru": "Публичное <w>оскорбление</w> было для него огромным унижением."
                            }
                        },
                        {
                            "text": "Nie odpowiedział na tę <w>obelgę</w>, zachowując pełen spokój.",
                            "target_lang_translations": {
                                "ru": "Он не ответил на это <w>оскорбление</w>, сохраняя полное спокойствие."
                            }
                        }
                    ],
                    "synonyms": [
                        "zniewaga"
                    ],
                    "target_lang_definitions": {
                        "ru": "поведение или слова, имеющие целью унизить кого-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оскорбление",
                                "target_lang_sense_clarification": "действие, направленное на унижение чести и достоинства"
                            },
                            {
                                "target_lang_word": "обида",
                                "target_lang_sense_clarification": "несправедливость, причиняющая боль"
                            }
                        ]
                    },
                    "common_phrases": [
                        "obrzucać obelgami"
                    ]
                },
                {
                    "sense_id": "6d5dec0c-d6ea-3344-82d7-259ab53c95a8",
                    "sense_definition": "działanie naruszające czyjąś godność",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "obraza",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To zachowanie było dla niej ciężką <w>obelgą</w>.",
                            "target_lang_translations": {
                                "ru": "Такое поведение было для неё тяжким <w>оскорблением</w>."
                            }
                        },
                        {
                            "text": "Nie mógł znieść tej <w>obelgi</w> i postanowił odejść.",
                            "target_lang_translations": {
                                "ru": "Он не мог стерпеть этого <w>оскорбления</w> и решил уйти."
                            }
                        }
                    ],
                    "synonyms": [
                        "poniżenie",
                        "zniewaga"
                    ],
                    "target_lang_definitions": {
                        "ru": "поступок или ситуация, нарушающие чье-либо достоинство"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оскорбление",
                                "target_lang_sense_clarification": "действие, наносящее ущерб достоинству"
                            },
                            {
                                "target_lang_word": "унижение",
                                "target_lang_sense_clarification": "состояние или действие, принижающее достоинство"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}