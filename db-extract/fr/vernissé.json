                "senses": [
                    {
                        "sense_id": "bbf72a4c-4b52-31e5-ae71-6514dd8507a1",
                        "entry_id": "ed029f36-37e1-3d49-b001-dc9caef888a0",
                        "glosses": [
                            "Qui est recouvert de vernis, de glaçure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0eda3ca0-bb8f-4445-9387-d5668cc98ce7",
                                "sense_id": "bbf72a4c-4b52-31e5-ae71-6514dd8507a1",
                                "text": "Le toit luisait, vernissé par les averses de la nuit."
                            },
                            {
                                "example_id": "2d22e41e-8d0c-40f6-8184-469fac30fbd8",
                                "sense_id": "bbf72a4c-4b52-31e5-ae71-6514dd8507a1",
                                "text": "De chaque côté de la porte qui mène à la salle des Ambassadeurs, dans le jambage même de l’arcade, au-dessus du revêtement de carreaux vernissés dont les triangles de couleurs tranchantes garnissent le bas des murs, sont creusées en forme de petites chapelles deux niches de marbre blanc sculptées avec une extrême délicatesse."
                            }
                        ]
                    }
                ],
