                                "sense_id": "7e108810-f43e-3743-bb9b-60d770a64fec",
                                "text": "Нарядился, как на бал."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae2867b9-0477-3bf5-b776-5e3903997ddf",
                        "entry_id": "c4510123-e2ff-3c3d-ab8d-50afcd63d28e",
