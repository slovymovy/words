                "senses": [
                    {
                        "sense_id": "b9472a9b-72b5-3e05-9e92-f52939948286",
                        "entry_id": "fc9eb469-26e5-329a-b5e1-4baa6a02373b",
                        "glosses": [
                            "die Wandlung des gesellschaftlich-kulturellen Lebens im Allgemeinen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4ca2f93-d488-489c-833d-06f959138129",
                                "sense_id": "b9472a9b-72b5-3e05-9e92-f52939948286",
                                "text": "„Erforscht werden in Wolfenbüttel nahezu alle Aspekte europäischer Kulturgeschichte vom Mittelalter bis zur Neuzeit.“"
                            },
                            {
                                "example_id": "294db8db-cb4f-453e-8433-34e4d1cd4317",
                                "sense_id": "b9472a9b-72b5-3e05-9e92-f52939948286",
                                "text": "„Mittels teilnehmender Beobachtung und literarischer Kulturgeschichte, die das Heutige mit dem Historischen verbindet, haben wir die Erfahrungen und Erlebnisse festgehalten, die wir während unserer Rheinfahrt machten.“"
                            },
                            {
                                "example_id": "d44b1731-5fd8-4b99-9cde-ad631fd8ec7a",
                                "sense_id": "b9472a9b-72b5-3e05-9e92-f52939948286",
                                "text": "„Casanovas Memoiren sind eine unerschöpfliche Quelle für die Kulturgeschichte des 18. Jahrhunderts.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9d608b3f-0702-386e-82ae-662801102d77",
                        "entry_id": "fc9eb469-26e5-329a-b5e1-4baa6a02373b",
                        "glosses": [
                            "die Kulturgeschichte als Wissenschaft"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "63031f7e-9aaf-3e45-978b-0659bb8e6dca",
                        "entry_id": "fc9eb469-26e5-329a-b5e1-4baa6a02373b",
                        "glosses": [
                            "ein Buch, das thematisch die Kulturgeschichte allgemein oder spezielle Aspekte dieser abhandelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b17261d5-4469-4413-9104-afa261e2afce",
                                "sense_id": "63031f7e-9aaf-3e45-978b-0659bb8e6dca",
                                "text": "„Nun, es ist nicht meine Absicht, eine Kulturgeschichte jener Zeit, geschweige denn eine allgemeine Literaturgeschichte zu schreiben.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
