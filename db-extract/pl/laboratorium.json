                    {
                        "sense_id": "15ddb666-b27e-3f62-ba3a-02d147bf2c6b",
                        "entry_id": "72510c9f-d1f1-3300-8d6e-23163ac48eb6",
                        "glosses": [
                            "pomieszczenie przeznaczone do przeprowadzania eksperymentów naukowych, analiz medycznych lub nadzorowania procesów technologicznych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f66d61c-c978-4be2-af8b-effeeb68c61c",
                                "sense_id": "15ddb666-b27e-3f62-ba3a-02d147bf2c6b",
                                "text": "Głównym celem istnienia laboratoriów pomiarowych jest wykonywanie wszelkiego typu pomiarów wielkości fizycznych i wzorcowań przyrządów pomiarowych"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "9828729c-dc0f-3936-8470-c9808140a664",
                        "entry_id": "72510c9f-d1f1-3300-8d6e-23163ac48eb6",
                        "glosses": [
                            "pomieszczenie przeznaczone do zajęć dydaktycznych, wymagających specjalistycznego sprzętu"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "b1f1e2bf-2f7e-331d-a926-dc3824456b1e",
                        "entry_id": "72510c9f-d1f1-3300-8d6e-23163ac48eb6",
                        "glosses": [
                            "zajęcia prowadzone w laboratorium (1.2)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "30639ad0-b225-44b9-b6bb-a2b3db1e4a15",
                                "sense_id": "b1f1e2bf-2f7e-331d-a926-dc3824456b1e",
                                "text": "Jeśli się nie pośpieszysz, spóźnimy się na laboratorium z elektroniki!"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "574ca5ad-38e9-4b93-bd55-6fd6a38e3e0e",
                        "source_entry_id": "72510c9f-d1f1-3300-8d6e-23163ac48eb6",
                        "source_sense_id": "15ddb666-b27e-3f62-ba3a-02d147bf2c6b",
                        "target_lang_word": "laboratory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laboratory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "23bbf32e-b26b-38b9-b585-f65d9b39cbcd",
                                        "entry_id": "6dd1bdb2-57d4-3ab5-9772-b196328e0668",
                                        "glosses": [
                                            "A room, building or institution equipped for scientific research, experimentation or analysis."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "85e931f8-3973-32fd-8c9e-b245f48c2865",
                                        "entry_id": "6dd1bdb2-57d4-3ab5-9772-b196328e0668",
                                        "glosses": [
                                            "A place where chemicals, drugs or microbes are prepared or manufactured."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dbc8d9e-a5af-42e2-9c8f-701da246d823",
                                                "sense_id": "85e931f8-3973-32fd-8c9e-b245f48c2865",
                                                "text": "Again she read the passage that had riveted her attention; and, rising from her seat, carried the still open volume, and laid it on a slab by the furnace in the laboratory: it was a celebrated treatise on poisons, written in the fifteenth century."
                                            },
                                            {
                                                "example_id": "efc8d63e-1711-495a-bc4a-b1ccd7aa1451",
                                                "sense_id": "85e931f8-3973-32fd-8c9e-b245f48c2865",
                                                "text": "[Isaac Newton] was obsessed with alchemy. He spent hours copying alchemical recipes and trying to replicate them in his laboratory. He believed that the Bible contained numerological codes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1549c001-daa3-415d-be81-b372f40363fa",
                        "source_entry_id": "72510c9f-d1f1-3300-8d6e-23163ac48eb6",
                        "source_sense_id": "15ddb666-b27e-3f62-ba3a-02d147bf2c6b",
                        "target_lang_word": "lab",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lab",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94f931a7-1b30-385f-a480-a9e306bb8aac",
                                        "entry_id": "723f5586-d0e9-3cd0-a601-ab948ec8fb5f",
                                        "glosses": [
                                            "A laboratory."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd2a2749-e807-449a-a89d-aa1bb77955c2",
                                                "sense_id": "94f931a7-1b30-385f-a480-a9e306bb8aac",
                                                "text": "I was working in the lab late one night\nWhen my eyes beheld an eerie sight\nFor my monster, from his slab, began to rise\nAnd suddenly, to my surprise\nHe did the Mash\nHe did the Monster Mash."
                                            },
                                            {
                                                "example_id": "97edc03d-3d8e-44ac-80b7-93a9972814f9",
                                                "sense_id": "94f931a7-1b30-385f-a480-a9e306bb8aac",
                                                "text": "A man dressed as a lab tech, his blue scrubs startlingly pale against the vivid red and black chaos, moved into sight from behind the SUV. He carried an assault rifle."
                                            },
                                            {
                                                "example_id": "fdca92d6-1c6e-4bfb-84ba-8fbc3d321eb8",
                                                "sense_id": "94f931a7-1b30-385f-a480-a9e306bb8aac",
                                                "text": "The NIAID supports projects at universities and research organizations around the United States as well as a network of 21 NIAID labs across the country."
                                            },
                                            {
                                                "example_id": "f6fee6f0-c97e-4c4a-8f9e-56adac636e91",
                                                "sense_id": "94f931a7-1b30-385f-a480-a9e306bb8aac",
                                                "text": "Since the lab has been \"doged,\" a petition posted to Change.org by Evgeny Stambulchik asked for signatures to oppose the layoff of the NIST Atomic Spectroscopy Group and has garnered 2,500 signatures as of reporting time. There is also a campaign website."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6797c318-9ade-3d80-bd08-d544c2607137",
                                        "entry_id": "723f5586-d0e9-3cd0-a601-ab948ec8fb5f",
                                        "glosses": [
                                            "Laboratory experiment, test, investigation or result."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f5b1611-466c-4552-a8ae-646684958c18",
                                                "sense_id": "6797c318-9ade-3d80-bd08-d544c2607137",
                                                "text": "I dropped my mixture while doing my lab, so I had to start over."
                                            }
                                        ]
                                    }
                                ]
                            },
