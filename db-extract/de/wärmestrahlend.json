                ],
                "senses": [
                    {
                        "sense_id": "bc551970-a897-386c-a5b9-f81322080e11",
                        "entry_id": "003b8386-4ea6-3579-a104-7c2117983df9",
                        "glosses": [
                            "Wärmeenergie abgebend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52c62a2a-7547-4d1e-8667-941a598feca8",
                                "sense_id": "bc551970-a897-386c-a5b9-f81322080e11",
                                "text": "Die wärmestrahlenden Hausfassaden in den Innenstädten in Hitzesommern stören Menschen, Tiere und Pflanzen."
                            },
                            {
                                "example_id": "e2d07c1a-9136-482c-b262-905fa5735afb",
                                "sense_id": "bc551970-a897-386c-a5b9-f81322080e11",
                                "text": "„Im Januar 2013 wurden die individuellen Bilder der wärmestrahlenden Dächer samt Infoschreiben versandt und sollten den Hauseigentümern vor Augen führen, welche Einsparmöglichkeiten sich auftun.“"
                            },
                            {
                                "example_id": "1891bfbb-46b8-4f96-a048-dc72755111bf",
                                "sense_id": "bc551970-a897-386c-a5b9-f81322080e11",
                                "text": "[Atommüll: Test für Endlagerung in Asse:] „Für Experimente mit dem hochaktiven, wärmestrahlenden Müll aus Amerika reicht das bergrechtliche Genehmigungsverfahren vom Bergamt in Clausthal.“"
                            },
                            {
                                "example_id": "14d8ed63-6e4d-4a48-b93a-186029c90021",
                                "sense_id": "bc551970-a897-386c-a5b9-f81322080e11",
                                "text": "„Planck übertrug dieses Konzept auf wärmestrahlende Körper und stellte seine Ergebnisse im März 1895 und Februar 1896 der Preußischen Akademie der Wissenschaften vor.“"
                            },
                            {
                                "example_id": "b1ee3152-6fa3-4a65-944e-db3c330b781e",
                                "sense_id": "bc551970-a897-386c-a5b9-f81322080e11",
                                "text": "„Die Arbeitsplätze sind gegen stark wärmestrahlende Einrichtungen (z. B. Grillbratereien) in geeigneter Weise zu schützen.“"
                            },
                            {
                                "example_id": "de10e84b-e0ca-4a87-9343-257d0b45091d",
                                "sense_id": "bc551970-a897-386c-a5b9-f81322080e11",
                                "text": "„Bis Mitte des 20. Jahrhunderts hatte die Wärmedämmung von Gebäuden einen geringen Stellenwert. Man behalf sich durch wärmende Bekleidung und das Zusammenrücken in wenigen, tagsüber mit vorwiegend wärmestrahlenden Einzelöfen beheizten Räumen.“"
                            },
                            {
                                "example_id": "35dc599b-1115-438b-be99-c68363a69492",
                                "sense_id": "bc551970-a897-386c-a5b9-f81322080e11",
                                "text": "„Bei den Bein- und Armamputierten ist noch zu beachten, daß die Gliedmaßenstümpfe vielfach wärmeempfindlich sind und daß deshalb unter Umständen die Beschäftigung der Amputierten in der Nähe wärmestrahlender Öfen und Apparate vermieden werden muss.“"
                            },
                            {
                                "example_id": "cfa4a06b-64ca-4225-af56-c19e7496c83a",
                                "sense_id": "bc551970-a897-386c-a5b9-f81322080e11",
                                "text": "„Grashalme haben im Vergleich zu ihrem Volumen eine relativ große wärmestrahlende Oberfläche.“"
                            },
                            {
                                "example_id": "9c9866c8-5f1d-40dd-b422-28a14523c71d",
                                "sense_id": "bc551970-a897-386c-a5b9-f81322080e11",
                                "text": "[Wir wenden] „uns seitwärts, klettern einen der jähen Bergesgrate hinan, und bald wird im Winter die Sonne wärmestrahlend uns beglücken, im Sommer die staubfreie Bergesluft uns laben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
