                                "target_senses": [
                                    {
                                        "sense_id": "bd1c5b8e-4024-3b5c-8359-65cd0a9bae7d",
                                        "entry_id": "8e2ae62d-2e96-3e47-8e4a-1ca1c3a24b26",
                                        "glosses": [
                                            "Membre du parti nazi d’Adolf Hitler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85d01b50-2484-4f27-98fa-12a35edeabec",
                                                "sense_id": "bd1c5b8e-4024-3b5c-8359-65cd0a9bae7d",
                                                "text": "Joachim von Ribbentrop n’est pas, comme les deux premiers, un nazi de la première heure, puisqu’il n’adhère au parti qu’en 1932."
                                            },
                                            {
                                                "example_id": "46531df8-9d48-4d18-bd66-d8477f058601",
                                                "sense_id": "bd1c5b8e-4024-3b5c-8359-65cd0a9bae7d",
                                                "text": "Dans l’Italie post-fasciste, par exemple, ce sont les collaborateurs, et non les fascistes, qui ont été visés ; en Hongrie, la loi de lustration post-communiste incluait des nazis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2340d836-e07a-3a3e-aa3d-73aaff485bd9",
                                        "entry_id": "8e2ae62d-2e96-3e47-8e4a-1ca1c3a24b26",
