                                        "glosses": [
                                            "in alle Bereiche des Lebens hineinwirkend, meist auch autoritär, undemokratisch, gewaltsam reglementierend"
                                        ],
                                        "tags": [
                                            "Erziehung"
                                        ],
                                        "examples": [
