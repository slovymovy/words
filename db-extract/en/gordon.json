                        "entry_id": "651c4855-38c4-33d7-ae5d-48c9229ea1cf",
                        "glosses": [
                            "A Scottish habitational surname from the Celtic languages for someone from Gordon, Berwickshire."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5f1ec51c-5f8a-3483-9f67-c33d2694419c",
                        "entry_id": "651c4855-38c4-33d7-ae5d-48c9229ea1cf",
                        "glosses": [
                            "An English habitational surname from Anglo-Norman for someone from Gourdon, France."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "768d1572-2810-36eb-bab9-265e21387d4a",
                        "entry_id": "651c4855-38c4-33d7-ae5d-48c9229ea1cf",
                        "glosses": [
                            "A habitational surname from Irish, an anglicization of de Górdún (“of Gordon (Berwickshire)”)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7c63a5ab-95b3-3c7d-8402-0d8820bb8bdb",
                        "entry_id": "651c4855-38c4-33d7-ae5d-48c9229ea1cf",
                        "glosses": [
                            "A surname from Irish [in turn originating as a patronymic], an adopted anglicization of Mag Mhuirneacháin (“son of Muirneachán”) (traditionally Magournahan)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1afaa7ef-163f-3d73-a368-70ac3c10aaa2",
                        "entry_id": "651c4855-38c4-33d7-ae5d-48c9229ea1cf",
                        "glosses": [
                            "A Jewish habitational surname probably for someone from Grodno, Belarus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cc91f31-83d9-4674-a3c2-0cf14e96a67c",
                                "sense_id": "1afaa7ef-163f-3d73-a368-70ac3c10aaa2",
                                "text": "Mount, vassals, couch your lances, and cry, \"Gordon!\nGordon for Scotland and Elizabeth!\""
                            }
                        ]
                    },
                    {
                        "sense_id": "38dd565f-5b14-3570-9134-c7b453a75588",
                        "entry_id": "651c4855-38c4-33d7-ae5d-48c9229ea1cf",
                        "glosses": [
                            "A male given name transferred from the surname."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d249cdd9-5acb-404b-ab8c-237de7481f97",
                                "sense_id": "38dd565f-5b14-3570-9134-c7b453a75588",
                                "text": "Often he wrote good ones on casual slips and fancied them his; names like Trevellyan or Montressor or Delancey, with musical prefixes; or a good, short, beautiful, but dignified name like \"Gordon Dane\". He liked that one. It suggested something."
                            }
                        ]
