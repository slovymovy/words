                "senses": [
                    {
                        "sense_id": "f6224c1d-3e80-3f29-991b-44ad642e7bd8",
                        "entry_id": "a0f15fdf-79a3-37b0-8769-e002ad0a9eab",
                        "glosses": [
                            "Séculariser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f8334cc-bcad-4c97-9f5a-fc006ef397d2",
                                "sense_id": "f6224c1d-3e80-3f29-991b-44ad642e7bd8",
                                "text": "En même temps s'est développée la volonté de renouveler le sens social des valeurs religieuses, de reséculariser les universaux du christianisme et de reconstruire un ordre politique et social nourri et entretenu par la foi chrétienne."
                            },
                            {
                                "example_id": "df59055c-04ff-45d2-9a57-b95212ad1750",
                                "sense_id": "f6224c1d-3e80-3f29-991b-44ad642e7bd8",
                                "text": "Et on ne peut pas retrouver le rapport au monde des Grecs depuis que le monde est devenu un saeculum, qui a dû lui-même être d'abord resécularisé."
                            }
                        ]
                    }
                ],
