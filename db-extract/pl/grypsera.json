                                    {
                                        "sense_id": "1d37080c-08a9-307e-a8b2-4cb4d0404f6e",
                                        "entry_id": "ac52943e-d5aa-3510-bb06-eff66b500ef5",
                                        "glosses": [
                                            "Oiseau de proie rapace diurne à queue fourchue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "236cb17b-26ee-43b9-831c-88d51c667d25",
                                                "sense_id": "1d37080c-08a9-307e-a8b2-4cb4d0404f6e",
                                                "text": "C’était quelque chose de l’immobilité d’un milan qui vient de découvrir un nid de moineaux et qui le regarde."
                                            },
                                            {
                                                "example_id": "d479e909-1e16-411a-bca5-53dda87ab60f",
                                                "sense_id": "1d37080c-08a9-307e-a8b2-4cb4d0404f6e",
                                                "text": "Dans cette pensée, conçue au feu d’un désir frénétique, il tomba sur la comtesse de Vandenesse comme un milan sur sa proie."
                                            },
                                            {
                                                "example_id": "8eca5307-57e7-4c96-bb31-5625df08f6b4",
                                                "sense_id": "1d37080c-08a9-307e-a8b2-4cb4d0404f6e",
                                                "text": "Marthe alla au buffet, il la suivit ; elle revint à la salle d’attente, il la suivit encore ; elle était comme un oiseau que chasse un milan, et elle commençait à perdre la tête."
                                            },
                                            {
                                                "example_id": "10a7e401-7980-4568-8236-60e44fd1ab91",
                                                "sense_id": "1d37080c-08a9-307e-a8b2-4cb4d0404f6e",
                                                "text": "En haut, des milans planaient au-dessus des arbres et franchissaient l'étendue lisse du Nil, …."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
