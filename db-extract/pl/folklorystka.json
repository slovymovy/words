                "translations": [
                    {
                        "translation_id": "fc4680d6-43b7-473e-b389-da489ddafd82",
                        "source_entry_id": "33070129-7929-3a30-9794-920b72d49f03",
                        "source_sense_id": "9df00469-1ef1-3dcd-b741-3f93cbf8ffb7",
