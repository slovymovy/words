                        "entry_id": "90135a50-bff2-3871-a978-ba0a171e81f3",
                        "glosses": [
                            "Que l’on ne peut pas rassembler."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "35b53981-9033-4d1e-88bd-ff217fa0b547",
                                "sense_id": "e459f9de-8c74-3803-b3f7-ac6f3e17e6ea",
                                "text": "Quoiqu’il eût déchiré la lettre et en eût éparpillé au vent les morceaux irrassemblables, Jacques s’en rappelait les termes comme s’il les avait eus encore sous les yeux."
                            },
                            {
                                "example_id": "00334278-1562-400e-a5b7-414207b76c56",
                                "sense_id": "e459f9de-8c74-3803-b3f7-ac6f3e17e6ea",
                                "text": "J’émerge d’instant en instant, de trou en trou, abruti de somnolence étrange, mourante, éclipsée, sableuse, comme un tout irrassemblable, par bouts ; je ne comprends rien, puis un peu puis rien, ni de ce qu’il dit ni de cet endroit où nous sommes, ni de l’heure."
                            }
                        ]
                    }
