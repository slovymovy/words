                "senses": [
                    {
                        "sense_id": "626eea08-816a-36d9-af26-ba46266c6b5f",
                        "entry_id": "454db29a-bf92-3f99-92e3-1195f5427825",
                        "glosses": [
                            "Supprimer partiellement ou totalement des unités d’une équation par une substitution appropriée de variables, dans le but de simplifier la représentation paramétrique de problèmes physiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1bac95e-8d0c-474c-a70d-5667dcbb7dcf",
                                "sense_id": "626eea08-816a-36d9-af26-ba46266c6b5f",
                                "text": "Adimensionner une équation différentielle en physique revient à spécifier le nombre minimal de paramètres de contrôle (sans dimension) qui régissent la solution mathématique de l’équation."
                            },
                            {
                                "example_id": "de15f387-0a18-4a55-ac56-2ad6e34d8a58",
                                "sense_id": "626eea08-816a-36d9-af26-ba46266c6b5f",
                                "text": "Pour exploiter ce modèle plus simplement par la suite, il est utile d’adimensionner les trois équations de base."
                            }
                        ]
                    }
                ],
