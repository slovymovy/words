                                        "entry_id": "d27e59d6-38ad-3997-b323-59ba052ac6f0",
                                        "glosses": [
                                            "Palermo betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "001a7f0e-8f71-4043-b6b4-19a37c0d71b3",
                                                "sense_id": "eef241f1-123e-30c4-849d-58fa9fb61526",
                                                "text": "„Viele palermitanische Adelspaläste hatten diese segensreiche Einrichtung eines tiefgelegenen Raumes, durch den ein Wasserlauf geleitet wurde.“"
                                            },
                                            {
                                                "example_id": "cc8e0bfa-4502-4e52-bf19-6dded4999282",
                                                "sense_id": "eef241f1-123e-30c4-849d-58fa9fb61526",
                                                "text": "„Palermitanische Erinnerungskultur ruft während der Wanderbiennale Manifesta die Caravaggio-Affäre wieder ins Gedächtnis.“"
                                            },
                                            {
                                                "example_id": "c16bb097-6ed6-431c-bcd4-e9a54c3a2557",
                                                "sense_id": "eef241f1-123e-30c4-849d-58fa9fb61526",
                                                "text": "„Auf Napolitanos Integrität ist erst vergangenes Jahr ein leichter Schatten gefallen, als ihm palermitanische Staatsanwälte vorhielten, er habe etwas mit illegalen Absprachen zwischen Staat und Mafia zu tun gehabt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
