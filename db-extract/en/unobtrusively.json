                ],
                "senses": [
                    {
                        "sense_id": "a7ae82ec-1f1c-39c0-bf0c-f0c8a6bc7596",
                        "entry_id": "c7b6aa89-60a3-3e63-9164-1f174665427a",
                        "glosses": [
                            "In an unobtrusive manner; in a manner that is not noticeable or blatant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "488f4993-4c23-405d-9ea6-bf2f2b4be7dd",
                                "sense_id": "a7ae82ec-1f1c-39c0-bf0c-f0c8a6bc7596",
                                "text": "He felt not the slightest doubt in his mind that this was the girl who had written him, and, having given an order to the waiter, he started to study her face as unobtrusively as possible."
                            },
                            {
                                "example_id": "9064eefa-1b4f-4e27-af69-5c614cdd9616",
                                "sense_id": "a7ae82ec-1f1c-39c0-bf0c-f0c8a6bc7596",
                                "text": "Sometimes she and Miss Baker talked at once, unobtrusively and with a bantering inconsequence that was never quite chatter, that was as cool as their white dresses and their impersonal eyes in the absence of all desire."
                            },
                            {
                                "example_id": "b085dcdb-53be-449a-b90c-89d2832816e7",
                                "sense_id": "a7ae82ec-1f1c-39c0-bf0c-f0c8a6bc7596",
                                "text": "Eudemis moved hastily but as unobtrusively as he could through the gaping crowd[.]"
                            },
                            {
                                "example_id": "d3a5531f-1aa4-42ae-b638-dc69cca6e381",
                                "sense_id": "a7ae82ec-1f1c-39c0-bf0c-f0c8a6bc7596",
                                "text": "Most of the old fishermen's cottages have been unobtrusively modernised, the harbour is busy with summer yachts, and the sands are superb."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "69db2a24-5f97-419c-8698-2e6b42eac1c6",
                        "source_entry_id": "c7b6aa89-60a3-3e63-9164-1f174665427a",
                        "source_sense_id": "a7ae82ec-1f1c-39c0-bf0c-f0c8a6bc7596",
                        "source_sense_description": "in a manner that is not noticeable or blatant",
                        "target_lang_word": "discrètement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "discrètement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e3d90b2a-dfed-37e3-b360-d892dcd54a7a",
                                        "entry_id": "b3fbd14b-9781-3b97-b122-fee050016840",
                                        "glosses": [
                                            "Avec retenue ; avec réserve."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5532403f-3889-4ac3-8bc1-53349b6e72fb",
                                                "sense_id": "e3d90b2a-dfed-37e3-b360-d892dcd54a7a",
                                                "text": "Elle fixa sur ses cheveux relevés un de ces délicieux chapeaux qu'on ne trouve qu'à Paris, sorte de tambourin de paille noir discrètement orné de fleurettes roses et d'une voilette."
                                            },
                                            {
                                                "example_id": "76ed16df-bb9d-4ae6-aa8d-63a4e23f2b4b",
                                                "sense_id": "e3d90b2a-dfed-37e3-b360-d892dcd54a7a",
                                                "text": "Pour le prouver, et alors que les reptiles s’accouplent généralement discrètement, Megan Folwell table sur l’étude de leurs circuits neuronaux."
                                            },
                                            {
                                                "example_id": "a820a3e4-fe47-4039-912b-5bd7fc83dbcd",
                                                "sense_id": "e3d90b2a-dfed-37e3-b360-d892dcd54a7a",
                                                "text": "Je continuerais ici, monseigneur, bien volontiers ce discours ; mais je crains de n'user pas assez discrètement de la liberté que l’on m’a donnée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc796c29-7a97-3201-a7b4-36fc864df7f7",
                                        "entry_id": "b3fbd14b-9781-3b97-b122-fee050016840",
                                        "glosses": [
                                            "Sans dire ce qui doit être tu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7005c691-c0de-4c99-867c-9ee7837a7357",
                                                "sense_id": "dc796c29-7a97-3201-a7b4-36fc864df7f7",
                                                "text": "Au bled, le père s'était remarié en scred, discrètement, avec une jeunette, sans dire qu'il avait un fils de cinq ans."
                                            },
                                            {
                                                "example_id": "87755400-a82e-44f5-8418-914e15e2d614",
                                                "sense_id": "dc796c29-7a97-3201-a7b4-36fc864df7f7",
                                                "text": "Vous affûtez vos armes discrètement."
                                            },
                                            {
                                                "example_id": "dbf23be4-d874-48ee-bc7f-7005cbb3f917",
                                                "sense_id": "dc796c29-7a97-3201-a7b4-36fc864df7f7",
                                                "text": "Ce soir les hommes ont allumé un brasier et nous avons dîné de succulentes grillades, merguez et côtes d'agneau. Nous avons même bu un verre de boulaouane, mais discrètement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc86e542-3410-3e46-86e3-688688109a0c",
                                        "entry_id": "b3fbd14b-9781-3b97-b122-fee050016840",
                                        "glosses": [
                                            "De façon discontinue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ef79fa4-26b8-4325-b1fa-ddfa389e2590",
                                                "sense_id": "cc86e542-3410-3e46-86e3-688688109a0c",
                                                "text": "La taille d'une population d'insectes varie discrètement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "295a1720-dfbb-4a50-a572-b2b38b4305b8",
                        "source_entry_id": "c7b6aa89-60a3-3e63-9164-1f174665427a",
                        "source_sense_id": "a7ae82ec-1f1c-39c0-bf0c-f0c8a6bc7596",
                        "source_sense_description": "in a manner that is not noticeable or blatant",
                        "target_lang_word": "en catimini",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en catimini",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a0c185b3-7739-3ed7-9c37-ec2a2b1a7aad",
                                        "entry_id": "023fff36-da5c-391c-8f9d-29752c2a1363",
                                        "glosses": [
                                            "En cachette, discrètement, en secret."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "691cc81e-4815-4655-88e2-d96edf181497",
                                                "sense_id": "a0c185b3-7739-3ed7-9c37-ec2a2b1a7aad",
                                                "text": "Un grand jeune blondin, que je me souviens de n’avoir point vu durant l’éclipse de la belle, rentra en catimini."
                                            },
                                            {
                                                "example_id": "e5bcce45-4386-4bbe-9326-a22775fa1cd3",
                                                "sense_id": "a0c185b3-7739-3ed7-9c37-ec2a2b1a7aad",
                                                "text": "[…] par la porte de service de la Préfecture la bonne tante s'en va seule, sans tambour ni trompette ni clocheton, vers quelque village proche et inconnu où dans une fosse creusée pour une autre on l'enterre en catimini, à peine froide."
                                            },
                                            {
                                                "example_id": "84b384e1-c019-4d4f-86ca-ea4c30798910",
                                                "sense_id": "a0c185b3-7739-3ed7-9c37-ec2a2b1a7aad",
                                                "text": "[…] je n’accepte pas d’entrevue en catimini, à Marrakech, à Biskra ou ailleurs. J’entends aller à Alger en plein jour et en pleine dignité."
                                            },
                                            {
                                                "example_id": "0db1217a-c5f1-400c-b6d7-1752ff5b6daa",
                                                "sense_id": "a0c185b3-7739-3ed7-9c37-ec2a2b1a7aad",
                                                "text": "Mon grand-père met les louis d’or sans jamais les compter dans la poche de son veston ; ma grand-mère, insomniaque, se glisse, la nuit, dans le vestibule pour prélever sa dîme « en catimini » comme elle dit elle-même à sa fille."
                                            },
                                            {
                                                "example_id": "87493a36-6c8e-4f1c-8036-c4d82a0ee0d7",
                                                "sense_id": "a0c185b3-7739-3ed7-9c37-ec2a2b1a7aad",
                                                "text": "Non que les myopies soient ici plus répandues qu’ailleurs, mais nettoyer ses verres avec un pan de chemise sorti en catimini du pantalon, avec un coin de nappe au restaurant ou l’angle intact d’un mouchoir roulé en boule au creux de la main, le risque se multiplie que les lunettes se démantibulent, tombent et se brisent."
                                            },
                                            {
                                                "example_id": "d0271847-b665-4b00-b4bf-3ea810f07ad9",
                                                "sense_id": "a0c185b3-7739-3ed7-9c37-ec2a2b1a7aad",
                                                "text": "C’est en catimini qu’Emmanuel Macron, alors secrétaire général adjoint de l’Élysée, a supervisé le processus qui devait aboutir, en avril 2014, à la vente de la branche énergie d’Alstom à General Electric."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a48c8caf-e2ee-4add-a39f-4c1f38b5a2fe",
                        "source_entry_id": "c7b6aa89-60a3-3e63-9164-1f174665427a",
                        "source_sense_id": "a7ae82ec-1f1c-39c0-bf0c-f0c8a6bc7596",
                        "source_sense_description": "in a manner that is not noticeable or blatant",
                        "target_lang_word": "en douce",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en douce",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dfd47dda-cb1f-3d5d-b065-24afd64c1cb2",
                                        "entry_id": "3f1f51c7-cb81-3967-9cf1-6e188ab0e6aa",
                                        "glosses": [
                                            "En essayant de ne pas se faire voir, de ne pas attirer l’attention."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "429a8929-0eea-4e9d-971a-e9be5d199d7f",
                                                "sense_id": "dfd47dda-cb1f-3d5d-b065-24afd64c1cb2",
                                                "text": "Tu parles d’un mecton qui connaissait les heures des trains ! Tu l’voyais s’rentrer en s’glissant en douce dans un groupe du dépôt où c’était l’filon, et y rester, toujours en douce poil-poil, et même, i’ s’donnait beaucoup d’mal pour que les copains ayent besoin de lui."
                                            },
                                            {
                                                "example_id": "cb151ebc-8a80-480e-b0b1-53acb81de937",
                                                "sense_id": "dfd47dda-cb1f-3d5d-b065-24afd64c1cb2",
                                                "text": "De n’pas danser, on mord les autres, n’est-ce pas ? et j’ai justement vu — quand tu m’interrogeais — une connaissance avec qui j’suis en affaire et qui, en douce, m’a fait signe de rappliquer."
                                            },
                                            {
                                                "example_id": "a5ffee8d-a086-467f-9b68-b524fca493cb",
                                                "sense_id": "dfd47dda-cb1f-3d5d-b065-24afd64c1cb2",
                                                "text": "J’ai fait ça en douce\nJe suis v’nue je n’sais pas comment […]"
                                            },
                                            {
                                                "example_id": "32f8652c-17b5-4582-b91c-eede2869d971",
                                                "sense_id": "dfd47dda-cb1f-3d5d-b065-24afd64c1cb2",
                                                "text": "Tenez, les gars, dans un aut’film que j’me suis payé à Noël, en douce, la Chair et le Diable, y a une femme ! Oh ! là là."
                                            },
                                            {
                                                "example_id": "bfba429f-7fe0-4242-8b48-e0a26546dac9",
                                                "sense_id": "dfd47dda-cb1f-3d5d-b065-24afd64c1cb2",
                                                "text": "– Tu pourrais me signer mon cahier ?\n– Bien sûr. […] Voyons voir… “Louis ne sait pas se tenir en classe.”\n Ah, je comprends mieux. Tu veux me faire signer ton cahier en douce pour éviter de le montrer à ta mère."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "56d60d75-01b0-47a8-8818-7ae4ef104a82",
                        "source_entry_id": "c7b6aa89-60a3-3e63-9164-1f174665427a",
                        "source_sense_id": "a7ae82ec-1f1c-39c0-bf0c-f0c8a6bc7596",
                        "source_sense_description": "in a manner that is not noticeable or blatant",
                        "target_lang_word": "en cachette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en cachette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "226d8760-505b-334c-87c7-47bcd70651e6",
                                        "entry_id": "313f273b-3a5d-3599-b8fd-8901bb6f0f6f",
                                        "glosses": [
                                            "En secret : à la dérobée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b087d0a3-5fd7-41dc-8572-ea38c70be093",
                                                "sense_id": "226d8760-505b-334c-87c7-47bcd70651e6",
                                                "text": "Souvenez-vous des paroles de nos pères théologiens, Hurtado de Mendoza et Sanchez, qui ont prouvé qu’on peut tuer en cachette son ennemi, puisque l’on évite par ce moyen deux péchés : celui d’exposer sa vie, et celui de se battre en duel. C’est d’après ce grand principe consolateur que j’ai toujours agi."
                                            },
                                            {
                                                "example_id": "855bb94c-17d6-465d-8309-7b8d31491cdf",
                                                "sense_id": "226d8760-505b-334c-87c7-47bcd70651e6",
                                                "text": "Puisque j'arrivais à tenir et à diriger un porte-plume, pourquoi pas aussi un petit pinceau ? En cachette, j’essayai, je m’évertuai, j’éduquai mes doigts et mon poignet et j’arrivai à un résultat relativement satisfaisant."
                                            },
                                            {
                                                "example_id": "6b80f6eb-22b2-440b-9ca4-26392a369a4e",
                                                "sense_id": "226d8760-505b-334c-87c7-47bcd70651e6",
                                                "text": "– Demande à papa. Dis-lui que c’est pour acheter des cigarettes et que tu les lui demandes en cachette de maman, il te les donnera."
                                            },
                                            {
                                                "example_id": "08475ea3-fa0c-426f-bc32-3cc907a16fcd",
                                                "sense_id": "226d8760-505b-334c-87c7-47bcd70651e6",
                                                "text": "Elle buvait en cachette tandis que vous vous écriviez, en cachette aussi, un livre sur ce drame."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
