                "senses": [
                    {
                        "sense_id": "a2300f68-d37f-3be2-ba45-5c693937b665",
                        "entry_id": "5964dfab-c31c-3c8c-88f4-503dbacda35a",
                        "glosses": [
                            "Eigenschaft, so zu sein, wie man es einer ländlichen Gegend (Provinz) und den Menschen, die dort leben, zuschreibt, unmodern, konservativ und schlicht gestrickt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1473eac-bbd7-4e94-a623-d98ca3be61e7",
                                "sense_id": "a2300f68-d37f-3be2-ba45-5c693937b665",
                                "text": "„Ein herausragendes Kennzeichen der Provinzialität ist insbesondere der oft unbewusste Zustand permanenter Gekränktheit, der sich nicht zuletzt aus Verschwörungstheorien speist. Damit verbunden ist die Vorstellung, dass Provinzialität auf einer besonderen Art der sozialen Bindung beruht.“"
                            },
                            {
                                "example_id": "d7e4d6bb-cf9b-4aea-a78a-f811a91fd3bc",
                                "sense_id": "a2300f68-d37f-3be2-ba45-5c693937b665",
                                "text": "„Regionale Literatur wird häufig, oft allzu rasch, mit dem Etikett der Provinzialität versehen.“"
                            },
                            {
                                "example_id": "302a14f5-3290-4c57-89ee-9727b8c8d179",
                                "sense_id": "a2300f68-d37f-3be2-ba45-5c693937b665",
                                "text": "„Durch Sophie würde es möglich sein, so hoffte ich, all meine Provinzialität abzuschütteln und mich zum Weltenbummler zu mausern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
