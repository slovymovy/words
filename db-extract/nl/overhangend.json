                        "examples": [
                            {
                                "example_id": "76ea977f-d7c5-4c00-b0dd-a0ebd02a0610",
                                "sense_id": "cd756e93-9c02-3c50-848d-b755ab964af5",
                                "text": "Regelmatige (lawaai)overlast van jongeren op het speelveldje tussen de Rijn- en Merwedestraat, overhangende takken op het schelpenpaadje langs de Regge en her en der door boomwortels opgedrukte trottoirtegels waren de belangrijkste punten, die volgens de deelnemers aan de schouw op korte termijn moeten worden aangepakt."
                            },
                            {
                                "example_id": "088b0d97-fad5-4b0c-a3a8-4bce39b72950",
                                "sense_id": "cd756e93-9c02-3c50-848d-b755ab964af5",
                                "text": "De boot wordt altijd in het najaar gebruikt om het overhangende groen op de eilandjes van het water weg te halen."
                            }
                        ]
                    }
                ],
