                "senses": [
                    {
                        "sense_id": "b7d34945-880b-348b-b0b4-b0aabda33770",
                        "entry_id": "888e5981-9dfd-3770-9e66-52bf38a0592c",
                        "glosses": [
                            "Se cuire de soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c539857b-13ad-413e-b831-beddbab7e37f",
                                "sense_id": "b7d34945-880b-348b-b0b4-b0aabda33770",
                                "text": "Je voulais échapper au réveillon chez ma belle-fille, autant dire à un calvaire, elle cuisine avec ses pieds, même une dinde s’autocuirait mieux."
                            },
                            {
                                "example_id": "a995945b-8aeb-417d-bfb0-1b7abaf33e5c",
                                "sense_id": "b7d34945-880b-348b-b0b4-b0aabda33770",
                                "text": "Le spag ne va pas s’autocuire, les filles !"
                            },
                            {
                                "example_id": "91b5df9a-b13f-4df5-b3e4-96b2edd15736",
                                "sense_id": "b7d34945-880b-348b-b0b4-b0aabda33770",
                                "text": "Le bol est mal rempli, le plat était pas assez chaud, du coup le boeuf cru s’autocuisait mal."
                            }
                        ]
                    }
                ],
