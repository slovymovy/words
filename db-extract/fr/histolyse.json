                        "entry_id": "f2059c68-3fa9-3889-ae82-6013201cca7e",
                        "glosses": [
                            "Destruction de tissu cellulaire par les lysosomes d’un organisme, en particulier lors de la métamorphose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af665e61-20f7-42c5-923e-4cbc63722513",
                                "sense_id": "475ef654-6167-3716-9c56-eab049bb1258",
                                "text": "Lorsque l’histolyse est particulièrement rapide (Diptères), les leucocytes ou phagocytes semblent dévorer les tissus et en accumuler la substance pour refaire des tissus."
                            },
                            {
                                "example_id": "d3a28714-bf1a-4836-9c04-c2a708aa39fb",
                                "sense_id": "475ef654-6167-3716-9c56-eab049bb1258",
                                "text": "La T3 possède un rôle trophique sur la croissance des pattes postérieures, mais induit l’histolyse de la queue du têtard."
                            }
                        ]
                    }
                ],
