                        "entry_id": "9ac09097-3177-3310-8f9d-c6cd189705d6",
                        "glosses": [
                            "A device to guide a line, rope or cable around an object or out of the way, or to stop it from moving laterally."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3d41122-8903-486e-9fdf-f9d82b9829d2",
                                "sense_id": "da0a472b-f117-3a26-a638-4b3477a5e9b2",
                                "text": "Approach the boat from the bow and use the Cunningham fairlead to help guide the foot of the mast into the hole in the hull."
                            }
                        ]
                    }
