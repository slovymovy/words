                                        "sense_id": "674fd3a3-4a9f-3d65-8dfc-435ece9c07ca",
                                        "entry_id": "6991f5ab-d3e8-337c-9b2b-2f6ad7baa27c",
                                        "glosses": [
                                            "The historic district of a city or town."
                                        ],
                                        "tags": [
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cbf34d5-de8d-4c58-97a4-f2e1b013e872",
                                                "sense_id": "674fd3a3-4a9f-3d65-8dfc-435ece9c07ca",
                                                "text": "He's living in old town these days."
                                            },
                                            {
                                                "example_id": "57d7753a-9d3b-4cd3-8e81-e60f640476fa",
                                                "sense_id": "674fd3a3-4a9f-3d65-8dfc-435ece9c07ca",
                                                "text": "She has a sunny apartment in the old town."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e52b16a0-f06c-34e1-9730-a63236b98d48",
                                        "entry_id": "6991f5ab-d3e8-337c-9b2b-2f6ad7baa27c",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see old, town."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d09d34e-39ba-4458-a751-0735df9da0e3",
                                                "sense_id": "e52b16a0-f06c-34e1-9730-a63236b98d48",
                                                "text": "St. Augustine, Florida, is a seriously old town by New World standards."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa13473c-77cf-4ba0-9aab-1cbd91d2a4dd",
                        "source_entry_id": "607235c6-4831-379b-b17d-c742ac65de4f",
                        "source_sense_id": "f0d555a6-7210-3d42-b776-afea723f2016",
                        "target_lang_word": "casco antiguo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d1080140-2366-43cf-9333-8a721efcf222",
                        "source_entry_id": "607235c6-4831-379b-b17d-c742ac65de4f",
                        "source_sense_id": "f0d555a6-7210-3d42-b776-afea723f2016",
                        "target_lang_word": "Altstadt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Altstadt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0d8248dc-1ffa-30b8-b516-26b39ea6f5d4",
                                        "entry_id": "784e7bb2-530a-3630-94f7-901d0e23f4a6",
                                        "glosses": [
                                            "der älteste Teil einer Stadt, sofern dieser (typischerweise) vor 1900 gebaut wurde oder in einem entsprechendem Stil wiederaufgebaut worden ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8552faea-6f11-4211-a182-614f99cb7e45",
                                                "sense_id": "0d8248dc-1ffa-30b8-b516-26b39ea6f5d4",
                                                "text": "In der Altstadt von Prag gibt es Gebäude aus dem 14. Jahrhundert."
                                            },
                                            {
                                                "example_id": "c89327d6-e499-495f-b819-04c9aa4bfd14",
                                                "sense_id": "0d8248dc-1ffa-30b8-b516-26b39ea6f5d4",
                                                "text": "Seit Ende des Zweiten Weltkrieges hat Berlin keine Altstadt mehr."
                                            },
                                            {
                                                "example_id": "9d1c8e22-cd68-4141-bc4d-cc963e87e8de",
                                                "sense_id": "0d8248dc-1ffa-30b8-b516-26b39ea6f5d4",
                                                "text": "„Der Reiseführer setzte unbeirrt seine Tour fort, und bald darauf betraten wir die Altstadt von Kairo mit ihren vielen Kirchen.“"
                                            },
                                            {
                                                "example_id": "6caf34bf-2c3b-4c89-a319-eb88990f8092",
                                                "sense_id": "0d8248dc-1ffa-30b8-b516-26b39ea6f5d4",
                                                "text": "„Es hat mich immer gewundert, dass die Neustadt so hieß, obwohl dort viel mehr alte und verfallene Häuser standen als in der Altstadt, die nach der Zerstörung größtenteils abgerissen und neu gebaut wurde. Eine neue Altstadt, funktional und uncharmant.“"
                                            },
                                            {
                                                "example_id": "462c6958-d858-4085-b3d8-61fd99740025",
                                                "sense_id": "0d8248dc-1ffa-30b8-b516-26b39ea6f5d4",
                                                "text": "„Sie mündet in die Warschauer Altstadt, der man es ebenfalls nicht ansieht, daß sie nur vierzig Jahre alt ist.“"
                                            },
                                            {
                                                "example_id": "e27e9869-4dc9-486a-94af-337e8d16ac13",
                                                "sense_id": "0d8248dc-1ffa-30b8-b516-26b39ea6f5d4",
                                                "text": "„Im Rahmen der BUGA entsteht hier ein attraktiver, großzügiger Landschaftspark, der einen Gegenpol zu dem regen Leben in der Altstadt bietet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
