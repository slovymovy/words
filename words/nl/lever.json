                    "frequency": "Middle",
                    "semantic_group_id": "voedsel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In dit restaurant serveren ze gebakken <w>lever</w> met uien en spek.",
                            "target_lang_translations": {
                                "en": "In this restaurant, they serve fried <w>liver</w> with onions and bacon."
                            }
                        },
                        {
                            "text": "Veel mensen vinden de smaak van <w>lever</w> te sterk voor hun persoonlijke voorkeur.",
                            "target_lang_translations": {
                                "en": "Many people find the taste of <w>liver</w> too strong for their personal preference."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gebakken lever"
                    ],
                    "target_lang_definitions": {
                        "en": "The organ of an animal used as food or an ingredient in cooking."
