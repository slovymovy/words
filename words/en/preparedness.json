                    "frequency": "Middle",
                    "semantic_group_id": "readiness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team showed great <w>preparedness</w> for the upcoming championship match.",
                            "target_lang_translations": {
                                "de": "Das Team zeigte eine große <w>Bereitschaft</w> für das bevorstehende Meisterschaftsspiel."
                            }
                        },
                        {
                            "text": "His <w>preparedness</w> for the exam helped him achieve a high score.",
                            "target_lang_translations": {
                                "de": "Sein <w>Vorbereitetsein</w> auf die Prüfung half ihm, ein hohes Ergebnis zu erzielen."
                            }
                        }
                    ],
                    "synonyms": [
