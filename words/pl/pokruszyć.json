                    "frequency": "Middle",
                    "semantic_group_id": "kruszenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kucharka postanowiła <w>pokruszyć</w> chleb na mniejsze kawałki do zupy.",
                            "target_lang_translations": {
                                "en": "The cook decided to <w>crumble</w> the bread into smaller pieces for the soup."
                            }
                        },
                        {
                            "text": "Musisz drobno <w>pokruszyć</w> herbatniki, aby przygotować spód do tego ciasta.",
                            "target_lang_translations": {
                                "en": "You need to finely <w>crush</w> the biscuits to prepare the base for this cake."
                            }
                        }
                    ],
                    "synonyms": [
                        "rozkruszyć",
                        "pokruszeć"
                    ],
                    "common_phrases": [
                        "pokruszyć chleb",
                        "pokruszyć ciastka"
                    ],
                    "target_lang_definitions": {
                        "en": "to break or crush something into small pieces or crumbs"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crumble",
                                "target_lang_sense_clarification": "to break something into small pieces"
                            },
                            {
                                "target_lang_word": "crush",
                                "target_lang_sense_clarification": "to press and break into fragments"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af3dc8ed-c94a-33bb-8b45-ce894b5332bc",
                    "sense_definition": "rozpaść się na drobne kawałki lub okruchy",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "kruszenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stary tynk na ścianie zaczął pękać i wreszcie zupełnie się <w>pokruszył</w>.",
                            "target_lang_translations": {
                                "en": "The old plaster on the wall began to crack and finally completely <w>crumbled</w>."
                            }
                        },
                        {
                            "text": "Suchy wafelek <w>pokruszył</w> się w dłoniach, zanim zdążyłem go zjeść.",
                            "target_lang_translations": {
                                "en": "The dry wafer <w>crumbled</w> in my hands before I could eat it."
                            }
                        }
