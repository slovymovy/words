            {
                "entry_id": "d69f0657-0482-3582-b75a-44140a9f2723",
                "word": "désinfectant",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "71408d90-3d3b-4cd0-9877-b50f51702b35",
                        "entry_id": "d69f0657-0482-3582-b75a-44140a9f2723",
                        "tags": [
                            "plural"
