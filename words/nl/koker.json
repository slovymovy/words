                    "frequency": "Low",
                    "semantic_group_id": "kookapparaat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mama was erg blij met de nieuwe <w>koker</w> voor haar keuken waarmee ze snel water kon verwarmen.",
                            "target_lang_translations": {
