{
    "word_family": [
        "zwelger",
        "zwelgerij",
        "zwelgpartij"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f89015f8-a2a4-35f7-b7f1-9596cc2f8da1",
                    "sense_definition": "Zich overgeven aan een emotie of toestand, er intens van genieten of zich erin verliezen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "genot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de breuk met haar vriend bleef ze dagenlang in zelfmedelijden <w>zwelgen</w>.",
                            "target_lang_translations": {
                                "pl": "Po zerwaniu z chłopakiem przez całe dnie <w>pogrążała się</w> w użalaniu się nad sobą."
                            }
                        },
                        {
                            "text": "De kunstenaar leek te <w>zwelgen</w> in alle aandacht die hij kreeg.",
                            "target_lang_translations": {
                                "pl": "Artysta zdawał się <w>pławić</w> w uwadze, jaką mu poświęcano."
                            }
                        }
                    ],
                    "synonyms": [
                        "wentelen"
                    ],
                    "common_phrases": [
                        "zwelgen in zelfmedelijden",
                        "zwelgen in verdriet"
                    ],
                    "target_lang_definitions": {
                        "pl": "Oddawać się jakiejś emocji lub stanowi, intensywnie się w tym zatracać lub tym napawać (np. rozpaczą, luksusem, uwagą)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "pławić się",
                                "target_lang_sense_clarification": "w luksusie, chwale, uwadze"
                            },
                            {
                                "target_lang_word": "pogrążać się",
                                "target_lang_sense_clarification": "w negatywnych emocjach, np. w smutku, żalu"
                            },
                            {
                                "target_lang_word": "rozpływać się",
                                "target_lang_sense_clarification": "w zachwycie lub samouwielbieniu"
                            },
                            {
                                "target_lang_word": "napawać się",
                                "target_lang_sense_clarification": "pozytywnym stanem lub sukcesem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de332141-3b88-37b5-93fc-59c7491471f9",
                    "sense_definition": "Op een gulzige en onmatige manier grote hoeveelheden eten of drinken tot zich nemen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "consumptie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gasten <w>zwolgen</w> de hele avond in wijn en overvloedig eten.",
                            "target_lang_translations": {
                                "pl": "Goście przez cały wieczór <w>ucztowali</w>, opływając w wino i obfite jedzenie."
                            }
                        },
                        {
                            "text": "Hij zat zwijgend aan tafel en <w>zwolg</w> zijn maaltijd binnen enkele minuten naar binnen.",
                            "target_lang_translations": {
                                "pl": "Siedział przy stole w milczeniu i w kilka minut <w>pochłonął</w> swój posiłek."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Spożywać jedzenie lub napoje w sposób chciwy, nieumiarkowany i w wielkich ilościach."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "obżerać się",
                                "target_lang_sense_clarification": "jeść w nadmiernych ilościach"
                            },
                            {
                                "target_lang_word": "ucztować",
                                "target_lang_sense_clarification": "jeść i pić bez umiaru, hulać"
                            },
                            {
                                "target_lang_word": "pochłaniać",
                                "target_lang_sense_clarification": "łapczywie jeść lub pić duże ilości"
                            },
                            {
                                "target_lang_word": "żłopać",
                                "target_lang_sense_clarification": "łapczywie i w nadmiarze pić"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}