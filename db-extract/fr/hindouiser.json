                "senses": [
                    {
                        "sense_id": "77a5433b-81b5-30f9-bb8e-7ae439b722be",
                        "entry_id": "7a691457-df26-33d1-a2f7-d87e7689fba6",
                        "glosses": [
                            "Rendre (ou faire paraître) hindou."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fcfc264-8d12-4635-bcb8-2f2e847b57d5",
                                "sense_id": "77a5433b-81b5-30f9-bb8e-7ae439b722be",
                                "text": "Quant aux êtres vivants, il a suffi, pour les hindouiser, pensa le peintre, de fendre leur œil en amande, comme beaucoup d'yeux dans les peintures persanes."
                            },
                            {
                                "example_id": "17164050-7192-49c0-9cb7-426116ba5c50",
                                "sense_id": "77a5433b-81b5-30f9-bb8e-7ae439b722be",
                                "text": "Il ne faudrait pas plus que quelques coquilles dispersées au dos de nos classiques, pour hindouiser totalement la plus illustre des littératures."
                            }
                        ]
                    }
                ],
