                        "glosses": [
                            "Propre ou relatif à Anne Hébert ou à son œuvre; caractéristique de son style."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5fd0657-3413-49e6-94a8-7dbf61f574e8",
                                "sense_id": "329256e3-8039-301a-bb96-b77f090bb0f4",
                                "text": "Le cœur, c'est donc le désir, qui devient ainsi le point de mire de la lumière et du regard hébertiens."
                            },
                            {
                                "example_id": "e258d242-ac41-4748-bc81-d2af460d94b4",
                                "sense_id": "329256e3-8039-301a-bb96-b77f090bb0f4",
                                "text": "Pareils aux oiseaux fous dont le roman hébertien porte le nom, les personnages se laissent emporter par la fureur de vivre, par la violence de leur désir."
                            }
                        ]
