                "senses": [
                    {
                        "sense_id": "5a686340-1f21-3845-a089-10d1e443b4ff",
                        "entry_id": "dc761da8-4d2b-36ef-8496-37010f03f7c8",
                        "glosses": [
                            "optische Linse, bei der durch das angewendete Bauprinzip Gewicht und Volumen der Linse verringert werden können"
                        ],
                        "tags": [
                            "Optik"
                        ],
                        "examples": [
                            {
                                "example_id": "4723bcbf-7028-4155-8bd6-9d0e9ae76d06",
                                "sense_id": "5a686340-1f21-3845-a089-10d1e443b4ff",
                                "text": "„Im Museum werden gewaltige Fresnellinsen gezeigt sowie Modelle berühmter Leuchttürme wie das des Anfang des 17.Jahrhunderts filigran wie eine Kat hedrale errichteten Cordouan-Leuchtturms an der Gironde-Mündung.“"
                            },
                            {
                                "example_id": "7dca0ee2-ac29-4d4d-8f71-a6458f1d0c8c",
                                "sense_id": "5a686340-1f21-3845-a089-10d1e443b4ff",
                                "text": "„Die gezielt aufgebrachten Mikrostrukturen – sie heißen nach dem Vorbild aus der Natur auch Mottenaugenstrukturen – sorgen beispielsweise dafür, daß mehr Licht durch die Fresnellinse gelangt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
