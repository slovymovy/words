                ],
                "senses": [
                    {
                        "sense_id": "ead0ec16-352e-329f-9c78-f34cdea8abf0",
                        "entry_id": "626432f0-db30-3e39-8563-5ac2389f0af6",
                        "glosses": [
                            "Mikrobiologie, Virologie: Viren, die Bakterien befallen, sich auf deren Kosten vermehren und diese letztlich total lysieren (auflösen). Bakteriophagen sind Parasiten auf genetischem Niveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1e7436a-e25f-437a-843e-917178e69bf6",
                                "sense_id": "ead0ec16-352e-329f-9c78-f34cdea8abf0",
                                "text": "„… War es doch Félix d'Hérell … der 1917 die von ihm so benannten Bakteriophagen im Stuhl von Rekonvaleszenten der Bakterien-Ruhr … nachweisen konnte und so als einer der Entdecker der Phagen angesehen wird. Der Brite Frederick Twort hatte zwar schon 1915 ein bakterientötendes, selbstreplizierendes Agens auf Kulturplatten mit Staphylokokken beobachtet, doch dies war Felix d'Hérell nicht bekannt; über die Entdeckung der Bakteriophagen gehen so die Meinungen auseinander. …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1835b41a-2661-4677-9631-b855f4512d67",
                        "source_entry_id": "626432f0-db30-3e39-8563-5ac2389f0af6",
                        "source_sense_id": "ead0ec16-352e-329f-9c78-f34cdea8abf0",
                        "source_sense_description": "Viren, die Bakterien befallen",
                        "target_lang_word": "bacteriophage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bacteriophage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c0158bd-d604-38a3-977c-dfff7ba9a10f",
                                        "entry_id": "c1dbda8a-a1c4-32e2-aaa4-17d84500f896",
                                        "glosses": [
                                            "A virus that specifically infects bacteria."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0210e397-d7f7-4480-aa38-be9ca9de8eed",
                                                "sense_id": "2c0158bd-d604-38a3-977c-dfff7ba9a10f",
                                                "text": "Another possibility is to enlist a bacteriophage, a kind of virus, to hunt down and kill harmful bacteria for us."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bbad7173-a168-4110-880a-1ecd76ed5d9d",
                        "source_entry_id": "626432f0-db30-3e39-8563-5ac2389f0af6",
                        "source_sense_id": "ead0ec16-352e-329f-9c78-f34cdea8abf0",
                        "source_sense_description": "Viren, die Bakterien befallen",
                        "target_lang_word": "bactériophage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bactériophage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b3bae5b5-4884-34a6-ae55-2b945ee24517",
                                        "entry_id": "65b03dd3-e3ad-3504-805e-439b04961fca",
                                        "glosses": [
                                            "Capable d’infecter une bactérie, de s’y multiplier et généralement de la lyser (en parlant d’un virus)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7634f6f5-abe8-40f2-8a66-4a9bd71ba0fd",
                                                "sense_id": "b3bae5b5-4884-34a6-ae55-2b945ee24517",
                                                "text": "À noter que certains virus sont capables d’infecter les bactéries et de les détruire, il s’agit des virus « bactériophages »."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bactériophage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3760b879-ba4d-35f1-b928-eef3ada6e65f",
                                        "entry_id": "46188e72-fa9d-3f9b-8a74-9ebeef2c2d67",
                                        "glosses": [
                                            "Virus capable d’infecter une bactérie, de s’y multiplier et généralement de la lyser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec4450d6-2dde-4d12-8428-68a89547fd2b",
                                                "sense_id": "3760b879-ba4d-35f1-b928-eef3ada6e65f",
                                                "text": "L'auteur rapporte les résultats de la bactériophagothérapie dans les plaies infectées et les suppurations rebelles du cheval. Il préconise les injections sous-cutanées de bactériophage à la dose de 10 cc."
                                            },
                                            {
                                                "example_id": "0a569adf-32ce-49f7-b5a8-5cd056bcdce2",
                                                "sense_id": "3760b879-ba4d-35f1-b928-eef3ada6e65f",
                                                "text": "Leur Institut de microbiologie, aujourd'hui baptisé Georges-Eliava, a survécu à toutes les crises. Certes on pleure aujourd'hui l'apogée des années communistes, quand 800 personnes produisaient 1 tonne de bactériophages par jour et quantité d'autres médicaments pour l'empire soviétique, lorsque la phagothérapie était pratiquement la seule réponse aux infections alors que le pays se claquemurait derrière le rideau de fer interdisant l'entrée des antibiotiques capitalistes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
