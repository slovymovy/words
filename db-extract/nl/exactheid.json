                    }
                ],
                "senses": [
                    {
                        "sense_id": "abf744c4-4782-3da2-a15d-c0fe5e06a620",
                        "entry_id": "252996b3-2918-34ea-96a5-56abc3910384",
                        "glosses": [
                            "het heel precies goed zijn van iets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fdc0978-3edb-4ca4-9e8c-ec72fc502ba9",
                                "sense_id": "abf744c4-4782-3da2-a15d-c0fe5e06a620",
                                "text": "Het werk van Messiaen als diepgelovig rooms-katholiek mag dan van wierook omfloerst zijn, tegelijk is hij de meester van de exactheid, wat Boerema zeer juist vaststelt in zijn noodzakelijk uitvoerige toelichting. Zo vormen muziek, orgel, vertolking en perfecte techniek, mét de terecht ruimtelijke opname, een glorieuze eenheid. Het tempo van Boerema, royaal vlotter dan Tanke en rustiger dan Van der Steen, houdt de aandacht gevangen."
                            },
                            {
                                "example_id": "ab6f98a1-a756-4593-8298-15ab278b2ca9",
                                "sense_id": "abf744c4-4782-3da2-a15d-c0fe5e06a620",
                                "text": "Zo zegt Marjoleine de Vos het niet. Zo zeg ík het, nog altijd belast met de erfzonde van de wijsbegeerte die meer vertrouwt op exactheid dan op poëzie."
                            },
                            {
                                "example_id": "045b8a54-348e-40cb-96bb-df2ab066ddc1",
                                "sense_id": "abf744c4-4782-3da2-a15d-c0fe5e06a620",
                                "text": "In zijn exactheid is het Nederlandse normeringsmodel uniek. Maar hoe exact kan een model zijn als over de beoordeling van zelfs een wiskundesom debat kan ontstaan?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b51e73db-3449-454e-97a3-a3af9cbbd030",
                        "source_entry_id": "252996b3-2918-34ea-96a5-56abc3910384",
                        "source_sense_id": "abf744c4-4782-3da2-a15d-c0fe5e06a620",
                        "target_lang_word": "accuracy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accuracy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "233385fe-1738-3de6-a05f-5acaa41db518",
                                        "entry_id": "f4264e93-673a-3b4e-bb7b-d219aeb4967d",
                                        "glosses": [
                                            "The state of being accurate; being free from error; exactness; correctness"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61723ab6-6994-4fa0-ba85-6c926e519377",
                                                "sense_id": "233385fe-1738-3de6-a05f-5acaa41db518",
                                                "text": "Its professed end [of logic], is to teach men to think, to judge, and to reason, with precision and accuracy."
                                            },
                                            {
                                                "example_id": "b5182719-27e8-46c5-8da7-022f608c285a",
                                                "sense_id": "233385fe-1738-3de6-a05f-5acaa41db518",
                                                "text": "The efficiency of the instrument will also depend upon the accuracy with which the piston fits the bottom and sides of the barrel. When the piston is depressed to the bottom, it is considered in theory to be in absolute contact, so as to exclude every particle of air from the space between it and the bottom."
                                            },
                                            {
                                                "example_id": "cf9817f6-b9d1-48f0-a856-4115b42e1d16",
                                                "sense_id": "233385fe-1738-3de6-a05f-5acaa41db518",
                                                "text": "At her invitation he outlined for her the succeeding chapters with terse military accuracy ; and what she liked best and best understood was avoidance of that false modesty which condescends, turning technicality into pabulum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b921362-6c4a-3de7-a632-fdfe2b4fdcd3",
                                        "entry_id": "f4264e93-673a-3b4e-bb7b-d219aeb4967d",
                                        "glosses": [
                                            "Exact conformity to truth, or to a rule or model; degree of conformity of a measure to a true or standard value."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b336e89-43b9-46c0-a9a0-d5867d4adff8",
                                                "sense_id": "4b921362-6c4a-3de7-a632-fdfe2b4fdcd3",
                                                "text": "The jury doubted the accuracy of the witness' comments."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3516acc4-7d58-4cb2-8378-d47ba86af43a",
                        "source_entry_id": "252996b3-2918-34ea-96a5-56abc3910384",
                        "source_sense_id": "abf744c4-4782-3da2-a15d-c0fe5e06a620",
                        "target_lang_word": "precision",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "precision",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50bfdd86-d8dc-39a2-9ee2-9a53ae77b3ba",
                                        "entry_id": "1031c8c8-8619-322b-b8fd-85b33d4af54d",
                                        "glosses": [
                                            "The state of being precise or exact; especially, both exact and accurate."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3389e6da-5aab-431e-b6ad-6775a2ec68a7",
                                                "sense_id": "50bfdd86-d8dc-39a2-9ee2-9a53ae77b3ba",
                                                "text": "Near-synonyms: exactitude, exactness; accuracy"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c8f541c-4bd9-3adc-90d1-8f8996ad7cdf",
                                        "entry_id": "1031c8c8-8619-322b-b8fd-85b33d4af54d",
                                        "glosses": [
                                            "The ability of a measurement to be reproduced consistently."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09abd386-ef1e-43df-867e-b0f99be9b9cb",
                                                "sense_id": "1c8f541c-4bd9-3adc-90d1-8f8996ad7cdf",
                                                "text": "Near-synonyms: repeatability; reproducibility"
                                            },
                                            {
                                                "example_id": "6e6e73d6-bc03-4c80-84a2-32167028acf7",
                                                "sense_id": "1c8f541c-4bd9-3adc-90d1-8f8996ad7cdf",
                                                "text": "The classic example of the difference between precision and accuracy is that in target practice, if the grouping is tight but the group is off-center, your precision is good but your accuracy needs calibration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67c38040-7559-3d64-8d19-6d8f8519acfa",
                                        "entry_id": "1031c8c8-8619-322b-b8fd-85b33d4af54d",
                                        "glosses": [
                                            "The number of significant digits to which a value may be measured reliably."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ee1836ab-8802-3fec-a480-5832f2e48484",
                                        "entry_id": "1031c8c8-8619-322b-b8fd-85b33d4af54d",
                                        "glosses": [
                                            "A bidding system that makes use of many artificial bids to describe a hand quite precisely."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
