                {
                    "sense_id": "f7f82942-5ee2-3d5e-9058-5de254e52fdc",
                    "sense_definition": "Qui produit un son fort, perçant ou retentissant.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sonore",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un rire <w>éclatant</w> a soudain brisé le silence studieux qui régnait dans la bibliothèque.",
                            "target_lang_translations": {
                                "en": "A <w>ringing</w> laugh suddenly broke the studious silence that reigned in the library.",
                                "de": "Ein <w>schallendes</w> Lachen durchbrach plötzlich die konzentrierte Stille, die in der Bibliothek herrschte.",
                                "es": "Una risa <w>resonante</w> rompió de repente el silencio de estudio que reinaba en la biblioteca.",
                                "zh": "一阵<w>响亮</w>的笑声突然打破了图书馆里专心学习的寂静。",
                                "ru": "<w>Звонкий</w> смех внезапно нарушил сосредоточенную тишину, царившую в библиотеке."
                            }
                        },
                        {
                            "text": "Le musicien jouait de la trompette avec une puissance et une clarté particulièrement <w>éclatantes</w>.",
                            "target_lang_translations": {
                                "en": "The musician played the trumpet with particularly <w>piercing</w> power and clarity.",
                                "de": "Der Musiker spielte die Trompete mit besonders <w>durchdringender</w> Kraft und Klarheit.",
                                "es": "El músico tocaba la trompeta con una potencia y una claridad especialmente <w>penetrantes</w>.",
                                "zh": "这位音乐家吹小号时，声音的力度和清晰度都格外<w>响亮</w>。",
                                "ru": "Музыкант играл на трубе с особенно <w>пронзительной</w> силой и чистотой звука."
                            }
                        }
