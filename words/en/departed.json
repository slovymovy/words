                            {
                                "target_lang_word": "усопший",
                                "target_lang_sense_clarification": "уважительно/книжное"
                            },
                            {
                                "target_lang_word": "умерший",
                                "target_lang_sense_clarification": "нейтральное значение"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zmarły",
                                "target_lang_sense_clarification": "neutralne określenie osoby nieżyjącej"
                            },
                            {
                                "target_lang_word": "nieboszczyk",
                                "target_lang_sense_clarification": "potoczne określenie osoby zmarłej"
