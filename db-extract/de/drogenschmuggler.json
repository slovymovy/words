                        "glosses": [
                            "jemand, der Drogen schmuggelt; der Drogen illegal über eine Staatsgrenze bringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc6c8999-acd6-4f69-aef9-dad1fc755480",
                                "sense_id": "8015a0d4-976b-36cf-bb08-a92efad41e7a",
                                "text": "Die Drogenschmuggler versuchten im Schutz der Dunkelheit die Grenze zu überqueren."
                            },
                            {
                                "example_id": "04c49361-ea8c-4463-98d3-f6eedec8c78c",
                                "sense_id": "8015a0d4-976b-36cf-bb08-a92efad41e7a",
                                "text": "„In China drohen überführten Drogenschmugglern entweder lange Haftstrafen oder die Todesstrafe.“"
                            },
                            {
                                "example_id": "8ddc2312-6412-422e-916a-9e6c47ad6264",
                                "sense_id": "8015a0d4-976b-36cf-bb08-a92efad41e7a",
                                "text": "„Glaubst du, der Junge ist ein Drogenschmuggler?“"
                            }
                        ],
