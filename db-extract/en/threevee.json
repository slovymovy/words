                        "glosses": [
                            "A screen or television able to display a three-dimensional image."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c343f12-3441-469e-b5c8-cabaec412b68",
                                "sense_id": "27265069-1b7e-389a-a3ba-f9a4c1b65261",
                                "text": "She loved to sit with me when three or four of us went to the Blue Sea, to the Bay of Lue, to threevees in the city, to musical shows, or just to eat iced meloncolion on the showy balconies of the comiche."
                            },
                            {
                                "example_id": "879405e9-8c57-470e-ae9c-8748244c2935",
                                "sense_id": "27265069-1b7e-389a-a3ba-f9a4c1b65261",
                                "text": "The demon paused before answering, as though listening to an internal voice. Seen up close, he too was slightly blurred — like a threevee picture in the middle of a bad day for sunspots, Kin thought."
                            }
                        ]
                    }
