                {
                    "sense_id": "fab11d28-f8a9-33fd-bea5-3f1044be4926",
                    "sense_definition": "De uiterste grens of zijkant van een voorwerp, gebied of oppervlak.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_edge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We liepen een stukje langs de <w>rand</w> van het bos.",
                            "target_lang_translations": {
                                "en": "We walked a bit along the <w>edge</w> of the forest.",
                                "ru": "Мы немного прошлись вдоль <w>опушки</w> леса."
                            }
                        },
                        {
                            "text": "Zet dat glas niet zo dicht bij de <w>rand</w> van de tafel.",
                            "target_lang_translations": {
                                "en": "Don't put that glass so close to the <w>edge</w> of the table.",
                                "ru": "Не ставь этот стакан так близко к <w>краю</w> стола."
                            }
