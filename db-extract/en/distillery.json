                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2e3f37d9-4283-4173-8ca9-15bd1c04a20e",
                        "source_entry_id": "82efe258-ad21-3e58-b55e-ef001af5c260",
                        "source_sense_description": "a place where distillation takes place",
                        "target_lang_word": "Brennerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brennerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f38f3ac8-632d-3786-b638-a452c0748503",
                                        "entry_id": "90237d25-4f6a-3cc1-9514-ccd765218358",
                                        "glosses": [
                                            "ein Betrieb, in dem stark alkoholhaltige Getränke aus einem schwach alkoholischen Ausgangsprodukt destilliert werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc9cbac4-a875-4f7a-bf20-4ac4bbe270ba",
                                                "sense_id": "f38f3ac8-632d-3786-b638-a452c0748503",
                                                "text": "Beim Besuch der Brennerei konnte man Branntwein probieren."
                                            },
                                            {
                                                "example_id": "5c0d187f-3168-4889-84dd-1b2c8e9cd6eb",
                                                "sense_id": "f38f3ac8-632d-3786-b638-a452c0748503",
                                                "text": "„Zwar residiert in der Brennerei neben die Vietzkes inzwischen die Kommandantura, aber was hilft's?“"
                                            },
                                            {
                                                "example_id": "67cb1b9c-b0fb-46a7-bb91-e474b45ae475",
                                                "sense_id": "f38f3ac8-632d-3786-b638-a452c0748503",
                                                "text": "„Der seit Jahrzehnten für die Brennerei tätige Hans Bleibtreu und der Brennermeister Bruno Brand sorgen dafür, dass die Geschäfte solide, ehrlich und halbwegs profitabel weiterlaufen und nichts am Geheimrezept des legendären Korngeists herumgepfuscht wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a6dde2cd-fde1-474d-8add-0e364b93ad60",
                        "source_entry_id": "82efe258-ad21-3e58-b55e-ef001af5c260",
                        "source_sense_description": "a place where distillation takes place",
                        "target_lang_word": "Destillerie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Destillerie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0b7d954b-290c-348a-b21c-7fa3ad50b5f2",
                                        "entry_id": "ab77e255-ce71-30ad-9f53-9becaaa4e137",
                                        "glosses": [
                                            "Betrieb, in dem stark alkoholhaltige Getränke aus einem schwach alkoholischen Ausgangsprodukt destilliert werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f577e01e-d294-4ee1-8760-1da9e986c1aa",
                                                "sense_id": "0b7d954b-290c-348a-b21c-7fa3ad50b5f2",
                                                "text": "„Er richtete zwei Destillerien ein, um aus den Kartoffeln, die in Varzin angebaut wurden, Schnaps zu brennen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2127ac58-1d1d-4061-b28f-65336ec0f5cc",
                        "source_entry_id": "82efe258-ad21-3e58-b55e-ef001af5c260",
                        "source_sense_description": "a place where distillation takes place",
                        "target_lang_word": "Destille",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Destille",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a6f62c32-e5d1-336e-942a-c4e8746de75d",
                                        "entry_id": "b0fcb98e-88a9-3e7d-857b-c9c906a56f66",
                                        "glosses": [
                                            "kleines Lokal mit Branntweinausschank"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f6ed861-320c-4038-ba78-47efdc138146",
                                                "sense_id": "a6f62c32-e5d1-336e-942a-c4e8746de75d",
                                                "text": "„Nachher, in der Destille, ist es gar nicht so einfach, dem Meister Puttbreese begreiflich zu machen, daß der Umzug in größter Stille vor sich zu gehen hat.“"
                                            },
                                            {
                                                "example_id": "96fdb770-ef89-4c17-aca2-e8cf6e639588",
                                                "sense_id": "a6f62c32-e5d1-336e-942a-c4e8746de75d",
                                                "text": "„Sie fragten ihn in der Destille, an der Ecke, wo er sie traktierte, was er für Geschäfte mache.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "05368cff-24a1-3ab8-8f91-1fef528c8ba3",
                                        "entry_id": "b0fcb98e-88a9-3e7d-857b-c9c906a56f66",
                                        "glosses": [
                                            "Einrichtung zur Herstellung von hochprozentigen Getränken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97af1294-6863-4d24-8075-f4ef18bc8820",
                                                "sense_id": "05368cff-24a1-3ab8-8f91-1fef528c8ba3",
                                                "text": "„Neben der Destille entstehen zwei Speicher für das Korn, um das ganze Jahr lang brennen zu können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ee0e76d-ee6f-4da7-8bbb-e8beb3d1327b",
                        "source_entry_id": "82efe258-ad21-3e58-b55e-ef001af5c260",
                        "source_sense_description": "a place where distillation takes place",
                        "target_lang_word": "Schnapsbrennerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schnapsbrennerei",
