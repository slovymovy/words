                                        ]
                                    },
                                    {
                                        "sense_id": "023fa35e-c8c2-3e32-ac6a-a5ae15842370",
                                        "entry_id": "4be92110-f61f-3aaa-8978-cc5bcd1a2a96",
                                        "glosses": [
                                            "Extrémité de la queue du poisson qui bat l’eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbb11a69-4745-4509-80c2-08eca87ce487",
                                                "sense_id": "023fa35e-c8c2-3e32-ac6a-a5ae15842370",
                                                "text": "Le poisson est mesuré entre œil et bat."
                                            },
                                            {
                                                "example_id": "7c21179b-5d9a-4c06-bf7f-72061dcda7d5",
                                                "sense_id": "023fa35e-c8c2-3e32-ac6a-a5ae15842370",
                                                "text": "Ce poisson a cinquante centimètres de bat : c’est-à-dire entre l’œil et la queue."
                                            }
                                        ]
                                    }
