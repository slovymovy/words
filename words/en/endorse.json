{
    "word_family": [
        "endorsement",
        "endorser",
        "endorsable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fd55e3bf-ddc9-3590-b5be-db37fd8becad",
                    "sense_definition": "To express support or approval, especially officially or publicly.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The famous athlete decided to <w>endorse</w> the new brand of running shoes in a television commercial.",
                            "target_lang_translations": {
                                "ru": "Знаменитый атлет решил <w>рекламировать</w> новый бренд кроссовок в телевизионном ролике."
                            }
                        },
                        {
                            "text": "Many local community leaders chose to <w>endorse</w> a candidate during the final weeks of the election campaign.",
                            "target_lang_translations": {
                                "ru": "Многие лидеры местных сообществ решили <w>поддержать</w> кандидата в последние недели избирательной кампании."
                            }
                        }
                    ],
                    "synonyms": [
                        "support",
                        "back",
                        "approve",
                        "sanction",
                        "advocate"
                    ],
                    "antonyms": [
                        "oppose",
                        "reject",
                        "condemn",
                        "disapprove"
                    ],
                    "common_phrases": [
                        "endorse a candidate",
                        "publicly endorse",
                        "officially endorse",
                        "endorse a product"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражать поддержку или одобрение, особенно официально или публично."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поддерживать",
                                "target_lang_sense_clarification": "оказывать помощь или выступать в защиту"
                            },
                            {
                                "target_lang_word": "одобрять",
                                "target_lang_sense_clarification": "официально признавать правильным"
                            },
                            {
                                "target_lang_word": "рекламировать",
                                "target_lang_sense_clarification": "продвигать товар от своего имени"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2cc8bbae-3452-3d85-9692-f3a99b9dcc21",
                    "sense_definition": "To write one's signature on the back of a cheque or document to make it payable to someone else or to cash it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must <w>endorse</w> the cheque on the back before the bank teller can process your deposit.",
                            "target_lang_translations": {
                                "ru": "Вы должны <w>подписать</w> чек с обратной стороны, прежде чем кассир сможет обработать ваш депозит."
                            }
                        },
                        {
                            "text": "Please <w>endorse</w> a cheque carefully to ensure the funds are transferred to the correct account.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>индоссируйте</w> чек внимательно, чтобы средства были переведены на нужный счет."
                            }
                        }
                    ],
                    "synonyms": [
                        "sign",
                        "countersign",
                        "undersign"
                    ],
                    "common_phrases": [
                        "endorse a cheque",
                        "endorse on the back"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "financial and legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поставить свою подпись на обороте чека или документа для его обналичивания или передачи другому лицу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "индоссировать",
                                "target_lang_sense_clarification": "делать передаточную надпись на чеке"
                            },
                            {
                                "target_lang_word": "подписывать",
                                "target_lang_sense_clarification": "ставить подпись на обороте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb6b8d7e-357a-34a6-ad00-c51beb8ac5ec",
                    "sense_definition": "To record a conviction or penalty points on a driving licence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal_penalty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magistrate decided to <w>endorse</w> his driving licence with three penalty points for the speeding offense.",
                            "target_lang_translations": {
                                "ru": "Судья решил <w>внести отметку</w> в его водительское удостоверение о трех штрафных баллах за превышение скорости."
                            }
                        },
                        {
                            "text": "If you continue to drive recklessly, the court will <w>endorse</w> your record and you may lose your permit.",
                            "target_lang_translations": {
                                "ru": "Если вы продолжите водить неосторожно, суд <w>сделает запись</w> в вашем деле, и вы можете лишиться прав."
                            }
                        }
                    ],
                    "synonyms": [
                        "record"
                    ],
                    "common_phrases": [
                        "endorse a licence",
                        "driving licence endorsed"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заносить сведения о правонарушении или штрафных баллах в водительское удостоверение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать отметку",
                                "target_lang_sense_clarification": "вносить запись о нарушении в права"
                            },
                            {
                                "target_lang_word": "регистрировать",
                                "target_lang_sense_clarification": "фиксировать штрафные баллы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de1d5213-6f98-38ea-8f9a-fc91e351d37a",
                    "sense_definition": "To report or confirm the presence of a specific symptom during a medical evaluation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical_reporting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During the clinical interview, the patient did <w>endorse</w> feelings of fatigue and mild chest pain.",
                            "target_lang_translations": {
                                "ru": "Во время клинического интервью пациент действительно <w>подтвердил</w> чувство усталости и легкую боль в груди."
                            }
                        },
                        {
                            "text": "The doctor asked several questions to see if the subject would <w>endorse</w> any symptoms of anxiety.",
                            "target_lang_translations": {
                                "ru": "Врач задал несколько вопросов, чтобы выяснить, <w>отметит</w> ли испытуемый какие-либо симптомы тревоги."
                            }
                        }
                    ],
                    "synonyms": [
                        "report",
                        "confirm"
                    ],
                    "antonyms": [
                        "deny"
                    ],
                    "common_phrases": [
                        "endorse symptoms"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "medical jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сообщать или подтверждать наличие определенного симптома во время медицинского обследования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подтверждать",
                                "target_lang_sense_clarification": "соглашаться с наличием симптома"
                            },
                            {
                                "target_lang_word": "отмечать",
                                "target_lang_sense_clarification": "указывать на наличие жалоб"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "db97c804-cdf4-3115-b494-1ef2405e7a95",
                    "sense_definition": "A narrow vertical stripe on a coat of arms, usually appearing in pairs on either side of a <w>pale</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "heraldry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight's shield featured a central pale flanked by a thin <w>endorse</w> on each side.",
                            "target_lang_translations": {
                                "ru": "На щите рыцаря был изображен центральный столб, по бокам которого располагалось по узкому <w>столбику</w>."
                            }
                        },
                        {
                            "text": "In traditional heraldry, an <w>endorse</w> is considered a diminutive of the larger vertical band.",
                            "target_lang_translations": {
                                "ru": "В традиционной геральдике <w>узкий столб</w> считается уменьшительным вариантом более широкой вертикальной полосы."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "heraldic terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Узкая вертикальная полоса на гербе, обычно располагающаяся парами по обе стороны от столба."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "узкий столб",
                                "target_lang_sense_clarification": "геральдическая фигура"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}