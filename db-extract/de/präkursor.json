                "senses": [
                    {
                        "sense_id": "b565665e-e38c-3ea6-84c4-431e92c9ed23",
                        "entry_id": "b29cb01a-ab0b-3c08-bdd9-de8c37147de3",
                        "glosses": [
                            "Biomolekül, das erst durch Modifikation in ein biologisch aktives Molekül überführt wird"
                        ],
                        "tags": [
                            "Biochemie"
                        ],
                        "examples": [
                            {
                                "example_id": "89bc97d4-d04a-4dac-858a-d9994f4d9088",
                                "sense_id": "b565665e-e38c-3ea6-84c4-431e92c9ed23",
                                "text": "Bei der Transkription der DNA entsteht die prä-mRNA, der Präkursor der Messenger-RNA."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bdf4d82f-5702-3100-8cd7-c985d057a023",
                        "entry_id": "b29cb01a-ab0b-3c08-bdd9-de8c37147de3",
                        "glosses": [
                            "Stoff, aus dem Drogen hergestellt werden können"
                        ],
                        "tags": [
                            "Drogenherstellung"
                        ],
                        "examples": [
                            {
                                "example_id": "12741147-a846-4425-91e1-6ef5650a403a",
                                "sense_id": "bdf4d82f-5702-3100-8cd7-c985d057a023",
                                "text": "Lysergsäure ist der Präkursor von LSD."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5004df2-88af-413e-a70f-51e67baea602",
                        "source_entry_id": "b29cb01a-ab0b-3c08-bdd9-de8c37147de3",
                        "source_sense_id": "b565665e-e38c-3ea6-84c4-431e92c9ed23",
                        "source_sense_description": "Biochemie: Biomolekül, das erst durch Modifikation in ein biologisch aktives Molekül überführt wird",
                        "target_lang_word": "precursor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "precursor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "02b5c8ff-041c-3429-b8fe-132f513a82ed",
                                        "entry_id": "5d9e120a-b0dd-3629-aa66-5726fa35ae36",
                                        "glosses": [
                                            "That which precurses: a forerunner, predecessor, or indicator of approaching events."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e65b50a3-3e90-4796-9014-b4c8006c07f2",
                                                "sense_id": "02b5c8ff-041c-3429-b8fe-132f513a82ed",
                                                "text": "Oxygen levels on Earth skyrocketed 2.4 billion years ago, when cyanobacteria evolved photosynthesis:[…]. The evolutionary precursor of photosynthesis is still under debate, and a new study sheds light. The critical component of the photosynthetic system is the “water-oxidizing complex”, made up of manganese atoms and a calcium atom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6899aeb-4420-31d6-9307-9d05784857f0",
                                        "entry_id": "5d9e120a-b0dd-3629-aa66-5726fa35ae36",
                                        "glosses": [
                                            "One of the compounds that participates in the chemical reaction that produces another compound."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "precursor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ba41c6c-913c-37f6-af3b-11f0c0aed909",
                                        "entry_id": "a9fc99c0-4ad5-31e3-8314-c02269db803d",
                                        "glosses": [
                                            "Caused by the following symbol."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90ecd951-247e-4b9f-a7d1-474fbd1e67a9",
                        "source_entry_id": "b29cb01a-ab0b-3c08-bdd9-de8c37147de3",
                        "source_sense_id": "b565665e-e38c-3ea6-84c4-431e92c9ed23",
                        "source_sense_description": "Biochemie: Biomolekül, das erst durch Modifikation in ein biologisch aktives Molekül überführt wird",
                        "target_lang_word": "précurseur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "précurseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0b87c3c6-1019-3631-a20b-cf3e5c0f67b2",
                                        "entry_id": "fe17fdf4-43b7-311e-8ccc-75e2fbea8869",
                                        "glosses": [
                                            "Qui en précède et en influence d’autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a61c6f3f-cc67-4552-9d12-7e012072a75a",
                                                "sense_id": "0b87c3c6-1019-3631-a20b-cf3e5c0f67b2",
                                                "text": "Elles formaient le modèle pour les collections de la bourgeoisie ; très souvent, elles étaient précurseurs des collections publiques ou des collections des universités."
                                            },
                                            {
                                                "example_id": "d46a7754-d5af-48d7-aa83-4d3bea90e08d",
                                                "sense_id": "0b87c3c6-1019-3631-a20b-cf3e5c0f67b2",
                                                "text": "Il a été un précurseur, redéfinissant l'image de la rock star dans les années 1970 en se créant une panoplie d'alter ego."
                                            },
                                            {
                                                "example_id": "a708faef-9ebb-43f5-a299-fbb61fc18b0f",
                                                "sense_id": "0b87c3c6-1019-3631-a20b-cf3e5c0f67b2",
                                                "text": "En outre, des décharges précurseurs d’éclairs sont détectées peu après certains événements de scintillations gamma, ce qui tend à montrer que ces derniers ont un rôle dans le déclenchement des éclairs, une question qui reste ouverte malgré les nombreux efforts de recherche sur le sujet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c1da3fc-4a70-3225-8069-5a6ecc7a0fc3",
                                        "entry_id": "fe17fdf4-43b7-311e-8ccc-75e2fbea8869",
                                        "glosses": [
                                            "Qui est en amont dans la synthèse, en parlant d’une molécule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c242c23e-603d-49f2-99e8-90e00ba22479",
                                                "sense_id": "4c1da3fc-4a70-3225-8069-5a6ecc7a0fc3",
                                                "text": "Chez le champignon Panellus stipticus, le composé précurseur luminescent est très vraisemblablement un sesquiterpène, le panal […] qui dérive des quinones via la formation de deux molécules intermédiaires, le 1-O-decanolpanal et le 1-O-dodecanolpanal qui sont des composés hydrophobes localisés."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "précurseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2b736458-4a72-3339-84c5-d8ae6a8ad86c",
                                        "entry_id": "b94f8267-7370-375e-a8a2-115849badc3f",
                                        "glosses": [
                                            "Personne qui vient avant quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0376737f-6087-4ab9-a792-8dbf6af64e0f",
                                                "sense_id": "2b736458-4a72-3339-84c5-d8ae6a8ad86c",
                                                "text": "Le Précurseur de Jésus-Christ, Jean-Baptiste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4585a585-e442-30db-bb72-0e50e0a6d3f1",
                                        "entry_id": "b94f8267-7370-375e-a8a2-115849badc3f",
                                        "glosses": [
                                            "Personne qui prépare la voie, qui précède et annonce une grande personnalité, un mouvement, une découverte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd209971-e320-4e30-8a4f-61654cbd8a8f",
                                                "sense_id": "4585a585-e442-30db-bb72-0e50e0a6d3f1",
                                                "text": "Nicolas Oresme applique à la représentation du mouvement une représentation graphique, grâce à un système de coordonnées rectangulaires, ce qui fait de lui un précurseur de la géométrie analytique de Descartes."
                                            },
                                            {
                                                "example_id": "78193656-457c-4888-bb8e-2fd641909a74",
                                                "sense_id": "4585a585-e442-30db-bb72-0e50e0a6d3f1",
                                                "text": "Nancy est une ville d’ordre et de lumières où dès le XVIIᵉ et le XVIIIᵉ siècle, des ducs intelligents furent, sans le savoir, les précurseurs heureux de nos urbanistes modernes."
                                            },
                                            {
                                                "example_id": "7e8c80d0-fc24-4bf8-8b61-c816ba3c6dd4",
                                                "sense_id": "4585a585-e442-30db-bb72-0e50e0a6d3f1",
                                                "text": "Pour les Indiens cultivés parlant une langue indo-européenne, la langue de référence est toujours le sanskrit, langue partiellement artificielle, comme l’Esperanto, constituée sur la base des langues indiennes utilisées il y a 2600 ans, et mise au point au IVᵉ siècle avant notre ère par le grammairien Pâninī, précurseur de Zamenhof."
                                            },
                                            {
                                                "example_id": "2d608dc7-aaf6-4a67-8dd9-06b38060f1d0",
                                                "sense_id": "4585a585-e442-30db-bb72-0e50e0a6d3f1",
                                                "text": "Ce Chilien s’appelait Diego Portales. Il est aujourd’hui considéré par les réactionnaires chiliens et par les généraux de la Junte comme leur grand précurseur."
                                            },
                                            {
                                                "example_id": "4f8e05ce-f696-482d-90a5-a9e769d627a4",
                                                "sense_id": "4585a585-e442-30db-bb72-0e50e0a6d3f1",
                                                "text": "Les radsocs de l’époque, véritables précurseurs de la social-démocratie, situés à la droite de socialistes sur le demi-camembert électoral, passeraient aujourd’hui pour des gauchistes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d101e6ab-f3e2-3274-a87f-e70a8d524aae",
                                        "entry_id": "b94f8267-7370-375e-a8a2-115849badc3f",
                                        "glosses": [
                                            "Chose qui en précède d’autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b6192b2-3689-4fcc-8e44-bf8549409ef2",
                                                "sense_id": "d101e6ab-f3e2-3274-a87f-e70a8d524aae",
                                                "text": "Des nuées de corneilles apparaissent alors, et se traînent comme les brumes dont elles sont les précurseurs."
                                            },
                                            {
                                                "example_id": "b0fa2114-a6da-4d38-95e9-8623bd154fee",
                                                "sense_id": "d101e6ab-f3e2-3274-a87f-e70a8d524aae",
                                                "text": "L’Allemagne a donné à la Tchéquie des sciences, des beaux-arts et l’industrie, et la Tchéquie a noblement répondu à ce magnifique cadeau, en produisant le hussitisme, cet immortel précurseur de Martin Luther."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39397134-972c-3e9a-8f38-62bfe40ba8c2",
                                        "entry_id": "b94f8267-7370-375e-a8a2-115849badc3f",
                                        "glosses": [
                                            "Molécule qui par une réaction biochimique va donner naissance à une autre molécule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98346ae0-9954-466d-8c52-2539057502bd",
                                                "sense_id": "39397134-972c-3e9a-8f38-62bfe40ba8c2",
                                                "text": "Les acides gras […] sont les précurseurs de plusieurs messagers intra et extracellulaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
