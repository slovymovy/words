                    {
                        "sense_id": "0dcfe4b0-fe82-3657-bfab-f16f1705ca71",
                        "entry_id": "6a5c178e-9c8d-332c-a472-5148505a3bfd",
                        "glosses": [
                            "Variante orthographique de peinard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2243dc9d-207f-4f11-bedb-49dce727be71",
                                "sense_id": "0dcfe4b0-fe82-3657-bfab-f16f1705ca71",
                                "text": "J’étais tranquille, j’étais pénard\nAccoudé au flipper\nLe type est entré dans le bar\nA commandé un jambon beurre."
                            },
                            {
                                "example_id": "96ecfa11-cd8c-4884-9e95-8188f70516fc",
                                "sense_id": "0dcfe4b0-fe82-3657-bfab-f16f1705ca71",
                                "text": "Moi aussi je vais m’y précipiter dans ce merveilleux refuge des femmes-profs qui veulent-tout-concilier, le collège, de la sixième à la troisième, nettement plus pénard. Même si ça me plaît moins."
                            },
                            {
                                "example_id": "5486ae11-0617-4066-9621-8d21ea2f9fdf",
                                "sense_id": "0dcfe4b0-fe82-3657-bfab-f16f1705ca71",
                                "text": "Avec un tel alibi, il est pénard."
                            }
                        ]
                    }
