                "senses": [
                    {
                        "sense_id": "92ca587c-2d9c-3003-ba19-b304da7009ea",
                        "entry_id": "4cfa258e-de77-32dd-9755-2cec52902ac9",
                        "glosses": [
                            "Software, Verfahren zur Bearbeitung von Texten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b4fdfba-469e-48d8-a99d-8e6d8e1e6a9a",
                                "sense_id": "92ca587c-2d9c-3003-ba19-b304da7009ea",
                                "text": "Es gibt für die Textverarbeitung viele verschiedene Programme."
                            },
                            {
                                "example_id": "2739250e-6aaf-4c7e-b9ac-1b63bc2cd3d4",
                                "sense_id": "92ca587c-2d9c-3003-ba19-b304da7009ea",
                                "text": "„Im Bereich der Textverarbeitung ist sicher die Umsetzung der Rechtschreibreform derzeit eine der spannendsten Fragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3d8f5dde-0ecd-360f-a51a-24181fdd329f",
                        "entry_id": "4cfa258e-de77-32dd-9755-2cec52902ac9",
                        "glosses": [
                            "kognitive Leistungen von Personen bei der Aufnahme, Interpretation oder Produktion von Texten"
                        ],
                        "tags": [
                            "speziell Psycholinguistik"
                        ],
                        "examples": [
                            {
                                "example_id": "0bf24cc4-533f-4f88-a106-088756cbdd83",
                                "sense_id": "3d8f5dde-0ecd-360f-a51a-24181fdd329f",
                                "text": "Bei der Textverarbeitung geht es um die Frage, welche Leistungen erforderlich sind, damit eine Person Texte erfolgreich produzieren oder rezipieren kann."
                            },
                            {
                                "example_id": "689fcbd3-ab43-43fb-b40e-3c78580cf714",
                                "sense_id": "3d8f5dde-0ecd-360f-a51a-24181fdd329f",
                                "text": "„Für die Textverarbeitung und E-Mails gilt die DIN 5008, deren Empfehlungen immer dann angeführt werden, wenn sich Abweichungen zu den allgemeinen Richtlinien ergeben.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f7e3d4a-8106-472e-9291-34b7ff91a35a",
                        "source_entry_id": "4cfa258e-de77-32dd-9755-2cec52902ac9",
                        "source_sense_id": "92ca587c-2d9c-3003-ba19-b304da7009ea",
