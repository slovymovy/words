                        ],
                        "examples": [
                            {
                                "example_id": "b216d34b-bc2a-4190-9ee8-d03f9afd8ec1",
                                "sense_id": "a9ec8881-b06f-32b1-922b-13cecb858860",
                                "text": "Tja, zaken zijn nu eenmaal zaken!"
                            }
                        ]
                    },
                    {
                        "sense_id": "47d985d5-7a19-3cd0-b024-96a539c505ff",
                        "entry_id": "db662eb5-59d1-339d-a0b2-1289736e795d",
