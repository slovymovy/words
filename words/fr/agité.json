            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cd860c81-9251-38c5-aa37-3fbacae0ff2d",
                    "sense_definition": "Qui est animé d'un mouvement vif, irrégulier ou tumultueux.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mouvement_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vent souffle fort et le lac devient très <w>agité</w> ce soir."
                        },
                        {
                            "text": "Après une nuit particulièrement <w>agitée</w>, il s'est réveillé avec un grand mal de tête."
                        }
                    ],
                    "synonyms": [
                        "mouvementé",
                        "tumultueux",
                        "houleux"
                    ],
                    "antonyms": [
                        "calme",
                        "paisible",
                        "tranquille"
                    ],
                    "common_phrases": [
