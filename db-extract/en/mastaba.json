{
    "word": "mastaba",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b011eaff-3e8e-38bf-860d-3b11ae96686c",
                "word": "mastaba",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "cf6c8fec-d5d0-475a-98fc-c6df09f44b55",
                        "entry_id": "b011eaff-3e8e-38bf-860d-3b11ae96686c",
                        "tags": [
                            "plural"
                        ],
                        "form": "mastabas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7f47ee8b-1e77-3c14-9978-a8927f8e4498",
                        "entry_id": "b011eaff-3e8e-38bf-860d-3b11ae96686c",
                        "glosses": [
                            "A wide stone bench built into the wall of a house, shop etc. in the Middle East."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e30002e2-0cda-4f54-bf93-cbb563e7a64c",
                                "sense_id": "7f47ee8b-1e77-3c14-9978-a8927f8e4498",
                                "text": "A wooden shutter which closes down at night-time, and by day two palm-stick stools intensely dirty and full of fleas, occupying the place of the Mastabah or earthern bench, which accomodated[sic] purchasers, complete the furniture of my preceptor's establishment."
                            }
                        ]
                    },
                    {
                        "sense_id": "446cc4cd-9b5c-3c28-b14b-40b20e61f420",
                        "entry_id": "b011eaff-3e8e-38bf-860d-3b11ae96686c",
                        "glosses": [
                            "A rectangular structure with a flat top and slightly sloping sides, built during Ancient Egyptian times above tombs that were situated on flat land. Mastabas were made of wood, mud bricks, stone, or a combination of these materials. Some are solid structures, while others can contain one or more rooms, sometimes decorated with paintings or inscriptions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a3c3056-4e41-4f4d-9c28-8615679197d7",
                                "sense_id": "446cc4cd-9b5c-3c28-b14b-40b20e61f420",
                                "text": "The pyramids at Giza are flanked by large cemeteries containing hundreds of mastabas."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "685c6f6e-167d-42d6-8609-f3c3db2ee3e1",
                        "source_entry_id": "b011eaff-3e8e-38bf-860d-3b11ae96686c",
                        "source_sense_description": "wide stone bench",
                        "target_lang_word": "Steinbank",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Steinbank",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c6069f61-add3-3e51-aaf1-d6ff85351596",
                                        "entry_id": "80a04027-37df-3cb0-95ef-bd3acf297256",
                                        "glosses": [
                                            "Bank aus Stein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74e4750f-318c-4d1d-8264-ce58f6dc60c2",
                                                "sense_id": "c6069f61-add3-3e51-aaf1-d6ff85351596",
                                                "text": "„Nachdem ich ihn verlassen hatte, ging ich die paar Schritte zum Jaffator und setzte mich auf die Steinbank davor, die Wärme des Tages war noch darin.“"
                                            },
                                            {
                                                "example_id": "58f5c4fc-fb3d-4992-a02c-5ceb13203169",
                                                "sense_id": "c6069f61-add3-3e51-aaf1-d6ff85351596",
                                                "text": "„Er verschnauft und läßt sich auf einer Steinbank nieder.“"
                                            },
                                            {
                                                "example_id": "81e0230f-d35e-43fb-ba73-f9fbdbfe2f7d",
                                                "sense_id": "c6069f61-add3-3e51-aaf1-d6ff85351596",
                                                "text": "„Zwischen Birken und Edeltannen hin schlängelte sich der Weg und führte bis an eine künstliche, von Moos und Efeu überwachsene Felswand, in deren Front (der alte Köckritz war jetzt zurückgeblieben) der König auf einer Steinbank saß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "967c079e-52e4-4f5d-9d29-82b07427dd4e",
                        "source_entry_id": "b011eaff-3e8e-38bf-860d-3b11ae96686c",
                        "source_sense_description": "rectangular tomb structure with a flat top and slightly sloping sides",
                        "target_lang_word": "mastaba",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mastaba",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "11eb2242-652a-3224-a7ee-ce22867117f5",
                                        "entry_id": "3b638c33-9b10-32fd-8b7a-0fbf9d558320",
                                        "glosses": [
                                            "rechthoekig bouwwerk met een plat dak en hellende wanden, zoals dat in het oude Egypte als grafmonument werd gebruikt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "960aa1fc-c55d-4b62-9f44-7c92e9f3a609",
                                                "sense_id": "11eb2242-652a-3224-a7ee-ce22867117f5",
                                                "text": "De mastaba van Djoser bij Sakkara van de eerste architect waarvan de naam bekend is gebleven en die trouwens vergoddelijkt is: Imhoteb!"
                                            },
                                            {
                                                "example_id": "6c1cac96-dd90-4d76-bc36-3ed60f102a2a",
                                                "sense_id": "11eb2242-652a-3224-a7ee-ce22867117f5",
                                                "text": "De vaten worden gebruikt voor een drijvende mastaba, een afgetopte piramide."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "31f1014a-04eb-415e-9638-4f3c1a7aed67",
                        "source_entry_id": "b011eaff-3e8e-38bf-860d-3b11ae96686c",
                        "source_sense_description": "rectangular tomb structure with a flat top and slightly sloping sides",
                        "target_lang_word": "mastaba",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mastaba",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7dcc647d-9163-3456-bedd-417a4a4ee641",
                                        "entry_id": "984745d0-7bf0-39fa-a4e9-58e73fbde5a7",
                                        "glosses": [
                                            "Construction funéraire rectangulaire utilisée dans l'Égypte antique comme sépulture pour les pharaons, les nobles ou les notables."
                                        ],
                                        "tags": [
                                            "Funéraire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91d345d6-5708-4ca7-8cc9-3706a88f7a74",
                                                "sense_id": "7dcc647d-9163-3456-bedd-417a4a4ee641",
                                                "text": "Cependant, des récipients en albâtre trouvés dans un mastaba voisin mentionnent le nom du Roi Khaba (2603-2599) et on a retrouvé sur des blocs de calcaire et de granit, beaucoup d'inscriptions : « Nebkarê, Seigneur des Deux Terres », mais sans que le nom soit dans un cartouche (Nebkarê serait un des noms de Khaba)."
                                            },
                                            {
                                                "example_id": "70d7212f-2df4-42bb-96cc-512ce831918c",
                                                "sense_id": "7dcc647d-9163-3456-bedd-417a4a4ee641",
                                                "text": "La chapelle du mastaba du noble Akhethétep, dont les ruines sont encore visibles sur le plateau de Saqqarah, est reconstituée au musée du Louvre."
                                            },
                                            {
                                                "example_id": "e003d03d-fd2b-462d-9332-2e816aefc9d3",
                                                "sense_id": "7dcc647d-9163-3456-bedd-417a4a4ee641",
                                                "text": "Tout à l’heure au Louvre, Antiquités égyptiennes. Longuement regardé les bas-reliefs du mastaba. Quelle délicatesse dans ce dessin qui a l’air d’à peine effleurer la pierre ! Ces personnages en pagne portent encore des traces de couleur. Les offrandes, oies, canards, nénuphars, sont enveloppées d’un trait si sûr et si léger, si ennemi de tout bavardage…"
                                            },
                                            {
                                                "example_id": "1481e347-72b4-4937-a398-d06656c60313",
                                                "sense_id": "7dcc647d-9163-3456-bedd-417a4a4ee641",
                                                "text": "Les « mastabas », ce sont les édifices funéraires égyptiens servant de sépulture aux pharaons des deux premières dynasties ainsi qu’aux hauts dignitaires, qui ont fait l’objet de nombreuses fouilles archéologiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4552e1e3-9567-47bc-aa12-c67433e8e676",
                        "source_entry_id": "b011eaff-3e8e-38bf-860d-3b11ae96686c",
                        "source_sense_description": "rectangular tomb structure with a flat top and slightly sloping sides",
                        "target_lang_word": "Mastaba",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mastaba",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "21f1ff50-7c05-3edd-9683-0f8f66d10ae4",
                                        "entry_id": "a3063af4-bed4-360f-820b-560d95f9e2f8",
                                        "glosses": [
                                            "Grabbau von flacher, blockartiger Form aus Lehmziegeln oder Steinen mit rechteckigen Kammern"
                                        ],
                                        "tags": [
                                            "altes",
                                            "Ägypten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "019101f1-b085-4440-8ed5-ed74db0ee76d",
                                                "sense_id": "21f1ff50-7c05-3edd-9683-0f8f66d10ae4",
                                                "text": "Denen, die nicht in steinernen Festungen, sondern in Mastabas unter der Erde oder in einfachen Sandgräbern dörrten, wurde mehr Gerechtigkeit als den Herrschern."
                                            },
                                            {
                                                "example_id": "a6469eda-9a95-41c7-a255-c8be2a0a60ec",
                                                "sense_id": "21f1ff50-7c05-3edd-9683-0f8f66d10ae4",
                                                "text": "Ursprünglich war sie als klassische Mastaba geplant, dann aber, Stufe um Stufe nach oben und außen erweitert, bis die Form der Stufenpyramide geboren war."
                                            },
                                            {
                                                "example_id": "c39d1a5d-bb15-4fa0-b5f5-bc7dce02e2b4",
                                                "sense_id": "21f1ff50-7c05-3edd-9683-0f8f66d10ae4",
                                                "text": "Durch den Eingang und das schmale Vestibül gelangt man ins Zentrum der Mastaba: eine große Kammer mit vier Säulenpfeilern."
                                            },
                                            {
                                                "example_id": "9e752dbd-a385-4bac-b2ba-961e78ef9f36",
                                                "sense_id": "21f1ff50-7c05-3edd-9683-0f8f66d10ae4",
                                                "text": "Neben den berühmten Mastabas von Mereruka und Kagemni steht die Pyramide des Königs Teti."
                                            },
                                            {
                                                "example_id": "16dc89a6-ceb8-42aa-83a6-47aa0086b395",
                                                "sense_id": "21f1ff50-7c05-3edd-9683-0f8f66d10ae4",
                                                "text": "Unter dem zudeckenden Sand des Schweigens erblickte sie nach und nach in den palastartigen Mastaben der Beamten Reliefs von erhaltener roter Farbigkeit, bei Mereruka, Ti und anderen."
                                            },
                                            {
                                                "example_id": "d6234ba3-9f36-40c0-ad54-eb24f50e3384",
                                                "sense_id": "21f1ff50-7c05-3edd-9683-0f8f66d10ae4",
                                                "text": "Neben seinem Amt als Hohepriester von Heliopolis unter Djoser und Sechemhet wirkte Imhotep als Architekt und als genialer Erfinder der Stufenpyramide. Sie besteht aus übereinander geschichteten Mastaben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
