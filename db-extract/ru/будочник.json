                "senses": [
                    {
                        "sense_id": "9202e7bd-e812-3896-8cfb-d0dfbfd6e14c",
                        "entry_id": "eb886985-b5f5-3f1a-91e4-b5ced6496a79",
                        "glosses": [
                            "устар., разг. тот, кто несёт караульную службу в будке"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2a16e7d7-b9a0-39a5-8eb4-61fcfbc7f035",
                        "entry_id": "eb886985-b5f5-3f1a-91e4-b5ced6496a79",
                        "glosses": [
                            "истор. в дореволюционной России: полицейский сторож, стоящий на посту у караульной будки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07890115-cc8b-4a8c-ba90-69a3643e5013",
                                "sense_id": "2a16e7d7-b9a0-39a5-8eb4-61fcfbc7f035",
                                "text": "Из русских чиновников был один будочник, чухонец Юрко, умевший приобрести, несмотря на своё смиренное звание, особенную благосклонность хозяина."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b5485505-7743-470e-b98c-60f9394ad74f",
                        "source_entry_id": "eb886985-b5f5-3f1a-91e4-b5ced6496a79",
                        "source_sense_description": "тот, кто несёт службу в будке",
                        "target_lang_word": "watchman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "watchman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "276739ae-113f-38f8-a856-a60ee5b6a4ab",
                                        "entry_id": "b407d6c2-f68f-3291-87cb-2001de76aea7",
                                        "glosses": [
                                            "One set to watch; a person who keeps guard, especially one who guards a building, or the streets of a city, by night."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d908ffe-be85-47bc-8a88-c9bba6f10c50",
                                                "sense_id": "276739ae-113f-38f8-a856-a60ee5b6a4ab",
                                                "text": "The visits of the watchman to that (then) obscure and ill-inhabited neighborhood were more regulated by his indolence than his duty; and Clarence knew that it would be in vain to listen for his cry or tarry for his assistance."
                                            },
                                            {
                                                "example_id": "f5931d00-b7dd-4f85-9107-dccad19a7e07",
                                                "sense_id": "276739ae-113f-38f8-a856-a60ee5b6a4ab",
                                                "text": "Well, it so happened that Stine and the cook were sitting in their room one evening, mending and darning their things; it was near bedtime, for the watchman had already sung out \"Ten o'clock,\" but somehow the darning and the sewing went on very slowly indeed[.]"
                                            },
                                            {
                                                "example_id": "09ac3f2e-ee93-44a1-a798-a3ec4b80758d",
                                                "sense_id": "276739ae-113f-38f8-a856-a60ee5b6a4ab",
                                                "text": "Watchmen are stationed continuously at each end of the bridge, and the main spans are patrolled twice during the night."
                                            },
                                            {
                                                "example_id": "aaa68d7b-eec4-4a3a-91c9-4f929b7f8b05",
                                                "sense_id": "276739ae-113f-38f8-a856-a60ee5b6a4ab",
                                                "text": "In 1972, a night watchman patrolling a hotel-office complex noticed that the basement garage door had been taped open and, attributing this to the carelessness of a maintenance worker earlier that day, peeled the tape off."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af8581d8-c86c-46d8-9b58-4ad717575cd6",
                        "source_entry_id": "eb886985-b5f5-3f1a-91e4-b5ced6496a79",
                        "source_sense_description": "тот, кто несёт службу в будке",
                        "target_lang_word": "Wächter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wächter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf337bb6-c261-3a7d-970d-89ec2c912b66",
                                        "entry_id": "5f6c3e8e-7f78-393a-9be7-2b09c631b0df",
                                        "glosses": [
                                            "Person, die etwas oder jemanden bewacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98be2035-37c0-4384-b255-f0aedc8b8b0b",
                                                "sense_id": "cf337bb6-c261-3a7d-970d-89ec2c912b66",
                                                "text": "Der Wächter hat den Dieb auf frischer Tat ertappt."
                                            },
                                            {
                                                "example_id": "93368b81-7a79-4670-92ef-cebafe4762c9",
                                                "sense_id": "cf337bb6-c261-3a7d-970d-89ec2c912b66",
                                                "text": "„Zwei Wächter hielten den zum Gelage angereisten Fürsten an den Armen fest.“"
                                            },
                                            {
                                                "example_id": "ffe16304-b553-417f-8cef-06e677c3a304",
                                                "sense_id": "cf337bb6-c261-3a7d-970d-89ec2c912b66",
                                                "text": "„Ein junger Wächter eilt davon, während die mit Marderpelz und Rossleder bekleideten Skythen das mächtige Tor bestaunen.“"
                                            },
                                            {
                                                "example_id": "34f2a167-c059-438c-8962-172b11e76af4",
                                                "sense_id": "cf337bb6-c261-3a7d-970d-89ec2c912b66",
                                                "text": "„Der Wächter des Platzes wechselte häufig, weil kein halbwegs normaler Ordnungshüter dieses Zentrum einer entfesselten Jugend länger als höchstens ein Vierteljahr ertragen konnte.“"
                                            },
                                            {
                                                "example_id": "fb14d00d-131c-48ad-9e7b-2261d3df8a95",
                                                "sense_id": "cf337bb6-c261-3a7d-970d-89ec2c912b66",
                                                "text": "„Der Wächter war mir gleich aufgefallen, und nicht nur, weil er die Menge um Haupteslänge überragte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a776c5c6-bcfe-3cca-84e2-9171a0e9cf24",
                                        "entry_id": "5f6c3e8e-7f78-393a-9be7-2b09c631b0df",
                                        "glosses": [
                                            "technische Einrichtung, die eine Messgröße überwacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30bcdaa1-6e6e-438e-905f-a6a6a6419b80",
                                                "sense_id": "a776c5c6-bcfe-3cca-84e2-9171a0e9cf24",
                                                "text": "Der Wächter wurde manipuliert und lieferte so falsche Zahlen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "681291dc-0ac9-4d9e-84dc-3be0157b00fb",
                        "source_entry_id": "eb886985-b5f5-3f1a-91e4-b5ced6496a79",
                        "source_sense_description": "тот, кто несёт службу в будке",
                        "target_lang_word": "gardien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gardien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ddafff1-5a97-3836-89e2-226d9b0807b3",
                                        "entry_id": "58fceac1-c769-3eed-8acb-ea7ba6ce8500",
                                        "glosses": [
                                            "Celui qui garde, surveille quelqu’un ou quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49f1c93d-0816-4677-bccc-062158f4fde8",
                                                "sense_id": "9ddafff1-5a97-3836-89e2-226d9b0807b3",
                                                "text": "Les bêtes levèrent leur mufle humide et, dociles à l’invite de leur jeune gardien, gravirent le coteau pour reprendre, […], le chemin de terre bordé de haies vives aboutissant au village."
                                            },
                                            {
                                                "example_id": "e5f8ae53-9261-4b00-8146-526c65cbc53f",
                                                "sense_id": "9ddafff1-5a97-3836-89e2-226d9b0807b3",
                                                "text": "Il pense au gardien de la mine d’Ichmoul mettant en fuite les bandits avec les quatre cartouches de son vieux mousqueton."
                                            },
                                            {
                                                "example_id": "aa62c904-5acc-4233-9a8f-51a41ef46e4d",
                                                "sense_id": "9ddafff1-5a97-3836-89e2-226d9b0807b3",
                                                "text": "Il fit état de la tendresse et de l’affection que le couple de lions manifestait à leur gardien."
                                            },
                                            {
                                                "example_id": "4ff3cd60-404f-4bca-bf10-4c2ec27268cc",
                                                "sense_id": "9ddafff1-5a97-3836-89e2-226d9b0807b3",
                                                "text": "Profitant des possibilités de sens offertes par le mot « gardien », qui peut désigner un gardien de cimetière mais aussi un gardien de zoo ou de cirque, le texte propose une descente dans le règne animal et prend dès lors l’allure d’une visite à une ménagerie de cirque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe9d9cd4-72fe-3517-93a6-2562f64f2612",
                                        "entry_id": "58fceac1-c769-3eed-8acb-ea7ba6ce8500",
                                        "glosses": [
                                            "Protecteur, personne qui protège quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5eef588-a3f9-4fea-887d-228e8caa0643",
                                                "sense_id": "fe9d9cd4-72fe-3517-93a6-2562f64f2612",
                                                "text": "La justice, gardienne de la vie sociale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a5ebdd2-97b5-3a91-bd89-8b530ce8e71a",
                                        "entry_id": "58fceac1-c769-3eed-8acb-ea7ba6ce8500",
                                        "glosses": [
                                            "Conservateur, personne chargée de veiller à la conservation d’une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b5ed7a6-31ee-4d2c-9b00-899e05a6faa5",
                                                "sense_id": "4a5ebdd2-97b5-3a91-bd89-8b530ce8e71a",
                                                "text": "Le gardien d’un monument public."
                                            },
                                            {
                                                "example_id": "899b133f-6cab-410d-9e89-e3323aa1edd5",
                                                "sense_id": "4a5ebdd2-97b5-3a91-bd89-8b530ce8e71a",
                                                "text": "Gardien de musée, de bibliothèque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bda6175c-03a2-31b1-9d45-a26ba4889e6f",
                                        "entry_id": "58fceac1-c769-3eed-8acb-ea7ba6ce8500",
                                        "glosses": [
                                            "Gardien de but."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0ef3c91d-7f75-30ec-9219-0943528d04bc",
                                        "entry_id": "58fceac1-c769-3eed-8acb-ea7ba6ce8500",
                                        "glosses": [
                                            "Celui qui est commis par justice pour garder des meubles saisis, des scellés, etc."
                                        ],
                                        "tags": [
                                            "Justice"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e64e154-6451-42f7-bad2-352c6fc5c75b",
                                                "sense_id": "0ef3c91d-7f75-30ec-9219-0943528d04bc",
                                                "text": "On l’a établi gardien des effets saisis, des meubles, des scellés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f61b5e1-f683-3076-ad45-76b98a3bbd50",
                                        "entry_id": "58fceac1-c769-3eed-8acb-ea7ba6ce8500",
                                        "glosses": [
                                            "Supérieur de certaines congrégations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "320580fe-d218-42ee-ab59-ca78871a31a7",
                                                "sense_id": "4f61b5e1-f683-3076-ad45-76b98a3bbd50",
                                                "text": "Le gardien des capucins."
                                            },
                                            {
                                                "example_id": "4496c8c5-6420-495c-a271-0fbb901de343",
                                                "sense_id": "4f61b5e1-f683-3076-ad45-76b98a3bbd50",
                                                "text": "Fra Battista, qui fut avant moi gardien du couvent de Santa Croce."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gardien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0da6b16d-e9e6-3fa8-88ee-73499770acb7",
                                        "entry_id": "ed637fa1-493a-325d-9cfe-c10052ca27e9",
                                        "glosses": [
                                            "Protecteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa24af65-28cc-4190-8cf8-bb4e7bf78459",
                                                "sense_id": "0da6b16d-e9e6-3fa8-88ee-73499770acb7",
                                                "text": "Ange gardien."
                                            },
                                            {
                                                "example_id": "808ca4f3-0b34-4f88-81a3-b7027881d771",
                                                "sense_id": "0da6b16d-e9e6-3fa8-88ee-73499770acb7",
                                                "text": "Renée allait, incertaine, déjà détachée, et témoignant d’une modestie indifférente et gardienne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
