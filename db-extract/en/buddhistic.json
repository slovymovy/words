                                        "examples": [
                                            {
                                                "example_id": "72dcf9a9-8b73-4d89-b1d5-da515ec0e492",
                                                "sense_id": "6633a458-6094-3363-96c5-a276abef9de9",
                                                "text": "Wan-nien-sseu est un très vieux temple bouddhique, qui s’élève à quelques lis à peine des murailles de la ville, la courbe élégante de ses toits vernissés."
                                            },
                                            {
                                                "example_id": "09f39ac5-fa53-4a18-974f-7d7ed342406d",
                                                "sense_id": "6633a458-6094-3363-96c5-a276abef9de9",
                                                "text": "14 mai. - On apprend que le haut clergé bouddhique a commencé une grève de la faim pour protester contre la discrimination dont il s'estime victime."
                                            },
                                            {
                                                "example_id": "60008c83-9df5-4043-8c7f-57b6a4d747e0",
                                                "sense_id": "6633a458-6094-3363-96c5-a276abef9de9",
                                                "text": "Au commencement, c’est l’École bouddhique, une école sortie des hauts plateaux de l’Asie, de l’Inde savante, et qui apporte avec la religion de Cakya Mouni, sa peinture à la Chine, au Japon, à tout l’Extrême-Orient …"
                                            }
                                        ]
                                    }
                                ]
