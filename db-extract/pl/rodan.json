                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fdecfdef-d923-3c9d-a63b-23be74b348a9",
                                        "entry_id": "8fd5340a-356f-388a-8b16-febd95e9140c",
                                        "glosses": [
                                            "in das Mittelmeer mündender Fluss in Frankreich und der Schweiz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65e6b938-8c28-402b-8ebd-8a4f4a463567",
                                                "sense_id": "fdecfdef-d923-3c9d-a63b-23be74b348a9",
                                                "text": "„Die Gemeinde des Pfarrers, abgelegen auf einem Hochplateau des Zentralmassivs zwischen Rhone und Loire, könnte Zufluchtsort für die jüdischen Kinder werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
