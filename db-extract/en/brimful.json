                "senses": [
                    {
                        "sense_id": "0190626a-142b-34d2-8151-0347266be8b7",
                        "entry_id": "afb70478-d75f-38fa-8074-85077da6c43e",
                        "glosses": [
                            "Filled to maximum capacity."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "912bdbd3-7bbc-4b74-885c-31cae89b18ae",
                                "sense_id": "0190626a-142b-34d2-8151-0347266be8b7",
                                "text": "So weighty was the cup, / That being propos'd brimful of wine, one scarce could lift it up."
                            }
                        ]
                    }
                ],
                "translations": [
