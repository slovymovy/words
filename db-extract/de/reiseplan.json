                "senses": [
                    {
                        "sense_id": "d0f14e0e-057c-38a6-94ec-14c4d685f20c",
                        "entry_id": "4ac3b33a-987e-33fe-8909-5a89f91cd069",
                        "glosses": [
                            "genaue Organisation einer Reise und/oder Übersicht dazu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc2c2997-4a39-46cc-a819-03471f442be7",
                                "sense_id": "d0f14e0e-057c-38a6-94ec-14c4d685f20c",
                                "text": "„Alles funktioniert nach einem festen Reiseplan, dessen Punkte genau eingehalten werden.“"
                            },
                            {
                                "example_id": "d8c1f6f7-e218-4712-869b-559220a03aaf",
                                "sense_id": "d0f14e0e-057c-38a6-94ec-14c4d685f20c",
                                "text": "„Ich war zutiefst enttäuscht, und es dauerte eine ganze Weile, bis ich meine Reisepläne wieder vergaß.“"
                            },
                            {
                                "example_id": "8f694003-950c-4b36-80bb-fa6c25ca98e2",
                                "sense_id": "d0f14e0e-057c-38a6-94ec-14c4d685f20c",
                                "text": "„Der junge Mann war von diesen Reiseplänen entzückt und erfuhr nie das geringste von der kleinen Anschwärzerei, die ich mir erlaubt hatte, um ihn zu entfernen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
