                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37720047-9460-4a31-9a68-c7417b293538",
                        "source_entry_id": "ea6235c2-a66a-34a6-b9d5-a7d222cc0113",
                        "source_sense_id": "9719aba6-c4f9-32a6-af58-d49a6331c435",
                        "source_sense_description": "Medizin: Person, die an Aphasie leidet",
                        "target_lang_word": "aphasique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aphasique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "859cbdba-9cd3-3f72-b950-2b538e120cea",
                                        "entry_id": "3772b42e-857e-3898-8878-f1e723cd5c6f",
                                        "glosses": [
                                            "Qui est atteint d’aphasie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f8de52b-4b0b-468b-9e6e-5c7106c36e8f",
                                                "sense_id": "859cbdba-9cd3-3f72-b950-2b538e120cea",
                                                "text": "Valéry Larbaud a été aphasique les vingt dernières années de sa vie. On raconte qu’il ne pouvait plus dire que les cinq mots suivants : « Bonjour les choses de la vie ! », salutation qui touche par sa joyeuse simplicité. J’aurais voulu la placer en exergue de mon livre Célébrations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fb57355-fe1e-3620-98fb-923a59d8d77b",
                                        "entry_id": "3772b42e-857e-3898-8878-f1e723cd5c6f",
                                        "glosses": [
                                            "Relatif à l’aphasie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d948a279-24fd-4cd4-9d36-cda3ac1b200d",
                                                "sense_id": "5fb57355-fe1e-3620-98fb-923a59d8d77b",
                                                "text": "Le terme de « mutisme » est consacré par l’usage, encore que le mutisme ne soit pas forcément d’origine aphasique (mutisme akinétique par exemple)."
                                            },
                                            {
                                                "example_id": "ea85a4c7-36f8-4331-9944-7c52eaaccf55",
                                                "sense_id": "5fb57355-fe1e-3620-98fb-923a59d8d77b",
                                                "text": "Le rapport conclut que Mme Bettencourt, « atteinte de troubles cognitifs évidents avec désorientation temporelle, troubles mnésiques, troubles de raisonnement et éléments aphasiques […] présente un tableau clinique de démence à un stade modérément sévère »."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aphasique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6f7ba006-7b28-39ad-bd59-f33b24c5d370",
                                        "entry_id": "3eb89c53-26d6-39dd-bc96-ccb14697057e",
                                        "glosses": [
                                            "Personne atteinte d’aphasie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4808fcdb-dd9d-4b29-9cc8-48b9e6facc7b",
                                                "sense_id": "6f7ba006-7b28-39ad-bd59-f33b24c5d370",
                                                "text": "Un, une aphasique."
                                            },
                                            {
                                                "example_id": "fff55b8d-ab91-4955-92ad-7b22fb79a139",
                                                "sense_id": "6f7ba006-7b28-39ad-bd59-f33b24c5d370",
                                                "text": "Vivre avec un aphasique peut être très déroutant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
