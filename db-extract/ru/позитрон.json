                                "target_senses": [
                                    {
                                        "sense_id": "1a7a847b-179d-32f7-9b51-045b9292e15f",
                                        "entry_id": "bf408dc9-9416-3915-b86d-2318601a63ec",
                                        "glosses": [
                                            "The antimatter equivalent of an electron, having the same mass but a positive charge."
                                        ],
                                        "tags": [
                                            "particle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3c383d2-7c55-4706-a0d1-afbbccc2c487",
                                                "sense_id": "1a7a847b-179d-32f7-9b51-045b9292e15f",
                                                "text": "The notion of a positron weapon remains the stuff of science fiction."
                                            },
                                            {
                                                "example_id": "ad108bf2-35ca-4491-8d04-2314891e33b4",
                                                "sense_id": "1a7a847b-179d-32f7-9b51-045b9292e15f",
                                                "text": "If these particles carry unit positive charge the curvatures and ionizations produced require the mass to be less than twenty times the electron mass. These particles will be called positrons."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
