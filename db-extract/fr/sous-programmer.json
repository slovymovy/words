                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0911c138-1066-4d06-83cb-f2c75ae6f786",
                                "sense_id": "a2628bfe-e056-3c36-9b64-fedad7532455",
                                "text": "Il suffirait tout simplement de la sous-programmer dans la loi et de dire que c’est assujetti au même article, de sorte que tous les ans il y aurait une indexation basée sur le coût de la vie."
                            },
                            {
                                "example_id": "282eab34-b1a2-4166-9d4d-3f1eb06a1283",
                                "sense_id": "a2628bfe-e056-3c36-9b64-fedad7532455",
                                "text": "Une variante de l’invention consiste alors à sous-programmer les cellules devant être programmées."
                            }
