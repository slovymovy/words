            {
                "entry_id": "e5159513-ed25-3d5e-b197-9eb409129919",
                "word": "lahar",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4d0e64f7-b135-45da-9ddb-015e908beb84",
                        "entry_id": "e5159513-ed25-3d5e-b197-9eb409129919",
                        "tags": [
                            "plural"
                        ],
                        "form": "lahars"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a10e235d-b506-3375-87cd-c54e5eaebaa1",
                        "entry_id": "e5159513-ed25-3d5e-b197-9eb409129919",
                        "glosses": [
                            "A volcanic mudflow."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4becfdf5-8129-4aaf-b8dd-83b96833b6fa",
                                "sense_id": "a10e235d-b506-3375-87cd-c54e5eaebaa1",
                                "text": "Such a highly destructive mud-flow (termed a lahar) eventually stops as a pile of debris of all shapes and sizes, as mixed up as a glacial moraine; the two deposits have often been confused."
                            },
                            {
                                "example_id": "e164502d-ff71-4267-bd97-dabbed9ff171",
                                "sense_id": "a10e235d-b506-3375-87cd-c54e5eaebaa1",
                                "text": "Pyroclastic flows are often difficult to distinguish in outcrops from a similar type of fragmental debris flow known as lahars. Both are characteristically unstratified and unsorted. A deposit containing blocks of varied compositions with rounded shapes is more likely to have been formed by a lahar than by a glowing avalanche."
                            },
                            {
                                "example_id": "8aa4830f-b208-4d14-9940-ef3296d08b4a",
                                "sense_id": "a10e235d-b506-3375-87cd-c54e5eaebaa1",
                                "text": "A regime of persistent lahar activity results when eruptive activity continually supplies unconsolidated volcanic material for remobilization."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd86f0e1-5330-442e-aeda-eef81602953e",
                        "source_entry_id": "e5159513-ed25-3d5e-b197-9eb409129919",
