                "senses": [
                    {
                        "sense_id": "b8d32773-8548-36b1-89c9-7d6846fce39e",
                        "entry_id": "6a449603-8920-3b2a-8a7c-925b69b48625",
                        "glosses": [
                            "Drohne vom Typ General Atomics MQ-1"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27745fc9-501c-4e4c-a682-567be35fac0b",
                                "sense_id": "b8d32773-8548-36b1-89c9-7d6846fce39e",
                                "text": "„Bob nahm sofort ab und teilte ihm mit, dass genau in diesem Moment eine Predator-Drohne über ihm in der Luft schwebte.“"
                            },
                            {
                                "example_id": "d8643dc7-6c4f-4259-be92-f18c768683ad",
                                "sense_id": "b8d32773-8548-36b1-89c9-7d6846fce39e",
                                "text": "„Um die Operation zu unterstützen, hatte Peter dafür gesorgt, dass das kleine Kontingent der Rebellen mit Waffen ausgestattet wurde, die zuvor verboten waren: Javelin-Panzerabwehrraketen, Remington-MSR-Scharfschützengewehre, Nachtsichtgeräte der neuesten Generation, sichere Kommunikationsmittel und Vorrang für die Piloten der Agency, die die bewaffneten Reaper- und Predator-Drohnen kontrollierten, die am syrischen Himmel kreisten.“"
                            },
                            {
                                "example_id": "5184c5b9-3b31-4fe4-b817-8dc7ed4e3d19",
                                "sense_id": "b8d32773-8548-36b1-89c9-7d6846fce39e",
                                "text": "„Die Nachtsichtkamera einer Predator-Drohne fing ein, wie das riesige Linienflugzeug in der Dunkelheit langsam auf die Startbahn zuhielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
