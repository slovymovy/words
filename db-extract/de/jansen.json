                        "tags": [],
                        "examples": [
                            {
                                "example_id": "983a8c63-5b53-49b8-96f7-d4b2fa16dd70",
                                "sense_id": "32a15f7a-cdbf-3fc3-bb87-9b654a998ef5",
                                "text": "Der frühere Fußball-Nationalspieler Marcell Jansen hat seine Karriere beendet."
                            },
                            {
                                "example_id": "4e676777-f601-49d7-ab76-1fe2249bed8b",
                                "sense_id": "32a15f7a-cdbf-3fc3-bb87-9b654a998ef5",
                                "text": "Wie Janine Jansen dieses Adagio nun aber spielt – als gäbe es nicht schon Dutzende von Aufnahmen davon –, hört man beglückt."
                            }
                        ],
                        "sense_index_json": "\"1\""
