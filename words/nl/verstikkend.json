{
    "word_family": [
        "stikken",
        "verstikken",
        "verstikking",
        "stikkend"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6d039544-de36-35c6-b44d-6a6aca806789",
                    "sense_definition": "Met het gevoel dat je geen adem meer krijgt of stikt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fysieke_benauwdheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rook in de brandende kamer gaf de brandweerman een <w>verstikkend</w> gevoel.",
                            "target_lang_translations": {
                                "en": "The smoke in the burning room gave the firefighter a <w>suffocating</w> feeling."
                            }
                        },
                        {
                            "text": "Hij had last van een <w>verstikkende</w> hoest die hem de hele nacht wakker hield.",
                            "target_lang_translations": {
                                "en": "He suffered from a <w>choking</w> cough that kept him awake all night."
                            }
                        }
                    ],
                    "synonyms": [
                        "benauwd"
                    ],
                    "common_phrases": [
                        "verstikkend gevoel"
                    ],
                    "target_lang_definitions": {
                        "en": "Causing a feeling of not being able to breathe or of suffocating."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "suffocating",
                                "target_lang_sense_clarification": "physically preventing breathing"
                            },
                            {
                                "target_lang_word": "choking",
                                "target_lang_sense_clarification": "causing gasping or airway blockage"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42e094f7-672c-36a2-9774-3c8617e5c79f",
                    "sense_definition": "Het gevoel gevend dat je in je vrijheid of beweging beperkt wordt en niet kunt ontsnappen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuurlijke_beklemming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij ervoer de strikte regels binnen het familiebedrijf als een <w>verstikkende</w> sfeer.",
                            "target_lang_translations": {
                                "en": "She experienced the strict rules within the family business as a <w>stifling</w> atmosphere."
                            }
                        },
                        {
                            "text": "De relatie voelde na een paar jaar erg <w>verstikkend</w> aan.",
                            "target_lang_translations": {
                                "en": "The relationship felt very <w>suffocating</w> after a few years."
                            }
                        }
                    ],
                    "synonyms": [
                        "beklemmend"
                    ],
                    "common_phrases": [
                        "verstikkende sfeer"
                    ],
                    "target_lang_definitions": {
                        "en": "Giving the feeling of being restricted in freedom or movement and unable to escape."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stifling",
                                "target_lang_sense_clarification": "restrictive or oppressive to personal freedom"
                            },
                            {
                                "target_lang_word": "suffocating",
                                "target_lang_sense_clarification": "metaphorically overwhelming and restrictive"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af8c50b7-c4ea-361c-9d54-0688e5b397ca",
                    "sense_definition": "Heel erg warm, drukkend en benauwd (van het weer of de lucht).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "weersomstandigheden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de jungle heerste een <w>verstikkende</w> hitte die het lopen zwaar maakte.",
                            "target_lang_translations": {
                                "en": "An <w>oppressive</w> heat prevailed in the jungle, making walking difficult."
                            }
                        },
                        {
                            "text": "Het was een <w>verstikkend</w> hete zomerdag waarop niemand wilde werken.",
                            "target_lang_translations": {
                                "en": "It was a <w>stiflingly</w> hot summer day on which nobody wanted to work."
                            }
                        }
                    ],
                    "synonyms": [
                        "drukkend",
                        "zwoel",
                        "broeierig"
                    ],
                    "common_phrases": [
                        "verstikkende hitte"
                    ],
                    "target_lang_definitions": {
                        "en": "Very hot, oppressive, and humid (referring to weather or air)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stifling",
                                "target_lang_sense_clarification": "extremely hot and stuffy weather"
                            },
                            {
                                "target_lang_word": "oppressive",
                                "target_lang_sense_clarification": "heavy, hot, and humid air"
                            },
                            {
                                "target_lang_word": "suffocating",
                                "target_lang_sense_clarification": "unbearably hot and airless"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2165d538-5c73-30a0-908a-ec502e05371e",
                    "sense_definition": "Een bedrukt, somber of deprimerend gevoel veroorzakend.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "figuurlijke_beklemming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De slechte resultaten zorgden voor een <w>verstikkende</w> stilte in de kleedkamer.",
                            "target_lang_translations": {
                                "en": "The poor results caused an <w>oppressive</w> silence in the dressing room."
                            }
                        },
                        {
                            "text": "Zijn constante negativiteit had een <w>verstikkend</w> effect op de hele groep.",
                            "target_lang_translations": {
                                "en": "His constant negativity had a <w>stifling</w> effect on the entire group."
                            }
                        }
                    ],
                    "synonyms": [
                        "deprimerend"
                    ],
                    "common_phrases": [
                        "verstikkende stilte"
                    ],
                    "target_lang_definitions": {
                        "en": "Causing a heavy, gloomy, or depressing feeling."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "oppressive",
                                "target_lang_sense_clarification": "weighing heavily on the spirit or atmosphere"
                            },
                            {
                                "target_lang_word": "stifling",
                                "target_lang_sense_clarification": "suppressing expression or mood"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4d0e7b02-badb-373e-a5a5-d9039a6e8832",
                    "sense_definition": "onvoltooid deelwoord van <w>verstikken</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rook verspreidde zich snel, de bewoners bijna <w>verstikkend</w> in hun slaap.",
                            "target_lang_translations": {
                                "en": "The smoke spread quickly, almost <w>suffocating</w> the residents in their sleep."
                            }
                        },
                        {
                            "text": "Met een <w>verstikkende</w> beweging probeerde hij de vlammen te doven.",
                            "target_lang_translations": {
                                "en": "With a <w>smothering</w> motion, he tried to extinguish the flames."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Present participle of the verb 'verstikken' (to suffocate, choke, or stifle)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "suffocating",
                                "target_lang_sense_clarification": "depriving of oxygen or smothering"
                            },
                            {
                                "target_lang_word": "choking",
                                "target_lang_sense_clarification": "strangling or blocking the airway"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}