                                "target_senses": [
                                    {
                                        "sense_id": "6967f5eb-ee0a-3d75-8cbb-5ca3cd3ee94b",
                                        "entry_id": "9b2d764b-ef79-33e4-8cfb-5a66744e523b",
                                        "glosses": [
