    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3b88f018-1c16-328b-8ec5-6d4a9ced8711",
                    "sense_definition": "Qui éprouve du regret, qui s'excuse pour une faute ou un contretemps.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "regret",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je suis vraiment <w>désolé</w> pour mon retard imprévu ce matin."
                        },
                        {
                            "text": "Mon frère était sincèrement <w>désolé</w> d'avoir cassé votre vase."
                        }
                    ],
                    "synonyms": [
                        "confus",
                        "contrit",
                        "penaud"
                    ],
                    "common_phrases": [
                        "être désolé",
                        "vraiment désolé"
                    ]
                },
                {
                    "sense_id": "603482bb-b279-3cef-adb8-d30918be1013",
                    "sense_definition": "Désert, stérile ou ravagé, en parlant d'un lieu ou d'un paysage.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les explorateurs traversaient un paysage particulièrement <w>désolé</w> et rocheux."
                        },
                        {
                            "text": "Après l'incendie, la forêt offrait le spectacle d'une terre entièrement <w>désolée</w>."
                        }
                    ],
                    "synonyms": [
                        "désertique",
                        "triste"
                    ],
                    "common_phrases": [
                        "paysage désolé"
                    ]
                },
                {
                    "sense_id": "9c0949ee-244d-3799-a547-9d3e918b7950",
                    "sense_definition": "Accablé par le chagrin ou plongé dans une profonde tristesse.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "chagrin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La famille <w>désolée</w> recevait les condoléances des proches après le drame."
                        },
                        {
                            "text": "Il semblait profondément <w>désolé</w> depuis l'annonce de la terrible nouvelle."
                        }
                    ],
                    "synonyms": [
                        "affligé",
                        "éploré",
                        "triste"
