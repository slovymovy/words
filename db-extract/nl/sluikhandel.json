                    },
                    {
                        "translation_id": "c9d37e3c-980f-4ddb-84c5-c11e254912ee",
                        "source_entry_id": "df73b9b9-cdce-3438-845e-961a7647886b",
                        "source_sense_id": "d51d88de-223b-3653-a504-dec88c20f087",
                        "target_lang_word": "contrebande",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contrebande",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "abf56e95-1ee0-3152-a35f-7e6bdab641d7",
                                        "entry_id": "f42016cc-2d85-31b0-a385-5d9c476da0fb",
                                        "glosses": [
                                            "Passage en fraude de marchandise, importation ou exportation clandestines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ee9905e-215b-42e1-a64c-6a7fc4f30d5c",
                                                "sense_id": "abf56e95-1ee0-3152-a35f-7e6bdab641d7",
                                                "text": "Enfin l’acte d’Algésiras, en créant un comité des douanes et une commission des valeurs douanières, édictait un règlement douanier et des tarifs nouveaux et ordonnait toutes les mesures propres à contrecarrer la fraude et la contrebande."
                                            },
                                            {
                                                "example_id": "1d13ea47-9806-47ff-b2ba-eeda4f4a66fa",
                                                "sense_id": "abf56e95-1ee0-3152-a35f-7e6bdab641d7",
                                                "text": "Malgré la contrebande qui s’exerce ouvertement comme tout autre négoce, et le plus souvent par des transactions avec les employés du fisc, la douane de Cadiz était une des plus productives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54864b88-8412-36b7-a9a1-e3c47a956e7e",
                                        "entry_id": "f42016cc-2d85-31b0-a385-5d9c476da0fb",
                                        "glosses": [
                                            "Marchandises qui sont ainsi passées en fraude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01ba0854-f8c0-441a-bee1-13746bc45981",
                                                "sense_id": "54864b88-8412-36b7-a9a1-e3c47a956e7e",
                                                "text": "D’ailleurs, la plupart des écrits de Voltaire furent imprimés en Hollande ou en Angleterre et ne se vendirent en France, qu’en contrebande."
                                            },
                                            {
                                                "example_id": "923d99d0-188c-44b6-8bd5-1e417874b121",
                                                "sense_id": "54864b88-8412-36b7-a9a1-e3c47a956e7e",
                                                "text": "Contrebande de guerre, introduction d’objets de guerre par un navire neutre dans le territoire d’une des puissances belligérantes."
                                            },
                                            {
                                                "example_id": "3ca62519-6a72-4962-a98c-d5a1413b48b1",
                                                "sense_id": "54864b88-8412-36b7-a9a1-e3c47a956e7e",
                                                "text": "Et son regard aigu se replongea dans la foule, à la recherche du lauréat, comme la sonde du gablou impassible se plonge dans les bottes de paille à la recherche de la contrebande."
                                            },
                                            {
                                                "example_id": "381e41c0-26e9-4bc5-85e1-76c694f2a5b0",
                                                "sense_id": "54864b88-8412-36b7-a9a1-e3c47a956e7e",
                                                "text": "En principe, les corsaires pouvaient s’emparer de tous les navires ennemis et visiter le neutres, afin de s’assurer que ceux-ci n’avaient pas à leurs bords des fraudeurs, des smogleurs, ou de la contrebande de guerre."
                                            },
                                            {
                                                "example_id": "c5f0a999-c03f-40ed-8092-9930a4803ee3",
                                                "sense_id": "54864b88-8412-36b7-a9a1-e3c47a956e7e",
                                                "text": "Le bureau d’Halifax de Atlas Shipping était chargé de noliser les bateaux par vingt ou quarante à la fois. La contrebande était transportée, sur ces navires, de Saint-Pierre au Canada et aux États-Unis."
                                            },
                                            {
                                                "example_id": "3483d9f5-73d1-4c6b-b9bd-aeec7544cfe1",
                                                "sense_id": "54864b88-8412-36b7-a9a1-e3c47a956e7e",
                                                "text": "J’étais un grand bateau descendant la Garonne\nFarci de contrebande et bourré d’Espagnols\nLes gens qui regardaient saluaient la Madone\nQue j’avais attachée en poupe par le col."
                                            }
                                        ]
                                    }
                                ]
                            },
