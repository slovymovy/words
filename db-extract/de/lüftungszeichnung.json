                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13e8bafe-c3f5-4f30-8c28-1ee0f765e1b5",
                                "sense_id": "ce0074d8-8a7b-3500-b8e0-58641a57c9f8",
                                "text": "„Hier sehen Sie einen Schnitt einer Lüftungszeichnung.“"
                            },
                            {
                                "example_id": "975f2587-c734-4637-8018-19031d8b896b",
                                "sense_id": "ce0074d8-8a7b-3500-b8e0-58641a57c9f8",
                                "text": "„Für das schnelle und einfache Erstellen von schematischen Lüftungszeichnungen wurden neue Schemasymbole nach EN 12792 in die Artikeldatenbank eingefügt.“"
                            },
                            {
                                "example_id": "337bab4a-0d71-4fb5-aa2a-2faba1254976",
                                "sense_id": "ce0074d8-8a7b-3500-b8e0-58641a57c9f8",
                                "text": "„Wenn die Lüftungszeichnung nicht den exakten Typ angibt, darauf achten, dass die Produkte im richtigen Kanalsystem montiert werden: S=Zuluft und E=Abluft. “"
                            },
                            {
                                "example_id": "74e6d9b6-5475-490d-9462-8235d003dd9f",
                                "sense_id": "ce0074d8-8a7b-3500-b8e0-58641a57c9f8",
                                "text": "„Damit Sie zukünftig Ihre Lüftungszeichnungen mit AutoCAD/LT schnell und präzise erstellen können, haben wir in Zusammenarbeit mit verschiedenen Lüftungsfirmen LT-TOOLS Lüftung entwickelt.“"
                            }
                        ],
