                                "sense_id": "6caa5188-3425-3fd4-b643-94619ea90a13",
                                "text": "Het project zal naar schatting 1000 mandagen aan werk kosten.",
                                "translation": "The project is estimated to require 1000 man-days of work.",
                                "english": "The project is estimated to require 1000 man-days of work."
                            },
                            {
                                "example_id": "993885eb-b71b-4a9d-9f22-882af80b5796",
                                "sense_id": "6caa5188-3425-3fd4-b643-94619ea90a13",
                                "text": "Voor dit bouwproject zijn er minstens 50 mandagen nodig om het af te ronden.",
                                "translation": "This construction project requires at least 50 man-days to complete.",
                                "english": "This construction project requires at least 50 man-days to complete."
                            },
                            {
                                "example_id": "146cdb70-d009-4b25-85a7-e29eff52f814",
                                "sense_id": "6caa5188-3425-3fd4-b643-94619ea90a13",
