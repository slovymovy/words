                "senses": [
                    {
                        "sense_id": "697548d2-2e2e-39dc-a3c3-e9298755bd37",
                        "entry_id": "14889dd7-83c1-334e-b90b-a55ff8e983a3",
                        "glosses": [
                            "Gottesdienst in der Nacht vom 24. Dezember auf den 25. Dezember eines Jahres kurz vor oder gegen Mitternacht zur Feier der Geburt Jesu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9747bc09-edd2-4ec3-b58f-c8cbb034c515",
                                "sense_id": "697548d2-2e2e-39dc-a3c3-e9298755bd37",
                                "text": "Die Christmette beginnt um 23:00 Uhr in der Kirche Brunstorf."
                            },
                            {
                                "example_id": "25d40909-80a1-46ae-b622-d12672396dae",
                                "sense_id": "697548d2-2e2e-39dc-a3c3-e9298755bd37",
                                "text": "Papst Franziskus hat am Heiligen Abend mit der Christmette den Höhepunkt der christlichen Weihnacht eingeläutet. Tausende Gläubige versammelten sich im und vor dem Petersdom in Rom, um der Predigt des Oberhaupts der Katholiken zuzuhören."
                            },
                            {
                                "example_id": "64793ced-0c2d-4bbc-9fc3-7cf124e3e11c",
                                "sense_id": "697548d2-2e2e-39dc-a3c3-e9298755bd37",
                                "text": "Eine unbekannte Frau hat versucht, Benedikt XVI. während der Christmette im Petersdom anzugreifen. Der Papst stürzte, konnte aber kurz darauf die Messe lesen"
                            },
                            {
                                "example_id": "2bbae96f-4f2c-4d30-b235-187a7a46f379",
                                "sense_id": "697548d2-2e2e-39dc-a3c3-e9298755bd37",
                                "text": "„Am Heiligen Abend fahren wir zur Christmette.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
