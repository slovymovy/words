                    {
                        "sense_id": "63ee4c08-511e-3802-9e49-f768409a2e1b",
                        "entry_id": "d0c7393c-45c3-3c5f-99d3-a95d23eb8f96",
                        "glosses": [
                            "Finished without a nap (in fabric)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "7b438830-6b32-4a7a-b6ec-617a6243507e",
                                "sense_id": "63ee4c08-511e-3802-9e49-f768409a2e1b",
                                "text": "Did I attempt her with a thred-bare name—unnapt with meritorious actions, [...]"
                            },
                            {
                                "example_id": "277f0f25-1472-43bc-9263-4b520588c75f",
                                "sense_id": "63ee4c08-511e-3802-9e49-f768409a2e1b",
                                "text": "Napping permits a more permeable cake on the fabric surface but, in some cases, is more difficult to clean than unnapped cloth."
                            },
                            {
                                "example_id": "2c474421-4b7b-4404-b8d7-10456c7b29b4",
                                "sense_id": "63ee4c08-511e-3802-9e49-f768409a2e1b",
                                "text": "Pigment prints are better applied to the unnapped side of a fabric as the print will matt down the raised fibers."
                            }
                        ]
                    },
                    {
                        "sense_id": "fb2dbe40-0104-34a0-96ad-70d3238e22d7",
                        "entry_id": "d0c7393c-45c3-3c5f-99d3-a95d23eb8f96",
                        "glosses": [
                            "Not having napped (slept for a short time)"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3bacd5e8-66ff-4ff5-9e95-e7b9f19bca0b",
                                "sense_id": "fb2dbe40-0104-34a0-96ad-70d3238e22d7",
                                "text": "However wolverine-like an unnapped child, he's a cherub compared to one roused from a short sleep."
                            },
                            {
                                "example_id": "7f659738-5054-4e1e-ad24-6eef0515577e",
                                "sense_id": "fb2dbe40-0104-34a0-96ad-70d3238e22d7",
                                "text": "A newborn baby Left unnapped so carelessly Takes this time to pee"
                            },
                            {
                                "example_id": "da769c09-b2a9-4442-b313-d5d6b040ce54",
                                "sense_id": "fb2dbe40-0104-34a0-96ad-70d3238e22d7",
                                "text": "If your unnapped child is fairly civil, composed, and not too cranky at bed- time, he probably doesn't need naps anymore."
                            }
                        ]
                    }
