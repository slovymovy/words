                "senses": [
                    {
                        "sense_id": "094713cc-7cb3-3859-8348-b8de92db7b87",
                        "entry_id": "97fa0a80-56c9-3f0c-b6af-6e1317a588b9",
                        "glosses": [
                            "ein Schriftstück, auf das sich interessierte Lüftungstechniker durch Mitarbeit in einem Normenausschuss geeinigt haben, das Empfehlungscharakter besitzt und das durch ein Gesetz, eine Verordnung oder einen Vertrag verbindlich gemacht werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ffdc6a2-39fd-47ca-9274-da61225b786a",
                                "sense_id": "094713cc-7cb3-3859-8348-b8de92db7b87",
                                "text": "Jede Lüftungsnorm stellt immer auch den \"Stand der Technik\" in der Lüftung dar."
                            },
                            {
                                "example_id": "48a4b443-b108-448f-bf8a-15ddc77a9133",
                                "sense_id": "094713cc-7cb3-3859-8348-b8de92db7b87",
                                "text": "„Deshalb wurde im Mai 2009 nach längerer Überarbeitungsphase eine aktualisierte Version der Lüftungsnorm DIN 1946-6 veröffentlicht.“"
                            },
                            {
                                "example_id": "903a3330-6e83-46e1-810c-482178b11742",
                                "sense_id": "094713cc-7cb3-3859-8348-b8de92db7b87",
                                "text": "„Der seit Anfang 2006 vorliegende Normenentwurf zur Neuregelung der hier relevanten Lüftungsnorm DIN 1946-6 wurde am 01.05.2009 verabschiedet und ist nunmehr als anerkannte Regel der Technik zu beachten.“"
                            },
                            {
                                "example_id": "1ede0c8d-099e-4fb7-a37c-987fb3d8c891",
                                "sense_id": "094713cc-7cb3-3859-8348-b8de92db7b87",
                                "text": "„Der Verband für Wohnungslüftung e.V. nimmt in einem Merkblatt zur aktualisierten Lüftungsnorm DIN 1946-6 (Mai 2009) Stellung.“"
                            },
                            {
                                "example_id": "d32cbfab-de30-4288-8cf4-35f6f8f2d43a",
                                "sense_id": "094713cc-7cb3-3859-8348-b8de92db7b87",
                                "text": "„Was sind die haftungsrechtlichen Konsequenzen aus der Lüftungsnorm?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
