                "senses": [
                    {
                        "sense_id": "f21303c0-bd33-3e26-afa4-b65e08d53086",
                        "entry_id": "b6a62bdf-06ee-3f9a-bfeb-aead9762f962",
                        "glosses": [
                            "ermittelbarer Anteil von Geruchsstoffen in der Luft und dessen Verifizierung"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "ad8908ca-e32c-491a-a9d8-0e42a61705ed",
                                "sense_id": "f21303c0-bd33-3e26-afa4-b65e08d53086",
                                "text": "„Geruchsabscheideleistung für biologische Abluftreinigungsanlagen •„Kein Rohgas im Reingas wahrnehmbar (k.R.w)“ •„Die Geruchskonzentration im Reingas muss kleiner/gleich 300 GE/m³ sein“ zu streng und in der Praxis nicht einzuhalten seien.“"
                            },
                            {
                                "example_id": "631a4d86-862a-49ba-b3df-beb8e2d34fc0",
                                "sense_id": "f21303c0-bd33-3e26-afa4-b65e08d53086",
                                "text": "„Die Geruchskonzentration von den Flächenquellen am Boden (Liegebox, Laufgang und Laufhof) und in 3 m Höhe wurde am Olfaktometer mit Testpersonen bestimmt. Während am Boden die höchsten Geruchskonzentrationen vor allem im Laufgang auftraten, war die Geruchskonzentration in 3 m Höhe über den drei Flächenquellen vergleichbar.“"
                            },
                            {
                                "example_id": "ea6b1804-f61c-401e-b1e2-071c93a3cdae",
                                "sense_id": "f21303c0-bd33-3e26-afa4-b65e08d53086",
                                "text": "„Die Geruchskonzentration nach VDI 3881 ist die quantitative Emissionsermittlung in GE/m³ bzw. GE/h.“"
                            },
                            {
                                "example_id": "6e3164ec-e63b-468d-be68-be1e7b1b4761",
                                "sense_id": "f21303c0-bd33-3e26-afa4-b65e08d53086",
                                "text": "„Gemäss der europäischen Norm UNE EN 13725, ist Geruchskonzentration “die Anzahl der europäischen Geruchseinheiten in einem Kubikmeter Gas zu Standardbedingungen”. Deshalb wird die Geruchskonzentration in “europäischen Geruchseinheiten” gemessen und ihr Symbol ist uoE (zu beachten, dass “E” ein Subindex ist).“"
                            },
                            {
                                "example_id": "82f27744-cbef-4401-af94-7f90b4fb1534",
                                "sense_id": "f21303c0-bd33-3e26-afa4-b65e08d53086",
                                "text": "„Verfahren zum Messen und/oder Normalisieren von Geruchskonzentrationen, und Geruchs- und/oder Feuerdetektionssystem, das eine Ersatzschaltung verwendet“ Patentschrift EP0674172B1, abgerufen am 21. August 2013"
                            },
                            {
                                "example_id": "aa9460ae-458f-4104-b291-b1659df6a088",
                                "sense_id": "f21303c0-bd33-3e26-afa4-b65e08d53086",
                                "text": "„Aus dieser Streuung der Verdünnungsstufen resultiert eine Verdoppelung oder Halbierung der ermittelten Geruchsstoffkonzentrationen, d. h. statt einer Geruchskonzentration von 100 GE/m³ können 50 GE/m³ bzw. 200 GE/m³ bestimmt werden (PILZ 1998).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
