                ],
                "senses": [
                    {
                        "sense_id": "af9bbbdb-4122-360c-9dd0-c46bbe8500bf",
                        "entry_id": "b72cd9d8-16da-3a58-9504-112a6ac9d2f5",
                        "glosses": [
                            "Garnir de broussailles un terrain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17210d8b-3174-40ac-a521-65f117538eb3",
                                "sense_id": "af9bbbdb-4122-360c-9dd0-c46bbe8500bf",
                                "text": "S’il est utile de déterminer à l’avance quels seront les périmètres… à reboiser, gazonner ou broussailler"
                            }
                        ]
                    },
                    {
                        "sense_id": "938e503e-0636-3380-9c88-4f563f772fd8",
                        "entry_id": "b72cd9d8-16da-3a58-9504-112a6ac9d2f5",
                        "glosses": [
                            "Avoir le caractère du broussailleur."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "868c49c4-7e77-3c75-8aa2-ce32931c2843",
                        "entry_id": "b72cd9d8-16da-3a58-9504-112a6ac9d2f5",
                        "glosses": [
                            "Ressembler à des broussailles."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "48938be5-a59f-470b-9b6b-a77c1d4b2821",
                                "sense_id": "868c49c4-7e77-3c75-8aa2-ce32931c2843",
                                "text": "La glace de la salle de bains me renvoya un ventre gris, des hanches lourdes, des mamelles où broussaillent les poils blancs et une petite chose, définitivement incongrue."
                            },
                            {
                                "example_id": "c235e79f-b8db-4296-9682-e5d02a1295ce",
                                "sense_id": "868c49c4-7e77-3c75-8aa2-ce32931c2843",
                                "text": "Sous le bras levé de la femme, un peu de poil broussaille éhontément."
                            }
                        ]
                    }
