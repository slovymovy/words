                                "target_senses": [
                                    {
                                        "sense_id": "a51adcdb-51a8-37d9-a780-afef0e33102a",
                                        "entry_id": "5116b6b8-fcbf-30e5-b205-dd7daa31ed27",
                                        "glosses": [
                                            "Hauptstadt von Litauen"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a3815c1-c16b-4908-9b1a-2028ac239c40",
                                                "sense_id": "a51adcdb-51a8-37d9-a780-afef0e33102a",
                                                "text": "Sie wurde in Wilna geboren."
                                            },
                                            {
                                                "example_id": "0344f33a-55fb-4ae8-8b18-c9fb0731b2dd",
                                                "sense_id": "a51adcdb-51a8-37d9-a780-afef0e33102a",
                                                "text": "„Der russische Kaiser war inzwischen bereits seit über einem Monat in Wilna und hielt dort Truppenschauen und Manöver ab.“"
                                            },
                                            {
                                                "example_id": "f121a78e-3db1-4796-9278-03ab37d208cb",
                                                "sense_id": "a51adcdb-51a8-37d9-a780-afef0e33102a",
                                                "text": "„Vielleicht kannst du einen Wagen begleiten, der unser Beutegut nach Wilna bringt, sagte er eines Abends.“"
                                            },
                                            {
                                                "example_id": "a1c7aa0e-320e-4c01-beb2-7a8f32fb4c50",
                                                "sense_id": "a51adcdb-51a8-37d9-a780-afef0e33102a",
                                                "text": "„In dem amerikanischen Film »Holocaust« kommt ein Kurier aus Wilna ins Warschauer Ghetto, erzählt, was in Wilna passiert, dass sie alle getötet werden und dass man den Widerstand organisieren muss.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b20ff8ec-96d1-47cd-b92b-8d1a6f2be621",
                        "source_entry_id": "13fa09b2-2903-369b-aaf1-298f9e820e68",
                        "source_sense_id": "0127c12d-4b00-35ae-bd2b-0e844c3820ae",
