                ],
                "senses": [
                    {
                        "sense_id": "bbbcd9fe-479c-3781-a964-117e55e4ac92",
                        "entry_id": "c0cf2115-b8e6-3577-9ec0-e1b871535984",
                        "glosses": [
                            "Krankheitserreger vom Typ Virus, dessen Erbgut/Genom aus RNA-Sequenzen besteht"
                        ],
                        "tags": [
                            "Biochemie",
                            "Virologie"
                        ],
                        "examples": [
                            {
                                "example_id": "0c5e1c1b-4413-4ba1-b19d-3286429c7b1d",
                                "sense_id": "bbbcd9fe-479c-3781-a964-117e55e4ac92",
                                "text": "„Als RNA-Viren bezeichnet man eine heterogene Gruppe von Viren, die als gemeinsames Strukturelement ein Genom aus Ribonukleinsäure (RNA) aufweisen. Ihr wissenschaftlicher Name ist Riboviria.“"
                            },
                            {
                                "example_id": "f2a2ccae-b802-4e09-95d3-a8a0c65c010c",
                                "sense_id": "bbbcd9fe-479c-3781-a964-117e55e4ac92",
                                "text": "„Erreger dieser bei Wiederkäuern (Rind, Schaf, Ziege) auftretenden viralen Infektionskrankheit ist das doppelsträngige RNA-Virus, wovon derzeit mind. 25 Serotypen bekannt sind. Bei den in Mitteleuropa beobachteten Ausbrüchen dominiert Serotyp 8.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
