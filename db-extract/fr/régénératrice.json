                "senses": [
                    {
                        "sense_id": "f8dbc6a5-f206-38cc-a038-8fd734415159",
                        "entry_id": "38a6a4a7-3880-39fa-a7e3-646cce2224e1",
                        "glosses": [
                            "Celle qui régénère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "148c3f78-6ce8-48c0-bfb1-605ee71ea0b3",
                                "sense_id": "f8dbc6a5-f206-38cc-a038-8fd734415159",
                                "text": "O voluptueuse Intempérance ! je te regarde comme la régénératrice des plaisirs ; ce n’est qu’avec toi qu’on les goûte bien ; ce n’est que par toi qu’ils n’ont plus d’épines ; toi seule en applanis la route ; toi seule en écartes l’imbécille Remords ; toi seule sais délicieusement troubler cette Raison, si froide et si monotone, dont toutes nos passions sont empoisonnées sans toi."
                            },
                            {
                                "example_id": "12715a28-2b56-416a-92ea-fb71eeb9d3bc",
                                "sense_id": "f8dbc6a5-f206-38cc-a038-8fd734415159",
                                "text": "Ô Sylvius, bénissons les heures effervescentes de l’été qui posent leurs mains régénératrices sur nos corps détendus."
                            }
                        ]
                    }
                ],
