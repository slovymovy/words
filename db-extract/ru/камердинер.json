                                    {
                                        "sense_id": "fe896eae-b73d-365b-8f45-261d3f6bc1ac",
                                        "entry_id": "9259e61f-0790-3b08-9fdf-ee05a18f8285",
                                        "glosses": [
                                            "A man's personal male attendant, responsible for his clothes and appearance."
                                        ],
