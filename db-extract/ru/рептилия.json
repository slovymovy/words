                        "form": "репти́лии"
                    },
                    {
                        "form_id": "f7f6f8a5-b2e8-41e5-a13f-92b8888036e0",
                        "entry_id": "656de92f-e29c-348e-a5fd-771ee5fb6cc7",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "репти́лиях"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ccdd6f5b-bb91-3aa8-b431-ca52f25a069c",
                        "entry_id": "656de92f-e29c-348e-a5fd-771ee5fb6cc7",
                        "glosses": [
                            "зоол. то же, что пресмыкающееся; позвоночное холоднокровное животное"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0596753c-1fba-4dd9-9771-569676db9460",
                                "sense_id": "ccdd6f5b-bb91-3aa8-b431-ca52f25a069c",
                                "text": "Отправляясь за дровами так близко от стоянки, охотники не взяли с собой ружей и теперь оказались безоружными лицом к лицу с какой-то рептилией неизвестной породы, несомненно плотоядной и сильной."
                            },
                            {
                                "example_id": "4ad2858f-43aa-41a5-85b4-4f1c4b9f4d4f",
                                "sense_id": "ccdd6f5b-bb91-3aa8-b431-ca52f25a069c",
                                "text": "Всё больше данных о том, что и в горных районах Африки среди заболоченных озёр бродят ящероподобные рептилии."
                            },
                            {
                                "example_id": "94ade981-c33e-415d-bbb7-ca772baa8826",
                                "sense_id": "ccdd6f5b-bb91-3aa8-b431-ca52f25a069c",
                                "text": "Второе слово repens (ползучий, ползающий) легко запомнить, если представить себе, как ползают различные рептилии ― змеи, черепахи и ящерицы."
                            }
                        ]
                    },
                    {
                        "sense_id": "95886a4d-08e0-31a3-8d92-ef136f34dc3b",
                        "entry_id": "656de92f-e29c-348e-a5fd-771ee5fb6cc7",
                        "glosses": [
                            "перен., уничиж. подхалим"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72e1e45d-2528-4bbd-9f46-bd3d8eeaf84a",
                                "sense_id": "95886a4d-08e0-31a3-8d92-ef136f34dc3b",
                                "text": "С каким наслаждением я дала бы по морде Львову. Этакая рептилия. Таких как он, как Мишкевич надо уничтожать не глядя, не задумываясь, пачками ― но непременно гласно, публично, дабы у других отбить охоту рептильничать."
                            },
                            {
                                "example_id": "05b85a0b-0b8d-4404-80cf-9800cd9b17be",
                                "sense_id": "95886a4d-08e0-31a3-8d92-ef136f34dc3b",
                                "text": "― Этот интеллигентный козёл, эта рептилия, испортил мне весь сегодняшний день!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "20dac2f9-9b26-4b54-8f2d-3eaca4b83f14",
                        "source_entry_id": "656de92f-e29c-348e-a5fd-771ee5fb6cc7",
                        "target_lang_word": "reptile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reptile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b6d4ded7-e3fd-3c7e-b6c2-49110afbe4bb",
                                        "entry_id": "26e1f2a8-b3c2-31b9-8bd8-af97b535c0b2",
                                        "glosses": [
                                            "Any member of the class Reptilia that is not a bird— a cold-blooded vertebrate with dry scales that usually lays eggs, such as a lizard, snake, turtle, tortoise, crocodile, alligator, etc."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "560d963f-8f27-3621-b37f-798d518e0141",
                                        "entry_id": "26e1f2a8-b3c2-31b9-8bd8-af97b535c0b2",
                                        "glosses": [
                                            "Any member of Reptilia, including birds."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1e05ea6a-8100-3d09-bbc4-d9b778e5ef2b",
                                        "entry_id": "26e1f2a8-b3c2-31b9-8bd8-af97b535c0b2",
                                        "glosses": [
                                            "A reptile or amphibian."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "525458f9-a80e-3127-b987-df8c9996a26d",
                                        "entry_id": "26e1f2a8-b3c2-31b9-8bd8-af97b535c0b2",
                                        "glosses": [
                                            "A mean, grovelling, loathsome or repulsive person."
                                        ],
                                        "tags": [
                                            "dated",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16ba2d50-1d94-496d-abcc-b0e3dedd90c0",
                                                "sense_id": "525458f9-a80e-3127-b987-df8c9996a26d",
                                                "text": "This work may, indeed, be considered as a great creation of our own; and for a little reptile of a critic to presume to find fault with any of its parts, without knowing the manner in which the whole is connected, and before he comes to the final catastrophe, is a most presumptuous absurdity."
                                            },
                                            {
                                                "example_id": "ce92c6c5-2ebd-4938-bc92-0a0609124dca",
                                                "sense_id": "525458f9-a80e-3127-b987-df8c9996a26d",
                                                "text": "\"That reptile,\" whispered Pott, catching Mr. Pickwick by the arm, and pointing towards the stranger. \"That reptile — Slurk, of the Independent!\""
                                            },
                                            {
                                                "example_id": "96972d01-7ac5-4cea-b6ea-a6beb29cdf1e",
                                                "sense_id": "525458f9-a80e-3127-b987-df8c9996a26d",
                                                "text": "[…] If I pitied you for crying and looking so very frightened, you should spurn such pity. Ellen, tell him how disgraceful this conduct is. Rise, and don’t degrade yourself into an abject reptile—don’t!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "reptile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3357ad73-43a5-3190-8bee-07dd1e118bc8",
                                        "entry_id": "a204bbba-809f-34b0-9749-edf993a3e488",
                                        "glosses": [
                                            "Creeping; moving on the belly, or by means of small and short legs."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "11c426b3-c258-348e-80f0-0869364133dc",
                                        "entry_id": "a204bbba-809f-34b0-9749-edf993a3e488",
                                        "glosses": [
                                            "Grovelling; low; vulgar."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ab33bd5-1686-4f13-b07c-e3a9e8b903db",
                                                "sense_id": "11c426b3-c258-348e-80f0-0869364133dc",
                                                "text": "a reptile race or crew    reptile vices"
                                            },
                                            {
                                                "example_id": "a16ed511-32d6-4f5d-b25f-cb1080a45250",
                                                "sense_id": "11c426b3-c258-348e-80f0-0869364133dc",
                                                "text": "There is also a false, reptile prudence, the result not of caution, but of fear."
                                            },
                                            {
                                                "example_id": "ce230cc0-4f46-4ab0-9b63-04a31ac79aff",
                                                "sense_id": "11c426b3-c258-348e-80f0-0869364133dc",
                                                "text": "My herald shall appoint a week, / And let the recreant traitors seek / My tournay court—that there and then / I may dislodge their reptile souls / From the bodies and forms of men!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b57ea2e2-a343-4511-8144-1e1e4ce24fa3",
                        "source_entry_id": "656de92f-e29c-348e-a5fd-771ee5fb6cc7",
                        "target_lang_word": "Reptil",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reptil",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f606aab1-490a-3679-bd5e-06b831ce68e7",
                                        "entry_id": "e3c659a0-3d39-3b21-badf-fe692c3a8a34",
                                        "glosses": [
                                            "Landwirbeltier, das mit Schuppen oder Hornplatten bedeckt ist und kein Larvenstadium durchlebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "924d7fbd-16e8-47d4-ae6f-ddd1521eaa08",
                                                "sense_id": "f606aab1-490a-3679-bd5e-06b831ce68e7",
                                                "text": "Die meisten Reptilien sind heute ausgestorben."
                                            },
                                            {
                                                "example_id": "38b224fd-0f72-45a4-9879-81ade7e96558",
                                                "sense_id": "f606aab1-490a-3679-bd5e-06b831ce68e7",
                                                "text": "Die Reptilien sind eine paraphyletische Tiergruppe, sie bilden zusammen mit den Vögeln die Sauropsiden."
                                            },
                                            {
                                                "example_id": "18af517c-6f9b-48c1-98b9-5c4824c49527",
                                                "sense_id": "f606aab1-490a-3679-bd5e-06b831ce68e7",
                                                "text": "„In der Mitte des Kataraktes ragten bizarre Felsen in die Höhe und wirkten aus der Entfernung wie riesige Reptilien aus dem Erdmittelalter.“"
                                            },
                                            {
                                                "example_id": "284a63a4-d896-4efc-8796-d77ddfed7c22",
                                                "sense_id": "f606aab1-490a-3679-bd5e-06b831ce68e7",
                                                "text": "„Dabei sind Reptilien eigentlich recht dankbare Haustiere.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
