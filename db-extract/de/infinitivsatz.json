                "senses": [
                    {
                        "sense_id": "e85367c5-c4a0-3a56-92e9-03f39ccc73ee",
                        "entry_id": "526ef6b4-895c-3e03-853d-eabfc7d70e36",
                        "glosses": [
                            "subjektlose Wortgruppe, deren Kern ein Infinitiv ist und die anstelle eines Satzes oder Teilsatzes verwendet wird, aber auch als ein Nebensatz behandelt und bezeichnet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cac9b246-9737-4591-9411-36c26afb2197",
                                "sense_id": "e85367c5-c4a0-3a56-92e9-03f39ccc73ee",
                                "text": "Statt Gliedsätzen mit Subjunktion werden oft Infinitivsätze formuliert: Aus dem Hauptsatz „er hole die Kinder nach der Schule nach Hause“ im Satz: „Er hatte angekündigt, er hole die Kinder nach der Schule nach Hause“ wird der Infinitivsatz: „die Kinder nach der Schule nach Hause zu holen“ in dem nun geänderten Satz: „Er hatte angekündigt, die Kinder nach der Schule nach Hause zu holen.“ Der Infinitivsatz, der Objekt zum Verb des Hauptsatzes ist, vertritt hier den Hauptsatz im Konjunktiv I und ist damit ein Objektsinfinitiv und besonderer Nebensatz."
                            },
                            {
                                "example_id": "3efb24a0-ae3b-4594-b12f-184f3bb1a212",
                                "sense_id": "e85367c5-c4a0-3a56-92e9-03f39ccc73ee",
                                "text": "„Wir ziehen es vor, diese Sequenzen als Nebensätze zu betrachten und sie als Infinitivsätze zu bezeichnen.“"
                            },
                            {
                                "example_id": "ab6e64ad-49b7-4b28-b6be-828ecdb857b0",
                                "sense_id": "e85367c5-c4a0-3a56-92e9-03f39ccc73ee",
                                "text": "„Grundsätzlich können satzwertige Infinitive nur an der Stelle von daß-Sätzen stehen.“"
                            },
                            {
                                "example_id": "166ab3e8-9c22-4e60-a4f0-8d28b971eb1d",
                                "sense_id": "e85367c5-c4a0-3a56-92e9-03f39ccc73ee",
                                "text": "„Daher verwenden wir folgende Bezeichnungen synonym: - Infinitivgruppe/satzwertiger Infinitiv…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
