{
    "word_family": [
        "seedpod",
        "podcast"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4c8fe5f0-2a94-3de0-8ac7-0d2dc599b74c",
                    "sense_definition": "A long, narrow seed case for legumes such as peas, beans, or lentils.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "botany_container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She snapped open the green <w>pod</w> to reveal the peas inside.",
                            "target_lang_translations": {
                                "ru": "Она разломила зеленый <w>стручок</w>, чтобы показать горошины внутри.",
                                "zh": "她掰开绿色的<w>豆荚</w>，露出了里面的豌豆。"
                            }
                        },
                        {
                            "text": "You should scrape the seeds from the vanilla <w>pod</w> into the milk.",
                            "target_lang_translations": {
                                "ru": "Тебе следует выскрести семена из <w>стручка</w> ванили в молоко.",
                                "zh": "你应该把香草<w>豆荚</w>里的籽刮进牛奶里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "seedpod",
                        "shell",
                        "husk",
                        "hull",
                        "case"
                    ],
                    "common_phrases": [
                        "pea pod",
                        "vanilla pod",
                        "seed pod"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинная узкая оболочка, содержащая семена бобовых растений, таких как горох, фасоль или чечевица.",
                        "zh": "豆类植物（如豌豆、蚕豆或扁豆）长而窄的种子外壳。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стручок",
                                "target_lang_sense_clarification": "плод растения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "豆荚",
                                "target_lang_sense_clarification": "植物的果实外壳"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3dda9627-97d1-3955-bc64-ef72175d1b9e",
                    "sense_definition": "A digital audio program or file available for download; a short form of podcast.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "media",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I listen to a sports <w>pod</w> on my way to work every morning.",
                            "target_lang_translations": {
                                "ru": "Я слушаю спортивный <w>подкаст</w> по дороге на работу каждое утро.",
                                "zh": "我每天早上上班路上都会听一个体育<w>播客</w>。"
                            }
                        },
                        {
                            "text": "They recorded a new episode of the <w>pod</w> yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера они записали новый выпуск <w>подкаста</w>.",
                                "zh": "他们昨天录制了新一期的<w>播客</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "listen to a pod"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        },
                        {
                            "trait_type": "form",
                            "comment": "clipping of podcast"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Цифровая аудиопрограмма или файл, доступный для скачивания; сокращение от слова «подкаст».",
                        "zh": "一种可供下载的数字音频节目或文件；“播客”的简称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подкаст",
                                "target_lang_sense_clarification": "аудиопрограмма"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "播客",
                                "target_lang_sense_clarification": "音频节目"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0631745a-7882-3ce7-8fa0-1f8b41df018a",
                    "sense_definition": "A detachable vessel, small vehicle, or self-contained space designed for a specific function or accommodation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tech_container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The astronaut used the escape <w>pod</w> to return safely to Earth.",
                            "target_lang_translations": {
                                "ru": "Астронавт использовал спасательную <w>капсулу</w>, чтобы благополучно вернуться на Землю.",
                                "zh": "宇航员使用了逃生<w>舱</w>安全返回了地球。"
                            }
                        },
                        {
                            "text": "He stayed in a tiny sleeping <w>pod</w> at the airport hotel.",
                            "target_lang_translations": {
                                "ru": "Он остановился в крошечной <w>капсуле</w> для сна в отеле при аэропорте.",
                                "zh": "他住在机场酒店的一个微型睡眠<w>胶囊</w>里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "capsule",
                        "vessel",
                        "container"
                    ],
                    "common_phrases": [
                        "escape pod",
                        "space pod",
                        "sleeping pod",
                        "office pod"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отделяемый отсек, небольшое транспортное средство или автономное пространство, предназначенное для определенной функции.",
                        "zh": "一种可拆卸的容器、小型交通工具或为特定功能设计的独立空间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "капсула",
                                "target_lang_sense_clarification": "отсек или модуль"
                            },
                            {
                                "target_lang_word": "отсек",
                                "target_lang_sense_clarification": "часть конструкции"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "舱",
                                "target_lang_sense_clarification": "独立的空间或容器"
                            },
                            {
                                "target_lang_word": "胶囊",
                                "target_lang_sense_clarification": "小型封闭空间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34d7a99f-ff13-31a4-8a61-d68879da84b1",
                    "sense_definition": "A small group of marine animals, especially whales or dolphins, swimming together.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "animal_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We were lucky to see a <w>pod</w> of dolphins playing near the boat.",
                            "target_lang_translations": {
                                "ru": "Нам повезло увидеть <w>стаю</w> дельфинов, играющих рядом с лодкой.",
                                "zh": "我们很幸运地看到了一<w>群</w>在船边嬉戏的海豚。"
                            }
                        },
                        {
                            "text": "A large <w>pod</w> of orcas was spotted hunting along the coast.",
                            "target_lang_translations": {
                                "ru": "Большая <w>стая</w> косаток была замечена на охоте вдоль побережья.",
                                "zh": "有人在海岸边发现了一大<w>群</w>虎鲸正在捕猎。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gam"
                    ],
                    "common_phrases": [
                        "pod of whales",
                        "pod of dolphins"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая группа морских животных, особенно китов или дельфинов, плавающих вместе.",
                        "zh": "一群一起游动的海洋动物，尤指鲸鱼或海豚。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стая",
                                "target_lang_sense_clarification": "группа животных"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "群",
                                "target_lang_sense_clarification": "用于成群动物的量词"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8c179e4e-dee6-3ace-9652-d90835684a02",
                    "sense_definition": "To remove peas or beans from their outer casing.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "food_prep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It takes a long time to <w>pod</w> enough broad beans for a full meal.",
                            "target_lang_translations": {
                                "ru": "Требуется много времени, чтобы <w>налущить</w> достаточно бобов для полноценного обеда.",
                                "zh": "要<w>剥</w>出足够做一顿饭的蚕豆需要很长时间。"
                            }
                        },
                        {
                            "text": "She sat on the porch <w>podding</w> fresh peas for dinner.",
                            "target_lang_translations": {
                                "ru": "Она сидела на крыльце и <w>лущила</w> свежий горох к ужину.",
                                "zh": "她坐在门廊上为晚餐<w>剥</w>新鲜豌豆。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shell",
                        "husk"
                    ],
                    "common_phrases": [
                        "pod peas"
                    ],
                    "target_lang_definitions": {
                        "ru": "Извлекать горох или бобы из их внешней оболочки.",
                        "zh": "将豌豆或豆类从外壳中剥出。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лущить",
                                "target_lang_sense_clarification": "очищать от скорлупы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "剥",
                                "target_lang_sense_clarification": "去掉外皮"
                            },
                            {
                                "target_lang_word": "去壳",
                                "target_lang_sense_clarification": "去除外壳"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}