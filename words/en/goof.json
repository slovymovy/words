{
    "word_family": [
        "goofy",
        "goofball"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "73721d18-23e7-3c33-8c13-41b5f82bf354",
                    "sense_definition": "A minor mistake or error",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "error",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I made a silly <w>goof</w> in that last calculation.",
                            "target_lang_translations": {
                                "nl": "Ik maakte een dom <w>foutje</w> in die laatste berekening.",
                                "es": "Cometí una <w>pifia</w> tonta en ese último cálculo."
                            }
                        },
                        {
                            "text": "It was just a small <w>goof</w> that we can easily fix.",
                            "target_lang_translations": {
                                "nl": "Het was slechts een klein <w>foutje</w> dat we makkelijk kunnen herstellen.",
                                "es": "Fue solo una pequeña <w>metedura de pata</w> que podemos solucionar fácilmente."
                            }
                        }
                    ],
                    "synonyms": [
                        "mistake",
                        "blunder",
                        "slip"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een kleine fout of vergissing.",
                        "es": "Error o fallo leve, a menudo tonto o por descuido."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "blunder",
                                "target_lang_sense_clarification": "Een domme of onhandige fout."
                            },
                            {
                                "target_lang_word": "foutje",
                                "target_lang_sense_clarification": "Een klein, onbeduidend foutje."
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "metedura de pata",
                                "target_lang_sense_clarification": "Error cometido por torpeza o descuido"
                            },
                            {
                                "target_lang_word": "pifia",
                                "target_lang_sense_clarification": "Fallo o descuido informal"
                            },
                            {
                                "target_lang_word": "error",
                                "target_lang_sense_clarification": "Fallo o equivocación menor"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2f1d6c8-b89f-3d35-b289-060ea82902e0",
                    "sense_definition": "A person who acts in a silly or foolish way",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Your little brother is a total <w>goof</w> when he is around his friends.",
                            "target_lang_translations": {
                                "nl": "Je broertje is een echte <w>gek</w> als hij bij zijn vrienden is.",
                                "es": "Tu hermano pequeño es un auténtico <w>payaso</w> cuando está con sus amigos."
                            }
                        },
                        {
                            "text": "Stop being such a <w>goof</w> and help me finish this work.",
                            "target_lang_translations": {
                                "nl": "Doe niet zo <w>dwaas</w> en help me dit werk afmaken.",
                                "es": "Deja de ser tan <w>tontorrón</w> y ayúdame a terminar este trabajo."
                            }
                        }
                    ],
                    "synonyms": [
                        "fool",
                        "clown"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemand die zich dwaas of onnozel gedraagt.",
                        "es": "Persona que se comporta de manera tonta, cómica o torpe."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gek",
                                "target_lang_sense_clarification": "Iemand die zich grappig of dwaas gedraagt."
                            },
                            {
                                "target_lang_word": "clown",
                                "target_lang_sense_clarification": "Iemand die grappen maakt en zich dwaas gedraagt."
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "payaso",
                                "target_lang_sense_clarification": "Persona que hace tonterías de forma simpática o molesta"
                            },
                            {
                                "target_lang_word": "tontorrón",
                                "target_lang_sense_clarification": "Persona que actúa de forma inocente o tonta"
                            },
                            {
                                "target_lang_word": "bobo",
                                "target_lang_sense_clarification": "Persona que hace cosas ridículas o tontas"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e9631d0f-5ed2-3610-911d-42ee06ed23c1",
                    "sense_definition": "To make a mistake",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "error",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is my fault because I <w>goofed</w> on the report.",
                            "target_lang_translations": {
                                "nl": "Het is mijn schuld omdat ik <w>geblunderd</w> heb in het rapport.",
                                "es": "Es culpa mía porque <w>metí la pata</w> en el informe."
                            }
                        },
                        {
                            "text": "We <w>goofed</w> and bought the wrong type of wax for the project.",
                            "target_lang_translations": {
                                "nl": "We <w>gingen de mist in</w> en kochten het verkeerde type was voor het project.",
                                "es": "Nos <w>equivocamos</w> y compramos el tipo de cera incorrecto para el proyecto."
                            }
                        }
                    ],
                    "synonyms": [
                        "err",
                        "blunder"
                    ],
                    "common_phrases": [
                        "goof up"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een fout maken.",
                        "es": "Cometer un error, equivocarse o meter la pata."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "blunderen",
                                "target_lang_sense_clarification": "Een domme fout maken."
                            },
                            {
                                "target_lang_word": "de mist in gaan",
                                "target_lang_sense_clarification": "Een fout maken of falen."
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "meter la pata",
                                "target_lang_sense_clarification": "Cometer un fallo o equivocarse de forma torpe"
                            },
                            {
                                "target_lang_word": "pifiar",
                                "target_lang_sense_clarification": "Equivocarse de manera informal"
                            },
                            {
                                "target_lang_word": "equivocarse",
                                "target_lang_sense_clarification": "Cometer una equivocación"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6750c6c1-30ac-361b-bd33-14efe93e568e",
                    "sense_definition": "To spend time doing silly or unproductive things",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We were just <w>goofing</w> around in the park all afternoon.",
                            "target_lang_translations": {
                                "nl": "We waren de hele middag in het park gewoon wat aan het <w>klooien</w>.",
                                "es": "Estuvimos simplemente <w>haciendo el tonto</w> en el parque toda la tarde."
                            }
                        },
                        {
                            "text": "Stop <w>goofing</w> and focus on your studies.",
                            "target_lang_translations": {
                                "nl": "Stop met <w>lummelen</w> en concentreer je op je studie.",
                                "es": "Deja de <w>hacer el payaso</w> y concéntrate en tus estudios."
                            }
                        }
                    ],
                    "synonyms": [
                        "mess around",
                        "fool around"
                    ],
                    "common_phrases": [
                        "goof around"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Tijd besteden aan dwaze of onproductieve dingen.",
                        "es": "Perder el tiempo haciendo tonterías o actividades poco productivas."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "klooien",
                                "target_lang_sense_clarification": "Onproductief bezig zijn of rommelen."
                            },
                            {
                                "target_lang_word": "lummelen",
                                "target_lang_sense_clarification": "Nietsnutten of doelloos rondhangen."
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "hacer el tonto",
                                "target_lang_sense_clarification": "Comportarse de forma ridícula o improductiva"
                            },
                            {
                                "target_lang_word": "hacer payasadas",
                                "target_lang_sense_clarification": "Actuar cómicamente o perdiendo el tiempo"
                            },
                            {
                                "target_lang_word": "perder el tiempo",
                                "target_lang_sense_clarification": "Estar desocupado o haciendo tonterías"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}