                        "examples": [
                            {
                                "example_id": "dff6edb1-f31f-44a9-abe1-917884bf1fd5",
                                "sense_id": "36d06911-81e4-352d-baa2-e9a181659f01",
                                "text": "Avec ce produit naturel ultra-économique et multi-usage, exit les produits chimiques abrasifs et dangereux."
                            },
                            {
                                "example_id": "a53254be-1f80-4322-bacf-93479ccdd94f",
                                "sense_id": "36d06911-81e4-352d-baa2-e9a181659f01",
                                "text": "Entre 0 et 3 ans, un bon jouet, en dehors de sa solidité et du respect des normes de sécurité, doit avoir pour qualités essentielles d’être le plus simple possible, et en même temps multi-usage."
                            },
                            {
                                "example_id": "69f83b5b-1992-41a0-a78c-f8873c4226c9",
                                "sense_id": "36d06911-81e4-352d-baa2-e9a181659f01",
                                "text": "L’idéal consiste à installer plusieurs socles RJ-45 multi-usage à différents endroits de la pièce pour y raccorder, au choix, un téléviseur, un téléphone ou un ordinateur (voir figure 11.3)."
