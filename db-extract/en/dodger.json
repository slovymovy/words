                        "source_entry_id": "e5bded0e-a2ea-3a78-b9fc-8d17ebf73489",
                        "source_sense_description": "nautical: companionway cover in a sailboat",
                        "target_lang_word": "buiskap",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "buiskap",
