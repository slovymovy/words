                    {
                        "sense_id": "7f04661b-817b-3a45-8acd-99c5472d1496",
                        "entry_id": "20254d34-e920-38cc-bfd5-13fa6d826e3c",
                        "glosses": [
                            "Messfeier, die früh am Morgen abgehalten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b13a21b0-35b4-45e1-9132-aee5dda985b8",
                                "sense_id": "7f04661b-817b-3a45-8acd-99c5472d1496",
                                "text": "„Dann kamen dazu zweimal in der Woche Frühmesse, einmal Bußandacht zusätzlich, zu zwei Malen Beichtunterricht.“"
                            },
                            {
                                "example_id": "fd9401a3-b2b6-485a-8880-3884ad894437",
                                "sense_id": "7f04661b-817b-3a45-8acd-99c5472d1496",
                                "text": "„Die Zwillinge Johanna und Matthias sorgten dafür, dass sie und Fried pünktlich in die Schule kamen, denn der Vater war bereits in der Frühmesse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
