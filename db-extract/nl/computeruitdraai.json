                "senses": [
                    {
                        "sense_id": "f94570ad-ebb8-313f-9d97-ed8e0c4c2a79",
                        "entry_id": "0fa4eca6-6f54-370b-adc2-54f16d00e7a3",
                        "glosses": [
                            "met een computer gemaakte papieren afdruk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61f29b71-4e9b-4893-98c1-39f93336a20d",
                                "sense_id": "f94570ad-ebb8-313f-9d97-ed8e0c4c2a79",
                                "text": "In de stilte van papiergeritsel werd zacht gesnik hoorbaar: mevrouw Noppens antwoord op het terugbrengen van leven en dood van haar zoon tot tweehonderd velletjes computeruitdraai."
                            },
                            {
                                "example_id": "8dc62977-15c1-4623-8e5c-88f70422e49c",
                                "sense_id": "f94570ad-ebb8-313f-9d97-ed8e0c4c2a79",
                                "text": "Wie beweert een brief van de overheid niet te hebben ontvangen, moet dat kunnen bewijzen. De afzender hoeft alleen met een computeruitdraai aan te tonen dat een geautomatiseerde brief is aangemaakt en verstuurd. Dat heeft de Raad van State bepaald in een zaak van een inwoner van Enschede."
                            }
                        ]
                    }
