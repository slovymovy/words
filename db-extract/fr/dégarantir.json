                "senses": [
                    {
                        "sense_id": "57fe7a4b-fa52-3ba6-8644-d71c049bea26",
                        "entry_id": "24b7caec-0614-36d9-8920-b67168fcb86f",
                        "glosses": [
                            "Arrêter de garantir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84e3f461-38a0-4f6d-a1b6-fa570ffffef7",
                                "sense_id": "57fe7a4b-fa52-3ba6-8644-d71c049bea26",
                                "text": "Même son de cloche dans la concession de Carpentras : Renault ne peut pas dégarantir la batterie si l’installation n’est pas ZE Ready."
                            },
                            {
                                "example_id": "cead7118-7276-451b-842a-eef3db9e24f7",
                                "sense_id": "57fe7a4b-fa52-3ba6-8644-d71c049bea26",
                                "text": "Le rôle de cette institution serait de garantir les parités des différentes monnaies membres, de mutualiser les réserves de change et de contrôler strictement l’inflation. Mais aussi de « dégarantir » la monnaie et de suspendre les États qui ne respecteraient pas les règles."
                            },
                            {
                                "example_id": "4e171de1-9893-4a5d-911d-99bf10744827",
                                "sense_id": "57fe7a4b-fa52-3ba6-8644-d71c049bea26",
                                "text": "Dégarantir les prêts. Pour cette deuxième méthode, les prêteurs n’ont pas besoin de remettre les NFT originaux aux locataires."
                            }
                        ]
                    }
