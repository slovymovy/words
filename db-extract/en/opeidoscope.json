                "senses": [
                    {
                        "sense_id": "3eadc4b5-9cd0-3eec-a92f-6744cbdd7341",
                        "entry_id": "f575a959-be76-3d11-b535-4983c58e40ce",
                        "glosses": [
                            "An instrument, consisting of a tube with one end open and the other end covered with a thin flexible membrane with a mirror attached to its centre, used for exhibiting upon a screen, by means of rays reflected from the mirror, the vibratory motions caused by sounds that enter the tube."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0befe2d8-0079-4a9b-bf7e-572800900200",
                                "sense_id": "3eadc4b5-9cd0-3eec-a92f-6744cbdd7341",
                                "text": "Among many experiments in transmitting speech I tried that of a conical point of iron fastened to the middle of an opeidoscope membrane, the point being attached to a fine wire in such a manner as not to interfere with its freedom of movement […]"
                            },
                            {
                                "example_id": "cfbc8a4e-7163-4181-9e3a-a16f42af4f1a",
                                "sense_id": "3eadc4b5-9cd0-3eec-a92f-6744cbdd7341",
                                "text": "This is a modification of the opeidoscope. A thin membrane of goldbeater's skin or rubber is stretched over a wooden or metallic cell and secured by a winding of thread. To the center of the membrane is cemented a small thin mirror."
                            },
                            {
                                "example_id": "b3eee686-3b46-41e8-9179-f8133b409f34",
                                "sense_id": "3eadc4b5-9cd0-3eec-a92f-6744cbdd7341",
                                "text": "I can't help thinking that, had he lived to see the electronic cricket sensor, the inventor of the opeidoscope probably would have approved."
                            }
                        ]
                    }
                ],
