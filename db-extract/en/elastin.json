                ],
                "senses": [
                    {
                        "sense_id": "7387f357-9e22-387b-b561-0e4d036a1cf3",
                        "entry_id": "dcb8e699-5ab6-356c-9510-a7b2e6a3fec7",
                        "glosses": [
                            "A protein, similar to collagen, found in connective tissue, that has elastic properties."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b38ecbe8-4771-446b-8776-6d377aba892c",
                                "sense_id": "7387f357-9e22-387b-b561-0e4d036a1cf3",
                                "text": "Our stomachs produce an enzyme specifically designed to break down elastin, a type of protein found in meat and nowhere else."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7799d73-830b-4c2a-a1ee-a8583d3d0949",
                        "source_entry_id": "dcb8e699-5ab6-356c-9510-a7b2e6a3fec7",
                        "source_sense_id": "7387f357-9e22-387b-b561-0e4d036a1cf3",
                        "source_sense_description": "protein with elastic properties, similar to collagen",
                        "target_lang_word": "élastine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "élastine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0a6d3baa-68a1-386e-8513-1558db12ce0b",
                                        "entry_id": "1d4294d6-7306-337a-ac3d-183f716821fe",
                                        "glosses": [
                                            "Protéine de la famille des protéines fibreuses de type structural, qui possède des propriétés élastiques et dont la synthèse diminue avec l’âge pour se trouver remplacée par du collagène inextensible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cbfc7cc-f580-47c3-bc24-0466d8c70055",
                                                "sense_id": "0a6d3baa-68a1-386e-8513-1558db12ce0b",
                                                "text": "L'augmentation du pontage des collagènes chez le sujet âgé, la fragmentation de l'élastine au cours des mitoses font progressivement perdre aux tissus leur fermeté et leur souplesse."
                                            },
                                            {
                                                "example_id": "a6c7ed4e-89ef-4cc4-971b-bd2eb1ed37e4",
                                                "sense_id": "0a6d3baa-68a1-386e-8513-1558db12ce0b",
                                                "text": "L’élastine est très résistante vis-à-vis des enzymes."
                                            },
                                            {
                                                "example_id": "bc0bd891-748a-460c-b6f4-f576086898ca",
                                                "sense_id": "0a6d3baa-68a1-386e-8513-1558db12ce0b",
                                                "text": "La matrice interstitielle contient en particulier les fibronectines, la vitronectine, la thrombospondine, l’élastine et les collagènes I, III et V."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
