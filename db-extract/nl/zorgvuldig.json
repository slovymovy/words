            {
                "entry_id": "f9fca0b9-28f6-35f9-a809-d64aec0b2418",
                "word": "zorgvuldig",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a4beb165-edb5-3043-8708-b56f5ab84675",
                        "entry_id": "f9fca0b9-28f6-35f9-a809-d64aec0b2418",
                        "glosses": [
                            "met zorg voor alle details"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb2c9d6f-3fb0-4551-897d-768d03847ff1",
                                "sense_id": "a4beb165-edb5-3043-8708-b56f5ab84675",
                                "text": "Dat moet u zorgvuldig aanpakken."
                            },
                            {
                                "example_id": "8591ae5c-8beb-44a4-95be-7dc514784150",
                                "sense_id": "a4beb165-edb5-3043-8708-b56f5ab84675",
                                "text": "David Hockney zet zijn tanden in een Double Smash Burger met gekarameliseerde uien en gerookte cheddar. Zijn twee gehoorapparaten heeft hij naast zijn bord gelegd, op zijn schoot ligt een zorgvuldig gevouwen servet."
                            },
                            {
                                "example_id": "8aeb20a3-d5df-4eb9-9ad0-88e0d1be20bf",
                                "sense_id": "a4beb165-edb5-3043-8708-b56f5ab84675",
                                "text": "Rond elf uur hield ik het niet meer en nam één hap van mijn Snicker. Ik kauwde zorgvuldig om optimaal te genieten van de nougat, pinda’s, karamel en melkchocolade."
                            },
                            {
                                "example_id": "55ac0bef-8293-41ee-b350-660b080ef741",
                                "sense_id": "a4beb165-edb5-3043-8708-b56f5ab84675",
                                "text": "De onbewerkte vloerplanken in zijn zolderkamer met uitzicht op de rivier waren zorgvuldig geboend met groene zeep."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25a3cd94-a197-49e1-8e8a-8cc670f07e44",
                        "source_entry_id": "f9fca0b9-28f6-35f9-a809-d64aec0b2418",
                        "source_sense_id": "a4beb165-edb5-3043-8708-b56f5ab84675",
                        "source_sense_description": "met zorg voor alle details",
                        "target_lang_word": "careful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "careful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "948a181f-5d71-3030-904d-f3ff638bc0eb",
                                        "entry_id": "7b71d07a-9bf3-33c5-ad50-522eed259186",
                                        "glosses": [
                                            "Taking care; attentive to potential danger, error or harm; cautious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc0e0307-fe95-4e6e-9784-2c28720c19cc",
                                                "sense_id": "948a181f-5d71-3030-904d-f3ff638bc0eb",
                                                "text": "He was a slow and careful driver."
                                            },
                                            {
                                                "example_id": "5ee3284a-d576-41b6-9b0d-2e2888cb51b7",
                                                "sense_id": "948a181f-5d71-3030-904d-f3ff638bc0eb",
                                                "text": "Be very careful while trekking through the jungle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4053de15-ad97-3153-838c-d8cce94f09fd",
                                        "entry_id": "7b71d07a-9bf3-33c5-ad50-522eed259186",
                                        "glosses": [
                                            "Conscientious and painstaking; meticulous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bd90f9a-e845-4124-939b-646e2e278746",
                                                "sense_id": "4053de15-ad97-3153-838c-d8cce94f09fd",
                                                "text": "They made a careful search of the crime scene."
                                            },
                                            {
                                                "example_id": "d4eaaa64-c486-4df0-b413-c449c3ba1776",
                                                "sense_id": "4053de15-ad97-3153-838c-d8cce94f09fd",
                                                "text": "At the same time, we were cognisant that careful scholars should never solely rely on their own impressionistic observations, and, that our own impressions were inexact and not capable of being quantified."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c3f5b5c-0245-3a6b-8a41-221f1512b687",
                                        "entry_id": "7b71d07a-9bf3-33c5-ad50-522eed259186",
                                        "glosses": [
                                            "Full of care or grief; sorrowful, sad."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a34876b7-9720-35d3-80a9-886b140dbba3",
                                        "entry_id": "7b71d07a-9bf3-33c5-ad50-522eed259186",
                                        "glosses": [
                                            "Full of cares or anxiety; worried, troubled."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2baf3193-1792-4787-bbc4-e9cc9ece0e39",
                                                "sense_id": "a34876b7-9720-35d3-80a9-886b140dbba3",
                                                "text": "Where through long watch, and late daies weary toile, / She soundly slept, and carefull thoughts did quite assoile."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
