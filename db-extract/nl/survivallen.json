                "senses": [
                    {
                        "sense_id": "21d74f2b-de3e-31e5-a133-5b61b1596dfe",
                        "entry_id": "789d6a89-af67-3d18-a98e-a6cf543bfc3c",
                        "glosses": [
                            "meedoen aan tochten waarbij je je in een onherbergzame omgeving met een minimum aan hulpmiddelen moet zien te redden"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "ee3c0906-a70d-410c-a721-1f3aff6d1949",
                                "sense_id": "21d74f2b-de3e-31e5-a133-5b61b1596dfe",
                                "text": "Survivallen is terug: je hoeft de tv maar aan te zetten of er is wel een programma bezig waarin bekende of minder bekende Nederlanders zichzelf moeten redden in een eenzaam bos."
                            },
                            {
                                "example_id": "0cdb6368-6beb-4102-8b49-0063d498bbc6",
                                "sense_id": "21d74f2b-de3e-31e5-a133-5b61b1596dfe",
                                "text": "‘Ga jij maar lekker stoer doen”, zegt de dokter. Ik hoest, het sneeuwt een beetje en ik heb de krant beloofd te ‘survivallen’."
                            }
                        ]
                    }
