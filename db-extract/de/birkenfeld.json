                ],
                "senses": [
                    {
                        "sense_id": "484f30cc-2ea7-3220-aa42-8b78dd615c61",
                        "entry_id": "447dde0e-f228-3518-8d13-0e7ca6cc6c7f",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f437f1b-20ad-4c43-8089-37db7682536c",
                                "sense_id": "484f30cc-2ea7-3220-aa42-8b78dd615c61",
                                "text": "Frau Birkenfeld ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "aab0ef15-1b3a-4a68-80b3-7d8ea2dabff4",
                                "sense_id": "484f30cc-2ea7-3220-aa42-8b78dd615c61",
                                "text": "Herr Birkenfeld wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ac1300a9-cf0a-4e73-af61-d7401f2f8079",
                                "sense_id": "484f30cc-2ea7-3220-aa42-8b78dd615c61",
                                "text": "Die Birkenfelds fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "981ccd5c-66f1-4e01-9689-09c5d5772008",
                                "sense_id": "484f30cc-2ea7-3220-aa42-8b78dd615c61",
                                "text": "Der Birkenfeld trägt nie die Schals, die die Birkenfeld ihm strickt."
                            },
                            {
                                "example_id": "e116d0aa-5d0a-4137-8484-af75acbca1fd",
                                "sense_id": "484f30cc-2ea7-3220-aa42-8b78dd615c61",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Birkenfeld kommt, geht der Herr Birkenfeld.“"
                            },
                            {
                                "example_id": "ce608a0e-c957-437c-8e0f-cfbdd1be09e4",
                                "sense_id": "484f30cc-2ea7-3220-aa42-8b78dd615c61",
                                "text": "Birkenfeld kommt und geht."
                            },
                            {
                                "example_id": "41678328-165d-44f3-95fc-e430570b7b98",
                                "sense_id": "484f30cc-2ea7-3220-aa42-8b78dd615c61",
                                "text": "Birkenfelds kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
