                    },
                    {
                        "form_id": "fb0d524b-94f0-458c-bbdc-353f021d883b",
                        "entry_id": "b07a5207-5aba-3fc3-a13b-8d8dde0efbdc",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Aalfang"
                    },
                    {
                        "form_id": "eea9292f-0d77-4215-8bde-5da760d9a495",
                        "entry_id": "b07a5207-5aba-3fc3-a13b-8d8dde0efbdc",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Aalfänge"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "92a650f9-001e-35de-94c0-0bf29547b4ff",
                        "entry_id": "b07a5207-5aba-3fc3-a13b-8d8dde0efbdc",
                        "glosses": [
                            "das Fangen von Aalen"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "b62aa5f9-27d7-49cd-9b08-e438ad24b660",
                                "sense_id": "92a650f9-001e-35de-94c0-0bf29547b4ff",
                                "text": "Der Aalfang nimmt von Jahr zu Jahr ab."
                            },
                            {
                                "example_id": "210a1106-d86c-46a2-bddd-82e7448f0e2f",
                                "sense_id": "92a650f9-001e-35de-94c0-0bf29547b4ff",
                                "text": "Man kann Aalfang nicht in jedem Gewässer betreiben."
                            },
                            {
                                "example_id": "3009e033-4f7d-4e1c-aae6-988fc357ee29",
                                "sense_id": "92a650f9-001e-35de-94c0-0bf29547b4ff",
                                "text": "„Seit Jahrhunderten sind viele Fischer in Italien an den Mündungen der Flüsse mit dem Aalfang beschäftigt, wodurch alljährlich grosse Massen von Aalen, welche im Begriffe waren, in das Meer hinauszuwandern, in den Handel gebracht werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0e1d978d-e8d1-339f-8e54-70b2345f33ac",
                        "entry_id": "b07a5207-5aba-3fc3-a13b-8d8dde0efbdc",
                        "glosses": [
                            "Einrichtung zum Fangen von Aalen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d4ad30e-239a-4cce-b3de-94b0599f70cb",
                                "sense_id": "0e1d978d-e8d1-339f-8e54-70b2345f33ac",
                                "text": "„Der Aalfang, auch Lattenfischerei genannt, ist ein aus Latten gefertigter Kasten, in welchen das Wasser eines Flusses geleitet wird, und der mit so weiten schlitzförmigen Oeffnungen zwischen den Latten versehen ist, daß das eingeleitete Wasser abfließt, die Fische aber zurückbleiben.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
