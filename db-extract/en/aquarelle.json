                    }
                ],
                "senses": [
                    {
                        "sense_id": "623e2539-6903-3504-8e10-55005dc9c0dd",
                        "entry_id": "149b7f24-596c-3392-b29a-09f64544d97b",
                        "glosses": [
                            "A watercolour (painting)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dbc2a2a-84e8-430f-9cc2-f9cbce920cb4",
                                "sense_id": "623e2539-6903-3504-8e10-55005dc9c0dd",
                                "text": "He looked out between whiles at the pleasant English land, an April aquarelle washed in with wondrous breadth."
                            },
                            {
                                "example_id": "876af52b-41b9-4ff5-a9ca-5fb6995b32f2",
                                "sense_id": "623e2539-6903-3504-8e10-55005dc9c0dd",
                                "text": "He wandered about the house, looking into several rooms, and only partially at rest when he discovered Caroline in one, engaged upon some of her aquarelle sketches."
                            }
                        ]
                    },
                    {
                        "sense_id": "1924c54e-4cc4-3fc6-84b1-e707b730c93c",
                        "entry_id": "149b7f24-596c-3392-b29a-09f64544d97b",
                        "glosses": [
                            "A printed picture coloured by the application of watercolour through stencils, using a different stencil for each colour."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "53f77448-6f22-4ba3-b9fb-6b92c3331dad",
                        "source_entry_id": "149b7f24-596c-3392-b29a-09f64544d97b",
                        "source_sense_description": "painting — see also watercolour",
                        "target_lang_word": "aquarelle",
