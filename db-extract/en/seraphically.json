                        "glosses": [
                            "in a seraphic manner; with angelic purity."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "907d0d3a-aa36-42b3-b8dd-966388d1aa1e",
                                "sense_id": "842d73b5-8452-3fdf-95cf-0779132ea6fe",
                                "text": "“You’re an angel, by Jove, you’re an angel!” said Foker, at which Blanche looked seraphically up to the chandelier."
                            },
                            {
                                "example_id": "7171b791-1465-46cc-9cf9-d029acb8d2c2",
                                "sense_id": "842d73b5-8452-3fdf-95cf-0779132ea6fe",
                                "text": "They smiled at Kate seraphically, and she saw that they wanted to be alone, and that it made little difference to them whether they were sitting in a warm room or walking the windy streets."
                            },
                            {
                                "example_id": "d44305b2-83f6-4872-8b4d-3e5254db7828",
                                "sense_id": "842d73b5-8452-3fdf-95cf-0779132ea6fe",
                                "text": "She was all in white like a lily, and otherwise carried out the lily tradition of belonging obviously to the non-toiling-and-spinning species, justifying the arrangement by looking seraphically lovely in the fruits of the loom and labor of the rest of the world."
                            }
                        ]
                    }
