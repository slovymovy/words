                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "affliction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La nouvelle de cette disparition brutale <w>désole</w> l'ensemble des habitants du village."
                        },
                        {
                            "text": "Tant de misère visible dans les rues de la ville le <w>désole</w> profondément."
