                    "examples": [
                        {
                            "text": "We walked across the river where the water was <flew>.",
                            "target_lang_translations": {
                                "ru": "Мы перешли реку там, где вода была <w>мелкой</w>.",
                                "zh": "我们走过河水较<w>浅</w>的地方。"
                            }
                        },
                        {
                            "text": "He served the food on a large, <flew> dish.",
                            "target_lang_translations": {
                                "ru": "Он подал еду на большом <w>плоском</w> блюде.",
                                "zh": "他用一个又大又<w>平</w>的盘子盛放食物。"
                            }
                        }
                    ],
