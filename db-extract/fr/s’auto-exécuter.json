                "senses": [
                    {
                        "sense_id": "7b1c5f92-f24a-3cfe-883d-6e322688187c",
                        "entry_id": "f711f753-7137-3cda-a44b-f1b834d1ec31",
                        "glosses": [
                            "S’exécuter de soi-même, sans intervention extérieure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "855f40a8-ad72-492d-9455-4d059d61a2a6",
                                "sense_id": "7b1c5f92-f24a-3cfe-883d-6e322688187c",
                                "text": "En ajustant les parts de marché tout au long du cycle (et donc en éliminant la possibilité de faillite pour les rivaux inefficaces), ce producteur peut agrandir l'ensemble des équilibres de collusion qui s’auto-exécutent."
                            },
                            {
                                "example_id": "e9f3482d-bdce-4c11-addd-0eafb3f49a6a",
                                "sense_id": "7b1c5f92-f24a-3cfe-883d-6e322688187c",
                                "text": "Cette capacité du langage à s’auto-exécuter est critique, et permet d’avoir des types de réponse JavaScript ou plus spécifiquement JSON dans un contexte Ajax, par exemple."
                            }
                        ]
                    }
