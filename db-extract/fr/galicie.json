                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eca68670-5734-4d68-8a22-2a76e3e97db1",
                                                "sense_id": "6cce70dd-bf78-3d12-ab83-e9550157ff18",
                                                "text": "No entreguerras, a Galícia foi incorporada à Polônia, uma situação que os ucranianos da Galícia consideraram frustrante."
                                            }
                                        ]
                                    }
                                ]
                            }
