                                        "sense_id": "af3b7f6b-70b5-37eb-be15-cb627d10cfc3",
                                        "entry_id": "34f8f252-e962-3360-a24e-6bf64946393a",
                                        "glosses": [
                                            "Relatif à La Rivière, commune française située dans le département de l’Isère."
