        "nl-extract.jsonl": [
            {
                "entry_id": "ba2621c6-0ffc-3de7-9001-aa1a2bce87aa",
                "word": "leedwezen",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "da3ffbfa-6d07-331a-9cad-042d6ba909ce",
                        "entry_id": "ba2621c6-0ffc-3de7-9001-aa1a2bce87aa",
                        "glosses": [
                            "verdriet, spijt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26815857-6c9b-41f5-ace5-8616856868b2",
                                "sense_id": "da3ffbfa-6d07-331a-9cad-042d6ba909ce",
                                "text": "Het is met groot leedwezen dat wij kennisnamen van zijn overlijden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b220efd-a48b-404b-be51-a273fec7f789",
                        "source_entry_id": "ba2621c6-0ffc-3de7-9001-aa1a2bce87aa",
                        "source_sense_id": "da3ffbfa-6d07-331a-9cad-042d6ba909ce",
                        "target_lang_word": "regret",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "regret",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4af1c39d-2f64-3aed-9928-967a2a36c043",
                                        "entry_id": "3ff4e15b-4d2e-3235-b1dc-cd663656dc64",
                                        "glosses": [
                                            "To feel sorry about (a thing that has or has not happened), afterthink: to wish that a thing had not happened, that something else had happened instead."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69f2a50a-b40f-4627-8f2a-7d20e2883e7c",
                                                "sense_id": "4af1c39d-2f64-3aed-9928-967a2a36c043",
                                                "text": "He regretted his words."
                                            },
                                            {
                                                "example_id": "46d67218-f171-46d4-84dc-3aad4f293543",
                                                "sense_id": "4af1c39d-2f64-3aed-9928-967a2a36c043",
                                                "text": "Judge Short had gone to town, and Farrar was off for a three days' cruise up the lake. I was bitterly regretting I had not gone with him when the distant notes of a coach horn reached my ear, and I descried a four-in-hand winding its way up the inn road from the direction of Mohair."
                                            },
                                            {
                                                "example_id": "2c79f59d-faf6-43bc-9be8-0f88011d66c7",
                                                "sense_id": "4af1c39d-2f64-3aed-9928-967a2a36c043",
                                                "text": "Dear humanity, we regret bein' alien bastards, we regret comin' to Earth, and we most definitely regret the Corps just blew up our raggedy-ass fleet!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34eaace4-6501-3b7d-bdbb-3af1741072ee",
                                        "entry_id": "3ff4e15b-4d2e-3235-b1dc-cd663656dc64",
                                        "glosses": [
                                            "To feel sorry about (any thing)."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a080b354-ce90-4982-a716-ca5bb83aa692",
                                                "sense_id": "34eaace4-6501-3b7d-bdbb-3af1741072ee",
                                                "text": "I regret that I have to do this, but I don't have a choice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88b41109-cfea-3ea2-bb6e-d158c85f31f7",
                                        "entry_id": "3ff4e15b-4d2e-3235-b1dc-cd663656dc64",
                                        "glosses": [
                                            "To miss; to feel the loss or absence of; to mourn."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77850bef-9c83-4e03-b193-686c32a04bbc",
                                                "sense_id": "88b41109-cfea-3ea2-bb6e-d158c85f31f7",
                                                "text": "He more than ever regretted his home, and with increased desire longed to see his family."
                                            },
                                            {
                                                "example_id": "cd122cbc-f9e1-41db-8be4-10ceef4d585a",
                                                "sense_id": "88b41109-cfea-3ea2-bb6e-d158c85f31f7",
                                                "text": "This [the Cage] was but one of Cluny’s hiding-places; he had caves, besides, and underground chambers in several parts of his country; and following the reports of his scouts, he moved from one to another as the soldiers drew near or moved away. By this manner of living, and thanks to the affection of his clan, he had not only stayed all this time in safety, while so many others had fled or been taken and slain: but stayed four or five years longer, and only went to France at last by the express command of his master. There he soon died; and it is strange to reflect that he may have regretted his Cage upon Ben Alder."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "regret",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16fa3ebc-90b4-33ca-b502-d7117257c7b7",
                                        "entry_id": "3c29518a-d93f-3785-90cf-4f473b933be6",
                                        "glosses": [
                                            "Emotional pain on account of something done or experienced in the past, with a wish that it had been different; a looking back with dissatisfaction or with longing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d55623e8-27b6-4939-90ec-23020db5e5bc",
                                                "sense_id": "16fa3ebc-90b4-33ca-b502-d7117257c7b7",
                                                "text": "What man does not remember with regret the first time he read Robinson Crusoe?"
                                            },
                                            {
                                                "example_id": "fc15dd92-8950-4bfe-a51d-4184b2f4e086",
                                                "sense_id": "16fa3ebc-90b4-33ca-b502-d7117257c7b7",
                                                "text": "Never any prince expressed a more lively regret for the loss of a servant."
                                            },
                                            {
                                                "example_id": "a45b700d-7f05-45d0-8048-5154f8b7b9ce",
                                                "sense_id": "16fa3ebc-90b4-33ca-b502-d7117257c7b7",
                                                "text": "From its peaceful bosom [the grave] spring none but fond regrets and tender recollections."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab8089d6-5f24-341c-810f-6ca23c3cd90b",
                                        "entry_id": "3c29518a-d93f-3785-90cf-4f473b933be6",
                                        "glosses": [
                                            "Dislike; aversion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e69b56cd-bc89-4014-aa31-04f90e242756",
                                                "sense_id": "ab8089d6-5f24-341c-810f-6ca23c3cd90b",
                                                "text": "Is it a vertue to have some ineffective regrets to damnation, and such a Vertue too, as shall serve to ballance all our vices?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7454462e-73ce-370c-ab00-2f60dcab2092",
                                        "entry_id": "3c29518a-d93f-3785-90cf-4f473b933be6",
                                        "glosses": [
                                            "The amount of avoidable loss that results from choosing the wrong action."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "293b4869-6c2b-41f1-89a1-11dccb60ced1",
                                                "sense_id": "7454462e-73ce-370c-ab00-2f60dcab2092",
                                                "text": "Under squared errorloss we show that there exists unique minimax regret solution for the problem of selecting the threshold."
                                            },
                                            {
                                                "example_id": "b9348ffe-4b67-4bb9-9775-7c94a65b99d2",
                                                "sense_id": "7454462e-73ce-370c-ab00-2f60dcab2092",
                                                "text": "Each loss then represents this unavoidable loss plus a regret (loss due to ignorance of Ө). Subtracting these unavoidable losses, we obtain the regret table, Table 1.7, and the average regret table, Table 1.8."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59138133-d289-38dd-9bf9-42e9610fddbe",
                                        "entry_id": "3c29518a-d93f-3785-90cf-4f473b933be6",
                                        "glosses": [
                                            "A person invited to an event who was unable to attend, but notified the organizer of this beforehand; a nonattendee."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
