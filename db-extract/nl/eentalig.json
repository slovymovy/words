                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d4bb9c04-b294-4b77-a6ec-9d262fa39051",
                        "source_entry_id": "d17b78ce-0e93-3713-a504-d761fe1df922",
                        "source_sense_id": "1fcfd1bf-093a-3307-97b3-2437b01728ba",
                        "target_lang_word": "monolingual",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monolingual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8eeeb279-bce2-3863-805f-30ffe9bff176",
                                        "entry_id": "f70977f5-42a0-3884-9c71-4d4f49dadec0",
                                        "glosses": [
                                            "Knowing or using a single language; written or spoken in a single language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5845e803-f3fb-485b-8aef-cc5c091a28b5",
                                                "sense_id": "8eeeb279-bce2-3863-805f-30ffe9bff176",
                                                "text": "Thus approximately 98% of signs contained English, and 93.5% of signs were wholly in English. As far as linguistic landscapes go, this is a case of extreme monolingual dominance in a multilingual setting."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "monolingual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46f45ceb-0efe-3718-83ef-8bdc55ce1615",
                                        "entry_id": "ba1c7451-34bf-3e21-badb-a0cbe3b769a8",
                                        "glosses": [
                                            "a person who knows or uses only a single language; a monoglot"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f94a6762-87b6-4b0b-9b94-f6bf91863a68",
                        "source_entry_id": "d17b78ce-0e93-3713-a504-d761fe1df922",
                        "source_sense_id": "1fcfd1bf-093a-3307-97b3-2437b01728ba",
                        "target_lang_word": "monolingue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monolingue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "562ad760-13d5-323b-927f-53d412239988",
                                        "entry_id": "f5057a9e-ef31-3a1f-bc5d-0dcfe72e003f",
                                        "glosses": [
                                            "Qui n’utilise qu’une seule langue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eae819e3-f09f-4f30-939e-ea6f267097e0",
                                                "sense_id": "562ad760-13d5-323b-927f-53d412239988",
                                                "text": "Dans la même étude, on présentait aussi à des nourrissons monolingues et bilingues des phrases de leur langue maternelle (soit l’espagnol, soit le catalan) et des phrases en anglais (langue totalement inconnue pour eux). Alors qu’on observait chez les monolingues le tableau de résultats attendu, avec des temps d’orientation plus rapides pour la langue familière que pour la langue non familière, on observait chez les bilingues le tableau exactement inverse : ils s’orientaient plus vite vers la langue non familière que vers la langue familière."
                                            },
                                            {
                                                "example_id": "3ceba266-8907-4cfc-ae41-a7fa6f7d939e",
                                                "sense_id": "562ad760-13d5-323b-927f-53d412239988",
                                                "text": "Né dans l’est du Tennessee, le Cherokee Sequoyah (v. 1770-1843) est monolingue et illettré."
                                            },
                                            {
                                                "example_id": "0633b93b-3eda-4a98-9e32-14f95323c636",
                                                "sense_id": "562ad760-13d5-323b-927f-53d412239988",
                                                "text": "Quant aux dictionnaires engrangeant les mots de la langue française pour mieux les traduire ou les faire comprendre à leurs contemporains, dictionnaires de leur époque, on distinguera d'un côté les dictionnaires bilingues, français-latin par exemple, et de l'autre les dictionnaires monolingues où les mots français sont suivis de leur définition en francais."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "monolingue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f107968e-d562-354b-905f-d10d2811a99c",
                                        "entry_id": "982d2685-087d-3147-8595-41bf1f54a568",
                                        "glosses": [
                                            "Substantif : personne qui n’utilise qu’une seule langue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db2729d5-de73-40d7-84e5-1bfa32ec8e1c",
                                                "sense_id": "f107968e-d562-354b-905f-d10d2811a99c",
                                                "text": "L’enfant avec des difficultés langagières apprendra certes ses deux langues plus lentement qu’un monolingue, et le niveau atteint dans les deux langues sera limité."
                                            },
                                            {
                                                "example_id": "b1727b31-af36-49d0-a772-1c9fbdeb63c6",
                                                "sense_id": "f107968e-d562-354b-905f-d10d2811a99c",
                                                "text": "Dans la même étude, on présentait aussi à des nourrissons monolingues et bilingues des phrases de leur langue maternelle (soit l’espagnol, soit le catalan) et des phrases en anglais (langue totalement inconnue pour eux). Alors qu’on observait chez les monolingues le tableau de résultats attendu, avec des temps d’orientation plus rapides pour la langue familière que pour la langue non familière, on observait chez les bilingues le tableau exactement inverse : ils s’orientaient plus vite vers la langue non familière que vers la langue familière."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
