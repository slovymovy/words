    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "fe60c93f-243b-3496-b3cd-a8f6d81915c1",
                "word": "nous",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bb23b66a-4634-39de-b873-f3863f3fcce4",
                        "entry_id": "fe60c93f-243b-3496-b3cd-a8f6d81915c1",
                        "glosses": [
                            "The mind or intellect, reason, both rational and emotional"
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f580b5bc-d1e9-4795-96a2-466562962d03",
                                "sense_id": "bb23b66a-4634-39de-b873-f3863f3fcce4",
                                "text": "I feel the will to roam, to learn\nBy test, experience, nous,\nThat fire is hot and ocean deep,\nAnd wolves carnivorous."
                            }
                        ]
                    },
                    {
                        "sense_id": "8a82ab4c-4d0e-3583-90e0-d0b5e994ca1a",
                        "entry_id": "fe60c93f-243b-3496-b3cd-a8f6d81915c1",
                        "glosses": [
                            "In Neoplatonism, the divine reason, regarded as first divine emanation."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "cd17aa48-753e-34ca-abd7-197a525217eb",
                        "entry_id": "fe60c93f-243b-3496-b3cd-a8f6d81915c1",
                        "glosses": [
                            "Common sense; practical intelligence."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "30740751-7968-4ba9-b9fc-a49caa5b771e",
                                "sense_id": "cd17aa48-753e-34ca-abd7-197a525217eb",
                                "text": "There is nothing original in absent-mindedness. True originality lies elsewhere. Really, the lower classes have no nous."
                            },
                            {
                                "example_id": "71e3e6a7-da2a-406e-bcd1-f25fcaecff86",
                                "sense_id": "cd17aa48-753e-34ca-abd7-197a525217eb",
                                "text": "The emerging African elite felt little affection for the wahindi, seen as tight-fisted, snooty and brazenly colour-conscious, but its members knew they needed its business nous."
                            }
                        ]
                    }
                ],
                "translations": [
