                        "glosses": [
                            "Plante non identifiée, issue de la Cyrénaïque, produisant une gomme résine, le laserpicium ou laser, très estimé des Anciens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43743120-84ba-4f2b-a5e2-8de44d591ccd",
                                "sense_id": "be7758bd-f277-3efd-b92d-e73f4b7ed9f1",
                                "text": "La Cyrénaïque produisait le silphium, plante très recherchée (ferula tingitana), au goût anisé, objet d’un intense commerce."
                            },
                            {
                                "example_id": "0bf326ad-c248-4b38-a3ba-bad8b55752ca",
                                "sense_id": "be7758bd-f277-3efd-b92d-e73f4b7ed9f1",
                                "text": "Assa foetida est la résine du silphium, d’une odeur désagréable, employée en médecine comme un puissant antispasmodique."
                            }
