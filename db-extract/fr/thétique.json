                ],
                "senses": [
                    {
                        "sense_id": "f0c1a0de-9653-35df-b915-17db308e84ba",
                        "entry_id": "f75ae265-e62b-39e4-92fc-5eaf9484a71e",
                        "glosses": [
                            "Qui se rapporte à une thèse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6c0011d-7333-4843-8a96-c686ef8af177",
                                "sense_id": "f0c1a0de-9653-35df-b915-17db308e84ba",
                                "text": "Chez Fichte, le terme thétique qualifie le jugement par lequel une chose est seulement posée comme identique à elle-même."
                            }
                        ]
                    },
                    {
                        "sense_id": "edf1d9e0-f95f-34e3-a813-a5671a8208f0",
                        "entry_id": "f75ae265-e62b-39e4-92fc-5eaf9484a71e",
                        "glosses": [
                            "Existentiel."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "6df63bf5-a739-4977-a31c-b5f72ceed454",
                                "sense_id": "edf1d9e0-f95f-34e3-a813-a5671a8208f0",
                                "text": "Conscience thétique ; celle qui pose son être comme existant."
                            },
                            {
                                "example_id": "b61f1371-db52-47cb-b5c6-f0348e204081",
                                "sense_id": "edf1d9e0-f95f-34e3-a813-a5671a8208f0",
                                "text": "Ce n’était pas paresse, mais bien plutôt un choix originel, un acte de conscience non thétique qui engageait mon existence entière."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa86a42a-f03b-47e1-87a3-bf38cdf097d9",
                        "source_entry_id": "f75ae265-e62b-39e4-92fc-5eaf9484a71e",
                        "target_lang_word": "thetisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thetisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f7b846f7-4b54-3428-a631-236b83daa7f3",
                                        "entry_id": "6eb719d1-f63f-3fa3-ab04-2509d00b2b90",
                                        "glosses": [
                                            "eine zu beweisende These vorstellend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a14f68c-44b0-4e5a-ba43-41bb029ee059",
                                                "sense_id": "f7b846f7-4b54-3428-a631-236b83daa7f3",
                                                "text": "\"Was hier etwas thetisch klingt, entfaltet John Berger in einem zwanzigseitigen […] Fest der Worte.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "840ca31b-3131-3f70-a901-4cde0eaf1d98",
                                        "entry_id": "6eb719d1-f63f-3fa3-ab04-2509d00b2b90",
                                        "glosses": [
                                            "eine bloße Behauptung aufstellend, die nicht belegt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67e55f6f-da46-4c23-92f1-b6154cb6952d",
                                                "sense_id": "840ca31b-3131-3f70-a901-4cde0eaf1d98",
                                                "text": "\"Seine Revolution-Theorie bleibt, wie ein Freund bemerkt, \"thetisch\", stützt sich also auf bloße Behauptungen.\""
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1b7b77ad-681c-3175-9b48-f8f2468b59ca",
                                        "entry_id": "6eb719d1-f63f-3fa3-ab04-2509d00b2b90",
                                        "glosses": [
                                            "als Text die Eigenschaft habend (ein thetisches Urteil auszudrücken) auf die Frage: was ist? was geschieht? zu antworten"
                                        ],
                                        "tags": [
                                            "Logik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d9040e4-2793-4284-aafb-50294336f55b",
                                                "sense_id": "1b7b77ad-681c-3175-9b48-f8f2468b59ca",
                                                "text": "„„Im Grunde kann man sagen, daß alle thetischen Aussagen bis auf die rein daseinssetzenden Äußerungen (...) eine Antwort auf eine explizite oder implizite Frage „Was ist (los)?“, „Was geschieht?“, „Was ist geschehen?“ darstellen“.“"
                                            },
                                            {
                                                "example_id": "0fb378ab-70d9-4ce7-8bfb-a13177fc848c",
                                                "sense_id": "1b7b77ad-681c-3175-9b48-f8f2468b59ca",
                                                "text": "»Es regnet« ist ebenso wie »ich bin« eine thetische Äußerung."
                                            },
                                            {
                                                "example_id": "ce4c1fe7-8c0f-426f-8a23-c719b17b2122",
                                                "sense_id": "1b7b77ad-681c-3175-9b48-f8f2468b59ca",
                                                "text": "„Thetische Sätze gelten als Paradebeispiele einer topikfreien Konstruktion.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
