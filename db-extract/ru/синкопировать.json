                    },
                    {
                        "translation_id": "765348b2-7259-4948-bb4a-1736ba17a8a0",
                        "source_entry_id": "a706a262-f191-31da-b5aa-3455a496816c",
                        "source_sense_id": "da490fab-4cb0-3c40-8057-58d2ceff16cd",
                        "target_lang_word": "synkopieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "synkopieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dca1cabc-7ab7-32b4-9d07-31cd44f2cfdc",
                                        "entry_id": "8ddfdb2a-a28a-3ef4-a92e-e11fc51748dd",
                                        "glosses": [
                                            "durch die Betonung eines unbetonten Taktwertes (Synkope) im Rhythmus verschieben"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e3900c5-5c97-4cad-a0de-73830c8022f5",
                                                "sense_id": "dca1cabc-7ab7-32b4-9d07-31cd44f2cfdc",
                                                "text": "Seine ersten Kompositionen waren nur mäßig synkopiert und wiesen nur gelegentlich einen Rhythmuswechsel auf."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "58cab08d-0363-34a9-aa50-6fee9984af7d",
                                        "entry_id": "8ddfdb2a-a28a-3ef4-a92e-e11fc51748dd",
                                        "glosses": [
                                            "einen zwischen zwei Konsonanten befindlichen unbetonten Vokal im Wortinneren ausfallen lassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c03e3686-67e4-4fb6-8e9a-cfc2ac1940a2",
                                                "sense_id": "58cab08d-0363-34a9-aa50-6fee9984af7d",
                                                "text": "„Adjektiva mit langer Stammsilbe auf -ar, -al, -an synkopieren das a häufig in den flektierten Formen, besonders in den älteren Quellen […].“"
                                            },
                                            {
                                                "example_id": "4d394639-9aa4-4b7f-b376-5d990c7de66c",
                                                "sense_id": "58cab08d-0363-34a9-aa50-6fee9984af7d",
                                                "text": "„Wenn man das Schriftbild der Handschrift beibehielte, würde es ungeübte Leser verleiten, oft Silben zu synkopieren, wo tatsächlich [e] gesprochen gehört.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "09885d92-54a2-3c99-b1b8-a339ce22c180",
                                        "entry_id": "8ddfdb2a-a28a-3ef4-a92e-e11fc51748dd",
                                        "glosses": [
                                            "kurz bewusstlos werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e48dc9a-71f4-4a0b-ba6f-002b80ecfa99",
                                                "sense_id": "09885d92-54a2-3c99-b1b8-a339ce22c180",
                                                "text": "„Dieses pathophysiologische Prinzip lässt verstehen, dass auch Hypertoniepatienten neurokardiogen synkopieren können.“"
                                            },
                                            {
                                                "example_id": "852d014f-4514-4ed0-88f8-4cbc74bceb00",
                                                "sense_id": "09885d92-54a2-3c99-b1b8-a339ce22c180",
                                                "text": "„Auch Patienten ohne strukturelle Herzerkrankung, die öfters synkopieren, sollten einen Arzt aufsuchen.“"
                                            },
                                            {
                                                "example_id": "a649ce4e-5b38-40e1-8336-fd268b2422cf",
                                                "sense_id": "09885d92-54a2-3c99-b1b8-a339ce22c180",
                                                "text": "„Für Notärzte sind Fälle von Hitzeerschöpfung im Hochsommer alltäglich, genauso wie der Sonnenstich und der lebensgefährliche Hitzschlag – und manche Menschen synkopieren, kippen also einfach um.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "cdc5c760-fb58-3c16-8aa4-956143b64b4a",
                                        "entry_id": "8ddfdb2a-a28a-3ef4-a92e-e11fc51748dd",
                                        "glosses": [
                                            "eine Senkung im Vers, also eine unbetonte Silbe, ausfallen lassen"
                                        ],
                                        "tags": [
                                            "Verslehre"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
