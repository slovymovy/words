                ],
                "senses": [
                    {
                        "sense_id": "d8109595-4296-3dd8-b502-3b641a20a08b",
                        "entry_id": "8e7cd18b-ea43-3ad3-b38f-24c836da3f03",
                        "glosses": [
                            "während der Abendstunden stattfindende Vorstellung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec2c641a-1ac1-4f78-ba4f-c1c8cd9bf956",
                                "sense_id": "d8109595-4296-3dd8-b502-3b641a20a08b",
                                "text": "„Ein Akteur nach dem anderen trudelt für die Abendvorstellung ein – manche scheinen schon in ihrer Rolle zu sein, stoßen pathetisch kurze Sätze aus, als wollten sie sich ‚einsingen‘.“"
                            },
                            {
                                "example_id": "de07e262-7d53-4dd6-8feb-4dd55a51dd60",
                                "sense_id": "d8109595-4296-3dd8-b502-3b641a20a08b",
                                "text": "„Eine Abendvorstellung im Nationaltheater ist bis auf den letzten Platz besetzt.“"
                            },
                            {
                                "example_id": "4c9f27f6-c5c4-4448-8e5e-3bf7e2c4d654",
                                "sense_id": "d8109595-4296-3dd8-b502-3b641a20a08b",
                                "text": "„‚Alles bis auf den Kaffeelöffel muss zerteilt und verstaut werden können‘, denn an den Kammerspielen wird vormittags in einem Bühnenbild für die nächste Premiere geprobt und nachmittags umgebaut auf die Abendvorstellung.“"
                            },
                            {
                                "example_id": "c5382514-ee10-4b52-9dee-7137e6b3bb9d",
                                "sense_id": "d8109595-4296-3dd8-b502-3b641a20a08b",
                                "text": "„Wie immer musste er rechtzeitig zur Abendvorstellung im Lichtspieltheater am Wedding sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
