                "senses": [
                    {
                        "sense_id": "bd9f346f-db92-3070-a939-c328c900062b",
                        "entry_id": "2967d71d-51e2-3e51-b92c-8d859574324e",
                        "glosses": [
                            "met veel krassen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73698321-acea-42f1-9c1a-e6bca6dc6905",
                                "sense_id": "bd9f346f-db92-3070-a939-c328c900062b",
                                "text": "Aukje Koks zoekt graag de grenzen op, en glipt er regelmatig overheen. Neem haar nieuwe tentoonstelling bij Stigter Van Doesburg. Die bevat werk van allerlei aard: er hangen schilderijen die mooi en slim en virtuoos zijn, tekeningen die nog het meest lijken op handige voorstudies en ook tekeningen en schilderijen die zo triviaal lijken (krasserig, onhandig, uitgeknipterig) dat je haar bijna wilt toeschreeuwen: Kom nou toch! Je kunt zoveel beter! Moet het echt zo lullig?"
                            },
                            {
                                "example_id": "324b5e1f-3dd6-4c7e-adec-d63014b93115",
                                "sense_id": "bd9f346f-db92-3070-a939-c328c900062b",
                                "text": "De tekeningen die Van Straaten maakte bij bijvoorbeeld de Elfstedentocht of rechtszittingen waren aanvankelijk een beetje in de stijl van Spier, maar gaandeweg ontwikkelde hij een heel eigen handschrift: lekker krasserig, vol arceringen, sfeervol."
                            },
                            {
                                "example_id": "b27c5f1b-1dea-46da-85ae-e2e0f6da9298",
                                "sense_id": "bd9f346f-db92-3070-a939-c328c900062b",
                                "text": "De illustraties, van Marijke Klompmaker, vallen om diezelfde reden tegen: woede uitbeelden met een boksend mannetje in een krasserige wolk, tja, dat maakt het geheel niet erg bijzonder."
                            }
                        ]
                    }
