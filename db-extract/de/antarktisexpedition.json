                "senses": [
                    {
                        "sense_id": "64ac48da-7561-3fb1-a952-d7dfa9cf9198",
                        "entry_id": "6593564f-24ed-3bd0-9a32-93bf49f44db4",
                        "glosses": [
                            "(Forschungs-)Reise zur Antarktis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "515e0a5d-1295-4590-89a8-71c48626b5e3",
                                "sense_id": "64ac48da-7561-3fb1-a952-d7dfa9cf9198",
                                "text": "„Das eindrucksvolle hölzerne Segelschiff lief unter Kapitän Scott 1901-1904 zur ersten Antarktisexpedition aus und kann jetzt besichtigt werden.“"
                            },
                            {
                                "example_id": "f8a20669-f285-4518-8565-1fd23fa12f82",
                                "sense_id": "64ac48da-7561-3fb1-a952-d7dfa9cf9198",
                                "text": "„Er zwängte sich in einen alten, blauen Anorak, in dem er aussah wie der Teilnehmer einer Antarktisexpedition aus den Fünfzigerjahren.“"
                            },
                            {
                                "example_id": "f41f037b-9d9c-4085-b8c6-12898680bb70",
                                "sense_id": "64ac48da-7561-3fb1-a952-d7dfa9cf9198",
                                "text": "„Das Zelt kostete ein halbes Vermögen und war für eine Antarktisexpedition ausgelegt.“"
                            },
                            {
                                "example_id": "ee40d826-88e4-432b-ab5e-a5aa3c9a83dd",
                                "sense_id": "64ac48da-7561-3fb1-a952-d7dfa9cf9198",
                                "text": "„Mit dieser Anzeige suchte der britische Polarforscher Sir Ernest Shackleton im Jahr 1914 nach mutigen Mitstreitern für seine geplante Antarktisexpedition.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
