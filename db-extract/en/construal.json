                "translations": [
                    {
                        "translation_id": "312227a4-6df3-4414-a417-708802561f50",
                        "source_entry_id": "7dc0fc78-5cb5-3092-8332-e68601ecb5a7",
                        "source_sense_id": "eb6f9a76-1c51-33da-a227-3f2a657330dd",
                        "source_sense_description": "act of interpreting",
                        "target_lang_word": "interpretatie",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interpretatie",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4c2fae71-a814-38d8-ba91-98dea5dc66b0",
                                        "entry_id": "613f2950-4572-3f38-9374-cf34b66ae9e5",
                                        "glosses": [
                                            "de manier waarop je iets beschouwt, duiding, lezing, uitlegging"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed76b7e8-a26f-423d-956c-fc25a5eca280",
                                                "sense_id": "4c2fae71-a814-38d8-ba91-98dea5dc66b0",
                                                "text": "Het ligt er net aan welke interpretatie je aan die tekst geeft."
                                            },
                                            {
                                                "example_id": "9e5ab15d-27b6-4567-b032-047db0a8383c",
                                                "sense_id": "4c2fae71-a814-38d8-ba91-98dea5dc66b0",
                                                "text": "Na een aantal maanden zoeken maakte ik dan een keuze die vaak op een oecumenische kerk viel, aangezien deze vrijer van dogma’s is. Ik vond er meer ruimte voor eigen interpretatie, twijfel en discussie."
                                            },
                                            {
                                                "example_id": "cb3b56c2-fb14-419e-b317-7a6aade35d6a",
                                                "sense_id": "4c2fae71-a814-38d8-ba91-98dea5dc66b0",
                                                "text": "Ik kan niet alles letterlijk reproduceren en ik moet toegeven dat ik ook niet alles verstond, omdat ik niet was voorbereid op deze uitbarsting van Franse poëzie, maar ik verstond genoeg om te begrijpen dat het ging om een feministische visie op drie verlaten vrouwen uit de mythologie, Nausica, Medea en Dido, die volgens mij werden samengesmolten tot één modern personage in de gedaante van een zwerfster in de metro van Parijs, maar voor het laatste deel van deze interpretatie moet ik gezien de particuliere metaforiek een slag om de arm houden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de21901a-5ceb-36a0-9d3a-84139d71a7c4",
                                        "entry_id": "613f2950-4572-3f38-9374-cf34b66ae9e5",
                                        "glosses": [
                                            "vertolking van een muzikale compositie of een tekst"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "daf9b3aa-af1d-4281-8dc6-f33b46cd9c93",
                        "source_entry_id": "7dc0fc78-5cb5-3092-8332-e68601ecb5a7",
                        "source_sense_id": "eb6f9a76-1c51-33da-a227-3f2a657330dd",
                        "source_sense_description": "act of interpreting",
                        "target_lang_word": "interprétation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interprétation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "18531113-6156-34bc-bd18-f90eda941370",
                                        "entry_id": "f0df7f47-426b-3279-aaf4-aab7a9841bf3",
                                        "glosses": [
                                            "Action d’interpréter ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "562ebaf2-a871-41c9-97c7-87d029737cba",
                                                "sense_id": "18531113-6156-34bc-bd18-f90eda941370",
                                                "text": "[…] mais aussi à cette translation se joignit bientôt quelque chose de plus que la traduction pure et simple; des interprétations, d’abord morales seulement, puis allégoriques, mirent sur la voie de ce que l’église voulait éviter, et de ce que la réforme a proclamé depuis, l’examen individuel de l’Écriture."
                                            },
                                            {
                                                "example_id": "3d37e5e6-8ce7-4b3b-99f6-9eba8785d4d2",
                                                "sense_id": "18531113-6156-34bc-bd18-f90eda941370",
                                                "text": "[…] ; on apprenait à mesurer le vent aux diverses altitudes en observant un ballon au moyen d’un théodolite ; on calculait les tables qui permettaient une interprétation rapide, et en même temps d'autres tables de correction pour le tir de l’artillerie."
                                            },
                                            {
                                                "example_id": "f359338c-cc50-43a9-b2a9-7612c7dca298",
                                                "sense_id": "18531113-6156-34bc-bd18-f90eda941370",
                                                "text": "Malgré la possibilité d’un échec final, il paraît donc utile de reprendre par sa base le problème très difficile de l’interprétation de la Mécanique ondulatoire, afin de voir si l’interprétation actuellement orthodoxe est vraiment la seule que l’on puisse adopter."
                                            },
                                            {
                                                "example_id": "35fc72ff-6f42-4a10-a991-0ece95273e1c",
                                                "sense_id": "18531113-6156-34bc-bd18-f90eda941370",
                                                "text": "Dans tous les articles, les auteurs s'attachent scrupuleusement aux faits, aux données brutes et concrètes : pas de bavardage, pas d’interprétations oiseuses, mais des informations précises étayées par des citations sourcées."
                                            },
                                            {
                                                "example_id": "0f40d4cf-a037-4f2a-b106-fa1fde6494e5",
                                                "sense_id": "18531113-6156-34bc-bd18-f90eda941370",
                                                "text": "Dès qu'on évoque le rôle de l’interprétation analogique dans une argumentation ou une invention scientifiques, on entend aussitôt crier haro sur la métaphore."
                                            },
                                            {
                                                "example_id": "5bb6315e-385b-4b55-ac7f-7271cfd9f64a",
                                                "sense_id": "18531113-6156-34bc-bd18-f90eda941370",
                                                "text": "Pour autant, l’ interprétation des élections européennes emporte nécessairement aussi des conséquences nationales, en raison de la nature même de l’Union européenne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe6ab360-ba1e-3599-aed3-e2876dd6b4ec",
                                        "entry_id": "f0df7f47-426b-3279-aaf4-aab7a9841bf3",
                                        "glosses": [
                                            "Façon dont les acteurs traduisent une pièce ou un rôle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70b3ccfa-54d8-401f-8078-76cab0d79d84",
                                                "sense_id": "fe6ab360-ba1e-3599-aed3-e2876dd6b4ec",
                                                "text": "L’interprétation d’un rôle, d’une pièce de théâtre,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f59d2da-7b95-31c8-adfc-8105c2c53c1d",
                                        "entry_id": "f0df7f47-426b-3279-aaf4-aab7a9841bf3",
                                        "glosses": [
                                            "Façon de jouer ou de chanter une œuvre musicale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fb017ef-63b5-4648-b8bc-df866a1112f5",
                                                "sense_id": "8f59d2da-7b95-31c8-adfc-8105c2c53c1d",
                                                "text": "L’interprétation de cette immense sonate est d’ailleurs à l’image du documentaire : très sobre, extrêmement sérieuse, presque sans affect."
                                            },
                                            {
                                                "example_id": "6f72c4dd-b24d-4468-b890-6221228af5e6",
                                                "sense_id": "8f59d2da-7b95-31c8-adfc-8105c2c53c1d",
                                                "text": "Une interprétation historiquement informée, c’est une interprétation qui essaie de se rapprocher le plus possible des intentions et des conditions d’origine de la création d’une œuvre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42904773-4bb5-45f3-806d-e6b117579e6c",
                        "source_entry_id": "7dc0fc78-5cb5-3092-8332-e68601ecb5a7",
                        "source_sense_id": "eb6f9a76-1c51-33da-a227-3f2a657330dd",
                        "source_sense_description": "act of interpreting",
                        "target_lang_word": "Deutung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Deutung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "684c0958-fff0-3252-a3f4-5d8b575e003c",
                                        "entry_id": "38b62ac6-e00a-3026-b429-817ae014a90d",
                                        "glosses": [
                                            "Versuch, den tieferen Sinn einer Sache zu begreifen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d4c9323-fa2f-42d5-a7d6-36ec7bbce7ef",
                                                "sense_id": "684c0958-fff0-3252-a3f4-5d8b575e003c",
                                                "text": "Der Vorgang lässt keine andere Deutung zu."
                                            },
                                            {
                                                "example_id": "9238e163-f4e4-492e-b811-bec8d2aec48d",
                                                "sense_id": "684c0958-fff0-3252-a3f4-5d8b575e003c",
                                                "text": "„Auch volksetymologischen Deutungen wird Raum gegeben, soweit diese mit einiger Zuverlässigkeit den Kern der Sache treffen.“"
                                            },
                                            {
                                                "example_id": "2713bad2-35a6-4b08-bde6-2bd894c5ba00",
                                                "sense_id": "684c0958-fff0-3252-a3f4-5d8b575e003c",
                                                "text": "„Über das Zeichensystem aus 24 Runen hinaus ist wenig bekannt, fast alle Deutungen laufen ins Nebulöse.“"
                                            },
                                            {
                                                "example_id": "b9c60f59-2c56-4bd4-a0b0-e4c0b0eb2d3d",
                                                "sense_id": "684c0958-fff0-3252-a3f4-5d8b575e003c",
                                                "text": "„Damit die Leser meine Deutungen überprüfen und ihre Eindrücke vertiefen können, biete ich weitere Lesevorschläge.“"
                                            },
                                            {
                                                "example_id": "c8c91c0f-d46e-45e6-80e1-25c024ea5a91",
                                                "sense_id": "684c0958-fff0-3252-a3f4-5d8b575e003c",
                                                "text": "„Das Material erlaubt aber in jedem Falle mehr als eine Deutung oder enthält mehr als ein Bewertungskriterium, ist also mehrdimensional und mehrperspektivisch angelegt und enthält eindeutige aber vielfältige Schlussfolgerungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
