                "senses": [
                    {
                        "sense_id": "e2a3bf79-6b14-35b4-8a55-b854692dcb0e",
                        "entry_id": "59c7c5e7-bed4-3553-84ba-bdccec60dac0",
                        "glosses": [
                            "englischsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e250e85-326e-4f37-9ac7-9d9c8e3cc589",
                                "sense_id": "e2a3bf79-6b14-35b4-8a55-b854692dcb0e",
                                "text": "Frau Presley ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a12ebf83-12ba-498a-bf8c-269818cd53bb",
                                "sense_id": "e2a3bf79-6b14-35b4-8a55-b854692dcb0e",
                                "text": "Herr Presley wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c7af8d79-86ff-456d-afbc-3d45212f7f83",
                                "sense_id": "e2a3bf79-6b14-35b4-8a55-b854692dcb0e",
                                "text": "Die Presleys fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "de21e450-72f6-479d-94dc-c2d24debac57",
                                "sense_id": "e2a3bf79-6b14-35b4-8a55-b854692dcb0e",
                                "text": "Der Presley trägt nie die Pullover, die die Presley ihm strickt."
                            },
                            {
                                "example_id": "a756f426-7944-4711-9dbb-d657ffee3d8b",
                                "sense_id": "e2a3bf79-6b14-35b4-8a55-b854692dcb0e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Presley kommt, geht der Herr Presley.“"
                            },
                            {
                                "example_id": "66a7839a-bcee-4b1a-936e-ef3e6adadf8c",
                                "sense_id": "e2a3bf79-6b14-35b4-8a55-b854692dcb0e",
                                "text": "Presley kommt und geht."
                            },
                            {
                                "example_id": "22a0d607-1bad-4fcc-82bb-a3b801c197af",
                                "sense_id": "e2a3bf79-6b14-35b4-8a55-b854692dcb0e",
                                "text": "Presleys kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
