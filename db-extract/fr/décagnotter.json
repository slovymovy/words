                "senses": [
                    {
                        "sense_id": "5958e81a-e2cf-35f2-bd88-27b908a64ef8",
                        "entry_id": "fd586dd7-8dd9-37d3-946c-02e59ba685be",
                        "glosses": [
                            "Sortir de l’argent d’une cagnotte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa66a811-f87b-4a15-b37b-3a30ee5e444d",
                                "sense_id": "5958e81a-e2cf-35f2-bd88-27b908a64ef8",
                                "text": "Bonjour, je viens de changer de carte je l'ai validé mais je ne peux pas décagnotter en magasin."
                            },
                            {
                                "example_id": "7f38bbf0-62d3-4d50-b404-0bb184ef2ad8",
                                "sense_id": "5958e81a-e2cf-35f2-bd88-27b908a64ef8",
                                "text": "Sachez que maintenant vous pouvez cagnotter et décagnotter sur Auchan.fr !"
                            },
                            {
                                "example_id": "37e86590-351c-4030-9a3f-3e1f2dbe6584",
                                "sense_id": "5958e81a-e2cf-35f2-bd88-27b908a64ef8",
                                "text": "J'ai obtenu il y a peu de temps mon code secret pour pouvoir décagnotter sur la carte fidélité carrefour."
                            },
                            {
                                "example_id": "e8ab9539-75d0-46dd-b5a9-b61ef1e5ad64",
                                "sense_id": "5958e81a-e2cf-35f2-bd88-27b908a64ef8",
                                "text": "Francine, elle, vient de « décagnoter » ses euros de fidélité, patiemment accumulés sur douze mois : 145 euros."
                            }
                        ]
                    }
