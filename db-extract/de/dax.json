                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f96462f-7fa8-42b7-92fe-5179528c1891",
                                "sense_id": "a42dcffe-5622-3efa-921d-c158c2aa36c5",
                                "text": "„Immerhin lehnt sich der Geldmehrer mit seinen Prognosen weit aus dem Fenster: Er traut dem Dax im ersten Quartal 4600 Zähler zu.“"
                            },
                            {
                                "example_id": "61b74c1f-14f1-409b-9055-86d7e93ee8f1",
                                "sense_id": "a42dcffe-5622-3efa-921d-c158c2aa36c5",
                                "text": "„Da kommt ein einziger Dax-Vorstandschef Berechnungen zufolge auf Pensionszusagen von 30 Millionen Euro, insgesamt liegt die Summe der Rückstellungen für Pensionen im Dax bei sagenhaften 637 Millionen Euro.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
