                        "sense_id": "4214db13-0554-35f3-84dd-35e381f341f8",
                        "entry_id": "e8f8c3cd-e60b-30e3-a21d-19060fe5d6ee",
                        "glosses": [
                            "A user of the social networking app Threads."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25c54e4f-1b08-48df-8e5d-50039ffef946",
                                "sense_id": "4214db13-0554-35f3-84dd-35e381f341f8",
                                "text": "For those who are especially keen on becoming a 'Threader', the free app can be pre-ordered now and will become available to use upon its official launch tomorrow."
                            },
                            {
                                "example_id": "c52e2032-4669-44e6-9fea-25fb57f510f8",
                                "sense_id": "4214db13-0554-35f3-84dd-35e381f341f8",
                                "text": "On Thursday morning, Mark Zuckerberg, chief executive of Meta Platforms, which owns Instagram and Facebook, said that 30 million new Threaders have already signed on."
                            },
                            {
                                "example_id": "b26a501f-2c0d-4845-92cc-adff9ece5150",
                                "sense_id": "4214db13-0554-35f3-84dd-35e381f341f8",
                                "text": "Ultimately, only time with tell whether mighty Meta will bring Twitter to heel. Until then, I have just one burning question: if Twitterers tweet, what do Threaders do? Sew? Stitch? Needle? Embroider? Answers on a virtual postcard, please."
                            }
                        ]
                    }
