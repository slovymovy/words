    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1c7ba8e8-e490-3dbf-bc12-e25978fcdaa6",
                    "sense_definition": "Défaire un appareil, un meuble ou un ensemble pièce par pièce.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mecanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de déménager, il faut <w>démonter</w> cette grande armoire en bois.",
                            "target_lang_translations": {
                                "en": "Before moving house, we will have to <w>dismantle</w> this large wooden wardrobe.",
                                "ru": "Перед переездом этот большой деревянный шкаф придётся <w>разобрать</w>.",
                                "de": "Bevor wir umziehen, müssen wir diesen großen Holzschrank <w>auseinandernehmen</w>.",
                                "es": "Antes de mudarnos, hay que <w>desmontar</w> este gran armario de madera.",
                                "zh": "搬家前，得先把这个大木衣柜<w>拆开</w>。"
                            }
                        },
                        {
                            "text": "Le mécanicien a <w>démonté</w> le moteur pour trouver l'origine de la panne.",
                            "target_lang_translations": {
                                "en": "The mechanic <w>dismantled</w> the engine to find the cause of the breakdown.",
                                "ru": "Механик <w>разобрал</w> двигатель, чтобы найти причину поломки.",
                                "de": "Der Mechaniker hat den Motor <w>auseinandergenommen</w>, um die Ursache der Panne zu finden.",
                                "es": "El mecánico <w>desmontó</w> el motor para encontrar el origen de la avería.",
                                "zh": "为找出故障的原因，机械师<w>拆卸</w>了发动机。"
                            }
                        }
                    ],
                    "synonyms": [
                        "désassembler"
                    ],
                    "antonyms": [
                        "monter",
                        "assembler"
                    ],
                    "common_phrases": [
                        "démonter un meuble",
                        "démonter une pièce"
                    ],
                    "target_lang_definitions": {
                        "en": "To take apart an appliance, piece of furniture or assembly piece by piece.",
                        "ru": "Разобрать устройство, мебель или механизм на отдельные части.",
                        "de": "Ein Gerät, ein Möbelstück oder eine Baugruppe Teil für Teil auseinandernehmen.",
                        "es": "Separar en piezas un aparato, un mueble o un conjunto.",
                        "zh": "把器具、家具或组件一个零件一个零件地拆开。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dismantle",
                                "target_lang_sense_clarification": "machines, furniture or structures"
                            },
                            {
                                "target_lang_word": "take apart",
                                "target_lang_sense_clarification": "everyday, into separate pieces"
                            },
                            {
                                "target_lang_word": "disassemble",
                                "target_lang_sense_clarification": "technical, separating components"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "разбирать",
                                "target_lang_sense_clarification": "мебель, техника, на отдельные части"
                            },
                            {
                                "target_lang_word": "демонтировать",
                                "target_lang_sense_clarification": "технический термин, снятие с установки"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "auseinandernehmen",
                                "target_lang_sense_clarification": "Geräte, Möbel, alltagssprachlich"
                            },
                            {
                                "target_lang_word": "zerlegen",
                                "target_lang_sense_clarification": "Maschinen in Einzelteile"
                            },
                            {
                                "target_lang_word": "demontieren",
                                "target_lang_sense_clarification": "Technik, Bauteile abnehmen"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "desmontar",
                                "target_lang_sense_clarification": "muebles, máquinas y conjuntos mecánicos"
                            },
                            {
                                "target_lang_word": "desarmar",
                                "target_lang_sense_clarification": "aparatos y objetos en piezas"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拆开",
                                "target_lang_sense_clarification": "日常用语，通用"
                            },
                            {
                                "target_lang_word": "拆卸",
                                "target_lang_sense_clarification": "机器、家具，逐件拆下"
                            },
                            {
                                "target_lang_word": "拆解",
                                "target_lang_sense_clarification": "技术，分解成零部件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e53cbbbe-9982-324c-986c-4d2dd6d8b0a5",
                    "sense_definition": "Déconcerter une personne ou lui faire perdre son assurance et son calme.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "psychologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette remarque inattendue a complètement <w>démonté</w> l'orateur pendant son discours.",
                            "target_lang_translations": {
                                "en": "This unexpected remark completely <w>unsettled</w> the speaker during his speech.",
                                "ru": "Это неожиданное замечание полностью <w>смутило</w> оратора во время его речи.",
                                "de": "Diese unerwartete Bemerkung hat den Redner während seiner Rede völlig <w>verunsichert</w>.",
                                "es": "Esta observación inesperada <w>desconcertó</w> por completo al orador durante su discurso.",
                                "zh": "这句出人意料的话，让演讲者在演讲途中完全<w>乱了方寸</w>。"
                            }
                        },
                        {
                            "text": "Malgré les critiques virulentes du jury, elle ne s'est pas <w>démontée</w>.",
                            "target_lang_translations": {
                                "en": "Despite the jury's scathing criticism, she was not <w>unnerved</w>.",
                                "ru": "Несмотря на резкую критику жюри, она не <w>растерялась</w>.",
                                "de": "Trotz der heftigen Kritik der Jury ließ sie sich nicht <w>verunsichern</w>.",
                                "es": "A pesar de las duras críticas del jurado, ella no <w>se arredró</w>.",
                                "zh": "尽管评委的批评十分尖锐，她还是没有<w>慌神</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "déconcerter",
                        "décontenancer",
                        "déstabiliser"
                    ],
                    "antonyms": [
                        "rassurer"
                    ],
                    "common_phrases": [
                        "ne pas se démonter"
                    ],
                    "target_lang_definitions": {
                        "en": "To unsettle someone and make them lose their composure or confidence.",
                        "ru": "Смутить человека, лишив его уверенности и душевного равновесия.",
                        "de": "Jemanden verwirren und ihm Sicherheit sowie Gelassenheit nehmen.",
                        "es": "Desconcertar a alguien o hacerle perder la calma y la seguridad.",
                        "zh": "使人慌乱，失去镇定或自信。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unsettle",
                                "target_lang_sense_clarification": "emotional or social situations"
                            },
                            {
                                "target_lang_word": "unnerve",
                                "target_lang_sense_clarification": "fear, shaking confidence"
                            },
                            {
                                "target_lang_word": "rattle",
                                "target_lang_sense_clarification": "informal, under pressure or criticism"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "смущать",
                                "target_lang_sense_clarification": "неловкость, растерянность перед другими"
                            },
                            {
                                "target_lang_word": "обескураживать",
                                "target_lang_sense_clarification": "лишать уверенности и духа"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "verunsichern",
                                "target_lang_sense_clarification": "Selbstvertrauen und Sicherheit nehmen"
                            },
                            {
                                "target_lang_word": "aus der Fassung bringen",
                                "target_lang_sense_clarification": "Redner, Situationen, umgangssprachlich"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "desconcertar",
                                "target_lang_sense_clarification": "reacciones o preguntas inesperadas"
                            },
                            {
                                "target_lang_word": "descolocar",
                                "target_lang_sense_clarification": "coloquial, pérdida de compostura"
                            },
                            {
                                "target_lang_word": "desestabilizar",
                                "target_lang_sense_clarification": "presiones, críticas o situaciones tensas"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乱了方寸",
                                "target_lang_sense_clarification": "失去镇定，多用于重要场合"
                            },
                            {
                                "target_lang_word": "慌了神",
                                "target_lang_sense_clarification": "口语，受压力或批评时"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e72db18-dd12-3eb6-b321-9e1596e4deb9",
                    "sense_definition": "Faire tomber un cavalier de sa monture.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "equitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cheval a fait une brusque embardée et a <w>démonté</w> son cavalier.",
                            "target_lang_translations": {
                                "en": "The horse swerved sharply and <w>unseated</w> its rider.",
                                "ru": "Лошадь резко шарахнулась в сторону и <w>сбросила</w> всадника.",
                                "de": "Das Pferd scheute plötzlich zur Seite und <w>warf</w> seinen Reiter <w>ab</w>.",
                                "es": "El caballo dio un brusco viraje y <w>desarzonó</w> a su jinete.",
                                "zh": "马突然猛地一偏，把骑手<w>甩下</w>了马背。"
                            }
                        },
                        {
                            "text": "Un coup violent de l'adversaire l'a <w>démonté</w> au milieu du champ de bataille.",
                            "target_lang_translations": {
                                "en": "A violent blow from his opponent <w>unseated</w> him in the middle of the battlefield.",
                                "ru": "Сильный удар противника <w>сбросил</w> его с коня посреди поля боя.",
                                "de": "Ein harter Schlag seines Gegners <w>warf</w> ihn mitten auf dem Schlachtfeld <w>aus dem Sattel</w>.",
                                "es": "Un golpe violento del adversario lo <w>desarzonó</w> en medio del campo de batalla.",
                                "zh": "对手的一记猛击，让他在战场中央<w>摔下马</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "désarçonner"
                    ],
                    "target_lang_definitions": {
                        "en": "To knock a rider off their horse.",
                        "ru": "Сбросить всадника с лошади.",
                        "de": "Einen Reiter vom Pferd herunterwerfen.",
                        "es": "Hacer caer a un jinete de su montura.",
                        "zh": "使骑手从马背上摔落。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unseat",
                                "target_lang_sense_clarification": "equestrian or jousting contexts"
                            },
                            {
                                "target_lang_word": "throw",
                                "target_lang_sense_clarification": "horse bucking its rider"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сбрасывать",
                                "target_lang_sense_clarification": "о лошади, сбрасывающей всадника"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "abwerfen",
                                "target_lang_sense_clarification": "Pferd wirft Reiter ab, Reitsport"
                            },
                            {
                                "target_lang_word": "aus dem Sattel werfen",
                                "target_lang_sense_clarification": "Reiten, Turnier, auch übertragen"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "desarzonar",
                                "target_lang_sense_clarification": "hípica, caballo que arroja al jinete"
                            },
                            {
                                "target_lang_word": "tirar",
                                "target_lang_sense_clarification": "caballo que derriba al jinete"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "甩下",
                                "target_lang_sense_clarification": "马匹甩落骑手"
                            },
                            {
                                "target_lang_word": "摔下马",
                                "target_lang_sense_clarification": "比武或马术场合"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "453ff1a9-69e6-3f8b-b338-37cef8847e94",
                    "sense_definition": "Désactiver l'accès logique à un disque ou à un système de fichiers.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oublie pas de <w>démonter</w> le disque externe avant de débrancher le câble.",
                            "target_lang_translations": {
                                "en": "Don't forget to <w>unmount</w> the external drive before unplugging the cable.",
                                "ru": "Не забудь <w>размонтировать</w> внешний диск перед тем, как отсоединить кабель.",
                                "de": "Vergiss nicht, die externe Festplatte <w>auszuhängen</w>, bevor du das Kabel abziehst.",
                                "es": "No olvides <w>desmontar</w> el disco externo antes de desconectar el cable.",
                                "zh": "拔掉数据线之前，别忘了先<w>弹出</w>外接硬盘。"
                            }
                        },
                        {
                            "text": "Le système refuse de <w>démonter</w> cette partition car un fichier reste ouvert.",
                            "target_lang_translations": {
                                "en": "The system refuses to <w>unmount</w> this partition because a file is still open.",
                                "ru": "Система отказывается <w>размонтировать</w> этот раздел, потому что файл остаётся открытым.",
                                "de": "Das System weigert sich, diese Partition <w>auszuhängen</w>, weil eine Datei noch geöffnet ist.",
                                "es": "El sistema se niega a <w>desmontar</w> esta partición porque un archivo sigue abierto.",
                                "zh": "由于还有一个文件处于打开状态，系统拒绝<w>卸载</w>这个分区。"
                            }
                        }
                    ],
                    "synonyms": [
                        "éjecter"
                    ],
                    "antonyms": [
                        "monter"
                    ],
                    "common_phrases": [
                        "démonter un volume",
                        "démonter un disque"
                    ],
                    "target_lang_definitions": {
                        "en": "To make a disk or file system inaccessible to the system before removing it.",
                        "ru": "Отключить диск или файловую систему от системы перед извлечением.",
                        "de": "Ein Laufwerk oder Dateisystem vor dem Entfernen für das System unzugänglich machen.",
                        "es": "Desactivar el acceso lógico a un disco o a un sistema de archivos.",
                        "zh": "使磁盘或文件系统在移除前停止被系统访问。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unmount",
                                "target_lang_sense_clarification": "computing, disconnecting file systems"
                            },
                            {
                                "target_lang_word": "dismount",
                                "target_lang_sense_clarification": "computing, making volumes unavailable"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "размонтировать",
                                "target_lang_sense_clarification": "компьютеры, диски, файловые системы"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "aushängen",
                                "target_lang_sense_clarification": "Dateisysteme, Laufwerke, Informatik"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "desmontar",
                                "target_lang_sense_clarification": "informática, particiones y volúmenes"
                            },
                            {
                                "target_lang_word": "expulsar",
                                "target_lang_sense_clarification": "informática, unidades extraíbles"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "弹出",
                                "target_lang_sense_clarification": "可移动存储器，安全移除"
                            },
                            {
                                "target_lang_word": "卸载",
                                "target_lang_sense_clarification": "计算机，文件系统或分区"
                            }
                        ]
                    }
                }
            ]
        }
    ]
