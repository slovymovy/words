{
    "word_family": [
        "osnuć",
        "usnuć",
        "zasnuć",
        "wysnuć",
        "snucie",
        "osnowa"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c80a0aa9-f5b1-3087-9748-de3bff694036",
                    "sense_definition": "tworzyć lub obmyślać coś w myślach, na przykład plany, marzenia albo opowieści",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "plany i myśli",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wieczorami siadali przy kominku i wspólnie <w>snuli</w> plany na przyszłość.",
                            "target_lang_translations": {
                                "ru": "По вечерам они садились у камина и вместе <w>строили</w> планы на будущее."
                            }
                        },
                        {
                            "text": "Przez cały miesiąc <w>snuł</w> plany dotyczące założenia firmy, analizując dokładnie koszty oraz rynek.",
                            "target_lang_translations": {
                                "ru": "Целый месяц он <w>вынашивал</w> планы по открытию фирмы, тщательно анализируя расходы и рынок."
                            }
                        }
                    ],
                    "common_phrases": [
                        "snuć plany",
                        "snuć marzenia",
                        "snuć opowieść",
                        "snuć wizje"
                    ],
                    "target_lang_definitions": {
                        "ru": "строить в мыслях, вынашивать (планы, мечты), плести или слагать (рассказы)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "строить",
                                "target_lang_sense_clarification": "о планах, замыслах"
                            },
                            {
                                "target_lang_word": "плести",
                                "target_lang_sense_clarification": "о рассказах, интригах"
                            },
                            {
                                "target_lang_word": "вынашивать",
                                "target_lang_sense_clarification": "о мыслях, планах"
                            },
                            {
                                "target_lang_word": "слагать",
                                "target_lang_sense_clarification": "о повестях, сказках"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2be4aac7-cc38-37a4-8dd4-19e01307d6a4",
                    "sense_definition": "chodzić powoli, bez wyraźnego celu lub bez energii; wałęsać się",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ruch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zamiast usiąść do nauki, bezradnie <w>snuł</w> się po pustym mieszkaniu od pokoju do pokoju.",
                            "target_lang_translations": {
                                "ru": "Вместо того чтобы сесть за учёбу, он беспомощно <w>слонялся</w> по пустой квартире из комнаты в комнату."
                            }
                        },
                        {
                            "text": "Opowiadał też o psie, który <w>snuł</w> się wśród turystów na szczycie w poszukiwaniu swojej pani.",
                            "target_lang_translations": {
                                "ru": "Он также рассказывал о собаке, которая <w>бродила</w> среди туристов на вершине в поисках своей хозяйки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "snuć się bez celu",
                        "snuć się po korytarzu",
                        "snuć się po mieszkaniu"
                    ],
                    "target_lang_definitions": {
                        "ru": "медленно ходить, бродить без определённой цели или без энергии, слоняться (snuć się)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слоняться",
                                "target_lang_sense_clarification": "бродить без цели (snuć się)"
                            },
                            {
                                "target_lang_word": "сновать",
                                "target_lang_sense_clarification": "ходить туда-сюда, перемещаться"
                            },
                            {
                                "target_lang_word": "шататься",
                                "target_lang_sense_clarification": "бесцельно ходить (snuć się)"
                            },
                            {
                                "target_lang_word": "бродить",
                                "target_lang_sense_clarification": "медленно перемещаться (snuć się)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9de6ba24-022b-3204-b285-64707b0ea1c4",
                    "sense_definition": "o dymie, mgle lub zapachach: unosić się i powoli przemieszczać w powietrzu",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "zjawiska fizyczne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gęsty dym z gasnącego ogniska powoli <w>snuł</w> się nad wilgotną łąką.",
                            "target_lang_translations": {
                                "ru": "Густой дым от угасающего костра медленно <w>стлался</w> над сырым лугом."
                            }
                        },
                        {
                            "text": "O poranku biała mgła <w>snuła</w> się nisko nad lustrem jeziora, tworząc tajemniczy nastrój.",
                            "target_lang_translations": {
                                "ru": "Утром белый туман низко <w>стлался</w> над гладью озера, создавая таинственную атмосферу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dym snuje się",
                        "mgła snuje się"
                    ],
                    "target_lang_definitions": {
                        "ru": "о дыме, тумане, запахах: медленно плыть, струиться, стлаться в воздухе (snuć się)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стлаться",
                                "target_lang_sense_clarification": "о дыме, тумане"
                            },
                            {
                                "target_lang_word": "струиться",
                                "target_lang_sense_clarification": "о дыме, запахах"
                            },
                            {
                                "target_lang_word": "клубиться",
                                "target_lang_sense_clarification": "о дыме, тумане"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7885f681-8239-3dcd-801f-02a683680a4e",
                    "sense_definition": "wytwarzać nić, włókno lub przędzę z surowca",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rzemiosło",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pająk cierpliwie <w>snuł</w> cienką sieć między gałęziami starej jabłoni w ogrodzie.",
                            "target_lang_translations": {
                                "ru": "Паук терпеливо <w>плёл</w> тонкую паутину между ветвями старой яблони в саду."
                            }
                        },
                        {
                            "text": "W dawnych chatach kobiety często <w>snuły</w> nić na tradycyjnych kołowrotkach podczas zimowych wieczorów.",
                            "target_lang_translations": {
                                "ru": "В старинных избах женщины зимними вечерами часто <w>пряли</w> нить на традиционных прялках."
                            }
                        }
                    ],
                    "synonyms": [
                        "prząść"
                    ],
                    "common_phrases": [
                        "snuć nić",
                        "snuć przędzę"
                    ],
                    "target_lang_definitions": {
                        "ru": "прясть, сновать, вытягивать нити или пряжу из волокна"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прясть",
                                "target_lang_sense_clarification": "скручивать волокна в нить"
                            },
                            {
                                "target_lang_word": "сновать",
                                "target_lang_sense_clarification": "подготавливать основу нитей для ткачества"
                            },
                            {
                                "target_lang_word": "плести",
                                "target_lang_sense_clarification": "о паутине"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}