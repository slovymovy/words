                ],
                "senses": [
                    {
                        "sense_id": "eff7563e-7d1a-3991-9a6c-c6bba98c5751",
                        "entry_id": "b1057e63-934c-3721-9b91-fb94efb0d47f",
                        "glosses": [
                            "Figur in einem Rollenspiel, die vom Spielenden gesteuert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b218ecdb-a9f6-4220-bd1e-4344fb3d0d81",
                                "sense_id": "eff7563e-7d1a-3991-9a6c-c6bba98c5751",
                                "text": "„Die ganze Welt ist ein Strafgefängnis, jeder Spielercharakter ein Häftling.“"
                            },
                            {
                                "example_id": "862307b9-2119-444e-96b1-2dc7cd14af1c",
                                "sense_id": "eff7563e-7d1a-3991-9a6c-c6bba98c5751",
                                "text": "„Auch der frei gestaltbare Spielercharakter beginnt das Spiel als wandelnde Leiche in einem Kerker im ‚Asyl der Untoten‘.“"
                            },
                            {
                                "example_id": "cc10b994-1943-4b73-9c98-c343c8454d6c",
                                "sense_id": "eff7563e-7d1a-3991-9a6c-c6bba98c5751",
                                "text": "„Gelehrt werden an der Fakultät zum Beispiel erfolgreiches Scouting, also wie man Spieler für die Zukunft findet, und richtige Kaderplanung, also welcher Spielercharakter zur Spielphilosophie passt.“"
                            },
                            {
                                "example_id": "7b273587-bdc4-4307-a74c-771108380871",
                                "sense_id": "eff7563e-7d1a-3991-9a6c-c6bba98c5751",
                                "text": "„Der Spielercharakter entwickelt sich nicht schrittweise, sondern graduell weiter.“"
                            },
                            {
                                "example_id": "a3f25599-e9cf-4517-907f-6bf76452c440",
                                "sense_id": "eff7563e-7d1a-3991-9a6c-c6bba98c5751",
                                "text": "„Der Spielercharakter wird auf Missionen geschickt und belohnt, er sammelt Erfahrung, Geld, Ausrüstung und eine Menge unmittelbarer Erfolgserlebnisse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
