                "senses": [
                    {
                        "sense_id": "29009635-47c7-32ed-91d7-2e4abdfcd16e",
                        "entry_id": "0894fe27-8041-3392-b6d6-be9c5d9b030b",
                        "glosses": [
                            "ein Land in Ostafrika"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4db65c6-3f1c-42bc-983f-94f6ce809141",
                                "sense_id": "29009635-47c7-32ed-91d7-2e4abdfcd16e",
                                "text": "In Tansania werden über 120 verschiedene Sprachen, vor allem Bantusprachen, gesprochen."
                            },
                            {
                                "example_id": "7cc5f354-dd44-4e62-8f21-261a9f840361",
                                "sense_id": "29009635-47c7-32ed-91d7-2e4abdfcd16e",
                                "text": "Daressalam ist die größte Stadt Tansanias."
                            },
                            {
                                "example_id": "a49bae82-a2c2-4285-ba9d-15333b5ac42f",
                                "sense_id": "29009635-47c7-32ed-91d7-2e4abdfcd16e",
                                "text": "Dodoma ist die Hauptstadt von Tansania."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8853686-de95-454e-8aac-98acff0aae9a",
                        "source_entry_id": "0894fe27-8041-3392-b6d6-be9c5d9b030b",
                        "source_sense_id": "29009635-47c7-32ed-91d7-2e4abdfcd16e",
                        "source_sense_description": "ein Land in Ostafrika",
                        "target_lang_word": "Tanzania",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tanzania",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c54216a-92a4-3658-b8ed-0c4070b16304",
                                        "entry_id": "4b218454-5cb4-3d30-8613-5de07c741383",
                                        "glosses": [
                                            "A country in East Africa. Official name: United Republic of Tanzania."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccb90b31-4efb-46c4-9aa7-e655d8f15e99",
                                                "sense_id": "2c54216a-92a4-3658-b8ed-0c4070b16304",
                                                "text": "A normally bustling border crossing between Tanzania and Malawi was noticeably quieter than usual on Thursday as a result of an escalating regional trade row."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c304fbe0-c4c8-40f0-96d1-3064bbb19600",
                        "source_entry_id": "0894fe27-8041-3392-b6d6-be9c5d9b030b",
                        "source_sense_id": "29009635-47c7-32ed-91d7-2e4abdfcd16e",
                        "source_sense_description": "ein Land in Ostafrika",
                        "target_lang_word": "Tanzanie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tanzanie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "88a135dc-bee7-351b-b06a-d82e1dc14d31",
                                        "entry_id": "3358490f-f8be-39ab-9f59-3e81c841e63d",
                                        "glosses": [
                                            "Pays d’Afrique, entouré par l’océan Indien, le Kenya, l’Ouganda, le Rwanda, le Burundi, le Congo, la Zambie, le Malawi et le Mozambique, et dont la capitale est Dodoma."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40481e53-cce8-41bb-ae58-575e055ccf4c",
                                                "sense_id": "88a135dc-bee7-351b-b06a-d82e1dc14d31",
                                                "text": "Si elle avait pu, Lily avait expédié sa soeur en Tanzanie."
                                            },
                                            {
                                                "example_id": "aee91714-7943-46ed-a067-d6ee5a4fe22a",
                                                "sense_id": "88a135dc-bee7-351b-b06a-d82e1dc14d31",
                                                "text": "La Tanzanie était en deuil jeudi après l'annonce du décès du président John Magufuli, qui a dirigé ce pays d'Afrique de l'Est durant plus de cinq années marquées par de grands projets, mais aussi par une dérive autoritaire."
                                            },
                                            {
                                                "example_id": "9a430a7d-ce27-46bb-96b1-10a29ae47339",
                                                "sense_id": "88a135dc-bee7-351b-b06a-d82e1dc14d31",
                                                "text": "La présidente de la Tanzanie, Samia Suluhu Hassan, sur Twitter, a assuré que « le monde entier se souviendra de la Reine comme d’un pilier de force, de paix, d’unité et de stabilité »."
                                            },
                                            {
                                                "example_id": "2c7900c8-c43a-49a2-8daf-a4820999f2ea",
                                                "sense_id": "88a135dc-bee7-351b-b06a-d82e1dc14d31",
                                                "text": "Il relierait la région enclavée du lac Albert, en Ouganda, à Tanga, au bord de l’océan Indien, en Tanzanie, d’où le pétrole pourrait être exporté à travers le monde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
