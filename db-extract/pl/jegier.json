                    {
                        "translation_id": "e70a50bc-c1d9-48c4-a939-60ba5fc2f8d2",
                        "source_entry_id": "cdae6138-88a7-3313-9501-621334214bd3",
                        "source_sense_id": "5d62f8fc-b2ed-3540-9b71-c1fed8bb290c",
                        "target_lang_word": "Jäger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jäger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05fca798-9034-3d9c-add7-656517618879",
                                        "entry_id": "929cf550-7ebe-333c-af7a-0c48d6b374f0",
                                        "glosses": [
                                            "Person, die jemanden oder etwas verfolgt"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04b9a3dc-b0bb-478b-bc2a-8a6b3545bb37",
                                                "sense_id": "05fca798-9034-3d9c-add7-656517618879",
                                                "text": "Die Natur ist Schauplatz ewiger Kämpfe zwischen Jägern und Gejagten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "93ffc12c-bfe2-31be-984b-f523b55fb19b",
                                        "entry_id": "929cf550-7ebe-333c-af7a-0c48d6b374f0",
                                        "glosses": [
                                            "Person, die die Jagd ausübt"
                                        ],
                                        "tags": [
                                            "Jagdwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38fb76c1-9df4-4807-9765-231bafe241a9",
                                                "sense_id": "93ffc12c-bfe2-31be-984b-f523b55fb19b",
                                                "text": "Um Jäger zu werden, braucht man eine besondere Ausbildung."
                                            },
                                            {
                                                "example_id": "8e2875c8-6a04-450a-8546-2cc6db440809",
                                                "sense_id": "93ffc12c-bfe2-31be-984b-f523b55fb19b",
                                                "text": "„Meine Grundschullehrerin hieß auch Friede, denkt der Wolfram in mir, und meine finnische Liebe wurde auf den Namen Pia-Maria getauft, was nicht eben nach Jägern und Sammlern klingt.“"
                                            },
                                            {
                                                "example_id": "22ed7f20-8331-400f-8f7b-0769690c7889",
                                                "sense_id": "93ffc12c-bfe2-31be-984b-f523b55fb19b",
                                                "text": "„Sie machte sich Vorwürfe und musste wieder an den jungen Jäger Aktaion denken und an ihre kurze Begegnung, die ihm den Tod gebracht hatte.“"
                                            },
                                            {
                                                "example_id": "38a6ef62-361e-40c6-8627-0946615bc1f4",
                                                "sense_id": "93ffc12c-bfe2-31be-984b-f523b55fb19b",
                                                "text": "„Ich war Kleinschmidts Wagen nachgefahren und hatte nahe genug geparkt, als der Jäger, dem ich auf der Spur bleiben mußte, seinen Wagen verließ und sich zu Fuß aufmachte.“"
                                            },
                                            {
                                                "example_id": "6bddde27-c3b0-4a42-9cad-454d9ea92061",
                                                "sense_id": "93ffc12c-bfe2-31be-984b-f523b55fb19b",
                                                "text": "„Dutzende von Frauenzimmern, alten, jüngeren und ganz jungen drängten sich im Hintergrunde, um die anreitenden Jäger zu sehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f38d32bf-22c8-3df7-91ad-fb8957b67045",
                                        "entry_id": "929cf550-7ebe-333c-af7a-0c48d6b374f0",
                                        "glosses": [
                                            "Soldat der Jägertruppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3595eb4-31f5-4ed4-9a69-0c984455d1c0",
                                                "sense_id": "f38d32bf-22c8-3df7-91ad-fb8957b67045",
                                                "text": "Der Dienst in den Jägereinheiten der Bundeswehr steht nur Soldaten der \"Tauglichkeitsstufe eins\" offen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "31192399-81c4-3dc1-a7b2-a3e9d4fc89df",
                                        "entry_id": "929cf550-7ebe-333c-af7a-0c48d6b374f0",
                                        "glosses": [
                                            "Jagdflugzeug"
                                        ],
                                        "tags": [
                                            "Kurzbezeichnung für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a06fb0ce-c853-48b3-99f6-aafd4c8aa4a0",
                                                "sense_id": "31192399-81c4-3dc1-a7b2-a3e9d4fc89df",
                                                "text": "Die Jäger wurden mit der Zeit immer schneller."
                                            },
                                            {
                                                "example_id": "afa15220-0223-4bdc-8215-7131b6fd15e4",
                                                "sense_id": "31192399-81c4-3dc1-a7b2-a3e9d4fc89df",
                                                "text": "„Japanische Jäger ließen sich jedoch nicht blicken, auch gab es kein Flakfeuer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Jäger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "45e1cbca-63b7-33bb-b1f8-d39ad61a730f",
                                        "entry_id": "b6230279-fc1e-3ef7-8b9e-83f83b8979bb",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad6a2d87-09ad-47c9-b055-b362661fc420",
                                                "sense_id": "45e1cbca-63b7-33bb-b1f8-d39ad61a730f",
                                                "text": "Frau Jäger ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "23cfe462-c606-4483-82b9-04949f2177bf",
                                                "sense_id": "45e1cbca-63b7-33bb-b1f8-d39ad61a730f",
                                                "text": "Herr Jäger wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "29268bdc-9738-410d-8aa1-05442f672971",
                                                "sense_id": "45e1cbca-63b7-33bb-b1f8-d39ad61a730f",
                                                "text": "Die Jägers fahren heute ins Rheinland."
                                            },
                                            {
                                                "example_id": "1a48577b-fc69-4080-80ec-5678c5fd4157",
                                                "sense_id": "45e1cbca-63b7-33bb-b1f8-d39ad61a730f",
                                                "text": "Der Jäger trägt nie die Schals, die die Jäger ihm strickt."
                                            },
                                            {
                                                "example_id": "2b77e89f-8419-4a4d-b076-5470798565a7",
                                                "sense_id": "45e1cbca-63b7-33bb-b1f8-d39ad61a730f",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Jäger kommt, geht der Herr Jäger.“"
                                            },
                                            {
                                                "example_id": "e3c996d4-7686-4c37-97f8-3100532636e1",
                                                "sense_id": "45e1cbca-63b7-33bb-b1f8-d39ad61a730f",
                                                "text": "Jäger kommt und geht."
                                            },
                                            {
                                                "example_id": "31160244-8be2-461c-b63a-d95e6539159c",
                                                "sense_id": "45e1cbca-63b7-33bb-b1f8-d39ad61a730f",
                                                "text": "Jägers kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5fc09183-aa28-4c25-99a1-d332d2744c6d",
                        "source_entry_id": "cdae6138-88a7-3313-9501-621334214bd3",
                        "source_sense_id": "5d62f8fc-b2ed-3540-9b71-c1fed8bb290c",
                        "target_lang_word": "егерь",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "егерь",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "001f38b5-7675-36c1-8a1e-7bb0dc3237cd",
                                        "entry_id": "693c1b76-9142-3c32-b6a0-908577e5733f",
                                        "glosses": [
                                            "специалист по организации охоты, ведению лесного хозяйства"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b759d80a-5bd4-45b8-b191-4e92d7012b62",
                                                "sense_id": "001f38b5-7675-36c1-8a1e-7bb0dc3237cd",
                                                "text": "За процессом ловли на отведенных участках внимательно наблюдают егеря́, обладающие правом аннулировать лицензию при поведении рыболова."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e972ee37-8e08-3b4b-aee9-786e030c0827",
                                        "entry_id": "693c1b76-9142-3c32-b6a0-908577e5733f",
                                        "glosses": [
                                            "устар. профессиональный охотник"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90594941-e41a-402a-bea1-87b3309a15db",
                                                "sense_id": "e972ee37-8e08-3b4b-aee9-786e030c0827",
                                                "text": "Мне думается, что искусство е́геря при натаске собак должно выразиться в значительной степени уменьем разыскать подходящее место и угадать тот момент нарастания сознания собаки, когда она должна лучше всего воспринимать запах дичи."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57834274-afc6-3aea-93cd-4496104674ec",
                                        "entry_id": "693c1b76-9142-3c32-b6a0-908577e5733f",
                                        "glosses": [
                                            "воен. в армиях некоторых стран — военнослужащий особого рода стрелковых войск"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "279fee32-a0bf-403e-bff0-e6cfa9a01da2",
                                                "sense_id": "57834274-afc6-3aea-93cd-4496104674ec",
                                                "text": "На огромном школьном дворе, где по средам и субботам производилась военная экзерсиция, выстроились все четыре эскадрона училища: кирасиры в палевых колетах, гусары в светло-голубых мундирах, гренадеры в темно-синих и егеря́ в светло-зеленых куртках."
                                            },
                                            {
                                                "example_id": "99c021ff-061b-44ff-80e9-cf8699f9b9a2",
                                                "sense_id": "57834274-afc6-3aea-93cd-4496104674ec",
                                                "text": "Однажды вечером три е́геря из линейного батальона, расквартированного в Перовском укреплении, поставили такую оригинальную западню и попросили караульных, несших службу на стенах форта, сообщить им после смены, если они услышат ночью выстрел."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
