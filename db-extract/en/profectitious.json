                "senses": [
                    {
                        "sense_id": "19241783-08f2-3847-9009-118cd9f58d43",
                        "entry_id": "848dc701-09cd-35e6-8142-126477ad9835",
                        "glosses": [
                            "Proceeding from, or as if from, a parent; derived, as from an ancestor."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "4d82ac4c-e74c-4fd4-b390-9ebf26e7aafe",
                                "sense_id": "19241783-08f2-3847-9009-118cd9f58d43",
                                "text": "The threefold distinction of profectitious, adventitious, and professional was ascertained."
                            },
                            {
                                "example_id": "afa8249d-5631-4abc-b69b-8c75769bb522",
                                "sense_id": "19241783-08f2-3847-9009-118cd9f58d43",
                                "text": "A \"profectitious\" dowry (dos profecticia) comes from a woman's paternal ascendant (usually her father and pater familias, but the same rules would apply even if she were emancipated); its main characteristic is that it can be reclaimed if a wife predeceases her husband."
                            },
                            {
                                "example_id": "6cb9dbe1-35b5-4aad-a7f8-3c9d47d3ccfa",
                                "sense_id": "19241783-08f2-3847-9009-118cd9f58d43",
                                "text": "And I say that this is not true, alleging lex Quaesitum, which proves that, with regard to the father, what passes from grandfather to grandson, is regarded as adventitious, not profectitious."
                            }
                        ]
                    }
                ],
