                        "sense_id": "f5fe838c-cdc7-3c73-b783-08e4a47bed71",
                        "entry_id": "6efd652d-1d2c-3b6f-9d78-9aee3a093856",
                        "glosses": [
                            "winkel waar men sieraden verkoopt, inkoopt en repareert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff36c412-2fc5-44e6-a47d-811209adbc89",
                                "sense_id": "f5fe838c-cdc7-3c73-b783-08e4a47bed71",
                                "text": "De eigenaar van de juwelierszaak probeerde de dieven tegen te houden. Daarbij is hij lichtgewond geraakt door glas."
                            },
                            {
                                "example_id": "731728b0-0a7b-4a03-a668-5d41595b62b2",
                                "sense_id": "f5fe838c-cdc7-3c73-b783-08e4a47bed71",
                                "text": "Er zijn meerdere vuurwapens aangetroffen in de juwelierszaak. Het lijkt erop dat de juwelier en zijn vrouw geen wapenvergunning hadden, zei hoofdofficier van justitie Nieuwenhuizen. Het OM onderzoekt of er sprake is van verboden wapenbezit."
                            }
                        ]
                    }
