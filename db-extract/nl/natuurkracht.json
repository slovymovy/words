                                    {
                                        "sense_id": "8fa4b833-f128-3cb7-8896-187c026b3568",
                                        "entry_id": "93f53356-6677-319e-a7fb-767d41ea6206",
                                        "glosses": [
                                            "A mighty natural force which is beyond human control, notably if potentially catastrophic, such as the elements (e.g. storms and extreme temperatures) or geological (e.g. seismic and volcanic) activity."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0c6b4e39-cd93-3606-b9ea-f89aa81f7d45",
                                        "entry_id": "93f53356-6677-319e-a7fb-767d41ea6206",
                                        "glosses": [
                                            "A thing or person that exhibits qualities which appear to be beyond outside control."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e5ad93e-18f4-4fc2-a1cb-baa43b47c24b",
                                                "sense_id": "0c6b4e39-cd93-3606-b9ea-f89aa81f7d45",
                                                "text": "\"She might be a little thing, but she's a force of nature.\" \"I believe it,\" Damon said with a nod. \"You should have heard her put me in my place the other day.\" He reached up to readjust his tie. “Not that I didn't deserve it.\""
                                            },
                                            {
                                                "example_id": "aa933b55-1d26-4d2d-a079-aac617e2be6e",
                                                "sense_id": "0c6b4e39-cd93-3606-b9ea-f89aa81f7d45",
                                                "text": "Again, she will never be a rider; however, she's a force of nature and a powerhouse."
                                            }
