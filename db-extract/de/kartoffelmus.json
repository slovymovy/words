                "senses": [
                    {
                        "sense_id": "6ad17480-76fb-33e4-8375-36890b50ac97",
                        "entry_id": "b91449e8-18d7-3426-928a-1fd1ce5668d9",
                        "glosses": [
                            "Kartoffelgericht aus gekochten und zerdrückten Kartoffeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17055561-d991-41d7-89e9-c92fb392490d",
                                "sense_id": "6ad17480-76fb-33e4-8375-36890b50ac97",
                                "text": "Das Kartoffelmus sollte nach der Zubereitung möglichst frisch gegessen werden."
                            },
                            {
                                "example_id": "4b983e4a-6cff-49ff-8812-3690219de9f5",
                                "sense_id": "6ad17480-76fb-33e4-8375-36890b50ac97",
                                "text": "„Dem Kartoffelmus wird vom Luftzug so viel Wärme entzogen, dass es als Erfrischung dienen kann, zumal die bereitgestellte Orangeade durch ihren Gehalt an tragisch ums Leben gekommenen Mücken nicht mehr zum Genuss reizt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
