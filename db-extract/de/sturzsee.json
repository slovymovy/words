                "senses": [
                    {
                        "sense_id": "da07836a-d13b-31a3-a1e4-bdf8ec9a916b",
                        "entry_id": "59feede5-64db-32ff-90c7-83732e6a4c46",
                        "glosses": [
                            "große Welle, die ein Schiff direkt trifft und in der Folge über dasselbe hereinbricht"
                        ],
                        "tags": [
                            "Schifffahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "70bcfb97-ce44-4f36-9117-cb9f482b1124",
                                "sense_id": "da07836a-d13b-31a3-a1e4-bdf8ec9a916b",
                                "text": "„Einmal schlug eine so schwere Sturzsee in mein Boot, daß ich haltmachen und das Wasser ausschöpfen mußte; das Herz klopfte mir dabei wie einem Vogel, aber allmählich gewöhnte ich mich an die Lage und lenkte mein Korakel so geschickt durch die Wellen, daß nur ab und zu ein Wogenschlag seinen Bug traf und mir den Schaum ins Gesicht warf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a90f58b-8e56-49e0-9b7f-a45e7bde79d4",
                        "source_entry_id": "59feede5-64db-32ff-90c7-83732e6a4c46",
                        "source_sense_id": "da07836a-d13b-31a3-a1e4-bdf8ec9a916b",
                        "source_sense_description": "Schifffahrt: große Welle, die ein Schiff direkt trifft und in der Folge über dasselbe hereinbricht",
                        "target_lang_word": "déferlante",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déferlante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d30ebadc-5058-33ac-a50b-5bc1c7cc7571",
                                        "entry_id": "62960912-507d-341e-8119-705a5177385e",
                                        "glosses": [
                                            "Vague qui déferle sur le rivage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa318231-5989-446d-8a21-cd666bd52d05",
                                                "sense_id": "d30ebadc-5058-33ac-a50b-5bc1c7cc7571",
                                                "text": "Certains réussirent, d'autres furent déportés par des déferlantes et ne purent être sauvés. On vit encore un moment leur tête émerger de la mer démontée, leurs bras faire des signes désespérés puis plus rien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a8a11c4-94c4-30b2-87ff-1d059d09ded6",
                                        "entry_id": "62960912-507d-341e-8119-705a5177385e",
                                        "glosses": [
                                            "Coulée pyroclastique qui déferle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b95fe25-b4c8-42e5-a302-684fa3db75c4",
                                                "sense_id": "2a8a11c4-94c4-30b2-87ff-1d059d09ded6",
                                                "text": "Observées pour la première fois à Taal, aux Philippines, les déferlantes basales sont des coulées de pyroclastites relativement froides, riches en vapeur qui se forment à partir d'éruptions phréaticomagmatiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1757159d-637d-39bb-aedf-b4594c68fd4a",
                                        "entry_id": "62960912-507d-341e-8119-705a5177385e",
                                        "glosses": [
                                            "Afflux soudain, raz-de-marée."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddd8348f-60a9-4a46-a397-2e170f0d8c78",
                                                "sense_id": "1757159d-637d-39bb-aedf-b4594c68fd4a",
                                                "text": "L’odeur des pommes est une déferlante. Comment avait-on pu se passer si longtemps de cette enfance âcre et sucrée ?"
                                            },
                                            {
                                                "example_id": "aab43b32-62c2-4f89-b69a-850d6d83205f",
                                                "sense_id": "1757159d-637d-39bb-aedf-b4594c68fd4a",
                                                "text": "Je dus prendre des mesures, interdire aux disciples de laisser approcher le moindre infirme. Cependant rien n’arrêtait la déferlante : on faisait passer les grabataires par les fenêtres, par le toit."
                                            },
                                            {
                                                "example_id": "c2faf4d8-93b6-4ccf-b926-ec671c0c7327",
                                                "sense_id": "1757159d-637d-39bb-aedf-b4594c68fd4a",
                                                "text": "Chose certaine, face à la déferlante Omicron, la majorité, son économie, sa santé mentale, l’éducation de ses enfants, en ont royalement marre de payer pour une minorité entêtée."
                                            },
                                            {
                                                "example_id": "d6d2a233-97e9-4ffe-a7de-6e2def316bab",
                                                "sense_id": "1757159d-637d-39bb-aedf-b4594c68fd4a",
                                                "text": "Après avoir refusé la mise en place de quotas pour les travailleurs de l’Est et après la déferlante des premières années, le Royaume Uni connait un tassement de l’immigration."
                                            },
                                            {
                                                "example_id": "19578982-942f-49f1-bd92-025ecabf097a",
                                                "sense_id": "1757159d-637d-39bb-aedf-b4594c68fd4a",
                                                "text": "Le nord de l’Italie est gagné par une déferlante xénophobe."
                                            }
                                        ]
                                    }
                                ]
                            },
