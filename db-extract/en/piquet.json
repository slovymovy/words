            {
                "entry_id": "0a7b9790-f6ac-36ff-b656-70714df73eba",
                "word": "piquet",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d87ae013-c89b-3b19-9fc5-2ccd93deef64",
                        "entry_id": "0a7b9790-f6ac-36ff-b656-70714df73eba",
                        "glosses": [
                            "A game of cards for two people, with thirty-two cards, all the deuces, threes, fours, fives, and sixes being set aside."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "bb8a14e5-406e-450f-91ad-1f8a8bd7e67d",
                                "sense_id": "d87ae013-c89b-3b19-9fc5-2ccd93deef64",
                                "text": "Maria my love you look grave. Come, you sit down to Piquet with Mr. Surface."
                            },
                            {
                                "example_id": "13bc962d-7713-464a-81ba-ac344becf66c",
                                "sense_id": "d87ae013-c89b-3b19-9fc5-2ccd93deef64",
                                "text": "The two wedding parties met constantly in each other's apartments. After two or three nights the gentlemen of an evening had a little piquet, as their wives sate and chatted apart."
                            },
                            {
                                "example_id": "31f5efe5-2bc5-4e49-a6ac-e4064cc2e8fc",
                                "sense_id": "d87ae013-c89b-3b19-9fc5-2ccd93deef64",
                                "text": "They would kick off their shoes and play piquet by candle-light."
                            },
                            {
                                "example_id": "af9c4183-bf1f-466a-a67b-c31f828b0357",
                                "sense_id": "d87ae013-c89b-3b19-9fc5-2ccd93deef64",
                                "text": "We shall together challenge the Chevalier de Belleroche to piquet; and, while we are winning money from him, we shall have the even greater pleasure of hearing you sing with your charming teacher, to whom I shall propose it."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "383a7b71-c04d-413d-9f25-32fe12bda2f0",
                        "source_entry_id": "0a7b9790-f6ac-36ff-b656-70714df73eba",
                        "source_sense_id": "d87ae013-c89b-3b19-9fc5-2ccd93deef64",
                        "source_sense_description": "a game of cards",
                        "target_lang_word": "piquet",
