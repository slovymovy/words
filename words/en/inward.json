                },
                {
                    "sense_id": "c748a0ad-57b1-36ca-8a07-e55d18480970",
                    "sense_definition": "Relating to mental or spiritual thoughts rather than external actions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He found <w>inward</w> peace through daily meditation.",
                            "target_lang_translations": {
                                "zh": "他通过每日冥想获得了<w>内心</w>的平静。"
                            }
                        },
                        {
                            "text": "She kept her <w>inward</w> struggles hidden from her colleagues.",
                            "target_lang_translations": {
                                "zh": "她将自己的<w>内心</w>挣扎对同事们隐瞒了起来。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "与心理或精神思想有关，而非外部行为。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "内心的",
                                "target_lang_sense_clarification": "指与个人思想、情感或精神世界相关的。"
                            }
                        ]
                    }
                }
            ]
        },
        {
