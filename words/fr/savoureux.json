                    "semantic_group_id": "gustatif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce chef cuisinier prépare toujours un plat <w>savoureux</w> avec des légumes frais du potager.",
                            "target_lang_translations": {
                                "en": "This chef always prepares a <w>tasty</w> dish with fresh vegetables from the kitchen garden.",
                                "ru": "Этот повар всегда готовит <w>вкусное</w> блюдо из свежих овощей с огорода.",
                                "nl": "Deze chef-kok bereidt altijd een <w>lekker</w> gerecht met verse groenten uit de moestuin.",
                                "de": "Dieser Küchenchef bereitet immer ein <w>schmackhaftes</w> Gericht mit frischem Gemüse aus dem Küchengarten zu.",
                                "pl": "Ten szef kuchni zawsze przygotowuje <w>smaczne</w> danie z warzyw prosto z przydomowego ogródka.",
                                "it": "Questo chef prepara sempre un piatto <w>gustoso</w> con verdure fresche dell'orto.",
                                "cs": "Tento šéfkuchař vždy připravuje <w>chutné</w> jídlo z čerstvé zeleniny z domácí zahrádky.",
                                "tr": "Bu aşçı, bostanından topladığı taze sebzelerle her zaman <w>lezzetli</w> bir yemek hazırlar.",
                                "es": "Este chef siempre prepara un plato <w>sabroso</w> con verduras frescas del huerto.",
                                "zh": "这位厨师总是用菜园里的新鲜蔬菜做出<w>美味</w>的菜肴。"
                            }
                        },
                        {
                            "text": "La tarte aux fruits de ma grand-mère est particulièrement <w>savoureuse</w> quand elle sort du four.",
                            "target_lang_translations": {
                                "en": "My grandmother's fruit tart is especially <w>delicious</w> when it comes out of the oven.",
                                "ru": "Фруктовый пирог моей бабушки особенно <w>вкусен</w>, когда его вынимают из духовки.",
                                "nl": "De fruittaart van mijn grootmoeder is bijzonder <w>lekker</w> als hij uit de oven komt.",
                                "de": "Der Obstkuchen meiner Großmutter ist besonders <w>lecker</w>, wenn er aus dem Ofen kommt.",
                                "pl": "Tarta owocowa mojej babci jest szczególnie <w>pyszna</w>, gdy wyjmuje się ją z piekarnika.",
                                "it": "La crostata di frutta di mia nonna è particolarmente <w>gustosa</w> quando esce dal forno.",
                                "cs": "Ovocný koláč mé babičky je obzvlášť <w>chutný</w>, když vyjde z trouby.",
                                "tr": "Büyükannemin meyveli tartı fırından çıktığında özellikle <w>lezzetli</w> oluyor.",
                                "es": "La tarta de frutas de mi abuela está especialmente <w>rica</w> cuando sale del horno.",
                                "zh": "我祖母做的水果挞刚出炉时特别<w>好吃</w>。"
                            }
                        }
