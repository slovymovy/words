                ],
                "senses": [
                    {
                        "sense_id": "01d2d4e5-d3ba-3f3a-ac75-138ac4687cb0",
                        "entry_id": "579a0540-ec65-3063-8ba3-d35c508cbfc6",
                        "glosses": [
                            "Bezeichnung für Nebensätze/Gliedsätze, die als Subjektsatz, Objektsatz, Prädikativsatz, als indirekte Rede oder als sogenannter dass-Satz verwendet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15efae34-eb83-4bf5-8c02-b19fa5ec34a0",
                                "sense_id": "01d2d4e5-d3ba-3f3a-ac75-138ac4687cb0",
                                "text": "In dem Satz: „Ich will wissen, ob du rechtzeitig fertig wirst“ ist „ob du rechtzeitig fertig wirst“ der Inhaltssatz (= Objektsatz: Objekt zu „wissen“)."
                            },
                            {
                                "example_id": "39dc9e74-aa61-4344-bf1f-41be920dacde",
                                "sense_id": "01d2d4e5-d3ba-3f3a-ac75-138ac4687cb0",
                                "text": "Inhaltssatz ist ein Begriff der traditionellen Grammatik, der darauf abzielt, dass es sich um Teilsätze handelt, die wesentliche Informationen zum Gesamtsatz beitragen."
                            },
                            {
                                "example_id": "2a5e6efe-270f-44f2-a2a4-7d9e8a88036d",
                                "sense_id": "01d2d4e5-d3ba-3f3a-ac75-138ac4687cb0",
                                "text": "„Unter der (nicht gerade selbsterklärenden) Bezeichnung Inhaltssatz werden Nebensätze zusammengefasst, die weder zu den Relativsätzen noch zu den Adverbialsätzen gehören.“"
                            },
                            {
                                "example_id": "9cd8797f-2c94-486e-a8a0-099c4f6bb035",
                                "sense_id": "01d2d4e5-d3ba-3f3a-ac75-138ac4687cb0",
                                "text": "„Weil die dass-Sätze Inhalte von notwendigen Satzgliedern wiedergeben, nennt man sie auch Inhaltssätze.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
