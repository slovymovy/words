                "forms": [
                    {
                        "form_id": "c5faacbd-416f-4614-8577-f53cb712f744",
                        "entry_id": "91b8828b-3e06-3d69-a6aa-8f8b1e8af8c0",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "psychrophiles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "660c8a68-a0b7-380b-94fe-81d902701d91",
                        "entry_id": "91b8828b-3e06-3d69-a6aa-8f8b1e8af8c0",
                        "glosses": [
                            "Qualifie un être vivant qui peut encore se développer à basse température (jusqu’à 0°C voire moins), mais dont la température de développement optimale est beaucoup plus élevée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50f47791-cf74-49eb-885f-6ce7a59c0c3f",
                                "sense_id": "660c8a68-a0b7-380b-94fe-81d902701d91",
                                "text": "Quelles pourraient-être les propriétés spéciales d’une enzyme isolée à partir d’une bactérie psychrophile ?"
                            },
                            {
                                "example_id": "7178ee46-2fb8-4b4f-816d-eecd07c93971",
                                "sense_id": "660c8a68-a0b7-380b-94fe-81d902701d91",
                                "text": "Durant cette étude, il a choisi deux archéobactéries dites mésophiles, Methanosarcina acetivorans (méthanogène) et Halobacterium sp. souche NRC-1 (halophile), ainsi que deux archéobactéries psychrophiles (capables de se développer à basse température) collectées dans des lacs de l’Antarctique : Methanococcoides burtonii (méthanogène) et Halorubrum lacusprofundi (halophile)."
                            }
                        ]
                    },
                    {
                        "sense_id": "523f9ba9-01b5-352d-be5c-3e6eeb4015cf",
                        "entry_id": "91b8828b-3e06-3d69-a6aa-8f8b1e8af8c0",
                        "glosses": [
                            "Qualifie un organisme qui ne peut se développer qu’à basse température (moins de 20°C), et dont la croissance est arrêtée à des températures plus élevées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee891227-cebb-4da1-9c85-871f6565ab07",
                                "sense_id": "523f9ba9-01b5-352d-be5c-3e6eeb4015cf",
                                "text": "On appelle ces espèces, des plantes psychrophiles : elles ont une croissance maximale à des températures comprises entre 0°C et 10°C. Comme la baie de mai (chèvrefeuille comestible appelé également myrtille de Sibérie)."
                            }
                        ]
                    }
                ],
                "translations": [],
