                                "target_senses": [
                                    {
                                        "sense_id": "7d0b828b-91b0-3678-b064-c37e5ca020f4",
                                        "entry_id": "7aac9b9d-24c8-3b0d-ba8f-d11308a7e619",
                                        "glosses": [
                                            "A melody."
                                        ],
                                        "tags": [
                                            "countable",
