                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dee1c20e-4eb7-3ff9-b659-342771ec3c9c",
                                        "entry_id": "fc325434-f1e7-36a8-ad22-5139452dfc89",
                                        "glosses": [
                                            "An animal or human, or the flesh thereof, that has been badly injured as a result of an accident or conflict."
                                        ],
                                        "tags": [
                                            "US",
                                            "colloquial",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "808b50de-ea87-4fac-8a98-e848fb2b88c7",
                                                "sense_id": "dee1c20e-4eb7-3ff9-b659-342771ec3c9c",
                                                "text": "The truck hit the deer and turned it into hamburger."
                                            },
                                            {
                                                "example_id": "81f1f0c2-eb5b-4291-a513-983992ec0aac",
                                                "sense_id": "dee1c20e-4eb7-3ff9-b659-342771ec3c9c",
                                                "text": "I'm going to make you into hamburger if you do that again."
                                            }
                                        ]
                                    },
