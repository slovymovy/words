                    {
                        "translation_id": "9f73890c-4329-4301-b8fc-0e781d9de0a5",
                        "source_entry_id": "4ebef2db-6e02-338c-862f-b11408401c69",
                        "source_sense_id": "2a43d683-a82c-3925-b68d-f8ec24cfcd0e",
