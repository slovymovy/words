                "senses": [
                    {
                        "sense_id": "8bc41dbb-f294-3530-8da9-db240985f1bc",
                        "entry_id": "ad0c69e0-9b9c-31f8-872d-a4868d8d6321",
                        "glosses": [
                            "een tas waarin de benodigdheden zitten voor een arts om buiten de praktijkruimte zijn werkzaamheden te kunnen verrichten, zoals het toepassen van eerste hulp"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2721418-b7fd-4f09-adcc-b97be7755e8f",
                                "sense_id": "8bc41dbb-f294-3530-8da9-db240985f1bc",
                                "text": "Henry kwam aan in zijn nachthemd & met zijn dokterstas. Hij knielde bij de verminkte gedaante & voelde de pols, maar schudde het hoofd. 'Deze man heeft geen dokter nodig.'"
                            },
                            {
                                "example_id": "300b693a-ad04-4b7a-895f-b426db250721",
                                "sense_id": "8bc41dbb-f294-3530-8da9-db240985f1bc",
                                "text": "Ik zat nog steeds op het dak en kwam in beweging om vader te hulp te snellen, toen de dierenarts riep: 'Jacqueline! Neem mijn dokterstas, en snel!'"
                            },
                            {
                                "example_id": "897d00de-71a3-4e54-8510-b3a0237a6581",
                                "sense_id": "8bc41dbb-f294-3530-8da9-db240985f1bc",
                                "text": "Hoeveel innovaties er ook zijn, uiteindelijk blijft M. V. gewoon een traditionele dokter. Een dokter met een al even traditionele tas. Een groot, roodbruin ‘gevaarte’. „Die heb ik al sinds ik de opleiding voor huisarts begon”, zegt Vloedbeld, terwijl ze de dokterstas openklapt. Met uiteraard de stethoscoop, een nog altijd onmisbaar instrument en daaronder allerlei kleinere tasjes en opbergdoosjes. „Voor ampullen met medicatie, zodat ik in een noodgeval de patiënt stabiel kan houden tot de ambulance er is.” Elke keer een uitdaging. „En dat is direct het allermooiste aan dit werk. Ik zou niet anders willen.”"
                            }
                        ]
                    }
