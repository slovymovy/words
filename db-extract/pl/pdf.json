                                "example_id": "44ffe68b-7e3c-4b18-807b-4c538967c911",
                                "sense_id": "4831905d-f052-3237-b521-9d6b2b55675c",
                                "text": "Prenumerujący mają możliwość przeglądania dziennika w formacie PDF i w wersji tekstowej."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "3d09cc5d-bcad-3921-a9c2-7aa29b6a9270",
                        "entry_id": "0e6eb463-1498-3fcc-840b-cb51651bbba3",
                        "glosses": [
