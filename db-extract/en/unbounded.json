                                "sense_id": "7ccad9c1-591b-3bb9-945c-eb3d36c481ee",
                                "text": "The universe is finite but unbounded."
                            },
                            {
                                "example_id": "ba78d748-5e62-4ff1-9adc-ef7d29b973b8",
                                "sense_id": "7ccad9c1-591b-3bb9-945c-eb3d36c481ee",
                                "text": "our everlasting, unbounded love"
                            },
                            {
