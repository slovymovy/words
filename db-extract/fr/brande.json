        "fr-extract.jsonl": [
            {
                "entry_id": "06785773-b0a1-33a8-8f9b-516abce2658f",
                "word": "brande",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0e5b9162-312e-4e31-855a-5c1cd3857b83",
                        "entry_id": "06785773-b0a1-33a8-8f9b-516abce2658f",
                        "tags": [
                            "plural"
                        ],
                        "form": "brandes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "52c89e60-7816-35b2-90d0-d9d17022320d",
                        "entry_id": "06785773-b0a1-33a8-8f9b-516abce2658f",
                        "glosses": [
                            "Bruyère à balais."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc713d5d-67ad-49a3-a6d1-590295e48b26",
                                "sense_id": "52c89e60-7816-35b2-90d0-d9d17022320d",
                                "text": "Un pays de brandes."
                            },
                            {
                                "example_id": "39644c51-eba1-41f8-8c82-f0a96bee30b3",
                                "sense_id": "52c89e60-7816-35b2-90d0-d9d17022320d",
                                "text": "Chauffer le four avec des brandes."
                            },
                            {
                                "example_id": "a81af132-3590-4e79-96b8-b9896b4bb3c0",
                                "sense_id": "52c89e60-7816-35b2-90d0-d9d17022320d",
                                "text": "[…] on voit partout de vastes étendues de brandes dans lesquelles ne croissent que des bruyères et des genêts. Là où les brandes cessent, les landes commencent ; et sur ces landes élevées les vents âpres rabougrissent les maigres bouquets d’arbres qui dressent çà et là leurs branches tordues et tourmentées."
                            },
                            {
                                "example_id": "10f843ba-4d1b-4f67-9e99-d97e5868cab6",
                                "sense_id": "52c89e60-7816-35b2-90d0-d9d17022320d",
                                "text": "Au plus épais d’une famille, elle allait couver, pareille à un feu sournois qui rampe sous la brande, embrase un pin, puis l’autre, puis de proche en proche crée une forêt de torches."
                            }
                        ]
                    },
                    {
                        "sense_id": "e91e5636-6097-307a-a623-602be15ba785",
                        "entry_id": "06785773-b0a1-33a8-8f9b-516abce2658f",
                        "glosses": [
                            "Lieux incultes où croissent çà et là ces sortes de petits arbustes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0346852-c388-42aa-8a16-1cf5ceb8dcd1",
                                "sense_id": "e91e5636-6097-307a-a623-602be15ba785",
                                "text": "Toutes ses plantes grillées, ses feuillages asphyxiés, ses racines bloquées dans un sous-sol aussi compact que la pierre, la terre brûlait, et craquelait, elle fumait, crépitait, grésillait. Des incendies s’allumaient spontanément dans les brandes."
                            },
                            {
                                "example_id": "e6f83eed-7399-4dbc-9dd1-aed0b5fcfe23",
                                "sense_id": "e91e5636-6097-307a-a623-602be15ba785",
                                "text": "Dans ce cas, le préfet peut limiter l’étendue de la battue : en juin 1840, « une battue est nécessaire sur les communes de Bouesse et Mosnay, mais en raison de l’avancement de la saison, ces chasses doivent être restreintes aux bois qui sont entourés de brandes ou de chemins publics, afin de n’exposer les récoltes à aucun dommage. »"
                            }
                        ]
                    },
                    {
                        "sense_id": "beb72713-8671-3f21-872e-31f7773dadb3",
                        "entry_id": "06785773-b0a1-33a8-8f9b-516abce2658f",
                        "glosses": [
                            "Maladie de la vigne."
                        ],
                        "tags": [
                            "Auvergne"
                        ],
                        "examples": [
                            {
                                "example_id": "22ab4eeb-8942-48d6-81d0-0f80caa43753",
                                "sense_id": "beb72713-8671-3f21-872e-31f7773dadb3",
                                "text": "On dit que la vigne a la brande ou est brandée, lorsque ses feuilles rougissent, se dessèchent et tombent."
                            }
                        ]
                    }
                ],
