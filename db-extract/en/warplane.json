                                    {
                                        "sense_id": "3d8af752-2f27-35a3-be57-765130dd81bc",
                                        "entry_id": "c91bfd60-60bf-3879-87b3-82dd520c414e",
                                        "glosses": [
                                            "Flugzeug, das für militärische Einsätze bewaffnet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7766b146-88d2-48fa-9b89-73aef02e34ea",
                                                "sense_id": "3d8af752-2f27-35a3-be57-765130dd81bc",
                                                "text": "Die gegnerischen Stellungen werden laufend mit Kampfflugzeugen angegriffen."
                                            },
                                            {
                                                "example_id": "1f1956dc-bfae-4187-af8e-bfd7a94c0163",
                                                "sense_id": "3d8af752-2f27-35a3-be57-765130dd81bc",
                                                "text": "„Die Nato verdreifacht angesichts der Ukraine-Krise die Zahl ihrer Kampfflugzeuge im Baltikum.“"
                                            },
                                            {
                                                "example_id": "7c994ff0-5822-49b3-b1ec-741e29c3a4ca",
                                                "sense_id": "3d8af752-2f27-35a3-be57-765130dd81bc",
                                                "text": "„Nato-Generalsekretär Jens Stoltenberg hatte Moskau mehrfach scharf kritisiert, weil russische Kampfflugzeuge ohne eingeschaltete Transponder an den Nato-Grenzen flögen und damit den zivilen Luftverkehr gefährdeten.“"
                                            },
                                            {
                                                "example_id": "79c6ee38-a610-4479-b578-e8ebf9df5bc1",
                                                "sense_id": "3d8af752-2f27-35a3-be57-765130dd81bc",
                                                "text": "„Tag und Nacht donnerten Kampfflugzeuge über das Dorf hinweg, und das Stakkato der Artillerie hallte über die Hügel und schien von allen Seiten zu kommen.“"
                                            }
                                        ],
