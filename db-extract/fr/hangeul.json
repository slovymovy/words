                                "target_senses": [
                                    {
                                        "sense_id": "ed36b927-f1e3-3249-8fc5-012d2da517e3",
                                        "entry_id": "fd1adc65-0443-33d1-8f0a-5192267ed003",
                                        "glosses": [
                                            "한국 고유의 글자이자 문자."
                                        ],
                                        "tags": [],
                                        "note": "한글 자모",
                                        "examples": [
                                            {
                                                "example_id": "edb33ab2-7c73-43ab-b7f1-cc83268aeeab",
                                                "sense_id": "ed36b927-f1e3-3249-8fc5-012d2da517e3",
                                                "text": "한글은 창제 당시 총 28개의 자모가 있었지만 지금은 24개만 사용한다."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05c70139-bc7a-3715-a08b-8aebacab9dc4",
                                        "entry_id": "fd1adc65-0443-33d1-8f0a-5192267ed003",
                                        "glosses": [
                                            "(드물게) '한국어'를 일컬을 때 쓰는 말."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8ba6c40-427c-4c83-9530-f29ee6f19d4d",
                                                "sense_id": "05c70139-bc7a-3715-a08b-8aebacab9dc4",
                                                "text": "(무분별한 신조어 사용을 지적하며) 한글을 바르게 써라."
                                            },
                                            {
                                                "example_id": "e9b3caa2-4aa0-4409-a82a-550a4a36c65f",
                                                "sense_id": "05c70139-bc7a-3715-a08b-8aebacab9dc4",
                                                "text": "이렇게 외래어를 자주 쓰다가는 한글을 아예 빼앗겨 버리겠어요."
                                            },
                                            {
                                                "example_id": "10c8446b-9dbd-435c-8e72-d8e3141cd930",
                                                "sense_id": "05c70139-bc7a-3715-a08b-8aebacab9dc4",
                                                "text": "몇몇 해외 사이트에서는 한글 서비스도 제공하고 있다."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cea7b455-97c3-3b9a-baf7-560aaeb31826",
                                        "entry_id": "fd1adc65-0443-33d1-8f0a-5192267ed003",
                                        "glosses": [
                                            "(드물게, 뒤따르는 명사를 수식하여) '토박이말'을 일컬을 때 쓰는 말."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bcbbdc5-46ed-4c06-b2bf-96107d31642c",
                                                "sense_id": "cea7b455-97c3-3b9a-baf7-560aaeb31826",
                                                "text": "자식 이름을 한글 이름으로 짓는 것이 유행이다."
                                            },
                                            {
                                                "example_id": "dbabad89-7ab8-4d37-a0d4-7dc7dabcebea",
                                                "sense_id": "cea7b455-97c3-3b9a-baf7-560aaeb31826",
                                                "text": "철수는 일제 시대 때 잃어버린 한글 지명을 되찾자는 운동을 하고 있다."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
