                    {
                        "sense_id": "a1529366-9d9d-300c-8bf8-1ccf1e24ca2d",
                        "entry_id": "50503438-2ba4-301e-b034-e7ede6a45a16",
                        "glosses": [
                            "Produit destiné à l’élimination des rongeurs considérés comme nuisibles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55da3010-9d63-4605-b529-2a174a73fc31",
                                "sense_id": "a1529366-9d9d-300c-8bf8-1ccf1e24ca2d",
                                "text": "Du fait de leur faible volume sanguin et de leur rythme cardiaque élevé, les rongeurs sont sensibles aux rodonticides à base d’anticoagulants."
                            },
                            {
                                "example_id": "dd8397fa-e718-4078-811a-800827d37cad",
                                "sense_id": "a1529366-9d9d-300c-8bf8-1ccf1e24ca2d",
                                "text": "Mais l’estomac des rongeurs retrouvés morts, intoxiqués par un rodenticide, intéresse également le scientifique."
                            },
                            {
                                "example_id": "1adb4634-8b93-4270-b07f-975a6ab6ed7e",
                                "sense_id": "a1529366-9d9d-300c-8bf8-1ccf1e24ca2d",
                                "text": "les rodonticides sont formulés sous diverses déclinaisons sur un base de céréales et de corps gras servant de liant que l’on nome \"appâts\", ceux-ci sont présentés sous forme de blocs, sachets de \"pâtes fraiches\" ou pellets principalement."
                            }
                        ]
                    }
