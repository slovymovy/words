{
    "word_family": [
        "progression",
        "progressive",
        "progressively"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7c26ab3d-8b86-3881-986d-523f7457f4dc",
                    "sense_definition": "Advancement to a higher or more developed state; development, growth, or improvement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "development",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Science has made extraordinary <w>progress</w> in the last fifty years.",
                            "target_lang_translations": {
                                "ru": "Наука достигла невероятного <w>прогресса</w> за последние пятьдесят лет.",
                                "zh": "过去五十年里，科学取得了非凡的<w>进步</w>。"
                            }
                        },
                        {
                            "text": "She is happy with the <w>progress</w> she has made in learning French.",
                            "target_lang_translations": {
                                "ru": "Она довольна <w>прогрессом</w>, которого достигла в изучении французского.",
                                "zh": "她对自己学习法语所取得的<w>进步</w>感到满意。"
                            }
                        }
                    ],
                    "synonyms": [
                        "advancement",
                        "development",
                        "growth",
                        "improvement",
                        "headway",
                        "breakthrough"
                    ],
                    "antonyms": [
                        "regress"
                    ],
                    "common_phrases": [
                        "make progress",
                        "significant progress",
                        "technological progress",
                        "rapid progress"
                    ],
                    "target_lang_definitions": {
                        "ru": "Переход на более высокую ступень развития; развитие, рост или улучшение.",
                        "zh": "向更高发展阶段的迈进；发展、成长或改善。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прогресс",
                                "target_lang_sense_clarification": "общее значение, движение вперед"
                            },
                            {
                                "target_lang_word": "развитие",
                                "target_lang_sense_clarification": "процесс роста и совершенствования"
                            },
                            {
                                "target_lang_word": "успех",
                                "target_lang_sense_clarification": "достижение положительного результата"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "进步",
                                "target_lang_sense_clarification": "指在学业、工作或能力上的提升"
                            },
                            {
                                "target_lang_word": "发展",
                                "target_lang_sense_clarification": "指事物由小到大、由简单到复杂的变化"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13121f66-dd1b-3593-8d1e-7012ea1af5a8",
                    "sense_definition": "Movement or advancement through a series of events or points in time; the state of currently happening.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Testing for the new antidote is currently in <w>progress</w>.",
                            "target_lang_translations": {
                                "ru": "Тестирование нового антидота в данный момент находится в <w>процессе</w>.",
                                "zh": "新解毒剂的测试目前正在<w>进行</w>中。"
                            }
                        },
                        {
                            "text": "Please do not disturb the meeting while it is in <w>progress</w>.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не мешайте проведению собрания, пока оно <w>идёт</w>.",
                                "zh": "会议正在<w>进行</w>，请勿打扰。"
                            }
                        }
                    ],
                    "synonyms": [
                        "course",
                        "process",
                        "passage",
                        "continuation"
                    ],
                    "common_phrases": [
                        "in progress",
                        "work in progress"
                    ],
                    "target_lang_definitions": {
                        "ru": "Движение или развитие через ряд событий или моментов времени; состояние текущего выполнения.",
                        "zh": "通过一系列事件或时间点的移动或推进；当前正在发生的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ход",
                                "target_lang_sense_clarification": "течение событий"
                            },
                            {
                                "target_lang_word": "процесс",
                                "target_lang_sense_clarification": "состояние выполнения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "进行",
                                "target_lang_sense_clarification": "指活动或事件正在开展"
                            },
                            {
                                "target_lang_word": "过程",
                                "target_lang_sense_clarification": "指事物发展所经过的程序或阶段"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5fbc9126-13d6-326e-bdec-244aa30ec692",
                    "sense_definition": "Movement onwards, forwards, or towards a specific objective or direction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thick branches overhanging the path made <w>progress</w> difficult.",
                            "target_lang_translations": {
                                "ru": "Густые ветки, нависающие над тропой, затрудняли <w>продвижение</w>.",
                                "zh": "悬在小路上的粗树枝使<w>前进</w>变得困难。"
                            }
                        },
                        {
                            "text": "The ship made slow <w>progress</w> against the strong wind.",
                            "target_lang_translations": {
                                "ru": "Корабль медленно <w>продвигался</w> против сильного ветра.",
                                "zh": "船在强风中缓慢地<w>前进</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "advance",
                        "headway",
                        "movement"
                    ],
                    "antonyms": [
                        "regress"
                    ],
                    "common_phrases": [
                        "slow progress",
                        "make progress"
                    ],
                    "target_lang_definitions": {
