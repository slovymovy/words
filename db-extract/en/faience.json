            {
                "entry_id": "8f9fb562-8a23-345a-8645-910c55f68129",
                "word": "faience",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "add4ce05-5e51-4728-9a0c-1e070f1d43d7",
