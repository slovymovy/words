                    ]
                },
                {
                    "sense_id": "77799f91-bcff-3838-ad2f-7418cb154eeb",
                    "sense_definition": "Considérer, estimer ou juger quelque chose d'une certaine façon.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "jugement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je <w>trouve</w> ce nouveau roman vraiment passionnant du début à la fin."
                        },
                        {
                            "text": "Comment <w>trouves</w>-tu la couleur de cette veste d'hiver ?"
                        }
                    ],
                    "common_phrases": [
