    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ce676c9f-003d-3d0a-9e8e-eb0cae4b5770",
                    "sense_definition": "Accès de colère violent et incontrôlable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "colere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Quand elle a découvert cette injustice, elle est entrée dans une véritable <w>furie</w>."
                        },
                        {
                            "text": "Face aux provocations de son adversaire, il n'a pas pu contenir sa <w>furie</w>."
                        }
                    ],
                    "common_phrases": [
                        "entrer en furie",
                        "être en furie"
                    ]
                },
                {
                    "sense_id": "4410c751-dd28-3607-a983-29320bdd1cf6",
                    "sense_definition": "Grande violence et déchaînement impétueux d'un phénomène naturel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les marins ont lutté toute la nuit contre la <w>furie</w> des flots."
                        },
                        {
                            "text": "Le vieux pont de pierre n'a pas survécu à la <w>furie</w> de la tempête."
                        }
                    ],
                    "common_phrases": [
                        "furie des flots",
                        "furie de la tempête"
                    ]
                },
                {
                    "sense_id": "9bed7968-7d52-3844-b3e5-90a896551ad9",
                    "sense_definition": "Femme particulièrement colérique, agressive et méchante.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès qu'on la contredisait au bureau, elle se transformait en une redoutable <w>furie</w>."
                        },
                        {
                            "text": "Cette voisine passe son temps à hurler sur les passants comme une vraie <w>furie</w>."
                        }
                    ],
                    "synonyms": [
                        "harpie",
                        "mégère",
                        "gorgone"
                    ]
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "1c9bfff3-cec7-36f8-9031-3dc3705b4c15",
                    "sense_definition": "Divinité infernale de la mythologie romaine préposée au châtiment des criminels.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mythologie",
                    "name_type": "mythological_or_astrological_entity",
                    "examples": [
                        {
                            "text": "Dans la mythologie classique, le criminel était pourchassé sans trêve par chaque <w>Furie</w>."
                        },
                        {
                            "text": "Le peintre a représenté une <w>Furie</w> tenant des serpents et un fouet vengeur."
                        }
                    ],
                    "synonyms": [
                        "Érinyes",
                        "Euménides",
                        "Chiennes d'Hadès"
                    ]
                }
            ]
        }
    ]
}