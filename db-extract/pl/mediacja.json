                    {
                        "translation_id": "e3040c58-0e6c-4ad3-aadf-1d2eec15d6bf",
                        "source_entry_id": "e6f1f130-4239-31a3-ae37-985738e4792e",
                        "source_sense_id": "72491f6c-ae4a-3008-8da4-85841010a83b",
                        "target_lang_word": "médiation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "médiation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "57433abd-26ec-3d32-bf8b-dd3517c0c1ef",
                                        "entry_id": "9eda564f-3aa4-3378-bc71-aa925f97bf80",
                                        "glosses": [
                                            "Moyen indirect par lequel on fait connaître un message ou une intention."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecc59602-4fc5-46e1-9089-79c9c1869f26",
                                                "sense_id": "57433abd-26ec-3d32-bf8b-dd3517c0c1ef",
                                                "text": "Mais Dieu se fait connaître à travers des médiations sensibles comme la pratique de l'hospitalité, qui est l'exercice même de l'amour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ca9b48c-b63a-3f2c-9d51-01a79e1d6792",
                                        "entry_id": "9eda564f-3aa4-3378-bc71-aa925f97bf80",
                                        "glosses": [
                                            "Entremise pour mettre d’accord deux personnes, deux partis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28bf3741-d293-4b15-8f85-cb8c2f2a9384",
                                                "sense_id": "3ca9b48c-b63a-3f2c-9d51-01a79e1d6792",
                                                "text": "Cet accommodement a été fait par la médiation de tel homme d’État."
                                            },
                                            {
                                                "example_id": "d89d632e-b26f-4656-8d28-2f1604b01241",
                                                "sense_id": "3ca9b48c-b63a-3f2c-9d51-01a79e1d6792",
                                                "text": "On s’est servi de sa médiation."
                                            },
                                            {
                                                "example_id": "9f41e60e-08c9-435c-81a8-a290d0f3f45a",
                                                "sense_id": "3ca9b48c-b63a-3f2c-9d51-01a79e1d6792",
                                                "text": "Il a offert, on a accepté, on a refusé sa médiation."
                                            },
                                            {
                                                "example_id": "aeb477db-ced6-4ca5-a5b1-f978079a5acd",
                                                "sense_id": "3ca9b48c-b63a-3f2c-9d51-01a79e1d6792",
                                                "text": "« Médiation armée » s’est dit de l’Acte de médiation dans lequel la puissance qui s’entremet entre les belligérants menace de faire la guerre à celle des deux parties qui n’acceptera pas ses propositions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5a0b85d-516d-3304-880e-f7f5ff15541d",
                                        "entry_id": "9eda564f-3aa4-3378-bc71-aa925f97bf80",
                                        "glosses": [
                                            "Recherche de conciliation entre deux parties avant une action en justice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a9cd350-c9be-4670-8bf9-d02d8c7735cb",
                                                "sense_id": "b5a0b85d-516d-3304-880e-f7f5ff15541d",
                                                "text": "Tout médiateur de la consommation met en place un site Internet consacré à la médiation et fournissant un accès direct aux informations relatives au processus de médiation. Ce site permet aux consommateurs de déposer en ligne une demande de médiation accompagnée des documents justificatifs."
                                            },
                                            {
                                                "example_id": "a0a510b9-e896-4054-9864-62573ce3654b",
                                                "sense_id": "b5a0b85d-516d-3304-880e-f7f5ff15541d",
                                                "text": "« Nous faisons de plus en plus de médiation avec les bailleurs ou les fournisseurs d’énergie pour étaler les impayés », remarque Fathia, qui accompagne 80 familles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee777c8b-293a-33cd-8d74-55dc50c56885",
                                        "entry_id": "9eda564f-3aa4-3378-bc71-aa925f97bf80",
                                        "glosses": [
                                            "Communication entre une institution culturelle, un artiste, et le public."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fdfc02b-6227-4af8-b061-fb50c201f2b2",
                                                "sense_id": "ee777c8b-293a-33cd-8d74-55dc50c56885",
                                                "text": "Notre société s’est dotée d’un service de médiation culturelle exclusivement dédié à la valorisation et à la diffusion du patrimoine archéologique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
