                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "belirgin",
                                "target_lang_sense_clarification": "gözle görülür, bariz"
                            },
                            {
                                "target_lang_word": "ciddi",
                                "target_lang_sense_clarification": "önemli ölçüde, yadsınamaz"
                            },
                            {
                                "target_lang_word": "kesin",
                                "target_lang_sense_clarification": "şüphesiz"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b92bc38a-4d71-30e4-ba0d-21cd204dc029",
                    "sense_definition": "Отчётливо очерченный, резкий, нерасплывчатый.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "clear_and_distinct",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "С годами черты его лица стали более <w>определёнными</w> и мужественными.",
                            "target_lang_translations": {
                                "tr": "Yıllar geçtikçe yüz hatları daha <w>belirgin</w> ve erkeksi bir hal aldı."
                            }
                        },
                        {
                            "text": "На горизонте показались <w>определённые</w> контуры далёких кавказских гор.",
                            "target_lang_translations": {
                                "tr": "Ufukta uzak Kafkas dağlarının <w>net</w> siluetleri belirdi."
                            }
                        }
                    ],
                    "common_phrases": [
                        "определённые черты"
                    ],
                    "target_lang_definitions": {
                        "tr": "Net bir şekilde çizilmiş, keskin, bulanık olmayan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "belirgin",
                                "target_lang_sense_clarification": "netleşmiş, keskinleşmiş"
                            },
                            {
                                "target_lang_word": "net",
                                "target_lang_sense_clarification": "keskin hatlı"
                            }
                        ]
                    }
                }
            ]
        },
        {
