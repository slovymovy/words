    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f4dbe105-85e0-3c0a-8bfb-5da909dc562c",
                    "sense_definition": "Przednia część głowy człowieka; twarz, często w kontekście podniosłym, literackim lub wyrażającym emocje.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "face_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jego surowe <w>oblicze</w> nie zdradzało w tej chwili żadnych emocji.",
                            "target_lang_translations": {
                                "ru": "Его суровое <w>лицо</w> в этот момент не выдавало никаких эмоций.",
                                "en": "His stern <w>countenance</w> betrayed no emotion at that moment."
                            }
                        },
                        {
                            "text": "Wszyscy zebrani patrzyli na pogodne <w>oblicze</w> króla z nadzieją.",
                            "target_lang_translations": {
                                "ru": "Все собравшиеся с надеждой смотрели на безмятежное <w>лицо</w> короля.",
                                "en": "All those gathered looked upon the king's serene <w>face</w> with hope."
                            }
                        }
                    ],
                    "synonyms": [
                        "twarz",
                        "lico",
                        "fizjonomia"
                    ],
                    "common_phrases": [
                        "pogodne oblicze",
                        "kamienne oblicze",
                        "surowe oblicze"
                    ],
                    "target_lang_definitions": {
                        "ru": "Передняя часть головы человека; лицо, часто в возвышенном, литературном контексте или при описании эмоций.",
                        "en": "The front part of a person's head; face, often used in a literary, elevated context or to convey emotion."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лицо",
                                "target_lang_sense_clarification": "передняя часть головы"
                            },
                            {
                                "target_lang_word": "лик",
                                "target_lang_sense_clarification": "возвышенно, литературно"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "face",
                                "target_lang_sense_clarification": "front part of the head; expression"
                            },
                            {
                                "target_lang_word": "countenance",
                                "target_lang_sense_clarification": "literary; facial appearance or expression"
                            },
                            {
                                "target_lang_word": "visage",
                                "target_lang_sense_clarification": "literary; a person's face"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c5ad984-a06c-3501-b53c-8ed35d27bc1e",
                    "sense_definition": "Charakter, natura lub wygląd zewnętrzny jakiegoś zjawiska, rzeczy lub sytuacji.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "face_abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kryzys gospodarczy pokazał swoje prawdziwe <w>oblicze</w> w najbiedniejszych regionach.",
                            "target_lang_translations": {
                                "ru": "Экономический кризис показал свое истинное <w>лицо</w> в самых бедных регионах.",
                                "en": "The economic crisis revealed its true <w>face</w> in the poorest regions."
                            }
                        },
                        {
                            "text": "Po remoncie stary dworzec zyskał zupełnie nowe, nowoczesne <w>oblicze</w>.",
                            "target_lang_translations": {
                                "ru": "После ремонта старый вокзал обрёл совершенно новый, современный <w>облик</w>.",
                                "en": "After the renovation, the old train station took on an entirely new, modern <w>look</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "twarz",
                        "charakter"
                    ],
                    "common_phrases": [
                        "prawdziwe oblicze",
                        "zmienić oblicze",
                        "w obliczu"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характер, сущность или внешний вид какого-либо явления, предмета или ситуации.",
                        "en": "The character, nature, or outward appearance of a phenomenon, thing, or situation."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лицо",
                                "target_lang_sense_clarification": "перен. сущность, характер"
                            },
                            {
                                "target_lang_word": "облик",
                                "target_lang_sense_clarification": "внешний вид, образ"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "face",
                                "target_lang_sense_clarification": "aspect, character, or appearance of something"
                            },
