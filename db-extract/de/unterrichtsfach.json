                ],
                "translations": [
                    {
                        "translation_id": "d56bdcac-4cb9-4cfe-845e-44fec1a3fffa",
                        "source_entry_id": "2ef90cd2-7792-3bf9-ad7a-4b00ee9e1256",
                        "source_sense_id": "626e6249-0518-3442-b301-b3351e70d0bc",
                        "source_sense_description": "Lehrfach in Schulen (nach gesetzlichen Bestimmungen)",
                        "target_lang_word": "school subject",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6d2cc39c-f5cc-433b-ba36-36cde123ae9f",
                        "source_entry_id": "2ef90cd2-7792-3bf9-ad7a-4b00ee9e1256",
                        "source_sense_id": "626e6249-0518-3442-b301-b3351e70d0bc",
                        "source_sense_description": "Lehrfach in Schulen (nach gesetzlichen Bestimmungen)",
                        "target_lang_word": "matière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "matière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c8839fe-d7fd-3a55-b722-48fe1e547991",
                                        "entry_id": "922fa2f6-3045-3308-8d8e-2f04b0b39571",
                                        "glosses": [
                                            "Ce qui a de la masse et occupe de l’espace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19f29b0c-5122-46b5-95c5-fca6f0e2244e",
                                                "sense_id": "7c8839fe-d7fd-3a55-b722-48fe1e547991",
                                                "text": "Le jus contient, en outre du principe sucré, une foule de matières étrangères dont quelques-unes sont susceptibles de fermenter et d'altérer le sucre."
                                            },
                                            {
                                                "example_id": "5298dd10-635c-4f2e-a96f-afed046578e9",
                                                "sense_id": "7c8839fe-d7fd-3a55-b722-48fe1e547991",
                                                "text": "J’ai vu, dans ma longue carrière d’ingénieur acousticien, bien des matières excellentes conductrices du son, mais jamais je n’en rencontrerai une seule comparable, même de loin, à celle dont sont pétris les murs de l’hôtel Terminus à Marseille."
                                            },
                                            {
                                                "example_id": "7a48a882-6aa6-4be7-859d-374470071ef4",
                                                "sense_id": "7c8839fe-d7fd-3a55-b722-48fe1e547991",
                                                "text": "Ce n’est pas parce qu’une matière a telle ou telle disposition qu’elle est unie à telle forme ; c’est l’inverse qui est vrai : pour que la forme soit telle, il importe que la matière soit optimalement disposée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b43cd1ae-7d62-32d2-8206-ac50ec65e968",
                                        "entry_id": "922fa2f6-3045-3308-8d8e-2f04b0b39571",
                                        "glosses": [
                                            "Ce dont une chose est faite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0280096f-6987-4450-99c7-37a2ea8e5098",
                                                "sense_id": "b43cd1ae-7d62-32d2-8206-ac50ec65e968",
                                                "text": "D'après MM. Pelletier et Caventou, le carmin est un composé de la matière colorante de la cochenille, d’une matière animale qui y est également renfermée, et des éléments du sel qu’on y ajoute pour en déterminer la précipitation."
                                            },
                                            {
                                                "example_id": "fe192df7-6ab0-4030-a6e7-3b582b4faf5c",
                                                "sense_id": "b43cd1ae-7d62-32d2-8206-ac50ec65e968",
                                                "text": "Matières d’or et d’argent, Les espèces fondues, les lingots et les barres employés pour la fabrication des monnaies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4314c334-5a5b-372f-82f6-1e50b7ce91e2",
                                        "entry_id": "922fa2f6-3045-3308-8d8e-2f04b0b39571",
                                        "glosses": [
                                            "Substance étendue, divisible et susceptible de recevoir toute sorte de formes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50581606-1998-43e5-8ec6-6adffe4ed405",
                                                "sense_id": "4314c334-5a5b-372f-82f6-1e50b7ce91e2",
                                                "text": "Nous pourrions leur répondre que la matière dont parlent les matérialistes, matière spontanément. éternellement mobile, active, productive, matière chimiquement ou organiquement déterminée, et manifestée par les propriétés ou les forces mécaniques, physiques, animales et intelligentes qui lui sont foncièrement inhérentes, que cette matière n'a rien de commun avec la vile matière des idéalistes. Cette dernière, produit de leur fausse abstraction, est effectivement un être stupide, inanimé, immobile, incapable de produire la moindre des choses, un caput mortuum, une vilaine imagination opposée à cette belle imagination qu'ils appellent Dieu, l'Être suprême vis-à-vis duquel la matière, leur matière à eux, dépouillée par eux-mêmes de tout ce qui en constitue la nature réelle, représente nécessairement le suprême Néant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1ec2ba2-e7ab-3403-8ae8-8f8d40772bf8",
                                        "entry_id": "922fa2f6-3045-3308-8d8e-2f04b0b39571",
                                        "glosses": [
                                            "Qualité des éléments matériels qui entrent dans la réalisation d’une œuvre d’art."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e5ddf30-5692-465c-8784-2e49fbd86d42",
                                                "sense_id": "b1ec2ba2-e7ab-3403-8ae8-8f8d40772bf8",
                                                "text": "Cette statue, ce meuble est d’une belle matière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c1841a3-ed7d-3ec3-9046-20601a99b6b8",
                                        "entry_id": "922fa2f6-3045-3308-8d8e-2f04b0b39571",
                                        "glosses": [
                                            "Sujet sur lequel on écrit, on parle."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6495c379-cb81-4e7d-b912-1a89306aa483",
                                                "sense_id": "7c1841a3-ed7d-3ec3-9046-20601a99b6b8",
                                                "text": "Traiter à fond, approfondir, épuiser une matière."
                                            },
                                            {
                                                "example_id": "ff929bf9-44b0-48f4-97f7-729d3f979cd3",
                                                "sense_id": "7c1841a3-ed7d-3ec3-9046-20601a99b6b8",
                                                "text": "La conversation a roulé sur toute sorte de matières."
                                            },
                                            {
                                                "example_id": "ae2f1e82-02b0-4bc3-80ef-2c51a523ed0a",
                                                "sense_id": "7c1841a3-ed7d-3ec3-9046-20601a99b6b8",
                                                "text": "Il avait essayé de consoler Rambert en lui faisant remarquer qu’il pouvait trouver à Oran la matière d’un reportage intéressant, et qu’il n’était pas d’événement, tout bien considéré, qui n’eût son bon côté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47ffcc4f-11b0-3b65-ab4f-e5a4263529a5",
                                        "entry_id": "922fa2f6-3045-3308-8d8e-2f04b0b39571",
                                        "glosses": [
                                            "Sujet enseigné dans un cadre d’un cours."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7274cc31-d55c-4bba-8948-823d9c6220a3",
                                                "sense_id": "47ffcc4f-11b0-3b65-ab4f-e5a4263529a5",
                                                "text": "La géographie et le sport sont deux matières enseignées au lycée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "219faa57-cb3c-3f8f-9ad6-49dfd58122e6",
                                        "entry_id": "922fa2f6-3045-3308-8d8e-2f04b0b39571",
                                        "glosses": [
                                            "Quelques-unes des parties qui composent la science du droit."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b23345a7-ae20-4698-b270-c1d6d2ec236a",
                                                "sense_id": "219faa57-cb3c-3f8f-9ad6-49dfd58122e6",
                                                "text": "Matière féodale. On l’emploie le plus souvent au pluriel."
                                            },
                                            {
                                                "example_id": "eda0cb64-6569-44f8-8cb8-a1500b9efba1",
                                                "sense_id": "219faa57-cb3c-3f8f-9ad6-49dfd58122e6",
                                                "text": "Les matières commerciales lui sont très familières."
                                            },
                                            {
                                                "example_id": "bf7ea65c-5317-4e95-a596-83b385de047a",
                                                "sense_id": "219faa57-cb3c-3f8f-9ad6-49dfd58122e6",
                                                "text": "La matière d’un crime, d’un délit, Ce qui constitue un crime, un délit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf4d4ce3-5b49-3720-97d4-f70757c9f330",
                                        "entry_id": "922fa2f6-3045-3308-8d8e-2f04b0b39571",
                                        "glosses": [
                                            "Sujet qu’on propose à des élèves pour le mettre en narration, en discours, en vers."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9fc1c61-5335-4ae5-b86b-4d01df648f4c",
                                                "sense_id": "cf4d4ce3-5b49-3720-97d4-f70757c9f330",
                                                "text": "Matière à mettre en vers latins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e17c026e-4f21-3758-b48d-d86d2dc9827f",
                                        "entry_id": "922fa2f6-3045-3308-8d8e-2f04b0b39571",
                                        "glosses": [
                                            "Substances évacuées par le haut ou par le bas, c’est-à-dire par l’anus ou la bouche."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9284b013-9b54-4169-8ac8-166f73b436bf",
                                                "sense_id": "e17c026e-4f21-3758-b48d-d86d2dc9827f",
                                                "text": "Matière des vomissements."
                                            },
                                            {
                                                "example_id": "8e9e557a-f6f5-41b2-bafd-f0e1bc50745c",
                                                "sense_id": "e17c026e-4f21-3758-b48d-d86d2dc9827f",
                                                "text": "Matière fécale."
                                            },
                                            {
                                                "example_id": "6b7597e1-b6b4-4c99-bb1c-3af00ada537f",
                                                "sense_id": "e17c026e-4f21-3758-b48d-d86d2dc9827f",
                                                "text": "— Vos hommes ont la diarrhée, à ce que je constate.\n— Quelques-uns, monsieur le Ministre, précisément ceux qui font usage des water-closets de nuit. Mais je crois pouvoir affirmer qu’aux water-closets de jour la consistance des matières est en général excellente."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "matière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3aa61b13-39e2-38ae-b6ec-b78a87894baf",
                                        "entry_id": "441eb127-afcd-3285-9ac2-7b789afc34b5",
                                        "glosses": [
                                            "Cause, sujet, occasion. En ce sens, il s’emploie sans article."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "569c6721-32c4-4ae9-a7d1-6f26dc178b9f",
                                                "sense_id": "3aa61b13-39e2-38ae-b6ec-b78a87894baf",
                                                "text": "Il n’y a pas là matière à se fâcher."
                                            },
                                            {
                                                "example_id": "e15c89cd-404c-4b98-9604-26b565b85c34",
                                                "sense_id": "3aa61b13-39e2-38ae-b6ec-b78a87894baf",
                                                "text": "Donner, fournir matière à rire."
                                            },
                                            {
                                                "example_id": "07dfe2b9-89df-4ccb-ad05-98e32a23bf66",
                                                "sense_id": "3aa61b13-39e2-38ae-b6ec-b78a87894baf",
                                                "text": "Il n’y a pas matière à procès."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2432efb8-1908-36b3-897a-a1878fb09192",
                                        "entry_id": "441eb127-afcd-3285-9ac2-7b789afc34b5",
                                        "glosses": [
                                            "Ce qui donne action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43939e49-95b6-4ecb-97ef-46c7366a9fe5",
                                                "sense_id": "2432efb8-1908-36b3-897a-a1878fb09192",
                                                "text": "En matière civile."
                                            },
                                            {
                                                "example_id": "c8bc7246-e5a7-42ad-9e79-06d676fdfd37",
                                                "sense_id": "2432efb8-1908-36b3-897a-a1878fb09192",
                                                "text": "En matière criminelle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
