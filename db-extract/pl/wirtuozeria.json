                        "source_sense_id": "cb681515-5fce-34fd-aa4a-482ce56abb82",
                        "target_lang_word": "virtuosité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "virtuosité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5aebebe0-484a-3314-bd07-6b52619975e1",
                                        "entry_id": "4e6f26d9-68ec-331e-8379-876bd8128f05",
                                        "glosses": [
                                            "Talent d’exécution, habileté technique dans la pratique d’un métier ou d’un art quelconque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "814b2240-205d-4b74-b018-11143566a09c",
                                                "sense_id": "5aebebe0-484a-3314-bd07-6b52619975e1",
                                                "text": "Ce fut ensuite, par les meilleurs danseurs de l'île, une hupahupa d'une virtuosité inouïe, avec des contorsions presque acrobatiques. Un entraînement datant du plus jeune âge est nécessaire pour bien exécuter cette danse,[…]."
                                            },
                                            {
                                                "example_id": "7d8ddd3a-63db-4d50-abc5-3e762c809050",
                                                "sense_id": "5aebebe0-484a-3314-bd07-6b52619975e1",
                                                "text": "Les flûtes, l'une après l'autre, inventent et modulent de gracieuses variations, comme pour célébrer joyeusement la virtuosité du vainqueur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f132775d-ec04-431a-bec6-aec6bca0b1c8",
                        "source_entry_id": "7dd049a5-e5de-385d-b371-b8b69b44bac7",
                        "source_sense_id": "cb681515-5fce-34fd-aa4a-482ce56abb82",
                        "target_lang_word": "виртуозность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "виртуозность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a3f0d527-f6a2-3e0f-b9bf-fc636ed478e9",
                                        "entry_id": "aef0b4b0-52a2-3f9e-8588-a1b630a4a9d9",
                                        "glosses": [
                                            "свойство по значению прил. виртуозный, высокое, отточенное мастерство"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dcc39b6-7b62-4b58-a11f-1ca75ed4c2d3",
                                                "sense_id": "a3f0d527-f6a2-3e0f-b9bf-fc636ed478e9",
                                                "text": "Исполняя произведения, пианист проявил виртуозность."
                                            },
                                            {
                                                "example_id": "1a98c6b2-9f1a-4f8b-ac1c-b62acbe5ab2c",
                                                "sense_id": "a3f0d527-f6a2-3e0f-b9bf-fc636ed478e9",
                                                "text": "Какая легкость, какое изящество, какая итальянская виртуозность и законченность в ее движениях!"
                                            },
                                            {
                                                "example_id": "26b3a6e2-62c7-4ede-9f9d-ef69ca60f788",
                                                "sense_id": "a3f0d527-f6a2-3e0f-b9bf-fc636ed478e9",
                                                "text": "Но в парусном деле он доходил до виртуозности."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
