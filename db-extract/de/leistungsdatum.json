                "senses": [
                    {
                        "sense_id": "678e6373-05eb-3ad1-b553-54b7541d0c3c",
                        "entry_id": "2d0c76dc-d0ad-3e14-806e-822c03e5cd34",
                        "glosses": [
                            "Tag, an dem jemandem gegenüber eine (Dienst-)Leistung erbracht wird"
                        ],
                        "tags": [
                            "vor allem",
                            "Kaufmannssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "0cf9920a-9f28-4236-95e0-022a9e73c15d",
                                "sense_id": "678e6373-05eb-3ad1-b553-54b7541d0c3c",
                                "text": "„Der einfache Hinweis ‚Leistungsdatum entspricht Rechnungsdatum‘ genügt, wenn das Ausstellungsdatum mit dem Zeitpunkt der Lieferung oder sonstigen Leistung übereinstimmt.“"
                            },
                            {
                                "example_id": "a99769af-508d-49b2-a810-703505ddbca3",
                                "sense_id": "678e6373-05eb-3ad1-b553-54b7541d0c3c",
                                "text": "„Zwar wird im gängigen Sprachgebrauch oft nicht zwischen den Begriffen ‚Lieferdatum‘ und ‚Leistungsdatum‘ unterschieden. Genau genommen bezieht sich das Lieferdatum jedoch auf den Vertrieb von Waren, während das Leistungsdatum bei Dienstleistungen verwendet wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
