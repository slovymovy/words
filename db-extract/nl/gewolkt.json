                "senses": [
                    {
                        "sense_id": "5e6fd07b-2dae-37a4-91f5-9f51e0713063",
                        "entry_id": "e15485e4-9064-3cb0-9ccb-81bb5d0cbcc9",
                        "glosses": [
                            "niet geheel glad en effen maar met niet scherp omgrensde vlekken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a678dfe5-3243-4e62-a01a-9d97a1d30689",
                                "sense_id": "5e6fd07b-2dae-37a4-91f5-9f51e0713063",
                                "text": "Kalkverf geeft mooi gewolkt effect. \"Bij sommige soorten kalkverf moet er een sealer over of primer onder, zodat de muur afneembaar wordt.\""
                            },
                            {
                                "example_id": "5dd99551-001e-4a96-be8f-f1aa9291fa48",
                                "sense_id": "5e6fd07b-2dae-37a4-91f5-9f51e0713063",
                                "text": "„Zwart email is het oudste. Daardoor is er veel minder van bewaard gebleven. Later kreeg je steeds meer kleuren: donkerrood, donkergroen, terracotta (oranje gevlamd) en grijs gewolkt.”"
                            },
                            {
                                "example_id": "6d2606b4-5a54-4dd1-b649-541f85f06919",
                                "sense_id": "5e6fd07b-2dae-37a4-91f5-9f51e0713063",
                                "text": "Liefhebbers van een keuken met een industriële look kunnen nu ook kiezen voor gewolkte inox. De geborstelde afwerking geeft het staal een matte afwerking en maakt het veel minder krasgevoelig."
                            }
                        ]
                    }
