    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1ea978d1-0fde-3bc8-a75d-024600ae9853",
                    "sense_definition": "Personne qui étudie, enseigne ou pratique la philosophie, ou qui crée un système de pensée.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "philosophie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce <w>philosophe</w> antique a marqué l'histoire de la pensée occidentale."
                        },
                        {
                            "text": "Les grands <w>philosophes</w> grecs s'interrogeaient sur la nature de la justice."
                        }
                    ],
                    "common_phrases": [
                        "grand philosophe",
                        "philosophe grec"
                    ]
                },
                {
                    "sense_id": "cb4d3641-c9c4-346f-bfd1-47c54c73e46a",
                    "sense_definition": "Personne sage qui accepte les épreuves et les difficultés de la vie avec calme et modération.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a accepté cette mauvaise nouvelle en véritable <w>philosophe</w>."
                        },
                        {
                            "text": "Un vrai <w>philosophe</w> ne se laisse pas abattre par les revers du destin."
                        }
                    ],
                    "common_phrases": [
                        "vivre en philosophe",
                        "agir en philosophe"
                    ]
                },
                {
                    "sense_id": "d22917a7-d482-39cf-b1c3-01dde3fafaba",
                    "sense_definition": "Penseur ou écrivain du dix-huitième siècle engagé pour les réformes morales, politiques et sociales.",
