                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adea7d50-7079-4733-8914-a4c859902073",
                                                "sense_id": "931a31c3-31fd-3481-82e8-e06d09d06a78",
                                                "text": "Мне крайне дорого Ваше внимание, и Ваша отзывчивость на мою просьбу глубоко тронула меня."
                                            }
                                        ]
