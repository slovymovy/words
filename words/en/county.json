{
    "word_family": [
        "count",
        "countess",
        "countship"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f732ca2c-7eec-31c3-923e-0a8a6f6a5cf2",
                    "sense_definition": "An administrative or geographical subdivision of a country or state.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "admin_region",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>county</w> library is located in the center of the town.",
                            "target_lang_translations": {
                                "ru": "Библиотека <w>округа</w> находится в центре города.",
                                "zh": "<w>县</w>图书馆位于镇中心。"
                            }
                        },
                        {
                            "text": "He was elected to represent the largest <w>county</w> in the state.",
                            "target_lang_translations": {
                                "ru": "Его избрали представлять самый большой <w>округ</w> в штате.",
                                "zh": "他当选为该州最大<w>县</w>的代表。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "county council",
                        "county court",
                        "county seat",
                        "county line",
                        "county fair"
                    ],
                    "target_lang_definitions": {
                        "ru": "Административно-территориальная единица деления страны или штата",
                        "zh": "国家或州下设的行政或地理区域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "округ",
                                "target_lang_sense_clarification": "административная единица в США"
                            },
                            {
                                "target_lang_word": "графство",
                                "target_lang_sense_clarification": "административная единица в Великобритании и Ирландии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "县",
                                "target_lang_sense_clarification": "中国或其他国家的行政区划"
                            },
                            {
                                "target_lang_word": "郡",
                                "target_lang_sense_clarification": "英国等国家的行政区划"
                            },
                            {
                                "target_lang_word": "县区",
                                "target_lang_sense_clarification": "美国行政区划的常用译法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92eb45f7-a472-3a9c-904c-fe6e2f118041",
                    "sense_definition": "The territory historically ruled by a count or a countess.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "historical_region",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The duke expanded his territory by annexing the neighboring <w>county</w>.",
                            "target_lang_translations": {
                                "ru": "Герцог расширил свои владения, аннексировав соседнее <w>графство</w>.",
                                "zh": "公爵通过吞并邻近的<w>伯爵领地</w>扩大了他的疆域。"
                            }
                        },
                        {
                            "text": "In medieval times, the <w>county</w> of Flanders was a major economic hub.",
                            "target_lang_translations": {
                                "ru": "В Средние века <w>графство</w> Фландрия было крупным экономическим центром.",
                                "zh": "在中世纪，佛兰德<w>伯爵领地</w>是一个主要的经济中心。"
                            }
                        }
                    ],
                    "synonyms": [
                        "countship",
                        "countdom"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Территория, исторически находившаяся под управлением графа или графини",
                        "zh": "历史上由伯爵或伯爵夫人统治的领地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "графство",
                                "target_lang_sense_clarification": "историческое владение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "伯爵领地",
                                "target_lang_sense_clarification": "历史上的封建领地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af2ba010-0b52-3662-8c5d-c72667ffad03",
                    "sense_definition": "A jail operated by a county government.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "jail",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent three months in <w>county</w> awaiting his trial.",
                            "target_lang_translations": {
                                "ru": "Он провел три месяца в <w>окружной тюрьме</w>, ожидая суда.",
                                "zh": "他在<w>县监狱</w>里待了三个月等待审判。"
                            }
                        },
                        {
                            "text": "The judge sentenced the defendant to time served in the <w>county</w> jail.",
                            "target_lang_translations": {
                                "ru": "Судья приговорил подсудимого к сроку, уже отбытому в <w>окружной</w> тюрьме.",
                                "zh": "法官判处被告的刑期即为已在<w>县监狱</w>服刑的时间。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in county",
                        "county jail"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "North American"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тюрьма, находящаяся в ведении администрации округа",
                        "zh": "由县级政府管理的监狱。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окружная тюрьма",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "县监狱",
                                "target_lang_sense_clarification": "美国地方监狱"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "be6ecee8-d1b9-3c5c-86bb-99b47c320323",
                    "sense_definition": "Characteristic of the upper class or gentry families of a county.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "social_class",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her manner was very <w>county</w>, reflecting her aristocratic upbringing.",
                            "target_lang_translations": {
                                "ru": "Ее манеры были очень <w>провинциально-аристократичными</w>, отражая ее благородное воспитание.",
                                "zh": "她的举止非常具有<w>地方贵族式</w>的风格，反映了她高贵的出身。"
                            }
                        },
                        {
                            "text": "They belong to the <w>county</w> set and attend all the exclusive local events.",
                            "target_lang_translations": {
                                "ru": "Они принадлежат к <w>местной знати</w> и посещают все эксклюзивные местные мероприятия.",
                                "zh": "他们属于<w>地方贵族</w>圈子，参加所有当地的高端活动。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "county family",
                        "county set"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "social class context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Характерный для высшего общества или дворянских семей графства",
                        "zh": "具有英国地方乡绅或贵族阶层特征的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "провинциально-аристократический",
                                "target_lang_sense_clarification": "о манерах или стиле"
                            },
                            {
                                "target_lang_word": "свойственный местной знати",
                                "target_lang_sense_clarification": "о социальном статусе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "地方贵族式的",
                                "target_lang_sense_clarification": "形容具有地方上层社会特征的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}