            {
                "entry_id": "25854a98-99e4-3024-8db7-b743c5668004",
                "word": "Hyperboréen",
                "pos": "name",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "797086da-f4fb-4dc5-b4e0-fddf15a26a57",
