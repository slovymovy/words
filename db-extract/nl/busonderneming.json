                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44514a51-3e34-4b23-b9cf-dcfa483f4699",
                                "sense_id": "db6e5ce6-9eed-35b8-876b-c05534c4317d",
                                "text": "In Arnhem heeft een stier die uit een islamitisch slachthuis ontsnapte opschudding veroorzaakt. Het dier stak een straat en een kruising over en kwam terecht in de wasstraat van de remise van busonderneming Connexxion."
                            },
                            {
                                "example_id": "7445ab05-cc1a-4d8d-9be2-a1a6a9bcdc97",
                                "sense_id": "db6e5ce6-9eed-35b8-876b-c05534c4317d",
                                "text": "De buschauffeurs van Connexxion mogen morgenochtend in Almere een paar uur staken, heeft de rechtbank in kort geding bepaald. De busonderneming was naar de rechter gestapt om de actie te verbieden, omdat een staking de reiziger dupeert."
                            }
                        ]
                    }
