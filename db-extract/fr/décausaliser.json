                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7b90d57-dd5f-41c4-b2a3-429499d879a5",
                                "sense_id": "323426ee-14ba-3f39-8bf6-9f87deaf92cd",
                                "text": "À partir du moment où l’enfant devient un être parlant ou un adulte et accède un petit peu à son désir, dans une analyse, il y a fermeture de l’inconscient d'un côté et ouverture justement quand on arrive à décausaliser les choses."
                            },
                            {
                                "example_id": "bd50c839-409d-4a54-a130-47fd3f2945b7",
                                "sense_id": "323426ee-14ba-3f39-8bf6-9f87deaf92cd",
                                "text": "Son action existe juste autant qu’elle peut se décausaliser."
                            }
                        ]
