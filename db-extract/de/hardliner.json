                "senses": [
                    {
                        "sense_id": "88599c5b-66d8-3259-8f14-ac5d26684440",
                        "entry_id": "601ac3af-483b-3ca0-838f-1efd72c7234d",
                        "glosses": [
                            "Partisan d’une ligne ou politique dure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e012337d-6bae-4e38-aa4f-724b054d760d",
                                "sense_id": "88599c5b-66d8-3259-8f14-ac5d26684440",
                                "text": "Von einer Abkopplung der westlichen Volkswirtschaften von China, wie sie manchen Hardlinern in Washington vorschwebt, ist in den Gipfeldokumenten keine Rede.",
                                "translation": "Il n'est pas question dans les documents du sommet d’un découplage des économies occidentales de la Chine, comme l’envisagent certains partisans de la ligne dure à Washington."
                            },
                            {
                                "example_id": "13c42904-1148-49b1-a476-416644186207",
                                "sense_id": "88599c5b-66d8-3259-8f14-ac5d26684440",
                                "text": "Nach dem Tod von Präsident Raisi muss Teheran die Nachfolge regeln. Das System der Hardliner ist angeschlagen und unbeliebt, deshalb will es sich mit allen Mitteln vor Reformen schützen. Dennoch könnte der Übergang eine Chance auf Wandel bieten.",
                                "translation": "Après la mort du président Raisi, Téhéran doit régler sa succession. Le système de la ligne dure est fragilisé et impopulaire, c'est pourquoi il veut se protéger par tous les moyens contre les réformes. Pourtant, la transition pourrait offrir une chance de changement."
                            }
                        ]
                    }
                ],
