                        "examples": [
                            {
                                "example_id": "3e74ef41-a2ba-4601-9a1d-b867f32d8459",
                                "sense_id": "863a3961-8f2a-3d29-ae8e-eb985cfb72d3",
                                "text": "Он проводил гостя в клозет, который имел право на чин ватерклозета, ибо унитаз промывался водой из бака."
                            },
                            {
                                "example_id": "3622cd57-0079-4257-8b38-02aac2b44656",
                                "sense_id": "863a3961-8f2a-3d29-ae8e-eb985cfb72d3",
                                "text": "— Туалет это клозет, пур ля дам, а нужник — это очко, сортир, понял?"
                            }
                        ]
                    }
