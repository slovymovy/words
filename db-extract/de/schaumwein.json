                        "glosses": [
                            "Mousseux, vin mousseux."
                        ],
                        "tags": [
                            "Viticulture"
                        ],
                        "examples": [
                            {
                                "example_id": "f9e3469e-88ce-437b-8d84-6c32fd4ca735",
                                "sense_id": "6669569d-4999-3f92-bf44-d82ed28db0c6",
                                "text": "Deutscher Qualitätsschaumwein muss mindestens neun Monate gelagert haben.",
                                "translation": "Le vin mousseux de qualité allemand doit avoir été stocké pendant au moins neuf mois."
                            },
                            {
                                "example_id": "1a7d1dc1-bf57-45fc-83ca-f5e013981790",
                                "sense_id": "6669569d-4999-3f92-bf44-d82ed28db0c6",
                                "text": "Im Jahr 2019 wurden in Deutschland 320,8 Millionen Liter Schaumwein abgesetzt.",
                                "translation": "En 2019, 320,8 millions de litres de vin mousseux ont été vendus en Allemagne."
                            }
                        ]
