                ],
                "senses": [
                    {
                        "sense_id": "083c5c85-763d-3863-a471-2e6ecbfb5bc6",
                        "entry_id": "e44329ef-7642-3f7c-9587-b72dc57d0560",
                        "glosses": [
                            "iemand die niets nuttigs uitvoert"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "09b0f048-33d4-4d23-ba91-c32415ca9d11",
                                "sense_id": "083c5c85-763d-3863-a471-2e6ecbfb5bc6",
                                "text": "Gelukkig is mijn dochter niet met een niksnut aan komen zetten."
                            },
                            {
                                "example_id": "c6ec773e-5b88-4616-8d61-6c473e9b36f5",
                                "sense_id": "083c5c85-763d-3863-a471-2e6ecbfb5bc6",
                                "text": "Er passeert wel eens een halfbakken vormexperiment of een rammelende zin, maar de taal is overwegend trefzeker, conform het streven naar ‘de helderheid van een bergbeekje’. Wanneer twee niksnutten een lift krijgen van een keurige heer, noteert Capote: ‘Zulke gasten wilden altijd graag in auto’s gezien worden, vooral met onbekenden; dan leek het of ze connecties hadden, en bovendien waren er de onvermijdelijke sigaretten’. Waarmee in één moeite door is aangetoond hoe goed de jongeling zich al weet te verplaatsen in figuren die ver van hem afstaan: kleurlingen, meisjes, oude vrouwen, landlopers. Het wijst vooruit naar zijn jubilerende non-fictie meesterwerk In koelen bloede (1966), waarin hij dicht op de huid kruipt van twee moordenaars."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cb031b1f-b022-4982-8435-38908b65b509",
                        "source_entry_id": "e44329ef-7642-3f7c-9587-b72dc57d0560",
                        "source_sense_id": "083c5c85-763d-3863-a471-2e6ecbfb5bc6",
                        "target_lang_word": "Taugenichts",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Taugenichts",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ffb08fb-1cfc-3b96-822f-37691748e8fb",
                                        "entry_id": "d8f790fb-3b15-3ff8-913e-869ab404e4c5",
                                        "glosses": [
                                            "Person, die zu nichts nützlich oder brauchbar ist"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7da229c1-7a5d-4842-9796-9839bd88ae7a",
                                                "sense_id": "1ffb08fb-1cfc-3b96-822f-37691748e8fb",
                                                "text": "Er war schon immer ein Taugenichts."
                                            },
                                            {
                                                "example_id": "7a4d9162-034b-4c14-b4fe-a992adc1a212",
                                                "sense_id": "1ffb08fb-1cfc-3b96-822f-37691748e8fb",
                                                "text": "Dein Sohn ist ein richtiger Taugenichts; er hat nur Unfug im Sinn."
                                            },
                                            {
                                                "example_id": "2fe6fde3-81d4-43fc-91d9-bbdc42629fda",
                                                "sense_id": "1ffb08fb-1cfc-3b96-822f-37691748e8fb",
                                                "text": "„So einen löblichen Vatter Wenceslaus gehabt, so wenig ahmte er doch demselben in seiner Regierung nach, indem ihn nichts, als seine Faulheit, Tyranney, und Unmäßigkeit der Nachwelt bekant gemacht haben, uṅ [und] er, mit einem Wort, ein rechter Taugenichts gewesen ist.“"
                                            },
                                            {
                                                "example_id": "8fe3fd79-b318-48fd-8fb1-4e336b0a6b64",
                                                "sense_id": "1ffb08fb-1cfc-3b96-822f-37691748e8fb",
                                                "text": "„Wir bringen es leicht fertig, die Armen, die von staatlichen Zuwendungen leben, als Taugenichtse zu beschimpfen.“"
                                            },
                                            {
                                                "example_id": "d33f8e77-55ef-455b-9a21-b0a80ead9ae7",
                                                "sense_id": "1ffb08fb-1cfc-3b96-822f-37691748e8fb",
                                                "text": "„Daß wir hier schon zahlreiche Vorgänger gehabt hatten, verrieten die Wände, die als Fremdenbuch dienten und auf die alle Taugenichtse der Welt ihren Namen geschrieben oder geritzt hatten.“"
                                            },
                                            {
                                                "example_id": "079748a7-efde-49dd-ae36-a89bc3beb42d",
                                                "sense_id": "1ffb08fb-1cfc-3b96-822f-37691748e8fb",
                                                "text": "„Han's jüngerer Bruder Han Dau-gwe (das ist der Faselhans) war ein Spieler und Taugenichts.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "30a59d47-b957-492b-b09b-6e1c3fd9f55b",
                        "source_entry_id": "e44329ef-7642-3f7c-9587-b72dc57d0560",
