                    }
                ],
                "senses": [
                    {
                        "sense_id": "fab093fe-2dbf-3ca4-bc3b-62ea224e310d",
                        "entry_id": "2fe280c0-66fa-35ec-afa9-8d150f2654c5",
                        "glosses": [
                            "Jahr, in dem etwa die Hälfte der Waldbäume Samen bilden"
                        ],
                        "tags": [
                            "Forstwirtschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "696a9bf4-e913-43a8-ad86-e297877319d2",
                                "sense_id": "fab093fe-2dbf-3ca4-bc3b-62ea224e310d",
                                "text": "Halbmast ergibt eine mittlere bis gute Ernte."
                            },
                            {
                                "example_id": "30a3c010-a7e9-47b0-9058-bea30338769f",
                                "sense_id": "fab093fe-2dbf-3ca4-bc3b-62ea224e310d",
                                "text": "„Die Ernteaussichten sind einzuschätzen […] * als mittel (Halbmast), wenn zahlreiche Bäume der Bestandesränder und einzelne, durch bevorzugten Standort begünstigte Bäume im Bestandesinnern guten Behang - 11 bis 40 % – ausweisen, […]“"
                            },
                            {
                                "example_id": "001af0db-5010-4116-a693-6f81b85f6ebc",
                                "sense_id": "fab093fe-2dbf-3ca4-bc3b-62ea224e310d",
                                "text": "„Auch die Eiche hat gut fruktifiziert; zwar keine Vollmast, aber im Landesdurchschnitt doch eine Halbmast.“"
                            },
                            {
                                "example_id": "3a37d0e2-c44e-4efb-92fb-0109630074aa",
                                "sense_id": "fab093fe-2dbf-3ca4-bc3b-62ea224e310d",
                                "text": "„Frost, geringe Bestäubung, Trockenheit oder Insekten können die Ernteaussichten beeinträchtigen. Aus diesem Grund melden die Forstdienststellen des Landes der FSB zum 01.08. jeden Jahres anhand der sichtbaren Fruchtansätze das quantitative Saatgutaufkommen nach den Kategorien Vollmast/Halbmast/Sprengmast.“"
                            },
                            {
                                "example_id": "4f783c2d-1ae5-4aed-8bb5-0c7271b20e4b",
                                "sense_id": "fab093fe-2dbf-3ca4-bc3b-62ea224e310d",
                                "text": "„Die Buche bringt im ganzen seltener Mast, dann aber in der Regel mindestens Halbmast.“"
                            },
                            {
                                "example_id": "3aa4f406-736c-4118-8250-5d5dbc4ca1f7",
                                "sense_id": "fab093fe-2dbf-3ca4-bc3b-62ea224e310d",
                                "text": "„Auch in anderen Ländern liegen die Verhältnisse ähnlich, wobei zudem nur alle 3-4 Jahre mit einer Spreng- oder Halbmast, selten mit einer Vollmast gerechnet werden kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
