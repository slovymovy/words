                "senses": [
                    {
                        "sense_id": "61af0f6b-7442-39d7-a000-c8ca20eb25eb",
                        "entry_id": "9384bfe5-892c-323e-9222-9c1685aae93d",
                        "glosses": [
                            "passives elektrisches Bauelement, das aus zwei oder mehreren parallelen Platten besteht und die Fähigkeit hat, elektrische Ladung zu speichern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11734ebd-bac2-4a99-b911-752fcdeb7595",
                                "sense_id": "61af0f6b-7442-39d7-a000-c8ca20eb25eb",
                                "text": "„Die Kapazität in Abhängikeit [sic] vom Plattenabstand und die Wirkung von Dielektrika bei Kondensatoren lassen sich am Plattenkondensator sehr gut zeigen.“",
                                "translation": "„Die Kapazität eines Plattenkondensators hängt stark von der Fläche A der Platten und ihrem Abstand d ab. Je größer A und je kleiner d, umso größer ist die Kapazität C.“"
                            },
                            {
                                "example_id": "a6e90687-56bb-4ae7-9848-d2481c4b88d9",
                                "sense_id": "61af0f6b-7442-39d7-a000-c8ca20eb25eb",
                                "text": "„Die einfachste Bauform für einen Kondensator ist der Plattenkondensator.“"
                            },
                            {
                                "example_id": "735bdca9-5674-41b3-a6e7-cb35b0cd1786",
                                "sense_id": "61af0f6b-7442-39d7-a000-c8ca20eb25eb",
                                "text": "„Anzumerken ist hier, dass bei den Anordnungen Plattenkondensator und Zylinderkondensator nur der Kapazitätsanteil durch dieses blau dargestellte Dielektrikum berechnet wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
