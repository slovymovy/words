        "nl-extract.jsonl": [
            {
                "entry_id": "f1eef4cd-3e31-3fbe-be31-0ffcf613304b",
                "word": "openduwen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "749e5e7f-956c-3698-9e20-0c2ef134e618",
                        "entry_id": "f1eef4cd-3e31-3fbe-be31-0ffcf613304b",
                        "glosses": [
                            "door drukken iets openmaken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "889d20f9-5289-429b-81f5-9de0727cf233",
                                "sense_id": "749e5e7f-956c-3698-9e20-0c2ef134e618",
                                "text": "Inmiddels heeft de vrouw het probleem gelukkig opgelost. „Ze heeft een andere deur voorzichtig geopend en met haar handen de borden tegengehouden terwijl ze de deur verder openduwde”, zegt Tsjeng tegenover Daily Mail."
                            },
                            {
                                "example_id": "687cda6b-a367-4f04-b664-697d95a3c1c6",
                                "sense_id": "749e5e7f-956c-3698-9e20-0c2ef134e618",
                                "text": "Geen zware toegangsdeur meer openduwen, maar binnenkomen door een moderne, ronde glazen entree met automatische schuifdeuren."
                            },
                            {
                                "example_id": "0d732a8c-684b-4349-87c9-43765e8c1862",
                                "sense_id": "749e5e7f-956c-3698-9e20-0c2ef134e618",
                                "text": "Als ik de deur van mijn kamer openduw, ben ik dolenthousiast. De koele stijl van de gang werd doorgetrokken: alles is grijs, tot de kunstplant toe."
                            }
                        ]
                    }
                ],
