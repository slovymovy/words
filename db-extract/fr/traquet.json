                ],
                "senses": [
                    {
                        "sense_id": "98681567-0d06-346f-aedd-b88b3779d197",
                        "entry_id": "ef4df592-396c-363a-b221-795e1b08c994",
                        "glosses": [
                            "Piège tendu aux bêtes puantes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "915bed70-c301-4713-be8a-873e8d5a87f2",
                                "sense_id": "98681567-0d06-346f-aedd-b88b3779d197",
                                "text": "Il trouva dans le bois un renard pris au traquet."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7fad2cf-ce55-3067-90e4-dd8eda612dd5",
                        "entry_id": "ef4df592-396c-363a-b221-795e1b08c994",
                        "glosses": [
                            "Donner dans le traquet, se laisser berner."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dcd99cf0-82b9-481e-9874-9e34d279857a",
                        "source_entry_id": "ef4df592-396c-363a-b221-795e1b08c994",
                        "target_lang_word": "Falle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Falle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "91794dfa-e3e0-34c4-99e6-266c4c39a387",
                                        "entry_id": "c729d756-61b4-3f65-a012-571eabd1ac08",
                                        "glosses": [
                                            "Vorrichtung zum Fangen von Wildtieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ebf77e8-2538-46c3-8a49-82739e252b1b",
                                                "sense_id": "91794dfa-e3e0-34c4-99e6-266c4c39a387",
                                                "text": "Das Stellen von Fallen gilt als unwaidmännisch."
                                            },
                                            {
                                                "example_id": "4d53d7e6-60dc-4430-bb3b-298ffb3eb0c2",
                                                "sense_id": "91794dfa-e3e0-34c4-99e6-266c4c39a387",
                                                "text": "„Ich sah, daß er durch seinen Zorn hindurch grinste, mit gebleckten Zähnen – so wie ich es bei den Ratten gesehen habe, die die Küchenschwester des Lehrlingsheimes in der Falle gefangen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f20ac6b6-900b-3cb8-b7fa-cba243664880",
                                        "entry_id": "c729d756-61b4-3f65-a012-571eabd1ac08",
                                        "glosses": [
                                            "Konstrukt zum Fangen, Festhalten, Überlisten, Hinterhalt"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e23ea9aa-94ec-41bc-a545-c4cce21a610c",
                                                "sense_id": "f20ac6b6-900b-3cb8-b7fa-cba243664880",
                                                "text": "Die Ermittler stellten bei dem Verhör eine geschickte Falle, in die der Verdächtige prompt tappte."
                                            },
                                            {
                                                "example_id": "0b6d0f6b-c645-4682-9566-dbc75b3b36d2",
                                                "sense_id": "f20ac6b6-900b-3cb8-b7fa-cba243664880",
                                                "text": "„Meine Einheit war in eine Falle gerannt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1ceb983d-95e1-357b-bcf2-129ba2c12095",
                                        "entry_id": "c729d756-61b4-3f65-a012-571eabd1ac08",
                                        "glosses": [
                                            "Regelungseinrichtung für den Wasserfluss an Fließgewässern"
                                        ],
                                        "tags": [
                                            "Wasserwirtschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8eb20170-c25e-40cf-ad71-a7525eab5c64",
                                                "sense_id": "1ceb983d-95e1-357b-bcf2-129ba2c12095",
                                                "text": "Von der alten Mühle war nichts mehr da außer einem verlandeten Kanal und dem verrosteten Gestänge einer alten Falle an deren Abzweig vom Bach."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a71713c5-d30c-3f42-869a-62469c0026cf",
                                        "entry_id": "c729d756-61b4-3f65-a012-571eabd1ac08",
                                        "glosses": [
                                            "Teil eines Türschlosses, der die Tür im Anschlag hält, nachdem sie „ins Schloss gefallen ist“; Türklinke, Klinke"
                                        ],
                                        "tags": [
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5df08e0-5c94-4daf-8037-9563b43c35b6",
                                                "sense_id": "a71713c5-d30c-3f42-869a-62469c0026cf",
                                                "text": "Sie hörte das Klicken der Falle, und die Tür öffnete langsam mit einem Quietschen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "0ac607a9-b4a6-36f7-a24a-78819b5836ac",
                                        "entry_id": "c729d756-61b4-3f65-a012-571eabd1ac08",
                                        "glosses": [
                                            "Bett, Bettstelle"
                                        ],
                                        "tags": [
                                            "casual",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c10cc3cc-9268-4996-b16c-85006843dd25",
                                                "sense_id": "0ac607a9-b4a6-36f7-a24a-78819b5836ac",
                                                "text": "„Nun aber ab in die Falle!“ sagte die Mutter spät am Weihnachtsabend"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "915ac008-700e-309d-9e4a-d7bc5a1873e7",
                                        "entry_id": "c729d756-61b4-3f65-a012-571eabd1ac08",
                                        "glosses": [
                                            "kurz für Sprengfalle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad99e7e0-d3e4-4f66-a8f3-f11f0c77fb0c",
                                                "sense_id": "915ac008-700e-309d-9e4a-d7bc5a1873e7",
                                                "text": "„Bei einer Wühlmaus-Sprengfalle handelt es sich um eine Vorrichtung, die man zur Schädlingsbekämpfung im Freien einsetzt. Die Falle wird unterirdisch im Mausegang versenkt, wo mit Berühren eines Drucksensors eine Detonation zur Tötung des Tieres ausgelöst wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "364a503d-6bdb-37ca-b599-b1dabc7579ef",
                                        "entry_id": "c729d756-61b4-3f65-a012-571eabd1ac08",
                                        "glosses": [
                                            "Ionenfalle"
                                        ],
                                        "tags": [
                                            "physics",
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97dd5100-ed09-4632-8d71-630b6ecdeb53",
                                                "sense_id": "364a503d-6bdb-37ca-b599-b1dabc7579ef",
                                                "text": "„In einer Ionenfalle werden Ionen, also elektrisch geladene Atome oder Moleküle, mittels elektrischer und magnetischer Felder festgehalten. Bei dem Einsatz der Ionenfalle als Massenfilter liegen an Endkappen- und Ringelektrode eine Wechselspannung im Radiofrequenzbereich an. … Nur die Ionen mit passendem Masse-zu-Ladungs Verhältnis bleiben in der Falle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "be3cc34c-707f-342b-97f9-3949cbac1a1b",
                                        "entry_id": "c729d756-61b4-3f65-a012-571eabd1ac08",
                                        "glosses": [
                                            "Paul-Falle"
                                        ],
                                        "tags": [
                                            "physics",
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50855f5c-a78b-4abe-9e43-bfbee7a118a0",
                                                "sense_id": "be3cc34c-707f-342b-97f9-3949cbac1a1b",
                                                "text": "„Die Paul-Falle besteht in ihrer klassischen Bauform aus drei Elektroden … Je weiter sich die Ionen vom Zentrum der Falle entfernen, desto größer wird die speichernde Kraft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "13c6b235-6868-3122-b8fa-ccead8236ba0",
                                        "entry_id": "c729d756-61b4-3f65-a012-571eabd1ac08",
                                        "glosses": [
                                            "magneto-optische Falle"
                                        ],
                                        "tags": [
                                            "physics",
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79f58d9c-54c9-4ec2-9a91-36952c1b2e10",
                                                "sense_id": "13c6b235-6868-3122-b8fa-ccead8236ba0",
                                                "text": "„Um zu verhindern, dass die Atome durch solche Zerfälle aus der Falle verloren gehen, benutzt man je nach atomarer Spezies einen oder mehrere Rückpumplaser, die diese konkurrierenden Zustände wieder in den Kühlprozess zurück transferieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"9\""
                                    },
                                    {
                                        "sense_id": "ec085944-369e-3bca-bc07-2ba0b0eb505e",
                                        "entry_id": "c729d756-61b4-3f65-a012-571eabd1ac08",
                                        "glosses": [
                                            "Penning-Falle"
                                        ],
                                        "tags": [
                                            "physics",
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b00ba31f-cade-4254-98af-7d72835aaa02",
                                                "sense_id": "ec085944-369e-3bca-bc07-2ba0b0eb505e",
                                                "text": "„Diese Falle ist besonders zur präzisen Messung der Eigenschaften von Ionen und stabilen subatomaren Teilchen geeignet. Eine ihrer Hauptanwendungen findet die Penning-Falle in der Massenspektrometrie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"10\""
                                    },
                                    {
                                        "sense_id": "a0303edc-2dca-3099-bccd-0cc80b4dc79e",
                                        "entry_id": "c729d756-61b4-3f65-a012-571eabd1ac08",
                                        "glosses": [
                                            "Kühlfalle, Teil eines Versuchsaufbaus oder einer Anlage in der Chemie und chemischen Industrie"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2bc2a60b-dceb-4fbe-9375-3a3cc160e97e",
                                                "sense_id": "a0303edc-2dca-3099-bccd-0cc80b4dc79e",
                                                "text": "„LN2 Kühlfallen werden aus Edelstahl gefertigt. Sie kommen vorwiegend in Hochvakuum- und Ultrahochvakuum- Anlagen zum Einsatz. An den Wänden der Falle kondensieren Wasser, Lösungsmittel, Treibmittel und Gase, deren Siedetemperaturen über 77 K liegen (z. B. CO2).“"
                                            }
                                        ],
                                        "sense_index_json": "\"11\""
                                    },
                                    {
                                        "sense_id": "7b470f0a-bd63-367e-8a77-113c6e69d412",
                                        "entry_id": "c729d756-61b4-3f65-a012-571eabd1ac08",
                                        "glosses": [
                                            "Erdölfalle, eine nach oben abgedichtete geologische Formation, in der sich Erdöl oder Erdgas sammelt"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47e462ae-a299-4b2a-8368-6675966331bd",
                                                "sense_id": "7b470f0a-bd63-367e-8a77-113c6e69d412",
                                                "text": "„Erdölfallen, geometrisch definierte Gesteinskörper, in denen sich, weil sie allseitig abgeschlossen bzw. abgedichtet sind, Erdöl und Erdgas fangen. Eine Falle beinhaltet auf der einen Seite die Kohlenwasserstoffe sammelnden durchlässigen und auf der anderen Seite die den weiteren Aufstieg hindernden überlagernden oder lateral abdichtenden Schichten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"12\""
                                    },
                                    {
                                        "sense_id": "c5f78399-5990-30b9-9162-f835685c4544",
                                        "entry_id": "c729d756-61b4-3f65-a012-571eabd1ac08",
                                        "glosses": [
                                            "Meteoritenfalle, einen Bereich eines Gletschers, an dem sich Meteoriten sammeln"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "760adec2-d156-4707-be19-2af48f6264b1",
                                                "sense_id": "c5f78399-5990-30b9-9162-f835685c4544",
                                                "text": "„Im klassischen Sinne versteht man unter einer Meteoritenfalle eine Depression in der Eisoberfläche mit einer Akkumulation von Meteoriten. Dieser 'Delle' fließt von allen Seiten Eis zu, um dann sublimiert zu werden – daher auch die Depression. Mit dem Eis werden Meteoriten herantransportiert, die sich mit der Zeit in der Falle sammeln. Eisdepressionen bilden sich aber nicht überall, sondern nur, wenn mehrere Faktoren zusammenkommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"13\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Falle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "39375de0-ec84-32e9-8a9a-e7ffa7743796",
