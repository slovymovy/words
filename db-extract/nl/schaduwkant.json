                                                "sense_id": "518d8730-1d94-3d48-bc82-8591853da12f",
                                                "text": "Having ridden the horse all day for the first time, I had painful blisters on my backside."
                                            },
                                            {
                                                "example_id": "d639def1-4339-4980-9265-5ff9fac1d732",
                                                "sense_id": "518d8730-1d94-3d48-bc82-8591853da12f",
                                                "text": "With an arrowe so broad, He shott him into the backe-syde."
                                            },
                                            {
                                                "example_id": "6180ce99-12c7-4b50-8dea-f099eae7afc7",
                                                "sense_id": "518d8730-1d94-3d48-bc82-8591853da12f",
                                                "text": "Our toilet was an outside netty shared between two or three families, where you sat on a hole and hoped the cat wouldn't jump at your backside."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3323f0f0-ca94-3661-843a-6f80923d0ae5",
