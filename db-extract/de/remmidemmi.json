                "senses": [
                    {
                        "sense_id": "ca745bc5-1578-3467-9f03-7cd3ffcf1c71",
                        "entry_id": "2fa11ac1-9874-3f04-b651-d488fdb611f1",
                        "glosses": [
                            "ausgelassenes, oft auch fröhliches und lautstarkes Treiben"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c7fc1108-7f54-45c4-ba62-35fec2356454",
                                "sense_id": "ca745bc5-1578-3467-9f03-7cd3ffcf1c71",
                                "text": "Die Nachbarn aus der Wohnung über uns machen schon wieder Remmidemmi!"
                            },
                            {
                                "example_id": "d275c34b-0b69-4c98-866a-c084b346fad1",
                                "sense_id": "ca745bc5-1578-3467-9f03-7cd3ffcf1c71",
                                "text": "Was ist denn das für ein Remmidemmi hier! Ruhe!"
                            },
                            {
                                "example_id": "8f38819a-7503-4a93-84fa-787e39083cb7",
                                "sense_id": "ca745bc5-1578-3467-9f03-7cd3ffcf1c71",
                                "text": "„Erst als zwei, drei Fenster knallend auffliegen und ein paar Scheiben grell scheppernd auf dem Boden zerspringen, blickt er hoch und mach eine halb amüsierte, halb nachsichtige Miene – just so, als gehe ihn das ganze Remmidemmi nichts an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
