                    },
                    {
                        "sense_id": "a1006294-6a15-3915-b059-27f71d604c6f",
                        "entry_id": "efdb3537-2344-3f1d-818d-b54f14b8b7af",
                        "glosses": [
                            "ziekteverschijnsel dat aanleiding is voor een bepaalde behandeling"
                        ],
