        "fr-extract.jsonl": [
            {
                "entry_id": "18b6ab37-2a5f-30a2-9b9d-b416f12f52b2",
                "word": "tonnage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7d2b33a8-e571-4a16-816c-d92c2bed7a0a",
                        "entry_id": "18b6ab37-2a5f-30a2-9b9d-b416f12f52b2",
                        "tags": [
                            "plural"
                        ],
                        "form": "tonnages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "af2c2a68-bc1f-3871-b581-f03eb1ec1020",
                        "entry_id": "18b6ab37-2a5f-30a2-9b9d-b416f12f52b2",
                        "glosses": [
                            "Capacité, déplacement d’eau d’un bateau, jauge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a19e1e9-89e1-424c-b881-765b22261fa6",
                                "sense_id": "af2c2a68-bc1f-3871-b581-f03eb1ec1020",
                                "text": "droit de tonnage, droit que paie un navire de commerce en raison de sa capacité."
                            },
                            {
                                "example_id": "9f7cc9ce-f15f-44b2-8e5b-02ae2f66a5a5",
                                "sense_id": "af2c2a68-bc1f-3871-b581-f03eb1ec1020",
                                "text": "Quatre ans auparavant, sur un yacht de vingt tonneaux, il avait traversé l'Atlantique de Nouvelle-Écosse à Cowes en vingt-deux jours, ce qui constitue un record pour une embarcation de ce tonnage."
                            },
                            {
                                "example_id": "5686b9b1-067d-4aca-b3db-54401d8343ea",
                                "sense_id": "af2c2a68-bc1f-3871-b581-f03eb1ec1020",
                                "text": "Selon toutes probabilités, ces navires, fabriqués à Marseille, Ampurias, Ibiza ou Carthagène, sont de faible tonnage. L'époque connaît des navires de tonnage conséquent, mais leurs naufrages se concentrent surtout autour des grands nœuds de navigation."
                            },
                            {
                                "example_id": "fcb422aa-75a1-4cb0-b15c-0ece63fd081d",
                                "sense_id": "af2c2a68-bc1f-3871-b581-f03eb1ec1020",
                                "text": "Le reste de l’équipage, composé d’officiers-majors, de maistrance, de matelots, de novices et de mousses, varie de trente-cinq à cinquante hommes, selon le tonnage du vaisseau."
                            }
                        ]
                    },
                    {
                        "sense_id": "744562c1-7360-366c-8ad5-a197ff4154b4",
                        "entry_id": "18b6ab37-2a5f-30a2-9b9d-b416f12f52b2",
                        "glosses": [
                            "Total des tonnes que représentent tous les vaisseaux d’une flotte, tous les navires entrant dans un port ou en sortant."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "e16df548-0ab9-4fd3-8c71-533e8c79f290",
                                "sense_id": "744562c1-7360-366c-8ad5-a197ff4154b4",
                                "text": "Le tonnage du port de Marseille."
                            },
                            {
                                "example_id": "50275bea-5f06-49bf-9396-46736dc06ad5",
                                "sense_id": "744562c1-7360-366c-8ad5-a197ff4154b4",
                                "text": "Que, dix ans après sa naissance, ou plutôt après son ouverture, le canal de Panama ait servi de route à un tonnage annuel supérieur à celui de Suez − lequel a été lui-même, en belle croissance − voilà qui manifeste la crue universelle du trafic par mer."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9bea421-0567-34b6-975d-6e5fd465cd18",
                        "entry_id": "18b6ab37-2a5f-30a2-9b9d-b416f12f52b2",
                        "glosses": [
                            "Quantité, exprimée en tonnes, d'un matériau pondéreux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88247366-7a7f-43c5-b387-7625f4084908",
                                "sense_id": "f9bea421-0567-34b6-975d-6e5fd465cd18",
                                "text": "Le midi aquitain produit près de 4 500 tonnes de conserves de petits pois et près de 3 500 tonnes de conserves de haricots verts. Ces tonnages sont incontestablement importants, mais il faut remarquer qu'ils s'appliquent à une région naturelle très étendue."
                            }
                        ]
                    },
                    {
                        "sense_id": "60729c15-b815-3b0a-a3a7-39879c8c8d10",
                        "entry_id": "18b6ab37-2a5f-30a2-9b9d-b416f12f52b2",
                        "glosses": [
                            "Masse d’un véhicule, de son contenu."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "0cacf128-8d46-408c-ae7f-e487f17d5f05",
                                "sense_id": "60729c15-b815-3b0a-a3a7-39879c8c8d10",
                                "text": "Des maires et des riverains se plaignent en effet que des camions, étrangers mais pas uniquement, viennent se « perdre » dans les centres-villes, ou empruntent des voies non dimensionnées avec un tonnage non adapté."
                            }
                        ]
                    }
                ],
