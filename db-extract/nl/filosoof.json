                ],
                "translations": [
                    {
                        "translation_id": "40a142c3-4c20-4274-aa8d-fa836423e9ed",
                        "source_entry_id": "bcae1227-e086-3a02-a8c2-cc61b4963aa4",
                        "source_sense_id": "688144ed-90ea-3ba6-a3ba-c2064d8b9d23",
                        "target_lang_word": "Philosoph",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Philosoph",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f9a4c297-4067-377b-a138-9583dc776482",
                                        "entry_id": "4847cdae-0e20-3b23-998c-679755449473",
                                        "glosses": [
                                            "Forscher des Gebietes Philosophie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "425f9fa0-647f-44d8-947b-1865a596b93d",
                                                "sense_id": "f9a4c297-4067-377b-a138-9583dc776482",
                                                "text": "Das Studium der Wahrheit, des Schönen und des Guten beschäftigt das Leben eines Philosophen."
                                            },
                                            {
                                                "example_id": "4df1a8ed-98c7-439a-bb71-eb4f81fa2452",
                                                "sense_id": "f9a4c297-4067-377b-a138-9583dc776482",
                                                "text": "„In einer einflussreichen Vorlesung von 1962 hat der Philosoph Joachim Ritter das mit Petrarca einsetzende Motiv des Blicks vom Berge als Ausdruck neuzeitlicher Subjektivität gedeutet.“"
                                            },
                                            {
                                                "example_id": "069ada11-5d99-427f-a104-b60cd8be59c6",
                                                "sense_id": "f9a4c297-4067-377b-a138-9583dc776482",
                                                "text": "„Jeder Philosoph sagt etwas anderes, und darunter die neuesten recht gleichgültige Dinge.“"
                                            },
                                            {
                                                "example_id": "2e57230d-5d18-46a3-b58a-64f7b6db877a",
                                                "sense_id": "f9a4c297-4067-377b-a138-9583dc776482",
                                                "text": "„Der Philosoph vermochte aber auch in Köln nicht Wurzeln zu schlagen.“"
                                            },
                                            {
                                                "example_id": "0f79f46c-2242-4f3c-80b7-e9af1fd6eb75",
                                                "sense_id": "f9a4c297-4067-377b-a138-9583dc776482",
                                                "text": "„Aristoteles war kein Christ gewesen, aber er war der Philosoph par excellence.“"
                                            },
                                            {
                                                "example_id": "6e8eee44-3920-434d-92cb-8d79b4623ce6",
                                                "sense_id": "f9a4c297-4067-377b-a138-9583dc776482",
                                                "text": "„Die Freiheit des Einzelnen bedeutete für den britischen Philosophen John Stuart Mill auch ein Recht auf Selbstbestimmung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cb4d9288-63a7-32b8-a1b5-99d8a346f23c",
                                        "entry_id": "4847cdae-0e20-3b23-998c-679755449473",
                                        "glosses": [
                                            "jemand, der gerne philosophiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8d05f63-068e-44e1-bdee-c00e48a3b8b1",
                                                "sense_id": "cb4d9288-63a7-32b8-a1b5-99d8a346f23c",
                                                "text": "An dieser Stelle muss ich zum Philosophen werden."
                                            },
                                            {
                                                "example_id": "19f00180-e56c-4801-a570-373f643aea48",
                                                "sense_id": "cb4d9288-63a7-32b8-a1b5-99d8a346f23c",
                                                "text": "„Er spricht wie ein Philosoph.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1bdbb8a0-3823-4ee1-bac6-cc95c35270cf",
                        "source_entry_id": "bcae1227-e086-3a02-a8c2-cc61b4963aa4",
                        "source_sense_id": "688144ed-90ea-3ba6-a3ba-c2064d8b9d23",
                        "target_lang_word": "philosopher",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "philosopher",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dcaf9c7d-bb82-398f-b6e3-3552e9463a94",
                                        "entry_id": "d1500181-4ccc-3a95-913f-5fd8219ac268",
                                        "glosses": [
                                            "A lover of wisdom."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "310b7afb-a173-35b0-9713-213ffc49e810",
                                        "entry_id": "d1500181-4ccc-3a95-913f-5fd8219ac268",
                                        "glosses": [
                                            "A student of philosophy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b91244a1-f7ee-35d3-a3ed-bbb93ccc6c49",
                                        "entry_id": "d1500181-4ccc-3a95-913f-5fd8219ac268",
                                        "glosses": [
                                            "A scholar or expert engaged in or contributing to philosophical inquiry."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27a49476-8143-475f-9bc3-9d67b02fa985",
                                                "sense_id": "b91244a1-f7ee-35d3-a3ed-bbb93ccc6c49",
                                                "text": "Their playwrights knew better. Scandal, murder, hair-rending and railing against the gods sold tickets. King is not a philosopher. He knows how to sell tickets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c51b3215-74b8-39d5-95ed-084b419cc65d",
                                        "entry_id": "d1500181-4ccc-3a95-913f-5fd8219ac268",
                                        "glosses": [
                                            "A person who applies the principles of philosophy to the conduct of their life, as by acting calmly and rationally in the face of inevitable change."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5266ec96-b98b-4282-b665-6214a24534d4",
                                                "sense_id": "c51b3215-74b8-39d5-95ed-084b419cc65d",
                                                "text": "Then certaine Philosophers of the Epicureans, and of the Stoikes, encountred him"
                                            },
                                            {
                                                "example_id": "9a5cfb3a-e7e7-4ec8-ab99-00d24b2160d7",
                                                "sense_id": "c51b3215-74b8-39d5-95ed-084b419cc65d",
                                                "text": "This is not the sort of happiness which a man would in general wish to owe to his wife; but where other powers of entertainment are wanting, the true philosopher will derive benefit from such as are given."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b56247ef-3b10-3f29-80be-59afa3721d48",
                                        "entry_id": "d1500181-4ccc-3a95-913f-5fd8219ac268",
                                        "glosses": [
                                            "A student, scholar, or expert in any branch of knowledge, especially those branches studied prior to being considered part of pure science."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "93e29504-ebd6-313c-bd01-b13e05abefd3",
                                        "entry_id": "d1500181-4ccc-3a95-913f-5fd8219ac268",
                                        "glosses": [
                                            "An alchemist."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "395de0f2-d087-4bcc-811c-75bf294c038d",
                                                "sense_id": "93e29504-ebd6-313c-bd01-b13e05abefd3",
                                                "text": "Then thus conclude I, since that God of heaven\nWill not that these philosophers neven\nHow that a man shall come unto this stone,\nI rede as for the best to let it gon."
                                            },
                                            {
                                                "example_id": "6a429d0a-aaee-4d1f-85d6-605406600ae6",
                                                "sense_id": "93e29504-ebd6-313c-bd01-b13e05abefd3",
                                                "text": "No further progress was made in this science until the Mohammedan alchemists embarked upon their search for the philosopher's stone, the elixir of life, and a method of transmuting base metals into gold."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9bba3273-2424-4fab-94cf-3f86c942eb15",
                        "source_entry_id": "bcae1227-e086-3a02-a8c2-cc61b4963aa4",
                        "source_sense_id": "688144ed-90ea-3ba6-a3ba-c2064d8b9d23",
                        "target_lang_word": "philosophe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "philosophe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1ea978d1-0fde-3bc8-a75d-024600ae9853",
                                        "entry_id": "3d684c5a-38c4-32c2-af34-a93e99eb62c4",
                                        "glosses": [
                                            "Personne qui pratique la philosophie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f5dd78a-1c52-479e-a493-8c1f6ce9f08e",
                                                "sense_id": "1ea978d1-0fde-3bc8-a75d-024600ae9853",
                                                "text": "C’est une Savante, & une Philosophe de profession."
                                            },
                                            {
                                                "example_id": "e49f808a-69da-4660-8c9c-9925140ac8be",
                                                "sense_id": "1ea978d1-0fde-3bc8-a75d-024600ae9853",
                                                "text": "Les philosophes, les théologiens et la plupart des héros d’arguments ont le génie de la nation française : ils attaquent vigoureusement, mais sont perdus s’ils sont réduits à la guerre défensive."
                                            },
                                            {
                                                "example_id": "2f3570dd-b16f-4c81-a332-e5043cdd4fa9",
                                                "sense_id": "1ea978d1-0fde-3bc8-a75d-024600ae9853",
                                                "text": "Je suis sûr que j’ai rencontré depuis deux jours dans les rues les philosophes les plus illustres et les fonctionnaires les plus influents. C’est mon désespoir de ne pas les connaître."
                                            },
                                            {
                                                "example_id": "1c2529e8-37b3-4503-a29a-91205d83a6d6",
                                                "sense_id": "1ea978d1-0fde-3bc8-a75d-024600ae9853",
                                                "text": "Ces personnes ont craint, en pénétrant trop avant dans le système de l’homme, de voir disparaître ses plus brillantes attributions; et, si elles ont été portées à applaudir à la sagacité du philosophe, elles ont été sur le point de condamner la philosophie."
                                            },
                                            {
                                                "example_id": "72a2e776-70a7-4671-a319-def8e6051224",
                                                "sense_id": "1ea978d1-0fde-3bc8-a75d-024600ae9853",
                                                "text": "[…], et c’est seulement après 1967 que le philosophe laïque syrien Sadiq Jalal al-Azm refusa hautement de voir dans la religion une voie d’avenir efficace."
                                            },
                                            {
                                                "example_id": "65b0612a-b361-4499-9b06-fb716b22d43a",
                                                "sense_id": "1ea978d1-0fde-3bc8-a75d-024600ae9853",
                                                "text": "La fonction du philosophe consiste exclusivement dans la profanation des idées. Aucune violence n’égale par ses effets la violence théorique. Plus tard, l’action vient…"
                                            },
                                            {
                                                "example_id": "11a6de04-0254-45cb-8cc5-50e4656f09dd",
                                                "sense_id": "1ea978d1-0fde-3bc8-a75d-024600ae9853",
                                                "text": "Descendant de Mahomet, il a pourtant été chassé de Constantinople pour avoir dit dans une conférence publique, en présence des plus grands dignitaires religieux, que le métier de philosophe était aussi indispensable à l’humanité que le métier de prophète."
                                            },
                                            {
                                                "example_id": "2f2e9f1e-6195-47b3-b5a9-1a5dc460aff9",
                                                "sense_id": "1ea978d1-0fde-3bc8-a75d-024600ae9853",
                                                "text": "Autrement dit : un philosophe n'est pas quelqu'un qui parle en philosophe mais qui vit en philosophe, non pas un grand parleur, un habile conférencier, mais un être qui a décidé de mettre en pratique les pensées philosophiques qui sont les siennes. En regard de cette méthode, on comprend que Pierre Hadot prenne plaisir à citer souvent cette phrase de Thoreau : « Il y a de nos jours des professeurs de philosophie, mais pas de philosophes. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d22917a7-d482-39cf-b1c3-01dde3fafaba",
                                        "entry_id": "3d684c5a-38c4-32c2-af34-a93e99eb62c4",
                                        "glosses": [
                                            "Écrivain du dix-huitième siècle épris d’idées de réforme en matière religieuse, politique, sociale et morale."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20eab7aa-33ed-493b-9046-d42b5098a72c",
                                                "sense_id": "d22917a7-d482-39cf-b1c3-01dde3fafaba",
                                                "text": "Les philosophes ont favorisé la publication de l’Encyclopédie."
                                            },
                                            {
                                                "example_id": "fd4cd874-5c75-48ac-8e37-145dd166a15d",
                                                "sense_id": "d22917a7-d482-39cf-b1c3-01dde3fafaba",
                                                "text": "— Frédéric II de Prusse se montra un roi philosophe"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb4d3641-c9c4-346f-bfd1-47c54c73e46a",
                                        "entry_id": "3d684c5a-38c4-32c2-af34-a93e99eb62c4",
                                        "glosses": [
                                            "Celui qui cultive sa raison, qui conforme sa conduite à des principes et travaille à fortifier son âme contre les coups du sort ; personne qui a un comportement inspiré par la sagesse."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ee70561-1bbd-4428-a266-dd7f693603a9",
                                                "sense_id": "cb4d3641-c9c4-346f-bfd1-47c54c73e46a",
                                                "text": "Il a pris cette mauvaise nouvelle en philosophe."
                                            },
                                            {
                                                "example_id": "1c01cc34-fb59-4f57-95f4-275976f20119",
                                                "sense_id": "cb4d3641-c9c4-346f-bfd1-47c54c73e46a",
                                                "text": "Il vécut et mourut en philosophe."
                                            },
                                            {
                                                "example_id": "837d35f4-d258-484a-addf-159773cc5058",
                                                "sense_id": "cb4d3641-c9c4-346f-bfd1-47c54c73e46a",
                                                "text": "Un vrai philosophe sait résister à ses passions et se vaincre lui- même."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cbf917b-6b0a-3f3a-bbd4-967d2d294ec5",
                                        "entry_id": "3d684c5a-38c4-32c2-af34-a93e99eb62c4",
                                        "glosses": [
                                            "Homme qui mène une vie tranquille et retirée, hors de l’embarras des affaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "685100af-58d6-4d6b-9c37-4843be615441",
                                                "sense_id": "9cbf917b-6b0a-3f3a-bbd4-967d2d294ec5",
                                                "text": "Il s’est retiré pour toujours à la campagne; c’est un philosophe, un vrai philosophe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b955ed2-4bce-3fe2-a9d1-3740ea4e1ecb",
                                        "entry_id": "3d684c5a-38c4-32c2-af34-a93e99eb62c4",
                                        "glosses": [
                                            "Étudiant qui étudie la philosophie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "76434679-ebf5-3788-b7f4-dcd126c26c3b",
                                        "entry_id": "3d684c5a-38c4-32c2-af34-a93e99eb62c4",
                                        "glosses": [
                                            "Personnage rêveur, qui manque du sens des réalités."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb6c1eae-d956-4152-ae29-4527245bc947",
                                                "sense_id": "76434679-ebf5-3788-b7f4-dcd126c26c3b",
                                                "text": "Les jurisconsultes civils donnèrent aussi leur avis et Valin dans son Commentaire sur l'Ordonnance de la Marine déclara « que les philosophes (sic) qui désapprouvaient la guerre de course étaient de mauvais citoyens. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01d874ea-bc1e-32f5-866e-e677d93f090c",
                                        "entry_id": "3d684c5a-38c4-32c2-af34-a93e99eb62c4",
                                        "glosses": [
                                            "Plat à base de purée de pommes de terre et de viande hachée."
                                        ],
                                        "tags": [
                                            "Belgique"
                                        ],
                                        "examples": [
                                            {
