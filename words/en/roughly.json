{
    "word_family": [
        "rough",
        "roughness",
        "roughen"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "23fa476f-7c73-39f6-948e-a410002b604b",
                    "sense_definition": "Without precision or exactness; imprecisely but close to in quantity or amount; approximately.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There were <w>roughly</w> fifty people waiting outside the store.",
                            "target_lang_translations": {
                                "ru": "Снаружи магазина ждало <w>примерно</w> пятьдесят человек.",
                                "zh": "商店外面<w>大约</w>有五十个人在等候。",
                                "pl": "Na zewnątrz sklepu czekało <w>mniej więcej</w> pięćdziesiąt osób."
                            }
                        },
                        {
                            "text": "The two cities are <w>roughly</w> equal in population size.",
                            "target_lang_translations": {
                                "ru": "Эти два города <w>приблизительно</w> равны по численности населения.",
                                "zh": "这两个城市的人口规模<w>大致</w>相等。",
                                "pl": "Oba miasta są <w>w przybliżeniu</w> równe pod względem liczby ludności."
                            }
                        }
                    ],
                    "synonyms": [
                        "approximately",
                        "about",
                        "around",
                        "nearly",
                        "more or less"
                    ],
                    "antonyms": [
                        "exactly",
                        "precisely"
                    ],
                    "common_phrases": [
                        "roughly speaking",
                        "roughly equal",
                        "roughly half"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не точно; приблизительно по количеству или объему.",
                        "zh": "指数量或程度不精确，大约，大概。",
                        "pl": "Bez precyzji; w przybliżeniu, około, mniej więcej."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "примерно",
                                "target_lang_sense_clarification": "о количестве, времени или размере"
                            },
                            {
                                "target_lang_word": "приблизительно",
                                "target_lang_sense_clarification": "с некоторой погрешностью, не точно"
                            },
                            {
                                "target_lang_word": "грубо",
                                "target_lang_sense_clarification": "без деталей (напр. «грубо говоря»)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大约",
                                "target_lang_sense_clarification": "用于数量或时间，表示估计"
                            },
                            {
                                "target_lang_word": "大概",
                                "target_lang_sense_clarification": "表示不十分精确的推测"
                            },
                            {
                                "target_lang_word": "粗略地",
                                "target_lang_sense_clarification": "指不细致、不精确地"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "mniej więcej",
                                "target_lang_sense_clarification": "najbardziej naturalne określenie przybliżonej ilości"
                            },
                            {
                                "target_lang_word": "około",
                                "target_lang_sense_clarification": "używane przy liczbach i ilościach"
                            },
                            {
                                "target_lang_word": "w przybliżeniu",
                                "target_lang_sense_clarification": "bardziej formalne określenie szacunkowej wartości"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f71c3c5-476c-3046-a762-140d6acfac7d",
                    "sense_definition": "In a rough manner; without kindness, softness, or gentleness.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He grabbed my arm <w>roughly</w> and pulled me away from the door.",
                            "target_lang_translations": {
                                "ru": "Он <w>грубо</w> схватил меня за руку и оттащил от двери.",
                                "zh": "他<w>粗暴地</w>抓住我的胳膊，把我从门口拉开了。",
                                "pl": "Chwycił mnie <w>brutalnie</w> za ramię i odciągnął od drzwi."
                            }
                        },
                        {
                            "text": "The baggage handlers were criticized for treating the luggage <w>roughly</w>.",
                            "target_lang_translations": {
                                "ru": "Грузчиков критиковали за то, что они <w>грубо</w> обращались с багажом.",
                                "zh": "行李搬运工因<w>粗鲁地</w>对待行李而受到批评。",
                                "pl": "Bagażowi zostali skrytykowani za to, że <w>niedelikatnie</w> obchodzili się z bagażem."
                            }
                        }
                    ],
                    "synonyms": [
                        "harshly",
                        "severely",
                        "violently",
                        "forcefully"
                    ],
                    "antonyms": [
                        "gently",
                        "softly",
                        "carefully"
                    ],
                    "common_phrases": [
                        "treat roughly",
                        "handle roughly",
                        "play roughly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жестко, без мягкости или осторожности; с применением физической силы или невежливо.",
                        "zh": "指动作粗暴、不温柔或缺乏礼貌。",
                        "pl": "W sposób szorstki, brutalny, bez delikatności lub uprzejmości."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грубо",
                                "target_lang_sense_clarification": "с применением силы или без уважения"
                            },
                            {
                                "target_lang_word": "резко",
                                "target_lang_sense_clarification": "внезапно и с силой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "粗暴地",
                                "target_lang_sense_clarification": "指行为动作猛烈或态度恶劣"
                            },
                            {
                                "target_lang_word": "粗鲁地",
                                "target_lang_sense_clarification": "指言行举止不礼貌"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "brutalnie",
                                "target_lang_sense_clarification": "o użyciu siły fizycznej"
                            },
                            {
                                "target_lang_word": "szorstko",
                                "target_lang_sense_clarification": "o sposobie traktowania kogoś lub zachowaniu"
                            },
                            {
                                "target_lang_word": "niedelikatnie",
                                "target_lang_sense_clarification": "o braku ostrożności w działaniu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9bec66e0-f6aa-3a06-a6e4-b7b957dd422f",
                    "sense_definition": "Unevenly or irregularly; in a way that creates a coarse surface or texture.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The vegetables should be <w>roughly</w> chopped before adding them to the soup.",
                            "target_lang_translations": {
                                "ru": "Овощи следует <w>крупно</w> нарезать перед добавлением в суп.",
                                "zh": "蔬菜在放入汤里之前应该<w>粗略地</w>切一下。",
                                "pl": "Warzywa należy <w>grubo</w> posiekać przed dodaniem ich do zupy."
                            }
                        },
                        {
                            "text": "They lived in a <w>roughly</w> built shack near the river.",
                            "target_lang_translations": {
                                "ru": "Они жили в <w>грубо</w> сколоченной хижине у реки.",
                                "zh": "他们住在河边一间<w>粗糙地</w>搭建起来的棚屋里。",
                                "pl": "Mieszkali w <w>niedbale</w> zbudowanej chacie nad rzeką."
                            }
                        }
                    ],
                    "synonyms": [
                        "unevenly",
                        "coarsely",
                        "irregularly"
                    ],
                    "antonyms": [
                        "smoothly",
                        "evenly",
                        "finely"
                    ],
                    "common_phrases": [
                        "roughly hewn",
                        "roughly chopped",
                        "roughly woven"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неровно, неаккуратно; создавая шероховатую поверхность или текстуру.",
                        "zh": "指表面不平整、不精细或制作简陋。",
                        "pl": "Nierówno, niechlujnie; w sposób tworzący chropowatą powierzchnię lub teksturę."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грубо",
                                "target_lang_sense_clarification": "о качестве обработки, текстуре или постройке"
                            },
                            {
                                "target_lang_word": "неровно",
                                "target_lang_sense_clarification": "без гладкости, криво"
                            },
                            {
                                "target_lang_word": "крупно",
                                "target_lang_sense_clarification": "о нарезке продуктов (напр. крупно нарезанный)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "粗糙地",
                                "target_lang_sense_clarification": "指质地或制作工艺不精细"
                            },
                            {
                                "target_lang_word": "大块地",
                                "target_lang_sense_clarification": "指切割食物时切得不细碎"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "grubo",
                                "target_lang_sense_clarification": "o sposobie krojenia lub wykończenia powierzchni"
                            },
                            {
                                "target_lang_word": "niedbale",
                                "target_lang_sense_clarification": "o sposobie wykonania pracy"
                            },
                            {
                                "target_lang_word": "nierówno",
                                "target_lang_sense_clarification": "o braku gładkości lub regularności"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}