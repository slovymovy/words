                                        "glosses": [
                                            "Any musical instrument consisting of tuned metal bars which are struck to make sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d10aa496-b108-4e9d-920c-ff27e7b1fa8d",
                                                "sense_id": "37cea2cd-b100-37b5-b9ed-e83f8f2a0243",
                                                "text": "The metallophone chimes at the end of each section signal changes in texture and harmony, a cue for the performers that permeates the consciousness of the listener like a reminder not to dwell on one thought or mood for too long."
                                            }
                                        ]
                                    }
