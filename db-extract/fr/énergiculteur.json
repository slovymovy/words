                ],
                "senses": [
                    {
                        "sense_id": "97fbaba0-fa58-389f-8221-0ad408a3559c",
                        "entry_id": "f6f23c9f-38b8-3078-b9bc-46bbf04563dc",
                        "glosses": [
                            "Agriculteur produisant de l’énergie issue de sources renouvelables (photovoltaïque, éolien, biogaz, bois, etc.) sur son exploitation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2b95aec-3d67-4196-9d19-2f8e1af7e98a",
                                "sense_id": "97fbaba0-fa58-389f-8221-0ad408a3559c",
                                "text": "Est-il acceptable que l’agriculteur, ne tirant plus aucun revenu de sa production de nourriture, devienne « énergiculteur » ou « stockeur de carbone » ?"
                            },
                            {
                                "example_id": "69180100-3e98-488e-b0bd-d6f76320ea72",
                                "sense_id": "97fbaba0-fa58-389f-8221-0ad408a3559c",
                                "text": "Suivait un nouveau bel exemple d’adaptation au marché avec Guy Giraud, agriculteur, énergiculteur et fabricant de crèmes glacées."
                            },
                            {
                                "example_id": "cb8d11ed-3154-413a-aba4-45829e9f4607",
                                "sense_id": "97fbaba0-fa58-389f-8221-0ad408a3559c",
                                "text": "Je n’ai pas une idée positive de ce qu’est un énergiculteur, je préférais donc ne pas lui demander plus de précision."
                            },
                            {
                                "example_id": "a2548001-7cc8-4588-bd78-4bd93867f6c3",
                                "sense_id": "97fbaba0-fa58-389f-8221-0ad408a3559c",
                                "text": "L’agriculteur va-t-il devoir se transformer en « énergiculteur » pour survivre ? Les cultures qui alimentent les mégas méthaniseurs épuiseront-elles les ressources en eau et en paille en cas de grave sécheresse ?"
                            }
                        ]
                    }
