    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "952bbf2e-152f-3893-a3f5-da251decb428",
                    "sense_definition": "Déclaration par laquelle on reconnaît avoir fait une faute, commis un acte ou éprouvé un sentiment secret.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "declaration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs heures d'interrogatoire, le suspect a fini par passer aux <w>aveux</w>."
                        },
                        {
                            "text": "Son <w>aveu</w> spontané a surpris tous ses proches qui ignoraient tout de cette histoire."
                        }
                    ],
                    "synonyms": [
                        "confession",
                        "reconnaissance"
                    ],
                    "antonyms": [
                        "démenti",
                        "dénégation"
                    ],
                    "common_phrases": [
                        "passer aux aveux",
                        "faire l'aveu de"
                    ]
                },
                {
                    "sense_id": "8de5d775-d3d3-360e-80ef-ba96804ee87f",
                    "sense_definition": "Reconnaissance ou constatation explicite faite par quelqu'un concernant une situation ou un fait.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "declaration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De l'<w>aveu</w> général, cette réunion a permis de résoudre les principaux blocages du projet."
                        },
                        {
                            "text": "De son propre <w>aveu</w>, il n'avait jamais pris le temps de lire le rapport en entier."
                        }
                    ],
                    "synonyms": [
                        "témoignage",
                        "reconnaissance"
                    ],
                    "common_phrases": [
                        "de l'aveu de",
                        "de son propre aveu",
                        "de l'aveu général"
                    ]
                },
                {
                    "sense_id": "470ee465-6b29-3fbd-a2ef-ffe854ce5e9d",
                    "sense_definition": "Reconnaissance formelle en justice d'un fait ou d'une prétention formulée par la partie adverse.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "declaration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>aveu</w> judiciaire constitue une preuve formelle devant le tribunal civil."
                        },
                        {
                            "text": "L'avocat de la défense a contesté la validité de cet <w>aveu</w> signé sans témoin."
                        }
                    ],
                    "common_phrases": [
                        "aveu judiciaire"
                    ]
                },
                {
                    "sense_id": "d1c304d0-5fdc-3605-bd56-0ab8d4e563f6",
                    "sense_definition": "Consentement ou approbation donné par une autorité ou un proche à un dessein ou à une action.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "approbation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a décidé de quitter la maison familiale sans l'<w>aveu</w> de ses parents."
                        },
                        {
                            "text": "Le jeune homme n'aurait jamais entrepris une telle démarche sans l'<w>aveu</w> de son tuteur."
                        }
                    ],
                    "synonyms": [
                        "approbation",
                        "consentement",
                        "agrément"
                    ],
                    "antonyms": [
                        "désapprobation",
                        "refus"
                    ],
                    "common_phrases": [
                        "sans l'aveu de"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "au sens de consentement ou d'approbation"
                        }
                    ]
                },
                {
                    "sense_id": "5e263771-620a-3712-bbbb-d38bd152cc1f",
                    "sense_definition": "Déclaration écrite par laquelle un vassal reconnaissait tenir des biens ou des terres de son seigneur.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "feodalite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'historien examine minutieusement les <w>aveux</w> conservés dans les archives du château."
                        },
                        {
                            "text": "Chaque nouveau vassal devait fournir un <w>aveu</w> et dénombrement de sa terre au suzerain."
                        }
                    ],
                    "common_phrases": [
                        "aveu et dénombrement"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "terme de droit féodal"
                        }
                    ]
                }
            ]
        }
    ]
}