                            {
                                "example_id": "cab5c782-c20e-419a-8b95-2942f0d2ded5",
                                "sense_id": "1e4a6df4-046f-3f95-aa76-b3f84350bed9",
                                "text": "Capa zou verslag blijven doen van conflicten wereldwijd. Hij was de enige fotograaf die mee durfde bij de eerste aanvalsgolf op D-Day en richtte in 1947 het vermaarde fotopersbureau Magnum op. In 1954 kwam hij om toen hij in Vietnam op een landmijn stapte."
                            },
                            {
                                "example_id": "f84b95be-16f0-4872-be2e-38779ada4bee",
                                "sense_id": "1e4a6df4-046f-3f95-aa76-b3f84350bed9",
                                "text": "Het gaat om Marcin Suber. Hij zou aan het werk zijn geweest op een mediakantoortje aan de kant van de Syrische oppositie, toen hij werd ontvoerd. Het gebeurde in het stadje Saraqeb dat in handen is van de rebellen. Suber is een freelance journalist en werkt onder meer voor het Poolse fotopersbureau Studio Melon."
                            }
                        ]
