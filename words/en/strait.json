    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b3b69592-e25a-3ab4-aceb-87db702158be",
                    "sense_definition": "A narrow waterway or channel connecting two larger bodies of water.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship navigated through the narrow <w>strait</w> carefully.",
                            "target_lang_translations": {
                                "tr": "Gemi dar <w>boğazdan</w> dikkatlice geçti."
                            }
                        },
                        {
                            "text": "Many trading vessels pass through the <w>Strait</w> of Gibraltar every day.",
                            "target_lang_translations": {
                                "tr": "Her gün birçok ticaret gemisi Cebelitarık <w>Boğazı'ndan</w> geçer."
                            }
                        }
                    ],
                    "synonyms": [
                        "channel",
                        "sound"
                    ],
                    "common_phrases": [
                        "Strait of Gibraltar",
                        "narrow strait"
                    ],
                    "target_lang_definitions": {
                        "tr": "İki büyük su kütlesini birbirine bağlayan dar su yolu veya geçit."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "boğaz",
                                "target_lang_sense_clarification": "iki kara arasındaki dar deniz veya su yolu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f95cc275-fb33-3f2c-8ee3-551be609a32a",
                    "sense_definition": "A difficult, troubled, or distressing situation (usually used in plural).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company was in dire <w>straits</w> after losing its main investor.",
                            "target_lang_translations": {
                                "tr": "Şirket, ana yatırımcısını kaybettikten sonra büyük bir <w>darboğaza</w> girdi."
                            }
                        },
                        {
                            "text": "Without financial aid, they will remain in severe economic <w>straits</w>.",
                            "target_lang_translations": {
                                "tr": "Finansal yardım olmadan ciddi ekonomik <w>sıkıntı içinde</w> kalacaklar."
                            }
                        }
                    ],
                    "synonyms": [
                        "plight",
                        "predicament",
                        "hardship"
                    ],
                    "common_phrases": [
                        "dire straits",
                        "financial straits",
                        "economic straits"
                    ],
                    "target_lang_definitions": {
                        "tr": "Zor, sıkıntılı veya kriz dolu durum (genellikle çoğul kullanılır)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "dar boğaz",
                                "target_lang_sense_clarification": "maddi veya genel kriz, sıkıntılı durum"
                            },
                            {
                                "target_lang_word": "sıkıntı",
                                "target_lang_sense_clarification": "zor durum, dar geçit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4756e8e5-c4b6-3118-8da6-365cf1cfc242",
                    "sense_definition": "A narrow pass, passage, or street.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The travelers squeezed through the rocky <w>strait</w> between the two cliffs.",
                            "target_lang_translations": {
                                "tr": "Gezginler iki uçurum arasındaki kayalık <w>dar geçitten</w> sıkışarak geçtiler."
                            }
                        },
                        {
                            "text": "Only one person at a time could move down the narrow <w>strait</w>.",
                            "target_lang_translations": {
                                "tr": "Dar <w>geçitten</w> tek seferde sadece bir kişi ilerleyebiliyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "pass",
                        "defile",
                        "passage"
                    ],
                    "common_phrases": [
                        "narrow strait"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare or literary in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Dar bir geçit veya yol."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "dar geçit",
                                "target_lang_sense_clarification": "dağ veya kayalıklar arasındaki dar yol"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "117dd9f3-15a5-3a64-aa04-9dbdc4ac2004",
