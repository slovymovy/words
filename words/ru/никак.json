                                "pl": "Za nic nie mogę <w>otworzyć</w> tych drzwi.",
                                "de": "Ich kann diese Tür <w>einfach</w> nicht öffnen.",
                                "fr": "Je n'arrive <w>absolument pas</w> à ouvrir cette porte.",
                                "it": "Proprio <w>non</w> riesco ad aprire questa porta.",
                                "cs": "Ty dveře <w>nijak</w> nemůžu otevřít.",
                                "tr": "Bu kapıyı <w>bir türlü</w> açamıyorum.",
                                "es": "No <w>hay manera de</w> que pueda abrir esta puerta."
                            }
                        },
                        {
                            "text": "Эту проблему <w>никак</w> нельзя игнорировать.",
                            "target_lang_translations": {
                                "en": "This problem can <w>by no means</w> be ignored.",
                                "zh": "这个问题<w>无论如何</w>都不能忽视。",
                                "nl": "Dit probleem kan <w>op geen enkele manier</w> genegeerd worden.",
                                "pl": "Tego problemu w żaden sposób nie można <w>zignorować</w>.",
                                "de": "Dieses Problem kann <w>auf keinen Fall</w> ignoriert werden.",
                                "fr": "Ce problème ne peut <w>en aucune façon</w> être ignoré.",
                                "it": "Questo problema <w>non</w> può essere ignorato in nessun modo.",
                                "cs": "Tento problém <w>v žádném případě</w> nelze ignorovat.",
                                "tr": "Bu sorun <w>hiçbir şekilde</w> görmezden gelinemez.",
                                "es": "Este problema no se puede <w>de ninguna manera</w> ignorar."
                            }
                        }
