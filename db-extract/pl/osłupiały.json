                "translations": [
                    {
                        "translation_id": "c99d2598-d058-4317-8f05-d46ebeec5a37",
                        "source_entry_id": "2280f520-7fad-367b-bd6d-766a580985ba",
                        "source_sense_id": "32d7f336-385a-3444-b141-15b99f5a1f38",
                        "target_lang_word": "flabbergasted",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flabbergasted",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bba1a30d-1f42-3db0-826b-b87750ee7658",
                                        "entry_id": "45088be4-6a8d-354c-ad45-2376a6b472d5",
                                        "glosses": [
                                            "Appalled, annoyed, exhausted or disgusted."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2deffde5-3acc-41e5-aa64-d0ba6993535f",
                                                "sense_id": "bba1a30d-1f42-3db0-826b-b87750ee7658",
                                                "text": "He was flabbergasted at how much weight he had gained."
                                            },
                                            {
                                                "example_id": "ed032f2d-bc03-40d9-8c64-a905b702f909",
                                                "sense_id": "bba1a30d-1f42-3db0-826b-b87750ee7658",
                                                "text": "Maxwell made a lunge at his flabbergasted guest, who ducked just in time to escape the great hands reaching for him."
                                            },
                                            {
                                                "example_id": "c783ed44-e583-4c6e-ad5b-bcaeee870305",
                                                "sense_id": "bba1a30d-1f42-3db0-826b-b87750ee7658",
                                                "text": "From behind her paper, she was flabbergasted to see a neatly dressed man helping himself to her cookies."
                                            },
                                            {
                                                "example_id": "74992d56-23dc-47a5-8cef-fabd43166301",
                                                "sense_id": "bba1a30d-1f42-3db0-826b-b87750ee7658",
                                                "text": "On his first encounter with tailgating in 2006, he was flabbergasted at the way rival fans mixed peaceably together at the parties. A Chicago Bears fan, he was warmly welcomed into a group of Arizona Cardinals fans and fed. \"I was shocked and slightly worried. I thought they were going to poison me. It was just so odd.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4c923ee-a39d-3358-8eb7-7bbf710227fb",
                                        "entry_id": "45088be4-6a8d-354c-ad45-2376a6b472d5",
                                        "glosses": [
                                            "Damned."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "flabbergasted",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "559d08a2-34a4-3d88-9eb3-88f718d65bf5",
                                        "entry_id": "0f0a86d8-4ecb-3f74-94aa-c6d41f9e9363",
                                        "glosses": [
                                            "simple past and past participle of flabbergast"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2ccb812-a539-4a34-a147-95cd9e170c6e",
                        "source_entry_id": "2280f520-7fad-367b-bd6d-766a580985ba",
                        "source_sense_id": "32d7f336-385a-3444-b141-15b99f5a1f38",
                        "target_lang_word": "aghast",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aghast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb335b30-54db-358e-8032-68485d5f79e3",
                                        "entry_id": "85144750-6011-3507-859d-58526cc2d687",
                                        "glosses": [
                                            "Terrified; struck with amazement; showing signs of terror or horror."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df126f35-30b1-48e5-8a61-ecbb98ff5591",
                                                "sense_id": "eb335b30-54db-358e-8032-68485d5f79e3",
                                                "text": "I was aghast when the incident unfolded in front of me."
                                            },
                                            {
                                                "example_id": "9a3a698b-4e2a-4a56-a9cd-f4274312ea32",
                                                "sense_id": "eb335b30-54db-358e-8032-68485d5f79e3",
                                                "text": "Betraide by fortune and ſuſpitious loue,\nThreatned with frowning wrath and iealouſie,\nSurpriz’d with feare and hideous reuenge,\nI ſtand agaſt: […]"
                                            },
                                            {
                                                "example_id": "d7a1e755-4737-45bf-b808-89805b36f014",
                                                "sense_id": "eb335b30-54db-358e-8032-68485d5f79e3",
                                                "text": "And while the revellers stood aghast at the fury of the man, one more wicked or, it may be, more drunken than the rest, cried out that they should put the hounds upon her."
                                            },
                                            {
                                                "example_id": "816860f9-8a9c-4ec5-90ef-1a31a0ffc793",
                                                "sense_id": "eb335b30-54db-358e-8032-68485d5f79e3",
                                                "text": "1985, Les Misérables, the song \"Red and Black\"\nI am agog! I am aghast! Is Marius in love at last?"
                                            },
                                            {
                                                "example_id": "3e33865b-1af8-4941-a8e3-d26deb58b745",
                                                "sense_id": "eb335b30-54db-358e-8032-68485d5f79e3",
                                                "text": "We sat at a long table with a huge salmon on a platter in the center, prepared Szechuan style. Dad sat at one end of the table, and regaled all present with his stories. In the middle of one convoluted yarn, he rose and went around to the salmon in the center of the table. Using his fingers, he dug an eyeball out of the fish, popped it in his mouth and swallowed it whole as we looked on, aghast. “A real delicacy,” he said, with a boyish smirk."
                                            },
                                            {
                                                "example_id": "c0762848-c096-4974-8285-eff2fcfe0719",
                                                "sense_id": "eb335b30-54db-358e-8032-68485d5f79e3",
                                                "text": "Hart, for one, will not remember the night for Lambert's heroics. Morrison, not closed down quickly enough, struck his shot well but England's No1 will be aghast at the way it struck his gloves then skidded off his knees and into the net."
                                            },
                                            {
                                                "example_id": "b0276f0b-c97b-4849-8b8e-cfc2ae8a4de5",
                                                "sense_id": "eb335b30-54db-358e-8032-68485d5f79e3",
                                                "text": "For months, Democrats have watched aghast as President Donald Trump has unleashed his head-spinning, all-of-government brand of disruption."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95749f7b-1cfd-4fda-b4db-680b4f78e378",
                        "source_entry_id": "2280f520-7fad-367b-bd6d-766a580985ba",
                        "source_sense_id": "32d7f336-385a-3444-b141-15b99f5a1f38",
                        "target_lang_word": "sidéré",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sidéré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ffffbd40-866e-3e91-ac4a-3f4ea4dfe6c3",
                                        "entry_id": "289b43fc-f1ec-3c3d-8944-71cdc476689b",
                                        "glosses": [
                                            "Qui est frappé de stupeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb0034b6-9d65-4db6-80a0-5589f9da97fb",
                                                "sense_id": "ffffbd40-866e-3e91-ac4a-3f4ea4dfe6c3",
                                                "text": "[…] : tout le visage était redevenu vivant, et les yeux lui lancèrent un regard tel qu’il finit par frissonner et, faisant quelques pas en arrière, prononça, d’une voix sidérée : « il regarde, il regarde, avec des yeux humains ! »"
                                            },
                                            {
                                                "example_id": "80e7ca4d-d6a4-4456-a99a-aac767f34c37",
                                                "sense_id": "ffffbd40-866e-3e91-ac4a-3f4ea4dfe6c3",
                                                "text": "Il admire Vladimir Poutine qu’il croit impressionner, alors que ce dernier le méprise et demeure sidéré que Donald Trump ait pu être élu président des États-Unis."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sidéré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c02facc-f302-3bd6-babe-9aae192e6f9c",
                                        "entry_id": "4f7d52d0-06d0-368b-8cd8-e1f06c23e7bc",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe sidérer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15fd7cbc-344f-41d5-b30e-5e90c3b85bc3",
                        "source_entry_id": "2280f520-7fad-367b-bd6d-766a580985ba",
                        "source_sense_id": "32d7f336-385a-3444-b141-15b99f5a1f38",
                        "target_lang_word": "stupide",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stupide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c7d2ea7-3e8b-3784-bad5-42134e9dbc46",
                                        "entry_id": "c85188e5-ce0b-342b-9864-8734bd408621",
                                        "glosses": [
                                            "Qui est frappé de stupeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08ef51c9-0217-4c99-bf8f-108c7ff0f2c4",
                                                "sense_id": "8c7d2ea7-3e8b-3784-bad5-42134e9dbc46",
                                                "text": "C’est alors que se produisit l’événement qui nous tint stupides. Vers le même lieu il se fit une explosion ou plutôt une éruption, avec le tapage de mille pièces, et un grand nuage cuivré dans lequel éclataient des projectiles innombrables ; tout cela au grand soleil. De telles choses laissent sans pensée ; et l’on se demande si l’on a rêvé […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cacc2033-cbf0-3b2c-b3cc-b01a8bed9533",
                                        "entry_id": "c85188e5-ce0b-342b-9864-8734bd408621",
                                        "glosses": [
                                            "Qui est hébété, idiot, obtus ; qui est d’un esprit lourd et pesant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27a19a2b-3b46-4718-9753-88940d0da6fb",
                                                "sense_id": "cacc2033-cbf0-3b2c-b3cc-b01a8bed9533",
                                                "text": "À l’en croire, c’était lui qui dansait, qui levait la jambe, qui se dandinait, tellement il se donnait de mal pour communiquer à ces merveilleuses mais stupides créatures un peu du feu sacré dont il les prétendait dépourvues."
                                            },
                                            {
                                                "example_id": "1fba6453-3c2c-40cd-b902-68180ef8ee8d",
                                                "sense_id": "cacc2033-cbf0-3b2c-b3cc-b01a8bed9533",
                                                "text": "Vous ne pouvez rien me faire, mais je me sens idiote et stupide de ne pas avoir les bonnes réponses. — Qu’est-ce que ça vous fait d’être idiote et stupide ? — Je déteste ça lorsque je suis stupide."
                                            },
                                            {
                                                "example_id": "e0de5d14-a898-4e32-813e-1cbd8700e11e",
                                                "sense_id": "cacc2033-cbf0-3b2c-b3cc-b01a8bed9533",
                                                "text": "Le seul \"différend\" que j’ai avec le capitaine Jakob est que c’est un ivrogne aussi violent que stupide !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c56d2a8-b695-3f54-a17b-9fcdb5cd65ef",
                                        "entry_id": "c85188e5-ce0b-342b-9864-8734bd408621",
                                        "glosses": [
                                            "Qualifie les productions d’un esprit lourd et pesant."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a7771b8-d2d4-499b-9bbc-3952f9cfa146",
                                                "sense_id": "0c56d2a8-b695-3f54-a17b-9fcdb5cd65ef",
                                                "text": "Le prétentieux-joueur ne met pas longtemps pour piger que son arrogance inconvenante est gâteusement stupide, ici, entre ces murs, au vu de sa situation."
                                            },
                                            {
                                                "example_id": "8b9cb20a-e0f5-44b6-85e4-3561aeb23b41",
                                                "sense_id": "0c56d2a8-b695-3f54-a17b-9fcdb5cd65ef",
                                                "text": "Mais ma stupide timidité me retient toujours."
                                            },
                                            {
                                                "example_id": "620afb82-c9f7-4883-bfdc-5a4feaf7cd9a",
                                                "sense_id": "0c56d2a8-b695-3f54-a17b-9fcdb5cd65ef",
                                                "text": "À cet âge, les garçons inventent des jeux stupides, comme le chat-bite dont le but est de saisir les attributs d'un partenaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
