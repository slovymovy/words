                "senses": [
                    {
                        "sense_id": "4a856b1b-67cb-380d-8e13-7a5e26419e8e",
                        "entry_id": "cbe5aeb8-fb71-3d5f-8b9f-50ceac15d11c",
                        "glosses": [
                            "Réseau français d’épiceries solidaires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9d386e1-9078-41cd-a41c-6d9a69907c63",
                                "sense_id": "4a856b1b-67cb-380d-8e13-7a5e26419e8e",
                                "text": "L’objectif ? Lutter contre la précarité alimentaire en soutenant le réseau d’épiceries solidaires ANDES."
                            },
                            {
                                "example_id": "6fd45ad7-5907-41e5-988c-972ccc903592",
                                "sense_id": "4a856b1b-67cb-380d-8e13-7a5e26419e8e",
                                "text": "ANDES, l’Association Nationale de Développement des Epiceries Solidaires, est le 1ᵉʳ réseau d’épiceries solidaires en France."
                            },
                            {
                                "example_id": "5d252009-6402-41de-a949-fe6f74b95b23",
                                "sense_id": "4a856b1b-67cb-380d-8e13-7a5e26419e8e",
                                "text": "ANDES a développé un réseau de plus de 420 épiceries solidaires qui accompagne 200 000 personnes par an."
                            }
                        ]
                    }
                ],
