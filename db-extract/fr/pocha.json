                    {
                        "sense_id": "2a45e23a-0010-386a-b0f0-0e4496de0d5c",
                        "entry_id": "e744b9b9-7fcf-3a6d-9ef8-35de1f228507",
                        "glosses": [
                            "Type de haricot blanc de Navarre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bb3cc34-2eba-410c-8b15-a0d19bbbc5de",
                                "sense_id": "2a45e23a-0010-386a-b0f0-0e4496de0d5c",
                                "text": "Haricots pocha de Navarre, poulpe de Galice, oignon, ail, fumet de poisson, safran et huile d'olive extra d’Arbequina."
                            },
                            {
                                "example_id": "3d63af89-f3c4-4e00-92d6-d22e8f2f7e14",
                                "sense_id": "2a45e23a-0010-386a-b0f0-0e4496de0d5c",
                                "text": "Prévoir une taille de plus du pantalon en sortant de table : tomates, piments frais grillés, « pochas », morue-gambas, dessert."
                            },
                            {
                                "example_id": "5ab01c95-a638-4eea-af19-6e505d061153",
                                "sense_id": "2a45e23a-0010-386a-b0f0-0e4496de0d5c",
                                "text": "Les pochas sont des haricots en grains, mangés frais ; ils doivent leur nom à la couleur de leur gousse (\"décolorée\" = \"pocho\")."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
