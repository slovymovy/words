                        ],
                        "form": "das Nasenloch"
                    },
                    {
                        "form_id": "8afce9d8-e5de-44e3-858e-ed84ea232e58",
                        "entry_id": "5e284a71-a5b7-3bcd-be8b-18ec47c0b049",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Nasenlöcher"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "752a8ec2-55ac-303e-9007-d0fece419e53",
                        "entry_id": "5e284a71-a5b7-3bcd-be8b-18ec47c0b049",
                        "glosses": [
                            "eine von zwei Öffnungen der Nase, die in das Innere der Nase, die Nasenhöhle führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fc2f5bc-a60e-420f-b6ff-dd51ef0bd5e0",
                                "sense_id": "752a8ec2-55ac-303e-9007-d0fece419e53",
                                "text": "„Charakteristisch sind die Grubenorgane, beidseitige Vertiefungen zwischen Nasenloch und Auge, die als Temperatursinnesorgane auch im Dunkeln ein räumliches Bild warmblütiger Tiere liefern und zum Aufspüren der Beute dienen.“"
                            },
                            {
                                "example_id": "9280d1bf-399b-446b-8cb9-af7135404f91",
                                "sense_id": "752a8ec2-55ac-303e-9007-d0fece419e53",
                                "text": "„Bobby hielt den Atem an, während ihm die Tiere wild gegen Ohren und Nasenlöcher taumelten.“"
                            },
                            {
                                "example_id": "87a0a742-55d8-4506-9bd5-d5547172aae3",
                                "sense_id": "752a8ec2-55ac-303e-9007-d0fece419e53",
                                "text": "„Rauch strömt aus den Nasenlöchern und den zusammengepressten Lippen.“"
                            },
                            {
                                "example_id": "97631869-d318-4d5a-bd14-3e3d66174d65",
                                "sense_id": "752a8ec2-55ac-303e-9007-d0fece419e53",
                                "text": "„Wir sind die Jüngsten an Bord, dann diese Frau, die sich nun eine Zigarette anzündet und den Rauch langsam durch die Nasenlöcher stößt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "51ae105a-e9a3-4b77-acec-1bdf8b0a07cb",
                        "source_entry_id": "5e284a71-a5b7-3bcd-be8b-18ec47c0b049",
                        "source_sense_id": "752a8ec2-55ac-303e-9007-d0fece419e53",
                        "source_sense_description": "Anatomie: eine von zwei Öffnungen der Nase, die in das Innere der Nase, die Nasenhöhle führt",
                        "target_lang_word": "nostril",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nostril",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30bed4f3-91ce-3ee5-9c16-c63460c8592b",
                                        "entry_id": "238addfd-7146-30db-b323-1b0a7d6a4847",
                                        "glosses": [
                                            "Either of the two orifices located on the nose (or on the beak of a bird); used as a passage for air and other gases to travel the nasal passages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3b49380-aea7-4e2b-8c9f-e26b19664458",
                                                "sense_id": "30bed4f3-91ce-3ee5-9c16-c63460c8592b",
                                                "text": "[…]whether it bee that they bee broken winded and purſiue, or otherwiſe bitten and ſtung with venomous beaſts; in which caſes, there muſt be an injection made vp into the noſthrils, of the juice of Rue in wine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4191782-da52-467c-9325-ea1713d8e131",
                        "source_entry_id": "5e284a71-a5b7-3bcd-be8b-18ec47c0b049",
                        "source_sense_id": "752a8ec2-55ac-303e-9007-d0fece419e53",
                        "source_sense_description": "Anatomie: eine von zwei Öffnungen der Nase, die in das Innere der Nase, die Nasenhöhle führt",
                        "target_lang_word": "narine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "narine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "380a7238-af7d-3647-883f-3db462fc4697",
                                        "entry_id": "8e5c9c90-05b8-3e56-b321-b69a69866d4e",
                                        "glosses": [
                                            "Chacune des deux ouvertures du nez par lesquelles l’être humain respire et perçoit les odeurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fa429cb-0d74-4424-872e-26693736e182",
                                                "sense_id": "380a7238-af7d-3647-883f-3db462fc4697",
                                                "text": "Mouillez votre petit doigt et glissez-le délicatement jusqu’en haut de votre narine, là, effectuez de minuscules mouvements circulaires, sans forcer, il ne s’agit pas de se faire mal mais de dégager le haut de votre narine."
                                            },
                                            {
                                                "example_id": "ef2599be-95ee-41e4-adbd-f6ed4cb03525",
                                                "sense_id": "380a7238-af7d-3647-883f-3db462fc4697",
                                                "text": "Elle avait l’âme de son regard de feu, l’esprit de ses lèvres brillantées par ses dents prestigieuses, la pensée de son front sublime, la fureur de ses narines toujours prêtes à hennir."
                                            },
                                            {
                                                "example_id": "54571ab8-2290-4d0f-8019-ba1bdc0d04cb",
                                                "sense_id": "380a7238-af7d-3647-883f-3db462fc4697",
                                                "text": "Les odeurs forestières, senteurs adorées par les âmes friandes de poésie à qui plaisent les mousses les plus innocentes, les cryptogames les plus vénéneux, les terres mouillées, les saules, les baumes, le serpolet, les eaux vertes d’une mare, l’étoile arrondie des nénuphars jaunes ; toutes ces vigoureuses fécondations se livrent à vos narines en vous livrant toute une pensée, leur âme peut-être."
                                            }
                                        ]
                                    },
                                    {
