{
    "word_family": [
        "grace",
        "graceful",
        "graciously",
        "graciousness",
        "ungracious"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "67718d33-ce02-3e7f-af1b-c0d0077a824d",
                    "sense_definition": "Kind, polite, and warmly courteous, especially towards someone of lower social status or in a difficult situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "courtesy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The queen was a <w>gracious</w> host who made every guest feel welcome at the palace.",
                            "target_lang_translations": {
                                "ru": "Королева была <w>любезной</w> хозяйкой, благодаря которой каждый гость чувствовал себя во дворце желанным.",
                                "pl": "Królowa była <w>uprzejmą</w> gospodynią, dzięki której każdy gość czuł się w pałacu mile widziany."
                            }
                        },
                        {
                            "text": "Even after a long day of work, she remained a <w>gracious</w> host to her unexpected visitors.",
                            "target_lang_translations": {
                                "ru": "Даже после долгого рабочего дня она оставалась <w>приветливой</w> хозяйкой для своих нежданных гостей.",
                                "pl": "Nawet po długim dniu pracy pozostała <w>życzliwą</w> gospodynią dla swoich niespodziewanych gości."
                            }
                        }
                    ],
                    "antonyms": [
                        "rude",
                        "ungracious",
                        "boorish"
                    ],
                    "common_phrases": [
                        "gracious host",
                        "gracious smile",
                        "gracious manner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Добрый, вежливый и обходительный, особенно по отношению к людям более низкого социального статуса или в трудной ситуации.",
                        "pl": "Uprzejmy, życzliwy i pełen ciepła, zwłaszcza wobec osób o niższym statusie społecznym lub w trudnej sytuacji."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "любезный",
                                "target_lang_sense_clarification": "проявляющий вежливость и внимание"
                            },
                            {
                                "target_lang_word": "приветливый",
                                "target_lang_sense_clarification": "радушный и открытый в общении"
                            },
                            {
                                "target_lang_word": "благосклонный",
                                "target_lang_sense_clarification": "проявляющий милость или доброжелательность"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "uprzejmy",
                                "target_lang_sense_clarification": "wykazujący dobre maniery i życzliwość"
                            },
                            {
                                "target_lang_word": "życzliwy",
                                "target_lang_sense_clarification": "nastawiony przyjaźnie i pomocnie"
                            },
                            {
                                "target_lang_word": "łaskawy",
                                "target_lang_sense_clarification": "okazujący dobroć i przychylność"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43a94baf-199e-3e81-b6b7-5530ecec2358",
                    "sense_definition": "Showing kindness and spirit by being magnanimous and avoiding arrogance, especially when winning or accepting a loss.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "courtesy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete was very <w>gracious</w> in defeat, shaking hands with the winner immediately.",
                            "target_lang_translations": {
                                "ru": "Спортсмен повел себя очень <w>великодушно</w> в поражении, сразу пожав руку победителю.",
                                "pl": "Sportowiec zachował się bardzo <w>wielkodusznie</w> po porażce, natychmiast podając rękę zwycięzcy."
                            }
                        },
                        {
                            "text": "The actress's <w>gracious</w> acceptance of the minor role allowed the production to proceed smoothly.",
                            "target_lang_translations": {
                                "ru": "То, что актриса <w>достойно</w> приняла второстепенную роль, позволило постановке продолжаться без проблем.",
                                "pl": "To, że aktorka <w>z klasą</w> przyjęła drugoplanową rolę, pozwoliło na płynną realizację produkcji."
                            }
                        }
                    ],
                    "synonyms": [
                        "wow"
                    ],
                    "antonyms": [
                        "resentful",
                        "petty"
                    ],
                    "common_phrases": [
                        "gracious in defeat",
                        "gracious winner",
                        "gracious acceptance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявляющий великодушие и отсутствие высокомерия, особенно при победе или поражении.",
                        "pl": "Okazujący wielkoduszność i brak arogancji, zwłaszcza podczas wygrywania lub przyjmowania porażki."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "великодушный",
                                "target_lang_sense_clarification": "умеющий достойно проигрывать или побеждать"
                            },
                            {
                                "target_lang_word": "достойный",
                                "target_lang_sense_clarification": "сохраняющий благородство в поведении"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wielkoduszny",
                                "target_lang_sense_clarification": "szlachetny w zachowaniu wobec rywala"
                            },
                            {
                                "target_lang_word": "z klasą",
                                "target_lang_sense_clarification": "zachowujący godność w każdej sytuacji"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76ac0a2f-4c63-38b7-853a-6cae1bd1fb5b",
                    "sense_definition": "Characterized by elegance, charm, or beauty in movement, appearance, or style of living.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "elegance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>gracious</w> movements of the figure skaters impressed the judges during the final performance.",
                            "target_lang_translations": {
                                "ru": "<w>Грациозные</w> движения фигуристов впечатлили судей во время финального выступления.",
                                "pl": "<w>Pełne wdzięku</w> ruchy łyżwiarzy figurowych zaimponowały sędziom podczas finałowego występu."
                            }
                        },
                        {
                            "text": "They enjoyed a life of <w>gracious</w> living in a large estate surrounded by beautiful gardens.",
                            "target_lang_translations": {
                                "ru": "Они наслаждались <w>изысканным</w> образом жизни в большом поместье, окруженном прекрасными садами.",
                                "pl": "Cieszyli się <w>wytwornym</w> życiem w dużej posiadłości otoczonej pięknymi ogrodami."
                            }
                        }
                    ],
                    "antonyms": [
                        "clumsy",
                        "awkward"
                    ],
                    "common_phrases": [
                        "gracious living",
                        "gracious curves",
                        "gracious home"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used to describe a lifestyle or physical grace"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся элегантностью, шармом или красотой в движениях, внешнем виде или образе жизни.",
                        "pl": "Cechujący się elegancją, wdziękiem lub pięknem w ruchu, wyglądzie lub stylu życia."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грациозный",
                                "target_lang_sense_clarification": "изящный в движениях"
                            },
                            {
                                "target_lang_word": "элегантный",
                                "target_lang_sense_clarification": "изысканный и благородный"
                            },
                            {
                                "target_lang_word": "изысканный",
                                "target_lang_sense_clarification": "о стиле жизни или обстановке"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "pełen wdzięku",
                                "target_lang_sense_clarification": "o eleganckich i płynnych ruchach"
                            },
                            {
                                "target_lang_word": "elegancki",
                                "target_lang_sense_clarification": "o wyrafinowanym stylu"
                            },
                            {
                                "target_lang_word": "wytworny",
                                "target_lang_sense_clarification": "o wysokim standardzie życia lub stylu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "57e78e41-c57c-34eb-8f78-44ba2869b200",
                    "sense_definition": "An exclamation used to express surprise, alarm, or mild annoyance.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "exclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Good <w>gracious</w>, I had no idea it was already midnight!",
                            "target_lang_translations": {
                                "ru": "<w>Боже мой</w>, я и понятия не имел, что уже полночь!",
                                "pl": "<w>O rety</w>, nie miałem pojęcia, że jest już północ!"
                            }
                        },
                        {
                            "text": "Oh <w>gracious</w>, look at the mess the dog made in the kitchen.",
                            "target_lang_translations": {
                                "ru": "О <w>господи</w>, посмотри, какой беспорядок устроила собака на кухне.",
                                "pl": "<w>O mój Boże</w>, spójrz, jaki bałagan pies zrobił w kuchni."
                            }
                        }
                    ],
                    "synonyms": [
                        "wow"
                    ],
                    "common_phrases": [
                        "good gracious",
                        "oh gracious",
                        "gracious me"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often used in phrases like 'good gracious'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Восклицание, используемое для выражения удивления, тревоги или легкого раздражения.",
                        "pl": "Wykrzyknienie używane do wyrażenia zdziwienia, niepokoju lub lekkiego irytacji."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "боже мой",
                                "target_lang_sense_clarification": "выражение удивления"
                            },
                            {
                                "target_lang_word": "батюшки",
                                "target_lang_sense_clarification": "просторечное выражение изумления"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "o rety",
                                "target_lang_sense_clarification": "wyrażenie zdziwienia lub lekkiego zaniepokojenia"
                            },
                            {
                                "target_lang_word": "o mój Boże",
                                "target_lang_sense_clarification": "silniejsze wyrażenie zdziwienia"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}