                "translations": [
                    {
                        "translation_id": "16f3a2d5-bb47-4971-ba5c-b721b1dc8595",
                        "source_entry_id": "722478ff-0aa1-3d64-8ab9-f5ef493a87d2",
                        "source_sense_description": "a decorative knot of hair on the crown of the head",
                        "target_lang_word": "Haarknoten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Haarknoten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "58c522f0-7242-3700-983b-d94b522ef1bd",
                                        "entry_id": "434cfdc8-abc4-3554-b6b3-fde43dd8627e",
                                        "glosses": [
                                            "mit den Haaren gebildeter Knoten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a33b337b-fb20-44b8-a10c-d182345aab50",
                                                "sense_id": "58c522f0-7242-3700-983b-d94b522ef1bd",
                                                "text": "„Silberfäden hielten ihren Haarknoten, der rings herum mit Spangen und Kämmen, voll von eingelegten Goldzierraten, besteckt war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44aa3194-4817-4d4c-b4c9-9a71468c9929",
                        "source_entry_id": "722478ff-0aa1-3d64-8ab9-f5ef493a87d2",
                        "source_sense_description": "a decorative knot of hair on the crown of the head",
                        "target_lang_word": "хохо́л",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "хохо́л",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "07f3f02c-d94a-3096-8a7d-3cfcad572875",
                                        "entry_id": "be096a53-4655-3d21-9263-4651a08410d8",
                                        "glosses": [
                                            "торчащий клок перьев на голове птицы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31d9d6d4-b3c4-43a9-9069-773d8a8c281b",
                                                "sense_id": "07f3f02c-d94a-3096-8a7d-3cfcad572875",
                                                "text": "Различия в перьях между селезнем и уткой я не замечал, но другие охотники сказывали мне, что селезень отличается бо́льшим отливом кофейного цвета, большею величиной и чёрным хохлом."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afebcacf-5728-3453-942d-7cbf84a80672",
                                        "entry_id": "be096a53-4655-3d21-9263-4651a08410d8",
                                        "glosses": [
                                            "торчащий клок волос на голове; вихор"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b453cea-6166-4cb1-be56-ddb11576a4dc",
                                                "sense_id": "afebcacf-5728-3453-942d-7cbf84a80672",
                                                "text": "Казаки бреют головы и носят на маковке длинный хохол, завивая его за ухо: этот клок волос называется оселедец."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01037213-8583-3183-b7ce-5b049675a02d",
                                        "entry_id": "be096a53-4655-3d21-9263-4651a08410d8",
                                        "glosses": [
                                            "взбитая или поднятая вверх прядь волос; кок"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "хохо́л",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f2a4cf9b-b547-337c-a414-0f843bb5a6b6",
                                        "entry_id": "21315645-702f-3a39-90ef-9f75d792a4e8",
                                        "glosses": [
                                            "разг., сниж., шутл. или уничиж., бран. представитель украинской национальности; украинец"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "487b3753-750c-4612-a640-5a1838b349be",
                                                "sense_id": "f2a4cf9b-b547-337c-a414-0f843bb5a6b6",
                                                "text": "Мне приятно думать, что милый Данильченко у Вас. Этот хохол был мне всегда чрезвычайно симпатичен."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "хохо́л",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ecfd756e-15dd-3daf-802d-3f7440c1bdd4",
                                        "entry_id": "fd9d752b-e573-304f-9a1d-0c8e3452948c",
                                        "glosses": [
                                            "нар.-разг. и фолькл. женский лобок вместе с лобковыми волосами"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f96a510-c8d6-401a-a132-5bff176bbe3f",
                                                "sense_id": "ecfd756e-15dd-3daf-802d-3f7440c1bdd4",
                                                "text": "Дура я — дала начальнику // Пощупать свой хохол! // На меня мои ребята // Написали протокол!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5701db4a-dbd1-42f0-af66-42bdcc0563bd",
                        "source_entry_id": "722478ff-0aa1-3d64-8ab9-f5ef493a87d2",
                        "source_sense_description": "a decorative knot of hair on the crown of the head",
                        "target_lang_word": "хохоло́к",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "хохоло́к",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c9006b91-a801-358e-9b3e-f0f98bc9accc",
                                        "entry_id": "2e37fb85-cebc-3592-9c8d-289e4610fe20",
                                        "glosses": [
                                            "ботан. пучок волосков на плодах у некоторых растений семейства сложноцветных, способствующий их распространению при помощи ветра, воды"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db98a05d-543f-4085-bb72-a80b1506d14a",
                                                "sense_id": "c9006b91-a801-358e-9b3e-f0f98bc9accc",
                                                "text": "Все цветки в корзинке язычковые, жёлтые, с хохолком."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "хохоло́к",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "24479972-4cca-33fb-b8c0-0a5f0fefbd5c",
                                        "entry_id": "0a8f2998-5f9a-34e9-8d6a-e25a6e368ca5",
                                        "glosses": [
                                            "разг. уменьш. к хохол в значении: торчащий клок волос на голове; вихор"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9799e14d-14f5-4d79-85db-78fe16a9e562",
                                                "sense_id": "24479972-4cca-33fb-b8c0-0a5f0fefbd5c",
                                                "text": "Русые тёмные волосы были зачёсаны у неё так же гладко, как и у сестры, за исключением небольшого хохолка, который постоянно вставал у неё на конце пробора, где волосы выходили на лоб небольшим мысиком."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d0a26ce-de3a-36eb-91e6-015773fc1a8a",
                                        "entry_id": "0a8f2998-5f9a-34e9-8d6a-e25a6e368ca5",
                                        "glosses": [
                                            "разг. ласк. к хохол в значении: торчащий клок перьев на голове птицы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a54a4c7-6594-485a-adf6-2c5dcf563460",
                                                "sense_id": "9d0a26ce-de3a-36eb-91e6-015773fc1a8a",
                                                "text": "Соя, или сойка, лесная птичка с хохолком и голубым зеркальцем на горлышке, из рода ворон — Corvus glandorius."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "хохоло́к",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "cafa1917-2972-3a21-847e-5649abdb0107",
                                        "entry_id": "b6f4ddc8-50e6-3564-bfe2-75758fef0808",
                                        "glosses": [
                                            "нар.-разг. и фолькл. женский лобок вместе с лобковыми волосами"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd4bc6f1-5014-4f5a-a5be-5d026f68c13a",
                                                "sense_id": "cafa1917-2972-3a21-847e-5649abdb0107",
                                                "text": "Я на печке спала // В алой кофточке! // Свой кудрявый хохолок // Держала в горсточке!"
                                            },
                                            {
                                                "example_id": "a51509f3-ba03-41f5-b4f9-de2cad326986",
                                                "sense_id": "cafa1917-2972-3a21-847e-5649abdb0107",
                                                "text": "У моей милашки Нюрки // Загорелся потолок! // Она юбочкой тушила,— // Подпалила хохолок!"
                                            },
                                            {
                                                "example_id": "ed3654fd-4f9b-4663-860d-1bd08d98a087",
                                                "sense_id": "cafa1917-2972-3a21-847e-5649abdb0107",
                                                "text": "У кого какая баня, — // У меня — без потолка! // У кого какая милка, — // У меня — без хохолка!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
