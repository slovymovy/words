                ],
                "senses": [
                    {
                        "sense_id": "17ad23d0-4f48-3c06-a480-e3ad399ec86c",
                        "entry_id": "fe9bdb4e-947d-3cb9-b065-4374da5095a0",
                        "glosses": [
                            "Articulation serrée cartilagineuse, comme aux vertèbres et aux carpes, laquelle ne permet pas le glissement des surfaces. Ces articulations permettent des mouvements d’amplitude limitée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aac13717-01fd-49e2-9e8e-dd079f2d2c34",
                                "sense_id": "17ad23d0-4f48-3c06-a480-e3ad399ec86c",
                                "text": "Les corps vertébraux, l'articulation sacro-iliaque et la symphyse pubienne sont des amphiarthroses."
                            },
                            {
                                "example_id": "ff520005-7f42-4be8-b264-70526fdf4d52",
                                "sense_id": "17ad23d0-4f48-3c06-a480-e3ad399ec86c",
                                "text": "L’amphiarthrose, que l’on nomme encore articulation mixte, est une articulation qui tient de la synarthrose et de la diarthrose, en ce que les os sont continus entre eux par une substance intermédiaire, qui, à cause de sa souplesse, leur permet de petits mouvements de flexibilité, mais non pas de glisser les uns sur les autres : telle est l’articulation du corps des vertèbres."
                            }
                        ]
                    }
                ],
