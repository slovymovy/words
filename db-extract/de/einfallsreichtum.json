                                "target_senses": [
                                    {
                                        "sense_id": "b6ddd17f-67f2-3c77-8332-f7ae472d5c4e",
                                        "entry_id": "1625617f-b252-3896-8f56-e6077170d4be",
                                        "glosses": [
                                            "The ability to cope with difficult situations, or unusual problems."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6942808e-ae63-4efd-9980-fb0df7243f49",
                        "source_entry_id": "cecfbfaf-8f59-3ce2-a52c-df636974b75b",
                        "source_sense_id": "c9ac02cd-bffc-386d-acd4-6a79d6d8ef50",
                        "source_sense_description": "Vorhandensein vieler Einfälle",
                        "target_lang_word": "inventiveness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inventiveness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ea9d8fc-1070-30d9-a9a5-552eda74c251",
                                        "entry_id": "c8c35994-0111-3bb5-996d-b15cfa5a99dd",
                                        "glosses": [
                                            "The quality of being inventive; the faculty of inventing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b017a91-77b8-4d58-b22c-4a7e0f698e46",
                                                "sense_id": "7ea9d8fc-1070-30d9-a9a5-552eda74c251",
                                                "text": "Near-synonyms: resourcefulness, creativity, imagination"
                                            },
                                            {
                                                "example_id": "7c535a6e-6917-4727-9a1e-29d601cc8ed4",
                                                "sense_id": "7ea9d8fc-1070-30d9-a9a5-552eda74c251",
                                                "text": "For as was the land, such was the art of it while folk yet troubled themselves about such things; it strove little to impress people either by pomp or ingenuity: not unseldom it fell into commonplace, rarely it rose into majesty; yet was it never oppressive, never a slave’s nightmare or an insolent boast: and at its best it had an inventiveness, an individuality, that grander styles have never overpassed: […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6ae894a-8bbc-4f20-bff7-252edaff589c",
                        "source_entry_id": "cecfbfaf-8f59-3ce2-a52c-df636974b75b",
                        "source_sense_id": "c9ac02cd-bffc-386d-acd4-6a79d6d8ef50",
                        "source_sense_description": "Vorhandensein vieler Einfälle",
                        "target_lang_word": "ingenuity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ingenuity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54847872-61f2-37a0-8998-1892139da889",
                                        "entry_id": "6ea49a8c-94c8-379b-995a-f77f365fb619",
                                        "glosses": [
                                            "The ability to solve difficult problems in original, clever, and inventive ways; ingeniousness."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13f9234a-e383-4bde-87f4-3cdae7976792",
                                                "sense_id": "54847872-61f2-37a0-8998-1892139da889",
                                                "text": "The pyramids demonstrate the ingenuity of the ancient Egyptians."
                                            },
                                            {
                                                "example_id": "540e2a03-12bf-465e-aaa1-8c1833be717d",
                                                "sense_id": "54847872-61f2-37a0-8998-1892139da889",
                                                "text": "Poverty is the mother of ingenuity."
                                            },
                                            {
                                                "example_id": "c819cb24-7389-4f50-a197-2454a7a6f04b",
                                                "sense_id": "54847872-61f2-37a0-8998-1892139da889",
                                                "text": "Ingenuity is one of the characteristics of a beaver."
                                            },
                                            {
                                                "example_id": "1433c4ff-0771-4d62-8d1a-dec0cc870c41",
                                                "sense_id": "54847872-61f2-37a0-8998-1892139da889",
                                                "text": "Half the ingenuity lavished on news—by news we mean the topics of the day as connected with their own circle—half this ingenuity would set up a whole Society of Antiquaries, and immortalise at least a dozen of them."
                                            },
                                            {
                                                "example_id": "ca01a1f2-caa9-4c16-9963-29258bbd9b99",
                                                "sense_id": "54847872-61f2-37a0-8998-1892139da889",
                                                "text": "The heavy freight traffic which shares the double line between Paddington and Wolverhampton with the passenger traffic has taxed the ingenuity of the timetable planners."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52c1c48e-5cb6-34f0-beb4-efa8ab2a109b",
                                        "entry_id": "6ea49a8c-94c8-379b-995a-f77f365fb619",
                                        "glosses": [
                                            "An ingenuous action or thought."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1448c930-b5b1-4a6b-a26e-dfad2d6a5374",
                                                "sense_id": "52c1c48e-5cb6-34f0-beb4-efa8ab2a109b",
                                                "text": "Virility is sustained, preserved, even recaptured, by man's ingenuities, by exotic foods and drinks, by rare herbal compounds, by fantastical manipulations, goetic periapts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bd37c08-b1b1-3911-8cee-d337fa1ccfaf",
                                        "entry_id": "6ea49a8c-94c8-379b-995a-f77f365fb619",
                                        "glosses": [
                                            "Ingenuousness; honesty, straightforwardness"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "288e0685-d8bb-4580-82f1-27b8fc8aa601",
                                                "sense_id": "5bd37c08-b1b1-3911-8cee-d337fa1ccfaf",
                                                "text": "And therefore I apply my selfe to ingenuitie, and ever to speake truth and what I think[…]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
