                "senses": [
                    {
                        "sense_id": "7ee2909b-f4c1-3295-9666-590a86efaa71",
                        "entry_id": "7316dbdd-173f-30e1-9145-642bce4cb850",
                        "glosses": [
                            "имеющий большое количество суков, сучков, сучьев"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "761d90f4-9882-4477-bc08-7df74293a1ea",
                                "sense_id": "7ee2909b-f4c1-3295-9666-590a86efaa71",
                                "text": "В конце улицы показался господин, шедший к ним навстречу, в картузе, с суковатой палкой в руке."
                            },
                            {
                                "example_id": "7c3e6f29-473e-4811-b48d-b1d956be4ef3",
                                "sense_id": "7ee2909b-f4c1-3295-9666-590a86efaa71",
                                "text": "Мы сидим на дубовой суковатой колоде, почерневшей от сырости; женщина хлопает ладонью по ней."
                            }
                        ]
                    }
                ],
