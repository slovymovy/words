                "senses": [
                    {
                        "sense_id": "90a7ce85-969f-389a-8c86-0ba6ee8513ba",
                        "entry_id": "5368f5c3-00f0-3dc0-b166-8718dcc11d4e",
                        "glosses": [
                            "Spielformen, die in öffentlichen Verkehrsräumen, wie auf Straßen und Plätzen, praktiziert werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "152b091e-d553-4ee7-ba58-9d1ec4521772",
                                "sense_id": "90a7ce85-969f-389a-8c86-0ba6ee8513ba",
                                "text": "„Sie wachsen schon deshalb nicht aus den Kindergarten- und Straßenspielen hervor, weil sie es mit einer anderen Ausgangssituation zu tun haben.“"
                            },
                            {
                                "example_id": "8231f3b5-8146-4d49-98b5-b493be67223d",
                                "sense_id": "90a7ce85-969f-389a-8c86-0ba6ee8513ba",
                                "text": "„Zu den dauerhaftesten Spielen gehören die Straßenspiele der Kinder.“"
                            },
                            {
                                "example_id": "6ce6713c-c44d-446c-891a-db3d7369d27c",
                                "sense_id": "90a7ce85-969f-389a-8c86-0ba6ee8513ba",
                                "text": "„Viele Straßenspiele und spielerische Kommunikationsformen, die sich noch vor wenigen Jahrzehnten beim Aufeinandertreffen von Kindern und Jugendlichen spontan entwickelten, lassen die dichte Bebauung, der moderne Verkehr, der Autotransport der Schüler nicht mehr zu.“"
                            },
                            {
                                "example_id": "8563f171-b152-41a2-8176-1a254abb1b9b",
                                "sense_id": "90a7ce85-969f-389a-8c86-0ba6ee8513ba",
                                "text": "„Die Idee, Straßenspiele für Erwachsene zu entwickeln, kommt aus New York.“"
                            },
                            {
                                "example_id": "38736414-80f2-42a6-8bba-1120c2f02e5b",
                                "sense_id": "90a7ce85-969f-389a-8c86-0ba6ee8513ba",
                                "text": "„Der Name leitet sich wahrscheinlich vom Begriff \"ca murra\" her, so nannte sich im 18. Jahrhundert der Chef und Streitschlichter des neapolitanischen Straßenspiels Murra.“"
                            },
                            {
                                "example_id": "4873e8a2-511a-48c8-a6cc-dfd2e4a4c619",
                                "sense_id": "90a7ce85-969f-389a-8c86-0ba6ee8513ba",
                                "text": "„95 Prozent der Friesensportler frönen heute einem Straßenspiel, dem Boßeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
