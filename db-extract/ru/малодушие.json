                    {
                        "translation_id": "afcc541a-a715-435e-a7b4-bbce5498e754",
                        "source_entry_id": "643a3b28-afe1-3cca-a171-f7391a19426e",
                        "source_sense_id": "2cb159fc-823f-3f4d-a7ff-22fe33cf9064",
