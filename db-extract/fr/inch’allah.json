                ],
                "senses": [
                    {
                        "sense_id": "84f2b88b-5d77-3d08-b6a6-51178be8b924",
                        "entry_id": "4b0ae7a4-72d1-3beb-bee1-cf9123f8823e",
                        "glosses": [
                            "Si Dieu le veut, si Dieu le permet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0df32b6-9721-4ccb-a3d3-43845e556f85",
                                "sense_id": "84f2b88b-5d77-3d08-b6a6-51178be8b924",
                                "text": "En achetant ce commerce il y a deux ans, je m’étais promis de ne pas faire la même erreur. Mais, à cause du Corona, j’ai continué à faire des avances et même à grande échelle. Aujourd’hui, on me doit 46 500 MRU [quelque 1 030 euros] que les villageois me rembourseront, Inch’Allah."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90ee9dda-6cf0-4deb-a8fb-936307d40171",
                        "source_entry_id": "4b0ae7a4-72d1-3beb-bee1-cf9123f8823e",
                        "source_sense_id": "84f2b88b-5d77-3d08-b6a6-51178be8b924",
                        "target_lang_word": "God willing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "God willing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d4df357-3dc4-3899-bd6c-8eac3899ede8",
                                        "entry_id": "97b693b3-9c6f-32c1-959a-0b08d290d651",
                                        "glosses": [
                                            "Barring unforeseen circumstances, it is hoped that (while generally also indicating acceptance of God's will)."
                                        ],
                                        "tags": [
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b30491df-c4c2-42ab-af04-7489f8df8501",
                                                "sense_id": "4d4df357-3dc4-3899-bd6c-8eac3899ede8",
                                                "text": "God willing, we'll meet again same time next year."
                                            },
                                            {
                                                "example_id": "421768b9-9fa2-47f3-bff1-a2c4b953a180",
                                                "sense_id": "4d4df357-3dc4-3899-bd6c-8eac3899ede8",
                                                "text": "See y'all again same time next year, God willing."
                                            },
                                            {
                                                "example_id": "4ba4ba8b-59d0-41ec-b1e2-df26b211328f",
                                                "sense_id": "4d4df357-3dc4-3899-bd6c-8eac3899ede8",
                                                "text": "And what so poor a man as Hamlet is May do, to express his love and friending to you, God willing, shall not lack."
                                            },
                                            {
                                                "example_id": "72bcc29f-c8d5-4dd5-bee3-3055bccced6f",
                                                "sense_id": "4d4df357-3dc4-3899-bd6c-8eac3899ede8",
                                                "text": "My wife and I have two kids a little bit younger than you all. One is in college and one is supposed to start this fall (God willing)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6aa353c6-e691-44be-bdea-ca56e29f321e",
                        "source_entry_id": "4b0ae7a4-72d1-3beb-bee1-cf9123f8823e",
                        "source_sense_id": "84f2b88b-5d77-3d08-b6a6-51178be8b924",
