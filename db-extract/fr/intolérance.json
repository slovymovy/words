                                        "examples": [
                                            {
                                                "example_id": "2ab790bf-c712-4cb3-9f89-cd4165d14e68",
                                                "sense_id": "e9c18a06-1b34-367a-977e-cdd7de7354be",
                                                "text": "Religious intolerance is a serious problem in Brazil."
                                            },
                                            {
                                                "example_id": "bfb529e4-c507-477a-bcec-87222d6a3ca6",
                                                "sense_id": "e9c18a06-1b34-367a-977e-cdd7de7354be",
                                                "text": "By some paradoxical evolution rancour and intolerance have been established in the vanguard of primitive Christianity. Mrs. Spoker, in common with many of the stricter disciples of righteousness, was as inclement in demeanour as she was cadaverous in aspect."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8543bcf-1fc0-3851-a963-f0bdb3c5eb4c",
                                        "entry_id": "33ab14de-a63f-39e5-bc25-11ce61c59b46",
                                        "glosses": [
                                            "Extreme sensitivity to a food or drug; of a food that is generally considered edible, an individual inability to digest it."
