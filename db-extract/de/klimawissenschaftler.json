                "senses": [
                    {
                        "sense_id": "24341086-f135-307c-a7a9-4ca04454c5aa",
                        "entry_id": "d5c7eb70-8c4b-3901-9697-abda4190f32b",
                        "glosses": [
                            "Forscher, der sich mit den Gesetzmäßigkeiten des Klimas und seinen Veränderungen im Zeitverlauf beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8c5b43b-a217-42fc-9cb1-033ae11a159b",
                                "sense_id": "24341086-f135-307c-a7a9-4ca04454c5aa",
                                "text": "„Klimawissenschaftler gehen davon aus, dass sich die Waldbrandgefahr im Rahmen des Klimawandels weiter erhöht.“"
                            },
                            {
                                "example_id": "d9e5aef1-f2d7-490a-97cc-2124d0f70f9a",
                                "sense_id": "24341086-f135-307c-a7a9-4ca04454c5aa",
                                "text": "„Fast alle aktiv veröffentlichenden Klimawissenschaftler unterstützen den Konsens über den menschengemachten Klimawandel.“"
                            },
                            {
                                "example_id": "b281a83a-2c6b-4987-ac66-ac4973823d4a",
                                "sense_id": "24341086-f135-307c-a7a9-4ca04454c5aa",
                                "text": "„Was wir momentan schon im April erleben, ist die Erfüllung der Prophezeiung, die einige Klimawissenschaftler schon vor 20 Jahren abgegeben haben: Die Dürrejahre werden zunehmen - nicht jedes Jahr, aber deutlich häufiger als in der Vergangenheit.“"
                            },
                            {
                                "example_id": "dbec3a1c-b304-4b63-a36c-203e079b6749",
                                "sense_id": "24341086-f135-307c-a7a9-4ca04454c5aa",
                                "text": "„Klimawissenschaftler gehen von einem CO₂-Budget aus, bei dessen Überschreitung unkalkulierbare Folgen eintreten würden,“ […]."
                            },
                            {
                                "example_id": "c565e513-8cdb-43a4-a7ed-579db00bf6db",
                                "sense_id": "24341086-f135-307c-a7a9-4ca04454c5aa",
                                "text": "„Nach dem Studium hat er an der ETH Zürich doktoriert und als Klimawissenschaftler gearbeitet.“"
                            },
                            {
                                "example_id": "82f4fbf3-5adf-4877-abef-b2d568c6b7b7",
                                "sense_id": "24341086-f135-307c-a7a9-4ca04454c5aa",
                                "text": "„Klimawissenschaftler werden persönlich angegriffen und regelrecht verleumdet.“"
                            },
                            {
                                "example_id": "5d6067ed-4371-45dd-a493-e07536aae4bb",
                                "sense_id": "24341086-f135-307c-a7a9-4ca04454c5aa",
                                "text": "„Tierschützer greifen oft Klimawissenschaftler an, nur weil diese darauf hinweisen, dass der Beitrag des Fleischessens im Vergleich zur Verbrennung fossiler Brennstoffe gering ist.“"
                            },
                            {
                                "example_id": "ec9bc9d1-af61-419b-9315-c31ee7ad35e7",
                                "sense_id": "24341086-f135-307c-a7a9-4ca04454c5aa",
                                "text": "„Hass im Netz: Klimawissenschaftler und vor allem Klimawissenschaftlerinnen erleben oft brutale Hetze“"
                            },
                            {
                                "example_id": "2209a246-7db9-4785-8d6d-03abf839d9d4",
                                "sense_id": "24341086-f135-307c-a7a9-4ca04454c5aa",
                                "text": "„Wie bei einer Wippe gibt es im System Erde mehrere Kipppunkte - davon gehen Klimawissenschaftler aus. Ist so ein Punkt erreicht, dann setzt das einen sich selbst verstärkenden Prozess in Gang.“"
                            },
                            {
                                "example_id": "573d742d-c992-4563-86d5-255ea5760d03",
                                "sense_id": "24341086-f135-307c-a7a9-4ca04454c5aa",
                                "text": "„»Jeder Mensch kriegt drei Tonnen CO2 pro Jahr, aber wer mehr braucht, muss es sich eben einkaufen«, erklärt der Klimawissenschaftler, und zwar von anderen, die weniger ausstoßen.“"
                            },
                            {
                                "example_id": "225d466d-bf83-425e-a41e-bf512d7252da",
                                "sense_id": "24341086-f135-307c-a7a9-4ca04454c5aa",
                                "text": "„Klimawissenschaftler haben berechnet, dass eine solche Junihitzewelle im Jahr 1900 statistisch gesehen nur alle 50 bis 100 Jahre einmal vorkam. Mit dem Klimawandel sind solche Hitzewellen im Juni nun viel wahrscheinlicher geworden und kommen alle 5 bis 20 Jahre vor.“"
                            },
                            {
                                "example_id": "f5b9a931-2e14-4b78-ab4e-26a963e9fede",
                                "sense_id": "24341086-f135-307c-a7a9-4ca04454c5aa",
                                "text": "„Auch in Frankreich kommen Klimawissenschaftler zum Schluss, dass der Klimawandel die Wahrscheinlichkeit einer solchen Hitzewelle um mindestens den Faktor 5 erhöht hat.“"
                            },
                            {
                                "example_id": "1d2657e1-9784-4453-bee8-5548fbf2648a",
                                "sense_id": "24341086-f135-307c-a7a9-4ca04454c5aa",
                                "text": "„Das jährliche Update der Weltwetterorganisation WMO nutzt das Fachwissen international anerkannter Klimawissenschaftler und die besten Vorhersagesysteme führender Klimazentren auf der ganzen Welt.“"
                            },
                            {
                                "example_id": "c7618250-777a-4736-b347-e70db963d1b0",
                                "sense_id": "24341086-f135-307c-a7a9-4ca04454c5aa",
                                "text": "„Michael Mann, ausgezeichneter Professor für Atmosphärenwissenschaften an der Penn State University und Autor von The New Climate War, sieht eine gewisse Ironie in der Tatsache, dass man »Klimawissenschaftler aufgrund ihrer Vorhersagen immer als Alarmisten abgetan hat – dabei waren diese Prognosen hochgradig konservativ. Das sehen wir daran, dass die Folgen des Klimawandels schon heute dramatischer sind, als die Vorhersagen angekündigt haben.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "96ed4bf2-23ab-46bb-bf27-ab4d7e2e096d",
