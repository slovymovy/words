                "senses": [
                    {
                        "sense_id": "b96067f6-d8ef-3eb3-97cd-32d04effd279",
                        "entry_id": "6811db47-41ff-329b-8a9e-db1e50839fa4",
                        "glosses": [
                            "upset, disappointment, frustration, vexation (emotions)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e63807d7-e8e1-4e30-9b92-b069ce65d09f",
                                "sense_id": "b96067f6-d8ef-3eb3-97cd-32d04effd279",
                                "text": "Проигра́в игру́, я чу́вствовал то́лько расстро́йство.",
                                "translation": "Having lost the game, I felt only disappointment.",
                                "english": "Having lost the game, I felt only disappointment."
                            }
                        ]
                    },
                    {
                        "sense_id": "a7306453-f409-3694-8e32-e061f38cb4f0",
                        "entry_id": "6811db47-41ff-329b-8a9e-db1e50839fa4",
                        "glosses": [
                            "Something that causes the above."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fceac3d-2bd8-4bbe-a187-53ca4a747e4f",
                                "sense_id": "a7306453-f409-3694-8e32-e061f38cb4f0",
                                "text": "То что сы́н ма́том руга́ется, э́то коне́чно расстро́йство.",
                                "translation": "The fact that my son swears is, of course, a disappointment.",
                                "english": "The fact that my son swears is, of course, a disappointment."
                            }
                        ]
                    },
                    {
                        "sense_id": "77357379-565d-37d6-8e71-0a17d7bb5655",
                        "entry_id": "6811db47-41ff-329b-8a9e-db1e50839fa4",
                        "glosses": [
                            "upset, disturbance, disruption, imbalance"
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "eed4bc16-1045-4af7-9712-44462be56aac",
                                "sense_id": "77357379-565d-37d6-8e71-0a17d7bb5655",
                                "text": "Расстро́йство в пото́ке во́здуха над крыло́м мо́жет вы́звать сва́ливание.",
                                "translation": "An upset of airflow over a wing can cause a stall.",
                                "english": "An upset of airflow over a wing can cause a stall."
                            }
                        ]
                    },
                    {
                        "sense_id": "62534274-e9fd-3111-a5ec-aa00661e4698",
                        "entry_id": "6811db47-41ff-329b-8a9e-db1e50839fa4",
                        "glosses": [
                            "disorder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "beb2877f-ade5-453d-8a14-d6ba365365d0",
                                "sense_id": "62534274-e9fd-3111-a5ec-aa00661e4698",
                                "text": "посттравмати́ческое стре́ссовое расстро́йство",
                                "translation": "post-traumatic stress disorder",
                                "english": "post-traumatic stress disorder"
                            }
                        ]
                    },
                    {
                        "sense_id": "a2c04b99-e5ca-38a6-8d8f-c0745e28e925",
                        "entry_id": "6811db47-41ff-329b-8a9e-db1e50839fa4",
                        "glosses": [
                            "The state of an instrument being out of tune."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb96bec2-c203-4fa3-9fbc-22854739b170",
                                "sense_id": "a2c04b99-e5ca-38a6-8d8f-c0745e28e925",
                                "text": "Расстро́йство мое́й фле́йты ста́ло заме́тно как то́лько орке́стр на́чал игра́ть.",
                                "translation": "It became apparent that my flute was out of tune as soon as the orchestra started to play.",
                                "english": "It became apparent that my flute was out of tune as soon as the orchestra started to play."
                            }
                        ]
                    },
                    {
