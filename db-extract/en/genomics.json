                                "target_senses": [
                                    {
                                        "sense_id": "8aea3089-933d-35c1-beae-cc782af55325",
                                        "entry_id": "5d8fa5f8-9c5c-31d7-8e7e-c82f4f8b3040",
                                        "glosses": [
                                            "Branche de la génétique qui étudie les génomes."
                                        ],
                                        "tags": [
                                            "Génétique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d57d50b-6cc0-486d-b8f0-fbc236737cda",
                                                "sense_id": "8aea3089-933d-35c1-beae-cc782af55325",
                                                "text": "L’émergence de nouvelles disciplines comme la génomique ainsi que le développement de la biochimie résultent de la connaissance du rôle des molécules qui composent les êtres vivants sur leurs propriétés."
                                            },
                                            {
                                                "example_id": "76eac3e9-cc9c-43c9-9ba6-746c8172f673",
                                                "sense_id": "8aea3089-933d-35c1-beae-cc782af55325",
                                                "text": "Venons-en donc à la cosméto-génomique, application de la génomique à la cosmétologie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "génomique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eb94102e-1480-3f7d-8e7b-d2e9ec28041d",
                                        "entry_id": "129c6824-2c4c-37b5-b727-c07df1e20353",
                                        "glosses": [
                                            "Qui a un rapport avec le génome."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4f6105e-1998-4d85-8501-ce7cb9442a20",
                                                "sense_id": "eb94102e-1480-3f7d-8e7b-d2e9ec28041d",
                                                "text": "Le phénomène dit « d’empreinte génomique », découvert en 1984 par Azim Surani à Cambridge, constitue une autre façon de violer les lois de Mendel."
                                            },
                                            {
                                                "example_id": "c5737168-f332-4cdf-95de-4ffa7b559892",
                                                "sense_id": "eb94102e-1480-3f7d-8e7b-d2e9ec28041d",
                                                "text": "Yavem était une célébrité dans son domaine. Il s'était spécialisé dans la différenciation génomique des membres d'une même famille. Ses recherches avaient permis d'établir une base génétique pour un certain nombre de maladies. On évoquait souvent son nom dans la liste des nobélisables potentiels."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4a5cdc3-59f2-45cd-9840-9cc471ed85c6",
                        "source_entry_id": "3579cf79-9964-3977-a7cb-4518d292b043",
