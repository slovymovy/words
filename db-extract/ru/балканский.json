                "senses": [
                    {
                        "sense_id": "473fce38-e403-3722-a04e-c0c784b286b9",
                        "entry_id": "97cf8b89-9dff-3db7-8965-c6888b6a5dc5",
                        "glosses": [
                            "относящийся к Балканам"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09b5cf3b-24f9-4604-9e86-805f43d4d579",
                                "sense_id": "473fce38-e403-3722-a04e-c0c784b286b9",
                                "text": "Гарибальди, сын знаменитого итальянского национального героя, выразил уверенность, что если к весне не будет улажен дипломатическим путём балканский кризис, то на Балканах вспыхнет война против Австрии, которая втянет туда и Италию, так как настроение последней далеко не в пользу союзницы."
                            }
                        ]
