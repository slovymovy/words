                "senses": [
                    {
                        "sense_id": "390039af-ead0-3eef-93f2-a0a658f7dadf",
                        "entry_id": "59ba7fa3-2481-3687-809c-b6f97b5c44d3",
                        "glosses": [
                            "Variante von Kölnisch Wasser, die in der Türkei als Parfum und Hausmittel gegen leichte körperliche Beschwerden verwendet und Gästen zur Handdesinfektion gereicht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14a51952-23de-4692-aabb-49dd867d3615",
                                "sense_id": "390039af-ead0-3eef-93f2-a0a658f7dadf",
                                "text": "„Kolonya wurde schnell Volksparfum und Allheilmittel dazu: Kopfschmerzen? Ein Spritzer auf die Schläfen. Beim Rasieren geschnitten? Kolonya einmassiert.“"
                            },
                            {
                                "example_id": "0eeeaf46-94e8-450f-9959-51bf164b0471",
                                "sense_id": "390039af-ead0-3eef-93f2-a0a658f7dadf",
                                "text": "„Mit einem Kamm kontrolliert er gekonnt den Schopfbrand. Am Ende kommt – klar – satt Kolonya rein. Ich rieche wie nach einem Bad in Limoncello.“"
                            },
                            {
                                "example_id": "5bc82957-d103-4d66-91bd-39f28beb20d7",
                                "sense_id": "390039af-ead0-3eef-93f2-a0a658f7dadf",
                                "text": "„‚Kolonya ausverkauft‘-Schilder schmücken mittlerweile die Märkte in der Türkei. Denn die Türken hamstern in der Corona-Krise das Duftwasser, die türkische Variante des Kölnisch Wasser - als Ersatz für Hand-Desinfektionsmittel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
