                ],
                "senses": [
                    {
                        "sense_id": "c5f8d4fd-dfef-39f3-bbcc-0434b438f73c",
                        "entry_id": "bddbd4c9-a009-3da4-9533-526dafe84851",
                        "glosses": [
                            "Donner un caractère quotidien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "050cfae3-68e5-4965-b206-67a9d36b4ed4",
                                "sense_id": "c5f8d4fd-dfef-39f3-bbcc-0434b438f73c",
                                "text": "Pour employer une expression wébérienne, le réformisme permet de « quotidianiser le socialisme »."
                            },
                            {
                                "example_id": "e047be70-9339-4027-a700-32b146c8c664",
                                "sense_id": "c5f8d4fd-dfef-39f3-bbcc-0434b438f73c",
                                "text": "La quotidienneté s'immisce-t-elle dans l'histoire au point de la « quotidianiser » (B. Bégout) ?"
                            },
                            {
                                "example_id": "5fd296d1-65c5-4d5f-87a3-e84a0bf55544",
                                "sense_id": "c5f8d4fd-dfef-39f3-bbcc-0434b438f73c",
                                "text": "Je crois, de manière naïve peut-être, que le mal ne peut pas se quotidianiser, que s'il devient tout de même quotidien, et s'inscrit en lui durablement, le quotidien lui-même n’est plus alors totalement ordinaire et banal, mais prend un aspect étrange et absurde."
                            }
                        ]
                    }
