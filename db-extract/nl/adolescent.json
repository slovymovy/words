                    {
                        "translation_id": "39b4d47d-e58e-44bf-a3bd-c00fd45a2292",
                        "source_entry_id": "6a57d68d-951e-3c4b-ab7f-15ecd9ef7e37",
                        "source_sense_id": "8c8a8f46-41e7-3cfc-a0de-a331055c5c79",
