        "fr-extract.jsonl": [
            {
                "entry_id": "59eeef3c-fb5e-3c0d-b2d0-3818cb6d847e",
                "word": "cubiste",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "627acfce-1a81-43fe-a1d2-45a2731b354e",
                        "entry_id": "59eeef3c-fb5e-3c0d-b2d0-3818cb6d847e",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "cubistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ed333c6a-e7bb-33c2-afea-3ee544b3b51d",
                        "entry_id": "59eeef3c-fb5e-3c0d-b2d0-3818cb6d847e",
                        "glosses": [
                            "Relatif au cubisme, qui appartient au cubisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26fd3c72-10c8-43da-bdd4-59ae5b36b5a3",
                                "sense_id": "ed333c6a-e7bb-33c2-afea-3ee544b3b51d",
                                "text": "Un tableau cubiste."
                            },
                            {
                                "example_id": "e8a6465e-31f9-4b1f-aa38-67cf8be5ce59",
                                "sense_id": "ed333c6a-e7bb-33c2-afea-3ee544b3b51d",
                                "text": "Mais Cézanne a déjà à cette date stimulé la peinture d’avant-garde avec l’apparition en 1907 de l’esthétique cubiste."
                            },
                            {
                                "example_id": "b9e7d610-14c6-4274-8871-873d5809534e",
                                "sense_id": "ed333c6a-e7bb-33c2-afea-3ee544b3b51d",
                                "text": "La collection faisait sans doute partie de la décoration, comme la grande fresque murale cubiste sur un mur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b071d63-26fe-490e-8d60-e88a1dd0bfa2",
                        "source_entry_id": "59eeef3c-fb5e-3c0d-b2d0-3818cb6d847e",
                        "source_sense_id": "ed333c6a-e7bb-33c2-afea-3ee544b3b51d",
                        "target_lang_word": "cubist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cubist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3114c66a-cd44-382e-8686-fb55e9eb136b",
                                        "entry_id": "dbabaf33-2596-3583-9e5e-fcdab6fd14bd",
                                        "glosses": [
                                            "Alternative letter-case form of Cubist."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5d1c2ae-5bda-49cb-8ff6-5adbf7e6bf5a",
                                                "sense_id": "3114c66a-cd44-382e-8686-fb55e9eb136b",
                                                "text": "They sat on cubist sofas in full evening dress and allowed us to hand them thimbles of cherry brandy and to talk to them about their poetry."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cubist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00498df1-d545-3e37-a07b-619c1b5e0a38",
                                        "entry_id": "e88cbd12-67dd-39b8-967e-0667a696b5fb",
                                        "glosses": [
                                            "Alternative letter-case form of Cubist."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cubist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99ade163-b0fd-3ed2-ae74-15e56784cbd5",
                                        "entry_id": "b3486714-33ba-3f6f-b071-12c2c19c6a63",
                                        "glosses": [
                                            "A player of Rubik's cube; a cuber."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "696b9fc0-7f1a-4f6b-822d-c46c668008da",
                                                "sense_id": "99ade163-b0fd-3ed2-ae74-15e56784cbd5",
                                                "text": "[…] as far as I know there is no standard word describing the art of playing with the cube. Cubing? Cubistics? Rubikonomia? or perhaps Rubikomania? Can the science (or art) of doing it be called “cubology”, as suggested by Scientific American? Some enthusiasts borrow “cubism” and call themselves “cubists”, all very reminiscent of the 1920s three dimensional, modern art phase."
                                            },
                                            {
                                                "example_id": "e5278e6b-8532-4c2c-8e84-fc446a58b886",
                                                "sense_id": "99ade163-b0fd-3ed2-ae74-15e56784cbd5",
                                                "text": "Being a new reader of this group and a novice cubist, I'm not familiar with either of these notations. Would someone please fill me in? Thanks in advance for the help."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "f4b480f7-1089-3f39-ba8b-4999d0aa9303",
                "word": "cubiste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
