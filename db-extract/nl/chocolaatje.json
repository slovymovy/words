                                    },
                                    {
                                        "sense_id": "356626b5-20a6-3fac-ae1c-0f461541f539",
                                        "entry_id": "7b1aeaf0-287f-3fff-a62a-59d4dce2da2a",
                                        "glosses": [
                                            "Black (relating to any of various ethnic groups having dark pigmentation of the skin)."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c11e977-34fc-4501-ae01-ba9f5121a0fe",
                                                "sense_id": "356626b5-20a6-3fac-ae1c-0f461541f539",
                                                "text": "She was a chocolate honey with all the assets necessary to never have to work hard to pay her bills."
                                            },
                                            {
                                                "example_id": "ff9c2ac1-8ede-48fa-9db8-27353aa983c6",
                                                "sense_id": "356626b5-20a6-3fac-ae1c-0f461541f539",
                                                "text": "Therefore, African Americans complexion range from fair to mahogony. When a baby is born, it's always a mystery of the hue of the child. Sometimes the child will be as white as the slave owner or as chocolate as a great great grandparent."
                                            },
                                            {
                                                "example_id": "d9d6c9b5-23f4-44bf-92d0-b9aabe9e9759",
                                                "sense_id": "356626b5-20a6-3fac-ae1c-0f461541f539",
                                                "text": "If you are as chocolate as an African queen, do you really think you'll look better as a bottle blonde?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chocolate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0634e846-ca4a-359b-bb74-c590c32c8647",
                                        "entry_id": "e5e7d3ac-ecd5-36a1-a663-cdd2f6df6db3",
                                        "glosses": [
                                            "To add chocolate to; to cover (food) in chocolate."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5ec34c74-016c-3ae4-9d76-c2035e9b08b0",
                                        "entry_id": "e5e7d3ac-ecd5-36a1-a663-cdd2f6df6db3",
                                        "glosses": [
                                            "To treat blood agar by heating in order to lyse the red blood cells in the medium."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ce4e7b8-0cfe-4442-9dea-3e44bce9bf4c",
                                                "sense_id": "5ec34c74-016c-3ae4-9d76-c2035e9b08b0",
                                                "text": "Other formulations have been adopted to supply these growth factors; these include heating or \"chocolating\" the blood agar to release NAD directly from the erythrocytes in the agar medium."
                                            },
                                            {
                                                "example_id": "3c54dafe-4b44-4cfc-86d0-b7021c5b7de1",
                                                "sense_id": "5ec34c74-016c-3ae4-9d76-c2035e9b08b0",
                                                "text": "It is a chocolated blood agar but here whole horse blood is used."
                                            },
                                            {
                                                "example_id": "e0c2426e-1275-452f-8edf-d0964975f836",
                                                "sense_id": "5ec34c74-016c-3ae4-9d76-c2035e9b08b0",
                                                "text": "The mixture is incubated at 75°C until chocolating has taken place."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4d12b89-62ae-4554-8465-74df1dc8fd0d",
                        "source_entry_id": "c3700f12-e0f5-3cb2-815d-88ebc3889007",
                        "source_sense_id": "8f3d1bd6-fc9b-3d52-9646-59f9f8b9eae7",
