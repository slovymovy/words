                                        "glosses": [
                                            "A blow with a cudgel or stick."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2880f3c-a520-4a35-8241-846f05c44ada",
                                                "sense_id": "7ddbd555-6847-30ff-bc4a-7fdb16bfd843",
                                                "text": "[H]e is Sir / The moſt vnutterable covvard, that ere nature / Bleſt vvith hard ſhoulders, vvhich vvere only giuen him, / To the ruine of baſtinados."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b35fb829-6add-3a3d-8737-12a441ee86fa",
                                        "entry_id": "6fdc9316-0272-3e35-9bff-5a895b6f69e7",
                                        "glosses": [
                                            "Beating the bare soles of the feet with a stick as a form of corporal punishment used primarily within prisons in various countries. The receiving person is required to be barefoot."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bastinado",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5496c648-34b8-37f4-b6dd-ce4cacc5059d",
                                        "entry_id": "94d90aa9-38bb-3af1-9915-0f719b5f9c69",
                                        "glosses": [
                                            "To punish a person by beating the bare soles of the feet, using a stick or truncheon."
                                        ],
