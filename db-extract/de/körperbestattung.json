                "senses": [
                    {
                        "sense_id": "cec2fe09-95d8-3333-89e7-b009c50c60f6",
                        "entry_id": "03d15ecb-5a90-332d-b051-4373884c2105",
                        "glosses": [
                            "Bestattung, bei der die Leiche des Verstorbenen als Ganzes/unverbrannt beerdigt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ab2a132-2ff0-46e1-a5a2-07f35b23328b",
                                "sense_id": "cec2fe09-95d8-3333-89e7-b009c50c60f6",
                                "text": "„Doch während sie in der frühen Hallstattzeit noch relativ selten anzutreffen ist, wird die Körperbestattung in der späten Hallstatt- und frühen Latènezeit zur vorherrschenden Bestattungsart.“"
                            },
                            {
                                "example_id": "7fd13ddf-0ca4-49ac-a1fa-c7341acee176",
                                "sense_id": "cec2fe09-95d8-3333-89e7-b009c50c60f6",
                                "text": "„In der Altsteinzeit, seit Beginn der Menschheitsgeschichte war die Körperbestattung die typische Beisetzungsform.“"
                            },
                            {
                                "example_id": "41762e5c-efb4-4f7c-a793-241687b63669",
                                "sense_id": "cec2fe09-95d8-3333-89e7-b009c50c60f6",
                                "text": "„Es gab auch die Körperbestattung in einem Sarkophag, also einem steinernen Sarg.“"
                            },
                            {
                                "example_id": "00f6e63d-22e4-430c-a8d7-ae7da9411547",
                                "sense_id": "cec2fe09-95d8-3333-89e7-b009c50c60f6",
                                "text": "„Der Übergang von Brand- zur Körperbestattung vollzog sich allmählich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1b97e32-3434-4740-85b1-d01a2d8603ce",
                        "source_entry_id": "03d15ecb-5a90-332d-b051-4373884c2105",
                        "source_sense_id": "cec2fe09-95d8-3333-89e7-b009c50c60f6",
                        "source_sense_description": "Bestattung, bei der die Leiche des Verstorbenen als Ganzes/unverbrannt beerdigt wird",
                        "target_lang_word": "inhumation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inhumation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35cddb1d-4ac7-3272-bc5b-24d5a08f3f87",
                                        "entry_id": "d4478c49-9d47-377f-8cf6-dae29272b87c",
                                        "glosses": [
                                            "The act of burial."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebb48398-2645-4913-bfec-fedabc8b4bf1",
                                                "sense_id": "35cddb1d-4ac7-3272-bc5b-24d5a08f3f87",
                                                "text": "\"Cremation versus Inhumation\" was the subject considered at the meeting of the Nineteenth Century Club at the residence of Mr. Courtlandt Palmer, No. 117 East One Hundred and Seventeenth-street, last evening."
                                            },
                                            {
                                                "example_id": "412ff7ba-44bc-49c0-83fb-801ce7e467a6",
                                                "sense_id": "35cddb1d-4ac7-3272-bc5b-24d5a08f3f87",
                                                "text": "Stampolidis's team has unearthed three types of Iron Age burials at Orthi Petra . . . dating from the ninth to the seventh century B.C.: pithos (large ceramic jar) burials, cremations, and basic inhumations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d83e7b0b-58f9-3509-bafc-d3f1defaadb2",
                                        "entry_id": "d4478c49-9d47-377f-8cf6-dae29272b87c",
                                        "glosses": [
                                            "The act of burying vessels in warm earth in order to expose their contents to a steady moderate heat; the state of being thus exposed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "81d5c293-4708-3a47-904b-1f4c62eb4281",
                                        "entry_id": "d4478c49-9d47-377f-8cf6-dae29272b87c",
                                        "glosses": [
                                            "Arenation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fe061625-2de2-4fe0-a9b2-444d27cc31ae",
                        "source_entry_id": "03d15ecb-5a90-332d-b051-4373884c2105",
                        "source_sense_id": "cec2fe09-95d8-3333-89e7-b009c50c60f6",
                        "source_sense_description": "Bestattung, bei der die Leiche des Verstorbenen als Ganzes/unverbrannt beerdigt wird",
                        "target_lang_word": "погребение",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "погребение",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "07c8f592-d179-318d-8ea2-0326266eff9a",
                                        "entry_id": "dfedea9b-fa7c-385e-968b-82dae08c5b63",
                                        "glosses": [
                                            "действие по значению гл. погребать; погрести"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5680b00c-4e04-408c-880f-0b705b73422e",
                                                "sense_id": "07c8f592-d179-318d-8ea2-0326266eff9a",
                                                "text": "Под красными знаменами их несли в красных гробах к стенам Кремля, где и было совершено погребение без присутствия духовенства."
                                            },
                                            {
                                                "example_id": "582aea4b-efbc-4f36-9902-aba0c92afb7b",
                                                "sense_id": "07c8f592-d179-318d-8ea2-0326266eff9a",
                                                "text": "На другой день отправлялось погребение Федора. Труп царя несли стольники в санях, а за ним в других санях несли молодую вдову Марфу Матвеевну."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e27a6ce3-0ec1-31fd-ac01-e0721b91a18b",
                                        "entry_id": "dfedea9b-fa7c-385e-968b-82dae08c5b63",
                                        "glosses": [
                                            "обряд (как правило торжественный) захоронения покойников в землю"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab21e7e8-abfa-4aa5-894d-30e303965eea",
                                                "sense_id": "e27a6ce3-0ec1-31fd-ac01-e0721b91a18b",
                                                "text": "А сказала я тебе про отца моего и мать, что пошли взаем плакать: так они пошли на погребение мертвого и там плачут; когда по них по самих придет смерть, другие по них станут плакать: это заимодавный плач."
                                            },
                                            {
                                                "example_id": "c0f8d0fb-3cf7-4df0-858a-3f07083a6441",
                                                "sense_id": "e27a6ce3-0ec1-31fd-ac01-e0721b91a18b",
                                                "text": "Закончив погребение, мужчины стянули фуражки, скорбно помолчали над могилой фронтовика, Арина, пронзенная печальной минутой, винясь за бедный похоронный обряд, горестно покачала головой"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b47b3de-628c-36c6-96c6-ec537c0df0d6",
                                        "entry_id": "dfedea9b-fa7c-385e-968b-82dae08c5b63",
                                        "glosses": [
                                            "место погребения [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3046687-05e7-466d-a3fd-cb5e2af0028e",
                                                "sense_id": "8b47b3de-628c-36c6-96c6-ec537c0df0d6",
                                                "text": "Впервые учёные подвергли классификации катакомбные погребения эпохи средней бронзы Кавказа в 1976 году."
                                            },
                                            {
                                                "example_id": "3692c57b-1368-477b-b591-af4173448f3f",
                                                "sense_id": "8b47b3de-628c-36c6-96c6-ec537c0df0d6",
                                                "text": "И это один из важнейших результатов исследования женского погребения из кургана 18 у села Колбино."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f5b018c-f00d-4903-b956-6e8cf935f31a",
                        "source_entry_id": "03d15ecb-5a90-332d-b051-4373884c2105",
                        "source_sense_id": "cec2fe09-95d8-3333-89e7-b009c50c60f6",
                        "source_sense_description": "Bestattung, bei der die Leiche des Verstorbenen als Ganzes/unverbrannt beerdigt wird",
                        "target_lang_word": "похороны",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "похороны",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1ab1043c-1dec-367a-a7f8-028f995c33bd",
                                        "entry_id": "7cf20b44-ff20-3465-a36a-fa8642231e44",
                                        "glosses": [
                                            "церемония, обряд проводов тела умершего для погребения, кремации и т. п., а также само погребение, кремация"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "346ad601-d15f-4c38-b125-a06d24e06a53",
                                                "sense_id": "1ab1043c-1dec-367a-a7f8-028f995c33bd",
                                                "text": "Как теперь помню ее похороны: я провожал тело старухи на католическое кладбище и плакал."
                                            },
                                            {
                                                "example_id": "a7d0ae05-6826-44ac-8fa7-cdd84fde9f33",
                                                "sense_id": "1ab1043c-1dec-367a-a7f8-028f995c33bd",
                                                "text": "Состоялись похороны жертвы террористов городового Васильева, умершего от ран."
                                            },
                                            {
                                                "example_id": "b9714062-32fe-4b52-9ed6-33ae619f35ea",
                                                "sense_id": "1ab1043c-1dec-367a-a7f8-028f995c33bd",
                                                "text": "и вспомнил Вадим его похороны: необитый гроб, поставленный на телеге, качался при каждом толчке; он с образом шел вперед…"
                                            },
                                            {
                                                "example_id": "22b6f686-9b2f-469b-b1c2-7b4a741a00de",
                                                "sense_id": "1ab1043c-1dec-367a-a7f8-028f995c33bd",
                                                "text": "И уместен ли барабан на похоронах человека, не имеющего военного чина? .."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27cac47c-4b1d-39d2-b9d3-bde223ee16da",
                                        "entry_id": "7cf20b44-ff20-3465-a36a-fa8642231e44",
                                        "glosses": [
                                            "разг. похоронная процессия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd645e96-878d-48b2-bf9f-fc0b353e0663",
                                                "sense_id": "27cac47c-4b1d-39d2-b9d3-bde223ee16da",
                                                "text": "Эти процессии напоминали собою похороны; при виде их невольно хотелось поднимать глаза к небу, чтобы прочесть там будущность и грядущую судьбу своего отечества."
                                            },
                                            {
                                                "example_id": "308556ec-03db-4abf-8990-d39de659bfcb",
                                                "sense_id": "27cac47c-4b1d-39d2-b9d3-bde223ee16da",
                                                "text": "А навстречу ей парадные похороны тянутся ― богатого покойника везут."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
