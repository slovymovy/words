{
    "word_family": [
        "strickle"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2516a4e0-146d-36ad-b461-6aefec6af711",
                    "sense_definition": "A bunch of hackled flax prepared for drawing into slivers.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "textile_production",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The worker carefully handled each <w>strick</w> of flax to ensure the fibers remained aligned.",
                            "target_lang_translations": {
                                "pl": "Robotnik ostrożnie obchodził się z każdą <w>garścią</w> lnu, aby włókna pozostały wyrównane."
                            }
                        },
                        {
                            "text": "After the hackling process, the <w>strick</w> is ready to be drawn into a continuous sliver.",
                            "target_lang_translations": {
                                "pl": "Po procesie czesania, <w>wiązka</w> jest gotowa do wyciągnięcia w ciągłe pasmo."
                            }
                        }
                    ],
                    "common_phrases": [
                        "strick of flax"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in textile manufacturing"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Wiązka wyczesanego lnu przygotowana do dalszej obróbki w procesie przędzenia."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "garść",
                                "target_lang_sense_clarification": "lnu lub konopi"
                            },
                            {
                                "target_lang_word": "wiązka",
                                "target_lang_sense_clarification": "włókien lnianych"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "370dbec1-6547-3f56-8a1f-1193198fed75",
                    "sense_definition": "A flat piece of wood used for levelling off grain in a measure; a <w>strickle</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "measuring_tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He used a wooden <w>strick</w> to level the grain in the bucket for an accurate measurement.",
                            "target_lang_translations": {
                                "pl": "Użył drewnianego <w>strychulca</w>, aby wyrównać ziarno w wiadrze w celu uzyskania dokładnego pomiaru."
                            }
                        },
                        {
                            "text": "The farmer kept a smooth <w>strick</w> hanging by the grain bin to ensure every bushel was fair.",
                            "target_lang_translations": {
                                "pl": "Rolnik trzymał gładki <w>strychulec</w> zawieszony przy zbiorniku na ziarno, aby mieć pewność, że każdy buszel był odmierzony uczciwie."
                            }
                        }
                    ],
                    "synonyms": [
                        "strickle"
                    ],
                    "common_phrases": [
                        "wooden strick"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "primarily used in historical agricultural contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Płaski kawałek drewna służący do wyrównywania poziomu ziarna w miarce; strychulec."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "strychulec",
                                "target_lang_sense_clarification": "narzędzie do wyrównywania sypkich produktów"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ec87675-f788-3c2d-8653-ffd362367e15",
                    "sense_definition": "A bushel measure.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "units_of_measure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The merchant sold the oats by the <w>strick</w> to the local villagers.",
                            "target_lang_translations": {
                                "pl": "Kupiec sprzedawał owies na <w>buszle</w> okolicznym mieszkańcom."
                            }
                        },
                        {
                            "text": "They calculated the total harvest yield in <w>stricks</w> before transporting it to the mill.",
                            "target_lang_translations": {
                                "pl": "Obliczyli całkowity plon w <w>miarach</w> przed przetransportowaniem go do młyna."
                            }
                        }
                    ],
                    "synonyms": [
                        "bushel"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical unit of measurement"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Dawna jednostka miary objętości ciał sypkich, odpowiadająca buszlowi."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "buszel",
                                "target_lang_sense_clarification": "jednostka miary"
                            },
                            {
                                "target_lang_word": "miara",
                                "target_lang_sense_clarification": "objętości ziarna"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}