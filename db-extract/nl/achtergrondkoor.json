                        "examples": [
                            {
                                "example_id": "fb510cfa-e2b5-4d87-b0bd-cf694b7caa77",
                                "sense_id": "dd7d0101-f0d0-3b61-a4a0-81f37f59ceb5",
                                "text": "Dit lied wil ik op mijn uitvaartdienst, wanneer de mensen de zaal in lopen. Wie niet huilt wanneer het achtergrondkoor erin komt, kan direct vertrekken."
                            },
                            {
                                "example_id": "36efa531-a411-4d12-ad42-3b025d50bb77",
                                "sense_id": "dd7d0101-f0d0-3b61-a4a0-81f37f59ceb5",
                                "text": "Zijn eigen hoogtepunten? \"Ik heb in mijn eigen bandje gespeeld. Iedereen mocht voor een tientje in het achtergrondkoor. Ook heb ik meegedaan aan een sloepenrace, een fotowedstrijd en bier getapt.\""
                            }
                        ]
