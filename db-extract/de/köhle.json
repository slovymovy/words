                ],
                "senses": [
                    {
                        "sense_id": "2e93edbc-67c4-3e8a-aa07-6cb69fa8bece",
                        "entry_id": "df58e5d2-d853-39d0-a31d-ec143a9126aa",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50ed4318-719a-4bd2-81c0-5b229c57aaf0",
                                "sense_id": "2e93edbc-67c4-3e8a-aa07-6cb69fa8bece",
                                "text": "Frau Köhle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5a452342-e186-4f40-a041-bea7119f8870",
                                "sense_id": "2e93edbc-67c4-3e8a-aa07-6cb69fa8bece",
                                "text": "Herr Köhle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "496a2c37-432f-42ba-a6af-8a929a4a2714",
                                "sense_id": "2e93edbc-67c4-3e8a-aa07-6cb69fa8bece",
                                "text": "Die Köhles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "e05349a8-bb86-4808-80b8-af3cb75f4077",
                                "sense_id": "2e93edbc-67c4-3e8a-aa07-6cb69fa8bece",
                                "text": "Der Köhle trägt nie die Schals, die die Köhle ihm strickt."
                            },
                            {
                                "example_id": "bd21e7c6-8837-40ec-9263-2aec0843eb47",
                                "sense_id": "2e93edbc-67c4-3e8a-aa07-6cb69fa8bece",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Köhle kommt, geht der Herr Köhle.“"
                            },
                            {
                                "example_id": "9dd05f0e-ddd9-407a-a42b-197cc3e80319",
                                "sense_id": "2e93edbc-67c4-3e8a-aa07-6cb69fa8bece",
                                "text": "Köhle kommt und geht."
                            },
                            {
                                "example_id": "c416c1ac-1347-41fa-aafa-d95cae2639a4",
                                "sense_id": "2e93edbc-67c4-3e8a-aa07-6cb69fa8bece",
                                "text": "Köhles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
