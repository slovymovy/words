                    {
                        "sense_id": "d80c0b3e-71ef-30dd-a18b-7df69a1ecef6",
                        "entry_id": "72f68395-d04d-3dac-874d-c70aea952429",
                        "glosses": [
                            "Chiffre qui exprime le nombre mille dans une date."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34dad8a3-b1b4-4842-afa2-612c36ff1819",
                                "sense_id": "d80c0b3e-71ef-30dd-a18b-7df69a1ecef6",
                                "text": "Le millésime de 2017 est 2"
                            }
                        ]
                    },
                    {
                        "sense_id": "98cf488c-b63f-3a89-847d-06310eb6d844",
                        "entry_id": "72f68395-d04d-3dac-874d-c70aea952429",
                        "glosses": [
                            "Ensemble des chiffres qui marquent l’année sur les médailles, les monnaies."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "234f68bb-7949-4966-bc7a-39e21ae8b062",
                                "sense_id": "98cf488c-b63f-3a89-847d-06310eb6d844",
                                "text": "Les louis d'or portant le millésime de l'année 1723 furent appelés mirlitons, et sont encore ainsi nommés par les numismates érudits, qui les colligent et vénèrent à cause de cette singularité."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ee0d129-ef50-3ff4-8567-4dd89306ee24",
                        "entry_id": "72f68395-d04d-3dac-874d-c70aea952429",
                        "glosses": [
                            "Ensemble des chiffres qui marquent l’année de publication."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e386fc6-c17b-40cd-8896-7d4072370581",
                                "sense_id": "0ee0d129-ef50-3ff4-8567-4dd89306ee24",
                                "text": "Mais le bibliophile qui était en lui consolait le lettré, maniant avec des mains dévotes la superbe édition qu’il possédait du Satyricon, l’in-8 portant le millésime 1585 et le nom de J. Dousa, à Leyde."
                            }
                        ]
                    },
                    {
                        "sense_id": "9fb49e3d-619c-3577-a052-b3a47f73ccaa",
                        "entry_id": "72f68395-d04d-3dac-874d-c70aea952429",
                        "glosses": [
                            "Lot de quelque chose associée à une certaine année."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "0cea9a87-4f3a-3ccf-a335-90666fc145aa",
                        "entry_id": "72f68395-d04d-3dac-874d-c70aea952429",
                        "glosses": [
                            "Année de récolte des raisins ayant servi à produire un vin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "355302ab-d66f-4a05-bb04-0b6bdba2174e",
                                "sense_id": "0cea9a87-4f3a-3ccf-a335-90666fc145aa",
                                "text": "Selon la législation européenne, l'indication du millésime sur les étiquettes est autorisée seulement pour les VQPRD et les vins de table avec indication géographique."
                            }
                        ]
                    },
                    {
                        "sense_id": "732aa0af-5218-33f0-a146-6b8237027c91",
                        "entry_id": "72f68395-d04d-3dac-874d-c70aea952429",
                        "glosses": [
                            "Cuvée d’une année vinicole exceptionnelle."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "786782ba-b5ec-4d33-971e-17bdd953cf46",
                                "sense_id": "732aa0af-5218-33f0-a146-6b8237027c91",
                                "text": "Vous me direz ce que vous pensez de ce millésime."
                            }
                        ]
                    }
