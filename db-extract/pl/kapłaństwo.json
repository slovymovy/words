                "senses": [
                    {
                        "sense_id": "86e7d61d-3712-307c-a6d8-a4e5ebc812ce",
                        "entry_id": "4b97fbcb-fb13-340a-a898-d48c76f42648",
                        "glosses": [
                            "godność lub urząd kapłana"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54ef988f-c1c5-4a71-a100-c2b31c83628d",
                                "sense_id": "86e7d61d-3712-307c-a6d8-a4e5ebc812ce",
                                "text": "Zaczęto dyskutować nad kapłaństwem kobiet."
                            },
                            {
                                "example_id": "eea1a385-1cb2-4b1e-9dac-cb82d592d18b",
                                "sense_id": "86e7d61d-3712-307c-a6d8-a4e5ebc812ce",
                                "text": "Własnego kapłaństwa się boję, • własnego kapłaństwa się lękam • i przed kapłaństwem w proch padam, • i przed kapłaństwem klękam"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "d034a101-7829-37e2-bf84-5cfb95154060",
                        "entry_id": "4b97fbcb-fb13-340a-a898-d48c76f42648",
                        "glosses": [
                            "sakrament święceń w chrześcijaństwie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5efacd81-1dfb-454b-a2fa-7f46933d5046",
                                "sense_id": "d034a101-7829-37e2-bf84-5cfb95154060",
                                "text": "Kapłaństwo jest jednym z siedmiu sakramentów."
                            },
                            {
                                "example_id": "4eed76b0-61b1-4bc5-814a-5fbef88d7a99",
                                "sense_id": "d034a101-7829-37e2-bf84-5cfb95154060",
                                "text": "W wielu posługach dla wspólnoty sakrament kapłaństwa ma szczególne znaczenie"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
