                                        "entry_id": "4a6968be-6d04-3028-8403-e004bde71792",
                                        "glosses": [
                                            "Famille de langue rassemblant une quarantaine de langues. La sous-famille principale est la famille tupi-guarani."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c423205-cab4-498c-9fa6-b070db9f7961",
                                                "sense_id": "beea0cda-3812-3692-a445-d93d19183baa",
                                                "text": "Un sabir à base de tupi s'est […] diffusé à travers tout le Brésil dans toutes les tribus en contact plus ou moins direct avec les Européens."
                                            }
                                        ]
                                    }
                                ]
