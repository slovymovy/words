    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "95529245-de0d-3578-97a9-c968c58c8f5f",
                    "sense_definition": "Dangerously insecure, unstable, or perilous.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "unstable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ladder was placed in a <w>precarious</w> position, making it very dangerous to climb.",
                            "target_lang_translations": {
                                "ru": "Лестница была установлена в <w>шатком</w> положении, из-за чего подниматься по ней было очень опасно.",
                                "tr": "Merdiven <w>eğreti</w> bir konuma yerleştirilmişti, bu da tırmanmayı çok tehlikeli hale getiriyordu."
                            }
                        },
                        {
                            "text": "Many freelance workers live in a <w>precarious</w> financial situation without a steady monthly income.",
                            "target_lang_translations": {
                                "ru": "Многие фрилансеры живут в <w>ненадёжном</w> финансовом положении без стабильного ежемесячного дохода.",
                                "tr": "Birçok serbest çalışan, düzenli bir aylık gelir olmadan <w>güvencesiz</w> bir finansal durumda yaşıyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "unsteady",
                        "shaky",
                        "unsafe",
                        "unstable",
                        "wobbly"
                    ],
                    "antonyms": [
                        "stable",
                        "secure",
                        "safe"
                    ],
                    "common_phrases": [
                        "precarious position",
                        "precarious situation",
                        "precarious balance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Опасно ненадежный, нестабильный или угрожающий безопасности.",
                        "tr": "Tehlikeli derecede güvensiz, istikrarsız veya emniyetsiz."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шаткий",
                                "target_lang_sense_clarification": "о положении, равновесии или конструкции"
                            },
                            {
                                "target_lang_word": "ненадёжный",
                                "target_lang_sense_clarification": "о финансовом или социальном положении"
                            },
                            {
                                "target_lang_word": "рискованный",
                                "target_lang_sense_clarification": "о ситуации или предприятии"
                            },
                            {
