                ],
                "senses": [
                    {
                        "sense_id": "3a1884c7-a24e-390f-9f94-3294b8bc75c9",
                        "entry_id": "3fed69ba-a2a3-39a8-ab9c-55dc30d33b1e",
                        "glosses": [
                            "Qui abonde en calamités."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "585aae3b-227e-4e1e-9a4a-769f183fc6e0",
                                "sense_id": "3a1884c7-a24e-390f-9f94-3294b8bc75c9",
                                "text": "En face des projets calamiteux qui se mijotent par ici, le Nationalistes algériens, de leur côté, ne restent pas inactifs."
                            },
                            {
                                "example_id": "2eb9007c-fcae-466d-9cd3-2f6ae222becd",
                                "sense_id": "3a1884c7-a24e-390f-9f94-3294b8bc75c9",
                                "text": "Mes meilleures expériences de voyages avaient souvent démarré sous de calamiteux auspices."
                            },
                            {
                                "example_id": "2e570456-4e94-4342-b871-a174e2dc02b0",
                                "sense_id": "3a1884c7-a24e-390f-9f94-3294b8bc75c9",
                                "text": "Quand on se penche sur le bilan de Pierre Elliott Trudeau dans le cas du Québec, le bilan est calamiteux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "27fcc82f-4d73-4d68-920c-23c519b5fe17",
                        "source_entry_id": "3fed69ba-a2a3-39a8-ab9c-55dc30d33b1e",
                        "source_sense_id": "3a1884c7-a24e-390f-9f94-3294b8bc75c9",
                        "target_lang_word": "calamitous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calamitous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53811647-41de-3565-87d0-a9d876c6f2dc",
                                        "entry_id": "baa298e8-a0e7-3c90-9110-3628aefe4661",
                                        "glosses": [
                                            "Causing or involving calamity; disastrous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5132c452-ab64-431c-a068-3354f9c762f6",
                                                "sense_id": "53811647-41de-3565-87d0-a9d876c6f2dc",
                                                "text": "The city was struck by a calamitous cyclone."
                                            },
                                            {
                                                "example_id": "7886f4eb-8688-42ac-bae6-d692bfbf8113",
                                                "sense_id": "53811647-41de-3565-87d0-a9d876c6f2dc",
                                                "text": "[T]he fallacie of Æquivocation and Amphibologie, […] conclude from the ambiguity of ſome vvord, or the ambiguous ſintaxis of many put together. From this fallacy aroſe the calamitous error of the Jevves, miſapprehending the Propheſies of their Meſſias, and expounding them alvvayes unto literall and temporal expectation."
                                            },
                                            {
                                                "example_id": "f93444d1-1979-4c38-a222-59e1d0cccf3c",
                                                "sense_id": "53811647-41de-3565-87d0-a9d876c6f2dc",
                                                "text": "The next year vvas calamitous, bringing ſtrange fluxes upon men, and murren upon Cattel."
                                            },
                                            {
                                                "example_id": "63565a48-d30d-4521-bd5f-6024031fc4f7",
                                                "sense_id": "53811647-41de-3565-87d0-a9d876c6f2dc",
                                                "text": "In former times it vvas a diſmal and calamitous thing for a tradeſman to break: vvhen it befell a family, it put all into confuſion and diſtraction; […]"
                                            },
                                            {
                                                "example_id": "f1b676ed-ae91-4a06-8559-42252dece1ae",
                                                "sense_id": "53811647-41de-3565-87d0-a9d876c6f2dc",
                                                "text": "Let him therefore lay dovvn his employment, vvhatever it be, vvhen he can no longer exert his former activity or attention; for nothing is more calamitous, than to croud the ſtage till a general hiſs commands him to depart."
                                            },
                                            {
                                                "example_id": "2e2e869d-322f-450a-b7a7-5e6609faa474",
                                                "sense_id": "53811647-41de-3565-87d0-a9d876c6f2dc",
                                                "text": "For critics, foremost among them liberal intellectuals and human rights activists, Xi [Jinping]'s first term has proved calamitous. Some had hoped he would prove a political reformer. Instead, China's authoritarian leader has waged war on dissent with unexpected ferocity, throwing some opponents in jail and forcing others overseas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cc491a5-7ce3-305d-8737-cb3ff9727bc1",
                                        "entry_id": "baa298e8-a0e7-3c90-9110-3628aefe4661",
                                        "glosses": [
                                            "Of a person: involved in a calamity; hence, distressed, miserable."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6e32ff5-837d-478a-803a-3a1afad3f715",
                                                "sense_id": "2cc491a5-7ce3-305d-8737-cb3ff9727bc1",
                                                "text": "Nor ought a Judge, in taking cognizance of a Cauſe, to ſhevv any Anger or Reſentment againſt ſuch Perſons as he conceives to be his Enemies, nor to be prevailed on by the Tears and Prayers of calamitous Perſons, nor ought he to affect to be thought Good-natured or Moroſe, Merciful or Severe, but let him act vvith Calmneſs as the Lavv directs; […]"
                                            },
                                            {
                                                "example_id": "a8945b02-8d76-4b58-b084-38a0b78c533d",
                                                "sense_id": "2cc491a5-7ce3-305d-8737-cb3ff9727bc1",
                                                "text": "Thou haſt ſeen me happy and calamitous, thou haſt beheld my exaltation and my fall."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08bcf8ea-afb5-43bb-a32e-297a5d8a38f6",
                        "source_entry_id": "3fed69ba-a2a3-39a8-ab9c-55dc30d33b1e",
                        "source_sense_id": "3a1884c7-a24e-390f-9f94-3294b8bc75c9",
                        "target_lang_word": "disastrous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disastrous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36f98f6c-8256-396b-961b-99487434a3b2",
                                        "entry_id": "c73b4df6-2da7-3972-befe-b1c2fe2634c2",
                                        "glosses": [
                                            "Of the nature of a disaster; calamitous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4faa0c76-40e4-4954-b910-c72198362083",
                                                "sense_id": "36f98f6c-8256-396b-961b-99487434a3b2",
                                                "text": "In addition, he was also able to reinforce the unease among progressive Democratic-leaning voters over Clinton’s disastrous pro-interventionist positions, thereby suppressing turnout and encouraging third party support in some key swing states that made the difference in his Electoral College victory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9b3b43d-8c13-3f3e-b82b-8536bdfecab2",
                                        "entry_id": "c73b4df6-2da7-3972-befe-b1c2fe2634c2",
                                        "glosses": [
                                            "Foreboding disaster; ill-omened."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d62ba1d-71ce-4aa1-8e8a-757a6028a994",
                                                "sense_id": "c9b3b43d-8c13-3f3e-b82b-8536bdfecab2",
                                                "text": "A fearsome sight it was to behold how he swelled in his wrath, and his eyes blazed like disastrous stars at midnight, and being wood with anger he gnashed his teeth till the froth stood at his lips and slavered down his chin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
