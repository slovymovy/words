                ],
                "senses": [
                    {
                        "sense_id": "51cbd215-8582-3d1b-8b2c-11d84d69dc07",
                        "entry_id": "670ef3e2-7003-3630-9a67-84cfc39dfebc",
                        "glosses": [
                            "mit Werkzeugen ausgestatteter Raum, beispielsweise für Holzarbeiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5eabcc5f-b86f-4d99-890a-e6d15a34c0d6",
                                "sense_id": "51cbd215-8582-3d1b-8b2c-11d84d69dc07",
                                "text": "Die Kinder lieben den Bastelraum im Kindergarten."
                            },
                            {
                                "example_id": "3058480b-3df5-443e-8862-70cdeb42a269",
                                "sense_id": "51cbd215-8582-3d1b-8b2c-11d84d69dc07",
                                "text": "Wir haben in unserem Bastelraum kleine Modellflugzeuge mit Gummizugpropeller zusammengebaut."
                            },
                            {
                                "example_id": "68ecff84-8ac5-4aed-9b4f-27fe185ad01c",
                                "sense_id": "51cbd215-8582-3d1b-8b2c-11d84d69dc07",
                                "text": "Väter bedrucken zusammen mit ihren Söhnen und Töchtern im Bastelraum der Ferienanlage T-Shirts mit kleinen Logos."
                            },
                            {
                                "example_id": "eb96b6de-826f-42e2-afe7-f096919a686d",
                                "sense_id": "51cbd215-8582-3d1b-8b2c-11d84d69dc07",
                                "text": "„Im Bastelraum der „Arche“ sitzt ein Mädchen, sieben Jahre alt, mit einer Mitarbeiterin und steckt Bügelperlen-Bilder für ihre Eltern.“"
                            },
                            {
                                "example_id": "73c1f43f-0593-4c08-b67a-9a4200292559",
                                "sense_id": "51cbd215-8582-3d1b-8b2c-11d84d69dc07",
                                "text": "„[…] dieser Bastelraum war so ganz anders als der im Kinderheim: In der Mitte des Raums stand ein großer Holztisch mit Mal- und Bastelsachen darauf. Und es roch auch nicht nach Terpentin oder Kernseife.“"
                            },
                            {
                                "example_id": "e6e2bf61-56f1-4547-b02f-4dca82009f86",
                                "sense_id": "51cbd215-8582-3d1b-8b2c-11d84d69dc07",
                                "text": "„Arthurs Zunge berührt beinahe seine Nasenspitze, so konzentriert ist der lockige Fünftklässler. »Hätte ich nur eine andere Frisur«, stöhnt er, während er im Bastelraum des Märkischen Museums seine Silhouette aus schwarzer Pappe ausschneidet.“"
                            },
                            {
                                "example_id": "1901b623-6663-4905-b8f7-fbfff28f4143",
                                "sense_id": "51cbd215-8582-3d1b-8b2c-11d84d69dc07",
                                "text": "„Auf einem Tisch im Bastelraum liegen Scheren und Filzmaler, drumherum sitzen acht Senioren konzentriert über Papierbögen. Sorgfältig malen sie Mandalas aus, manche mit zitternder Hand.“"
                            },
                            {
                                "example_id": "0d84a86d-3044-4529-8903-30aaab7ea141",
                                "sense_id": "51cbd215-8582-3d1b-8b2c-11d84d69dc07",
                                "text": "„Irmela hatte ihren Entwurf, der eine verschnörkelte Vase, gefüllt mit üppigen Rosen, Nelken und Glockenblumen, darstellte, auf dem verschrammten Tisch im Bastelraum ausgebreitet.“"
                            },
                            {
                                "example_id": "df81a81c-4259-404a-9b70-a4703cbb6d62",
                                "sense_id": "51cbd215-8582-3d1b-8b2c-11d84d69dc07",
                                "text": "„Frauen äußern häufiger den Wunsch nach einem begehbaren Schrank, einem Bügelzimmer und einem Schuhraum. Männer dagegen wollen einen Bastelraum, einen Party- und auch einen Weinkeller.“"
                            },
                            {
                                "example_id": "95063238-5ca4-41ac-99f5-1b83442fc889",
                                "sense_id": "51cbd215-8582-3d1b-8b2c-11d84d69dc07",
                                "text": "„Vollmann wickelte diese Dinge […] in Plastiktüten und brachte sie in den Keller, den er sich als einen Bastelraum eingerichtet hatte, obwohl er so gut wie nie bastelte und nicht einmal das Wort ausstehen konnte. Der Bastelraum war eine Idee von Monika gewesen.“"
                            },
                            {
                                "example_id": "09669590-b302-46d1-b58e-568f7a374d3d",
                                "sense_id": "51cbd215-8582-3d1b-8b2c-11d84d69dc07",
                                "text": "„Leiterin Mathilde Golde zeigte den Stadträten den großen Spiel- und Bastelraum mit Kicker […].“"
                            },
                            {
                                "example_id": "56e8377e-a2ae-4650-ac8f-a01a8cabfa3b",
                                "sense_id": "51cbd215-8582-3d1b-8b2c-11d84d69dc07",
                                "text": "„MakerSpace in Garching, nördlich von München, ist die Alternative zum heimischen Bastelraum - eine öffentlich zugängliche, hoch professionelle Hightech-Werkstatt.“"
                            },
                            {
                                "example_id": "c2af81c4-8903-401a-823b-98efd0df4441",
                                "sense_id": "51cbd215-8582-3d1b-8b2c-11d84d69dc07",
                                "text": "„Das Feuer war gegen 10.45 Uhr im Bastelraum eines Einfamilienhauses ausgebrochen - der ladende Lithium-Ionen-Akku eines Modellauto hatte aus noch ungeklärter Ursache Feuer gefangen. Ein 34-Jähriger und sein 70 Jahre alter Vater versuchten zwar noch, das Feuer zu löschen, aber vergeblich: Der Bastelraum brannte vollständig aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
