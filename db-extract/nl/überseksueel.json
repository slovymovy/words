                    {
                        "sense_id": "210696be-9812-3401-9023-af8a35bc328c",
                        "entry_id": "b4ee5910-ab2e-3c76-aeea-9d21e0e9924f",
                        "glosses": [
                            "aantrekkelijk als man door een combinatie van traditionele mannelijkheid en modebewustzijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa793b46-debf-4fc9-93ea-67808e68e8c1",
                                "sense_id": "210696be-9812-3401-9023-af8a35bc328c",
                                "text": "Een beetje überseksuele man (cultureel ontwikkeld, stijlvol, mannelijk maar niet macho) neemt risico’s, maar laat zich adviseren door bladen die ’het’ weten."
                            }
                        ]
