                    {
                        "sense_id": "92261f20-b24d-3e5e-9f57-809ae96e3bdb",
                        "entry_id": "efc63e6a-98a8-3653-baf4-0c9266573f86",
                        "glosses": [
                            "Seide in unverarbeitetem, leimartigem Zustand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c741010-d3fd-4788-b0a6-2f53b13a97f7",
                                "sense_id": "92261f20-b24d-3e5e-9f57-809ae96e3bdb",
                                "text": "„Es steckte in dem offenen Kragen eines cremefarbenen Hemds aus Rohseide.“"
                            },
                            {
                                "example_id": "066816fe-548a-4b5b-a387-e60edb76442c",
                                "sense_id": "92261f20-b24d-3e5e-9f57-809ae96e3bdb",
                                "text": "„Er trug einen weichkrempigen Fedora, eine rote Fliege - und zwar keine, die man anklemmt, sondern eine, die er fachmännisch gebunden hatte -, ein hellblaues Hemd und einen weißen Anzug, der aus Rohseide sein musste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
