                                "example_id": "eed2d63a-c8ed-4b96-9010-bbb479d3eef2",
                                "sense_id": "7647fe16-dcfe-317f-a5c2-ca404a3c9e53",
                                "text": "In het noordoosten van het land heerst een tropisch klimaat."
                            },
                            {
                                "example_id": "2bd47d28-d8b6-43a5-a194-745095eae234",
                                "sense_id": "7647fe16-dcfe-317f-a5c2-ca404a3c9e53",
                                "text": "Voor Noord-Brabant geldt code oranje van 14.00 tot 19.00 uur. In Gelderland en Limburg is de weerwaarschuwing tussen 15.00 en 20.00 uur van kracht. En in Overijssel is het opletten tussen 16.00 en 21.00 uur. De buien trekken naar het noordoosten en verlaten zondagavond het land."
                            }
                        ]
                    }
