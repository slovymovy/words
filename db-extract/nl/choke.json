                                        "glosses": [
                                            "The mass of immature florets in the centre of the bud of an artichoke."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1ccadbe-8270-4137-aab7-5d993052064c",
                                                "sense_id": "7116b328-8461-3fd7-b76c-3fd1e639c259",
                                                "text": "Once all the leaves are gone, a hairy little island will remain in the middle of the artichoke. This is the “choke.” A gentleman uses his knife and fork to slice it away, uncovering the delicious artichoke “heart” underneath."
                                            }
                                        ]
                                    }
