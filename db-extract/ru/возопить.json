                "senses": [
                    {
                        "sense_id": "59f76192-0fab-3e2a-8c72-e1806431981b",
                        "entry_id": "d693f19a-a4b2-35ef-838c-1867e0375590",
                        "glosses": [
                            "высок. или ирон. начать громко кричать, вскричать, воззвать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "132edb52-c400-406d-a6dd-3ccbccbd84d3",
                                "sense_id": "59f76192-0fab-3e2a-8c72-e1806431981b",
                                "text": "Она вырвала руку, и вдруг как будто что-то возопило в ней: все из-за него!"
                            },
                            {
                                "example_id": "0539fd47-26b7-4427-814c-99a9e472f41f",
                                "sense_id": "59f76192-0fab-3e2a-8c72-e1806431981b",
                                "text": "― Опять ты, Макарушка, глотку мне затыкаешь? ― плачущим голосом возопил дед Щукарь."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "312b5ed3-922c-4afd-90e8-c80535f6f926",
                        "source_entry_id": "d693f19a-a4b2-35ef-838c-1867e0375590",
                        "source_sense_id": "59f76192-0fab-3e2a-8c72-e1806431981b",
                        "target_lang_word": "clamour",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clamour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87d0df71-e948-366b-ba8d-2ed217b08cab",
                                        "entry_id": "34bf21af-a811-33e3-bfaf-ca34f82d883b",
                                        "glosses": [
                                            "British and Canada standard spelling of clamor."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "UK",
                                            "alt-of",
                                            "countable",
                                            "standard",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5804d11b-62f9-4853-b23c-4494be9fc1b8",
                                                "sense_id": "87d0df71-e948-366b-ba8d-2ed217b08cab",
                                                "text": "Sickly eares Deaft with the clamours of their owne deare grones."
                                            },
                                            {
                                                "example_id": "281499a3-d45d-4c0e-bd4d-2eba2a244a4f",
                                                "sense_id": "87d0df71-e948-366b-ba8d-2ed217b08cab",
                                                "text": "For when he knew his Rival freed and gone, / He ſwells with Wrath; he makes outrageous Moan: / He frets, he fumes, he ſtares, he ſtamps the Ground; / The hollow Tow'r with Clamours rings around: […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "clamour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "286b6f55-1862-3b16-a541-089d42bd08be",
                                        "entry_id": "702dfdfb-a0e6-3ba9-8814-b056987eda1e",
                                        "glosses": [
                                            "British and Canada standard spelling of clamor."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "UK",
                                            "alt-of",
                                            "standard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64b01c63-5a85-41e0-b4d4-000ee9c8932f",
                                                "sense_id": "286b6f55-1862-3b16-a541-089d42bd08be",
                                                "text": "The second argument , against the integrity of the Law from this Omission , has been clamoured by a large Body of Answerers"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11f75c1d-74b6-36c7-95c8-2fde4a4f15d9",
                                        "entry_id": "702dfdfb-a0e6-3ba9-8814-b056987eda1e",
                                        "glosses": [
                                            "To salute loudly."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b5d01e7-bf1b-4abd-8cf6-2d2018b3a39b",
                                                "sense_id": "11f75c1d-74b6-36c7-95c8-2fde4a4f15d9",
                                                "text": "At ſight of him the people with a ſhout / Rifted the Air clamouring thir god with praiſe,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b6cf585-7f89-337b-b4fe-b72829a5cf90",
                                        "entry_id": "702dfdfb-a0e6-3ba9-8814-b056987eda1e",
                                        "glosses": [
                                            "To stun with noise."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90eccb22-60cc-4407-a2e0-0511e4e14938",
                                                "sense_id": "3b6cf585-7f89-337b-b4fe-b72829a5cf90",
                                                "text": "Let them not come..in a Tribunitious Manner; For that is, to clamour Counsels, not to enforme them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "925955b0-1d2d-3307-9c0e-8474c54e6cfe",
                                        "entry_id": "702dfdfb-a0e6-3ba9-8814-b056987eda1e",
                                        "glosses": [
                                            "To repeat the strokes quickly on (bells) so as to produce a loud clang."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
