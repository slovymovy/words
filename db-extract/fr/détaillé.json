                                "example_id": "5dcd2e77-b954-4d0f-b819-ecbd3146d673",
                                "sense_id": "6e2c4ea0-2f70-346d-a60a-4645ce51e73b",
                                "text": "Il aurait fait à l’instant même un portrait d’elle plus juste, plus vrai, plus détaillé."
                            }
                        ]
