                            },
                            {
                                "target_lang_word": "à la hauteur",
                                "target_lang_sense_clarification": "capable de faire face à une situation ou un défi"
                            },
                            {
                                "target_lang_word": "capable de faire face",
                                "target_lang_sense_clarification": "apte à surmonter une épreuve ou une difficulté"
