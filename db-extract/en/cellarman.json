                                        "sense_id": "f8888764-7890-3756-b499-2aef054184c3",
                                        "entry_id": "12b26927-894d-325c-a69f-069c481d5395",
                                        "glosses": [
                                            "ausgebildete Person, die für den Weinkeller und die sachgemäße Behandlung der Weine zuständig ist"
                                        ],
                                        "tags": [
                                            "Beruf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a016dd0-4945-46da-8384-a615938ce49b",
                                                "sense_id": "f8888764-7890-3756-b499-2aef054184c3",
                                                "text": "„Der Kellermeister Rudimann kommt herzu, ohne den fremden zu bemerken, und hält eine Weinprobe.“"
                                            },
                                            {
                                                "example_id": "6fedce82-62f8-41f4-b37d-6b0366c06df0",
                                                "sense_id": "f8888764-7890-3756-b499-2aef054184c3",
                                                "text": "„Wir haben mit Kellermeister Odilon de Varine über die Herstellung des perfekten Geschmacks von Champagner gesprochen – und einige seiner feinen Tropfen verkostet.“"
                                            },
                                            {
                                                "example_id": "e923d485-9272-43d2-970d-206c5219f928",
                                                "sense_id": "f8888764-7890-3756-b499-2aef054184c3",
                                                "text": "„Bis 2001 ließ sich Hao in Würzburg zum Weinküfer ausbilden, später folgte in Heilbronn die Weiterbildung zum Weinmacher oder Kellermeister.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08b9fbd2-b463-46cf-97a5-26565b88987e",
                        "source_entry_id": "6f5ede25-0aff-36a5-a8be-7422d4aa2f80",
                        "source_sense_id": "bf2154d2-d3de-324e-9fa5-c6a7a6559175",
                        "source_sense_description": "Kellermeister, Küfer",
                        "target_lang_word": "Küfer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Küfer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bfdef6e2-42a0-33f1-b12f-3426ea035c85",
                                        "entry_id": "c0bad17f-daa4-30f4-9c72-aa3e09059745",
                                        "glosses": [
                                            "Person, die beruflich Fässer und andere Holzgefäße herstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6a17af3-06b2-4eaf-81d8-5cbe5ed8694e",
                                                "sense_id": "bfdef6e2-42a0-33f1-b12f-3426ea035c85",
                                                "text": "Mein Großvater war Küfer."
                                            },
                                            {
                                                "example_id": "55ad0d1e-dbe0-413d-8822-30b20d76944e",
                                                "sense_id": "bfdef6e2-42a0-33f1-b12f-3426ea035c85",
                                                "text": "„An Land waren die Küfer besonders beansprucht worden.“"
                                            },
                                            {
                                                "example_id": "66a80169-dc02-4dd7-b9ef-aedf33c14d19",
                                                "sense_id": "bfdef6e2-42a0-33f1-b12f-3426ea035c85",
                                                "text": "„Die Küfer hämmern tagsüber und nachts aus schlanken Eichendauben die bauchigen blitzsauberen Fässer und ersetzen so, was altersschwach; was mit dem letzten Jahrgang gefüllt, ging weit in die Welt.“"
                                            },
                                            {
                                                "example_id": "6aee9c7b-510d-4af4-929f-a699a5fe2a90",
                                                "sense_id": "bfdef6e2-42a0-33f1-b12f-3426ea035c85",
                                                "text": "„Der Küfer, der seine Sorte wohl kannte, steckte einen Trichter in dieses Ungeheuer von Feldflasche und füllte es mit einem fast schwarzen Rotwein an.“"
                                            },
                                            {
                                                "example_id": "188d0116-7378-42f8-97f7-085e3ae78460",
                                                "sense_id": "bfdef6e2-42a0-33f1-b12f-3426ea035c85",
                                                "text": "„Der Küfer brachte Wein und trug dazu einen Teller mit Rauchfleisch und einem frischen Fisch auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
