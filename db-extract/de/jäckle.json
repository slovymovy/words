                "senses": [
                    {
                        "sense_id": "3333ba44-79e3-35b5-b80a-5eb5e4d83131",
                        "entry_id": "a1b13148-622a-3ced-bcb4-48c0b2b2a398",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd87d773-c716-40f7-8a5b-787f87c663c6",
                                "sense_id": "3333ba44-79e3-35b5-b80a-5eb5e4d83131",
                                "text": "Frau Jäckle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "759d6d46-502a-429a-a071-b8a39fcbe6ca",
                                "sense_id": "3333ba44-79e3-35b5-b80a-5eb5e4d83131",
                                "text": "Herr Jäckle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2e2f44da-10e9-47b7-ac35-f77329a6b328",
                                "sense_id": "3333ba44-79e3-35b5-b80a-5eb5e4d83131",
                                "text": "Die Jäckles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "afcc71dc-2b0d-488e-8aed-feb0d599468a",
                                "sense_id": "3333ba44-79e3-35b5-b80a-5eb5e4d83131",
                                "text": "Der Jäckle trägt nie die Schals, die die Jäckle ihm strickt."
                            },
                            {
                                "example_id": "4f8f3b51-7f9a-4bf3-850c-247796809bfd",
                                "sense_id": "3333ba44-79e3-35b5-b80a-5eb5e4d83131",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Jäckle kommt, geht der Herr Jäckle.“"
                            },
                            {
                                "example_id": "e5679350-40b7-4386-a8e7-3cc07b46690c",
                                "sense_id": "3333ba44-79e3-35b5-b80a-5eb5e4d83131",
                                "text": "Jäckle kommt und geht."
                            },
                            {
                                "example_id": "ce7bb387-5642-450d-8dfa-53216e6956bb",
                                "sense_id": "3333ba44-79e3-35b5-b80a-5eb5e4d83131",
                                "text": "Jäckles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
