{
    "word_family": [
        "whisht"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b219b5b7-730e-339b-8350-d2b402a81857",
                    "sense_definition": "A classic card game for four players in two partnerships, which was a predecessor to bridge.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "card_games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The elderly gentlemen spent every Tuesday evening playing <w>whist</w> at the local social club.",
                            "target_lang_translations": {
                                "ru": "Пожилые джентльмены каждый вечер вторника играли в <w>вист</w> в местном общественном клубе."
                            }
                        },
                        {
                            "text": "Before bridge became popular, a game of <w>whist</w> was the standard entertainment at formal gatherings.",
                            "target_lang_translations": {
                                "ru": "До того как стал популярен бридж, партия в <w>вист</w> была стандартным развлечением на официальных приемах."
                            }
                        }
                    ],
                    "common_phrases": [
                        "game of whist",
                        "play whist"
                    ],
                    "target_lang_definitions": {
                        "ru": "Классическая карточная игра для четырех игроков в двух партнерствах, предшественница бриджа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вист",
                                "target_lang_sense_clarification": "карточная игра"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68c1fe96-bbcf-34a5-afb4-3943996cb0df",
                    "sense_definition": "A social event or session dedicated to playing the card game whist.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "card_games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The village hall is hosting a charity <w>whist</w> drive to raise money for the new roof.",
                            "target_lang_translations": {
                                "ru": "В сельском клубе проводится благотворительный <w>вечер виста</w>, чтобы собрать деньги на новую крышу."
                            }
                        },
                        {
                            "text": "They organized a competitive <w>whist</w> that lasted well into the early hours of the morning.",
                            "target_lang_translations": {
                                "ru": "Они организовали соревновательную <w>партию в вист</w>, которая затянулась до раннего утра."
                            }
                        }
                    ],
                    "common_phrases": [
                        "whist drive"
                    ],
                    "target_lang_definitions": {
                        "ru": "Общественное мероприятие или сессия, посвященная игре в вист."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "партия в вист",
                                "target_lang_sense_clarification": "игровой сеанс"
                            },
                            {
                                "target_lang_word": "вечер виста",
                                "target_lang_sense_clarification": "социальное мероприятие"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "7e3b5187-b15b-3c56-8f56-865ca86b2110",
                    "sense_definition": "A command or request to be silent; an alternative spelling of <w>whisht</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "silence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guide turned to the group and whispered a sharp <w>whist</w> to ensure they remained undetected.",
                            "target_lang_translations": {
                                "ru": "Гид повернулся к группе и резко прошептал «<w>тсс</w>», чтобы их не обнаружили."
                            }
                        },
                        {
                            "text": "“<w>Whist</w>!” she cautioned, holding a finger to her lips as she heard footsteps approaching the door.",
                            "target_lang_translations": {
                                "ru": "«<w>Тише</w>!» — предостерегла она, приложив палец к губам, когда услышала шаги, приближающиеся к двери."
                            }
                        }
                    ],
                    "synonyms": [
                        "hush",
                        "shush",
                        "be quiet"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "often found in Irish or Scottish English contexts"
                        },
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Приказ или просьба замолчать; вариант написания слова whisht."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тсс",
                                "target_lang_sense_clarification": "призыв к тишине"
                            },
                            {
                                "target_lang_word": "тише",
                                "target_lang_sense_clarification": "просьба замолчать"
                            },
                            {
                                "target_lang_word": "молчать",
                                "target_lang_sense_clarification": "резкая команда"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8824ea87-54f0-37c0-9cff-ff35412fc318",
                    "sense_definition": "Characterized by silence or being hushed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "silence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet described the wild waves <w>whist</w> as the storm finally began to subside.",
                            "target_lang_translations": {
                                "ru": "Поэт описал, как буйные волны <w>притихли</w>, когда шторм наконец начал утихать."
                            }
                        },
                        {
                            "text": "In the <w>whist</w> midnight air, even the smallest sound seemed to echo through the valley.",
                            "target_lang_translations": {
                                "ru": "В <w>безмолвном</w> полуночном воздухе даже малейший звук эхом разносился по долине."
                            }
                        }
                    ],
                    "synonyms": [
                        "silent",
                        "hushed",
                        "still"
                    ],
                    "antonyms": [
                        "noisy",
                        "loud"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "primarily found in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся тишиной или безмолвием."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тихий",
                                "target_lang_sense_clarification": "беззвучный"
                            },
                            {
                                "target_lang_word": "безмолвный",
                                "target_lang_sense_clarification": "литературно о тишине"
                            },
                            {
                                "target_lang_word": "притихший",
                                "target_lang_sense_clarification": "ставший тихим"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2b29b894-3f5c-3f14-939a-1649356ed9e7",
                    "sense_definition": "To make someone or something silent; to hush or still.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "silence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mother <w>whisted</w> her crying child before the guests entered the room.",
                            "target_lang_translations": {
                                "ru": "Мать <w>утихомирила</w> плачущего ребенка до того, как гости вошли в комнату."
                            }
                        },
                        {
                            "text": "The sudden appearance of the teacher <w>whisted</w> the rowdy classroom instantly.",
                            "target_lang_translations": {
                                "ru": "Внезапное появление учителя мгновенно <w>заставило умолкнуть</w> шумный класс."
                            }
                        }
                    ],
                    "synonyms": [
                        "hush",
                        "silence",
                        "still"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as a verb in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставить кого-либо или что-либо замолчать; утихомирить или успокоить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утихомиривать",
                                "target_lang_sense_clarification": "заставлять замолчать"
                            },
                            {
                                "target_lang_word": "заставлять умолкнуть",
                                "target_lang_sense_clarification": "прекращать шум"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8086fe92-fd40-3aeb-8d8d-06ee99b191d8",
                    "sense_definition": "To become silent or quiet.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "silence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As the sun set, the birds <w>whisted</w> and the forest grew dark and still.",
                            "target_lang_translations": {
                                "ru": "Когда солнце зашло, птицы <w>затихли</w>, и в лесу стало темно и тихо."
                            }
                        },
                        {
                            "text": "The audience <w>whisted</w> as soon as the conductor raised his baton to begin.",
                            "target_lang_translations": {
                                "ru": "Публика <w>умолкла</w>, как только дирижер поднял палочку, чтобы начать."
                            }
                        }
                    ],
                    "synonyms": [
                        "quieten",
                        "fall silent"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "primarily literary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стать тихим или замолчать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затихать",
                                "target_lang_sense_clarification": "становиться тише"
                            },
                            {
                                "target_lang_word": "умолкать",
                                "target_lang_sense_clarification": "переставать говорить или звучать"
                            }
                        ]
                    }
                }
            ]
        }
    ]
