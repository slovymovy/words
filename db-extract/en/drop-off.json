                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "08b0c40d-1ad5-3d5e-8c99-4fb63a0d2689",
                        "entry_id": "fd576ea3-665a-33e7-be28-009649329c8b",
                        "glosses": [
                            "A sudden downward slope or cliff.",
                            "The precipitous outer side of a coral reef, facing the open sea."
