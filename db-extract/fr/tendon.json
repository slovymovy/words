            {
                "entry_id": "9e79ca62-6ca7-3421-8ce9-d1c9afb7dba1",
                "word": "tendon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c1dd3287-5065-4e54-85ed-a586c2db04c5",
                        "entry_id": "9e79ca62-6ca7-3421-8ce9-d1c9afb7dba1",
                        "tags": [
                            "plural"
                        ],
                        "form": "tendons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d998becf-363d-36ea-9215-60fae6e6ba11",
                        "entry_id": "9e79ca62-6ca7-3421-8ce9-d1c9afb7dba1",
                        "glosses": [
                            "Partie fibreuse, blanchâtre, ronde ou aplatie, qui forme l’extrémité des muscles et qui sert à les attacher aux os ou à d’autres parties."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54c5c270-fe3e-4678-995e-ccbb4032237b",
                                "sense_id": "d998becf-363d-36ea-9215-60fae6e6ba11",
                                "text": "Le tendon d’un gros muscle."
                            },
                            {
                                "example_id": "aceba367-cda3-4998-80d5-5925b68eed8e",
                                "sense_id": "d998becf-363d-36ea-9215-60fae6e6ba11",
                                "text": "Il y a des muscles à plusieurs tendons."
                            },
                            {
                                "example_id": "65ad942b-d0e2-4907-9cab-b32ca69262e4",
                                "sense_id": "d998becf-363d-36ea-9215-60fae6e6ba11",
                                "text": "Avec son menton saillant et les tendons de son cou décharné, qui tirent sa peau, comme les cordes tirent les toiles d’une tente, elle ressemble aux sorcières qui jettent des sorts."
                            },
                            {
                                "example_id": "be04d47c-7bfe-4dd0-99e0-ad2a25a1ff2b",
                                "sense_id": "d998becf-363d-36ea-9215-60fae6e6ba11",
                                "text": "Il avait été impressionné par cette tête d’une maigreur de bête sauvage et surtout par les tendons du cou, si apparents qu’ils semblaient des cordes attachant cette tête à ce froc."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ef7e6d5-7a5c-31e4-8b5e-d0668926659f",
                        "entry_id": "9e79ca62-6ca7-3421-8ce9-d1c9afb7dba1",
                        "glosses": [
                            "Partie postérieure des jambes des chevaux."
                        ],
                        "tags": [
                            "Médecine vétérinaire"
                        ],
                        "examples": [
                            {
                                "example_id": "42710def-60d8-4178-8adc-ebf266c67d4d",
                                "sense_id": "3ef7e6d5-7a5c-31e4-8b5e-d0668926659f",
                                "text": "L’enclouure sera grave, si le pus, après avoir long-temps séjourné dans le pied, a carié l'os, ou si, après avoir fusé dessous la chair de la couronne, il a gâté, ou le tendon extenseur, ou le cartilage latéral, ou l'articulation."
                            },
                            {
                                "example_id": "d7931282-97fc-4abb-9465-54d41e4e8c70",
                                "sense_id": "3ef7e6d5-7a5c-31e4-8b5e-d0668926659f",
                                "text": "Ce cheval a le tendon bien détaché, bien net."
                            },
                            {
                                "example_id": "3492f66d-7654-4ed5-883c-785dd78da463",
                                "sense_id": "3ef7e6d5-7a5c-31e4-8b5e-d0668926659f",
                                "text": "Il a le tendon engorgé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a6b8e92-537e-4809-94de-8f85390aad36",
                        "source_entry_id": "9e79ca62-6ca7-3421-8ce9-d1c9afb7dba1",
                        "source_sense_description": "Anatomie",
                        "target_lang_word": "Sehne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sehne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "44d7ed27-f82e-3b55-8cc1-145971703fb6",
                                        "entry_id": "3b486d07-99d4-3b44-878b-c21e9ffeaab7",
                                        "glosses": [
                                            "Band aus Bindegewebe zwischen Muskeln und Knochen zur wechselseitigen Übertragung der im Bewegungsablauf auftretenden mechanischen Kräfte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "308467ad-3193-4cd3-81db-c6bc04a43fd1",
                                                "sense_id": "44d7ed27-f82e-3b55-8cc1-145971703fb6",
                                                "text": "Er hat sich eine Sehne gerissen."
                                            },
                                            {
                                                "example_id": "e2860df6-27f9-4b51-86ec-d3c68b774889",
                                                "sense_id": "44d7ed27-f82e-3b55-8cc1-145971703fb6",
                                                "text": "Sie hat sich eine Zerrung der Sehne zugezogen."
                                            },
                                            {
                                                "example_id": "fcbf173f-1d44-46f7-b6cf-2fbef0035dcd",
                                                "sense_id": "44d7ed27-f82e-3b55-8cc1-145971703fb6",
                                                "text": "„In ihrer Kniekehle zeichneten sich die Sehnen ab, weil sie sie, die Schläge erwartend, angespannt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aed78e91-de9f-317e-ad63-ff6f2fd8fb96",
                                        "entry_id": "3b486d07-99d4-3b44-878b-c21e9ffeaab7",
                                        "glosses": [
                                            "die kürzeste Verbindungsstrecke zwischen zwei Punkten auf einem Kreis oder einer anderen gekrümmten Kurve."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddb771b0-1636-49a6-9c0b-aeeb4ee060d5",
                                                "sense_id": "aed78e91-de9f-317e-ad63-ff6f2fd8fb96",
                                                "text": "Jede Sehne am Kreis ist kürzer als beide zugehörigen Bögen."
                                            },
                                            {
                                                "example_id": "e7760b44-cabc-4bd4-999d-3235fd8ab4cc",
                                                "sense_id": "aed78e91-de9f-317e-ad63-ff6f2fd8fb96",
                                                "text": "Ein Sehnenviereck ist ein Viereck, dessen sämtliche vier Ecken auf demselben Kreis liegen. Seine Seiten sind also Sehnen genau dieses Kreises."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e52b56b7-4545-3710-ae08-62ede133e570",
                                        "entry_id": "3b486d07-99d4-3b44-878b-c21e9ffeaab7",
                                        "glosses": [
                                            "Teil eines Bogens"
                                        ],
                                        "tags": [
                                            "Waffenkunde"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af62f8f1-4215-4515-b728-5e81a6b5713b",
                                                "sense_id": "e52b56b7-4545-3710-ae08-62ede133e570",
                                                "text": "Die Sehne eines Bogens schnellt nach dem Abschuss des Pfeils zurück."
                                            },
                                            {
                                                "example_id": "0e2f1e10-27ad-48c4-8f95-e22616147d7d",
                                                "sense_id": "e52b56b7-4545-3710-ae08-62ede133e570",
                                                "text": "„Die Sehne schnellte zurück, der Pfeil hatte zwischen der ersten und der zweiten Sprosse getroffen und die Schnur hindurchgezogen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0bc2f597-88f1-40ea-9796-0315e0510ca9",
                        "source_entry_id": "9e79ca62-6ca7-3421-8ce9-d1c9afb7dba1",
                        "source_sense_description": "Anatomie",
                        "target_lang_word": "sinew",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sinew",
