                {
                    "sense_id": "9b543b94-0082-321d-bb54-7d74a1d1c6b4",
                    "sense_definition": "A shortened form of <w>government</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "administration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The official <w>gov</w> website provides all the necessary forms for tax filing.",
                            "target_lang_translations": {
