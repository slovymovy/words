                        "glosses": [
                            "Of or pertaining to astrophysics."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "1f3e78cc-0d13-415a-9bcb-5afc8b0f7a73",
                                "sense_id": "2704a553-f59e-3200-b7bb-1cfabff3c4a7",
                                "text": "But many important astrophysical and atomic processes involving hydrogen, the most abundant element in the universe and in stars, give off ultraviolet light."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b733cfc3-276b-42d7-a1da-67f02e84d9a9",
                        "source_entry_id": "c869dfae-a32b-3928-a227-a9fb4b4b9024",
                        "source_sense_id": "2704a553-f59e-3200-b7bb-1cfabff3c4a7",
                        "source_sense_description": "of or pertaining to astrophysics",
                        "target_lang_word": "astrophysique",
