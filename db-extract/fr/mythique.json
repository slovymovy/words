                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95dbfc53-7e30-472f-bffd-b6d7f8781065",
                        "source_entry_id": "a7f874e8-27cb-3045-b5b2-c26f84cc6dcb",
                        "target_lang_word": "mythic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mythic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cbe67e47-f285-31fb-b1f1-47fe366794d9",
                                        "entry_id": "762c8fe5-e251-3380-b608-07e5332959cb",
                                        "glosses": [
                                            "Mythical; existing in myth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "764b6bdc-3b4e-4256-9181-7ca2d78a78b8",
                                                "sense_id": "cbe67e47-f285-31fb-b1f1-47fe366794d9",
                                                "text": "Whitehead-Gould has become a mythic presence in the case history fairy-tale: the personification of the selfish woman who went back on her promise to deliver up her child to an unfulfilled aspiring mother."
                                            },
                                            {
                                                "example_id": "3410cfea-bc40-4b95-aaa2-096fc6084f01",
                                                "sense_id": "cbe67e47-f285-31fb-b1f1-47fe366794d9",
                                                "text": "Bellerophon attempts to become a mythic hero by perfectly imitating the actuarial program for mythic heroes."
                                            },
                                            {
                                                "example_id": "ee3b05fb-103b-4298-ae36-70c8023de1f7",
                                                "sense_id": "cbe67e47-f285-31fb-b1f1-47fe366794d9",
                                                "text": "The Wyoming territories become a mythic space where character is tested and revealed and Good battles Evil."
                                            },
                                            {
                                                "example_id": "841dadbd-1d23-4774-8365-f89c876f5547",
                                                "sense_id": "cbe67e47-f285-31fb-b1f1-47fe366794d9",
                                                "text": "The ways in which Eastern Europe has become a mythic part of the Jewish past and not an imagined mythic home in the future is central to understanding how American Jews see themselves at home in America."
                                            },
                                            {
                                                "example_id": "d93e0a79-1e2b-48d1-9202-a202f2da3f3b",
                                                "sense_id": "cbe67e47-f285-31fb-b1f1-47fe366794d9",
                                                "text": "By the mid-nineteenth century tartan had become a mythic material encompassing ideas of nationhood, clanship, and political allegiance seen through increasingly fashionable and spectacular forms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8794fcb0-5da0-32a2-85b7-5a3bc06b69db",
                                        "entry_id": "762c8fe5-e251-3380-b608-07e5332959cb",
                                        "glosses": [
                                            "Very rare."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1054f03d-f4aa-3821-af32-86300b3531c0",
                                        "entry_id": "762c8fe5-e251-3380-b608-07e5332959cb",
                                        "glosses": [
                                            "Amazing, epic, legendary."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab054991-de63-4b66-ad57-2f503a26cf76",
                                                "sense_id": "1054f03d-f4aa-3821-af32-86300b3531c0",
                                                "text": "Had Pesky nailed Enos Slaughter in the 1946 Series, his throw home would have become a mythic moment."
                                            },
                                            {
                                                "example_id": "7cbd95ee-c389-439a-9f26-7b39a5a180df",
                                                "sense_id": "1054f03d-f4aa-3821-af32-86300b3531c0",
                                                "text": "There's far more than just hot dogs to feast on too. The pizzas—gigantic, floppy, with a hyperreal waxy sheen—are mythic. They arrive exclusively in cheese, pepperoni, or supreme—the holy trinity—and will run you an eminently affordable $1.99 for a ridiculously huge wedge-shaped slice."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
