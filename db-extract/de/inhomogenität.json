                ],
                "senses": [
                    {
                        "sense_id": "3f9a6827-be48-39ee-8323-36b4d2a174d1",
                        "entry_id": "49698276-af90-393d-b95d-a8a8cf1f5010",
                        "glosses": [
                            "Eigenschaft, nicht gleichmäßig einheitlich (nicht homogen) zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03b2fcd0-39d5-4be1-b056-246de5931731",
                                "sense_id": "3f9a6827-be48-39ee-8323-36b4d2a174d1",
                                "text": "„Außer bei den Kristallen, bei denen die die Doppelbrechung verursachende Inhomogenität eine durch die Kristallstruktur gegebene regelmäßige ist, wird auch durch jede beliebige Maßnahme, die eine Inhomogenität eines durchsichtigen Körpers erzeugt, Anisotropie hervorgerufen.“"
                            },
                            {
                                "example_id": "e64d7963-51d8-4a10-bcb9-03766a68d635",
                                "sense_id": "3f9a6827-be48-39ee-8323-36b4d2a174d1",
                                "text": "„Aufgrund der großen Unterschiede innerhalb der einzelnen Gruppen war es auch notwendig, die Streuungswerte zu berechnen. Auffallend war die Inhomogenität der Gruppen vor allem bei den hörgeschädigten/ gehörlosen Kindern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d1e6d215-31b9-3f3a-9a27-c30f70ebb27d",
                        "entry_id": "49698276-af90-393d-b95d-a8a8cf1f5010",
                        "glosses": [
                            "Sache, die nicht einheitlich gleichartig, vom gleichen Typ wie alles andere, ist"
                        ],
                        "tags": [
                            "mit Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "ec6c5c90-f862-4a48-a4bc-ed3cf6d32725",
                                "sense_id": "d1e6d215-31b9-3f3a-9a27-c30f70ebb27d",
                                "text": "„Keßler untersucht das Auftreten von makroskopisch hell sichtbaren Inhomogenitäten in der heißgepreßten Si3N4-Keramik. “"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
