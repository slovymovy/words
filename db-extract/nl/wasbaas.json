                        "examples": [
                            {
                                "example_id": "b8ec5601-7a33-42f7-b708-2194c9be8035",
                                "sense_id": "f48d3198-308e-3a76-a6dd-c09850a012bf",
                                "text": "Egyptische moslims hebben vandaag huizen van Koptische christenen in brand gestoken in een dorp in de omgeving van Caïro. De aanleiding voor de brandstichting was een ruzie tussen een moslim en een christelijke wasbaas die bij het strijken diens hemd had verbrand. Dat deelde de politie mee."
                            },
                            {
                                "example_id": "bfb9b7b3-c904-4ece-be4d-d675ee87da6b",
                                "sense_id": "f48d3198-308e-3a76-a6dd-c09850a012bf",
                                "text": "Inderdaad, waar het racisme betreft tonen Amerikanen zich fijnbesnaard. Ze zijn heel voorzichtig met het typeren van bevolkingsgroepen. Het is taboe een Chinees te typeren als ondoorgrondelijke wasbaas of een Afro-Amerikaan als domme ondergeschikte. Blackface, de zwartgeschminkte artiest gaf in de jaren zestig zijn laatste voorstelling in de VS. Wat let Zwarte Piet zijn voorbeeld te volgen?"
                            }
                        ]
                    }
