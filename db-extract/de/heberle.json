                ],
                "senses": [
                    {
                        "sense_id": "131adbee-6a38-32c3-ac3d-139f3e4802a5",
                        "entry_id": "7748dcd5-7449-3bc1-9d06-ceee9f6b9f4a",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5e597c7-297f-4cb9-a8c4-208d99392503",
                                "sense_id": "131adbee-6a38-32c3-ac3d-139f3e4802a5",
                                "text": "Frau Heberle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "df846bde-b81e-4ad3-a346-6ebf605b6ddf",
                                "sense_id": "131adbee-6a38-32c3-ac3d-139f3e4802a5",
                                "text": "Herr Heberle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "150130b6-ab3d-45ca-afb1-7ca83cddd01c",
                                "sense_id": "131adbee-6a38-32c3-ac3d-139f3e4802a5",
                                "text": "Die Heberles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "550e8108-560f-45f2-8de2-3783ddb626a9",
                                "sense_id": "131adbee-6a38-32c3-ac3d-139f3e4802a5",
                                "text": "Der Heberle trägt nie die Pullover, die die Heberle ihm strickt."
                            },
                            {
                                "example_id": "09355970-882a-413f-9309-ca14d7e1990a",
                                "sense_id": "131adbee-6a38-32c3-ac3d-139f3e4802a5",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Heberle kommt, geht der Herr Heberle.“"
                            },
                            {
                                "example_id": "82f19875-8df4-4f76-bc6f-68177e36f8ed",
                                "sense_id": "131adbee-6a38-32c3-ac3d-139f3e4802a5",
                                "text": "Heberle kommt und geht."
                            },
                            {
                                "example_id": "c06a1f30-9387-432e-b4f4-20008abdfe7b",
                                "sense_id": "131adbee-6a38-32c3-ac3d-139f3e4802a5",
                                "text": "Heberles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
