                                            "Armillaria, rodzaj grzybów z rodziny obrzękowcowatych"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d015873d-a916-41dc-88d9-8ea7f8ab0bf0",
                                                "sense_id": "8a4d5489-b953-3dcd-821e-875e0de6878a",
                                                "text": "Opieńka jest największym organizmem na ziemi. Może pokrywać ogromne obszary i żyć nawet do 1500 lat."
