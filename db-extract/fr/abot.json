                                                "sense_id": "721fef0b-461d-3901-87d9-e0f4bffca87c",
                                                "text": "Die Fußfesseln mussten ihm genau angepasst werden."
                                            },
                                            {
                                                "example_id": "ddd1ebfc-ca6d-4057-8d10-e8ca8f1fe180",
                                                "sense_id": "721fef0b-461d-3901-87d9-e0f4bffca87c",
                                                "text": "„Er war verantwortlich dafür, dass in Hessen die elektronische Fußfessel getestet wurde, die erste in Deutschland.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
