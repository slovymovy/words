                ],
                "senses": [
                    {
                        "sense_id": "8002c6ea-1d58-3620-931e-d59817a3d85c",
                        "entry_id": "ab0e6b1c-765f-3e4e-8a2a-1266246f5d07",
                        "glosses": [
                            "interdisziplinäre Ingenieurwissenschaft, bestehend aus Maschinenbau, Elektrotechnik und Informatik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c11f702c-fe84-4783-acb1-8c37118ddf24",
                                "sense_id": "8002c6ea-1d58-3620-931e-d59817a3d85c",
                                "text": "„Das Fachgebiet Mechatronik erforscht und entwickelt klassische und neuartige mechatronische Antriebe im Verbund mit den mechatronischen Systemen in die diese Antriebe integriert werden.“"
                            },
                            {
                                "example_id": "dc70bec0-8fff-4bdb-a66e-92e276e3c5f7",
                                "sense_id": "8002c6ea-1d58-3620-931e-d59817a3d85c",
                                "text": "Er studiert Mechatronik im 2. Semester."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b3e436b-505c-426e-b9fe-28b972eb295a",
                        "source_entry_id": "ab0e6b1c-765f-3e4e-8a2a-1266246f5d07",
                        "source_sense_id": "8002c6ea-1d58-3620-931e-d59817a3d85c",
                        "source_sense_description": "interdisziplinäre Ingenieurwissenschaft, bestehend aus Maschinenbau, Elektrotechnik und Informatik",
                        "target_lang_word": "mechatronics",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mechatronics",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07e59656-fce6-31c7-a845-2db076919e9b",
                                        "entry_id": "028c92cc-cad0-3fbd-ac05-4600b9b38945",
                                        "glosses": [
                                            "The synergistic combination of mechanical engineering, electronic engineering and software engineering for the study of automata from an engineering perspective and the control of advanced hybrid systems."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb7d30d9-8900-49d0-bc2e-d22be8483f68",
                                                "sense_id": "07e59656-fce6-31c7-a845-2db076919e9b",
                                                "text": "Advanced technology to create energy-saving, resource-saving and highly intelligent systems by integrating mechanics, electronics and software is called mechatronics."
                                            },
                                            {
                                                "example_id": "0d876b23-37e4-4ec2-97e8-127b5d9efcd2",
                                                "sense_id": "07e59656-fce6-31c7-a845-2db076919e9b",
                                                "text": "So what's this new hybrid called a Mechatronics Engineer? Simply stated, these pros apply mechanical, electrical, and computer engineering theory and techniques to create automated, intelligent products, smart devices, and industrial control systems--systems that can then be \"taught\" to improve their performance. This is where many future engineering jobs are headed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c5ac757-f5a7-4773-b42c-7179bae52048",
                        "source_entry_id": "ab0e6b1c-765f-3e4e-8a2a-1266246f5d07",
                        "source_sense_id": "8002c6ea-1d58-3620-931e-d59817a3d85c",
                        "source_sense_description": "interdisziplinäre Ingenieurwissenschaft, bestehend aus Maschinenbau, Elektrotechnik und Informatik",
                        "target_lang_word": "mécatronique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mécatronique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "05b01526-fb3c-35f8-9d16-066ea52fa8ab",
                                        "entry_id": "90de2629-472a-3ff3-8eae-994979b97d61",
                                        "glosses": [
                                            "Combinaison synergique et systémique de la mécanique, de l’électronique et de l’informatique temps réel afin de concevoir des systèmes automatiques puissants et de permettre le contrôle de systèmes complexes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63e2e92a-c719-4843-98ad-a00bb2999ca7",
                                                "sense_id": "05b01526-fb3c-35f8-9d16-066ea52fa8ab",
                                                "text": "Cependant, il peut encore exister un pôle d’accumulation du savoir-faire, la mécatronique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mécatronique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5f02c9ee-a560-34a3-9739-b92e5b24192f",
                                        "entry_id": "462b81a1-3723-381b-846e-69415320bed1",
                                        "glosses": [
                                            "Relatif à la mécatronique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dc140d1-d4e0-47db-bdd9-9223ab15043f",
                                                "sense_id": "5f02c9ee-a560-34a3-9739-b92e5b24192f",
                                                "text": "Dans les couloirs de la firme, Günter Neugebauer, un ancien du site, détaille la sophistication des produits mécatroniques (électronique associée à la mécanique) fabriqués ici."
                                            },
                                            {
                                                "example_id": "c28a57bd-ba5d-4591-92c0-09ec01de213b",
                                                "sense_id": "5f02c9ee-a560-34a3-9739-b92e5b24192f",
                                                "text": "Le Japon est le pays des robots ; non, vous n’y croiserez pas des humanoïdes à tous les coins de rue. À part de rares semi-androïdes à roulettes et tablette ventrale, souffre-douleur des enfants dans quelques commerces, les clones mécatroniques d’humains n’y existent encore qu’à l’état de prototypes ou de créatures fantasmées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
