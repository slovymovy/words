                "senses": [
                    {
                        "sense_id": "457bd68b-67a5-3a7e-8dc3-e7af5b21067f",
                        "entry_id": "bf21c4fd-43fa-3ed2-83a3-ea34e15891b9",
                        "glosses": [
                            "het afweren van aanvallen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed1cbf6e-d332-4973-aed5-4d6e81b90a3b",
                                "sense_id": "457bd68b-67a5-3a7e-8dc3-e7af5b21067f",
                                "text": "De afweer functioneerde perfect in de burgeroorlog."
                            }
                        ]
                    },
                    {
                        "sense_id": "56732676-edff-3371-bfb5-6abab9d20609",
                        "entry_id": "bf21c4fd-43fa-3ed2-83a3-ea34e15891b9",
                        "glosses": [
                            "bescherming tegen vervelende dingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d35fd9f8-4793-4bf0-83a9-7874a7ecaf67",
                                "sense_id": "56732676-edff-3371-bfb5-6abab9d20609",
                                "text": "Het was gelach zonder vreugde, een afweer tegen het noodlot."
                            },
                            {
                                "example_id": "038d360b-b7bb-49c1-b89c-15359c611989",
                                "sense_id": "56732676-edff-3371-bfb5-6abab9d20609",
                                "text": "Nu lijkt het of mijn adviezen almaar afketsen op een muur van afweer en coping. 'We gaan het gesprek afronden,' zeg ik bruusker dan ik wil.'Ik zal het dossier sluiten bij de verzekeraar.Je kunt gaan.'"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bbbe42fc-9e4e-40c6-a47f-ac6047e81cc2",
                        "source_entry_id": "bf21c4fd-43fa-3ed2-83a3-ea34e15891b9",
                        "source_sense_id": "457bd68b-67a5-3a7e-8dc3-e7af5b21067f",
                        "source_sense_description": "het afweren van aanvallen",
                        "target_lang_word": "defence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "defence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d996f239-a0fc-35f5-9efb-e8824aedce44",
                                        "entry_id": "1faf1d17-edf4-3e43-9edf-40a1077b924e",
                                        "glosses": [
                                            "The action of defending, of protecting from attack, danger or injury."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aaa576a4-3a48-4d1b-96c9-ca9da7e951e1",
                                                "sense_id": "d996f239-a0fc-35f5-9efb-e8824aedce44",
                                                "text": "In cases of defence ’tis best to weigh\nThe enemy more mighty than he seems:"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15cbd69f-39fd-3f5d-adba-f2d956e2700d",
                                        "entry_id": "1faf1d17-edf4-3e43-9edf-40a1077b924e",
                                        "glosses": [
                                            "Something used to oppose attacks."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd0f77c4-3686-4e7a-9243-c2c95bb205b7",
                                                "sense_id": "15cbd69f-39fd-3f5d-adba-f2d956e2700d",
                                                "text": "And nothing ’gainst Time’s scythe can make defence\nSave breed, to brave him when he takes thee hence."
                                            },
                                            {
                                                "example_id": "1b1fbe40-5989-4f25-b850-5b1df387e88e",
                                                "sense_id": "15cbd69f-39fd-3f5d-adba-f2d956e2700d",
                                                "text": "As governments and health officials continue to flip-flop on vaccine age requirements, and anti-vaxxers spread falsehoods through social media and protests, the vaxxie might just be a powerful line of defence against vaccine hesitancy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40939b6c-7fca-396b-8f22-7e614bd05b3c",
                                        "entry_id": "1faf1d17-edf4-3e43-9edf-40a1077b924e",
                                        "glosses": [
                                            "An argument in support or justification of something."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "571bf95a-75e6-448d-8485-bf3a90e7620d",
                                                "sense_id": "40939b6c-7fca-396b-8f22-7e614bd05b3c",
                                                "text": "Speak of my lameness, and I straight will halt,\nAgainst thy reasons making no defence."
                                            },
                                            {
                                                "example_id": "efbc6ed6-8213-4e97-bf3c-bcc636ffe7aa",
                                                "sense_id": "40939b6c-7fca-396b-8f22-7e614bd05b3c",
                                                "text": "In Hodgson's defence, it must be stated that in large parts this was a vibrant, energetic performance with the emphasis almost exclusively on attack."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "852b34b9-0964-3352-8695-31e8ba951f6e",
                                        "entry_id": "1faf1d17-edf4-3e43-9edf-40a1077b924e",
                                        "glosses": [
                                            "A strategy and tactics employed to prevent the other team from scoring; contrasted with offence."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4ddf6582-4daa-3012-8248-48ec67a6e4f4",
                                        "entry_id": "1faf1d17-edf4-3e43-9edf-40a1077b924e",
                                        "glosses": [
                                            "The portion of a team dedicated to preventing the other team from scoring; contrasted with offence."
                                        ],
                                        "tags": [
