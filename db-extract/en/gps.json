                                "target_senses": [
                                    {
                                        "sense_id": "233bb639-723d-3d2b-833c-3d4927f17637",
                                        "entry_id": "69f55ea5-f680-37f8-8b83-59ae3137eb88",
                                        "glosses": [
                                            "Kurzwort für englisch Global Positioning System (= weltweites Standortbestimmungssystem)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "041fdb8f-4e70-442f-93a3-1c1f4729ca93",
                                                "sense_id": "233bb639-723d-3d2b-833c-3d4927f17637",
                                                "text": "„Auch das GPS liefert keine vernünftigen Daten.“"
                                            },
                                            {
                                                "example_id": "a8243e76-abf7-48f5-b259-334fcc4cbbee",
                                                "sense_id": "233bb639-723d-3d2b-833c-3d4927f17637",
                                                "text": "„Kein Mobiltelefon, kein Notebook, kein GPS wäre je erfunden worden, wenn nicht Querdenker wie Einstein, Bohr oder Planck ihre Genialität darauf verwendet hätten, jahrhundertealte Vorstellungen über Raum und Zeit umzustürzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
