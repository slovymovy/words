                    },
                    {
                        "form_id": "1cdd4ebb-7024-4560-aa93-e208ea2d0286",
                        "entry_id": "5eb4b9d2-eca3-3523-a137-48ecbab01ace",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "зюйдве́стках"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d97f3aae-11ba-38c7-bfa9-80eeb9d6d1de",
                        "entry_id": "5eb4b9d2-eca3-3523-a137-48ecbab01ace",
                        "glosses": [
                            "морск. мягкая шляпа из непромокаемой материи с широкими полями, откидывающимися спереди"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b26f664-dad6-4e51-a720-d2182d70c425",
                                "sense_id": "d97f3aae-11ba-38c7-bfa9-80eeb9d6d1de",
                                "text": "Притулившись на баке у наветренного борта, кучка вахтенных матросов, одетых в кожаны, с зюйдвестками на головах, тихо лясничала."
                            },
                            {
                                "example_id": "b82486cd-b2a2-4bb1-a5d7-4c3be7b03e5d",
                                "sense_id": "d97f3aae-11ba-38c7-bfa9-80eeb9d6d1de",
                                "text": "И мы стали подбирать с полу непромокаемые наши роканы и буксы, а под них надели непросыхаемые наши телогрейки и ватные штаны, сунули ноги в полуболотные сапоги с раструбами, головы покрыли зюйдвестками."
                            }
                        ]
                    },
                    {
                        "sense_id": "e5c100a0-f3af-3054-8dbb-e2b1bc7f968a",
                        "entry_id": "5eb4b9d2-eca3-3523-a137-48ecbab01ace",
                        "glosses": [
                            "широкий непромокаемый плащ с капюшоном"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3944dd5a-961c-4198-91ba-066977cbf18a",
                                "sense_id": "e5c100a0-f3af-3054-8dbb-e2b1bc7f968a",
                                "text": "Рыбаки в желтых проолифленных зюйдвестках при свете бензиновых ламп выгружали улов в большие плоские корзины."
                            },
                            {
                                "example_id": "5bcdfb87-3299-4e15-88fc-3d51d301d465",
                                "sense_id": "e5c100a0-f3af-3054-8dbb-e2b1bc7f968a",
                                "text": "И Владимир, улыбнувшись, залез рукой под капюшон Толикиной зюйдвестки и потрепал его волосы."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d7907878-f4e0-4c6a-b8e2-a6174fbfed17",
                        "source_entry_id": "5eb4b9d2-eca3-3523-a137-48ecbab01ace",
                        "source_sense_description": "головной убор",
                        "target_lang_word": "sou'wester",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "bd91250c-0477-498f-ad6c-7e8830f0f466",
                        "source_entry_id": "5eb4b9d2-eca3-3523-a137-48ecbab01ace",
                        "source_sense_description": "головной убор",
                        "target_lang_word": "south-wester",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "south-wester",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2feb7a8e-4ec0-3b0d-844f-cc6737e3bcbc",
                                        "entry_id": "eccbc10f-6627-3ece-80e0-ac80841948cd",
                                        "glosses": [
                                            "A kind of cap to protect against the rain"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd38e052-2e55-4c58-a075-febb63dcde19",
                                                "sense_id": "2feb7a8e-4ec0-3b0d-844f-cc6737e3bcbc",
                                                "text": "We spring out of our berths, clap on a monkey-jacket and south-wester, and tumble up the ladder."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9551de1-92ef-4a15-95aa-8bc594a5a4b1",
                        "source_entry_id": "5eb4b9d2-eca3-3523-a137-48ecbab01ace",
                        "source_sense_description": "головной убор",
                        "target_lang_word": "Südwester",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Südwester",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e77c20b-b769-3554-9fed-ff4c13d82085",
                                        "entry_id": "af5e23af-5bed-3460-aaca-6d9b634a7e8e",
                                        "glosses": [
                                            "eine haubenartige Kopfbedeckung zum Wetterschutz (überwiegend auf See)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db9b60c2-6e7a-4d66-ad56-1b8289b7b31e",
                                                "sense_id": "5e77c20b-b769-3554-9fed-ff4c13d82085",
                                                "text": "Besser ist du setzt deinen Südwester auf."
                                            },
                                            {
                                                "example_id": "453d33fc-788b-4904-a88f-db5599294555",
                                                "sense_id": "5e77c20b-b769-3554-9fed-ff4c13d82085",
                                                "text": "„Es half nichts, daß mir Gummistiefel, ein Südwester für den Kopf und ein Regenmantel, der bis zum Boden reichte, gekauft wurden.“"
                                            },
                                            {
                                                "example_id": "e3da40da-e612-4db6-b0b6-1ac5c1fea225",
                                                "sense_id": "5e77c20b-b769-3554-9fed-ff4c13d82085",
                                                "text": "„Auf dem Kopf der Südwester verbarg sein Gesicht.“"
                                            },
                                            {
                                                "example_id": "9f6784d6-10cc-4067-93a3-11130ec789ea",
                                                "sense_id": "5e77c20b-b769-3554-9fed-ff4c13d82085",
                                                "text": "„Kleine Kinder in gelben Gummimänteln und Südwestern drängten sich an die Beine ihrer Eltern.“"
                                            },
                                            {
                                                "example_id": "426987c3-b967-46d0-b624-ab0eae003cf2",
                                                "sense_id": "5e77c20b-b769-3554-9fed-ff4c13d82085",
                                                "text": "„Bevor Thomas widersprechen konnte, hatte sie bereits einen Wettermantel angezogen und einen dunklen Südwester übergestülpt; ihren Hiddensee-Look.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "48109391-29fc-3d33-a1d7-f9e1a255cbba",
                                        "entry_id": "af5e23af-5bed-3460-aaca-6d9b634a7e8e",
                                        "glosses": [
                                            "Eigenbezeichnung der deutschsprachigen Einwohner Namibias"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fd250cd-3751-455b-a5b9-5ca8a24ec2b3",
                                                "sense_id": "48109391-29fc-3d33-a1d7-f9e1a255cbba",
                                                "text": "Ich bin geborener Südwester."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1d04af3b-8d7d-3307-8258-2b5c6ff2e243",
