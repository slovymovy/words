{
    "word_family": [
        "учитель",
        "ученик",
        "учёба",
        "учебник",
        "обучение",
        "изучение",
        "учёный",
        "выучить",
        "научить"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b957b992-58f9-3139-aa80-21aba8d5095d",
                    "sense_definition": "Передавать знания, умения или навыки кому-либо; обучать.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "teaching",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она <w>учит</w> меня английскому языку уже год.",
                            "target_lang_translations": {
                                "en": "She has been <w>teaching</w> me English for a year.",
                                "de": "Sie <w>bringt</w> mir schon seit einem Jahr Englisch <w>bei</w>.",
                                "tr": "Bir yıldır bana İngilizce <w>öğretiyor</w>."
                            }
                        },
                        {
                            "text": "Отец <w>учит</w> сына кататься на велосипеде в парке.",
                            "target_lang_translations": {
                                "en": "The father is <w>teaching</w> his son to ride a bike in the park.",
                                "de": "Der Vater <w>bringt</w> seinem Sohn im Park das Fahrradfahren <w>bei</w>.",
                                "tr": "Baba, parkta oğluna bisiklete binmeyi <w>öğretiyor</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "обучать",
                        "преподавать"
                    ],
                    "common_phrases": [
                        "учить детей",
                        "учить плавать",
                        "учить читать",
                        "учить музыке"
                    ],
                    "target_lang_definitions": {
                        "en": "To pass knowledge, skills, or abilities to someone; to educate.",
                        "de": "Wissen, Fähigkeiten oder Fertigkeiten an jemanden weitergeben; jemanden ausbilden.",
                        "tr": "Birine bilgi, beceri veya yetenek kazandırmak; eğitmek."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "teach",
                                "target_lang_sense_clarification": "to give lessons or knowledge to someone"
                            },
                            {
                                "target_lang_word": "instruct",
                                "target_lang_sense_clarification": "to give formal training or instructions"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "beibringen",
                                "target_lang_sense_clarification": "jemandem zeigen, wie etwas gemacht wird, sodass er es danach kann"
                            },
                            {
                                "target_lang_word": "lehren",
                                "target_lang_sense_clarification": "jemandem Wissen oder Fertigkeiten vermitteln"
                            },
                            {
                                "target_lang_word": "unterrichten",
                                "target_lang_sense_clarification": "jemandem in einem bestimmten Fach oder Bereich Wissen vermitteln"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "öğretmek",
                                "target_lang_sense_clarification": "birine bir konuda bilgi veya beceri kazandırmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "166d841a-425d-3d8d-a404-3379735f4dff",
                    "sense_definition": "Усваивать знания, приобретать навыки; изучать какой-либо предмет.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "learning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Студент <w>учит</w> физику, чтобы сдать экзамен.",
                            "target_lang_translations": {
                                "en": "The student is <w>studying</w> physics to pass the exam.",
                                "de": "Der Student <w>lernt</w> Physik, um die Prüfung zu bestehen.",
                                "tr": "Öğrenci sınavı geçmek için fizik <w>çalışıyor</w>."
                            }
                        },
                        {
                            "text": "Мы <w>учим</w> новые слова на каждом уроке.",
                            "target_lang_translations": {
                                "en": "We <w>learn</w> new words in every lesson.",
                                "de": "Wir <w>lernen</w> in jeder Stunde neue Wörter.",
                                "tr": "Her derste yeni kelimeler <w>öğreniyoruz</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "штудировать",
                        "изучать"
                    ],
                    "common_phrases": [
                        "учить уроки",
                        "учить язык",
                        "учить правила"
                    ],
                    "target_lang_definitions": {
                        "en": "To assimilate knowledge, acquire skills; to study a subject.",
                        "de": "Wissen aufnehmen, Fähigkeiten erwerben; sich mit einem Thema beschäftigen.",
                        "tr": "Bilgi edinmek, beceri kazanmak; bir konuyu çalışmak."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "learn",
                                "target_lang_sense_clarification": "to gain knowledge or skill"
                            },
                            {
                                "target_lang_word": "study",
                                "target_lang_sense_clarification": "to engage in the process of learning a subject"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "lernen",
                                "target_lang_sense_clarification": "sich Wissen oder Fähigkeiten aneignen"
                            },
                            {
                                "target_lang_word": "studieren",
                                "target_lang_sense_clarification": "sich intensiv mit einem Thema oder Fachgebiet beschäftigen"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "öğrenmek",
                                "target_lang_sense_clarification": "yeni bir bilgi veya beceri edinmek"
                            },
                            {
                                "target_lang_word": "çalışmak",
                                "target_lang_sense_clarification": "bir ders veya konu üzerinde emek harcayarak öğrenmeye çalışmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "621fe406-d0b5-336f-8d9d-7e24d2b2772f",
                    "sense_definition": "Запоминать информацию наизусть, заучивать.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "learning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Школьник должен <w>учить</w> стихотворение наизусть к завтрашнему дню.",
                            "target_lang_translations": {
                                "en": "The schoolboy must <w>learn</w> the poem by heart by tomorrow.",
                                "de": "Der Schüler muss das Gedicht bis morgen <w>auswendig lernen</w>.",
                                "tr": "Öğrencinin yarına kadar şiiri <w>ezberlemesi</w> gerekiyor."
                            }
                        },
                        {
                            "text": "Актёр <w>учит</w> свою роль для нового спектакля.",
                            "target_lang_translations": {
                                "en": "The actor is <w>learning</w> his role for the new play.",
                                "de": "Der Schauspieler <w>lernt</w> seine Rolle für das neue Theaterstück.",
                                "tr": "Oyuncu, yeni oyun için rolünü <w>ezberliyor</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "зубрить",
                        "заучивать"
                    ],
                    "antonyms": [
                        "забывать"
                    ],
                    "common_phrases": [
                        "учить наизусть",
                        "учить стихи",
                        "учить роль",
                        "учить слова"
                    ],
                    "target_lang_definitions": {
                        "en": "To commit information to memory; to learn by heart.",
                        "de": "Informationen auswendig lernen, sich einprägen.",
                        "tr": "Bilgiyi hafızaya yerleştirmek; ezberlemek."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "memorize",
                                "target_lang_sense_clarification": "to commit to memory"
                            },
                            {
                                "target_lang_word": "learn",
                                "target_lang_sense_clarification": "to commit to memory (e.g., lines, a poem)"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "auswendig lernen",
                                "target_lang_sense_clarification": "Informationen so lernen, dass man sie ohne Vorlage wiedergeben kann"
                            },
                            {
                                "target_lang_word": "einprägen",
                                "target_lang_sense_clarification": "sich etwas fest im Gedächtnis verankern"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ezberlemek",
                                "target_lang_sense_clarification": "bir şeyi kelimesi kelimesine akılda tutmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f490b2d0-4626-30ee-baef-f7ed150b83c0",
                    "sense_definition": "Физически наказывать, бить (обычно с целью воспитания).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "punishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В старину детей часто <w>учили</w> розгами за непослушание.",
                            "target_lang_translations": {
                                "en": "In the old days, children were often <w>punished</w> with birch rods for disobedience.",
                                "de": "Früher wurden Kinder bei Ungehorsam oft mit Ruten <w>gezüchtigt</w>.",
                                "tr": "Eskiden çocuklar itaatsizlik ettiklerinde sık sık değnekle <w>cezalandırılırdı</w>."
                            }
                        },
                        {
                            "text": "Нельзя <w>учить</w> ребёнка ремнём, нужно объяснять словами.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>punish</w> a child with a belt; you need to explain with words.",
                                "de": "Man darf ein Kind nicht mit dem Gürtel <w>züchtigen</w>, man muss es mit Worten erklären.",
                                "tr": "Çocuğu kemerle <w>cezalandırmak</w> olmaz, sözlerle anlatmak gerekir."
                            }
                        }
                    ],
                    "synonyms": [
                        "наказывать"
                    ],
                    "common_phrases": [
                        "учить ремнём",
                        "учить кулаками"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in context of physical punishment"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To physically punish or beat (usually for disciplinary purposes).",
                        "de": "Jemanden körperlich bestrafen oder schlagen (meist zur Disziplinierung).",
                        "tr": "Disiplin amacıyla fiziksel ceza vermek veya dövmek."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "punish",
                                "target_lang_sense_clarification": "to impose a penalty for a fault"
                            },
                            {
                                "target_lang_word": "discipline",
                                "target_lang_sense_clarification": "to train or punish to ensure obedience"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "züchtigen",
                                "target_lang_sense_clarification": "jemanden körperlich bestrafen, um ihn zu erziehen"
                            },
                            {
                                "target_lang_word": "bestrafen",
                                "target_lang_sense_clarification": "jemandem eine Strafe für ein Fehlverhalten auferlegen"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "cezalandırmak",
                                "target_lang_sense_clarification": "bir hata karşılığında ceza vermek"
                            },
                            {
                                "target_lang_word": "dayak atmak",
                                "target_lang_sense_clarification": "fiziksel şiddet uygulamak"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}