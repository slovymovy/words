        "fr-extract.jsonl": [
            {
                "entry_id": "277dec68-fa9c-3e18-a272-c09537457ef9",
                "word": "jaconas",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "73dcba0e-bfe1-309b-afa7-9764ae73c4f3",
                        "entry_id": "277dec68-fa9c-3e18-a272-c09537457ef9",
                        "glosses": [
                            "Espèce de mousseline légèrement plus épaisse que le nansouk."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ece6c054-6d15-483c-ad15-e1b8f9797d15",
                                "sense_id": "73dcba0e-bfe1-309b-afa7-9764ae73c4f3",
                                "text": "Elle était jolie comme une figure de Greuze ; elle portait un grand chapeau de paille, auquel elle venait d’ajouter une couronne de fleurs des champs ; de ses bras nus, ronds et veloutés, elle retenait un pan de sa robe de jaconas rose, ce qui l’aidait à soutenir une immense botte de fleurs, butin embaumé ravi au jardin des Capucins."
                            },
                            {
                                "example_id": "beb7d344-6f6c-4502-b067-092c7cc00e4c",
                                "sense_id": "73dcba0e-bfe1-309b-afa7-9764ae73c4f3",
                                "text": "Quand j’ai besoin de jaconas ou de madapolam, je le mande à ce digne Chevreux, qui sait mes goûts et il m’envoie sur l’heure ce qui me convient."
                            },
                            {
                                "example_id": "73fea8e9-1580-4ec6-9842-f9ec2993c461",
                                "sense_id": "73dcba0e-bfe1-309b-afa7-9764ae73c4f3",
                                "text": "Mainte dame se sentirait mortifiée si l’on parvenait à lui faire comprendre à quel point un cœur masculin se laisse peu impressionner par le luxe ou la nouveauté d’une toilette, à quel point le laisse froid la texture d’une mousseline et combien il est incapable d’aimer plus tendrement les pois que les fleurs, l’organdi que le jaconas"
                            },
                            {
                                "example_id": "4e119fec-db89-40f7-8928-6e56b2b10cad",
                                "sense_id": "73dcba0e-bfe1-309b-afa7-9764ae73c4f3",
                                "text": "Enfin tout en haut, à côté d’une lucarne, près d’un plomb, séchait, sur une ficelle, une robe en jaconas aux pois roses."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "03339b52-22f5-49f5-ab7c-2517a95d3d93",
                        "source_entry_id": "277dec68-fa9c-3e18-a272-c09537457ef9",
                        "source_sense_id": "73dcba0e-bfe1-309b-afa7-9764ae73c4f3",
                        "target_lang_word": "jaconet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jaconet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0523a825-6129-3f00-8778-3d72417fd8c7",
                                        "entry_id": "0d643956-5a3b-3842-bba7-456ccf13f0da",
                                        "glosses": [
                                            "A type of cotton cloth, especially as dyed and waterproofed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3abf6929-b625-421e-ba7e-b40adf06cc51",
                                                "sense_id": "0523a825-6129-3f00-8778-3d72417fd8c7",
                                                "text": "It would be mortifying to the feelings of many ladies, could they be made to understand how little the heart of man is affected by what is costly or new in their attire; how little it is biased by the texture of their muslin, and how unsusceptible of peculiar tenderness towards the spotted, the sprigged, the mull, or the jackonet."
                                            },
                                            {
                                                "example_id": "b120b60f-4009-418f-97e0-71ef04762818",
                                                "sense_id": "0523a825-6129-3f00-8778-3d72417fd8c7",
                                                "text": "It really was beautifully executed, more like a forgery than a copy, for the copyist had laid it down on a jaconet backing and had even added a cachet de vente, a couple of collectors’ marks and a museum reference number."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
