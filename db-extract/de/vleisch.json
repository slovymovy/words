                        "sense_id": "fc998480-be90-33f1-a982-d4f8bb48f2bb",
                        "entry_id": "76ffea51-8ab2-3a1e-ab12-afdf11703867",
                        "glosses": [
                            "aus pflanzlichen Produkten hergestellter Fleischersatz/»Fleisch«"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd8c8113-e8e9-4568-ae79-8f3c5ee96736",
                                "sense_id": "fc998480-be90-33f1-a982-d4f8bb48f2bb",
                                "text": "Beim veganen Markt gab es statt Fleisch \"Vleisch\" auf Weizen- und Sojabasis, Käse aus Cashews, und sogar \"Vlönz\" unter anderem aus schwarzen Bohnen und roter Bete."
                            },
                            {
                                "example_id": "331e3435-3e5a-4bb7-94ec-00921fa4372e",
                                "sense_id": "fc998480-be90-33f1-a982-d4f8bb48f2bb",
                                "text": "Vleisch statt Fleisch ist kein Tippfehler"
                            },
                            {
                                "example_id": "fe9b86a8-1eaf-40ff-bd5a-11aabd2f5fdc",
                                "sense_id": "fc998480-be90-33f1-a982-d4f8bb48f2bb",
                                "text": "Neu am Spitz: Vegane Burger mit \"Vleisch\""
                            },
                            {
                                "example_id": "7b9571c9-71c7-47a4-86bc-75c9e24a9260",
                                "sense_id": "fc998480-be90-33f1-a982-d4f8bb48f2bb",
                                "text": "Für die 43. Auflage, die 2016 erscheinen wird, konnte er 2000 neue Wörter ausfindig gemachen: von Kanzlertamtsminister über Vleisch und Pizzaschnitte (im Sinn von „Pflug“) bis gelingsicher."
                            },
                            {
                                "example_id": "b186e134-2ea9-4aa7-9fa6-38faf4b6ab28",
                                "sense_id": "fc998480-be90-33f1-a982-d4f8bb48f2bb",
                                "text": "Dass die Lebensmittelindustrie das Potenzial der veganen Nische längst entdeckt hat, zeigen uns nicht nur die neuen fleischfreien Ersatzprodukte (kurz Vleisch) oder die Discounter-Regale voller Bio-Soja-Drinks und Gemüsebuletten."
                            }
                        ],
