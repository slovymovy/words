                "senses": [
                    {
                        "sense_id": "2597091e-4d03-3854-abc4-9fc56cfd01fc",
                        "entry_id": "bbc31c61-5a6b-3548-bbb1-e5566aff1a5f",
                        "glosses": [
                            "A physical specimen (or an illustration) that is not the holotype but is considered the same taxon by the author of the holotype."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7417184d-5baa-4aa2-abf5-5e28f258db0e",
                                "sense_id": "2597091e-4d03-3854-abc4-9fc56cfd01fc",
                                "text": "The paratype of this species proves to have an ovipositor very different from that of the holotype (see dissimilis, new species)."
                            },
                            {
                                "example_id": "e37815bd-fe43-4e2f-8f5a-f226dea6d27e",
                                "sense_id": "2597091e-4d03-3854-abc4-9fc56cfd01fc",
                                "text": "1965, James A. G. Rehn, A New Genus of Symbiotic Cockroach from Southwest Africa (Orthoptera; Blattaria; Oxyhaloinae), Notulae Naturae, Academy of Natural Sciences of Philadelphia, page 6,\nAn adult female paratype will be sent to the Transvaal Museum (at Dr. Kohls' request) and a similar one to the United States National Museum. The remainder are in the collection of this Academy. All were taken with the type and allotype."
                            },
                            {
                                "example_id": "321e9845-02d3-4cf6-a2a3-156946a6eb59",
                                "sense_id": "2597091e-4d03-3854-abc4-9fc56cfd01fc",
                                "text": "In addition to the holotype, other specimens believed to be of the same species by the author are designated as paratypes. If a holotype is not available, a paratype can be examined to confirm identifications."
                            }
                        ]
                    }
                ],
