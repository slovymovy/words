                ],
                "senses": [
                    {
                        "sense_id": "bd9e2516-a9a0-3beb-b735-bcc11c018d5b",
                        "entry_id": "9e3440a8-df2c-3b6c-816f-78116f5cbf46",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76759fbc-7a64-48a8-8c7f-85cc829413ec",
                                "sense_id": "bd9e2516-a9a0-3beb-b735-bcc11c018d5b",
                                "text": "Frau Wässerle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "2c40d3dc-25ea-4dcc-acbd-089f3c0369c2",
                                "sense_id": "bd9e2516-a9a0-3beb-b735-bcc11c018d5b",
                                "text": "Herr Wässerle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2d301bd6-2d61-442b-9c87-f23b6d1df27d",
                                "sense_id": "bd9e2516-a9a0-3beb-b735-bcc11c018d5b",
                                "text": "Die Wässerles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "e601ebb9-da35-47a5-81b5-ed34a69393dc",
                                "sense_id": "bd9e2516-a9a0-3beb-b735-bcc11c018d5b",
                                "text": "Der Wässerle trägt nie die Pullover, die die Wässerle ihm strickt."
                            },
                            {
                                "example_id": "b185ea9e-a21f-4657-8f61-6309fbc46e6e",
                                "sense_id": "bd9e2516-a9a0-3beb-b735-bcc11c018d5b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wässerle kommt, geht der Herr Wässerle.“"
                            },
                            {
                                "example_id": "58e5baa0-9e76-44ff-887d-9755943a45ac",
                                "sense_id": "bd9e2516-a9a0-3beb-b735-bcc11c018d5b",
                                "text": "Wässerle kommt und geht."
                            },
                            {
                                "example_id": "bb286929-0944-4527-83a6-40433cad31a9",
                                "sense_id": "bd9e2516-a9a0-3beb-b735-bcc11c018d5b",
                                "text": "Wässerles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
