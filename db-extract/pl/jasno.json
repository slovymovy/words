                    },
                    {
                        "translation_id": "733342af-8401-41b2-a7cc-3fc5c5f902d9",
                        "source_entry_id": "db598c90-00c6-3da7-8d39-b61cf1f508ee",
                        "source_sense_id": "b41786c0-00f5-33be-9f83-76fe47418cd8",
                        "target_lang_word": "clearly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clearly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4253b384-f07d-3c18-adcd-ebafed18575a",
                                        "entry_id": "6b38cf32-5bed-3254-8e3e-855638a91e71",
                                        "glosses": [
                                            "In a clear manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "695f2aec-9e34-4b70-ad5a-60b7557941e6",
                                                "sense_id": "4253b384-f07d-3c18-adcd-ebafed18575a",
                                                "text": "He enunciated every syllable clearly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dafa2904-8780-34d6-92c4-ac9245674a8b",
                                        "entry_id": "6b38cf32-5bed-3254-8e3e-855638a91e71",
                                        "glosses": [
                                            "Without a doubt; obviously."
                                        ],
                                        "tags": [
                                            "modal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7744b0e0-d2f5-43ee-88ca-65eef287f79f",
                                                "sense_id": "dafa2904-8780-34d6-92c4-ac9245674a8b",
                                                "text": "Clearly, the judge erred in his opinion."
                                            },
                                            {
                                                "example_id": "ebcc9eea-220f-4d40-829a-f7630f78b950",
                                                "sense_id": "dafa2904-8780-34d6-92c4-ac9245674a8b",
                                                "text": "While Gunners boss Arsene Wenger had warned his players against letting the pre-match festivities distract them from the task at hand, they clearly struggled for fluency early on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce4011fe-dd32-370f-b6f7-c07ed377d1c6",
                                        "entry_id": "6b38cf32-5bed-3254-8e3e-855638a91e71",
                                        "glosses": [
                                            "To a degree clearly discernible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4633d05-925e-4e13-9124-451a88013cab",
                                                "sense_id": "ce4011fe-dd32-370f-b6f7-c07ed377d1c6",
                                                "text": "He was clearly wrong on all points but one."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae9824f5-eedd-4fbe-af92-e8b1af8aba4e",
                        "source_entry_id": "db598c90-00c6-3da7-8d39-b61cf1f508ee",
                        "source_sense_id": "b41786c0-00f5-33be-9f83-76fe47418cd8",
                        "target_lang_word": "plainly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plainly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "843c51bd-e45e-3de7-9e81-17bf9394c3d0",
                                        "entry_id": "e4adbbf6-8f86-3187-a3cb-743b404b4697",
                                        "glosses": [
                                            "In a plain manner; simply; basically."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c94f750-8fa7-4427-a4de-e01b945d2d08",
                                                "sense_id": "843c51bd-e45e-3de7-9e81-17bf9394c3d0",
                                                "text": "She decorated the room plainly but neatly."
                                            },
                                            {
                                                "example_id": "a2522760-5d67-4dff-821a-9551efd86e30",
                                                "sense_id": "843c51bd-e45e-3de7-9e81-17bf9394c3d0",
                                                "text": "'Tell me plainly what you think of my daughter's little companion.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0160e8cc-c48a-3fbf-a2d1-b00fc2c982cf",
                                        "entry_id": "e4adbbf6-8f86-3187-a3cb-743b404b4697",
                                        "glosses": [
                                            "Obviously; clearly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1060563-3455-4aeb-8fec-0099957aa51f",
                                                "sense_id": "0160e8cc-c48a-3fbf-a2d1-b00fc2c982cf",
                                                "text": "You will see that ours is plainly the better method."
                                            },
                                            {
                                                "example_id": "84af7e50-d76c-436e-9827-75c6f2d77b1c",
                                                "sense_id": "0160e8cc-c48a-3fbf-a2d1-b00fc2c982cf",
                                                "text": "The stories did not seem to me to touch life. They were plainly intended to have a bracing moral effect, and perhaps had this result for the people at whom they were aimed. They left me with the impression of a well-delivered stereopticon lecture, with characters about as life-like as the shadows on the screen, and whisking on and off, at the mercy of the operator."
                                            },
                                            {
                                                "example_id": "405ed914-8d92-40b0-97ec-1a9b888153fe",
                                                "sense_id": "0160e8cc-c48a-3fbf-a2d1-b00fc2c982cf",
                                                "text": "Plainly he was prepared to bark out an interminable succession of charges against the Wanderer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
