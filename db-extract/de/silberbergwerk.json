                "senses": [
                    {
                        "sense_id": "d53352bb-c677-3cb0-91c5-e9ca9146f157",
                        "entry_id": "912757a0-6e6f-39bd-a895-7d7859ac64da",
                        "glosses": [
                            "Bergwerk, in dem Silber(erz) abgebaut wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28c28dcd-d426-4443-a455-85dd496ff3c9",
                                "sense_id": "d53352bb-c677-3cb0-91c5-e9ca9146f157",
                                "text": "„Nicht weit von Pribram liegt Birkenberg, ein Bergflecken mit einem Silberbergwerke und Gießereien.“"
                            },
                            {
                                "example_id": "d612eeb1-14f5-4015-8abf-a0f7e3c46c4a",
                                "sense_id": "d53352bb-c677-3cb0-91c5-e9ca9146f157",
                                "text": "„Weil Indien keine Silberbergwerke besaß, konnte die Zahl der Münzen nicht beliebig vermehrt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
