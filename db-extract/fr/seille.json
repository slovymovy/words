                                        "sense_id": "553a2aa1-dae2-3ca9-b785-895522337e64",
                                        "entry_id": "a378c085-afc9-39bb-bb8a-2fffded529da",
                                        "glosses": [
                                            "A container made of rigid material, often with a handle, used to carry liquids or small items."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0c96580-af65-4178-8247-700f213f9e1b",
                                                "sense_id": "553a2aa1-dae2-3ca9-b785-895522337e64",
                                                "text": "I need a bucket to carry the water from the well."
                                            },
                                            {
                                                "example_id": "43515ca0-265c-4dcf-b79d-2f773a5edb22",
                                                "sense_id": "553a2aa1-dae2-3ca9-b785-895522337e64",
                                                "text": "The crab was cool and very light. But the water was thick with sand, and so, scrambling down, Jacob was about to jump, holding his bucket in front of him, when he saw, stretched entirely rigid, side by side, their faces very red, an enormous man and woman."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f3b3119-9282-3046-97c5-8baeede78bc6",
                                        "entry_id": "a378c085-afc9-39bb-bb8a-2fffded529da",
                                        "glosses": [
                                            "The amount held in this container."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d559da58-3c7c-43f7-afe6-96b5ba09bd22",
                                                "sense_id": "2f3b3119-9282-3046-97c5-8baeede78bc6",
                                                "text": "The horse drank a whole bucket of water."
                                            }
                                        ]
                                    },
                                    {
