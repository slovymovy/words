                        ],
                        "form": "die Sicherheitskraft"
                    },
                    {
                        "form_id": "ac1dbef9-f342-4d13-b5c8-adb9f1f84ff5",
                        "entry_id": "c86fe69a-46ee-3510-a9d8-8b749430a912",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Sicherheitskräfte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "62d6fa35-a4ad-32ac-af9f-af16f43f97e5",
                        "entry_id": "c86fe69a-46ee-3510-a9d8-8b749430a912",
                        "glosses": [
                            "Exekutivorgan eines Staates, das der Bewahrung oder Wiederherstellung der inneren Sicherheit dient"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "0057c4ad-4a49-4d4c-8926-be5a3d2253ea",
                                "sense_id": "62d6fa35-a4ad-32ac-af9f-af16f43f97e5",
                                "text": "„Die UÇK übernahm die Aktion. Seither hat sie, aufgewertet durch die barbarischen Vergeltungsakte der serbischen Sicherheitskräfte, das Bewußtsein der Bevölkerung im Kosovo gewendet. Präsident Rugova verlor das Monopol der Gewaltfreiheit, die Politik den Primat über die Waffen.“"
                            },
                            {
                                "example_id": "d51576d2-518d-4c0d-ae35-b9a98683e95e",
                                "sense_id": "62d6fa35-a4ad-32ac-af9f-af16f43f97e5",
                                "text": "„Als ihm eine Sicherheitskraft dies verwehren wollte, sprühte der 21-Jährige Pfefferspray in die Augen des Security-Mannes.“"
                            },
                            {
                                "example_id": "cc915d27-9c63-4f60-aadb-06271660a7a0",
                                "sense_id": "62d6fa35-a4ad-32ac-af9f-af16f43f97e5",
                                "text": "„Im gesamten Land verhinderten Sicherheitskräfte Protestaktionen im Vorfeld, indem sie Zufahrtswege sperrten oder Menschen in Gewahrsam nahmen.“"
                            },
                            {
                                "example_id": "64449e46-739e-4ee9-8baa-d6d15536594d",
                                "sense_id": "62d6fa35-a4ad-32ac-af9f-af16f43f97e5",
                                "text": "„Am 24. April 2012 gingen Sicherheitskräfte dem Vernehmen nach gewaltsam gegen Justizangestellte vor, die mit einem Sitzstreik gegen ihre Arbeitsbedingungen protestierten.“"
                            },
                            {
                                "example_id": "40eac460-d1b0-4af5-8c87-8a7ba8358077",
                                "sense_id": "62d6fa35-a4ad-32ac-af9f-af16f43f97e5",
                                "text": "„Regierungsberichten zufolge kam es zur Tötung von Angehörigen bewaffneter Gruppierungen durch die Sicherheitskräfte.“"
                            },
                            {
                                "example_id": "a95aaecd-c188-4508-8030-e2b2c342b6cb",
                                "sense_id": "62d6fa35-a4ad-32ac-af9f-af16f43f97e5",
                                "text": "„Mindestens vier Zivilpersonen wurden durch Bomben oder den Schusswaffeneinsatz der Sicherheitskräfte getötet.“"
                            },
                            {
                                "example_id": "1ce8abfa-3660-40d9-9d0b-6bafeafd3246",
                                "sense_id": "62d6fa35-a4ad-32ac-af9f-af16f43f97e5",
                                "text": "„Gleichzeitig blieb die Frontier ein ständiger Unruheherd, da sich paschtunische Stämme und pakistanische Sicherheitskräfte permanent Scharmützel lieferten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
