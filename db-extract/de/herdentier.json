                        "glosses": [
                            "Tier, das in Gemeinschaft mit einer meist größeren Anzahl von Artgenossen lebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d84a38be-fa0d-4427-8ea2-c2a2ed68621b",
                                "sense_id": "6a438049-2b7c-3ff3-b2d0-2bad7e505c8f",
                                "text": "Die meisten Nutztiere sind von Natur aus Herdentiere."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a31bcf8c-668e-3c71-9ef4-6373ef42dc23",
                        "entry_id": "d7372452-b5bc-3c62-939d-9fe2079a262a",
                        "glosses": [
