                                "target_senses": [
                                    {
                                        "sense_id": "9dfd80fc-1494-3b41-b95b-923c6f0bde10",
                                        "entry_id": "9c98c481-6b85-328f-8544-c24b48c5e47e",
                                        "glosses": [
                                            "deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dac704c1-6674-486e-9630-0973175bb232",
                                                "sense_id": "9dfd80fc-1494-3b41-b95b-923c6f0bde10",
                                                "text": "Frau Philippi ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "633aa8aa-afc7-4eab-aab6-97ed2198f485",
                                                "sense_id": "9dfd80fc-1494-3b41-b95b-923c6f0bde10",
                                                "text": "Herr Philippi wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "7452b76f-d40e-4b71-a9b1-ea40dee0983e",
                                                "sense_id": "9dfd80fc-1494-3b41-b95b-923c6f0bde10",
                                                "text": "Die Philippis fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "59df287f-3897-49fe-a595-a55bb2ebbf4f",
                                                "sense_id": "9dfd80fc-1494-3b41-b95b-923c6f0bde10",
                                                "text": "Der Philippi trägt nie die Schals, die die Philippi ihm strickt."
                                            },
                                            {
                                                "example_id": "140462d1-5b69-4406-8533-1b6304469135",
                                                "sense_id": "9dfd80fc-1494-3b41-b95b-923c6f0bde10",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Philippi kommt, geht der Herr Philippi.“"
                                            },
                                            {
                                                "example_id": "243e5a46-1f1f-438b-8b30-8c01ae56c854",
                                                "sense_id": "9dfd80fc-1494-3b41-b95b-923c6f0bde10",
                                                "text": "Philippi kommt und geht."
                                            },
                                            {
                                                "example_id": "d905f1c4-14f2-4fcf-a911-4030ecc1ca93",
                                                "sense_id": "9dfd80fc-1494-3b41-b95b-923c6f0bde10",
                                                "text": "Philippis kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
