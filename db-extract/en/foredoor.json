                        "glosses": [
                            "A door located at the fore part of a house or dwelling; front door."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69990a99-f9cb-4fc6-9d2d-0a6cfb246bbc",
                                "sense_id": "7d14fb9b-0b42-33cf-b710-b718ed2da730",
                                "text": "This morning the great foredoor quite open, dancing backwards and forwards with all its weight upon the lower hinge, which must have been broken if the dean had not accidentally come and relieved it."
                            },
                            {
                                "example_id": "dd12113b-51a3-4341-9dfa-7851e03ec3cf",
                                "sense_id": "7d14fb9b-0b42-33cf-b710-b718ed2da730",
                                "text": "All the pewter is thrown about the kitchen.” But when they looked, all the pewter stood in its place. There then was a loud knocking at the back-door. My father opened it, but saw nothing. It was then at the foredoor. He opened that : but it was still lost labour."
                            },
                            {
                                "example_id": "d818e455-3f3f-461c-aeb0-9a55a894b7b4",
                                "sense_id": "7d14fb9b-0b42-33cf-b710-b718ed2da730",
                                "text": "I begged, prayed, would have kneeled to him: But all was in vain: The tyger-hearted man, as Mr. Greville had truly called him, muffled me up in it, and by force carried me thro' a long entry to the foredoor."
                            }
                        ]
                    }
