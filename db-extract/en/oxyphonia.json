                "senses": [
                    {
                        "sense_id": "bdd36dec-fd42-35ce-8757-9ae91e103f96",
                        "entry_id": "4ecab521-af87-338a-b8d8-9a41fb2dcfde",
                        "glosses": [
                            "shrillness or high pitch of the voice"
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4e41f083-f1ef-4524-82d1-a1839e9757c2",
                                "sense_id": "bdd36dec-fd42-35ce-8757-9ae91e103f96",
                                "text": "In the latter case, it is either too strong or too weak, too deep (vox clangosa, if it is at the same time too strong, and raucitas gravis, if it is at the same time too weak), or too high (oxyphonia, which again is divided into vox cucuriens or rudens, which is at the same time too strong, and raucitas acuta, at the same time too weak)."
                            },
                            {
                                "example_id": "9692f23c-12bf-4f28-ada5-288db20353ed",
                                "sense_id": "bdd36dec-fd42-35ce-8757-9ae91e103f96",
                                "text": "Symptoms related to pressure of the thyroid on neighboring structures in the neck include dysphagia, oxyphonia, dyspnea, and a choking sensation."
                            },
                            {
                                "example_id": "4d3cec0c-98b0-4549-9fd7-cbf3163c6e03",
                                "sense_id": "bdd36dec-fd42-35ce-8757-9ae91e103f96",
                                "text": "You've produced this redolent oxyphonia in me, this mysterious paroxysm of wicked albuminuria."
                            },
                            {
                                "example_id": "9301eaf0-1ae1-40cf-b6a7-0a5cd60d154b",
                                "sense_id": "bdd36dec-fd42-35ce-8757-9ae91e103f96",
                                "text": "Farewell the unspeakable pleasures of ouretic and outlandish, outsoar and oxfordian; forgive my oxyphonia."
                            }
                        ]
                    }
                ],
