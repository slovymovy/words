                                            {
                                                "example_id": "66491467-6f39-4eb8-a466-6050095539eb",
                                                "sense_id": "0c64ad54-7555-3c4e-9eae-e1aba49fc02e",
                                                "text": "Der Ausbilder zählte die Namen der angehenden Soldaten auf."
                                            },
                                            {
                                                "example_id": "49ce47db-b70e-4cd5-b9a4-3d6d86e8f0eb",
                                                "sense_id": "0c64ad54-7555-3c4e-9eae-e1aba49fc02e",
                                                "text": "Bei den vielen Filmen ist es schwierig, alle Erfolge von Mario Adorf aufzuzählen."
                                            },
                                            {
                                                "example_id": "c23d6e07-3b4d-49ac-adec-666a5d77ffdf",
                                                "sense_id": "0c64ad54-7555-3c4e-9eae-e1aba49fc02e",
                                                "text": "\"Sehr geehrte Frau Vorsitzende, sehr geehrte Ausschussmitglieder, liebe Kinder aus Deutschland\", begrüßte der Staatssekretär die Anwesenden und zählte dann auf, was deutsche Behörden seit der letzten Anhörung im Jahr 2004 alles zum Schutz der Kinderrechte unternommen hatten."
                                            },
                                            {
                                                "example_id": "69bba915-0148-4d78-97da-2130f93aeadc",
                                                "sense_id": "0c64ad54-7555-3c4e-9eae-e1aba49fc02e",
                                                "text": "Der deutsche Schauspieler Til Schweiger zählte auf: 300 Millionen Tonträger hat die griechische Sängerin [Nana Mouskouri] in ihrer 50-jährigen Karriere verkauft und dabei 1500 Titel in 10 Sprachen aufgenommen."
                                            }
                                        ],
