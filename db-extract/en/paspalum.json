                        "glosses": [
                            "Any member of the genus Paspalum of tall perennial grasses, the bahiagrasses or Dallis grasses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0511934d-c36d-4c4b-83e4-cbd1999043e3",
                                "sense_id": "c725c4dd-73f5-344e-97b9-0a4d28988f82",
                                "text": "We returned to the crossing, passing slowly through the high rusty stands of dock weeds and the fleshy beds of dense paspalum."
                            },
                            {
                                "example_id": "eff657eb-65fe-4f83-b65a-11fdfe579848",
                                "sense_id": "c725c4dd-73f5-344e-97b9-0a4d28988f82",
                                "text": "The paspalum blades they had walked over were mostly intact, green leaves with near-invisible lines of teeny tiny veins running the length of them, delivering food and water, same as veins did for a person."
                            }
                        ]
                    }
