                "senses": [
                    {
                        "sense_id": "4ca230f4-0ad3-3c5f-a481-183be13f8bd3",
                        "entry_id": "907c0719-7017-3b19-b777-6552c503aafa",
                        "glosses": [
                            "het door uitdroging en/of balsemen geconserveerde lichaam van een overleden mens of dier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c00045e5-5a4e-4faa-8233-7dd554a49b82",
                                "sense_id": "4ca230f4-0ad3-3c5f-a481-183be13f8bd3",
                                "text": "Oud-Egypte is bekend om zijn mummies."
                            },
                            {
                                "example_id": "1cb9283f-7693-459e-9921-e9084210e491",
                                "sense_id": "4ca230f4-0ad3-3c5f-a481-183be13f8bd3",
                                "text": "Die tentoonstelling laat zien dat het museum inderdaad bijzondere spullen toont zoals Egyptische mummies, Griekse vazen, Romeinse keizerbeelden, Assyrische reliëfs en Foenicische doopvonten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1271819c-b554-4f00-872c-b18f3ced070a",
                        "source_entry_id": "907c0719-7017-3b19-b777-6552c503aafa",
                        "source_sense_id": "4ca230f4-0ad3-3c5f-a481-183be13f8bd3",
                        "source_sense_description": "een door balseming en uitdroging geconserveerd lichaam van een dode",
                        "target_lang_word": "Mumie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mumie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "059f66b7-2b70-35b5-8046-811d45761f78",
                                        "entry_id": "67aab05f-d0ec-3071-88e2-94fe464acd1d",
                                        "glosses": [
                                            "toter Körper, der durch Einbalsamierung oder natürliche Gegebenheiten vor Verwesung geschützt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "281b962e-9aab-4a31-95e3-2243cd26ea37",
                                                "sense_id": "059f66b7-2b70-35b5-8046-811d45761f78",
                                                "text": "„Im Dunkel der Nacht haben Forscher in Luxor die Mumie von Pharao Tutenchamun aus ihrem Sarkophag gehoben, um den König erstmals per Computertomographie zu untersuchen.“"
                                            },
                                            {
                                                "example_id": "f7d697a0-995c-4883-9d82-a4c52a10db76",
                                                "sense_id": "059f66b7-2b70-35b5-8046-811d45761f78",
                                                "text": "„Der Tonmann bleibt cool, denn wenn es Schwierigkeiten gibt, haben Westfalen den Blutdruck einer ägyptischen Mumie.“"
                                            },
                                            {
                                                "example_id": "06d0077e-a43d-4157-a71e-39919b100247",
                                                "sense_id": "059f66b7-2b70-35b5-8046-811d45761f78",
                                                "text": "„Ein mir befreundeter Archäologe bat mich um meine Mitarbeit bei der Sektion an einer Mumie aus der Zeit der Ramsiden.“"
                                            },
                                            {
                                                "example_id": "86d658aa-5702-4ebc-86e7-e16594f56203",
                                                "sense_id": "059f66b7-2b70-35b5-8046-811d45761f78",
                                                "text": "„Um dahin zu kommen, wo die Mumien sind, musste man durch eine Art sehr schmalen Flur.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef330a6a-e3e6-4572-9ed2-1b87ce413a69",
                        "source_entry_id": "907c0719-7017-3b19-b777-6552c503aafa",
                        "source_sense_id": "4ca230f4-0ad3-3c5f-a481-183be13f8bd3",
                        "source_sense_description": "een door balseming en uitdroging geconserveerd lichaam van een dode",
                        "target_lang_word": "mummy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mummy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5477cdef-b292-3fac-8ade-ad9d355d2852",
                                        "entry_id": "d556bcf4-5e63-384d-a287-da6293e90727",
                                        "glosses": [
                                            "An embalmed human or non-human animal corpse wrapped in linen bandages for burial, especially as practised by the ancient Egyptians and some Native American tribes."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c12a1dc-77ea-4d37-ac6b-38d45f47624c",
                                                "sense_id": "5477cdef-b292-3fac-8ade-ad9d355d2852",
                                                "text": "1832, Royal Society (Great Britain), Abstracts of The Papers Printed in the Philosophical Transactions of the Royal Society of London, From 1800 to 1830 inclusive, Volume 1: 1800-1814, page 201,\n[…] Mr. Pearson proceeds to give a particular description of the very perfect mummy of an Ibis, which forms the chief subject of the present paper."
                                            },
                                            {
                                                "example_id": "0c5c96ca-38e5-4763-9d34-8d8eeb3f9b0f",
                                                "sense_id": "5477cdef-b292-3fac-8ade-ad9d355d2852",
                                                "text": "Leo was the first to discover what these burdens were. `Great heaven!' he said, `they are corpses on fire!' I stared and stared again - he was perfectly right - the torches that were to light our entertainment were human mummies from the caves! On rushed the bearers of the flaming corpses, and, meeting at a spot about twenty paces in front of us, built their ghastly burdens crossways into a huge bonfire."
                                            },
                                            {
                                                "example_id": "69fe7931-693f-4a2e-a83e-215d73686d9a",
                                                "sense_id": "5477cdef-b292-3fac-8ade-ad9d355d2852",
                                                "text": "But, more horrible, I had not failed to note that its purplish gleaming body resembled that of a human being - or of a chrysalis encasing one - or of a mummy!"
                                            },
                                            {
                                                "example_id": "7574c81a-d005-4294-9cc4-6132707b63db",
                                                "sense_id": "5477cdef-b292-3fac-8ade-ad9d355d2852",
                                                "text": "Many people believed in the curse of the mummy, and soon, the curse had become an accepted part of Tut′s legend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ba209f5-094c-3864-887a-86c59be0975c",
                                        "entry_id": "d556bcf4-5e63-384d-a287-da6293e90727",
                                        "glosses": [
                                            "A reanimated embalmed human corpse, as a stock character in horror films."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b85f0cbf-2156-4478-bf94-7330168352cc",
                                                "sense_id": "2ba209f5-094c-3864-887a-86c59be0975c",
                                                "text": "For many, mummies fascinate more than repel. Our horrific connotations lie not so much with the mummy itself, but in associated fears. The mummy serves, of course, as a general reminder of our own mortality and our fear of death, but this alone is not enough to make it a monster."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "102d6333-0ee5-367d-894b-63202afe266a",
                                        "entry_id": "d556bcf4-5e63-384d-a287-da6293e90727",
                                        "glosses": [
                                            "Any naturally preserved human or non-human animal body."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d6d91b1-ea2a-46cc-80b2-177c29976be4",
                                                "sense_id": "102d6333-0ee5-367d-894b-63202afe266a",
                                                "text": "'Mummy,' that is pounded ancient Egyptian, is, I believe, a pigment much used by artists, and especially by those of them who direct their talents to the reproduction of the works of the old masters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1629dea5-f094-37b6-b64b-3dbc2318ec48",
                                        "entry_id": "d556bcf4-5e63-384d-a287-da6293e90727",
                                        "glosses": [
                                            "Any naturally preserved human or non-human animal body.\\n(countable, uncountable, now rare) A brown pigment originally prepared from the ground-up remains of Egyptian animal or human mummies mixed with bitumen, etc.",
                                            "A brown pigment originally prepared from the ground-up remains of Egyptian animal or human mummies mixed with bitumen, etc."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7c9ab9ea-7baf-3d29-b0a8-f7cec5c1a066",
                                        "entry_id": "d556bcf4-5e63-384d-a287-da6293e90727",
                                        "glosses": [
                                            "A pulp."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42f93e22-cbc1-47c4-90d7-f59337c393b3",
                                                "sense_id": "7c9ab9ea-7baf-3d29-b0a8-f7cec5c1a066",
                                                "text": "Imagine twenty thouſand of them breaking into the midſt of an European Army, confounding the Ranks, overturning the Carriages, battering the Warriors Faces into Mummy, by terrible Yerks from their hinder Hoofs."
                                            },
                                            {
                                                "example_id": "e139deec-2d8b-4c73-8968-3a94be1072fc",
                                                "sense_id": "7c9ab9ea-7baf-3d29-b0a8-f7cec5c1a066",
                                                "text": "Going up to him, therefore, he laid hold on his lance, and breaking it, began to thresh him so severely, that, in spite of the resistance of his armour, he was almost beaten into mummy […]."
                                            },
                                            {
                                                "example_id": "caff5982-450d-4773-bc8d-3fda52a47c1c",
                                                "sense_id": "7c9ab9ea-7baf-3d29-b0a8-f7cec5c1a066",
                                                "text": "You may beat them to a mummy, you may put them upon the rack, you may burn them on a gridiron, […] yet you will never remove them from that innate fidelity […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2e33613-b5e6-3bed-a812-ab46412c935c",
                                        "entry_id": "d556bcf4-5e63-384d-a287-da6293e90727",
                                        "glosses": [
                                            "A substance used in medicine, prepared from mummified flesh."
                                        ],
                                        "tags": [
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57fa50ac-3846-431a-aa16-646fc725e671",
                                                "sense_id": "b2e33613-b5e6-3bed-a812-ab46412c935c",
                                                "text": "Yet another scatological medicament was obtained from mummy, the material derived from a dried or embalmed human corpse, the most valuable being that imported from Mizraim (ancient Egypt)."
                                            },
                                            {
                                                "example_id": "68f72817-40d9-4973-a48a-87dc17ead50f",
                                                "sense_id": "b2e33613-b5e6-3bed-a812-ab46412c935c",
                                                "text": "Nonetheless, his book advertises many Paracelsian remedies, including laudanum, mummy, antimony and mercury."
                                            },
                                            {
                                                "example_id": "606832b6-e229-4980-8a22-44424405596a",
                                                "sense_id": "b2e33613-b5e6-3bed-a812-ab46412c935c",
                                                "text": "In or near this place is a precious liquor, or mummy, growing, Mumnaky-koobasa they call it, which none presumes to take, it being carefully preserved for the King's sole use."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efb667c6-c8ae-355f-9b05-79213c0ae57e",
                                        "entry_id": "d556bcf4-5e63-384d-a287-da6293e90727",
                                        "glosses": [
                                            "A sort of wax used in grafting."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "mummy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5220d514-dccb-32b4-9a7d-cacff67170d5",
                                        "entry_id": "49db5d29-f6c1-3c3c-9154-8ca24701422d",
                                        "glosses": [
                                            "To mummify."
                                        ],
                                        "tags": [
                                            "dated",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "mummy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe29ce6c-6354-3923-9fc5-7d76143e811c",
                                        "entry_id": "caafb885-402b-3eba-91aa-27f91a1100b4",
                                        "glosses": [
                                            "mother."
                                        ],
                                        "tags": [
                                            "New-England",
                                            "UK",
                                            "childish",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6c7451f-fed3-4d9a-bc3b-7e9291c03b75",
                                                "sense_id": "fe29ce6c-6354-3923-9fc5-7d76143e811c",
                                                "text": "“Oh, mummy, would you like the loveliest daughter-in-law in the world? Oh, mummy, I must marry Flora Dewsley. But I know I am not nearly good enough, mummy. She knows nothing of the world and its wickedness, and I — Well, mummy, at school, a fellow learns everything. And no man is perfect, is he, mummy?[…]”"
                                            },
                                            {
                                                "example_id": "7b89512c-f274-4bc9-9259-67558f5367a8",
                                                "sense_id": "fe29ce6c-6354-3923-9fc5-7d76143e811c",
                                                "text": "Meeting mummy after this visit was not exactly easy."
                                            },
                                            {
                                                "example_id": "dad24458-1ab9-4dd3-8a1c-23de56c26f45",
                                                "sense_id": "fe29ce6c-6354-3923-9fc5-7d76143e811c",
                                                "text": "“[…]What′s your problem, you little shit? Proud of yourself, for ruining Mummy′s life?” I was careful to use the insipid falsetto the experts commend. “You′ve got Daddy snowed, but Mummy′s got your number. You're a little shit, aren′t you?″"
                                            },
                                            {
                                                "example_id": "643a1013-7d83-43bc-a694-589b9aa7234c",
                                                "sense_id": "fe29ce6c-6354-3923-9fc5-7d76143e811c",
                                                "text": "2004, Dennis Child, Psychology and the Teacher, Continuum International Publishing, page 91,\n‘ […] We have to ask mummy if we can go to Rajah′s mummy′s house (Rajah′s mummy is the owner of the dog). We can if mummy says “yes”. […] ’"
                                            },
                                            {
                                                "example_id": "8e98928b-8dfe-4eaf-8b70-45e4043b63ff",
                                                "sense_id": "fe29ce6c-6354-3923-9fc5-7d76143e811c",
                                                "text": "Darla stared at her father and said, Mummy, Mummy, Mummy!\nMarjorie wheezed and said, Father. You. Are. Filthy!\nJoe said Daddy′s muddy! Daddy′s muddy!\nDarla stared at the darkened doorway where Howard stood, saying, Mummy, Mummy, Mummy, each time a little louder, each time a bit more shrilly,[…]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9344f9ba-d265-437e-9bf9-251f91c3a144",
                        "source_entry_id": "907c0719-7017-3b19-b777-6552c503aafa",
                        "source_sense_id": "4ca230f4-0ad3-3c5f-a481-183be13f8bd3",
                        "source_sense_description": "een door balseming en uitdroging geconserveerd lichaam van een dode",
                        "target_lang_word": "momie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "momie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "50bca441-8a07-3793-b2ca-9f39273137e6",
                                        "entry_id": "ef733101-08d1-3774-b897-3fdfb3db4a65",
                                        "glosses": [
                                            "Corps humain embaumé afin d’en assurer la conservation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ca10553-412b-4785-b64d-30cf27159ce2",
                                                "sense_id": "50bca441-8a07-3793-b2ca-9f39273137e6",
                                                "text": "C’est lui qui invente le culte de Lénine, […], l’embaumement, les défilés de foules recueillies devant la momie peinte, semblable à une figure de cire, amenuisée par le travail des embaumeurs."
                                            },
                                            {
                                                "example_id": "18048639-ff9d-4d94-b634-4d03d624dc6c",
                                                "sense_id": "50bca441-8a07-3793-b2ca-9f39273137e6",
                                                "text": "Elle prend du tabac, se tient roide comme un pieu, se pose en femme considérable, et ressemble parfaitement à une momie à laquelle le galvanisme aurait rendu la vie pour un instant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9abfd454-6dd9-3d44-96a1-abb312d9ef64",
                                        "entry_id": "ef733101-08d1-3774-b897-3fdfb3db4a65",
                                        "glosses": [
                                            "Corps qui, naturellement, se dessèche sans putréfaction."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2081766f-6a55-4406-9d09-1b6dfa635025",
                                                "sense_id": "9abfd454-6dd9-3d44-96a1-abb312d9ef64",
                                                "text": "APHIDIUS COLEMANI\n Biologie : la femelle de cet Hyménoptère parasitoïde dépose un œuf dans le puceron. La larve se développe dans ce puceron qui se fige sous forme de momie. Chaque momie est à l’origine d’un nouvel adulte d’Aphidius."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4332ce0-e357-3e81-8af9-b87614cbf0e7",
                                        "entry_id": "ef733101-08d1-3774-b897-3fdfb3db4a65",
                                        "glosses": [
                                            "Substance de poix et de bitume employée pour conserver les corps."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "82933495-75ce-3c47-a16c-3bf9ddd093d4",
                                        "entry_id": "ef733101-08d1-3774-b897-3fdfb3db4a65",
                                        "glosses": [
                                            "Substance à base de bitume servant de médicament."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e383478d-790a-3028-9de2-803d202d44b6",
                                        "entry_id": "ef733101-08d1-3774-b897-3fdfb3db4a65",
                                        "glosses": [
                                            "Couleur brune produite à partir de la substance pour enduire les momies."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "996fa38a-83af-44c3-93f3-0fd9a4addc7f",
                                                "sense_id": "e383478d-790a-3028-9de2-803d202d44b6",
                                                "text": "Voilà donc cette pauvre couleur momie qui a fait notre joie pendant tant d’années dans les sombres tableaux de Ribot ou dans les études à la Goya, appelée à disparaître à brêve échéance, si nous en croyons les gens bien informés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa9b6421-a494-3cd9-9673-1700e853d329",
                                        "entry_id": "ef733101-08d1-3774-b897-3fdfb3db4a65",
                                        "glosses": [
                                            "Personne maigre."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6d473c51-37e4-3cc6-a047-c6d1623d981a",
                                        "entry_id": "ef733101-08d1-3774-b897-3fdfb3db4a65",
                                        "glosses": [
                                            "Personne épuisée, sans aucune vivacité."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98f03f60-ab04-4def-8fe3-9e9dd077aaa4",
                                                "sense_id": "6d473c51-37e4-3cc6-a047-c6d1623d981a",
                                                "text": "Sa mère, Habiba, n’était plus, à trente-cinq ans, qu’une vieille momie sans âge, adonnée aux dures travaux du gourbi et du petit champ d’orge."
                                            },
                                            {
                                                "example_id": "24337941-abe3-472c-b509-82768e4feb3b",
                                                "sense_id": "6d473c51-37e4-3cc6-a047-c6d1623d981a",
                                                "text": "— Mais reluquez-moi c’te mijaurée, c’te momie, qui ne peut seulement pas se baisser ! Il ne vous salira pas, ce panier… Dire que nous payons ces propres à rien ! Croirait-on pas qu’elle a pondu l’obélisque avec sa robe noire ?"
                                            },
                                            {
                                                "example_id": "c44679f8-2f88-4f5e-80e4-2bb70bdbda06",
                                                "sense_id": "6d473c51-37e4-3cc6-a047-c6d1623d981a",
                                                "text": "— Vous n’allez pas sérieusement dormir ici ? C’est sinistre…\n— Ah ? Parce que jouer au pilleur de tombes avec trois momies et Quasimodo, ça te paraît plus glamour ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6ed82ff-9d75-3746-ad5d-cbd73d1bd304",
                                        "entry_id": "ef733101-08d1-3774-b897-3fdfb3db4a65",
                                        "glosses": [
                                            "Pastis servi dans un petit verre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f70d286e-da90-4489-9c82-3bf141ad8b7c",
                                                "sense_id": "a6ed82ff-9d75-3746-ad5d-cbd73d1bd304",
                                                "text": "Il existe une multitude de dénominations conférées au pastis. Dans le sud de la France, on demande à déguster un jaune ou un flai pour l’apéro. À Marseille, berceau de la production, on parle de pastaga et on commande un Pastis 51 ou une momie 51 (du nom de petit verre utilisé) pour l’apéritif."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
