                        "nl": "Vlot, gracieus en zonder onderbreking verlopen of bewegen.",
                        "zh": "指事物、过程或对话平稳、自然且不间断地进行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "течь",
                                "target_lang_sense_clarification": "протекать плавно (о беседе, времени)"
                            },
                            {
                                "target_lang_word": "идти",
                                "target_lang_sense_clarification": "развиваться или двигаться (о процессе, транспорте)"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "vloeien",
                                "target_lang_sense_clarification": "soepel verlopen (van een gesprek of proces)"
                            },
                            {
                                "target_lang_word": "doorstromen",
                                "target_lang_sense_clarification": "vlot blijven bewegen (van verkeer)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "顺畅",
                                "target_lang_sense_clarification": "形容过程进行得顺利"
                            },
                            {
                                "target_lang_word": "进行",
                                "target_lang_sense_clarification": "指活动或对话的开展"
                            }
                        ]
