                                                "sense_id": "98bb5fc2-b003-317c-9ad0-436607d4b389",
                                                "text": "Wie steht es um deine Disposition?"
                                            },
                                            {
                                                "example_id": "a6b038ae-4a47-4b47-97bb-08500f256f5f",
                                                "sense_id": "98bb5fc2-b003-317c-9ad0-436607d4b389",
                                                "text": "„Der DDR-Führung war die Disposition der Bevölkerung zur Schöpfung von Sprachwitzen aus der Abänderung des offiziellen Sprachgebrauchs selbstverständlich bekannt.“"
                                            },
                                            {
                                                "example_id": "5a8d30d3-1096-4ef6-b6f9-f318cd7443bb",
                                                "sense_id": "98bb5fc2-b003-317c-9ad0-436607d4b389",
                                                "text": "Sie hat schon eine gewisse Disposition für nervöse Krankheiten."
                                            }
                                        ],
