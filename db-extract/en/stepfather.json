                    },
                    {
                        "translation_id": "de253261-097d-40f3-947a-c0102c906f68",
                        "source_entry_id": "2f6bbf37-609a-3329-930a-717771739709",
                        "source_sense_description": "husband of one's biological mother, other than one's biological father",
                        "target_lang_word": "otčím",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "otčím",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "3e07cbe0-f66c-301c-ad14-0b92210fa16c",
                                        "entry_id": "c1a7a598-7a10-38f3-a93d-972cbca325f5",
                                        "glosses": [
                                            "nevlastní otec, matčin manžel nebo partner"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68ac86e3-777f-4056-ac52-270795d4c9e6",
                                                "sense_id": "3e07cbe0-f66c-301c-ad14-0b92210fa16c",
                                                "text": "Má rodiče, vlastní matku, ale otec jí umřel, když jí bylo devět let, bylo tomu osm let o Jiří. Matka se zase provdala — má otčíma."
                                            },
                                            {
                                                "example_id": "50e4903f-66a5-4556-91ac-046d8eae3821",
                                                "sense_id": "3e07cbe0-f66c-301c-ad14-0b92210fa16c",
                                                "text": "Za chlapcem zlostí rozzuřen zlý otčím dále chvátá, a když mu zmizel za dvorem, uzavřel za ním vrata."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1bbb618c-14a2-48e0-971f-b6ef998ca540",
                        "source_entry_id": "2f6bbf37-609a-3329-930a-717771739709",
