                "senses": [
                    {
                        "sense_id": "a86bc211-9b73-3c63-87a5-4249abb56fde",
                        "entry_id": "b5193dfd-9ad7-3af8-9f4f-d7e32391a4d7",
                        "glosses": [
                            "Action de coupler, résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ea371d2-d0bf-43de-9561-24074824edd9",
                                "sense_id": "a86bc211-9b73-3c63-87a5-4249abb56fde",
                                "text": "Lorsque le couplement des sciences apparut comme une notion importante, on figura, dans les tableaux, chaque couple sur un même étage, soit en deux termes : arithmétique-géométrie ou en trois termes : arithmétique (mathématiques), géométrie."
                            },
                            {
                                "example_id": "cfad117f-e142-44be-9ac8-3306d675739d",
                                "sense_id": "a86bc211-9b73-3c63-87a5-4249abb56fde",
                                "text": "Son plan contient des mesures concrètes, comme le couplement des amendes routières aux impôts qui permettrait, selon les cas de figure, de déduire les amendes impayées du montant que le fisc doit rembourser au contribuable ou d’additionner les amendes dues au montant que le contribuable doit au fisc."
                            },
                            {
                                "example_id": "9258f4dd-a79b-492e-b182-fa21bc10f962",
                                "sense_id": "a86bc211-9b73-3c63-87a5-4249abb56fde",
                                "text": "Nous avons dû choisir un étagement adéquat pour les engrenages de sorte que, quelque soit le rapport engagé, nous puissions obtenir de ce couplement moteur boîte le meilleur rendement possible."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13734b92-10c4-4848-9adb-a72457fb203a",
                        "source_entry_id": "b5193dfd-9ad7-3af8-9f4f-d7e32391a4d7",
                        "source_sense_id": "a86bc211-9b73-3c63-87a5-4249abb56fde",
                        "target_lang_word": "Kopplung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kopplung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4019df9e-fce1-376a-af87-8d697b815abb",
                                        "entry_id": "7e8ebb37-7c18-3aa4-8b0b-fff8870ba2b0",
                                        "glosses": [
                                            "mechanische, elektromagnetische oder gedankliche Verbindung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbd97a09-6a9c-4287-bf55-f081d8610066",
                                                "sense_id": "4019df9e-fce1-376a-af87-8d697b815abb",
                                                "text": "[16. Oktober 1976:] „In Kasachstan (UdSSR) landet die sowjetische \"Sojus-23\"-Kapsel früher als geplant, nachdem die ursprünglich vorgesehene Kopplung mit der Raumstation \"Saljut 5\" gescheitert ist.“"
                                            },
                                            {
                                                "example_id": "f33e581d-6520-4ec4-971b-538b082414d1",
                                                "sense_id": "4019df9e-fce1-376a-af87-8d697b815abb",
                                                "text": "„Durch die elektrische Kopplung der Geräte kann bei Fehlfunktionen des einen Gerätes das andere Gerät gestört oder sogar zerstört werden.“"
                                            },
                                            {
                                                "example_id": "8408fe07-5e4b-4b82-bb33-78cd8c449dbf",
                                                "sense_id": "4019df9e-fce1-376a-af87-8d697b815abb",
                                                "text": "[Gegeninduktivität] „wird auch als magnetische Kopplung bezeichnet.“"
                                            },
                                            {
                                                "example_id": "064cce6e-9514-4469-b665-ca1519e84987",
                                                "sense_id": "4019df9e-fce1-376a-af87-8d697b815abb",
                                                "text": "[Balkonkraftwerke:] „Die Kopplung mehrerer Geräte über eine Mehrfachsteckdose wäre gefährlich.“"
                                            },
                                            {
                                                "example_id": "849b204e-f27c-4b43-aaee-2974acad2e02",
                                                "sense_id": "4019df9e-fce1-376a-af87-8d697b815abb",
                                                "text": "„Mietwagen, die die Kopplung des Smartphones mit dem eingebauten Infotainment-System erlauben, sind praktisch: Musik hören, Telefonie und Co. Doch das Handy kann Spuren hinterlassen.“"
                                            },
                                            {
                                                "example_id": "002da2c1-502a-4937-94b4-f4a381ae1f3d",
                                                "sense_id": "4019df9e-fce1-376a-af87-8d697b815abb",
                                                "text": "[…] „die Kopplung zwischen sozialer Herkunft und Bildungserfolg ist hierzulande weiterhin hoch.“"
                                            },
                                            {
                                                "example_id": "95a7ca22-dde2-4b45-af2b-c28431a303ca",
                                                "sense_id": "4019df9e-fce1-376a-af87-8d697b815abb",
                                                "text": "„In der saudiarabischen Wüste, 40 Kilometer nordwestlich der Hauptstadt Riad, wird seit Anfang des Monats erstmals die technische Produktion von Wasserstoff durch direkte Kopplung von solarer Stromerzeugung und Wasserelektrolyse in großem Stil erprobt.“"
                                            },
                                            {
                                                "example_id": "74f15ae8-7718-4de4-ad07-55cac75cbedf",
                                                "sense_id": "4019df9e-fce1-376a-af87-8d697b815abb",
                                                "text": "„Der Bundesgerichtshof hat die seit gut 40 Jahren bestehende Kopplung von Erdgas an den Ölpreis aufgehoben.“"
                                            },
                                            {
                                                "example_id": "d17b2076-5472-4073-b9ee-cdc80e26ca8a",
                                                "sense_id": "4019df9e-fce1-376a-af87-8d697b815abb",
                                                "text": "„Wie könnte eine solche Kopplung an die Teuerung aussehen?“"
                                            },
                                            {
                                                "example_id": "80eb9676-99e4-4873-a6b4-a209580a241c",
                                                "sense_id": "4019df9e-fce1-376a-af87-8d697b815abb",
                                                "text": "„Die Kopplung des Rentenalters an die Lebenserwartung ist die einzige nachhaltige Lösung für die Altersvorsorge.“"
                                            },
                                            {
                                                "example_id": "5d87bd95-8829-40b8-87ac-8a54b1cc8f58",
                                                "sense_id": "4019df9e-fce1-376a-af87-8d697b815abb",
                                                "text": "[Indexmietverträge:] „Vor allem aus der SPD und bei den Grünen im Bund gab es zuletzt Forderungen, solche Mieten zu reformieren, um sprunghafte Mietanstiege wegen der Kopplung an die hohe Inflation zu verhindern.“"
                                            },
                                            {
                                                "example_id": "e6770e1f-b246-4444-adcd-ce8a324b9ea3",
                                                "sense_id": "4019df9e-fce1-376a-af87-8d697b815abb",
                                                "text": "„Die starke Kopplung des US-Dollars mit der Weltwirtschaft hat sich aber trotz der Ankündigungen einiger Staaten, künftig mehr Geschäfte in chinesischer oder anderer Währung abzuwickeln, noch nicht grundsätzlich verändert.“"
                                            },
                                            {
                                                "example_id": "6e63d8a4-5fd0-432c-962e-153e55997a7d",
                                                "sense_id": "4019df9e-fce1-376a-af87-8d697b815abb",
                                                "text": "„Grund für die Abwertung der Schweizer Währung war die Kopplung des Mindestkurses des Schweizer Frankens an den Wechselkurs Euro/US-Dollar.“"
                                            },
                                            {
                                                "example_id": "a7aca44b-e86a-4b40-aba8-6d8b0f92449e",
                                                "sense_id": "4019df9e-fce1-376a-af87-8d697b815abb",
                                                "text": "„EuGH erlaubt vorinstallierte Software“ – […] „Der EuGH hält eine derartige Kopplung von Hard- und Software grundsätzlich für zulässig, zumal Käufer üblicher Weise erwarten, einen sofort einsatzfähigen Rechner zu erwerben.“"
                                            },
                                            {
                                                "example_id": "aea5ce48-b33e-4f50-9bfb-2d20b0c719d1",
                                                "sense_id": "4019df9e-fce1-376a-af87-8d697b815abb",
                                                "text": "„Was im historischen Vergleich allerdings ganz deutlich heraussteche, sei die Prohibitionspolitik und Kriminalisierung von Drogen im 20. Jahrhundert. »Diese strikte Kopplung von Drogenrausch und Gefahr, die wir kennen, das ist recht neu. Das Abstinenz-Gebot ist recht neu, die Idee von Nüchternheit«, sagt Feustel.“"
                                            },
                                            {
                                                "example_id": "47614e73-3efe-4a25-8bf7-36c6adb38fb3",
                                                "sense_id": "4019df9e-fce1-376a-af87-8d697b815abb",
                                                "text": "[Rechtschreibung:] „Bei Kopplungen wie 5 %-Klausel wird auf einen zusätzlichen Bindestrich zwischen Zahl und Prozentzeichen verzichtet; hier kann aus typographischen Gründen ein Halbabstand anstatt eines vollen Abstandes gesetzt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
