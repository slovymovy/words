                    "frequency": "Low",
                    "semantic_group_id": "grivoiserie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'humoriste ponctuait son spectacle de nombreux <w>sous-entendus</w> qui faisaient rire la salle."
