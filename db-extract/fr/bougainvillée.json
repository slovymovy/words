                                                "sense_id": "d01addc5-0007-3f77-b416-b1844b47d538",
                                                "text": "He is outside in his garden, surrounded by bougainvillea bursting with color."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
