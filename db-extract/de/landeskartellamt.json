                "senses": [
                    {
                        "sense_id": "25f7dbb0-1e25-3c3d-a39a-9450b2a93b3c",
                        "entry_id": "ad73960d-945b-31fc-930a-0fc1a824497e",
                        "glosses": [
                            "Behörde auf Landesebene, deren Aufgabe der Schutz des Wettbewerbes ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15f7e44a-445b-45ed-a2e6-6842191170db",
                                "sense_id": "25f7dbb0-1e25-3c3d-a39a-9450b2a93b3c",
                                "text": "„Ein Wettbewerb sei nicht spürbar, klagen das hessische und das bayrische Landeskartellamt.“"
                            },
                            {
                                "example_id": "cdef41b4-e604-4509-873c-6ea17c488559",
                                "sense_id": "25f7dbb0-1e25-3c3d-a39a-9450b2a93b3c",
                                "text": "„Der Verdacht der Liefersperre hat sich nach Aussage des Landeskartellamts jedoch nicht bestätigt.“"
                            },
                            {
                                "example_id": "4b8f866d-530e-4f6e-b437-e6f90be88bc5",
                                "sense_id": "25f7dbb0-1e25-3c3d-a39a-9450b2a93b3c",
                                "text": "„Das Landeskartellamt in Bayern will eine Untersagungsverfügung aussprechen und diese beabsichtigte Koppelung verbieten.“"
                            },
                            {
                                "example_id": "9421aa07-aaca-4cd4-a2d2-f3ab2613b40e",
                                "sense_id": "25f7dbb0-1e25-3c3d-a39a-9450b2a93b3c",
                                "text": "„Letztere obliegt dem Bundeskartellamt bei bundesweit tätigen EVU und entsprechend dem jeweiligen Landeskartellamt bei EVU, die nur in einem Bundesland aktiv sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
