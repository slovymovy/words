        "fr-extract.jsonl": [
            {
                "entry_id": "445992d6-22f3-3b27-a46c-14b4a4221684",
                "word": "médiocrement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c600ccfe-91ba-3c6f-81c5-b73aba1402c3",
                        "entry_id": "445992d6-22f3-3b27-a46c-14b4a4221684",
                        "glosses": [
                            "D’une façon médiocre, moyenne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d83e8d1-35e0-411e-b366-697b0ec5660f",
                                "sense_id": "c600ccfe-91ba-3c6f-81c5-b73aba1402c3",
                                "text": "Un roi médiocrement savant."
                            },
                            {
                                "example_id": "5df1c27d-1070-4fc2-b8e3-8cf100226ec2",
                                "sense_id": "c600ccfe-91ba-3c6f-81c5-b73aba1402c3",
                                "text": "Qu'Orosmane immole Zaïre à sa jalousie ; une femme sensible y voit sans effroi le transport de la passion ; car c’est un moindre malheur de périr par la main de son amant, que d’en être médiocrement aimée."
                            }
                        ]
                    },
                    {
                        "sense_id": "c731300d-8336-3e6c-a00b-608a667dfec9",
                        "entry_id": "445992d6-22f3-3b27-a46c-14b4a4221684",
                        "glosses": [
                            "Peu ; pas beaucoup ; moyennement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f79cf03-ffed-4879-b37d-52e8332481f8",
                                "sense_id": "c731300d-8336-3e6c-a00b-608a667dfec9",
                                "text": "Tous deux appartenaient à des familles bourgeoises de Beauvais médiocrement riches, mais où les mœurs douces et la loyauté des provinces se transmettaient comme une partie de l’héritage."
                            },
                            {
                                "example_id": "c91cf5f9-d955-4b51-9bed-96f3cbfaab6f",
                                "sense_id": "c731300d-8336-3e6c-a00b-608a667dfec9",
                                "text": "Mattia était presque aussi content que moi, et il n’était pas médiocrement fier d’avoir contribué pour sa part à gagner une pareille somme."
                            },
                            {
                                "example_id": "8685f493-c41a-4b88-859d-211aa59ac23b",
                                "sense_id": "c731300d-8336-3e6c-a00b-608a667dfec9",
                                "text": "Dès qu'il s'éloigne du sol natal, sa pensée y retourne avec un charme douloureux et persistant. Dole, Dijon, Auxerre, Joigny, Sens, Fontainebleau, tous ces grands relais de poste, n'intéressaient que médiocrement les deux enfants."
                            },
                            {
                                "example_id": "6a909a69-5fae-44dc-bab7-c7023caf9c11",
                                "sense_id": "c731300d-8336-3e6c-a00b-608a667dfec9",
                                "text": "On a fêté médiocrement l'anniversaire des Trois Glorieuses qui délivrèrent la France des Bourbons et amenèrent Philippe sur le trône."
                            },
                            {
                                "example_id": "af16a3cb-522a-4fc8-876f-8f47e52d44ba",
                                "sense_id": "c731300d-8336-3e6c-a00b-608a667dfec9",
                                "text": "Leur mauvaise humeur s'accentuait quand ils constataient que le chef du gouvernement semblait médiocrement épris de la réforme."
                            },
                            {
                                "example_id": "e20e4671-c823-4038-8721-ff8fda3ae226",
                                "sense_id": "c731300d-8336-3e6c-a00b-608a667dfec9",
                                "text": "Qu'ils avaient affaire à un homme [Richelieu] qui ne voulait pas médiocrement ce qu’il voulait, et qui n'avait pas accoutumé de trouver de la résistance, ou de la souffrir impunément."
                            },
                            {
                                "example_id": "fa03059b-4535-4dcf-b5de-95524f362816",
                                "sense_id": "c731300d-8336-3e6c-a00b-608a667dfec9",
                                "text": "Nous revenions médiocrement couverts de lauriers."
                            }
                        ]
                    }
                ],
