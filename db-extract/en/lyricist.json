                                        "entry_id": "30c8e475-aebb-3ce4-a4cf-6a0d038e8189",
                                        "glosses": [
                                            "Auteur d’un livret d’opéra ou des paroles d’une chanson."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3be68bd9-0283-4317-a18e-8741975fac17",
                                                "sense_id": "3ffb5d05-be68-393c-aeed-270fbd50c7ef",
                                                "text": "Le parolier et le compositeur ont des droits d’auteur sur leur œuvre."
                                            },
                                            {
                                                "example_id": "7615cda6-689f-4b68-80b1-6b145704003d",
                                                "sense_id": "3ffb5d05-be68-393c-aeed-270fbd50c7ef",
                                                "text": "Hé là là, on s’entend qu’Émile Bilodeau n’est pas un grand parolier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66e80437-3657-3f8a-82c3-c5e5692a8ad6",
                                        "entry_id": "30c8e475-aebb-3ce4-a4cf-6a0d038e8189",
                                        "glosses": [
                                            "Dispositif délivrant aux visiteurs d’un musée un enregistrement sonore."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef126bc2-a2e0-42a5-be83-99428a344a1b",
                                                "sense_id": "66e80437-3657-3f8a-82c3-c5e5692a8ad6",
                                                "text": "Mieux que l’audioguide, les paroliers profitent à toute la famille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c78a369-de9a-3e76-ad08-1d276201c41a",
                                        "entry_id": "30c8e475-aebb-3ce4-a4cf-6a0d038e8189",
                                        "glosses": [
                                            "Bavard, fort en gueule."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74467e4d-6c85-4926-a291-628666d98329",
                                                "sense_id": "2c78a369-de9a-3e76-ad08-1d276201c41a",
                                                "text": "— Monseigneur, je le connois, l’original : bon ouvrier, fin menuisier, grand parolier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
