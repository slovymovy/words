                "senses": [
                    {
                        "sense_id": "728e331a-43e1-3238-a83a-91cc8a43b802",
                        "entry_id": "1539ad70-e4f2-39d7-bd1c-ceea6ecb32e8",
                        "glosses": [
                            "Qui approfondit, qui creuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f72c4323-b342-47c7-8e37-d9fb1df83dd1",
                                "sense_id": "728e331a-43e1-3238-a83a-91cc8a43b802",
                                "text": "Faire passer deux fois la charrue dans le même sillon, ou employer ces charrues approfondissantes, est toujours une bonne opération."
                            },
                            {
                                "example_id": "99696091-14c3-4de3-8e21-121726278a11",
                                "sense_id": "728e331a-43e1-3238-a83a-91cc8a43b802",
                                "text": "Plus militante que spéculative, plus voyageuse qu’approfondissante, elle remonte peu aux œuvres au passé, qui n’excitent plus en nous que des jouissances paisibles et des curiosité désintéressées."
                            },
                            {
                                "example_id": "7f86e724-0e15-4b57-8109-65e85a875643",
                                "sense_id": "728e331a-43e1-3238-a83a-91cc8a43b802",
                                "text": "Elles se sont trouvées préparées par de grandes fractures volcaniques pléistocènes, que les eaux n’ont eu qu’à utiliser pour leur travail d’érosion approfondissante."
                            }
                        ]
                    }
