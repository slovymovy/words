                    {
                        "sense_id": "644cd31f-e7d2-3983-8958-86c9d39b8ec7",
                        "entry_id": "2be6983b-375e-34c0-9798-edd0d94bfa0a",
                        "glosses": [
                            "unraffinierter Grundstoff für ein natürliches Süßungsmittel aus Zuckerrohr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a945af19-3ea7-486d-bcd8-9a464191ce5f",
                                "sense_id": "644cd31f-e7d2-3983-8958-86c9d39b8ec7",
                                "text": "„Diese Verordnung dient der Durchführung […] der Verordnung (EG) Nr. 1100/2006 zur Festlegung der Vorschriften für die Eröffnung und Verwaltung von Zollkontingenten für zur Raffination bestimmten Rohrohrzucker mit Ursprung in den am wenigsten entwickelten Ländern, …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "49ee1000-613b-3557-a1b0-68d89e74ab1f",
                        "entry_id": "2be6983b-375e-34c0-9798-edd0d94bfa0a",
                        "glosses": [
                            "teilweise raffiniertes natürliches Süßungsmittel aus Zuckerrohr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d097b5fc-cc23-42cb-81f5-d08eafe2da6f",
                                "sense_id": "49ee1000-613b-3557-a1b0-68d89e74ab1f",
                                "text": "„Roh-Rohrzucker ist teilweise raffiniert und enthält 0,3 bis 1 % Melasse.“"
                            },
                            {
                                "example_id": "8baa23ee-6ed2-44a4-b0d6-176784feb203",
                                "sense_id": "49ee1000-613b-3557-a1b0-68d89e74ab1f",
                                "text": "„Mit Rohrohrzucker ist hingegen ein teilraffinierter Rohrzucker mit einem geringeren Aschegehalt gemeint. Rohrohrzucker, auch unter den Namen Demerara, Muskovado und Syramena erhältlich, hat einen karamellartigen Eigengeschmack, der aber nicht so intensiv ist, wie der des Vollrohrzuckers.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
