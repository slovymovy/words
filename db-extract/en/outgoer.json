                        "examples": [
                            {
                                "example_id": "40e6a8e0-bd68-46a7-905e-b94f53a0029d",
                                "sense_id": "fd4590e6-4069-345e-bdc0-aa6f9720d728",
                                "text": "This tenancy necessitates the most complicated arrangements to dovetail the interests of the incomer and outgoer."
                            },
                            {
                                "example_id": "b05eb64d-e45b-4aa3-96d6-db7477741323",
                                "sense_id": "fd4590e6-4069-345e-bdc0-aa6f9720d728",
                                "text": "Also, a larger percentage of ailing outgoers than frail recluses would consider rebates."
                            },
                            {
                                "example_id": "534be190-3cb1-4a7c-a238-febce5069d6e",
                                "sense_id": "fd4590e6-4069-345e-bdc0-aa6f9720d728",
                                "text": "Then there exists a unique outgoer and unique ingoer (up to parametrization) through each point of Kerr-star spacetime."
                            }
                        ]
