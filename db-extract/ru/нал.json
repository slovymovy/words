                        "sense_id": "49c05955-cb07-3056-9847-bd1aef26e4b0",
                        "entry_id": "c2a1d745-e95c-3b9b-be96-b8b2dbdfc761",
                        "glosses": [
                            "разг. сокр. от наличные"
                        ],
