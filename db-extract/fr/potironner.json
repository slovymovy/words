                "senses": [
                    {
                        "sense_id": "68ee1a5a-c2c6-3f42-8f00-86d9ed0785bb",
                        "entry_id": "b8d33450-2fa0-3dee-8147-5aeddd46d1a6",
                        "glosses": [
                            "Avoir une activité de potiron."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fae321ae-b03a-44ac-aaff-98180db215ef",
                                "sense_id": "68ee1a5a-c2c6-3f42-8f00-86d9ed0785bb",
                                "text": "Il est vrai que je voyais de mes fenêtres les deux potirons jumeaux, Alfred et Clément Caumont, potironner côte à côte dans une paix profonde."
                            }
                        ]
                    },
                    {
                        "sense_id": "891f7c50-7452-3eb3-b8d0-c5d4b9abefe5",
                        "entry_id": "b8d33450-2fa0-3dee-8147-5aeddd46d1a6",
                        "glosses": [
                            "Orner de potirons en laine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f113cf88-4250-45be-9407-e1ac4a069829",
                                "sense_id": "891f7c50-7452-3eb3-b8d0-c5d4b9abefe5",
                                "text": "L’été c’est le moment de potironner !"
                            },
                            {
                                "example_id": "2a99195f-8bbd-4fad-806e-b332bb2cb307",
                                "sense_id": "891f7c50-7452-3eb3-b8d0-c5d4b9abefe5",
                                "text": "J’avais bien envie de potironner ce dos, en posant 2 pendouilles potironnés en tissu du col."
                            },
                            {
                                "example_id": "4198c02a-e6c5-4ac2-a85d-241123d59196",
                                "sense_id": "891f7c50-7452-3eb3-b8d0-c5d4b9abefe5",
                                "text": "Grâce au Chat je me suis éclatée à potironner à donf pour en mettre un peu partout dans mon écharpe (je sais que ma belle cousine chérie adore les potirons aussi)."
                            }
                        ]
                    }
