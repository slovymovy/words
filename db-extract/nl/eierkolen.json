                                        "entry_id": "d0d67973-9218-3930-8f12-fd6170c8562e",
                                        "glosses": [
                                            "Synonym of egg waffle (“egg-shaped waffle popular in Hong Kong”)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03816eb6-4f8e-459a-938e-00c6fd2e9924",
                                                "sense_id": "6e06ca15-e3dc-332e-979e-a399c08381fe",
                                                "text": "This takeaway counter serves up some of Hong Kong's best eggettes, the egg-shaped waffles beloved by local children and adults alike."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c38ee86-61c1-315e-abea-174e4c6c9a11",
                                        "entry_id": "d0d67973-9218-3930-8f12-fd6170c8562e",
                                        "glosses": [
                                            "An egg-shaped briquet of coal."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5371280-9363-460b-a7fc-e4008d146207",
                                                "sense_id": "6c38ee86-61c1-315e-abea-174e4c6c9a11",
                                                "text": "[…] an eggette or briquette manufacturing contract, where, by the compression of tar with these fine particles of culm, there are made pieces of coal about the size of an egg […]"
                                            }
                                        ]
                                    }
