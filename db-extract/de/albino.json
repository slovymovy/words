                        "sense_id": "942e0d98-3241-3b76-b064-9a9f75f53c53",
                        "entry_id": "787c7737-be64-3cfb-9d54-ce7d33b4823a",
                        "glosses": [
                            "Lebewesen mit der angeborenen Störung Albinismus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e3bedd1-d7a6-4576-9c97-931171666c98",
                                "sense_id": "942e0d98-3241-3b76-b064-9a9f75f53c53",
                                "text": "„Tatsächlich gibt es mehrere Gene, die Albinismus hervorrufen, ich spreche aber nur von einem von ihnen. Es ist rezessiv, das heißt, es muß in doppelter Ausfertigung vorhanden sein, damit ein Mensch ein Albino wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
