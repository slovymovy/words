                                    {
                                        "sense_id": "7a2c237c-008d-3fc9-92ba-53e225351643",
                                        "entry_id": "fc57c18b-5814-3c3e-af69-5423a23d22a3",
                                        "glosses": [
                                            "eine Wirtschaft, in der man gepflegt ein Bier trinken kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e3aab07-09f4-4bd5-99ae-8634b67f9930",
                                                "sense_id": "7a2c237c-008d-3fc9-92ba-53e225351643",
                                                "text": "Ich gehe zuweilen gerne in die Bierstube."
                                            },
                                            {
                                                "example_id": "723349d9-a35d-4cc2-9c7d-45176118938e",
                                                "sense_id": "7a2c237c-008d-3fc9-92ba-53e225351643",
                                                "text": "„Als ich in die kleine Bierstube eintrat, wo die Funktionärsversammlung stattfand, waren die achtundzwanzig Jahre wie weggewischt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b74731dd-dfd5-464e-ace2-c840bb56ba54",
                        "source_entry_id": "c5adc221-c89c-3e6b-b602-ae162421393b",
                        "source_sense_id": "6fec05f3-5339-3bbd-a61c-5f37547b98e2",
                        "source_sense_description": "type of restaurant",
                        "target_lang_word": "Brasserie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brasserie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b2ea6f81-5a7b-330e-b4dd-ffc9b605f912",
                                        "entry_id": "8bbcc903-6017-3c73-941f-a2f17171c23a",
                                        "glosses": [
                                            "ein Bierlokal"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fdbef59-0995-4097-95ab-47e27620321e",
                                                "sense_id": "b2ea6f81-5a7b-330e-b4dd-ffc9b605f912",
                                                "text": "Guck mal, da ist eine Brasserie! Wollen wir dahin?"
                                            },
                                            {
                                                "example_id": "2284c473-8609-4ed7-90ee-427713c9db38",
                                                "sense_id": "b2ea6f81-5a7b-330e-b4dd-ffc9b605f912",
                                                "text": "„Und so habe ich ihn von seinem letzten Besuch in Straßburg her in Erinnerung: fast betäubt von seiner Überdosis Aufputschmittel, Alkohol und Tabak, zusammengesunken vor einem Teller Sauerkraut in einer zweitrangigen Brasserie unweit des Kleberplatzes, achtlos ein Würstchen mit Senf bekleckernd, überragt von Simone de Beauvoir, aus deren Gesicht nicht das triumphierende Lächeln bedürfnisloser Selbstgerechtigkeit weicht.“"
                                            },
                                            {
                                                "example_id": "5ce848d6-64ed-4995-a61f-b544297cbbca",
                                                "sense_id": "b2ea6f81-5a7b-330e-b4dd-ffc9b605f912",
                                                "text": "„Georg K. Glaser hat sie in der Brasserie deponiert, damit ihm das Bier besser schmeckt.“"
                                            },
