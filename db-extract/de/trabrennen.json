                "senses": [
                    {
                        "sense_id": "b268b3d2-91bd-3b48-ab6b-ad0c5225e6d0",
                        "entry_id": "9be2c86f-d6c2-3532-b4fc-b8b321a789b2",
                        "glosses": [
                            "Wettrennen mit Pferden, bei der nur die Gangart Trab zulässig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0262819c-2dc3-4bc2-b73c-648bc2e3775b",
                                "sense_id": "b268b3d2-91bd-3b48-ab6b-ad0c5225e6d0",
                                "text": "„Auf der Jaderennbahn messen sich die Rennpferde im Trabrennen.“"
                            },
                            {
                                "example_id": "768942e2-d119-418a-a5ed-71592e9329f9",
                                "sense_id": "b268b3d2-91bd-3b48-ab6b-ad0c5225e6d0",
                                "text": "„John Brown, ein Mietstallbesitzer, hatte die ersten Trabrennen in Woolston bei Canterbury organisiert, nachdem sich der Sport in Europa etabliert hatte.“"
                            },
                            {
                                "example_id": "3cc1db82-fb70-43a6-a766-acc214fe6443",
                                "sense_id": "b268b3d2-91bd-3b48-ab6b-ad0c5225e6d0",
                                "text": "„Eines davon war Spirit, ein kleiner schwarzer Vollbluthengst, der nie besonders schnell galoppiert war, aber eine ausgesprochene Begabung fürs Trabrennen zeigte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
