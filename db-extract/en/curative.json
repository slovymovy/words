                                "example_id": "a25b5f43-bc30-489d-bbaf-4c55900d67f9",
                                "sense_id": "d5bd5bff-673f-3d0a-b0c7-97701fd11279",
                                "text": "a curative jury instruction to disregard the sheriff's testimony"
                            }
                        ]
                    }
