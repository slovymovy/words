                        "entry_id": "da89f64c-a72f-3a49-b55b-b6697d449609",
                        "glosses": [
                            "Bergwerk, in dem Kupfer abgebaut wird"
                        ],
                        "tags": [
                            "Bergbau"
                        ],
                        "examples": [
                            {
                                "example_id": "40ebecde-db6c-4bec-b77b-299ec981f3a6",
                                "sense_id": "503fb4a2-76f5-397b-9f2c-ca95ba40bbde",
                                "text": "„Wegen eines Streiks hat die weltgrößte Kupfermine in Chile am Montag ihre Produktion eingestellt.“"
                            },
                            {
                                "example_id": "7aae0d1b-345e-401e-bf48-b6fe7fd4fa9a",
                                "sense_id": "503fb4a2-76f5-397b-9f2c-ca95ba40bbde",
                                "text": "„Zwischen 1911 und 1918 sterben allein in den Kupferminen der südöstlichen Provinz Katanga etwa 5000 einheimische Arbeiter.“"
                            }
                        ],
