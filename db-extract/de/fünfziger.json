                "senses": [
                    {
                        "sense_id": "722b1af2-a293-392b-a18c-0f2c9e9463de",
                        "entry_id": "d1ce4402-5d7b-3718-9d05-8222b63b2a21",
                        "glosses": [
                            "Somme, monnaie d'une valeur de faciale de cinquante, en un billet de banque, ou plus rarement une pièce de monnaie."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "14ff2412-74a5-4463-83fa-3eb75efec76a",
                                "sense_id": "722b1af2-a293-392b-a18c-0f2c9e9463de",
                                "text": "Hast du Fünfziger dabei?",
                                "translation": "As-tu (une ou des) billets de 50 (euros) sur toi ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "f0f95702-c4c8-3fba-9158-daff730a4479",
                        "entry_id": "d1ce4402-5d7b-3718-9d05-8222b63b2a21",
                        "glosses": [
                            "Années cinquante d'un siècle ou d'une vie, au pluriel uniquement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f840a592-1a0b-441b-badb-8e257988b97f",
                                "sense_id": "f0f95702-c4c8-3fba-9158-daff730a4479",
                                "text": "Die Fünfziger waren das sechste Jahrzehnt des 20. Jahrhunderts und dauerten von 1950 bis 1959.",
                                "translation": "Les années cinquante ont été la sixième décennie du XXème siècle et ont duré de 1950 à 1959."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9709529-7d38-3d4f-8de6-b75683fa565c",
                        "entry_id": "d1ce4402-5d7b-3718-9d05-8222b63b2a21",
                        "glosses": [
                            "Quinquagénaire personne âgée de 50 à 59 ans, ,."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b08bd7be-c6f5-41bf-9af4-86a91e0cc53c",
                                "sense_id": "f9709529-7d38-3d4f-8de6-b75683fa565c",
                                "text": "Dieser Fünfzigersieht trotz seiner grauen Haare immer noch jung aus.",
                                "translation": "Ce quinquagénaire paraît encore jeune malgré ses cheveux gris."
                            }
                        ]
                    }
                ],
