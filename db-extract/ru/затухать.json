                    },
                    {
                        "sense_id": "031fab1d-8644-3f09-ae15-11cf821d7c65",
                        "entry_id": "62931ea4-8387-3499-814b-55b617dbfb98",
                        "glosses": [
                            "перен. становиться слабее; затихать, прекращаться"
                        ],
