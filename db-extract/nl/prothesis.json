                    {
                        "translation_id": "9f0c253f-436a-4261-acd1-b5f057ca6f96",
                        "source_entry_id": "c7e36f04-d545-3a91-9025-3e98257f8e9d",
                        "source_sense_id": "27a945da-469d-330a-9b25-b19353624326",
