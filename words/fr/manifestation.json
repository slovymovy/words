{
    "word_family": [
        "manifestant",
        "manifeste",
        "manifestement",
        "manifester"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3d7717bc-b5f0-3e47-9802-8c76122850ad",
                    "sense_definition": "Rassemblement de personnes dans un lieu public pour exprimer collectivement une opinion ou une revendication politique ou sociale.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Des milliers de citoyens ont défilé calmement pendant cette grande <w>manifestation</w> contre la nouvelle loi."
                        },
                        {
                            "text": "Les syndicats ont décidé d'organiser une <w>manifestation</w> pacifique dans le centre de la capitale."
                        }
                    ],
                    "synonyms": [
                        "manif",
                        "protestation"
                    ],
                    "common_phrases": [
                        "manifestation pacifique",
                        "organiser une manifestation",
                        "participer à une manifestation"
                    ]
                },
                {
                    "sense_id": "7779fd1f-d4d3-38d1-b49a-5c39c5903835",
                    "sense_definition": "Rassemblement public organisé pour des réjouissances ou des activités culturelles, artistiques ou sportives.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "evenement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La ville prépare une importante <w>manifestation</w> culturelle qui attirera de nombreux visiteurs cet été."
                        },
                        {
                            "text": "Cette grande <w>manifestation</w> sportive réunit chaque année des athlètes de toute l'Europe."
                        }
                    ],
                    "synonyms": [
                        "événement",
                        "rassemblement"
                    ],
                    "common_phrases": [
                        "manifestation culturelle",
                        "manifestation sportive"
                    ]
                },
                {
                    "sense_id": "0be79603-3b88-37bf-86e5-4acfa45c9505",
                    "sense_definition": "Fait de rendre visible ou évident un sentiment, une intention ou une réalité abstraite.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "signe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses larmes silencieuses étaient une claire <w>manifestation</w> de sa profonde tristesse."
                        },
                        {
                            "text": "Les applaudissements chaleureux du public étaient une éclatante <w>manifestation</w> de joie."
                        }
                    ],
                    "synonyms": [
                        "expression",
                        "marque",
                        "signe",
                        "témoignage"
                    ],
                    "common_phrases": [
                        "manifestation de joie",
                        "manifestation de sympathie"
                    ]
                },
                {
                    "sense_id": "c6245c40-2cc8-370c-a335-89dacfb97ba9",
                    "sense_definition": "Signe extérieur, symptôme perceptible ou effet visible d'une maladie ou d'un trouble physique.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'éruption cutanée représente la première <w>manifestation</w> visible de cette réaction allergique."
                        },
                        {
                            "text": "Le médecin a surveillé chaque <w>manifestation</w> clinique de la fièvre chez le patient."
                        }
                    ],
                    "common_phrases": [
                        "manifestation clinique",
                        "manifestation allergique"
                    ]
                },
                {
                    "sense_id": "c77b4161-d133-3cf4-96dc-7f3c0d43a5e9",
                    "sense_definition": "Ensemble du monde physique et des phénomènes tangibles, par opposition au monde immatériel ou transcendant.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "philosophie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cet ouvrage ésotérique, l'auteur examine les lois spirituelles qui gouvernent la <w>manifestation</w> universelle."
                        },
                        {
                            "text": "Les mystiques cherchent à dépasser la <w>manifestation</w> pour atteindre le principe immuable qui la fonde."
                        }
                    ],
                    "common_phrases": [
                        "manifestation universelle"
                    ]
                }
            ]
        }
    ]
}