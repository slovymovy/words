                "senses": [
                    {
                        "sense_id": "cad52a02-50ca-3966-91de-a110b19f098b",
                        "entry_id": "156c2103-4f05-367c-904a-96d79957567c",
                        "glosses": [
                            "nach dem Aufstehen getragenes, bequemes einteiliges Bekleidungsstück"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e439ddf-c246-4e7b-bca4-d41902de9003",
                                "sense_id": "cad52a02-50ca-3966-91de-a110b19f098b",
                                "text": "„Sie trägt einen Morgenmantel.“"
                            },
                            {
                                "example_id": "0a9c39cb-3c6a-40f1-bb20-3d3573e501a9",
                                "sense_id": "cad52a02-50ca-3966-91de-a110b19f098b",
                                "text": "„Einige Patienten waren hell gekleidet, einige von ihnen in weißen Morgenmänteln.“"
                            },
                            {
                                "example_id": "384c2771-84f7-4ed8-8530-3d87efd45e48",
                                "sense_id": "cad52a02-50ca-3966-91de-a110b19f098b",
                                "text": "„Den Morgenmantel habe ich sofort bei meinem Schneider Wong in Auftrag gegeben.“"
                            },
                            {
                                "example_id": "70be876d-a704-49c1-a3f3-059cf2ba4a12",
                                "sense_id": "cad52a02-50ca-3966-91de-a110b19f098b",
                                "text": "„Sie warf sich ihren rosa Morgenmantel aus gestepptem Acryl über und lief in Pantoffeln hinaus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4e41e840-1f95-4a18-9606-c1c7e5b39244",
                        "source_entry_id": "156c2103-4f05-367c-904a-96d79957567c",
                        "source_sense_id": "cad52a02-50ca-3966-91de-a110b19f098b",
                        "source_sense_description": "nach dem Aufstehen getragenes, bequemes einteiliges Bekleidungsstück",
                        "target_lang_word": "dressing gown",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dressing gown",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "769ffeba-555e-3553-82bb-7697f37e852c",
                                        "entry_id": "afc66330-bc75-3b60-bc8b-a128a941abd2",
                                        "glosses": [
                                            "An item of clothing often made from cotton or another absorbent material, in the form of a long open robe with a belt to tie it around the middle and fasten it securely; often worn over pyjamas."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d249491-07a0-4385-8660-4da57341b9fd",
                                                "sense_id": "769ffeba-555e-3553-82bb-7697f37e852c",
                                                "text": "After about ten minutes he got up, and, throwing on an elaborate dressing-gown of silk-embroidered cashmere wool, passed into the onyx-paved bathroom."
                                            },
                                            {
                                                "example_id": "edc87cb6-dbbd-4d90-bbc9-0aea47a90b3a",
                                                "sense_id": "769ffeba-555e-3553-82bb-7697f37e852c",
                                                "text": "I was feeling just as I had felt in the old Malvern House epoch when I used to sneak down to [the headmaster]'s study at dead of night in quest of the biscuits he kept there in a tin on his desk, and there came back to me the memory of the occasion when, not letting a twig snap beneath my feet, I had entered his sanctum in pyjamas and a dressing-gown, to find him seated in his chair, tucking into the biscuits himself. [...] She was looking more like Sherlock Holmes than ever. Slap a dressing-gown on her and give her a violin, and she could have walked straight into Baker Street and no questions asked."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f91c08b3-45c4-4341-ac34-1cc53dff9995",
                        "source_entry_id": "156c2103-4f05-367c-904a-96d79957567c",
                        "source_sense_id": "cad52a02-50ca-3966-91de-a110b19f098b",
                        "source_sense_description": "nach dem Aufstehen getragenes, bequemes einteiliges Bekleidungsstück",
                        "target_lang_word": "peignoir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peignoir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c592086-b407-32c5-a9ae-00dbe7e57928",
                                        "entry_id": "c599c968-eaa1-35be-82ef-4d36fcdfc442",
                                        "glosses": [
                                            "Sorte de vêtement de dessus que l’on jette sur ses épaules, quand on fait sa toilette, quand on se peigne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b5d4651-e233-4e79-b04d-e3c0e3cc2c2b",
                                                "sense_id": "8c592086-b407-32c5-a9ae-00dbe7e57928",
                                                "text": "Liane s’était contentée d’un simple peignoir de mérinos grisâtre avec devantiau (tablier) noir, fichu à grands ramages, et ce gracieux petit bonnet rond qui s’appelle une canipette."
                                            },
                                            {
                                                "example_id": "f94020f8-3601-4738-80b1-356ad5080177",
                                                "sense_id": "8c592086-b407-32c5-a9ae-00dbe7e57928",
                                                "text": "Arlette a promis de décorer la table avec des fleurs. Aussi, le lendemain, dès l’aube, est-elle dans le jardin, en peignoir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d007961-bee7-3ce3-aac7-8ba046766dab",
                                        "entry_id": "c599c968-eaa1-35be-82ef-4d36fcdfc442",
                                        "glosses": [
                                            "Vêtement à peu près semblable qu’on met en sortant du bain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "492cd3ba-48df-45f4-9f73-4374d6e34c0a",
                                                "sense_id": "7d007961-bee7-3ce3-aac7-8ba046766dab",
                                                "text": "J’attrapai un peignoir et décrochai le combiné fixé au mur, à côté des W-C."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20722737-402c-3850-877c-26672e755c40",
                                        "entry_id": "c599c968-eaa1-35be-82ef-4d36fcdfc442",
                                        "glosses": [
                                            "Vêtement d’intérieur ; déshabillé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "492ffe98-6b5b-4192-affa-d10375e828fc",
                                                "sense_id": "20722737-402c-3850-877c-26672e755c40",
                                                "text": "Une Liménienne déjeûne le matin, avec son mari en petit peignoir à la française, ses cheveux retroussés absolument comme nos dames de Paris."
                                            },
                                            {
                                                "example_id": "497a42e8-d545-448d-b9ef-8553e6aea31e",
                                                "sense_id": "20722737-402c-3850-877c-26672e755c40",
                                                "text": "Quand elle achetait soit des corsets, soit des peignoirs, soit des pantalons, elle voulait toujours que ce fût moi qui passasse avec elle dans la chambre au fond et qui les lui essayasse."
                                            },
                                            {
                                                "example_id": "0e0f74eb-dd6c-4d5d-8c39-d440ff18764c",
                                                "sense_id": "20722737-402c-3850-877c-26672e755c40",
                                                "text": "[…] : pour peu qu’il y eût de l’électricité dans l’air ou que Och eût joué des parties du Vaisseau Fantôme, les Teutes s’assombrissaient, d’autres tentaient de s’aller coucher et chassées par l’insomnie revenaient en peignoir dans le petit salon des veillées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
