                    {
                        "form_id": "9323b66c-3bc1-44b4-9aeb-106c750e759f",
                        "entry_id": "8cae70ea-f748-3950-ae0a-12b3b11cd93c",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "bruiloftjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a7a03248-1e2d-3895-9d63-f7994397af09",
                        "entry_id": "8cae70ea-f748-3950-ae0a-12b3b11cd93c",
                        "glosses": [
                            "feestelijke gelegenheid waarbij twee personen in de echt verenigd worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bf2a292-82ca-4001-be84-d5f14e849afe",
                                "sense_id": "a7a03248-1e2d-3895-9d63-f7994397af09",
                                "text": "De uitgever van het Duitse boulevardblad Bild zei ooit: ‘Als je met ons in de lift omhoog gaat, ga je ook mee met de lift naar beneden.’ Zo werkt dat in ons vak: we zijn op je bruiloft, maar ook op je begrafenis. Als je bekend wordt, dan weet je: het hoort er gewoon bij. Dus werk je er gewoon een beetje aan mee.”"
                            },
                            {
                                "example_id": "ced80726-50bb-4299-9a00-82b7b2f20c7f",
                                "sense_id": "a7a03248-1e2d-3895-9d63-f7994397af09",
                                "text": "Ik bleef nog een tijdje languit in het gras liggen om de tekst die ze mij had voorgelezen tot me door te laten dringen. Ik had het hoofdstuk over het huwelijk uit De profeet al vaker gehoord tijdens bruiloften, voorgelezen door een trotse oom of vader."
                            },
                            {
                                "example_id": "eb8cbc37-929b-4ce0-9913-b15ef39e3286",
                                "sense_id": "a7a03248-1e2d-3895-9d63-f7994397af09",
                                "text": "Toen hij hem verbaasd omhooghield veranderde de stemming snel, de anderen lachten, klapten in hun handen en feliciteerden hem met de bruiloft binnen een jaar."
                            }
                        ]
                    },
                    {
                        "sense_id": "55bcac4c-e461-357e-83d7-33c6f13a2a2c",
                        "entry_id": "8cae70ea-f748-3950-ae0a-12b3b11cd93c",
                        "glosses": [
                            "gedenkfeest van een huwelijk"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "18c1b4b0-f1bf-43e4-a13c-20d4800fcf37",
                        "source_entry_id": "8cae70ea-f748-3950-ae0a-12b3b11cd93c",
                        "source_sense_id": "a7a03248-1e2d-3895-9d63-f7994397af09",
                        "source_sense_description": "huwelijks-, trouwfeest",
                        "target_lang_word": "Hochzeitsfeier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hochzeitsfeier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6c9232bb-5134-39ac-bb34-55746d4e648a",
                                        "entry_id": "86fe00e8-d16e-38ce-a299-c5ccdf0bef8f",
                                        "glosses": [
                                            "das Feiern anlässlich einer Eheschließung (Hochzeit)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af6e4200-5922-48b0-9756-b377b2f7bf48",
                                                "sense_id": "6c9232bb-5134-39ac-bb34-55746d4e648a",
                                                "text": "Meine Hochzeitsfeier hatte über 100 Gäste."
                                            },
                                            {
                                                "example_id": "6ec233f3-c173-4d8f-9859-1f56e463b1e1",
                                                "sense_id": "6c9232bb-5134-39ac-bb34-55746d4e648a",
                                                "text": "„Im Mittelpunkt der Hochzeitsfeier aber stand das Festmahl am ersten Hochzeitstag, das bis heute mit einer kräftigen Hochzeitssuppe eingeleitet wird.“"
                                            },
                                            {
                                                "example_id": "48a18cb2-d92e-4f66-bbe1-2cbfe0c0b07c",
                                                "sense_id": "6c9232bb-5134-39ac-bb34-55746d4e648a",
                                                "text": "„Darum bin ich auch bisher nur auf wenigen Hochzeitsfeiern gewesen.“"
                                            },
                                            {
                                                "example_id": "903f7ea3-ba32-404c-9884-509053970c97",
                                                "sense_id": "6c9232bb-5134-39ac-bb34-55746d4e648a",
                                                "text": "„Die schöne miterlebte Hochzeitsfeier erweckte in ihr keinerlei Reue, daß sie die gute, ihr von Madame Audiberti vorgeschlagene Partie zurückgewiesen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
