    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "023748ad-7474-3fc0-8275-62fe34884b30",
                    "sense_definition": "Qualifie une nourriture ou un repas simple, modeste et peu abondant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "alimentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après une longue journée de marche en montagne, les randonneurs ont partagé un repas <w>frugal</w> composé de pain et de fromage."
                        },
                        {
                            "text": "Elle préférait un dîner <w>frugal</w> le soir pour mieux dormir."
                        }
                    ],
                    "synonyms": [
                        "simple"
                    ],
                    "antonyms": [
                        "opulent",
                        "sophistiqué"
                    ],
                    "common_phrases": [
                        "repas frugal",
                        "dîner frugal"
                    ]
                },
                {
                    "sense_id": "83c2e995-5862-372d-a427-37747ea29602",
                    "sense_definition": "Qui a des habitudes simples et sobres, particulièrement dans sa manière de se nourrir.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré son immense fortune, ce vieil homme est resté très <w>frugal</w> tout au long de son existence."
                        },
                        {
                            "text": "Les moines mènent une vie <w>frugale</w> à l'écart du tumulte de la ville moderne."
                        }
                    ],
                    "synonyms": [
                        "simple"
                    ],
                    "common_phrases": [
                        "vie frugale"
                    ]
                },
                {
                    "sense_id": "b4d173cc-a67a-3653-8488-927ac5053dab",
                    "sense_definition": "Qui pratique une stricte rigueur budgétaire et s'oppose à l'augmentation de la dette publique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "economie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lors des négociations européennes, les pays <w>frugaux</w> ont fermement exigé une réduction des dépenses publiques communes."
                        },
                        {
                            "text": "Cette coalition réunit plusieurs États aux politiques budgétaires traditionnellement très <w>frugales</w>."
                        }
                    ],
                    "common_phrases": [
                        "pays frugaux"
                    ]
                }
            ]
        }
    ]
