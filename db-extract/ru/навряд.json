        "ru-extract.jsonl": [
            {
                "entry_id": "c6c9a35a-07da-39eb-8a9e-bb452b3c1017",
                "word": "навряд",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "196d68c2-c0d8-300b-9b44-3320eec0fbe2",
                        "entry_id": "c6c9a35a-07da-39eb-8a9e-bb452b3c1017",
                        "glosses": [
                            "устар. и прост. то же, что вряд ли"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5450902b-9da2-4a08-a6c1-0a077797ed87",
                        "source_entry_id": "c6c9a35a-07da-39eb-8a9e-bb452b3c1017",
                        "source_sense_id": "196d68c2-c0d8-300b-9b44-3320eec0fbe2",
                        "target_lang_word": "hardly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hardly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5fbc8ba-d20b-3d6b-95f6-3c109f9b046e",
                                        "entry_id": "ba34ebd5-3f92-33d5-85c1-bd9687de851f",
                                        "glosses": [
                                            "Barely, only just, almost not."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dbc64f0-0d04-413a-b6b4-2468c3defa70",
                                                "sense_id": "f5fbc8ba-d20b-3d6b-95f6-3c109f9b046e",
                                                "text": "They hardly ever watch television."
                                            },
                                            {
                                                "example_id": "4e11a184-c869-4af2-b2c4-b0277b6b3c42",
                                                "sense_id": "f5fbc8ba-d20b-3d6b-95f6-3c109f9b046e",
                                                "text": "It's hardly possible he could lose the election."
                                            },
                                            {
                                                "example_id": "7810b1da-8b27-4127-9763-96122912a36e",
                                                "sense_id": "f5fbc8ba-d20b-3d6b-95f6-3c109f9b046e",
                                                "text": "Hardly did I arrive when he left."
                                            },
                                            {
                                                "example_id": "533b1569-90de-4cd1-a4a6-4bf2defc40af",
                                                "sense_id": "f5fbc8ba-d20b-3d6b-95f6-3c109f9b046e",
                                                "text": "How lonely they looked as they lay there, and how ill assorted! That little heap had been for two thousand years the wisest, loveliest, proudest creature - I can hardly call her woman - in the whole universe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb68ce87-0e3b-3a33-8b24-940d55e910fc",
                                        "entry_id": "ba34ebd5-3f92-33d5-85c1-bd9687de851f",
                                        "glosses": [
                                            "Certainly not; not at all."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "239a05e8-daf0-4811-8e4a-7fb0a5238309",
                                                "sense_id": "fb68ce87-0e3b-3a33-8b24-940d55e910fc",
                                                "text": "I hardly think they'll come in this bad weather!"
                                            },
                                            {
                                                "example_id": "5f23d5ed-da99-4a7e-ba6f-c742279ddd91",
                                                "sense_id": "fb68ce87-0e3b-3a33-8b24-940d55e910fc",
                                                "text": "With this the second of three games in seven days for Stoke, it was hardly surprising to see nine changes from the side that started against Newcastle in the Premier League on Monday."
                                            },
                                            {
                                                "example_id": "c60b62a6-7543-4485-b953-1b95ece74f36",
                                                "sense_id": "fb68ce87-0e3b-3a33-8b24-940d55e910fc",
                                                "text": "Investors face a quandary. Cash offers a return of virtually zero in many developed countries; government-bond yields may have risen in recent weeks but they are still unattractive. Equities have suffered two big bear markets since 2000 and are wobbling again. It is hardly surprising that pension funds, insurers and endowments are searching for new sources of return."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f78af57f-df19-3828-8cbe-54699b3a4901",
                                        "entry_id": "ba34ebd5-3f92-33d5-85c1-bd9687de851f",
                                        "glosses": [
                                            "With difficulty."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1103ead-7834-4756-a824-f6c230808372",
                                                "sense_id": "f78af57f-df19-3828-8cbe-54699b3a4901",
                                                "text": "And what gentle flame soever doth warme the heart of young virgins, yet are they hardly drawne to leave and forgoe their mothers, to betake them to their husbands […]."
                                            },
                                            {
                                                "example_id": "64307183-296b-44ff-b535-e97145a2f664",
                                                "sense_id": "f78af57f-df19-3828-8cbe-54699b3a4901",
                                                "text": "While in Chelsea, Anne Smiley pined, taking very hardly to her unaccustomed role of wife abandoned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a4ffbbe-5bb3-37b6-b304-b4a53226c2ec",
                                        "entry_id": "ba34ebd5-3f92-33d5-85c1-bd9687de851f",
                                        "glosses": [
                                            "Harshly, severely; in a hard manner."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab45d19a-4c60-4cbd-98dd-162f9eb70963",
                                                "sense_id": "1a4ffbbe-5bb3-37b6-b304-b4a53226c2ec",
                                                "text": "I was a fool when I married him; and I am so far an incurable fool on that subject, that, for the sake of what I once believed him to be, I wouldn’t have even this shadow of my idle fancy hardly dealt with."
                                            },
                                            {
                                                "example_id": "6fb5a34d-bc80-4c7f-b537-ec782ea2de8b",
                                                "sense_id": "1a4ffbbe-5bb3-37b6-b304-b4a53226c2ec",
                                                "text": "\"Mr. Cholmondeley, the young men out here are much too hardly worked to allow them time for paying impertinent compliments.\""
                                            },
                                            {
                                                "example_id": "0cd6c1f5-4803-4860-becb-ebd0e79965ef",
                                                "sense_id": "1a4ffbbe-5bb3-37b6-b304-b4a53226c2ec",
                                                "text": "Only I wasn't at all pleased with that; I saw that he was simply sorry for me because I was so hardly treated by grandmother, and that was all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2baf242-fe61-3b67-ae17-c6aaea2e56fd",
                                        "entry_id": "ba34ebd5-3f92-33d5-85c1-bd9687de851f",
                                        "glosses": [
                                            "Firmly, vigorously, with strength or exertion."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4d624d3-ffa4-49de-9f66-718a9c747d0e",
                                                "sense_id": "c2baf242-fe61-3b67-ae17-c6aaea2e56fd",
                                                "text": "Let him hardly be possest with an honest curiositie to search out the nature and causes of all things […]."
                                            },
                                            {
                                                "example_id": "1e783f7a-9ed9-4512-98ed-2ca2c1954690",
                                                "sense_id": "c2baf242-fe61-3b67-ae17-c6aaea2e56fd",
                                                "text": "Sometimes my pulse beat so quickly and hardly, that I felt the palpitation of every artery; at others, I nearly sank to the ground through languor and extreme weakness."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hardly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "068567fa-54fe-3ea2-8e30-6061d421bd2a",
                                        "entry_id": "815a44e3-e868-31d4-9011-2bd0cf165861",
                                        "glosses": [
                                            "Not really."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7b0f9df-70c0-4468-bf6b-ab6426aabc8f",
                                                "sense_id": "068567fa-54fe-3ea2-8e30-6061d421bd2a",
                                                "text": "I think the Beatles are a really overrated band. ― Hardly!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
