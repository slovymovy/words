                "senses": [
                    {
                        "sense_id": "f8641f43-05bb-3530-8e00-9795bfb7780c",
                        "entry_id": "c8d27093-2445-3e94-9975-7677f158d0b6",
                        "glosses": [
                            "Fertigkeit, Können im Spiel; Qualität des Spielvermögens eines Einzelspielers oder einer Mannschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c33e254d-2546-4f74-95fa-3e2ad6dc89cd",
                                "sense_id": "f8641f43-05bb-3530-8e00-9795bfb7780c",
                                "text": "„Dass der Spielanfang nicht der Höhepunkt der Spielkunst war, hat jeder mitgekriegt, sagte er.“"
                            },
                            {
                                "example_id": "b0e8b884-26fa-47af-b8fe-15201c22281d",
                                "sense_id": "f8641f43-05bb-3530-8e00-9795bfb7780c",
                                "text": "„Im April und Mai entdeckte das Team im Abstiegskampf seine Spielkunst, reihte Sieg an Sieg.“"
                            },
                            {
                                "example_id": "e0c79108-6866-4dac-a672-608689c5ac7c",
                                "sense_id": "f8641f43-05bb-3530-8e00-9795bfb7780c",
                                "text": "„Schon in der 4. Minute gaben die Katalanen die erste Kostprobe ihrer Spielkunst ab, als die Juve-Abwehr eine schnelle Kombination von Neymar und Andreas Iniesta auf der linken Seite nicht verhindern konnte.“"
                            },
                            {
                                "example_id": "e00e3010-4661-4fa7-a01c-6aff3d1a61a8",
                                "sense_id": "f8641f43-05bb-3530-8e00-9795bfb7780c",
                                "text": "„Timo Boll, wegen seiner Spielkunst und seines höflichen Auftretens ein gern gesehener Gast, und der Weltranglisten-Erste Ma Long bilden in Suzhou ein Doppel.“"
                            },
                            {
                                "example_id": "8a71c123-611c-4b6b-9e6a-2b3cf2362d04",
                                "sense_id": "f8641f43-05bb-3530-8e00-9795bfb7780c",
                                "text": "„Zuletzt bekamen er und seine Mannschaft die Spielkunst der Skandinavier beim Supercup im vorigen November vorgeführt, als es in Berlin eine 26:29-Niederlage gab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
