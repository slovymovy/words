                "senses": [
                    {
                        "sense_id": "86015721-8a86-37d8-9573-fefeda9c0db5",
                        "entry_id": "fe235163-c0c3-3f7c-b005-8e4c24383a82",
                        "glosses": [
                            "letzter und heiliger Tag in der Woche bei der jüdischen/judenchristlichen Glaubensgemeinschaft (im wesentlichen der Samstag/Sonnabend)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c7bd6cc-7544-4f2c-9000-3385e60450d8",
                                "sense_id": "86015721-8a86-37d8-9573-fefeda9c0db5",
                                "text": "„Wenn am Freitag Abend Engelbrecht das verschlossene Klavier öffnete, ein Lieblingsstück anschlug und Reinchen hinter dem Rücken der Mutter unwillkürlich zur Geige griff, dann stürzte Raschelchen herein mit dem Ausruf: »Reinchen, was thust Du! am heiligen Schabbes (Sabbath)!«“"
                            },
                            {
                                "example_id": "048edecf-26d8-4237-9885-f65260331e5c",
                                "sense_id": "86015721-8a86-37d8-9573-fefeda9c0db5",
                                "text": "„Nach dem Beten gingen die Männer zu Max hinüber und wünschten ihm guten Schabbes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd154f28-86cd-4fef-ad1a-927ef7f32664",
                        "source_entry_id": "fe235163-c0c3-3f7c-b005-8e4c24383a82",
                        "source_sense_id": "86015721-8a86-37d8-9573-fefeda9c0db5",
                        "target_lang_word": "Shabbas",
