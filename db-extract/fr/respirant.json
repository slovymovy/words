                    {
                        "sense_id": "c0c3dfcc-bb62-3ddc-bc41-911e9f558a94",
                        "entry_id": "568cbfb9-bace-3c8c-a658-c77a75e49b6b",
                        "glosses": [
                            "Participe présent de respirer."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "031ba00b-9d36-47ab-9870-53e9077a7fd5",
                                "sense_id": "c0c3dfcc-bb62-3ddc-bc41-911e9f558a94",
                                "text": "Les silhouettes des buissons frangeaient son chemin et il allait, tête levée, respirant large."
                            },
                            {
                                "example_id": "e31b9566-bd2c-4e04-9704-9d85d72a9426",
                                "sense_id": "c0c3dfcc-bb62-3ddc-bc41-911e9f558a94",
                                "text": "Zef la suivit, respirant son sillage à pleins poumons. Sûr, il n’allait plus la quitter des yeux de la soirée. Et quand elle partirait, il la suivrait encore. Et il lui ferait son affaire dans une ruelle. Vite fait, mal fait. En plus, vilaine comme elle était, elle ne pourrait pas se plaindre, jugea-t-il."
                            }
                        ]
                    }
