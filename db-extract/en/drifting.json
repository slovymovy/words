    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "6f103724-7e46-3bd5-b6d6-2703d49e30d8",
                "word": "drifting",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5fc28faf-ffce-3b39-abd2-c498c8d91391",
                        "entry_id": "6f103724-7e46-3bd5-b6d6-2703d49e30d8",
                        "glosses": [
                            "Moving aimlessly or at the mercy of external forces."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "d5da0818-21c9-4a50-afde-328c13fb015a",
                                "sense_id": "5fc28faf-ffce-3b39-abd2-c498c8d91391",
                                "text": "The drifting seaweed went wherever the currents carried it."
                            }
                        ]
                    },
                    {
                        "sense_id": "36be295b-b105-3c47-8235-5f95d5160daf",
                        "entry_id": "6f103724-7e46-3bd5-b6d6-2703d49e30d8",
                        "glosses": [
                            "Without direction, focus, or goal."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "0bed9e50-2a78-4ff2-b457-ddaec5b31e7d",
                                "sense_id": "36be295b-b105-3c47-8235-5f95d5160daf",
                                "text": "[Lionel] Johnson was stern by nature, strong by intellect, and always, I think, deliberately picked his company, but [Ernest] Dowson seemed gentle, affectionate, drifting."
                            },
                            {
                                "example_id": "9605e01e-41df-41de-b113-7d91fcf9f0b2",
                                "sense_id": "36be295b-b105-3c47-8235-5f95d5160daf",
                                "text": "There is nothing more expressive of a barbarous and stupid lack of culture than the half-unconscious attitude so many of us slip into, of taking for granted, when we see weak, neurotic, helpless, drifting, unhappy people, that it is by reason of some special merit in us or by reason of some especial favour towards us that the gods have given us an advantage over such persons."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "424dcf6b-061a-3c02-8f80-0e02d3165416",
                "word": "drifting",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a5413107-e6b8-44c1-adfb-c975a5903347",
                        "entry_id": "424dcf6b-061a-3c02-8f80-0e02d3165416",
                        "tags": [
                            "plural"
                        ],
                        "form": "driftings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8610f36b-0302-3179-bee3-1654ce4615a3",
                        "entry_id": "424dcf6b-061a-3c02-8f80-0e02d3165416",
                        "glosses": [
                            "The act by which something drifts."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "61d689cb-766d-4d1e-9240-2e85f50e3bdd",
                                "sense_id": "8610f36b-0302-3179-bee3-1654ce4615a3",
                                "text": "True, there had been some heavy falls of snow and some of the roads had become blocked, while north of Inverness there was drifting that held up traffic here and there, but things were no worse than are expected in January."
                            },
                            {
                                "example_id": "09ec68b3-0a9f-4b4d-96ac-505226636e92",
                                "sense_id": "8610f36b-0302-3179-bee3-1654ce4615a3",
                                "text": "Still, she did not regret him, for nothing Ernest could have given her would have equalled the delight of those romantic driftings on the lake with Eden."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae08aaa4-c6ec-31b6-abb8-9b1ede3207a6",
                        "entry_id": "424dcf6b-061a-3c02-8f80-0e02d3165416",
                        "glosses": [
                            "That which drifts."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "706630fa-6806-48e6-ac23-258431c84f74",
                                "sense_id": "ae08aaa4-c6ec-31b6-abb8-9b1ede3207a6",
                                "text": "[W]ith hollow eyes / Many all day in dazzling river stood, / To take the rich-ored driftings of the flood."
                            }
                        ]
                    },
                    {
                        "sense_id": "a797ff08-3bcb-3801-9074-bf4437c3b3f0",
                        "entry_id": "424dcf6b-061a-3c02-8f80-0e02d3165416",
                        "glosses": [
                            "A driving technique where the driver intentionally oversteers, causing loss of traction in the rear wheels, while maintaining control from entry to exit of a corner."
                        ],
