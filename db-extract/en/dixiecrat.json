                    {
                        "sense_id": "21dd8228-067c-3e1a-a950-58777d604820",
                        "entry_id": "ea365d5a-5ad7-365a-87b9-284a93965ef2",
                        "glosses": [
                            "A member of the Democratic Party of the United States of America from the southern States, especially one of the former territories of the Confederate States of America, who hold socially conservative viewpoints, and supports racial segregation and white power."
                        ],
                        "tags": [
                            "US",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "6d8befa9-541a-4598-960a-8eefc84a536a",
                                "sense_id": "21dd8228-067c-3e1a-a950-58777d604820",
                                "text": "A Dixiecrat is nothing but a Democrat in disguise."
                            }
                        ]
                    },
                    {
                        "sense_id": "dfa1040c-173c-350b-982e-3105b2243be0",
                        "entry_id": "ea365d5a-5ad7-365a-87b9-284a93965ef2",
                        "glosses": [
                            "A member of the short-lived States' Rights Democratic Party of the United States of America."
                        ],
                        "tags": [
                            "US",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "da60e5a7-c3c6-44d6-8020-8c92024f06a3",
                                "sense_id": "dfa1040c-173c-350b-982e-3105b2243be0",
                                "text": "Throughout the controversy, most prominent southern leaders stayed within the Democratic Party. After the election, the Dixiecrat movement evaporated. The South's vocal dissent in 1948, however, forecast the sectional unrest of the following decades, weakened the region's loyalty to the Democratic Party, and prepared the way for future political realignment."
                            }
                        ]
                    }
