                "translations": [
                    {
                        "translation_id": "000a813c-a7f7-4e09-a0ff-746be4c7d288",
                        "source_entry_id": "abb0ad27-d48a-3616-8f30-aaf261b37d13",
                        "source_sense_id": "a077282e-a6e5-30f1-b664-022936c5315a",
                        "target_lang_word": "ceiling",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ceiling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95f9ea7f-ef6e-38f4-bce0-cdb3068d360a",
                                        "entry_id": "10e377c3-5d62-34a5-8225-e26b1cd671aa",
                                        "glosses": [
                                            "The overhead closure of a room."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75396d4c-bc20-4cc6-bdbf-41041c2d01a3",
                                                "sense_id": "95f9ea7f-ef6e-38f4-bce0-cdb3068d360a",
                                                "text": "The dining room had an ornate ceiling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4f60cfe-c76d-3583-a985-e7ed4399b605",
                                        "entry_id": "10e377c3-5d62-34a5-8225-e26b1cd671aa",
                                        "glosses": [
                                            "The upper limit of an object or action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a37272a-3f52-44e3-b63d-00e3f411e85b",
                                                "sense_id": "f4f60cfe-c76d-3583-a985-e7ed4399b605",
                                                "text": "[…] and only at Barnet did Tappin give Empire of India a burst to bring us up to the 60 m.p.h. speed ceiling of the London area."
                                            },
                                            {
                                                "example_id": "fe454a02-0334-45ee-bb16-19466de4de0a",
                                                "sense_id": "f4f60cfe-c76d-3583-a985-e7ed4399b605",
                                                "text": "Market forces naturally move the economy to the equilibrium, and the price ceiling has no effect on the price or the quantity sold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60a6baa5-2fe3-3007-9546-3436d21e8ef0",
                                        "entry_id": "10e377c3-5d62-34a5-8225-e26b1cd671aa",
                                        "glosses": [
                                            "The highest altitude at which an aircraft can safely maintain flight."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5a4bb3d2-9ccc-3387-9b3f-dc4cbca12c2b",
                                        "entry_id": "10e377c3-5d62-34a5-8225-e26b1cd671aa",
                                        "glosses": [
                                            "The measurement of visible distance from ground or sea level to an overcast cloud cover; under a clear sky, the ceiling measurement is identified as \\\"unlimited.\\"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8aa8cf50-7d13-400f-971f-6cc5f7d91e0d",
                                                "sense_id": "5a4bb3d2-9ccc-3387-9b3f-dc4cbca12c2b",
                                                "text": "Even though it was cloudy, there was still enough ceiling for the Blue Angels to perform a great show."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "122e1e5c-cf5b-3a13-be57-b4131db4fcf6",
                                        "entry_id": "10e377c3-5d62-34a5-8225-e26b1cd671aa",
                                        "glosses": [
                                            "The smallest integer greater than or equal to a given number."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f54cd77f-b258-4af0-8e0e-b61f6fb4741a",
                                                "sense_id": "122e1e5c-cf5b-3a13-be57-b4131db4fcf6",
                                                "text": "The ceiling of 4.5 is 5; the ceiling of −4.5 is −4."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0223b490-cb8b-377b-9766-73e008de189b",
                                        "entry_id": "10e377c3-5d62-34a5-8225-e26b1cd671aa",
                                        "glosses": [
                                            "The inner planking of a vessel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f079061-7f26-383e-97d0-d97dd8c9e25b",
                                        "entry_id": "10e377c3-5d62-34a5-8225-e26b1cd671aa",
                                        "glosses": [
                                            "The maximum permitted level in a financial transaction."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "62ba9ebf-c114-365a-9473-043a841615c5",
                                        "entry_id": "10e377c3-5d62-34a5-8225-e26b1cd671aa",
                                        "glosses": [
                                            "The overhead interior surface that covers the upper limits of a room."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
