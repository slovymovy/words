                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d9e96b7-d06d-414f-96c0-5acdf5dd3bda",
                                "sense_id": "c47ddebc-ec43-3558-9129-dca4c81b4015",
                                "text": "„Die Idee dahinter: Die Ministerin hofft, Österreich werde als Fluchtziel an Attraktivität verlieren, wenn sich herumspräche, dass Antragsteller hier lange schmoren müssen, bevor über ihr Schicksal entschieden wird. So, sagt die Ressortchefin, lasse sich der \"Asyl-Express stoppen\".“"
                            },
                            {
                                "example_id": "48f54926-633b-400e-8ade-a5d0993d4b90",
                                "sense_id": "c47ddebc-ec43-3558-9129-dca4c81b4015",
                                "text": "„Ihre Fluchtziele heißen jetzt: Danzig und Gotenhafen.“"
                            },
                            {
                                "example_id": "12745dcd-a497-40ed-8a65-58718df830f1",
                                "sense_id": "c47ddebc-ec43-3558-9129-dca4c81b4015",
                                "text": "„Manche Flüchtlinge brachen am Fluchtziel zusammen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
