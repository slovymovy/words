                    {
                        "translation_id": "46cb0928-11d4-468b-96ea-583308093712",
                        "source_entry_id": "bedaa30a-1b01-3c96-ba9b-8ff33b7c98da",
                        "source_sense_description": "to dirty",
                        "target_lang_word": "salir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "daf85d0c-ace8-38b4-8f57-c9c56938aa6b",
                                        "entry_id": "bf05b55f-fdf3-3fd2-ab4a-2ffcb48b5737",
                                        "glosses": [
                                            "Rendre sale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9baff623-39b5-4364-b6a3-8498336d7d69",
                                                "sense_id": "daf85d0c-ace8-38b4-8f57-c9c56938aa6b",
                                                "text": "Prenez garde de ne pas salir ce plancher."
                                            },
                                            {
                                                "example_id": "293ed8a3-3a93-47ec-b935-238dff64443c",
                                                "sense_id": "daf85d0c-ace8-38b4-8f57-c9c56938aa6b",
                                                "text": "Je me suis sali les mains à manier des livres pleins de poussière."
                                            },
                                            {
                                                "example_id": "2eb42bd2-725a-41e9-bc8a-42ff04898c12",
                                                "sense_id": "daf85d0c-ace8-38b4-8f57-c9c56938aa6b",
                                                "text": "Cet enfant s’est sali."
                                            },
                                            {
                                                "example_id": "8daac451-9edb-4ac7-8601-f12e1107575d",
                                                "sense_id": "daf85d0c-ace8-38b4-8f57-c9c56938aa6b",
                                                "text": "Les étoffes blanches se salissent vite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3f16f6d-cc22-3402-a9a3-2f4911a47a8b",
                                        "entry_id": "bf05b55f-fdf3-3fd2-ab4a-2ffcb48b5737",
                                        "glosses": [
                                            "Présenter à l’imagination des idées déshonnêtes."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24d11923-65bb-4841-b5de-744d5823d782",
                                                "sense_id": "d3f16f6d-cc22-3402-a9a3-2f4911a47a8b",
                                                "text": "Ce conte, cette description salit l’imagination."
                                            },
                                            {
                                                "example_id": "f553b51d-0021-41e9-98f0-3aaffa3a4cda",
                                                "sense_id": "d3f16f6d-cc22-3402-a9a3-2f4911a47a8b",
                                                "text": "Quoi que dise la directive eCommerce, il n’y a quasiment plus rien qui relève de l’exercice de la liberté d’expression sur les plateformes centralisées lucratives, sinon une grotesque parodie qui salit le nom même de la liberté et nous en fait peu à peu perdre jusqu’au sens !"
                                            },
                                            {
                                                "example_id": "55b4259e-d2b4-4ba9-b14f-73cdafe3e25d",
                                                "sense_id": "d3f16f6d-cc22-3402-a9a3-2f4911a47a8b",
                                                "text": "S’il reste aux républicains un brin ou deux de décence, ils exprimeront ouvertement leur désaveu pour l’homme indigne qui salit sa fonction et bafoue les règles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4da162f6-498e-3a35-97c0-8e1bd7774621",
                                        "entry_id": "bf05b55f-fdf3-3fd2-ab4a-2ffcb48b5737",
                                        "glosses": [
                                            "Déshonorer quelqu’un par des propos, par des calomnies."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d712609e-82a1-4dba-bc47-ff4d70942166",
                                                "sense_id": "4da162f6-498e-3a35-97c0-8e1bd7774621",
                                                "text": "Salir quelqu’un, salir la réputation de quelqu’un."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "278c9d27-85b8-3326-8843-8e2e3d0eb178",
                                        "entry_id": "bf05b55f-fdf3-3fd2-ab4a-2ffcb48b5737",
                                        "glosses": [
                                            "Se dit d’un homme qui a fait quelque action nuisible à sa réputation."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7572a83a-dcdc-4576-91ce-241c2467b7c0",
                                                "sense_id": "278c9d27-85b8-3326-8843-8e2e3d0eb178",
                                                "text": "En agissant de cette sorte, il s’est sali."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02cfdff6-e615-3b9b-b535-7b394763798f",
                                        "entry_id": "bf05b55f-fdf3-3fd2-ab4a-2ffcb48b5737",
                                        "glosses": [
                                            "Se couvrir d’adventices, d’acrû, de plantes indésirables."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa38a3b7-75d0-4747-9d18-8a1f3b33feff",
                                                "sense_id": "02cfdff6-e615-3b9b-b535-7b394763798f",
                                                "text": "Une fois les peuplements ouverts et en l’absence de semis, le parterre des coupes se « salit » (colonisation par les graminées, par les rejets de taillis…) et, peu de temps après, le terrain devient impropre à la germination des glands."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
