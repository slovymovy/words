    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c5e65a9a-86da-31e2-b899-d5997d66caf0",
                    "sense_definition": "Qui ne prête pas attention à ce qu'il fait ou entend ; inattentif.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "inattention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Paul est souvent très <w>distrait</w> lorsqu'il écoute les explications du professeur en classe."
                        },
                        {
                            "text": "Elle marchait d'un pas rapide, tellement <w>distraite</w> par ses pensées qu'elle ne m'a pas salué."
                        }
                    ],
                    "synonyms": [
                        "inattentif",
                        "étourdi"
                    ],
                    "antonyms": [
                        "attentif",
                        "concentré"
                    ]
                },
                {
                    "sense_id": "bdd25288-c48b-338f-867d-083ed96f523f",
                    "sense_definition": "Qui manifeste ou dénote un manque d'attention ou de présence d'esprit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inattention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a jeté un regard <w>distrait</w> sur les documents posés sur son bureau avant de répondre."
                        },
                        {
                            "text": "Elle a répondu à ma question d'un air <w>distrait</w>, tout en continuant à taper son message."
                        }
                    ],
                    "synonyms": [
                        "vague",
                        "absent"
                    ],
                    "antonyms": [
                        "attentif"
                    ],
                    "common_phrases": [
                        "d'un air distrait",
                        "un regard distrait",
                        "d'un geste distrait"
                    ]
                }
            ]
        },
        {
