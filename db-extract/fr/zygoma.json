                "senses": [
                    {
                        "sense_id": "35c017e7-9284-31c5-8a07-32466113c4e6",
                        "entry_id": "3f12d397-964c-3c9a-8e9c-128bc12e7579",
                        "glosses": [
                            "Os de la pommette de la joue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc363220-4e81-442f-9339-d41df4ce472b",
                                "sense_id": "35c017e7-9284-31c5-8a07-32466113c4e6",
                                "text": "Au côté externe et inférieur des orbites sont deux petits os, nommés zygomas, d’une forme assez irrégulière, applatis et légèrement convexes en dehors."
                            },
                            {
                                "example_id": "6c5130dc-f213-4ac4-8e74-8d31c8b554f2",
                                "sense_id": "35c017e7-9284-31c5-8a07-32466113c4e6",
                                "text": "Sur son zygoma gauche protubérant courait une mince cicatrice qui absorbait la lumière en un trait rectiligne et maquillait le jeune homme d’une coquetterie d’automate. — (Robert Darvel, L’Homme qui traversa la Terre, Les Moutons électriques, 2016, page 37.)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "969d962f-e8ef-4467-a91c-3254391f7cc1",
                        "source_entry_id": "3f12d397-964c-3c9a-8e9c-128bc12e7579",
                        "source_sense_id": "35c017e7-9284-31c5-8a07-32466113c4e6",
                        "source_sense_description": "Os",
                        "target_lang_word": "Jochbein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jochbein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64c4c4de-b6a3-3b54-9ee9-d9b508db4d64",
                                        "entry_id": "84032bdf-6f32-3510-9795-c92e116cfe8a",
                                        "glosses": [
                                            "Knochen des Gesichtsschädels, der den Oberkiefer mit dem Schläfenbein verbindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "528fbca2-5c8c-4de5-b079-71e2361fca80",
                                                "sense_id": "64c4c4de-b6a3-3b54-9ee9-d9b508db4d64",
                                                "text": "„Miroslav Klose hat anstatt des zunächst befürchteten erneuten Bruchs nur eine Prellung am Jochbein erlitten.“"
                                            },
                                            {
                                                "example_id": "b22d54c4-006a-4290-b4e9-bc8a97c145de",
                                                "sense_id": "64c4c4de-b6a3-3b54-9ee9-d9b508db4d64",
                                                "text": "„Da kam bei Brokdorf ein Polizist vom Bremer Sondereinsatzkommando noch glimpflich davon. Einen ‚plötzlichen heftigen Druck am Kopf‘ spürte der Uniformierte: Eine Stahlkugel hatte – knapp am Auge vorbei – sein Jochbein zertrümmert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
