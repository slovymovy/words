                "senses": [
                    {
                        "sense_id": "0ba6c0f9-ce7b-3879-ab72-28b26cf542f1",
                        "entry_id": "1ca739b9-dc90-3c1a-a712-c8ddb8b6ef8a",
                        "glosses": [
                            "Qui permet de cribler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb12fe74-0b07-4a85-80b7-e8d49618d4aa",
                                "sense_id": "0ba6c0f9-ce7b-3879-ab72-28b26cf542f1",
                                "text": "Le bon blé sortant du cylindre cribleur est conduit directement aux meules, soit par des conduits inclinés, soit par des vis d’Archimède à palettes en tôle ou en bois, …."
                            },
                            {
                                "example_id": "3de51137-e03f-46f7-82ad-f4f2a7c4c76e",
                                "sense_id": "0ba6c0f9-ce7b-3879-ab72-28b26cf542f1",
                                "text": "Un godet cribleur est un équipement qui se fixe sur un porteur (minipelle, pelle hydraulique, télescopique, chargeuse…) et qui permet de traiter différents types de matériaux et déchets de chantier directement sur site. Ces matériaux vont être criblés et séparés pour obtenir une granulométrie précise permettant de valoriser le matériau en sortie."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "3f2e209f-47b3-30a4-bd6a-247cc1d06521",
