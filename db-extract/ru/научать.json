                "senses": [
                    {
                        "sense_id": "c3c49bb0-b846-3ee8-b795-89c7a26d12e7",
                        "entry_id": "99250401-1c2b-3d09-a4d5-2e2a5298c57c",
                        "glosses": [
                            "учить, передавать знания"
                        ],
                        "tags": [],
