                                "target_senses": [
                                    {
                                        "sense_id": "dff27ae4-1409-3d07-89cd-718637f7e373",
                                        "entry_id": "443630e6-2644-38b9-af77-08a9076552ba",
                                        "glosses": [
                                            "Suited to various types of terrain."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86accb72-6619-4996-8511-36ffd3030556",
                                                "sense_id": "dff27ae4-1409-3d07-89cd-718637f7e373",
                                                "text": "Armatures are quadruped all-terrain heavy weapons platforms, akin to the armored fighting vehicles of other races. Geth being synthetic intelligences, armatures are not crewed vehicles, but intelligent entities, capable of independent decision-making and learning."
                                            },
                                            {
                                                "example_id": "3e5113a9-9f72-4f38-911a-cefb79d96df2",
                                                "sense_id": "dff27ae4-1409-3d07-89cd-718637f7e373",
                                                "text": "the final assembly of which occurs in the U.S. For the purposes of the deduction, an applicable passenger vehicle also includes all-terrain vehicles and recreational vehicles which the final assembly of which occurs in the U.S. The deduction is allowed from tax years 2025 through 2028."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
