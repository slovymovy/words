                        {
                            "text": "Having completed the sacred ceremony, the young man was recognized as a <w>kipper</w>.",
                            "target_lang_translations": {
                                "ru": "После завершения священного обряда юноша был признан <w>полноправным мужчиной</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Australia"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "Historical anthropological usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Молодой австралийский абориген, прошедший обряд посвящения во взрослую жизнь."
