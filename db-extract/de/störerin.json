                        "sense_id": "98ef1ccc-7f22-332f-9296-a12f25cb86fb",
                        "entry_id": "7e2361e9-d00d-3925-96ec-23705e8e6008",
                        "glosses": [
                            "weibliche Person, die durch ihr Verhalten etwas beeinträchtigt (stört)"
                        ],
