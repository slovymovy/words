    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fd72ebad-c458-3b18-b676-dee2d304be31",
                    "sense_definition": "Relating to the process, art, or equipment of taking photographs.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "photography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local shop stocks all the latest <w>photographic</w> equipment for professional artists.",
                            "target_lang_translations": {
                                "ru": "В местном магазине представлено всё новейшее <w>фотографическое</w> оборудование для профессиональных художников."
                            }
                        },
                        {
                            "text": "She decided to pursue a <w>photographic</w> career after winning a national competition.",
                            "target_lang_translations": {
                                "ru": "Она решила продолжить <w>фотографическую</w> карьеру после победы в национальном конкурсе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "photographic equipment",
                        "photographic film",
                        "photographic career",
                        "photographic studio"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к процессу, искусству или оборудованию для создания фотографий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фотографический",
                                "target_lang_sense_clarification": "связанный с техникой или процессом"
                            },
                            {
                                "target_lang_word": "фото-",
                                "target_lang_sense_clarification": "в качестве приставки для оборудования или деятельности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "397d30a8-62a0-3ff6-b33e-43c709f097c5",
                    "sense_definition": "Extremely detailed and <w>accurate</w>, resembling the precision of a photograph.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "accuracy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has a <w>photographic</w> memory and can recall every page of the book perfectly.",
                            "target_lang_translations": {
                                "ru": "У него <w>фотографическая</w> память, и он может в совершенстве вспомнить каждую страницу книги."
                            }
                        },
                        {
                            "text": "The witness provided a <w>photographic</w> account of the events that happened that night.",
                            "target_lang_translations": {
                                "ru": "Свидетель представил <w>фотографически</w> точный отчет о событиях, произошедших той ночью."
                            }
                        }
                    ],
                    "synonyms": [
                        "accurate"
                    ],
                    "antonyms": [
                        "inaccurate",
                        "vague"
                    ],
                    "common_phrases": [
                        "photographic memory",
                        "photographic detail",
                        "photographic reproduction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно детальный и точный, напоминающий точность фотографии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фотографический",
                                "target_lang_sense_clarification": "о памяти или точности воспроизведения"
                            },
                            {
                                "target_lang_word": "феноменальный",
                                "target_lang_sense_clarification": "в контексте исключительной памяти"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}