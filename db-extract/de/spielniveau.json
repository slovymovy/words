                ],
                "senses": [
                    {
                        "sense_id": "b6faea8f-682e-3063-acef-0d143c562ef1",
                        "entry_id": "86303252-ec48-3994-a40f-d8d37036e8d3",
                        "glosses": [
                            "Leistungsebene im Spielbereich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4546aa98-5bf0-482b-9c77-d82f8e460d32",
                                "sense_id": "b6faea8f-682e-3063-acef-0d143c562ef1",
                                "text": "„Das Friedensspiel stellt nur geringe technische und taktische Ansprüche; von einem bestimmten Spielniveau an wird es für die Spielenden uninteressant.“"
                            },
                            {
                                "example_id": "643ff8b5-0126-45df-bb69-0eea1eb6a7b2",
                                "sense_id": "b6faea8f-682e-3063-acef-0d143c562ef1",
                                "text": "„Im ersten Analyseschritt wurde das Spielniveau des Kindes erfasst, vom einfachen Hantieren mit den Steinen ohne ersichtliches Ziel über das symbolische Spiel bis zur Verwendung abstrakter Begriffe wie Farbe, Form und Menge.“"
                            },
                            {
                                "example_id": "0093cf7e-61a7-4423-a1c1-b9c23f644905",
                                "sense_id": "b6faea8f-682e-3063-acef-0d143c562ef1",
                                "text": "„Wie geht man als Trainer mit diesen unterschiedlichen Spielniveaus um? Für einen guten Trainer sollte es immer das Ziel sein, die Lücken im Spielniveau durch sein Training zu schließen.“"
                            },
                            {
                                "example_id": "be3a61d7-885b-4b95-b58a-76e0cc01a69a",
                                "sense_id": "b6faea8f-682e-3063-acef-0d143c562ef1",
                                "text": "„Ein Golfprofi verfügt in der Regel über ein außergewöhnliches Spielniveau und kann auf einen umfangreichen Erfahrungsschatz zurückgreifen, gleichbedeutend mit der Fähigkeit, Golf auch erfolgreich anderen Menschen beibringen zu können, ist dies jedoch nicht, sagt Hasenbein.“"
                            },
                            {
                                "example_id": "1512ffbf-bded-46cf-b78a-176d1dc77075",
                                "sense_id": "b6faea8f-682e-3063-acef-0d143c562ef1",
                                "text": "„Anders als Zverev erreichte der Ausnahmekönner aus Basel nicht sein gewohnt druckvolles Spielniveau.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
