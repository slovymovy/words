                    "sense_id": "0a97ce43-bd82-3ae7-824f-2221c533bfca",
                    "sense_definition": "Elke keer dat iets gebeurt.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "frequency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Telkens</w> als je dit plein oversteekt, word je door al die verkopers aangesproken.",
                            "target_lang_translations": {
                                "en": "<w>Every time</w> you cross this square, you get approached by all those vendors.",
                                "ru": "<w>Каждый раз</w>, когда ты переходишь эту площадь, к тебе обращаются все эти продавцы.",
                                "fr": "<w>Chaque fois que</w> tu traverses cette place, tous ces vendeurs t'abordent."
                            }
                        },
                        {
                            "text": "Ik nam me <w>telkens</w> voor om meer te rusten, maar het kwam er niet van.",
                            "target_lang_translations": {
                                "en": "I resolved <w>each time</w> to rest more, but it never happened.",
                                "ru": "Я <w>каждый раз</w> собирался больше отдыхать, но из этого ничего не выходило.",
                                "fr": "Je me promettais <w>à chaque fois</w> de me reposer plus, mais cela ne se faisait pas."
                            }
                        }
                    ],
                    "synonyms": [
                        "telkenmale",
                        "iedere keer",
                        "elke keer"
                    ],
                    "common_phrases": [
                        "telkens als",
                        "telkens weer"
                    ],
                    "target_lang_definitions": {
                        "en": "Every time that something happens.",
                        "ru": "Каждый раз, когда что-то происходит.",
                        "fr": "Chaque fois que quelque chose se produit."
                    },
