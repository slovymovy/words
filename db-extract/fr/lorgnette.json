                            {
                                "example_id": "59c10d50-2042-4aae-b795-c0defb7a873b",
                                "sense_id": "81e673c2-83f1-35b6-bd5b-ca644785cd08",
                                "text": "Au théâtre, nous occuperions une loge. En me penchant, je pourrais toucher le rideau. De toute la salle, on nous observerait, avec des lorgnettes.",
                                "translation": "At the theatre, we would have a box. If I leant over, I would be able to touch the curtain. The whole auditorium would watch us through lorgnettes.",
                                "english": "At the theatre, we would have a box. If I leant over, I would be able to touch the curtain. The whole auditorium would watch us through lorgnettes."
                            }
                        ]
