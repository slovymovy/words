                "translations": [
                    {
                        "translation_id": "9ce54609-d645-4118-a6f6-0f295af84311",
                        "source_entry_id": "34864d86-c7b2-3ec9-9181-8b9977237f5f",
                        "source_sense_id": "9562d430-83d5-385e-a11d-ccfc1bb498e9",
                        "target_lang_word": "überlisten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "überlisten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f04c7ec8-9331-34e3-bce1-2597f2ce7a60",
                                        "entry_id": "016a265e-1797-304e-91cf-55a55d38e20e",
                                        "glosses": [
                                            "jemanden hintergehen, mit einer List täuschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d7c03fb-509e-4d78-863f-8a92489c71cf",
                                                "sense_id": "f04c7ec8-9331-34e3-bce1-2597f2ce7a60",
                                                "text": "„Beim Fliegen überlistet der Pilot mittels seines Verstandes die Natur, die ihn körperlich nicht zum Fliegen geschaffen hat.“"
                                            },
                                            {
                                                "example_id": "1cc522c8-29d5-4fd4-8157-bc939edde961",
                                                "sense_id": "f04c7ec8-9331-34e3-bce1-2597f2ce7a60",
                                                "text": "Ich schäme mich dafür, dass mich der Betrüger so frech überlisten konnte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3671d75f-0ab3-44cf-a2f5-a8aa4f14c335",
                        "source_entry_id": "34864d86-c7b2-3ec9-9181-8b9977237f5f",
                        "source_sense_id": "9562d430-83d5-385e-a11d-ccfc1bb498e9",
                        "target_lang_word": "austricksen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "austricksen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "02fab8a3-2180-3604-b603-e1482b8cb341",
                                        "entry_id": "3c42b93b-666f-3190-af67-67370c721586",
                                        "glosses": [
                                            "jemanden durch Anwendung einer List (Trick) übervorteilen, ein technisches Gerät durch Anwendung eines Tricks zu der gewünschten Leistung bringen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6f4ab29-485f-448e-a0c7-2acd4e01bf19",
                                                "sense_id": "02fab8a3-2180-3604-b603-e1482b8cb341",
                                                "text": "Ich habe mich von meiner Kollegin austricksen lassen. Jetzt hat sie die Vertragsverlängerung und nicht ich."
                                            },
                                            {
                                                "example_id": "ceb806a6-5558-46a8-a74b-70b48511badb",
                                                "sense_id": "02fab8a3-2180-3604-b603-e1482b8cb341",
                                                "text": "So können Sie den Kopierschutz austricksen und sich eine Sicherheitskopie anlegen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c4d4c54e-4af1-3fa7-be0d-c96fbb598eea",
                                        "entry_id": "3c42b93b-666f-3190-af67-67370c721586",
                                        "glosses": [
                                            "einen Gegenspieler geschickt (trickreich, mit Tricks) in die Irre führen und so einen Vorteil gewinnen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6b2d77b-f495-41a6-a6a9-e41a304f7d7f",
                                                "sense_id": "c4d4c54e-4af1-3fa7-be0d-c96fbb598eea",
                                                "text": "Sie trickste ihre Gegnerin geschickt aus und gewann den Tie-Break mit 7:6."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
