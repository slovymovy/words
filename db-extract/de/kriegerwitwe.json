                "senses": [
                    {
                        "sense_id": "61547c55-950e-3306-a045-12b02d49bd1e",
                        "entry_id": "e18b7a58-312c-3981-8517-b13a87ec608a",
                        "glosses": [
                            "Frau, deren Ehegatte, ein Soldat, im Krieg gefallen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54f81fae-edb0-45a6-80f2-afc050bd9ff2",
                                "sense_id": "61547c55-950e-3306-a045-12b02d49bd1e",
                                "text": "„Koaliks Anna iat eine dürre Kriegerwitwe.“"
                            },
                            {
                                "example_id": "357acf98-7d8b-4a21-9c16-a6f4bc101e5e",
                                "sense_id": "61547c55-950e-3306-a045-12b02d49bd1e",
                                "text": "„Es entstanden große Wohnsiedlungen mit modernen sanitären Anlagen und Elektrizität, vor allem für kinderreiche Familien, Kriegsinvaliden und Kriegerwitwen.“"
                            },
                            {
                                "example_id": "fad6cf80-e67a-47d2-b865-b0d3b4d1e492",
                                "sense_id": "61547c55-950e-3306-a045-12b02d49bd1e",
                                "text": "„Glück im Unglück, daß Mutter als Kriegerwitwe mit zwei kleinen Kindern bevorzugt in jenen Personenzug gesetzt worden war, der als letzter fahrplanmäßig die Stadt Danzig verließ und tatsächlich fahrplanmäßig ankam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
