                ],
                "senses": [
                    {
                        "sense_id": "a7cd981a-4d5d-300e-8048-d420f27e6777",
                        "entry_id": "b8a8bc15-4838-3062-ac53-de6c2f7b4b91",
                        "glosses": [
                            "das Verschlingen einer Galaxie durch eine andere"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "749dac98-b8b7-4eb1-a289-5850cb8ff877",
                                "sense_id": "a7cd981a-4d5d-300e-8048-d420f27e6777",
                                "text": "„Zwerggalaxien treten häufig als Satelliten großer Milchstraßensysteme auf, von denen sie schlussendlich einverleibt werden – gewissermaßen eine Art Galaxienkannibalismus.“"
                            },
                            {
                                "example_id": "1dca9f71-1791-4632-95ae-8e5916a35e23",
                                "sense_id": "a7cd981a-4d5d-300e-8048-d420f27e6777",
                                "text": "„Man kann lernen, wie die Milchstraße aufgebaut ist. Diese Scheibengalaxie besteht ja vermutlich aus vielen kleinen Galaxien, die verschluckt wurden. Es gibt Galaxienkannibalismus.“"
                            },
                            {
                                "example_id": "65283322-8856-4941-84d5-f68b29622dc3",
                                "sense_id": "a7cd981a-4d5d-300e-8048-d420f27e6777",
                                "text": "„Wenn wir die Vorgänge im All betrachten, zeigt sich schnell, dass wir im Grunde jeden Materieaustausch und jede Umsetzung als »Kannibalismus« betrachten könnten, der auf kleinster Ebene beginnt, zum Beispiel bei mikroskopischen Meteoriten, die wegen des so genannten Pointing-Robertson-Effektes relativ schnell auf Spiralbahnen in die Sonne stürzen, über Ereignisse auf planetarer Ebene - beispielsweise dem Sturz von Komet Shoemaker-Levy 9 in den Jupiter - bis hin zu Galaxienkannibalismus.“"
                            },
                            {
                                "example_id": "e47ded3f-509a-4808-bc93-cb36c4b7b4b1",
                                "sense_id": "a7cd981a-4d5d-300e-8048-d420f27e6777",
                                "text": "„Das Universum schien ein gewalttätiger Ort zu sein, wo es immer wieder zu Zusammenstößen, Galaxienkannibalismus und Galaxienverschmelzungen kam.“"
                            },
                            {
                                "example_id": "37ddb0ee-fec8-47e2-900a-5e7cb2eaef0c",
                                "sense_id": "a7cd981a-4d5d-300e-8048-d420f27e6777",
                                "text": "„NGC 3314 steht im Hydragalaxienhaufen. Dort projizieren sich zwei Galaxien übereinander, was aber kein Beispiel für Galaxienkannibalismus darstellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
