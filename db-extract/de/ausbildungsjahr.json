                "senses": [
                    {
                        "sense_id": "c026781f-3a80-31f3-91b8-3e19494175df",
                        "entry_id": "16aedd93-5ca5-3e12-bfd7-3008fa21122c",
                        "glosses": [
                            "Zeitraum eines Jahres, in dem ein Beruf meist in einem Betrieb und in der Berufsschule erlernt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff87b201-4537-4eff-baff-b3c3ae95f330",
                                "sense_id": "c026781f-3a80-31f3-91b8-3e19494175df",
                                "text": "„Trotzdem hat er ein Problem: Wenn das Ausbildungsjahr am 1. September beginnt, fehlen ihm vier Leute – zwei in der Küche und zwei im Restaurant.“"
                            },
                            {
                                "example_id": "a9c132ea-4a64-41ee-a84b-027cf09dd592",
                                "sense_id": "c026781f-3a80-31f3-91b8-3e19494175df",
                                "text": "„Ein Ausbildungsjahr umfaßt zwölf Monate.“"
                            },
                            {
                                "example_id": "c789b1c9-46a4-4fdd-928d-d496595e2180",
                                "sense_id": "c026781f-3a80-31f3-91b8-3e19494175df",
                                "text": "„Die Jugendlichen können vor allem auf ihr eigenes technisches Wissen setzen: Vom ersten bis zum dritten Ausbildungsjahr helfen die Azubis sich gegenseitig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
