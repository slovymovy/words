                                "example_id": "30c8e401-1a0c-4e41-ba48-a288e8719a21",
                                "sense_id": "bdd14ba5-53da-3575-87cf-b45915fd9075",
                                "text": "„Nach der Inkubationszeit von 2 bis 4 Tagen entstehen Halsschmerzen und Schluckbeschwerden, meist in Kombination mit Fieber über 38 °C und einer Schwellung der Halslymphknoten.“"
                            },
