                        "glosses": [
                            "einzelnes, in sich abgeschlossenes mythologisches Thema oder Motiv"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "350150ee-50e4-4d4a-99ee-a9e3561a2b0e",
                                "sense_id": "669ab9cd-2f15-3393-b702-cf2ec32b41aa",
                                "text": "„Eine Frucht der Empörung Heras gegen Zeus war Hephaistos selbst, ein Sohn, den sie nach Hesiod in Zorn und Wetteifer mit Zeus ohne ihn, aus sich selbst erzeugt und geboren hat, allerdings einen hinkenden und häßlichen, den sie nach einem Mythologem selber von sich geschleudert hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
