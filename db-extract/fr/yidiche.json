                                        "glosses": [
                                            "język Żydów aszkenazyjskich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8f3a233-26d6-417c-ac9a-11d36b400076",
                                                "sense_id": "39579a3b-9c9a-31e6-a16f-14641753e9b9",
                                                "text": "Mówił tylko w jidysz, ale rozumiał też kilka innych języków."
                                            },
                                            {
                                                "example_id": "bf080e72-4633-408c-a877-a847a3c1697e",
                                                "sense_id": "39579a3b-9c9a-31e6-a16f-14641753e9b9",
                                                "text": "Opowieść przy stole toczył po angielsku, my rozmawialiśmy ze sobą po rosyjsku, czasem wstawiałem jakieś popularne powiedzonko w jidysz, co spotykało się z uśmiechem zrozumienia i wdzięczności"
                                            },
                                            {
                                                "example_id": "22380b3a-6700-4af1-9cf4-bc4d395be4a1",
                                                "sense_id": "39579a3b-9c9a-31e6-a16f-14641753e9b9",
                                                "text": "W trzecim okresie swej twórczości literackiej podejmuje pionierską inicjatywę zaadaptowania na grunt polski utworów żydowskich, czym utoruje drogę przyszłym tłumaczom literatury jidysz na język polski oraz tym twórcom, którzy – jak Szaniawski – wprowadzać będą żydowskie wątki i charaktery do literatury rodzimej"
                                            }
                                        ],
