                        "examples": [
                            {
                                "example_id": "f6b4aeb0-3fe2-406b-a136-3efe868ed1b8",
                                "sense_id": "4d722fa3-a731-35b6-bd5c-6e2fc7807475",
                                "text": "Ik ben met mijn vriendinnetje naar een dansfeest gegaan."
                            },
                            {
                                "example_id": "84378952-96ce-48fc-969e-7a431b808a5f",
                                "sense_id": "4d722fa3-a731-35b6-bd5c-6e2fc7807475",
                                "text": "Wat draag je naar je werk? En waarom? Deze week Marian Markelo (62). Als bekendste wintipriesteres van Nederland houdt ze grote muziek- en dansfeesten ter ere van de natuurkrachten. „Ik hoor goed na te denken en ik hoor er goed uit te zien.”"
                            }
                        ]
                    }
