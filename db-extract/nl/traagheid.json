                    {
                        "translation_id": "4ecf97c9-3a33-4e30-b8be-e7ce5fa8df8e",
                        "source_entry_id": "d3a72ab5-f41b-393d-8003-0c8bbbad39ca",
                        "source_sense_id": "31c00b90-f194-3348-8091-df4be524554c",
