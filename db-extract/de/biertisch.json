                "senses": [
                    {
                        "sense_id": "74a8a7c8-ad7c-3e28-a2fe-503cf12eb6d4",
                        "entry_id": "550ad5d0-85c9-3812-848c-d0ad27297b0e",
                        "glosses": [
                            "zur Biergarnitur gehörender, oft klappbarer Tisch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a40ec8a-ef19-4254-82c4-4bb3b088aa05",
                                "sense_id": "74a8a7c8-ad7c-3e28-a2fe-503cf12eb6d4",
                                "text": "„Der Biertisch besteht aus einer hölzernen Tischplatte auf oft lackierten Metallbeinen (früher auch teilweise Holzbeine).“"
                            },
                            {
                                "example_id": "f7394cc8-d410-487b-b08b-c39bd21fd29c",
                                "sense_id": "74a8a7c8-ad7c-3e28-a2fe-503cf12eb6d4",
                                "text": "„Da sitzen wir nun müde in der Dämmerung an einem der Biertische und gehen die Notizen des Tages durch.“"
                            },
                            {
                                "example_id": "d394b980-6178-4377-9d6e-ed07a0dbdca0",
                                "sense_id": "74a8a7c8-ad7c-3e28-a2fe-503cf12eb6d4",
                                "text": "„Und es gibt ein Gedicht von ihm, das die Evolution zum Menschen in der Regression zum grunzenden, auf allen vieren kriechenden Tier beschreibt, nachdem die damalige Darwin-Debatte auf Biertische und Weinabende heruntergekommen war.“"
                            },
                            {
                                "example_id": "0a0576c3-ba9b-4555-9529-cf66812d0107",
                                "sense_id": "74a8a7c8-ad7c-3e28-a2fe-503cf12eb6d4",
                                "text": "„Mochten Adam, Eva (»Heua« bei Luther), Noah und ihr Schöpfer Deutsch gesprochen haben oder nicht, die Priester an den Altären, die Gelehrten auf den Kathedern und die Studenten am Biertisch sprachen Latein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
