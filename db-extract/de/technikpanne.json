                "senses": [
                    {
                        "sense_id": "55f49f39-4ea1-3fa7-8201-630c865ec998",
                        "entry_id": "99618486-d249-399c-9615-eb0c0e253ac1",
                        "glosses": [
                            "Nichtfunktionieren einer technischen Vorrichtung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c677cdf-f80d-4886-acb4-f1a2439d17da",
                                "sense_id": "55f49f39-4ea1-3fa7-8201-630c865ec998",
                                "text": "„Wir wollten wissen, wie man sich als Gastgeber auf einen Podcast vorbereitet und wie man mit Lampenfieber und Technikpannen umgeht.“"
                            },
                            {
                                "example_id": "8bfaf925-17a7-4481-8bc8-e3903b77afc3",
                                "sense_id": "55f49f39-4ea1-3fa7-8201-630c865ec998",
                                "text": "„Es geht aufs Finale zu, alles lief gut, keine Technikpannen, die Anspannung ist weg, nun ist es nur noch der pure Spaß.“"
                            },
                            {
                                "example_id": "cbfecea5-c9a7-44d3-9d71-8d04e8f297b8",
                                "sense_id": "55f49f39-4ea1-3fa7-8201-630c865ec998",
                                "text": "„Wählen Sie sich bereits zehn Minuten vor dem Gespräch in den Videocall ein, um Zeit zu haben, womöglich dennoch auftretende Technikpannen zu beheben.“"
                            },
                            {
                                "example_id": "665fda90-288f-4aa0-b436-98007fc2ca76",
                                "sense_id": "55f49f39-4ea1-3fa7-8201-630c865ec998",
                                "text": "„Ich hatte über die Technikpanne im Büro berichtet, die im Übrigen bis Dienstschluss nicht behoben worden war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
