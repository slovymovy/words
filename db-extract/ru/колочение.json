                                    {
                                        "sense_id": "f6f88b29-e04b-306d-83db-94ac9b7b06e3",
                                        "entry_id": "d120be19-c06a-3fe2-a066-c0c691fd6ba3",
                                        "glosses": [
                                            "Handlung, mit dem Finger oder einem Gegenstand an etwas vernehmlich zu pochen, an etwas zu klopfen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59a6b8d7-afcc-4ff1-89da-00ccd3557ef7",
                                                "sense_id": "f6f88b29-e04b-306d-83db-94ac9b7b06e3",
                                                "text": "„Heftiges Klopfen zerreißt einen unruhigen Schlaf.“"
                                            },
                                            {
                                                "example_id": "97dabdc8-e0a2-4ebe-a2bf-e1e0a3dee564",
                                                "sense_id": "f6f88b29-e04b-306d-83db-94ac9b7b06e3",
                                                "text": "„An der Tür erklang plötzlich ein Klopfen, und ich fuhr zusammen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29acfb43-d671-4e56-a49e-f0c6229f8d57",
                        "source_entry_id": "7dd6b948-6984-3d97-ba77-f2ebcd6ef447",
