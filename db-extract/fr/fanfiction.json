                    }
                ],
                "senses": [
                    {
                        "sense_id": "da6230d1-c368-3d48-842e-a5cda145a49d",
                        "entry_id": "35f60fea-dc86-325d-a5de-db6fec1ee391",
                        "glosses": [
                            "Écrit mettant en scène des personnes célèbres ou des personnages issus d’autres œuvres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f33241d5-5ce7-443d-a40f-6f65aca51c24",
                                "sense_id": "da6230d1-c368-3d48-842e-a5cda145a49d",
                                "text": "Pour les non initiés, la fanfiction est un sous-genre littéraire on ne peut plus démocratique qui a explosé avec Internet. Ses adeptes s’emparent de personnages de fiction pour leur faire vivre d’autres aventures."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e406f50a-87c6-42c9-91e0-4418a0507215",
                        "source_entry_id": "35f60fea-dc86-325d-a5de-db6fec1ee391",
                        "source_sense_id": "da6230d1-c368-3d48-842e-a5cda145a49d",
                        "target_lang_word": "Fan-Fiction",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fan-Fiction",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "844cf678-69b6-3998-8d37-a978af51b0c9",
                                        "entry_id": "91a747e6-bde3-36b6-b290-d156db0de8ad",
                                        "glosses": [
                                            "Literaturgattung, zu der Werke gehören, die von Fans eines Films, einer Fernsehserie, von Büchern, Computerspielen oder dergleichen geschrieben werden und die die Personen und Welten aufgreifen"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b63d8c8-31bb-4c48-b739-ddb9e5bc580f",
                                                "sense_id": "844cf678-69b6-3998-8d37-a978af51b0c9",
                                                "text": "Höchst beliebte Themen der Fan-Fiction sind lebende Stars der Musikbranche wie Harry Stiles und Taylor Swift, nicht nur alles, was einem so zu Harry Potter und Star Trek einfallen könnte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9679f329-6f8c-3a2e-a230-faa70e84b6b5",
                                        "entry_id": "91a747e6-bde3-36b6-b290-d156db0de8ad",
                                        "glosses": [
                                            "Werk, das von Fans eines Films, einer Fernsehserie, von Büchern, Computerspielen oder dergleichen geschrieben wird und das die Personen und Welten aufgreift"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e59cdb3-be73-4976-8acf-232e61c3e2d3",
                                                "sense_id": "9679f329-6f8c-3a2e-a230-faa70e84b6b5",
                                                "text": "Diese Fan-Fiction wird es vermutlich weit bringen: »After« ist eine erotische Trilogie um den Sänger von One Direction, deren Filmrechte Paramount erworben hat."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b7be00f-7dd2-45de-aca7-bdcdb1110254",
                        "source_entry_id": "35f60fea-dc86-325d-a5de-db6fec1ee391",
                        "source_sense_id": "da6230d1-c368-3d48-842e-a5cda145a49d",
                        "target_lang_word": "Fanfiktion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8440256d-ef90-4917-8c94-d7840c59c43a",
                        "source_entry_id": "35f60fea-dc86-325d-a5de-db6fec1ee391",
                        "source_sense_id": "da6230d1-c368-3d48-842e-a5cda145a49d",
                        "target_lang_word": "Fangeschichte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5442d353-b29b-48f3-b86a-8005f95f0a54",
                        "source_entry_id": "35f60fea-dc86-325d-a5de-db6fec1ee391",
                        "source_sense_id": "da6230d1-c368-3d48-842e-a5cda145a49d",
                        "target_lang_word": "fan fiction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fan fiction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a4a7e6c-3dc3-36c6-9d70-e53d3d46300d",
                                        "entry_id": "3b002cc4-4596-3bc0-bbc4-3872a5a3fe0c",
                                        "glosses": [
                                            "Fiction, typically amateur, created by fans, incorporating the characters and concepts of a commercial media property, typically without permission from the author or owner."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a64a6212-892d-4b38-94f9-a0fdf7b2efb2",
                                                "sense_id": "1a4a7e6c-3dc3-36c6-9d70-e53d3d46300d",
                                                "text": "In the latest issue of Astounding, our old pal and brother-fan, Milt Rothman makes his professional debut under the pen name: Lee Gregor. And Milt is to be congratulated on the story.... it is definitely pro and not fan fiction."
                                            },
                                            {
                                                "example_id": "8823ed5e-d34a-4b0f-8cf7-094807a04d0f",
                                                "sense_id": "1a4a7e6c-3dc3-36c6-9d70-e53d3d46300d",
                                                "text": "I also want to put in my two-cents-worth on the subject of fan fiction. There has been a strong trend away from fiction in fanzines of late: SPACEWARP stopped using fan fiction shortly before the end; ORB followed suit; WYLIE STAR will switch; most of the new mags are starting out with non-fiction plans. I think fiction is just as important (if not more so) in fmz as articles. Where else will embryo pro-authors get their start?"
                                            },
                                            {
                                                "example_id": "c706f932-3e64-44ec-b0ff-531b8837ef2f",
                                                "sense_id": "1a4a7e6c-3dc3-36c6-9d70-e53d3d46300d",
                                                "text": "Laura, whose ambition is to become a professional writer, has been writing STAR TREK fiction since her early teens, and was recently nominated for a Hugo Award for fan fiction for her series ‘Federation and Empire’."
                                            },
                                            {
                                                "example_id": "60026b4c-9aa6-4373-aaf1-d45981608cc9",
                                                "sense_id": "1a4a7e6c-3dc3-36c6-9d70-e53d3d46300d",
                                                "text": "Chris Carter may bar X-Filers Mulder and Scully forever from consummating their deep bond—but it's a common fantasy in the archives of fan fiction, where familiar TV and movie characters populate digital poems, scripts, short stories—even full-length novels—that span hundreds of websites and Usenet discussion groups. Readership figures are elusive, but fanfic's America Online index page has collected a half million hits in the past year."
                                            },
                                            {
                                                "example_id": "62d0557e-4526-4628-a9bb-9aae6a77b3d8",
                                                "sense_id": "1a4a7e6c-3dc3-36c6-9d70-e53d3d46300d",
                                                "text": "The acres of Harry Potter fan fiction have allowed its Millennial audience to rewrite the stories to fit their own values, easing their discomfort (while still luxuriating in the nostalgic setting of the British private-school system, an institution designed to perpetuate elitism)."
                                            },
                                            {
                                                "example_id": "64fb4aab-c31a-4649-a89d-fa44dc201033",
                                                "sense_id": "1a4a7e6c-3dc3-36c6-9d70-e53d3d46300d",
                                                "text": "Fan fiction writers are just one group now staging revolts against A.I. systems as a fever over the technology has gripped Silicon Valley and the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "287a5fde-72ae-3ed9-9167-fcb6bddfe807",
                                        "entry_id": "3b002cc4-4596-3bc0-bbc4-3872a5a3fe0c",
                                        "glosses": [
                                            "A work of fan fiction."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7668cf97-b09f-47f6-9b8a-686b03146274",
                                                "sense_id": "287a5fde-72ae-3ed9-9167-fcb6bddfe807",
                                                "text": "This can be, as you note below, quite fun and entertaining, but I do think that it is very easy for people to lose track of the fact that all of these \"speculations\" are just fan fictions that have little to do with what Tolkien actually wrote."
                                            },
                                            {
                                                "example_id": "d396d591-e60c-4819-a356-94c4aab32811",
                                                "sense_id": "287a5fde-72ae-3ed9-9167-fcb6bddfe807",
                                                "text": "An otherwise strong site is marred by some trashy material. Skip the many bad ER fan fictions here and take the rumors section with a huge grain of salt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cfb258a-07d7-3ab3-a1df-9515bf802b17",
                                        "entry_id": "3b002cc4-4596-3bc0-bbc4-3872a5a3fe0c",
                                        "glosses": [
                                            "Fiction about fans and fandom created by members of fandom."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75d5c7d3-25b0-41b3-a399-4503887248cc",
                                                "sense_id": "6cfb258a-07d7-3ab3-a1df-9515bf802b17",
                                                "text": "fan fiction - Sometimes improperly used to mean fan science fiction, that is, ordinary fantasy published in a fan magazine. Properly, the term means fiction about fans, or something about pros, and occasionally bringing in some famous characters stf stories. It may refer to real fans by name (Tucker nudged Brackney, who was nursing a \"black eye\"), or may be about types, especially Joe Fann."
                                            },
                                            {
                                                "example_id": "39101a07-5f9a-45af-8d64-201568efede5",
                                                "sense_id": "6cfb258a-07d7-3ab3-a1df-9515bf802b17",
                                                "text": "Triode specialized in humorous ‘fan fiction’—stories written about actual personalities in the SF field—and dates from the period in which science fiction fans did not take themselves quite so seriously as nowadays, and those who made religion from an enthusiasm were generally mocked for it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7a9b910-7031-4b31-9926-e0ee585f5cc7",
                        "source_entry_id": "35f60fea-dc86-325d-a5de-db6fec1ee391",
                        "source_sense_id": "da6230d1-c368-3d48-842e-a5cda145a49d",
