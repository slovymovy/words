                "senses": [
                    {
                        "sense_id": "a36579d5-0f89-3d69-9127-738a1353f143",
                        "entry_id": "a30a8b34-cabe-3856-8e08-3cd15a7083d8",
                        "glosses": [
                            "An action performed in opposition to another action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11df54b7-1f84-4c73-90d8-6d8ac045771f",
                                "sense_id": "a36579d5-0f89-3d69-9127-738a1353f143",
                                "text": "This flesh and blood of Christ's human body, as the redeeming substance, should have been eaten by man as an act of obedience to the command, 'Take, eat,' &c., as a counteract to the act of disobedience, and as a work meet for repentance."
                            },
                            {
                                "example_id": "51ba7fb0-bc4d-4c01-a0bc-57f397d93445",
                                "sense_id": "a36579d5-0f89-3d69-9127-738a1353f143",
                                "text": "Every time there is a march by the Ku Klux Klan or a swastika painted on a Jewish building, there could be a counteract of reconciliation within twenty-four hours."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
