                "senses": [
                    {
                        "sense_id": "5199dff5-381c-3eac-b67d-702d11b9a33a",
                        "entry_id": "c844f87d-b506-3727-9c93-9dd6d0c82923",
                        "glosses": [
                            "Traiter pour que le lactose présent soit transformé ou éliminé, au moins partiellement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47acc39d-e19b-49f6-b624-bfd2fd6f26be",
                                "sense_id": "5199dff5-381c-3eac-b67d-702d11b9a33a",
                                "text": "Délactoser une fabrication favorise l'égouttage du grain de caillé en cuve."
                            },
                            {
                                "example_id": "6670dcd5-f6be-490b-8eb9-ea4b1905279e",
                                "sense_id": "5199dff5-381c-3eac-b67d-702d11b9a33a",
                                "text": "T'as compris faut surtout pas le délactoser!!!!"
                            },
                            {
                                "example_id": "4109d85d-74e6-4934-8419-0b0bd82afc0a",
                                "sense_id": "5199dff5-381c-3eac-b67d-702d11b9a33a",
                                "text": "Plus tard dans la chaîne de fabrication, on doit présoutirer le lactosérum, le délactoser (réduire le lactose dans le fromage) et le pré-presser."
                            }
                        ]
                    }
