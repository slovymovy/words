                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "a1376c76-a084-3332-8515-8ade73c12cf2",
                                        "entry_id": "35fa3a43-567d-3e9c-9a23-1635d6672078",
                                        "glosses": [
                                            "Práctica de correctas formas de congeniar con los elementos pertenecientes al ambiente, buscando la relación con el mismo sin la alteración en forma significativa de sus elementos y también velando por la conservación adecuada de los mismos."
                                        ],
                                        "tags": [],
