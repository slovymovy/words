                "senses": [
                    {
                        "sense_id": "c838475a-4335-398d-99c7-d0f98bd8d338",
                        "entry_id": "7d5040fc-3d4c-3486-8500-597f6e399a60",
                        "glosses": [
                            "почётное звание, присваиваемое космонавтам, совершившим полёт в космос"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f98ff3f4-7f3e-44b9-8065-fe911632440d",
                                "sense_id": "c838475a-4335-398d-99c7-d0f98bd8d338",
                                "text": "Мне присвоено звание лётчика-космонавта СССР, с этим званием можно лететь в космос."
                            },
                            {
                                "example_id": "f8d0d85d-52af-410e-b4a0-69b253895e0c",
                                "sense_id": "c838475a-4335-398d-99c7-d0f98bd8d338",
                                "text": "― Павел Романович, вот вас и ваших коллег называют летчиками-космонавтами. Это ― высокое звание."
                            }
                        ]
                    },
                    {
                        "sense_id": "818d4f3f-7ee3-3941-9f6e-b4d30feb7942",
                        "entry_id": "7d5040fc-3d4c-3486-8500-597f6e399a60",
                        "glosses": [
                            "обладатель такого звания"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b824b204-5533-43be-a71c-5b1327f57238",
                                "sense_id": "818d4f3f-7ee3-3941-9f6e-b4d30feb7942",
                                "text": "Он был лётчиком-космонавтом, и оторвать его от самолета ― значило бы оторвать его от космического корабля."
                            }
                        ]
                    }
