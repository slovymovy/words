                        "entry_id": "bf9b4a76-4015-349c-be63-94d90fa209f2",
                        "glosses": [
                            "Personne qui copie quelque chose en utilisant une blockchain sans en être réellement propriétaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62023a1c-2c3b-45fd-8f78-ede1235ab816",
                                "sense_id": "692e69e6-0ef1-36f4-a3a8-7cb5a2694d86",
                                "text": "Le voleur prenait de nombreuses œuvres d’artistes en espérant ne pas se faire choper, raconte une artiste victime d’un copyminter."
                            },
                            {
                                "example_id": "490e5b3d-dcf1-4888-b487-8a7f1d6b79bb",
                                "sense_id": "692e69e6-0ef1-36f4-a3a8-7cb5a2694d86",
                                "text": "Si vous tombez sur le vol de vos œuvres par un copyminter, ne vous laissez pas faire !"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
