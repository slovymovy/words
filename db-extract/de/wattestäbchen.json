                                "sense_id": "563c0355-d2b2-381b-a7da-8a30fa11e849",
                                "text": "Verwende zum Reinigen stets ein feuchtes Wattestäbchen."
                            },
                            {
                                "example_id": "32d0281d-6f52-4a20-8d8d-43c4682fd42f",
                                "sense_id": "563c0355-d2b2-381b-a7da-8a30fa11e849",
                                "text": "„Irgendwann entdeckt der CIA wahrscheinlich noch, welch furchtbar grausame Dinge man mit einem Wattestäbchen anrichten kann.“"
                            }
