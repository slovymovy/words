                "senses": [
                    {
                        "sense_id": "f7b8ac04-0f20-337f-a654-1c212a04055d",
                        "entry_id": "e5d695ef-18a2-3af7-89fe-ae7bcf60ef6a",
                        "glosses": [
                            "Faire un roulé-boulé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8de1235f-526d-49a9-80af-4ea58000d873",
                                "sense_id": "f7b8ac04-0f20-337f-a654-1c212a04055d",
                                "text": "En se retournant, le moine trébucha sur son froc, roula-boula deux fois de suite puis, se relevant, descendit rapidement la pente."
                            },
                            {
                                "example_id": "65cbb8f7-515a-4f91-bb11-55605c39b042",
                                "sense_id": "f7b8ac04-0f20-337f-a654-1c212a04055d",
                                "text": "Il roula-boula vers l’entrée, entendit un vase exploser derrière lui."
                            },
                            {
                                "example_id": "41eed9ac-01dd-437f-abba-9b50749a6bb2",
                                "sense_id": "f7b8ac04-0f20-337f-a654-1c212a04055d",
                                "text": "Mais il plongea. D’abord ! Roula-boula sur l’épaule alors que mes pruneaux se perdaient au-dessus de lui."
                            }
                        ]
                    }
                ],
