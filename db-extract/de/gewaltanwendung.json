                "senses": [
                    {
                        "sense_id": "dab366a3-9fa8-3208-ae5a-48e41f1c52db",
                        "entry_id": "9baf9850-4bde-3e65-bfa0-df9095fed081",
                        "glosses": [
                            "Verwendung von sogenannter Gewalt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59a071a2-d601-4bb9-888b-520e43978ccf",
                                "sense_id": "dab366a3-9fa8-3208-ae5a-48e41f1c52db",
                                "text": "„Bei Männern mit schwerer Persönlichkeitsstörung kann durch destruktive Dominanz- und verletzende Gewaltanwendung das sexuelle Empfinden gesteigert werden.“"
                            },
                            {
                                "example_id": "4fd9ab4b-3edf-4de9-b5cf-bb81a692dc28",
                                "sense_id": "dab366a3-9fa8-3208-ae5a-48e41f1c52db",
                                "text": "„Äußerliche Hinweise auf eine Kindesmisshandlung sind ungewöhnliche Spuren von Gewaltanwendung (z. B. zahlreiche blaue Flecken, Verbrennungen oder Knochenbrüche), bei Vernachlässigung stehen psychische Auffälligkeiten im Vordergrund.“"
                            },
                            {
                                "example_id": "47c5060a-7f06-4452-8f27-9f75c4c484aa",
                                "sense_id": "dab366a3-9fa8-3208-ae5a-48e41f1c52db",
                                "text": "„Ich überzeugte ihn rasch, daß er ihn daran, selbst unter Gewaltanwendung, hindern mußte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
