                    }
                ],
                "senses": [
                    {
                        "sense_id": "f60f003b-ef41-3c17-bce1-38796d21bd46",
                        "entry_id": "1b935f43-adf7-3e3c-bf07-78601cd6e6d8",
                        "glosses": [
                            "Personne qui s’occupe de statistique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d09e370-ad81-45b3-a541-59b3c4ced3b6",
                                "sense_id": "f60f003b-ef41-3c17-bce1-38796d21bd46",
                                "text": "Les géographes et les statisticiens ont dressé depuis plusieurs années des tableaux détaillés de la population de ses villes, de ses districts, de ses provinces et de ses royaumes."
                            },
                            {
                                "example_id": "195a5d5c-437d-4109-97ae-1746e8e584f2",
                                "sense_id": "f60f003b-ef41-3c17-bce1-38796d21bd46",
                                "text": "C’est l’œuvre d’un économiste, n’est-ce-pas, et on devine quels arides tableaux bourrés de chiffres les statisticiens d’aujourd’hui feraient de Sapogne-Feuchères à la fin du XIXᵉ siècle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2d63e8e2-d137-4277-9e42-035b537d5f68",
                        "source_entry_id": "1b935f43-adf7-3e3c-bf07-78601cd6e6d8",
                        "source_sense_id": "f60f003b-ef41-3c17-bce1-38796d21bd46",
                        "source_sense_description": "spécialiste des statistiques",
                        "target_lang_word": "Statistiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Statistiker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6154a600-b48b-399e-959e-4eec8b0dd175",
                                        "entry_id": "f5108c28-d423-314e-9a2e-1a7b09014508",
                                        "glosses": [
                                            "Person, die sich mit der Erforschung und/oder Anwendung der Statistik befasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7897e592-9782-4d5d-adac-f1c6ca5cce8f",
                                                "sense_id": "6154a600-b48b-399e-959e-4eec8b0dd175",
                                                "text": "„Dies ist eben der Bereich, in dem ihm der Statistiker eine hilfreiche Hand reichen kann.“"
                                            },
                                            {
                                                "example_id": "4e3ebc65-fe85-464a-ab38-4843c9955d14",
                                                "sense_id": "6154a600-b48b-399e-959e-4eec8b0dd175",
                                                "text": "„Den Statistikern zufolge sank die Zahl der Schülerinnen und Schüler im Grundschulbereich wegen der sinkenden Geburtenraten in den vergangenen zehn Jahren um zwölf Prozent.“"
                                            },
                                            {
                                                "example_id": "6c69e87c-ad54-40a0-808c-bdd1c6e2acd9",
                                                "sense_id": "6154a600-b48b-399e-959e-4eec8b0dd175",
                                                "text": "„Als der Geschäftsführer mit dem Archivar den Raum verlassen hatte, dauerte es noch eine Weile, bis der aufgescheuchte Statistiker in sein Gleichgewicht zurückgependelt war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
