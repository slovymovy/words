                        "glosses": [
                            "A tree, Mitragyna speciosa, endemic to Southeast Asia."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5ab6d5ce-b3fc-4e2d-bfd5-7b6fd9101a37",
                                "sense_id": "23a674e1-b8e8-3dd0-813a-f661cce677ca",
                                "text": "When the US Drug Enforcement Administration announced plans to criminalise the sale and possession of the psychoactive plant kratom, people across the country became interested in a leaf used medicinally for centuries in parts of Asia."
                            }
                        ]
                    },
                    {
                        "sense_id": "c3cb8097-572d-3ca2-a91a-945f6a07a354",
                        "entry_id": "0b320dec-500a-3af6-b1f3-d0451707052c",
                        "glosses": [
                            "The dried leaves of this tree, used in traditional medicine or recreationally for their stimulant and analgesic effects."
                        ],
