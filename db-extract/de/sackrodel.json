                "senses": [
                    {
                        "sense_id": "b619d830-f912-3fe7-9ee8-8da4c62a59a4",
                        "entry_id": "9b7c0da6-deae-3fd5-9219-e6c9913f437c",
                        "glosses": [
                            "zweirädriges Gerät zur Beförderung von Lasten, auch Getränkekisten"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "19828676-47a8-4e10-9e10-34eeab79a2af",
                                "sense_id": "b619d830-f912-3fe7-9ee8-8da4c62a59a4",
                                "text": "„Er belud eine Sackrodel mit 10 Säcken zu je 25 kg.“"
                            },
                            {
                                "example_id": "2228fe4b-f395-488a-93ff-64a7dfb491d6",
                                "sense_id": "b619d830-f912-3fe7-9ee8-8da4c62a59a4",
                                "text": "„Mit einer Sackrodel transporten die Einbrecher die Beute aus dem Gebäude.“"
                            },
                            {
                                "example_id": "86d1f2c6-a127-47eb-87fd-0aafc84c4d87",
                                "sense_id": "b619d830-f912-3fe7-9ee8-8da4c62a59a4",
                                "text": "„Das Kopfsteinpflaster war nass und rutschig, die Vollgummiräder der Sackrodel, auf die eine Mülltonne geladen war, schlugen den Ton.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "495235cf-6c4b-46b3-bf4a-732bdcbfe8d0",
