                                "target_senses": [
                                    {
                                        "sense_id": "6e9e4047-f9a2-3abc-96c1-c70b3842ab2f",
                                        "entry_id": "a9d5d34e-b378-3765-bfcf-e1110c279fd7",
                                        "glosses": [
                                            "уменьш.-ласк. к солдат"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b82d3cb-c048-4ca5-8e04-43e881019e8a",
                                                "sense_id": "6e9e4047-f9a2-3abc-96c1-c70b3842ab2f",
                                                "text": "― Я капитана узнал, капитана! — закричал смуглый маленький солдатик."
                                            },
                                            {
                                                "example_id": "84128013-62c5-4ab1-9dd8-ab80dd00e7d4",
                                                "sense_id": "6e9e4047-f9a2-3abc-96c1-c70b3842ab2f",
                                                "text": "К любимому солдатскому месту, к каше, собирается большая группа, и с трубочками в зубах солдатики…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "548064e2-4d9e-3263-abd7-606c8f370408",
                                        "entry_id": "a9d5d34e-b378-3765-bfcf-e1110c279fd7",
                                        "glosses": [
                                            "разг., небольшая фигурка солдата, обычно выполненная из металла и предназначенная для детских игр или коллекционирования"
                                        ],
                                        "tags": [
                                            "обычно мн. ч."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f56a79d4-7425-48d0-a3a1-cd28b83893b4",
                                                "sense_id": "548064e2-4d9e-3263-abd7-606c8f370408",
                                                "text": "Мальчик по-прежнему возился с кубиками, только теперь он строил из них не дом, а длинную невысокую стену, на которой через равные промежутки стояли оловянные солдатики с длинными красными плюмажами."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d00884f4-fdf2-3a9b-beee-f22f396defa9",
                                        "entry_id": "a9d5d34e-b378-3765-bfcf-e1110c279fd7",
