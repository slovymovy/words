                        "entry_id": "df266c19-13a2-3368-bc55-896c2fe58628",
                        "glosses": [
                            "one of two broad subdivisions of ecology, which studies the individual organism or species."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "d8d0b40d-7cf7-4c87-9353-2b694512bdf8",
                                "sense_id": "d028174e-4c10-3e3f-aeab-1a20bd44b63a",
                                "text": "1959: Odum, '\nIn regard to subdivisions, ecology is commonly divided into autecology' and synecology."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f06e30b4-77ce-477f-b676-da34a7c4b572",
                        "source_entry_id": "df266c19-13a2-3368-bc55-896c2fe58628",
                        "source_sense_id": "d028174e-4c10-3e3f-aeab-1a20bd44b63a",
                        "source_sense_description": "one of two broad subdivisions of ecology",
