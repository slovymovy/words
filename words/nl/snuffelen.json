            "senses": [
                {
                    "sense_id": "6c781ae9-20f8-341a-9c5d-dc3c0f6b8919",
                    "sense_definition": "met korte hoorbare halen door de neus ademen om iets aandachtig te ruiken",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ruiken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De hond begon direct aan mijn schoenen te <w>snuffelen</w> toen ik binnenkwam.",
                            "target_lang_translations": {
                                "en": "The dog immediately started to <w>sniff</w> my shoes when I came in.",
                                "ru": "Собака сразу начала <w>обнюхивать</w> мои ботинки, когда я вошел."
                            }
                        },
                        {
                            "text": "Het konijn bleef even staan om aan het gras te <w>snuffelen</w>.",
                            "target_lang_translations": {
                                "en": "The rabbit paused for a moment to <w>snuffle</w> at the grass.",
                                "ru": "Кролик на мгновение остановился, чтобы <w>понюхать</w> траву."
                            }
                        }
                    ],
                    "synonyms": [
                        "ruiken",
                        "besnuffelen"
                    ],
                    "common_phrases": [
                        "aan iets snuffelen",
                        "nieuwsgierig snuffelen"
                    ],
                    "target_lang_definitions": {
                        "en": "to breathe through the nose with short audible inhalations in order to smell something carefully",
                        "ru": "вдыхать носом с короткими слышимыми звуками, чтобы внимательно что-то учуять"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sniff",
                                "target_lang_sense_clarification": "to inhale through the nose to smell something"
                            },
                            {
                                "target_lang_word": "snuffle",
                                "target_lang_sense_clarification": "to sniff or smell something loudly"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "нюхать",
                                "target_lang_sense_clarification": "вдыхать запах чего-либо"
                            },
                            {
                                "target_lang_word": "обнюхивать",
                                "target_lang_sense_clarification": "тщательно исследовать носом со всех сторон"
                            },
                            {
                                "target_lang_word": "сопеть",
                                "target_lang_sense_clarification": "шумно дышать носом при обнюхивании"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a979f178-9ff0-368a-afe3-214a12399729",
                    "sense_definition": "op een nieuwsgierige en vaak informele manier ergens naar zoeken of rondkijken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zoeken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik vind het heerlijk om urenlang in een oude boekhandel te <w>snuffelen</w>.",
                            "target_lang_translations": {
                                "en": "I love to <w>browse</w> in an old bookstore for hours.",
                                "ru": "Мне очень нравится часами <w>рыться</w> в старом книжном магазине."
                            }
                        },
                        {
                            "text": "Zij houdt ervan om tussen de antieke spullen op de rommelmarkt te <w>snuffelen</w>.",
                            "target_lang_translations": {
                                "en": "She loves to <w>rummage</w> through the antique items at the flea market.",
                                "ru": "Ей нравится <w>выискивать</w> что-нибудь среди антиквариата на блошином рынке."
                            }
                        }
                    ],
                    "synonyms": [
                        "rondneuzen",
                        "doorzoeken",
                        "grasduinen"
                    ],
                    "common_phrases": [
                        "tussen de boeken snuffelen",
                        "in een winkel snuffelen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt voor winkelen of zoeken zonder specifiek doel"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to search or look around somewhere in a curious and often informal way",
                        "ru": "любопытно и часто неформально искать что-то или осматриваться"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "browse",
                                "target_lang_sense_clarification": "to look through items in a shop or collection"
                            },
                            {
                                "target_lang_word": "nose around",
                                "target_lang_sense_clarification": "to look for something curiously or pry"
                            },
                            {
                                "target_lang_word": "rummage",
                                "target_lang_sense_clarification": "to search through a mass of items"
