                                "target_senses": [
                                    {
                                        "sense_id": "a91f8474-24e5-3afc-a82c-9595d8b6c4f6",
                                        "entry_id": "36507429-c414-3b10-8ed7-5b46cbe2c9a6",
                                        "glosses": [
