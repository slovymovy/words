            "senses": [
                {
                    "sense_id": "d3b1347c-80f6-3948-bc65-b18e16b0c4a0",
                    "sense_definition": "De manier waarop iemand een woord, zin of taal ten gehore brengt.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fonetiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>uitspraak</w> van de Franse taal is voor veel Nederlanders erg lastig.",
                            "target_lang_translations": {
                                "en": "The <w>pronunciation</w> of the French language is very difficult for many Dutch people."
                            }
                        },
                        {
                            "text": "Je moet goed op je <w>uitspraak</w> letten als je een nieuwe taal leert.",
                            "target_lang_translations": {
                                "en": "You have to pay close attention to your <w>pronunciation</w> when learning a new language."
                            }
                        }
                    ],
                    "common_phrases": [
                        "op de uitspraak letten",
                        "duidelijke uitspraak"
                    ],
                    "target_lang_definitions": {
                        "en": "The way in which a word, sentence, or language is spoken or sounded."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pronunciation",
                                "target_lang_sense_clarification": "the way words are spoken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "971c112f-cf31-30b2-8a89-fbf9ffe22b4a",
                    "sense_definition": "Een bewering of geuite mening in de vorm van een woord of zin.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "communicatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politicus deed een opmerkelijke <w>uitspraak</w> over de nieuwe wetgeving.",
                            "target_lang_translations": {
                                "en": "The politician made a remarkable <w>statement</w> about the new legislation."
                            }
                        },
                        {
                            "text": "Ik wil die <w>uitspraak</w> graag nuanceren voordat er misverstanden ontstaan.",
                            "target_lang_translations": {
                                "en": "I would like to qualify that <w>statement</w> before any misunderstandings arise."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een uitspraak doen",
                        "opmerkelijke uitspraak"
                    ],
                    "target_lang_definitions": {
                        "en": "An assertion or expressed opinion in the form of a word or sentence."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "statement",
                                "target_lang_sense_clarification": "a declaration or remark"
                            },
                            {
                                "target_lang_word": "pronouncement",
                                "target_lang_sense_clarification": "a formal or official announcement"
                            },
                            {
                                "target_lang_word": "remark",
                                "target_lang_sense_clarification": "a casual or brief comment"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e0553d9-5af2-3c70-80f5-175b2496667c",
                    "sense_definition": "Het officiële oordeel of de beslissing van een rechter of rechtbank.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rechtspraak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rechter doet volgende week vrijdag eindelijk een <w>uitspraak</w> in deze zaak.",
                            "target_lang_translations": {
                                "en": "The judge will finally deliver a <w>verdict</w> in this case next Friday."
                            }
                        },
                        {
                            "text": "De advocaat was niet tevreden met de <w>uitspraak</w> van het gerechtshof.",
                            "target_lang_translations": {
                                "en": "The lawyer was not satisfied with the <w>ruling</w> of the court of appeal."
                            }
                        }
                    ],
                    "synonyms": [
                        "vonnis"
                    ],
                    "common_phrases": [
                        "uitspraak doen",
                        "rechterlijke uitspraak"
                    ],
                    "target_lang_definitions": {
                        "en": "The official judgment or decision made by a judge or a court of law."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "verdict",
                                "target_lang_sense_clarification": "a decision on an issue of fact in a case"
                            },
                            {
                                "target_lang_word": "ruling",
                                "target_lang_sense_clarification": "an authoritative decision by a judge"
                            },
                            {
                                "target_lang_word": "judgment",
                                "target_lang_sense_clarification": "the formal decision of a court"
                            }
                        ]
                    }
                }
            ]
        }
    ]
