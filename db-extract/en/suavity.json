                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "133b1404-16cf-408f-88c0-b4950197ba4d",
                        "entry_id": "30a2bec8-e831-3ef7-8878-33ef717992cb",
                        "tags": [
                            "plural"
