                                                "sense_id": "d2d55276-b975-38b3-839c-a0346fed520c",
                                                "text": "Es herrschte eine große Not in der Bevölkerung."
                                            },
                                            {
                                                "example_id": "6e346bd2-3aaa-4946-af4a-0ece022509fe",
                                                "sense_id": "d2d55276-b975-38b3-839c-a0346fed520c",
                                                "text": "Denke ich an Deutschland, ist mir auch nach Schrei'n",
                                                "translation": "Hier bin ich geboren, auch das ist mein Land."
                                            },
                                            {
                                                "example_id": "81a9e4dd-578e-4da0-9315-0bdcdde8f0ab",
                                                "sense_id": "d2d55276-b975-38b3-839c-a0346fed520c",
                                                "text": "„Wir schreiben hier über den Motorflug, weil sich hier die Nöte des westdeutschen Luftsportes besonders kraß abzeichnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8f9576a5-2385-324c-885d-f007a820b3e3",
                                        "entry_id": "fb5d5369-b9f0-3c31-a392-b3d557ca0cc8",
                                        "glosses": [
                                            "eine gefahrvolle, lebensbedrohliche Situation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30b694b1-1847-41f5-913b-be92f4d66330",
                                                "sense_id": "8f9576a5-2385-324c-885d-f007a820b3e3",
                                                "text": "Der Mann in der Gletscherspalte ist in Not."
                                            },
                                            {
                                                "example_id": "edea6689-60bc-4aa0-843d-a8cd020e020d",
                                                "sense_id": "8f9576a5-2385-324c-885d-f007a820b3e3",
                                                "text": "Denke ich an Deutschland, ist mir auch nach Schrei'n",
                                                "translation": "Hier bin ich geboren, auch das ist mein Land."
                                            },
                                            {
                                                "example_id": "6b8e1d88-3e23-4832-ad9f-fd8e0ac05f55",
                                                "sense_id": "8f9576a5-2385-324c-885d-f007a820b3e3",
                                                "text": "„Wir schreiben hier über den Motorflug, weil sich hier die Nöte des westdeutschen Luftsportes besonders kraß abzeichnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8d7a7926-6a94-3f3b-840c-f1e0215fe9db",
                                        "entry_id": "fb5d5369-b9f0-3c31-a392-b3d557ca0cc8",
                                        "glosses": [
                                            "ein seelischer Zustand der Rat- und Hoffnungslosigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5eec8a3-526d-466e-9b92-fe0c344f5252",
                                                "sense_id": "8d7a7926-6a94-3f3b-840c-f1e0215fe9db",
                                                "text": "Die Psychologin war der erste Mensch, der sich für ihre Not interessierte."
                                            },
                                            {
                                                "example_id": "0139870c-5441-47df-9c41-830951815880",
                                                "sense_id": "8d7a7926-6a94-3f3b-840c-f1e0215fe9db",
                                                "text": "Denke ich an Deutschland, ist mir auch nach Schrei'n",
                                                "translation": "Hier bin ich geboren, auch das ist mein Land."
                                            },
                                            {
                                                "example_id": "a6d22c8c-3cff-4ddb-80a4-917ea3fa2677",
                                                "sense_id": "8d7a7926-6a94-3f3b-840c-f1e0215fe9db",
                                                "text": "„Wir schreiben hier über den Motorflug, weil sich hier die Nöte des westdeutschen Luftsportes besonders kraß abzeichnen.“"
                                            }
