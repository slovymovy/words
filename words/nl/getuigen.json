    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "79627142-9981-305f-b43f-d28164e02fab",
                    "sense_definition": "een officiële verklaring afleggen over wat men gezien of gehoord heeft, vaak voor een rechtbank",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verklaring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De buurman moest voor de rechtbank <w>getuigen</w> over het ongeluk dat hij had gezien.",
                            "target_lang_translations": {
                                "en": "The neighbor had to <w>testify</w> in court about the accident he had seen."
                            }
                        },
                        {
                            "text": "Zij weigerde te <w>getuigen</w> tegen haar eigen familieleden.",
                            "target_lang_translations": {
                                "en": "She refused to <w>testify</w> against her own family members."
                            }
                        }
                    ],
                    "synonyms": [
                        "een getuigenis afleggen"
                    ],
                    "common_phrases": [
                        "voor de rechtbank getuigen",
                        "tegen iemand getuigen",
                        "onder ede getuigen"
                    ],
                    "target_lang_definitions": {
                        "en": "To make an official statement about what one has seen or heard, often in a court of law."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "testify",
                                "target_lang_sense_clarification": "to give evidence in court"
                            },
                            {
                                "target_lang_word": "bear witness",
                                "target_lang_sense_clarification": "to provide a formal account of events"
                            },
                            {
                                "target_lang_word": "give evidence",
                                "target_lang_sense_clarification": "to provide information in a legal context"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f926c068-0bc7-3dbb-9479-104e0733f382",
                    "sense_definition": "een bewijs of aanwijzing zijn van een bepaalde eigenschap of toestand",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bewijs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn snelle reactie laat zien dat hij oplet en <w>getuigt</w> van grote moed.",
                            "target_lang_translations": {
                                "en": "His quick reaction shows that he is paying attention and <w>testifies</w> to great courage."
                            }
                        },
                        {
                            "text": "De prachtige details in dit schilderij <w>getuigen</w> van vakmanschap.",
                            "target_lang_translations": {
                                "en": "The beautiful details in this painting <w>attest</w> to craftsmanship."
                            }
                        }
                    ],
                    "synonyms": [
                        "aantonen",
                        "bewijzen"
                    ],
                    "common_phrases": [
                        "getuigen van moed",
                        "getuigen van respect",
                        "getuigen van inzicht"
                    ],
                    "target_lang_definitions": {
                        "en": "To be evidence or an indication of a particular quality or condition."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "testify to",
                                "target_lang_sense_clarification": "to serve as evidence of something"
                            },
                            {
                                "target_lang_word": "attest to",
                                "target_lang_sense_clarification": "to confirm or show the existence of a quality"
                            },
                            {
                                "target_lang_word": "show",
                                "target_lang_sense_clarification": "to demonstrate a certain trait"
                            },
                            {
                                "target_lang_word": "speak of",
                                "target_lang_sense_clarification": "to suggest or indicate a quality"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d2609c9c-8bac-3c81-b6ae-32d0aff82c6e",
                    "sense_definition": "meervoud van <w>getuige</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er waren meerdere <w>getuigen</w> aanwezig bij de diefstal in de supermarkt.",
                            "target_lang_translations": {
                                "en": "There were several <w>witnesses</w> present at the theft in the supermarket."
                            }
                        },
                        {
                            "text": "De politie vraagt alle <w>getuigen</w> om zich zo snel mogelijk te melden.",
                            "target_lang_translations": {
                                "en": "The police are asking all <w>witnesses</w> to come forward as soon as possible."
                            }
                        }
                    ],
                    "common_phrases": [
                        "getuigen van een ongeluk",
                        "oproep aan getuigen"
                    ],
                    "target_lang_definitions": {
                        "en": "Plural of witness; people who see an event take place."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "witnesses",
                                "target_lang_sense_clarification": "people who saw an event"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}