                            {
                                "example_id": "c70ca6b1-07c2-43d0-b9c5-9aacb04123dd",
                                "sense_id": "5409ea63-2d45-3723-ae8a-1d3873530978",
                                "text": "Het raam keek uit op de binnenplaats van het huis, op de achtergevels van aangrenzende huizen en op onbebouwde stukjes stadsgrond aan de rivier."
                            },
                            {
                                "example_id": "f5eff90f-2b92-4610-92b1-b41a7a41229e",
                                "sense_id": "5409ea63-2d45-3723-ae8a-1d3873530978",
                                "text": "Met duizend verschillende soorten grond heeft het World Soil Museum nu een wereldwijde verzameling die onder meer stadsgrond uit Hilversum bevat, maar bijvoorbeeld ook woestijngrond uit Ghana. In een zaal met tachtig meter aan grondsoorten kun je zien welke invloed uitspoeling, verzilting, vervuiling en verdroging hebben op de bodem."
                            }
