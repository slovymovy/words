{
    "word_family": [
        "сегодняшний"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "18a0ddb9-9352-3792-99ae-44a95b421ad0",
                    "sense_definition": "В этот, текущий день; в эти сутки",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "literal_day",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Сегодня</w> отличная погода для прогулки в парке.",
                            "target_lang_translations": {
                                "en": "<w>Today</w> the weather is great for a walk in the park.",
                                "zh": "<w>今天</w>公园里的天气非常适合散步。",
                                "de": "<w>Heute</w> ist das Wetter hervorragend für einen Spaziergang im Park."
                            }
                        },
                        {
                            "text": "Я обязательно позвоню тебе <w>сегодня</w> вечером после работы.",
                            "target_lang_translations": {
                                "en": "I will definitely call you <w>today</w> in the evening after work.",
                                "zh": "我下班后<w>今天</w>晚上一定会给你打电话。",
                                "de": "Ich werde dich <w>heute</w> Abend nach der Arbeit auf jeden Fall anrufen."
                            }
                        }
                    ],
                    "antonyms": [
                        "вчера",
                        "завтра"
                    ],
                    "common_phrases": [
                        "сегодня утром",
                        "сегодня днём",
                        "сегодня вечером",
                        "не сегодня"
                    ],
                    "target_lang_definitions": {
                        "en": "On this day; on the current day",
                        "zh": "在这一天；在当前这一天",
                        "de": "An diesem Tag; am aktuellen Tag"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "today",
                                "target_lang_sense_clarification": "on the current day"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "今天",
                                "target_lang_sense_clarification": "指说话时的这一天"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "heute",
                                "target_lang_sense_clarification": "am aktuellen Tag"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9a81f09-8c4f-3fde-9ded-5b66ae9b54d9",
                    "sense_definition": "В настоящее время, в наши дни",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "figurative_present",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Сегодня</w> многие люди предпочитают работать удалённо из дома.",
                            "target_lang_translations": {
                                "en": "<w>Today</w>, many people prefer to work remotely from home.",
                                "zh": "<w>今天</w>许多人更喜欢在家远程办公。",
                                "de": "<w>Heute</w> ziehen es viele Menschen vor, remote von zu Hause aus zu arbeiten."
                            }
                        },
                        {
                            "text": "Мир <w>сегодня</w> меняется быстрее, чем когда-либо прежде.",
                            "target_lang_translations": {
                                "en": "The world <w>today</w> is changing faster than ever before.",
                                "zh": "世界<w>今天</w>的变化比以往任何时候都快。",
                                "de": "Die Welt verändert sich <w>heute</w> schneller als je zuvor."
                            }
                        }
                    ],
                    "synonyms": [
                        "нынче"
                    ],
                    "target_lang_definitions": {
                        "en": "At the present time; in these times",
                        "zh": "在当前时期；在当今时代",
