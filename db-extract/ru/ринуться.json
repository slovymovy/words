                        "cross_references": [
                            {
                                "target_word": "foncer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f66b51b9-bf24-3bee-9f79-5622eccb0275",
                                        "entry_id": "f5247e39-3602-3a91-b856-ca45ad0d4578",
                                        "glosses": [
                                            "Garnir d’un fond."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a07ddb6f-b685-4cc0-b39b-723c049174f6",
                                                "sense_id": "f66b51b9-bf24-3bee-9f79-5622eccb0275",
                                                "text": "Le premier rempailleur de chaise à s’être promené à pîed dans les rues pour exercer son métier, semble être celui qui travaillait avec de la paille de seigle, du foin des marais ou des tiges de chanvre, puisque les chaises foncées avec ces matériaux étaient répandues chez les habitants aux XVII et XVIII siècle, tant dans les district de Trois-Rivières, que dans ceux de Montréal et de Québec."
                                            },
                                            {
                                                "example_id": "f6f21abe-74fd-41e6-ab7b-bd2775d8cee6",
                                                "sense_id": "f66b51b9-bf24-3bee-9f79-5622eccb0275",
                                                "text": "J’ai fait foncer dix tonneaux à neuf."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7522f5d2-e6dc-3744-a6b2-14acd71acdbc",
                                        "entry_id": "f5247e39-3602-3a91-b856-ca45ad0d4578",
                                        "glosses": [
                                            "Garnir de pâte un moule ou une plaque à gâteau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19e2abce-c963-4735-9d78-31e01f708ac1",
                                                "sense_id": "7522f5d2-e6dc-3744-a6b2-14acd71acdbc",
                                                "text": "Piquez votre foie de veau de gros lard assaisonné; foncez une braisière de bardes de lard; mettez-y le foie avec des carottes, un bouquet garni, des oignons, […]."
                                            },
                                            {
                                                "example_id": "f41141cd-2f65-48ea-ae06-ffec9c7e6ef5",
                                                "sense_id": "7522f5d2-e6dc-3744-a6b2-14acd71acdbc",
                                                "text": "Charlotte au café à la Vierge.\nFoncez un moule à charlotte avec des biscuits à la cuiller, ou mieux poussez à la poche : […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0bf3937-fd46-3790-a857-2f3e9f87b7ae",
                                        "entry_id": "f5247e39-3602-3a91-b856-ca45ad0d4578",
                                        "glosses": [
                                            "Creuser verticalement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93a7f9e6-05c8-4fc2-9b70-474d8bb9e429",
                                                "sense_id": "b0bf3937-fd46-3790-a857-2f3e9f87b7ae",
                                                "text": "Foncer un puits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32a373ba-03bd-3f3f-b59b-ed91837f4f92",
                                        "entry_id": "f5247e39-3602-3a91-b856-ca45ad0d4578",
                                        "glosses": [
                                            "Charger de couleur de manière à rendre plus sombre."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d69085f4-da5b-429d-a4f0-f3de7410a48c",
                                                "sense_id": "32a373ba-03bd-3f3f-b59b-ed91837f4f92",
                                                "text": "La saison fonçait les feuillages, touchait d’or les prés, carminait çà et là une branche."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "foncer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6c8dc3a5-0283-325d-8a1e-af4650e788da",
                                        "entry_id": "a15646eb-f865-370b-a348-e69c4264b2c4",
                                        "glosses": [
