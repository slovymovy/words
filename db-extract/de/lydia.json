                                "target_senses": [
                                    {
                                        "sense_id": "1f38c346-e6af-3797-8dfe-69cacc6bbe66",
                                        "entry_id": "6ac63df8-7ae0-3e38-b4b3-18a1abc2bdae",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "794646bd-8b7c-42e6-a964-5e675da87a90",
                                                "sense_id": "1f38c346-e6af-3797-8dfe-69cacc6bbe66",
                                                "text": "Dans sa romance Veggy vs Zombies, Lydie Wallon a voulu donner une nouvelle chance au mort-vivant."
                                            },
                                            {
                                                "example_id": "11b806c5-8d49-4b91-a3a0-2438aece5ec1",
                                                "sense_id": "1f38c346-e6af-3797-8dfe-69cacc6bbe66",
                                                "text": "Lydie, « la Lydienne », était certainement d'origine servile, les esclaves recevant fréquemment des noms indiquant leur provenance."
                                            },
                                            {
                                                "example_id": "83299282-bc50-4108-a80d-a392de77cf80",
                                                "sense_id": "1f38c346-e6af-3797-8dfe-69cacc6bbe66",
                                                "text": "Parmi les dossiers transmis, celui de la tuerie de Chevaline, en 2012, le meurtre de Marion Wagon, 10 ans, en 1996, ou celui de Lydie Logé, disparue à 29 ans en 1993."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
