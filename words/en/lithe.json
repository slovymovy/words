{
    "word_family": [
        "litheness",
        "lithesome"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "61615258-44a7-3314-a811-051f59418a25",
                    "sense_definition": "Bending easily and gracefully; supple and flexible.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "flexibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dancer's <w>lithe</w> movements captivated everyone watching the performance.",
                            "target_lang_translations": {
                                "it": "I movimenti <w>flessuosi</w> del ballerino hanno affascinato tutti gli spettatori dell'esibizione."
                            }
                        },
                        {
                            "text": "Years of daily gymnastics kept his body astonishingly <w>lithe</w> and agile.",
                            "target_lang_translations": {
                                "it": "Anni di ginnastica quotidiana hanno mantenuto il suo corpo incredibilmente <w>elastico</w> e agile."
                            }
                        }
                    ],
                    "synonyms": [
                        "flexible",
                        "limber",
                        "pliant",
                        "lissome",
                        "lithesome"
                    ],
                    "common_phrases": [
                        "lithe body",
                        "lithe dancer"
                    ],
                    "target_lang_definitions": {
                        "it": "Che si flette facilmente e con grazia; flessuoso e agile."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "flessuoso",
                                "target_lang_sense_clarification": "che si piega con grazia ed eleganza"
                            },
                            {
                                "target_lang_word": "agile",
                                "target_lang_sense_clarification": "sciolto e rapido nei movimenti"
                            },
                            {
                                "target_lang_word": "elastico",
                                "target_lang_sense_clarification": "flessibile, snodato"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4746f79f-fd94-3c53-b677-a420838478de",
                    "sense_definition": "Slender and athletic in appearance.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "flexibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A pack of <w>lithe</w> runners sprinted effortlessly along the winding mountain path.",
                            "target_lang_translations": {
                                "it": "Un gruppo di <w>snelli</w> corridori scattava senza sforzo lungo il tortuoso sentiero di montagna."
                            }
                        },
                        {
                            "text": "She admired the leopard's <w>lithe</w> frame as it crept through the tall grass.",
                            "target_lang_translations": {
                                "it": "Ammirava la corporatura <w>slanciata</w> del leopardo mentre avanzava furtivo nell'erba alta."
                            }
                        }
                    ],
                    "synonyms": [
                        "slender",
                        "slim",
                        "svelte",
                        "willowy"
                    ],
                    "common_phrases": [
                        "lithe frame",
                        "lithe figure"
                    ],
                    "target_lang_definitions": {
