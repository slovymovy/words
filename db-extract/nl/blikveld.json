                "senses": [
                    {
                        "sense_id": "f1152fe2-bddf-34e4-b2b9-3d890ff6943b",
                        "entry_id": "ee10d6af-f792-3d36-8584-92f01871ac88",
                        "glosses": [
                            "wat je kunt zien van de buitenwereld als je je hoofd stilhoudt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02a8bf30-eca0-4077-9925-dc363d36ce4d",
                                "sense_id": "f1152fe2-bddf-34e4-b2b9-3d890ff6943b",
                                "text": "Want zie toch hoe gek Wilson zich gedroeg: hij instrueerde mensen die hij ontmoette om in zijn rechter blikveld te gaan staan. Wat Freud niet besefte, was dat Wilson een hersenbloeding had gehad, daardoor blind raakte voor zijn linker visuele veld en zodoende die merkwaardige gewoonte had ontwikkeld."
                            },
                            {
                                "example_id": "45a62cd4-4021-4d43-af1f-4d75a786af47",
                                "sense_id": "f1152fe2-bddf-34e4-b2b9-3d890ff6943b",
                                "text": "Een strakblauwe hemel domineert in het blikveld, het is alsof de sparren respectvol uit zicht blijven."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c358e81-f7e2-36c9-8e69-48c700d009db",
                        "entry_id": "ee10d6af-f792-3d36-8584-92f01871ac88",
                        "glosses": [
                            "waar je wel eens aan denkt, wat je je nog wel eens voorstelt"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "6e3c11ee-4f3e-4697-887f-aaef4ad808a5",
                                "sense_id": "5c358e81-f7e2-36c9-8e69-48c700d009db",
                                "text": "Het verhaal van Jezus van Nazaret is bij velen uit het blikveld geraakt. Anno 2017 betekent Pasen: pal staan voor het eieren zoeken als onvervreemdbaar cultuurgoed. Toch verdient het verhaal over Jezus’ dood een plaats in ons collectieve bewustzijn. Want het leert ons iets over onszelf."
                            },
                            {
                                "example_id": "08ed1a75-2ecc-4f32-830b-886fd2a5c633",
                                "sense_id": "5c358e81-f7e2-36c9-8e69-48c700d009db",
                                "text": "Iedereen had het naar zijn zin, en daar draaide het uiteindelijk allemaal om. Het luidruchtige commentaar van Jeroen was voor haar geen aanleiding om van blikveld te veranderen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "903cf66a-012a-44d1-a6b5-15a4c6afdb2d",
                        "source_entry_id": "ee10d6af-f792-3d36-8584-92f01871ac88",
                        "source_sense_id": "f1152fe2-bddf-34e4-b2b9-3d890ff6943b",
                        "source_sense_description": "wat je kunt zien van de buitenwereld als je je hoofd stilhoudt",
                        "target_lang_word": "field of vision",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "field of vision",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a35158de-cf50-3643-9386-bbe7f5abd28b",
                                        "entry_id": "12420ae5-4a0f-340a-91ce-aba3b330a737",
                                        "glosses": [
                                            "The area that a person, an animal, etc. can see with its eyes (or each eye individually) without turning the head."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "655c7ec2-757f-47c8-8695-d2ca89feef9e",
                                                "sense_id": "a35158de-cf50-3643-9386-bbe7f5abd28b",
                                                "text": "But when there is no Danger to our Eyes, either from Duſt or Light, we pull up our Eye-brows, that none of the Light may be ſtopt, but that all of it may fall upon our Eyes; by which the Sight or Field of Viſion is enlarged, and all the Objects above the Axis of Viſion are now ſeen: [...]"
                                            },
                                            {
                                                "example_id": "73f1934f-501b-4cf5-ba72-60d5cdb4f213",
                                                "sense_id": "a35158de-cf50-3643-9386-bbe7f5abd28b",
                                                "text": "Prisms with their base outwards, combined with the convex lenses, have only the effect of enlarging the outer side of both fields of vision. For all the purposes we now speak of, this combination of prisms with convex lenses is quite superfluous, even in some respects troublesome."
                                            },
                                            {
                                                "example_id": "86f1ad80-90e5-462b-9d3c-f5b92bb9c212",
                                                "sense_id": "a35158de-cf50-3643-9386-bbe7f5abd28b",
                                                "text": "[A]ny of you who drive automobiles know that you run in and out of traffic, that you live up to the courtesies of the road, by making use of the whole field of vision. You see out of one corner of your eye that the man on your right has parked too far from the curb and out of the other corner of your eye that the man on your left is driving too close."
                                            },
                                            {
                                                "example_id": "1093d62c-cdba-408f-b95e-e6498171cd61",
                                                "sense_id": "a35158de-cf50-3643-9386-bbe7f5abd28b",
                                                "text": "The average normal field of vision extends outward 90°, upward 50°, downward 70°, and inward 60° from the point of fixation."
                                            },
                                            {
                                                "example_id": "a7fa369b-5461-4c8f-86a5-a5596447c578",
                                                "sense_id": "a35158de-cf50-3643-9386-bbe7f5abd28b",
                                                "text": "Occasionally a clubgoer happens to notice one of the cameras and responds by thrusting a middle finger or an exposed breast into Haz’s field of vision. Otherwise, the thousands of young men and women entering and exiting the clubs are his unwitting entertainment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
