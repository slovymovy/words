                "senses": [
                    {
                        "sense_id": "1eac7c43-ef0e-3fda-b1a2-3b9bc8e63166",
                        "entry_id": "3f9f2e90-fc74-3d08-b275-440a2068e093",
                        "glosses": [
                            "Appareil ou machine qui ôte les fibres végétales, gratterons, fruits crochus des chardons, etc., de la laine."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": [
                            {
                                "example_id": "9e26d37e-e784-481f-aaa8-ca6497bf890a",
                                "sense_id": "1eac7c43-ef0e-3fda-b1a2-3b9bc8e63166",
                                "text": "Dans l’échardonneuse Offermann, de Leipzig, l’appareil se compose d’un cylindre à lames qui peut être rapproché autant qu’on le voudra d’un autre cylindre lisse sans toutefois pouvoir jamais le toucher."
                            },
                            {
                                "example_id": "05cff761-dce3-4edf-8850-716fe7134408",
                                "sense_id": "1eac7c43-ef0e-3fda-b1a2-3b9bc8e63166",
                                "text": "On pourrait la supprimer, et disposer, à la partie antérieure de l’échardonneuse, une toile sans fin F, sur laquelle on mettrait directement la laine avec la main."
                            }
                        ]
                    },
                    {
                        "sense_id": "f7df9843-6b1e-31b8-be97-0b87fd3e7354",
                        "entry_id": "3f9f2e90-fc74-3d08-b275-440a2068e093",
                        "glosses": [
                            "Ouvrière qui était chargée d’ôter les chardons dans les cultures."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "6ff5628d-fce4-42ed-88ee-257237ea4681",
                                "sense_id": "f7df9843-6b1e-31b8-be97-0b87fd3e7354",
                                "text": "Et continuellement ceux qui sont venus à l’autre monde, auxquels j’ai autrefois, sous de mauvais prétextes, retenu une partie de leurs salaires, m’étranglent pour me faire rendre gorge; ils crient : […] L’échardonnage, à raison de cinq sous par journée d’échardonneuse !"
                            }
                        ]
                    }
