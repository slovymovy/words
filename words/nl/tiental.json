                {
                    "sense_id": "9593b6dd-31fe-33ee-89d3-d5a0e31e856b",
                    "sense_definition": "in het meervoud gebruikt om een onbepaalde maar aanzienlijke hoeveelheid aan te duiden",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "hoeveelheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er staan <w>tientallen</w> foto's in het nieuwe boek over het paleis.",
                            "target_lang_translations": {
                                "en": "There are <w>dozens</w> of photos in the new book about the palace.",
                                "ru": "В новой книге о дворце <w>десятки</w> фотографий.",
                                "pl": "W nowej książce o pałacu znajdują się <w>dziesiątki</w> zdjęć."
                            }
                        },
                        {
                            "text": "Nu <w>tientallen</w> leden van zijn kabinet zijn opgestapt, treedt de minister-president alsnog terug.",
                            "target_lang_translations": {
                                "en": "Now that <w>dozens</w> of members of his cabinet have resigned, the prime minister is stepping down after all.",
                                "ru": "Теперь, когда <w>десятки</w> членов его кабинета ушли в отставку, премьер-министр всё же покидает свой пост.",
                                "pl": "Teraz, gdy <w>dziesiątki</w> członków jego gabinetu podały się do dymisji, premier ostatecznie ustępuje ze stanowiska."
                            }
                        }
