                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c8b0ab50-1fe1-440b-b4bc-3635de27ce9c",
                        "entry_id": "1a4b586f-00e3-3ffa-9adf-46a9bed54572",
                        "tags": [
