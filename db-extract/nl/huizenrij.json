                    {
                        "sense_id": "f620e230-ddc5-3158-8e18-5abeb6e6dc33",
                        "entry_id": "a4302d5d-e73f-3af3-8e05-4a7d4f743a80",
                        "glosses": [
                            "een aaneengesloten rij woningen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9223ccdc-a71e-413c-858f-6998f3a3e083",
                                "sense_id": "f620e230-ddc5-3158-8e18-5abeb6e6dc33",
                                "text": "Het uitzicht vanuit de woonkamer is adembenemenend. Groene weilanden, een houtwal en ’s morgens soms reeën op een steenworp afstand van de huizenrij aan de rand van Hanenberglanden. De meeste rolgordijnen en jaloeziëen aan de straatzijde zijn echter gesloten. Op die manier sluiten de bewoners van de rij woningen zich letterlijk af van de aanblik van de overzijde van de straat."
                            },
                            {
                                "example_id": "0589dcb4-aaf2-4d66-945c-21fa17d654e6",
                                "sense_id": "f620e230-ddc5-3158-8e18-5abeb6e6dc33",
                                "text": "Daarom moesten de ingangen binnen de huizenrij uitkomen en werden het voormalige ABN-kantoor aan de Ceintuurbaan en twee panden naast de markt gesloopt. Dat het stadsdeel dat wilde was opmerkelijk, omdat uitgangspunt van de metrobouw was om zo min mogelijk te slopen."
                            }
                        ]
                    }
