                                                "sense_id": "ae96c416-f9c8-3f9c-bc93-7727d83dd432",
                                                "text": "Forget about dating him; he's out of your league."
                                            },
                                            {
                                                "example_id": "cf5404e7-fc69-4e2b-8274-0099a2cd51cb",
                                                "sense_id": "ae96c416-f9c8-3f9c-bc93-7727d83dd432",
                                                "text": "We're not even in the same league."
