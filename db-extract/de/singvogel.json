                        "sense_id": "1aed4a04-3a64-3d53-9002-46632d1c9c38",
                        "entry_id": "ed2635b0-10d2-3147-9724-e8c6a57acacd",
                        "glosses": [
                            "Oiseau chanteur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f6b9444-a8f3-446a-b189-9de36318c12c",
                                "sense_id": "1aed4a04-3a64-3d53-9002-46632d1c9c38",
                                "text": "Kaum zu glauben: Der Rabe ist ein Singvogel!",
                                "translation": "Difficile à croire : le corbeau est un oiseau chanteur !"
                            },
                            {
                                "example_id": "7695e42c-29f4-4246-a2f1-e4039bb5d1cf",
                                "sense_id": "1aed4a04-3a64-3d53-9002-46632d1c9c38",
                                "text": "Auch wenn ihre Bestände rückläufig sind, so ist die Goldammer (Emberiza citrinella) noch immer einer der häufigsten Singvögel in Europa.",
                                "translation": "Même si ses populations sont en baisse, le bruant jaune (Emberiza citrinella) reste l'un des oiseaux chanteurs les plus communs en Europe."
                            }
                        ]
                    }
                ],
