                    },
                    {
                        "translation_id": "07b03d13-0d08-424e-b605-affc25ac4f22",
                        "source_entry_id": "25b30506-7308-30ab-a2cd-55cddbd4bc62",
                        "source_sense_id": "f1d0091f-c68c-3eaf-a4c2-6b688f65233c",
                        "source_sense_description": "een toneelvorm begeleid door muziek, gewoonlijk met een goede afloop",
                        "target_lang_word": "melodrama",
