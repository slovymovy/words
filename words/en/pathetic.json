{
    "word_family": [
        "pathos",
        "pathology",
        "pathological",
        "pathos-filled",
        "pathetically"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b2b8d2f0-5988-3728-ac9a-05ae45c58e47",
                    "sense_definition": "Arousing scorn or contempt, often due to being miserably inadequate or weak.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "contemptible",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team's performance was <w>pathetic</w>, as they didn't even manage to score a single point.",
                            "target_lang_translations": {
                                "ru": "Игра команды была <w>жалкой</w>, так как им не удалось набрать ни одного очка."
                            }
                        },
                        {
                            "text": "It is a <w>pathetic</w> excuse to say you forgot your homework for the third time this week.",
                            "target_lang_translations": {
                                "ru": "Это <w>убогое</w> оправдание — говорить, что ты забыл домашнее задание в третий раз за неделю."
                            }
                        }
                    ],
                    "synonyms": [
                        "pitiful",
                        "miserable",
                        "deplorable",
                        "shameful",
                        "disgraceful"
                    ],
                    "antonyms": [
                        "admirable",
                        "impressive",
                        "excellent"
                    ],
                    "common_phrases": [
                        "pathetic excuse",
                        "pathetic attempt",
                        "truly pathetic"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used to express strong disapproval or annoyance"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий презрение или насмешку из-за своей никчемности, слабости или неадекватности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жалкий",
                                "target_lang_sense_clarification": "вызывающий презрение"
                            },
                            {
                                "target_lang_word": "убогий",
                                "target_lang_sense_clarification": "крайне скудный или слабый"
                            },
                            {
                                "target_lang_word": "ничтожный",
                                "target_lang_sense_clarification": "не заслуживающий внимания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd64667b-6412-3385-acef-840902490d23",
                    "sense_definition": "Arousing pity, sympathy, or compassion; moving one to sadness.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lost puppy let out a <w>pathetic</w> cry that made everyone in the street stop and look.",
                            "target_lang_translations": {
                                "ru": "Потерявшийся щенок издал <w>жалобный</w> крик, который заставил всех на улице остановиться и оглянуться."
                            }
                        },
                        {
                            "text": "The child’s <w>pathetic</w> pleas for help touched the hearts of the rescue workers.",
                            "target_lang_translations": {
                                "ru": " <w>Трогательные</w> мольбы ребенка о помощи тронули сердца спасателей."
                            }
                        }
                    ],
                    "synonyms": [
                        "pitiable",
                        "heartbreaking",
                        "sad",
                        "moving",
                        "touching"
                    ],
                    "antonyms": [
                        "cheerful",
                        "joyful"
                    ],
                    "common_phrases": [
                        "pathetic sight",
                        "pathetic pleas",
                        "pathetic cry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий жалость, сочувствие или сострадание; наводящий грусть."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жалостный",
                                "target_lang_sense_clarification": "вызывающий сострадание"
                            },
                            {
                                "target_lang_word": "душераздирающий",
                                "target_lang_sense_clarification": "вызывающий сильную печаль"
                            },
                            {
                                "target_lang_word": "трогательный",
                                "target_lang_sense_clarification": "вызывающий нежные чувства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "531e7f91-3947-30a7-842d-d19f94d817fa",
                    "sense_definition": "Expressing or showing strong emotion, especially anger or passion.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emotional",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The orator delivered a <w>pathetic</w> speech that stirred the crowd into a state of righteous fury.",
                            "target_lang_translations": {
                                "ru": "Оратор произнес <w>патетическую</w> речь, которая привела толпу в состояние праведного гнева."
                            }
                        },
                        {
                            "text": "His <w>pathetic</w> outburst during the meeting revealed just how much pressure he was under.",
                            "target_lang_translations": {
                                "ru": "Его <w>эмоциональная</w> вспышка во время собрания показала, под каким сильным давлением он находился."
                            }
                        }
                    ],
                    "synonyms": [
                        "passionate",
                        "furious",
                        "impassioned"
                    ],
                    "antonyms": [
                        "indifferent",
                        "apathetic",
                        "calm"
                    ],
                    "common_phrases": [
                        "pathetic sermon",
                        "pathetic outburst"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "this sense of being full of passion or anger is rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражающий сильные эмоции, особенно гнев или страсть (устаревшее значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "патетический",
                                "target_lang_sense_clarification": "преисполненный пафоса"
                            },
                            {
                                "target_lang_word": "страстный",
                                "target_lang_sense_clarification": "эмоционально насыщенный"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}