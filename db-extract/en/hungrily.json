                                        "entry_id": "ebece8e6-b81b-35ba-a01b-ee23496167e1",
                                        "glosses": [
                                            "Avec voracité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44ed67e9-51fa-4bac-932f-61c9ce47abfe",
                                                "sense_id": "320b8b76-a074-32f1-83b6-f17664f50770",
                                                "text": "À table, José, qui se tenait mal et mangeait voracement, répétait sa mère, et qui ne s’était pas lavé les mains, racontait sa course dans la lande avec Burthe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5962f22a-bb65-471d-8a8b-15ecb586baed",
                        "source_entry_id": "08f84c34-0b5c-3ce8-8053-2211ac3b34f7",
