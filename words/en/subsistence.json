{
    "word_family": [
        "subsist",
        "subsistent"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "88e337ec-8c02-36ec-afe1-50e14dc90715",
                    "sense_definition": "Something such as food, water, or money that is required to stay alive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "survival",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family struggled to find enough <w>subsistence</w> to survive the harsh winter.",
                            "target_lang_translations": {
                                "zh": "这家人为了在严冬中活下去，竭力寻找足够的<w>生计</w>。"
                            }
                        },
                        {
                            "text": "They rely on small-scale farming for their daily <w>subsistence</w>.",
                            "target_lang_translations": {
                                "zh": "他们依靠小规模耕作来维持日常<w>生计</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sustenance"
                    ],
                    "common_phrases": [
                        "subsistence farming",
                        "means of subsistence"
                    ],
                    "target_lang_definitions": {
                        "zh": "维持生命所必需的食物、水或金钱等基本生活资料。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "生计",
                                "target_lang_sense_clarification": "指维持生活所需的经济来源或基本条件。"
                            },
                            {
                                "target_lang_word": "生活资料",
                                "target_lang_sense_clarification": "指维持生存所必需的物质资料。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "becda78b-7cf6-3d6d-94b5-0128df4a46cf",
                    "sense_definition": "The act of maintaining oneself at a minimum level of survival.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "survival",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The refugees lived at a level of bare <w>subsistence</w> for many months.",
                            "target_lang_translations": {
                                "zh": "难民们在几个月里一直处于勉强<w>维持生存</w>的水平。"
                            }
                        },
                        {
                            "text": "Their income was barely enough for <w>subsistence</w>.",
                            "target_lang_translations": {
                                "zh": "他们的收入仅够勉强<w>维持生存</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bare subsistence"
                    ],
                    "target_lang_definitions": {
                        "zh": "维持最低生存水平的行为或状态。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "维持生存",
                                "target_lang_sense_clarification": "指仅能满足最低限度生存需求的状态。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32a29ee9-f2a0-3d82-aa7f-f351dbe31adf",
                    "sense_definition": "The state of having real being or existence.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "existence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Philosophers often debate the nature of <w>subsistence</w> in abstract concepts.",
                            "target_lang_translations": {
                                "zh": "哲学家们经常探讨抽象概念中<w>存在</w>的本质。"
                            }
                        },
                        {
                            "text": "The theory questions the <w>subsistence</w> of entities beyond physical reality.",
                            "target_lang_translations": {
                                "zh": "该理论质疑物理现实之外实体的<w>存在</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in philosophical or theological contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指事物具有真实存在或本体论意义上的存在状态。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "存在",
                                "target_lang_sense_clarification": "哲学语境下指事物作为实体的客观存在。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6288c718-4972-3506-9a29-e35b62e74559",
                    "sense_definition": "The state of being inherent or existing within something else.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "existence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>subsistence</w> of these properties within the material is essential to the study.",
                            "target_lang_translations": {
                                "zh": "这些属性在材料中的<w>内在性</w>对于这项研究至关重要。"
                            }
                        },
                        {
                            "text": "He analyzed the <w>subsistence</w> of qualities in the physical body.",
                            "target_lang_translations": {
                                "zh": "他分析了物理实体中各种特质的<w>内在性</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in philosophical or scientific contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指某种属性或特质内在于某物之中的状态。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "内在性",
                                "target_lang_sense_clarification": "指事物固有的、存在于内部的属性。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "acc14974-9975-3325-943e-954a89cd3dc1",
                    "sense_definition": "The embodiment or personification of an underlying principle or quality.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "existence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The statue serves as a <w>subsistence</w> of the abstract ideal of justice.",
                            "target_lang_translations": {
                                "zh": "这座雕像作为抽象正义理想的一种<w>体现</w>。"
                            }
                        },
                        {
                            "text": "The concept finds its <w>subsistence</w> in the form of a living person.",
                            "target_lang_translations": {
                                "zh": "这个概念以活人的形式找到了它的<w>体现</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hypostasis"
                    ],
                    "target_lang_definitions": {
                        "zh": "某种基本原则或品质的具体化或体现。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "体现",
                                "target_lang_sense_clarification": "指抽象概念在具体事物中的呈现。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}