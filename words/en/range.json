                },
                {
                    "sense_id": "691330dc-9f6a-3cc7-ba8c-55ffb684c25f",
                    "sense_definition": "An area of open, often unfenced, grazing land.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cattle roam freely on the open <w>range</w>.",
                            "target_lang_translations": {
                                "ru": "Скот свободно бродит на открытом <w>пастбище</w>.",
                                "tr": "Büyükbaş hayvanlar açık <w>merada</w> özgürce dolaşır.",
                                "zh": "牛群在开阔的<w>牧场</w>上自由漫步。"
                            }
                        },
                        {
                            "text": "Life on the <w>range</w> can be lonely for a cowboy.",
                            "target_lang_translations": {
                                "ru": "Жизнь на <w>пастбище</w> может быть одинокой для ковбоя.",
                                "tr": "<w>Otlakta</w> yaşam bir kovboy için yalnız geçebilir.",
                                "zh": "对于牛仔来说，<w>牧场</w>上的生活可能会很孤独。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "home on the range",
                        "open range"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Участок открытой, часто неогороженной земли для выпаса скота.",
                        "tr": "Geniş, çoğunlukla etrafı çevrilmemiş otlatma arazisi.",
                        "zh": "一片开阔的、通常没有围栏的放牧土地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пастбище",
                                "target_lang_sense_clarification": "место выпаса"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "mera",
                                "target_lang_sense_clarification": "otlatma alanı"
