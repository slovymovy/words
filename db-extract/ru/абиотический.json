                                        "sense_id": "23c67b8d-db49-3e86-bc15-018e67e7d34b",
                                        "entry_id": "ebb9a51f-c64a-3fed-8f2f-7b4060e85cff",
                                        "glosses": [
                                            "unbelebt, nicht durch das Leben bedingt, nicht durch biologische Systeme bedingt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cbfcc0a-f7f3-4528-82f2-f2028281faa2",
                                                "sense_id": "23c67b8d-db49-3e86-bc15-018e67e7d34b",
                                                "text": "Dabei betrachten die Wissenschaftler die taxonomische Zusammensetzung, Diversität, die Evolutionsgeschichte sowie biogeografische Affinitäten der Dinosaurierfaunen des mittleren und späten Jura, sie berücksichtigen zudem abiotische Einflussfaktoren wie Geografie und Klima."
                                            }
