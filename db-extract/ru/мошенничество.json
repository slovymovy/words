                                        "entry_id": "b206c9b0-896c-3f5e-b279-e2939a4e8c04",
                                        "glosses": [
                                            "Any act of deception carried out for the purpose of unfair, undeserved or unlawful gain."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4713e302-81f6-49bc-b929-dd3d0aa73185",
                                                "sense_id": "99543030-f638-3777-b374-befc9f58a601",
                                                "text": "When success a lover's toil attends, / Few ask, if fraud or force attain'd his ends."
                                            },
                                            {
                                                "example_id": "8e7085fd-d97b-44eb-95ef-3587486b9d2b",
                                                "sense_id": "99543030-f638-3777-b374-befc9f58a601",
                                                "text": "But electric vehicles and the batteries that made them run became ensnared in corporate scandals, fraud, and monopolistic corruption that shook the confidence of the nation and inspired automotive upstarts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e37c52e-fb19-3042-acae-71352b4fbc41",
                                        "entry_id": "b206c9b0-896c-3f5e-b279-e2939a4e8c04",
                                        "glosses": [
                                            "The assumption of a false identity to such deceptive end."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1343c2c6-a198-3028-accb-57e5bc2bc112",
                                        "entry_id": "b206c9b0-896c-3f5e-b279-e2939a4e8c04",
                                        "glosses": [
                                            "A person who performs any such trick."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
