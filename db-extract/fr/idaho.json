                        "entry_id": "94dee4be-f99a-3426-8814-3ac5ed32e859",
                        "glosses": [
                            "Un des cinquante États des États-Unis d’Amérique (code postal ID), bordé par le Canada (Colombie-Britannique) au nord, le Montana au nord-est, le Wyoming à l’est, l’Utah au sud-est, le Nevada au sud-ouest, l’Oregon à l’ouest, et l’État de Washington au nord-ouest. Sa capitale est Boise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a376e04e-a8c7-4ac1-9bbb-e9ad597db677",
                                "sense_id": "160e1a2a-8587-3f2f-8159-0fe8fc5cc0a6",
                                "text": "Je vis en Idaho."
                            }
                        ]
                    }
