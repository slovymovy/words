                ],
                "senses": [
                    {
                        "sense_id": "fe5fe78d-157d-359d-b36c-b0f56a595f41",
                        "entry_id": "3a331294-0d30-3d25-9099-f22cfb133bfe",
                        "glosses": [
                            "Association d’entreprises, sous contrôle familial, juridiquement distinctes, concentrant des activités horizontalement et verticalement."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "e263816b-7b46-4da1-a16a-35d6007eacdb",
                                "sense_id": "fe5fe78d-157d-359d-b36c-b0f56a595f41",
                                "text": "Rarement on a vu autant de konzerns en première ligne du mouvement de fusions et acquisitions qui agitent actuellement l’Europe des affaires."
                            },
                            {
                                "example_id": "bb16f4b1-c72f-4516-beb8-318fc2676a72",
                                "sense_id": "fe5fe78d-157d-359d-b36c-b0f56a595f41",
                                "text": "La reconcentration et la recartellisation de la Ruhr ont atteint un point qui fait que les cartels et les « konzernen » sont plus puissants en 1957 qu'en 1939."
                            },
                            {
                                "example_id": "c22669d5-e1d8-4e34-8ffb-081c809b7eca",
                                "sense_id": "fe5fe78d-157d-359d-b36c-b0f56a595f41",
                                "text": "En 1976 j'ai fait observer que l'audace d'une demande présentée par un konzern allemand afin de s'agrandir encore était un peu forte. La demande fut retirée, c'est-à-dire que la recartellisation fut acquise sans autorisation !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1131d8f4-7815-4376-9cab-7874c176aaa5",
                        "source_entry_id": "3a331294-0d30-3d25-9099-f22cfb133bfe",
                        "source_sense_id": "fe5fe78d-157d-359d-b36c-b0f56a595f41",
                        "target_lang_word": "Konzern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Konzern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b89d5d99-8e96-3c13-9d2a-1bb8be59df4f",
                                        "entry_id": "9038263b-09e3-3683-9b94-81eccc233474",
                                        "glosses": [
                                            "Zusammenschluss von mehreren selbstständigen Unternehmen unter einer einheitlichen wirtschaftlichen Führung mit dem Zweck der Kostenersparnis"
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a126cb0a-feb7-4675-99b9-64429cec2b45",
                                                "sense_id": "b89d5d99-8e96-3c13-9d2a-1bb8be59df4f",
                                                "text": "Siemens ist ein großer Konzern."
                                            },
                                            {
                                                "example_id": "4f641642-419d-42bd-9d09-e8f84eaeff61",
                                                "sense_id": "b89d5d99-8e96-3c13-9d2a-1bb8be59df4f",
                                                "text": "Konzerne haben eine große Bedeutung für die Wirtschaft."
                                            },
                                            {
                                                "example_id": "24ce6d65-a6e1-45c9-87eb-11a13220a107",
                                                "sense_id": "b89d5d99-8e96-3c13-9d2a-1bb8be59df4f",
                                                "text": "„Den Einstieg in das Audi-Q-niversum bildet allerdings der kleine Q1, der womöglich schon 2015 vorgestellt wird. Er basiert auf der Kleinwagen-Plattform des Konzerns, wird aber nicht in Tschechien, sondern in Ingolstadt gefertigt.“"
                                            },
                                            {
                                                "example_id": "077b64a2-3207-40bb-9da6-e7eafd8af009",
                                                "sense_id": "b89d5d99-8e96-3c13-9d2a-1bb8be59df4f",
                                                "text": "„Viele Konzerne verursachen riesige Mengen CO₂.“"
                                            },
                                            {
                                                "example_id": "e1367c5f-d994-4e8d-9d76-d2b88a4f9b8b",
                                                "sense_id": "b89d5d99-8e96-3c13-9d2a-1bb8be59df4f",
                                                "text": "„Durch seine Zementproduktion hat der Konzern zwischen 1950 und 2021 mehr als sieben Milliarden Tonnen CO₂ ausgestoßen, was mehr als doppelt so viel ist wie die gesamte Schweiz verursacht hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04fce56c-2acc-41ea-ada7-16cefe28d1e6",
                        "source_entry_id": "3a331294-0d30-3d25-9099-f22cfb133bfe",
                        "source_sense_id": "fe5fe78d-157d-359d-b36c-b0f56a595f41",
                        "target_lang_word": "concern",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "concern",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1da40202-9ed7-3fe0-9265-86cdbcce49c5",
                                        "entry_id": "f5de5b57-6b6a-3170-a19f-6a61b8a1f244",
                                        "glosses": [
                                            "That which affects one’s welfare or happiness. A matter of interest to someone."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0bbc339-b4e6-4bb0-95a4-83343db7a4bb",
                                                "sense_id": "1da40202-9ed7-3fe0-9265-86cdbcce49c5",
                                                "text": "Mark’s health was of great concern to Connie."
                                            },
                                            {
                                                "example_id": "3f89fe0b-4ec9-4c65-9a66-80bf223af65a",
                                                "sense_id": "1da40202-9ed7-3fe0-9265-86cdbcce49c5",
                                                "text": "We drove back to the office with some concern on my part at the prospect of so large a case. Sunning himself on the board steps, I saw for the first time Mr. Farquhar Fenelon Cooke. He was dressed out in broad gaiters and bright tweeds, like an English tourist, and his face might have belonged to Dagon, idol of the Philistines."
                                            },
                                            {
                                                "example_id": "e8d4300c-fe8d-4bd8-88fd-ea94aa2291bf",
                                                "sense_id": "1da40202-9ed7-3fe0-9265-86cdbcce49c5",
                                                "text": "Although the encounter was bathed in sunshine, the match failed to reach boiling point but that will be of little concern to Gerard Houllier’s team, who took a huge step forward before they face crucial matches against their relegation rivals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9849577-4c79-36f6-9fd3-3df7c7726630",
                                        "entry_id": "f5de5b57-6b6a-3170-a19f-6a61b8a1f244",
                                        "glosses": [
                                            "The placement of interest or worry on a subject."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25e28768-745b-4338-ac0b-b25f0234b56d",
                                                "sense_id": "d9849577-4c79-36f6-9fd3-3df7c7726630",
                                                "text": "Most people in Australia have no concern for the recent events in London."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f13f94f-40c8-31f4-8fa4-434a645a0797",
                                        "entry_id": "f5de5b57-6b6a-3170-a19f-6a61b8a1f244",
                                        "glosses": [
                                            "A worry; a sense that something may be wrong; an identification of a possible problem."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efa0b7f8-1eb0-423e-a84c-b5accffe7739",
                                                "sense_id": "1f13f94f-40c8-31f4-8fa4-434a645a0797",
                                                "text": "Let me know if you have any questions or concerns about the document."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78609c54-02cf-3b6f-88bb-dcf5450f1ef0",
                                        "entry_id": "f5de5b57-6b6a-3170-a19f-6a61b8a1f244",
                                        "glosses": [
                                            "The expression of solicitude, anxiety, or compassion toward a thing or person."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4ad863e-e715-49c5-9f02-5a3a86dabc63",
                                                "sense_id": "78609c54-02cf-3b6f-88bb-dcf5450f1ef0",
                                                "text": "Judy's eyes filled with concern as she listened to the news report."
                                            },
                                            {
                                                "example_id": "210f4551-34d3-42ad-93ff-b9c73eceee4b",
                                                "sense_id": "78609c54-02cf-3b6f-88bb-dcf5450f1ef0",
                                                "text": "Appleby […] rose from his seat when Morales came in. He shook hands urbanely, unbuckled his sword, and laid his kepi on the table, and then sat down with an expression of concern in his olive face which Appleby fancied was assumed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad7a09c5-b437-3526-94b4-0dd8b064d28c",
                                        "entry_id": "f5de5b57-6b6a-3170-a19f-6a61b8a1f244",
                                        "glosses": [
                                            "A business, firm or enterprise; a company."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3c47e6c-540a-4a15-80ac-ef7229ae53fd",
                                                "sense_id": "ad7a09c5-b437-3526-94b4-0dd8b064d28c",
                                                "text": "The employees’ attitude is really hurting the concern."
                                            },
                                            {
                                                "example_id": "363513e2-9a6f-4328-bfab-78fa7c054e34",
                                                "sense_id": "ad7a09c5-b437-3526-94b4-0dd8b064d28c",
                                                "text": "a going concern"
                                            },
                                            {
                                                "example_id": "efc223d0-4828-4578-9d02-161b5fbdfd89",
                                                "sense_id": "ad7a09c5-b437-3526-94b4-0dd8b064d28c",
                                                "text": "Then I remembered there was a big concern, a Company for trade on that river."
                                            },
                                            {
                                                "example_id": "97d81c50-721a-4e8c-bb90-e81296735697",
                                                "sense_id": "ad7a09c5-b437-3526-94b4-0dd8b064d28c",
                                                "text": "Soon after he ascended the throne, an Arabic television joint venture between the BBC and a Saudi concern, Orbit Communications, foundered over the BBC’s insistence on editorial independence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1b82a39-a258-34a8-8a45-d0e193893d86",
                                        "entry_id": "f5de5b57-6b6a-3170-a19f-6a61b8a1f244",
                                        "glosses": [
                                            "Any set of information that affects the code of a computer program."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a381921-efaf-4363-b206-4b5f4a27fb73",
                                                "sense_id": "e1b82a39-a258-34a8-8a45-d0e193893d86",
                                                "text": "At the programming level, an aspect is a modular unit that implements a concern."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "concern",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f14d95fc-a9c6-32e3-8209-3709c72a09cf",
                                        "entry_id": "d4794756-cdb4-3c35-8706-3048d148e0ba",
                                        "glosses": [
                                            "To relate or belong to; to have reference to or connection with; to affect the interest of; to be of importance to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c59c68b-8608-40ab-986a-6515cd5916f5",
                                                "sense_id": "f14d95fc-a9c6-32e3-8209-3709c72a09cf",
                                                "text": "Preaching the kingdom of God, and teaching those things which concern the Lord Jesus Christ."
                                            },
                                            {
                                                "example_id": "cac4af8c-de11-42bf-9870-6e56eec270df",
                                                "sense_id": "f14d95fc-a9c6-32e3-8209-3709c72a09cf",
                                                "text": "our wars with France have always affected us in our most tender interests, and concerned us more than those we have had with any other nation"
                                            },
                                            {
                                                "example_id": "f87c8104-4379-46a0-886a-9ec9cde6d00e",
                                                "sense_id": "f14d95fc-a9c6-32e3-8209-3709c72a09cf",
                                                "text": "ignorant, so far as the usual instruction was concerned"
                                            },
                                            {
                                                "example_id": "8ec13788-f934-4e30-b4c5-bf2e40addc34",
                                                "sense_id": "f14d95fc-a9c6-32e3-8209-3709c72a09cf",
                                                "text": "As a political system democracy seems to me extraordinarily foolish, but I would not go out of my way to protest against it. My servant is, so far as I am concerned, welcome to as many votes as he can get. I would very gladly make mine over to him if I could."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "966aa75a-182e-3f8b-baaf-c47ac914f3cd",
                                        "entry_id": "d4794756-cdb4-3c35-8706-3048d148e0ba",
                                        "glosses": [
                                            "To engage by feeling or sentiment; to interest."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68841669-14a5-47af-a39b-3e00f0e60158",
                                                "sense_id": "966aa75a-182e-3f8b-baaf-c47ac914f3cd",
                                                "text": "A good prince concerns himself in the happiness of his subjects."
                                            },
                                            {
                                                "example_id": "c51901ed-c76d-4804-b5c9-3ef6867c8f14",
                                                "sense_id": "966aa75a-182e-3f8b-baaf-c47ac914f3cd",
                                                "text": "They think themselves out the reach of Providence, and no longer concerned to solicit his favour."
                                            },
                                            {
                                                "example_id": "2b647ec5-bb71-4e2a-9a2c-39ba4d933966",
                                                "sense_id": "966aa75a-182e-3f8b-baaf-c47ac914f3cd",
                                                "text": "It had been his intention to go to Wimbledon, but as he himself said: “Why be blooming well frizzled when you can hear all the results over the wireless. And results are all that concern me.[…]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "122c9201-4fa9-3813-9989-9246c04e4fb5",
                                        "entry_id": "d4794756-cdb4-3c35-8706-3048d148e0ba",
                                        "glosses": [
                                            "To make somebody worried."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ea9bd60-2bb7-4977-9b03-8dc544cf2baa",
                                                "sense_id": "122c9201-4fa9-3813-9989-9246c04e4fb5",
                                                "text": "I’m concerned that she’s becoming an alcoholic."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
