                "senses": [
                    {
                        "sense_id": "6ab9a0d7-80f2-3c04-a00f-278707f646a1",
                        "entry_id": "12cb7f96-b837-3ca0-99f7-a6cfa1bfc7a0",
                        "glosses": [
                            "lijst met boeken die het meest verkocht worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc1ea178-741a-4b53-b82f-2fcbd150bf00",
                                "sense_id": "6ab9a0d7-80f2-3c04-a00f-278707f646a1",
                                "text": "Sinds de Engelse vertaling eerder dit jaar verscheen klom het boek op tot nummer 1 op de bestsellerlijst van Amazon. Momenteel is het gezakt naar de tweede plaats, maar dat is waarschijnlijk vooral omdat het inmiddels moeilijk te krijgen is. Bij Amazon zelf is het boek namelijk uitverkocht, het e-book is natuurlijk nog wel te koop."
                            },
                            {
                                "example_id": "b6860f8c-151e-41d6-8288-9c18ba83bd2a",
                                "sense_id": "6ab9a0d7-80f2-3c04-a00f-278707f646a1",
                                "text": "En dat heeft weer gevolgen voor Hachette. De ruzie duurt nu al een maand en sindsdien is de uitgever van de toppositie op de bestsellerlijst van ebooks gekukeld."
                            },
                            {
                                "example_id": "97b8a86b-a0dd-460c-a99b-ee9569c48f10",
                                "sense_id": "6ab9a0d7-80f2-3c04-a00f-278707f646a1",
                                "text": "Piketty publiceerde zijn boek in 2013 in het Frans. De Engelse vertaling verscheen in maart en klom meteen naar de nummer 1-positie op de bestsellerlijst van Amazon. In Nederland werd er tussen uitgevers gestreden om de rechten van de Nederlandse vertaling. De Bezige Bij won."
                            }
                        ]
                    }
