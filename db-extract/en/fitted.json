            {
                "entry_id": "de303b3b-8fa4-3532-ab07-effed7df89d9",
                "word": "fitted",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7877df11-a8f1-4b5a-90bc-3365372b43bb",
                        "entry_id": "de303b3b-8fa4-3532-ab07-effed7df89d9",
                        "tags": [
                            "plural"
                        ],
                        "form": "fitteds"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d48e3ad5-9c90-3d9d-a7e3-f1342edbaff7",
                        "entry_id": "de303b3b-8fa4-3532-ab07-effed7df89d9",
                        "glosses": [
                            "A fitted cap."
                        ],
                        "tags": [
                            "US",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "929ab7fb-a467-4675-ae77-2b2d59d4110a",
                                "sense_id": "d48e3ad5-9c90-3d9d-a7e3-f1342edbaff7",
                                "text": "For niggas plottin, I might blow it at your fitted\nGet your bitch-ass slimed out, it ain't no kiddin\nAin't no kiddin, got that semi"
                            },
                            {
                                "example_id": "ffda401b-9f91-4937-b8c3-c88f2d9ad03d",
                                "sense_id": "d48e3ad5-9c90-3d9d-a7e3-f1342edbaff7",
                                "text": "Late night, on a drill, aimin for his fitted"
                            }
                        ]
                    },
                    {
                        "sense_id": "e5ffe05d-05ec-3fd4-a5ab-415a28175e64",
                        "entry_id": "de303b3b-8fa4-3532-ab07-effed7df89d9",
                        "glosses": [
                            "A fitted diaper."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9b7d38f-05b6-4938-9eef-775138b4e62c",
                                "sense_id": "e5ffe05d-05ec-3fd4-a5ab-415a28175e64",
                                "text": "Fitteds have elastic around the back of the diaper and the legs of the diaper to get a better fit and sometimes they also have snap closures so that you don't have to use a diaper fastener."
                            },
                            {
                                "example_id": "176477d7-b115-4500-8708-64164defbdb6",
                                "sense_id": "e5ffe05d-05ec-3fd4-a5ab-415a28175e64",
                                "text": "Pocket diapers are my favorite because they're a little easier to use than fitteds, flats, and prefolds, and they're cheaper than all-in-twos and all-in-ones."
                            },
                            {
                                "example_id": "1e37f022-c9fa-4427-bedb-191411e8ac40",
                                "sense_id": "e5ffe05d-05ec-3fd4-a5ab-415a28175e64",
                                "text": "Many natural fibres wear down with use. This is called edge wear. Depending on the wash routine (detergent strength, agitation, water pH, and more factors) edge wear happens quicker for some people. This happens with fitteds too."
                            }
                        ]
                    }
                ],
