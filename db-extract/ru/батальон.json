                    {
                        "translation_id": "a0938979-52c5-42d9-a7a8-973d89aafd33",
                        "source_entry_id": "3e753b1b-d8e8-3a3d-a463-5b9e87ef217c",
                        "source_sense_description": "воинское подразделение",
                        "target_lang_word": "Bataillon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bataillon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fe76954b-154f-3d4c-9381-a678ea9c2e9d",
                                        "entry_id": "945498c2-6b09-314f-ada0-1557ba408b4e",
                                        "glosses": [
                                            "ein Verband von Streitkräften, der aus unterschiedlich ausgerüsteten Teilverbänden einer Truppengattung zusammengesetzt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1af0381f-2d0a-4fe0-a7d7-beabb0290fbf",
                                                "sense_id": "fe76954b-154f-3d4c-9381-a678ea9c2e9d",
                                                "text": "Ein Bataillon wird normalerweise von einem Major oder Oberstleutnant geführt."
                                            },
                                            {
                                                "example_id": "9c201fac-4116-4ff8-b0c3-70eed81cc858",
                                                "sense_id": "fe76954b-154f-3d4c-9381-a678ea9c2e9d",
                                                "text": "„Von Osten ließen nun die Franzosen neun frische Bataillone gegen die gelichteten deutschen Reihen aufmarschieren.“"
                                            },
                                            {
                                                "example_id": "684785a7-31b3-45b5-a5d3-c603de5bedfa",
                                                "sense_id": "fe76954b-154f-3d4c-9381-a678ea9c2e9d",
                                                "text": "„Das Bataillon lag am Ufer zur Linken.“"
                                            },
                                            {
                                                "example_id": "7d0aea8b-8ebb-4891-8dbf-2ae170802fe3",
                                                "sense_id": "fe76954b-154f-3d4c-9381-a678ea9c2e9d",
                                                "text": "„Das dritte Bataillon soll die französischen Vorposten überfallen.“"
                                            },
                                            {
                                                "example_id": "5d5b4e63-4dc1-41d1-9fff-cfe89f378399",
                                                "sense_id": "fe76954b-154f-3d4c-9381-a678ea9c2e9d",
                                                "text": "„Die Türme von Smolensk vor Augen, biwakierte das Bataillon im Apfelgarten eines verlassenen Gutshauses.“"
                                            },
                                            {
                                                "example_id": "e4500f07-cf7f-4528-9657-3f6ad478d6ac",
                                                "sense_id": "fe76954b-154f-3d4c-9381-a678ea9c2e9d",
                                                "text": "„Während der Verhandlungen wuchs Mugabes Misstrauen gegenüber den Südafrikanern, deren neuer Premierminister Pieter Willem Botha die Anwesenheit zweier südafrikanischer Bataillone in Rhodesien zugegeben hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20a53ac6-c49a-4ad4-9e69-b30c207386d7",
                        "source_entry_id": "3e753b1b-d8e8-3a3d-a463-5b9e87ef217c",
                        "source_sense_description": "воинское подразделение",
                        "target_lang_word": "bataillon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bataillon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a9edc1b-d56d-3e8c-8dbd-84dcfb16a5e0",
                                        "entry_id": "2aaf729e-f0b9-3b76-802a-3ee96c0e28b4",
                                        "glosses": [
                                            "Troupe en ordre de bataille."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bfc5740-2522-4c75-840d-d9c30a74accd",
                                                "sense_id": "7a9edc1b-d56d-3e8c-8dbd-84dcfb16a5e0",
                                                "text": "Aux armes, citoyens !\nFormez vos bataillons !\nMarchons, marchons !\nQu’un sang impur…\nAbreuve nos sillons !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15cf79c5-5d2d-3c2f-8be0-167a98ab4dd7",
                                        "entry_id": "2aaf729e-f0b9-3b76-802a-3ee96c0e28b4",
                                        "glosses": [
                                            "Troupe composée de plusieurs compagnies et faisant ordinairement partie d’un régiment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf920438-85a5-4a6d-9a63-7be2cfdf9ba6",
                                                "sense_id": "15cf79c5-5d2d-3c2f-8be0-167a98ab4dd7",
                                                "text": "Le bataillon revint en France à la fin de janvier 1814. Il faisait partie de cette division Leval qui, comptant à peine 8.000 hommes, eut à lutter à Bar-sur-Aube contre une armée de 40.000 ennemis. On appela le 3ᵉ régiment « le brave parmi les braves »."
                                            },
                                            {
                                                "example_id": "0beca0a8-4f6e-41df-b4e5-913aa2bca18b",
                                                "sense_id": "15cf79c5-5d2d-3c2f-8be0-167a98ab4dd7",
                                                "text": "Seuls les brancardiers sont prêts; ils sont même partis : il faut les arrêter de force et les faire passer à l’arrière du bataillon."
                                            }
                                        ]
                                    },
                                    {
