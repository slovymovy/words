                ],
                "senses": [
                    {
                        "sense_id": "8f2f1081-81e5-3fbf-bb29-48d591def4a9",
                        "entry_id": "c6b17bb9-6af0-3c0f-b021-8230c5ba06c9",
                        "glosses": [
                            "Exciter sexuellement un mâle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d0143f3-7f60-4496-a8b2-4c3afb9804f8",
                                "sense_id": "8f2f1081-81e5-3fbf-bb29-48d591def4a9",
                                "text": "Il semble alors, vraiment, que dans l’homme, l’animalité primitive d’un satyre priapise."
                            },
                            {
                                "example_id": "cca4c069-b344-4300-8391-89d1dffd4a17",
                                "sense_id": "8f2f1081-81e5-3fbf-bb29-48d591def4a9",
                                "text": "Ce petit Daudet, il est particulier, il est étrange et a, par moments, des foucades tout à fait en dehors de notre vie de bons bourgeois. Le vin le priapise d’une manière folle et capricante."
                            },
                            {
                                "example_id": "773c70a4-7edb-4a4e-9a30-bc209eadac3d",
                                "sense_id": "8f2f1081-81e5-3fbf-bb29-48d591def4a9",
                                "text": "À une époque où tout priapise, où tout est lascif, on devrait interdire la conjonction tarifée des voluptés ?"
                            },
                            {
                                "example_id": "61f3240a-0e64-4315-bb75-daa206cae2ce",
                                "sense_id": "8f2f1081-81e5-3fbf-bb29-48d591def4a9",
                                "text": "« Ces types-là priapisent », m’avait dit un jour un polar."
                            }
                        ]
                    }
                ],
