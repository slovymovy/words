            {
                "entry_id": "78e58c53-8b5f-3c32-972d-7550145ce6f0",
                "word": "dunette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fa8b02ea-2057-4297-8abd-7a9599330f67",
                        "entry_id": "78e58c53-8b5f-3c32-972d-7550145ce6f0",
                        "tags": [
                            "plural"
                        ],
                        "form": "dunettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9847e2a5-d5dd-3934-ba1a-c728f3cfc280",
                        "entry_id": "78e58c53-8b5f-3c32-972d-7550145ce6f0",
                        "glosses": [
                            "Construction élevée sur le gaillard d’arrière de certains navires pour y loger des officiers, et principalement le commandant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a807617-8e4e-41c4-b8ed-d2ecc6946f0a",
                                "sense_id": "9847e2a5-d5dd-3934-ba1a-c728f3cfc280",
                                "text": "Cette nuit avait paru, sans doute, trop noire et trop orageuse aux passagers, car Philippe n’en vit aucun sur la dunette."
                            },
                            {
                                "example_id": "2bc2e0f0-27e2-4e5d-85b5-71f2616b5291",
                                "sense_id": "9847e2a5-d5dd-3934-ba1a-c728f3cfc280",
                                "text": "On communique d’un gaillard à l’autre par les passe-avans, et les dunettes sont établies à l’extrémité du gaillard d’arrière."
                            },
                            {
                                "example_id": "3d0582c0-be67-4fa6-a625-b43cf2c29be9",
                                "sense_id": "9847e2a5-d5dd-3934-ba1a-c728f3cfc280",
                                "text": "Martinez demeura seul sur la dunette et porta ses yeux vers l’Asia, qui naviguait sous le vent du brick."
                            }
                        ]
                    },
                    {
                        "sense_id": "cc9f63a8-99df-3101-878d-b3b7bda1da52",
                        "entry_id": "78e58c53-8b5f-3c32-972d-7550145ce6f0",
                        "glosses": [
                            "Partie supérieure de la dunette formant un pont."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "419a9915-a334-43e7-b846-07782f61d3f6",
                                "sense_id": "cc9f63a8-99df-3101-878d-b3b7bda1da52",
                                "text": "La dunette sert souvent de lieu de promenade aux officiers."
                            },
                            {
                                "example_id": "df274d7c-a2a5-4f10-866b-36dc2b46bcb7",
                                "sense_id": "cc9f63a8-99df-3101-878d-b3b7bda1da52",
                                "text": "Le mercredi matin à 5 heures, Le Gonidec, son quart étant tiré, quitte la dunette. Il prend un peu de repos et remonte."
                            },
                            {
                                "example_id": "344f80f5-c318-4190-a224-ff54679e3453",
                                "sense_id": "cc9f63a8-99df-3101-878d-b3b7bda1da52",
                                "text": "Régulièrement, un bœuf, qui représentait quatre jours de nourriture pour l’ensemble de l’équipage, était égorgé sur la dunette. Son sang se déversait en une cascade poisseuse dans la mer où se précipitaient les mouettes."
                            }
                        ]
                    },
                    {
                        "sense_id": "609d43cf-cb2a-3f88-a3dd-a9436c107514",
                        "entry_id": "78e58c53-8b5f-3c32-972d-7550145ce6f0",
                        "glosses": [
                            "Synonyme de diguette."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c92e23a-21be-4b50-8262-153944115ce2",
                                "sense_id": "609d43cf-cb2a-3f88-a3dd-a9436c107514",
                                "text": "Sous leurs pieds, la dunette s’effondrait de plus en plus souvent."
                            }
                        ]
                    }
                ],
