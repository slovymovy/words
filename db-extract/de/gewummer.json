                "senses": [
                    {
                        "sense_id": "c402358b-f58b-383c-a5ae-d8b2d81e4f7a",
                        "entry_id": "8e68125e-9f5d-3b95-bf41-6bd80138dfc4",
                        "glosses": [
                            "rhythmisches dröhnendes Bassgeräusch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c4f8c98-ebb0-49df-89a6-fd9422391024",
                                "sense_id": "c402358b-f58b-383c-a5ae-d8b2d81e4f7a",
                                "text": "„Von nebenan drang ein monotones Geschepper und Gewummer durch die Wand: Hannes hörte Musik, eine seiner Bands, Dead Art oder Linkin' Park oder so was.“"
                            },
                            {
                                "example_id": "0e47b69f-43b2-4e03-b2bc-9eeea3af936a",
                                "sense_id": "c402358b-f58b-383c-a5ae-d8b2d81e4f7a",
                                "text": "„Ich drehte das Seitenfenster ein Stück herunter und hörte schon das Gewummer der Bässe.“"
                            },
                            {
                                "example_id": "a5c5dca6-d0b1-4cd5-aae3-75acd81addab",
                                "sense_id": "c402358b-f58b-383c-a5ae-d8b2d81e4f7a",
                                "text": "„Ich hoffe, mir wird nicht wieder schlecht, mit diesem Gewummer und Gedröhne, das meine Organe von innen nach außen zittern lässt.“"
                            },
                            {
                                "example_id": "2e3ef017-74d2-4844-9f16-fb219e18a91e",
                                "sense_id": "c402358b-f58b-383c-a5ae-d8b2d81e4f7a",
                                "text": "„Vom Horizont her klang ununterbrochen aufregendes Gewummer großer Geschütze.“"
                            },
                            {
                                "example_id": "78d92611-ded0-4458-a20a-40ad6d73bf0a",
                                "sense_id": "c402358b-f58b-383c-a5ae-d8b2d81e4f7a",
                                "text": "„Das Gewummer setzte wieder ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
