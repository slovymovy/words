            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f2f6e627-c144-390c-9084-5ed87ac26900",
                    "sense_definition": "het op grote schaal verbouwen van gewassen of planten voor voedsel of handel",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "landbouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We <w>telen</w> tomaten in onze achtertuin voor eigen gebruik.",
                            "target_lang_translations": {
                                "en": "We <w>grow</w> tomatoes in our backyard for our own use."
                            }
                        },
                        {
                            "text": "In deze regio <w>telen</w> ze voornamelijk tarwe op de grote akkers.",
                            "target_lang_translations": {
                                "en": "In this region, they mainly <w>cultivate</w> wheat on the large fields."
                            }
                        }
                    ],
                    "synonyms": [
                        "verbouwen",
                        "kweken"
                    ],
                    "common_phrases": [
                        "gewassen telen",
                        "groenten telen"
                    ],
                    "target_lang_definitions": {
