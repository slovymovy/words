                                    {
                                        "sense_id": "33aced28-aa55-3cab-b254-77a59e01bc03",
                                        "entry_id": "75fe4395-6213-3e0c-8c95-4aaa835b58ff",
                                        "glosses": [
                                            "jednotka délky o rozměru tisíciny metru"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cece4f1f-490e-4af9-86c5-781ef40c93ce",
                                                "sense_id": "33aced28-aa55-3cab-b254-77a59e01bc03",
                                                "text": "Každou minutu někde v Česku přibude 7 milimetrů dálnice."
                                            },
                                            {
                                                "example_id": "9b7335c1-9e9d-41be-8e93-b886ff202f5f",
                                                "sense_id": "33aced28-aa55-3cab-b254-77a59e01bc03",
                                                "text": "Když se podíváme, že na spoustě míst napršelo 20 nebo 30 milimetrů vody, a řeknu, že nám chybí třeba 400 milimetrů srážek, tak bychom potřebovali měsíc takovéhoto deště, aby nám to doplnilo srážkový deficit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b784562-087a-4072-9f93-9d2146dc76c4",
                        "source_entry_id": "f6bd6706-6147-3ab4-ba4d-522c820529bd",
                        "source_sense_id": "841da8c9-b44f-30f2-950e-abb919096ae8",
                        "target_lang_word": "millimètre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "millimètre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e2409cca-c371-37cd-9b74-10d2e61ff57e",
                                        "entry_id": "4b496e97-a45d-33f2-a8e4-464636bb4cd6",
                                        "glosses": [
                                            "Unité de mesure de longueur du Système international (SI), valant 10⁻³ mètre, et dont le symbole est mm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfae557e-e30f-4396-bd8e-f2520c9cd7b8",
                                                "sense_id": "e2409cca-c371-37cd-9b74-10d2e61ff57e",
                                                "text": "On fabrique actuellement des tubes capillaires en verre excessivement fins. Ceux-ci, étirés par des ouvriers spéciaux, ont d’ordinaire une ouverture de deux dixième de millimètre."
                                            },
                                            {
                                                "example_id": "66eb219b-2d14-4b64-99d7-e498a4d2d521",
                                                "sense_id": "e2409cca-c371-37cd-9b74-10d2e61ff57e",
                                                "text": "Il aligna ses pistolets sur une table de marbre, à côté de lui. Il les graissa, les essuya, fit jouer les ressorts à vide, il en lima soigneusement les détentes : « Ça part au millimètre », dit-il."
                                            },
                                            {
                                                "example_id": "232d0906-13e3-4d2e-8214-148d9a009f28",
                                                "sense_id": "e2409cca-c371-37cd-9b74-10d2e61ff57e",
                                                "text": "Quelques millimètres pesant quelques microgrammes de l’essence même de la vie. Obtenus après avoir lysé les globules blancs et séparé par centrifugation le précieux ADN du reste du matériel cellulaire."
                                            },
                                            {
                                                "example_id": "dd1fcf79-93d2-46ce-958a-f6f5b208906c",
                                                "sense_id": "e2409cca-c371-37cd-9b74-10d2e61ff57e",
                                                "text": "Le front orageux n’arrosera pas l’ensemble du territoire de façon homogène. Tendanciellement, il sera plus généreux à proximité du Massif central, avec des totaux de l’ordre de 50 millimètres d’eau, que sur la frange littorale."
                                            }
                                        ]
                                    }
                                ]
                            },
