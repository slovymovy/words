                                                "sense_id": "2f40f213-cb63-317f-867e-aeb374fac621",
                                                "text": "It costs a fortune these days to fill up."
                                            },
                                            {
                                                "example_id": "7ff73391-4133-4c3e-b7de-843cc66dba3d",
                                                "sense_id": "2f40f213-cb63-317f-867e-aeb374fac621",
                                                "text": "\"Game over,\" Waddicor warns. \"Look at the fuel gauge. Someone's forgotten to fill up.\" The heavily laden train has come from Freightliner's Maritime Terminal in Southampton's western docks. Waddicor reckons there might not be enough diesel in the tank to complete the journey."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1eda4de-ed67-3663-8eff-998013ecb28c",
                                        "entry_id": "04692cee-17d2-3929-9613-e66e2b034a1a",
                                        "glosses": [
                                            "To become completely full."
                                        ],
                                        "tags": [
