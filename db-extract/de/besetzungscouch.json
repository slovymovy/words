                "senses": [
                    {
                        "sense_id": "61f8f542-561b-3af9-91ee-479e6b127505",
                        "entry_id": "22d25823-a4fb-3f8c-8ebc-643667818990",
                        "glosses": [
                            "Couch eines Filmemachers, auf der – wie böse Zungen behaupten – dieser über die Vergabe von Rollen an Schauspielerinnen entscheidet, und zwar allein in Abhängigkeit von deren Bereitschaft zu sexuellen Handlungen"
                        ],
                        "tags": [
                            "Filmjargon"
                        ],
                        "examples": [
                            {
                                "example_id": "3b28394c-24d2-429a-8c92-4ee5fd43f828",
                                "sense_id": "61f8f542-561b-3af9-91ee-479e6b127505",
                                "text": "„Ich kann auf Befehl dicke Tränen weinen, bin bereit auf der Besetzungscouch alles zu geben und mich bei laufender Kamera vor johlendem Publikum komplett zum Affen zu machen.“"
                            },
                            {
                                "example_id": "6d586769-41f0-4330-b0bd-de677c42cdbf",
                                "sense_id": "61f8f542-561b-3af9-91ee-479e6b127505",
                                "text": "„Die sprichwörtliche Besetzungscouch, bei der es Jobs gegen Sex gibt, habe sie nicht erlebt - wohl aber ein Klima von Sexismus und Chauvinismus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "72d57afb-ac3b-45cb-8701-64a200d038ed",
                        "source_entry_id": "22d25823-a4fb-3f8c-8ebc-643667818990",
                        "source_sense_id": "61f8f542-561b-3af9-91ee-479e6b127505",
                        "source_sense_description": "Couch eines Filmemachers, der über die Vergabe von Rollen an Schauspielerinnen gegen Sex entscheidet",
                        "target_lang_word": "casting couch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "casting couch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57fbccf5-d642-3f08-bcb3-a7ba429f3188",
                                        "entry_id": "69337e7e-8003-311b-9b6b-1d88dbc50ddd",
                                        "glosses": [
                                            "The now illegal practice of soliciting sexual favors from a job applicant in exchange for employment, particularly in the entertainment industry."
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a4016a5-bca8-495a-8f98-c316c23959e7",
                                                "sense_id": "57fbccf5-d642-3f08-bcb3-a7ba429f3188",
                                                "text": "...when a writing test at a radio station turned into the casting-couch routine. She was typing a piece of copy when she realized the station manager had locked the door and was caressing her shoulders."
                                            },
                                            {
                                                "example_id": "a5c30248-9c87-4589-bd0f-badd80da024d",
                                                "sense_id": "57fbccf5-d642-3f08-bcb3-a7ba429f3188",
                                                "text": "What the term \"casting couch\" hints at is that roles or jobs are given in exchange for sexual favors."
                                            },
                                            {
                                                "example_id": "9cd48a52-f4a3-407f-b5fe-3ef52e4b10d5",
                                                "sense_id": "57fbccf5-d642-3f08-bcb3-a7ba429f3188",
                                                "text": "casting couch: This refers to the alleged practice by some Hollywood producers and directors of furnishing an office with a couch, upon which would-be actresses perform special services in return for casting consideration..."
                                            },
                                            {
                                                "example_id": "8a3f6834-1cf8-4b45-9d17-aee0ebc7c7c8",
                                                "sense_id": "57fbccf5-d642-3f08-bcb3-a7ba429f3188",
                                                "text": "It wasn’t sexual assault, Harvey Weinstein’s lawyers argue in his defense, just the casting couch, with benefits for everyone who took a seat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2393723-cdac-3185-bd0b-6505991bc9f5",
                                        "entry_id": "69337e7e-8003-311b-9b6b-1d88dbc50ddd",
                                        "glosses": [
                                            "An actual couch or sofa used for this practice."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3de834db-f5b8-4b19-8f79-0b293006750c",
                                                "sense_id": "d2393723-cdac-3185-bd0b-6505991bc9f5",
                                                "text": "There was a wide damask covered divan in a shadowy corner, like a casting couch."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
