                        "form": "das Hecklicht"
                    },
                    {
                        "form_id": "011930bb-e13b-4320-860a-ab0b804cf64d",
                        "entry_id": "457f364f-83dc-3ed4-aa3d-518c005c7d84",
                        "tags": [
