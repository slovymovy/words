                        "entry_id": "0fb3c25b-0529-3d78-9b11-37726f7a2632",
                        "glosses": [
                            "Relatif aux découvertes de Christophe Colomb."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ae31df6-6712-430c-8830-f193992f0031",
                                "sense_id": "d8b2318c-7331-3f7d-acb3-d5e8e3a6724a",
                                "text": "L’ancien palais des premiers gouverneurs de l’île, où Christophe Colomb séjourna en 1592, fait revivre l’époque colombine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e780d2dc-65b0-45fa-872e-28d82e5f17c7",
                        "source_entry_id": "0fb3c25b-0529-3d78-9b11-37726f7a2632",
                        "source_sense_id": "d8b2318c-7331-3f7d-acb3-d5e8e3a6724a",
