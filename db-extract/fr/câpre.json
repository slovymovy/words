                                    {
                                        "sense_id": "f534fe67-04d1-3be6-b555-8d49ce08bdba",
                                        "entry_id": "196723b3-169b-3051-ba90-fb78ee24cba9",
                                        "glosses": [
                                            "in Salzlake eingelegte Knospe des Kapernstrauchs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "574b9a35-fa98-43da-a831-e315bc6e5d8c",
                                                "sense_id": "f534fe67-04d1-3be6-b555-8d49ce08bdba",
                                                "text": "Zu Königsberger Klopsen gehört eine Soße mit Kapern."
                                            },
                                            {
                                                "example_id": "9db3eec5-62fa-4ee7-8b8e-41a3ebb935db",
                                                "sense_id": "f534fe67-04d1-3be6-b555-8d49ce08bdba",
                                                "text": "„Als er die Pistazien und Kapern zerhackte, schlug er plötzlich mit dem Messer auf das Brett wie ein Wahnsinniger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Kaper",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b50b6ed-cf95-3e09-9dc2-cde318955bcc",
