                        "entry_id": "42a7eb67-6514-3995-9533-01872752e2bd",
                        "glosses": [
                            "Mot dont une syllabe est redoublée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ce7db6f-0175-43c0-adba-75914d1ad1a2",
                                "sense_id": "db339959-8866-3ad6-b5f9-f2828fba3ac4",
                                "text": "D’après M. L. Marcus, les Marmarides dont le nom ne formerait pour lui que le réduplicatif de celui de Maures, seraient les premiers Libyens."
                            }
                        ]
                    },
                    {
                        "sense_id": "1185779c-ada7-30e8-a016-c7db7c4fd0e8",
                        "entry_id": "42a7eb67-6514-3995-9533-01872752e2bd",
                        "glosses": [
                            "Mot qui marque la répétition à l'identique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23e16937-417a-4ece-a225-daea738b3118",
                                "sense_id": "1185779c-ada7-30e8-a016-c7db7c4fd0e8",
                                "text": "Rebattre est le réduplicatif de battre."
                            }
                        ]
