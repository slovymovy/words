                ],
                "senses": [
                    {
                        "sense_id": "6957d2dc-9c6d-340d-aa2b-62589955b0ee",
                        "entry_id": "20b549c9-a441-3452-8705-23e5679d602f",
                        "glosses": [
                            "Pratiquer une activité spéléologique, visiter des cavernes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df3310df-65ba-4e46-8df8-54031c5451ad",
                                "sense_id": "6957d2dc-9c6d-340d-aa2b-62589955b0ee",
                                "text": "Aucun n'étant le bon, à quoi bon pérégriner, spéléologuer vers des cimetières marins, des mausolées de vagues ?"
                            },
                            {
                                "example_id": "805b6eca-a972-4d09-819e-6523a0d8d1e6",
                                "sense_id": "6957d2dc-9c6d-340d-aa2b-62589955b0ee",
                                "text": "Préférez vous aller de suite dans la grotte et manger en vous caillant dans le froid et l'humidité ou préférez-vous aller vous balader ce matin chercher de nouveaux trous, manger au chaud et aller spéléologuer ensuite ?"
                            },
                            {
                                "example_id": "7703ea58-2e36-44bf-829a-8cfa1ff730e1",
                                "sense_id": "6957d2dc-9c6d-340d-aa2b-62589955b0ee",
                                "text": "Petits, nous en avons passé des heures à courir d'une place de pique-nique à l'autre, zigzaguer entre les arbres, escalader les rochers alentour, spéléologuer les moindres cavernes potentielles, barboter dans la rivière ou courir les myrtilles!"
                            },
                            {
                                "example_id": "8f42a567-8793-4599-a89c-c977c14f6f81",
                                "sense_id": "6957d2dc-9c6d-340d-aa2b-62589955b0ee",
                                "text": "Avec ces bouquin on ne lit pas, on recherche on spéléologue, on historianise..."
                            }
                        ]
                    }
                ],
