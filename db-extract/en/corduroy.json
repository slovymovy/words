    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "978aefea-48e2-3d76-88aa-8a9ec5f31cb0",
                "word": "corduroy",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "87005f43-1a72-3a9a-8530-094a016e7a14",
                        "entry_id": "978aefea-48e2-3d76-88aa-8a9ec5f31cb0",
                        "glosses": [
                            "Of a road, path, etc., paved with split or round logs laid crosswise side by side."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "8857ca5b-d2ea-439d-a8c8-2366db1432a0",
                                "sense_id": "87005f43-1a72-3a9a-8530-094a016e7a14",
                                "text": "Swamps had to be crossed by means of corduroy causeways; made by cutting down trees and laying them horizontally on the quivering mass of boggy ground."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "5c4f5621-cbc8-3db6-9795-228ef2269c5b",
                "word": "corduroy",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "648e51eb-4299-42ed-aa6d-bf02ca3e22ac",
                        "entry_id": "5c4f5621-cbc8-3db6-9795-228ef2269c5b",
                        "tags": [
                            "plural"
                        ],
                        "form": "corduroys"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d66c43e9-95ff-3570-a861-eaeec1d5aee5",
                        "entry_id": "5c4f5621-cbc8-3db6-9795-228ef2269c5b",
                        "glosses": [
                            "A heavy fabric, usually made of cotton, with vertical ribs."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b64e84bc-27db-41aa-8d99-60dd72321cb9",
                                "sense_id": "d66c43e9-95ff-3570-a861-eaeec1d5aee5",
                                "text": "Sunning himself on the board steps, I saw for the first time Mr. Farquhar Fenelon Cooke.[…]A silver snaffle on a heavy leather watch guard which connected the pockets of his corduroy waistcoat, together with a huge gold stirrup in his Ascot tie, sufficiently proclaimed his tastes."
                            },
                            {
                                "example_id": "561f9617-e18b-428e-bf4f-8f7378c9d087",
                                "sense_id": "d66c43e9-95ff-3570-a861-eaeec1d5aee5",
                                "text": "We turned to see a muscular young man lounging in the door which led into the sitting-room. He wore green corduroy trousers, a duffle coat and an old school tie."
                            }
                        ]
                    },
                    {
                        "sense_id": "bd917d2b-c583-3f96-b257-9a0cf8da3786",
                        "entry_id": "5c4f5621-cbc8-3db6-9795-228ef2269c5b",
                        "glosses": [
                            "Cheap and poor-quality whiskey."
                        ],
                        "tags": [
                            "Ireland",
                            "countable",
                            "obsolete",
                            "slang",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0021156a-6de4-4ebb-a8df-8e0ccb989166",
                                "sense_id": "bd917d2b-c583-3f96-b257-9a0cf8da3786",
                                "text": "Another description of what would be termed adulterated spirits, is by the vulgar termed \"Corduroy,\" on account of the rough feeling which it imparts to the tongue and palate."
                            },
                            {
                                "example_id": "5394c1ec-1fba-444b-acf8-b14439a57669",
                                "sense_id": "bd917d2b-c583-3f96-b257-9a0cf8da3786",
                                "text": "To men of common gumption, / Hot strange, besides, must seem / At this time any scheme / To put a check upon potheen's consumption, / When all are calling for Irish Poor Laws! / Instead of framing more laws, / To pauperism if you'd give a pegger, / Don't check, but patronise their \"Kill-the-Beggar!\" / If Pat is apt to go in Irish Linen, / (Buttoning his coat, with nothing but his skin in) / Would any Christian man -- that's quite himself, / His wits not floor'd, or laid upon the shelf --, While blaming Pat for raggedness, poor boy, / Would deprive him of his \"Corduroy!\""
                            }
                        ]
                    },
                    {
                        "sense_id": "86be6808-4d1a-3dff-a770-77784f62e039",
                        "entry_id": "5c4f5621-cbc8-3db6-9795-228ef2269c5b",
                        "glosses": [
                            "A pattern on snow resulting from the use of a snow groomer to pack snow and improve skiing, snowboarding and snowmobile trail conditions. Corduroy is widely regarded as a good surface on which to ski or ride."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
