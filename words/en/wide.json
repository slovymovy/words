                    "sense_definition": "Over a large area or distance; extensively.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "scope",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "People traveled from far and <w>wide</w> to attend the festival.",
                            "target_lang_translations": {
                                "ru": "Люди ехали <w>отовсюду</w>, чтобы посетить фестиваль.",
                                "nl": "Mensen kwamen van heinde en <w>verre</w> om het festival bij te wonen.",
                                "tr": "İnsanlar festivale katılmak için <w>dört bir yandan</w> seyahat etti.",
                                "zh": "人们从<w>四面八方</w>赶来参加这个节日。"
                            }
                        },
                        {
                            "text": "They searched far and <w>wide</w> for the missing key.",
                            "target_lang_translations": {
                                "ru": "Они искали потерянный ключ <w>повсюду</w>.",
                                "nl": "Ze zochten <w>overal</w> naar de vermiste sleutel.",
                                "tr": "Kayıp anahtarı <w>her yerde</w> aradılar.",
                                "zh": "他们<w>到处</w>寻找丢失的钥匙。"
                            }
                        }
                    ],
                    "common_phrases": [
