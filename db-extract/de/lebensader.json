                "senses": [
                    {
                        "sense_id": "92cbf5a7-bead-36b8-996c-19b75473c7aa",
                        "entry_id": "33dd484c-d9c2-3957-aa2e-c1b738b7bf4a",
                        "glosses": [
                            "wichtiger Verkehrsweg"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "b5240ea4-d4ab-4ce6-a963-2ed3b3bab4f8",
                                "sense_id": "92cbf5a7-bead-36b8-996c-19b75473c7aa",
                                "text": "Der Mpanga-Fluss im Westen Ugandas ist die Lebensader der Region, für Mensch und Natur."
                            },
                            {
                                "example_id": "350c67d7-91e2-463b-bfdb-04d73cc6dd46",
                                "sense_id": "92cbf5a7-bead-36b8-996c-19b75473c7aa",
                                "text": "Die Bahn ist in Indien das beliebteste Fernverkehrsmittel, das Netz wird als \"Lebensader der Nation\" bezeichnet."
                            },
                            {
                                "example_id": "4f3daf7d-fe59-4e06-9158-e8ba68193e24",
                                "sense_id": "92cbf5a7-bead-36b8-996c-19b75473c7aa",
                                "text": "Es sind die Lebensadern der europäischen Metropolen, die großen Boulevards von Paris, Budapest, Berlin, Barcelona und Wien."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1bf8572f-2acf-3edb-83bf-68ca39c1c6c2",
                        "entry_id": "33dd484c-d9c2-3957-aa2e-c1b738b7bf4a",
                        "glosses": [
                            "notwendige Versorgung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6c4f5c2-a926-4ed2-88d3-543f8c288e36",
                                "sense_id": "1bf8572f-2acf-3edb-83bf-68ca39c1c6c2",
                                "text": "„Die Arterien des Menschen, die das Blut in die Organe bringen, das sind unsere Lebensadern.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
