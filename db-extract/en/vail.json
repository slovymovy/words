                "word_linkages": []
            },
            {
                "entry_id": "f881a52b-747f-31ed-a4b5-74749377955b",
                "word": "vail",
                "pos": "verb",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9147ec4e-fd19-4269-8290-10f0f75dc47f",
                        "entry_id": "f881a52b-747f-31ed-a4b5-74749377955b",
                        "tags": [
                            "present",
                            "singular",
                            "third-person"
                        ],
                        "form": "vails"
                    },
                    {
                        "form_id": "2d2f989c-c129-416f-8a01-9f8cf136b3b2",
                        "entry_id": "f881a52b-747f-31ed-a4b5-74749377955b",
                        "tags": [
                            "participle",
                            "present"
                        ],
                        "form": "vailing"
                    },
                    {
                        "form_id": "5729139a-69de-4939-9fa7-7c0f023b795a",
                        "entry_id": "f881a52b-747f-31ed-a4b5-74749377955b",
                        "tags": [
                            "participle",
                            "past"
                        ],
                        "form": "vailed"
                    },
                    {
                        "form_id": "f3929bf2-ae27-4470-a37e-432b971b1800",
                        "entry_id": "f881a52b-747f-31ed-a4b5-74749377955b",
                        "tags": [
                            "past"
                        ],
                        "form": "vailed"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "faa98a53-0697-3970-9b69-9e95529919b5",
                        "entry_id": "f881a52b-747f-31ed-a4b5-74749377955b",
                        "glosses": [
                            "To lower, let fall; to allow or cause to sink."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ed625192-c289-4513-91aa-28a9f574be5c",
                                "sense_id": "faa98a53-0697-3970-9b69-9e95529919b5",
                                "text": "Then let them vale a bonet of their proud ſayle,"
                            },
                            {
                                "example_id": "455fab5b-bcc1-4ccc-90a8-6f3de7076df1",
                                "sense_id": "faa98a53-0697-3970-9b69-9e95529919b5",
                                "text": "[…] when he shall know it lies in vs,\nTo banish him, and then to call him home,\nTwill make him vaile the topflag of his pride,\nAnd feare to offend the meanest noble man."
                            },
                            {
                                "example_id": "eae0252f-18f0-4605-82b5-17542877e399",
                                "sense_id": "faa98a53-0697-3970-9b69-9e95529919b5",
                                "text": "[…] Vail your regard\nUpon a wrong’d, I would fain have said, a maid!"
                            }
                        ]
                    },
                    {
                        "sense_id": "c60ab05d-0dad-3ca7-8ceb-29ea8f66f589",
                        "entry_id": "f881a52b-747f-31ed-a4b5-74749377955b",
                        "glosses": [
                            "To lower or “dip” a carried flag or banner in a salute by a forward reducing of the angle of the pike/flagstaff with respect to the ground; in extreme instances, as when saluting a monarch, both the banner and the finial of the pike are allowed to rest upon the ground."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ed28e0c7-9bf3-30ac-9775-9cdae50f459b",
                        "entry_id": "f881a52b-747f-31ed-a4b5-74749377955b",
                        "glosses": [
                            "To lower a sail, in salute or otherwise."
                        ],
                        "tags": [
                            "intransitive",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d650240c-81db-4e41-8c19-142ec316690e",
                                "sense_id": "ed28e0c7-9bf3-30ac-9775-9cdae50f459b",
                                "text": "Both we will walke vpon the loftie cliffes,\nAnd Chriſtian Merchants that with Ruſſian ſtems\nPlow vp huge furrowes in the Caſpian ſea,\nShall vaile to vs, as Lords of al the Lake."
                            }
                        ]
                    },
                    {
                        "sense_id": "02e3e3e0-b6c9-36fc-83f2-1fbcba624c5b",
                        "entry_id": "f881a52b-747f-31ed-a4b5-74749377955b",
                        "glosses": [
                            "To remove as a sign of deference, as a hat."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a1586c13-ccca-4b9d-b68d-4d5fa9bae035",
                                "sense_id": "02e3e3e0-b6c9-36fc-83f2-1fbcba624c5b",
                                "text": "[…] Now the time is come\nThat France must vail her lofty-plumed crest\nAnd let her head fall into England’s lap."
                            },
                            {
                                "example_id": "55be87c1-b343-4597-adef-73651e23acb8",
                                "sense_id": "02e3e3e0-b6c9-36fc-83f2-1fbcba624c5b",
                                "text": "[…] the Templar […], without vailing his bonnet, or testifying any reverence for the alleged sanctity of the relic, took from his neck a gold chain, which he flung on the board […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "601cc2a2-be35-3793-a4da-8d322ff451bb",
                        "entry_id": "f881a52b-747f-31ed-a4b5-74749377955b",
                        "glosses": [
                            "To pay homage, bow, submit, defer (to someone or something); to yield, give way (to something)."
                        ],
                        "tags": [
                            "intransitive",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "f105514e-e420-4e0a-9774-a268434364bc",
                                "sense_id": "601cc2a2-be35-3793-a4da-8d322ff451bb",
                                "text": "She would with rich and constant pen\nVail to her mistress Dian;"
                            },
                            {
                                "example_id": "d00cef9e-a45e-4cef-8491-488d9aba58f4",
                                "sense_id": "601cc2a2-be35-3793-a4da-8d322ff451bb",
                                "text": "[…] when a Man does not readily vail to the Opinions of approved Authors, which have been received with respect and submission by others"
                            },
                            {
                                "example_id": "9c4504b1-21c3-4cd5-934e-f078348e4a0c",
                                "sense_id": "601cc2a2-be35-3793-a4da-8d322ff451bb",
                                "text": "1692, Robert South, Discourses on Various Subjects and Occasions, Boston: Bowles & Dearborn, 1827, Discourse 5, p. 370,\nThy convenience must vail to thy neighbour’s necessity."
                            }
                        ]
                    }
                ],
