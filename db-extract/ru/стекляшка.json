                "senses": [
                    {
                        "sense_id": "5e98be71-c498-35db-931a-5735be6ee55a",
                        "entry_id": "8f13b728-12cd-3b07-95b3-8eac2974770a",
                        "glosses": [
                            "пренебр. стекло; кусочек стекла; небольшой предмет из стекла"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df8c6037-97aa-43b8-ba12-8ed3a8b8d811",
                                "sense_id": "5e98be71-c498-35db-931a-5735be6ee55a",
                                "text": "Пришлось вспомнить азы химии, насобирать всяких баночек, колб, пробирок и других необходимых для опытов стекляшек."
                            }
                        ]
                    },
                    {
                        "sense_id": "2cebe29e-158e-359c-a253-9d258b39d886",
                        "entry_id": "8f13b728-12cd-3b07-95b3-8eac2974770a",
                        "glosses": [
                            "разг. здание из стекла, бетона и стали, создающее впечатление сквозного, просвечивающего"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "603a2a69-7da5-4ea5-9a39-e62f6a96c8cc",
                                "sense_id": "2cebe29e-158e-359c-a253-9d258b39d886",
                                "text": "Встретимся в стекляшке."
                            },
                            {
                                "example_id": "a64bb510-ebb9-410e-9c38-b4d31a2b2a71",
                                "sense_id": "2cebe29e-158e-359c-a253-9d258b39d886",
                                "text": "Так схема понятна: покупка здания «с обременением» ― нытьё о невозможности его «эффективного использования» ― снятие охраняемого статуса ― снос и очередная убогая стекляшка."
                            }
                        ]
                    }
