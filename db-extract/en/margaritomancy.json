                        "examples": [
                            {
                                "example_id": "3f8bbf31-0928-41ca-a812-f7e1afa452ca",
                                "sense_id": "224274c3-5d05-3c22-8ed7-08f8d9c59103",
                                "text": "In ancient times, a form of margaritomancy was used to determine the guilt or innocence of a man or woman suspected of committing a crime."
                            },
                            {
                                "example_id": "9d29c005-094c-45b9-8439-4d541836257e",
                                "sense_id": "224274c3-5d05-3c22-8ed7-08f8d9c59103",
                                "text": "Margaritomancy: Divination by pearls. A pearl was covered with a vase, and placed near the fire, and the names of suspected persons pronounced. When the name of the guilty one was uttered the pearl was supposed to bound upwards and pierce the bottom of the vase."
                            },
                            {
                                "example_id": "f0885434-d807-480f-b0ba-01835a7ca4e4",
                                "sense_id": "224274c3-5d05-3c22-8ed7-08f8d9c59103",
                                "text": "1931 Lock tr. de Givry Picture Museum of Sorcery\nVery curious was margaritomancy, or divination by a pearl. \"The pearl is to be enchanted,\" says de l'Ancre, \"and shut in a pot; then if it chance that the name of the thief be pronounced the pearl will leap, striking against the pot.\""
                            }
                        ]
                    }
