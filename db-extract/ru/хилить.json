                "senses": [
                    {
                        "sense_id": "5bbf7c25-1016-386a-8129-2f8a7337f2de",
                        "entry_id": "ad2a3b26-db2a-3ac6-b65f-c37758a29e33",
                        "glosses": [
                            "прост. разг. сленг то же, что целить, то же, что лечить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fda402c-f321-4cd6-9f86-0f146f749e8f",
                                "sense_id": "5bbf7c25-1016-386a-8129-2f8a7337f2de",
                                "text": "Как хилил, так и буду хилить, — ответил шаман Жора."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0121f38f-9819-4e64-816b-8dd2829287d4",
                        "source_entry_id": "ad2a3b26-db2a-3ac6-b65f-c37758a29e33",
                        "source_sense_id": "5bbf7c25-1016-386a-8129-2f8a7337f2de",
                        "target_lang_word": "heal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd5f9963-dc1a-3d4d-ac63-ed75159bc4c7",
                                        "entry_id": "0f009f56-1264-334a-b538-d65382a08ebf",
                                        "glosses": [
                                            "To make better from a disease, wound, etc.; to revive or cure."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07dacdb5-5116-48e6-963a-b96bf306939f",
                                                "sense_id": "cd5f9963-dc1a-3d4d-ac63-ed75159bc4c7",
                                                "text": "This bandage will help to heal your cut."
                                            },
                                            {
                                                "example_id": "696893c1-b9c5-492e-a368-fe8e97ed93ec",
                                                "sense_id": "cd5f9963-dc1a-3d4d-ac63-ed75159bc4c7",
                                                "text": "Speak the word only, and my servant shall be healed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88faa6a2-231e-3ebc-9fc3-f469d1e34c27",
                                        "entry_id": "0f009f56-1264-334a-b538-d65382a08ebf",
                                        "glosses": [
                                            "To become better or healthy again."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "647eadea-0b58-406f-88dc-bc0ef1421b47",
                                                "sense_id": "88faa6a2-231e-3ebc-9fc3-f469d1e34c27",
                                                "text": "Bandages allow cuts to heal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd369f9b-c0c9-3981-83b7-831dfd8d581f",
                                        "entry_id": "0f009f56-1264-334a-b538-d65382a08ebf",
                                        "glosses": [
                                            "To reconcile, as a breach or difference; to make whole; to free from guilt."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d2ae4e1-2d4f-4116-b336-a7d2f1e2b4d1",
                                                "sense_id": "bd369f9b-c0c9-3981-83b7-831dfd8d581f",
                                                "text": "to heal dissensions"
                                            },
                                            {
                                                "example_id": "07cc300d-550e-43c3-9b11-dbf3bdf5e2ca",
                                                "sense_id": "bd369f9b-c0c9-3981-83b7-831dfd8d581f",
                                                "text": "to heal a broken heart"
                                            },
                                            {
                                                "example_id": "00acefe3-251d-4bf2-9a2d-6a41bdb12f32",
                                                "sense_id": "bd369f9b-c0c9-3981-83b7-831dfd8d581f",
                                                "text": "English spelling, although unphonetic and antiphonetic, was inherited from our ancestors and has served magnificently in the glorious past. The weak spot in English spelling, however, can be easily healed with the global alphabet."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "heal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "18fd2a56-0ade-319c-88f9-069005cfec77",
                                        "entry_id": "b32eee06-3f07-31d8-9f8e-6de363b31f37",
                                        "glosses": [
                                            "A spell or ability that restores hit points or removes a status ailment."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4958aaf-79d3-4575-a79d-6df541bf118a",
                                                "sense_id": "18fd2a56-0ade-319c-88f9-069005cfec77",
                                                "text": "Also, various interesting spells have been added—for instance, with the Orb spell, you can circle a character, firing offensive bolts or casting heals, and free up a mage-type to cast other spells or even melee."
                                            },
                                            {
                                                "example_id": "035d1c9b-d32b-42da-ad54-70f3f468de32",
                                                "sense_id": "18fd2a56-0ade-319c-88f9-069005cfec77",
                                                "text": "The following macro checks whether our current target is friendly and casts a heal on it if so; otherwise it casts the heal on the target's target […]"
                                            },
                                            {
                                                "example_id": "dcc61276-e961-4aec-8488-75e452d870c0",
                                                "sense_id": "18fd2a56-0ade-319c-88f9-069005cfec77",
                                                "text": "Synner, a priest walking by, sees her struggling and casts a heal on her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8369c171-3618-3418-a025-af465634ee27",
                                        "entry_id": "b32eee06-3f07-31d8-9f8e-6de363b31f37",
                                        "glosses": [
                                            "Healing; an instance of restoration of health or hit points."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73d899a3-a82c-40f5-a77f-147d4d67b6a2",
                                                "sense_id": "8369c171-3618-3418-a025-af465634ee27",
                                                "text": "Give me heals! I need healing!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e402836-70f4-3db7-bbad-f824cd5ef886",
                                        "entry_id": "b32eee06-3f07-31d8-9f8e-6de363b31f37",
                                        "glosses": [
                                            "health"
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "heal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4ee35ae-a896-3469-9026-58675cf09309",
                                        "entry_id": "338e0dda-64af-3c82-9293-2c1593cef3ad",
                                        "glosses": [
                                            "Alternative form of hele (“conceal”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c9be661-9805-4129-be01-5cd03ccb6851",
                                                "sense_id": "a4ee35ae-a896-3469-9026-58675cf09309",
                                                "text": "\"Heal, conceal and keep secret.\""
                                            },
                                            {
                                                "example_id": "3404e3fe-bb90-4b8c-bc57-03907d16cfe9",
                                                "sense_id": "a4ee35ae-a896-3469-9026-58675cf09309",
                                                "text": "'I swear before God and all these witnesses that I will always heal, conceal and never reveal any art or part of this secret of horsemanry which is to be revealed to me at this time or any other time hereafter.'"
                                            },
                                            {
                                                "example_id": "fa72c8a3-7a44-4c8f-851b-5eaf3e5ec3ac",
                                                "sense_id": "a4ee35ae-a896-3469-9026-58675cf09309",
                                                "text": "The man in black asked Christopher for the secret passwords he'd been given and he answered correctly. As soon as he had, Christopher felt the point of a blade at his throat. “Do you swear to heal, conceal and never reveal the secrets of the witching arts for all your days[…]?\""
                                            }
                                        ]
                                    }
                                ]
                            }
