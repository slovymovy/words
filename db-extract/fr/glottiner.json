                "senses": [
                    {
                        "sense_id": "d70169b3-4368-385a-9e9f-7ddcbef9b099",
                        "entry_id": "61685d93-edff-35cf-8191-51f1a143fa9c",
                        "glosses": [
                            "Sucer, lécher, lors d'un rapport bucco-génital."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e689dd91-dc91-48a4-bec7-0545d4188f27",
                                "sense_id": "d70169b3-4368-385a-9e9f-7ddcbef9b099",
                                "text": "Elle se jette dessus, le reçoit dans sa bouche, le glottine à merveille, et lui rend ainsi toute sa première vigueur."
                            },
                            {
                                "example_id": "367e6366-d1be-4a42-b13b-99e899773c4c",
                                "sense_id": "d70169b3-4368-385a-9e9f-7ddcbef9b099",
                                "text": "Aussi est-ce sans me faire prier que je m'allonge pour glottiner sa chatte offerte en jeu."
                            }
                        ]
                    }
                ],
