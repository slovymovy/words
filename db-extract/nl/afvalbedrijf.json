                        "examples": [
                            {
                                "example_id": "f873bcd7-4cfa-47cb-9ece-d6802a95e880",
                                "sense_id": "d6c537da-9a5b-382b-9597-868c269e9ed2",
                                "text": "De vervuiling zou zijn ontstaan doordat een afvalbedrijf de gebruikte grond onvoldoende had schoongemaakt. Daardoor zijn de giftige stoffen styreen (gebruikt bij productie van plastic) en DDT (landbouwgif) in de grond achtergebleven."
                            },
                            {
                                "example_id": "1ec1f9d0-f112-4383-a670-df3865722e09",
                                "sense_id": "d6c537da-9a5b-382b-9597-868c269e9ed2",
                                "text": "De vervuiling zou zijn ontstaan doordat een afvalbedrijf de grond niet goed genoeg had schoongemaakt. Daardoor zijn er resten van giftige stoffen in achtergebleven."
                            }
                        ]
