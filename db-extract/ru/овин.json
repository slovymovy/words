                                "target_senses": [
                                    {
                                        "sense_id": "361fa7a5-413e-3f25-bafc-304a3bdc57c8",
                                        "entry_id": "c01dfc04-493b-3f12-9941-b162a943afb9",
                                        "glosses": [
                                            "To lay up in a barn."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0212aa82-275a-428d-8b8d-b52196b32351",
                                                "sense_id": "361fa7a5-413e-3f25-bafc-304a3bdc57c8",
                                                "text": "But like still-pining Tantalus he sits / And useless barns the harvest of his wits"
                                            },
                                            {
                                                "example_id": "a6330a3b-e6bb-46a1-afcd-9a8cfd8213b4",
                                                "sense_id": "361fa7a5-413e-3f25-bafc-304a3bdc57c8",
                                                "text": "Hypocrites, in like manner, so act holiness that they pass for saints before men, whose censures often barn up the chaff, and burn up the grain."
                                            }
                                        ]
                                    }
                                ]
