                                        "sense_id": "38e885ed-9f17-3547-bdc1-2125ca1ccc2a",
                                        "entry_id": "d077c931-0093-3c77-9392-73904e36a246",
                                        "glosses": [
                                            "A member of the proletariat; a proletarian."
                                        ],
