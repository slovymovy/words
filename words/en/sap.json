{
    "word_family": [
        "sappy",
        "sapwood"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a2578f89-3f29-3d61-bba5-6e769b05ece9",
                    "sense_definition": "The fluid that circulates through a plant, carrying nutrients.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "plant_fluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sticky <w>sap</w> dripped slowly from the cut in the tree trunk.",
                            "target_lang_translations": {
                                "tr": "Yapışkan <w>özsu</w>, ağaç gövdesindeki kesikten yavaşça damladı."
                            }
                        },
                        {
                            "text": "Maple <w>sap</w> is collected in early spring to make syrup.",
                            "target_lang_translations": {
                                "tr": "Şurup yapmak için ilkbaharın başlarında akçaağaç <w>özsuyu</w> toplanır."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tree sap",
                        "maple sap"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bitkilerde dolaşarak besin taşıyan sıvı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "özsu",
                                "target_lang_sense_clarification": "bitki sıvısı"
                            },
                            {
                                "target_lang_word": "bitki özsuyu",
                                "target_lang_sense_clarification": "ağaç veya bitkilerin içindeki besleyici sıvı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6cfce1b8-6709-3d9d-ac2e-c1745e37d072",
                    "sense_definition": "A person who is easily fooled or naive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't be such a <w>sap</w> and believe everything they tell you.",
                            "target_lang_translations": {
                                "tr": "O kadar <w>saf</w> olma da sana söyledikleri her şeye inanma."
                            }
                        },
                        {
                            "text": "He felt like a total <w>sap</w> after falling for the obvious scam.",
                            "target_lang_translations": {
                                "tr": "Bu bariz dolandırıcılığa kandıktan sonra kendini tam bir <w>enayi</w> gibi hissetti."
                            }
                        }
                    ],
                    "synonyms": [
                        "milksop",
                        "saphead"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal term for a naive person."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Kolayca aldatılabilen, saf veya ahmak kimse."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "saf",
                                "target_lang_sense_clarification": "kolay kandırılan kimse"
                            },
                            {
                                "target_lang_word": "enayi",
                                "target_lang_sense_clarification": "kolay aldatılan, ahmakça davranan kişi"
                            },
                            {
                                "target_lang_word": "ahmak",
                                "target_lang_sense_clarification": "kolayca kanabilen kimse"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "546ead83-a874-3ad7-b031-ad8a5e4893b7",
                    "sense_definition": "A small, heavy club used as a weapon.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weapon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective found a leather <w>sap</w> hidden in the suspect's coat pocket.",
                            "target_lang_translations": {
                                "tr": "Dedektif, şüphelinin ceket cebine gizlenmiş deri bir <w>cop</w> buldu."
                            }
                        },
                        {
                            "text": "He was knocked unconscious by a blow from a <w>sap</w>.",
                            "target_lang_translations": {
                                "tr": "Bir <w>cop</w> darbesiyle bilincini kaybetti."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Silah olarak kullanılan kısa, ağır bir cop."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "cop",
                                "target_lang_sense_clarification": "kısa, ağır deri veya kauçuk sopa"
                            },
                            {
                                "target_lang_word": "kısa cop",
                                "target_lang_sense_clarification": "genellikle deriden yapılmış vurucu alet"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "143a912a-5f64-3315-91fa-4ad2012265d4",
                    "sense_definition": "To gradually reduce or destroy someone's strength or energy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "weaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The long illness began to <w>sap</w> his remaining strength.",
                            "target_lang_translations": {
                                "tr": "Uzun süren hastalık, kalan gücünü de <w>tüketmeye</w> başladı."
                            }
                        },
                        {
                            "text": "Working in the heat all day really <w>saps</w> your energy.",
                            "target_lang_translations": {
                                "tr": "Bütün gün sıcakta çalışmak enerjinizi gerçekten <w>tüketiyor</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Birinin gücünü veya enerjisini yavaş yavaş tüketmek ya da yok etmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "tüketmek",
                                "target_lang_sense_clarification": "güç veya enerjiyi yavaşça bitirmek"
                            },
                            {
                                "target_lang_word": "tüketip bitirmek",
                                "target_lang_sense_clarification": "gücünü emmek"
                            },
                            {
                                "target_lang_word": "zayıflatmak",
                                "target_lang_sense_clarification": "kuvvetten düşürmek"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "376d50b4-4868-3c4b-84eb-609c39954983",
                    "sense_definition": "A major multinational software corporation.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "company",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "Many large companies use <w>SAP</w> software to manage their business operations.",
                            "target_lang_translations": {
                                "tr": "Birçok büyük şirket iş süreçlerini yönetmek için <w>SAP</w> yazılımı kullanmaktadır."
                            }
                        },
                        {
                            "text": "She started her career as a consultant working with <w>SAP</w> systems.",
                            "target_lang_translations": {
                                "tr": "Kariyerine <w>SAP</w> sistemleriyle çalışan bir danışman olarak başladı."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Büyük, çok uluslu bir kurumsal yazılım şirketi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "SAP",
                                "target_lang_sense_clarification": "yazılım şirketi veya ERP sistemi"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}