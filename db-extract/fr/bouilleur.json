                        "entry_id": "dcf0b801-d4ac-3cd7-87b6-5d6e945dc475",
                        "glosses": [
                            "Personne qui fait bouillir, qui distille une boisson ou un moût alcoolisé, pour en faire de l’eau-de-vie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cffa746-8894-4a4e-820e-e5e12d31ee0a",
                                "sense_id": "768a07ee-ab5a-3271-ada8-7da5a1ba4e93",
                                "text": "J’ai connu, autrefois, un bouilleur, un certain Marcel Lemerle, qui avait baptisé son alambic « la goulue »."
                            }
                        ]
                    }
                ],
                "translations": [
