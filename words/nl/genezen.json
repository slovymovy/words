                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "behandeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De arts doet elke dag haar uiterste best om de patiënt te <w>genezen</w>.",
