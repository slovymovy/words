                "senses": [
                    {
                        "sense_id": "371bc09f-7789-315f-815d-3bd38a55afdb",
                        "entry_id": "ecfe189d-6500-32bb-bd1f-bb74318b9527",
                        "glosses": [
                            "Médecin spécialiste de la lèpre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2ba8616-4eb9-40d2-85eb-6a44f2468f15",
                                "sense_id": "371bc09f-7789-315f-815d-3bd38a55afdb",
                                "text": "La possibilité de l’existence de la lèpre en Bretagne, si bien mise au jour par un léprologiste de la valeur de Zambaco-Pacha, venait donc à l’appui de mon hypothèse."
                            },
                            {
                                "example_id": "c04b28fd-8cd5-481d-8308-8ed26063be2e",
                                "sense_id": "371bc09f-7789-315f-815d-3bd38a55afdb",
                                "text": "Aussi n’ai-je pas été surpris de lire tout récemment dans le mémoire de Danielssen que cet éminent léprologiste n’avait jamais pu guérir de lépreux en employant le traitement de Unna, bien qu’il l’eût essayé sur un certain nombre de malades …."
                            },
                            {
                                "example_id": "a5b8c15b-7eeb-4347-8dc2-6ec98352bf9a",
                                "sense_id": "371bc09f-7789-315f-815d-3bd38a55afdb",
                                "text": "Il est devenu léprologiste après cela. On le rencontre à toutes les conférences internationales sur la lèpre, chargé de son crâne qu’il emporte dans un sac de nuit de je ne sais quelle ligne d’aviation."
                            }
                        ]
                    }
