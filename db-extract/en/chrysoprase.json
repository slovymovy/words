                "senses": [
                    {
                        "sense_id": "3c556ca2-d329-385b-b031-f986808058e2",
                        "entry_id": "23320974-3d67-3890-89e5-2c3563e562a6",
                        "glosses": [
                            "A variety of light-green translucent quartz."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b15d3d8f-e642-423b-8ecb-51896edbd8e2",
                                "sense_id": "3c556ca2-d329-385b-b031-f986808058e2",
                                "text": "[…]or such pale green and uncertain as we see in sunset sky, and in the clefts of the glacier and the chrysoprase,[…]"
                            },
                            {
                                "example_id": "bfa24bf0-e51f-436f-ae7d-d20ad52ead46",
                                "sense_id": "3c556ca2-d329-385b-b031-f986808058e2",
                                "text": "With shaken soul of light and shuddering blaze / Of leaping emerald and cold chrysoprase"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e4db59d-4262-40b1-af7a-5682e27ad51d",
                        "source_entry_id": "23320974-3d67-3890-89e5-2c3563e562a6",
                        "source_sense_id": "3c556ca2-d329-385b-b031-f986808058e2",
