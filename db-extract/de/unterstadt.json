                ],
                "senses": [
                    {
                        "sense_id": "82a00697-3618-3d05-81c9-f22df328badc",
                        "entry_id": "2b1c2e7f-f609-3b4a-a05d-e5b7079ec42f",
                        "glosses": [
                            "tiefer gelegener Stadtteil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f910061-11a9-455f-97f1-3459f447ab33",
                                "sense_id": "82a00697-3618-3d05-81c9-f22df328badc",
                                "text": "„Denn auf einem großen Plateau an der Flanke des Burgbergs lag noch eine Unterstadt.“"
                            },
                            {
                                "example_id": "e6934d56-31db-4eb6-934c-b2e9e6de2b74",
                                "sense_id": "82a00697-3618-3d05-81c9-f22df328badc",
                                "text": "„Während in Carcassonne die Burgstadt, die Cité, zunächst sämtliche städtische Funktionen wahrnahm, trat mit der Gründung der Unterstadt um die Mitte des 13. Jh.s eine Teilung insofern ein, als der Cité lediglich die militärische Funktion, die übrigen zentralen Funktionen aber auf die Unterstadt übergingen.“"
                            },
                            {
                                "example_id": "eb7c87bd-6de0-480e-a7a4-3a8d703664cd",
                                "sense_id": "82a00697-3618-3d05-81c9-f22df328badc",
                                "text": "„Neue Siedlungsareale dehnten sich auf mehrere Hektar im flachen Gelände am Fuße der Akropolis aus. Es ist allerdings unklar, wie dicht bebaut solche ‚Unterstädte‘ waren. “"
                            },
                            {
                                "example_id": "771488f2-ccbf-47b2-8d3a-eb5e8b3a38a7",
                                "sense_id": "82a00697-3618-3d05-81c9-f22df328badc",
                                "text": "„Der Vater war schon aufgebrochen, um vor der vollen Dunkelheit die Unterstadt zu erreichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
