                "senses": [
                    {
                        "sense_id": "62fa82a4-e2c2-347e-bb59-f31d8912671e",
                        "entry_id": "7e398cfb-8a15-3e7a-adfb-876bf48fb40d",
                        "glosses": [
                            "lekka strzelba gwintowana z XVII-XVIII wieku. używana na ogół do polowań"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c674b07d-d559-4985-8f57-9d6e56fb264c",
                                "sense_id": "62fa82a4-e2c2-347e-bb59-f31d8912671e",
                                "text": "Raz wyrwała się z domu na polowanie, na kaczki z guldynką"
                            },
                            {
                                "example_id": "a172b51c-759c-4c2b-a45e-6e0018a8b86f",
                                "sense_id": "62fa82a4-e2c2-347e-bb59-f31d8912671e",
                                "text": "Nic nie ma w ręku. Czym tu dać sygnały? Róg i guldynka z kozaczkiem zostały"
                            },
                            {
                                "example_id": "bf6a0c3e-4e6d-43f1-aee7-8ad9c6f67ef5",
                                "sense_id": "62fa82a4-e2c2-347e-bb59-f31d8912671e",
                                "text": "Ciężki a dalekonośny muszkiet był mi niepotrzebny. Zamiast niego wziąłem lżejszą guldynkę"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
