                "forms": [
                    {
                        "form_id": "30243c2e-d0c8-406b-9c1e-b1ee438cb45c",
                        "entry_id": "af3eb684-2ec9-3e2c-832e-0d96334d1096",
                        "tags": [
                            "positive"
                        ],
                        "form": "Wachauer"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "07ab9ba8-cf8e-3934-a2e9-510b3e1acb3e",
                        "entry_id": "af3eb684-2ec9-3e2c-832e-0d96334d1096",
                        "glosses": [
                            "aus der Wachau stammend, sich auf die Wachau beziehend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97ecbb18-521a-478d-bf53-de3d565b2057",
                                "sense_id": "07ab9ba8-cf8e-3934-a2e9-510b3e1acb3e",
                                "text": "„Am liebsten würde Hans Krenn ja jede Wachauer Marille einzeln auffangen, sobald sie reif vom Baum fällt. Denn die Marille, so sagt der begnadete Schnapsbrenner aus dem südlichen Waldviertel, ‚ist eine wahre Diva‘.“"
                            },
                            {
                                "example_id": "911e055f-121b-42e3-92d6-35fa8091496f",
                                "sense_id": "07ab9ba8-cf8e-3934-a2e9-510b3e1acb3e",
                                "text": "„Sie haben sich sogar ein spezielles Gütesiegel zugelegt, um sich von den Schrammelweinen zu unterscheiden: ‚Wiener Classic‘. Die meisten von ihnen können durchaus mit den Wachauer Winzern verglichen werden, und im Preisvergleich schneiden sie ohnehin besser ab.“"
                            },
                            {
                                "example_id": "653c3de6-2b57-4f11-8274-79e8e4e30467",
                                "sense_id": "07ab9ba8-cf8e-3934-a2e9-510b3e1acb3e",
                                "text": "„Zig Dirndln hängen hier, geordnet nach Farben, Regionen und Verwendungszweck: Da gibt es die schlichten, baumwollenen Arbeitsdirndln, die samtenen, bestickten Festtagsdirndln und die originalen Altausseer, Tiroler und Wachauer Dirndl.“"
                            },
                            {
                                "example_id": "b77826b9-31b3-41eb-a7c3-db2fedce47b8",
                                "sense_id": "07ab9ba8-cf8e-3934-a2e9-510b3e1acb3e",
                                "text": "„Das Souper für 500 Schilling ist vortrefflich, Krebsschwanzcocktail in Melonen, Seezungenfilets, Rehrücken mit Preiselbeeren, Eisparfait mit heißer Weichselsauce, dazu eine Flasche Wachauer Weißer aus der stadteigenen Sandgrube von Krems.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
