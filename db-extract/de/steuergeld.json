                ],
                "senses": [
                    {
                        "sense_id": "27e11652-e9de-3db1-8ed3-2a354f87e7eb",
                        "entry_id": "2c897053-aa89-3435-9a97-26f2f24d39ef",
                        "glosses": [
                            "finanzielle Mittel aus staatlichen Abgaben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbf115f9-ee82-4492-b573-d068aa3baa57",
                                "sense_id": "27e11652-e9de-3db1-8ed3-2a354f87e7eb",
                                "text": "In Deutschland werden viele Steuergelder verprasst und landen nicht dort, wo sie hin sollten."
                            },
                            {
                                "example_id": "cc16a2db-0a3d-4b12-acda-5c942e495e59",
                                "sense_id": "27e11652-e9de-3db1-8ed3-2a354f87e7eb",
                                "text": "„Wenn es schlecht läuft, könnte das bis zu 16 Milliarden Euro Steuergeld kosten.“"
                            },
                            {
                                "example_id": "1fffaa97-0578-49b4-bc45-43c3d4bbcdb4",
                                "sense_id": "27e11652-e9de-3db1-8ed3-2a354f87e7eb",
                                "text": "„Nach geltendem finnischen Recht – und da ist der Finne ein Pedant wie europäisch sonst höchstens noch der Deutsche und der Schweizer – darf Steuergeld nicht für Glücksspiele ausgegeben werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "35a87d80-28f1-40d1-822c-a34963ed07d4",
                        "source_entry_id": "2c897053-aa89-3435-9a97-26f2f24d39ef",
                        "source_sense_id": "27e11652-e9de-3db1-8ed3-2a354f87e7eb",
