                                    {
                                        "sense_id": "65538b4c-33c6-3077-80ba-d612c960a582",
                                        "entry_id": "d8757b9c-82fa-3438-9152-4f7469da985e",
                                        "glosses": [
                                            "vliegend voorwerp waarvan de identiteit niet bekend is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de8da715-f204-4e81-b214-2f5f2002f661",
                                                "sense_id": "65538b4c-33c6-3077-80ba-d612c960a582",
                                                "text": "In het Nederlands is het ongebruikelijk het woord ufo te gebruiken zonder te bedoelen dat het buitenaards is."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc6d15b0-21b9-38bd-b814-2180188465ea",
                                        "entry_id": "d8757b9c-82fa-3438-9152-4f7469da985e",
                                        "glosses": [
                                            "buitenaards vliegend voorwerp"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adff6122-380b-47ba-9774-713192800205",
                                                "sense_id": "fc6d15b0-21b9-38bd-b814-2180188465ea",
                                                "text": "Er wordt geregeld melding gemaakt van (vermeende) waarnemingen van ufo's."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae383638-d446-4cc7-8ac5-6fb2ad780ffd",
                        "source_entry_id": "e054eaaa-8775-3549-b43d-32d9c169bd56",
                        "source_sense_description": "an unidentified flying object",
                        "target_lang_word": "OVNI",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "OVNI",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eb4e4fa9-71d2-31e3-b27f-f950ef1980ac",
                                        "entry_id": "3421d239-f1b2-348a-a99b-c1161b05b468",
                                        "glosses": [
                                            "Variante de ovni."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "173ffcce-7851-4fc0-9438-5c78406729da",
                                                "sense_id": "eb4e4fa9-71d2-31e3-b27f-f950ef1980ac",
                                                "text": "Dimanche 26 juillet : les OVNI sont évoqués dans l’article de l’Union « Astronomie à Liez : La tête dans les étoiles », retraçant l’édition de la Nuit des Étoiles à Liez."
                                            },
                                            {
                                                "example_id": "397cafd0-d895-4f2a-be73-caebaab97482",
                                                "sense_id": "eb4e4fa9-71d2-31e3-b27f-f950ef1980ac",
                                                "text": "On n’avait pas recherché les OVNIs parce que personne ne croyait que l’on pourrait jamais les trouver. Six mois plus tôt, ces engins fantomatiques étaient apparus sur Terre […]."
                                            },
                                            {
                                                "example_id": "78e91e21-7c60-47e6-9448-e8984e2ed128",
                                                "sense_id": "eb4e4fa9-71d2-31e3-b27f-f950ef1980ac",
                                                "text": "Ces images faisaient partie du soi-disant incident de l’OVNI de Nimitz, dans lequel plusieurs membres du personnel de la marine américaine ont rapporté avoir vu plusieurs OVNIs en forme de tic-tac (gélule), au-dessus de la mer, une affaire qui été étudiée par l’AATIP."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
