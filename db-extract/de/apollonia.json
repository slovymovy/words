                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40472a81-42b3-427d-b5d0-dc79bc003559",
                                                "sense_id": "a0b197cb-041c-3d5b-b5cc-f08dad6fabc7",
                                                "text": "Sainte Apolline, ou Apollonie, d'Alexandrie."
                                            },
                                            {
                                                "example_id": "db853659-f835-4305-882a-697c55cc29f8",
                                                "sense_id": "a0b197cb-041c-3d5b-b5cc-f08dad6fabc7",
                                                "text": "Il y avait au bord d’une route un puits de sainte Apolline, dont l’eau guérissait les maux de dents. Je me souviens des gouttes bues dans le creux de la main, et de l’image pieuse de la martyre édentée par un bourreau romain, collée sur la joue, accompagnée d’un clou de girofle contre la gencive."
                                            },
                                            {
                                                "example_id": "1a531a3e-4813-43c3-be23-9af9d8a1b806",
                                                "sense_id": "a0b197cb-041c-3d5b-b5cc-f08dad6fabc7",
                                                "text": "Apolline sera en direct le mercredi 4 octobre et Florian le jeudi 5 octobre pour gagner leur place dans l’équipe des Grandes Gueules."
                                            }
                                        ]
                                    }
                                ]
                            }
