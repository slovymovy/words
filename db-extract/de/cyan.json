                "senses": [
                    {
                        "sense_id": "584f4e72-6bde-3ebc-a1b7-c013bdc1cc9a",
                        "entry_id": "d0935247-365d-3f34-ae36-6df4b21a025e",
                        "glosses": [
                            "Name des cyanfarbenen Farbtons, eines bestimmten Abschnitts des sichtbaren Lichts im Spektrum der elektromagnetischen Wellen, Malfarbe, Streichfarbe"
                        ],
                        "tags": [
                            "jargon",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "39f0e8c1-9a5a-476a-b95d-40a024fc5b8b",
                                "sense_id": "584f4e72-6bde-3ebc-a1b7-c013bdc1cc9a",
                                "text": "Leandros Hemd ist in einem hellen Cyan gehalten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "dd09cec5-b43e-312b-a599-c178ae634a3e",
                        "entry_id": "d0935247-365d-3f34-ae36-6df4b21a025e",
                        "glosses": [
                            "gasförmige, giftige chemische Verbindung aus Kohlenstoff und Stickstoff mit Bittermandelgeruch"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "b732e975-0ccc-4700-97e3-7ac990c05924",
                                "sense_id": "dd09cec5-b43e-312b-a599-c178ae634a3e",
                                "text": "Es bilden sich dort Verbindungen des Cyans mit dem Eisen, sogenanntes Berlinerblau, doch wird auch hier nicht alles Cyan aufgenommen, so daß das gereinigte Gas noch beträchtliche Mengen von Cyan enthält."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
