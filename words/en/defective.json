    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e3412d3b-615c-377f-a672-0455edfa449b",
                    "sense_definition": "Having one or more defects; imperfect, faulty, or not working properly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "imperfect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company had to recall thousands of cars because of a <w>defective</w> brake system."
                        },
                        {
                            "text": "If you receive a <w>defective</w> product, you can return it for a full refund."
                        }
                    ],
                    "synonyms": [
                        "faulty"
                    ],
                    "antonyms": [
                        "perfect",
                        "undefective"
                    ],
                    "common_phrases": [
