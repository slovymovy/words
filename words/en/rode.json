    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4314d4c9-b19c-3847-b42f-98eecca9a28e",
                    "sense_definition": "Simple past tense of the verb <w>ride</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verb_ride_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>rode</w> her bicycle to school yesterday morning.",
                            "target_lang_translations": {
                                "ru": "Вчера утром она <w>ехала</w> в школу на велосипеде.",
                                "zh": "昨天早上她<w>骑</w>自行车去了学校。"
                            }
                        },
                        {
                            "text": "We <w>rode</w> the bus because it was raining outside.",
                            "target_lang_translations": {
                                "ru": "Мы <w>поехали</w> на автобусе, потому что на улице шел дождь.",
                                "zh": "因为外面在下雨，我们<w>乘</w>了公交车。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rode a bike",
                        "rode a horse",
                        "rode the bus",
                        "rode away"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время глагола \"ride\" (ехать, кататься, скакать).",
                        "zh": "动词 ride 的过去式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ехал",
                                "target_lang_sense_clarification": "передвигался на транспорте или верхом"
                            },
                            {
                                "target_lang_word": "катался",
                                "target_lang_sense_clarification": "совершал прогулку для удовольствия"
                            },
                            {
                                "target_lang_word": "скакал",
                                "target_lang_sense_clarification": "ехал верхом на лошади"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "骑",
                                "target_lang_sense_clarification": "骑马或自行车"
                            },
                            {
                                "target_lang_word": "乘",
                                "target_lang_sense_clarification": "乘坐交通工具"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d1737fc-c78f-3243-9550-b748a27c8277",
                    "sense_definition": "Past participle of <w>ride</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verb_ride_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has <w>rode</w> with the best horsemen in the county.",
                            "target_lang_translations": {
                                "ru": "Он <w>ездил верхом</w> с лучшими всадниками в округе.",
                                "zh": "他曾与县里最优秀的骑手一起<w>骑马</w>。"
                            }
                        },
                        {
                            "text": "They have <w>rode</w> many miles to reach this destination.",
                            "target_lang_translations": {
                                "ru": "Они <w>проехали</w> много миль, чтобы добраться до этого места.",
                                "zh": "他们<w>骑行</w>了许多英里才到达目的地。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Standard modern English uses 'ridden' as the past participle."
                        },
                        {
                            "trait_type": "dialectal",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие прошедшего времени от \"ride\" (нестандартное или диалектное употребление вместо \"ridden\").",
                        "zh": "ride 的过去分词（非标准用法）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ездил",
                                "target_lang_sense_clarification": "форма причастия/прошедшего времени"
                            },
                            {
                                "target_lang_word": "скакал",
                                "target_lang_sense_clarification": "верхом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "骑过",
                                "target_lang_sense_clarification": "表示经历"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ec36c0d-ef4a-3019-898f-1d363561ccf1",
                    "sense_definition": "Of a male woodcock, to fly back and forth over the edge of a woodland while calling, typically during the mating season.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The naturalist waited quietly to watch the woodcock as it <w>rode</w> in the twilight.",
                            "target_lang_translations": {
                                "ru": "Натуралист тихо ждал, чтобы понаблюдать за вальдшнепом, когда тот <w>тянул</w> в сумерках.",
                                "zh": "博物学家静静地等待着，观察那只在暮色中进行<w>求偶飞行</w>的丘鹬。"
                            }
                        },
                        {
                            "text": "We heard the bird call as it <w>rode</w> along the forest boundary.",
                            "target_lang_translations": {
                                "ru": "Мы слышали крик птицы, когда она <w>тянула</w> вдоль границы леса.",
                                "zh": "我们听见那只鸟沿着森林边缘<w>求偶飞行</w>时发出的叫声。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical or ornithological context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "О вальдшнепе: совершать брачный полет, издавая характерные звуки (тянуть).",
                        "zh": "指雄性丘鹬在繁殖季节飞行并发出叫声。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тянул",
                                "target_lang_sense_clarification": "охотничий термин для вальдшнепа"
                            },
                            {
                                "target_lang_word": "токовал",
                                "target_lang_sense_clarification": "о брачном поведении птиц"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "求偶飞行",
                                "target_lang_sense_clarification": "鸟类行为"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "525f2e6f-6cb6-3a0b-8c6c-f297a4e2f181",
                    "sense_definition": "The rope, chain, or cable connecting a vessel to its anchor.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain ordered the crew to let out more <w>rode</w> to secure the boat.",
                            "target_lang_translations": {
                                "ru": "Капитан приказал команде вытравить больше <w>якорного каната</w>, чтобы закрепить лодку.",
                                "zh": "船长命令船员放出更多的<w>锚链</w>以固定船只。"
                            }
                        },
                        {
                            "text": "You must check the anchor <w>rode</w> for any signs of fraying or damage.",
                            "target_lang_translations": {
                                "ru": "Вы должны проверить якорный <w>трос</w> на наличие признаков износа или повреждений.",
                                "zh": "你必须检查<w>锚索</w>是否有磨损或损坏的迹象。"
                            }
                        }
                    ],
                    "synonyms": [
                        "warp"
                    ],
                    "common_phrases": [
                        "anchor rode",
                        "chain rode"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "nautical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Веревка, цепь или трос, соединяющие судно с якорем.",
                        "zh": "连接船只与锚的绳索、链条或缆绳。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "якорный канат",
                                "target_lang_sense_clarification": "морской термин"
                            },
                            {
                                "target_lang_word": "трос",
                                "target_lang_sense_clarification": "общее значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "锚链",
                                "target_lang_sense_clarification": "航海术语"
                            },
                            {
                                "target_lang_word": "锚索",
                                "target_lang_sense_clarification": "航海术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c920fd07-55d3-34a3-b8d3-fce96b958ec2",
                    "sense_definition": "Obsolete spelling of <w>road</w>, referring to a hostile incursion or raid.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knights prepared for a night <w>rode</w> into the enemy lands.",
                            "target_lang_translations": {
                                "ru": "Рыцари готовились к ночному <w>набегу</w> на вражеские земли.",
                                "zh": "骑士们准备对敌方领土进行一次夜间<w>袭击</w>。"
                            }
                        },
                        {
                            "text": "Historical texts describe how they made a <w>rode</w> to capture cattle.",
                            "target_lang_translations": {
                                "ru": "Исторические тексты описывают, как они совершили <w>набег</w> для захвата скота.",
                                "zh": "历史文献描述了他们如何进行一次<w>突袭</w>以掠夺牲畜。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшее написание слова \"road\" в значении враждебного вторжения или набега.",
                        "zh": "road 的过时拼写，指敌对的入侵或袭击。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "набег",
                                "target_lang_sense_clarification": "вторжение"
                            },
                            {
                                "target_lang_word": "рейд",
                                "target_lang_sense_clarification": "военная операция"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "袭击",
                                "target_lang_sense_clarification": "军事行动"
                            },
                            {
                                "target_lang_word": "突袭",
                                "target_lang_sense_clarification": "军事行动"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "50bdec3b-f1c8-38ec-be5c-659991c954ca",
                    "sense_definition": "A village and civil parish in Somerset, England.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They visited a small historic church in the village of <w>Rode</w>.",
                            "target_lang_translations": {
                                "ru": "Они посетили небольшую историческую церковь в деревне <w>Роуд</w>.",
                                "zh": "他们参观了<w>罗德</w>村里一座历史悠久的小教堂。"
                            }
                        },
                        {
                            "text": "My friend moved to <w>Rode</w> to enjoy the quiet countryside.",
                            "target_lang_translations": {
                                "ru": "Мой друг переехал в <w>Роуд</w>, чтобы насладиться тихой сельской местностью.",
                                "zh": "我的朋友搬到了<w>罗德</w>，以享受宁静的乡村生活。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Деревня и гражданский приход в графстве Сомерсет, Англия.",
                        "zh": "英国萨默塞特郡的一个村庄和民政教区。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Роуд",
                                "target_lang_sense_clarification": "географическое название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "罗德",
                                "target_lang_sense_clarification": "地名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be7fb550-64bf-3229-ad2c-946e1f7d812d",
                    "sense_definition": "A surname indicating a person who lived near a clearing or came from a place called Rode.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Rode</w> was known for his expertise in local history.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Роуд</w> был известен своими познаниями в местной истории.",
                                "zh": "<w>罗德</w>先生以其在地方史方面的专业知识而闻名。"
                            }
                        },
                        {
                            "text": "I have an appointment with Dr. <w>Rode</w> tomorrow afternoon.",
                            "target_lang_translations": {
                                "ru": "У меня назначена встреча с доктором <w>Роудом</w> завтра днем.",
                                "zh": "我明天下午和<w>罗德</w>医生有个预约。"
                            }
