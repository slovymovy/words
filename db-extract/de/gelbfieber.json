                ],
                "senses": [
                    {
                        "sense_id": "6d926437-c086-3777-8550-7de13236bb88",
                        "entry_id": "27611b53-eaf0-32bf-89bc-faf9eb8e95a9",
                        "glosses": [
                            "Krankheit, die durch eine Infektion mit dem Gelbfieber-Virus ausgelöst wird und die in tropischen und subtropischen Gebieten in Südamerika und Afrika vorkommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15f5ad7a-8cdc-408e-a6ab-2092b9caa05b",
                                "sense_id": "6d926437-c086-3777-8550-7de13236bb88",
                                "text": "Das Gelbfieber ist in den Tropen verbreitet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ca48840-34bc-4b3a-92da-8d8e734ba15c",
                        "source_entry_id": "27611b53-eaf0-32bf-89bc-faf9eb8e95a9",
                        "source_sense_id": "6d926437-c086-3777-8550-7de13236bb88",
                        "target_lang_word": "yellow fever",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yellow fever",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86be8014-d6f2-3277-be7e-4fcac1ecc7cb",
                                        "entry_id": "cebada78-b975-307a-b2d8-a63dd3c24f7b",
                                        "glosses": [
                                            "An acute febrile illness of tropical regions, caused by a flavivirus (Yellow fever virus) and spread by certain mosquitoes, characterised by jaundice, black vomit and the absence of urination."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9dd0b750-a3c1-4586-9b3f-cd6e41787a48",
                                                "sense_id": "86be8014-d6f2-3277-be7e-4fcac1ecc7cb",
                                                "text": "The town up the road was overcome by yellow fever, he said. All travelers warned away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9514e3da-286b-3734-b8ff-05f8239e3c81",
                                        "entry_id": "cebada78-b975-307a-b2d8-a63dd3c24f7b",
                                        "glosses": [
                                            "An attraction to ethnically East Asian men or women, expressed by non-East Asian (especially white European male or white American) people."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f01d8a9f-c8b7-4616-97b8-ab6adaf754a0",
                                                "sense_id": "9514e3da-286b-3734-b8ff-05f8239e3c81",
                                                "text": "Your girl want me, we both know / Cause she got yellow fever"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b4c9c26-afd0-3273-811a-70b6658019d3",
                                        "entry_id": "cebada78-b975-307a-b2d8-a63dd3c24f7b",
                                        "glosses": [
                                            "A lust for gold; an obsession with seeking gold ore."
                                        ],
                                        "tags": [
                                            "dated",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "329e071e-d30e-43c0-be83-89749856796b",
                                                "sense_id": "4b4c9c26-afd0-3273-811a-70b6658019d3",
                                                "text": "He's got the yellow fever; Once get the sight of gold and you are poisoned."
                                            },
                                            {
                                                "example_id": "ba09bcbc-a0c7-4a7d-8c93-8b42328ee136",
                                                "sense_id": "4b4c9c26-afd0-3273-811a-70b6658019d3",
                                                "text": "An onze a day, two a day, or three—every one has the gold or yellow fever. Last night several of the most respectible American residents of this town arrived home from a visit to the gold regions."
                                            },
                                            {
                                                "example_id": "15908855-b1e0-466c-8b81-352e180de8dd",
                                                "sense_id": "4b4c9c26-afd0-3273-811a-70b6658019d3",
                                                "text": "But the true yellow fever that has abounded in the lower gold-bearing valleys around Guanay can possibly illustrate in sickness what takes place in actuality among the sons of men who are seduced by the lust for gold."
                                            },
                                            {
                                                "example_id": "7f4fae29-b573-4871-83d3-251d84850483",
                                                "sense_id": "4b4c9c26-afd0-3273-811a-70b6658019d3",
                                                "text": "In the stories he wrote and published about the gold rush, Dickens does not resolve characters' feelings of class resentment so much as explain them in non-political terms […] Dickens spreads this strain of 'yellow fever' among his characters, making their labour unrest seem both understandable and pathological."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2c2f924-3b69-4e94-9856-197fbaa2f179",
                        "source_entry_id": "27611b53-eaf0-32bf-89bc-faf9eb8e95a9",
                        "source_sense_id": "6d926437-c086-3777-8550-7de13236bb88",
                        "target_lang_word": "fièvre jaune",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fièvre jaune",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "57564275-8f3c-3471-a720-88750b74e2f0",
                                        "entry_id": "3d48ba64-36ad-32b0-8532-30a1ae69e67c",
                                        "glosses": [
                                            "Maladie virale transmise par des moustiques et caractérisée par des maux de tête et des fièvres."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c50bcade-606d-4d61-acd7-18db055b083e",
                                                "sense_id": "57564275-8f3c-3471-a720-88750b74e2f0",
                                                "text": "Merde ! Et la fièvre jaune ? Et le béribéri, l’arthrite des femmes enceintes et le goudou-goudou…"
                                            },
                                            {
                                                "example_id": "95ab0d11-0e5f-4b22-9310-287067ac8964",
                                                "sense_id": "57564275-8f3c-3471-a720-88750b74e2f0",
                                                "text": "La route passe devant le cimetière où se trouvent toutes les tombes des premiers travailleurs français du canal victimes de la terrible fièvre jaune."
                                            },
                                            {
                                                "example_id": "14ee08d0-49ab-4a3e-a695-4b86843df289",
                                                "sense_id": "57564275-8f3c-3471-a720-88750b74e2f0",
                                                "text": "On connait plus de 300 arbovirus, et on en isole toujours de nouveaux. […]. Parmi les infections qu'ils provoquent, il faut citer à cause de leur grande incidence et de leur gravité la fièvre jaune, les méningo-encéphalites américaines, l’encéphalite japonaise B."
                                            },
                                            {
                                                "example_id": "a795a069-76cb-4b8a-b5cc-557fae17c080",
                                                "sense_id": "57564275-8f3c-3471-a720-88750b74e2f0",
                                                "text": "Afin de mieux étudier le cycle selvatique du virus de la fièvre jaune, cycle au cours duquel un moustique s'infecte en piquant un singe avant de réinjecter le virus à un autre singe, les virologues et entomologistes décident de mener un programme de « singes sentinelles »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea424207-92aa-48d9-8333-a0ecec5035e5",
                        "source_entry_id": "27611b53-eaf0-32bf-89bc-faf9eb8e95a9",
