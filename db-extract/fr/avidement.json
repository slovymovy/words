        "fr-extract.jsonl": [
            {
                "entry_id": "df0fc9ab-06bf-3aa6-88f2-46aacfd8eab0",
                "word": "avidement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "712da004-7033-3c82-b1ce-2c14e0c573df",
                        "entry_id": "df0fc9ab-06bf-3aa6-88f2-46aacfd8eab0",
                        "glosses": [
                            "D’une manière avide ; avec avidité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "427607ab-6569-4e09-b83c-2caa4257ebe8",
                                "sense_id": "712da004-7033-3c82-b1ce-2c14e0c573df",
                                "text": "L’homme souleva ma tête avec des mouvements doux, me fit boire quelques gorgées d’un breuvage que j’avalai avidement."
                            },
                            {
                                "example_id": "af47a634-919d-4d99-bc0f-a234c43e4f8c",
                                "sense_id": "712da004-7033-3c82-b1ce-2c14e0c573df",
                                "text": "On lui mit une boîte de viande entre les mains et il en dévora avidement le contenu, non sans boire à même la bouteille d’ale."
                            },
                            {
                                "example_id": "0f8c299a-b36e-44e7-a617-94549cf7df6b",
                                "sense_id": "712da004-7033-3c82-b1ce-2c14e0c573df",
                                "text": "— Il la couvrait avidement de caresses, murmurait les mots d'amour les plus doux, et tous deux se perdaient dans une extase furieuse et passionnée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f8f371c-fe3a-458d-9e9c-05dbae315121",
                        "source_entry_id": "df0fc9ab-06bf-3aa6-88f2-46aacfd8eab0",
                        "source_sense_id": "712da004-7033-3c82-b1ce-2c14e0c573df",
                        "target_lang_word": "gierig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gierig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c8b1f37f-8152-3507-b273-dd50c1a6997e",
                                        "entry_id": "91688a52-5b34-3db2-8dfc-6330f86422e9",
                                        "glosses": [
                                            "triebartig danach verlangend, etwas zu bekommen oder zu besitzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38389943-1c68-435d-8a0a-eef27b1e7a72",
                                                "sense_id": "c8b1f37f-8152-3507-b273-dd50c1a6997e",
                                                "text": "Der Pirat starrte gierig auf die Schätze."
                                            },
                                            {
                                                "example_id": "ca0167e2-23bb-4c68-bb3f-2db963b21e8a",
                                                "sense_id": "c8b1f37f-8152-3507-b273-dd50c1a6997e",
                                                "text": "Gierig verschlang der Gefangene einen Teller Suppe."
                                            },
                                            {
                                                "example_id": "cc1612ff-8850-4e79-8a3b-77b9a4c60456",
                                                "sense_id": "c8b1f37f-8152-3507-b273-dd50c1a6997e",
                                                "text": "Der Mann saß an der Bar und verschlang die Stripperin mit gierigem Blick."
                                            },
                                            {
                                                "example_id": "017944bc-c030-4b74-b3db-6c6b62bee8f4",
                                                "sense_id": "c8b1f37f-8152-3507-b273-dd50c1a6997e",
                                                "text": "Die Mannschaft ist gieriger auf den Titel als auf die Prämie."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8500dec-323b-4634-ac43-ebb85fef4ab0",
                        "source_entry_id": "df0fc9ab-06bf-3aa6-88f2-46aacfd8eab0",
                        "source_sense_id": "712da004-7033-3c82-b1ce-2c14e0c573df",
                        "target_lang_word": "begierig",
