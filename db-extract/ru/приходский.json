                                                "sense_id": "2d76a0c9-cc04-3df8-a1ba-6ae108d539fc",
                                                "text": "Église, messe paroissiale."
                                            },
                                            {
                                                "example_id": "5df68c55-f226-4952-be97-7746e415b71d",
                                                "sense_id": "2d76a0c9-cc04-3df8-a1ba-6ae108d539fc",
                                                "text": "Conseil paroissial."
                                            },
                                            {
                                                "example_id": "1476cdd7-1626-4b01-b371-17fd54e2fe29",
                                                "sense_id": "2d76a0c9-cc04-3df8-a1ba-6ae108d539fc",
                                                "text": "Mais ce fut inutile et il dut se résigner à l’humiliation de cette exhibition publique à ce pilori paroissial."
                                            },
                                            {
                                                "example_id": "78021044-1bab-4aac-a149-cbbed0e749db",
                                                "sense_id": "2d76a0c9-cc04-3df8-a1ba-6ae108d539fc",
                                                "text": "Sa religion était une religion du cimetière plus que de l’église, sa fidélité paroissiale plus que cléricale."
