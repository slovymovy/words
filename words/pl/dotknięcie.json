    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "019f3d29-7433-3487-a278-47d376197bac",
                    "sense_definition": "fizyczny kontakt z czymś lub kimś za pomocą części ciała, zwłaszcza dłoni",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kontakt_fizyczny",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Delikatne <w>dotknięcie</w> dłoni wystarczyło, aby poczuł się znacznie spokojniejszy.",
                            "target_lang_translations": {
                                "ru": "Нежного <w>прикосновения</w> руки было достаточно, чтобы он почувствовал себя намного спокойнее."
                            }
                        },
                        {
                            "text": "Telefon reaguje nawet na bardzo lekkie <w>dotknięcie</w> ekranu.",
                            "target_lang_translations": {
                                "ru": "Телефон реагирует даже на самое лёгкое <w>касание</w> экрана."
                            }
                        }
                    ],
                    "synonyms": [
                        "dotyk"
                    ],
                    "common_phrases": [
                        "lekkie dotknięcie",
                        "delikatne dotknięcie"
                    ],
                    "target_lang_definitions": {
                        "ru": "физический контакт с кем-либо или чем-либо с помощью части тела, особенно руки"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прикосновение",
                                "target_lang_sense_clarification": "физический контакт, осязание"
                            },
                            {
                                "target_lang_word": "касание",
                                "target_lang_sense_clarification": "лёгкое физическое воздействие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2dd8c11c-866e-3ee1-a0c0-3be58169d015",
                    "sense_definition": "rzeczownik odczasownikowy od: <w>dotknąć</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kontakt_fizyczny",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Samo <w>dotknięcie</w> tego eksponatu w muzeum groziło natychmiastowym włączeniem alarmu.",
                            "target_lang_translations": {
                                "ru": "Одно лишь <w>прикосновение</w> к этому экспонату в музее грозило немедленным срабатыванием сигнализации."
                            }
                        },
                        {
                            "text": "Lekarz ostrzegł pacjenta, że przypadkowe <w>dotknięcie</w> rany może wywołać zakażenie.",
                            "target_lang_translations": {
                                "ru": "Врач предупредил пациента, что случайное <w>касание</w> раны может вызвать заражение."
                            }
                        }
                    ],
                    "antonyms": [
                        "niedotknięcie"
                    ],
                    "target_lang_definitions": {
                        "ru": "действие по значению глагола dotknąć; единичный акт касания"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прикосновение",
                                "target_lang_sense_clarification": "действие касания"
                            },
                            {
                                "target_lang_word": "касание",
                                "target_lang_sense_clarification": "действие по соприкосновению"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3e812e4-f122-3cd3-951d-dc8c8ac4a174",
                    "sense_definition": "uraza psychiczna wywołana przykrą uwagą lub niestosownym zachowaniem",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "uraza",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W jego głosie dało się wyczuć głębokie <w>dotknięcie</w> tą niesprawiedliwą krytyką.",
                            "target_lang_translations": {
                                "ru": "В его голосе чувствовалась глубокая <w>обида</w> из-за этой несправедливой критики."
                            }
                        },
                        {
                            "text": "Niewybredny żart kolegi spowodował u niej bolesne <w>dotknięcie</w>.",
                            "target_lang_translations": {
                                "ru": "Грубая шутка коллеги нанесла ей болезненное <w>уязвление</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "uraza",
                        "zniewaga"
                    ],
                    "common_phrases": [
                        "bolesne dotknięcie"
                    ],
                    "target_lang_definitions": {
                        "ru": "психическая травма, обида, вызванная резким замечанием или неподобающим поведением"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обида",
                                "target_lang_sense_clarification": "уязвлённое чувство, задетое самолюбие"
                            },
                            {
                                "target_lang_word": "уязвление",
                                "target_lang_sense_clarification": "удар по самолюбию, ущемление чувств"
                            }
                        ]
                    }
                }
            ]
        }
    ]
