                        "glosses": [
                            "persoon of organisatie die zorgt voor de benodigde geldelijke middelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "859efc08-5a06-493c-889e-e0bf7cc1a9ca",
                                "sense_id": "5026ca42-1a41-322a-a743-0b03af96ed7a",
                                "text": "Jamaloodin en Dos Santos werden genoemd door een groot aantal getuigen in de zaak tegen Burney 'Nini' Fonseca, de man die de schakel vormde tussen opdrachtgevers en uitvoerders van de moord. Het Openbaar Ministerie liet in de zaak-Fonseca in het midden of Dos Santos financierder was of opdrachtgever om Wiels te liquideren."
                            },
                            {
                                "example_id": "c11578f5-5764-4a0b-920c-9c38f06857a8",
                                "sense_id": "5026ca42-1a41-322a-a743-0b03af96ed7a",
                                "text": "ICAN heeft ook een Nederlandse tak, de vredesbeweging PAX. PAX is mede-financierder van ICAN en heeft ook een vertegenwoordiger in het bestuur."
                            }
                        ]
                    }
