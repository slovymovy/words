                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d607512b-7f64-42a7-8854-0d363f0b9aaf",
                                "sense_id": "5a28029d-7398-395f-9125-d9781f8db7ae",
                                "text": "Ramsauer kaufte von seinem Arbeitgeber eine Villa in der Himmelstraße um 9,6 Mio. Euro und verkaufte diese nur zwei Monate [später] mit einem Gewinn von 14 Mio. Euro um 23,8 Mio. Euro an einen russischen Öl-Manager, berichtet das Magazin \"Gewinn\"."
                            },
                            {
                                "example_id": "4d04a95c-edb3-4942-935b-4e720de4f57d",
                                "sense_id": "5a28029d-7398-395f-9125-d9781f8db7ae",
                                "text": "Bereits als Schüler wurde Ramsauer 1972 Mitglied der Jungen Union und 1973 auch der CSU."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
