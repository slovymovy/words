                                        "sense_id": "47a1d319-6d56-3aa7-8037-7ae7a610d9fb",
                                        "entry_id": "ad2f1852-bf92-3e1d-b2ea-4f294178368b",
                                        "glosses": [
                                            "Tänzerin in einem hinduistischen Tempel"
                                        ],
                                        "tags": [],
