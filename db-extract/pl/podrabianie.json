                            {
                                "example_id": "04823a11-2d96-432a-ac02-314f74017c60",
                                "sense_id": "2a644e7c-5e3d-3af1-9a68-d174a5a69bcc",
                                "text": "Uczennica została zawieszona w prawach ucznia za podrabianie zwolnień i bezczelność."
