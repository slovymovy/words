                                        "glosses": [
                                            "związek organiczny z grupy chlorków kwasowych, bezbarwny gaz o zapachu świeżo skoszonej trawy lub zgniłych owoców, stosowany jako bojowy środek trujący z grupy duszących w czasie I wojny światowej"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb54abaf-083b-463c-a7af-fde42d314f10",
                                                "sense_id": "d632b4ce-954f-3a6c-8eff-a3d4b1169576",
                                                "text": "Podczas spalania polichlorku winylu mogą powstawać pewne ilości fosgenu."
                                            }
