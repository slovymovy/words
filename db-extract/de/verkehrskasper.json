                "senses": [
                    {
                        "sense_id": "058ffb73-449c-34ca-bba7-cc635e587800",
                        "entry_id": "68ede645-928a-316f-a5fe-2b9a5d269add",
                        "glosses": [
                            "Puppenfigur, die vornehmlich zur Verkehrserziehung von Kindern eingesetzt wird, auch die Kasperlebühne, auf der er auftritt oder die Methode des Lehrtheaters"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32e7a531-8183-423a-9627-99fb08a1bddc",
                                "sense_id": "058ffb73-449c-34ca-bba7-cc635e587800",
                                "text": "„Der Verkehrskasper ist aus der traditionellen Verkehrserziehung nicht mehr wegzudenken.“"
                            },
                            {
                                "example_id": "726a227b-0d09-4c8f-8fb7-f38589ffad60",
                                "sense_id": "058ffb73-449c-34ca-bba7-cc635e587800",
                                "text": "„Einmal war der Verkehrskasper in den Kindergarten gekommen. Genauer, es war ein Polizist, der zwei Handpuppen dabei hatte, einen Kasper und eben das Krokodil.“"
                            },
                            {
                                "example_id": "6ce36e0b-33a7-40ae-929e-28961e245fff",
                                "sense_id": "058ffb73-449c-34ca-bba7-cc635e587800",
                                "text": "„In Form eines Puppenspiels bringt der Verkehrskasper Aspekte der Verkehrserziehung zur Sprache.“"
                            },
                            {
                                "example_id": "71e71f15-e220-4797-9a0c-6edc9818958c",
                                "sense_id": "058ffb73-449c-34ca-bba7-cc635e587800",
                                "text": "„In diesem Rahmen sind jedoch fast anarchistische, auf die möglichst unmittelbare Befriedigung körperlicher Bedürfnisse zielende Kasperles ebenso möglich wie der erzieherische Verkehrskasper, der Erstkläßlern einschärft, bei Rot stehenzubleiben.“"
                            },
                            {
                                "example_id": "c3a1746f-7ae4-48f8-ad41-f73b445eeb6f",
                                "sense_id": "058ffb73-449c-34ca-bba7-cc635e587800",
                                "text": "„Jedes Kind weiß, dass man vor dem Überqueren der Straße nach links, rechts und nochmal nach links schauen muss. Einen großen Anteil daran trägt der Verkehrskasper, der in Schleswig-Holstein seit 1954 in Kindergärten Verkehrswissen vermittelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
