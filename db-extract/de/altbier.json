                "senses": [
                    {
                        "sense_id": "ff632b1b-66c5-33c8-9860-c61541916dba",
                        "entry_id": "61184c56-a151-3cb6-8073-7b070ae5cded",
                        "glosses": [
                            "obergäriges Bier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b65814c-14bc-4b75-a1b6-e098d88527e6",
                                "sense_id": "ff632b1b-66c5-33c8-9860-c61541916dba",
                                "text": "Im Rheinland trinkt man häufig Altbier."
                            },
                            {
                                "example_id": "aba772f5-b740-4484-a1cd-314dc0338406",
                                "sense_id": "ff632b1b-66c5-33c8-9860-c61541916dba",
                                "text": "„Zu den obergärigen Bieren zählen Kölsch, Weizen- oder Altbier.“"
                            },
                            {
                                "example_id": "0a869dde-7f02-4967-a402-7f130d3c0e79",
                                "sense_id": "ff632b1b-66c5-33c8-9860-c61541916dba",
                                "text": "„Der Mann, der sich heute Mittag bei uns darüber beschwerte, dass es an Bord kein Altbier gebe, sitzt allein an einem Vierer-Tisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
