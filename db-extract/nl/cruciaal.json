                                        "glosses": [
                                            "Essential or decisive for determining the outcome or future of something; extremely important; vital."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4defd41-57c0-4891-9b82-4e5472e596eb",
                                                "sense_id": "af204e1b-56fc-354d-a1e5-077ee1d51b07",
                                                "text": "A secure supply of crude oil is crucial for any modern nation, let alone a superpower."
                                            },
                                            {
                                                "example_id": "65337102-703c-41d5-af5e-2d6d4bf7a045",
                                                "sense_id": "af204e1b-56fc-354d-a1e5-077ee1d51b07",
                                                "text": "The battle of Tali-Ihantala in 1944 is one of the crucial moments in the history of Finland."
                                            },
                                            {
                                                "example_id": "51c00eef-25b6-45f5-82cc-0f4457f6ca59",
                                                "sense_id": "af204e1b-56fc-354d-a1e5-077ee1d51b07",
                                                "text": "The perfume industry is facing a major problem: maintaining constant levels of quality is crucial, but it is increasingly difficult to obtain a regular supply of all the necessary natural ingredients."
                                            },
                                            {
                                                "example_id": "af76c002-e8c7-4094-8d3c-029740f9ed1d",
                                                "sense_id": "af204e1b-56fc-354d-a1e5-077ee1d51b07",
                                                "text": "Vocabulary provides a foundation from which grammar, phonology, and morphology emerge, and in a subject area it provides access to conceptual knowledge. Vocabulary selection for pedagogical purposes is therefore crucial."
                                            },
                                            {
                                                "example_id": "6a1965c4-9bcb-4db5-9c70-784c832825cd",
                                                "sense_id": "af204e1b-56fc-354d-a1e5-077ee1d51b07",
                                                "text": "Language is crucial because it is the best weapon against violence. When children don’t have the words to express their thoughts, they raise their fists."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c546e5f3-1994-3e8c-8ab1-93a6cea50539",
                                        "entry_id": "de1ee0e5-53bf-3052-a628-8f4b84e1f2df",
                                        "glosses": [
                                            "Cruciform or cruciate; cross-shaped."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
