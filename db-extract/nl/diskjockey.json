                        "examples": [
                            {
                                "example_id": "c46a4c6a-4644-45de-9d9a-ddcd5ae380db",
                                "sense_id": "203b975e-5ac5-3abc-aa22-f24d1027fec0",
                                "text": "DJ Tiesto en Armin van Buuren zijn Nederlandse diskjockeys die tot de wereldtop behoren"
                            },
                            {
                                "example_id": "cb13318b-7f70-4117-ab03-68a3a51d375b",
                                "sense_id": "203b975e-5ac5-3abc-aa22-f24d1027fec0",
                                "text": "Het was de basis voor zijn eenzelvigheid. Op de middelbare school werd Muskee geraakt door On the Road van Jack Kerouac en The Naked Lunch van William Burroughs. Discjockey [sic!]Willis Conover van radiozender The Voice of America stak hem aan met jazz en blues. Vooral de dampende liedjes van John Lee Hooker maakten indruk."
                            }
                        ]
                    }
