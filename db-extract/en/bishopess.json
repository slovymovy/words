                                            "in einzelnen christlichen Kirchen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "029eb7be-c677-44d0-bd36-c355e7e50424",
                                                "sense_id": "ae171454-5c01-325a-9ed2-e3d8a42efa5c",
                                                "text": "In der evangelischen Kirche gibt es im Gegensatz zur katholischen auch Bischöfinnen."
                                            },
                                            {
                                                "example_id": "40609443-2568-4a26-9883-c6774c47eb0e",
                                                "sense_id": "ae171454-5c01-325a-9ed2-e3d8a42efa5c",
                                                "text": "„Die Bischöfin wollte wissen, an welchen Ausweg ihre Schwester da gedacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
