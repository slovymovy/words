                "senses": [
                    {
                        "sense_id": "24180427-a599-391f-bb06-c9978dc585ac",
                        "entry_id": "de1a9c2c-4e89-3e72-b5f9-3cd3a480d7d6",
                        "glosses": [
                            "der Göttin Athene geweihter Tempel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3789d1d5-40a8-4925-8d8a-0f185289b479",
                                "sense_id": "24180427-a599-391f-bb06-c9978dc585ac",
                                "text": "Das Athenäum war ein prächtiger Bau."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fd121807-549e-34fb-b2b3-f03abaf2d798",
                        "entry_id": "de1a9c2c-4e89-3e72-b5f9-3cd3a480d7d6",
                        "glosses": [
                            "Form einer weiterführenden Schule (insbesondere in Belgien)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5e6000e-cdad-4e4f-8d67-393d180a653f",
                                "sense_id": "fd121807-549e-34fb-b2b3-f03abaf2d798",
                                "text": "„In der Mensa des Athenäums in Eupen ist ausreichend Platz für die rund ein Dutzend Familien, die das Angebot wahrnehmen.“"
                            },
                            {
                                "example_id": "382e2c02-7fe8-4b63-87e9-baa418f7ee6f",
                                "sense_id": "fd121807-549e-34fb-b2b3-f03abaf2d798",
                                "text": "„Das Institut für Weiterbildung im César-Franck-Athenäum Kelmis bietet Abendkurse für Erwachsene.“"
                            },
                            {
                                "example_id": "86b63211-a69f-418b-b461-92122d3b6ae9",
                                "sense_id": "fd121807-549e-34fb-b2b3-f03abaf2d798",
                                "text": "„Im Königlichen Athenäum in Eupen wird in ausgewählten Klassen des ersten und zweiten Jahres eine unkonventionelle Unterrichtsform angewandt.“"
                            },
                            {
                                "example_id": "cf62535f-1480-4561-b608-7dc30bf8b801",
                                "sense_id": "fd121807-549e-34fb-b2b3-f03abaf2d798",
                                "text": "„Seine Mutter Rosalia, die sich als Haushälterin bei begüterten Leuten verdingte, war aber von der Begabung ihres Sohnes überzeugt und erreichte für ihn einen Studienplatz im Königlichen Athenäum, einer staatlichen Schule.“"
                            },
                            {
                                "example_id": "4638fd77-6e8e-46ad-bdcc-a0827e970898",
                                "sense_id": "fd121807-549e-34fb-b2b3-f03abaf2d798",
                                "text": "„Nachdem die Familie an die belgische Seeküste umgesiedelt war, studierte René am Königlichen Athenäum in Brügge, wo er 1939 als Primus seiner Klasse die Schullaufbahn beendete."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
