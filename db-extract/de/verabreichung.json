                        "sense_id": "e32842ad-8439-326d-a91e-12812c47492d",
                        "entry_id": "1e83e64d-bee2-35ce-8bd3-d4fec8565fd9",
                        "glosses": [
                            "Handlung, bei der jemandem etwas (eine Substanz) gegeben wird, damit dieser es einnimmt (wissentlich oder versehentlich)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29581b0d-050d-4fe7-9088-9d2a7e2dca3b",
                                "sense_id": "e32842ad-8439-326d-a91e-12812c47492d",
                                "text": "Nach der Verabreichung des Medikaments setzt Müdigkeit ein, die jedoch schnell wieder vorübergeht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "59dd4565-7903-4d3b-b461-79fafe3d8274",
                        "source_entry_id": "1e83e64d-bee2-35ce-8bd3-d4fec8565fd9",
                        "source_sense_id": "e32842ad-8439-326d-a91e-12812c47492d",
                        "target_lang_word": "administration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "administration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6519d1d6-163e-3046-a639-646e8ac31a79",
                                        "entry_id": "b341397f-7cef-3673-916d-7d9323f718a2",
                                        "glosses": [
                                            "The act of administering; government of public affairs; the service rendered, or duties assumed, in conducting affairs; the conducting of any office or employment; direction."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49e79c84-d90d-420c-91c9-9e877ff4b068",
                                                "sense_id": "6519d1d6-163e-3046-a639-646e8ac31a79",
                                                "text": "[…] the fact that the propertied classes are no longer the best educated, and the fact that the large number of people who owe their position solely to their general education do not possess that experience of the working of the economic system which the administration of property gives are important to understanding the role of the intellectual."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5399fa8-0959-3ae7-88f5-4b17ccb09d78",
                                        "entry_id": "b341397f-7cef-3673-916d-7d9323f718a2",
                                        "glosses": [
                                            "The executive part of government; the persons collectively who are entrusted with the execution of laws and the superintendence of public affairs; the chief magistrate and his cabinet or council; or the council, or ministry, alone, as in Great Britain."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae9ae490-82b5-459e-9ee7-eb7722cd1971",
                                                "sense_id": "e5399fa8-0959-3ae7-88f5-4b17ccb09d78",
                                                "text": "Successive US administrations have had similar Middle East policies."
                                            },
                                            {
                                                "example_id": "493a743d-a3e6-4321-b983-1ff7a3bf0fc1",
                                                "sense_id": "e5399fa8-0959-3ae7-88f5-4b17ccb09d78",
                                                "text": "The trove of documents from half a dozen federal agencies in recent days are a direct result of a blockbuster Supreme Court decision last month that allowed the administration to develop plans for ending birthright citizenship – even though the effort has once again been placed on hold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67f01ee3-b205-3c3b-95b5-04a7e47fa2f7",
                                        "entry_id": "b341397f-7cef-3673-916d-7d9323f718a2",
                                        "glosses": [
                                            "The country's government under the rule of a particular leader."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3d1b8a4-c94b-4bf0-bc5e-1cb27f708127",
                                                "sense_id": "67f01ee3-b205-3c3b-95b5-04a7e47fa2f7",
                                                "text": "The Obama administration"
                                            },
                                            {
                                                "example_id": "d6618e60-a59f-4213-88a0-3c0d30626615",
                                                "sense_id": "67f01ee3-b205-3c3b-95b5-04a7e47fa2f7",
                                                "text": "The Duterte administration"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "839d3add-8e9c-371c-92cb-5231d2f09cbd",
                                        "entry_id": "b341397f-7cef-3673-916d-7d9323f718a2",
                                        "glosses": [
                                            "A body that administers; a body of administrators."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8aca86be-04a7-4c9c-8a36-c71ce9a8e7de",
                                                "sense_id": "839d3add-8e9c-371c-92cb-5231d2f09cbd",
                                                "text": "The Chiang Mai Administrative Court ruled in favour of students from the Media Arts and Design Department, Faculty of Fine Arts, Chiang Mai University, who filed for a temporary injunction on 18 October after the University administration prohibited them from showing their final theses in the University Art Centre because some pieces dealt with social and political themes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8dcbe050-f2b6-3871-94aa-128294c38ee4",
                                        "entry_id": "b341397f-7cef-3673-916d-7d9323f718a2",
                                        "glosses": [
                                            "The act of administering, or tendering something to another; dispensation."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bd31cd4-be54-4f1f-a83b-6fa4ac9a187b",
                                                "sense_id": "8dcbe050-f2b6-3871-94aa-128294c38ee4",
                                                "text": "the administration of a medicine, of an oath, of justice, or of the sacrament"
                                            },
                                            {
                                                "example_id": "ab80f6e7-c003-4eea-baba-43cbb258e384",
                                                "sense_id": "8dcbe050-f2b6-3871-94aa-128294c38ee4",
                                                "text": "oral administration of insulin"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a10a272-6255-36ea-9ee5-a2946d16055e",
                                        "entry_id": "b341397f-7cef-3673-916d-7d9323f718a2",
                                        "glosses": [
                                            "Management."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5392c2a9-f1d7-39e4-aee1-4101d6ee3a2f",
                                        "entry_id": "b341397f-7cef-3673-916d-7d9323f718a2",
                                        "glosses": [
                                            "An arrangement whereby an insolvent company can continue trading under supervision."
                                        ],
                                        "tags": [
                                            "UK",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4181035b-8be0-4597-ae3b-6a0cc500f54f",
                                                "sense_id": "5392c2a9-f1d7-39e4-aee1-4101d6ee3a2f",
                                                "text": "The company went into voluntary administration last week."
                                            },
                                            {
                                                "example_id": "d8ff2807-2f0d-406e-ac9e-39618668913a",
                                                "sense_id": "5392c2a9-f1d7-39e4-aee1-4101d6ee3a2f",
                                                "text": "The other ambitions, and much of Prescott's plan, foundered just south of Hatfield that October, when a GNER express derailed on a shattered rail […], plunging the railway into a crisis that led to private track owner Railtrack being put into administration."
                                            }
                                        ]
                                    }
                                ]
