                        "form": "paraleipses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e8c74e1e-3081-3712-b817-3636d0a6ef6d",
                        "entry_id": "5aa8891f-ed9c-3035-8478-89080c29f0dd",
                        "glosses": [
                            "A figure of speech in which one pretends to ignore or omit something by actually mentioning it."
                        ],
                        "tags": [
                            "countable",
                            "rhetoric",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7c7b8518-05f2-4c40-8cdf-aaafaccfaace",
                                "sense_id": "e8c74e1e-3081-3712-b817-3636d0a6ef6d",
                                "text": "These negatives are a paraleipsis: what cannot be done to the soul can be done to the body."
                            },
                            {
                                "example_id": "0fbc75ba-5446-4f58-96bb-796c0af640f8",
                                "sense_id": "e8c74e1e-3081-3712-b817-3636d0a6ef6d",
                                "text": "Oxenberg tells us twice that she does not talk about the sister who died. She fools no one with this paralipsis […]."
                            },
                            {
                                "example_id": "038c81e1-7538-4388-9b6c-1141f800fe43",
                                "sense_id": "e8c74e1e-3081-3712-b817-3636d0a6ef6d",
                                "text": "What's left to consider? I am loath to bring up Trump's paralipsis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd655808-0a86-47a6-a31b-17b4e7361b5b",
                        "source_entry_id": "5aa8891f-ed9c-3035-8478-89080c29f0dd",
                        "source_sense_id": "e8c74e1e-3081-3712-b817-3636d0a6ef6d",
