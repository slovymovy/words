                                    {
                                        "sense_id": "f60b5537-c9d6-3fb7-8bcb-9cb293d7e8ac",
                                        "entry_id": "4816fabb-6018-328a-aff4-0792a78a960c",
                                        "glosses": [
                                            "A beverage made by infusing mainly the leaves (and sometimes the flowers, roots, or stems) of various herbs or other plants, generally not including true tea (Camellia sinensis)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
