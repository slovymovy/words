                    {
                        "sense_id": "7e6d5709-0965-3a58-8728-11ca2e06baaf",
                        "entry_id": "33733e07-efc9-3b63-8108-a8763efee191",
                        "glosses": [
                            "een tuin waar groenten worden gekweekt voor eigen gebruik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e33374dc-1aae-42b8-b38e-160d2f86ba43",
                                "sense_id": "7e6d5709-0965-3a58-8728-11ca2e06baaf",
                                "text": "De man verklaarde eksters te willen vangen in verband met schade aan zijn groentetuin en het roven van eieren van zijn kippen."
                            },
                            {
                                "example_id": "db85c39d-21ad-43c2-9fbd-3e1a3ef6d521",
                                "sense_id": "7e6d5709-0965-3a58-8728-11ca2e06baaf",
                                "text": "De biologische groentetuin van De Werkwijzer in Oldenzaal levert dat wat de Voedselbank graag wil hebben. De tuin maakt een topjaar door."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0d6d67e9-d41d-470c-946e-6039153660ed",
                        "source_entry_id": "33733e07-efc9-3b63-8108-a8763efee191",
