                        "source_sense_id": "0dbfd91f-2a4e-369b-a688-5da89de1b8ae",
                        "target_lang_word": "vervierfachen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vervierfachen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9e445dbb-1dbb-3676-b46b-e3b5262a1c24",
                                        "entry_id": "458aa6c6-b512-3894-8b28-fb75615b8308",
                                        "glosses": [
                                            "auf die vierfache Anzahl bringen, in seiner Summe viermal so groß machen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29663839-1537-4921-9a3c-94ea367d35b4",
                                                "sense_id": "9e445dbb-1dbb-3676-b46b-e3b5262a1c24",
                                                "text": "„Wenn es nun taͤglich bewaͤhret wird, daß ein Staͤdter ſein Grundcapital vermittelſt ſeinem Gewerbe in einer weit kuͤrzern Zeit verdoppeln, ja vervierfachen kann, als der Landwirth, obgleich dieſer die unentbehrlichſten Produkte liefert, und, da er ſolche meiſt fuͤr bar verkauft, die wenigſte Gefahr laͤuft, ſo muß dieſes ſeinen wichtigen feſtbeſtimmten Grund haben.“ [1800]"
                                            },
                                            {
                                                "example_id": "e509d5de-dc9e-40d3-b291-cefae436a172",
                                                "sense_id": "9e445dbb-1dbb-3676-b46b-e3b5262a1c24",
                                                "text": "„Bei einem Pfeiler mit einem quadratischen Querschnitt vervierfacht sich beim Vervierfachen des Querschnitts auch das Gewicht, das er tragen kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "db9d5da8-0a24-3a37-970e-e0b8b5503e5e",
                                        "entry_id": "458aa6c6-b512-3894-8b28-fb75615b8308",
                                        "glosses": [
                                            "sich auf die vierfache Anzahl erhöhen beziehungsweise vierfache Menge vergrößern"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2c50647-9afe-454c-878d-95bf75f2e543",
                                                "sense_id": "db9d5da8-0a24-3a37-970e-e0b8b5503e5e",
                                                "text": "„Bei einem Pfeiler mit einem quadratischen Querschnitt vervierfacht sich beim Vervierfachen des Querschnitts auch das Gewicht, das er tragen kann.“"
                                            },
                                            {
                                                "example_id": "423d28b2-bb7f-407b-bc12-e6bf070b6c7b",
                                                "sense_id": "db9d5da8-0a24-3a37-970e-e0b8b5503e5e",
                                                "text": "„Laut EU-Kommission hat sich das Handelsvolumen mit der Türkei seit Gründung der Zollunion vervierfacht.“"
                                            },
                                            {
                                                "example_id": "40d2b369-cf14-4b73-ba20-4005e7630e86",
                                                "sense_id": "db9d5da8-0a24-3a37-970e-e0b8b5503e5e",
                                                "text": "„Der Bundesverband der deutschen Industrie schätzt, dass sich die deutschen Exporte in den Iran binnen weniger Jahre vervierfachen könnten: von derzeit 2,4 auf 10 Milliarden Euro pro Jahr.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
