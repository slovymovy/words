                "senses": [
                    {
                        "sense_id": "57e5a317-0bda-3039-b51e-c76ff7fcadc8",
                        "entry_id": "d95b87ce-7cd8-3c8a-a23f-f59f2c00bd52",
                        "glosses": [
                            "plötzlich einsetzende, kalte Wetterperiode"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d50f32d1-9874-4506-add0-4bdba62081b5",
                                "sense_id": "57e5a317-0bda-3039-b51e-c76ff7fcadc8",
                                "text": "„Zum ersten Mal überhaupt wurde ein neuer Rollrasen verlegt. 150 000 Euro kostete das edle Geläuf, und weil eine Rasenheizung das Budget gesprengt hätte, haben die Kieler sich ein Zelt geliehen, das das Grün vor dem Kälteeinbruch schützt.“"
                            },
                            {
                                "example_id": "a1be108d-75bd-4e73-b2ca-19561f6132f6",
                                "sense_id": "57e5a317-0bda-3039-b51e-c76ff7fcadc8",
                                "text": "„Vor dem Kälteeinbruch hatten Pencroff und Harbert Zweige von der Purpurweide, die sie am Nordende des Sees gefunden hatten, ins Granithaus gebracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "405eae03-dc2d-4355-912b-58fc3b1ed2e7",
                        "source_entry_id": "d95b87ce-7cd8-3c8a-a23f-f59f2c00bd52",
                        "source_sense_id": "57e5a317-0bda-3039-b51e-c76ff7fcadc8",
                        "source_sense_description": "plötzlich einsetzende, kalte Wetterperiode",
                        "target_lang_word": "cold snap",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cold snap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5149b371-2e0f-31f6-a832-7408b6950749",
                                        "entry_id": "d1b7ab2b-ee10-3e62-a85e-0a2c942b2d03",
                                        "glosses": [
                                            "A short and sudden period of cold weather."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db814771-bf19-48e1-b36a-dcf6875143b8",
                                                "sense_id": "5149b371-2e0f-31f6-a832-7408b6950749",
                                                "text": "A recent cold snap damaged citrus crops."
                                            },
                                            {
                                                "example_id": "0486e1a9-7185-45af-8e3e-75b5b9d91c67",
                                                "sense_id": "5149b371-2e0f-31f6-a832-7408b6950749",
                                                "text": "On the day that RAIL meets Mick Whelan, it's during a particularly chilly cold snap. A story has broken in the national press about train drivers refusing to walk to their cabs at Edge Hill depot, because the paths to the trains have not been cleared of snow."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41dd5fa7-a472-4c75-8f6c-115a23f49ba3",
                        "source_entry_id": "d95b87ce-7cd8-3c8a-a23f-f59f2c00bd52",
                        "source_sense_id": "57e5a317-0bda-3039-b51e-c76ff7fcadc8",
                        "source_sense_description": "plötzlich einsetzende, kalte Wetterperiode",
                        "target_lang_word": "vague de froid",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vague de froid",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "00e06260-6d7c-3ab7-9986-a7ab7226d153",
                                        "entry_id": "c1b95d55-3ad5-3c2b-b311-52244c33c57c",
                                        "glosses": [
                                            "Épisode météorologique durant lequel la température est inhabituellement basse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4dffd69-9c29-4a32-8a79-695b371753f2",
                                                "sense_id": "00e06260-6d7c-3ab7-9986-a7ab7226d153",
                                                "text": "La vague de froid que nous avons connue en 2014 n’a pas seulement touché le Québec."
                                            },
                                            {
                                                "example_id": "c0d70fec-e473-4b20-ba68-a1571c9b9fe1",
                                                "sense_id": "00e06260-6d7c-3ab7-9986-a7ab7226d153",
                                                "text": "Des chercheurs québécois ont développé un système d’alerte pour les vagues de froid en relation avec la santé, afin d'éviter la mort prématurée de plus d’une centaine de Canadiennes et de Canadiens, ce qui serait une première dans le monde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c50ee7f9-f9ab-4cbb-90cd-5587eee1b6eb",
                        "source_entry_id": "d95b87ce-7cd8-3c8a-a23f-f59f2c00bd52",
                        "source_sense_id": "57e5a317-0bda-3039-b51e-c76ff7fcadc8",
                        "source_sense_description": "plötzlich einsetzende, kalte Wetterperiode",
                        "target_lang_word": "coup de froid",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coup de froid",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6c842019-7253-3579-b07b-65b309699921",
                                        "entry_id": "f137eceb-4341-3c5a-89d8-18032d22c712",
                                        "glosses": [
                                            "Refroidissement soudain des températures."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f6500f13-c6f1-348b-886b-836218991d77",
                                        "entry_id": "f137eceb-4341-3c5a-89d8-18032d22c712",
                                        "glosses": [
                                            "Rhume (maladie attrapée lors d’un coup de froid)."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "352bf63b-2ad7-49ad-9f6f-5ffb5ff1f876",
                                                "sense_id": "f6500f13-c6f1-348b-886b-836218991d77",
                                                "text": "Des larmes étaient montées aux yeux de la mère. Elle tremblait toujours, elle savait bien le mensonge de la façade : un coup de froid aurait emporté son fils, tout grand et solide qu’il paraissait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8c8d2eb-9e90-3de0-b214-3f3adc367253",
                                        "entry_id": "f137eceb-4341-3c5a-89d8-18032d22c712",
                                        "glosses": [
                                            "Dégradation dans les relations."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85692e0c-2342-41be-ad49-58d2b8b19506",
                                                "sense_id": "b8c8d2eb-9e90-3de0-b214-3f3adc367253",
                                                "text": "Ce coup de froid a essentiellement saisi les pays présentant des fragilités spécifiques (lourds déficits, instabilité politique, etc.). Mais si le FMI ne discerne pas, pour l’instant, de contagion, il appelle à la vigilance."
                                            },
                                            {
                                                "example_id": "5e1bb4c5-dab4-45e8-8783-613f45a1086c",
                                                "sense_id": "b8c8d2eb-9e90-3de0-b214-3f3adc367253",
                                                "text": "Coup de froid sur la Chiraquie. Les derniers chiraquiens ne sont plus nombreux, et voilà qu’ils se font la guerre entre eux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
