                "senses": [
                    {
                        "sense_id": "5a28d736-c2aa-3acf-ba9b-0a2a303ea5ce",
                        "entry_id": "4621235b-73f9-3f77-9c4c-b1e0b64a0686",
                        "glosses": [
                            "das Ablegen der Kleidung; das Aufdecken, Offenbaren von etwas"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "7eb9a196-c6ca-4fd7-a94f-1713e0b17237",
                                "sense_id": "5a28d736-c2aa-3acf-ba9b-0a2a303ea5ce",
                                "text": "„Die Entkleidung Christi ist damit gerade durch ihr Verständnis als besondere Schmach Sinnbild für das Abstreifen der Sünden, das der Gläubige durch aufrichtige Buße erreichen konnte.“"
                            },
                            {
                                "example_id": "bf8c74d8-a3ed-4d14-a9d9-8756d2aa2c0a",
                                "sense_id": "5a28d736-c2aa-3acf-ba9b-0a2a303ea5ce",
                                "text": "„Nach der Entkleidung des Patienten kann die Inspektion des Schuhwerks und dessen Sohlenabnutzung Hinweise auf eine unphysiologische Belastung der unteren Extremitäten bieten.“"
                            },
                            {
                                "example_id": "81aa3d3a-a978-48ad-b078-eaaf52b6953d",
                                "sense_id": "5a28d736-c2aa-3acf-ba9b-0a2a303ea5ce",
                                "text": "„Die Räume im Erdgeschoss des Schlosses wurden für die Entkleidung der zur Tötung bestimmten Opfer hergerichtet.“"
                            },
                            {
                                "example_id": "d5593052-e20c-47a6-9955-e18beec0775a",
                                "sense_id": "5a28d736-c2aa-3acf-ba9b-0a2a303ea5ce",
                                "text": "„Eine völlige Entkleidung der Sachprobleme von den jeweiligen Rechtssystemen kann nur der erste Schritt einer Rechtsvergleichung sein.“"
                            },
                            {
                                "example_id": "9c64189e-92e4-490d-8317-33f312a399fd",
                                "sense_id": "5a28d736-c2aa-3acf-ba9b-0a2a303ea5ce",
                                "text": "„Der Aussagekern solle erst nach Entkleidung des satirischen Gewandes festgestellt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
