                "senses": [
                    {
                        "sense_id": "09d00a59-fcc4-3cd5-b763-c8959e259db6",
                        "entry_id": "662c78ad-8e70-3bcd-9bb1-b4c2834af46f",
                        "glosses": [
                            "Homme (ou femme) d’affaires qui cherche à racheter un maximum de titres de la presse écrite."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "30b2cdaa-bef0-4ab8-80fc-0f0a3424f260",
                                "sense_id": "09d00a59-fcc4-3cd5-b763-c8959e259db6",
                                "text": "Aucun doute, dans la concurrence effrénée qui bouleverse nos paysages médiatiques, et face à ses confrères papivores, l’audiovisuel est incontestablement le plus fort."
                            },
                            {
                                "example_id": "2f62de69-ee16-4c19-917f-565a0d07ce12",
                                "sense_id": "09d00a59-fcc4-3cd5-b763-c8959e259db6",
                                "text": "Au Royaume-Uni, le papivore possède le Times, le Sun et contrôle donc 39 % de Sky et Sky News, sa chaîne d’information en continu."
                            }
                        ]
                    }
