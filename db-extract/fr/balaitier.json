                        "glosses": [
                            "Fabricant de balais en genet, bruyère ou autres matériaux végétaux."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "932af602-66ce-45a8-88ba-f9169c08568c",
                                "sense_id": "b8baf209-346d-3962-8423-cb77558efcc2",
                                "text": "Le balaitier liait le tout une première fois à une quinzaine de centimètres du bout et arasait soigneusement les extrémités de la scie."
                            },
                            {
                                "example_id": "cd22bfb5-2d8a-4e85-b5dd-cae84811e3d4",
                                "sense_id": "b8baf209-346d-3962-8423-cb77558efcc2",
                                "text": "Appelés « balaitiers », « balaisiers »ou « balaiseurs » en fonction des régions, ils récupèrent ces brindilles, généralement de bouleau ou de genêt, pour confectionner des balais qu’ils se chargent eux mêmes de revendre dans les villages alentours pour quelques pièces ou un peu de nourriture."
                            }
                        ]
                    }
