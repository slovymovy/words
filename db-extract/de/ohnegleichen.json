                    {
                        "sense_id": "00ba4e1e-89e8-37fa-b320-24d1ba971d92",
                        "entry_id": "cdfb6bd0-ba42-33eb-ab2a-4212551b8a6b",
                        "glosses": [
                            "so geartet, dass es sich mit nichts vergleichen lässt"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "b143c3d3-4b74-4392-bfc6-acf0262cb78c",
                                "sense_id": "00ba4e1e-89e8-37fa-b320-24d1ba971d92",
                                "text": "„O gäbs doch Sterne, die nicht bleichen,",
                                "translation": "hat meine Seele oft geträumt.“"
                            },
                            {
                                "example_id": "119c8d1f-4fe4-4708-812d-3d63a2b21311",
                                "sense_id": "00ba4e1e-89e8-37fa-b320-24d1ba971d92",
                                "text": "Dieses Automobil aus den 20er Jahren ist weltweit ohnegleichen."
                            },
                            {
                                "example_id": "1e5b2032-bd0f-47d4-8cfb-e9579605fccb",
                                "sense_id": "00ba4e1e-89e8-37fa-b320-24d1ba971d92",
                                "text": "Claudius ist ein Angeber ohnegleichen."
                            },
                            {
                                "example_id": "23e2c402-30bf-4307-8549-9a8f500e8c98",
                                "sense_id": "00ba4e1e-89e8-37fa-b320-24d1ba971d92",
                                "text": "Noch einmal mache ich so etwas nicht mit. Es war eine Blamage ohnegleichen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae039f84-f6d5-4e47-93d1-eb2793fa7657",
                        "source_entry_id": "cdfb6bd0-ba42-33eb-ab2a-4212551b8a6b",
                        "source_sense_id": "00ba4e1e-89e8-37fa-b320-24d1ba971d92",
                        "source_sense_description": "bei Substantiven nachgestellt, gehoben: so geartet, dass es sich mit nichts vergleichen lässt",
                        "target_lang_word": "sans pareil",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sans pareil",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bab8ce0e-a03c-3841-bc63-dc87eb75df5c",
                                        "entry_id": "384cf3e3-a6ba-36fa-bd92-e8e4a4304031",
                                        "glosses": [
                                            "Excellent, supérieur dans son genre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c35f66b0-e327-4292-9aff-9735d2671348",
                                                "sense_id": "bab8ce0e-a03c-3841-bc63-dc87eb75df5c",
                                                "text": "[…] François se dévoyait auprès des filles publiques, […]. On dit que ces professionnelles ont des charmes secrets, des recettes magiques pour exaspérer la volupté de leurs clients et leur procurer des extases sans pareilles […]."
                                            },
                                            {
                                                "example_id": "dc34c4b2-7292-461d-a595-226692af21ca",
                                                "sense_id": "bab8ce0e-a03c-3841-bc63-dc87eb75df5c",
                                                "text": "La seule fois que j’en aie goûté, j’en ai pris trois jours de migraine, des vomissements de bile verte, un dévoiement sans pareil."
                                            },
                                            {
                                                "example_id": "b3ae48aa-80b2-45c8-88a9-5e05eb3d2486",
                                                "sense_id": "bab8ce0e-a03c-3841-bc63-dc87eb75df5c",
                                                "text": "C’est un homme d’un sang-froid sans pareil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50c21683-9835-4bcd-aa94-8ef61d45ac54",
                        "source_entry_id": "cdfb6bd0-ba42-33eb-ab2a-4212551b8a6b",
                        "source_sense_id": "00ba4e1e-89e8-37fa-b320-24d1ba971d92",
                        "source_sense_description": "bei Substantiven nachgestellt, gehoben: so geartet, dass es sich mit nichts vergleichen lässt",
                        "target_lang_word": "unique en son genre",
                        "target_lang_code": "fr",
