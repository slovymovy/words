                                    {
                                        "sense_id": "33eb09a8-cb23-3748-b610-ec6554e8dda6",
                                        "entry_id": "d489d38e-234b-3e7a-bcb4-8493f70439b3",
                                        "glosses": [
                                            "A male given name from the Slavic languages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db96f387-714d-4f9e-9453-c17a65c183ca",
                                                "sense_id": "33eb09a8-cb23-3748-b610-ec6554e8dda6",
                                                "text": "Good King Wenceslas look'd out, On the Feast of Stephen; / When the snow lay round about, Deep, and crisp, and e-ven: / Brightly shone the moon that night, Though the frost was cru-el, / When a poor man came in sight, Gath'ring win-ter fu-el."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be723119-d531-4dc1-aac1-9566030ef298",
                        "source_entry_id": "5e6b6b66-c574-3580-8b64-052cd91119d0",
                        "source_sense_id": "2caff82b-f585-3944-88a9-2f4f7e03a125",
                        "target_lang_word": "Václav",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Václav",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "2f52932f-fec7-325c-ab1b-91a66581ddc9",
                                        "entry_id": "232c918d-d8c2-3836-9059-7f274916a790",
                                        "glosses": [
                                            "české mužské křestní jméno"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35ada172-344e-42dc-927f-08819a0e03c1",
                                                "sense_id": "2f52932f-fec7-325c-ab1b-91a66581ddc9",
                                                "text": "Svatý Václave, vévodo české země, kníže náš, pros za nás Boha, svatého Ducha! Kriste, eleison. Ty jsi dědic české země, rozpomeň se na své plémě, nedej zahynouti nám ni budoucím, svatý Václave! Kriste, eleison"
                                            },
                                            {
                                                "example_id": "225f3dcf-14c7-4018-a106-308fcf0bb552",
                                                "sense_id": "2f52932f-fec7-325c-ab1b-91a66581ddc9",
                                                "text": "Nositelů jména Václav v současnosti spíše ubývá. Historickou shodou okolností (ale jistě i statisticko-demografickými faktory) se přihodilo, že první dva prezidenti novodobé České republiky, tak rozdílní v povaze a činech, oba shodně nesli jméno Václav."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
