                    },
                    {
                        "form_id": "2dc335cf-7d4b-4e10-96fc-d9eebc94d019",
                        "entry_id": "00725dc5-7512-358b-8542-9848fdcf60cb",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Schwimmwesten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3934e833-dc79-3deb-b164-9ddc3ddc4bd2",
                        "entry_id": "00725dc5-7512-358b-8542-9848fdcf60cb",
                        "glosses": [
                            "westenartiges Rettungsmittel, das man überziehen kann und den Träger/die Trägerin über Wasser hält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76cc375c-97cc-4822-9021-daae8efac627",
                                "sense_id": "3934e833-dc79-3deb-b164-9ddc3ddc4bd2",
                                "text": "Schwimmwesten für alle Crewmitglieder sind ein grundlegender Bestandteil der Ausrüstung eines Segelbootes."
                            },
                            {
                                "example_id": "c9252779-6d54-4210-bc25-9f5ca1fec5db",
                                "sense_id": "3934e833-dc79-3deb-b164-9ddc3ddc4bd2",
                                "text": "Um das Optisegeln zu lernen, reichen im Sommer „ein Neopren-Shorty oder Schwimmshorts und UV-Hemden. Dazu kommen eine Schwimmweste, Handschuhe, ordentliche Schuhe fürs Boot, eine Regattauhr und eine Kopfbedeckung […].“"
                            },
                            {
                                "example_id": "4dd0902c-b4bb-4783-91d6-627afec0e533",
                                "sense_id": "3934e833-dc79-3deb-b164-9ddc3ddc4bd2",
                                "text": "„Mit einem luftgefüllten Tauchretter als Schwimmweste kämpfte der Smut 13 Stunden um sein Leben, bis der britische Fischtrawler St. Martin ihn entdeckte und an Bord nahm.“"
                            },
                            {
                                "example_id": "2b48b8c3-8a5a-44f9-8d3d-e69f9fd352d3",
                                "sense_id": "3934e833-dc79-3deb-b164-9ddc3ddc4bd2",
                                "text": "„\"Sea Watch\" durfte die Flüchtlinge zwar nicht an Bord nehmen. Aber sie konnten die Menschen mit Trinkwasser und Medizin versorgen und ihnen Schwimmwesten geben.“"
                            },
                            {
                                "example_id": "53b26561-8883-4ab9-9915-402feb1d4cd7",
                                "sense_id": "3934e833-dc79-3deb-b164-9ddc3ddc4bd2",
                                "text": "„Die Crew versorgte fast 800 Menschen in elf überfüllten Booten mit Schwimmwesten und Rettungsinseln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6caef451-8119-4769-ab35-58504324aa99",
                        "source_entry_id": "00725dc5-7512-358b-8542-9848fdcf60cb",
                        "source_sense_id": "3934e833-dc79-3deb-b164-9ddc3ddc4bd2",
                        "source_sense_description": "westenartiges Rettungsmittel, das man überziehen kann und den Träger/die Trägerin über Wasser hält",
                        "target_lang_word": "life jacket",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "life jacket",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29bf838f-4744-3e4e-bb2c-77bf63f27303",
                                        "entry_id": "69dc245f-4ad3-30a8-a2b7-88ae0da5a1aa",
                                        "glosses": [
                                            "an article of protective clothing that is designed to keep the wearer's head floating above the surface of the water."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d99b0f1b-048e-427f-babf-0e23a9ffd3f8",
                        "source_entry_id": "00725dc5-7512-358b-8542-9848fdcf60cb",
                        "source_sense_id": "3934e833-dc79-3deb-b164-9ddc3ddc4bd2",
                        "source_sense_description": "westenartiges Rettungsmittel, das man überziehen kann und den Träger/die Trägerin über Wasser hält",
                        "target_lang_word": "gilet de sauvetage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gilet de sauvetage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0dd1122c-dd6d-36a1-abb7-64e9d74ed6b3",
                                        "entry_id": "7520fcf0-90e5-3179-87af-35055b528c1a",
                                        "glosses": [
                                            "Dispositif qui permet à une personne, en cas de chute dans l’eau, de flotter plus facilement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e1310fc-712a-45e7-99a2-a4768f8613a2",
                                                "sense_id": "0dd1122c-dd6d-36a1-abb7-64e9d74ed6b3",
                                                "text": "Il ne faut pas confondre gilet de sauvetage et gilet d’aide à la flottabilité. Ces derniers aident seulement à la flottabilité et nécessitent de savoir nager, tandis que les gilets de sauvetage permettent le retournement de la personne sur le dos, pour qu’elle puisse respirer si elle se retrouve inconsciente."
                                            },
                                            {
                                                "example_id": "5cd4f1ec-93e8-46a4-8e6e-9fb1604c9fbf",
                                                "sense_id": "0dd1122c-dd6d-36a1-abb7-64e9d74ed6b3",
                                                "text": "Le gilet de sauvetage n'est pas inclus dans le prix du passage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bcf6f06c-9396-49a4-8eb4-a4ac89d47c1e",
                        "source_entry_id": "00725dc5-7512-358b-8542-9848fdcf60cb",
                        "source_sense_id": "3934e833-dc79-3deb-b164-9ddc3ddc4bd2",
                        "source_sense_description": "westenartiges Rettungsmittel, das man überziehen kann und den Träger/die Trägerin über Wasser hält",
                        "target_lang_word": "giubbotto salvagente",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e7b952bc-1495-4a76-9af9-b946e041b67b",
                        "source_entry_id": "00725dc5-7512-358b-8542-9848fdcf60cb",
                        "source_sense_id": "3934e833-dc79-3deb-b164-9ddc3ddc4bd2",
                        "source_sense_description": "westenartiges Rettungsmittel, das man überziehen kann und den Träger/die Trägerin über Wasser hält",
                        "target_lang_word": "zwemvest",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zwemvest",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a41fe29e-9caa-3e40-b76e-14f957a81460",
                                        "entry_id": "8d9d8ce7-41a0-368e-8992-301c811599b2",
                                        "glosses": [
                                            "een in het water om het lijf gedragen vest met hoog drijfvermogen om verdrinken te voorkomen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e605d07d-3064-46d5-8ab7-4c6386ba4b5d",
                                                "sense_id": "a41fe29e-9caa-3e40-b76e-14f957a81460",
                                                "text": "Het is aan boord van een zeilboot verplicht een zwemvest te dragen."
                                            },
                                            {
                                                "example_id": "370b9dc7-54b0-4e11-a81e-f45c51392dcb",
                                                "sense_id": "a41fe29e-9caa-3e40-b76e-14f957a81460",
                                                "text": "Men had ons toen verteld dat we warme kleding moesten aantrekken, en ook onze zwemvesten die in een kastje in de hut lagen, en ons naar het verzamelpunt begeven dat ons was aangewezen."
                                            },
                                            {
                                                "example_id": "6b8d404d-033e-4e26-b0e6-eb0a4dd5ce74",
                                                "sense_id": "a41fe29e-9caa-3e40-b76e-14f957a81460",
                                                "text": "We hadden allemaal een fluitje aan ons zwemvest en als hij een zeil of iets ongewoons aan de horizon zou ontdekken, kon hij ons onmiddellijk waarschuwen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9530d336-7e27-41de-8abd-7177c2399030",
