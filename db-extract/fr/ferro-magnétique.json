                        "examples": [
                            {
                                "example_id": "ffb078c9-e2ba-4fe9-840b-ab7bc9b92e74",
                                "sense_id": "5a58d17e-373e-34f0-886c-96bf64eaae92",
                                "text": "La magnétite (fer-aimant Fe₃O₄) est le corps ferro-magnétique qui se prête le mieux à une étude complète des propriétés magnétiques au dessus de la température de transformation."
                            },
                            {
                                "example_id": "38f110e0-4080-41fb-8c2a-2d57ae786fac",
                                "sense_id": "5a58d17e-373e-34f0-886c-96bf64eaae92",
                                "text": "Si l’on approche de ce pont une petite pièce de métal ferro-magnétique, il apparaît aux bornes de l’enroulement différentiel une faible tension, laquelle, après amplification, fait basculer un amplificateur bi-stable à réponse rapide."
                            }
                        ]
