{
    "word_family": [
        "contempt",
        "contemptible",
        "contemptuously"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a7b06e1e-4e94-3e60-963a-efe04bd3481b",
                    "sense_definition": "Showing or expressing a lack of respect or disdain for someone or something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "disrespectful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave me a <w>contemptuous</w> look when I suggested a different plan.",
                            "target_lang_translations": {
                                "it": "Mi ha rivolto uno sguardo <w>sprezzante</w> quando ho suggerito un piano diverso."
                            }
                        },
                        {
                            "text": "The critic wrote a <w>contemptuous</w> review of the new movie.",
                            "target_lang_translations": {
                                "it": "Il critico ha scritto una recensione <w>sprezzante</w> del nuovo film."
                            }
                        }
                    ],
                    "synonyms": [
                        "disdainful",
                        "dismissive",
                        "slighting"
                    ],
                    "antonyms": [
                        "respectful"
                    ],
                    "common_phrases": [
                        "contemptuous look",
                        "contemptuous laughter"
                    ],
                    "target_lang_definitions": {
                        "it": "Che mostra o esprime mancanza di rispetto o disprezzo verso qualcuno o qualcosa."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "sprezzante",
                                "target_lang_sense_clarification": "che ostenta disprezzo o alterigia verso gli altri"
                            },
                            {
                                "target_lang_word": "sdegnoso",
                                "target_lang_sense_clarification": "che manifesta sdegno o profonda avversione"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "029f7d00-a73a-3707-9e72-d58398a4c2e4",
                    "sense_definition": "Deserving of contempt; contemptible.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "disrespectful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician's <w>contemptuous</w> behavior toward the public was widely condemned.",
                            "target_lang_translations": {
                                "it": "Il comportamento <w>spregevole</w> del politico verso il pubblico è stato ampiamente condannato."
                            }
                        },
                        {
                            "text": "They were involved in a truly <w>contemptuous</w> act of betrayal.",
                            "target_lang_translations": {
                                "it": "Sono stati coinvolti in un atto di tradimento davvero <w>spregevole</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Che merita disprezzo; spregevole."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "spregevole",
                                "target_lang_sense_clarification": "che suscita disprezzo per la sua bassezza morale"
                            },
                            {
                                "target_lang_word": "ignobile",
                                "target_lang_sense_clarification": "che è indegno di rispetto, vile"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}