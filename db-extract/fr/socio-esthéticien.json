                "senses": [
                    {
                        "sense_id": "46ab5592-d314-39c8-be7b-aaf70da8cdaf",
                        "entry_id": "0abab10f-fc1c-3809-bae1-e292560848fb",
                        "glosses": [
                            "Professionnel des soins esthétiques auprès de personnes atteintes dans leur intégrité physique à cause de maladies, handicaps, vieillesse, toxicomanie ou autres causes de détresse sociale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b6543f2-85d8-4614-afe1-6b032754bcbf",
                                "sense_id": "46ab5592-d314-39c8-be7b-aaf70da8cdaf",
                                "text": "Dès 1979, le CODES met en place la première formation en France de « socio-esthéticien(ne) », titre reconnu par L’État depuis 2007 et inscrit au répertoire national des certifications professionnelles."
                            },
                            {
                                "example_id": "03361bb9-f609-4b3d-90d1-b6ba21cc0d18",
                                "sense_id": "46ab5592-d314-39c8-be7b-aaf70da8cdaf",
                                "text": "On a un socio-esthéticien qui nous apprend à prendre soin de nous, avec des coiffures, des soins du visage, du maquillage. Quelle couleur de vêtement va le mieux à notre visage, etc."
                            },
                            {
                                "example_id": "1f5ae5cc-a96b-4cb7-88b6-22b597befeb7",
                                "sense_id": "46ab5592-d314-39c8-be7b-aaf70da8cdaf",
                                "text": "Le métier de socio-esthéticien ou esthéticien social consiste à aider des patients à accepter la modification de leur image corporelle en cas de maladie ou de vieillesse, mais pas seulement."
                            }
                        ]
                    },
                    {
                        "sense_id": "96d5c726-2314-3bbc-8448-0887dd45dd91",
                        "entry_id": "0abab10f-fc1c-3809-bae1-e292560848fb",
                        "glosses": [
                            "Professionnel de l’Art s’intéressant à la dimension sociologique des œuvres d’art."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df8efe17-13dd-4603-8708-f611436e14ef",
                                "sense_id": "96d5c726-2314-3bbc-8448-0887dd45dd91",
                                "text": "C'est le rôle du socio-esthéticien que cette mise en évidence du caractère artistique de la découverte des terræ incognitæ du Beau (ici pris au sens de l'original) qu’il s'agisse de masques nègres, d’antiquités du XIXᵉ siècle ou d’amphores grecques"
                            },
                            {
                                "example_id": "e5106cf8-46be-4490-89a5-07d3efe54647",
                                "sense_id": "96d5c726-2314-3bbc-8448-0887dd45dd91",
                                "text": "La présence du socio-esthéticien se veut potentiellement l'expression de l'émergence de formes et d'une esthétique de l’interaction entre individus à partir d’une situation donnée"
                            }
                        ]
                    }
