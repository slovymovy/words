            {
                "entry_id": "cf7ba139-8b2d-3b04-9263-b0cf3a1aff95",
                "word": "salutiste",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9857de27-d218-4a04-ab46-c7439e23b447",
                        "entry_id": "cf7ba139-8b2d-3b04-9263-b0cf3a1aff95",
                        "tags": [
