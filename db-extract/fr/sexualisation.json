                "senses": [
                    {
                        "sense_id": "8057c3f9-e372-36ce-8bf3-cb700ff0f9cc",
                        "entry_id": "1094bc63-21ee-320f-a976-18d2e561a500",
                        "glosses": [
                            "Attribution ou développement des caractéristiques sexuelles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf0f3a84-5ef2-431a-a1a8-58cc69b4a3d3",
                                "sense_id": "8057c3f9-e372-36ce-8bf3-cb700ff0f9cc",
                                "text": "Quand on parle de la « sexualisation » du monde végétal, il faut s’entendre sur le sens du terme : il ne s’agit pas des phénomènes réels de la fertilisation des plantes, mais d’une classification morphologique « qualitative », qui est l’aboutissement et l’expression d’une expérience de sympathie mystique avec le monde. C’est l’idée de la Vie qui, projetée sur le Cosmos, le « sexualise »."
                            },
                            {
                                "example_id": "af5aece3-65e4-41de-b5aa-470420c78e1d",
                                "sense_id": "8057c3f9-e372-36ce-8bf3-cb700ff0f9cc",
                                "text": "La défense par sexualisation de la pensée bascule cependant, face à la force de la désintrication pulsionnelle et la fragilité des possibilités de déplacement, dans le registre d’une suractivité auto-calmante."
                            }
                        ]
                    },
                    {
                        "sense_id": "9fb23c6e-af4f-3aff-95f5-73818959a0db",
                        "entry_id": "1094bc63-21ee-320f-a976-18d2e561a500",
                        "glosses": [
                            "Utilisation du sexe à des fins détournées de son objet initial."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dc22b98-bc41-4885-b463-79dee5024dd0",
                                "sense_id": "9fb23c6e-af4f-3aff-95f5-73818959a0db",
                                "text": "La sexualisation dans les médias."
                            }
                        ]
                    }
                ],
