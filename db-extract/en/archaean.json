                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b94250f1-3df2-303d-af55-017d1d630409",
                        "entry_id": "c148c2b4-1aab-3abd-b3d4-eb18a5836c9f",
                        "glosses": [
                            "Of or relating to Arche, the Muse of beginnings in Greek mythology."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "42509203-041f-356b-9d3f-eedd7b303897",
                        "entry_id": "c148c2b4-1aab-3abd-b3d4-eb18a5836c9f",
                        "glosses": [
                            "Of, or relating to the geologic eon from about 4,031 to 2,500 million years ago; comprises the Eoarchean, Paleoarchean, Mesoarchean and Neoarchean eras; marked by an atmosphere with little oxygen, the formation of the first continents and oceans and the emergence of simple life."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "4f196d94-6c42-441d-87ad-4e3ddbcef1df",
                                "sense_id": "42509203-041f-356b-9d3f-eedd7b303897",
                                "text": "The oldest vestiges of continental crust, which date from the Archaean aeon about 4 billion years ago, are in Acasta in north-west Canada."
                            }
                        ]
                    },
                    {
                        "sense_id": "849619f0-fd39-3d4e-a373-1a3b3719fd57",
                        "entry_id": "c148c2b4-1aab-3abd-b3d4-eb18a5836c9f",
                        "glosses": [
                            "Of or relating to the irregular Jovian moon named for Arche."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
