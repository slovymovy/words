                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "bf881c5e-93f6-4ffb-9e84-85ec31543db7",
                        "entry_id": "7e6029e1-8e66-3b3b-894f-684c6a6c18ef",
                        "tags": [
                            "plural"
                        ],
                        "form": "concentraties"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "875a9874-f36a-301d-bef0-a29530933817",
                        "entry_id": "7e6029e1-8e66-3b3b-894f-684c6a6c18ef",
                        "glosses": [
                            "sterkte van een oplossing"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8bed080-48f6-49cc-a52e-fc914de3de42",
                                "sense_id": "875a9874-f36a-301d-bef0-a29530933817",
                                "text": "Wij gebruiken zwavelzuur in een hoge concentratie."
                            },
                            {
                                "example_id": "2ac4e22e-c2c7-4e79-be76-17d0c9a70e9d",
                                "sense_id": "875a9874-f36a-301d-bef0-a29530933817",
                                "text": "De onderzoekers maakten de armen van de ster uit drie soorten polymeren, die ieder verschilden in hoe snel ze het medicijn afgaven. Zo was het mogelijk om van ieder afzonderlijk geneesmiddel de gewenste concentraties in het bloed bij te sturen. Daarnaast kan de dosis per middel gevarieerd worden door één of meer armen van de ster ermee te vullen."
                            }
                        ]
                    },
                    {
                        "sense_id": "664a90b6-73ad-314c-bf57-30d02f96cd11",
                        "entry_id": "7e6029e1-8e66-3b3b-894f-684c6a6c18ef",
                        "glosses": [
                            "het de aandacht kunnen richten op één onderwerp zonder zich af te laten leiden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d6a4b2d-dbbc-4795-8e26-707792b2e49b",
                                "sense_id": "664a90b6-73ad-314c-bf57-30d02f96cd11",
                                "text": "Voor het maken van een examen is een goede concentratie nodig."
                            },
                            {
                                "example_id": "e8891f88-3f50-4582-ad75-ad7732cf4847",
                                "sense_id": "664a90b6-73ad-314c-bf57-30d02f96cd11",
                                "text": "Opperste concentratie in de coulissen van De Bond. Gespannen staan de leerlingen uit groep 8C van de basisschool Drie-eenheid maandagmorgen naar hun klasgenoten te kijken die op dat moment in de schijnwerpers staan. Als er al wat wordt gezegd, gebeurt dat op een fluistertoon die op de bühne niet te horen is."
                            },
                            {
                                "example_id": "67d26c76-f116-4cca-9c50-5f5ebf464a5c",
                                "sense_id": "664a90b6-73ad-314c-bf57-30d02f96cd11",
                                "text": "Omdat ze moeite had om haar glimlach te onderdrukken, veinsde ze opperste concentratie tijdens het beoordelen van de verkeerssituaties."
                            },
                            {
                                "example_id": "4f754d9f-fd4d-4945-9bd3-02e20935aacb",
                                "sense_id": "664a90b6-73ad-314c-bf57-30d02f96cd11",
                                "text": "Aan de motivatie mankeerde dus niets. Het was slechter gesteld met de concentratie."
                            }
                        ]
                    },
                    {
                        "sense_id": "f741c1a3-92a3-3398-8799-49c4bf336b21",
                        "entry_id": "7e6029e1-8e66-3b3b-894f-684c6a6c18ef",
                        "glosses": [
                            "samentrekking op één punt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45c2eb61-068a-473b-bbdc-5c0e909f8b40",
                                "sense_id": "f741c1a3-92a3-3398-8799-49c4bf336b21",
                                "text": "Er is een grote concentratie van scholen in onze wijk."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76dcc9af-52fd-4d36-aa3d-2550d9ffd09d",
                        "source_entry_id": "7e6029e1-8e66-3b3b-894f-684c6a6c18ef",
                        "target_lang_word": "Konzentration",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Konzentration",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9e51a957-7a60-3cab-b4b9-8d1b1b310081",
                                        "entry_id": "14e4f291-da11-3d2a-a680-e3c87ccf3eaa",
                                        "glosses": [
                                            "die gedankliche Sammlung und Anspannung"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e256351-9660-491b-8964-f56fe0cb80fa",
                                                "sense_id": "9e51a957-7a60-3cab-b4b9-8d1b1b310081",
                                                "text": "Für die Prüfungsvorbereitung benötige ich eine höhere Konzentration."
                                            },
                                            {
                                                "example_id": "7f38d60d-df53-41c1-96fc-4f4faa5fd999",
                                                "sense_id": "9e51a957-7a60-3cab-b4b9-8d1b1b310081",
                                                "text": "„Doch seine gewohnte Konzentration ließ ihn im Stich.“"
                                            },
                                            {
                                                "example_id": "4f135b65-0893-4928-8273-31a8f709d958",
                                                "sense_id": "9e51a957-7a60-3cab-b4b9-8d1b1b310081",
                                                "text": "„Obwohl die technisch bedingten Zeitverzögerungen das Gespräch schwierig gestalteten, was Tom unglaublich nervte, wuchs seine Konzentration von Sekunde zu Sekunde immer weiter an.“"
                                            },
                                            {
                                                "example_id": "e9072de9-1154-48d8-887f-843e686432a9",
                                                "sense_id": "9e51a957-7a60-3cab-b4b9-8d1b1b310081",
                                                "text": "„Die Konzentration auf das Navigieren durch eine mir unbekannte Millionenstadt hatte mich ausgelaugt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bc0ff3f1-e0e3-3071-b895-0e61c6d351c1",
                                        "entry_id": "14e4f291-da11-3d2a-a680-e3c87ccf3eaa",
                                        "glosses": [
                                            "die zielgerichtete Lenkung auf eine Sache hin"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9080469-15e4-420a-85a9-71015016ffe2",
                                                "sense_id": "bc0ff3f1-e0e3-3071-b895-0e61c6d351c1",
                                                "text": "„Die Konzentration dieses Epos auf ganz wenige Gestalten hebt es ab von der turbulenten Zeit, in der ich ihm begegnet bin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "886de692-0e4d-3a95-8d0a-ed191987d3b0",
                                        "entry_id": "14e4f291-da11-3d2a-a680-e3c87ccf3eaa",
                                        "glosses": [
                                            "die Zusammenballung von Kräften"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e72dd8b4-f564-44c1-a075-4d58286b4640",
                                                "sense_id": "886de692-0e4d-3a95-8d0a-ed191987d3b0",
                                                "text": "Mit einer Konzentration auf ihre Kernkompetenzen versuchen manche Konzerne, für die Zukunft besser gerüstet zu sein."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "9574dbd4-e662-3fdb-865d-e78cf638f0fa",
                                        "entry_id": "14e4f291-da11-3d2a-a680-e3c87ccf3eaa",
                                        "glosses": [
                                            "der Gehalt einer Lösung an gelösten Stoffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c64e38b5-385b-413c-a43e-05c5aa4e5138",
                                                "sense_id": "9574dbd4-e662-3fdb-865d-e78cf638f0fa",
                                                "text": "Die Konzentration des Salzes in der Lösung steigt, wenn das Wasser verdunstet."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
