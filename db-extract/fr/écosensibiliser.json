                "senses": [
                    {
                        "sense_id": "25a4b780-1381-308e-b03a-65c53ddac043",
                        "entry_id": "395d8260-a249-3a01-9cc0-c7654d3ef3ec",
                        "glosses": [
                            "Rendre sensible aux questions écologiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49c31825-09cb-4787-add3-0b8af24e46b3",
                                "sense_id": "25a4b780-1381-308e-b03a-65c53ddac043",
                                "text": "Bien que l’environnement devrait être au cœur de tes préoccupations, le but de ce carnet n’est pas de faire de toi un David Suzuki, mais plutôt de t'écosensibiliser et de t'écoresponsabiliser!"
                            },
                            {
                                "example_id": "22f20aa8-bb50-43d8-ac43-c806b27cf719",
                                "sense_id": "25a4b780-1381-308e-b03a-65c53ddac043",
                                "text": "Le but de l'action est d'“écosensibiliser” les élèves."
                            },
                            {
                                "example_id": "b2a2a1cf-db3b-458d-89ed-ce2fa06aa0aa",
                                "sense_id": "25a4b780-1381-308e-b03a-65c53ddac043",
                                "text": "Une industrie électronique écosensibilisée."
                            }
                        ]
                    }
