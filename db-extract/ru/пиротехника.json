                                    {
                                        "sense_id": "b22e2ac7-4380-3cca-bed3-eb77ca139782",
                                        "entry_id": "5fe8cd3d-e5a1-3375-9868-f4a66affdf77",
                                        "glosses": [
                                            "An impressive display."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "441fdf9d-f377-44b4-8e40-e107e1914351",
                                                "sense_id": "b22e2ac7-4380-3cca-bed3-eb77ca139782",
                                                "text": "Dazzling verbal pyrotechnics and incredibly vivid characterization."
                                            },
                                            {
                                                "example_id": "85b8af8a-25a3-472a-a3b2-fd8e63457f92",
                                                "sense_id": "b22e2ac7-4380-3cca-bed3-eb77ca139782",
                                                "text": "Mainstream Records, wowed by Nugent's Hendrix-like guitar pyrotechnics, signed the guys and issued their self-titled debut album in 1968."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d8d4b44-f98e-4cf2-a4ab-e3cad26615ae",
                        "source_entry_id": "fdf67944-3f6a-3ba5-8763-610bbb1db70d",
