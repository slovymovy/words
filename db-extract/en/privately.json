                "senses": [
                    {
                        "sense_id": "d1f45f8c-3ddc-373b-a07b-bc5bce69b839",
                        "entry_id": "1d9c2e89-17f2-3b81-a6a4-1ed0c19257d5",
                        "glosses": [
                            "ιδιωτικά, ανεξάρτητα· με τρόπο που δεν είναι υπό τον έλεγχο του κράτους"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1b37144-6d39-4401-a7c9-a2c1fec6672f",
                                "sense_id": "d1f45f8c-3ddc-373b-a07b-bc5bce69b839",
                                "text": "In public he supported the official policy, but privately he was sure it would fail.",
                                "translation": "Δημόσια υποστήριξε την επίσημη πολιτική, αλλά ιδιωτικά ήταν σίγουρος ότι θα αποτύχει."
                            },
                            {
                                "example_id": "8698242d-296d-4a2a-98b1-6a7f194fee2f",
                                "sense_id": "d1f45f8c-3ddc-373b-a07b-bc5bce69b839",
                                "text": "a privately-owned garden/driveway/garage - ιδιωτικός κήπος/δρόμος/γκαράζ"
                            },
                            {
                                "example_id": "655cbb2b-56f5-43e6-a761-92153052860a",
                                "sense_id": "d1f45f8c-3ddc-373b-a07b-bc5bce69b839",
                                "text": "All their children have been educated privately.",
                                "translation": "Όλα τα παιδιά τους έχουν εκπαιδευτεί σε ιδιωτικά σχολεία."
                            }
                        ]
                    },
                    {
                        "sense_id": "8091a7fc-eb26-33d8-943d-a690df756f3f",
                        "entry_id": "1d9c2e89-17f2-3b81-a6a4-1ed0c19257d5",
                        "glosses": [
                            "ιδιωτικά, μεταξύ μας, ιδιαιτέρως, με μυστικό τρόπο που εμπλέκει ένα συγκεκριμένο άτομο ή ομάδα ανθρώπων και όχι ανθρώπους γενικά"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2918bd17-3b63-4c5d-a970-f35f324f525d",
                                "sense_id": "8091a7fc-eb26-33d8-943d-a690df756f3f",
                                "text": "Can we speak privately?",
                                "translation": "Μπορούμε να μιλήσουμε ιδιωτικά/μεταξύ μας;"
                            },
                            {
                                "example_id": "6066e9b8-5c4e-4b74-ba9e-dcd17956764e",
                                "sense_id": "8091a7fc-eb26-33d8-943d-a690df756f3f",
                                "text": "I want us to talk privately.",
                                "translation": "Θέλω να τα πούμε ιδιαιτέρως."
                            }
                        ]
                    },
                    {
                        "sense_id": "c4c7fb44-a368-395a-9e33-8b788285a21e",
                        "entry_id": "1d9c2e89-17f2-3b81-a6a4-1ed0c19257d5",
                        "glosses": [
                            "κρυφά, στις προσωπικές σκέψεις κάποιου· με τρόπο που δεν είναι γνωστός στο κοινό"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0943215e-1729-4de0-bf80-10eeb03f6703",
                                "sense_id": "c4c7fb44-a368-395a-9e33-8b788285a21e",
                                "text": "I know that privately you hope that I am wrong.",
                                "translation": "Γνωρίζω ότι κρυφά ελπίζετε ότι θα κάνω λάθος."
                            },
                            {
                                "example_id": "d8094156-440f-46c0-88fc-981ae51f11e7",
                                "sense_id": "c4c7fb44-a368-395a-9e33-8b788285a21e",
                                "text": "She smiled, but privately she was furious.",
                                "translation": "Χαμογέλασε, αλλά κρυφά ήταν έξαλλη από το θυμό."
                            }
                        ]
                    },
                    {
                        "sense_id": "6e3e0a34-2cce-3f2f-97f5-6b969e1de9d3",
                        "entry_id": "1d9c2e89-17f2-3b81-a6a4-1ed0c19257d5",
                        "glosses": [
                            "ιδιαίτερα μαθήματα, σε ένα άτομο ή σε μια μικρή ομάδα ατόμων για πληρωμή"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59387c13-824a-45df-adb9-876d9062c026",
                                "sense_id": "6e3e0a34-2cce-3f2f-97f5-6b969e1de9d3",
                                "text": "She gave piano lessons privately.",
                                "translation": "Έδινε ιδιαίτερα μαθήματα πιάνου."
                            }
                        ]
                    }
