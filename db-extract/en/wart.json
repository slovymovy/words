                "senses": [
                    {
                        "sense_id": "3c456280-a084-3da7-9350-69d46a951d6e",
                        "entry_id": "5303360e-6911-3312-8bb0-93115afcd221",
                        "glosses": [
                            "A type of deformed growth occurring on the skin caused by the human papillomavirus (HPV)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fd97281-5f4a-4c7b-a457-6331dfc5de8f",
                                "sense_id": "3c456280-a084-3da7-9350-69d46a951d6e",
                                "text": "A wart has appeared on my toe."
                            }
                        ]
                    },
                    {
                        "sense_id": "5d45781d-1724-3f93-bfb7-469aa9d89b27",
                        "entry_id": "5303360e-6911-3312-8bb0-93115afcd221",
                        "glosses": [
                            "Any similar growth occurring in plants or animals, such as the parotoid glands in the back of toads."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "200b4380-bd34-3aca-b979-125fee24e8e6",
                        "entry_id": "5303360e-6911-3312-8bb0-93115afcd221",
                        "glosses": [
                            "Anything unsightly or undesirable; a blemish."
                        ],
                        "tags": [
                            "figuratively",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "414b66e8-6290-48a4-856f-debcdf6cc8db",
                                "sense_id": "200b4380-bd34-3aca-b979-125fee24e8e6",
                                "text": "Things that look too good to be true usually are, and every company has some warts that need to be taken into account."
                            }
                        ]
                    },
                    {
                        "sense_id": "ec43d0a1-d211-3000-9aa1-95bf03c73136",
                        "entry_id": "5303360e-6911-3312-8bb0-93115afcd221",
                        "glosses": [
                            "Any of the prefixes used in Hungarian notation."
                        ],
                        "tags": [
                            "derogatory",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "b75f0770-8910-4d8e-988c-e4f1c0c1b26a",
                                "sense_id": "ec43d0a1-d211-3000-9aa1-95bf03c73136",
                                "text": "Hungarian warts suck big time! If you need them, your functions are too big and your class interface is much too fat."
                            },
                            {
                                "example_id": "05f7cb95-09ce-4f0e-931d-caccbc25c3c7",
                                "sense_id": "ec43d0a1-d211-3000-9aa1-95bf03c73136",
                                "text": "Far easier to not use warts in the first place. Even if a wart is present, you still have to verify the variable's declaration anyway, if you're a diligent maintenance programmer."
                            }
                        ]
                    }
                ],
                "translations": [
