                "senses": [
                    {
                        "sense_id": "c12a647b-9401-3aaf-9221-ddd30aed1131",
                        "entry_id": "843a1235-f633-3e7f-91a3-a2f624ceb19b",
                        "glosses": [
                            "Synonym of reredorter: a monastery's latrine, outhouse, or lavatory, typically located behind the dormitory."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "929c48c9-7c7b-4254-8912-8e88a9f1a982",
                                "sense_id": "c12a647b-9401-3aaf-9221-ddd30aed1131",
                                "text": "The other outlet from the pisalis […] leads to the necessarium, in the corner of which a light […] is kept burning."
                            },
                            {
                                "example_id": "6c8c84fc-8707-4ec9-8227-80f1b0d0fe1a",
                                "sense_id": "c12a647b-9401-3aaf-9221-ddd30aed1131",
                                "text": "A passage at the other end [of the dormitory] leads to the “necessarium” (I), a portion of the monastic buildings always planned with extreme care."
                            }
                        ]
                    },
                    {
                        "sense_id": "8ed9a7be-d8f2-328d-bedb-5a28407b30b5",
                        "entry_id": "843a1235-f633-3e7f-91a3-a2f624ceb19b",
                        "glosses": [
                            "A lavatory."
                        ],
                        "tags": [
                            "capitalized",
                            "humorous",
                            "sometimes"
                        ],
                        "examples": [
                            {
                                "example_id": "931d087d-9028-43d5-83b3-dcf98670212d",
                                "sense_id": "8ed9a7be-d8f2-328d-bedb-5a28407b30b5",
                                "text": "Viewers […] don't mind having a hundred variations, from ‘The Necessarium’ to ‘The Thunder-Box’ to choose from."
                            }
                        ]
                    }
                ],
