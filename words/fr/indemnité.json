    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5ec589da-b020-3952-99b8-070d84b89694",
                    "sense_definition": "Somme allouée à une personne en compensation d'un préjudice, d'une perte ou de la rupture d'un contrat.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "compensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après son départ forcé de l'entreprise, elle a perçu une <w>indemnité</w> de licenciement conforme à la loi."
                        },
                        {
                            "text": "L'assurance lui a versé une importante <w>indemnité</w> pour réparer les dégâts causés par l'inondation."
                        }
                    ],
                    "synonyms": [
                        "compensation",
                        "dédommagement",
                        "réparation"
                    ],
                    "common_phrases": [
                        "indemnité de licenciement",
                        "indemnités journalières",
                        "indemnité compensatrice"
                    ]
                },
                {
                    "sense_id": "4033821f-b068-3499-97f1-5d839d2eb77b",
                    "sense_definition": "Somme allouée en supplément d'un salaire pour couvrir des frais liés à une fonction ou des sujétions spécifiques.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "allocation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les salariés qui utilisent leur propre véhicule reçoivent une <w>indemnité</w> de déplacement chaque mois."
                        },
                        {
                            "text": "Cet agent de la fonction publique perçoit une <w>indemnité</w> de résidence en plus de son traitement de base."
                        }
                    ],
                    "synonyms": [
                        "allocation",
                        "défraiement",
                        "prime"
                    ],
                    "common_phrases": [
                        "indemnité de déplacement",
                        "indemnité de résidence",
                        "indemnité de transport"
                    ]
                },
                {
                    "sense_id": "1bbc46b7-d1ee-37ee-8c5b-19c4ec7bdeb2",
                    "sense_definition": "Acte officiel ou juridique par lequel on garantit un dédommagement ou une exonération de responsabilité.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "acte_juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le parlement a adopté une disposition exceptionnelle tenant lieu d'<w>indemnité</w> pour protéger les agents de poursuites."
                        },
                        {
                            "text": "Le ministre a signé un acte d'<w>indemnité</w> afin de prémunir les investisseurs contre toute perte imprévue."
                        }
                    ],
                    "synonyms": [
                        "garantie"
                    ],
                    "common_phrases": [
                        "bill d'indemnité"
                    ]
                }
            ]
        }
    ]
