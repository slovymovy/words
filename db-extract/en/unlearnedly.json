                        "glosses": [
                            "In an unlearned manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10465977-1ce5-4549-b018-ec619fbaf717",
                                "sense_id": "e730492e-cfc4-3a60-bb8f-1ed5122f4c7f",
                                "text": "And those Affectators of Variety seem equally ridiculous, who, when they have spoken barbarously once, repeat the same Thing much more barbarously; and then over and over again much more unlearnedly."
                            },
                            {
                                "example_id": "00e2c0d2-6015-43f3-b38d-fdd004b2c113",
                                "sense_id": "e730492e-cfc4-3a60-bb8f-1ed5122f4c7f",
                                "text": "Better far for such victims had they, instead of aspiring to the vanities of a \"classical education,\" sat, like Keats, unlearnedly at the feet of quaint Chapman, or Dryden, or even of Mr. Pope."
                            }
                        ]
                    }
