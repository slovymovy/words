                "senses": [
                    {
                        "sense_id": "93ff0a7b-60f1-3d52-a6eb-cc9aa3b83a34",
                        "entry_id": "a81f44c4-936a-3fab-809a-a7e1ea0b809d",
                        "glosses": [
                            "Qui est en retard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7aa22f5-da3e-4925-a903-84b42e50cde4",
                                "sense_id": "93ff0a7b-60f1-3d52-a6eb-cc9aa3b83a34",
                                "text": "Un soir il n’arriva pas à l’heure ordinaire. Brisquette venait sur le pas de la porte, rentrait, ressortait, et disait, en se croisant les mains : — Mon Dieu, qu’il est attardé !…"
                            },
                            {
                                "example_id": "a5c03615-dd4d-4419-aea0-040c789723a4",
                                "sense_id": "93ff0a7b-60f1-3d52-a6eb-cc9aa3b83a34",
                                "text": "Sur la route de Sailly à Malandry, pour ne citer enfin que ce dernier exemple, c'était l'âme d'un moine blanc de l'ancienne abbaye d'Orval qui apparaissait la nuit aux voyageurs attardés."
                            }
                        ]
                    },
                    {
                        "sense_id": "bdf76b28-c73a-328c-bfd7-c718120609e7",
                        "entry_id": "a81f44c4-936a-3fab-809a-a7e1ea0b809d",
                        "glosses": [
                            "Qui est en retard dans son développement intellectuel ou physique."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [],
                "word_linkages": []
