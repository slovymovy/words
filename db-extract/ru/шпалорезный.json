                "senses": [
                    {
                        "sense_id": "b26706c0-194b-3dd7-9f0f-1d8f0c61e144",
                        "entry_id": "b4f88d19-0ecf-3373-9191-95c6561168ac",
                        "glosses": [
                            "деревообр. предназначенный для распиливания древесины на шпалы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f1bd24f-983f-4232-8a97-1a8344e46dd2",
                                "sense_id": "b26706c0-194b-3dd7-9f0f-1d8f0c61e144",
                                "text": "На шпалорезный станок установлены следующие нормы выработки шпал (в расчете на 7-часовой рабочий день):"
                            },
                            {
                                "example_id": "ca451ba0-3e64-4b04-b540-391f0a5ac366",
                                "sense_id": "b26706c0-194b-3dd7-9f0f-1d8f0c61e144",
                                "text": "Первые шпалорезные станки отечественного производства были изготовлены мастерскими Ленинградского технологического института им. Ленсовета в 1923 году."
                            }
                        ]
                    }
