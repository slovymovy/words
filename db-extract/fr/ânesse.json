                                    {
                                        "sense_id": "a239759f-111b-3e06-8a81-b8c0f6b90976",
                                        "entry_id": "5631d05d-6b1c-345a-ba16-bebccfae1a28",
                                        "glosses": [
                                            "A female donkey."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ebce580-a35e-4e8d-8584-be306fa77a3f",
                                                "sense_id": "a239759f-111b-3e06-8a81-b8c0f6b90976",
                                                "text": "c. 1849, G. Herbert Rodwell, Old London Bridge, London: Henry Lea, Chapter 15, p. 158,\n[…] this little donkey could not be trusted in the road, for it was always getting under the wheels, because it would not let its mother, a fine fat old jenny ass in the shafts, alone."
                                            },
                                            {
                                                "example_id": "4d1cd852-a87e-4031-ba7f-395b3c8b3030",
                                                "sense_id": "a239759f-111b-3e06-8a81-b8c0f6b90976",
                                                "text": "But a man who holds so tightly to what he calls his rights over what he calls his debts will hold tightly also to what he calls his rights over her whom he calls his wife. No sir smile neighbour shall covet his ox or his wife or his manservant or his maidservant or his jackass. / —Or his jennyass, Buck Mulligan antiphoned."
                                            },
                                            {
                                                "example_id": "c3fdfb28-8671-4c05-865e-6c523a5d733f",
                                                "sense_id": "a239759f-111b-3e06-8a81-b8c0f6b90976",
                                                "text": "[…] old rope is for tethering your jennyass […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
