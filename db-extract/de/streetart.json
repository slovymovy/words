                    {
                        "sense_id": "2c4e7ece-9670-3c80-9fce-382b0bb79447",
                        "entry_id": "6e64ba26-bc8d-3fcc-a885-93bbcbd2b003",
                        "glosses": [
                            "Kunst im öffentlichen Raum, welche mit diesem interagiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d12837fd-99c9-4dbf-8ab5-1c06fa06c572",
                                "sense_id": "2c4e7ece-9670-3c80-9fce-382b0bb79447",
                                "text": "Streetart kann das Stadtbild verschönern."
                            },
                            {
                                "example_id": "7a5d2576-586f-4019-b9af-4eb0e37bf071",
                                "sense_id": "2c4e7ece-9670-3c80-9fce-382b0bb79447",
                                "text": "„Wer Gefallen an Streetart findet, braucht nur mit offenen Augen durch die Straßen der deutschen Hauptstadt zu gehen und wird so an vielen Stellen die phantasievollen Werke kreativer Köpfe entdecken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c74e0a8-abd5-42fc-ad36-d34a75bca504",
                        "source_entry_id": "6e64ba26-bc8d-3fcc-a885-93bbcbd2b003",
                        "source_sense_id": "2c4e7ece-9670-3c80-9fce-382b0bb79447",
                        "source_sense_description": "Kunst im öffentlichen Raum, welche mit diesem interagiert",
                        "target_lang_word": "street art",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "street art",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86e4444d-caaf-38cc-a5af-b2606e7f4ba4",
                                        "entry_id": "a0a932f5-de8e-3768-8c3c-4a12fe8d1d0f",
                                        "glosses": [
                                            "Visual art created in public space and executed outside of the context of traditional art venues."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44195b39-6f60-4a83-a919-1a3e311caaee",
                                                "sense_id": "86e4444d-caaf-38cc-a5af-b2606e7f4ba4",
                                                "text": "This summer over 50 outdoor street art shows will display the work of Michigan and out-of-state painters and craftsmen."
                                            },
                                            {
                                                "example_id": "4c89314c-c765-4a8c-9720-a9372ffeae7d",
                                                "sense_id": "86e4444d-caaf-38cc-a5af-b2606e7f4ba4",
                                                "text": "There is a street art explosion in America today of unprecedented proportions. A few years ago a person seeking out street art would have had a long search with lean rewards. Since 1970, the situation has changed dramatically."
                                            },
                                            {
                                                "example_id": "0756bff1-f7d6-4ae9-bf7f-38b60b8757ca",
                                                "sense_id": "86e4444d-caaf-38cc-a5af-b2606e7f4ba4",
                                                "text": "Little wonder then that subway cars became the canvas when street art literally went underground in the early 1970s."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
