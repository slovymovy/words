    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "33b8bef4-2883-3c1a-9f4b-6a5cac936e66",
                    "sense_definition": "iemands zijde kiezen in een discussie of debat; instemmen met wat iemand zegt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "steun_betuigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het verwonderde hem dat een aantal mensen hem <w>bijgevallen</w> waren, waarvan hij dat niet verwacht had.",
                            "target_lang_translations": {
                                "en": "It surprised him that a number of people had <w>backed</w> him <w>up</w>, from whom he had not expected it."
                            }
                        },
                        {
                            "text": "De voorzitter <w>valt</w> hem <w>bij</w> en benadrukt dat de kwaliteit van het onderzoek erg hoog is.",
                            "target_lang_translations": {
                                "en": "The chairman <w>agrees with</w> him and emphasizes that the quality of the research is very high."
                            }
                        }
                    ],
                    "synonyms": [
                        "ondersteunen",
                        "seconderen",
                        "instemmen"
                    ],
                    "antonyms": [
                        "tegenspreken",
                        "bestrijden"
                    ],
                    "common_phrases": [
                        "iemand bijvallen"
                    ],
                    "target_lang_definitions": {
                        "en": "to take someone's side in a discussion or debate; to agree with what someone is saying"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to agree with",
                                "target_lang_sense_clarification": "to support someone's statement"
                            },
                            {
                                "target_lang_word": "to back up",
                                "target_lang_sense_clarification": "to support someone in an argument"
                            },
                            {
                                "target_lang_word": "to second",
                                "target_lang_sense_clarification": "to formally support a proposal or person"
                            },
                            {
                                "target_lang_word": "to side with",
                                "target_lang_sense_clarification": "to take someone's part in a dispute"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d4f06db-e3d8-315d-b207-994621f8ace3",
                    "sense_definition": "erbij vallen, waardoor de totale hoeveelheid toeneemt",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "toename",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er was vannacht nog zeker twintig centimeter sneeuw <w>bijgevallen</w> op de skipistes.",
                            "target_lang_translations": {
                                "en": "At least another twenty centimeters of snow had <w>fallen</w> on the ski slopes last night."
                            }
                        },
                        {
                            "text": "Als er nog meer regen <w>bijvalt</w>, zal het waterpeil in de rivier gevaarlijk stijgen.",
                            "target_lang_translations": {
                                "en": "If even more rain <w>falls</w>, the water level in the river will rise dangerously."
                            }
                        }
                    ],
                    "synonyms": [
                        "toenemen"
                    ],
                    "common_phrases": [
                        "sneeuw bijvallen"
                    ],
                    "target_lang_definitions": {
                        "en": "to fall additionally, causing the total amount to increase (usually of precipitation)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to fall additionally",
                                "target_lang_sense_clarification": "referring to more snow or rain falling"
                            },
                            {
                                "target_lang_word": "to accumulate further",
                                "target_lang_sense_clarification": "referring to an increasing layer of snow"
                            }
                        ]
                    }
                }
            ]
        }
    ]
