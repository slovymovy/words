                "senses": [
                    {
                        "sense_id": "96aba79f-fe65-3958-a24b-520e1e547448",
                        "entry_id": "434b6cfb-29e2-3d2a-8ab6-c137720c5196",
                        "glosses": [
                            "rozpowszechniony w kuchni tureckiej, ormiańskiej, bułgarskiej i bałkańskiej deser z ciasta półfrancuskiego przełożonego warstwami pokrojonych orzechów (włoskich lub migdałów) z cukrem lub miodem, polewanego lukrem lub syropem i posypywanego tłuczonymi, niesolonymi orzeszkami pistacjowymi"
                        ],
                        "tags": [
                            "cuk."
                        ],
                        "examples": [
                            {
                                "example_id": "35acb0b6-fcd3-4767-8306-0610123f28ed",
                                "sense_id": "96aba79f-fe65-3958-a24b-520e1e547448",
                                "text": "Wewnątrz mówiło się po francusku i jadło ptifurki, lecz także turecką baklawę, rosyjskie pirożki, wiedeńskie strudle – przegląd najważniejszych w Rumunii wpływów kulturowych"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd4bdb39-bbef-4938-89fc-26f20a785310",
                        "source_entry_id": "434b6cfb-29e2-3d2a-8ab6-c137720c5196",
                        "source_sense_id": "96aba79f-fe65-3958-a24b-520e1e547448",
                        "target_lang_word": "baklava",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baklava",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5fd8ff0d-b469-3aae-a176-80a70c6a9ffd",
                                        "entry_id": "77f4182a-3f9f-391e-af5a-869fcf4485d8",
                                        "glosses": [
                                            "A sweet pastry found in many cuisines of the Middle East and the Balkans, made of chopped nuts layered with phyllo pastry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8de22e8-3269-45f5-b5d9-9729baed44b1",
                                                "sense_id": "5fd8ff0d-b469-3aae-a176-80a70c6a9ffd",
                                                "text": "It meant lifting tea towels off trays in her Muslim neighbours’ kitchens to help herself to sticky triangles of baklava, half lemon slices pressed into the syrupy pastry filled with walnuts and raisins."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dba0a504-934a-4f6a-a106-8e743af288d9",
                        "source_entry_id": "434b6cfb-29e2-3d2a-8ab6-c137720c5196",
                        "source_sense_id": "96aba79f-fe65-3958-a24b-520e1e547448",
                        "target_lang_word": "baclava",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "82e86c99-f085-46e5-9d16-bb9e27017eb0",
                        "source_entry_id": "434b6cfb-29e2-3d2a-8ab6-c137720c5196",
                        "source_sense_id": "96aba79f-fe65-3958-a24b-520e1e547448",
                        "target_lang_word": "Baklava",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Baklava",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1869df99-f661-339a-997f-3d4695f60ec5",
                                        "entry_id": "cc893ec2-958c-3b68-a8d6-1bdf1f951cdb",
                                        "glosses": [
                                            "Blätterteigpastete, die in Honig- oder Zuckersirup eingelegt und mit gehackten Walnüssen, Mandeln oder Pistazien gefüllt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "feac938b-afd9-4bcd-b43a-c54c8af3495b",
                                                "sense_id": "1869df99-f661-339a-997f-3d4695f60ec5",
                                                "text": "Viele Europäer können nicht viel Baklava essen, da sie fett ist und mit Zuckerwasser übergossen wird, das auf ein Maß Wasser ein Maß Zucker beinhaltet."
                                            },
                                            {
                                                "example_id": "79d3f561-d7df-4835-a792-90ab98912e3f",
                                                "sense_id": "1869df99-f661-339a-997f-3d4695f60ec5",
                                                "text": "„Zum Nachtisch gibt es eine Süßspeise, von der Honig tropft. »Ich habe so oft davon geträumt, eine Baklava zu essen. Diese Freude hört nicht auf.«“"
                                            },
                                            {
                                                "example_id": "8f7f7440-67b0-419d-85c1-7d47c7449300",
                                                "sense_id": "1869df99-f661-339a-997f-3d4695f60ec5",
                                                "text": "„Mara hat natürlich keine Ahnung, wer dieser Ohnesorg ist, und sie kann sich auch nicht mehr daran erinnern, ob Baklava nun der Ausdruck für den karierten Palästinenserschal ist oder für Blätterteiggebäck.“"
                                            },
                                            {
                                                "example_id": "6eb5cf71-8ff4-48da-ae32-41cbc2452e2a",
                                                "sense_id": "1869df99-f661-339a-997f-3d4695f60ec5",
                                                "text": "„Wir wurden mit Baklava und Wassermelonen gefüttert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "462871e4-c22d-4392-a3a3-1c319744bf75",
                        "source_entry_id": "434b6cfb-29e2-3d2a-8ab6-c137720c5196",
                        "source_sense_id": "96aba79f-fe65-3958-a24b-520e1e547448",
                        "target_lang_word": "баклава",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "баклава",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ff1c9c33-c550-3b9e-b0ff-c42e41c76ec7",
                                        "entry_id": "c98960fa-921d-375d-bc0e-31031d7f2829",
                                        "glosses": [
                                            "кулин. то же, что пахлава; восточная сладость из слоёного теста с орехами в сиропе"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35794d43-0d12-48b8-aeb4-e5dc511e6132",
                        "source_entry_id": "434b6cfb-29e2-3d2a-8ab6-c137720c5196",
                        "source_sense_id": "96aba79f-fe65-3958-a24b-520e1e547448",
                        "target_lang_word": "пахлава",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пахлава",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "739fb506-936a-3cb0-97de-ba8dddc3a173",
                                        "entry_id": "31fbbe33-f4dd-3225-b4bd-5e10d1153399",
                                        "glosses": [
                                            "кулин. кондитерское изделие из слоёного теста с орехами в сиропе, широко распространённое в кухнях восточных народов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a8c5ae3-ced9-4753-b5c1-f9ae0f942522",
                                                "sense_id": "739fb506-936a-3cb0-97de-ba8dddc3a173",
                                                "text": ".. венцом её жизни был греческий ресторанчик, образовавшийся из розничной торговли восточными сладостями, в частности пахлавой, тесто для которой так ловко растягивали её проворные некрасивые дочери. ❬…❭ .. обед растягивался часа на два и, кроме обычной здешней еды — самсы, лагмана, всегда стояла на столе какая-нибудь армянская редкость — даже пахлаву Леночка печь не разучилась."
                                            },
                                            {
                                                "example_id": "9e15d786-7ca9-4494-9119-d69c58b8ed69",
                                                "sense_id": "739fb506-936a-3cb0-97de-ba8dddc3a173",
                                                "text": "Летом он всегда отоваривался в палатках в самом начале Поварской. Особенно любил пахлаву — сочную, с большим количеством орехов, такую не делают больше ни в одной кулинарии города."
                                            },
                                            {
                                                "example_id": "d425cd73-6261-4574-afa1-69448c6e8a3a",
                                                "sense_id": "739fb506-936a-3cb0-97de-ba8dddc3a173",
                                                "text": "Сладости — одна из главных прелестей турецкой жизни. За пределами страны известны в основном халва .., лукум .. и сладкая тяжёлая выпечка пахлава .."
                                            },
                                            {
                                                "example_id": "afe7fda1-fc99-42e7-b3d7-8ea7ff6c62f8",
                                                "sense_id": "739fb506-936a-3cb0-97de-ba8dddc3a173",
                                                "text": "Говоря о десертах, турки очень равнодушны к привычным нам тортам и пирожным. У них есть свои лакомства. На первом месте пахлава, которую в Турции называют «баклава». Лепестки теста, обильно сдобренные фисташками или другой ореховой начинкой и пропитанные сахарным сиропом, сведут с ума любого сладкоежку."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
