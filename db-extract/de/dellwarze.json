                ],
                "senses": [
                    {
                        "sense_id": "10faf353-2053-36fc-964a-68ab2cecf5d8",
                        "entry_id": "d77d9595-582b-3b1d-b45b-1b2ce99ec872",
                        "glosses": [
                            "weltweit verbreitete virale Infektion der Haut, bei der derbe, hautfarbene Papeln mit Hornpfropf als zentrale Eindellung heranwachsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6b37d39-3992-447e-a4db-f1660294404c",
                                "sense_id": "10faf353-2053-36fc-964a-68ab2cecf5d8",
                                "text": "Dellwarzen haben ihren Namen von der kleinen Delle in der Mitte."
                            },
                            {
                                "example_id": "99b5490b-b4c6-4c14-8864-ef96ebe3c9f9",
                                "sense_id": "10faf353-2053-36fc-964a-68ab2cecf5d8",
                                "text": "Dellwarzen kommen besonders häufig bei Kindern vor, insbesondere bei Kindern mit atopischem Ekzem (Neurodermitis), bei Personen mit Immunschwäche, Personen unter Kortisontherapie und sexuell aktiven Erwachsenen."
                            },
                            {
                                "example_id": "8d3860eb-9d0e-4193-9594-703997fbc2ac",
                                "sense_id": "10faf353-2053-36fc-964a-68ab2cecf5d8",
                                "text": "Kaliumhydroxid wird zweimal täglich auf die Dellwarzen aufgetragen, bis eine leichte Entzündungsreaktion sichtbar ist. Danach beginnt die Abheilung der Mollusken innerhalb weniger Tage."
                            },
                            {
                                "example_id": "c3415de4-fc45-4c41-8d45-c9e4f44e81e6",
                                "sense_id": "10faf353-2053-36fc-964a-68ab2cecf5d8",
                                "text": "Dellwarzen können speziell bei trockener Haut von einem mitunter starken Juckreiz begleitet werden."
                            },
                            {
                                "example_id": "6d9d4b7a-9a96-412f-ba4b-01985225e2ae",
                                "sense_id": "10faf353-2053-36fc-964a-68ab2cecf5d8",
                                "text": "Die Ansteckung mit Dellwarzen erfolgt in den allermeisten Fällen von Mensch zu Mensch über direkten Hautkontakt, beispielsweise beim Spielen von Kindern, bei Erwachsenen auch über Geschlechtsverkehr und gemeinsam benutzte Objekte, insbesondere Textilien wie Handtücher."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
