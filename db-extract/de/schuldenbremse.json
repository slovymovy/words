                ],
                "senses": [
                    {
                        "sense_id": "0cf11eab-aa2e-3eb6-83e0-fe58d4da0b69",
                        "entry_id": "7ac1bbce-9d0b-33df-baf1-577e067bbab7",
                        "glosses": [
                            "(verfassungsrechtliche/gesetzliche) Bestimmungen zur Begrenzung von Haushaltsdefiziten und der staatlichen Verschuldung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5225c23f-2800-46f4-b6a1-59d2fe1a02e8",
                                "sense_id": "0cf11eab-aa2e-3eb6-83e0-fe58d4da0b69",
                                "text": "„Die Schweizer Schuldenbremse funktioniert nach dem Prinzip von Grossmutters Haushaltsbüchlein. Der Staat darf über die Dauer nicht mehr ausgeben, als er einnimmt.“"
                            },
                            {
                                "example_id": "cd949438-9420-4be4-a23e-6255cb507ffd",
                                "sense_id": "0cf11eab-aa2e-3eb6-83e0-fe58d4da0b69",
                                "text": "„Die Schweizer Schuldenbremse ist bereits 20 Jahre in Kraft.“"
                            },
                            {
                                "example_id": "d9281d63-99b4-4776-99a1-2e79e8f00ac6",
                                "sense_id": "0cf11eab-aa2e-3eb6-83e0-fe58d4da0b69",
                                "text": "„Politiker und Ökonominnen nutzen das Jubiläum, um ein Loblied auf die Schuldenbremse zu singen.“"
                            },
                            {
                                "example_id": "e68fe921-4839-4771-bd1a-b07d6a994a9a",
                                "sense_id": "0cf11eab-aa2e-3eb6-83e0-fe58d4da0b69",
                                "text": "„Nach Verhandlungen zwischen Bund und Ländern wurde die Schuldenbremse im Frühsommer 2009 mit Zweidrittelmehrheit in Bundestag und Bundesrat beschlossen und im Grundgesetz verankert.“"
                            },
                            {
                                "example_id": "ec84095d-f9e1-4fa9-8950-f9228f07f2fd",
                                "sense_id": "0cf11eab-aa2e-3eb6-83e0-fe58d4da0b69",
                                "text": "„Die Schuldenbremse in Deutschland steht viel mehr in der Kritik als in der Schweiz.“"
                            },
                            {
                                "example_id": "12f0a71c-542b-458b-b5ba-356352930de1",
                                "sense_id": "0cf11eab-aa2e-3eb6-83e0-fe58d4da0b69",
                                "text": "„Im Zuge des Streits über das Milliardenloch im Haushalt kocht eine generelle Debatte über die Schuldenbremse hoch“ […]."
                            },
                            {
                                "example_id": "2abac3df-edf5-472f-8561-1773bdb45292",
                                "sense_id": "0cf11eab-aa2e-3eb6-83e0-fe58d4da0b69",
                                "text": "[2022:] „Schneider forderte die Bundesregierung auf, die Schuldenbremse auszusetzen.“"
                            },
                            {
                                "example_id": "94acdde0-a175-44a2-8d08-a12251848039",
                                "sense_id": "0cf11eab-aa2e-3eb6-83e0-fe58d4da0b69",
                                "text": "[2023:] „Die Schuldenbremse soll nicht erneut ausgesetzt werden.“"
                            },
                            {
                                "example_id": "ffb69a7a-7b8a-48f3-a2df-1521b1cbec90",
                                "sense_id": "0cf11eab-aa2e-3eb6-83e0-fe58d4da0b69",
                                "text": "„Die Schuldenbremse ist im Grundgesetz verankert - und dennoch verhandelbar.“"
                            },
                            {
                                "example_id": "6221517d-ea12-48ea-ad52-96e8bae3498c",
                                "sense_id": "0cf11eab-aa2e-3eb6-83e0-fe58d4da0b69",
                                "text": "[…] „in Notlagen kann die Schuldenbremse auch ausgesetzt werden, so wie während der Corona-Pandemie.“"
                            },
                            {
                                "example_id": "2758a1f6-6a03-4b02-8494-070801fee6f3",
                                "sense_id": "0cf11eab-aa2e-3eb6-83e0-fe58d4da0b69",
                                "text": "„Beide Methoden – Eigenkapital und Staatskredite – riechen schon von Weitem nach Umgehung der verfassungsrechtlichen Schuldenbremse.“"
                            },
                            {
                                "example_id": "03d43781-aded-40f5-a04e-c57818649b84",
                                "sense_id": "0cf11eab-aa2e-3eb6-83e0-fe58d4da0b69",
                                "text": "„Intelligente Ideen für ein faires Steuersystem zu entwickeln, ja, Diskussionen überhaupt einmal zuzulassen – wäre das nicht eine schöne Aufgabe für einen Bundesfinanzminister, der unbedingt die sogenannte Schuldenbremse einhalten will?“"
                            },
                            {
                                "example_id": "b286a064-f0a0-4955-84db-715b66b78459",
                                "sense_id": "0cf11eab-aa2e-3eb6-83e0-fe58d4da0b69",
                                "text": "„Politisch ist die Schuldenbremse vor allem für die FDP nicht verhandelbar.“"
                            },
                            {
                                "example_id": "553bf2d1-f9c9-4d96-84b7-d06907b7041c",
                                "sense_id": "0cf11eab-aa2e-3eb6-83e0-fe58d4da0b69",
                                "text": "„Das Finanzministerium hat mit Zeitungsanzeigen für die Schuldenbremse geworben. War das eine verdeckte Parteienfinanzierung für die FDP?“"
                            },
                            {
                                "example_id": "d3fa1e19-9aa4-4b2e-b117-26fdda4e2379",
                                "sense_id": "0cf11eab-aa2e-3eb6-83e0-fe58d4da0b69",
                                "text": "„Viele Ökonomen plädieren angesichts der aktuellen Lage dafür, die Schuldenbremse zumindest maßvoll aufzuweichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
