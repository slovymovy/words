                    },
                    {
                        "translation_id": "32828338-aa44-484e-a82a-eccf86688925",
                        "source_entry_id": "38ee01a5-41a5-383d-af51-060a5e46396e",
                        "source_sense_id": "bc6c38ff-716c-3946-9407-a2ed87635dbc",
                        "source_sense_description": "felgekleurde papiersnippers",
                        "target_lang_word": "confetti",
                        "target_lang_code": "en",
