                "senses": [
                    {
                        "sense_id": "1e44fc48-74e1-32b1-9fa4-901c347795aa",
                        "entry_id": "dfc3f1ba-fa8e-3f98-9aad-65dc335890e2",
                        "glosses": [
                            "Haufen aus Steinbrocken/Erzgestein, aus durch Hauen gewonnenem Material"
                        ],
                        "tags": [
                            "Bergbau"
                        ],
                        "examples": [
                            {
                                "example_id": "e4bd6f88-fd69-451d-b94d-a6676dca7e3f",
                                "sense_id": "1e44fc48-74e1-32b1-9fa4-901c347795aa",
                                "text": "„Für Bereiche an denen Hauwerk abgestürzt wird, zB Versturzkanten, Aufgabestellen für Sturzrinnen und Sturzschächte oder Entladestellen von Fahrzeugen, gilt: […].“"
                            },
                            {
                                "example_id": "798fb339-0e59-48e4-a5f1-2f70956e6a9f",
                                "sense_id": "1e44fc48-74e1-32b1-9fa4-901c347795aa",
                                "text": "„Ein Kübel Hauwerk wog etwa einen Bergzentner. Ein Bergzentner entsprach einem Gewicht von 56 kg.“"
                            },
                            {
                                "example_id": "45d536d2-670f-487e-915b-207501117003",
                                "sense_id": "1e44fc48-74e1-32b1-9fa4-901c347795aa",
                                "text": "„Haufwerke (in Österreich Hauwerke) entstanden ursprünglich beim Bergbau. Der nicht verwendbare Abraum aus dem Berg wurde so benannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
