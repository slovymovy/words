                    {
                        "form_id": "e0657bf2-30d5-4277-943c-b00c1cef5620",
                        "entry_id": "17ff2fe4-f516-3e04-81bd-ea46c5251ab4",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "versaillaise"
                    },
                    {
                        "form_id": "b8709805-e8d7-4e5e-a7d3-7b97c9859107",
                        "entry_id": "17ff2fe4-f516-3e04-81bd-ea46c5251ab4",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "versaillaises"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3c9a8bf9-1a69-39a2-a084-fcf09826784a",
                        "entry_id": "17ff2fe4-f516-3e04-81bd-ea46c5251ab4",
                        "glosses": [
                            "Relatif à Versailles, commune française située dans le département des Yvelines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90aafea3-2f53-476a-afae-42fea01c8e85",
                                "sense_id": "3c9a8bf9-1a69-39a2-a084-fcf09826784a",
                                "text": "Pour cet épisode versaillais qu’il a lui-même sacralisé comme un grand moment, il s’est contenté d’égrener savamment, et 90 minutes durant, des généralités volontaristes sur la France, qu’il va remettre en marche sans plus tarder, et l’Europe dans la foulée."
                            }
                        ]
                    },
                    {
                        "sense_id": "3dbdb770-b8f4-33e8-98ec-0fa4c397188f",
                        "entry_id": "17ff2fe4-f516-3e04-81bd-ea46c5251ab4",
                        "glosses": [
                            "Relatif au Château de Versailles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ff08511-e3dc-4028-8174-c2606a041c94",
                                "sense_id": "3dbdb770-b8f4-33e8-98ec-0fa4c397188f",
                                "text": "La Galerie des Glaces est l’aboutissement suprême du lyrisme versaillais, […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "76bc11a7-9c4c-377c-b732-565cc4786208",
                        "entry_id": "17ff2fe4-f516-3e04-81bd-ea46c5251ab4",
                        "glosses": [
                            "Qualifie l’esprit du mouvement qui s’est opposé à la commune de 1871."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b40b3735-f9de-49ab-8eee-bade88d64ad2",
                                "sense_id": "76bc11a7-9c4c-377c-b732-565cc4786208",
                                "text": "Macron a des vertus, parmi celles-ci, il a celle de débrider la parole du bloc bourgeois qui grâce à lui peut étaler toute sa haine du peuple et son esprit versaillais."
                            }
                        ]
                    },
                    {
                        "sense_id": "9d21d1e8-1e61-3645-a89e-a7037bfe31ff",
                        "entry_id": "17ff2fe4-f516-3e04-81bd-ea46c5251ab4",
                        "glosses": [
                            "Qualifie les individus de type bon chic bon genre, qui ont une pratique assidue du catholicisme."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "586a39c9-3b2f-4b91-98f5-2cf640e1dbb7",
                                "sense_id": "9d21d1e8-1e61-3645-a89e-a7037bfe31ff",
                                "text": "Robespierristes et versaillais se retrouvent dans la haine de l'étranger."
                            },
                            {
                                "example_id": "ee9262d3-a8b1-4ff0-8e94-1407d021fecd",
                                "sense_id": "9d21d1e8-1e61-3645-a89e-a7037bfe31ff",
                                "text": "Bref, les frontières entre catholiques « observants », « traditionalistes » et « intégristes » semblent poreuses dans l’entre-soi versaillais."
                            }
                        ]
                    }
                ],
                "translations": [],
