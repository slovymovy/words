                            {
                                "example_id": "67e8c57a-a3f6-449c-9c53-1984867d00ce",
                                "sense_id": "1a020501-fe3a-3d02-90cd-4e402ad08c8a",
                                "text": "Er worden daar heilzame eigenschappen aan toegeschreven."
                            },
                            {
                                "example_id": "f4f48983-350a-4f35-ab5d-4370e988bdb6",
                                "sense_id": "1a020501-fe3a-3d02-90cd-4e402ad08c8a",
                                "text": "Net als ik vond ze het heilzaam om er af en toe alleen op uit te trekken."
                            }
                        ]
                    }
