                "senses": [
                    {
                        "sense_id": "874dcfde-8792-3103-bc45-08f203fa4156",
                        "entry_id": "a4396faf-1d77-3ccd-9b58-f29d415adbbd",
                        "glosses": [
                            "истор. причинение себе физических страданий (обычно путём нанесения себе ударов плетью) из религиозного изуверства, фанатизма"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d3095240-10a5-36e9-9059-821dccb994ee",
                        "entry_id": "a4396faf-1d77-3ccd-9b58-f29d415adbbd",
                        "glosses": [
                            "перен. суровое обличение своих поступков, слабостей; обвинения, упрёки самому себе, обычно — вследствие раскаяния, сознания своей вины"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3637764-633b-42f9-bbe4-1ed3c81384f6",
                        "source_entry_id": "a4396faf-1d77-3ccd-9b58-f29d415adbbd",
                        "source_sense_description": "причинение себе физических страданий из религиозного изуверства",
                        "target_lang_word": "self-flagellation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "self-flagellation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9826a130-50b4-3281-b3bf-8b14062fe0fd",
                                        "entry_id": "358aeb1a-575f-389a-bec2-93d595baf63c",
                                        "glosses": [
                                            "The practice of whipping oneself as penance for sins."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "86dbaeb5-ddf0-3415-82c5-52f9cf255ded",
                                        "entry_id": "358aeb1a-575f-389a-bec2-93d595baf63c",
                                        "glosses": [
                                            "Intense feelings of guilt."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfef713c-1bff-45bd-babc-16fa65ba095a",
                                                "sense_id": "86dbaeb5-ddf0-3415-82c5-52f9cf255ded",
                                                "text": "It was [...] followed by feelings of immense guilt and self-flagellation. What did I do wrong? What did I forget?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a549697a-0cd3-4b7f-b8b1-8ed4666d6964",
                        "source_entry_id": "a4396faf-1d77-3ccd-9b58-f29d415adbbd",
                        "source_sense_description": "причинение себе физических страданий из религиозного изуверства",
                        "target_lang_word": "autoflagellation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autoflagellation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "af48eec6-70d1-3724-84a1-05234fc9f85f",
                                        "entry_id": "234dc193-1824-3bc6-8234-ce2cb80bee7c",
                                        "glosses": [
                                            "Action de se flageller."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a957244-6fd5-482e-8a83-138626b6e933",
                                                "sense_id": "af48eec6-70d1-3724-84a1-05234fc9f85f",
                                                "text": "L’automutilation sert généralement à évacuer les tensions. Les personnes concernées se blessent afin d’évacuer des tensions intérieures insupportables et, le cas échéant, de ne plus ressentir des souvenirs traumatisants ou des sentiments douloureux. L’autoflagellation serait également un motif. Après s’être blessées elles-mêmes, les personnes concernées se sentent dans un premier temps soulagées. Mais ce sentiment positif fait ensuite place à la honte et à la culpabilité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d2d599b-440e-3a42-a9be-d8d7fdd781e2",
                                        "entry_id": "234dc193-1824-3bc6-8234-ce2cb80bee7c",
                                        "glosses": [
                                            "Fait de s’accabler de reproches."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e6a8a4f-07f8-4f5e-86c6-80ca8cc97e0a",
                                                "sense_id": "9d2d599b-440e-3a42-a9be-d8d7fdd781e2",
                                                "text": "Son récit est d’autant plus exceptionnel et précieux qu’il se démarque de l’habituelle attitude d’autocritique ou d’autoflagellation invariablement adoptée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98ba7b6a-33d5-400a-933e-712e89a0d3bf",
                        "source_entry_id": "a4396faf-1d77-3ccd-9b58-f29d415adbbd",
                        "source_sense_description": "причинение себе физических страданий из религиозного изуверства",
                        "target_lang_word": "mortification",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mortification",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7db42285-65e6-3fc3-894d-a3a6750ff23b",
                                        "entry_id": "621cc794-f749-3f0f-9347-0218043600a6",
                                        "glosses": [
                                            "État d’un tissu ou d’un organe qui se décompose et devient comme mort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1a25f88-1f45-4d3f-b70c-8638a5e1b934",
                                                "sense_id": "7db42285-65e6-3fc3-894d-a3a6750ff23b",
                                                "text": "La mortification du tissu cellulaire dans le premier cas, l'absence de cette mortification dans le second, établissent seules la différence entre ces deux affections."
                                            },
                                            {
                                                "example_id": "a86aeed3-d9ce-48fc-b427-46a4120767b0",
                                                "sense_id": "7db42285-65e6-3fc3-894d-a3a6750ff23b",
                                                "text": "Sont considérées également comme blessures de guerre les gelures avec mortification tissulaire si elles ont été contractées dans une unité combattante, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bae492d4-ed90-3f50-a4af-97bb44ba95e4",
                                        "entry_id": "621cc794-f749-3f0f-9347-0218043600a6",
                                        "glosses": [
                                            "Action de garder certaines viandes pour qu’elles deviennent tendres et gagnent du fumet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f41091b-25a8-435d-845c-3aea5dfa75c7",
                                                "sense_id": "bae492d4-ed90-3f50-a4af-97bb44ba95e4",
                                                "text": "Le gibier, frais tué, a la chair plus dure et n'est pas toujours d'une grande saveur, si ce n'est le fumet du sauvage qui va s'amplifiant avec la mortification, le \"faisandage\" qui attendrit les viandes."
                                            },
                                            {
                                                "example_id": "5ed85025-461a-4f61-9cb0-dbb731f757b4",
                                                "sense_id": "bae492d4-ed90-3f50-a4af-97bb44ba95e4",
                                                "text": "À tel point qu'un chef au firmament étoilé prétendait, il y a peu, la servir clandestinement simplement rôtie après trois jours de mortification au frigo !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0aee0027-ae71-3cc4-9a8a-c385897aaa15",
                                        "entry_id": "621cc794-f749-3f0f-9347-0218043600a6",
                                        "glosses": [
                                            "Action par laquelle on mortifie son corps ou ses passions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abb5181c-cd77-4504-b241-bdbd7da45c62",
                                                "sense_id": "0aee0027-ae71-3cc4-9a8a-c385897aaa15",
                                                "text": "Des mortifications, des jeûnes les purifient. Ni froment, ni huile.."
                                            },
                                            {
                                                "example_id": "d42b8e8f-9277-4384-9425-ed6f864a1825",
                                                "sense_id": "0aee0027-ae71-3cc4-9a8a-c385897aaa15",
                                                "text": "Elle essaya, par mortification, de rester tout un jour sans manger."
                                            },
                                            {
                                                "example_id": "b88fe52c-a2f7-4533-9697-d8fa7f468ab4",
                                                "sense_id": "0aee0027-ae71-3cc4-9a8a-c385897aaa15",
                                                "text": "L’indifférence de son mari et la maussaderie de son père la condamnaient à une solitude dont elle souffrait, mais qu’elle offrait à son Créateur comme la plus grande mortification de sa vie, ainsi qu’elle le disait elle-même en inclinant la tête et en abaissant les paupières."
                                            },
                                            {
                                                "example_id": "989559e5-3f19-45ad-8022-f86c71ad9202",
                                                "sense_id": "0aee0027-ae71-3cc4-9a8a-c385897aaa15",
                                                "text": "Par mortification, d’ordinaire, elle ne prend pas de sucre, mais il faut bien nourrir l’enfant qu’elle porte. Un morceau, puis un second, tombent dans le crémeux liquide. Mathilde prononce en silence un benedicite, choisit une tranche de pain bis, la beurre, et s’adonne sérieusement à la douceur de manger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23752743-de81-30a7-b4b9-cebbd7a5b1cf",
                                        "entry_id": "621cc794-f749-3f0f-9347-0218043600a6",
                                        "glosses": [
                                            "Pratique d'ascèse religieuse consistant à s'imposer une souffrance, en général physique, dans le but de progresser spirituellement."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9e8942f-5f08-47cb-9978-bfceda56accd",
                                                "sense_id": "23752743-de81-30a7-b4b9-cebbd7a5b1cf",
                                                "text": "Le premier soin du confesseur sera donc d'affermir dans la vie spirituelle les personnes qui s'adonnent à la piété : ensuite , suivant leur condition , leur santé et leur ferveur, il leur permettra quelques mortifications corporelles."
                                            },
                                            {
                                                "example_id": "fdde2ae8-e156-4bac-993d-c230fe7a48f2",
                                                "sense_id": "23752743-de81-30a7-b4b9-cebbd7a5b1cf",
                                                "text": "Il y a souvent chez eux, avez-vous ajouté, des exagérations de mortification que vous êtes les premiers à condamner chez les mahométans et les idolâtres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af45484d-c453-3e5c-8efa-dc8dbcea2d2f",
                                        "entry_id": "621cc794-f749-3f0f-9347-0218043600a6",
                                        "glosses": [
                                            "Accidents fâcheux qui arrivent dans la vie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed36ca8d-f28e-4947-85bd-cc01bc6e0d96",
                                                "sense_id": "af45484d-c453-3e5c-8efa-dc8dbcea2d2f",
                                                "text": "Les maladies sont des mortifications que Dieu nous envoie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59a6ce6b-0d97-3a7f-ba87-9f7a2cccbf9d",
                                        "entry_id": "621cc794-f749-3f0f-9347-0218043600a6",
                                        "glosses": [
                                            "Chagrin, humiliation qu’on fait éprouver à une personne par quelque réprimande ou par quelque procédé dur et fâcheux."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "988329f4-7a75-4b06-89c8-c971ccde40fa",
                                                "sense_id": "59a6ce6b-0d97-3a7f-ba87-9f7a2cccbf9d",
                                                "text": "Non ; la grande et l’unique cause de l’expédition de Crimée, qui a coûté à la France 100 000 hommes et trois empreints de 500 millions chacun, a été la mortification vivement ressentie par le nouvel empereur des Français de n’avoir pas été appelé par l’empereur de Russie : « Mon bon frère »."
                                            },
                                            {
                                                "example_id": "0ab96e14-36a2-4437-9361-cfccd4c16050",
                                                "sense_id": "59a6ce6b-0d97-3a7f-ba87-9f7a2cccbf9d",
                                                "text": "Ils avaient tort, dès lors, de se sentir, à certains instants atteints dans leur dignité : ces petites mortifications – demander d’un ton peu assuré le prix de quelque chose, hésiter, tenter de marchander, lorgner les devantures sans oser entrer, avoir envie, avoir l’air mesquin – faisaient-elles aussi marcher le commerce."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2bfd8d52-418f-4dc9-86c1-bb569d866663",
                        "source_entry_id": "a4396faf-1d77-3ccd-9b58-f29d415adbbd",
                        "source_sense_description": "суровое обличение своих поступков, слабостей",
                        "target_lang_word": "self-reproach",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "self-reproach",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "08adc760-7f03-37e3-b81b-f7f3bf2d01c0",
                                        "entry_id": "81b3c768-e7c5-39da-8964-e62a765435b5",
                                        "glosses": [
                                            "Blame or condemnation directed at the self, as by the conscience."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8de9857c-ba30-4272-ac7b-b1557667dacd",
                                                "sense_id": "08adc760-7f03-37e3-b81b-f7f3bf2d01c0",
                                                "text": "Besides the jar of contrast there came to her a chill self-reproach that she had not returned sooner, to help her mother in these domesticities, instead of indulging herself out-of-doors."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
