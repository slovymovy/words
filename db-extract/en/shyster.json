                                "target_senses": [
                                    {
                                        "sense_id": "c1771de6-14f6-3fb8-9f35-11fc4e39ceed",
                                        "entry_id": "9aac1c32-c500-3bab-97f1-9e68ce122a1b",
                                        "glosses": [
                                            "Celui qui chicane, qui aime à chicaner, principalement en affaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4eccb5b2-0a76-4f78-8101-03d6e09e510f",
                                                "sense_id": "c1771de6-14f6-3fb8-9f35-11fc4e39ceed",
                                                "text": "Et je gagne ma cause. A cela que fait-on ?\nMon chicaneur s'oppose à l'exécution."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chicaneur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3639f5e3-a674-3faa-acf7-c4f777c7b12b",
                                        "entry_id": "e0f53b3f-e269-350b-809a-d61f2447b474",
                                        "glosses": [
                                            "Qui chicane, qui aime à chicaner, principalement en affaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3d62679-c2f6-43a9-ac33-c15ee740bcd6",
                                                "sense_id": "3639f5e3-a674-3faa-acf7-c4f777c7b12b",
                                                "text": "Je ne vis jamais homme plus chicaneur."
                                            },
                                            {
                                                "example_id": "ac0c43dd-33ee-420d-8f81-deb1d8ec6781",
                                                "sense_id": "3639f5e3-a674-3faa-acf7-c4f777c7b12b",
                                                "text": "Esprit chicaneur."
                                            }
                                        ]
                                    }
