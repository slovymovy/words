                "senses": [
                    {
                        "sense_id": "b719fb16-7939-3bfd-91ca-cc0baeed379f",
                        "entry_id": "f95edbdf-798e-3cd1-a079-d11932d649de",
                        "glosses": [
                            "Tasche, die gegen Außenwärme isoliert ist, damit man darin Lebensmittel und Getränke gekühlt aufbewahren kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb0de9c5-1b3e-45ee-9274-e1d0665b84f2",
                                "sense_id": "b719fb16-7939-3bfd-91ca-cc0baeed379f",
                                "text": "Zum Picknicken nehmen wir eine Kühltasche mit, in welche die Getränke kommen."
                            },
                            {
                                "example_id": "e9586651-f278-41c0-b4a3-d9d13e2016a4",
                                "sense_id": "b719fb16-7939-3bfd-91ca-cc0baeed379f",
                                "text": "„Eine für den Kläger noch günstigere Möglichkeit wäre es, sich für diesen Zweck eine Kühltasche anzuschaffen.“"
                            },
                            {
                                "example_id": "6b7bfefd-d00a-494b-b091-759ebfdcb771",
                                "sense_id": "b719fb16-7939-3bfd-91ca-cc0baeed379f",
                                "text": "Im Sommer ist eine Kühltasche beim Einkaufen sehr hilfreich."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
