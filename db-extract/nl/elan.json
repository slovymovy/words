                    },
                    {
                        "translation_id": "bb86d8f5-b6fb-45a5-bf4e-e34e20c8bd03",
                        "source_entry_id": "0f8c5ea7-5173-338a-ac4c-3476f5ceae8a",
                        "source_sense_id": "c5c3137f-602e-37d4-88f0-b3f6875e9e2c",
                        "source_sense_description": "animo",
                        "target_lang_word": "élan",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "élan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6fc38180-bd9d-357b-b3d2-661797bf6bab",
                                        "entry_id": "4cf789d2-4196-3aa8-8831-0fc04ddf1abf",
                                        "glosses": [
                                            "Mouvement pour s’élancer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3754da6-3cef-4bd7-8082-4f926f6f2d0f",
                                                "sense_id": "6fc38180-bd9d-357b-b3d2-661797bf6bab",
                                                "text": "Il avait hâte de mettre la jeune femme à l’abri, et, d’un élan, il traversa les champs et la porta jusqu’à une grange isolée que, dès le début, il s’était proposé d’atteindre."
                                            },
                                            {
                                                "example_id": "40deb209-512c-444a-a2b7-56d79e5a61bb",
                                                "sense_id": "6fc38180-bd9d-357b-b3d2-661797bf6bab",
                                                "text": "Ce héros, la lance brandie en avant, l’oriflamme sacrée flottant au-dessus de sa tête, entra d'un élan fougueux dans la masse guerrière qui lui prêtait le flanc."
                                            },
                                            {
                                                "example_id": "7e368171-a1bc-4af0-bfd9-f7226cd1ddd2",
                                                "sense_id": "6fc38180-bd9d-357b-b3d2-661797bf6bab",
                                                "text": "Prendre son élan pour sauter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "335d296a-4be7-3fb8-a09e-06a07154f967",
                                        "entry_id": "4cf789d2-4196-3aa8-8831-0fc04ddf1abf",
                                        "glosses": [
                                            "Continuation sans dynamisme d'un mouvement déjà amorcé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f945e07c-ccb7-418d-82ac-38d9d151a381",
                                                "sense_id": "335d296a-4be7-3fb8-a09e-06a07154f967",
                                                "text": "Avec l'élan qu’avait le patineur au moment de sa chute, il ne pouvait qu’heurter violemment le rebord."
                                            },
                                            {
                                                "example_id": "bdeb985c-d552-4aee-afe2-125863cf1d2b",
                                                "sense_id": "335d296a-4be7-3fb8-a09e-06a07154f967",
                                                "text": "Beaucoup n’ont pas su s’arrêter à temps et se sont fracassés de plein élan contre le mur de la cabane."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c44b4f9-2c78-314a-aa69-6d5db44c6c17",
                                        "entry_id": "4cf789d2-4196-3aa8-8831-0fc04ddf1abf",
                                        "glosses": [
                                            "Comportement vif et dynamique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ede5ea78-e1cd-4872-a0a3-f828b0dbd011",
                                                "sense_id": "4c44b4f9-2c78-314a-aa69-6d5db44c6c17",
                                                "text": "Répondre avec élan."
                                            },
                                            {
                                                "example_id": "f5f1b74d-2e1b-4393-9fda-15cb78578a65",
                                                "sense_id": "4c44b4f9-2c78-314a-aa69-6d5db44c6c17",
                                                "text": "Ce jeune homme manque d’élan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "109cae0c-6b50-3a1f-a3bb-8d1c9bd5faef",
                                        "entry_id": "4cf789d2-4196-3aa8-8831-0fc04ddf1abf",
                                        "glosses": [
                                            "Changement subit d'attitude, sous l’influence d’un sentiment vif ou généreux."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7a94030-7179-491d-ae9e-be7d72bdee67",
                                                "sense_id": "109cae0c-6b50-3a1f-a3bb-8d1c9bd5faef",
                                                "text": "Ne désespérons cependant pas de voir un jour le parlement, dans un élan collectif de patriotisme, oser braver certaines tendances funestes, chères à une partie de l'opinion publique, et de risquer même le danger d'une impopularité passagère, pour assurer le bien du peuple malgré lui."
                                            },
                                            {
                                                "example_id": "5a4ff524-6f3b-4c32-9d56-414d24013c43",
                                                "sense_id": "109cae0c-6b50-3a1f-a3bb-8d1c9bd5faef",
                                                "text": "À bout de larmes et d’ennui, je misai d’un élan toute ma vie sur cette chance."
                                            },
                                            {
                                                "example_id": "5581eaf2-3b4d-4abf-923b-7e25462c10db",
                                                "sense_id": "109cae0c-6b50-3a1f-a3bb-8d1c9bd5faef",
                                                "text": "La révolution de Palais, qui se produisait le 13 décembre 1940 et dans laquelle Alibert s'était compromis, devait briser net l’élan réformateur du premier garde des sceaux de Vichy."
                                            },
                                            {
                                                "example_id": "38f028ae-7d0a-4e7b-b120-8e00c55ba8e2",
                                                "sense_id": "109cae0c-6b50-3a1f-a3bb-8d1c9bd5faef",
                                                "text": "L'odeur de l’ambre solaire avait curieusement un effet aphrodisiaque sur Albert qui devenait infernal. Moi, je mesurais mes élans car je détestais prendre un râteau."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "élan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "34009aed-85f2-3a99-b9bc-914defab005d",
                                        "entry_id": "caffb2f0-bd20-3429-8827-a45af35313b3",
                                        "glosses": [
                                            "Espèce de mammifère ruminant ressemblant à un grand cerf (c’est le plus grand des cervidés) avec de très grands bois plats, qu’on trouve dans les pays septentrionaux, Europe du Nord et Canada."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1795bfc-526b-4acb-b590-987b18c143fd",
                                                "sense_id": "34009aed-85f2-3a99-b9bc-914defab005d",
                                                "text": "Une corne ou un bois d’élan peut atteindre un mètre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b8d21b5-07e1-350d-8571-cd3ec778f134",
                                        "entry_id": "caffb2f0-bd20-3429-8827-a45af35313b3",
                                        "glosses": [
                                            "(Absolument) Variété européenne de cet animal, par opposition à l’orignal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "23596ad5-8ab0-3d74-aaf1-885d75b7bf6a",
                                        "entry_id": "caffb2f0-bd20-3429-8827-a45af35313b3",
                                        "glosses": [
                                            "Meuble représentant l’animal du même nom dans les armoiries. À rapprocher de biche, cerf, chevreuil et daim."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc413016-6307-4fb0-8ca4-50395a1c3f4a",
                                                "sense_id": "23596ad5-8ab0-3d74-aaf1-885d75b7bf6a",
                                                "text": "D’azur à un élan d’argent attaqué à la croupe par un faucon fondant d’or et à l’avant par un lévrier rampant du même bloquant la patte senestre de l’élan de la sienne, qui est de Jämtland en Suède → voir illustration « armoiries avec un élan »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
