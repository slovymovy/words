                                                "sense_id": "e83ba553-8286-3f66-9411-1174b381e2af",
                                                "text": "Pragnę widzieć ją oczyszczoną, taką jaką sobie wyobrażałem, dawną matronę rzymską pilnującą kolebki dziecięcia przy domowym ognisku, a nie szaloną niewiastę naszego wieku"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "6328852d-f156-37f2-8d25-c05115e0815d",
                                        "entry_id": "231eed65-ae40-32af-818f-8f2d81438510",
                                        "glosses": [
                                            "stateczna i dostojna starsza kobieta wzbudzająca szacunek"
                                        ],
                                        "tags": [
                                            "literary",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03de8eb1-69b0-4223-bebe-2d46816d0422",
                                                "sense_id": "6328852d-f156-37f2-8d25-c05115e0815d",
                                                "text": "Panią i matronę poznać w niej było łatwo, która choć niewiastą, więc na pół wolną się czuła, zachowała powagę i wiarę w moc swoją"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
