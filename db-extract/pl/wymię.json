                    {
                        "sense_id": "bdad7eb7-1c38-3b08-8013-bc4b7e356504",
                        "entry_id": "221452cf-2fb9-3ce1-af56-d4fbed4cc774",
                        "glosses": [
                            "gruczoł mlekowy niektórych ssaków, zwłaszcza hodowlanych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f864d1f3-3dbd-4f96-a576-d3e9cbbde6e9",
                                "sense_id": "bdad7eb7-1c38-3b08-8013-bc4b7e356504",
                                "text": "W lecznictwie ludowym zwierząt za pomocą naparów z glistnika leczono spuchnięte wymiona krów oraz usuwano pasożyty wewnętrzne u świń"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "a3978bcb-054f-3c6a-b52b-e56547b077dc",
                        "entry_id": "221452cf-2fb9-3ce1-af56-d4fbed4cc774",
