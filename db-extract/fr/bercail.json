        "fr-extract.jsonl": [
            {
                "entry_id": "53c19a6c-a500-3a85-8e38-db1f4059c674",
                "word": "bercail",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "19c1e767-f3c4-4e0d-b3dc-f297770bc793",
                        "entry_id": "53c19a6c-a500-3a85-8e38-db1f4059c674",
                        "tags": [
                            "plural"
                        ],
                        "form": "bercails"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f3cffcf0-3d9b-3b70-82d0-45d19d98d52a",
                        "entry_id": "53c19a6c-a500-3a85-8e38-db1f4059c674",
                        "glosses": [
                            "Bergerie."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "bcaf5646-64b9-47ee-bad1-5bf0b7c4622e",
                                "sense_id": "f3cffcf0-3d9b-3b70-82d0-45d19d98d52a",
                                "text": "Un jardin grand et riche, une maison jolie,\nUn bercail spacieux pour tes chères brebis."
                            }
                        ]
                    },
                    {
                        "sense_id": "cb831109-52a9-35a9-aeee-faab49dad563",
                        "entry_id": "53c19a6c-a500-3a85-8e38-db1f4059c674",
                        "glosses": [
                            "Troupeau de brebis, de moutons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6f99210-54d2-4915-823f-9ea4955dcee0",
                                "sense_id": "cb831109-52a9-35a9-aeee-faab49dad563",
                                "text": "Le pâtre absent par fraude !\nLe chien mort ! le loup rôde,\nEt tend ses noirs panneaux.\nAu bercail qui frissonne,\nQui veillera ? personne.\nPauvres petits agneaux !"
                            }
                        ]
                    },
                    {
                        "sense_id": "5fc040a1-94f6-34c6-81bf-6f0bde4464bd",
                        "entry_id": "53c19a6c-a500-3a85-8e38-db1f4059c674",
                        "glosses": [
                            "En allusion à la parabole du Bon Pasteur : espace de l’Église où les fidèles trouvent sûreté et paix, hors duquel ils sont égarés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9a7147f-5784-4363-933e-a00b7059707c",
                                "sense_id": "5fc040a1-94f6-34c6-81bf-6f0bde4464bd",
                                "text": "Revenir, rentrer au bercail, revenir à la pratique de la vraie religion, à une conduite pieuse dont on s’était écarté."
                            },
                            {
                                "example_id": "fb2cec85-d5cf-47a7-9b9a-e423b0c405da",
                                "sense_id": "5fc040a1-94f6-34c6-81bf-6f0bde4464bd",
                                "text": "Dieu ne défend pas les routes fleuries, quand elles servent à revenir à lui, et ce n'est pas toujours par les sentiers rudes et sublimes de la montagne, que la brebis égarée retourne au bercail."
                            },
                            {
                                "example_id": "3b4a9025-8b93-437f-af6a-e32de33e9eab",
                                "sense_id": "5fc040a1-94f6-34c6-81bf-6f0bde4464bd",
                                "text": "Hélas ! mes frères, reprit le curé, cet ancien négociant, ce Kernok, c’était aussi un agneau éloigné du bercail !"
                            }
                        ]
                    },
                    {
                        "sense_id": "4de336e6-4fe2-3a39-9d85-f2c30dce92eb",
                        "entry_id": "53c19a6c-a500-3a85-8e38-db1f4059c674",
                        "glosses": [
                            "Communauté religieuse plus ou moins nombreuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "067a4ce9-774b-4958-8b6e-d04f4b41d21d",
                                "sense_id": "4de336e6-4fe2-3a39-9d85-f2c30dce92eb",
                                "text": "Il y avait à Paris des milliers de retraites semblables, où le clergé réfractaire réunissait clandestinement de petits troupeaux de fidèles. La police des sections, bien que vigilante et soupçonneuse, fermait les yeux sur ces bercails cachés, de peur des ouailles irritées et par un reste de vénération pour les choses saintes."
                            }
                        ]
                    },
                    {
                        "sense_id": "ee707365-f142-30d8-bc8b-f29a1d0c71f0",
                        "entry_id": "53c19a6c-a500-3a85-8e38-db1f4059c674",
                        "glosses": [
                            "Maison."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "f5c83178-0a02-417c-badd-1f64dbae7599",
                                "sense_id": "ee707365-f142-30d8-bc8b-f29a1d0c71f0",
                                "text": "Mais revenons à nos amis qui, eux-mêmes, reviennent au bercail…"
                            },
                            {
                                "example_id": "d9169b74-d4d8-4d16-8eda-e4243e8f83c8",
                                "sense_id": "ee707365-f142-30d8-bc8b-f29a1d0c71f0",
                                "text": "Ainsi, après le départ de Pauline Barrat à Toulouse faute d’accès à l’élite, alors qu’elle est suivie par les Bleues, Lucie Coupé a souhaité rentrer dans son bercail agenais."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e36b9098-02cb-4ab9-9dad-1d10f7847155",
                        "source_entry_id": "53c19a6c-a500-3a85-8e38-db1f4059c674",
                        "target_lang_word": "flock",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3de4f80-0f00-39db-b544-72e6ef479288",
                                        "entry_id": "abfe545c-6033-3a14-9c0a-879bec0552f8",
                                        "glosses": [
                                            "A number of birds together in a group, such as those gathered together for the purpose of migration."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "696f7cfe-d97a-3cd6-811b-746ba5eefa91",
                                        "entry_id": "abfe545c-6033-3a14-9c0a-879bec0552f8",
                                        "glosses": [
                                            "A large number of animals associated together in a group; commonly used of sheep, but (dated) also used for goats, farmed animals, and a wide variety of animals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f04c85fe-9f41-4cc5-b4fb-c8e9df016bcb",
                                                "sense_id": "696f7cfe-d97a-3cd6-811b-746ba5eefa91",
                                                "text": "He told his father, and said it would be just suitable work for him to run about fields and woods amongst the strawberry hills after a flock of hares, and now and then lie down and take a nap on some sunny hill."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9886861e-83ab-3b28-b331-d09ce9dc5363",
                                        "entry_id": "abfe545c-6033-3a14-9c0a-879bec0552f8",
                                        "glosses": [
                                            "Those served by a particular pastor or shepherd."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3662b86-d4fe-42cd-9bdd-8dbf7fde6632",
                                                "sense_id": "9886861e-83ab-3b28-b331-d09ce9dc5363",
                                                "text": "But lapsed into so long a pause again / As half amazed, half frighted all his flock: [...]"
                                            },
                                            {
                                                "example_id": "b337c3dd-f128-48ee-ab04-0b2bd8c66eaa",
                                                "sense_id": "9886861e-83ab-3b28-b331-d09ce9dc5363",
                                                "text": "I also have other sheep that are not from this pen. I must lead them. They, too, will respond to my voice. So they will be one flock with one shepherd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50c5c6d6-f379-309c-9df0-c5bcd777a212",
                                        "entry_id": "abfe545c-6033-3a14-9c0a-879bec0552f8",
                                        "glosses": [
                                            "A large number of people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b1e1897-6b55-438c-bfc2-3528a600e706",
                                                "sense_id": "50c5c6d6-f379-309c-9df0-c5bcd777a212",
                                                "text": "The heathen […] came to Nicanor by flocks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c2f34ca-9818-3b83-a335-fbca7f8aae4e",
                                        "entry_id": "abfe545c-6033-3a14-9c0a-879bec0552f8",
                                        "glosses": [
                                            "A religious congregation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "flock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8ecd9c1-4f41-3847-af77-0e69bcb2663a",
                                        "entry_id": "47afbb38-1f2a-3061-9cf3-c47ce1519bcb",
                                        "glosses": [
                                            "To congregate in or head towards a place in large numbers."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af950ed2-2e3b-4aa7-a37c-afffaadaeea6",
                                                "sense_id": "e8ecd9c1-4f41-3847-af77-0e69bcb2663a",
                                                "text": "People flocked to the cinema to see the new film."
                                            },
                                            {
                                                "example_id": "1f77e517-a16d-49d7-8bd8-6fe071cab1e2",
                                                "sense_id": "e8ecd9c1-4f41-3847-af77-0e69bcb2663a",
                                                "text": "What place the gods for our repose assigned.\nFriends daily flock; and scarce the kindly spring\nBegan to clothe the ground"
                                            },
                                            {
                                                "example_id": "02785a65-7751-4306-bc21-b4ccc9a2ca94",
                                                "sense_id": "e8ecd9c1-4f41-3847-af77-0e69bcb2663a",
                                                "text": "Given the poor state of the line's trains and schedules, it is remarkable that people flock to use or experience it in embarrassingly large numbers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00ceef74-a2be-3a83-9d5f-87d0aa957db3",
                                        "entry_id": "47afbb38-1f2a-3061-9cf3-c47ce1519bcb",
                                        "glosses": [
                                            "To flock to; to crowd."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e75fd34a-3f14-4f19-aa37-1d7f82560c4f",
                                                "sense_id": "00ceef74-a2be-3a83-9d5f-87d0aa957db3",
                                                "text": "Good fellows, trooping, flocked me so."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "flock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c2522cb-7207-39f0-aa8d-e3e0236a86e8",
