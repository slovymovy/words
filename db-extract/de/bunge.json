                ],
                "senses": [
                    {
                        "sense_id": "af51fcee-2136-3962-9df9-19a0cd6138ff",
                        "entry_id": "c64bda7b-3210-3099-a1fe-068e3d2b357f",
                        "glosses": [
                            "kleine schlauchartige Fischreuse aus Netzwerk mit trichterförmiger Öffnung an beiden Enden"
                        ],
                        "tags": [
                            "Fischerei"
                        ],
                        "examples": [
                            {
                                "example_id": "ea2183b1-920d-4b4f-ade8-5cfe2d1a7cd6",
                                "sense_id": "af51fcee-2136-3962-9df9-19a0cd6138ff",
                                "text": "Eine Bunge eignet sich sehr gut zum Fang von Krebsen."
                            },
                            {
                                "example_id": "bf0ddb6f-fd90-45d5-b440-00d1e3cec411",
                                "sense_id": "af51fcee-2136-3962-9df9-19a0cd6138ff",
                                "text": "In den Teichen fischt man auch wohl mit Bungen und Kessern, oder kleinen beutelförmigen, am Ende einer langen Stange ausgespannten Netzen."
                            },
                            {
                                "example_id": "7c4f8291-4f3e-44cb-9a7a-51fccff36708",
                                "sense_id": "af51fcee-2136-3962-9df9-19a0cd6138ff",
                                "text": "Mit Wehmut denken noch die Alten an die frühere schöne Zeit zurück, wo mit Klebgarn und Gamen, mit Bungen und Fuken, Aalkörben und Setzangeln manch köstliches Gericht aus dem Wasser geholt und in Mutters Küche gebracht wurde."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "01fdc523-e6e0-3aa0-a1e2-3f7c85c11491",
                        "entry_id": "c64bda7b-3210-3099-a1fe-068e3d2b357f",
                        "glosses": [
                            "eine Gattung innerhalb der Familie Primelgewächse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10864201-7b23-42ed-918b-7fe53025d80f",
                                "sense_id": "01fdc523-e6e0-3aa0-a1e2-3f7c85c11491",
                                "text": "Ebenfalls auf mehreren Erdteilen kommen der Gilbweiderich Lysimachia, der Gauchheil Anagallis und die Bunge Samolus vor."
                            },
                            {
                                "example_id": "6d10176c-9682-4c8e-9343-4b4d69dc374c",
                                "sense_id": "01fdc523-e6e0-3aa0-a1e2-3f7c85c11491",
                                "text": "Bungen sind tolerant gegenüber Brack- und Salzwasser und wachsen auch am Gartenteich."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
