                    "semantic_group_id": "plissement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Quand elle ne comprend pas une consigne, elle a tendance à <w>froncer</w> les sourcils."
                        },
                        {
                            "text": "Le détective a <w>froncé</w> les sourcils en examinant les indices laissés sur la table."
