                                    {
                                        "sense_id": "897555e9-a0c0-3522-a320-c310ec09a515",
                                        "entry_id": "14c99d2c-7c24-3f71-a9b9-5c7792c5e3e7",
                                        "glosses": [
                                            "(se emplea como preposición para hacer referencia a un aspecto de algo) En relación con aquello que se menciona o de que se habla."
                                        ],
                                        "tags": [
                                            "culto"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58122f98-c849-44dd-9277-90d29a96834d",
                                                "sense_id": "897555e9-a0c0-3522-a320-c310ec09a515",
                                                "text": "Los alumnos asumirán papeles concretos por lo que respecta a las operaciones con el cargamento o demás operaciones que se estén simulando."
                                            },
                                            {
                                                "example_id": "3256ea4c-ed0a-4f80-b818-0a1d797052b1",
                                                "sense_id": "897555e9-a0c0-3522-a320-c310ec09a515",
                                                "text": "A partir de este momento, por lo que a mí respecta, Francisco tiene mi permiso para conocer el otro mundo."
                                            },
                                            {
                                                "example_id": "9b9e253e-2f94-49a6-b525-1713686e0d56",
                                                "sense_id": "897555e9-a0c0-3522-a320-c310ec09a515",
                                                "text": "Por lo que respecta a las emociones, ellas dependen de las interpretaciones y éstas de las sensaciones."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
