{
    "word_family": [
        "grendelen",
        "vergrendelen",
        "ontgrendelen",
        "vergrendeling",
        "ontgrendeling"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f81bb8dd-d631-3fe0-b6dd-290c7caee3bd",
                    "sense_definition": "Een metalen staaf of schuif die gebruikt wordt om een deur of raam af te sluiten.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sluiting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij schoof de zware <w>grendel</w> op de deur zodat niemand naar binnen kon.",
                            "target_lang_translations": {
                                "en": "He slid the heavy <w>bolt</w> on the door so that no one could get inside."
                            }
                        },
                        {
                            "text": "Deze stevige <w>grendel</w> maakt het vrijwel onmogelijk om de kluis te kraken.",
                            "target_lang_translations": {
                                "en": "This sturdy <w>latch</w> makes it virtually impossible to crack the safe."
                            }
                        }
                    ],
                    "synonyms": [
                        "schuif",
                        "deurslot"
                    ],
                    "common_phrases": [
                        "de grendel opschuiven",
                        "achter slot en grendel"
                    ],
                    "target_lang_definitions": {
                        "en": "A metal rod or slide used to lock or secure a door or window."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bolt",
                                "target_lang_sense_clarification": "sliding metal bar"
                            },
                            {
                                "target_lang_word": "latch",
                                "target_lang_sense_clarification": "fastening mechanism"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f28b17e-4e74-3f5e-beb8-37bde4934597",
                    "sense_definition": "Onderdeel van een vuurwapen waarmee de kamer wordt afgesloten voordat er geschoten kan worden.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wapenonderdeel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De soldaat trok de <w>grendel</w> van zijn geweer naar achteren om een nieuwe patroon te laden.",
                            "target_lang_translations": {
                                "en": "The soldier pulled back the <w>bolt</w> of his rifle to load a new cartridge."
                            }
                        },
                        {
                            "text": "Hij drukte de patronen in het geweer en duwde de <w>grendel</w> krachtig dicht.",
                            "target_lang_translations": {
                                "en": "He pressed the cartridges into the rifle and pushed the <w>bolt</w> shut forcefully."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de grendel sluiten"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technische term in de wapenkunde"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The part of a firearm that closes the breech of a weapon before firing."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bolt",
                                "target_lang_sense_clarification": "firearm component"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ee9c733e-3939-361f-8081-32b92c70dd6f",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>grendelen</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>grendel</w> de deur elke avond voordat ik naar bed ga.",
                            "target_lang_translations": {
                                "en": "I <w>bolt</w> the door every night before I go to bed."
                            }
                        },
                        {
                            "text": "Als ik de schuur verlaat, <w>grendel</w> ik altijd de poort.",
                            "target_lang_translations": {
                                "en": "When I leave the shed, I always <w>latch</w> the gate."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present tense of the verb 'to bolt' or 'to latch'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bolt",
                                "target_lang_sense_clarification": "to secure with a bolt"
                            },
                            {
                                "target_lang_word": "latch",
                                "target_lang_sense_clarification": "to fasten with a latch"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "050c5d15-deaf-31bf-b1d3-e7e55ac051e2",
                    "sense_definition": "Gebiedende wijs van <w>grendelen</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Grendel</w> de deur onmiddellijk zodra je binnen bent!",
                            "target_lang_translations": {
                                "en": "<w>Bolt</w> the door immediately as soon as you are inside!"
                            }
                        },
                        {
                            "text": "Snel, <w>grendel</w> die poort voordat de dieren ontsnappen.",
                            "target_lang_translations": {
                                "en": "Quick, <w>latch</w> that gate before the animals escape."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative mood of the verb 'to bolt' or 'to latch'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bolt",
                                "target_lang_sense_clarification": "command to secure"
                            },
                            {
                                "target_lang_word": "latch",
                                "target_lang_sense_clarification": "command to fasten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96850271-7bf5-3027-b412-8a75d78625c1",
                    "sense_definition": "Tweede persoon enkelvoud tegenwoordige tijd van <w>grendelen</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Grendel</w> je de achterdeur ook als je weggaat?",
                            "target_lang_translations": {
                                "en": "Do you <w>bolt</w> the back door as well when you leave?"
                            }
                        },
                        {
                            "text": "Waarom <w>grendel</w> je het raam niet tegen de tocht?",
                            "target_lang_translations": {
                                "en": "Why don't you <w>latch</w> the window against the draft?"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Second-person singular present tense of the verb 'to bolt' or 'to latch'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bolt",
                                "target_lang_sense_clarification": "to secure with a bolt"
                            },
                            {
                                "target_lang_word": "latch",
                                "target_lang_sense_clarification": "to fasten with a latch"
                            }
                        ]
                    }
                }
            ]
        }
    ]
