                    ]
                },
                {
                    "sense_id": "55d22f8b-430a-3bf1-828b-ed749d1710f6",
                    "sense_definition": "Qui est extrêmement grand ou considérable, au propre comme au figuré.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "degre_extreme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur a fait preuve d'une <w>infinie</w> patience avec ses jeunes élèves."
                        },
                        {
                            "text": "Elle a manipulé les vieux manuscrits avec des précautions <w>infinies</w>."
                        }
                    ],
                    "synonyms": [
                        "immense"
                    ],
                    "antonyms": [
                        "limité"
                    ],
                    "common_phrases": [
