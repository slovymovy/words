                                    {
                                        "sense_id": "859a84bc-747e-3251-becd-fecc19fbe7a2",
                                        "entry_id": "c3692739-1e6c-3587-a8ce-f535ff3fd586",
                                        "glosses": [
                                            "An archaic word, style, etc."
                                        ],
                                        "tags": [
