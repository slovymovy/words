                                "target_senses": [
                                    {
                                        "sense_id": "8e6155b4-fcc6-3c4d-9948-3dcbb1255476",
                                        "entry_id": "91721734-aa0f-3cd7-97f7-e5ba6c988ee4",
                                        "glosses": [
                                            "transport van brandbare stoffen van de brandstoftank naar de plaats waar ze verbrand worden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b761a86d-7727-4b82-a955-a3b6d46b6fbf",
                                                "sense_id": "8e6155b4-fcc6-3c4d-9948-3dcbb1255476",
                                                "text": "\"Het is niet moeilijk om motoren weer op te voeren\", bevestigt Mark Pecqueur, motorspecialist van de Vlaamse Hogeschool Thomas More. \"Bij oudere motoren hoef je de brandstoftoevoer maar te verhogen en er is veel meer vermogen uit zo'n motor te halen. Nieuwere motoren kunnen nog makkelijker worden gemanipuleerd: in de software.\""
                                            },
                                            {
                                                "example_id": "388c8f06-3b75-451e-9053-8343835e035f",
                                                "sense_id": "8e6155b4-fcc6-3c4d-9948-3dcbb1255476",
                                                "text": "De eerste meters in de RB14 zitten erop voor Max Verstappen. Bij de testdagen in een koud Barcelona kwam de Nederlander dinsdagochtend op de baan om te kijken hoe de nieuwe auto van Red Bull Racing presteert. Voorlopig nog zonder succes, want na één ronde bleef hij binnen vanwege problemen met de brandstoftoevoer."
                                            }
