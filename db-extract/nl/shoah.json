                        "sense_id": "ede15339-bd5b-32df-aeb5-1adfeabc3d0f",
                        "entry_id": "82ff81ab-0a0a-36bc-8114-2ee99704458c",
                        "glosses": [
                            "Holocaust, de massale vervolging van en moord op de Joden in de Tweede Wereldoorlog"
