                "translations": [
                    {
                        "translation_id": "b820aeb4-bbfa-4f2f-ada6-0aa7efddc15a",
                        "source_entry_id": "384f6943-2009-3a01-9c34-52db687ef83e",
                        "source_sense_description": "condition of being prudish; prudishness",
                        "target_lang_word": "Prüderie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Prüderie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fbcc7af8-ac3a-3127-a2a5-db3d9b13df63",
                                        "entry_id": "6b0dd66b-3054-3ec9-8063-461bff7a6ce6",
                                        "glosses": [
                                            "übertrieben schamhafte Haltung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "456525cb-b02f-42f2-bc11-f973dbce5e23",
                                                "sense_id": "fbcc7af8-ac3a-3127-a2a5-db3d9b13df63",
                                                "text": "Mein Nachbar kann der Prüderie bezichtigt werden."
                                            },
                                            {
                                                "example_id": "e6db983d-560f-46ba-97cc-3f82e8cfeca0",
                                                "sense_id": "fbcc7af8-ac3a-3127-a2a5-db3d9b13df63",
                                                "text": "„Nach Jahrhunderten der Prüderie setzte sich der gesunde Körper um 1900 zum ersten Mal dem Sonnenschein, dem Wind und den entsetzten Blicken der Bürger aus.“"
                                            },
                                            {
                                                "example_id": "9b6114f0-9d50-4ee1-b36d-55783ccf2958",
                                                "sense_id": "fbcc7af8-ac3a-3127-a2a5-db3d9b13df63",
                                                "text": "„Die Prüderie in der Arbeiterklasse ist eine andere als die im Schatten einer Klosterkirche.“"
                                            },
                                            {
                                                "example_id": "e33487b4-9de8-4a4d-9a31-8e54b69545df",
                                                "sense_id": "fbcc7af8-ac3a-3127-a2a5-db3d9b13df63",
                                                "text": "„Die Prüderie, die Gezwungenheit, die Bigotterie und die geistige Unsauberkeit, die seit der viktorianischen Ära herrschen, waren erst nötig, um die Reinheit der Freundschaften zu trüben.“"
                                            },
                                            {
                                                "example_id": "7104398a-e846-4033-bb52-b03ea8042324",
                                                "sense_id": "fbcc7af8-ac3a-3127-a2a5-db3d9b13df63",
                                                "text": "„Stets kommt ein philosophischer Bettler vor, ein griesgrämiger Burgherr, unschuldige junge Mädchen, komische Diener und endlose Dialoge, eine dumme Prüderie und völliger Mangel an Tiefe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
