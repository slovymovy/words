                "senses": [
                    {
                        "sense_id": "4ebe57fb-ac29-35ee-adc4-f47459bd887e",
                        "entry_id": "46ad17e9-ba7d-3bbc-a84c-1d1bfe49bc28",
                        "glosses": [
                            "zentral gelegener Teil einer Stadt; innerer Teil einer Stadt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acd4ea0d-4f32-431a-8196-3cee3ff5b791",
                                "sense_id": "4ebe57fb-ac29-35ee-adc4-f47459bd887e",
                                "text": "„Ich kühlte mich auf dem Balkon ab, hörte mit Kopfhörern Peter Fox und blickte seitlich über die Grünanlage hinweg, in Richtung Stadtinneres.“"
                            },
                            {
                                "example_id": "e6012415-c55c-4ea7-a783-0111584d9e75",
                                "sense_id": "4ebe57fb-ac29-35ee-adc4-f47459bd887e",
                                "text": "„Eine Durchsage ertönt und teilt uns mit, dass die letzte Straßenbahn Richtung Stadtinneres gleich losfährt.“"
                            },
                            {
                                "example_id": "d9d034f8-1c7f-44fa-b386-5333c2bce97f",
                                "sense_id": "4ebe57fb-ac29-35ee-adc4-f47459bd887e",
                                "text": "„In Richtung Stadtinneres fuhr ich zwanzig Minuten mit dem Fahrrad, kaufte dort in Supermärkten ein oder trainierte in einen Kampfsportclub.“"
                            },
                            {
                                "example_id": "8a565f78-56f2-48d5-a2f3-a8d88d4592d9",
                                "sense_id": "4ebe57fb-ac29-35ee-adc4-f47459bd887e",
                                "text": "„Seufzend strich ich mir mein nasses Haar hinters Ohr und eilte weiter Richtung Stadtinneres.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
