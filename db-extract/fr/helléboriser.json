                "senses": [
                    {
                        "sense_id": "0dfbcc74-04db-341c-86ce-86a671ed001d",
                        "entry_id": "ab9bb45a-94ab-3e9c-b043-9d85856d1ad5",
                        "glosses": [
                            "Purger avec l’hellébore."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "16c6e1fc-bd67-4b68-8fab-997f6edec2c2",
                                "sense_id": "0dfbcc74-04db-341c-86ce-86a671ed001d",
                                "text": "J’étais en effet amené, ô Démocrite, comme devant helléboriser un aliéné, et sans avoir deviné quel tu étais ;"
                            },
                            {
                                "example_id": "c6e2e613-7251-48ae-bc2a-5d03de71c2fd",
                                "sense_id": "0dfbcc74-04db-341c-86ce-86a671ed001d",
                                "text": "La pharmacopée de Paris fait son sirop de pomme helléborisé en décuisant le précédent avec une infusion d’hellébore noir, & cuisant de nouveau la liqueur en consistance de sirop, qu’elle aromatise avec le safran."
                            }
                        ]
                    }
