                                "target_lang_sense_clarification": "an Nahrungsmangel leiden"
                            },
                            {
                                "target_lang_word": "dürsten nach",
                                "target_lang_sense_clarification": "metaphorisch: ein starkes Bedürfnis nach etwas haben"
                            }
                        ]
