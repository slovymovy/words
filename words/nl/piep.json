{
    "word_family": [
        "pieper",
        "piepklein",
        "piepjong",
        "piepen",
        "pieptoon"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4a2deed6-6d54-3455-a350-36d68cd369b2",
                    "sense_definition": "een kort, hoog en scherp geluid",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rookmelder gaf plotseling een harde <w>piep</w> af.",
                            "target_lang_translations": {
                                "en": "The smoke detector suddenly emitted a loud <w>beep</w>."
                            }
                        },
                        {
                            "text": "Hij hoorde een aanhoudende <w>piep</w> in zijn oren na het concert.",
                            "target_lang_translations": {
                                "en": "He heard a persistent <w>ringing</w> in his ears after the concert."
                            }
                        }
                    ],
                    "synonyms": [
                        "pieptoon"
                    ],
                    "common_phrases": [
                        "een hoge piep",
                        "een korte piep"
                    ],
                    "target_lang_definitions": {
                        "en": "a short, high-pitched, sharp sound"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "beep",
                                "target_lang_sense_clarification": "electronic or short high sound"
                            },
                            {
                                "target_lang_word": "squeak",
                                "target_lang_sense_clarification": "short high sound made by an animal or object"
                            },
                            {
                                "target_lang_word": "peep",
                                "target_lang_sense_clarification": "soft, high-pitched sound"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9c752e88-8fec-3747-a627-49f42a2bbfc1",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>piepen</w>",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>piep</w> als ik ademhaal door mijn verkoudheid.",
                            "target_lang_translations": {
                                "en": "I <w>wheeze</w> when I breathe because of my cold."
                            }
                        },
                        {
                            "text": "Als ik deze oude deur opendoe, <w>piep</w> ik altijd zachtjes mee van schrik.",
                            "target_lang_translations": {
                                "en": "When I open this old door, I always quietly <w>squeak</w> along in fright."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoeging"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "first-person singular present tense of 'piepen' (to squeak, wheeze, or beep)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "squeak",
                                "target_lang_sense_clarification": "make a high-pitched cry or noise"
                            },
                            {
                                "target_lang_word": "wheeze",
                                "target_lang_sense_clarification": "breathe with a whistling or rattling sound"
                            },
                            {
                                "target_lang_word": "beep",
                                "target_lang_sense_clarification": "emit a high-pitched electronic sound"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dcf79ea4-381f-3318-8e63-6361ed67d70e",
                    "sense_definition": "gebiedende wijs van <w>piepen</w>",
                    "learner_level": "A2",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Piep</w> niet zo hard als de kinderen slapen!",
                            "target_lang_translations": {
                                "en": "Don't <w>squeak</w> so loudly while the children are sleeping!"
                            }
                        },
                        {
                            "text": "<w>Piep</w> even als je klaar bent met de test.",
                            "target_lang_translations": {
                                "en": "Just give a quick <w>peep</w> when you're done with the test."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoeging"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "imperative form of 'piepen'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "squeak",
                                "target_lang_sense_clarification": "imperative: make a high-pitched sound"
                            },
                            {
                                "target_lang_word": "beep",
                                "target_lang_sense_clarification": "imperative: signal with a beep"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19b7c75f-2696-3c0b-a802-934fc7285b51",
                    "sense_definition": "tweede persoon enkelvoud tegenwoordige tijd (inversie) van <w>piepen</w>",
                    "learner_level": "A2",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>piep</w> je zo als je die trap oploopt?",
                            "target_lang_translations": {
                                "en": "Why are you <w>wheezing</w> like that as you walk up those stairs?"
                            }
                        },
                        {
                            "text": "<w>Piep</w> je wanneer de wasmachine klaar is?",
                            "target_lang_translations": {
                                "en": "Will you <w>give a beep</w> when the washing machine is done?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoeging"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "second-person singular present tense (inverted) of 'piepen'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "squeak",
                                "target_lang_sense_clarification": "make a squeaking noise"
                            },
                            {
                                "target_lang_word": "wheeze",
                                "target_lang_sense_clarification": "breathe noisily"
                            },
                            {
                                "target_lang_word": "beep",
                                "target_lang_sense_clarification": "make a beeping noise"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "932c9607-1039-32f0-aa02-5cb8807171ec",
                    "sense_definition": "nabootsing van het hoge geluid van een muis of vogel",
                    "learner_level": "A1",
                    "frequency": "Middle",
                    "semantic_group_id": "klanknabootsing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "\"<w>Piep</w>!\" zei het kleine vogeltje vanuit het nest.",
                            "target_lang_translations": {
                                "en": "\"<w>Peep</w>!\" said the little bird from the nest."
                            }
                        },
                        {
                            "text": "Het muisje rende snel weg en riep nog: \"<w>piep</w>!\"",
                            "target_lang_translations": {
                                "en": "The little mouse quickly ran off and called back: \"<w>squeak</w>!\""
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "onomatopoeia imitating the high-pitched sound of a mouse or small bird"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "squeak",
                                "target_lang_sense_clarification": "sound made by a mouse"
                            },
                            {
                                "target_lang_word": "peep",
                                "target_lang_sense_clarification": "sound made by a baby bird or chick"
                            },
                            {
                                "target_lang_word": "chirp",
                                "target_lang_sense_clarification": "short high sound made by a small bird"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9377691b-3fb8-3e66-9a30-a929dcba9271",
                    "sense_definition": "nabootsing van het wegbliepen van een grof woord op televisie of radio",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "klanknabootsing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op televisie hoorde je alleen maar \"<w>piep</w>\" tijdens zijn woedeaanval.",
                            "target_lang_translations": {
                                "en": "On television you only heard \"<w>bleep</w>\" during his temper tantrum."
                            }
                        },
                        {
                            "text": "Ze vervingen elk scheldwoord in het interview door een luide <w>piep</w>.",
                            "target_lang_translations": {
                                "en": "They replaced every swear word in the interview with a loud <w>bleep</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "gebruikt als censuurgeluid"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "sound imitating the bleeping out of profanity in broadcasting"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bleep",
                                "target_lang_sense_clarification": "sound used to censor swearing"
                            },
                            {
                                "target_lang_word": "beep",
                                "target_lang_sense_clarification": "censor tone"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "aeddbbfd-f55c-3938-8170-242484c7ee62",
                    "sense_definition": "verkorting van <w>piepjong</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij was nog maar <w>piep</w> toen ze al aan de universiteit begon te studeren.",
                            "target_lang_translations": {
                                "en": "She was still <w>very young</w> when she already started studying at university."
                            }
                        },
                        {
                            "text": "Die voetballer is nog <w>piep</w>, maar hij speelt nu al bij de profs.",
                            "target_lang_translations": {
                                "en": "That football player is still <w>very young</w>, but he is already playing with the pros."
                            }
                        }
                    ],
                    "synonyms": [
                        "piepjong"
                    ],
                    "antonyms": [
                        "stokoud"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informele verkorting"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "colloquial shortening of 'piepjong' (very young)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "very young",
                                "target_lang_sense_clarification": "at a tender age"
                            },
                            {
                                "target_lang_word": "tiny",
                                "target_lang_sense_clarification": "very small and young"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}