                    {
                        "translation_id": "47659b33-883a-4fc8-9dca-0a8a7d0ae7db",
                        "source_entry_id": "39fd68d8-31f6-36f6-8adf-e02bcf1fe440",
                        "source_sense_description": "railroad employee",
                        "target_lang_word": "Bremser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bremser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1b06df13-8e79-3a41-86d3-b73ceaa8c707",
                                        "entry_id": "3d1aca0e-2f0b-3200-8555-34622f99c492",
                                        "glosses": [
                                            "Person, die Fahrzeuge bremst"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7980f020-2977-4d3c-aa68-c74c4318975c",
                                                "sense_id": "1b06df13-8e79-3a41-86d3-b73ceaa8c707",
                                                "text": "„Bremser sind Eisenbahner, die für das Bremsen von Eisenbahnzügen verantwortlich sind. Dieser Beruf wurde in Europa und bei den meisten Eisenbahnen auch außerhalb Europas durch die Einführung automatischer Bremssysteme verdrängt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ea5d54bc-eef8-3ea9-853d-167fa7fd23f0",
                                        "entry_id": "3d1aca0e-2f0b-3200-8555-34622f99c492",
                                        "glosses": [
                                            "Person, die Prozesse oder Projekte bremst und verlangsamt"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e373d3d2-2154-4363-8a11-539349cda4eb",
                                                "sense_id": "ea5d54bc-eef8-3ea9-853d-167fa7fd23f0",
                                                "text": "„Noch halten sich die Bremser angesichts des Volkszorns zurück. Eine Mehrheit hätte gemäss Umfrage eine temporäre Verstaatlichung der Credit Suisse der Schaffung einer Monsterbank vorgezogen.“"
                                            },
                                            {
                                                "example_id": "30b7e9ce-d056-49df-adbf-36b2a4c85da6",
                                                "sense_id": "ea5d54bc-eef8-3ea9-853d-167fa7fd23f0",
                                                "text": "„Und wer ernsthaft damit anfängt, wird erst mal unglaublich viel Geld, Mühe und Kraft hineinstecken müssen und keine Energie mehr übrig haben, sich nebenher gegen Nörgler und Bremser zu behaupten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e03e11ac-bf5c-3d84-9a92-e1ce40138dbb",
                                        "entry_id": "3d1aca0e-2f0b-3200-8555-34622f99c492",
                                        "glosses": [
                                            "ein Traubenmost, der begonnen hat zu gären"
                                        ],
                                        "tags": [
                                            "Getränk",
                                            "Rheinhessen",
                                            "Franken"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b86c6b4c-bd2b-4322-9d8f-f73f18f4cc06",
                                                "sense_id": "e03e11ac-bf5c-3d84-9a92-e1ce40138dbb",
                                                "text": "„Die Bremserzeit ist eine der schönsten Abschnitte des Weinjahres. Ihr Höhepunkt war früher die Bremsermusik. Der Bremser »bremst« also keineswegs, im Gegenteil. Sein Name rührt vielmehr vom Geräusch der beginnenden Gärung her.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "62288d38-1e23-3a23-bd0e-44f004b42560",
                                        "entry_id": "3d1aca0e-2f0b-3200-8555-34622f99c492",
                                        "glosses": [
                                            "letzte Person in einem Bob, deren Aufgabe das Bremsen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00888874-7e4d-4c95-9602-fa9094771199",
                                                "sense_id": "62288d38-1e23-3a23-bd0e-44f004b42560",
                                                "text": "„Gibt es die Startfreigabe, dann haben die vier Mann eine Minute Zeit, um den Bob in Bewegung zu setzen. Sobald die Startlinie überquert ist, beginnt die Zeit zu laufen. Wenn der Bob schnell genug ist, springt der Steuermann hinein und ihm folgen die beiden Anschieber und zuletzt der Bremser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
