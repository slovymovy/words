                                "target_word": "Lehnsmann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e15c7fd0-ea1e-39eb-b5b5-8e100c271b06",
                                        "entry_id": "7f3e0c78-8800-37f8-8d11-f84e4ea17435",
                                        "glosses": [
                                            "Empfänger eines Lehens vom Lehnsherren"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a80fa2b-6bdd-4f09-9fb9-090cffa6a1d1",
                                                "sense_id": "e15c7fd0-ea1e-39eb-b5b5-8e100c271b06",
                                                "text": "„Da die Dienste des Lehnsmannes insbesondere Kriegsdienste umfassten, wurde das Lehnswesen in der fränkischen Monarchie jahrhundertelang die Grundlage der Heerverfassung und der sozialen Organisation des Heiligen Römischen Reichs.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07d86c30-737b-4fef-b2e5-525742940188",
                        "source_entry_id": "1ba4786a-bc74-37a0-bd9b-e10ca871b886",
                        "source_sense_id": "6fd37670-5d81-33dc-b85c-7ae6d8450abc",
                        "target_lang_word": "vassal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vassal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7598be46-1439-3022-9f46-978f73e65650",
                                        "entry_id": "f2b98e76-51b3-372d-abc3-ead497a645c0",
                                        "glosses": [
                                            "Qui est dépendant d’un seigneur, d'un suzerain, d’un souverain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "649e5055-8489-488e-873a-1cae82691946",
                                                "sense_id": "7598be46-1439-3022-9f46-978f73e65650",
                                                "text": "Selon lui, la principauté de Cochin était tributaire, vassale du royaume de Mysore ; en conséquence aucune portion du territoire n'en pouvait être légalement aliénée, sans le consentement du souverain de ce dernier pays."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdab48b1-a35f-315c-beb4-12229f5ddb49",
                                        "entry_id": "f2b98e76-51b3-372d-abc3-ead497a645c0",
                                        "glosses": [
                                            "Qui est soumis à une puissance, subordonné, tributaire, ancillaire."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20f14814-e481-4fdb-8bd4-acc8076db76b",
                                                "sense_id": "fdab48b1-a35f-315c-beb4-12229f5ddb49",
                                                "text": "Les PMI sont vassales et banquières des grandes entreprises qui leur imposent des conditions de paiement draconiennes."
                                            },
                                            {
                                                "example_id": "7578f7f5-82de-4086-8508-e6132b0d2d54",
                                                "sense_id": "fdab48b1-a35f-315c-beb4-12229f5ddb49",
                                                "text": "À l’égard des deux autres sources de divergence, nous dirons que nous avons compris, dans l’Asie russe, tous les peuples vassaux, tributaires."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vassal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "71f10822-dd08-3448-9ab5-305bed2c7729",
                                        "entry_id": "77c43486-dd31-3f57-b9df-09f406d60361",
                                        "glosses": [
                                            "Personne liée par serment d’allégeance et d’hommage à un suzerain qui en retour lui reconnaît la propriété d’un fief."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5c9d76d-d80a-4956-91d1-2fe450d56716",
                                                "sense_id": "71f10822-dd08-3448-9ab5-305bed2c7729",
                                                "text": "Le système d’hérédité des fiefs était plus favorable au vassal qui consolidait son droit patrimonial, mais le seigneur concédant pouvait en souffrir dans le cas où le fief tombait aux mains d’un héritier mineur […]"
                                            },
                                            {
                                                "example_id": "15228970-5bb9-4b87-83ce-8843c3796d5c",
                                                "sense_id": "71f10822-dd08-3448-9ab5-305bed2c7729",
                                                "text": "Les guerriers du guîch ne sont peut-être pas beaucoup plus disciplinés que ceux de l’âsker ; mais au moins, chez eux, la discipline est remplacée par le sentiment du devoir du vassal envers son seigneur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98241a76-cb82-3726-bc22-00497a385c3d",
                                        "entry_id": "77c43486-dd31-3f57-b9df-09f406d60361",
                                        "glosses": [
                                            "Personne en soumission juridique et civile d’une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a708675-1e43-4a60-bea4-beb3cdfb5eb5",
                                                "sense_id": "98241a76-cb82-3726-bc22-00497a385c3d",
                                                "text": "Interrogez ce gentilhomme, qui a des terres et des vassaux, ou qui croit l’univers bouleversé depuis qu’il n’en a plus; il vous donnera de la propriété des idées à peu près semblables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25f92581-cce4-3b9b-b58c-b4344eb88874",
                                        "entry_id": "77c43486-dd31-3f57-b9df-09f406d60361",
                                        "glosses": [
                                            "Pays dominé par un autre pays puissant, mais ayant certaines autonomies domestiques."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
