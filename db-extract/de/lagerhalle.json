                "senses": [
                    {
                        "sense_id": "43ebb782-29b6-3f48-a03d-3bfa972f19c8",
                        "entry_id": "039379fc-8ddc-37fe-a37d-21ac3fa934ec",
                        "glosses": [
                            "großer Raum, der dazu dient, Gegenstände für eine Weile aufzubewahren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c28e751-6180-415e-b897-e48bff104f33",
                                "sense_id": "43ebb782-29b6-3f48-a03d-3bfa972f19c8",
                                "text": "„Auf der einen Seite des Fjordes lagern zwei Boote in einer Lagerhalle aus Wellblech, eingezwängt zwischen den Felsen, in der Bucht gegenüber liegt das hellgelbe Gerippe eines Zwergwals, an dem blaues Ölzeug zum Trocknen hängt.“"
                            },
                            {
                                "example_id": "59de6e18-a9bd-43ad-9514-b8c08f184ca8",
                                "sense_id": "43ebb782-29b6-3f48-a03d-3bfa972f19c8",
                                "text": "„Als sie die riesige Lagerhalle betraten, hörten sie, wie der Wind an der Wellblechfassade rüttelte und mit gespenstischem Geheul über das Dach jagte.“"
                            },
                            {
                                "example_id": "49da37ba-3752-44df-a14b-42c20f954b12",
                                "sense_id": "43ebb782-29b6-3f48-a03d-3bfa972f19c8",
                                "text": "„Sie gingen auf verschiedene Schulen, nachmittags half Sung im Laden, und Mia jobbte in der Lagerhalle einer Textilfabrik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7b9a4b7-05ee-4f46-9e11-ec1ad70a0861",
                        "source_entry_id": "039379fc-8ddc-37fe-a37d-21ac3fa934ec",
                        "source_sense_id": "43ebb782-29b6-3f48-a03d-3bfa972f19c8",
                        "source_sense_description": "großer Raum, der dazu dient, Gegenstände für eine Weile aufzubewahren",
                        "target_lang_word": "storehouse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "storehouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "23875ec0-a322-3733-8594-f49b9cac2df5",
                                        "entry_id": "89c657d2-a30b-3a6c-911e-bd18c7089e72",
                                        "glosses": [
                                            "A building for keeping goods of any kind, especially provisions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e8b172f-8a77-4723-91b7-5711a3fcef6b",
                                                "sense_id": "23875ec0-a322-3733-8594-f49b9cac2df5",
                                                "text": "Jacobsen's theory about the empty storehouse is still valid, for a myth never has one meaning only; a myth is a polyphonic fugue of many voices."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "239c81fd-2f17-312b-9b03-b4b4a5c35bf2",
                                        "entry_id": "89c657d2-a30b-3a6c-911e-bd18c7089e72",
                                        "glosses": [
                                            "A single location or resource where a large quantity of something can be found."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "475c6992-fe77-493a-9330-4ab39d06251f",
                                                "sense_id": "239c81fd-2f17-312b-9b03-b4b4a5c35bf2",
                                                "text": "This old book is a genuine storehouse of useful cooking tips."
                                            },
                                            {
                                                "example_id": "54b063ac-8075-484a-993b-536f57734f82",
                                                "sense_id": "239c81fd-2f17-312b-9b03-b4b4a5c35bf2",
                                                "text": "To most people, the huge ice sheets of Antarctica and Greenland are merely water that once was snow. To glaciologists and climatologists, they are storehouses of the Earth's former atmospheres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1beb20b2-1d08-3cab-a0fc-e7f9ff2df729",
                                        "entry_id": "89c657d2-a30b-3a6c-911e-bd18c7089e72",
                                        "glosses": [
                                            "A mass or quantity laid up."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2353dc99-ad0c-47f4-9488-cf7418cdc45e",
                                                "sense_id": "1beb20b2-1d08-3cab-a0fc-e7f9ff2df729",
                                                "text": "enrich the storehouse of his powerfull wit"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "storehouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "75cbc69f-04b0-3427-876b-962904314025",
                                        "entry_id": "f99f823b-3c9e-32f3-9d13-4e1c04edc95d",
                                        "glosses": [
