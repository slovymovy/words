                "forms": [
                    {
                        "form_id": "9546e9c2-f284-4e14-81fe-8e43b2b42b19",
                        "entry_id": "fc8bc1c8-6e5b-3fbb-9a40-bfb5984cd6f1",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more bedazzled"
                    },
                    {
                        "form_id": "0c3225f0-20c0-486d-a931-8c519c734661",
                        "entry_id": "fc8bc1c8-6e5b-3fbb-9a40-bfb5984cd6f1",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most bedazzled"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dc6d4885-11ea-3d0a-ab12-8b65a892c78b",
                        "entry_id": "fc8bc1c8-6e5b-3fbb-9a40-bfb5984cd6f1",
                        "glosses": [
                            "Covered in spangles, glitter, jewels, or similar shiny decorations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a3c5060-d75f-4ff4-be1e-c439a78d2181",
                                "sense_id": "dc6d4885-11ea-3d0a-ab12-8b65a892c78b",
                                "text": "I half expected to see an old troll draped in silk, sitting high atop a golden throne with a bedazzled chalice in either hand."
                            },
                            {
                                "example_id": "e6a71124-29c1-4ca9-b2e1-efccdc1a9e75",
                                "sense_id": "dc6d4885-11ea-3d0a-ab12-8b65a892c78b",
                                "text": "… a “DWTS”-sanctioned bedazzled microphone for her performance."
                            },
                            {
                                "example_id": "0f9ace4c-8dda-412c-87b1-7aa5c8a96ede",
                                "sense_id": "dc6d4885-11ea-3d0a-ab12-8b65a892c78b",
                                "text": "I had red cowboy boots with Swarovski crystals, and a bedazzled captain's jacket."
                            }
                        ]
                    },
                    {
                        "sense_id": "778d6098-ee3b-32f0-bace-762d3955cabe",
                        "entry_id": "fc8bc1c8-6e5b-3fbb-9a40-bfb5984cd6f1",
                        "glosses": [
                            "Experiencing dazzlement; overcome by awe and appreciation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6a63bb8-d4fb-41f6-9626-4ea1a87a9e9c",
                                "sense_id": "778d6098-ee3b-32f0-bace-762d3955cabe",
                                "text": "A diamond on his finger flashed, and drew a cheer from a bedazzled yokel at the back of the gallery."
                            },
                            {
                                "example_id": "5319ac96-6748-4991-97bd-11a2cdeccbe3",
                                "sense_id": "778d6098-ee3b-32f0-bace-762d3955cabe",
                                "text": "I forgave her future giggles and even made an internal vow not to make fun of her for turning into a bedazzled thirteen-year-old at the mention of the man's name."
                            },
                            {
                                "example_id": "ec56dfe0-6c28-404a-9e7f-e1a3a2cac663",
                                "sense_id": "778d6098-ee3b-32f0-bace-762d3955cabe",
                                "text": "She buzzed up and down on the spot and rolled her eyes in a bedazzled fashion to indicate how easy she found it."
                            },
                            {
                                "example_id": "b6e9de95-5d69-45c6-a664-f93893dbde5a",
                                "sense_id": "778d6098-ee3b-32f0-bace-762d3955cabe",
                                "text": "That was my very bedazzled by his kiss response."
                            }
                        ]
                    }
                ],
