                        "glosses": [
                            "That which does not exist."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f6eeb01-760e-41a1-8141-a256068804ef",
                                "sense_id": "0f465c8b-af24-3d92-91bd-d3ebece1c62c",
                                "text": "[Xenophanes] only accepts as truth that the ent (or existent) is, while the nonent (or non-existing) is not, the ent being \"perfect on every side, like the mass of a rounded sphere, equidistant from the centre at every point,\" continuous."
                            },
                            {
                                "example_id": "2c5e23ec-06bf-49a8-a5db-027fa9562a72",
                                "sense_id": "0f465c8b-af24-3d92-91bd-d3ebece1c62c",
                                "text": "It would seem then that the whole subject of predication was to Zeno a mystery, and that it was upon the theory of the impossibility of predication that he rested his denial of the nonent."
                            }
                        ]
                    }
