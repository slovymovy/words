                        "source_sense_id": "33c90a34-d0b0-3417-9c05-efc84df9420a",
                        "target_lang_word": "самозванец",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "самозванец",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f6b77ff1-bfd5-3230-9f30-75ad7091eb3b",
                                        "entry_id": "f8ff1224-1e8d-3198-b233-2bfe812e3b5c",
                                        "glosses": [
                                            "тот, кто выдаёт себя за другого человека, незаконно присваивая чужое имя, звание"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66313acf-64bb-41c2-9e2c-39c5f854cb2b",
                                                "sense_id": "f6b77ff1-bfd5-3230-9f30-75ad7091eb3b",
                                                "text": "Комендант, изнемогая от раны, собрал последние силы и отвечал твёрдым голосом: «Ты мне не государь, ты вор и самозванец, слышь ты!»"
                                            },
                                            {
                                                "example_id": "35627dcc-5b0c-44b1-b10b-449b1fcdcaf8",
                                                "sense_id": "f6b77ff1-bfd5-3230-9f30-75ad7091eb3b",
                                                "text": "Вам ли, с вашими высокими понятиями, снизойти до какого-то безвестного выходца, может быть самозванца-графа…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
