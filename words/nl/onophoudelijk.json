                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "constantly",
                                "target_lang_sense_clarification": "occurring continuously or persistently"
                            },
                            {
                                "target_lang_word": "ceaselessly",
                                "target_lang_sense_clarification": "without ever stopping"
                            },
                            {
                                "target_lang_word": "incessantly",
                                "target_lang_sense_clarification": "without interruption, often used for talking or rain"
                            },
                            {
                                "target_lang_word": "non-stop",
                                "target_lang_sense_clarification": "without any pauses"
                            }
                        ]
