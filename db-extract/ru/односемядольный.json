                "translations": [
                    {
                        "translation_id": "0b2b439a-ab79-403e-bc47-fbe875b7e233",
                        "source_entry_id": "dbdc301c-cd64-3118-9d97-cc3d1e144464",
                        "source_sense_id": "853f47f2-928f-3f43-a670-7874863ca983",
                        "target_lang_word": "monocotyledonous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monocotyledonous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67ebd837-31fb-3473-920d-b350b1be271e",
                                        "entry_id": "9a22cc82-08c6-36e7-9eb0-a7613fb76949",
                                        "glosses": [
                                            "Of or pertaining to a flowering plant having a seed with one embryonic leaf (a single cotyledon)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c54d47f-4cb8-4a2b-9c32-b86cac0e64d1",
                                                "sense_id": "67ebd837-31fb-3473-920d-b350b1be271e",
                                                "text": "Strange to say, the islet of Ronde, about 16 miles north of Mauritius, forms a separate biological kingdom, possessing one peculiar species of cabbage-palm, some lizards, two snakes, and relatively more monocotyledonous plants than any other region in the world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c29978f0-ce54-4187-86c2-8216932a17b3",
                        "source_entry_id": "dbdc301c-cd64-3118-9d97-cc3d1e144464",
                        "source_sense_id": "853f47f2-928f-3f43-a670-7874863ca983",
                        "target_lang_word": "monocotiledóneo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monocotiledóneo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "7636c9a0-bed5-3819-9f48-fee5093b4f29",
                                        "entry_id": "6203a2ab-7717-3c96-9ab9-c11a076cacab",
                                        "glosses": [
                                            "Se dice de una planta cuya semilla tiene un solo cotiledón (hoja primordial en su embrión)."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12df33a8-4c64-49d6-8912-4d9828865dac",
                                                "sense_id": "7636c9a0-bed5-3819-9f48-fee5093b4f29",
                                                "text": "Pero equivocar un dicotiledóneo con un monocotiledóneo es cosa que no haría un aprendiz de Botánica"
                                            },
                                            {
                                                "example_id": "07f98e95-e57a-427f-9d96-8b85298c014b",
                                                "sense_id": "7636c9a0-bed5-3819-9f48-fee5093b4f29",
                                                "text": "La orquídea es, como nos dicen el diccionario y la botánica, una planta monocotiledónea, dotada de formas y de colores raros"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
