                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16e844ba-cf9f-4c3d-877c-faf72e1f5d67",
                                "sense_id": "aeceb391-9708-3476-8463-3538724a50a8",
                                "text": "- iMac (1998): Een jaar na het succes van de Macintosh werd Jobs ontslagen door de Raad van Bestuur. Hij keerde in 1996 terug en twee jaar later kwam de iMac uit. De computer had een semitransparante behuizing met een bijpassend toetsenbord en een geheel ronde eenknopsmuis. De iMac had geen diskettestation en geen resetknop. Jobs vond beide overbodig."
                            },
                            {
                                "example_id": "116fd921-98d2-49eb-9b0d-897f829af5f8",
                                "sense_id": "aeceb391-9708-3476-8463-3538724a50a8",
                                "text": "In 2002 verkocht Sony in Japan nog 47 miljoen diskettes, maar in 2009 gingen er slechts 12 miljoen over de toonbank. Veel computerfabrikanten zijn dan ook al lang gestopt met het diskettestation in de standaarduitrusting."
                            }
                        ]
