        "ru-extract.jsonl": [
            {
                "entry_id": "e918bca3-76fc-3b63-b298-f4f10a77aed8",
                "word": "Захаров",
                "pos": "name",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f3cc7f5b-25ce-3c26-a4f9-a97cf9700e58",
                        "entry_id": "e918bca3-76fc-3b63-b298-f4f10a77aed8",
                        "glosses": [
                            "русская фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88766227-c456-4920-9669-356e96a05488",
                                "sense_id": "f3cc7f5b-25ce-3c26-a4f9-a97cf9700e58",
                                "text": "Захаров, шумно дыша, торопливо шёл по тропинке."
                            },
                            {
                                "example_id": "18ff6ee6-b2c4-468b-b422-5ff1a0f938e7",
                                "sense_id": "f3cc7f5b-25ce-3c26-a4f9-a97cf9700e58",
                                "text": "В России и СССР никогда не велось разработок и не производилось вещества с названием «Новичок». Зато такие исследования вёл Запад, заявила на брифинге официальный представитель российского министерства иностранных дел Мария Захарова. ¶ «Мы неоднократно заявляли, что ни в Советском Союзе, ни в России, в отличие от стран Запада, научно-исследовательских и конструкторских разработок под условным названием „Новичок“ никогда не осуществлялось», — цитирует Захарову «Национальная служба новостей»."
                            },
                            {
                                "example_id": "356d053f-2c40-4715-8808-5bee47071181",
                                "sense_id": "f3cc7f5b-25ce-3c26-a4f9-a97cf9700e58",
                                "text": "Один из разработчиков «Новичка» Вил Мирзаянов в эфире телеканала «Дождь» опроверг слова официального представителя МИД Марии Захаровой о том, что это отравляющее вещество никогда не разрабатывалось в СССР и России."
                            }
                        ]
                    }
                ],
