                "senses": [
                    {
                        "sense_id": "1835bf8d-3eec-3276-80e3-643c3583d49a",
                        "entry_id": "f09d155f-a034-32cb-a55c-f134fbb2cb3d",
                        "glosses": [
                            "haltbar gemachtes Gemüse, Gewürze, Konservierungsmittel und Fett, das in die Form eines Quaders gepresst wurde und in Wasser aufgelöst eine Brühe ergibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d1683b3-77e4-4ea3-8b34-40a93d171f88",
                                "sense_id": "1835bf8d-3eec-3276-80e3-643c3583d49a",
                                "text": "Wenn es schnell gehen muss, koche ich keine Brühe aus Knochen und Gemüse, sondern greife zum Brühwürfel."
                            },
                            {
                                "example_id": "29cc6ad2-c8db-48d5-b0a1-c2913514c9d6",
                                "sense_id": "1835bf8d-3eec-3276-80e3-643c3583d49a",
                                "text": "Unter Spitzenköchen ist der Brühwürfel absolut verpönt."
                            },
                            {
                                "example_id": "2c2cc20c-9613-4e0e-ac29-265239067dee",
                                "sense_id": "1835bf8d-3eec-3276-80e3-643c3583d49a",
                                "text": "„Gekörnte Brühe entspricht von der Zusammensetzung her in etwa Brühwürfeln, die Zutaten werden jedoch getrocknet und nicht verpresst, wodurch sie schneller löslich ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
