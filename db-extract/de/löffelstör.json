                                        "examples": [
                                            {
                                                "example_id": "ef1aea6d-50c0-401a-8e4c-ee874ac99a5d",
                                                "sense_id": "4596f2c9-0b7a-378d-a39e-f4f803fd0317",
                                                "text": "Caviar comes from various species of sturgeons and paddlefishes."
                                            },
