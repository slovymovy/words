                "senses": [
                    {
                        "sense_id": "bcf4c61c-f1b1-3c56-92b6-8e6d8776c78f",
                        "entry_id": "cd0b78e5-049f-3264-b747-acf8b6cbb000",
                        "glosses": [
                            "Rune, deren Schriftzug entgegen der Schriftrichtung gestaltet ist"
                        ],
                        "tags": [
                            "Germanistik",
                            "Skandinavistik"
                        ],
                        "examples": [
                            {
                                "example_id": "1989a28c-392d-4a0e-b697-8842b3b1bef2",
                                "sense_id": "bcf4c61c-f1b1-3c56-92b6-8e6d8776c78f",
                                "text": "„Nicht selten zeigen auch einzelne Runen innerhalb einer Zeile einde widerstrebende Richtung (»Wenderunen«), …“"
                            },
                            {
                                "example_id": "f5c268ab-31bb-4725-8610-df9d80bad9d9",
                                "sense_id": "bcf4c61c-f1b1-3c56-92b6-8e6d8776c78f",
                                "text": "„In den einzelnen Inschriften ist die Richtung im allgemeinen fest; doch kommen häufig sogenannte Wenderunen vor, das heißt Runen entgegen der Richtung der sonstigen Zeichen.“"
                            },
                            {
                                "example_id": "104b666b-7eca-4dc9-b159-5a1eb792d835",
                                "sense_id": "bcf4c61c-f1b1-3c56-92b6-8e6d8776c78f",
                                "text": "„Schon eine der ältesten Inschriften (…) zeigt solch eine »Wenderune«…“"
                            },
                            {
                                "example_id": "71764a33-9454-44f3-8b77-31034f83feaf",
                                "sense_id": "bcf4c61c-f1b1-3c56-92b6-8e6d8776c78f",
                                "text": "„Wenderunen heißen Runen, die gegen die Schriftrichtung verlaufen… Wenderunen treten aus den graphischen Kontext hervor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
