                        "form": "den Hauptbestandteil"
                    },
                    {
                        "form_id": "d155c5a4-63f4-4fe7-8acd-6be99e2521b9",
                        "entry_id": "e7c05afd-ddf5-3f0b-bd85-4793983dc23a",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Hauptbestandteile"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e01e9706-452c-3d7c-a1a4-4422f6bb30c8",
                        "entry_id": "e7c05afd-ddf5-3f0b-bd85-4793983dc23a",
                        "glosses": [
                            "wichtigster Teil von etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95c655f3-cc0c-4dd1-9deb-e606609e7c4d",
                                "sense_id": "e01e9706-452c-3d7c-a1a4-4422f6bb30c8",
                                "text": "„Methan ist der Hauptbestandteil von Erdgas […].“"
                            },
                            {
                                "example_id": "6a68fca0-9913-4997-aead-8d8b591763a2",
                                "sense_id": "e01e9706-452c-3d7c-a1a4-4422f6bb30c8",
                                "text": "„Hauptbestandteil von Tränen ist schlicht Wasser.“"
                            },
                            {
                                "example_id": "f7119728-b190-4310-b5c2-012521aff39f",
                                "sense_id": "e01e9706-452c-3d7c-a1a4-4422f6bb30c8",
                                "text": "Der süchtig machende Hauptbestandteil in Zigaretten ist Nikotin."
                            },
                            {
                                "example_id": "1be1e01d-844f-4be7-afda-419034dfddbb",
                                "sense_id": "e01e9706-452c-3d7c-a1a4-4422f6bb30c8",
                                "text": "„Das Element Wasserstoff ist das mit Abstand häufigste Element im Kosmos. Es ist Hauptbestandteil der Sterne.“"
                            },
                            {
                                "example_id": "57ead6ab-621b-423d-a7b3-7161e9c92a83",
                                "sense_id": "e01e9706-452c-3d7c-a1a4-4422f6bb30c8",
                                "text": "„Siliciumdioxid ist der Hauptbestandteil von Sand und gilt als unbedenkliches Rieselmittel in Nahrungsmitteln.“"
                            },
                            {
                                "example_id": "151e55d2-6d88-4882-bad0-d86b6093ec04",
                                "sense_id": "e01e9706-452c-3d7c-a1a4-4422f6bb30c8",
                                "text": "„Lithium gilt als Schlüsselrohstoff. Das Alkalimetall ist ein Hauptbestandteil von Batteriezellen und unverzichtbar in einer mutmaßlich elektro-getriebenen Zukunft.“"
                            },
                            {
                                "example_id": "5dc095d4-17a7-430d-860d-57db60ed0eab",
                                "sense_id": "e01e9706-452c-3d7c-a1a4-4422f6bb30c8",
                                "text": "„Opiate sind psychoaktive Substanzen, die aus Schlafmohn gewonnen werden. Der Milchsaft der Pflanze, der dazu verwendet wird, besteht zu drei bis 23 Prozent aus Morphin, das somit den Hauptbestandteil bildet.“"
                            },
                            {
                                "example_id": "afd75251-d8c5-4e9a-ad4d-a47032fd4ced",
                                "sense_id": "e01e9706-452c-3d7c-a1a4-4422f6bb30c8",
                                "text": "„Kaliumnitrat ist Bestandteil von Salpeter und dient unter anderem etwa als Dünger und als Konserviermittel für Fleisch. Es ist auch der Hauptbestandteil von Schießpulver, da es sich bei mehreren hundert Grad Celsius zersetzt und Sauerstoff freisetzt, der die Explosion begünstigt.“"
                            },
                            {
                                "example_id": "d51ca9fe-a0c8-4fb2-9b20-7eee7149b3c1",
                                "sense_id": "e01e9706-452c-3d7c-a1a4-4422f6bb30c8",
                                "text": "Fool-Medames wird auf zahlreiche verschiedene Arten zubereitet. Hauptbestandteil dieses Gerichts sind braune Bohnen (Saubohnen), die mindestens 24 Stunden gedünstet und dann in einer Sauce serviert werden."
                            },
                            {
                                "example_id": "2a119669-c17e-4617-a21d-abfade0278f9",
                                "sense_id": "e01e9706-452c-3d7c-a1a4-4422f6bb30c8",
                                "text": "„Welcher Nährstoff sollte im Rahmen einer ausgewogenen Ernährung den Hauptbestandteil der Nahrung ausmachen?“"
                            },
                            {
                                "example_id": "6a4a39da-c728-44f4-ae64-2ea5a940ce58",
                                "sense_id": "e01e9706-452c-3d7c-a1a4-4422f6bb30c8",
                                "text": "„Jongleure, Akrobaten, Artisten, Zauberkünstler und Tierdressuren – das sind bis heute die Hauptbestandteile eines guten und abwechslungsreichen Zirkusprogramms.“"
                            },
                            {
                                "example_id": "a4ebe2b4-8f34-4b43-ba91-3093491f921d",
                                "sense_id": "e01e9706-452c-3d7c-a1a4-4422f6bb30c8",
                                "text": "„Mit dem Ausbau will der Verkehrsverbund Luzern dem Mobilitätswachstum gerecht werden. Hauptbestandteil des Ausbaus sind zusätzliche lange Busse, wie sie bereits auf der Linie 1 im Einsatz stehen.“"
                            },
                            {
                                "example_id": "edcdcd54-f07c-467d-9b03-9de1c9e3b6f9",
                                "sense_id": "e01e9706-452c-3d7c-a1a4-4422f6bb30c8",
                                "text": "„Menschen mit sozialer Phobie fürchten sich vor öffentlicher Aufmerksamkeit. Hauptbestandteil der Therapie ist üblicherweise die Konfrontation mit Stresssituationen.“"
                            },
                            {
                                "example_id": "3aeee853-f2d0-4b02-8b68-222fa32794ef",
                                "sense_id": "e01e9706-452c-3d7c-a1a4-4422f6bb30c8",
                                "text": "„Im Fernsehzeitalter wurden Serien […] schnell zum beliebten Hauptbestandteil der Programme.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
