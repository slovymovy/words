                        "glosses": [
                            "Person, die etwas Geäußertes unangemessen genau/wörtlich nimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b632f346-b97e-4584-b82a-c708c7200245",
                                "sense_id": "864b5362-1f52-333f-b19a-8a8bd48b3da9",
                                "text": "Man muss immer genau darauf achten, was man sagt, da er wirklich ein Wortklauber ist."
                            },
                            {
                                "example_id": "736000e5-d8da-4758-8eb6-bef0e22cd1a3",
                                "sense_id": "864b5362-1f52-333f-b19a-8a8bd48b3da9",
                                "text": "„Auch war er zugleich ein kalter scholastischer Wortklauber und ein begeisterter, gottberauschter Prophet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
