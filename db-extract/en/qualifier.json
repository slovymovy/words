                    {
                        "translation_id": "ebbba786-d365-45b3-9ada-e554c720e924",
                        "source_entry_id": "bc1a4012-ee4f-32a8-ad8a-c3c68c09315f",
                        "source_sense_description": "describing or characterizing word",
                        "target_lang_word": "Beifügung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beifügung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ee57aef6-7435-3df6-b636-d61d24d34797",
                                        "entry_id": "9d84924c-9820-3f31-8c75-d2ecbe29e63d",
                                        "glosses": [
                                            "Attribut"
                                        ],
                                        "tags": [
                                            "deutscher Ausdruck für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4851ea0-ef1e-496f-93df-93099a74ed52",
                                                "sense_id": "ee57aef6-7435-3df6-b636-d61d24d34797",
                                                "text": "In „der kleine Junge“ ist „kleine“ eine Beifügung."
                                            },
                                            {
                                                "example_id": "d95d538b-af85-41aa-bd33-024b3b25a1f1",
                                                "sense_id": "ee57aef6-7435-3df6-b636-d61d24d34797",
                                                "text": "„Punkt 3 gilt auch, wenn die einem Namen vorangestellte Bezeichnung durch Beifügungen umfänglicher ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bbd278d1-ca56-3770-807b-59bdbe116d24",
                                        "entry_id": "9d84924c-9820-3f31-8c75-d2ecbe29e63d",
                                        "glosses": [
                                            "Ergebnis/Vorgang einer Handlung, die darin besteht, dass etwas einem anderen hinzugegeben wird"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd95db82-dd75-41fd-9b2f-feaf79d6b7a5",
                                                "sense_id": "bbd278d1-ca56-3770-807b-59bdbe116d24",
                                                "text": "„Kommen nur einzelne Teile einer Urkunde in Betracht, so genügt die Beifügung eines Auszugs…“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d043bf36-3aae-470c-ad08-79c165a9e45e",
                        "source_entry_id": "bc1a4012-ee4f-32a8-ad8a-c3c68c09315f",
                        "source_sense_description": "describing or characterizing word",
                        "target_lang_word": "Attribut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Attribut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e91e69c6-d523-3fca-be6a-91088c11d48a",
                                        "entry_id": "691cc224-f2e8-37ff-8b38-0d2c68bef459",
                                        "glosses": [
                                            "(weglassbare) Beifügung in einem Satzglied"
                                        ],
                                        "tags": [
                                            "Sprachwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b5d65a0-0947-4313-b525-0569f85cd94f",
                                                "sense_id": "e91e69c6-d523-3fca-be6a-91088c11d48a",
                                                "text": "Im Beispiel „der kleine Bach“ ist „kleine“ das Attribut zu „Bach“."
                                            },
                                            {
                                                "example_id": "6457f211-863f-449f-81dc-cf8256850389",
                                                "sense_id": "e91e69c6-d523-3fca-be6a-91088c11d48a",
                                                "text": "„Zur Blockbildung kommt es dann, wenn ein oder mehrere Attribute ein Satzglied ausweiten.“"
                                            },
                                            {
                                                "example_id": "efe1e6a0-fde7-43b9-84ab-6ce13b6cc11c",
                                                "sense_id": "e91e69c6-d523-3fca-be6a-91088c11d48a",
                                                "text": "„Und deshalb ist das Attribut an das Satzglied angehängt, in dem dieses Bezugsnomen steht.“"
                                            },
                                            {
                                                "example_id": "5d86857c-cfb3-48e1-9860-ab1281bce8a3",
                                                "sense_id": "e91e69c6-d523-3fca-be6a-91088c11d48a",
                                                "text": "„Die 42 Antwortoptionen bestehen aus Attributen und Substantiven, die oft mit ihren jeweiligen Antonymen auftraten, zur Auswahl aufgelistet und mit passenden Bildern ergänzt wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "86645030-204c-3b29-b901-4b00f36fc876",
                                        "entry_id": "691cc224-f2e8-37ff-8b38-0d2c68bef459",
                                        "glosses": [
                                            "Charakteristik, auffällige Eigenschaft von etwas"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f835fd82-f7a5-4b2b-b15d-160bbfefbaae",
                                                "sense_id": "86645030-204c-3b29-b901-4b00f36fc876",
                                                "text": "Der Schlüssel ist ein Attribut von Petrus, da er immer wieder in dessen Darstellungen auftaucht."
                                            },
                                            {
                                                "example_id": "07cef9fd-d6d9-4205-b04d-e54a8727bb28",
                                                "sense_id": "86645030-204c-3b29-b901-4b00f36fc876",
                                                "text": "„Seine Frau, aus modischen Attributen zusammengesetzt, wovon ihr der Bubikopf noch am natürlichsten stand, auf eine andere Art leicht als Fräulein Rahm, war gutbürgerlicher Herkunft, aber ohne Penetranz.“"
                                            },
                                            {
                                                "example_id": "4e4ba900-5d60-417b-a389-3053549cfa1c",
                                                "sense_id": "86645030-204c-3b29-b901-4b00f36fc876",
                                                "text": "„In der Literatur des Zweiten Weltkriegs wurden die Attribute des Heldenkults früherer Zeiten noch überhöht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
