                                            {
                                                "example_id": "b998d837-5894-47c8-9326-15331212b257",
                                                "sense_id": "3ac98655-5413-37c1-aeae-465165cb2c17",
                                                "text": "The cat licked its fur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "469c8487-9dfb-3692-92fb-ca84ff9c54b9",
                                        "entry_id": "01c607e7-1e74-3e7b-84a1-95467280b52d",
                                        "glosses": [
                                            "To lap; to take in with the tongue."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b02cacd1-f7aa-418f-a2ce-332673f29db2",
                                                "sense_id": "469c8487-9dfb-3692-92fb-ca84ff9c54b9",
                                                "text": "She licked the last of the honey off the spoon before washing it."
                                            },
                                            {
                                                "example_id": "ebca7308-9452-4db7-a5a6-05df706d1a12",
                                                "sense_id": "469c8487-9dfb-3692-92fb-ca84ff9c54b9",
                                                "text": "Jim closed his eyes and licked his vanilla ice cream cone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a52a8a08-5f0d-3b23-9310-f91c7e41ad33",
                                        "entry_id": "01c607e7-1e74-3e7b-84a1-95467280b52d",
                                        "glosses": [
                                            "To beat with repeated blows."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9128570-15b4-4268-816b-7abb49d97fe9",
                                                "sense_id": "a52a8a08-5f0d-3b23-9310-f91c7e41ad33",
                                                "text": "\"What a curious kind of a fool a girl is! Never been licked in school! Shucks! What's a licking! That's just like a girl -- they're so thin-skinned and chicken-hearted. […]\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1fc900d-6194-3b25-a3e2-fe1a47a5d8d5",
                                        "entry_id": "01c607e7-1e74-3e7b-84a1-95467280b52d",
                                        "glosses": [
                                            "To defeat decisively, particularly in a fight."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "798800c7-e336-42cd-b695-65b26fe19f62",
                                                "sense_id": "c1fc900d-6194-3b25-a3e2-fe1a47a5d8d5",
                                                "text": "My dad can lick your dad."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcc2e869-73e2-382f-a0bf-83bef80d7cc7",
                                        "entry_id": "01c607e7-1e74-3e7b-84a1-95467280b52d",
                                        "glosses": [
                                            "To overcome."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15126f1a-cddb-4228-8e45-f64bc9ce18d7",
                                                "sense_id": "dcc2e869-73e2-382f-a0bf-83bef80d7cc7",
                                                "text": "I think I can lick this."
                                            },
                                            {
                                                "example_id": "65430758-45fa-4a73-b302-43f11b080b60",
                                                "sense_id": "dcc2e869-73e2-382f-a0bf-83bef80d7cc7",
                                                "text": "This week, diskery and phono manufacturer spokesmen sounded tempering notes of caution as they discussed the many problems still to be licked in developing truly compatible stereo with fidelity standards equal to those now available in monaural disks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bca5ec7-5aa0-3bfb-8b74-20cb7e49e4f7",
                                        "entry_id": "01c607e7-1e74-3e7b-84a1-95467280b52d",
                                        "glosses": [
                                            "To perform cunnilingus."
                                        ],
                                        "tags": [
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fdc18c07-d23f-33ea-b17a-d0cebda6d4bd",
                                        "entry_id": "01c607e7-1e74-3e7b-84a1-95467280b52d",
                                        "glosses": [
                                            "To do anything partially."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d90aea78-0348-3307-a325-765384151cf4",
                                        "entry_id": "01c607e7-1e74-3e7b-84a1-95467280b52d",
                                        "glosses": [
                                            "To lap."
                                        ],
                                        "tags": [
                                            "of flame"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eebcb505-3aed-4006-b5da-dcfdd5da3811",
                                                "sense_id": "d90aea78-0348-3307-a325-765384151cf4",
                                                "text": "Now, in this decadent age the art of fire-making had been altogether forgotten on the earth. The red tongues that went licking up my heap of wood were an altogether new and strange thing to Weena."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10c0650c-b122-3fe3-8093-6f13486577e2",
                                        "entry_id": "5a18d28f-d888-3388-9052-2f75843d0c17",
                                        "glosses": [
                                            "The act of licking; a stroke of the tongue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "939eb5f1-7e7d-4cec-a43b-354edef7245e",
                                                "sense_id": "10c0650c-b122-3fe3-8093-6f13486577e2",
                                                "text": "The cat gave its fur a lick."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f3aae20-5a5e-33e8-858a-e18757caac91",
                                        "entry_id": "5a18d28f-d888-3388-9052-2f75843d0c17",
                                        "glosses": [
                                            "The amount of some substance obtainable with a single lick."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a661c10-d658-4d88-b53f-33c2b908214f",
                                                "sense_id": "2f3aae20-5a5e-33e8-858a-e18757caac91",
                                                "text": "Give me a lick of ice cream."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d057ba1-a0f8-35e8-9503-c4f7640afe03",
                                        "entry_id": "5a18d28f-d888-3388-9052-2f75843d0c17",
                                        "glosses": [
                                            "A quick and careless application of anything, as if by a stroke of the tongue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1c4a6e7-08b6-431c-835d-99e0020be2c6",
                                                "sense_id": "3d057ba1-a0f8-35e8-9503-c4f7640afe03",
                                                "text": "a lick of paint"
                                            },
                                            {
                                                "example_id": "4abbc69f-3ea3-403e-bd43-10dd3b984f73",
                                                "sense_id": "3d057ba1-a0f8-35e8-9503-c4f7640afe03",
                                                "text": "to put on colours with a lick of the brush"
                                            },
                                            {
                                                "example_id": "339c1978-a91a-4575-b1c9-625a5e4f3f5d",
                                                "sense_id": "3d057ba1-a0f8-35e8-9503-c4f7640afe03",
                                                "text": "When ſly Jemmy Twitcher had ſmugg'd up his face / With a lick of court white waſh,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "012bf23d-3b2c-3c05-8be3-0c083d0a9bd8",
                                        "entry_id": "5a18d28f-d888-3388-9052-2f75843d0c17",
                                        "glosses": [
                                            "A place where animals lick minerals from the ground."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "726ff2e8-8111-416a-85a2-c6fe2b8a9ba4",
                                                "sense_id": "012bf23d-3b2c-3c05-8be3-0c083d0a9bd8",
                                                "text": "The birds gathered at the clay lick."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be2b5678-40ff-33ca-8f61-9f53fa4c2c0c",
                                        "entry_id": "5a18d28f-d888-3388-9052-2f75843d0c17",
                                        "glosses": [
                                            "A small watercourse or ephemeral stream. It ranks between a rill and a stream."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b70979aa-a8b6-41d4-96a1-a0a994878081",
                                                "sense_id": "be2b5678-40ff-33ca-8f61-9f53fa4c2c0c",
                                                "text": "We used to play in the lick."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d126cda-0ac2-3e09-89c5-98550b24dbde",
                                        "entry_id": "5a18d28f-d888-3388-9052-2f75843d0c17",
                                        "glosses": [
                                            "A stroke or blow."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae869f25-2810-4259-99dc-e691c179523d",
                                                "sense_id": "9d126cda-0ac2-3e09-89c5-98550b24dbde",
                                                "text": "Hit that wedge a good lick with the sledgehammer."
                                            },
                                            {
                                                "example_id": "dfec7cd1-4938-4098-9c1d-433997e4cdd6",
                                                "sense_id": "9d126cda-0ac2-3e09-89c5-98550b24dbde",
                                                "text": "I went in big licks, and, although it was a good-sized pile, I chopped it all up before he got back at night."
                                            },
                                            {
                                                "example_id": "315836c5-39c5-4fdb-8843-0c5e28beb9e6",
                                                "sense_id": "9d126cda-0ac2-3e09-89c5-98550b24dbde",
                                                "text": "Who gave you your worst licks and why?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfa2731a-9c37-3212-b7c2-f6212fe8cd4c",
                                        "entry_id": "5a18d28f-d888-3388-9052-2f75843d0c17",
                                        "glosses": [
                                            "A small amount; a whit."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "351dfd61-9400-4677-9c98-ec4ed1e95721",
                                                "sense_id": "cfa2731a-9c37-3212-b7c2-f6212fe8cd4c",
                                                "text": "You don't have a lick of sense."
                                            },
                                            {
                                                "example_id": "7bb1ffd2-46e7-406e-9eca-9699880166b6",
                                                "sense_id": "cfa2731a-9c37-3212-b7c2-f6212fe8cd4c",
                                                "text": "I didn't do a lick of work today."
                                            },
                                            {
                                                "example_id": "19646d77-dde0-4e90-8d28-e3d05eee25f2",
                                                "sense_id": "cfa2731a-9c37-3212-b7c2-f6212fe8cd4c",
                                                "text": "Allen Gregory DeLongpre: Why don't I call Jean-Michel at Il Portofino? We'll get a table outside? Ooh, I'm not getting a lick of service. Babe, can I hop on your landline?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba55f6d6-396e-34fe-b58f-02060b6fb848",
                                        "entry_id": "5a18d28f-d888-3388-9052-2f75843d0c17",
                                        "glosses": [
                                            "An attempt at something."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ecc2d9b-c8f4-4b9d-bdb2-c3211149f57c",
                                                "sense_id": "ba55f6d6-396e-34fe-b58f-02060b6fb848",
                                                "text": "Well, my album did well, but \"Ruby\" was a timely song and that wasn't the time for it to step out. […] Then Waylon Jennings took a lick at it on an album, and my old buddy Roger Miller covered it, too, in his album. And although they're outstanding artists, nothing much happened with the song."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db172d77-11a1-3723-9e42-0b60606e91ef",
                                        "entry_id": "5a18d28f-d888-3388-9052-2f75843d0c17",
                                        "glosses": [
                                            "A short motif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5562f01-7aa0-449a-900a-12260f98d54a",
                                                "sense_id": "db172d77-11a1-3723-9e42-0b60606e91ef",
                                                "text": "There are some really good blues licks in this solo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be804552-aebc-3012-9398-9b3e2979bdb0",
                                        "entry_id": "5a18d28f-d888-3388-9052-2f75843d0c17",
                                        "glosses": [
                                            "A rate of speed. (Always qualified by good, fair, or a similar adjective.)"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93650995-2757-4ccc-8f9f-a88049c76f7e",
                                                "sense_id": "be804552-aebc-3012-9398-9b3e2979bdb0",
                                                "text": "The bus was travelling at a good lick when it swerved and left the road."
                                            },
                                            {
                                                "example_id": "5b2ab3da-5d9b-49b4-8c17-c922447ce6da",
                                                "sense_id": "be804552-aebc-3012-9398-9b3e2979bdb0",
                                                "text": "Dandy Marx, a perfect gentleman in the true sense of the word, now drives forth under single harness ; whereas “once upon a time,” he rushed over the ground at a “big lick,” reigning his four beautiful roans, and continually kicking up an extra excitement among the “fashionables.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d3d9c5d-5fc5-3dd9-823c-9490daaefe2a",
                                        "entry_id": "5a18d28f-d888-3388-9052-2f75843d0c17",
                                        "glosses": [
                                            "An act of cunnilingus."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e2d6265-d407-4e14-863f-34361ff2ed8e",
                                                "sense_id": "1d3d9c5d-5fc5-3dd9-823c-9490daaefe2a",
                                                "text": "You up for a lick tonight?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00db7f16-1db5-3dc5-8596-9163c573a480",
                                        "entry_id": "6a1e0865-0273-3788-a729-7c0e1f70434f",
                                        "glosses": [
                                            "An instance or opportunity to earn money fast, usually by illegal means, thus a heist, drug deal etc. or its victim; mostly used in phrasal verbs: hit a lick, hit licks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3c44747-482c-4423-a82f-e24b04b3766a",
                                                "sense_id": "00db7f16-1db5-3dc5-8596-9163c573a480",
                                                "text": "Bitch, pig, pull out with the stick / everything I hit like a lick / We don’t miss"
                                            },
                                            {
                                                "example_id": "ec09e2de-aeca-46c1-995d-256c7b73b438",
                                                "sense_id": "00db7f16-1db5-3dc5-8596-9163c573a480",
                                                "text": "You see a lick and you rob him / I see a lick then I stop on the block and I pause him"
                                            },
                                            {
                                                "example_id": "e0bf582a-0b25-4c58-b9b1-69920e65a31d",
                                                "sense_id": "00db7f16-1db5-3dc5-8596-9163c573a480",
                                                "text": "JAEKAE: Free all my G’s, they got locked for licks. Five minutes of fame and I’m hittin’ for six. Past seven, eight, nine, and you’re in my bits."
                                            },
                                            {
                                                "example_id": "68eb9c6f-ded7-464e-8c66-fdeb3c357c2a",
                                                "sense_id": "00db7f16-1db5-3dc5-8596-9163c573a480",
                                                "text": "Remember on my first lick, got lost in a house / Had to dip, bro, quick, before the dogs came out"
                                            },
                                            {
                                                "example_id": "ec203c02-6479-4258-b8ca-763757985bbc",
                                                "sense_id": "00db7f16-1db5-3dc5-8596-9163c573a480",
                                                "text": "Is it really necessary how I live the way I do it\nI live for the lick – you see me breathing, I just proved it"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
