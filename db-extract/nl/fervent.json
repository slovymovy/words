                                "sense_id": "44a115a4-3320-3402-a093-7a3f6fbefe46",
                                "text": "Hij is een fervent persoon in dat soort dingen."
                            },
                            {
                                "example_id": "89cb7a97-c827-4d08-8b0c-e8360cbeb738",
                                "sense_id": "44a115a4-3320-3402-a093-7a3f6fbefe46",
                                "text": "De Holtense tekenaar, etser en schilder Kees Stoop treedt niet graag op de voorgrond. De fervente kunstenaar is groot geworden, maar toch altijd klein gebleven."
                            }
                        ]
                    }
