                "senses": [
                    {
                        "sense_id": "13596a98-ef25-3f9a-a069-b94776a1cbd0",
                        "entry_id": "b00433f6-2a43-323b-affd-f6a9e7dc73ae",
                        "glosses": [
                            "Imaginer une fiction pour faire passer un message sur la réalité, donner un caractère de fiction à quelque chose de réel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48e8ce46-3b4c-4e5b-bb61-4cfe98c4c6dd",
                                "sense_id": "13596a98-ef25-3f9a-a069-b94776a1cbd0",
                                "text": "Je fictionne sur le combat de la vie et de la mort, je témoigne bien (sinon « en bien ») de l’humanité, je ne « divertis » pas, je renvoie à l’essentiel en racontant une histoire qui peut passionner parce qu’elle concerne tout et tous, sous les déguisements symboliques qui peuvent donner l’idée d’un « genre littéraire »."
                            },
                            {
                                "example_id": "b8b1c682-ae4f-4f66-a0d3-20f768212cc3",
                                "sense_id": "13596a98-ef25-3f9a-a069-b94776a1cbd0",
                                "text": "Est le deuxième volet d'un projet intitulé « Les Chambres » et comportant plusieurs autres portraits fictionnés."
                            }
                        ]
                    }
                ],
