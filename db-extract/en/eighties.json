            {
                "entry_id": "8a34963e-7457-370e-9fdb-0268d9c15cb3",
                "word": "eighties",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "89f3f4cb-0396-3147-84c0-a82afb22261b",
                        "entry_id": "8a34963e-7457-370e-9fdb-0268d9c15cb3",
                        "glosses": [
                            "The decade of the 1880s, 1980s, etc."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "cd0fb6aa-ebd9-4dd3-883b-ba4f310346a0",
                                "sense_id": "89f3f4cb-0396-3147-84c0-a82afb22261b",
                                "text": "Only kids born in the eighties remember this song!"
                            },
                            {
                                "example_id": "a6711c0c-9cd2-43fe-abbd-22ea6de824a1",
                                "sense_id": "89f3f4cb-0396-3147-84c0-a82afb22261b",
                                "text": "Our readers — and contributors — are apt to elect a good deal according to years. The seventies and eighties, we may suppose, are concerned for the large educational and cultural interests of their Alma Mater; the nineties are deep in the practical and business activities; the noughties are not naughty, but still young enough to sport a fantastic costume at reunion and let the college wag as it will; the oneties are the really wise as to what the college ought to be, especially on its athletic side, but as contributors modest."
                            },
                            {
                                "example_id": "e0115f18-99bc-40b8-93ca-b6e97044ed2e",
                                "sense_id": "89f3f4cb-0396-3147-84c0-a82afb22261b",
                                "text": "1919, Harry Hamilton Johnston, The Gay-Dombeys: A Novel, Macmillan, page 172,\nHe and his clever staff of minor blackguards exploited to the full every weakness and caries in the London Society of the 'eighties, 'nineties, and 'oughts."
                            }
                        ]
                    },
                    {
                        "sense_id": "3470b9b1-aec5-3ee1-8ef9-6cfcdada4a6f",
                        "entry_id": "8a34963e-7457-370e-9fdb-0268d9c15cb3",
                        "glosses": [
                            "The decade of one's life from age 80 through age 89."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "f33312a2-f871-4f23-be46-af28c65f4bc3",
                                "sense_id": "3470b9b1-aec5-3ee1-8ef9-6cfcdada4a6f",
                                "text": "Only folks in their eighties remember this song!"
                            }
                        ]
                    },
                    {
                        "sense_id": "7d61d662-e8a5-3511-bd1e-06413641f7fd",
                        "entry_id": "8a34963e-7457-370e-9fdb-0268d9c15cb3",
                        "glosses": [
                            "The range between 80 and 89."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "0b504ba1-3c8f-4043-9874-914ff2303e19",
                                "sense_id": "7d61d662-e8a5-3511-bd1e-06413641f7fd",
                                "text": "No wonder I'm sweating, it's in the eighties!"
                            }
                        ]
                    }
