                        "glosses": [
                            "von der Seite des Vaters her, aus der Familie des Vaters"
                        ],
                        "tags": [
                            "in Bezug auf Verwandtschaftsverhältnisse"
                        ],
                        "examples": [
                            {
                                "example_id": "2fe1ffd4-26a2-4380-99e0-8096635db94e",
                                "sense_id": "baa8a602-9de9-3d65-8848-d7c17572281e",
                                "text": "Meine Verwandten väterlicherseits sind allesamt Nichtsnutze."
                            },
                            {
                                "example_id": "9b263947-78a7-44e3-a26c-2cd29c499714",
                                "sense_id": "baa8a602-9de9-3d65-8848-d7c17572281e",
                                "text": "Ihre Großmutter väterlicherseits stammte aus Indien."
                            },
                            {
                                "example_id": "7a09b3b1-c9c1-427c-8e94-14a51f00520e",
                                "sense_id": "baa8a602-9de9-3d65-8848-d7c17572281e",
                                "text": "„Die Familie väterlicherseits war jüdisch geprägt, zur Familie mütterlicherseits gehörten Wehrmachtsoffiziere.“"
                            },
                            {
                                "example_id": "a452590b-cb25-4546-83b7-6085d0ba8365",
                                "sense_id": "baa8a602-9de9-3d65-8848-d7c17572281e",
                                "text": "„Babur, der Begründer der Moguldynastie, stammte tatsächlich väterlicherseits direkt von Timur Leng und mütterlicherseits von Dschingis Khan ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
