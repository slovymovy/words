                "senses": [
                    {
                        "sense_id": "4624559d-f87b-3992-8e1e-82ca3360ef9d",
                        "entry_id": "d48403ee-382f-35d9-95b0-55edff591476",
                        "glosses": [
                            "Donner un caractère agraire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bc856f2-5839-4ead-87ad-4dc4faaae703",
                                "sense_id": "4624559d-f87b-3992-8e1e-82ca3360ef9d",
                                "text": "Son intérêt, comme celui de tous les producteurs du Nord, était de rendre un marché déjà dépendant entièrement tributaire de leur production, c’est-à- dire de l’« agrariser »."
                            },
                            {
                                "example_id": "3d316180-f74d-4daf-8b17-badfb9045c30",
                                "sense_id": "4624559d-f87b-3992-8e1e-82ca3360ef9d",
                                "text": "La bourgeoisie s’efforce « d’agrariser » le monde, de relever l’agriculture au détriment de l’industrie afin d’empêcher la révolution sociale."
                            }
                        ]
                    }
                ],
