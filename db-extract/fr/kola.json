                ],
                "senses": [
                    {
                        "sense_id": "f7fed037-7fbc-34a6-b429-58efba9be46e",
                        "entry_id": "41a8e6cb-6a0c-3298-813c-ae1af5388060",
                        "glosses": [
                            "Plante de la famille des Malvacées, originaire d’Afrique tropicale, dont la noix est employée comme tonifiant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0f2651e-df59-4334-ad0f-f24b73b64be2",
                                "sense_id": "f7fed037-7fbc-34a6-b429-58efba9be46e",
                                "text": "Des clients, je n’en avais guère vu venir encore à la factorie, des badauds noirs seulement, d’interminables gesticuleurs et mâcheurs de kola, érotiques et paludéens."
                            },
                            {
                                "example_id": "eb3b5222-e248-4e6a-aa59-84b2c6813418",
                                "sense_id": "f7fed037-7fbc-34a6-b429-58efba9be46e",
                                "text": "« Un fameux verre de vin de kola pour le ministère, » fut-il dit par un député. Le reconstituant venait à point. Le cabinet était malade, fort malade."
                            },
                            {
                                "example_id": "565eaee9-a2d3-4263-b2db-80b1b845557d",
                                "sense_id": "f7fed037-7fbc-34a6-b429-58efba9be46e",
                                "text": "Le Vino-Kolafra est quant à lui constitué d’extrait de noix de kola dilué dans du vin de Marsala."
                            }
                        ]
                    }
                ],
