                "senses": [
                    {
                        "sense_id": "89b35bc1-1a47-3998-9e67-62a6505c4917",
                        "entry_id": "cba7822c-e402-3105-b7c5-7dda10b43a2b",
                        "glosses": [
                            "Vertreter aus der Familie der Hasen (Leporidae)"
                        ],
                        "tags": [
                            "familiär",
                            "jocular"
                        ],
                        "examples": [
                            {
                                "example_id": "173adcc5-ac6e-4564-a4bc-49040c8d45da",
                                "sense_id": "89b35bc1-1a47-3998-9e67-62a6505c4917",
                                "text": "„Die Kaninchen ‚landeten‘ in Australien, als im Jahr 1859 der Engländer Thomas Austin 24 der Mümmelmänner mit auf den Kontinent brachte.“"
                            },
                            {
                                "example_id": "0e2f757b-be49-4fee-8002-506968fc3bbb",
                                "sense_id": "89b35bc1-1a47-3998-9e67-62a6505c4917",
                                "text": "„Die Hasenjagd beginnt im Oktober, zu einem Zeitpunkt also, an dem die Mümmelmänner gerade den ‚Ernteschock‘ überwunden haben: Bei günstiger Witterung räumen die Bauern die Felder innerhalb kurzer Zeit ab.“"
                            },
                            {
                                "example_id": "dbb6486a-f454-4607-912b-41b02d0e11e2",
                                "sense_id": "89b35bc1-1a47-3998-9e67-62a6505c4917",
                                "text": "„Ansonsten hat es der Osterhase nicht weit gebracht: In Russland und Italien kennt ihn keiner. Auch den Sprung über den Kanal nach England hat der hoppelnde Mümmelmann nicht geschafft.“"
                            },
                            {
                                "example_id": "7dd62d1c-0c7a-4295-8753-10bd0c82b759",
                                "sense_id": "89b35bc1-1a47-3998-9e67-62a6505c4917",
                                "text": "„Schon den alten Griechen und später den Römern galt der zeugungsfreudige Mümmelmann als Symbol der Fruchtbarkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
