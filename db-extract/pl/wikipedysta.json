                                                "example_id": "36836b99-ce99-47bd-bd7c-535b9125f2a6",
                                                "sense_id": "4f99df0c-b038-3db3-acf7-5274fc592284",
                                                "text": "Википедист всегда знает, что, как бы хорошо ни была написана статья, ее можно написать еще лучше."
                                            }
                                        ]
                                    }
                                ]
