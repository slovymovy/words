{
    "word_family": [
        "clapper",
        "clapping"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7e9ddfba-f5fb-3a3e-9a7d-19dcd5a0ce4f",
                    "sense_definition": "The act of striking the palms of the hands together.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "hand_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He summoned the waiter with a <w>clap</w>.",
                            "target_lang_translations": {
                                "ru": "Он подозвал официанта <w>хлопком</w>."
                            }
                        },
                        {
                            "text": "The audience gave a loud <w>clap</w> after the performance.",
                            "target_lang_translations": {
                                "ru": "После выступления зрители разразились громким <w>хлопком</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "a loud clap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие, при котором ладони ударяются друг о друга."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хлопо́к",
                                "target_lang_sense_clarification": "короткий звук удара ладоней"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7dd007b0-fae7-360c-9cd9-fa3261970ab8",
                    "sense_definition": "The explosive sound of thunder.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sudden <w>clap</w> of thunder shook the windows.",
                            "target_lang_translations": {
                                "ru": "Внезапный <w>раскат грома</w> сотряс окна."
                            }
                        },
                        {
                            "text": "We heard a distant <w>clap</w> before the rain started.",
                            "target_lang_translations": {
                                "ru": "Перед началом дождя мы услышали отдаленный <w>раскат грома</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "thunderclap"
                    ],
                    "common_phrases": [
                        "clap of thunder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Взрывной звук грома."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раска́т гро́ма",
                                "target_lang_sense_clarification": "звук грома"
                            },
                            {
                                "target_lang_word": "у́дар гро́ма",
                                "target_lang_sense_clarification": "резкий звук грома"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb4c8991-3183-38d2-b97c-8ab15a91f8c6",
                    "sense_definition": "A friendly slap with the hand.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "hand_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave his friend a <w>clap</w> on the shoulder.",
                            "target_lang_translations": {
                                "ru": "Он дружески <w>похлопал</w> друга по плечу."
                            }
                        },
                        {
                            "text": "A firm <w>clap</w> on the back showed his support.",
                            "target_lang_translations": {
                                "ru": "Крепкое <w>похлопывание</w> по спине выражало его поддержку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "clap on the back"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дружеский удар рукой по спине или плечу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "похло́пывание",
                                "target_lang_sense_clarification": "дружеский жест"
                            },
                            {
                                "target_lang_word": "шлепо́к",
                                "target_lang_sense_clarification": "легкий удар рукой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af9b7f44-3592-3ed0-8dd0-fd099f6dcaf4",
                    "sense_definition": "A common term for the sexually transmitted infection gonorrhea.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "disease",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gonorrhea is sometimes informally called the <w>clap</w>.",
                            "target_lang_translations": {
                                "ru": "Гонорею иногда неофициально называют «<w>триппером</w>»."
                            }
                        },
                        {
                            "text": "He was worried he might have caught the <w>clap</w>.",
                            "target_lang_translations": {
                                "ru": "Он беспокоился, что мог подхватить <w>триппер</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal and often considered vulgar."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разговорное название венерического заболевания гонореи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гоноре́я",
                                "target_lang_sense_clarification": "медицинский термин"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "71070788-cd00-3955-adbe-405593aa0b5e",
                    "sense_definition": "To strike the palms of the hands together to make a sound.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "hand_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children began to <w>clap</w> in time with the music.",
                            "target_lang_translations": {
                                "ru": "Дети начали <w>хлопать</w> в такт музыке."
                            }
                        },
                        {
                            "text": "Please <w>clap</w> your hands to the rhythm.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>хлопайте</w> в ладоши в ритм."
                            }
                        }
                    ],
                    "common_phrases": [
                        "clap hands"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ударять ладонями друг о друга, чтобы издать звук."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хло́пать",
                                "target_lang_sense_clarification": "производить звук ударами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bde94469-36c0-3664-8c31-24c9ddb3fab6",
                    "sense_definition": "To show approval by striking the hands together.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "hand_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The audience started to <w>clap</w> at the end of the show.",
                            "target_lang_translations": {
                                "ru": "В конце шоу зрители начали <w>аплодировать</w>."
                            }
                        },
                        {
                            "text": "Everyone stood up to <w>clap</w> for the performers.",
                            "target_lang_translations": {
                                "ru": "Все встали, чтобы <w>аплодировать</w> артистам."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражать одобрение ударами ладоней друг о друга."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аплоди́ровать",
                                "target_lang_sense_clarification": "выражать одобрение"
                            },
                            {
                                "target_lang_word": "хло́пать",
                                "target_lang_sense_clarification": "разговорный вариант аплодисментов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5225a67-1950-3e98-a237-ecf8725ea058",
                    "sense_definition": "To slap someone lightly on the back or shoulder in a friendly way.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hand_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He would often <w>clap</w> his teammates on the back for encouragement.",
                            "target_lang_translations": {
                                "ru": "Он часто <w>похлопывал</w> товарищей по команде по спине для поддержки."
                            }
                        },
                        {
                            "text": "She <w>clap</w>ped him on the shoulder to say goodbye.",
                            "target_lang_translations": {
                                "ru": "Она <w>похлопала</w> его по плечу, прощаясь."
                            }
                        }
                    ],
                    "common_phrases": [
                        "clap on the back"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слегка ударить кого-то по спине или плечу в дружеской манере."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "похло́пать",
                                "target_lang_sense_clarification": "дружеский жест"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e10a007c-3f76-31c7-ac98-5337b0a9af1b",
                    "sense_definition": "To move or place something forcefully so that it makes a sharp sound.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>clap</w>ped the book shut after reading the last page.",
                            "target_lang_translations": {
                                "ru": "Она <w>хлопнула</w> книгой, закрыв её после прочтения последней страницы."
                            }
                        },
                        {
                            "text": "He <w>clap</w>ped the glass down on the table.",
                            "target_lang_translations": {
                                "ru": "Он с силой <w>хлопнул</w> стаканом по столу."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигать или помещать что-то с силой, создавая резкий звук."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хло́пнуть",
                                "target_lang_sense_clarification": "резко закрыть или ударить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "427fd613-34a6-3ec3-9d8c-e23a4a42f5a7",
                    "sense_definition": "To put someone or something somewhere quickly or suddenly.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police <w>clap</w>ped the thief in jail immediately.",
                            "target_lang_translations": {
                                "ru": "Полиция немедленно <w>засадила</w> вора в тюрьму."
                            }
                        },
                        {
                            "text": "She was the prettiest thing I had ever <w>clap</w>ped eyes on.",
                            "target_lang_translations": {
                                "ru": "Она была самой красивой из всех, на кого я когда-либо <w>бросал взгляд</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро или внезапно поместить кого-то или что-то куда-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "засади́ть",
                                "target_lang_sense_clarification": "поместить в тюрьму"
                            },
                            {
                                "target_lang_word": "бро́сить",
                                "target_lang_sense_clarification": "поместить куда-то быстро"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}