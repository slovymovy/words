                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0348fdf1-b67d-4533-bf7a-cb46b38cc509",
                                                "sense_id": "b33bceb1-c3d6-3317-9421-cdb14678251f",
                                                "text": "„‚[…] Ein Mensch, der bestimmt war, in den Boudoirs der Tänzerinnen herumzulungern und seine Zeit mit der Anschauung der schönen Rosalinde verbringt…‘“"
                                            }
                                        ],
