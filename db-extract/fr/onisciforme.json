                        "examples": [
                            {
                                "example_id": "365eff80-48a7-429e-beb1-1fbbe46e6863",
                                "sense_id": "270cfb4b-fdf4-31a6-b728-8441bf5b5de2",
                                "text": "ONISCIFORME, adject., onisciformis (oniscus, cloporte, forma, forme). Kirby donne cette épithète aux larves herbivores, polypodes, antennifères, dont le corps court, oblong, déprimé et bordé, ressemble un peu à celui des cloportes. Ex. Quelques Tenthredo."
                            },
                            {
                                "example_id": "d25509ed-d0f4-4b4c-832a-1e55e94138cb",
                                "sense_id": "270cfb4b-fdf4-31a6-b728-8441bf5b5de2",
                                "text": "Je ne sais si les entomologistes qui ont acquis la collection de M. Serville ont eu à leur disposition cette curieuse espèce tout à fait onisciforme, dont ce savant du reste n'a jamais connu qu'un seul individu."
                            }
                        ]
                    }
