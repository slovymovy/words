                ],
                "senses": [
                    {
                        "sense_id": "7b32e731-9b2d-3dad-a124-bdf96f8867c1",
                        "entry_id": "ddc08088-3730-3340-a794-1d679ae36ed0",
                        "glosses": [
                            "Großregion Asiens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41001447-940f-4581-8823-79425321693a",
                                "sense_id": "7b32e731-9b2d-3dad-a124-bdf96f8867c1",
                                "text": "„Der in Europa und Westasien heimische Gewürz-Kümmel (Carum carvi) ist ein 2jähriges, bis 60 cm hohes, aromatisch duftendes Kraut mit doppelfiederteiligen Blättern, kleinen, meist weißen Blüten in zusammengesetzten Dolden und 3–6 mm langen, charakteristisch duftenden Früchten, deren etherisches Öl zu etwa 60% aus Carvon sowie Limonen, Carveol und Dihydrocarvon besteht.“"
                            },
                            {
                                "example_id": "eaab54da-84c6-4edd-a4eb-01be21908ca4",
                                "sense_id": "7b32e731-9b2d-3dad-a124-bdf96f8867c1",
                                "text": "„Auch später noch, als indische Herrscher sich auf die Kavalleriestrategie einstellten, hatten sie stets große Verluste zu verbuchen und mussten Pferde zu hohen Preisen aus Westasien importieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
