                ],
                "senses": [
                    {
                        "sense_id": "bd4faa40-4acb-3813-994e-278dbe76a181",
                        "entry_id": "f1880dd1-d88d-396f-b504-663772b10a1c",
                        "glosses": [
                            "wieś lub osada wiejska"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "eb1ace6f-3355-4c21-80e7-882b6469add3",
                                "sense_id": "bd4faa40-4acb-3813-994e-278dbe76a181",
                                "text": "Jak druciarz zarabiać może włócząc się od sioła do sioła."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b337842e-6efd-4c3e-8f88-c59c9d3e470d",
                        "source_entry_id": "f1880dd1-d88d-396f-b504-663772b10a1c",
                        "source_sense_id": "bd4faa40-4acb-3813-994e-278dbe76a181",
                        "target_lang_word": "село",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "село",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3a0b758d-4627-3e93-b565-e10eb1d9b632",
                                        "entry_id": "750bf3f8-dbdc-33f1-92b6-b503a7605b52",
                                        "glosses": [
                                            "большой крестьянский или ремесленный населённый пункт (в России традиционно с православным храмом)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea83ddcf-39c0-4215-a997-4d81d2e7b6a4",
                                                "sense_id": "3a0b758d-4627-3e93-b565-e10eb1d9b632",
                                                "text": "Юрий, выскакав на дорогу, ведущую в село Палицыно, приостановил усталую лошадь и поехал рысью."
                                            },
                                            {
                                                "example_id": "b2d2fb89-e6f4-46b3-a3b4-f9189db91d9f",
                                                "sense_id": "3a0b758d-4627-3e93-b565-e10eb1d9b632",
                                                "text": "Но как всему на свете есть конец, то и мы наконец добрались до какого-то села, где оставили экипажи и при них человека, а другого взяли с собой."
                                            },
                                            {
                                                "example_id": "222979ef-fb44-4b06-8628-d676efcd05f6",
                                                "sense_id": "3a0b758d-4627-3e93-b565-e10eb1d9b632",
                                                "text": "В этом селе мы, хотя и приезжие люди, знали хорошо жизнь каждого дома."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c176adbc-4144-347f-838a-864620afd441",
                                        "entry_id": "750bf3f8-dbdc-33f1-92b6-b503a7605b52",
                                        "glosses": [
                                            "собир., неисч. сельская, деревенская местность вообще"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac5fe21a-e947-4bcb-84a4-95f7d9205dcb",
                                                "sense_id": "c176adbc-4144-347f-838a-864620afd441",
                                                "text": "Любовь местных властей общественную работу на селе сваливать на тех же учителей."
                                            },
                                            {
                                                "example_id": "841fa776-5b3e-4b76-a45a-61a0b4cc900a",
                                                "sense_id": "c176adbc-4144-347f-838a-864620afd441",
                                                "text": "Важно другое, чтобы они в погоне за прибылями, килограммами и центнерами не забывали человека, который живёт на селе."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9d93167-5055-3a60-9953-b352564c502b",
                                        "entry_id": "750bf3f8-dbdc-33f1-92b6-b503a7605b52",
                                        "glosses": [
                                            "шутл. или пренебр. то же, что невежда"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "село",
                                "target_lang_code": "ru",
