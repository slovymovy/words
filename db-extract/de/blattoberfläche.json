                        "examples": [
                            {
                                "example_id": "81f7bb2d-8c1f-4a7c-96da-25ea512aa7f9",
                                "sense_id": "3bff0ab2-50a6-31f4-b17d-a89a3a436329",
                                "text": "Als ich das Lindenblatt berührte, konnte ich die weiche Blattoberfläche fühlen."
                            },
                            {
                                "example_id": "20eb6f38-f166-40dd-a168-2f9ca6eb9974",
                                "sense_id": "3bff0ab2-50a6-31f4-b17d-a89a3a436329",
                                "text": "Ein Marienkäfer lief über die Blattoberfläche."
                            },
                            {
                                "example_id": "ca1eaf90-fc4f-43c8-b93d-9c18d878a0d9",
                                "sense_id": "3bff0ab2-50a6-31f4-b17d-a89a3a436329",
                                "text": "Die Blattoberfläche des Aquarellpapiers ist besonders beschichtet, um die Farbe besser aufzunehmen."
                            }
