                        "examples": [
                            {
                                "example_id": "32e4e345-3b3f-4c9b-96d4-99a246c6fe3c",
                                "sense_id": "05db4142-2447-3579-ac1a-38e74db7cd9d",
                                "text": "Nu zijn er nog drie ingangen, maar daarvan blijft er een over. De routes voor het bezoekende verkeer worden verbeterd en het aantal parkeerplaatsen wordt uitgebreid. Komend seizoen kunnen op de parkeerplaats 4500 auto’s en 1000 touringcars terecht. In het nieuwe entreegebouw komen kassa's, een souvenirshop, wc's en kantoorruimtes."
                            },
                            {
                                "example_id": "9d3a465a-5f9b-4639-ad26-0d03e12d4384",
                                "sense_id": "05db4142-2447-3579-ac1a-38e74db7cd9d",
                                "text": "Een groot deel van Naturalis is gesloten. In het entreegebouw, het Pesthuis, kunnen bezoekers de komende tijd naar 'Op Expeditie met Naturalis'."
                            },
                            {
                                "example_id": "3debe54f-1cca-4c90-928c-93608153cb4e",
                                "sense_id": "05db4142-2447-3579-ac1a-38e74db7cd9d",
                                "text": "Verder staan er nog een nieuw entreegebouw, zonnepanelen, een windmolen en een biovergister op het verlanglijstje. Die laatste wordt deze week al in gebruik genomen."
                            }
                        ]
                    }
