                "senses": [
                    {
                        "sense_id": "930bbec7-cfec-3bc3-ba66-8670459b6135",
                        "entry_id": "36d38266-8e07-348d-9555-227733fe12d8",
                        "glosses": [
                            "Handlung, die viel Mut erforderte und zur Lösung eines Problems/einer Notsituation führte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fbe74eb-5fa9-4782-bd09-a05815ab8545",
                                "sense_id": "930bbec7-cfec-3bc3-ba66-8670459b6135",
                                "text": "„Jede Generation hat seitdem die Heldentaten, mit denen sich ihre Väter und Großväter unsterblich machten, cineastisch nacherlebt.“"
                            },
                            {
                                "example_id": "0cf7ca84-656f-419f-b379-5972d3f6d1f5",
                                "sense_id": "930bbec7-cfec-3bc3-ba66-8670459b6135",
                                "text": "„Fast bin ich stolz, als hätte mein Großonkel eine Heldentat begangen.“"
                            },
                            {
                                "example_id": "94bcd126-2ad8-4837-963d-6facdca53efd",
                                "sense_id": "930bbec7-cfec-3bc3-ba66-8670459b6135",
                                "text": "„Lucien wandte sich an die Diva, die aufmerksam Requiems Geschwafel über seine Heldentaten und sein Fernweh lauschte.“"
                            },
                            {
                                "example_id": "38cf7908-f736-4ad4-b1b2-9e2e0bbc7339",
                                "sense_id": "930bbec7-cfec-3bc3-ba66-8670459b6135",
                                "text": "„Ein durchschnittlicher Politiker hätte es bei dieser einen Heldentat belassen.“"
                            },
                            {
                                "example_id": "9941097c-76b1-42a1-986e-173d8b490039",
                                "sense_id": "930bbec7-cfec-3bc3-ba66-8670459b6135",
                                "text": "„Dieser Eindruck verdichtet sich in der Tat immer dann, wenn Risikosportler nicht sachlich und objektiv über ihre Erlebnisse berichten, sondern euphorisch übersteigert in Heldentaten schwelgen, […] mit Fliegerlatein die Wirklichkeit zu überhöhen versuchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e785f340-c0a3-493f-98c6-5a3822c0de40",
                        "source_entry_id": "36d38266-8e07-348d-9555-227733fe12d8",
                        "source_sense_id": "930bbec7-cfec-3bc3-ba66-8670459b6135",
