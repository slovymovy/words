        "ru-extract.jsonl": [
            {
                "entry_id": "6f547c64-086a-3cec-bac0-f6c8108f640b",
                "word": "гуще",
                "pos": "adj",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9970a4a4-0611-3903-af5c-96080cc7c984",
                        "entry_id": "6f547c64-086a-3cec-bac0-f6c8108f640b",
                        "glosses": [
                            "сравн. ст. к прил. густой"
                        ],
                        "tags": [
                            "comparative"
                        ],
                        "examples": [
                            {
                                "example_id": "bc669f98-adbe-42ff-8595-4190fd3e98ba",
                                "sense_id": "9970a4a4-0611-3903-af5c-96080cc7c984",
                                "text": "Здесь толпа была, пожалуй, ещё гуще, потому что выходили сюда же люди из другого здания, тоже с митинга."
                            },
                            {
                                "example_id": "a2b80e90-efdf-4b8c-964a-1af5144ca86c",
                                "sense_id": "9970a4a4-0611-3903-af5c-96080cc7c984",
                                "text": "В тайге у горных ключей лес бывает выше и гуще."
                            },
                            {
                                "example_id": "1b500be4-db63-4fdb-97c0-106e4faa4db0",
                                "sense_id": "9970a4a4-0611-3903-af5c-96080cc7c984",
                                "text": "На востоке краснело небо и с каждой минутой краски становились гуще, ярче, радостней."
                            },
                            {
                                "example_id": "899be8c7-617e-4322-b5a7-fc928be3613c",
                                "sense_id": "9970a4a4-0611-3903-af5c-96080cc7c984",
                                "text": "Чем ближе собор, тем звучнее, тяжелее, гуще и торжественнее гул соборного колокола."
                            }
                        ]
                    },
                    {
                        "sense_id": "b09991fe-6e42-3704-9872-aa41961eb384",
                        "entry_id": "6f547c64-086a-3cec-bac0-f6c8108f640b",
                        "glosses": [
                            "сравн. ст. к нареч. густой"
                        ],
                        "tags": [
                            "comparative"
                        ],
                        "examples": [
                            {
                                "example_id": "691c46e9-5dba-4d59-8e0a-4b1b45c4de8b",
                                "sense_id": "b09991fe-6e42-3704-9872-aa41961eb384",
                                "text": "Но Мишель покраснел ещё гуще и остался на месте."
                            },
                            {
                                "example_id": "1a51ccc0-437a-4d05-9aaf-fe49e1fd3b22",
                                "sense_id": "b09991fe-6e42-3704-9872-aa41961eb384",
                                "text": "Туман, расходившийся на горе, только гуще расстилался в низах, куда спустились войска."
                            }
                        ]
                    }
