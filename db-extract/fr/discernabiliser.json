                        "examples": [
                            {
                                "example_id": "e5487f4a-bc44-434b-bc8d-b94fd57af03d",
                                "sense_id": "529a6630-db33-3b34-9729-6e6e96d98da6",
                                "text": "Le travail de la schizoanalyse consistera tout particulièrement à discernabiliser ces composantes mutationnelles porteuses d’aspérités sémiotiques, de points-signes déterritorialisants qui leur permettent de « passer à travers » les stratifications d’agencement, un peu à la façon de cet « effet tunnel » que décrivent les physiciens."
                            },
                            {
                                "example_id": "5ea557f4-d886-4b06-a737-66502231a564",
                                "sense_id": "529a6630-db33-3b34-9729-6e6e96d98da6",
                                "text": "On peut discernabiliser des choses sans pour autant discursiver ?"
                            }
                        ]
                    }
