{
    "word_family": [
        "mélange",
        "mélangeage",
        "mélangeur",
        "mélangeuse"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "63b0dcbb-b094-3c8d-a77a-b6e19a723483",
                    "sense_definition": "Unir plusieurs éléments ou substances ensemble pour former un tout.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "combinaison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut bien <w>mélanger</w> les ingrédients pour obtenir une pâte lisse."
                        },
                        {
                            "text": "Vous devez <w>mélanger</w> la peinture avec un peu d'eau avant de commencer."
                        }
                    ],
                    "synonyms": [
                        "combiner",
                        "mêler",
                        "mixer"
                    ],
                    "antonyms": [
                        "dissocier",
                        "séparer"
                    ],
                    "common_phrases": [
                        "mélanger les ingrédients",
                        "mélanger les couleurs"
                    ]
                },
                {
                    "sense_id": "245d8474-21c7-37aa-b372-99c7ff4e141f",
                    "sense_definition": "Confondre des choses distinctes sans faire de différence entre elles.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "confusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant son exposé, l'élève a <w>mélangé</w> les dates importantes de la leçon."
                        },
                        {
                            "text": "Fais attention à ne pas <w>mélanger</w> ces deux dossiers professionnels."
                        }
                    ],
                    "synonyms": [
                        "amalgamer",
                        "confondre"
                    ],
                    "antonyms": [
                        "différencier",
                        "distinguer"
                    ],
                    "common_phrases": [
                        "mélanger les choses",
                        "tout mélanger"
                    ]
                },
                {
                    "sense_id": "ff12ee81-bdc0-35ac-a664-b8842c6fa0c2",
                    "sense_definition": "S'embrouiller dans ses pensées ou dans ses propos.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "confusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En voulant répondre trop vite, il s'est <w>mélangé</w> dans ses explications."
                        },
                        {
                            "text": "Je commence à me <w>mélanger</w> les pinceaux avec toutes ces nouvelles règles."
                        }
                    ],
                    "synonyms": [
                        "s'embrouiller",
                        "s'égarer"
                    ],
                    "antonyms": [
                        "s'y retrouver"
                    ],
                    "common_phrases": [
                        "se mélanger les pinceaux"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "souvent employé à la forme pronominale"
                        }
                    ]
                },
                {
                    "sense_id": "b6114620-d224-37a8-84e4-5ca7618fa8b6",
                    "sense_definition": "Provoquer de la confusion ou du trouble dans l'esprit de quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "confusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toutes ces instructions contradictoires ont fini par me <w>mélanger</w> l'esprit."
                        },
                        {
                            "text": "Ses explications trop détaillées risquent de <w>mélanger</w> les élèves débutants."
                        }
                    ],
                    "synonyms": [
                        "déconcerter",
                        "troubler"
                    ],
                    "antonyms": [
                        "éclairer"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "notamment usuel au Québec"
                        }
                    ]
                }
            ]
        }
    ]
