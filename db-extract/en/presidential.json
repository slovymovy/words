                    {
                        "sense_id": "ec308768-6280-3abb-847c-1aecf0114979",
                        "entry_id": "f3875ef6-350e-38fe-b273-daa866271555",
                        "glosses": [
                            "Pertaining to a president or presidency."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f583e42-eea1-4e9f-8a73-16d7ec89087c",
                                "sense_id": "ec308768-6280-3abb-847c-1aecf0114979",
                                "text": "Take the New Right's full-throated embrace of protectionism and industrial policy. This romance with protectionism started in the 1990s with former GOP presidential candidate Pat Buchanan, gained enormous traction under former President Donald Trump, and is still going strong today."
                            }
                        ]
                    },
                    {
                        "sense_id": "94685bf9-361c-3f8b-962f-6503b34ddaf7",
                        "entry_id": "f3875ef6-350e-38fe-b273-daa866271555",
                        "glosses": [
                            "Presiding or watching over."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a86d699f-cd83-3933-acf0-8784e89fec51",
                        "entry_id": "f3875ef6-350e-38fe-b273-daa866271555",
                        "glosses": [
                            "With the bearing or composure that befits a president; stately, dignified."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "552cfb0d-54a1-4121-a10f-79872ca90323",
                                "sense_id": "a86d699f-cd83-3933-acf0-8784e89fec51",
                                "text": "I feel my age and supposed status mean I am permanently required to be in presidential mode. And I mean this in the old sense of “presidential”, meaning magnanimous, patient and generous, rather than in the modern sense of presidential, meaning being a corrupt, pussy-grabbing racist."
                            }
                        ]
                    },
                    {
                        "sense_id": "2a3fb504-1ac1-3ad0-b758-f99cd67eec32",
                        "entry_id": "f3875ef6-350e-38fe-b273-daa866271555",
                        "glosses": [
                            "(of prayers) addressed to God on behalf of the congregation by the presiding priest"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7652cb97-8cad-4c57-ae15-a7078510846f",
                                "sense_id": "2a3fb504-1ac1-3ad0-b758-f99cd67eec32",
                                "text": "These prayers are addressed to God in the name of the entire holy people and all present, by the priest who presides over the assembly in the person of Christ. It is with good reason, therefore, that they are called the \"presidential prayers.\""
                            }
                        ]
                    }
