                "translations": [
                    {
                        "translation_id": "2228ab59-1697-4ab4-aba5-660424a03bcb",
                        "source_entry_id": "bafe5a05-2cc2-3d08-a2af-09699e0c0336",
                        "source_sense_id": "b7ea32fa-97d9-3c08-8b93-3132284f9c5a",
                        "target_lang_word": "pencil-neck",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pencil-neck",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "162a2f14-9aae-376f-8e20-0c1fa3123570",
                                        "entry_id": "069341ec-03a8-369e-b6ed-c5e1584d507e",
                                        "glosses": [
                                            "A person with a very thin neck."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a1c8b0a3-b424-36bb-822d-fbe4ce18f19f",
                                        "entry_id": "069341ec-03a8-369e-b6ed-c5e1584d507e",
                                        "glosses": [
                                            "An insubstantial person; a weakling."
                                        ],
                                        "tags": [
                                            "US",
                                            "derogatory",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1038e74-4f3d-4cfe-902b-25950023ff04",
                                                "sense_id": "a1c8b0a3-b424-36bb-822d-fbe4ce18f19f",
                                                "text": "That pencil-neck from systems isn't going to tell me what I can't do."
                                            },
                                            {
                                                "example_id": "13e3e6c6-db84-4e5a-94ee-a695377dc4cb",
                                                "sense_id": "a1c8b0a3-b424-36bb-822d-fbe4ce18f19f",
                                                "text": "Mom said, “Sell it to the circus, what the heck.” / Dad said, “Nope, this one's a pencil neck / And if there's one thing lower than a side show freak / It's a grit eatin', scum suckin', pencil neck geek.”"
                                            },
                                            {
                                                "example_id": "a5c3f981-48e5-4a67-a9f5-d9a6b19982ff",
                                                "sense_id": "a1c8b0a3-b424-36bb-822d-fbe4ce18f19f",
                                                "text": "On Thursday, March 28, Trump took the stage in Grand Rapids, Michigan, for a campaign rally, where he unleashed a new schoolyard nickname: “little pencil-neck Adam Schiff.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3117a99c-a230-41e9-9a66-7e9e3a5f7112",
                        "source_entry_id": "bafe5a05-2cc2-3d08-a2af-09699e0c0336",
                        "source_sense_id": "b7ea32fa-97d9-3c08-8b93-3132284f9c5a",
