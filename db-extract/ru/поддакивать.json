                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1875db15-2cb4-432d-8399-ada0bc3f1da1",
                                                "sense_id": "fa5cc3e1-2a65-3d3a-80d5-d86864c19fd3",
                                                "text": "And the Jews also assented, saying that these things were so."
                                            },
                                            {
                                                "example_id": "71502830-98fb-44aa-af72-5aeb23277416",
                                                "sense_id": "fa5cc3e1-2a65-3d3a-80d5-d86864c19fd3",
                                                "text": "The princess assented to all that was suggested."
                                            },
                                            {
                                                "example_id": "80af5b07-f10a-42b7-ae24-6c6c03e6fc9e",
                                                "sense_id": "fa5cc3e1-2a65-3d3a-80d5-d86864c19fd3",
                                                "text": "To assent to the words\nOf medieval law\nTo pay a corporal price\nTo death, by lapidation"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
