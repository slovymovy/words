                "senses": [
                    {
                        "sense_id": "af28e830-17bb-32ec-8f6e-8ed503d48c78",
                        "entry_id": "a9fffbe2-490b-3fb0-9564-716d161d0914",
                        "glosses": [
                            "człowiek, który wziął udział w podróży kosmicznej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6aa6978-4676-4a7e-a5c6-f2c40fc2af01",
                                "sense_id": "af28e830-17bb-32ec-8f6e-8ed503d48c78",
                                "text": "Obejmować Ziemię wzrokiem… – to marzenie ziściło się jedynie kosmonautom, a telewidzowie dostają tylko namiastkę."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "79f4392b-21a0-43a0-96f8-6e2722c6fe0a",
                        "source_entry_id": "a9fffbe2-490b-3fb0-9564-716d161d0914",
                        "source_sense_id": "af28e830-17bb-32ec-8f6e-8ed503d48c78",
                        "target_lang_word": "cosmonaut",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cosmonaut",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db0477e7-e2d7-3a26-b177-8b0b6444078a",
                                        "entry_id": "a04ac53c-ddf4-34a3-844c-9d9ec7894cee",
                                        "glosses": [
                                            "An astronaut, especially a Russian or Soviet one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75224842-743a-42f1-9504-39e651a007b4",
                                                "sense_id": "db0477e7-e2d7-3a26-b177-8b0b6444078a",
                                                "text": "Khrushchev’s answer came 60 years ago, on April 12, 1961, when Soviet cosmonaut Yuri Gagarin circled the Earth aboard a spacecraft called Vostok 1."
                                            },
                                            {
                                                "example_id": "bce733fb-18f1-4888-b476-5da930ac43b6",
                                                "sense_id": "db0477e7-e2d7-3a26-b177-8b0b6444078a",
                                                "text": "Longtime NASA astronaut Don Pettit, who has ventured to space four times, returned to Earth on Saturday night from the International Space Station. Pettit, who turned 70 on Sunday, landed at 9:20 p.m. ET in a Soyuz spacecraft with Roscosmos cosmonauts Alexey Ovchinin and Ivan Vagner near Zhezkazgan, Kazakhstan, after a seven-month stay aboard the orbiting laboratory."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f8ddfb5-c100-4657-bf62-841270a40f36",
                        "source_entry_id": "a9fffbe2-490b-3fb0-9564-716d161d0914",
                        "source_sense_id": "af28e830-17bb-32ec-8f6e-8ed503d48c78",
                        "target_lang_word": "kosmonaut",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kosmonaut",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "ce8217e0-477b-3ec0-8a10-5758aa8ae549",
                                        "entry_id": "9d9affe2-c153-3f18-86b9-e7625e135f78",
                                        "glosses": [
                                            "člověk vytrénovaný k létání v kosmické lodi"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38b2346e-e653-422f-a4c2-a82a712a1ac9",
                                                "sense_id": "ce8217e0-477b-3ec0-8a10-5758aa8ae549",
                                                "text": "Prvním českým kosmonautem se stal koncem 70. let 20. století Vladimír Remek."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e984dcd1-eefe-4611-b6d5-4f68d3fa109c",
                        "source_entry_id": "a9fffbe2-490b-3fb0-9564-716d161d0914",
                        "source_sense_id": "af28e830-17bb-32ec-8f6e-8ed503d48c78",
                        "target_lang_word": "cosmonauta",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cosmonauta",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "054162d8-75b0-3768-a61b-d76953c6bd17",
                                        "entry_id": "ef2d96d6-76fd-3e2a-8b70-a06894388a05",
                                        "glosses": [
                                            "Astronauta soviético o ruso."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a82d6e49-71aa-4db1-b91b-a70ed819eb3f",
                        "source_entry_id": "a9fffbe2-490b-3fb0-9564-716d161d0914",
                        "source_sense_id": "af28e830-17bb-32ec-8f6e-8ed503d48c78",
                        "target_lang_word": "Kosmonaut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kosmonaut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e8e11c18-47bb-308e-99db-16d25aed5c97",
                                        "entry_id": "d6f6a5ce-fc41-35a8-8a02-6aeec256b4ef",
                                        "glosses": [
                                            "Weltraumfahrer (aus Russland beziehungsweise aus der ehemaligen Sowjetunion und/oder dem ehemaligen Ostblock), der an einem (russischen beziehungsweise sowjetischen) Raumflug teilnimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "246619a5-cddd-4b95-8572-727d381ecbd8",
                                                "sense_id": "e8e11c18-47bb-308e-99db-16d25aed5c97",
                                                "text": "Im Jahr 1961 startete der erste Kosmonaut ins All."
                                            },
                                            {
                                                "example_id": "e7c223a9-a2d4-49a9-8121-2c8ec19bf35e",
                                                "sense_id": "e8e11c18-47bb-308e-99db-16d25aed5c97",
                                                "text": "„Da kommt aber auch der 70. Jahrestag der Oktoberrevolution, und keiner weiß, ob vielleicht wieder ein Kosmonaut aus der DDR in den Weltraum fliegt …“"
                                            },
                                            {
                                                "example_id": "ff97f56e-ae72-4720-b06a-97d3fc3bdee9",
                                                "sense_id": "e8e11c18-47bb-308e-99db-16d25aed5c97",
                                                "text": "„Er wußte die längste Zeit nicht, ob er Maler oder Kosmonaut werden wollte.“"
                                            },
                                            {
                                                "example_id": "b0ef4c8e-257b-422a-bf0a-7024c67b15d4",
                                                "sense_id": "e8e11c18-47bb-308e-99db-16d25aed5c97",
                                                "text": "„Der Kosmonaut musste sich sehr einsam da oben gefühlt haben und heilfroh gewesen sein, heil wieder zurück nach Hause gekommen zu sein.“"
                                            },
                                            {
                                                "example_id": "7304e78f-e8fd-413a-856b-7d5b0e82f6d7",
                                                "sense_id": "e8e11c18-47bb-308e-99db-16d25aed5c97",
                                                "text": "„Die Sojus-Rakete MS-08 wird auf der Startrampe des von Russland gemieteten Kosmodroms Baikonur in Kasachstan montiert. Der Start der Sojus-Rakete, mit den NASA-Astronauten Andrew Feustel, Richard Arnold und dem Roscosmos-Kosmonauten Oleg Artemyev an Bord, ist für den 21. März geplant.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04df6fc0-bac5-4e57-a68e-924ce009cbd6",
                        "source_entry_id": "a9fffbe2-490b-3fb0-9564-716d161d0914",
                        "source_sense_id": "af28e830-17bb-32ec-8f6e-8ed503d48c78",
                        "target_lang_word": "космона́вт",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "космона́вт",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "43bb960b-e22e-3888-aa80-35c4b4344e5e",
                                        "entry_id": "4f6bad3a-9bef-3df0-a110-eb7dbdf161dd",
                                        "glosses": [
                                            "косм. человек, совершивший либо готовящийся совершить космический полёт"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e80c4f1-4526-4d3e-abf2-be1ff7d8266c",
                                                "sense_id": "43bb960b-e22e-3888-aa80-35c4b4344e5e",
                                                "text": "С ответным визитом в США побывали наши космонавты .., которых тепло встретили американские космонавты, отдавая должное тому, что и их путь в космос проложили советские спутники Земли, первый космонавт мира Юрий Алексеевич Гагарин."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5aefd8cf-4293-3e74-86b7-a876753d3692",
                                        "entry_id": "4f6bad3a-9bef-3df0-a110-eb7dbdf161dd",
                                        "glosses": [
                                            "косм. космонавт [1], работающий в рамках космической программы России или СССР"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9790fd7-d9fa-4f1c-8c66-cbe91091d981",
                                                "sense_id": "5aefd8cf-4293-3e74-86b7-a876753d3692",
                                                "text": "Находясь на орбите, космонавты и астронавты уже неоднократно принимали участие в голосовании, но в переписи они принимают участие впервые."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02bbb611-fbed-3078-960a-9156ca42f7f8",
                                        "entry_id": "4f6bad3a-9bef-3df0-a110-eb7dbdf161dd",
                                        "glosses": [
                                            "разг. сотрудник силовых структур в защитном обмундировании для работы на массовых мероприятиях"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "430273d0-0ed8-4f04-87be-80e0471b378b",
                                                "sense_id": "02bbb611-fbed-3078-960a-9156ca42f7f8",
                                                "text": "…в этот раз симпатии народа были на стороне избиваемых. «Фашисты! — кричала какая-то пожилая женщина. — Вы бы в Чечне так воевали!» «Космонавты! — поддерживал её молодой мужчина, имея в виду омоновские шлемы, похожие на снаряжение космонавтов. — Летите в космос!»"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
                        "linkage_id": "4a2e9f9d-49d1-4ad0-8425-b94149310109",
