                        "examples": [
                            {
                                "example_id": "fadaca59-a844-487d-a650-a22fd60e094f",
                                "sense_id": "fa48c60e-fd76-3964-a603-46a1a9d36946",
                                "text": "„Ihre Brauen zogen sich wie Unwetterwolken über ihrem Gesicht zusammen.“"
                            },
                            {
                                "example_id": "5fa4a35d-5394-4f69-a276-dee68e282f74",
                                "sense_id": "fa48c60e-fd76-3964-a603-46a1a9d36946",
                                "text": "„Ein Blick aus dem Fenster zeigt die Dinge jedoch in einem etwas anderen Licht; angesichts des grauen Himmels und der dunklen Unwetterwolken am Horizont muss der Typ entweder verrückt oder betrunken sein.“"
                            }
                        ],
