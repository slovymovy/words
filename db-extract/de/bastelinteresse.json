                ],
                "senses": [
                    {
                        "sense_id": "22fde0b0-4a67-3f54-af5f-ba18016d55f6",
                        "entry_id": "9bc3c89c-9edc-3ab9-88f9-62faeff22e3e",
                        "glosses": [
                            "Leidenschaft für das Basteln (kleine Handwerksarbeiten)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c82d527b-3deb-41ca-9284-c2aa4cf8c53d",
                                "sense_id": "22fde0b0-4a67-3f54-af5f-ba18016d55f6",
                                "text": "„Eine auffällige technische Begabung, ein intensives Bastelinteresse, ein musikalisches oder zeichnerisches Talent, das bis dahin die besten Hoffnungen begründete, kann in der (eigentlichen) Pubertät untergehen und nicht wiederkehren.“"
                            },
                            {
                                "example_id": "e2e65db6-970e-4c05-9a78-b95aab90306a",
                                "sense_id": "22fde0b0-4a67-3f54-af5f-ba18016d55f6",
                                "text": "„Sein entwickeltes Motorrad- und Bastelinteresse kultiviert der junge Mann zusätzlich mit der Teilnahme an Mofa-Rennen und Motorcross-Wettkämpfen.“"
                            },
                            {
                                "example_id": "f5a67801-b974-4cd2-acc8-0f3efe63f48a",
                                "sense_id": "22fde0b0-4a67-3f54-af5f-ba18016d55f6",
                                "text": "„Der Dentist Friedrich Pohlenz , Zahnarzt der Familie Grade, hört vom Bastelinteresse des Jungen.“"
                            },
                            {
                                "example_id": "e3036a76-b3de-41f4-9c90-0efaf15e9a87",
                                "sense_id": "22fde0b0-4a67-3f54-af5f-ba18016d55f6",
                                "text": "„Es ist geeignet, über das Spiel hinaus Verständnis für Anlage und Betrieb der wirklichen Eisenbahn zu fördern und wird alle Jungen fesseln, deren Bastelinteresse noch nicht volltommen durch das Radio absorbiert ist.“"
                            },
                            {
                                "example_id": "ba4714c0-5b39-4004-b3fc-7559ba01f1f5",
                                "sense_id": "22fde0b0-4a67-3f54-af5f-ba18016d55f6",
                                "text": "„Außerhalb der Schule interessieren sich die Buben für Sport und Technik; ihr Bastelinteresse richtet sich vor allem auf Verkehrsmittel, wie Flugzeuge und Schiffe.“"
                            },
                            {
                                "example_id": "ac892722-bae9-4ed7-99e1-2dab458dabc8",
                                "sense_id": "22fde0b0-4a67-3f54-af5f-ba18016d55f6",
                                "text": "„Ich wurde immer wieder nach Bastelinteressen unseres Sohnes gefragt, ob ich Chemikalien, Kochbücher, evtl. elektronische Bastelteile bei ihm gefunden hätte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
