                "senses": [
                    {
                        "sense_id": "358358cf-4ec2-362b-ad10-b4344d967f21",
                        "entry_id": "75d449f5-0639-3d57-b2a6-e4299777fad3",
                        "glosses": [
                            "door platdrukken kapot maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0811d109-bcb8-4947-8858-0dc031ce323f",
                                "sense_id": "358358cf-4ec2-362b-ad10-b4344d967f21",
                                "text": "Alleen al hoe Macron het veld openbreekt vanuit het midden is een kunststukje; voorheen werden alle centrum-avonturiers verplet tussen rechts en links. De man is jong, intelligent en ongemeen charmant; „ambitie met hertenogen”, typeerde iemand."
                            },
                            {
                                "example_id": "bbe9ae8f-263d-4070-a722-ea7af5f8e12a",
                                "sense_id": "358358cf-4ec2-362b-ad10-b4344d967f21",
                                "text": "Hij was een groot bewonderaar en kenner van de negentiende-eeuwse verskunst. Zo maakte hij een bundeltje met antwoorden op de befaamde weemoedige gedichten van Piet Paaltjens. In het gedicht Aan Rika spreekt Paaltjens de wens uit samen met Rika verplet te worden door een sneltrein, om zo met haar verenigd te zijn."
                            }
                        ]
                    },
                    {
                        "sense_id": "d0fbf6c9-e9f4-30de-8d66-5b344bad2db1",
                        "entry_id": "75d449f5-0639-3d57-b2a6-e4299777fad3",
                        "glosses": [
                            "helemaal van slag raken door een zeer indrukwekkende gebeurtenis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9839a2f7-6fff-4f6e-bf95-e7fcd0c0cca8",
                                "sense_id": "d0fbf6c9-e9f4-30de-8d66-5b344bad2db1",
                                "text": "Toch is dit lang genoeg om hem blind verliefd te doen worden en in de slotregel hoopt hij ‘met u verplet te worden door één trein’. Een klassiek voorbeeld van de coup de foudre, de zweepslag van de plotselinge verliefdheid."
                            }
                        ]
                    }
