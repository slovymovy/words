                ],
                "senses": [
                    {
                        "sense_id": "3f565443-332a-321f-a9bf-a27ed01722cf",
                        "entry_id": "4521a4f9-666b-3b61-b5d7-1c5bb302b237",
                        "glosses": [
                            "Zeitraum (in den Tropen), in dem besonders viel Regen fällt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02833667-7cae-4466-ad81-3cef81982397",
                                "sense_id": "3f565443-332a-321f-a9bf-a27ed01722cf",
                                "text": "Die Regenzeit ist wichtig, um die Wasserreservoire zu füllen."
                            },
                            {
                                "example_id": "ada6c7ef-5534-4ed3-92c6-217f245d3e76",
                                "sense_id": "3f565443-332a-321f-a9bf-a27ed01722cf",
                                "text": "„Während der kurzen Regenzeit wird das Tal von mitreißenden Regenfluten überschwemmt, die sich donnernd in den Atlantik ergießen.“"
                            },
                            {
                                "example_id": "0c8a0f9e-d237-4a34-a704-6506b6a22aee",
                                "sense_id": "3f565443-332a-321f-a9bf-a27ed01722cf",
                                "text": "„Denn auch in jenem Januar 1890 war die Regenzeit in Samoa gekennzeichnet durch lähmende Hitze und sintflutartige Regenfälle sowie häufige Sturmwinde und extrem hohe Luftfeuchtigkeit.“"
                            },
                            {
                                "example_id": "bd652e4d-6b70-47c2-baeb-1443b6695ac9",
                                "sense_id": "3f565443-332a-321f-a9bf-a27ed01722cf",
                                "text": "„Das Wasser, das in den Seen gespeichert wurde, fließt weiter Jahr für Jahr zur Regenzeit ins Tal - inzwischen wird es jedoch unter die Stadt geleitet.“"
                            },
                            {
                                "example_id": "cfadfaac-c5fb-4414-a312-c6ec5d5c099a",
                                "sense_id": "3f565443-332a-321f-a9bf-a27ed01722cf",
                                "text": "„Während der Regenzeit zerren Sturmböen an Reitern und Zelten.“"
                            },
                            {
                                "example_id": "aec3be53-e975-40db-b528-a0b2e703ee69",
                                "sense_id": "3f565443-332a-321f-a9bf-a27ed01722cf",
                                "text": "„Doch die Regenzeit stand kurz bevor, und wenn die Straße unasphaltiert blieb, würde die ganze Arbeit im Nu weggespült werden.“"
                            },
                            {
                                "example_id": "258a24ac-e6e5-48cd-b67c-63bad7b5de50",
                                "sense_id": "3f565443-332a-321f-a9bf-a27ed01722cf",
                                "text": "„Die Ebene wird von Flüssen durchzogen, die in der Regenzeit oft über die Ufer treten und dieses Gebiet unpassierbar machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
