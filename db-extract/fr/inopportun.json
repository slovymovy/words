                "senses": [
                    {
                        "sense_id": "fb13db64-5225-3ea2-a7d4-39a39290f870",
                        "entry_id": "09692ba6-a806-3362-aa55-2e2a16af0dbf",
                        "glosses": [
                            "Qui n’est pas opportun, pas à propos, mal adapté aux circonstances."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51c004ab-9b8a-478c-ba9e-7e4e8cb7f273",
                                "sense_id": "fb13db64-5225-3ea2-a7d4-39a39290f870",
                                "text": "Vous ne pouvez choisir un moment plus inopportun."
                            },
                            {
                                "example_id": "5abd35e9-0ea8-4035-aae1-472d275eb9f2",
                                "sense_id": "fb13db64-5225-3ea2-a7d4-39a39290f870",
                                "text": "Cette mesure ne vous semble- t-elle pas inopportune ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fff38912-94d8-400a-9fc0-5ec3b3066978",
                        "source_entry_id": "09692ba6-a806-3362-aa55-2e2a16af0dbf",
                        "source_sense_id": "fb13db64-5225-3ea2-a7d4-39a39290f870",
                        "target_lang_word": "inopportune",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inopportune",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b71b958-5a60-3272-9369-642633062f63",
                                        "entry_id": "777b9a8b-80e0-3683-b1f1-05d8ed6c9c37",
                                        "glosses": [
                                            "Unsuitable for some particular purpose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "722f0fe4-6688-4f5f-9574-90afd10e042c",
                                                "sense_id": "6b71b958-5a60-3272-9369-642633062f63",
                                                "text": "That was a most inopportune spot for a picnic."
                                            },
                                            {
                                                "example_id": "05f4cf77-56c3-4452-8029-fe875eedeb34",
                                                "sense_id": "6b71b958-5a60-3272-9369-642633062f63",
                                                "text": "\"It appears I come at an inopportune time, madam,\" said he, \"when my friend, Mr. Rochester, is from home; but I arrive from a very long journey, and I think I may presume so far on old and intimate acquaintance as to install myself here till he returns.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df904497-67e6-3276-a7a0-6008fd894619",
                                        "entry_id": "777b9a8b-80e0-3683-b1f1-05d8ed6c9c37",
                                        "glosses": [
                                            "Happening/occurring at an inconvenient or inappropriate time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98bf4276-e6cf-433d-9288-3b1dd27e1934",
                                                "sense_id": "df904497-67e6-3276-a7a0-6008fd894619",
                                                "text": "The inopportune arrival of the bus cut short the interesting conversation."
                                            },
                                            {
                                                "example_id": "c7655ef2-9f5a-4831-bbdd-96a5324cca85",
                                                "sense_id": "df904497-67e6-3276-a7a0-6008fd894619",
                                                "text": "The object is to keep the yard operators apprised of main-line movements, so that they do not plan to occupy the main lines with activity into or out of the yard at an inopportune juncture."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
