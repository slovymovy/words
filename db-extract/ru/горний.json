                "senses": [
                    {
                        "sense_id": "e424f723-857a-3057-b955-44c5a5b969d0",
                        "entry_id": "170714b0-1db4-3e1f-8d24-e1b2abc25789",
                        "glosses": [
                            "Haut, situé sur une montagne."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "3257c9f6-ccc9-455a-8ba1-61501899e5d4",
                                "sense_id": "e424f723-857a-3057-b955-44c5a5b969d0",
                                "text": "Дорога в горний град [Иерусалим], разумеется, гористая, как впрочем и везде в здешней стороне.",
                                "translation": "La route menant à la ville haute (de Jérusalem) est ardue, etc."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ce050bd-1e7a-3ab1-aae2-4b5ab42dc8df",
                        "entry_id": "170714b0-1db4-3e1f-8d24-e1b2abc25789",
                        "glosses": [
                            "Divin, céleste, sublime."
                        ],
                        "tags": [
                            "Qui vient du haut"
                        ],
                        "examples": [
                            {
                                "example_id": "95e3bf90-902b-4762-9f7d-e7b543d17afb",
                                "sense_id": "0ce050bd-1e7a-3ab1-aae2-4b5ab42dc8df",
                                "text": "И внял я неба содроганье,\nИ горний ангелов полёт,\nИ гад морских подводный ход,\nИ дольней ло́зы прозябанье."
                            }
                        ]
                    }
