                                                "example_id": "1f559d51-f598-4eec-aeea-bcaf2f67f071",
                                                "sense_id": "2d9560bb-225d-3c28-9883-0e08eb03f3d6",
                                                "text": "The British Transport Commission (BTC) was created to own not just the railways, but also London Underground, docks, inland waterways, and some road haulage activities. Its remit was to operate on a break-even basis, with sustained losses unacceptable."
                                            }
                                        ]
