{
    "word_family": [
        "boender",
        "boenwas",
        "boenmachine"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "72e0d098-6653-39a7-a9f8-e7192fcba8d7",
                    "sense_definition": "met een harde borstel en water krachtig schoonmaken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "schoonmaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De tegels glansden nadat ze met zeepsop <w>geboend</w> waren.",
                            "target_lang_translations": {
                                "en": "The tiles gleamed after they had been <w>scrubbed</w> with soapy water."
                            }
                        },
                        {
                            "text": "Je moet de vloer goed <w>boenen</w> om alle vlekken te verwijderen.",
                            "target_lang_translations": {
                                "en": "You need to <w>scrub</w> the floor well to remove all the stains."
                            }
                        }
                    ],
                    "synonyms": [
                        "schrobben",
                        "poetsen"
                    ],
                    "common_phrases": [
                        "de vloer boenen",
                        "met zeep boenen"
                    ],
                    "target_lang_definitions": {
                        "en": "to clean vigorously using a hard brush and water"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scrub",
                                "target_lang_sense_clarification": "to rub hard with a brush to clean"
                            },
                            {
                                "target_lang_word": "scour",
                                "target_lang_sense_clarification": "to clean by hard rubbing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2f118ca-55df-345b-ae62-5b99555aafbb",
                    "sense_definition": "iets met was of een ander middel inwrijven om het te laten glanzen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "schoonmaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De buurman staat de hele dag zijn auto te <w>boenen</w>.",
                            "target_lang_translations": {
                                "en": "The neighbor is <w>polishing</w> his car all day long."
                            }
                        },
                        {
                            "text": "Na het aanbrengen van de was moet je het hout stevig <w>boenen</w>.",
                            "target_lang_translations": {
                                "en": "After applying the wax, you have to <w>buff</w> the wood vigorously."
                            }
                        }
                    ],
                    "synonyms": [
                        "opwrijven",
                        "polijsten"
                    ],
                    "common_phrases": [
                        "met was boenen",
                        "glanzend boenen"
                    ],
                    "target_lang_definitions": {
                        "en": "to rub something with wax or another substance to make it shine"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "polish",
                                "target_lang_sense_clarification": "to make a surface shiny by rubbing"
                            },
                            {
                                "target_lang_word": "wax",
                                "target_lang_sense_clarification": "to treat or polish with wax"
                            },
                            {
                                "target_lang_word": "buff",
                                "target_lang_sense_clarification": "to polish with a soft material"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}