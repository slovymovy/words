                "entry_id": "c9b48739-6a7b-35f8-8346-ad55e8d2051a",
                "word": "antitrust",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d45ff694-7fa5-3b49-a2a3-6f5340037c35",
                        "entry_id": "c9b48739-6a7b-35f8-8346-ad55e8d2051a",
                        "glosses": [
                            "Opposed to or against the establishment or existence of trusts (monopolies), usually referring to legislation."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "337e156f-75df-48bb-ac0b-d31e8f5461c4",
                                "sense_id": "d45ff694-7fa5-3b49-a2a3-6f5340037c35",
                                "text": "The regulators used antitrust laws to block the merger, believing it would eliminate competition."
                            },
                            {
                                "example_id": "9b75ee91-1dbf-4c77-a140-4f5dba0e06d4",
                                "sense_id": "d45ff694-7fa5-3b49-a2a3-6f5340037c35",
                                "text": "If the takeover is approved, Comcast would control 20 of the top 25 cable markets, […]. Antitrust officials will need to consider Comcast’s status as a monopsony (a buyer with disproportionate power), when it comes to negotiations with programmers, whose channels it pays to carry."
                            },
                            {
                                "example_id": "0f046c86-9e21-4f12-9ef8-441f04c1b41b",
                                "sense_id": "d45ff694-7fa5-3b49-a2a3-6f5340037c35",
                                "text": "When a rival meatpacker filed an antitrust lawsuit to block the deal, the Reagan administration intervened on the side of Cargill."
                            }
                        ]
                    }
                ],
