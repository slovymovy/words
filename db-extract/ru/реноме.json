                                        "sense_id": "4cb6605d-fc0a-3a72-8580-5095803e5d66",
                                        "entry_id": "c19a79c1-27c5-3ea2-a40e-65f1358a21f2",
                                        "glosses": [
                                            "El epíteto de gloria o fama que se adquiere o da a alguno por sus acciones."
                                        ],
