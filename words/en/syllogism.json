    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "27e7c1cd-1945-30b7-97ab-b623c9a128f8",
                    "sense_definition": "A form of deductive reasoning in which a conclusion is drawn from two given or assumed propositions (premises).",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "logic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The classic <w>syllogism</w> states that all men are mortal, Socrates is a man, and therefore Socrates is mortal."
                        },
                        {
                            "text": "In logic class, students learned how to construct a valid <w>syllogism</w> using two true premises."
                        }
                    ],
                    "synonyms": [
                        "deduction"
                    ],
                    "common_phrases": [
                        "categorical syllogism",
                        "valid syllogism"
                    ]
                },
                {
                    "sense_id": "87022125-1578-3bc1-be6f-592ba147cd3b",
                    "sense_definition": "An extremely subtle, sophisticated, or deceptive argument used to mislead someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "logic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician used a clever <w>syllogism</w> to disguise the flaws in his proposed policy."
                        },
                        {
                            "text": "Her entire defense rested on a deceptive <w>syllogism</w> meant to distract the jury from the facts."
                        }
                    ],
                    "synonyms": [
