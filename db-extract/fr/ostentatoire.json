                                        "entry_id": "5bc580cc-f06b-3451-b2f2-705853deb264",
                                        "glosses": [
                                            "Of ostentation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3ba28792-ea2d-302c-8581-d97c70eb0a00",
                                        "entry_id": "5bc580cc-f06b-3451-b2f2-705853deb264",
                                        "glosses": [
                                            "Intended to attract notice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d53b790f-462c-496d-9581-887070c57f94",
                                                "sense_id": "3ba28792-ea2d-302c-8581-d97c70eb0a00",
                                                "text": "Over the course of the war in Ukraine, the Kremlin has drawn several “red lines” – with ostentatious references to Russia’s huge strategic nuclear arsenal – only to seemingly do nothing when these lines are crossed by Ukraine or its Western backers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3323b728-b2b1-3b11-8758-c91a7a880ccb",
                                        "entry_id": "5bc580cc-f06b-3451-b2f2-705853deb264",
                                        "glosses": [
                                            "Of tawdry display; kitsch."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
