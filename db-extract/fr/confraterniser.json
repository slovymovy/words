                        "glosses": [
                            "Se conduire de façon confraternelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bc64b17-89bb-4e99-b4ad-4b45bca140a5",
                                "sense_id": "434ddc7e-ce0a-3241-8467-106b4a48a8d0",
                                "text": "Tant pis ! le peuple se sent insulté de cette retraite ; le peuple veut confraterniser avec vous, pourquoi ne vous rapprochez-vous pas de nous au lieu de vous en éloigner ?"
                            },
                            {
                                "example_id": "a3f7a062-a378-4bb2-bb81-a039afa4c2b0",
                                "sense_id": "434ddc7e-ce0a-3241-8467-106b4a48a8d0",
                                "text": "Ils ne veulent plus confraterniser avec le sieur de Préval."
                            }
                        ]
                    }
