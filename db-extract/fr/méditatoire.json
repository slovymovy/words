                        "glosses": [
                            "Relatif à la méditation."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a84fcaeb-5383-4e09-9a99-e97ac9af537f",
                                "sense_id": "f99e2e7a-6cd2-3b09-9ac7-14a5886fc54c",
                                "text": "Je m’attends à un silence méditatoire, quand le cacatoès coordinateur bondit de son perchoir, tout grand réveillé, et se met à cacatoer à débit bousculeur."
                            },
                            {
                                "example_id": "9b9edeca-606b-40c3-8817-c21dbcc3f227",
                                "sense_id": "f99e2e7a-6cd2-3b09-9ac7-14a5886fc54c",
                                "text": "Plutôt que d’essayer de dresser un inventaire de toutes les sortes de techniques méditatoires prodiguées et de comparer éventuellement leur fondement, il paraît plus important d’analyser d’abord la demande."
                            },
                            {
                                "example_id": "1ec8699f-41d4-4b89-b855-8dcaca0e91cd",
                                "sense_id": "f99e2e7a-6cd2-3b09-9ac7-14a5886fc54c",
                                "text": "Il y a encore ceux qui pratiquent à domicile les arts - divinatoires, artistiques, martiaux, méditatoires - en provenance d’Asie, et ceux qui s’adonnent avec bonne foi aux médecines douces, à la sophrologie, au végétarisme, etc."
                            }
                        ]
                    }
