                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "02def1b3-17d8-3fd3-8e8b-7f98457841d6",
                        "entry_id": "b49b55f7-813d-3055-afaa-075445cc5e82",
                        "glosses": [
