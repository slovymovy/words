                ],
                "senses": [
                    {
                        "sense_id": "9df1a3db-d28c-3c8d-8f51-b991d8262c5f",
                        "entry_id": "7f08a06c-3d37-37d2-a3de-a822b318a7a7",
                        "glosses": [
                            "Personne trans qui souhaite réaliser à terme une opération de réattribution sexuelle."
                        ],
                        "tags": [
                            "Transitude"
                        ],
                        "examples": [
                            {
                                "example_id": "3b857bd1-54f2-40ef-b11c-2039ac94e1b3",
                                "sense_id": "9df1a3db-d28c-3c8d-8f51-b991d8262c5f",
                                "text": "C’est le cas de la représentation des femmes trans pré-op ou non-op qui sert une obsession voyeuriste des cis ainsi qu'une représentation cissexiste des corps des femmes trans."
                            },
                            {
                                "example_id": "fe53ef92-fcf1-433c-ba2f-c1e6d563fe7d",
                                "sense_id": "9df1a3db-d28c-3c8d-8f51-b991d8262c5f",
                                "text": "Sans surprise, les universitaires, les activistes, les étudianz* et les artistes ont questionné le sens et la signification de la corporéité transsexuelle/transgenre. Dans les versions les plus simplistes, on a suggéré que les transsexuel·les pré-op se sentent enfermé·es dans le mauvais corps, qu’iels désirent un corps guéri, nécessairement articulé selon une forme mâle ou femelle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "311b6f3b-e61b-4248-b56a-48a5918967e0",
                        "source_entry_id": "7f08a06c-3d37-37d2-a3de-a822b318a7a7",
                        "source_sense_id": "9df1a3db-d28c-3c8d-8f51-b991d8262c5f",
                        "target_lang_word": "pre-op",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pre-op",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "047aa1e6-d4c0-3a11-ab18-61f7ea4dcecb",
                                        "entry_id": "1d5df40b-1176-3ee9-a8ff-944d2ac6e0d8",
                                        "glosses": [
                                            "Happening before an operation."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8340b6ba-05c9-4dc5-8883-7296fdfa9e4c",
                                                "sense_id": "047aa1e6-d4c0-3a11-ab18-61f7ea4dcecb",
                                                "text": "a pre-op consultation"
                                            },
                                            {
                                                "example_id": "5b60b504-9343-4b3c-9ae9-320fd9ad1fa5",
                                                "sense_id": "047aa1e6-d4c0-3a11-ab18-61f7ea4dcecb",
                                                "text": "For example, Goal 7 “Reduce the risk of health care associated infections” stipulates, among other things, that hospitals have specific strategies in place to prevent surgical site infection (SSI), that they provide regular feedback about SSI rates to caregivers, with follow-up for 30 days, that they discontinue the use of shaving as a method of preop hair removal, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce777eaf-656f-3948-a99b-cf180f7b47d2",
                                        "entry_id": "1d5df40b-1176-3ee9-a8ff-944d2ac6e0d8",
                                        "glosses": [
                                            "Not yet operated on."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39397204-5ef5-4f67-805c-b27e6feb9d7c",
                                                "sense_id": "ce777eaf-656f-3948-a99b-cf180f7b47d2",
                                                "text": "The three pre-op transsexuals are attired in cheap, synthetic clothes and, to emphasize this point, one of them even wears a polyester imitation of Samantha's luxury silk nightgown […]"
                                            }
                                        ]
                                    }
                                ]
                            },
