                "translations": [
                    {
                        "translation_id": "c34ce024-667c-4b50-98a9-a8a32be2927a",
                        "source_entry_id": "13307a86-eebd-3914-9c8e-38f36732c982",
                        "source_sense_id": "897b1a4d-fdee-3f50-9423-1aa81319af25",
                        "target_lang_word": "Erholung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erholung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d466db67-b8b4-3a74-b17e-65cb586098a1",
                                        "entry_id": "7275d415-24f6-315c-8b09-4a75ced685c8",
                                        "glosses": [
                                            "derjenige Vorgang, bei dem sich ein biologischer Organismus nach einer anstrengenden Tätigkeit, aber auch nach Verletzungen oder Krankheiten durch eine Ruhephase wieder regeneriert und Kräfte sammelt"
                                        ],
                                        "tags": [
                                            "Physiologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "410e005c-4db3-4266-9fd4-e0008822ba91",
                                                "sense_id": "d466db67-b8b4-3a74-b17e-65cb586098a1",
                                                "text": "Nach diesen Anstrengungen bedurften wir dringend einer längeren Erholung."
                                            },
                                            {
                                                "example_id": "be676004-9d94-4565-aef5-47f9349c5ee7",
                                                "sense_id": "d466db67-b8b4-3a74-b17e-65cb586098a1",
                                                "text": "Wollen wir zur Erholung über das Wochenende wegfahren?"
                                            },
                                            {
                                                "example_id": "77084db7-2c21-47d2-b206-d64683b42f21",
                                                "sense_id": "d466db67-b8b4-3a74-b17e-65cb586098a1",
                                                "text": "„Die Datierung lieferte auch Belege, dass die Erholung von Pflanzen und Tieren nach dem Asteroideneinschlag eng miteinander verbunden war.“"
                                            },
                                            {
                                                "example_id": "8da9c916-d9e2-48c8-9dde-920baf90f1de",
                                                "sense_id": "d466db67-b8b4-3a74-b17e-65cb586098a1",
                                                "text": "„Die erschöpften Leute beider Armeen, die den ganzen Tag über weder Nahrung noch Erholung gehabt hatte, begannen gleichermassen zu zweifeln, ob sie wirklich in ihrem gegenseitigen Vernichtungswerk fortfahren sollten, auf allen Gesichtern prägte sich dieses Schwanken aus, und in jeder einzelnen Seele erhob sich die gleiche Frage: ….“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6c41872f-76f1-3553-92d2-c168eff876d6",
                                        "entry_id": "7275d415-24f6-315c-8b09-4a75ced685c8",
                                        "glosses": [
                                            "Zurückbewegung auf einen positiven Zustand hin"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3646b76-fe06-437b-95a5-e6665ca8c2d1",
                                                "sense_id": "6c41872f-76f1-3553-92d2-c168eff876d6",
                                                "text": "Die konjunkturelle Erholung setzt sich fort."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "398abf2f-1b72-3579-ad7a-14ad5c148ac2",
                                        "entry_id": "7275d415-24f6-315c-8b09-4a75ced685c8",
                                        "glosses": [
                                            "Kristallerholung, Bestreben eines kaltverformten Werkstoffs, sich seinem Gleichgewichtszustand anzunähern"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d2eb3d5-f96c-4c54-bd9b-794023a0e7dd",
                                                "sense_id": "398abf2f-1b72-3579-ad7a-14ad5c148ac2",
                                                "text": "Wir nehmen eine Wärmebehandlung vor, die zur Erholung und Rekristallisation des Aluminiums führt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4fb9536-47bd-4573-9058-2fa49219ca70",
                        "source_entry_id": "13307a86-eebd-3914-9c8e-38f36732c982",
                        "source_sense_id": "897b1a4d-fdee-3f50-9423-1aa81319af25",
                        "target_lang_word": "recreation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recreation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1dc24478-f9fd-36cd-95dc-f9c979259081",
                                        "entry_id": "81ede1b7-9d21-3770-9a9e-3c75255ee71f",
                                        "glosses": [
                                            "Any activity, such as play, that amuses, diverts or stimulates."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8816f326-3918-4ce8-8886-49a2efa2cfd1",
                                                "sense_id": "1dc24478-f9fd-36cd-95dc-f9c979259081",
                                                "text": "The ordinary recreations which we have in winter, and in most solitary times busy our minds with, are cards, tables and dice, shovelboard, chess-play, the philosopher's game, small trunks, shuttlecock […]"
                                            },
                                            {
                                                "example_id": "c36310b0-4b86-44fe-b664-d58d435db738",
                                                "sense_id": "1dc24478-f9fd-36cd-95dc-f9c979259081",
                                                "text": "Mercury contents did not affect recreation persay but definitely could if found in fish tissue at high levels."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "recreation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef1a3246-e049-3e45-bff7-0be615102d7c",
                                        "entry_id": "37b45b74-8639-3f2a-aa28-c22d6dc6a8ba",
                                        "glosses": [
                                            "The process of creating something again."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0b998814-13ab-3446-aa96-5e62581ac02f",
                                        "entry_id": "37b45b74-8639-3f2a-aa28-c22d6dc6a8ba",
                                        "glosses": [
                                            "The result of this process."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d97f40b8-268a-4579-8f29-0524f0965d09",
                                                "sense_id": "0b998814-13ab-3446-aa96-5e62581ac02f",
                                                "text": "Such abundance must be laid out on superfluous recreations, buildings, ornaments, furniture, equipage, attendants, entertainments, visitations, braveries, and a world of need-nots […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "937d5d25-1b78-462f-a398-ee8815f70db9",
                        "source_entry_id": "13307a86-eebd-3914-9c8e-38f36732c982",
                        "source_sense_id": "897b1a4d-fdee-3f50-9423-1aa81319af25",
                        "target_lang_word": "récréation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "récréation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "24e7bc69-dcae-313d-b474-6d289ffe634d",
                                        "entry_id": "e52ea509-d46e-32e3-878b-35f09ddb16b8",
                                        "glosses": [
                                            "Occupation, exercice qui fait diversion au travail et qui sert de délassement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e4548c4-af67-4711-9b68-0c30011b9952",
                                                "sense_id": "24e7bc69-dcae-313d-b474-6d289ffe634d",
                                                "text": "[…], il a constaté que la guerre en Mandchourie manquait de récréations galantes, alors il a chargé ses hommes de confiance de lui recruter pour Moukden un lot de jeunes beautés dont la mission serait de chanter en petit comité pour distraire ses camarades de l'état-major, entre deux combats."
                                            },
                                            {
                                                "example_id": "52fb970b-3c4b-40b3-8ef1-cdf9321906eb",
                                                "sense_id": "24e7bc69-dcae-313d-b474-6d289ffe634d",
                                                "text": "Cheminant vers la rue Saint-Joseph, elle songe avec nostalgie à l'ancienne Suzanne, celle qui s’épivardait dans la rue avec ses enfants pendant les récréations et qui, parfois, grimpait au pommier en déchirant sa jupe..."
                                            },
                                            {
                                                "example_id": "33997924-2d83-445a-85ef-a1f6caa94905",
                                                "sense_id": "24e7bc69-dcae-313d-b474-6d289ffe634d",
                                                "text": "Prendre un peu de récréation après le travail."
                                            },
                                            {
                                                "example_id": "1ec9f195-5d7c-4532-a2fa-1e42cf9434f6",
                                                "sense_id": "24e7bc69-dcae-313d-b474-6d289ffe634d",
                                                "text": "Aussitôt qu’elle me voyait fatiguée, elle m’asseyait de force sur une chaise, et elle disait avec une autorité souriante :\n— Prends ta récréation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "834ac296-a735-324c-9a53-e1d433136f82",
                                        "entry_id": "e52ea509-d46e-32e3-878b-35f09ddb16b8",
                                        "glosses": [
                                            "Dans les maisons d’éducation et dans les communautés religieuses, temps accordé aux élèves, aux religieux pour se délasser, pour se divertir."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d880bc40-2bd4-4260-b521-755752d74ad8",
                                                "sense_id": "834ac296-a735-324c-9a53-e1d433136f82",
                                                "text": "Cet écolier, ce religieux est à la récréation, en récréation, Il est avec les autres à prendre sa récréation."
                                            },
                                            {
                                                "example_id": "0926fb2a-15a3-4236-a7e0-0c1ccd11aa95",
                                                "sense_id": "834ac296-a735-324c-9a53-e1d433136f82",
                                                "text": "Face à la vague de chaleur qui terrasse l’Argentine depuis près de deux semaines, une école de Rosario (nord) autorise les enfants à venir en maillot de bain pour pouvoir les asperger à la récréation."
                                            },
                                            {
                                                "example_id": "c160a5d2-0a45-49f4-98f2-4db509fcc1c1",
                                                "sense_id": "834ac296-a735-324c-9a53-e1d433136f82",
                                                "text": "– Quelquefois, disait-il, à la récréation, au lieu de jouer avec les camarades, je vais m’asseoir sur un banc, sans rien faire.\n– Tiens, quelle drôle d’idée ; tu dois t’ennuyer, pourtant !\n– Oh ! oui, mais comme ça, la récréation me paraît plus longue, tu comprends !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ad371e5-310b-344f-bf6a-0225c446437c",
                                        "entry_id": "e52ea509-d46e-32e3-878b-35f09ddb16b8",
                                        "glosses": [
                                            "Divers ouvrages où l’on tire de la science des sujets de récréation."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e9e62ef-ed0d-40da-a482-b7e22bf286aa",
                                                "sense_id": "2ad371e5-310b-344f-bf6a-0225c446437c",
                                                "text": "Ce savant composa des récréations mathématiques, des Récréations philologiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
