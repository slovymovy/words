                "entry_id": "93d53b72-8fc9-3866-9235-a67d9c22fdf7",
                "word": "vuilnisophaler",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "5263188b-4a76-496f-8a01-3b34f0fb24d8",
                        "entry_id": "93d53b72-8fc9-3866-9235-a67d9c22fdf7",
                        "tags": [
