                "senses": [
                    {
                        "sense_id": "b2f283fe-47ee-3a86-a5da-ba322fb5b13f",
                        "entry_id": "b34935d9-b138-301b-89db-24182d273a47",
                        "glosses": [
                            "een voorziening, hulpmiddel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ccff83e-6ce9-407d-9fb7-a044f4369997",
                                "sense_id": "b2f283fe-47ee-3a86-a5da-ba322fb5b13f",
                                "text": "Er waren genoeg faciliteiten aanwezig om sport te beoefenen."
                            }
                        ]
                    },
                    {
                        "sense_id": "e0d1ed89-e2d5-34a4-b453-e559520aca90",
                        "entry_id": "b34935d9-b138-301b-89db-24182d273a47",
