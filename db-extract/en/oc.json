                "senses": [
                    {
                        "sense_id": "40130afc-78d2-3718-87c5-6b670f5471bd",
                        "entry_id": "11780c9f-096a-35fc-8452-85436f8c1f33",
                        "glosses": [
                            "Initialism of original content."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
