                    "sense_id": "d59a2859-9a08-34ff-bbe8-d5405f2bcce3",
                    "sense_definition": "Le jour où l'on est actuellement, ce jour-ci.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "jour_present",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Quel jour sommes-nous <w>aujourd'hui</w> ?",
                            "target_lang_translations": {
                                "en": "What day is it <w>today</w>?",
                                "ru": "Какое <w>сегодня</w> число?",
                                "nl": "Welke dag is het <w>vandaag</w>?",
                                "de": "Welchen Tag haben wir <w>heute</w>?",
                                "pl": "Jaki dzień mamy <w>dzisiaj</w>?",
                                "it": "Che giorno è <w>oggi</w>?",
                                "cs": "Jaký den máme <w>dnes</w>?",
                                "tr": "<w>Bugün</w> günlerden ne?",
                                "es": "¿Qué día es <w>hoy</w>?",
                                "zh": "<w>今天</w>是星期几？"
                            }
                        },
                        {
                            "text": "Il fait très beau <w>aujourd'hui</w> et nous allons nous promener au parc.",
                            "target_lang_translations": {
                                "en": "The weather is really nice <w>today</w>, and we're going for a walk in the park.",
                                "ru": "<w>Сегодня</w> очень хорошая погода, и мы пойдём гулять в парк.",
                                "nl": "Het is <w>vandaag</w> heel mooi weer en we gaan een wandeling maken in het park.",
                                "de": "Das Wetter ist <w>heute</w> sehr schön, und wir machen einen Spaziergang im Park.",
                                "pl": "Pogoda jest <w>dzisiaj</w> bardzo ładna i wybieramy się na spacer do parku.",
                                "it": "<w>Oggi</w> fa davvero bel tempo e andiamo a fare una passeggiata al parco.",
                                "cs": "<w>Dnes</w> je moc hezky a jdeme se projít do parku.",
                                "tr": "<w>Bugün</w> hava çok güzel, parka yürüyüşe çıkacağız.",
                                "es": "<w>Hoy</w> hace muy buen tiempo y vamos a dar un paseo por el parque.",
                                "zh": "<w>今天</w>天气很好，我们要去公园散步。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ce jour"
                    ],
                    "antonyms": [
                        "hier",
                        "demain"
                    ],
                    "common_phrases": [
                        "aujourd'hui même",
                        "dès aujourd'hui"
                    ],
                    "target_lang_definitions": {
                        "en": "The day that is happening right now, the current calendar date.",
                        "ru": "День, который наступает сейчас, текущая календарная дата.",
                        "nl": "De dag waarop we nu zijn, de huidige kalenderdag.",
                        "de": "Der Tag, an dem man sich gerade befindet, also der laufende Kalendertag.",
                        "pl": "Dzień, w którym właśnie jesteśmy, czyli obecna data kalendarzowa.",
                        "it": "Il giorno in cui ci si trova al momento, la data del calendario attuale.",
                        "cs": "Den, ve kterém se právě nacházíme, tedy aktuální kalendářní datum.",
                        "tr": "İçinde bulunduğumuz takvim günü, şu anki gün.",
                        "es": "El día en que nos encontramos en este momento, la fecha actual del calendario.",
                        "zh": "指说话时所处的这一天，即当前的日历日期。"
                    },
