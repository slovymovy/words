                        "bénéficier d'une réduction",
                        "carte de réduction"
                    ]
                },
                {
                    "sense_id": "6d95c5bc-732e-3b75-a86c-532144562cbc",
                    "sense_definition": "Action de diminuer une quantité, une taille, une durée ou une intensité ; résultat de cette action.",
