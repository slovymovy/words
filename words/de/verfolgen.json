    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "21440177-85e1-3fb0-b119-91d42f55420d",
                    "sense_definition": "hinter jemandem oder etwas hergehen oder herfahren, um die Person oder Sache einzuholen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "nachgehen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zwei Polizeiwagen <w>verfolgten</w> das verdächtige Auto durch die engen Straßen."
                        },
                        {
                            "text": "Der Wachhund <w>verfolgte</w> den Einbrecher bis zum Zaun des Gartens."
                        }
                    ],
                    "synonyms": [
                        "nachjagen",
                        "nachstellen"
                    ],
                    "antonyms": [
                        "fliehen"
                    ],
                    "common_phrases": [
                        "eine Spur verfolgen",
                        "jemanden auf Schritt und Tritt verfolgen"
                    ]
                },
                {
                    "sense_id": "bace6170-64d6-3829-8a3e-d02da8004039",
