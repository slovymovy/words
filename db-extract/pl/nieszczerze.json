                        ]
                    },
                    {
                        "translation_id": "5189ea74-6b21-4f45-b857-67c690c5a557",
                        "source_entry_id": "886e6eb7-661d-36bd-9d7e-3908ff17f2ce",
                        "source_sense_id": "e5184f0f-11ac-3bd7-9efa-4799bb2b0a9f",
                        "target_lang_word": "disingenuously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disingenuously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8bbf6f32-8835-3127-bdae-27a65d3a83c4",
                                        "entry_id": "c35e591b-51da-3e2c-9f53-357b688b9c93",
                                        "glosses": [
                                            "In a manner that is not frank or open; deceptively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa375b9f-1449-4da6-8a3d-e4eee09f2575",
                                                "sense_id": "8bbf6f32-8835-3127-bdae-27a65d3a83c4",
                                                "text": "Instead of inquiring why the facts oppose the theory, and where the explanation is to be found for this remarkable discrepancy, he disingenuously endeavours to give reasons for \"the causes which operated, and do commonly operate, to prevent these extraordinary drafts on the productive resources of the country from being so much felt as it might seem reasonable to expect.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc7719ed-a6e2-3d2b-b255-a36fe5dbe9a0",
                                        "entry_id": "c35e591b-51da-3e2c-9f53-357b688b9c93",
                                        "glosses": [
                                            "In an unnoble manner; in a manner unbecoming of true honor or dignity; unworthily."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d379d88-804d-4109-9890-4bb37e620c7e",
                                                "sense_id": "fc7719ed-a6e2-3d2b-b255-a36fe5dbe9a0",
                                                "text": "The letter's false intent trumps any truths within, which one would expect of a woman who disingenuously calls herself Fidessa."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f14048a4-4982-3bce-bdb2-ed6c03099073",
                                        "entry_id": "c35e591b-51da-3e2c-9f53-357b688b9c93",
                                        "glosses": [
                                            "In a manner that adopts a pose of naïveté, possibly to make a point or to deceive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21b0b0ff-0398-46f8-ba14-c0e07448aebf",
                                                "sense_id": "f14048a4-4982-3bce-bdb2-ed6c03099073",
                                                "text": "Churchill, a month later, would memorably if disingenuously describe Lend-Lease as a matter of \"Give us the tools and we will finish the job.\" Roosevelt, a few days earlier, had described it a bit more prosaically, but no less disingenuously, as the equivalent of lending a neighbor whose house was on fire a garden hose, expecting to get it back when the fire was out."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
