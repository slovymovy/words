                        ],
                        "examples": [
                            {
                                "example_id": "b6f700b0-ea54-418b-947d-66cb01604d55",
                                "sense_id": "3e89c917-b580-3823-840e-dde663eb1c67",
                                "text": "„Nur wenige Fahrradminuten von Stralsund entfernt, nicht weit von Greifswald und Grimmen und mitten in Vorpommern liegt das kleine Naturschutzgebiet Niederhof und damit eine von Deutschlands größten Kormorankolonien.“"
                            },
                            {
                                "example_id": "b426c416-2739-4c97-9369-d86bae731ab3",
                                "sense_id": "3e89c917-b580-3823-840e-dde663eb1c67",
                                "text": "„Der Weg, den ich suche, ist nur eine Fahrradminute entfernt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
