                                                "sense_id": "61a6615a-5d22-34d5-95a7-9f3c53ebf739",
                                                "text": "A treatment or cure is applied after a medical problem has already started."
                                            },
                                            {
                                                "example_id": "c4f9a85e-08ec-4d5c-a10b-919c261c8306",
                                                "sense_id": "61a6615a-5d22-34d5-95a7-9f3c53ebf739",
                                                "text": "Cancer survivors who got radiation treatments as children have nearly twice the risk of developing diabetes as adults."
                                            },
                                            {
                                                "example_id": "7b3d26e4-3a3f-44db-b568-d52cb57f084b",
                                                "sense_id": "61a6615a-5d22-34d5-95a7-9f3c53ebf739",
                                                "text": "The change is due largely to the increased availability of antiretroviral treatment."
                                            }
