                        "glosses": [
                            "następujący po przejściu grypy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6c55a81-248a-4bfd-9536-8641a7932a9e",
                                "sense_id": "cb7a74de-13e2-3962-8d4f-6a39e5eeed16",
                                "text": "Powikłania te stanowią 20-25% wszystkich pogrypowych powikłań neurologicznych, przy czym w oddziałach zakaźnych odsetek ten może wzrastać do 50%"
                            },
                            {
                                "example_id": "88dc5656-57ea-4561-91b5-94a9120f714c",
                                "sense_id": "cb7a74de-13e2-3962-8d4f-6a39e5eeed16",
                                "text": "Bywa, że pogrypowe zapalenie mięśnia sercowego kończy się niewydolnością serca, co może prowadzić nawet do śmierci"
                            }
                        ],
