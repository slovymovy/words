                "senses": [
                    {
                        "sense_id": "be3a22f0-774f-3910-944b-721c5b8635c6",
                        "entry_id": "63a5f791-b78f-345a-9d09-dea3d3bdcc0a",
                        "glosses": [
                            "die Einschränkung der persönlichen Freiheit einer Person durch Behörden oder Gerichte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0164106-2a05-4638-85fe-63da123e7af9",
                                "sense_id": "be3a22f0-774f-3910-944b-721c5b8635c6",
                                "text": "Er wurde zu lebenslänglichem Freiheitsentzug verurteilt."
                            },
                            {
                                "example_id": "45fd153d-c196-40d6-a1a0-d34bdd345837",
                                "sense_id": "be3a22f0-774f-3910-944b-721c5b8635c6",
                                "text": "Der elektronische Hausarrest ist eine Alternative zum stationären Freiheitsentzug."
                            },
                            {
                                "example_id": "3ecdd367-94f2-4e44-a163-d9eec457dffb",
                                "sense_id": "be3a22f0-774f-3910-944b-721c5b8635c6",
                                "text": "Kann Freiheitsentzug bei dementen Personen als Schutz- oder Zwangsmaßnahme eingesetzt werden?"
                            },
                            {
                                "example_id": "9d593f25-2e69-489e-9960-30665846617e",
                                "sense_id": "be3a22f0-774f-3910-944b-721c5b8635c6",
                                "text": "„Fünfzehn Jahre Freiheitsentzug forderte Rudenko.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2502038a-da11-4c7d-a7ec-963002ee5134",
                        "source_entry_id": "63a5f791-b78f-345a-9d09-dea3d3bdcc0a",
                        "source_sense_id": "be3a22f0-774f-3910-944b-721c5b8635c6",
                        "source_sense_description": "die Einschränkung der persönlichen Freiheit einer Person durch Behörden oder Gerichte",
                        "target_lang_word": "imprisonment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imprisonment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49ba17c8-3399-3632-a40f-d7c5e2ed5cb5",
                                        "entry_id": "fe5aedf6-b95e-3f90-8902-576163ce428b",
                                        "glosses": [
                                            "A confinement in a place, especially a prison or a jail, especially as punishment for a crime."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "703723e8-a699-43b7-b7e0-5522de697c08",
                                                "sense_id": "49ba17c8-3399-3632-a40f-d7c5e2ed5cb5",
                                                "text": "His sinews woxen weake and raw / Through long emprisonment and hard constraint."
                                            },
                                            {
                                                "example_id": "3ac79ea7-a2c2-47f0-8141-7d1d309527b4",
                                                "sense_id": "49ba17c8-3399-3632-a40f-d7c5e2ed5cb5",
                                                "text": "Every confinement of the person is an imprisonment, whether it be in a common prison, or in a private house, or even by forcibly detaining one in the public streets."
                                            },
                                            {
                                                "example_id": "567f1ae2-8bd0-4bd3-9da4-3a7859e2107d",
                                                "sense_id": "49ba17c8-3399-3632-a40f-d7c5e2ed5cb5",
                                                "text": "Oh, by what plots, by what forswearings, betrayings, oppressions, imprisonments, tortures, poisonings, and under what reasons of state and politic subtilty, have these forenamed kings […] pulled the vengeance of God upon themselves […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
