                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "531b5a96-9f29-4469-8737-ac4564c06e19",
                        "source_entry_id": "2100373d-546f-33b5-a31d-fa3b026c0d05",
                        "source_sense_id": "caadefae-e2d1-3b63-b87c-f7d0c59ab7f2",
                        "source_sense_description": "Slovakia",
                        "target_lang_word": "Slovaquie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Slovaquie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f2ef79e1-88dc-347d-aa5e-b2a2f3a9c9e5",
                                        "entry_id": "46552aaf-8244-3632-94ad-f8d5137dbfad",
                                        "glosses": [
                                            "Pays d’Europe, entouré par l’Ukraine à l’est, la Pologne au nord, la République tchèque à l'ouest-nord-ouest, l’Autriche à l’ouest-sud-ouest et la Hongrie au sud, et dont la capitale est Bratislava."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a37992ad-3494-4fb9-93aa-73a4c5430de5",
                                                "sense_id": "f2ef79e1-88dc-347d-aa5e-b2a2f3a9c9e5",
                                                "text": "Le désastre de Mohacz (1526) où mourut le roi Louis II ouvre pour la Hongrie et la Slovaquie la période de domination ottomane qui dure jusqu’au traité de Požarevac (1718)."
                                            },
                                            {
                                                "example_id": "9623659f-51ff-4376-a7b9-d300a8e64004",
                                                "sense_id": "f2ef79e1-88dc-347d-aa5e-b2a2f3a9c9e5",
                                                "text": "La Tchéquie devient protectorat de Bohême-Moravie, et, quoique indépendante sous la houlette de Mgr Tizo, la Slovaquie a consenti d'importantes facilités stratégiques au Reich."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "edfa6a92-f709-4fdc-96f9-2529d8442c5d",
                        "source_entry_id": "2100373d-546f-33b5-a31d-fa3b026c0d05",
                        "source_sense_id": "caadefae-e2d1-3b63-b87c-f7d0c59ab7f2",
                        "source_sense_description": "Slovakia",
                        "target_lang_word": "Slowakei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Slowakei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "66c21f1a-d410-3b87-8f8c-9512e299473e",
                                        "entry_id": "cc9c552f-f434-3686-b075-82539975bbd6",
                                        "glosses": [
                                            "Land in Mitteleuropa, genauer in Ostmitteleuropa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66c26df2-41f0-41ed-acea-ade5eab74f95",
                                                "sense_id": "66c21f1a-d410-3b87-8f8c-9512e299473e",
                                                "text": "Wir machen Urlaub in der Slowakei."
                                            },
                                            {
                                                "example_id": "d537abb8-1437-47e0-b5d6-f4e2632edf62",
                                                "sense_id": "66c21f1a-d410-3b87-8f8c-9512e299473e",
                                                "text": "Pressburg ist die Hauptstadt der Slowakei."
                                            },
                                            {
                                                "example_id": "03059fc5-0fad-4a60-b719-68719460c7e1",
                                                "sense_id": "66c21f1a-d410-3b87-8f8c-9512e299473e",
                                                "text": "„Der Vortragende … ist in der Slowakei keine unbekannte Person:…“"
                                            },
                                            {
                                                "example_id": "2522671f-4120-4396-a42f-00b634771c28",
                                                "sense_id": "66c21f1a-d410-3b87-8f8c-9512e299473e",
                                                "text": "„Es sind vor allem zwei große geschichtliche Verknotungen, die Tschechen und Deutsche – von den Slowaken war bis ins 20. Jahrhundert hinein keine Rede, und was man später die Slowakei nannte, hieß bis 1918 Oberungarn – gegeneinander hetzten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf5a6bb8-72d2-49c6-bcbd-bb93d4c5f48d",
