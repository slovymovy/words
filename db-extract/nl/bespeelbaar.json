                                            {
                                                "example_id": "5234b1ce-6e3c-419a-965b-0ae61e6dcd85",
                                                "sense_id": "1bf50511-bdfe-3e90-8769-6d6d682409ed",
                                                "text": "Weil die CD bespielbar ist, brannte er seine Musik darauf."
                                            }
