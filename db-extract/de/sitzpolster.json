                "senses": [
                    {
                        "sense_id": "30feff14-7f5b-3833-986e-3e76ed4a015b",
                        "entry_id": "58bd8785-11b8-3536-bc84-b37c64c8a9a7",
                        "glosses": [
                            "weicher (gepolsterter) Bezug oder weiche Auflage auf einem Sitz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af1691da-9a0d-45a5-862f-7d828807a6c8",
                                "sense_id": "30feff14-7f5b-3833-986e-3e76ed4a015b",
                                "text": "„Die zweite Kalesche gibt es noch, allerdings in kläglichem Zustand: Die Sitzpolster wurden kreuz und quer aufgeschnitten.“"
                            },
                            {
                                "example_id": "b47c093a-371b-44f8-ac14-114f1e3091a1",
                                "sense_id": "30feff14-7f5b-3833-986e-3e76ed4a015b",
                                "text": "Bei unseren Kindersitztests würde eine Sitzerhöhung ohne Rückenlehne mit „nicht genügend“ durchfallen, da der Sitzpolster einem Seitencrash nicht genügend standhalten kann."
                            },
                            {
                                "example_id": "5fa6d455-4e99-4593-9985-b653c76564ff",
                                "sense_id": "30feff14-7f5b-3833-986e-3e76ed4a015b",
                                "text": "„Wahrscheinlich legte sie schon Sitzpolster auf die Gartenstühle.“"
                            },
                            {
                                "example_id": "e85bec5c-1b70-4744-ba41-f21579f580dd",
                                "sense_id": "30feff14-7f5b-3833-986e-3e76ed4a015b",
                                "text": "„Sie nahm den Rucksack ab, öffnete ihn, löste das Rückenpolster aus Schaumstoff heraus und legte es als Sitzpolster in den Schnee.“"
                            },
                            {
                                "example_id": "935a94c0-f934-48fb-891a-6f31f5307a88",
                                "sense_id": "30feff14-7f5b-3833-986e-3e76ed4a015b",
                                "text": "„Schließlich zog ich die Sitzpolster heraus, legte mich auf das Gestell und türmte so viele Polster und Kissen über mir auf, bis alles wieder einstürzte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2cba685d-060c-4248-87b5-a639bc8872e3",
                        "source_entry_id": "58bd8785-11b8-3536-bc84-b37c64c8a9a7",
                        "source_sense_id": "30feff14-7f5b-3833-986e-3e76ed4a015b",
                        "source_sense_description": "weicher (gepolsterter) Bezug oder weiche Auflage auf einem Sitz",
                        "target_lang_word": "seat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8240cf44-d675-3da1-8111-701f798ac83b",
                                        "entry_id": "034f3455-5c50-3151-90f0-14daf1c4e807",
                                        "glosses": [
                                            "Something to be sat upon.",
                                            "A place in which to sit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7df75e2c-2aa1-4370-b830-5599ba3c8ee9",
                                                "sense_id": "8240cf44-d675-3da1-8111-701f798ac83b",
                                                "text": "There are two hundred seats in this classroom."
                                            },
                                            {
                                                "example_id": "ac6e53d9-2606-4a11-a1db-8649e7e5284e",
                                                "sense_id": "8240cf44-d675-3da1-8111-701f798ac83b",
                                                "text": "The humor of my proposition appealed more strongly to Miss Trevor than I had looked for, and from that time forward she became her old self again;[…]. Our table in the dining-room became again the abode of scintillating wit and caustic repartee, Farrar bracing up to his old standard, and the demand for seats in the vicinity rose to an animated competition."
                                            },
                                            {
                                                "example_id": "670529bd-21f5-43a5-a1c8-0111374244cb",
                                                "sense_id": "8240cf44-d675-3da1-8111-701f798ac83b",
                                                "text": "[…] Grand Union proposes making a seat part of the price of a ticket, with 50% refunds for those travelling for longer than 30 minutes unable to obtain a seat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7512e3f-c012-311e-9a3f-378ca46ed5f9",
                                        "entry_id": "034f3455-5c50-3151-90f0-14daf1c4e807",
                                        "glosses": [
                                            "Something to be sat upon.",
                                            "The horizontal portion of a chair or other furniture designed for sitting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5c2bd03-0942-4145-b5ae-97b9e21f230a",
                                                "sense_id": "e7512e3f-c012-311e-9a3f-378ca46ed5f9",
                                                "text": "He sat on the arm of the chair rather than the seat, which always annoyed his mother."
                                            },
                                            {
                                                "example_id": "2402dd29-38e2-4060-8f9a-3bafd7529456",
                                                "sense_id": "e7512e3f-c012-311e-9a3f-378ca46ed5f9",
                                                "text": "the seat of a saddle"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bd72620-eff7-315f-98e3-9101bad2d6bb",
                                        "entry_id": "034f3455-5c50-3151-90f0-14daf1c4e807",
                                        "glosses": [
                                            "Something to be sat upon.",
                                            "A piece of furniture made for sitting, such as a chair, stool, or bench; any improvised place for sitting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c6fc91f-d810-4cc9-ac65-331c7ea5b2cc",
                                                "sense_id": "8bd72620-eff7-315f-98e3-9101bad2d6bb",
                                                "text": "She pulled the seat from under the table to allow him to sit down."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3745b31-6f41-370e-b2de-55f410345078",
                                        "entry_id": "034f3455-5c50-3151-90f0-14daf1c4e807",
                                        "glosses": [
                                            "Something to be sat upon.",
                                            "A piece of furniture made for sitting, such as a chair, stool, or bench; any improvised place for sitting.",
                                            "An ejection seat."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a50f32ee-bfbc-4be7-a299-f0fa8dd7607e",
                                                "sense_id": "c3745b31-6f41-370e-b2de-55f410345078",
                                                "text": "Hey, fighter boy, our radar's putting out enough energy to launch your seat from this distance!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75e78b3a-4fa9-3b67-ab85-192d1ba216d3",
                                        "entry_id": "034f3455-5c50-3151-90f0-14daf1c4e807",
                                        "glosses": [
                                            "Something to be sat upon.",
                                            "The part of an object or individual (usually the buttocks) directly involved in sitting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92c8ee4c-d294-49de-b8e9-c113d9a362eb",
                                                "sense_id": "75e78b3a-4fa9-3b67-ab85-192d1ba216d3",
                                                "text": "Instead of saying \"sit down\", she said \"place your seat on this chair\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f205ede1-64f0-3250-8c35-eb2b68f8a0de",
                                        "entry_id": "034f3455-5c50-3151-90f0-14daf1c4e807",
                                        "glosses": [
                                            "Something to be sat upon.",
                                            "The part of a piece of clothing (usually pants or trousers) covering the buttocks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8edeb46-9f44-45ef-b99e-421ca3f784ce",
                                                "sense_id": "f205ede1-64f0-3250-8c35-eb2b68f8a0de",
                                                "text": "The seat of these trousers is almost worn through."
                                            },
                                            {
                                                "example_id": "345e889f-59e6-4c85-8055-86fad9f0c588",
                                                "sense_id": "f205ede1-64f0-3250-8c35-eb2b68f8a0de",
                                                "text": "Several pressmen have nearly lost their lives, to say nothing of the seats of their trousers, from these creatures."
                                            },
                                            {
                                                "example_id": "a2671a8c-72a8-44fb-8e7b-fedf5d70d172",
                                                "sense_id": "f205ede1-64f0-3250-8c35-eb2b68f8a0de",
                                                "text": "I love these new biker pants I bought! There's padding in the seat to protect my rear end."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38165503-dcc2-3faf-8d00-5bd3a5ceff82",
                                        "entry_id": "034f3455-5c50-3151-90f0-14daf1c4e807",
                                        "glosses": [
                                            "Something to be sat upon.",
                                            "A part or surface on which another part or surface rests."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bde40bf6-3fde-46cf-ad7c-275a660e92f9",
                                                "sense_id": "38165503-dcc2-3faf-8d00-5bd3a5ceff82",
                                                "text": "The seat of the valve had become corroded."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d6d172c-eec9-3072-a1a7-5214429ac54f",
                                        "entry_id": "034f3455-5c50-3151-90f0-14daf1c4e807",
                                        "glosses": [
                                            "A location or site.",
                                            "A membership in an organization, particularly a representative body."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e3c69fa-2433-4066-925e-72ab3b92b1e3",
                                                "sense_id": "3d6d172c-eec9-3072-a1a7-5214429ac54f",
                                                "text": "Our neighbor has a seat at the stock exchange and in congress."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c02dea64-11b5-30d6-a1ab-723c8a28f00f",
                                        "entry_id": "034f3455-5c50-3151-90f0-14daf1c4e807",
                                        "glosses": [
                                            "A location or site.",
                                            "The location of a governing body."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a97872ae-cc74-4ad2-a6b0-c8253a258db4",
                                                "sense_id": "c02dea64-11b5-30d6-a1ab-723c8a28f00f",
                                                "text": "Washington D.C. is the seat of the U.S. government."
                                            },
                                            {
                                                "example_id": "89febe0a-32f2-4a68-b72e-84541e29f543",
                                                "sense_id": "c02dea64-11b5-30d6-a1ab-723c8a28f00f",
                                                "text": "The K'o-tzu-lo-su Kirghiz chou bordered on the K'o-shih chuan-ch'ü and its seat at A-t'u-shih was only twenty-five kilometers from K'o-shih shih."
                                            },
                                            {
                                                "example_id": "00d4bd97-1951-40e3-a60c-90319615e107",
                                                "sense_id": "c02dea64-11b5-30d6-a1ab-723c8a28f00f",
                                                "text": "But how the neurons are organised in these lobes and ganglia remains obscure. Yet this is the level of organisation that does the actual thinking—and is, presumably, the seat of consciousness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3464aae6-c3f2-3c58-810a-2d62c3cb7fa6",
                                        "entry_id": "034f3455-5c50-3151-90f0-14daf1c4e807",
                                        "glosses": [
                                            "A location or site.",
                                            "An electoral district, especially for a national legislature."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7c9d977a-1395-3203-bbc7-45497f4da2b3",
                                        "entry_id": "034f3455-5c50-3151-90f0-14daf1c4e807",
                                        "glosses": [
                                            "A location or site.",
                                            "A temporary residence, such as a country home or a hunting lodge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79f98c46-aa29-45f6-95b2-842de993593e",
                                                "sense_id": "7c9d977a-1395-3203-bbc7-45497f4da2b3",
                                                "text": "A man of fortune, who lives in London, may, in plays, operas, routs, assemblies, French cookery, French sauces, and French wines, spend as much yearly, as he could do, were he to live in the most hospitable manner at his seat in the country."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "838a1c48-fbfe-3ebb-94bb-077fd18bcc2c",
                                        "entry_id": "034f3455-5c50-3151-90f0-14daf1c4e807",
                                        "glosses": [
                                            "A location or site.",
                                            "The place occupied by anything, or where any person, thing or quality is situated or resides; a site."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e48df346-935d-424d-8105-8a788187f301",
                                                "sense_id": "838a1c48-fbfe-3ebb-94bb-077fd18bcc2c",
                                                "text": "Where thou dwellest, even where Satan's seat is."
                                            },
                                            {
                                                "example_id": "f093c664-d860-49ec-b010-53a2c88a0f8d",
                                                "sense_id": "838a1c48-fbfe-3ebb-94bb-077fd18bcc2c",
                                                "text": "He that builds a fair house upon an ill seat committeth himself to prison."
                                            },
                                            {
                                                "example_id": "a6c1ef10-8340-408e-9be3-f1fdf6b3d904",
                                                "sense_id": "838a1c48-fbfe-3ebb-94bb-077fd18bcc2c",
                                                "text": "a seat of plenty, content, and tranquillity"
                                            },
                                            {
                                                "example_id": "aec059d5-e737-4688-9f73-db21f5c6a752",
                                                "sense_id": "838a1c48-fbfe-3ebb-94bb-077fd18bcc2c",
                                                "text": "I stopped taking the sweets and condiments I had got from home. The mind having taken a different turn, the fondness for condiments wore away, and I now relished the boiled spinach which in Richmond tasted insipid, cooked without condiments. Many such experiments taught me that the real seat of taste was not the tongue but the mind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76c7c52b-6321-3b85-8f8c-5e940daee1ad",
                                        "entry_id": "034f3455-5c50-3151-90f0-14daf1c4e807",
                                        "glosses": [
                                            "A location or site.",
                                            "One of a series of departmental placements given to a trainee solicitor as part of their training contract."
                                        ],
                                        "tags": [
                                            "England",
                                            "Wales"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1d6057dc-b3d8-37cf-8c4f-c840f4c47f2d",
                                        "entry_id": "034f3455-5c50-3151-90f0-14daf1c4e807",
                                        "glosses": [
                                            "A location or site.",
                                            "Any of several autonomous regions in the medieval Kingdom of Hungary."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "789fb4d2-8535-31a5-b4d0-8f94bcb918c0",
                                        "entry_id": "034f3455-5c50-3151-90f0-14daf1c4e807",
                                        "glosses": [
                                            "The starting point of a fire."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc361e09-1d05-34e2-8e84-67045419d806",
                                        "entry_id": "034f3455-5c50-3151-90f0-14daf1c4e807",
                                        "glosses": [
                                            "Posture, or way of sitting, on horseback."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d87eb42-cdf7-4ad7-befe-b7882cef9d38",
                                                "sense_id": "bc361e09-1d05-34e2-8e84-67045419d806",
                                                "text": "She had so good a seat and hand she might be trusted with any mount."
                                            },
                                            {
                                                "example_id": "0cec1024-69e6-434f-8a87-f3b052284730",
                                                "sense_id": "bc361e09-1d05-34e2-8e84-67045419d806",
                                                "text": "George was a perfect picture on horseback; he had a light, firm seat, and seemed as if he were a part of his horse, and was only happy when away in the saddle for hours together, mustering cattle or tracking a missing horse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "seat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15166cf2-399a-3c3d-ae1a-0fda82ba59df",
                                        "entry_id": "1a651dee-093c-35ac-becc-fbba890c2b24",
                                        "glosses": [
                                            "To put an object into a place where it will rest; to fix; to set firm."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6aa6eab-8844-4a48-a51b-c4ded0607dbc",
                                                "sense_id": "15166cf2-399a-3c3d-ae1a-0fda82ba59df",
                                                "text": "Be sure to seat the gasket properly before attaching the cover."
                                            },
                                            {
                                                "example_id": "beb0b2eb-d53f-42b7-84b4-e4a6a97b9626",
                                                "sense_id": "15166cf2-399a-3c3d-ae1a-0fda82ba59df",
                                                "text": "From their foundations, loosening to and fro, / They plucked the seated hills."
                                            },
                                            {
                                                "example_id": "6131ade2-6605-46f3-9892-4a01d6d1386a",
                                                "sense_id": "15166cf2-399a-3c3d-ae1a-0fda82ba59df",
                                                "text": "One morning I had been driven to the precarious refuge afforded by the steps of the inn, after rejecting offers from the Celebrity to join him in a variety of amusements. But even here I was not free from interruption, for he was seated on a horse-block below me, playing with a fox terrier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76c35788-6784-3f0f-8099-e3d7780e0d1a",
                                        "entry_id": "1a651dee-093c-35ac-becc-fbba890c2b24",
                                        "glosses": [
                                            "To provide with a place to sit."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc7d50c7-e25c-4d5d-93cb-f42d54595305",
                                                "sense_id": "76c35788-6784-3f0f-8099-e3d7780e0d1a",
                                                "text": "This classroom seats two hundred students."
                                            },
                                            {
                                                "example_id": "07f8a33f-d9ae-481c-8484-56c74e7ec116",
                                                "sense_id": "76c35788-6784-3f0f-8099-e3d7780e0d1a",
                                                "text": "The waiter seated us and asked what we would like to drink."
                                            },
                                            {
                                                "example_id": "4d3e530f-ce09-4517-8bf3-70ee0ac4d17b",
                                                "sense_id": "76c35788-6784-3f0f-8099-e3d7780e0d1a",
                                                "text": "The guests were no sooner seated but they entered into a warm debate."
                                            },
                                            {
                                                "example_id": "22f7f4b7-d37f-430d-b742-2ca301c62df5",
                                                "sense_id": "76c35788-6784-3f0f-8099-e3d7780e0d1a",
                                                "text": "He used to seat you on the piano and then, with vehement gestures and pirouettings, would argue the case. Not one word of the speech did you understand."
                                            },
                                            {
                                                "example_id": "170fa5fe-812a-4aae-bf62-610da96ff6df",
                                                "sense_id": "76c35788-6784-3f0f-8099-e3d7780e0d1a",
                                                "text": "The older Jungfrau locomotives are of 330 h.p. only, but can push two coaches seating a total of 80 passengers up the 1 in 4 at 4 m.p.h."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "494e7301-fade-32c5-a4ea-9774a6debf87",
                                        "entry_id": "1a651dee-093c-35ac-becc-fbba890c2b24",
                                        "glosses": [
                                            "To request or direct one or more persons to sit."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78a8e734-502a-406e-b293-b839b9875b32",
                                                "sense_id": "494e7301-fade-32c5-a4ea-9774a6debf87",
                                                "text": "Please seat the audience after the anthem and then introduce the first speaker."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63fb0056-cc0c-3f51-bda2-fe1a1814e1aa",
                                        "entry_id": "1a651dee-093c-35ac-becc-fbba890c2b24",
                                        "glosses": [
                                            "To recognize the standing of a person or persons by providing them with one or more seats which would allow them to participate fully in a meeting or session."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e0be16f-670d-49a9-9aa6-8c86f12a9b2f",
                                                "sense_id": "63fb0056-cc0c-3f51-bda2-fe1a1814e1aa",
                                                "text": "Only half the delegates from the state were seated at the convention because the state held its primary too early."
                                            },
                                            {
                                                "example_id": "d817e0f4-9d1c-4430-b5a9-62ea08d3673f",
                                                "sense_id": "63fb0056-cc0c-3f51-bda2-fe1a1814e1aa",
                                                "text": "You have to be a member to be seated at the meeting. Guests are welcome to sit in the visitors section."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc4f7549-c409-30b2-bf4a-5c68c9545d2a",
                                        "entry_id": "1a651dee-093c-35ac-becc-fbba890c2b24",
                                        "glosses": [
                                            "To assign the seats of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f3279c4-68d0-49a8-823b-adfbd91e15e7",
                                                "sense_id": "fc4f7549-c409-30b2-bf4a-5c68c9545d2a",
                                                "text": "to seat a church"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "325e1f9b-9653-3200-b077-5435bb512532",
                                        "entry_id": "1a651dee-093c-35ac-becc-fbba890c2b24",
                                        "glosses": [
                                            "To cause to occupy a post, site, or situation; to station; to establish; to fix; to settle."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ccce7a2-ffa8-4ab2-a674-66f3d33b39ce",
                                                "sense_id": "325e1f9b-9653-3200-b077-5435bb512532",
                                                "text": "This valve isn't seating properly."
                                            },
                                            {
                                                "example_id": "aaf49719-01ae-426b-b45c-3decd3be9407",
                                                "sense_id": "325e1f9b-9653-3200-b077-5435bb512532",
                                                "text": "Thus high […] is King Richard seated."
                                            },
                                            {
                                                "example_id": "8433dc18-2247-4909-89bf-a6e54cb3619d",
                                                "sense_id": "325e1f9b-9653-3200-b077-5435bb512532",
                                                "text": "They had seated themselves in Nova Guiana."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8af6237f-96ab-39f0-9e04-a019d0545ef0",
                                        "entry_id": "1a651dee-093c-35ac-becc-fbba890c2b24",
                                        "glosses": [
                                            "To rest; to lie down."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d05f081b-16ff-47c4-a14f-7d51379dcee5",
                                                "sense_id": "8af6237f-96ab-39f0-9e04-a019d0545ef0",
                                                "text": "The folds, where sheepe at night doe seat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f099a8c8-1998-3363-99ab-699b508f929b",
                                        "entry_id": "1a651dee-093c-35ac-becc-fbba890c2b24",
                                        "glosses": [
                                            "To settle; to plant with inhabitants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcfd2162-1073-4f37-83bf-ddf30b8e0931",
                                                "sense_id": "f099a8c8-1998-3363-99ab-699b508f929b",
                                                "text": "to seat a country"
                                            },
                                            {
                                                "example_id": "090eeb40-5fd5-4580-9cb0-ce1ab2b00608",
                                                "sense_id": "f099a8c8-1998-3363-99ab-699b508f929b",
                                                "text": "The Plantations, for the most Part, are high and pleasantly seated"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75e9d013-4a26-3efa-b03d-ae472c90cc34",
                                        "entry_id": "1a651dee-093c-35ac-becc-fbba890c2b24",
                                        "glosses": [
                                            "To put a seat or bottom in."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e29335e-e9af-48f3-9f4b-1115beba1e24",
