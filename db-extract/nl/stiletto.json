                "senses": [
                    {
                        "sense_id": "50c4484a-bcac-3b57-9a9d-5bd88ee5426f",
                        "entry_id": "0c010c2b-9a7a-3aa5-9845-636623d9b9c0",
                        "glosses": [
                            "mes waarbij het lemmet uit het handvat kan klappen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9e24213-3d7c-4560-bf6f-188cf3139383",
                                "sense_id": "50c4484a-bcac-3b57-9a9d-5bd88ee5426f",
                                "text": "Hae-Joo gaf opdracht om de sluipweg te proberen. Daarna haalde hij een stiletto uit zijn zak, sneed het topje van zijn linker wijsvinger af en haalde er een metalen eitje uit."
                            }
                        ]
                    },
                    {
                        "sense_id": "130f5362-0735-382d-a83b-4fa34fa64de5",
                        "entry_id": "0c010c2b-9a7a-3aa5-9845-636623d9b9c0",
                        "glosses": [
                            "zeer hoge en spitse hak van een damesschoen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c2eb9d5e-ad67-3893-83b1-8af7b7259737",
                        "entry_id": "0c010c2b-9a7a-3aa5-9845-636623d9b9c0",
                        "glosses": [
                            "damesschoen met zeer hoge en spitse hak"
                        ],
                        "tags": [
                            "metonymisch",
                            "schoeisel"
                        ],
                        "examples": [
                            {
                                "example_id": "5529db13-3ff0-4d96-b8e3-28b0463b9e90",
                                "sense_id": "c2eb9d5e-ad67-3893-83b1-8af7b7259737",
                                "text": "‘Ben er niet zeker van dat Melania Trump voorbereid is voor de orkaan Harvey', twitterde iemand. 'Die stiletto’s moeten haar helpen boven het waterpeil te blijven', meende een ander, bijgevallen door nog een positivist: 'Heb je in aanmerking genomen hoe hoog het water in Texas staat'."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "043805d7-a5a2-4545-9c0c-a5f89ce7cb68",
                        "source_entry_id": "0c010c2b-9a7a-3aa5-9845-636623d9b9c0",
                        "source_sense_id": "50c4484a-bcac-3b57-9a9d-5bd88ee5426f",
                        "source_sense_description": "mes waarbij het lemmet uit het handvat kan klappen",
                        "target_lang_word": "Schnappmesser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schnappmesser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "19ca5f06-783a-3166-a52d-7436b6e6a757",
                                        "entry_id": "99340584-4899-3c5a-a1b3-6af012c07706",
                                        "glosses": [
                                            "Messer, bei dem die Klinge nach Betätigung eines Knopfes aus dem Messergriff hervorschnellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "680b5061-8466-4c43-b49f-2388490a6852",
                                                "sense_id": "19ca5f06-783a-3166-a52d-7436b6e6a757",
                                                "text": "„Er trug ein kleines Tonbandgerät über der kugelsicheren Weste. In der Tasche hatte er einen Beutel Heroin, ein Schnappmesser, eine 9mm Automatik.“"
                                            },
                                            {
                                                "example_id": "a9c7df98-e0d2-43b5-85c5-df55d79d8f01",
                                                "sense_id": "19ca5f06-783a-3166-a52d-7436b6e6a757",
                                                "text": "„Ich ging wieder in die Bar, hob das Schnappmesser auf, steckte es ein, setzte mich auf meinen Barhocker und bestellte noch einen Drink.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4be0cb57-12cb-4975-9274-6372e8cbf2be",
                        "source_entry_id": "0c010c2b-9a7a-3aa5-9845-636623d9b9c0",
                        "source_sense_id": "50c4484a-bcac-3b57-9a9d-5bd88ee5426f",
                        "source_sense_description": "mes waarbij het lemmet uit het handvat kan klappen",
                        "target_lang_word": "Springmesser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Springmesser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db5f1f03-8887-345d-9b86-3fd14dc734f6",
                                        "entry_id": "6837e82e-7dfd-3f6a-a1e4-308fdd2b0471",
                                        "glosses": [
                                            "Messer, bei dem die Klinge nach Betätigung eines Knopfes aus dem Messergriff hervorschnellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de6f4b80-3503-4c3d-b312-3218d5ebfd48",
                                                "sense_id": "db5f1f03-8887-345d-9b86-3fd14dc734f6",
                                                "text": "„Ein Springmesser, dessen Klinge auf Knopfdruck hervorschnellt und fixiert wird, ist hingegen eher nicht zum Erdäpfelschälen gedacht; es gilt als Waffe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f72f3f2-5a58-4fd7-876b-31d8e769bd25",
                        "source_entry_id": "0c010c2b-9a7a-3aa5-9845-636623d9b9c0",
                        "source_sense_id": "50c4484a-bcac-3b57-9a9d-5bd88ee5426f",
