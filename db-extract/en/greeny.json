                "senses": [
                    {
                        "sense_id": "1f67c9b3-29d5-31e1-ac51-7a97e3026c2f",
                        "entry_id": "d87e48db-0f3b-34cc-b0d9-b871f9d44d6b",
                        "glosses": [
                            "greenish; somewhat green"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7679ee27-864c-404e-927c-41e8a7ad9d85",
                                "sense_id": "1f67c9b3-29d5-31e1-ac51-7a97e3026c2f",
                                "text": "When we get them off their guard we have got to paint that red 'T' the greeniest green that ever came out of a greenhouse."
                            },
                            {
                                "example_id": "f13d69b5-4a8b-42b0-b6af-7bcfeefada5e",
                                "sense_id": "1f67c9b3-29d5-31e1-ac51-7a97e3026c2f",
                                "text": "Resentment showed in his face, greeny-brown and wrinkled like a baked apple,—resentment that white folks should pry into matters wholly Indian."
                            },
                            {
                                "example_id": "7925e153-1dfa-431b-bf96-1f2f3bc6b683",
                                "sense_id": "1f67c9b3-29d5-31e1-ac51-7a97e3026c2f",
                                "text": "In the end he settled for a very faint and tightly checked greeny shirt to go with his dark tweed jacket […]"
                            },
                            {
                                "example_id": "936e3cae-8935-4180-a612-e502387b31c5",
                                "sense_id": "1f67c9b3-29d5-31e1-ac51-7a97e3026c2f",
                                "text": "And my eyes are weird green grey. More greeny blue in daylight."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "1b6d4aea-170e-3dc4-bbc9-ae051cc1a63d",
                "word": "Greeny",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ac9c9632-297d-3e2b-9b81-32a412747ffd",
                        "entry_id": "1b6d4aea-170e-3dc4-bbc9-ae051cc1a63d",
                        "glosses": [
                            "A nickname of the surname Green."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d283090a-6ad8-3794-8ff5-8e01402b32e7",
                        "entry_id": "1b6d4aea-170e-3dc4-bbc9-ae051cc1a63d",
                        "glosses": [
                            "A nickname for someone (e.g., a fictional character or a creature of myth) who is green."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9786a3e2-bb5b-405d-b854-5e3493dceffe",
                                "sense_id": "d283090a-6ad8-3794-8ff5-8e01402b32e7",
                                "text": "Eh? What are you saying? Goblins are people too?! HELL NO! Goblins are responsible for all the world's evils! We must CLEANSE Enroth of the Goblin scum that has infested it! DOWN WITH GREENY!"
                            },
                            {
                                "example_id": "fd0f06aa-a20f-4de9-90c4-414d08c69a9c",
                                "sense_id": "d283090a-6ad8-3794-8ff5-8e01402b32e7",
                                "text": "Terra: It's a freaking nightmare. Just leave me alone. I'm okay, so get going. You heard me. Get going. You too, Greeny. [referring to Beast Boy, a superhero with green skin]"
                            }
                        ]
                    }
                ],
