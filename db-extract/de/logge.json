                "senses": [
                    {
                        "sense_id": "dedf8ee0-bfa6-3ccf-bea3-50633631cd94",
                        "entry_id": "765127cd-c677-3025-ac79-6fe50ffd9a73",
                        "glosses": [
                            "Gerät, das die Geschwindigkeit eines Wasserfahrzeuges misst"
                        ],
                        "tags": [
                            "Seemannssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "b1c1bfcb-0bb6-4acf-a020-180583f92c91",
                                "sense_id": "dedf8ee0-bfa6-3ccf-bea3-50633631cd94",
                                "text": "„Durch die Logge mißt man die Länge des vom segelnden Schiffe zurückgelegten Weges (die gesegelte Distanz) […].“ (1862)"
                            },
                            {
                                "example_id": "b74bb621-22d5-4a21-b54e-c6459e0b46df",
                                "sense_id": "dedf8ee0-bfa6-3ccf-bea3-50633631cd94",
                                "text": "„Einmal schnellt die Logge sogar auf sechzehn Knoten hoch. Wahnsinn! Bei dieser Geschwindigkeit vollführt die Windfahnensteuerung ziemliche Schlangenkurven, doch nie verliert sie das Schiff aus dem Kurs.“ (2010)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
