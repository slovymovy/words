                "senses": [
                    {
                        "sense_id": "55ffe066-1585-3d02-b353-16c9f516959e",
                        "entry_id": "fda41077-481a-397f-97d5-cfefabed741f",
                        "glosses": [
                            "Personne qui invente quelque chose avec une ou plusieurs autres personnes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c6840e7-7c98-4eef-8c49-6a157575a15c",
                                "sense_id": "55ffe066-1585-3d02-b353-16c9f516959e",
                                "text": "Même les plus fidèles soutiens de Darwin, comme Alfred Russel Wallace, le coïnventeur de la sélection naturelle, et Thomas Huxley, hésiteront à aller plus loin."
                            },
                            {
                                "example_id": "fe6b702a-cc45-424b-aec3-368da0bd7cfe",
                                "sense_id": "55ffe066-1585-3d02-b353-16c9f516959e",
                                "text": "Appelé incidemment à parler de l’aérotherme de M Delaire (ou de son coïnventeur !), nous exprimerons ici le regret de voir cette belle invention rester, par des causes que nous n’avons pas à examiner, sans application et sans résultat."
                            }
                        ]
                    }
