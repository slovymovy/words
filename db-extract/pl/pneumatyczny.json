                                        "examples": [
                                            {
                                                "example_id": "dd37187d-3136-4b23-aa39-5e20323c0de8",
                                                "sense_id": "016f63b9-1d97-3110-bb3c-86bc5f593e5b",
                                                "text": "\"Every one says I'm awfully pneumatic,\" said Lenina reflectively, patting her own legs."
                                            },
                                            {
                                                "example_id": "42f22b30-0157-4d20-92be-82437ca13763",
                                                "sense_id": "016f63b9-1d97-3110-bb3c-86bc5f593e5b",
                                                "text": "This short but pneumatic woman had killed six men and yet for some reason he wasn't afraid."
                                            },
                                            {
                                                "example_id": "410b524d-5699-4cda-85ca-31e77ec75479",
                                                "sense_id": "016f63b9-1d97-3110-bb3c-86bc5f593e5b",
                                                "text": "Her almost pneumatic bust tightened itself, and she was quite prepared to say uncharitable things, as she saw Felicia enter."
                                            }
