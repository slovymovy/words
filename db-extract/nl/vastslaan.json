                "entry_id": "068d04d0-e3ad-33d5-8cb8-dee52bb0a0cb",
                "word": "vastslaan",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4e087131-a93d-3a14-bbe7-742a503272d6",
                        "entry_id": "068d04d0-e3ad-33d5-8cb8-dee52bb0a0cb",
                        "glosses": [
                            "met een slaande beweging iets bevestigen"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "1aaa4fcc-1f2a-42af-8973-b5d261e0c8b4",
                                "sense_id": "4e087131-a93d-3a14-bbe7-742a503272d6",
                                "text": "De lander had een paar harpoenen moeten afschieten, die als een soort tentharingen de verkenner hadden moeten vastslaan aan het oppervlak, maar dat systeem werkte niet."
                            },
                            {
                                "example_id": "a764d5e1-0841-48b0-b6f7-f1edefab404b",
                                "sense_id": "4e087131-a93d-3a14-bbe7-742a503272d6",
                                "text": "Vroeger stond bij ons thuis een boekje over hengelsport in de kast dat heette Vastslaan en strakhouden, en dat deden ze."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "344f645c-53a9-41da-9f18-3f5be93a9d89",
                        "source_entry_id": "068d04d0-e3ad-33d5-8cb8-dee52bb0a0cb",
                        "source_sense_id": "4e087131-a93d-3a14-bbe7-742a503272d6",
                        "target_lang_word": "nail down",
