        "pl-extract.jsonl": [
            {
                "entry_id": "097cd279-6833-31a2-95ed-68407a0b817f",
                "word": "misterny",
                "pos": "adj",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c73b6bbb-5a81-31de-a675-0c63dee8d37c",
                        "entry_id": "097cd279-6833-31a2-95ed-68407a0b817f",
                        "glosses": [
                            "umiejętnie wykonany"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a60c6970-9b1b-4989-8de7-b287fee8aec5",
                                "sense_id": "c73b6bbb-5a81-31de-a675-0c63dee8d37c",
                                "text": "Na wierzchu wyobrażone były jakieś postacie filigranowe i misterne, przecież wcale wyraźne"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "cdc9d78c-7e3e-3c0b-9c22-104421592aea",
                        "entry_id": "097cd279-6833-31a2-95ed-68407a0b817f",
                        "glosses": [
                            "starannie zaplanowany"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08bf9b2f-cc67-4019-bef6-75d9a8562fce",
                        "source_entry_id": "097cd279-6833-31a2-95ed-68407a0b817f",
                        "source_sense_id": "c73b6bbb-5a81-31de-a675-0c63dee8d37c",
                        "target_lang_word": "dainty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dainty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "45c0aabb-a31a-3cc3-a194-e17288a93b56",
                                        "entry_id": "e4689122-81f2-3dbc-9854-71cf98a939e6",
                                        "glosses": [
                                            "Elegant; delicately small and pretty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56426bca-5f3e-412d-8f96-70c5fe8ab0b8",
                                                "sense_id": "45c0aabb-a31a-3cc3-a194-e17288a93b56",
                                                "text": "As for thoſe People of the Eaſt, (Goa, Calecute, Malaca,) they vvere a Fine, and Dainty People; Frugall, and yet Elegant, though not Militar."
                                            },
                                            {
                                                "example_id": "e2b5c91e-3204-45d7-9161-2a76577bccea",
                                                "sense_id": "45c0aabb-a31a-3cc3-a194-e17288a93b56",
                                                "text": "Those dainty limbs which nature lent / For gentle usage and soft delicacy.",
                                                "translation": "Comus",
                                                "english": "Comus"
                                            },
                                            {
                                                "example_id": "cb2ae621-cc88-409c-809d-c3e36bd4a47d",
                                                "sense_id": "45c0aabb-a31a-3cc3-a194-e17288a93b56",
                                                "text": "However, with the dainty volume my quondam friend sprang into fame. At the same time he cast off the chrysalis of a commonplace existence."
                                            },
                                            {
                                                "example_id": "7c5090d9-591a-4081-9162-7f5c77bb1e7e",
                                                "sense_id": "45c0aabb-a31a-3cc3-a194-e17288a93b56",
                                                "text": "The cutting sides were gay with heather in bloom, and masses of dainty Scots bluebells, while patches of clear sky overhead were bringing life and colour to the sea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99b31e42-086f-3d8c-9e9f-e898f34f3f4a",
                                        "entry_id": "e4689122-81f2-3dbc-9854-71cf98a939e6",
                                        "glosses": [
                                            "Fastidious and fussy, especially when eating."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f5c5f1c-5323-49bb-bddc-ee50ba38a164",
                                                "sense_id": "99b31e42-086f-3d8c-9e9f-e898f34f3f4a",
                                                "text": "UUho when he ſhal embrace you in his arms\nUUil tell how many thouſand men he ſlew.\nAnd when you looke for amorous diſcourſe,\nWill rattle foorth his facts of war and blood:\nToo harſh a ſubiect for your daintie eares."
                                            },
                                            {
                                                "example_id": "4d95cf78-5ebb-4ecb-91dc-05df58392cc5",
                                                "sense_id": "99b31e42-086f-3d8c-9e9f-e898f34f3f4a",
                                                "text": "And let us not be dainty of leave taking, / But shift away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7341f5ce-1952-3219-91f0-f897a11794fd",
                                        "entry_id": "e4689122-81f2-3dbc-9854-71cf98a939e6",
                                        "glosses": [
                                            "Excellent; valuable, fine."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3954f6ef-1ad3-443e-a730-c599a44b40df",
                                                "sense_id": "7341f5ce-1952-3219-91f0-f897a11794fd",
                                                "text": "Heliogabalus the most dissolute man of the world, amidst his most riotous sensualities, intended, whensoever occasion should force him to it, to have a daintie death."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dainty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f71e5abb-2110-320c-af78-75119bf49663",
                                        "entry_id": "2106fa64-b571-362e-9518-7af92439172d",
                                        "glosses": [
                                            "A delicacy (choice or pleasing food)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbb51b77-b8d5-4c7e-a816-ead9239195a3",
                                                "sense_id": "f71e5abb-2110-320c-af78-75119bf49663",
                                                "text": "And she receyued hym with grete Ioye and made hym to sytte doune by her and soo was he sette to soupe with flesshe and many deyntees\nAnd she received him with great joy, and made him to sit down by her, and so was he set to sup with flesh and many dainties."
                                            },
                                            {
                                                "example_id": "c0211ce7-e6b8-449a-bcf4-302f8bd8745d",
                                                "sense_id": "f71e5abb-2110-320c-af78-75119bf49663",
                                                "text": "[…]my case was deplorable enough, yet I had great cause for thankfulness that I was not driven to any extremities for food, but had rather plenty, even to dainties."
                                            },
                                            {
                                                "example_id": "e53ac4ee-905f-465c-9104-d3b6f0ffa057",
                                                "sense_id": "f71e5abb-2110-320c-af78-75119bf49663",
                                                "text": "And now a maiden […] ſupplied them, next, / With a reſplendent table, which the chaſte / Directreſs of the ſtores furniſh'd with bread / And dainties, remnants of the laſt regale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea93feb0-7f4e-33de-93d7-61a810510246",
                                        "entry_id": "2106fa64-b571-362e-9518-7af92439172d",
                                        "glosses": [
                                            "A fancy cookie, pastry, or square, frequently homemade, served at a social event."
                                        ],
                                        "tags": [
                                            "British-Columbia",
                                            "Canadian-Prairies",
                                            "Northwestern",
                                            "Ontario",
                                            "plural-normally"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "196aa388-c1e6-3baf-ba5a-c3240bbebdbb",
                                        "entry_id": "2106fa64-b571-362e-9518-7af92439172d",
                                        "glosses": [
                                            "Esteem, honour."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7e1544c3-923a-3a46-8f1b-96fa0f0cd249",
                                        "entry_id": "2106fa64-b571-362e-9518-7af92439172d",
                                        "glosses": [
                                            "An affectionate term of address."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10cf6854-ccfa-4b4b-aae7-c2b324dfe57b",
                                                "sense_id": "7e1544c3-923a-3a46-8f1b-96fa0f0cd249",
                                                "text": "I am not eager at forbidden dainties"
                                            }
                                        ]
                                    }
                                ]
                            }
