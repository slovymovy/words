                        ],
                        "examples": [
                            {
                                "example_id": "5934e216-cbd1-487c-b77f-188fa394422e",
                                "sense_id": "83b8bdb0-d00b-352e-8e67-55beb26658b0",
                                "text": "Micros will move upwards to where they have the same power and speed as today's minis."
                            },
                            {
                                "example_id": "53b6690e-f5cb-4d10-893e-b7a66789a8c4",
                                "sense_id": "83b8bdb0-d00b-352e-8e67-55beb26658b0",
                                "text": "Time sharing will be done by the mini because time sharing (the bulk of which is simple text editing) is the wrong thing to do on a maxi and the right thing on a mini."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba7f77e1-a92a-3333-b17e-05209eae86d7",
                        "entry_id": "7cfd85c2-43ec-3887-84f8-f819b567524e",
