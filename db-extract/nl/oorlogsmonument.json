                    {
                        "translation_id": "6e5d69e6-cecc-4e2f-81a0-31ac9abb0a61",
                        "source_entry_id": "27a17d76-c9be-326f-aa2a-ecebe2978892",
                        "source_sense_id": "93cfacf3-92a3-322b-9438-f3d649ea30de",
                        "target_lang_word": "monument à la guerre",
                        "target_lang_code": "fr",
