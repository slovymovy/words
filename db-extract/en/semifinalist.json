                                            {
                                                "example_id": "435ab411-4bb5-4985-a391-3e0df1605807",
                                                "sense_id": "f9d09b66-0adf-33c6-a1a2-6c464d5d1943",
                                                "text": "Česká Miss 2015 už zná své první semifinalistky! Do semifinále České Miss 2015 z prvního castingu postupují: ..."
                                            },
                                            {
                                                "example_id": "4332d060-6da5-41c1-998d-0f9a1df2eba6",
                                                "sense_id": "f9d09b66-0adf-33c6-a1a2-6c464d5d1943",
                                                "text": "Všem třem dosavadním semifinalistkám dámské dvouhry je 32 a více roků, což se stalo poprvé v grandslamové historii."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15729e39-e894-4154-922b-b874a24544d1",
                        "source_entry_id": "976ad32c-1fe4-38f7-88ff-ce395c41ea3e",
                        "source_sense_id": "35b6b1d2-db82-3223-9e91-46a42bee4192",
