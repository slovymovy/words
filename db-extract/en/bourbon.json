                                "target_senses": [
                                    {
                                        "sense_id": "21d4cc02-e270-3f98-84d0-c08ed9dd3165",
                                        "entry_id": "7e3e485e-9a31-30a8-be3e-a64f13247b1c",
                                        "glosses": [
                                            "Whiskey américain produit à partir de maïs, en lieu et place de l’orge, le reste étant généralement du seigle et du blé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff454cef-efdf-49ad-b544-278ab3fd389c",
                                                "sense_id": "21d4cc02-e270-3f98-84d0-c08ed9dd3165",
                                                "text": "Il aurait ouvert le tiroir du bas d’un bras nonchalant, en crochetant la poignée inoxydable avec deux doigts, et aurait pêché par le goulot une bouteille de bourbon ou de rye."
                                            },
                                            {
                                                "example_id": "fd90d746-741d-41a4-97a9-4b1b433dd550",
                                                "sense_id": "21d4cc02-e270-3f98-84d0-c08ed9dd3165",
                                                "text": "Moi, c’est Derek, et tant pis pour le cognac, un bourbon fera aussi bien l’affaire."
                                            },
                                            {
                                                "example_id": "b9edd9a3-00e1-4da9-8bce-fe71a3dc7687",
                                                "sense_id": "21d4cc02-e270-3f98-84d0-c08ed9dd3165",
                                                "text": "Le whisky n’était pas du bourbon mais du scotch, du White Horse, du bon, pour Gérard du moins : les Yankees buvaient du rye, ils aiment le goût de brillantine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc2452d6-1f39-40af-8946-c346df6bd039",
                        "source_entry_id": "5f11f9a2-4f28-3b03-8cc7-4d4d4ae3a695",
