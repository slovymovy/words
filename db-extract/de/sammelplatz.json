                "senses": [
                    {
                        "sense_id": "ce41b753-39e1-3657-8f18-8b87f333b42f",
                        "entry_id": "2a1f6c39-e035-3ebf-b1e4-315c8e8491fc",
                        "glosses": [
                            "Ort, an dem sich Menschen zusammenfinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fcdcf32-7625-4edc-82aa-4dd268a88d27",
                                "sense_id": "ce41b753-39e1-3657-8f18-8b87f333b42f",
                                "text": "„Kleebusch hatte seine Gruppe schnell beisammen. Außer ihm bestand sie nur noch aus vier Mann. Er marschierte mit ihnen zum Sammelplatz vor dem Ort, wo die Kampfgruppe im zwanglosen Halbkreis antrat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fb90f1e4-5086-3a53-b2ef-119c2d5319b9",
                        "entry_id": "2a1f6c39-e035-3ebf-b1e4-315c8e8491fc",
                        "glosses": [
                            "Ort zur Lagerung von Sachen oder Material"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d5be8ee-229a-494e-8d98-4b658cb5f1f8",
                                "sense_id": "fb90f1e4-5086-3a53-b2ef-119c2d5319b9",
                                "text": "„Abb. 59. Verladen von Quebrachostämmen an einem Sammelplatze mittels eines primitiven Krahnes.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
