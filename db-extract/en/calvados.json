                        "translation_id": "b08561c8-3414-49f5-bbcd-f317dd4c1dca",
                        "source_entry_id": "8fa1bd94-ffb1-39b1-9cd9-93256dcb1c9a",
                        "source_sense_id": "aedce88c-eef4-3851-9dd1-2224bd5e11cc",
                        "source_sense_description": "department of France, in the Normandy region",
                        "target_lang_word": "Calvados",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
