{
    "word_family": [
        "dipper",
        "dipstick"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c62197c1-082f-3b70-ba83-21f1e731be30",
                    "sense_definition": "To put something into a liquid for a short time and then take it out again.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "liquid_interaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can <w>dip</w> your biscuit into your tea if you like.",
                            "target_lang_translations": {
                                "ru": "Ты можешь <w>макать</w> печенье в чай, если хочешь.",
                                "zh": "如果你喜欢，可以把饼干<w>蘸</w>在茶里吃。"
                            }
                        },
                        {
                            "text": "He <w>dipped</w> the brush into the paint to start working.",
                            "target_lang_translations": {
                                "ru": "Он <w>окунул</w> кисть в краску, чтобы начать работу.",
                                "zh": "他把刷子<w>蘸</w>入油漆中开始工作。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dip in",
                        "dip into"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поместить что-то в жидкость на короткое время и затем вынуть.",
                        "zh": "将某物短暂地放入液体中，然后取出。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "макать",
                                "target_lang_sense_clarification": "погружать еду или предмет в жидкость"
                            },
                            {
                                "target_lang_word": "окунать",
                                "target_lang_sense_clarification": "погружать целиком или частично"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "蘸",
                                "target_lang_sense_clarification": "将食物或物体放入液体中"
                            },
                            {
                                "target_lang_word": "浸",
                                "target_lang_sense_clarification": "将物体放入液体中"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c85d56f-e931-3100-929f-640bffd85a4b",
                    "sense_definition": "To go down to a lower level or amount, usually for a short time.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "downward_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The temperature is expected to <w>dip</w> below freezing tonight.",
                            "target_lang_translations": {
                                "ru": "Ожидается, что сегодня ночью температура <w>опустится</w> ниже нуля.",
                                "zh": "预计今晚气温会<w>降</w>至冰点以下。"
                            }
                        },
                        {
                            "text": "Sales <w>dipped</w> slightly in the second quarter but recovered later.",
                            "target_lang_translations": {
                                "ru": "Продажи немного <w>упали</w> во втором квартале, но позже восстановились.",
                                "zh": "第二季度销售额略有<w>下滑</w>，但后来有所回升。"
                            }
                        }
                    ],
                    "antonyms": [
                        "rise",
                        "increase"
                    ],
                    "common_phrases": [
                        "dip below"
                    ],
                    "target_lang_definitions": {
                        "ru": "Опускаться на более низкий уровень или уменьшаться в количестве, обычно ненадолго.",
                        "zh": "降至较低的水平或数量，通常是暂时的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "падать",
                                "target_lang_sense_clarification": "о цене, уровне или количестве"
                            },
                            {
                                "target_lang_word": "опускаться",
                                "target_lang_sense_clarification": "снижаться"
                            },
                            {
                                "target_lang_word": "снижаться",
                                "target_lang_sense_clarification": "уменьшаться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "下降",
                                "target_lang_sense_clarification": "指数值或水平降低"
                            },
                            {
                                "target_lang_word": "下跌",
                                "target_lang_sense_clarification": "指价格或销售额减少"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6176b11-cd9d-3678-a14a-9c74dab1e82c",
                    "sense_definition": "To take something out of a container using a ladle, spoon, or hand.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "liquid_interaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She used a ladle to <w>dip</w> the soup into the bowls.",
                            "target_lang_translations": {
                                "ru": "Она использовала половник, чтобы <w>разлить</w> суп по тарелкам.",
                                "zh": "她用长柄勺把汤<w>舀</w>进碗里。"
                            }
                        },
                        {
                            "text": "We had to <w>dip</w> water from the bucket to wash our hands.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось <w>зачерпывать</w> воду из ведра, чтобы помыть руки.",
                                "zh": "我们不得不从桶里<w>舀</w>水洗手。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dip out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Доставать что-то из емкости с помощью половника, ложки или руки.",
                        "zh": "用勺子、长柄勺或手从容器中取出液体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зачерпывать",
                                "target_lang_sense_clarification": "брать жидкость ковшом или ложкой"
                            },
                            {
                                "target_lang_word": "наливать",
                                "target_lang_sense_clarification": "разливать жидкость половником"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "舀",
                                "target_lang_sense_clarification": "用勺子等工具取出液体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0490bb3a-5c65-3555-9ba4-f28e9f36e12e",
                    "sense_definition": "To lower the beam of vehicle headlights to avoid blinding other drivers.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "downward_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>dip</w> your lights when a car approaches from the other direction.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>переключить</w> фары <w>на ближний свет</w>, когда приближается встречная машина.",
                                "zh": "当有车从对面驶来时，你应该<w>切换</w>近光灯。"
                            }
                        },
                        {
                            "text": "The driver <w>dipped</w> the headlights as he entered the city.",
                            "target_lang_translations": {
                                "ru": "Водитель <w>переключил</w> фары <w>на ближний свет</w> при въезде в город.",
                                "zh": "司机进城时<w>切换</w>了近光灯。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dip lights"
                    ],
                    "target_lang_definitions": {
                        "ru": "Опускать луч фар транспортного средства, чтобы не ослеплять других водителей.",
                        "zh": "调低车辆前灯的灯光，以免晃到其他驾驶员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переключать на ближний свет",
                                "target_lang_sense_clarification": "о фарах автомобиля"
                            },
                            {
                                "target_lang_word": "приглушать",
                                "target_lang_sense_clarification": "свет фар"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "切换近光灯",
                                "target_lang_sense_clarification": "指汽车灯光操作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cafaf55e-037e-3e6f-9eda-0b3f0c0a204c",
                    "sense_definition": "To leave a place, often quickly or suddenly.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The party was getting boring, so we decided to <w>dip</w>.",
                            "target_lang_translations": {
                                "ru": "Вечеринка становилась скучной, поэтому мы решили <w>свалить</w>.",
                                "zh": "派对变得很无聊，所以我们决定<w>溜走</w>。"
                            }
                        },
                        {
                            "text": "He had to <w>dip</w> early to catch the last bus home.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось <w>уйти</w> пораньше, чтобы успеть на последний автобус домой.",
                                "zh": "他不得不提前<w>走</w>，以便赶上回家的末班车。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Покидать место, часто быстро или внезапно.",
                        "zh": "离开某地，通常是快速或突然地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сваливать",
                                "target_lang_sense_clarification": "сленг: уходить"
                            },
                            {
                                "target_lang_word": "уходить",
                                "target_lang_sense_clarification": "покидать место"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "溜走",
                                "target_lang_sense_clarification": "悄悄或快速离开"
                            },
                            {
                                "target_lang_word": "先走",
                                "target_lang_sense_clarification": "提前离开"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a40bb0b5-0362-391d-898c-1654e798e9f0",
                    "sense_definition": "A thick sauce into which pieces of food are dipped before eating.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "liquid_interaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This onion <w>dip</w> is just scrumptious with potato chips.",
                            "target_lang_translations": {
                                "ru": "Этот луковый <w>соус</w> просто восхитителен с картофельными чипсами.",
                                "zh": "这种洋葱<w>蘸酱</w>配薯片吃简直太美味了。"
                            }
                        },
                        {
                            "text": "She made a delicious cheese <w>dip</w> for the party.",
                            "target_lang_translations": {
                                "ru": "Она приготовила вкусный сырный <w>дип</w> для вечеринки.",
                                "zh": "她为派对制作了一种美味的奶酪<w>蘸酱</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cheese dip",
                        "onion dip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Густой соус, в который макают кусочки еды перед употреблением.",
                        "zh": "一种浓稠的酱料，食用前将食物蘸入其中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соус",
                                "target_lang_sense_clarification": "для макания"
                            },
                            {
                                "target_lang_word": "дип",
                                "target_lang_sense_clarification": "густой соус"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "蘸酱",
                                "target_lang_sense_clarification": "用于蘸食的浓酱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e47312bf-fac5-3b7d-8c30-594bb9ba8ffe",
                    "sense_definition": "A short swim, usually for refreshment.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "liquid_interaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am going for a <w>dip</w> in the pool before breakfast.",
                            "target_lang_translations": {
                                "ru": "Я иду <w>искупаться</w> в бассейне перед завтраком.",
                                "zh": "早餐前我打算去泳池<w>游</w>一会儿。"
                            }
                        },
                        {
                            "text": "The water looked so inviting that he went for a quick <w>dip</w>.",
                            "target_lang_translations": {
                                "ru": "Вода выглядела так заманчиво, что он решил быстро <w>окунуться</w>.",
                                "zh": "水看起来太诱人了，他决定快速<w>泡</w>一下。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "go for a dip",
                        "take a dip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткое плавание, обычно для того, чтобы освежиться.",
                        "zh": "短暂的游泳，通常为了清凉一下。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "купание",
                                "target_lang_sense_clarification": "короткий заплыв"
                            },
                            {
                                "target_lang_word": "окунание",
                                "target_lang_sense_clarification": "погружение в воду"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "游泳",
                                "target_lang_sense_clarification": "指短暂的戏水或游泳"
                            },
                            {
                                "target_lang_word": "泡澡",
                                "target_lang_sense_clarification": "指在水中浸泡"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dfbe5d43-19f6-3903-8257-95df162c4014",
                    "sense_definition": "A part of a surface that is lower than the surrounding area.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "downward_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful, there is a deep <w>dip</w> in the road ahead.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, впереди на дороге глубокая <w>впадина</w>.",
                                "zh": "小心，前方路面有个深<w>坑洼</w>。"
                            }
                        },
                        {
                            "text": "The car bounced as it hit a <w>dip</w> in the pavement.",
                            "target_lang_translations": {
                                "ru": "Машина подпрыгнула, попав в <w>углубление</w> на асфальте.",
                                "zh": "车子撞到路面上的<w>凹陷</w>时颠簸了一下。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть поверхности, которая ниже окружающей области.",
                        "zh": "表面上低于周围区域的部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "углубление",
                                "target_lang_sense_clarification": "ямка или понижение уровня"
                            },
                            {
                                "target_lang_word": "впадина",
                                "target_lang_sense_clarification": "геологическая или на дороге"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "凹陷",
                                "target_lang_sense_clarification": "指地表或物体表面的低洼处"
                            },
                            {
                                "target_lang_word": "坑洼",
                                "target_lang_sense_clarification": "指路面上的低洼处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a18ad5e-4b18-3ec0-b967-f96eaab8b25d",
                    "sense_definition": "A decrease in amount or value, often temporary.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "downward_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Investors often look to buy the <w>dips</w> in the stock market.",
                            "target_lang_translations": {
                                "ru": "Инвесторы часто стремятся выкупать <w>спады</w> на фондовом рынке.",
                                "zh": "投资者经常寻求在股市<w>下跌</w>时买入。"
                            }
                        },
                        {
                            "text": "There was a noticeable <w>dip</w> in the company's revenue last month.",
                            "target_lang_translations": {
                                "ru": "В прошлом месяце наблюдался заметный <w>спад</w> доходов компании.",
                                "zh": "上个月公司收入出现了明显的<w>下滑</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "buy the dip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уменьшение количества или стоимости, часто временное.",
                        "zh": "数量或价值的减少，通常是暂时的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спад",
                                "target_lang_sense_clarification": "снижение показателей"
                            },
                            {
                                "target_lang_word": "падение",
                                "target_lang_sense_clarification": "снижение цены или уровня"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "下跌",
                                "target_lang_sense_clarification": "指价格或数值的暂时回落"
                            },
                            {
                                "target_lang_word": "下滑",
                                "target_lang_sense_clarification": "指业绩或水平的下降"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9afef45a-e1da-3628-96e3-78caaee6c745",
                    "sense_definition": "A physical exercise where one lowers and raises the body using the arms.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He performed ten <w>dips</w> on the parallel bars at the gym.",
                            "target_lang_translations": {
                                "ru": "Он выполнил десять <w>отжиманий на брусьях</w> в спортзале.",
                                "zh": "他在健身房做了十个双杠<w>臂屈伸</w>。"
                            }
                        },
                        {
                            "text": "Tricep <w>dips</w> are great for building arm strength.",
                            "target_lang_translations": {
                                "ru": "<w>Обратные отжимания</w> на трицепс отлично подходят для развития силы рук.",
                                "zh": "三头肌<w>臂屈伸</w>对增强手臂力量非常有效。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tricep dips"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическое упражнение, при котором тело опускается и поднимается с помощью рук.",
                        "zh": "一种通过手臂力量上下移动身体的体育锻炼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отжимание на брусьях",
                                "target_lang_sense_clarification": "упражнение"
                            },
                            {
                                "target_lang_word": "обратное отжимание",
                                "target_lang_sense_clarification": "от скамьи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "双杠臂屈伸",
                                "target_lang_sense_clarification": "一种健身动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea04412c-5d70-31fd-befc-000c2f6bf0f4",
                    "sense_definition": "Finely ground tobacco placed between the lip and gum.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He prefers using <w>dip</w> over smoking cigarettes.",
                            "target_lang_translations": {
                                "ru": "Он предпочитает <w>жевательный табак</w> курению сигарет.",
                                "zh": "他更喜欢用<w>嚼烟</w>而不是抽烟。"
                            }
                        },
                        {
                            "text": "The baseball player had a tin of <w>dip</w> in his back pocket.",
                            "target_lang_translations": {
                                "ru": "У бейсболиста была банка <w>жевательного табака</w> в заднем кармане.",
                                "zh": "那个棒球运动员的后兜里有一盒<w>嚼烟</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chewing tobacco",
                        "snuff"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мелко нарезанный табак, который кладут между губой и десной.",
                        "zh": "放置在嘴唇和牙龈之间的细磨烟草。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жевательный табак",
                                "target_lang_sense_clarification": "вид табака"
                            },
                            {
                                "target_lang_word": "снюс",
                                "target_lang_sense_clarification": "сосательный табак"
