                                        "entry_id": "0e1b6d1c-c95f-35fd-a753-75cef43618f6",
                                        "glosses": [
                                            "Ökosystem, das zum Zweck der landwirtschaftlichen Nutzung geschaffen wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38e88aad-7d7d-445f-94ee-919bbcc72581",
                                                "sense_id": "c06da1a8-db19-3015-936a-5597ec638652",
                                                "text": "„Geordnet nach abnehmender Intensität der menschlichen Einflußnahme, werden urban-industrielle Ökosysteme, Agroökosysteme sowie naturnahe und natürliche Ökosysteme unterschieden.“"
                                            }
                                        ],
