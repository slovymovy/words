                                        "entry_id": "65f72077-0057-3157-a793-6821cffc3449",
                                        "glosses": [
                                            "специалист в области музыковедения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb4a75ea-978f-4532-a493-6ba00876f93d",
                                                "sense_id": "78437a75-d27b-3100-892a-8feaa5f120b3",
                                                "text": "Композитор пишет, пианист играет — музыковед проговаривает, проясняет, обсуждает."
                                            },
                                            {
                                                "example_id": "f7915fb3-79bc-47d1-bfb5-2bcae5e01b3d",
                                                "sense_id": "78437a75-d27b-3100-892a-8feaa5f120b3",
                                                "text": "Для меня просто поговорить с человеком из Москвы — уже событие, а тут ещё и пиво — это прямо-таки избыточная роскошь! Я ведь музыковед… Он сказал это так, точно профессия музыковеда запрещала ему употребление пива."
                                            }
                                        ]
                                    }
                                ]
                            }
