                                            {
                                                "example_id": "bd4e9b63-60b6-4957-98d2-f37a4a81bd6c",
                                                "sense_id": "9c83bdf7-49db-317a-8892-b51bafd6c7cc",
                                                "text": "Diese Baumängel müssen beanstandet werden."
                                            },
                                            {
                                                "example_id": "5b679c3f-3b5b-4dee-a653-4c26479bc1d6",
                                                "sense_id": "9c83bdf7-49db-317a-8892-b51bafd6c7cc",
                                                "text": "An Ihrer Vorgehensweise habe ich überhaupt nichts zu beanstanden, aber an Ihrem Ton!"
                                            },
                                            {
                                                "example_id": "ac2b3f13-ed2a-4c5e-b359-3a72f37ebdb7",
                                                "sense_id": "9c83bdf7-49db-317a-8892-b51bafd6c7cc",
                                                "text": "Ein Beitrag von mir im Energieforum wurde beanstandet."
                                            },
                                            {
                                                "example_id": "e2667264-7cc9-4831-ba89-fac60e1877e6",
                                                "sense_id": "9c83bdf7-49db-317a-8892-b51bafd6c7cc",
                                                "text": "Ein Topphotel, nichts zu beanstanden, kann ich nur empfehlen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5cb6e99-4ca2-4188-a360-b306128b392e",
                        "source_entry_id": "3961972b-231f-3522-8893-f25ef4726bf2",
                        "source_sense_description": "in aanmerking nemen",
                        "target_lang_word": "berücksichtigen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "berücksichtigen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8a0d0730-6e1f-3441-adb7-9a1a0c96e1e1",
                                        "entry_id": "18d5f1dc-d05d-37a5-a7f9-6d63a86b0a28",
                                        "glosses": [
                                            "auf jemanden, etwas Rücksicht nehmen; jemanden, etwas in Betracht ziehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0c7e7ef-f57b-489c-aebb-60d813281b09",
                                                "sense_id": "8a0d0730-6e1f-3441-adb7-9a1a0c96e1e1",
                                                "text": "Das Gericht berücksichtigte ihre ausweglose Situation und milderte die Strafe."
                                            },
                                            {
                                                "example_id": "a947905b-9c75-4a24-b57a-6ec9d7924efe",
                                                "sense_id": "8a0d0730-6e1f-3441-adb7-9a1a0c96e1e1",
                                                "text": "In dieser Analyse sind sowohl Einmalkosten als auch laufende Kosten berücksichtigt."
                                            },
                                            {
                                                "example_id": "0b46ce0c-ab47-4ef3-8d0b-16553b10ef94",
                                                "sense_id": "8a0d0730-6e1f-3441-adb7-9a1a0c96e1e1",
                                                "text": "Die Interessen der Anwohner werden hier nie berücksichtigt!"
                                            },
                                            {
                                                "example_id": "aaf49081-6144-4348-8a5a-39ef60192d84",
                                                "sense_id": "8a0d0730-6e1f-3441-adb7-9a1a0c96e1e1",
                                                "text": "„Beim Drachenflug ist es besonders wichtig, den Windeinfluss zu berücksichtigen, da schon relativ geringe Gegenwindgeschwindigkeiten zu einer drastischen Verschlechterung der Gleitzahl führen.“"
                                            },
                                            {
                                                "example_id": "3550cb8b-6a24-4b2b-b063-17c528b61915",
                                                "sense_id": "8a0d0730-6e1f-3441-adb7-9a1a0c96e1e1",
                                                "text": "„Einerseits sollte die schulische Wagniserziehung die Bedürfnisse der Wagenden berücksichtigen, und andererseits sollte sie Impulse zur Reflexion des gewagten Handelns setzen, um ein Bewusstsein für Selbstwirksamkeit, der Hilfsbedürftigkeit und Verantwortungsübernahme zu ermöglichen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9d207f2e-e17d-3612-8c46-726cddbbb836",
                                        "entry_id": "18d5f1dc-d05d-37a5-a7f9-6d63a86b0a28",
                                        "glosses": [
                                            "jemanden, etwas beachten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e8a38a3-0861-4138-a779-4ccbdc6f8d67",
                                                "sense_id": "9d207f2e-e17d-3612-8c46-726cddbbb836",
                                                "text": "„Beim Drachenflug ist es besonders wichtig, den Windeinfluss zu berücksichtigen, da schon relativ geringe Gegenwindgeschwindigkeiten zu einer drastischen Verschlechterung der Gleitzahl führen.“"
                                            },
                                            {
                                                "example_id": "1e251c53-2c67-4093-80af-00d8e818a5d2",
                                                "sense_id": "9d207f2e-e17d-3612-8c46-726cddbbb836",
                                                "text": "„Einerseits sollte die schulische Wagniserziehung die Bedürfnisse der Wagenden berücksichtigen, und andererseits sollte sie Impulse zur Reflexion des gewagten Handelns setzen, um ein Bewusstsein für Selbstwirksamkeit, der Hilfsbedürftigkeit und Verantwortungsübernahme zu ermöglichen.“"
                                            },
                                            {
                                                "example_id": "4da60a35-513c-47f0-a868-7b545566a8b4",
                                                "sense_id": "9d207f2e-e17d-3612-8c46-726cddbbb836",
                                                "text": "Bei der Besetzung der Stelle berücksichtigen wir besonders ältere Arbeitnehmer und Wiedereinsteiger."
                                            },
                                            {
                                                "example_id": "50f38443-b5b6-4d0a-a1a8-fa123039cf9d",
                                                "sense_id": "9d207f2e-e17d-3612-8c46-726cddbbb836",
                                                "text": "Man berücksichtigte ihre Verdienste im Namen der Stiftung. Deshalb erhielt sie einen Orden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
