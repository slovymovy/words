                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mongolia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ada0d2b7-3d61-379e-93fe-1487ed8df282",
                                        "entry_id": "fcf2e5a5-3ac8-338f-ab25-d81c07254107",
                                        "glosses": [
                                            "A country in East Asia. Capital and largest city: Ulaanbaatar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b564b092-62b8-4c64-8744-8c2497982135",
                                                "sense_id": "ada0d2b7-3d61-379e-93fe-1487ed8df282",
                                                "text": "The chemicals abandoned when the paper mill closed are seeping into the ground water and will eventually contaminate the lake, according to a study by the Irkutsk region’s Ministry of Natural Resources. Plans by Mongolia to dam the Selenga River, which flows into the lake, are also a Russian concern."
                                            },
                                            {
                                                "example_id": "7d6e529b-1672-433e-bd6d-75cd7f55279b",
                                                "sense_id": "ada0d2b7-3d61-379e-93fe-1487ed8df282",
                                                "text": "Pope Francis hoped that his visit would deepen cooperation and dialogue between the Church and Mongolia.\n“I am certain that Mongolian Catholics will continue to offer readily their proper contribution to the building of a prosperous and secure society, in dialogue and cooperation with all others who dwell in this great land kissed by the sky,” he said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa0ffbc0-ca38-30a5-93d6-906528b55237",
                                        "entry_id": "fcf2e5a5-3ac8-338f-ab25-d81c07254107",
                                        "glosses": [
                                            "A Mongolian-speaking geographic region in East Asia, including the country of Mongolia (Outer Mongolia), the autonomous region of Inner Mongolia in China, and sometimes also Buryatia, Tuva and the Altai Republic in Russia."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9357cc1-6145-4961-abc3-59cebd687379",
                        "source_entry_id": "9c8d4ce5-75f8-36d9-a0d2-a036e3643325",
                        "source_sense_id": "66b0b78f-793d-3556-ab8f-c31d5f5907e0",
                        "target_lang_word": "Mongolei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mongolei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cafb1568-17af-338b-940c-7aaa2f81e986",
                                        "entry_id": "44ccedfe-ae32-3e9f-982b-cec09fcc2e99",
                                        "glosses": [
                                            "Staat im Innern Ostasiens mit 3 Millionen Einwohnern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fba28ee-8024-42d2-84cf-dd33299a95d8",
                                                "sense_id": "cafb1568-17af-338b-940c-7aaa2f81e986",
                                                "text": "Ulan-Bator ist die Hauptstadt der Mongolei."
                                            },
                                            {
                                                "example_id": "bc7c69b4-66fa-45e8-ac4d-83526839d364",
                                                "sense_id": "cafb1568-17af-338b-940c-7aaa2f81e986",
                                                "text": "„Von allen unabhängigen Staaten der Welt ist die Mongolei das Land mit der geringsten Bevölkerungsdichte.“"
                                            },
                                            {
                                                "example_id": "75f458e4-badc-4019-99b6-d84a0b697cc2",
                                                "sense_id": "cafb1568-17af-338b-940c-7aaa2f81e986",
                                                "text": "„Wegen der geografisch bedingt sehr kargen Böden hat sich in der Mongolei fast überhaupt kein Ackerbau entwickelt, im Gegenzug ist aber eine hoch spezialisierte Viehwirtschaft entstanden.“"
                                            },
                                            {
                                                "example_id": "9a5930e5-a443-48b6-ab23-e8cee88e396f",
                                                "sense_id": "cafb1568-17af-338b-940c-7aaa2f81e986",
                                                "text": "„Er hat sie mir vor zehn Jahren gegeben, gleich nach seiner Rückkehr aus der Mongolei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd7bd4cd-5501-4b58-8c0b-84119a8c470d",
                        "source_entry_id": "9c8d4ce5-75f8-36d9-a0d2-a036e3643325",
