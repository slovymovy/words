                                "target_senses": [
                                    {
                                        "sense_id": "8911c261-3f79-3b95-a134-85786f457e2e",
                                        "entry_id": "ee827c8b-92c6-32dc-8b0e-a8a85fb72361",
                                        "glosses": [
                                            "Qui stimule, stimulant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c638638-0a74-42b8-8078-41799ca170a6",
                                                "sense_id": "8911c261-3f79-3b95-a134-85786f457e2e",
                                                "text": "L'air par son oxygène, le fluide électrique, le calorique, la lumière, sont les agents stimulateurs, les causes stimulatrices qui entretiennent la vie dans les corps organisés."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stimulateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "79a2f3df-dfe4-32cb-9f88-497ba7592c5c",
                                        "entry_id": "b8f3e9dd-3e10-30e6-b124-6d1681f5c478",
                                        "glosses": [
                                            "Personne qui stimule, instigateur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22f4e3e7-5a8c-40ed-b6ea-c9c4e430c0d7",
                                                "sense_id": "79a2f3df-dfe4-32cb-9f88-497ba7592c5c",
                                                "text": "Le prince, ministre de Dieu, est le protecteur et le stimulateur du bien."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stimulateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "17c604f7-0e75-38b7-8053-3a79eccb2238",
                                        "entry_id": "0502b3a8-4497-3ba7-b1ed-a0cbe5082ee8",
                                        "glosses": [
                                            "Appareil qui stimule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "651a2a76-05c6-477c-857b-5d348381d4c5",
                                                "sense_id": "17c604f7-0e75-38b7-8053-3a79eccb2238",
                                                "text": "Le désir est provoqué par chaque centre cérébral de faculté, mis en action par le stimulateur qui lui convient dans l'ordre de la nature au moyen d'une sensation et d'une perception."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb2cadb4-c714-38fd-8f63-1691291cd813",
                                        "entry_id": "0502b3a8-4497-3ba7-b1ed-a0cbe5082ee8",
                                        "glosses": [
                                            "Appareil qui stimule.",
                                            "Appareil électrique implanté dans l’organisme, destiné à suppléer une commande nerveuse déficiente pour le fonctionnement d’un appareil musculaire (le cœur, un sphincter, etc.)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
