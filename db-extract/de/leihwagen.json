                "senses": [
                    {
                        "sense_id": "d96ae9d7-f939-3655-8e08-ff46be1eafea",
                        "entry_id": "bd986361-f1ee-3130-b24c-f20b99893edb",
                        "glosses": [
                            "Kraftfahrzeug, das man gegen eine Gebühr vorübergehend als Selbstfahrer nutzen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af43ecaa-ac30-406d-b0b0-820ca7010e48",
                                "sense_id": "d96ae9d7-f939-3655-8e08-ff46be1eafea",
                                "text": "Wenn das eigene Fahrzeug in die Werkstatt muss, braucht man womöglich einen Leihwagen."
                            },
                            {
                                "example_id": "1f028e84-1e7d-497c-bdaa-f51a7bafe783",
                                "sense_id": "d96ae9d7-f939-3655-8e08-ff46be1eafea",
                                "text": "„Dabei fährt sie gerade mit einem weißen Leihwagen vorbei, weil ihr Golf in der Werkstatt ist.“"
                            },
                            {
                                "example_id": "625ca720-884f-423e-b88d-0ff884995b6f",
                                "sense_id": "d96ae9d7-f939-3655-8e08-ff46be1eafea",
                                "text": "„Ich schnaubte, stieg aus und bevor ich die Tür zufallen ließ, beugte ich mich noch einmal zu ihm ins Innere des Leihwagens, den er noch abgeben musste, bevor er sich in den nächsten Tagen auch auf den Heimweg machen wollte.“"
                            },
                            {
                                "example_id": "1ecfb49f-9066-4a2c-af5d-c1f940937b28",
                                "sense_id": "d96ae9d7-f939-3655-8e08-ff46be1eafea",
                                "text": "„Ist der französische Journalist etwa in einem Leihwagen persönlich mit den Strümpfen hierher in den Norden unterwegs, während ich das schreibe?“"
                            },
                            {
                                "example_id": "9bbcfe6d-f8f9-4de2-9cb8-10edd35a8ed8",
                                "sense_id": "d96ae9d7-f939-3655-8e08-ff46be1eafea",
                                "text": "„Am Waldrand stiegen wir in unseren Leihwagen um und entfernten uns weiter von der Grenze.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
