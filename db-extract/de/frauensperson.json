                                "target_word": "ženská",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "9182e3d1-cf0b-374b-8a33-cd60d14f6c64",
                                        "entry_id": "89bc3ff6-adcc-3b92-8ac2-fb6071fc16ec",
                                        "glosses": [
                                            "nominativ singuláru ženského rodu adjektiva ženský"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e645ae00-6665-4d22-9314-f8e573daac83",
                                                "sense_id": "9182e3d1-cf0b-374b-8a33-cd60d14f6c64",
                                                "text": "Prokopa dráždila a znepokojovala ta silná ženská vůně, když pracoval skloněn nad krabičkou pudru (…)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7a72108-0a41-3ca8-b843-caaccd8693e5",
                                        "entry_id": "89bc3ff6-adcc-3b92-8ac2-fb6071fc16ec",
                                        "glosses": [
