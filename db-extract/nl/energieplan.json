                        "entry_id": "a928bb77-8bd8-3f4c-acd2-e4dc6b38a647",
                        "glosses": [
                            "voornemens rond de toekomstige energievoorziening"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b11271a9-48cc-4b61-bb1b-606d5da87313",
                                "sense_id": "c17cec2b-7369-3d15-9a58-d60d211362be",
                                "text": "Omvangrijk energieplan in de maak: Met een landelijke voorlichtingscampagne moet volgend jaar de grootste energiebesparingsoperatie tot nu toe in gang worden gezet. Dat meldt dagblad Trouw op basis van een vertrouwelijk conceptrapport dat deel uitmaakt van het Nationaal Energieakkoord, waar de overheid, de milieubeweging en de energiesector over onderhandelen."
                            },
                            {
                                "example_id": "b5605004-071f-4626-a400-9d314da73a6d",
                                "sense_id": "c17cec2b-7369-3d15-9a58-d60d211362be",
                                "text": "In het verleden zei ook de Commissie zelf dat de Europese markt te klein is om mondiaal de prijzen te kunnen bepalen. De energieplannen van de Commissie vormen de hoofdmoot van de State of the Union, de jaarlijkse ‘troonrede’ van de Commissievoorzitter, morgen in Straatsburg."
                            }
                        ]
                    }
