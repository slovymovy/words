                        "target_lang_word": "Spektrogramm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spektrogramm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f7befdd5-40ec-3bd9-8934-be585d4f6c18",
                                        "entry_id": "24510948-8690-365a-aa14-9d1a3d2fdb3b",
                                        "glosses": [
                                            "graphische Repräsentation eines Spektrums"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a48e053f-9f15-487c-a034-4eacb5c84b09",
                                                "sense_id": "f7befdd5-40ec-3bd9-8934-be585d4f6c18",
                                                "text": "Ein Diagramm veranschaulicht dies, es zeigt die Lichtintensität des Spektralbilds in Abhängigkeit von der Wellenlänge. Ein solches Spektrogramm kann man mit einem Freeware-Programm erzeugen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "48e4e444-477f-3f33-93be-3b7a2c7b1dac",
                                        "entry_id": "24510948-8690-365a-aa14-9d1a3d2fdb3b",
                                        "glosses": [
                                            "Spektrogramm^([1]), das die Zeit in Millisekunden (ms) auf der x-Achse, die Frequenz in Hertz (Hz) auf der y-Achse und die Amplitude durch Schwärzung darstellt"
                                        ],
                                        "tags": [
                                            "Phonetik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07f72ff0-1597-45c7-a52e-0dedd2ae5668",
                                                "sense_id": "48e4e444-477f-3f33-93be-3b7a2c7b1dac",
                                                "text": "Das Thema ist die praktische Arbeit mit Spektren und Spektrogrammen im Bereich des Stimmtrainings, Sprechens und Singens."
                                            },
                                            {
                                                "example_id": "83105e59-ec8e-4805-85ae-cc4a4fd336c1",
                                                "sense_id": "48e4e444-477f-3f33-93be-3b7a2c7b1dac",
                                                "text": "Da das Spektrogramm die einzelnen Frequenzen des Signales im Zeitverlauf darstellt, ist es hervorragend zur Stimmanalyse geeignet."
                                            },
                                            {
                                                "example_id": "f44454d0-e3ea-45e0-80ae-98c953aee726",
                                                "sense_id": "48e4e444-477f-3f33-93be-3b7a2c7b1dac",
                                                "text": "„So hat man von diesen Spektrogrammen her eine zunächst neue Technik der Lautbeschreibung und Systematisierung gewonnen, die ich doch noch etwas näher erläutern möchte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
