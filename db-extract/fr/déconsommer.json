                "senses": [
                    {
                        "sense_id": "5b1281c8-5c5a-30c3-b704-6d67597be061",
                        "entry_id": "429011c0-f74f-3a0e-a007-38b77b07bbf1",
                        "glosses": [
                            "Cesser de consommer de manière superflue ou évitable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68181e59-11e9-40d4-95f4-64a5a6352272",
                                "sense_id": "5b1281c8-5c5a-30c3-b704-6d67597be061",
                                "text": "De la même façon, lorsque le consommateur reporte de quelques mois ou de plusieurs années le renouvellement de sa voiture, il n'a pas le sentiment de déconsommer, pour ainsi dire, car son véhicule fonctionne toujours et lui donne pleine satisfaction."
                            },
                            {
                                "example_id": "7d9406c2-2119-4694-8e20-c06e8612c26e",
                                "sense_id": "5b1281c8-5c5a-30c3-b704-6d67597be061",
                                "text": "Certains déconsomment pour se sentir mieux, c'est le cas des minimalistes."
                            },
                            {
                                "example_id": "d8dd2d16-10fa-4a47-95ef-3242665d5c5d",
                                "sense_id": "5b1281c8-5c5a-30c3-b704-6d67597be061",
                                "text": "Déconsommer, c'est faire son propre savon à partir de copeaux de savon de Marseille 100% huile d'olive."
                            },
                            {
                                "example_id": "ad4c85a2-d23b-46d9-8617-f07dff2c60b9",
                                "sense_id": "5b1281c8-5c5a-30c3-b704-6d67597be061",
                                "text": "Déconsommer devient une mode, un nouvel art de vivre."
                            }
                        ]
                    }
                ],
