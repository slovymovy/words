                {
                    "sense_id": "64a92a67-026d-39c4-9c6f-a2ecb691b19d",
                    "sense_definition": "Action de faire connaître publiquement ou solennellement une nouvelle, une opinion ou une décision ; texte ou propos qui l'exprime.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ministre a fait une <w>déclaration</w> solennelle devant les journalistes réunis ce matin."
                        },
                        {
                            "text": "Cette <w>déclaration</w> inattendue a provoqué de nombreuses discussions passionnées parmi les participants."
                        }
                    ],
                    "synonyms": [
                        "affirmation",
                        "proclamation"
                    ],
                    "common_phrases": [
                        "déclaration officielle",
                        "faire une déclaration",
                        "déclaration de guerre"
                    ]
                },
                {
                    "sense_id": "6d60f3eb-8067-30a4-909a-5dbdd6e5ca1c",
                    "sense_definition": "Aveu explicite et sincère de ses sentiments amoureux à la personne aimée.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
