                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The school <w>banned</w> mobile phones in the classroom last year.",
                            "target_lang_translations": {
                                "ru": "В прошлом году школа <w>запретила</w> использование мобильных телефонов в классе.",
