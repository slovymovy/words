                ],
                "senses": [
                    {
                        "sense_id": "4399a771-6a59-331f-8f10-9a74adc35cd6",
                        "entry_id": "a62dbd72-a9e4-34b0-a527-aebb0dbd43af",
                        "glosses": [
                            "Une application, un programme directement utilisé par l'utilisateur pour réaliser une tâche, ou un ensemble de tâches élémentaires d'un même domaine ou formant un tout."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "670f64cb-698a-4d79-85cb-8865443e0071",
                                "sense_id": "4399a771-6a59-331f-8f10-9a74adc35cd6",
                                "text": "Comme elle a besoin de beaucoup de données par apprendre, les géants du numérique rendent leurs applicatifs addictifs, ce qui leur permet de récupérer les montagnes d'information nécessaires."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b01a88f-f090-4c0e-8f10-d0037a9c453e",
                        "source_entry_id": "a62dbd72-a9e4-34b0-a527-aebb0dbd43af",
                        "source_sense_id": "4399a771-6a59-331f-8f10-9a74adc35cd6",
                        "target_lang_word": "Anwendung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anwendung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d0985c46-a697-34c9-96d0-5a1adf3b1ebf",
                                        "entry_id": "feca844b-a947-3f2c-8195-c46f008ac948",
                                        "glosses": [
                                            "das Verwenden, Benutzen einer Sache zu einem gewissen Zweck"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b82ef86b-a0d7-4c78-8691-c14de08add28",
                                                "sense_id": "d0985c46-a697-34c9-96d0-5a1adf3b1ebf",
                                                "text": "Die Anwendung dieses Mittels ist ganz einfach."
                                            },
                                            {
                                                "example_id": "850f8676-652e-494c-8f26-b4983050ebaf",
                                                "sense_id": "d0985c46-a697-34c9-96d0-5a1adf3b1ebf",
                                                "text": "„Manche Berater Trumans rieten von der Anwendung der Bombe ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a94c78b6-c217-3d5e-94d1-0c693739aab9",
                                        "entry_id": "feca844b-a947-3f2c-8195-c46f008ac948",
                                        "glosses": [
                                            "Verabreichung eines Heilmittels bei medizinischen Behandlungen und Kuren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58b2d617-1285-4ce1-aef5-81fdf095bb24",
                                                "sense_id": "a94c78b6-c217-3d5e-94d1-0c693739aab9",
                                                "text": "Ich muss noch mehrere Anwendungen auf mich nehmen."
                                            },
                                            {
                                                "example_id": "1da3a372-7d75-484a-83bf-a6e130b1f3a7",
                                                "sense_id": "a94c78b6-c217-3d5e-94d1-0c693739aab9",
                                                "text": "„Allerdings war das Wissen über die korrekte Anwendung von Antibiotika äußerst lückenhaft: So glauben 65 Prozent, dass Antibiotika gegen Erkältungen und Schnupfen helfen - dabei richten solche Medikamente gegen Viruserkrankungen nichts aus und helfen nur gegen bakterielle Infektionen.“"
                                            },
                                            {
                                                "example_id": "c698c6f9-5880-4e14-8b0f-88a97fdfeed7",
                                                "sense_id": "a94c78b6-c217-3d5e-94d1-0c693739aab9",
                                                "text": "„Meistens musste Ida allein auf dem Zimmer bleiben, bis die Mama von ihren Anwendungen zurückkam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c80f305f-06d5-3081-86c7-ce990fd7150b",
                                        "entry_id": "feca844b-a947-3f2c-8195-c46f008ac948",
                                        "glosses": [
                                            "Anwendungsprogramm; Computerprogramm, das einem Endanwender nützen soll"
                                        ],
                                        "tags": [
                                            "Kurzform für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e506d66f-eda8-4d94-973e-2f55ba3c70b3",
                                                "sense_id": "c80f305f-06d5-3081-86c7-ce990fd7150b",
                                                "text": "Kennst du eine gute Anwendung um Bilder in ein anderes Format umzuwandeln?"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0e5b513-8648-4372-b63c-09ebcc87b9ee",
