                        "examples": [
                            {
                                "example_id": "21bfddba-84a4-40ab-83ee-fcc57856e746",
                                "sense_id": "3b6e1536-3529-3f65-be5f-c67eee3d09aa",
                                "text": "Maar tal van interessante persoonlijke krachtmetingen gaven de pas in de tweede helft boeiende botsing der giganten nog een extra dimensie. De alleraardigste was die tussen Marco van Basten uit Utrecht en Romario da Souza Faria uit Rio de Janeiro, de wellicht twee beste spitsen ter wereld."
                            }
                        ]
                    },
                    {
                        "sense_id": "1fd1e7bb-e09c-3541-83d6-f9d26d7c5f99",
                        "entry_id": "08cdd788-5724-3eae-a677-7ad3778e530b",
                        "glosses": [
                            "bij een bijvoeglijk naamwoord in de overtreffende trap",
                            "bij overdrijving gebruikt om een buitengewoon hoge graad van de stellende trap aan te geven"
                        ],
                        "tags": [
                            "intensifier",
                            "prefix"
                        ],
                        "examples": [
                            {
                                "example_id": "785321cb-96db-4522-8164-f5d1bb841dca",
                                "sense_id": "1fd1e7bb-e09c-3541-83d6-f9d26d7c5f99",
                                "text": "Jan 'Speedy' Lorré, handelaar in gebruikte wagens, koopt op zekere dag een alleraardigst autootje in voor weinig geld."
                            }
                        ]
                    },
                    {
                        "sense_id": "66dc1b77-e488-3ae5-aa24-91e044076260",
                        "entry_id": "08cdd788-5724-3eae-a677-7ad3778e530b",
                        "glosses": [
                            "in hoogst mogelijke graad (door reduplicatie sterk benadrukte vorm van aller-, betekenis [1])"
                        ],
                        "tags": [
                            "intensifier",
                            "prefix",
                            "vernacular"
                        ],
                        "examples": [
                            {
