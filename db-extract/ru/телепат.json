                    {
                        "translation_id": "8f973508-b671-49ef-8070-cd9da7130bd4",
                        "source_entry_id": "9462d2eb-25c9-3856-9dcd-98ca23aaa5f9",
                        "source_sense_id": "39d934cb-e95d-3d5d-9277-211ee0bbb4fd",
                        "target_lang_word": "télépathe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "télépathe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "39bac04b-4d8f-36cc-b175-c03c2829bdb1",
                                        "entry_id": "da14eb77-0a8f-38e4-82f4-b05967f2b770",
                                        "glosses": [
                                            "Personne douée de télépathie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71783053-ae83-4d40-b1ce-2e37eaba3904",
                                                "sense_id": "39bac04b-4d8f-36cc-b175-c03c2829bdb1",
                                                "text": "Les télépathes se répartissent en deux catégories distinctes, les autotélépathes qui approfondissent le gnothi seauton socratique, et les pseudotélépathes."
                                            },
                                            {
                                                "example_id": "06702697-70c2-4dc3-b157-a2eed1863110",
                                                "sense_id": "39bac04b-4d8f-36cc-b175-c03c2829bdb1",
                                                "text": "— Je suis cireur de bottes, monsieur ; et aussi commissionnaire. Mais tout cela ne serait rien. Je suis télépathe.\n— Hein ?\n— Télépathe.\n— Parfaitement.\n— Je reçois et je transmets la pensée à travers la distance. M. Broudier est un de mes abonnés."
                                            }
                                        ]
                                    }
                                ]
                            },
