                        "glosses": [
                            "Perdre (des kilos)."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "b4b63162-2c33-444e-91d4-1950d3b70321",
                                "sense_id": "aab869f0-32ae-3661-892c-8b778986154c",
                                "text": "J'ai 10 kilos à dékiloter"
                            },
                            {
                                "example_id": "787bae05-0de2-4231-9045-af17a6bd7528",
                                "sense_id": "aab869f0-32ae-3661-892c-8b778986154c",
                                "text": "j'ai dékiloté plus de 4 kg."
                            }
                        ]
                    },
                    {
                        "sense_id": "42e9d4ed-50f9-333b-8224-93380a7f7ea6",
                        "entry_id": "e6da0fee-6ff9-34cd-a37d-8bd44c22a824",
                        "glosses": [
                            "Perdre du poids."
                        ],
                        "tags": [
                            "pronominal",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "d4c4e098-cef4-4823-83b3-06d88cdf5be2",
                                "sense_id": "42e9d4ed-50f9-333b-8224-93380a7f7ea6",
                                "text": "D'ici à la fin des fêtes, il pouvait être plaisant de glousser, lors de repas arrosés, sur cette foule grandissante d'Ajacciens soucieux de se dékiloter."
                            },
                            {
                                "example_id": "01bfd142-2754-4bfd-9697-cfe3688f41db",
                                "sense_id": "42e9d4ed-50f9-333b-8224-93380a7f7ea6",
                                "text": "Dure nouvelle pour ceux qui croyaient la légende urbaine selon laquelle le sport en chambre faisait dépenser au moins 300 calories et qui misaient là-dessus pour se dékiloter."
                            }
                        ]
                    }
