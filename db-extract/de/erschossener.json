                ],
                "senses": [
                    {
                        "sense_id": "b622566c-3d18-388b-96d1-1602fbe2767d",
                        "entry_id": "aad75be3-6ad6-347c-9e4e-22e189f5aecb",
                        "glosses": [
                            "Person, die mit einer Schusswaffe getötet wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53c874b5-6ca1-43e5-b09c-dd2be5d5e87f",
                                "sense_id": "b622566c-3d18-388b-96d1-1602fbe2767d",
                                "text": "„Da der Mörder ein angesehener Mann aus bester Gesellschaft ist, soll Lizzie vor Gericht aussagen, der Erschossene habe versucht, sie zu vergewaltigen.“"
                            },
                            {
                                "example_id": "0fffdb76-8503-4ef5-b7b9-a7d2c3894454",
                                "sense_id": "b622566c-3d18-388b-96d1-1602fbe2767d",
                                "text": "„Die Auswertung einer großen Fülle an Handydaten habe ergeben, dass der Erschossene zwar keinerlei Kontakt zu den drei Angeklagten gehabt habe, sehr wohl aber zu jenen mutmaßlichen Dealern, mit denen die Angeklagten im Streit um Geld lagen und die in einem separaten Verfahren wegen Drogenhandels angeklagt sind.“"
                            },
                            {
                                "example_id": "d29a92ff-52fa-4494-809e-aad896d98f9c",
                                "sense_id": "b622566c-3d18-388b-96d1-1602fbe2767d",
                                "text": "„Unter den Erschossenen befand sich auch Velvele, mit vollem Namen Valentin Pinkert, der kleine jüdische Junge auf dem Dreirad – auf dem abgedruckten alten Foto – der von deutschen Mördern in Uniform erschossen wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
