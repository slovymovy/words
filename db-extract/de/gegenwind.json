                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0b94c7a-4d75-4ab4-804e-0755ca255dad",
                        "source_entry_id": "eacc11b9-6005-39d4-bb66-28f9f406d49a",
                        "source_sense_id": "dab6373a-344d-3896-a282-7896b918c9df",
                        "source_sense_description": "Wind von vorne, Wind aus der Richtung, in die eine Bewegung erfolgt",
                        "target_lang_word": "vent contraire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vent contraire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a3d0b76e-ea21-3877-b201-a74542629984",
                                        "entry_id": "35f85b77-1abb-3b34-b865-9c469c5ae871",
                                        "glosses": [
                                            "Vent opposé à la route que l’on veut faire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d06e193-5a60-4c48-866d-0f26c19a67bd",
                                                "sense_id": "a3d0b76e-ea21-3877-b201-a74542629984",
                                                "text": "Serait-ce quelque vent contraire qui m’aurait détourné de ma course ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbaa8f5e-68d9-3da4-9fed-04255e1bed96",
                                        "entry_id": "35f85b77-1abb-3b34-b865-9c469c5ae871",
                                        "glosses": [
                                            "Événement malheureux."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93f53d4e-dad8-437f-8de8-cc3e9a75a021",
                                                "sense_id": "bbaa8f5e-68d9-3da4-9fed-04255e1bed96",
                                                "text": "Alors que la chancelière Angela Merkel vient d’annoncer son retrait progressif de la vie politique, une série de vents contraires soufflent depuis l’été sur la conjoncture germanique."
                                            },
                                            {
                                                "example_id": "17da49a4-5e16-4dd1-9dc6-8138a87278b5",
                                                "sense_id": "bbaa8f5e-68d9-3da4-9fed-04255e1bed96",
                                                "text": "Sur les trois premiers mois de 2019, elle a engrangé 2,4 milliards de dollars de profit opérationnel. Mais c’est à ses yeux insuffisant pour affronter les vents contraires qui se lèvent de toutes parts dans l’industrie automobile."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
