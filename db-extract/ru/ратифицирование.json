                "senses": [
                    {
                        "sense_id": "a0586c1f-1885-36de-a792-e552a70c0485",
                        "entry_id": "5cc6bb13-b5c4-37f9-a18a-bc15854da45c",
                        "glosses": [
                            "юр., полит. действие по значению гл. ратифицировать; официальное утверждение чего-либо, придание чему-либо юридической силы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4f96d8e-4b57-4a14-813e-503d6c11e3dd",
                                "sense_id": "a0586c1f-1885-36de-a792-e552a70c0485",
                                "text": "В Германии ратифицирование международных договоров происходит на основе Закона о международных договорах 1969 года."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "968748df-c96f-4341-9ee1-5990dd3df8f7",
                        "source_entry_id": "5cc6bb13-b5c4-37f9-a18a-bc15854da45c",
                        "source_sense_id": "a0586c1f-1885-36de-a792-e552a70c0485",
                        "target_lang_word": "confirmation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "confirmation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd3751e0-eaa5-303c-940a-d39243beeda1",
                                        "entry_id": "76b09fcd-9d2c-386b-89a9-442e95123ba9",
                                        "glosses": [
                                            "An official indicator that things will happen as planned."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be14f2d6-dbe1-4c77-bab9-4958b99795ba",
                                                "sense_id": "cd3751e0-eaa5-303c-940a-d39243beeda1",
                                                "text": "We will send you a written confirmation of your hotel booking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecb103c7-3a4b-3fcb-ab81-77f89a827c0f",
                                        "entry_id": "76b09fcd-9d2c-386b-89a9-442e95123ba9",
                                        "glosses": [
                                            "A verification that something is true or has happened."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15b621df-ff85-4107-8e9c-455638913032",
                                                "sense_id": "ecb103c7-3a4b-3fcb-ab81-77f89a827c0f",
                                                "text": "The announcement in the newspaper was a confirmation of my suspicions."
                                            },
                                            {
                                                "example_id": "5e2e16b2-0833-47f9-b977-16b6b27d9826",
                                                "sense_id": "ecb103c7-3a4b-3fcb-ab81-77f89a827c0f",
                                                "text": "They declare ringing confirmation for their theories even in the face of feeble data."
                                            },
                                            {
                                                "example_id": "7640ca90-b238-4756-aac9-08579b57f6e8",
                                                "sense_id": "ecb103c7-3a4b-3fcb-ab81-77f89a827c0f",
                                                "text": "The thing is, we've even had formal confirmation from Government itself that the crucial research required to make such sweeping claims hasn't been done!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da94b533-4a9d-3869-81bd-6fd7b5db9e4f",
                                        "entry_id": "76b09fcd-9d2c-386b-89a9-442e95123ba9",
                                        "glosses": [
                                            "A ceremony of sealing and conscious acknowledgement of the faith in many Christian churches, typically around the ages of 14 to 18; considered a sacrament in some churches, including Catholicism, but not in most Protestant churches."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0140b33e-9431-488c-8cee-72905c5fb18b",
                                                "sense_id": "da94b533-4a9d-3869-81bd-6fd7b5db9e4f",
                                                "text": "You got a nice white dress / and a party on your confirmation. / You've got a brand new soul, / mm, and a cross of gold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17f71ab6-0896-3005-9fa7-8ccbfc4c2c67",
                                        "entry_id": "76b09fcd-9d2c-386b-89a9-442e95123ba9",
                                        "glosses": [
                                            "An act whereby something conditional or voidable is made sure and unavoidable, especially the possession of an estate."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
