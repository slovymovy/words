                "forms": [
                    {
                        "form_id": "ff83fd33-8d9c-4642-a14f-1bd630d2fa88",
                        "entry_id": "84d81e8d-d8bb-34df-9436-5f4b55477e31",
                        "tags": [
                            "plural"
                        ],
                        "form": "planeconomieën"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "23a3ada7-ec0c-3dbe-a9f9-ce3780fb17e7",
                        "entry_id": "84d81e8d-d8bb-34df-9436-5f4b55477e31",
                        "glosses": [
                            "een door de centrale overheid bestuurde economie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24cbf12c-e9c5-4c1b-9179-1409d8f7c503",
                                "sense_id": "23a3ada7-ec0c-3dbe-a9f9-ce3780fb17e7",
                                "text": "Zelfs Leon Trotski zag plaats voor de markt binnen zijn planeconomie. Precies omdat het een nuttig instrument is, zal de markt niet mee geofferd worden met het marktfundamentalisme. Wellicht is Trump dus niet de ruiter die het einde van het kapitalisme aankondigt."
                            }
                        ]
                    },
                    {
                        "sense_id": "40114a5d-be89-3012-a142-a4392637f0b4",
                        "entry_id": "84d81e8d-d8bb-34df-9436-5f4b55477e31",
                        "glosses": [
                            "de leer van hoe je een economie als geheel kunt sturen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb205125-d88d-4c14-909b-cf332b919769",
                                "sense_id": "40114a5d-be89-3012-a142-a4392637f0b4",
                                "text": "Maar Thieme is daarin niet blijven hangen: ze is uit die vissenkom gesprongen. Met haar boek De kanarie in de kolenmijn heeft ze in en buiten Nederland het debat over haar Plan B, de groene planeconomie van de 21ste eeuw, naar zich toegetrokken. Dat gaat zich uitbetalen, ook na 15 maart."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57b2a0de-55f0-4b18-9653-9fb8401e15ba",
                        "source_entry_id": "84d81e8d-d8bb-34df-9436-5f4b55477e31",
                        "source_sense_id": "23a3ada7-ec0c-3dbe-a9f9-ce3780fb17e7",
                        "source_sense_description": "(politiek) een door de centrale overheid bestuurde economie",
                        "target_lang_word": "command economy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "command economy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e18eb3e6-c37c-30f7-84c9-908f0ac5ae03",
                                        "entry_id": "7d6fe66c-404d-37c0-8b5f-89f37ee3d0c7",
                                        "glosses": [
                                            "A planned economy in which the government (or some other central authority) is solely responsible for resource allocation, distribution and the setting of prices, with little to no market influence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "999ec292-2329-4aa7-9291-bd6bbe7e0b7b",
                                                "sense_id": "e18eb3e6-c37c-30f7-84c9-908f0ac5ae03",
                                                "text": "Some scholars continue to blame the USSR's command economy for its 1991 collapse."
                                            },
                                            {
                                                "example_id": "2b5c39b2-936d-4667-ab66-417933275507",
                                                "sense_id": "e18eb3e6-c37c-30f7-84c9-908f0ac5ae03",
                                                "text": "Following some National Socialist economists, we may distinguish three types of economies existing within Germany: a competitive economy, a monopolistic economy, and a command economy […]"
                                            },
                                            {
                                                "example_id": "f72b6b28-aa49-4bda-a949-bd68dd0a3a9d",
                                                "sense_id": "e18eb3e6-c37c-30f7-84c9-908f0ac5ae03",
                                                "text": "Willy Neuling saw three fundamental types of economic order, namely individualism, monopolism, and command economy (Befehlswirtschaft), and believed that a quite new type of economic theory, indispensable for analyzing the “command economy,” was in the offing […]"
                                            },
                                            {
                                                "example_id": "e889642d-1794-48bf-9463-3f5a63a18425",
                                                "sense_id": "e18eb3e6-c37c-30f7-84c9-908f0ac5ae03",
                                                "text": "Khrushchev is turning the top-heavy administrative machinery of a gigantic command economy upside down. He is breaking overnight the customary links, thus clogging the well-worn channels of command; he is driving all the most competent higher administrators into frantic opposition […]"
                                            },
                                            {
                                                "example_id": "b95b6ef4-15e3-47f3-8226-fa0a18420ccb",
                                                "sense_id": "e18eb3e6-c37c-30f7-84c9-908f0ac5ae03",
                                                "text": "An expansion of tourism [sc. in Yugoslavia] is one purpose of the measure. It is also part of another move by Yugoslavia away from the Soviet-style “command” economy. When Marshall Tito broke with Stalin, his country's economy was organized on the Russian pattern […]"
                                            },
                                            {
                                                "example_id": "ad30f59c-4755-494c-8b15-1279b7f5fc47",
                                                "sense_id": "e18eb3e6-c37c-30f7-84c9-908f0ac5ae03",
                                                "text": "Until now, the highly centralised command economy has worked better in East Germany than in other Comecon countries, especially the Soviet Union. But now it is being called on to propel East Germany into the micro-electronics age and to close the 30 per cent gap in labour productivity compared with West germany."
                                            },
                                            {
                                                "example_id": "683e2581-206e-4402-a79f-72a7c6a9299a",
                                                "sense_id": "e18eb3e6-c37c-30f7-84c9-908f0ac5ae03",
                                                "text": "Yet it is hard to hand out enormous sums without turning poor countries into miniature command economies. Development projects mostly attempt to build entire industries, such as dairy farming or fisheries, from scratch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e9c7605-ead3-3c93-af0b-1509e6fbe305",
                                        "entry_id": "7d6fe66c-404d-37c0-8b5f-89f37ee3d0c7",
                                        "glosses": [
                                            "A planned economy."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
