                "senses": [
                    {
                        "sense_id": "ef384fff-f664-35fc-9aff-7e931e4e51b3",
                        "entry_id": "b2df1700-e5dc-3eba-880c-712e826a4e33",
                        "glosses": [
                            "dienstplichtige"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e4c4beb-d5c4-46f8-ad5c-7daf38f2be89",
                                "sense_id": "ef384fff-f664-35fc-9aff-7e931e4e51b3",
                                "text": "Als model voor ‘Afghanistan’ en voor wat gevechtsvliegtuigen en helikopters bijdragen aan het beslechten van een grootschalig guerrillaconflict beschouwt Van Creveld bijvoorbeeld de Franse strijd in Algerije in de jaren vijftig. Die analogie stemt somber. De Fransen hadden in de kolonie jarenlang 400.000 reguliere manschappen op de been, aangevuld met bijna tweehonderdduizend Algerijnse miliciens. En de Franse luchtmacht vloog in het conflict met honderden jagers, bommenwerpers, helikopters en transportvliegtuigen. Hun luchtoverwicht was totaal, want de tegenstanders van het Nationaal Bevrijdingsfront die op het hoogtepunt nauwelijks 40.000 man telden, hadden geen luchtmacht en geen luchtafweergeschut."
                            },
                            {
                                "example_id": "c1e013c0-1cb7-4461-8ff6-ab6bdd71997a",
                                "sense_id": "ef384fff-f664-35fc-9aff-7e931e4e51b3",
                                "text": "Vorige week werden al twee medewerkers van de marinekazerne gearresteerd. Een van hen is een 23-jarige milicien, een dienstplichtige eilandbewoner. De tweede is een 48-jarige burgermedewerker van Defensie. Beiden worden verdacht van het uitvoeren van cocaïne via de militaire post. Hoe dit precies in zijn werk ging, wil de marechaussee niet zeggen. Mogelijk volgen meer aanhoudingen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52d20cfe-7e9e-4d4e-b45f-e00ec8cff11d",
                        "source_entry_id": "b2df1700-e5dc-3eba-880c-712e826a4e33",
                        "source_sense_id": "ef384fff-f664-35fc-9aff-7e931e4e51b3",
                        "source_sense_description": "(militair) dienstplichtige",
                        "target_lang_word": "soldier",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soldier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f458d2e2-b16b-3cb5-adba-de361aab8cef",
                                        "entry_id": "90c0b38e-d792-3eb8-95a7-78741ddb52c4",
                                        "glosses": [
                                            "A member of a ground-based army, of any rank, but especially an enlisted member."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84a907cc-653f-496b-b31e-62141e2c4cba",
                                                "sense_id": "f458d2e2-b16b-3cb5-adba-de361aab8cef",
                                                "text": "My friends and I saw a soldier questioning a man holding a bag with a gun in his pocket."
                                            },
                                            {
                                                "example_id": "6a15a22d-d5aa-4220-98da-28b8af274fb7",
                                                "sense_id": "f458d2e2-b16b-3cb5-adba-de361aab8cef",
                                                "text": "The Citizens in their rage, imagining that euery poſt in the Churche had bin one of yᵉ Souldyers, ſhot habbe or nabbe at randon uppe to the Roode lofte, and to the Chancell, leauing ſome of theyr arrowes ſticking in the Images."
                                            },
                                            {
                                                "example_id": "531f21c9-bb51-4550-a054-c58e2785471f",
                                                "sense_id": "f458d2e2-b16b-3cb5-adba-de361aab8cef",
                                                "text": "I am a soldier and unapt to weep."
                                            },
                                            {
                                                "example_id": "24b1d4f9-92db-4812-8a24-64fa165cbc05",
                                                "sense_id": "f458d2e2-b16b-3cb5-adba-de361aab8cef",
                                                "text": "Captain Edward Carlisle, soldier as he was, martinet as he was, felt a curious sensation of helplessness seize upon him as he met her steady gaze, her alluring smile ; he could not tell what this prisoner might do."
                                            },
                                            {
                                                "example_id": "47495e55-cf17-43c8-8392-69a0fbd86682",
                                                "sense_id": "f458d2e2-b16b-3cb5-adba-de361aab8cef",
                                                "text": "Stanning, who was commissioned from Sandhurst in 2008 and has served in Afghanistan, is not the first soldier to bail out the organisers at these Games but will be among the most celebrated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f080dc70-5701-3a6a-a96f-0ce837aba721",
                                        "entry_id": "90c0b38e-d792-3eb8-95a7-78741ddb52c4",
                                        "glosses": [
                                            "Any member of a military, regardless of specialty."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "nonstandard"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2c30fa3e-041d-31fc-bb4d-5916733d1384",
                                        "entry_id": "90c0b38e-d792-3eb8-95a7-78741ddb52c4",
                                        "glosses": [
                                            "An enlisted member of a military service, as distinguished from a commissioned officer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49acf6f9-3184-4216-82af-f6606230e63f",
                                                "sense_id": "2c30fa3e-041d-31fc-bb4d-5916733d1384",
                                                "text": "She saw a soldier while collecting her baggage at the airport."
                                            },
                                            {
                                                "example_id": "1051f4fc-a3b5-406d-9686-14aafc9223c2",
                                                "sense_id": "2c30fa3e-041d-31fc-bb4d-5916733d1384",
                                                "text": "It were meet that any one, before he came to be a captain, should have been a soldier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4895d35b-f210-3c17-9f90-f9a99415a781",
                                        "entry_id": "90c0b38e-d792-3eb8-95a7-78741ddb52c4",
