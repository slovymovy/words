        "fr-extract.jsonl": [
            {
                "entry_id": "a0c442e5-2ece-3b54-98b8-f46649caedf9",
                "word": "Ourthe",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8efd44f1-12f0-3c3d-bfc4-8043bab07a50",
                        "entry_id": "a0c442e5-2ece-3b54-98b8-f46649caedf9",
                        "glosses": [
                            "Rivière de Belgique, affluent en rive droite de la Meuse."
                        ],
                        "tags": [
                            "Cours d’eau"
                        ],
                        "examples": [
                            {
                                "example_id": "4dc05200-9cf6-4c57-a3c3-0ff4df05b7ba",
                                "sense_id": "8efd44f1-12f0-3c3d-bfc4-8043bab07a50",
                                "text": "Si par malheur les crues de l’Ourthe coïncidaient avec celles de la Meuse, des inondations catastrophiques affectaient toute la vallée en aval de Liège."
                            },
                            {
                                "example_id": "9404a4fc-384b-41b7-9540-5d3700770e71",
                                "sense_id": "8efd44f1-12f0-3c3d-bfc4-8043bab07a50",
                                "text": "Les habitants d’Houffalize, tapie au fond de sa vallée, au bord de l’Ourthe claire, et que la guerre avait jusque là épargnée, virent arriver les avions […], et une minute plus tard, Houffalize n'existait plus."
                            },
                            {
                                "example_id": "5a3067a8-ee66-4778-b86e-e4232fabe10e",
                                "sense_id": "8efd44f1-12f0-3c3d-bfc4-8043bab07a50",
                                "text": "Le 7 janvier 1636, un recès du Chapitre Cathédral de Liège ordonne aux habitants de Tilff et de Méry de prendre les armes pour garantir la circulation sur l’Ourthe, alors menacée par des pillards croates."
                            }
                        ]
                    }
                ],
