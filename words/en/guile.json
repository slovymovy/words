{
    "word_family": [
        "guileful",
        "guileless"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5f9bee4b-3cdf-314a-9883-80615ac1c4fd",
                    "sense_definition": "Astuteness often marked by a certain sense of cunning or artful deception.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The veteran player used his <w>guile</w> to outsmart the younger defenders during the match.",
                            "target_lang_translations": {
                                "fr": "Le joueur expérimenté a usé de sa <w>ruse</w> pour déjouer les jeunes défenseurs pendant le match."
                            }
                        },
                        {
                            "text": "She showed great <w>guile</w> in negotiating the contract to her advantage.",
                            "target_lang_translations": {
                                "fr": "Elle a fait preuve d'une grande <w>finesse</w> pour négocier le contrat à son avantage."
                            }
                        }
                    ],
                    "synonyms": [
                        "cunning",
                        "craftiness",
                        "slyness"
                    ],
                    "antonyms": [
                        "honesty",
                        "sincerity"
                    ],
                    "common_phrases": [
                        "pure guile"
                    ],
                    "target_lang_definitions": {
                        "fr": "Astuce ou habileté marquée par la ruse, la finesse ou l'art de tromper."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "ruse",
                                "target_lang_sense_clarification": "habileté, artifice ou finesse pour parvenir à ses fins"
                            },
                            {
                                "target_lang_word": "finesse",
                                "target_lang_sense_clarification": "subtilité d'esprit, ingéniosité"
                            },
                            {
                                "target_lang_word": "astuce",
                                "target_lang_sense_clarification": "habileté ingénieuse"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94ade7ca-46ec-36d6-82ee-caf93b9897bf",
                    "sense_definition": "Deceptiveness, deceit, fraud, duplicity, or dishonesty.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was a man of absolute integrity, in whom there was no <w>guile</w>.",
                            "target_lang_translations": {
                                "fr": "C'était un homme d'une intégrité absolue, exempt de toute <w>fourberie</w>."
                            }
                        },
                        {
                            "text": "The politician was accused of using <w>guile</w> to manipulate the public opinion.",
                            "target_lang_translations": {
                                "fr": "Le politicien a été accusé d'avoir usé de <w>tromperie</w> pour manipuler l'opinion publique."
                            }
                        }
                    ],
                    "synonyms": [
                        "deceit",
                        "duplicity",
                        "dishonesty"
                    ],
                    "antonyms": [
                        "truthfulness",
                        "candor"
                    ],
                    "target_lang_definitions": {
                        "fr": "Caractère trompeur, duplicité, fausseté ou mauvaise foi délibérée."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "fourberie",
                                "target_lang_sense_clarification": "action ou disposition perfide et trompeuse"
                            },
                            {
                                "target_lang_word": "tromperie",
                                "target_lang_sense_clarification": "acte de tromper délibérément"
                            },
                            {
                                "target_lang_word": "duplicité",
                                "target_lang_sense_clarification": "fausseté, hypocrisie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b304cb68-d7f5-37e9-a776-160ff942951f",
                    "sense_definition": "An obsolete form of <w>gold</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient text referred to the precious <w>guile</w> found in the riverbed.",
                            "target_lang_translations": {
                                "fr": "Le texte ancien mentionnait le précieux <w>or</w> découvert dans le lit de la rivière."
                            }
                        },
                        {
                            "text": "In old manuscripts, the word <w>guile</w> was sometimes used to describe refined metal.",
                            "target_lang_translations": {
                                "fr": "Dans les manuscrits anciens, le mot « <w>guile</w> » était parfois utilisé pour désigner le métal raffiné."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "This sense is no longer in use."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Forme obsolète du mot or."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "or",
                                "target_lang_sense_clarification": "métal précieux (forme archaïque)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ccf4bad-a4e5-3a87-923f-5fabbbcadd54",
                    "sense_definition": "An alternative form of gyle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The brewer monitored the <w>guile</w> carefully during the fermentation process.",
                            "target_lang_translations": {
                                "fr": "Le brasseur surveillait attentivement le <w>brassin</w> pendant le processus de fermentation."
                            }
                        },
                        {
                            "text": "A fresh batch of <w>guile</w> was prepared for the next stage of brewing.",
                            "target_lang_translations": {
                                "fr": "Un nouveau lot de <w>moût</w> fut préparé pour la prochaine étape du brassage."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Variante orthographique de « gyle » (moût ou brassin en cours de fermentation)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "brassin",
                                "target_lang_sense_clarification": "quantité de bière brassée en une fois"
                            },
                            {
                                "target_lang_word": "moût",
                                "target_lang_sense_clarification": "liquide en fermentation dans la bière"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c7a29e9d-1c1c-3377-a1ab-dc57ffef0fb8",
                    "sense_definition": "To deceive or beguile.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not let his charming smile <w>guile</w> you into trusting him.",
                            "target_lang_translations": {
                                "fr": "Ne laissez pas son sourire charmant vous <w>tromper</w> en vous poussant à lui faire confiance."
                            }
                        },
                        {
                            "text": "He tried to <w>guile</w> the unsuspecting traveler with false promises.",
                            "target_lang_translations": {
                                "fr": "Il a tenté de <w>duper</w> le voyageur méfiant avec de fausses promesses."
                            }
                        }
                    ],
                    "synonyms": [
                        "deceive",
                        "trick",
                        "beguile"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This verb sense is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Tromper, duper ou séduire par des artifices (archaïque)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "tromper",
                                "target_lang_sense_clarification": "induire en erreur"
                            },
                            {
                                "target_lang_word": "duper",
                                "target_lang_sense_clarification": "abuser de la naïveté de quelqu'un"
                            },
                            {
                                "target_lang_word": "entourlouper",
                                "target_lang_sense_clarification": "tromper par ruse (familier)"
                            }
                        ]
                    }
                }
            ]
        },
