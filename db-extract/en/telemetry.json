                        "entry_id": "1088acf1-4b02-3b59-8526-5eb0a3695b5c",
                        "glosses": [
                            "The science, and associated technology, of the automatic recording and transmission of data from a remote source to a receiving station for analysis."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "052f822c-71ff-4fdb-89c6-7cb2048d6e4c",
                                "sense_id": "9e35280c-165b-3d53-8080-9691ee1af764",
                                "text": "We have also installed river level monitors and scour telemetry on more than 25 bridges across our network, and over the next two years we will continue to increase the number of locations fitted with these technologies."
                            }
                        ]
                    }
                ],
