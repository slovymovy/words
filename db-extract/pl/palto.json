                ],
                "senses": [
                    {
                        "sense_id": "a44df60f-c325-336b-8957-f9f7cb3368e0",
                        "entry_id": "a6880932-2d71-37ca-a44a-95170989a6e1",
                        "glosses": [
                            "ciepłe okrycie wierzchnie do noszenia głównie zimą"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5edaa83e-bcf0-4d48-b777-0d307e1734ca",
                                "sense_id": "a44df60f-c325-336b-8957-f9f7cb3368e0",
                                "text": "I tak prędko po kolei odrywali się od stołu, rzucali nie dokończony obiad, kiwali głowami nie mając czasu na inne pożegnania i wybiegali ubierając się już w palta na schodach, i lecieli do fabryk, porywani tymi świstami, co jak kanonada rozlegały się nad miastem i zwoływały do pracy"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c488d13-a718-4a71-a756-f5af2fe9b91b",
                        "source_entry_id": "a6880932-2d71-37ca-a44a-95170989a6e1",
                        "source_sense_id": "a44df60f-c325-336b-8957-f9f7cb3368e0",
                        "target_lang_word": "overcoat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overcoat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf97172a-f73c-3e91-9741-a6b4fb5e54fd",
                                        "entry_id": "0c05952e-1d41-3e40-8a4c-d52cc167fd72",
                                        "glosses": [
                                            "A heavy garment worn over other clothes, for protection from cold or weather."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1379b8c4-c65c-4ead-b9fa-d83a55bb2c3c",
                                                "sense_id": "cf97172a-f73c-3e91-9741-a6b4fb5e54fd",
                                                "text": "Men that I knew around Wapatomac didn't wear high, shiny plug hats, nor yeller spring overcoats, nor carry canes with ivory heads as big as a catboat's anchor, as you might say."
                                            },
                                            {
                                                "example_id": "8bd02d6a-44bf-4863-8c6c-4d75a13572dd",
                                                "sense_id": "cf97172a-f73c-3e91-9741-a6b4fb5e54fd",
                                                "text": "‘It's rather like a beautiful Inverness cloak one has inherited. Much too good to hide away, so one wears it instead of an overcoat and pretends it's an amusing new fashion.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69b5cbef-17ac-3642-bdbc-2b191f60d155",
                                        "entry_id": "0c05952e-1d41-3e40-8a4c-d52cc167fd72",
                                        "glosses": [
                                            "An outer coat, an outer coating (of paint, etc)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f53ca39-9b4c-4db5-94fc-9a80c45f0c4b",
                                                "sense_id": "69b5cbef-17ac-3642-bdbc-2b191f60d155",
                                                "text": "Near-synonym: topcoat"
                                            },
                                            {
                                                "example_id": "1b6451af-889c-44a5-b598-6915a18b6d61",
                                                "sense_id": "69b5cbef-17ac-3642-bdbc-2b191f60d155",
                                                "text": "Wait 24 hours before applying an overcoat."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "overcoat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2de3b01a-200d-3a58-bba6-26bd2907dcbd",
                                        "entry_id": "b9cd20cd-ffff-3584-a5c0-b05654556793",
                                        "glosses": [
                                            "To apply an exterior coating to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a366fe14-3e6d-4472-a4a4-08cd2139e950",
                                                "sense_id": "2de3b01a-200d-3a58-bba6-26bd2907dcbd",
                                                "text": "Wait 24 hours before overcoating with either this product or a clearcoat."
                                            },
                                            {
                                                "example_id": "4b6e0c8c-79f3-4331-8c72-b3261d2b128c",
                                                "sense_id": "2de3b01a-200d-3a58-bba6-26bd2907dcbd",
                                                "text": "One method is to overcoat the fiber with Teflon AF, an amorphous Teflon that transmits over most of sapphire fiber's transmission range."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5ed32cad-9353-4881-bd5b-5340fb76da9a",
                        "source_entry_id": "a6880932-2d71-37ca-a44a-95170989a6e1",
                        "source_sense_id": "a44df60f-c325-336b-8957-f9f7cb3368e0",
                        "target_lang_word": "topcoat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "topcoat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "490ef7c3-86ab-3b05-97d8-ab8110f21cf4",
                                        "entry_id": "abd9ca7c-9271-3c3e-85a5-2a92fbb43644",
                                        "glosses": [
                                            "A light overcoat (outer garment)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f319919-0850-4c14-91d9-32be558cfb76",
                                                "sense_id": "490ef7c3-86ab-3b05-97d8-ab8110f21cf4",
                                                "text": "Our new acquaintance very deliberately coiled up the tube of his hookah, and produced from behind a curtain a very long befrogged topcoat with Astrakhan collar and cuffs."
                                            },
                                            {
                                                "example_id": "df2ec39c-fd32-4ac1-97db-440baa910684",
                                                "sense_id": "490ef7c3-86ab-3b05-97d8-ab8110f21cf4",
                                                "text": "He is wearing a black armband on the left sleeve of his gray topcoat."
                                            },
                                            {
                                                "example_id": "f487cc2c-0d8a-4164-9311-44fe46b557d1",
                                                "sense_id": "490ef7c3-86ab-3b05-97d8-ab8110f21cf4",
                                                "text": "Whereas Oehler habitually wears his topcoat completely buttoned up, I leave my topcoat completely open."
                                            },
                                            {
                                                "example_id": "4e5c9271-86bf-4262-b996-3a781bcec2e5",
                                                "sense_id": "490ef7c3-86ab-3b05-97d8-ab8110f21cf4",
                                                "text": "Then he opened his closet and took out a black topcoat. It was heavily lined with silk, soft to the touch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b229528c-86fc-3c38-bdd3-7e062322a3cd",
                                        "entry_id": "abd9ca7c-9271-3c3e-85a5-2a92fbb43644",
                                        "glosses": [
                                            "A layer of paint or varnish etc. applied after the undercoat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a18f1782-cc3a-4ab4-9d32-39d7e5e6c5f6",
                                                "sense_id": "b229528c-86fc-3c38-bdd3-7e062322a3cd",
                                                "text": "Near-synonym: overcoat"
                                            },
                                            {
                                                "example_id": "df8fd61f-7db3-4a7b-aa8e-12671f7193f1",
                                                "sense_id": "b229528c-86fc-3c38-bdd3-7e062322a3cd",
                                                "text": "Apply two topcoats, particularly to areas that are fully exposed to the weather such as the south side of the house. A total of three coats (primer and two topcoats) should result in an optimum thickness of 4-1/2 to 5 mils."
                                            },
                                            {
                                                "example_id": "f1b4e8e2-76d6-4943-9047-99345aa9c399",
                                                "sense_id": "b229528c-86fc-3c38-bdd3-7e062322a3cd",
                                                "text": "Fig. 7 shows the microstructures of lutetium silicate topcoat on SiC/SiC composite after various exposure tests."
                                            },
                                            {
                                                "example_id": "ced3160c-7a8c-40c7-89fc-5410f7f3170d",
                                                "sense_id": "b229528c-86fc-3c38-bdd3-7e062322a3cd",
                                                "text": "Without the protection of the topcoat, your wood constantly expands and contracts and is more susceptible to warping and cracking. Topcoats also improve the look of the wood by adding depth and color."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "topcoat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb62e83b-2634-3ff0-ba96-6a1966dea8e5",
                                        "entry_id": "ba201269-21fa-30bb-9fb5-6b2fccc2cdaf",
                                        "glosses": [
                                            "To apply a topcoat to (something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4be2c84-ce28-4261-9afd-ff6cef299cac",
                        "source_entry_id": "a6880932-2d71-37ca-a44a-95170989a6e1",
                        "source_sense_id": "a44df60f-c325-336b-8957-f9f7cb3368e0",
                        "target_lang_word": "abrigo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abrigo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "66f4698b-d357-3ffb-aebd-bcc8b737940f",
                                        "entry_id": "3e0a0b2e-feaf-35ef-a1a4-23eda033e04d",
                                        "glosses": [
                                            "Prenda de vestir que se pone encima de las demás y sirve para abrigar."
                                        ],
                                        "tags": [
                                            "Vestimenta"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9af46473-4038-4803-8b5b-0a21b42e746d",
                                                "sense_id": "66f4698b-d357-3ffb-aebd-bcc8b737940f",
                                                "text": "Ponte el abrigo que hace mucho frío."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "93b461e1-d6d0-3466-bb00-0f125a7b8126",
                                        "entry_id": "3e0a0b2e-feaf-35ef-a1a4-23eda033e04d",
                                        "glosses": [
                                            "Cualquier cosa que defiende, resguarda o protege, especialmente del frío, pero también de la intemperie o los peligros."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7a1e8689-29ad-3b85-bc5e-aabb9f546d25",
                                        "entry_id": "3e0a0b2e-feaf-35ef-a1a4-23eda033e04d",
                                        "glosses": [
                                            "Lugar para refugiarse contra las inclemencias del tiempo, como por ejemplo de las ventiscas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29378132-1f1f-4068-b251-47b1bfbaf142",
                                                "sense_id": "7a1e8689-29ad-3b85-bc5e-aabb9f546d25",
                                                "text": "Los alpinistas buscaban un abrigo para protegerse de la ventisca."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "1e3672e8-07a8-3a93-8828-652de215dddf",
                                        "entry_id": "3e0a0b2e-feaf-35ef-a1a4-23eda033e04d",
                                        "glosses": [
                                            "Acción o efecto de abrigar o de abrigarse."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "91ed74a6-88cd-32c9-b635-c97c48d6b980",
                                        "entry_id": "3e0a0b2e-feaf-35ef-a1a4-23eda033e04d",
                                        "glosses": [
                                            "Lugar de la costa que sirve a las naves para resguardarse de los vientos, las olas y las corrientes."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "65354854-42ee-3625-bb11-a7f3f04acd55",
                                        "entry_id": "3e0a0b2e-feaf-35ef-a1a4-23eda033e04d",
                                        "glosses": [
                                            "Pequeño saliente en la roca, menor que una cueva. Cueva natural donde se supone que hubo asentamientos prehistóricos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1a453fc-f701-42bc-92ff-75b6ed9a344f",
                                                "sense_id": "65354854-42ee-3625-bb11-a7f3f04acd55",
                                                "text": "En diversos lugares de la península Ibérica abundan las pinturas rupestres en los abrigos."
