                    },
                    {
                        "translation_id": "414012fb-c1cc-430f-8186-3f174270a481",
                        "source_entry_id": "32dcbf96-c6cb-3d02-bc3d-f0d4c867fe3a",
                        "source_sense_id": "c7852408-635f-35f6-ac29-2624a32cc6ce",
                        "target_lang_word": "de jure",
