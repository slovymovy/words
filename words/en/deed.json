    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bf8bb6d6-22be-36ec-b982-1ad767a145e9",
                    "sense_definition": "An intentional act or action that is performed.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "action_senses",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She tried to do a good <w>deed</w> for her neighbor every day.",
                            "target_lang_translations": {
                                "ru": "Она старалась делать доброе <w>дело</w> для своего соседа каждый день.",
                                "nl": "Ze probeerde elke dag een goede <w>daad</w> te verrichten voor haar buurman."
                            }
                        },
                        {
                            "text": "He will eventually be punished for his evil <w>deeds</w>.",
                            "target_lang_translations": {
                                "ru": "В конце концов он будет наказан за свои злые <w>деяния</w>.",
                                "nl": "Hij zal uiteindelijk gestraft worden voor zijn slechte <w>daden</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "act",
                        "action"
                    ],
                    "common_phrases": [
                        "good deed",
                        "bad deed",
                        "dirty deed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Намеренное действие или поступок, совершаемый человеком.",
                        "nl": "Een opzettelijke handeling of actie die wordt uitgevoerd."
                    },
                    "translations": {
