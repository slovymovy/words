                        ],
                        "examples": [
                            {
                                "example_id": "d269bdf9-9ef0-4cf0-a898-ce7a61e89db3",
                                "sense_id": "9a1f7dc2-28d9-38bd-b5a4-3c3213163bcc",
                                "text": "Les Ichniographes sont ceux qui ont exprimés les plantes , soit en gravures, soit en couleurs, ou qui les ont figurées en bois, ou empreintes en original &c."
                            },
                            {
                                "example_id": "7db5124e-d2a9-4b0e-92a1-b3ebb568e865",
                                "sense_id": "9a1f7dc2-28d9-38bd-b5a4-3c3213163bcc",
                                "text": "Dans le Fundamenta botanica, il place parmi les “collecteurs” la catégorie des “ichniographes” qui “exprimèrent par des images les figures des végétaux”. Il souligne alors que l'art de la gravure était inconnu des Anciens et qu'un herbier l'emporte de toutes façons sur toutes sortes de figures."
                            }
                        ]
                    }
