                ],
                "senses": [
                    {
                        "sense_id": "aa014d0f-72c9-3faa-beb2-9451bfd9a314",
                        "entry_id": "55a604d8-29d5-3385-9a29-1658094dbce8",
                        "glosses": [
                            "weit verbreitetes dunkelbraunes bis schwarzes oder gelbliches bis rötliches Pigment"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8be541c9-0e88-4c67-800f-a79348aa572b",
                                "sense_id": "aa014d0f-72c9-3faa-beb2-9451bfd9a314",
                                "text": "„Da auch helle Falter noch den dunklen Melaninfarbstoff besitzen, ist nicht einmal von Mikroevolution zu sprechen.“"
                            },
                            {
                                "example_id": "11dda213-06c9-4936-b9bf-648ccad98897",
                                "sense_id": "aa014d0f-72c9-3faa-beb2-9451bfd9a314",
                                "text": "„Dieser eliminierte Eiweißkomplex bildet also das korpuskuläre Pigment, das zugleich durch seine in Melaninfarbstoff umgewandelte Suprareninkomponente die braunschwarze Tönung erhält.“"
                            },
                            {
                                "example_id": "f6a1608e-0beb-4262-a576-1809c0e6e601",
                                "sense_id": "aa014d0f-72c9-3faa-beb2-9451bfd9a314",
                                "text": "„Ähnliche Hyperpigmentierungen entstehen oft auch nach Entzündungen, da durch die Heftigkeit der Entzündung Melaninfarbstoff aus dem ersten ins zweite Untergeschoss abtropft und da monatelang liegen bleibt.“"
                            },
                            {
                                "example_id": "acf7f520-fb8d-4ea6-acbf-c33b5682b9c5",
                                "sense_id": "aa014d0f-72c9-3faa-beb2-9451bfd9a314",
                                "text": "„Außer den Farbstoffen struktureller Art (Blau, Weiß) finden sich neben den Melaninfarbstoffen verschiedene rote und gelbe Lypochrome, von denen einzelne Carotinoidcharakter besitzen.“"
                            },
                            {
                                "example_id": "bc1108cd-c47b-41fb-be3f-fe56c80b7360",
                                "sense_id": "aa014d0f-72c9-3faa-beb2-9451bfd9a314",
                                "text": "„Der Melaninfarbstoff ist im Zentrum der Flecken stärker konzentriert und weniger regelmäßig an den Randzonen verteilt, welche daher oft wie ausgefranst wirken.“"
                            },
                            {
                                "example_id": "b4c4514e-9230-40ae-9c57-88ff5f68f891",
                                "sense_id": "aa014d0f-72c9-3faa-beb2-9451bfd9a314",
                                "text": "„Die Proteine vernetzen sich mit Phenolpolymeren wie die Cellulose der Baumstämme mit Lignin und das Keratin der Haare mit Melaninfarbstoffen (Seite 189f).“"
                            },
                            {
                                "example_id": "80994599-2cf0-461e-9a08-b3a59aa46111",
                                "sense_id": "aa014d0f-72c9-3faa-beb2-9451bfd9a314",
                                "text": "„Ob wir nun eher dunkel oder hell sind, liegt auch am Mischungsverhältnis der Melaninfarbstoffe in unserer Haut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
