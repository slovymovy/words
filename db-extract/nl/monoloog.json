                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28d575fb-eebf-49c2-bb29-a5754cf9dc7e",
                        "source_entry_id": "27f88df2-b1ac-3b17-b0dd-38c0c041b0d5",
                        "source_sense_id": "8743734f-a139-3380-833b-1980d54662c5",
                        "source_sense_description": "een gesprek gevoerd door één persoon, meestal op toneel",
                        "target_lang_word": "monologue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monologue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e1e52661-fcd9-3e4d-9702-fea8a3c07b42",
                                        "entry_id": "7ecb750c-d8a0-3127-9bb9-0d5748cafa7e",
                                        "glosses": [
                                            "Scène d’une pièce de théâtre où un personnage est seul et se parle à lui-même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7508718a-2b1d-4de4-bdf7-7387ba9eb1f9",
                                                "sense_id": "e1e52661-fcd9-3e4d-9702-fea8a3c07b42",
                                                "text": "Un chef-d'œuvre d’Arthur Schnitzler converti en un monologue vécu en direct par l’héroïne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "739a0835-bba3-350e-ac47-70c948d43189",
                                        "entry_id": "7ecb750c-d8a0-3127-9bb9-0d5748cafa7e",
                                        "glosses": [
                                            "Scène dite par un seul personnage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52af6958-5558-4bd0-9bbe-ee34b996d95e",
                                                "sense_id": "739a0835-bba3-350e-ac47-70c948d43189",
                                                "text": "Réciter un monologue."
                                            },
                                            {
                                                "example_id": "5b97dd45-68fa-4ff6-998e-b9ffbba87246",
                                                "sense_id": "739a0835-bba3-350e-ac47-70c948d43189",
                                                "text": "Faire un monologue interne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44a4f6a2-70c4-37c7-9396-7a68a424ce4a",
                                        "entry_id": "7ecb750c-d8a0-3127-9bb9-0d5748cafa7e",
                                        "glosses": [
                                            "Discours d’une personne parlant toute seule ou ne laissant pas parler les autres, ou parlant simplement pour elle-même."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c392ed02-0f57-4fc1-936d-869dde6155e5",
                                                "sense_id": "44a4f6a2-70c4-37c7-9396-7a68a424ce4a",
                                                "text": "[…] et il resta content, sans deviner combien le monologue est blessant pour des provinciaux dont la principale occupation est de démontrer aux Parisiens l’existence, l’esprit et la sagesse de la province."
                                            },
                                            {
                                                "example_id": "ae4af47b-09ae-429c-a3e5-d193213faf62",
                                                "sense_id": "44a4f6a2-70c4-37c7-9396-7a68a424ce4a",
                                                "text": "Le docteur Sarrasin avait toute sa vie pratiqué le monologue, qui est une des formes de la distraction."
                                            },
                                            {
                                                "example_id": "327ad0e3-6e92-46c6-8b1e-7ba12b963839",
                                                "sense_id": "44a4f6a2-70c4-37c7-9396-7a68a424ce4a",
                                                "text": "Pendant que le nouveau venu se débitait à lui-même ce monologue, un autre cavalier […] s’arrêtait et demeurait aussi en extase devant l’enseigne de la Belle-Étoile."
                                            },
                                            {
                                                "example_id": "5dafb2ac-0268-4119-a9f6-a7085d4b3d63",
                                                "sense_id": "44a4f6a2-70c4-37c7-9396-7a68a424ce4a",
                                                "text": "Et tout en buvant, il mâchait entre ses dents des « chameaux par-ci, cochons par-là, vaches, grues, truies, etc. », quand l’aubergiste […] s’immisça dans ses monologues."
                                            },
                                            {
                                                "example_id": "9a976688-8be1-4c88-9627-02f96d29779b",
                                                "sense_id": "44a4f6a2-70c4-37c7-9396-7a68a424ce4a",
                                                "text": "Amène, souriant, le Dr Ficace n’a pas besoin de consulter l’ordinateur pour se remémorer le dossier. Sur le ton de la ferme compétence, il délivre un monologue médical parfaitement incompréhensible puis laisse planer le silence, le temps pour nous d’admirer l’artiste."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "monologue",
                                "target_lang_code": "fr",
