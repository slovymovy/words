                "senses": [
                    {
                        "sense_id": "87e8604e-ae74-39c2-a8be-cc50eb8dc561",
                        "entry_id": "828afa42-c1e7-3a47-94fe-279612e1c295",
                        "glosses": [
                            "Femme vue comme un objet, en particulier comme objet du désir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83c265b5-f10a-4f3d-a47b-7d08f3e6b4b6",
                                "sense_id": "87e8604e-ae74-39c2-a8be-cc50eb8dc561",
                                "text": "L’homme serait-il devenu une femme-objet comme les autres ? Y prendrait-il goût ?"
                            },
                            {
                                "example_id": "bb0b5834-1d8c-472b-965e-7e8736c0f11c",
                                "sense_id": "87e8604e-ae74-39c2-a8be-cc50eb8dc561",
                                "text": "La sportive devient, comme le note Françoise Labridy l’objet support des fantasmes masculins, elle perpétue son rôle social de femme-objet, mélange d’admiration et de désir érotique."
                            },
                            {
                                "example_id": "37659b6e-b3e4-4628-9e4b-f7d3577fb48c",
                                "sense_id": "87e8604e-ae74-39c2-a8be-cc50eb8dc561",
                                "text": "La femme qui circule s’offre comme objet d’échange. Il s’agit alors d’une sorte de marché entre les hommes pour obtenir la femme-objet, marché où le plus offrant serat gagnant […]."
                            },
                            {
                                "example_id": "104b4758-dcc6-4639-9151-55389f1beb41",
                                "sense_id": "87e8604e-ae74-39c2-a8be-cc50eb8dc561",
                                "text": "Portant des pancartes déplorant le « système dégradant et irresponsable de la femme-objet », les contestataires ont aussi installé des poubelles dans lesquelles elles jetaient gaines, rouges à lèvres, faux cheveux, faux cils et perruques."
                            }
                        ]
                    }
