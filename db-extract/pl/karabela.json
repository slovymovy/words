                "senses": [
                    {
                        "sense_id": "afcac3fa-7a66-3611-a810-51de1b9b5ba5",
                        "entry_id": "4dc967c7-4d8a-3f2a-a411-1ba9e5e6a959",
                        "glosses": [
                            "lekka, ozdobna, paradna szabla bez kabłąka przy rękojeści"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eff4e263-9044-4eb5-9c56-b621be800e99",
                                "sense_id": "afcac3fa-7a66-3611-a810-51de1b9b5ba5",
                                "text": "nie orzą w Ukrainie i w Podolu pługi"
                            },
                            {
                                "example_id": "ab1b6c98-d0d9-42f5-bae6-59a11273d8d3",
                                "sense_id": "afcac3fa-7a66-3611-a810-51de1b9b5ba5",
                                "text": "Zygmunt I chodził z karabelą, został też z nią pochowany."
                            },
                            {
                                "example_id": "768cbede-0ed7-492b-b4fd-5b2fd39bbd65",
                                "sense_id": "afcac3fa-7a66-3611-a810-51de1b9b5ba5",
                                "text": "Pókiśmy miecze, pałasze i kordy"
                            },
                            {
                                "example_id": "ae23bc81-d1b6-4540-acec-d2cd7e0558f3",
                                "sense_id": "afcac3fa-7a66-3611-a810-51de1b9b5ba5",
                                "text": "nosili, nie baliśmy się Ordy,"
                            },
                            {
                                "example_id": "ad3f874d-2ed3-4b5a-884e-716ce426799f",
                                "sense_id": "afcac3fa-7a66-3611-a810-51de1b9b5ba5",
                                "text": "a gdy z karabelkami nastały czeczugi,"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
