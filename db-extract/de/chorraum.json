                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chancel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46107256-1725-3054-90c1-24cb22aeee8f",
                                        "entry_id": "e9331206-c094-31f4-bc95-db94555cf615",
                                        "glosses": [
                                            "The space around the altar in a church, often enclosed, for use by the clergy and the choir. In medieval cathedrals the chancel was usually enclosed or blocked off from the nave by an altar screen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc6c8feb-1b8c-4942-a708-7bc7dfacff11",
                                                "sense_id": "46107256-1725-3054-90c1-24cb22aeee8f",
                                                "text": "The Citizens in their rage, imagining that euery poſt in the Churche had bin one of yᵉ Souldyers, ſhot habbe or nabbe at randon^([sic – meaning random]) uppe to the Roode lofte, and to the Chancell, leauing ſome of theyr arrowes ſticking in the Images."
                                            },
                                            {
                                                "example_id": "beae2074-f2f3-4b9b-a14a-61f2d99af8c4",
                                                "sense_id": "46107256-1725-3054-90c1-24cb22aeee8f",
                                                "text": "Hester Earle and Violet Wayne were moving about the aisle with bundles of wheat-ears and streamers of ivy, for the harvest thanksgiving was shortly to be celebrated, while the vicar stood waiting for their directions on the chancel steps with a great handful of crimson gladioli."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
