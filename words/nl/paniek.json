{
    "word_family": [
        "paniekerig",
        "panikeren",
        "paniekvoetbal",
        "paniekreactie",
        "paniekaanval"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9d6927ac-c262-3f3f-bc21-88c323465f44",
                    "sense_definition": "Een plotselinge, hevige schrik of angst voor een echt of ingebeeld gevaar die vaak leidt tot ondoordacht handelen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "angst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen het brandalarm afging, ontstond er grote <w>paniek</w> onder de aanwezigen in de bioscoop.",
                            "target_lang_translations": {
                                "en": "When the fire alarm went off, there was great <w>panic</w> among those present in the cinema."
                            }
                        },
                        {
                            "text": "Je moet niet in <w>paniek</w> raken als er iets onverwachts gebeurt tijdens je presentatie.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>panic</w> if something unexpected happens during your presentation."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in paniek raken",
                        "paniek zaaien",
                        "blinde paniek"
                    ],
                    "target_lang_definitions": {
                        "en": "A sudden, intense fright or fear of a real or imagined danger that often leads to thoughtless action."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "panic",
                                "target_lang_sense_clarification": "overwhelming fear or fright"
                            },
                            {
                                "target_lang_word": "scare",
                                "target_lang_sense_clarification": "a sudden attack of fright"
                            },
                            {
                                "target_lang_word": "fright",
                                "target_lang_sense_clarification": "sudden intense fear"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c932631a-1219-33ed-896c-81d2a8cfa8d7",
                    "sense_definition": "Kenmerkend voor of voortkomend uit een plotselinge, hevige angst.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "angst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn <w>panieke</w> reactie op het nieuws was voor iedereen een grote verrassing.",
                            "target_lang_translations": {
                                "en": "His <w>panicked</w> reaction to the news was a big surprise to everyone."
                            }
                        },
                        {
                            "text": "Met een <w>paniek</w> gebaar probeerde de zwemmer de aandacht van de strandwacht te trekken.",
                            "target_lang_translations": {
                                "en": "With a <w>frantic</w> gesture, the swimmer tried to attract the lifeguard's attention."
                            }
                        }
                    ],
                    "synonyms": [
                        "panisch"
                    ],
                    "target_lang_definitions": {
                        "en": "Characteristic of or resulting from a sudden, intense fear."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "panic",
                                "target_lang_sense_clarification": "resulting from overwhelming fear"
                            },
                            {
                                "target_lang_word": "panicked",
                                "target_lang_sense_clarification": "feeling or showing sudden fear"
                            },
                            {
                                "target_lang_word": "frantic",
                                "target_lang_sense_clarification": "conducted in a hurried, excited, and disorganized way"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}