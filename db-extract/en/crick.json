            {
                "entry_id": "733aaa4d-fae5-3cdd-920c-8e6631c197a1",
                "word": "crick",
                "pos": "verb",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4f75153d-1f4e-4c7e-8cda-5b68be6f159e",
                        "entry_id": "733aaa4d-fae5-3cdd-920c-8e6631c197a1",
                        "tags": [
