                                        "entry_id": "93da8eb0-8a27-32b1-a403-a90cdd9de831",
                                        "glosses": [
                                            "Bezeichnung für alle Teilchen, die aus Quarks bestehen"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62fd6c7e-2524-4ab2-bdca-172e6bd8e7d8",
                                                "sense_id": "08795211-aac5-3340-a8b2-0779258ab5a3",
                                                "text": "Hadronen unterliegen der starken Wechselwirkung."
                                            },
                                            {
                                                "example_id": "c54868da-7819-480f-9d20-bcc576a5b284",
                                                "sense_id": "08795211-aac5-3340-a8b2-0779258ab5a3",
                                                "text": "„Der künftige Teilchenbeschleuniger ist als Nachfolger des LHC gedacht und soll es ermöglichen, Hadronen (etwa Protonen) mit einer Energie von bis zu 100 TeV (Tera-Elektronenvolt) kollidieren zu lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
