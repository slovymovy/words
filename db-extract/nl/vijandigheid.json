                "senses": [
                    {
                        "sense_id": "cb201da7-3e5e-3d9f-b742-e2edbac368ae",
                        "entry_id": "a25fb2a1-ae05-3e96-b603-7c1352598a7f",
                        "glosses": [
                            "het vijandig zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8bdcffa-6784-4c68-9f5e-43f1ca9957b8",
                                "sense_id": "cb201da7-3e5e-3d9f-b742-e2edbac368ae",
                                "text": "De vijandigheid tussen de twee groepen nam toe."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "720ec703-0617-4d09-8af1-05465dc0b154",
                        "source_entry_id": "a25fb2a1-ae05-3e96-b603-7c1352598a7f",
                        "source_sense_id": "cb201da7-3e5e-3d9f-b742-e2edbac368ae",
                        "source_sense_description": "het vijandig zijn",
                        "target_lang_word": "Feindlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feindlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8babfd28-0c7e-3ba8-9b0b-e803a35e6539",
                                        "entry_id": "576fa7fe-a3b0-3c8c-96cd-8305350ed0fb",
                                        "glosses": [
                                            "Gegnerschaft; feindliche Haltung/Gesinnung gegenüber einer anderen Person oder Gruppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73a5397f-ac40-4e8e-9100-6f6ca0a001dd",
                                                "sense_id": "8babfd28-0c7e-3ba8-9b0b-e803a35e6539",
                                                "text": "„Das aber ist Rassismus – und der geht eben auch über die zweite Worthälfte von Ausländer oder Fremdenfeindlichkeit hinaus: Feindlichkeit.“"
                                            },
                                            {
                                                "example_id": "b8cf6a2e-6a1c-46a6-a56a-ff3afaa7a1fe",
                                                "sense_id": "8babfd28-0c7e-3ba8-9b0b-e803a35e6539",
                                                "text": "„Die Kooperationsbereitschaft beim anderen Menschen steigt, wenn ein Anliegen freundlich vorgetragen wird, und sinkt entsprechend angesichts von Feindlichkeit.“"
                                            },
                                            {
                                                "example_id": "a44fecbe-70e6-4a8e-b457-daeb73f4720e",
                                                "sense_id": "8babfd28-0c7e-3ba8-9b0b-e803a35e6539",
                                                "text": "„Der Begriff ‚Feindlichkeit‘ beschreibt im Allgemeinen eine stark ausgeprägte Ablehnung bis hin zum Hass gegenüber einer bestimmten Sache.“"
                                            },
                                            {
                                                "example_id": "86f1e461-ab31-4b1a-b178-b0c1a860544b",
                                                "sense_id": "8babfd28-0c7e-3ba8-9b0b-e803a35e6539",
                                                "text": "„Im Alltag begegnet Menschen eine Feindlichkeit, die sich gegen Gruppen richtet oder gegen Personen, weil sie einer sozialen Gruppe angehören bzw. als angehörig betrachtet werden, in den unterschiedlichsten Facetten.“"
                                            },
                                            {
                                                "example_id": "5847ff1d-8635-4986-93bc-a88aad53428f",
                                                "sense_id": "8babfd28-0c7e-3ba8-9b0b-e803a35e6539",
                                                "text": "„An diesem Punkt schlägt die bereits latent existierende Feindlichkeit gegenüber den minorisierten Gruppen häufig in eine manifeste um.“"
                                            },
                                            {
                                                "example_id": "2523ff3d-346b-4b48-b0d3-4a3fca546ba9",
                                                "sense_id": "8babfd28-0c7e-3ba8-9b0b-e803a35e6539",
                                                "text": "„Dies liege jedoch nicht daran, dass diese Menschen Ausländer seien, sondern daran, dass Feindlichkeit auf Unwissen basiere.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "026abb7a-201e-31d4-818f-f5f8095947d4",
                                        "entry_id": "576fa7fe-a3b0-3c8c-96cd-8305350ed0fb",
                                        "glosses": [
                                            "Handlung, die [1] zum Ausdruck bringt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f334e875-dbb2-4e15-8f54-069140a275af",
                                                "sense_id": "026abb7a-201e-31d4-818f-f5f8095947d4",
                                                "text": "„Misstrauen, Ausgrenzung, Mobbing und Feindlichkeiten bis hin zu Hass gegenüber Andersdenkenden und Fremden werden das Ergebnis sein.“"
                                            },
                                            {
                                                "example_id": "4c6b9c4f-c51d-4bdc-b1e0-7934242d95ce",
                                                "sense_id": "026abb7a-201e-31d4-818f-f5f8095947d4",
                                                "text": "„So verbündete sie sich mit ihrer Mutter, einem warmen herzensguten Menschen, und beide Frauen bildeten eine enge Koalition gegen die Feindlichkeiten des Lebens.“"
                                            },
                                            {
                                                "example_id": "87ee211e-ae01-4628-a275-234eeefb7bc4",
                                                "sense_id": "026abb7a-201e-31d4-818f-f5f8095947d4",
                                                "text": "„Mit der Entstehung des Christentums aus dem Judentum durch Jesus Christus nahmen die Feindlichkeiten zwischen Christen und Juden ihren Lauf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45773d9b-1c9e-4f32-b3e9-49fa3b0c5465",
                        "source_entry_id": "a25fb2a1-ae05-3e96-b603-7c1352598a7f",
                        "source_sense_id": "cb201da7-3e5e-3d9f-b742-e2edbac368ae",
                        "source_sense_description": "het vijandig zijn",
                        "target_lang_word": "Feindseligkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feindseligkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bc999501-70fa-3ac5-8441-2620b59a3783",
                                        "entry_id": "e26abe92-0197-325b-b49a-9fd65837face",
                                        "glosses": [
                                            "Gefühl der Feindschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e94c6f0-9b71-48ba-bd92-ec744db99411",
                                                "sense_id": "bc999501-70fa-3ac5-8441-2620b59a3783",
                                                "text": "„Sie waren viel zu verspielt, um sich von oben mit Feindseligkeit und Groll und Erbitterung indoktrinieren zu lassen.“"
                                            },
                                            {
                                                "example_id": "fa86adbd-c160-4e40-946b-79cb664dba85",
                                                "sense_id": "bc999501-70fa-3ac5-8441-2620b59a3783",
                                                "text": "„Als sein erstes Orchesterstück 1911 in München uraufgeführt wurde, stieß es bei den Musikern auf Unverständnis, sogar auf Feindseligkeit.“"
                                            },
                                            {
                                                "example_id": "4b9ef534-25b8-4ff6-8457-5a4e184d07d4",
                                                "sense_id": "bc999501-70fa-3ac5-8441-2620b59a3783",
                                                "text": "„Selbst Menschen, die ihm früher mit Bosheit und unverhohlener Feindseligkeit begegnet waren, zeigten sich jetzt zärtlich und liebevoll.“"
                                            },
                                            {
                                                "example_id": "4e0406a7-f53e-4bdb-a39a-f50b42ad0d93",
                                                "sense_id": "bc999501-70fa-3ac5-8441-2620b59a3783",
                                                "text": "„Mich machte diese stumme Feindseligkeit nervös, ich stieg eine Station zu früh aus, und ich ging zu Fuß das Stück die Ebertallee hinunter, bevor ich zum Rhein hin abschwenkte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1cb498d3-48d4-3f71-9c0a-51310e6c13c9",
                                        "entry_id": "e26abe92-0197-325b-b49a-9fd65837face",
                                        "glosses": [
                                            "bewaffnete Aktion gegen jemanden oder etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2174cd70-fd12-47a4-bec8-5329bac1e7f2",
                                                "sense_id": "1cb498d3-48d4-3f71-9c0a-51310e6c13c9",
                                                "text": "„Dabei kamen den Arabern die ständigen Feindseligkeiten zwischen den Völkern und Sippen zugute.“"
                                            },
                                            {
                                                "example_id": "66ecf088-b608-4986-9367-1b00b41a77d7",
                                                "sense_id": "1cb498d3-48d4-3f71-9c0a-51310e6c13c9",
                                                "text": "„Noch hatten die Waffen nicht gesprochen, doch ganz Europa erwartete den Ausbruch von Feindseligkeiten zwischen Frankreich, Deutschland und Russland.“"
                                            },
                                            {
                                                "example_id": "90bc8fbe-8006-4172-88fc-6702a9cb7f96",
                                                "sense_id": "1cb498d3-48d4-3f71-9c0a-51310e6c13c9",
                                                "text": "„Der kaiserliche Befehl zur Einstellung der Feindseligkeiten erging am Mittag des 16. August.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0e3095b-bec0-4bbf-b572-dd030f3b5e80",
                        "source_entry_id": "a25fb2a1-ae05-3e96-b603-7c1352598a7f",
                        "source_sense_id": "cb201da7-3e5e-3d9f-b742-e2edbac368ae",
                        "source_sense_description": "het vijandig zijn",
                        "target_lang_word": "hostility",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hostility",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29661ecd-04c5-3c0c-8fe5-cd5d80031cc7",
                                        "entry_id": "537e2829-e992-34e3-a7f9-dcdab7f0f044",
                                        "glosses": [
                                            "The state of being hostile."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d59f2fc-f757-4a0f-85cf-c745b6ed3b97",
                                                "sense_id": "29661ecd-04c5-3c0c-8fe5-cd5d80031cc7",
                                                "text": "My resentment and anger towards you caused hostility and a division between us."
                                            },
                                            {
                                                "example_id": "ea990558-94ef-4c52-a74f-572894267c08",
                                                "sense_id": "29661ecd-04c5-3c0c-8fe5-cd5d80031cc7",
                                                "text": "There is no hostilitie so excellent, as that which is absolutely Christian."
                                            },
                                            {
                                                "example_id": "bced59d3-8aa0-4a69-9d9c-dd8efade346a",
                                                "sense_id": "29661ecd-04c5-3c0c-8fe5-cd5d80031cc7",
                                                "text": "But with Goodison Park openly directing its full hostility towards Atkinson, Liverpool went ahead when Carroll turned in his first Premier League goal of the season after 70 minutes."
                                            },
                                            {
                                                "example_id": "c080f4fe-3a47-4e2e-a9af-933eec9ccc11",
                                                "sense_id": "29661ecd-04c5-3c0c-8fe5-cd5d80031cc7",
                                                "text": "The polarization of wealth and the polarization of attitudes to diversity are not unrelated. A key reason for popular hostility to immigrants is that to many people, particularly within working-class communities, immigration has become a symbol of unacceptable change."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5de9e25f-7825-3008-a6f2-f917c727d100",
                                        "entry_id": "537e2829-e992-34e3-a7f9-dcdab7f0f044",
                                        "glosses": [
                                            "A hostile action, especially a military action. See hostilities for specific plural definition."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5eb4c81c-aec6-4f2b-a0b6-e46a68b42b43",
                                                "sense_id": "5de9e25f-7825-3008-a6f2-f917c727d100",
                                                "text": "As the revivals died down in the 1740s, the revivalist camp made concessions to their opponents, admonished prorevivalists who continued with the hostilities, and generally sought to heal divisions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6f1e073-4992-4fc4-b6b5-88d6389e04e2",
                        "source_entry_id": "a25fb2a1-ae05-3e96-b603-7c1352598a7f",
                        "source_sense_id": "cb201da7-3e5e-3d9f-b742-e2edbac368ae",
                        "source_sense_description": "het vijandig zijn",
                        "target_lang_word": "hostilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hostilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5ad68bf4-92bb-34bc-8e7b-96799ab2a500",
                                        "entry_id": "d77f7115-6660-3847-889f-f03831e27b03",
                                        "glosses": [
                                            "Acte d’un ennemi ou état de guerre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0c03b0e-e578-4116-b759-4e26065458d0",
                                                "sense_id": "5ad68bf4-92bb-34bc-8e7b-96799ab2a500",
                                                "text": "Un commencement d’hostilités, commencer les hostilités."
                                            },
                                            {
                                                "example_id": "24657e8c-d769-4f5f-8092-9dd6da6e5da9",
                                                "sense_id": "5ad68bf4-92bb-34bc-8e7b-96799ab2a500",
                                                "text": "Suspendre les hostilités."
                                            },
                                            {
                                                "example_id": "5594bd17-f1ab-431c-ae7c-999762fcd6d0",
                                                "sense_id": "5ad68bf4-92bb-34bc-8e7b-96799ab2a500",
                                                "text": "Le monde entier prenait part aux hostilités, sans pouvoir envisager la possibilité d’une paix prochaine, sans même l’espoir de recouvrer jamais la paix."
                                            },
                                            {
                                                "example_id": "fa481410-6422-4c62-ad86-1a22907232f0",
                                                "sense_id": "5ad68bf4-92bb-34bc-8e7b-96799ab2a500",
                                                "text": "L'Autriche déclarait en outre, qu'elle trouvait inadmissible que, dans l'article 3, les puissances se congratulassent de la signature de la paix entre la Prusse et le Danemarck, les hostilités ayant formellement repris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5e4ce06-4540-300d-9bf5-13dd468cca99",
                                        "entry_id": "d77f7115-6660-3847-889f-f03831e27b03",
                                        "glosses": [
                                            "Comportement d’inimitié ou d’opposition ; disposition hostile."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a36321f-b4d0-4dd7-94ee-7449cf69738a",
                                                "sense_id": "c5e4ce06-4540-300d-9bf5-13dd468cca99",
                                                "text": "Voici, pour commencer, ce que j’écrivais, il y a six ans, dans un livre de colère que l’hostilité générale s’efforça d’étouffer par tous les moyens imaginables."
                                            },
                                            {
                                                "example_id": "5f1dc349-91c2-4ac6-bcb5-14c3d54fe625",
                                                "sense_id": "c5e4ce06-4540-300d-9bf5-13dd468cca99",
                                                "text": "L’indifférence en matière de foi était devenue de règle, car d’hostilité on n’en sentait point trop encore ; à peine sourdait-elle, peut-être, dans quelques propos sacrilèges que les mauvaises langues : […], s’essayaient malicieusement dans l’ombre à propager."
                                            },
                                            {
                                                "example_id": "f6d22563-06c5-4ad0-8066-790c375a6c6b",
                                                "sense_id": "c5e4ce06-4540-300d-9bf5-13dd468cca99",
                                                "text": "Pavlov ne s’est pas borné à abdiquer simplement la psychologie en tant que science. Il voyait naître en lui le sentiment d’hostilité irréconciliable envers cette « alliée de la physiologie » qui n’a pas fait ses preuves."
                                            },
                                            {
                                                "example_id": "056d800d-0095-4f69-a9b3-10fb5abe728c",
                                                "sense_id": "c5e4ce06-4540-300d-9bf5-13dd468cca99",
                                                "text": "Victime de l’hostilité d’Arago en France et de Humboldt en Allemagne, Paravey a la mentalité d'un persécuté. Il se plaint dès 1835 « de sourdes et odieuses manœuvres qui tendent sans cesse à se renouveler. »"
                                            },
                                            {
                                                "example_id": "25c40919-ceca-4be6-a962-dae008b7036a",
                                                "sense_id": "c5e4ce06-4540-300d-9bf5-13dd468cca99",
                                                "text": "Il n’y avait pas encore de déclin appréciable dans l’influence des ordres soufis. L’hostilité que leur manifestaient les wahhabites avait peu de poids en dehors de l’Arabie centrale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13d7421c-bf1d-388f-b8cf-378640130cbd",
                                        "entry_id": "d77f7115-6660-3847-889f-f03831e27b03",
                                        "glosses": [
                                            "Sentiment d’animosité, déclaré ou dissimulé, qui incline une personne à l’agression."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7844982-3108-4e9d-83a5-be0541af86b2",
                                                "sense_id": "13d7421c-bf1d-388f-b8cf-378640130cbd",
                                                "text": "Il éprouvait pour elle une hostilité à peine voilée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
