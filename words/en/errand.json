{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3110e98b-9d41-35d7-b462-be4e41ba596f",
                    "sense_definition": "a short trip taken to attend to a minor daily task or chore, such as shopping or dropping off items",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to <w>run</w> a quick <w>errand</w> before the supermarket closes tonight.",
                            "target_lang_translations": {
                                "ru": "Мне нужно быстро <w>выполнить одно дело</w>, пока супермаркет не закрылся сегодня вечером."
                            }
                        },
                        {
                            "text": "She spent the entire morning going to town on some <w>errands</w>.",
                            "target_lang_translations": {
                                "ru": "Она провела всё утро в городе, <w>бегая по делам</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "run"
                    ],
                    "common_phrases": [
                        "run an errand",
                        "do errands"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткая поездка или прогулка для выполнения небольшого повседневного дела или поручения (покупки, отправка почты и т.д.)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дело",
                                "target_lang_sense_clarification": "бытовое мелкое дело или мелкая забота"
                            },
                            {
                                "target_lang_word": "поручение",
                                "target_lang_sense_clarification": "небольшое задание, которое нужно выполнить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3870e939-437c-3153-9bd6-4d0cfcaea26e",
                    "sense_definition": "a journey undertaken to accomplish a specific important mission, quest, or task",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The messenger arrived at the castle carrying news of an urgent <w>errand</w>.",
                            "target_lang_translations": {
                                "ru": "Гонец прибыл в замок с вестью о срочном <w>поручении</w>."
                            }
                        },
                        {
                            "text": "Few travelers have ever come hither on an <w>errand</w> so dangerous.",
                            "target_lang_translations": {
                                "ru": "Немногие странники приходили сюда с столь опасным <w>делом</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used in literary or historical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поездка или путешествие, предпринимаемое для выполнения важной миссии или задачи"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поручение",
                                "target_lang_sense_clarification": "важное задание или миссия"
                            },
                            {
                                "target_lang_word": "задание",
                                "target_lang_sense_clarification": "конкретная задача для выполнения"
                            },
                            {
                                "target_lang_word": "дело",
                                "target_lang_sense_clarification": "цель поездки или визита"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2c42356-c0bf-38a9-83a8-d2a2135983ab",
                    "sense_definition": "the purpose or objective of a trip or journey",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He refused to state the true nature of his <w>errand</w> to the guards.",
                            "target_lang_translations": {
                                "ru": "Он отказался назвать стражникам истинную <w>цель своего визита</w>."
                            }
                        },
                        {
                            "text": "The stranger explained his <w>errand</w> to the town council.",
                            "target_lang_translations": {
                                "ru": "Незнакомец объяснил <w>цель своего прихода</w> городскому совету."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Цель или причина поездки, визита или путешествия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цель визита",
                                "target_lang_sense_clarification": "причина прибытия или поездки"
                            },
                            {
                                "target_lang_word": "дело",
                                "target_lang_sense_clarification": "цель, с которой кто-либо пришёл или приехал"
                            },
                            {
                                "target_lang_word": "поручение",
                                "target_lang_sense_clarification": "задача, с которой совершается поездка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81894e53-42ac-33d9-a0b4-383c867c54dc",
                    "sense_definition": "an oral message entrusted to someone to deliver to another person",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young messenger promised to deliver the secret <w>errand</w> faithfully.",
                            "target_lang_translations": {
                                "ru": "Молодой гонец пообещал верно передать секретное <w>послание</w>."
                            }
                        },
                        {
                            "text": "Flowers were arranged in a pattern to convey silent <w>errands</w> between lovers.",
                            "target_lang_translations": {
                                "ru": "Цветы выкладывали в узор, чтобы передавать тайные <w>послания</w> между влюблёнными."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historical poetic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устное известие или сообщение, доверенное кому-либо для передачи другому человеку"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "послание",
                                "target_lang_sense_clarification": "сообщение или известие"
                            },
                            {
                                "target_lang_word": "весть",
                                "target_lang_sense_clarification": "известие или слух"
                            },
                            {
                                "target_lang_word": "поручение",
                                "target_lang_sense_clarification": "устное просьба или сообщение для передачи"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aeb5c702-03e3-311d-84df-37dd1530d98d",
                    "sense_definition": "to travel or go around in order to perform tasks or chores",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spent an enjoyable afternoon <w>erranding</w> in the city center.",
                            "target_lang_translations": {
                                "ru": "Она приятно провела день, <w>родясь по делам</w> в центре города."
                            }
                        },
                        {
                            "text": "He spent all Saturday <w>erranding</w> around town before heading home.",
                            "target_lang_translations": {
                                "ru": "Он провёл всю субботу, <w>бегая по делам</w> по городу, прежде чем отправиться домой."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Uncommon verbal form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ходить или ездить по делам, выполнять мелкие бытовые поручения"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ходить по делам",
                                "target_lang_sense_clarification": "заниматься бытовыми делами"
                            },
                            {
                                "target_lang_word": "бегать по поручениям",
                                "target_lang_sense_clarification": "выполнять мелкие мелкие задачи вне дома"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2301fafd-c292-3284-9817-b6e65066b9a7",
                    "sense_definition": "to send a person out to do a task or chore",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "All the servants were busy or had been <w>erranded</w> out of the house.",
                            "target_lang_translations": {
                                "ru": "Все слуги были заняты или <w>отправлены с поручениями</w> из дома."
                            }
                        },
                        {
                            "text": "The manager <w>erranded</w> the young assistant to pick up the morning mail.",
                            "target_lang_translations": {
                                "ru": "Менеджер <w>отправил</w> молодого ассистента забрать утреннюю почту."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Посылать кого-либо с мелким поручением или заданием"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посылать с поручением",
                                "target_lang_sense_clarification": "отправлять кого-либо сделать дело"
                            },
                            {
                                "target_lang_word": "отправлять по делам",
                                "target_lang_sense_clarification": "давать задание куда-то сходить или съездить"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}