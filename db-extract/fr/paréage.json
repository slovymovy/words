                        "examples": [
                            {
                                "example_id": "70b29a4d-abee-41e3-94f5-1f23d5d7f3a0",
                                "sense_id": "d5a99a18-be01-30db-8508-67e3c38b295e",
                                "text": "Le paréage conclu entre le prieur et le comte de Grandpré pour l'exploitation d'un nouveau village au terroir de Saint-Oricle entre Senuc et Chevières (juin 1232) n'a pas laissé de traces."
                            },
                            {
                                "example_id": "2998bfee-62e8-4e09-8a32-8bdef1104e88",
                                "sense_id": "d5a99a18-be01-30db-8508-67e3c38b295e",
                                "text": "Afin de définir leurs droits féodaux respectifs sur la région, le comte de Foix (France) et l’évêque d’Urgell (Espagne) signent un acte de paréage en 1278, fixant ainsi les frontières de la principauté d’Andorre."
                            }
                        ]
                    }
