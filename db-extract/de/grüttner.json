                ],
                "senses": [
                    {
                        "sense_id": "5d6f32ad-6ec0-3d8a-95aa-18b302256e33",
                        "entry_id": "daccc41d-38b5-3296-a8b2-1f1e46c3f99d",
                        "glosses": [
                            "deutschsprachiger Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79e0de91-2012-4b83-a126-cf7c71b28d63",
                                "sense_id": "5d6f32ad-6ec0-3d8a-95aa-18b302256e33",
                                "text": "Frau Grüttner ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f84466cf-89d6-44f5-9a29-cfc8ae777871",
                                "sense_id": "5d6f32ad-6ec0-3d8a-95aa-18b302256e33",
                                "text": "Herr Grüttner wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a5e4e1a7-fdab-4d5b-be99-2dfd3dbc1bc8",
                                "sense_id": "5d6f32ad-6ec0-3d8a-95aa-18b302256e33",
                                "text": "Die Grüttners fahren heute nach Gera."
                            },
                            {
                                "example_id": "7a63afa4-9d6a-47d2-86d5-25348a007f15",
                                "sense_id": "5d6f32ad-6ec0-3d8a-95aa-18b302256e33",
                                "text": "Der Grüttner trägt nie die Pullover, die die Grüttner ihm strickt."
                            },
                            {
                                "example_id": "606362c4-0e62-4404-aa3a-bdb5ff53a80b",
                                "sense_id": "5d6f32ad-6ec0-3d8a-95aa-18b302256e33",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Grüttner kommt, geht der Herr Grüttner.“"
                            },
                            {
                                "example_id": "b32bad58-e55c-4e5f-aadd-26dad191fe37",
                                "sense_id": "5d6f32ad-6ec0-3d8a-95aa-18b302256e33",
                                "text": "Grüttner kommt und geht."
                            },
                            {
                                "example_id": "74f751dd-091a-42b3-a0c4-c0394b71a783",
                                "sense_id": "5d6f32ad-6ec0-3d8a-95aa-18b302256e33",
                                "text": "Grüttners kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
