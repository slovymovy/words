    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "baf2c49d-d80f-3755-bb27-c3a041a46572",
                    "sense_definition": "Rétablissement de la concorde et de l'entente entre des personnes ou des groupes qui étaient brouillés ou en conflit.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "accord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après des mois de dispute, ils ont enfin trouvé le chemin de la <w>réconciliation</w>."
                        },
                        {
                            "text": "Le président a prononcé un discours en faveur de la <w>réconciliation</w> nationale."
                        }
                    ],
                    "synonyms": [
                        "raccommodement",
                        "rapprochement"
                    ],
                    "antonyms": [
                        "rupture",
                        "brouille",
                        "discorde"
                    ],
                    "common_phrases": [
                        "tentative de réconciliation",
                        "voie de réconciliation"
                    ]
                },
                {
                    "sense_id": "838ba689-1921-3bf7-85f2-85d882248468",
                    "sense_definition": "Opération consistant à comparer et accorder des écritures comptables avec des relevés bancaires ou d'autres documents.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "comptabilité",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le comptable effectue la <w>réconciliation</w> bancaire à la fin de chaque mois."
                        },
                        {
                            "text": "Une erreur de calcul a été détectée pendant la <w>réconciliation</w> des comptes."
                        }
                    ],
                    "synonyms": [
                        "rapprochement"
                    ],
                    "common_phrases": [
                        "réconciliation bancaire"
                    ]
                },
                {
                    "sense_id": "cdef82f6-dae2-321e-bf96-e1da68325012",
                    "sense_definition": "Mise en cohérence et harmonisation de données provenant de sources différentes après un désalignement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>réconciliation</w> des données est indispensable avant la mise en production du logiciel."
                        },
                        {
                            "text": "Le système assure la <w>réconciliation</w> automatique des fichiers en cas de conflit réseau."
                        }
                    ],
                    "synonyms": [
                        "harmonisation",
                        "synchronisation"
                    ],
                    "common_phrases": [
                        "réconciliation de données"
                    ]
                },
                {
                    "sense_id": "8214841a-8810-3265-8777-ed3079f6b7d9",
                    "sense_definition": "Acte solennel par lequel une personne repentie est réadmise dans la communion de l'Église.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'évêque a célébré la <w>réconciliation</w> solennelle du pénitent devant l'assemblée."
                        },
                        {
                            "text": "Ce rituel ancien de <w>réconciliation</w> levait officiellement toutes les peines ecclésiastiques."
                        }
                    ],
                    "antonyms": [
                        "excommunication"
                    ]
                },
                {
                    "sense_id": "300c58d1-9ce7-33e2-be6a-8707b3ff6e00",
                    "sense_definition": "Cérémonie liturgique destinée à purifier et consacrer à nouveau un lieu de culte qui a été profané.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>réconciliation</w> de la cathédrale a eu lieu quelques jours après les actes de vandalisme."
                        },
                        {
                            "text": "Une messe spéciale a marqué la <w>réconciliation</w> de cet édifice religieux."
                        }
                    ],
                    "antonyms": [
                        "profanation"
                    ]
                }
            ]
        }
    ]
