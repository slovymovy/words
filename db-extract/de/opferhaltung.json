                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f879009f-e71c-458c-957c-0279f6374919",
                                "sense_id": "1c350bc3-cbc9-3b1c-8a08-34e67483a53a",
                                "text": "„Vielleicht möchtest du dich endgültig davon trennen, in einer Opferhaltung zu sein (wenn du öfter denkst: ‚Warum gerade ich?‘, entspricht das einer Opferhaltung)“"
                            },
                            {
                                "example_id": "9fff8044-6068-47e5-b456-72aba9177835",
                                "sense_id": "1c350bc3-cbc9-3b1c-8a08-34e67483a53a",
                                "text": "„Ich glaube, meinem Vater war nicht bewusst, wie sehr er die Familie mit seiner Opferhaltung beeinflusste.“"
                            }
                        ],
