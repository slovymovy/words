                "senses": [
                    {
                        "sense_id": "557aa4a1-f8e5-3fa8-901b-8ee419948bd9",
                        "entry_id": "e496124f-189d-34bd-8119-18beed064a78",
                        "glosses": [
                            "Celle qui se présente pour recevoir le sacrement de confirmation, dans l’Église catholique romaine ou la cérémonie protestante homonyme (qui n’est pas alors considérée comme sacrement)."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f774f4d0-4709-429f-9a5e-d251c0346ba2",
                        "source_entry_id": "e496124f-189d-34bd-8119-18beed064a78",
                        "source_sense_id": "557aa4a1-f8e5-3fa8-901b-8ee419948bd9",
                        "target_lang_word": "Konfirmandin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Konfirmandin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07bd8c75-d2df-3f53-b977-ec9cecf59b5a",
                                        "entry_id": "36356081-4ec9-3475-8eb1-ad808a232564",
                                        "glosses": [
                                            "weibliche Person, die im Konfirmationsunterricht auf die Konfirmation vorbereitet wird, weibliche Person, die gerade konfirmiert wird/wurde"
                                        ],
                                        "tags": [
                                            "evangelische Kirche",
                                            "auch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "715f8551-e760-40c5-a1d5-85739ce25232",
                                                "sense_id": "07bd8c75-d2df-3f53-b977-ec9cecf59b5a",
                                                "text": "Die Konfirmandinnen besuchen regelmäßig den Konfirmationsunterricht und während der gesamten Konfirmandenzeit den Gottesdienst der Kirchengemeinde."
                                            },
                                            {
                                                "example_id": "e1ce99ea-22aa-48a4-8d9c-c2a07ae28984",
                                                "sense_id": "07bd8c75-d2df-3f53-b977-ec9cecf59b5a",
                                                "text": "„Elses Brüder reisten zur Feier an, was bedeutete, dass Klaus in der Badewanne schlafen musste und die Konfirmandin unterm Tisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04a05fd5-28fd-4766-ad5c-0c2635c9b017",
                        "source_entry_id": "e496124f-189d-34bd-8119-18beed064a78",
                        "source_sense_id": "557aa4a1-f8e5-3fa8-901b-8ee419948bd9",
                        "target_lang_word": "Firmling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Firmling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2cec9e89-9f1d-3b2e-8671-14903a591f71",
                                        "entry_id": "24a86f1e-daaa-3a4e-94d1-f1ca867f5f7c",
                                        "glosses": [
                                            "Person, die gefirmt wird; die zur Firmung geht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cde5956-9fc7-4768-97ce-759288a8c156",
                                                "sense_id": "2cec9e89-9f1d-3b2e-8671-14903a591f71",
                                                "text": "„Der Pate begleitet den Firmling und legt die rechte Hand auf die rechte Schulter des Firmlings.“"
                                            },
                                            {
                                                "example_id": "ed121655-b32b-4a36-8047-ceb72a0d2a40",
                                                "sense_id": "2cec9e89-9f1d-3b2e-8671-14903a591f71",
                                                "text": "„Voraussetzung für die Firmung ist, dass der Firmling getauft ist und aus freiem Willen gefirmt werden will.“"
                                            },
                                            {
                                                "example_id": "6973d81a-3429-4c71-bcf8-246f207870bc",
                                                "sense_id": "2cec9e89-9f1d-3b2e-8671-14903a591f71",
                                                "text": "„Beim feierlichen Empfang des Erzbischofs in der alten Frauenkirche waren auch wir Firmlinge anwesend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea5e7856-c96c-43dc-8b54-601e5f9b51c6",
                        "source_entry_id": "e496124f-189d-34bd-8119-18beed064a78",
                        "source_sense_id": "557aa4a1-f8e5-3fa8-901b-8ee419948bd9",
                        "target_lang_word": "confirmand",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "confirmand",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84ba8893-3862-3606-94f4-0661c7fdab76",
                                        "entry_id": "cea34800-2624-3034-a094-8e2a48193500",
                                        "glosses": [
                                            "A candidate for confirmation or affirmation of baptism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68940f25-43e8-4c22-9766-ce27fd469e34",
                                                "sense_id": "84ba8893-3862-3606-94f4-0661c7fdab76",
                                                "text": "The preacher then tells the confirmands, that as a token of their full consent to the confession just made, each of them should kiss the Scroll of the Law."
                                            },
                                            {
                                                "example_id": "a8b3c6e9-1bc9-45f3-8e50-af2f7606efb1",
                                                "sense_id": "84ba8893-3862-3606-94f4-0661c7fdab76",
                                                "text": "In confirmation the confirmand confesses his faith and expresses a willingness to accept and obey Jesus Christ as his Lord; and the Christian Church confirms the worthiness of the confirmand to partake of the fellowship and heavenly blessings which this new relation called church-membership involves."
                                            },
                                            {
                                                "example_id": "b42d7b48-a031-46f2-811c-4128d2adfe21",
                                                "sense_id": "84ba8893-3862-3606-94f4-0661c7fdab76",
                                                "text": "These persons are recruited from a list of several, active adults in the church that is submitted by each confirmand."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
