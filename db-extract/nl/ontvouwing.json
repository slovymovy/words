                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb7996c6-b19f-4244-b2cf-2fbc8ad28eff",
                                "sense_id": "34faa9ee-21e0-3969-938e-fb06486f6baa",
                                "text": "Het deed de mensen denken aan een paar dingen: de reusachtige slingers van de Drie Lichamen-wereld, de laagdimensionale ontvouwingen van de sofonen en het druppeltje."
                            },
                            {
                                "example_id": "b50c5b51-8cf3-49d7-8146-b5bb7c5fd104",
                                "sense_id": "34faa9ee-21e0-3969-938e-fb06486f6baa",
                                "text": "Is dit liefde? De regels werden weergegeven op een laagdimensionale ontvouwing van een sofon die plots naast hen verscheen."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a4765b9-1bd2-374d-b4b8-d043a572d05c",
