                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Durchsuchung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "339d6cfd-fec3-3e0d-aebc-3edccfafa139",
                                        "entry_id": "76608f71-b617-3b1e-902e-19ab385fb9f8",
                                        "glosses": [
                                            "systematische Untersuchung von jemandem oder etwas, um gegebenenfalls etwas Verstecktes zu finden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bea8f284-27de-41cb-b5f5-3325c55f38c6",
                                                "sense_id": "339d6cfd-fec3-3e0d-aebc-3edccfafa139",
                                                "text": "„Devereux nahm meinen Gürtel vom Tisch, den man mir bei meiner Durchsuchung abgenommen hatte, und wog ihn auf der Handfläche.“"
                                            },
                                            {
                                                "example_id": "6e4108ec-7424-4ddd-b2cb-889fdc04878c",
                                                "sense_id": "339d6cfd-fec3-3e0d-aebc-3edccfafa139",
                                                "text": "Im Zusammenhang mit den Kartellvorwürfen gegen mehrere deutsche Autobauer hat es Durchsuchungen der EU-Kommission bei BMW gegeben."
                                            },
                                            {
                                                "example_id": "6114e72c-ab28-4343-82e4-39ebb9a31c1b",
                                                "sense_id": "339d6cfd-fec3-3e0d-aebc-3edccfafa139",
                                                "text": "Zwei Tage nach den Durchsuchungen bei der Deutschen Bank geben die Ermittler Details bekannt: Es geht um dubiose Aktiendeals und den Versuch, den Staat um Millionen zu betrügen."
                                            },
                                            {
                                                "example_id": "b1fedf2f-695a-41f2-8b83-b32b637383d1",
                                                "sense_id": "339d6cfd-fec3-3e0d-aebc-3edccfafa139",
                                                "text": "Seit Tagen sorgen Behörden in Russland mit Durchsuchungen bei politischen Stiftungen und Nichtregierungsorganisationen für Aufsehen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
