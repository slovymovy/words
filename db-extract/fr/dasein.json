                                "target_senses": [
                                    {
                                        "sense_id": "c17c5794-22bd-3b56-9d65-ca93d23c3e2d",
                                        "entry_id": "8a9b7b3c-271f-3b13-91cd-efbc62562731",
                                        "glosses": [
                                            "present participle and gerund of be"
                                        ],
