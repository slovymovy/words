                "senses": [
                    {
                        "sense_id": "e9037c88-9df0-352b-8c4b-04e010b2b15a",
                        "entry_id": "9a19d989-1af6-396f-89b1-fd5a4cb426cf",
                        "glosses": [
                            "Rapport de deux choses qui se font au même moment."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "4b2f1d31-de3d-43e5-b636-292f253d4530",
                                "sense_id": "e9037c88-9df0-352b-8c4b-04e010b2b15a",
                                "text": "En un curieux synchronisme, tous les gradés saluèrent, un instant pareils à ceux qu’ils comptaient façonner."
                            },
                            {
                                "example_id": "1e9e67aa-5b69-43a5-a281-720a4f132f7a",
                                "sense_id": "e9037c88-9df0-352b-8c4b-04e010b2b15a",
                                "text": "Il convient enfin qu'un synchronisme écologique existe ou s'établisse entre la plante et le pollinisateur, concernant par exemple la phénologie florale et le rythme d'activité du pollinisateur ; leurs exigences écologiques et, par voie de conséquence, leurs biotopes préférés doivent être très proches ou identiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d138c4f-47e5-3c12-9f12-9d4fcf3eccee",
                        "entry_id": "9a19d989-1af6-396f-89b1-fd5a4cb426cf",
                        "glosses": [
                            "Qualité de ce qui arrive en même temps."
                        ],
                        "tags": [],
                        "examples": [
