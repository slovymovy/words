                    {
                        "sense_id": "fe707a3f-bdda-3386-b7fb-5d81565a237a",
                        "entry_id": "0cdd38e0-c32d-3658-8393-fd2acc2e1366",
                        "glosses": [
                            "Bal populaire ^([2])."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "4951324d-ea4e-4c82-b91d-1e731412fbfd",
                                "sense_id": "fe707a3f-bdda-3386-b7fb-5d81565a237a",
                                "text": "J'irai dans mon quartier, à la Porte des Lilas, dans les petits guinches... Il en reste encore des vrais guinches où on danse musette."
                            },
                            {
                                "example_id": "c4251a2c-e4e4-4c47-ab0a-b795f4a75c66",
                                "sense_id": "fe707a3f-bdda-3386-b7fb-5d81565a237a",
                                "text": "Le vrai roi du guinche, la coqueluche, le mieux placé pour lever les frangines, c’est l’accordéon."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
