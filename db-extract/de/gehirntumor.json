                "senses": [
                    {
                        "sense_id": "d6bdfddd-451b-3cc2-9167-eef82d9ac5b9",
                        "entry_id": "9d91cb48-ccf1-3930-9d6a-3896e856c920",
                        "glosses": [
                            "Geschwulst im Gewebe des zentralen Nervensystems"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52198431-9d4d-4f7a-b232-5145d5b2ed70",
                                "sense_id": "d6bdfddd-451b-3cc2-9167-eef82d9ac5b9",
                                "text": "„Das hatte ich doch erst kürzlich gelesen, dass man einem Geiger bei vollem Bewusstsein seinen Gehirntumor entfernt hatte.“"
                            },
                            {
                                "example_id": "55e50082-0bdf-4287-b1a0-e67e6c714620",
                                "sense_id": "d6bdfddd-451b-3cc2-9167-eef82d9ac5b9",
                                "text": "„Die einzigen Erkrankungen, die das Strafgesetzbuch als willenseinschränkend anerkennt, sind Schizophrenie oder ein Gehirntumor.“"
                            },
                            {
                                "example_id": "5e7ee973-c34d-46e3-98cd-0a71b684ea16",
                                "sense_id": "d6bdfddd-451b-3cc2-9167-eef82d9ac5b9",
                                "text": "„Wenn die beiden Brüder miteinander telefonierten, schilderte Sandy besorgt irgendwelche neuen Symptome, und einmal flog Philip mit einer Concorde von London nach New York, weil Sandy eine Sehstörung für die ersten Anzeichen eines Gehirntumors hielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
