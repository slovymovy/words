        "fr-extract.jsonl": [
            {
                "entry_id": "4a59b2bf-ba5d-32c3-8c22-353013aa9e8b",
                "word": "contraint",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f87e0756-4134-4f11-8862-1011a8a0fdf8",
                        "entry_id": "4a59b2bf-ba5d-32c3-8c22-353013aa9e8b",
                        "tags": [
                            "plural",
                            "masculine"
                        ],
                        "form": "contraints"
                    },
                    {
                        "form_id": "010fec9b-8baa-4d64-b6bb-76a2791506fe",
                        "entry_id": "4a59b2bf-ba5d-32c3-8c22-353013aa9e8b",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "contrainte"
                    },
                    {
                        "form_id": "22fc16fe-a966-4768-a42c-e0b9a7fbf673",
                        "entry_id": "4a59b2bf-ba5d-32c3-8c22-353013aa9e8b",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "contraintes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "11b16942-a032-37f9-b457-33bbf0508920",
                        "entry_id": "4a59b2bf-ba5d-32c3-8c22-353013aa9e8b",
                        "glosses": [
                            "Qui est gêné, forcé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f65ee55-3f65-4391-87be-b58f90e45009",
                                "sense_id": "11b16942-a032-37f9-b457-33bbf0508920",
                                "text": "Je ne lui trouvai plus cette vivacité, ces brusques élans, cette rapide expression qui m’avaient tant plu en elle. Ses regards étaient lents, ses gestes contraints, son attitude morne."
                            },
                            {
                                "example_id": "33c1ded9-0a06-460a-9a7b-63f26c6d7cee",
                                "sense_id": "11b16942-a032-37f9-b457-33bbf0508920",
                                "text": "L’empressement qu’elle mettait à nous être agréable et, comme elle disait, à « faciliter les choses », était si épais que nous restions le plus souvent, Alissa et moi, contraints et quasi muets devant elle."
                            },
                            {
                                "example_id": "14bda5be-3a61-4796-b5e9-2b7c274ffd27",
                                "sense_id": "11b16942-a032-37f9-b457-33bbf0508920",
                                "text": "Jamais Clément Talon ne faisait un pas qui ne fût absolument nécessaire ; il marchait lentement, lourdement, avec quelque chose de contraint qui me porte à croire qu’il souffrait de la goutte."
                            },
                            {
                                "example_id": "da1a1ea7-1243-458c-aed9-afb4fc649c22",
                                "sense_id": "11b16942-a032-37f9-b457-33bbf0508920",
                                "text": "Mais, à la longue, elle se vit contrainte de renoncer à ses méthodes iniques, parce que trop d’enquêtes s’étaient tournées à sa confusion […]."
                            },
                            {
                                "example_id": "f300bff3-1242-43f1-a262-5148a62329d7",
                                "sense_id": "11b16942-a032-37f9-b457-33bbf0508920",
                                "text": "Tout se passa convenablement, mais sur un mode un peu contraint."
                            },
                            {
                                "example_id": "96524dcc-c5fd-4b4e-bbf0-1c7596f3bfd2",
                                "sense_id": "11b16942-a032-37f9-b457-33bbf0508920",
                                "text": "Il a l’air contraint."
                            },
                            {
                                "example_id": "ef8cb1fc-ca6b-453b-92fd-0d285c34a00c",
                                "sense_id": "11b16942-a032-37f9-b457-33bbf0508920",
                                "text": "Une posture contrainte."
                            },
                            {
                                "example_id": "864acd51-bf2e-48aa-a64b-46226b6025d2",
                                "sense_id": "11b16942-a032-37f9-b457-33bbf0508920",
                                "text": "Il n’y a rien de contraint dans ses manières."
                            },
                            {
                                "example_id": "3db26821-5fbb-4a97-9960-9ca876a8570c",
                                "sense_id": "11b16942-a032-37f9-b457-33bbf0508920",
                                "text": "Je n’y consentirai que contraint et forcé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ecfff49-a3fb-493d-88ac-5ededd5e3e80",
                        "source_entry_id": "4a59b2bf-ba5d-32c3-8c22-353013aa9e8b",
