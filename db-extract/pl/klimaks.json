                "senses": [
                    {
                        "sense_id": "854db554-f3cc-389e-aca3-a55406a0029f",
                        "entry_id": "cbe09372-3650-3245-87a6-6aa6a75de1bf",
                        "glosses": [
                            "stan względnej równowagi w środowisku / biocenozie"
