                ],
                "senses": [
                    {
                        "sense_id": "33e749ab-b359-316f-8c6c-be91a6662533",
                        "entry_id": "f236507b-1f5f-3560-bb10-9c6ccdac979d",
                        "glosses": [
                            "Scheiße, die von einer Kuh stammt"
                        ],
                        "tags": [
                            "colloquial",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "f088f7f5-0c2d-403b-9caa-2f81ed7d4026",
                                "sense_id": "33e749ab-b359-316f-8c6c-be91a6662533",
                                "text": "„Eigentlich sollten wir jetzt getrocknete Kuhscheiße aufsammeln oder wie das heißt, Kuhfladen, aber Denny bedrängt mich: »Lies das, Mann. Die eingekreiste Anzeige.«“"
                            },
                            {
                                "example_id": "a37bbb72-9249-4216-8cad-3ea8c836d320",
                                "sense_id": "33e749ab-b359-316f-8c6c-be91a6662533",
                                "text": "„Ich konnte mich an einem dicken Brett festhalten, das mir aus den Händen rutschte und noch bevor ich es loslassen konnte, landete ich mit aufgeschürften Ellbogen im Gras in der Kuhscheiße.“"
                            },
                            {
                                "example_id": "bd65738f-6a26-4c0e-9c66-7880f00b69e8",
                                "sense_id": "33e749ab-b359-316f-8c6c-be91a6662533",
                                "text": "„Zwie Trecker standen mit abgestelltem Motor auf der Straße. Vermummte Gestalten schöpften auf den Ladeflächen frische Kuhscheiße aus großen Eimern.“"
                            },
                            {
                                "example_id": "bb1750c0-7198-436a-b895-24d9084760d8",
                                "sense_id": "33e749ab-b359-316f-8c6c-be91a6662533",
                                "text": "„Seine Stiefel hinterlassen Spuren von Kuhscheiße, aber er verläuft sich kein einziges Mal.“"
                            },
                            {
                                "example_id": "c23e0ff8-2aa3-4a09-92df-1a38311c4c36",
                                "sense_id": "33e749ab-b359-316f-8c6c-be91a6662533",
                                "text": "„›Hab ihr gesagt, von mir aus kann sie mich da auch gleich begraben, wo ich doch sowieso mein Leben lang bis zum Arsch in Kuhscheiße gestanden hab.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
