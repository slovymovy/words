                                        ]
                                    },
                                    {
                                        "sense_id": "90c2350b-46ce-3141-82e7-f29257dfbe61",
                                        "entry_id": "115a1d7c-e8f4-3e59-82bd-074c4f63778b",
                                        "glosses": [
                                            "A fabric made from this material."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "170e2855-0f89-43f9-b1fb-0680789b3b08",
                                                "sense_id": "90c2350b-46ce-3141-82e7-f29257dfbe61",
                                                "text": "Her mission statement is that clothes made from sustainable viscose and cruelty-free alternatives to leather should not be targeted at a niche market, but shown to hold their own on the Paris fashion week catwalk."
                                            },
                                            {
                                                "example_id": "d164f01c-8c6e-4f25-93aa-3af3a993804f",
                                                "sense_id": "90c2350b-46ce-3141-82e7-f29257dfbe61",
                                                "text": "Here you are […] in your favourite viscose shirt and palazzo pants."
