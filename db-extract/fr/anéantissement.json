        "fr-extract.jsonl": [
            {
                "entry_id": "5440b33f-c3b5-3c25-8cff-bd14a5ee7593",
                "word": "anéantissement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d5b540b2-fa61-484e-bd26-1b909d7b48d0",
                        "entry_id": "5440b33f-c3b5-3c25-8cff-bd14a5ee7593",
                        "tags": [
                            "plural"
                        ],
                        "form": "anéantissements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0f4c94a8-cfb9-3a30-aa41-69d19315f16a",
                        "entry_id": "5440b33f-c3b5-3c25-8cff-bd14a5ee7593",
                        "glosses": [
                            "Fait d’être anéanti."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69b33702-1916-4e6b-b401-626d259a8783",
                                "sense_id": "0f4c94a8-cfb9-3a30-aa41-69d19315f16a",
                                "text": "Encore hier, on annonçait le triomphe de l’Espagne et l’anéantissement de Bolivar , tandis que déjà depuis plusieurs mois, armée, généraux de l’Espagne, tout avait passé sous les fourches caudines, et que sa domination avait fini en Amérique ; […]."
                            },
                            {
                                "example_id": "708bfbf7-4c28-4e2b-a48f-4306eae7bcda",
                                "sense_id": "0f4c94a8-cfb9-3a30-aa41-69d19315f16a",
                                "text": "C’est au premier anéantissement des légions nomades qui portaient avec elles les destinées de la Pologne, que se terminera cette histoire."
                            }
                        ]
                    },
                    {
                        "sense_id": "84bffad7-ad3b-3849-8ce8-6beef4991374",
                        "entry_id": "5440b33f-c3b5-3c25-8cff-bd14a5ee7593",
                        "glosses": [
                            "Fait d’être détruit absolument."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "5544866d-707c-4773-9439-1512b20a782f",
                                "sense_id": "84bffad7-ad3b-3849-8ce8-6beef4991374",
                                "text": "Cette famille est tombée dans l’anéantissement."
                            },
                            {
                                "example_id": "428f7ff1-f8ce-4f25-943a-02aa32526770",
                                "sense_id": "84bffad7-ad3b-3849-8ce8-6beef4991374",
                                "text": "La chute et l’anéantissement de cette monarchie."
                            },
                            {
                                "example_id": "ff75fb73-897e-4762-8b9c-95a4b2540185",
                                "sense_id": "84bffad7-ad3b-3849-8ce8-6beef4991374",
                                "text": "Depuis l’anéantissement de sa fortune, il est tombé dans le dernier mépris."
                            }
                        ]
                    },
                    {
                        "sense_id": "6947f65a-72c6-3c4e-94f5-a9d4103bac3c",
                        "entry_id": "5440b33f-c3b5-3c25-8cff-bd14a5ee7593",
                        "glosses": [
                            "Action de s’abaisser, de s’humilier devant Dieu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fef6a81-5b0b-4ccb-aae8-18d43eb9f80e",
                                "sense_id": "6947f65a-72c6-3c4e-94f5-a9d4103bac3c",
                                "text": "Être dans un continuel anéantissement devant Dieu."
                            }
                        ]
                    },
                    {
                        "sense_id": "15f883c8-4a71-3387-99af-64513b5a49ba",
                        "entry_id": "5440b33f-c3b5-3c25-8cff-bd14a5ee7593",
                        "glosses": [
                            "État d’abattement et de faiblesse extrême dans lequel l’exercice de toutes les facultés semble être suspendu."
                        ],
                        "tags": [
                            "figuratively",
                            "hyperbole"
                        ],
                        "examples": [
                            {
                                "example_id": "35eed303-552c-4e7b-81ab-f1a3fc1cc93e",
                                "sense_id": "15f883c8-4a71-3387-99af-64513b5a49ba",
                                "text": "Elle fut frappée de stupéfaction, et son anéantissement fut tel que bien certainement elle n’eût pas pu faire un pas pour se cacher."
                            },
                            {
                                "example_id": "68d4b673-855d-423d-ba74-9e6d862dd4ad",
                                "sense_id": "15f883c8-4a71-3387-99af-64513b5a49ba",
                                "text": "Ils eurent un instant d'anéantissement ineffable, après lequel ils se réveillèrent, l'âme illuminée d'une lumière nouvelle, comme s'ils venaient de sortir des ténèbres."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fadbda8d-0081-47c6-9b6f-d25d1922354c",
                        "source_entry_id": "5440b33f-c3b5-3c25-8cff-bd14a5ee7593",
