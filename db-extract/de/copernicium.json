                    {
                        "sense_id": "f0f5287a-51b2-319f-b794-4f039d2f100b",
                        "entry_id": "7ad095d7-a8cb-3fcb-a1f2-2d493cd20796",
                        "glosses": [
                            "das chemische Element der Ordnungszahl 112"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cf5138f-3002-4e82-a0f4-6bd701bdcaac",
                                "sense_id": "f0f5287a-51b2-319f-b794-4f039d2f100b",
                                "text": "„Nach Pressemitteilung des Paul Scherrer Instituts im Mai 2006 ergaben Experimente, dass Copernicium sich chemisch ähnlich wie Quecksilber (Hg) verhalte.“"
                            },
                            {
                                "example_id": "8c54cd09-437c-4f98-8a68-d59972065285",
                                "sense_id": "f0f5287a-51b2-319f-b794-4f039d2f100b",
                                "text": "„\"Copernicium\" trägt die Ordnungszahl 112. Es ist 277-mal schwerer als Wasserstoff, das leichteste aller Atome.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "37e2c65d-cea6-4c52-ab4c-e02b0c01b4c2",
