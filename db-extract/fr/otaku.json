                "senses": [
                    {
                        "sense_id": "92a1a999-0ece-3123-8267-b7709a947bee",
                        "entry_id": "b97982bf-304b-3592-873f-45c30bb2e376",
                        "glosses": [
                            "Personne qui se consacre de façon obsessionnelle à un loisir d’intérieur (littéralement, un loisir pratiqué dans sa maison), tel que les mangas, les animes et les jeux vidéo en général, mais pas limités à ceux-ci pour autant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "016196e6-0564-4a78-9d39-963e52122b3e",
                                "sense_id": "92a1a999-0ece-3123-8267-b7709a947bee",
                                "text": "- Que signifie « otaku » ? demanda Lola.\n- « Celui qui s’abrite à la maison ». Un otaku est un jeune homme qui refuse de devenir adulte. Il s’enferme chez lui, oublie le réel et ne vit que pour sa passion.\n- Quel genre ?\n- Modélisme, collection de montres, petites culottes de lycéennes, vidéos pornos et ainsi de suite."
                            },
                            {
                                "example_id": "60f468db-212d-4b1d-92a5-4a1ebeb230bf",
                                "sense_id": "92a1a999-0ece-3123-8267-b7709a947bee",
                                "text": "Messier était absent, retenu par une enquête qui semblait le passionner – un adolescent psychotique, une espèce d’otaku qui avait apparemment trouvé le mode opératoire de ses meurtres sur Internet."
                            }
                        ]
                    }
                ],
