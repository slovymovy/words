{
    "word_family": [
        "focal",
        "focalize",
        "focusing",
        "refocus",
        "unfocused"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "22dd6464-fa30-3657-abd9-e0a4b1da5590",
                    "sense_definition": "To concentrate one's attention on something; to have as one's central point of interest or concern.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mental concentration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I really need to <w>focus</w> on my work if I want to finish this project by tonight.",
                            "target_lang_translations": {
                                "ru": "Мне действительно нужно <w>сосредоточиться</w> на работе, если я хочу закончить этот проект к вечеру.",
                                "zh": "如果我想在今晚之前完成这个项目，我真的需要<w>专注</w>于我的工作。"
                            }
                        },
                        {
                            "text": "The team decided to <w>focus</w> on quality rather than quantity for the new product line.",
                            "target_lang_translations": {
                                "ru": "Команда решила <w>сфокусироваться</w> на качестве, а не на количестве для новой линейки продуктов.",
                                "zh": "团队决定为新产品线<w>侧重</w>于质量而非数量。"
                            }
                        }
                    ],
                    "synonyms": [
                        "concentrate",
                        "fixate",
                        "attend"
                    ],
                    "antonyms": [
                        "ignore"
                    ],
                    "common_phrases": [
                        "focus on quality",
                        "focus on work",
                        "focus on goals"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сосредоточить внимание на чем-либо; иметь что-либо в качестве центрального пункта интереса или беспокойства.",
                        "zh": "将注意力集中在某事上；将某事作为关注或关心的中心。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сосредоточиться",
                                "target_lang_sense_clarification": "направить внимание"
                            },
                            {
                                "target_lang_word": "сконцентрироваться",
                                "target_lang_sense_clarification": "собрать мысли"
                            },
                            {
                                "target_lang_word": "фокусироваться",
                                "target_lang_sense_clarification": "уделять основное внимание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "专注",
                                "target_lang_sense_clarification": "集中注意力"
                            },
                            {
                                "target_lang_word": "集中",
                                "target_lang_sense_clarification": "汇集精力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5003dc27-d68f-3dcd-967b-038260598e68",
                    "sense_definition": "To adjust itself or be adjusted such that light from a scene converges appropriately to create a clear image.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "optics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The camera <w>focuses</w> automatically on the subject's eyes to ensure a sharp portrait.",
                            "target_lang_translations": {
                                "ru": "Камера автоматически <w>фокусируется</w> на глазах объекта, чтобы обеспечить резкость портрета.",
                                "zh": "相机自动<w>对焦</w>在拍摄对象的眼睛上，以确保人像清晰。"
                            }
                        },
                        {
                            "text": "I can't get the lens to <w>focus</w> properly because the room is too dark.",
                            "target_lang_translations": {
                                "ru": "Я не могу заставить объектив <w>навестись на резкость</w> должным образом, потому что в комнате слишком темно.",
                                "zh": "因为房间太暗，我无法让镜头正确<w>聚焦</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "align",
                        "point"
                    ],
                    "antonyms": [
                        "defocus"
                    ],
                    "common_phrases": [
                        "focus automatically",
                        "focus the lens",
                        "fail to focus"
                    ],
                    "target_lang_definitions": {
                        "ru": "Настраиваться или быть настроенным таким образом, чтобы свет сходился для создания четкого изображения.",
                        "zh": "调整自身或被调整，使光线汇聚以形成清晰的图像。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фокусироваться",
                                "target_lang_sense_clarification": "об оптике"
                            },
                            {
                                "target_lang_word": "наводиться на резкость",
                                "target_lang_sense_clarification": "о камере или линзе"
                            },
                            {
                                "target_lang_word": "сфокусироваться",
                                "target_lang_sense_clarification": "стать четким"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "对焦",
                                "target_lang_sense_clarification": "光学调整"
                            },
                            {
                                "target_lang_word": "聚焦",
                                "target_lang_sense_clarification": "使图像清晰"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10589904-3649-3428-8016-8515e8ca2594",
                    "sense_definition": "To direct attention, effort, or energy to a particular audience, task, or direction.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mental concentration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The president <w>focused</w> her remarks on the newcomers during the opening ceremony.",
                            "target_lang_translations": {
                                "ru": "Президент <w>сосредоточила</w> свои замечания на новичках во время церемонии открытия.",
                                "zh": "在开幕式上，总统将她的发言<w>集中</w>在新人身上。"
                            }
                        },
                        {
                            "text": "We should <w>focus</w> efforts on improving customer service this quarter.",
                            "target_lang_translations": {
                                "ru": "Нам следует <w>направить</w> усилия на улучшение обслуживания клиентов в этом квартале.",
                                "zh": "本季度我们应该将精力<w>集中</w>在改善客户服务上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "direct",
                        "center",
                        "centre",
                        "hone"
                    ],
                    "antonyms": [
                        "dilute"
                    ],
                    "common_phrases": [
                        "focus efforts",
                        "focus attention",
                        "focus remarks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Направлять внимание, усилия или энергию на определенную аудиторию, задачу или направление.",
                        "zh": "将注意力、努力或精力导向特定的受众、任务或方向。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сосредоточить",
                                "target_lang_sense_clarification": "усилия или внимание"
                            },
                            {
                                "target_lang_word": "сконцентрировать",
                                "target_lang_sense_clarification": "ресурсы или энергию"
                            },
                            {
                                "target_lang_word": "направить",
                                "target_lang_sense_clarification": "внимание на что-то"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "集中",
                                "target_lang_sense_clarification": "导向特定目标"
                            },
                            {
                                "target_lang_word": "侧重",
                                "target_lang_sense_clarification": "偏重于某方面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da39fddf-1f7b-3ec6-9f4c-32cdc81860e5",
                    "sense_definition": "To transfer the input focus to a visual element, such as a text box, so that it receives subsequent input.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The text box won't receive the user's keystrokes unless you explicitly <w>focus</w> it.",
                            "target_lang_translations": {
                                "ru": "Текстовое поле не будет принимать нажатия клавиш пользователя, пока вы явно не <w>передадите фокус</w> ему.",
                                "zh": "除非你明确地让文本框<w>聚焦</w>，否则它不会接收用户的按键输入。"
                            }
                        },
                        {
                            "text": "You can <w>focus</w> the next input field by pressing the tab key on your keyboard.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>активировать</w> следующее поле ввода, нажав клавишу Tab на клавиатуре.",
                                "zh": "你可以通过按键盘上的Tab键来让下一个输入框<w>聚焦</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "engage"
                    ],
                    "common_phrases": [
                        "focus the element",
                        "input focus"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Передать фокус ввода визуальному элементу, например текстовому полю, чтобы он мог принимать последующий ввод.",
                        "zh": "将输入焦点转移到视觉元素（如文本框），使其能够接收后续输入。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "передать фокус",
                                "target_lang_sense_clarification": "элементу интерфейса"
                            },
                            {
                                "target_lang_word": "активировать",
                                "target_lang_sense_clarification": "поле ввода"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "聚焦",
                                "target_lang_sense_clarification": "计算机界面操作"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dd6c6054-6f07-36dd-8e30-3bc546668049",
                    "sense_definition": "Something to which activity, attention, or interest is primarily directed.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "center of interest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My studies are my main <w>focus</w> right now as I prepare for my final exams.",
                            "target_lang_translations": {
                                "ru": "Моя учеба — это мой главный <w>приоритет</w> сейчас, когда я готовлюсь к выпускным экзаменам.",
                                "zh": "由于正在准备期末考试，学习是我目前的<w>重点</w>。"
                            }
                        },
                        {
                            "text": "The <w>focus</w> of the meeting was to discuss the budget for the upcoming year.",
                            "target_lang_translations": {
                                "ru": "Центральной <w>темой</w> встречи было обсуждение бюджета на предстоящий год.",
                                "zh": "会议的<w>焦点</w>是讨论来年的预算。"
                            }
                        }
                    ],
                    "synonyms": [
                        "focal point",
                        "center",
                        "centre"
                    ],
                    "common_phrases": [
                        "main focus",
                        "primary focus",
                        "central focus"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, на что в первую очередь направлена деятельность, внимание или интерес.",
                        "zh": "活动、注意或兴趣主要指向的对象。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "центр внимания",
                                "target_lang_sense_clarification": "основной интерес"
                            },
                            {
                                "target_lang_word": "фокус",
                                "target_lang_sense_clarification": "приоритетное направление"
                            },
                            {
                                "target_lang_word": "средоточие",
                                "target_lang_sense_clarification": "место концентрации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "焦点",
                                "target_lang_sense_clarification": "关注中心"
                            },
                            {
                                "target_lang_word": "重点",
                                "target_lang_sense_clarification": "主要目标"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc05359f-0eab-3d00-9eea-f16fae0b4a9a",
                    "sense_definition": "The concentration of attention or the ability to stay concentrated.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mental concentration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I believe I can bring the high degree of <w>focus</w> required for this important job.",
                            "target_lang_translations": {
                                "ru": "Я верю, что смогу обеспечить высокую степень <w>сосредоточенности</w>, необходимую для этой важной работы.",
                                "zh": "我相信我能带来这份重要工作所要求的极高<w>专注力</w>。"
                            }
                        },
                        {
                            "text": "It is hard to maintain <w>focus</w> when there is so much noise in the office.",
                            "target_lang_translations": {
                                "ru": "Трудно сохранять <w>концентрацию</w>, когда в офисе так много шума.",
                                "zh": "当办公室里有这么多噪音时，很难保持<w>专注</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "concentrate"
                    ],
                    "common_phrases": [
                        "lose focus",
                        "maintain focus",
                        "sharp focus"
                    ],
                    "target_lang_definitions": {
                        "ru": "Концентрация внимания или способность оставаться сосредоточенным.",
                        "zh": "注意力的集中或保持集中的能力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "концентрация",
                                "target_lang_sense_clarification": "способность сосредоточиться"
                            },
                            {
                                "target_lang_word": "сосредоточенность",
                                "target_lang_sense_clarification": "состояние ума"
                            },
                            {
                                "target_lang_word": "внимание",
                                "target_lang_sense_clarification": "направленность мысли"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "专注力",
                                "target_lang_sense_clarification": "保持集中的能力"
                            },
                            {
                                "target_lang_word": "注意力",
                                "target_lang_sense_clarification": "心理状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b3f67c6-8847-3e9b-93f7-c1d1cacc3ea4",
                    "sense_definition": "The state of light rays meeting at a point to produce a clear image on a medium.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "optics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Unfortunately, the license plate is out of <w>focus</w> in this image and cannot be read.",
                            "target_lang_translations": {
                                "ru": "К сожалению, номерной знак на этом изображении не в <w>фокусе</w>, и его невозможно прочитать.",
                                "zh": "不幸的是，这张图片里的车牌不在<w>焦点</w>上，无法辨认。"
                            }
                        },
                        {
                            "text": "Make sure the subject is in <w>focus</w> before you press the shutter button.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что объект находится в <w>фокусе</w>, прежде чем нажимать кнопку спуска затвора.",
                                "zh": "在按下快门按钮之前，请确保拍摄对象处于<w>焦点</w>内。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in focus",
                        "out of focus",
                        "soft focus"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние схождения световых лучей в одной точке для создания четкого изображения.",
                        "zh": "光线汇聚于一点以在介质上产生清晰图像的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фокус",
                                "target_lang_sense_clarification": "точка схождения лучей"
                            },
                            {
                                "target_lang_word": "резкость",
                                "target_lang_sense_clarification": "четкость изображения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "焦点",
                                "target_lang_sense_clarification": "光学汇聚点"
                            },
                            {
                                "target_lang_word": "清晰度",
                                "target_lang_sense_clarification": "图像的锐度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e32e5097-f510-3efa-98ac-5c392df3ed84",
                    "sense_definition": "The status of being the currently active element in a user interface.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Text entered at the keyboard is sent to the component which currently has the <w>focus</w>.",
                            "target_lang_translations": {
                                "ru": "Текст, вводимый с клавиатуры, отправляется компоненту, который в данный момент имеет <w>фокус</w>.",
                                "zh": "通过键盘输入的文本会被发送到当前拥有<w>焦点</w>的组件。"
                            }
                        },
                        {
                            "text": "The button highlight indicates that it has the keyboard <w>focus</w>.",
                            "target_lang_translations": {
                                "ru": "Подсветка кнопки указывает на то, что она имеет <w>фокус</w> клавиатуры.",
                                "zh": "按钮的高亮显示表明它拥有键盘<w>焦点</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "keyboard focus",
                        "input focus"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Статус активного элемента в пользовательском интерфейсе.",
                        "zh": "用户界面中当前活动元素的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фокус",
                                "target_lang_sense_clarification": "состояние элемента интерфейса"
                            },
                            {
                                "target_lang_word": "фокус ввода",
                                "target_lang_sense_clarification": "активность для клавиатуры"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "焦点",
                                "target_lang_sense_clarification": "界面活动状态"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}