                "forms": [],
                "senses": [
                    {
                        "sense_id": "86e71712-e871-31ea-a01d-1f7e62f99214",
                        "entry_id": "a305a466-758e-3a41-8529-4859203d336e",
                        "glosses": [
                            "Ville de Pologne, capitale de la voïvodie de Petite-Pologne, et ancienne capitale du pays (jusqu'à 1596)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9f46a9b-eb4a-4345-898f-62079b3e2dc0",
                                "sense_id": "86e71712-e871-31ea-a01d-1f7e62f99214",
                                "text": "Roy Farmouth s’était installé au Grand Hôtel, dans la rue Stakowka, au cœur du vieux Cracovie, et avait retrouvé avec plaisir le charme paisible de l’ancienne capitale, épargnée par la guerre."
                            },
                            {
                                "example_id": "45fe40dd-a0d0-4ed2-ae47-a3ed17a5b12b",
                                "sense_id": "86e71712-e871-31ea-a01d-1f7e62f99214",
                                "text": "Déjà mère de sept enfants âgés de 10 mois à 12 ans, Dominika Clarke a accouché de quintuplés, dans un hôpital de Cracovie, en Pologne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "172711e4-10fa-42fa-9524-f6ed18e56e69",
                        "source_entry_id": "a305a466-758e-3a41-8529-4859203d336e",
                        "source_sense_id": "86e71712-e871-31ea-a01d-1f7e62f99214",
                        "target_lang_word": "Krakau",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krakau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b481bb71-77c1-3caf-b5b2-9340e04dd38c",
