                            {
                                "target_lang_word": "ni z tego, ni z owego",
                                "target_lang_sense_clarification": "nagle i bez przyczyny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "08271d1b-70d0-32a0-8d26-a253dc3920a7",
                    "sense_definition": "Op een willekeurige manier, zonder erbij na te denken of zonder toestemming te vragen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "zonder_reden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je kunt niet <zomaar> bij vreemden naar binnen lopen.",
                            "target_lang_translations": {
                                "ru": "Нельзя <просто так> заходить к незнакомцам.",
                                "en": "You can't <just> walk into strangers' homes.",
                                "pl": "Nie możesz <w>tak po prostu</w> wchodzić do domów obcych ludzi."
                            }
                        },
                        {
                            "text": "Hij pakte <zomaar> mijn fiets en reed weg.",
                            "target_lang_translations": {
                                "ru": "Он <без спроса> взял мой велосипед и уехал.",
                                "en": "He took my bike <without asking> and rode away.",
                                "pl": "Wziął mój rower <w>bez pytania</w> i odjechał."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zomaar iets",
                        "niet zomaar"
                    ],
                    "target_lang_definitions": {
                        "ru": "Произвольно, не задумываясь или без разрешения.",
                        "en": "In a random way, without thinking or asking for permission.",
                        "pl": "W sposób losowy, bez zastanowienia lub bez pytania o pozwolenie."
                    },
                    "translations": {
