                "senses": [
                    {
                        "sense_id": "590a0a4d-99aa-3c98-8e6b-765503ac7ae8",
                        "entry_id": "b887f8f0-44a4-32e1-a84c-a50fa4b14313",
                        "glosses": [
                            "Variante orthographique ancienne de déclencher."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96f0befa-7221-40d6-82e5-1cef7f1a77db",
                                "sense_id": "590a0a4d-99aa-3c98-8e6b-765503ac7ae8",
                                "text": "A la tombée du jour, j’imagine, dans un hôtel meublé, le décor triste et sale où s’éveillent des hommes seuls, de vieilles femmes et des couples puissamment enchaînés. Si c’est dans une chambre de Montmartre, le réveille-matin déclanche sa sonnerie baroque."
                            },
                            {
                                "example_id": "ddc7ba08-4273-47dd-bed7-948a6a1db523",
                                "sense_id": "590a0a4d-99aa-3c98-8e6b-765503ac7ae8",
                                "text": "L’Allemagne peut-elle préparer dans les circonstances actuelles une guerre de revanche, et la déclancher dans un avenir prochain ?"
                            },
                            {
                                "example_id": "3365bc72-10c4-47d4-ba88-04ca0e1f3939",
                                "sense_id": "590a0a4d-99aa-3c98-8e6b-765503ac7ae8",
                                "text": "Chez une enfant de 16 ans, l’absorption d’une gorgée d’eau suffit bien souvent à déclancher une crise d’épilepsie."
                            }
                        ]
                    }
