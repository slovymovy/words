{
    "word_family": [
        "equivalence",
        "equivalency"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "addda4e5-5124-35b6-9686-a0feb18cd662",
                    "sense_definition": "Similar or identical in value, meaning, or effect; virtually equal.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "general_equivalence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To burn calories, a thirty-minute jog is <w>equivalent</w> to a couple of hamburgers.",
                            "target_lang_translations": {
                                "ru": "Чтобы сжечь калории, тридцатиминутная пробежка <w>эквивалентна</w> паре гамбургеров.",
                                "zh": "为了消耗热量，慢跑三十分钟<w>相当于</w>吃两个汉堡。"
                            }
                        },
                        {
                            "text": "His silence during the meeting was <w>equivalent</w> to an admission of guilt.",
                            "target_lang_translations": {
                                "ru": "Его молчание во время встречи было <w>равносильно</w> признанию вины.",
                                "zh": "他在会议期间的沉默<w>等同于</w>认罪。"
                            }
                        }
                    ],
                    "synonyms": [
                        "on a par"
                    ],
                    "antonyms": [
                        "unequal",
                        "different"
                    ],
                    "common_phrases": [
                        "equivalent to",
                        "roughly equivalent",
                        "functionally equivalent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одинаковый или тождественный по ценности, значению или действию; практически равный.",
                        "zh": "在价值、意义或效果上相似或相同；几乎相等。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эквивалентный",
                                "target_lang_sense_clarification": "общий термин"
                            },
                            {
                                "target_lang_word": "равноценный",
                                "target_lang_sense_clarification": "по стоимости или значимости"
                            },
                            {
                                "target_lang_word": "равносильный",
                                "target_lang_sense_clarification": "по действию или эффекту"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "等同",
                                "target_lang_sense_clarification": "指性质或价值相同"
                            },
                            {
                                "target_lang_word": "相当",
                                "target_lang_sense_clarification": "指在程度或价值上相匹配"
                            },
                            {
                                "target_lang_word": "等价",
                                "target_lang_sense_clarification": "指价值相等"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc1ec8a5-7f66-336f-99b0-60a5bc2d1c06",
                    "sense_definition": "Of two sets, having the same number of elements and a one-to-one correspondence.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Finite sets A and B are <w>equivalent</w> sets only when the number of elements in both is equal.",
                            "target_lang_translations": {
                                "ru": "Конечные множества A и B являются <w>эквивалентными</w> множествами, только если количество элементов в них обоих одинаково.",
                                "zh": "有限集 A 和 B 只有在元素个数相等时才是<w>等价</w>集。"
                            }
                        },
                        {
                            "text": "In advanced mathematics, two infinite sets can be considered <w>equivalent</w> if they share the same cardinality.",
                            "target_lang_translations": {
                                "ru": "В высшей математике два бесконечных множества могут считаться <w>эквивалентными</w>, если они обладают одинаковой мощностью.",
                                "zh": "在高等数学中，如果两个无限集具有相同的基数，则可以认为它们是<w>等价</w>的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "equinumerous"
                    ],
                    "common_phrases": [
                        "equivalent sets"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "mathematics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "О двух множествах: имеющие одинаковое количество элементов и взаимно однозначное соответствие.",
                        "zh": "指两个集合具有相同数量的元素，且存在一一对应关系。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эквивалентный",
                                "target_lang_sense_clarification": "математический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "等价",
                                "target_lang_sense_clarification": "数学术语，指集合间存在双射"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0750b962-6037-3719-a616-fb1946144e56",
                    "sense_definition": "Anything that is virtually equal to something else in value, function, or meaning.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "general_equivalence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Is there a cheaper generic <w>equivalent</w> for this brand-name medication?",
                            "target_lang_translations": {
                                "ru": "Существует ли более дешевый непатентованный <w>аналог</w> этого брендового лекарства?",
                                "zh": "这种品牌药有没有更便宜的通用名<w>替代品</w>？"
                            }
                        },
                        {
                            "text": "The president described the energy crisis as the moral <w>equivalent</w> of war.",
                            "target_lang_translations": {
                                "ru": "Президент назвал энергетический кризис моральным <w>эквивалентом</w> войны.",
                                "zh": "总统将能源危机描述为道德上的战争<w>等价物</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "modern equivalent",
                        "cash equivalent",
                        "moral equivalent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нечто равноценное, заменяющее что-либо другое или соответствующее ему по функции или смыслу.",
                        "zh": "在价值、功能或意义上与某物几乎相等的事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эквивалент",
                                "target_lang_sense_clarification": "полное соответствие"
                            },
                            {
                                "target_lang_word": "аналог",
                                "target_lang_sense_clarification": "схожий предмет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "等价物",
                                "target_lang_sense_clarification": "指价值相等的事物"
                            },
                            {
                                "target_lang_word": "替代品",
                                "target_lang_sense_clarification": "指功能相似的替代物"
                            },
                            {
                                "target_lang_word": "对应物",
                                "target_lang_sense_clarification": "指在不同系统中起相同作用的事物"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}