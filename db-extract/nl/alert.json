                ],
                "senses": [
                    {
                        "sense_id": "0e769365-6605-31f9-b302-24bbdb5e7c28",
                        "entry_id": "615e715b-2543-3321-8cb6-d29b35538377",
                        "glosses": [
                            "oplettend, snel reagerend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caa693c2-0a2d-4a01-a9ea-95484d0ef50f",
                                "sense_id": "0e769365-6605-31f9-b302-24bbdb5e7c28",
                                "text": "De alerte arts zag direct dat het niet goed ging met de patiënt."
                            },
                            {
                                "example_id": "1bb43c86-9e6d-478d-88a2-a6933d850089",
                                "sense_id": "0e769365-6605-31f9-b302-24bbdb5e7c28",
                                "text": "'Wat een ernstige ogen,' zei ze tegen Teresa, terwijl ze haar penseel in de verf op haar palet doopte. 'Zo donker en alert boven dat kleine wipneusje van je.' Jij en Isaac zitten als een houtsnede in mijn geheugen gegrift."
                            },
                            {
                                "example_id": "37d88f13-7b34-4238-b06e-2b173752ca2e",
                                "sense_id": "0e769365-6605-31f9-b302-24bbdb5e7c28",
                                "text": "Over het algemeen was hij iets feller en alerter dan Dennis, die meestal de kat uit de boom keek."
                            },
                            {
                                "example_id": "9c56533d-2468-47de-9048-7b59721efee6",
                                "sense_id": "0e769365-6605-31f9-b302-24bbdb5e7c28",
                                "text": "Een alerte observator ziet dat literatuur en kunst bol staan van homoseksuele verwijzingen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a3e9ad9c-b6b5-4926-9cc4-7e4804714d02",
                        "source_entry_id": "615e715b-2543-3321-8cb6-d29b35538377",
                        "source_sense_id": "0e769365-6605-31f9-b302-24bbdb5e7c28",
                        "source_sense_description": "oplettend",
                        "target_lang_word": "alert",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alert",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a0d8a069-d1e0-3ea4-9f76-7bf1a1bf34b6",
                                        "entry_id": "8f7dc25d-5c69-3b67-bb11-9c5594e7395b",
                                        "glosses": [
                                            "munter, aufgeweckt, rege, frisch"
                                        ],
                                        "tags": [
                                            "gehoben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9604c933-0102-4a62-92bc-b8fc7ab56b19",
                                                "sense_id": "a0d8a069-d1e0-3ea4-9f76-7bf1a1bf34b6",
                                                "text": "„Leider wird die historische Zeitenwende [Asiens] in Europa nur sehr eingeschränkt wahrgenommen. Die USA als Pazifik-Anrainer sind da wesentlich alerter.“"
                                            },
                                            {
                                                "example_id": "46b44451-4c87-4919-b925-bf439437e611",
                                                "sense_id": "a0d8a069-d1e0-3ea4-9f76-7bf1a1bf34b6",
                                                "text": "„Dann, als er alles geprüft hatte, steuerte er auf einen jungen Mann hinter einem Tisch zu, der ihm ein bißchen alerter aussah als die anderen Kontorschemelreiter.“"
                                            },
                                            {
                                                "example_id": "317bcfa4-8523-46fd-ad0b-99cc5555a1ba",
                                                "sense_id": "a0d8a069-d1e0-3ea4-9f76-7bf1a1bf34b6",
                                                "text": "An die Stelle der dauernden (und lähmenden!) Grundsatzdebatten ist eine Talk- und Umfragekultur getreten, die noch den kommunikativ alertesten Schriftsteller abhängt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f852085b-cdc5-4d03-baeb-57437f0498fb",
                        "source_entry_id": "615e715b-2543-3321-8cb6-d29b35538377",
                        "source_sense_id": "0e769365-6605-31f9-b302-24bbdb5e7c28",
