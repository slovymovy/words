                "senses": [
                    {
                        "sense_id": "2a3f58b5-50ef-3400-a740-d4507533b74e",
                        "entry_id": "06c9e66f-6a91-335a-9fd2-4c36fc2ff4c5",
                        "glosses": [
                            "smalle kronkelende weg"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0fbe0fec-f921-3a29-8c63-9c69b4d6ec5c",
                        "entry_id": "06c9e66f-6a91-335a-9fd2-4c36fc2ff4c5",
                        "glosses": [
                            "fiets- of wandelroute"
                        ],
                        "tags": [
                            "uitgezette toeristische"
                        ],
                        "examples": [
                            {
                                "example_id": "2713a9d9-a637-486f-9e83-1b445af17ae0",
                                "sense_id": "0fbe0fec-f921-3a29-8c63-9c69b4d6ec5c",
                                "text": "De 73-jarige pensionado Manolo is geen anachronisme. Hij heeft een Samsung Galaxy, gebruikt gps, internet en een e-reader. Hij maakt een YouTube-filmpje om sponsors te werven voor zijn droom: in Amerika de ruim 3.500 kilometer lange ‘Trail of Tears’ aflopen, waarlangs in 1838 de Cherokees naar het westen van de VS werden gedeporteerd. Maar dan wel met zijn herdershond Zafrana en ezeltje Gorrión."
                            },
                            {
                                "example_id": "1b0fe325-bb00-4a28-a22c-1ba2cb5ed33f",
                                "sense_id": "0fbe0fec-f921-3a29-8c63-9c69b4d6ec5c",
                                "text": "Zondag deed Amsterdam-Noord dienst als decor van de eerste Amsterdam Urban Trail. Meer dan 3.300 liefhebbers hadden zich ingeschreven en legden een parcours van 10 kilometer af met 18 bijzondere locaties, zoals De Ceuvel en de Tolhuistuin."
                            },
                            {
                                "example_id": "e7396695-20d2-4751-82b2-29c784f00489",
                                "sense_id": "0fbe0fec-f921-3a29-8c63-9c69b4d6ec5c",
                                "text": "De Twentse Smokkel Trail, een trimloop door het buitengebied van Losser, gaat op 2 juni op herhaling."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "058361c7-d078-416c-a45e-8c5bec7220ea",
                        "source_entry_id": "06c9e66f-6a91-335a-9fd2-4c36fc2ff4c5",
                        "source_sense_id": "2a3f58b5-50ef-3400-a740-d4507533b74e",
                        "target_lang_word": "trail",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trail",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8665390b-89d0-38ca-a935-3eaf0427773c",
                                        "entry_id": "f2a74b19-474b-3516-ae79-ccc2d026b56b",
                                        "glosses": [
                                            "To follow behind (someone or something); to tail (someone or something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa0ad15e-707f-493d-9529-9bd9b9fd991c",
                                                "sense_id": "8665390b-89d0-38ca-a935-3eaf0427773c",
                                                "text": "The hunters trailed their prey deep into the woods."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e53f242-caf5-330e-84fc-20bcd34c3cd2",
                                        "entry_id": "f2a74b19-474b-3516-ae79-ccc2d026b56b",
                                        "glosses": [
                                            "To drag (something) behind on the ground."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5188ae0-5a20-455a-8fb1-c5fe962a9481",
                                                "sense_id": "2e53f242-caf5-330e-84fc-20bcd34c3cd2",
                                                "text": "You'll get your coat all muddy if you trail it around like that."
                                            },
                                            {
                                                "example_id": "66038d90-afd9-4ef5-ace8-14935c995274",
                                                "sense_id": "2e53f242-caf5-330e-84fc-20bcd34c3cd2",
                                                "text": "Our little life is but a gust That bends the branches of thy tree, And trails its blossoms in the dust!"
                                            },
                                            {
                                                "example_id": "e5d82e7e-0060-4015-9ccd-5ce9e47d6705",
                                                "sense_id": "2e53f242-caf5-330e-84fc-20bcd34c3cd2",
                                                "text": "\"I saw your brother—I saw your brother,\" he said, nodding his head, as Archer lagged past him, trailing his spade, and scowling at the old gentleman in spectacles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e72f3afe-0f1e-351c-b269-7ee003c24810",
                                        "entry_id": "f2a74b19-474b-3516-ae79-ccc2d026b56b",
                                        "glosses": [
                                            "To leave (a trail of)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a211c76-bdf1-4e68-aa58-92c63355653d",
                                                "sense_id": "e72f3afe-0f1e-351c-b269-7ee003c24810",
                                                "text": "He walked into the house, soaking wet, and trailed water all over the place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c2056d4-8639-307a-b5fd-8fbb93a4ea75",
                                        "entry_id": "f2a74b19-474b-3516-ae79-ccc2d026b56b",
                                        "glosses": [
                                            "To show a trailer of (a film, TV show etc.); to release or publish a preview of (a report etc.) in advance of the full publication."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f089a66-4a14-4238-8f4f-1cd46eb7f436",
                                                "sense_id": "9c2056d4-8639-307a-b5fd-8fbb93a4ea75",
                                                "text": "His new film was trailed on TV last night."
                                            },
                                            {
                                                "example_id": "65379553-4c1d-4f72-a897-4039e88271cf",
                                                "sense_id": "9c2056d4-8639-307a-b5fd-8fbb93a4ea75",
                                                "text": "There were no surprises in this morning's much-trailed budget statement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8cbc930-18e1-3117-a0ba-638c2f7b2b6c",
                                        "entry_id": "f2a74b19-474b-3516-ae79-ccc2d026b56b",
                                        "glosses": [
                                            "To hang or drag loosely behind; to move with a slow sweeping motion."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf6b8bea-b4a8-45d5-b729-e86211354e23",
                                                "sense_id": "d8cbc930-18e1-3117-a0ba-638c2f7b2b6c",
                                                "text": "The bride's long dress trailed behind her as she walked down the aisle."
                                            },
                                            {
                                                "example_id": "1f301c51-ab00-43c0-abe5-91c4a50c78b4",
                                                "sense_id": "d8cbc930-18e1-3117-a0ba-638c2f7b2b6c",
                                                "text": "Even now I behold a sign, A threatening of wrath divine, A watery, wandering star, through whose streaming hair, and the white Unfolding garments of light, That trail behind it afar, The constellations shine!"
                                            },
                                            {
                                                "example_id": "c14dfeab-d7c7-46c3-809f-87fc510c6293",
                                                "sense_id": "d8cbc930-18e1-3117-a0ba-638c2f7b2b6c",
                                                "text": "Cumberland sausage is about half as thick as your wrist and extends in a single rope several feet long, so that Mistrootchinson [Mister Hutchinson, the butcher], having weighed you one end while the other trailed over the edge of the scale, would then cut it for you like a draper selling a length of tape."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c01f7366-e1fe-32ea-b300-48e819dc507d",
                                        "entry_id": "f2a74b19-474b-3516-ae79-ccc2d026b56b",
                                        "glosses": [
                                            "To run or climb like certain plants."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cde274c-5909-42c7-84cf-e20583f4f221",
                                                "sense_id": "c01f7366-e1fe-32ea-b300-48e819dc507d",
                                                "text": "The flowers glowed red and golden: snapdragons and sunflowers, and nasturtians trailing all over the turf walls and peeping in at the round windows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b824fd2d-e686-329e-92aa-3660e06b8347",
                                        "entry_id": "f2a74b19-474b-3516-ae79-ccc2d026b56b",
                                        "glosses": [
                                            "To drag oneself lazily or reluctantly along."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e84107e-1ad9-4bc8-bb1c-95001514c6d2",
                                                "sense_id": "b824fd2d-e686-329e-92aa-3660e06b8347",
                                                "text": "Our parents marched to church and we trailed behind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5089eb9-70e4-31f0-ad6f-61e979a4942c",
                                        "entry_id": "f2a74b19-474b-3516-ae79-ccc2d026b56b",
                                        "glosses": [
                                            "To be losing, to be behind in a competition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d690d10-4e40-422d-b00e-53dc123e057c",
                                                "sense_id": "f5089eb9-70e4-31f0-ad6f-61e979a4942c",
                                                "text": "Neil Lennon and his players have, in almost no time at all, roared back from trailing Rangers by 15 points in November to ending the year two points clear."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1de0186-e778-3f63-8dbb-70721c68b67c",
                                        "entry_id": "f2a74b19-474b-3516-ae79-ccc2d026b56b",
                                        "glosses": [
                                            "To carry (a firearm) with the breech near the ground and the upper part inclined forward, the piece being held by the right hand near the middle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e7cb4279-9c8d-3fe1-8b55-9e438748781c",
                                        "entry_id": "f2a74b19-474b-3516-ae79-ccc2d026b56b",
                                        "glosses": [
                                            "To create a trail in."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69a1bfec-3d09-4a51-ab05-d4ef0ceb5012",
                                                "sense_id": "e7cb4279-9c8d-3fe1-8b55-9e438748781c",
                                                "text": "The sun shone on burnished bodies and arm-bands, and robes of beaver trailed the grass as majestic fellows trod back and forth in the passion of eloquence."
                                            },
                                            {
                                                "example_id": "2d9d3076-9e8b-4c40-bcaa-e681e803847f",
                                                "sense_id": "e7cb4279-9c8d-3fe1-8b55-9e438748781c",
                                                "text": "[…] was no mean judge of racing and, having a suspicion of the possible result, she secreted a lemon in the commodious recesses of a dress which, while the height of fashion in those times, nevertheless trailed the grass."
                                            },
                                            {
                                                "example_id": "4225baf9-05fb-4da9-8c74-7f9e03b1baf1",
                                                "sense_id": "e7cb4279-9c8d-3fe1-8b55-9e438748781c",
                                                "text": "Because of the potential damages caused by social trailing, regulations stipulate that all permits are void when a group obtains multiple permits for the same campground or use area for the same night."
                                            },
                                            {
                                                "example_id": "734f78ea-8712-42f2-8342-13f0ee8d4448",
                                                "sense_id": "e7cb4279-9c8d-3fe1-8b55-9e438748781c",
                                                "text": "The monument would use the floowing indicators to determine when and where visitor allocations need to be made: (1) resource damage (e.g., proliferation of campsites, human waste problems, social trailing or vandalism to historical, archaeological, paleontological sites, or destruction of biological soil crusts), […]"
                                            },
                                            {
                                                "example_id": "8327fed7-a575-42d5-8757-6c8d7b121588",
                                                "sense_id": "e7cb4279-9c8d-3fe1-8b55-9e438748781c",
                                                "text": "In my mind's eye, I looked down at the toes of high-topped, lace-up leather boots, peeking from under a long brown skirt that bent the grass sideways as it trailed the ground and tented gently outward with every step."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8e3c084-54e3-30e4-b9ae-c23f934ce93c",
                                        "entry_id": "f2a74b19-474b-3516-ae79-ccc2d026b56b",
                                        "glosses": [
                                            "To travel by following or creating trails."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86fa466f-a0a7-4754-8f43-e2eddd622b20",
                                                "sense_id": "d8e3c084-54e3-30e4-b9ae-c23f934ce93c",
                                                "text": "Trailed three miles down the North side and encamped early, making thirteen miles trailed to-day."
                                            },
                                            {
                                                "example_id": "ed8c19ae-7a1b-4b6c-b3bd-da6b094c7a03",
                                                "sense_id": "d8e3c084-54e3-30e4-b9ae-c23f934ce93c",
                                                "text": "In accordance with the treaty of 1842 they crossed the Missouri River to a reservation in Kansas. Poor crops, however, and a feverish climate made them unhappy in their new home: they trailed back to Iowa."
                                            },
                                            {
                                                "example_id": "46f3f87e-309a-455d-9536-2d264672ca46",
                                                "sense_id": "d8e3c084-54e3-30e4-b9ae-c23f934ce93c",
                                                "text": "But we did not see him and now, in the big heat of noon, we made three long circles around some hills and finally came out into a meadow full of little, humpy Masai cattle and, leaving all shade behind, trailed back across the open country under the noon sun to the car."
                                            },
                                            {
                                                "example_id": "361a13c5-3822-4051-b064-f40edb7a089f",
                                                "sense_id": "d8e3c084-54e3-30e4-b9ae-c23f934ce93c",
                                                "text": "That control became visible each spring when they trailed back out of the low country to summer range."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d8359f0-b335-348f-8c8b-4967d6395082",
                                        "entry_id": "f2a74b19-474b-3516-ae79-ccc2d026b56b",
                                        "glosses": [
                                            "To transport (livestock) by herding it along a trail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "062fd93a-29af-4884-bd59-47815b0da444",
                                                "sense_id": "9d8359f0-b335-348f-8c8b-4967d6395082",
                                                "text": "One operator on the Boise Forest in Idaho reports that where he formerly marketed 80-pound lambs after trailing them 10 days from the allotment, his lambs now often tip the scales at 100 pounds or better, mainly because only one day is required to transport an entire shipment to the railroad through the use of truck pullmans."
                                            },
                                            {
                                                "example_id": "5c37ef6c-beef-4116-8ca0-f3c0daeaa062",
                                                "sense_id": "9d8359f0-b335-348f-8c8b-4967d6395082",
                                                "text": "Genesis, the first book of the Holy Bible, relates the earliest known instance of cattle being trailed to better grass lands (unless Noah's trip with the ark is one)."
                                            },
                                            {
                                                "example_id": "00894d37-6c5f-40a7-8488-b88303ea6427",
                                                "sense_id": "9d8359f0-b335-348f-8c8b-4967d6395082",
                                                "text": "The most impressive long-distance traders, however, were the backcountry drovers, who trailed herds of livestock up the wagon road to Philadelphia (Merrens 1964:135; Bridenbaugh 1971:138)."
                                            },
                                            {
                                                "example_id": "3944352a-6c93-4a0a-81f6-1b74cc7cee3f",
                                                "sense_id": "9d8359f0-b335-348f-8c8b-4967d6395082",
                                                "text": "In all areas where trails are present, stock must remain on the trails. Free trailing or loose herding is not permitted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09dc7e58-e158-38d0-900f-e252e9c5ec10",
                                        "entry_id": "f2a74b19-474b-3516-ae79-ccc2d026b56b",
                                        "glosses": [
                                            "To take advantage of the ignorance of; to impose upon."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96567b04-dac1-43be-8ab5-147f7b74293d",
                                                "sense_id": "09dc7e58-e158-38d0-900f-e252e9c5ec10",
                                                "text": "I presently perceived she was (what is vernacularly termed) trailing Mrs. Dent; that is, playing on her ignorance."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "trail",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34114803-841c-311b-8f89-e46a40104cac",
                                        "entry_id": "c80fd08c-4267-3c54-95bf-f415e78dbe5e",
                                        "glosses": [
                                            "The track or indication marking the route followed by something that has passed, such as the footprints of animal on land or the contrail of an airplane in the sky."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "115ab89f-0b45-44cb-8efd-d3e9adbdb877",
                                                "sense_id": "34114803-841c-311b-8f89-e46a40104cac",
                                                "text": "trail of blood"
                                            },
                                            {
                                                "example_id": "f38d43d3-5f2b-4f01-8819-8ee6264ffbea",
                                                "sense_id": "34114803-841c-311b-8f89-e46a40104cac",
                                                "text": "condensation trail"
                                            },
                                            {
                                                "example_id": "e2f5355e-3854-4b07-98c7-cd358ea3e658",
                                                "sense_id": "34114803-841c-311b-8f89-e46a40104cac",
                                                "text": "data trail, paper trail"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2d61b1e-b5d4-37ac-81f8-efb693f12332",
                                        "entry_id": "c80fd08c-4267-3c54-95bf-f415e78dbe5e",
                                        "glosses": [
                                            "A route for travel over land, especially a narrow, unpaved pathway for use by hikers, horseback riders, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a17bd80c-8924-3305-aac4-7aa2cbc67030",
                                        "entry_id": "c80fd08c-4267-3c54-95bf-f415e78dbe5e",
                                        "glosses": [
                                            "A route or circuit generally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0126a0b5-07e7-4975-aa16-c58c3636ea02",
                                                "sense_id": "a17bd80c-8924-3305-aac4-7aa2cbc67030",
                                                "text": "Politicians are on the campaign trail in preparation for this year's election."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0ee1f97-9b47-39e8-afa0-0e61aac43a0a",
                                        "entry_id": "c80fd08c-4267-3c54-95bf-f415e78dbe5e",
                                        "glosses": [
                                            "A trailer broadcast on television for a forthcoming film or programme."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b559d67d-ead2-35c1-8163-1a8711179afa",
                                        "entry_id": "c80fd08c-4267-3c54-95bf-f415e78dbe5e",
                                        "glosses": [
                                            "A walk in which all the edges are distinct."
                                        ],
                                        "tags": [],
