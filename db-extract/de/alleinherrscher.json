                            {
                                "example_id": "a94e47de-b7e7-413d-bbfc-d677831553a1",
                                "sense_id": "43d5fab3-b804-3bea-afaa-ba91668a4947",
                                "text": "Die alte Volksrepublik der Nullerjahre, verkörpert durch Hu Jintao, muss abtreten, um Platz für das neue China unter Alleinherrscher Xi Jinping zu machen.",
