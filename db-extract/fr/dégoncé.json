                        "examples": [
                            {
                                "example_id": "872ce91b-9492-436d-8426-16f3da4b4075",
                                "sense_id": "28caaaf9-80da-37fc-8fbb-56d6deee6077",
                                "text": "On traversait des parcs à même la pelouse, devant de très belles maisons nobles, désertes et déjà borgnes de quelques volets dégoncés, sur le perron desquelles des jardiniers désœuvrés, les mains dans la poitrine de leurs tabliers, nous regardaient passer."
                            },
                            {
                                "example_id": "ab47fbcf-579c-4645-8ba1-1461defef0a1",
                                "sense_id": "28caaaf9-80da-37fc-8fbb-56d6deee6077",
                                "text": "[…] une fenêtre du premier étage qui était restée ouverte, manifestement parce que le volet, pourri de pluie et dégoncé, ne pouvait plus se fermer."
                            }
                        ]
