                "senses": [
                    {
                        "sense_id": "24fdad61-80d3-3006-9efc-57525f48103c",
                        "entry_id": "e80c8166-46fc-3049-8a00-d70eef5aed5d",
                        "glosses": [
                            "Weg mit sandiger Oberfläche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfaf4717-26b4-4f92-9fa3-9e0f242412e4",
                                "sense_id": "24fdad61-80d3-3006-9efc-57525f48103c",
                                "text": "„Bis nach I-n-Guezzam, dem algerischen Grenzposten zum Niger, waren es 320 Kilometer Sandpiste.“"
                            },
                            {
                                "example_id": "cdd5026a-29a8-46c7-ab9e-d2f3a6ff7cde",
                                "sense_id": "24fdad61-80d3-3006-9efc-57525f48103c",
                                "text": "„Links und rechts der Sandpiste, die heute als Straße dient, streckt sich der gelbrötliche Staub bis zum Horizont, darüber thront erdrückend der unendliche Himmel New Mexikos.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
