{
    "word_family": [
        "northeastern",
        "northeasterly",
        "northeastward",
        "northeastwards"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4b4e631c-fdb8-3603-916c-59fb927f0363",
                    "sense_definition": "The direction or compass point halfway between north and east.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "compass_point",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wind is blowing strongly from the <w>northeast</w> today.",
                            "target_lang_translations": {
                                "ru": "Сегодня дует сильный ветер с <w>северо-востока</w>.",
                                "zh": "今天风正从<w>东北</w>方向强劲地吹来。"
                            }
                        },
                        {
                            "text": "Look to the <w>northeast</w> to see the sunrise over the mountains.",
                            "target_lang_translations": {
                                "ru": "Посмотрите на <w>северо-восток</w>, чтобы увидеть восход солнца над горами.",
                                "zh": "看向<w>东北</w>方，就能看到太阳从山后升起。"
                            }
                        }
                    ],
                    "antonyms": [
                        "southwest"
                    ],
                    "common_phrases": [
                        "to the northeast",
                        "from the northeast",
                        "in the northeast"
                    ],
                    "target_lang_definitions": {
                        "ru": "Направление или сторона света посередине между севером и востоком.",
                        "zh": "位于北和东之间的方向或罗盘方位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "северо-восток",
                                "target_lang_sense_clarification": "сторона света"
                            },
                            {
                                "target_lang_word": "норд-ост",
                                "target_lang_sense_clarification": "морской термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "东北",
                                "target_lang_sense_clarification": "方位"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f1514738-a206-33ba-b022-ddd5fcbe1d65",
                    "sense_definition": "Situated toward or in the direction of the northeast.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They live in a small village on the <w>northeast</w> coast of the island.",
                            "target_lang_translations": {
                                "ru": "Они живут в маленькой деревне на <w>северо-восточном</w> побережье острова.",
                                "zh": "他们住在岛上<w>东北部</w>海岸的一个小村庄里。"
                            }
                        },
                        {
                            "text": "The map shows a <w>northeast</w> course for the ship.",
                            "target_lang_translations": {
                                "ru": "Карта показывает <w>северо-восточный</w> курс корабля.",
                                "zh": "地图显示了这艘船的<w>东北</w>航向。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "northeast corner",
                        "northeast coast",
                        "northeast side"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расположенный в направлении северо-востока или на северо-востоке.",
                        "zh": "位于东北方向或朝向东北的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "северо-восточный",
                                "target_lang_sense_clarification": "расположение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "东北部的",
                                "target_lang_sense_clarification": "形容词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e87d7b40-8a35-3e54-abf7-d34b2a579b67",
                    "sense_definition": "Coming from the northeast, usually describing wind.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wind_direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A cold <w>northeast</w> wind brought snow to the region.",
                            "target_lang_translations": {
                                "ru": "Холодный <w>северо-восточный</w> ветер принес в регион снег.",
                                "zh": "一股寒冷的<w>东北</w>风给该地区带来了降雪。"
                            }
                        },
                        {
                            "text": "Sailors often struggle against the strong <w>northeast</w> breeze.",
                            "target_lang_translations": {
                                "ru": "Морякам часто приходится бороться с сильным <w>северо-восточным</w> ветром.",
                                "zh": "水手们经常要顶着强劲的<w>东北</w>风航行。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "northeast wind",
                        "northeast breeze"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дующий с северо-востока (обычно о ветре).",
                        "zh": "来自东北方向的，通常指风。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "северо-восточный",
                                "target_lang_sense_clarification": "о ветре"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "东北",
                                "target_lang_sense_clarification": "指风向"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "c0997cfd-d6be-3e19-ad8b-59fe407a1097",
                    "sense_definition": "Towards the direction of the northeast.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "direction_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We are travelling <w>northeast</w> to reach the cabin before dark.",
                            "target_lang_translations": {
                                "ru": "Мы едем <w>на северо-восток</w>, чтобы добраться до хижины до темноты.",
                                "zh": "我们正<w>向东北</w>行进，以便在天黑前到达小屋。"
                            }
                        },
                        {
                            "text": "The storm is moving <w>northeast</w> across the state.",
                            "target_lang_translations": {
                                "ru": "Шторм движется <w>на северо-восток</w> через штат.",
                                "zh": "风暴正<w>向东北</w>移动，横穿整个州。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "travel northeast",
                        "head northeast",
                        "move northeast"
                    ],
                    "target_lang_definitions": {
                        "ru": "В направлении северо-востока.",
                        "zh": "朝向东北方向。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "на северо-восток",
                                "target_lang_sense_clarification": "направление движения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "向东北",
                                "target_lang_sense_clarification": "运动方向"
                            }
                        ]
                    }
                }
            ]
        },
        {
