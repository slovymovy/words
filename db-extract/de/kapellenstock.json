                            {
                                "example_id": "f1b449b0-a67c-47b6-abd0-d0194fa43121",
                                "sense_id": "4d17e0cd-2c29-3c88-b444-01d01ce62bed",
                                "text": "Der Kapellenstock war mit einem Schloss versehen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4bc49a8e-5b8c-3c3c-a198-807405b57381",
                        "entry_id": "5633f384-5ed1-3687-af1c-71dc8b88cba6",
                        "glosses": [
                            "Säule mit solidem Unterbau und Votivnische mit Bildern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05aec853-d674-40db-8b19-1f760fe552f4",
                                "sense_id": "4bc49a8e-5b8c-3c3c-a198-807405b57381",
                                "text": "„Der Träubeles-Bildstock westlich hinter dem Königheimer Friedhof wird laut Kolb Kapellenstock genannt.“"
                            },
                            {
                                "example_id": "e9af4fdb-59a6-4073-9d4a-e42ccb94fb0c",
                                "sense_id": "4bc49a8e-5b8c-3c3c-a198-807405b57381",
                                "text": "Damals wurde auch der kleine Kapellenstock, ein durchfenstertes Walmdachhäuschen auf der Mauerkrone der Nordostecke des Stiftsareals, aufgegeben."
                            },
                            {
                                "example_id": "c6d00c44-c21f-4e8f-98e5-8d74605275e9",
                                "sense_id": "4bc49a8e-5b8c-3c3c-a198-807405b57381",
                                "text": "Das Prunnerkreuz ist ein richtiger Kapellenstock, wohl einer der wertvollsten des Landes."
                            },
                            {
                                "example_id": "924632bc-4050-40f2-a5ec-f6416e63cb0b",
                                "sense_id": "4bc49a8e-5b8c-3c3c-a198-807405b57381",
                                "text": "Der ganze Kapellenstock ist außen mit großen Granitquadern verblendet, in Schichten von 27 bis 58 cm Höhe."
                            },
                            {
                                "example_id": "2b878bf1-8419-4f7c-9cc1-0127364a21cd",
                                "sense_id": "4bc49a8e-5b8c-3c3c-a198-807405b57381",
                                "text": "Dieser Kapellenstock wird nach dem nebenstehenden Haus auch Saxer Kapelle genannt. Früher einmal war es umgekehrt: Es hat das einst kleine Wohnhaus wegen der Kapelle das Kapellhäusl geheißen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
