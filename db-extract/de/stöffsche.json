                "senses": [
                    {
                        "sense_id": "6aca78cd-28e6-39b7-8393-d04aa8fbbb12",
                        "entry_id": "c6be1f53-d305-3e4a-b34d-5ab748eef75e",
                        "glosses": [
                            "Apfelwein, wird besonders gerne in alten urigen Szenekneipen in Frankfurt benutzt"
                        ],
                        "tags": [
                            "hessisch"
                        ],
                        "examples": [
                            {
                                "example_id": "7f3159cf-35d3-4d8d-8e19-9a25472022c6",
                                "sense_id": "6aca78cd-28e6-39b7-8393-d04aa8fbbb12",
                                "text": "Oft kann man „Stöffsche“ auch auf der Speisekarte von diesen oben besagten Kneipen finden."
                            },
                            {
                                "example_id": "ebd9ce0d-2c19-498a-bc84-75adfb2f62e5",
                                "sense_id": "6aca78cd-28e6-39b7-8393-d04aa8fbbb12",
                                "text": "Apfelwein wird in Hessen „Ebbelwoi“, „Abbelwoi“ oder auch „Stöffsche“ genannt."
                            },
                            {
                                "example_id": "e56110e8-ebce-4594-b90f-f5a5e2e5c910",
                                "sense_id": "6aca78cd-28e6-39b7-8393-d04aa8fbbb12",
                                "text": "Für den Sachsenhäuser ist dies kein Problem, er kennt sein Stöffsche!"
                            },
                            {
                                "example_id": "cacabab0-2c1f-4c74-b539-66aa5520737c",
                                "sense_id": "6aca78cd-28e6-39b7-8393-d04aa8fbbb12",
                                "text": "Inklusive einem großen Glas kühlen, frischen Ebbelwoi oder Stöffsche, wie die Frankfurter ihr Nationalgetränk liebevoll nannten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8ce8307c-e362-3dc1-a3cc-87c5c4a406ec",
                        "entry_id": "c6be1f53-d305-3e4a-b34d-5ab748eef75e",
                        "glosses": [
                            "Wein"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "835868a6-f6ca-4552-8e52-fea31fc833af",
                                "sense_id": "8ce8307c-e362-3dc1-a3cc-87c5c4a406ec",
                                "text": "Ein süffig' Stöffsche, wie die Pfälzer sagen würden."
                            },
                            {
                                "example_id": "bbd4d814-2ba9-45a2-a2ca-2b23a69e4006",
                                "sense_id": "8ce8307c-e362-3dc1-a3cc-87c5c4a406ec",
                                "text": "Jaja, e ordentliches Stöffsche. Deswege gibt's bei uns so viel Eiswein, weil de Betriebsleiter mitte im Weinberg wohnt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
