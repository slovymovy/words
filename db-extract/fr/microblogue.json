                    {
                        "sense_id": "63c29f89-c036-3d64-9eea-d89503f7166d",
                        "entry_id": "a06cd1f6-064b-3dd6-91bd-22a4ea7135af",
                        "glosses": [
                            "Blogue constitué de micromessages diffusés en temps réel, qui contiennent souvent des mots-dièse et dont l’enchaînement forme des fils de discussion."
                        ],
                        "tags": [
                            "Internet"
                        ],
                        "examples": [
                            {
                                "example_id": "e9803f14-09af-470c-893e-86b74029e68d",
                                "sense_id": "63c29f89-c036-3d64-9eea-d89503f7166d",
                                "text": "Avec la matérialisation : la rumeur se « copie-colle », se commente, se transforme en hyperliens, se retrouve sur microblogue avec Twitter et s’intègre dans des vidéos que l’on se transmet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9defc106-7e06-45f6-b23c-a3d74ddf2402",
                        "source_entry_id": "a06cd1f6-064b-3dd6-91bd-22a4ea7135af",
                        "source_sense_id": "63c29f89-c036-3d64-9eea-d89503f7166d",
                        "target_lang_word": "microblog",
