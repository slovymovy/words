                                            {
                                                "example_id": "46cdbbd5-75bf-482d-8f5e-c56dda5eae66",
                                                "sense_id": "ac14b851-2b2c-3fff-b17b-ecbb5713daca",
                                                "text": "Er hat ein recht flatterhaftes Wesen."
