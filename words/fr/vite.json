        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "b85ab35d-ff2b-3bfb-98f2-ffcf19624e44",
                    "sense_definition": "Exclamation exprimant l'urgence ou servant à presser vivement quelqu'un.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "urgence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Vite</w>, le train va partir dans moins de deux minutes !",
                            "target_lang_translations": {
                                "en": "<w>Hurry</w>, the train is leaving in less than two minutes!",
                                "ru": "<w>Скорее</w>, поезд отправляется меньше чем через две минуты!",
                                "nl": "<w>Schiet op</w>, de trein vertrekt over minder dan twee minuten!",
                                "de": "<w>Schnell</w>, der Zug fährt in weniger als zwei Minuten ab!",
                                "pl": "<w>Szybciej</w>, pociąg odjeżdża za mniej niż dwie minuty!",
                                "it": "<w>Presto</w>, il treno parte tra meno di due minuti!",
                                "cs": "<w>Honem</w>, vlak odjíždí za méně než dvě minuty!",
                                "tr": "<w>Çabuk</w> olun, tren iki dakikadan kısa bir süre içinde kalkıyor!",
                                "es": "¡<w>Deprisa</w>, que el tren sale en menos de dos minutos!",
                                "zh": "<w>快点</w>！火车不到两分钟就要开了！"
                            }
                        },
                        {
                            "text": "<w>Vite</w>, apportez une trousse de premiers secours pour ce voyageur blessé !",
                            "target_lang_translations": {
                                "en": "<w>Quick</w>, bring a first-aid kit for this injured traveller!",
                                "ru": "<w>Живо</w>, принесите аптечку для этого раненого пассажира!",
                                "nl": "<w>Snel</w>, breng een EHBO-koffer voor deze gewonde reiziger!",
                                "de": "<w>Schnell</w>, bringen Sie einen Verbandkasten für diesen verletzten Reisenden!",
                                "pl": "<w>Szybko</w>, przynieście apteczkę dla tego rannego podróżnego!",
                                "it": "<w>Presto</w>, portate una cassetta di pronto soccorso per questo viaggiatore ferito!",
                                "cs": "<w>Rychle</w>, přineste lékárničku pro toho zraněného cestujícího!",
                                "tr": "<w>Çabuk</w>, bu yaralı yolcu için bir ilk yardım çantası getirin!",
                                "es": "¡<w>Rápido</w>, traigan un botiquín de primeros auxilios para este viajero herido!",
                                "zh": "<w>快点</w>！给这位受伤的旅客拿个急救箱来！"
                            }
                        }
                    ],
                    "synonyms": [
