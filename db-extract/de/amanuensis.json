                                    {
                                        "sense_id": "608f1f75-88d5-3649-98aa-0fe925e0d71a",
                                        "entry_id": "ff58c74c-d1b2-3ac4-b5d3-9cf3d3fdf0d6",
                                        "glosses": [
                                            "Someone employed as a scribe for personal correspondence."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1eb3621e-226c-4dda-9986-e7620fc0fb4b",
                                                "sense_id": "608f1f75-88d5-3649-98aa-0fe925e0d71a",
                                                "text": "\"Do not give yourself any uneasiness about one so utterly unworthy of a thought! Sir George Kingston is without one grain of either honour or real feeling! The fact is, I have, for some months past, been his secretary, and wrote for him the letters which were sent you!\""
                                            }
