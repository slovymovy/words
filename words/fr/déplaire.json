{
    "word_family": [
        "déplaisant",
        "déplaisir",
        "plaire",
        "plaisant",
        "plaisir"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3eb9da23-ad66-3c16-82df-16096ca7228a",
                    "sense_definition": "Être désagréable, susciter le mécontentement ou le refus chez quelqu'un en parlant d'une chose ou d'une situation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "deplaisir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle organisation du travail <w>déplaît</w> fortement à l'ensemble des employés."
                        },
                        {
                            "text": "N'en <w>déplaise</w> à ses détracteurs, le musicien a donné un concert tout à fait remarquable."
                        }
                    ],
                    "synonyms": [
                        "indisposer",
                        "chagriner"
                    ],
                    "antonyms": [
                        "plaire",
                        "convenir"
                    ],
                    "common_phrases": [
                        "n'en déplaise à",
                        "ne vous en déplaise"
                    ]
                },
                {
                    "sense_id": "df8de2f7-0c7c-3e96-9d72-3856f4cb66b0",
                    "sense_definition": "Ne pas plaire à quelqu'un, s'attirer son antipathie ou sa désapprobation en parlant d'une personne.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "deplaisir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Par son attitude arrogante, ce candidat a immédiatement <w>déplu</w> à toute l'équipe."
                        },
                        {
                            "text": "Il craignait toujours de <w>déplaire</w> aux parents de sa fiancée lors des repas."
                        }
                    ],
                    "synonyms": [
                        "insupporter"
                    ],
                    "antonyms": [
                        "plaire",
                        "séduire"
                    ],
                    "common_phrases": [
                        "craindre de déplaire"
                    ]
                },
                {
                    "sense_id": "18519440-bb04-307a-b815-a04c56b58177",
                    "sense_definition": "Ne pas se sentir bien ou ne pas s'adapter dans un endroit, un travail ou un milieu.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis son déménagement, elle se <w>déplaît</w> profondément dans cette maison isolée."
                        },
                        {
                            "text": "Ces arbres fragiles se <w>déplaisent</w> dans une terre trop sèche et calcaire."
                        }
                    ],
                    "antonyms": [
                        "se plaire"
                    ],
                    "common_phrases": [
                        "se déplaire quelque part"
                    ]
                }
            ]
        }
    ]
}