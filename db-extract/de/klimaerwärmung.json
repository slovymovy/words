                    },
                    {
                        "sense_id": "f3c29344-2572-3a40-9c5f-fe9a9b1ccc7f",
                        "entry_id": "d21b447b-a7fb-3387-8c25-538a0e168781",
                        "glosses": [
                            "der seit einigen Jahrzehnten beobachtete Anstieg der Durchschnittstemperatur auf der Erde (Globale Erwärmung)"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "c98bd739-a4ad-44b8-a9e3-dc27447c4015",
                                "sense_id": "f3c29344-2572-3a40-9c5f-fe9a9b1ccc7f",
                                "text": "Die weltweite Klimaerwärmung wird von vielen als eine der größten Gefahren des 21. Jahrhunderts wahrgenommen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
