                        ],
                        "examples": [
                            {
                                "example_id": "5b99dc99-90c9-4758-a9c9-9fd505bc5636",
                                "sense_id": "49c82ee3-b520-340a-b361-7dd68a411dea",
                                "text": "Native Americans seem to have always placed great value on silence and direct experience, and in indigenous cultures in general, silence denotes respect and self-effacement."
                            }
                        ]
                    },
                    {
                        "sense_id": "0011d374-428e-31f5-aa2a-560ea5d88e69",
