{
    "word_family": [
        "flayer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2b6c426a-37f2-3564-94bf-98d658f69ac3",
                    "sense_definition": "To strip the skin off an animal or person.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "skinning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunter had to <w>flay</w> the deer carefully to preserve the hide.",
                            "target_lang_translations": {
                                "ru": "Охотнику пришлось осторожно <w>свежевать</w> оленя, чтобы сохранить шкуру."
                            }
                        },
                        {
                            "text": "Ancient accounts describe how they would <w>flay</w> the animal after the hunt.",
                            "target_lang_translations": {
                                "ru": "В старинных описаниях говорится, что после охоты они <w>сдирали шкуру</w> с животного."
                            }
                        }
                    ],
                    "synonyms": [
                        "fleece",
                        "flense",
                        "skin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Снять кожу или шкуру с животного или человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свежева́ть",
                                "target_lang_sense_clarification": "о туше животного: снимать шкуру; свежевать"
                            },
                            {
                                "target_lang_word": "сдира́ть шку́ру",
                                "target_lang_sense_clarification": "буквально: снимать кожу или шкуру"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "563f8a35-102b-3f3c-b4d4-1e8368cd4911",
                    "sense_definition": "To lash or whip someone severely.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "skinning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cruel master threatened to <w>flay</w> the servant for his mistake.",
                            "target_lang_translations": {
                                "ru": "Жестокий хозяин пригрозил <w>высечь</w> слугу за его ошибку."
                            }
                        },
                        {
                            "text": "The prisoner was <w>flayed</w> as punishment for his crimes.",
                            "target_lang_translations": {
                                "ru": "Заключённого <w>высекли</w> в наказание за его преступления."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Жестоко избить или высечь кого-либо кнутом, плетью или розгами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высе́чь",
                                "target_lang_sense_clarification": "жестоко наказать ударами, обычно плетью или розгами"
                            },
                            {
                                "target_lang_word": "поро́ть",
                                "target_lang_sense_clarification": "сильно бить в наказание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61003986-4080-30f5-b169-98bd1f31d8dc",
                    "sense_definition": "To frighten or terrify someone.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden loud noise seemed to <w>flay</w> the nervous horse.",
                            "target_lang_translations": {
                                "ru": "Казалось, что внезапный громкий шум <w>испугал</w> нервную лошадь."
                            }
                        },
                        {
                            "text": "He tried to <w>flay</w> his opponent with aggressive threats.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>устрашить</w> противника агрессивными угрозами."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is largely archaic."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пугать или приводить кого-либо в сильный страх."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пуга́ть",
                                "target_lang_sense_clarification": "вызвать страх, напугать"
                            },
                            {
                                "target_lang_word": "устраша́ть",
                                "target_lang_sense_clarification": "внушать сильный страх"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78f254d0-9fca-3323-aa1a-5d5877b25a40",
                    "sense_definition": "To drive someone or something away by frightening them.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The loud shouting helped to <w>flay</w> the intruders from the property.",
                            "target_lang_translations": {
                                "ru": "Громкие крики помогли <w>отпугнуть</w> нарушителей от участка."
                            }
                        },
                        {
                            "text": "They managed to <w>flay</w> the birds away from the crops.",
                            "target_lang_translations": {
                                "ru": "Им удалось <w>спугнуть</w> птиц от посевов."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is largely archaic."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прогнать кого-либо или что-либо, напугав."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отпугну́ть",
                                "target_lang_sense_clarification": "заставить уйти, напугав"
                            },
                            {
                                "target_lang_word": "спугну́ть",
                                "target_lang_sense_clarification": "резко прогнать страхом, особенно птиц или животных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e129c344-2f36-3a03-af04-9d0b00d8e6f2",
                    "sense_definition": "To be in a state of extreme fear.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villagers were <w>flayed</w> by the rumors of the approaching army.",
                            "target_lang_translations": {
                                "ru": "Слухи о приближении армии <w>привели жителей деревни в ужас</w>."
                            }
                        },
                        {
                            "text": "He was <w>flayed</w> by the thought of losing his home.",
                            "target_lang_translations": {
                                "ru": "Мысль о потере дома <w>приводила его в ужас</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is largely archaic."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Находиться в состоянии крайнего страха."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быть в у́жасе",
                                "target_lang_sense_clarification": "испытывать очень сильный страх"
                            },
                            {
                                "target_lang_word": "трепета́ть от стра́ха",
                                "target_lang_sense_clarification": "быть охваченным страхом"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8e46f800-62e7-3c17-a66c-abee60cbf48c",
                    "sense_definition": "A sudden feeling of fear or a scare.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden shadow gave him a real <w>flay</w>.",
                            "target_lang_translations": {
                                "ru": "Внезапная тень вызвала у него настоящий <w>испуг</w>."
                            }
                        },
                        {
                            "text": "She recovered from the <w>flay</w> after realizing it was just a cat.",
                            "target_lang_translations": {
                                "ru": "Она оправилась от <w>испуга</w>, когда поняла, что это была всего лишь кошка."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is largely archaic."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапное чувство страха; испуг."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испу́г",
                                "target_lang_sense_clarification": "внезапное чувство страха"
                            },
                            {
                                "target_lang_word": "перепо́лох",
                                "target_lang_sense_clarification": "резкий краткий страх"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8038349-865c-3dae-80f2-5b0328c70582",
                    "sense_definition": "A source of intense fear or a terrifying person.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dark forest was a constant <w>flay</w> to the young children.",
                            "target_lang_translations": {
                                "ru": "Тёмный лес был для маленьких детей постоянным <w>источником страха</w>."
                            }
                        },
                        {
                            "text": "That man is a <w>flay</w> to everyone in the neighborhood.",
                            "target_lang_translations": {
                                "ru": "Этот человек — настоящее <w>пугало</w> для всех в округе."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is largely archaic."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Источник сильного страха или человек, внушающий ужас."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пуга́ло",
                                "target_lang_sense_clarification": "то, что пугает; человек или предмет, внушающий страх"
                            },
                            {
                                "target_lang_word": "исто́чник стра́ха",
                                "target_lang_sense_clarification": "причина сильного страха"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "1cdb2324-8c64-34ec-89d5-b07af08bec62",
                    "sense_definition": "A family name.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Flay</w> is our new neighbor.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Флей</w> — наш новый сосед."
                            }
                        },
                        {
                            "text": "The <w>Flays</w> are hosting a dinner party tonight.",
                            "target_lang_translations": {
                                "ru": "Сегодня вечером ужин устраивает семья <w>Флей</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": []
                    }
                }
            ]
        }
    ]
}