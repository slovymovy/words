                "senses": [
                    {
                        "sense_id": "124cd5f4-8f7e-3ddf-b6a0-9ad1120e768d",
                        "entry_id": "7ca3a66b-3aa6-327c-b741-c4c6ba06a1ae",
                        "glosses": [
                            "Mann, der eine große Ausstrahlung auf Frauen besitzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40dde5a1-f9a1-4d98-aff5-36e44e066dbd",
                                "sense_id": "124cd5f4-8f7e-3ddf-b6a0-9ad1120e768d",
                                "text": "„Ich war ein komischer Womanizer in dieser wie in der anderen Welt.“"
                            },
                            {
                                "example_id": "8cc5c1cb-8fe7-4749-ba1a-28efec2b4292",
                                "sense_id": "124cd5f4-8f7e-3ddf-b6a0-9ad1120e768d",
                                "text": "„Souveräner kann man einem Womanizer den Stecker nicht ziehen.“"
                            },
                            {
                                "example_id": "ff1656a8-fdda-475d-8084-87a7d3c7278d",
                                "sense_id": "124cd5f4-8f7e-3ddf-b6a0-9ad1120e768d",
                                "text": "„Clinton war, wie viele seiner Vorgänger, ein Präsident, der mit mildem Understatement als Womanizer durch seine Amtszeit und seine Wahlkämpfe lief.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b8c20caf-b530-4e7e-bf6c-a48e6c6db6ac",
                        "source_entry_id": "7ca3a66b-3aa6-327c-b741-c4c6ba06a1ae",
                        "source_sense_id": "124cd5f4-8f7e-3ddf-b6a0-9ad1120e768d",
                        "source_sense_description": "Mann, der eine große Ausstrahlung auf Frauen besitzt",
                        "target_lang_word": "womanizer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "womanizer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ed4c222-32bb-3d26-8829-b4ebc9ea9f2d",
                                        "entry_id": "22e85a65-8c36-3384-a08e-88fe858d2f19",
                                        "glosses": [
                                            "A man who habitually flirts with and seduces, or attempts to seduce, women."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "607858f5-b55a-4552-b886-435584250e60",
                                                "sense_id": "6ed4c222-32bb-3d26-8829-b4ebc9ea9f2d",
                                                "text": "Getting back into the dating game after a painful divorce is never easy, and the proliferation of womanizers looking to take advantage of your vulnerability only makes things worse."
                                            },
                                            {
                                                "example_id": "32c9d901-64f0-4af0-933d-8db786a6bb40",
                                                "sense_id": "6ed4c222-32bb-3d26-8829-b4ebc9ea9f2d",
                                                "text": "A couple of months ago, in a piece about the language of self-involvement, I quoted a girlfriend of Woody Allen as having described the actor as “very much of a womanizer, very self-involved”."
                                            },
                                            {
                                                "example_id": "6c2a1058-de31-42a4-b874-d2e5d47d71f5",
                                                "sense_id": "6ed4c222-32bb-3d26-8829-b4ebc9ea9f2d",
                                                "text": "Sometimes the stereotype is framed as light and cheeky—think the “boys will be boys” mentality exemplified by sitcom womanizers such as How I Met Your Mothers Barney Stinson or '''Two and a Half Mens Charlie Harper."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
