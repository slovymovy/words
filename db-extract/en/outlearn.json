                "senses": [
                    {
                        "sense_id": "4a4a368b-8045-3890-944b-79eeedb35d48",
                        "entry_id": "35b31722-6a08-3096-bee4-b104658ce88e",
                        "glosses": [
                            "To surpass (someone) in learning."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3c713cb1-2b09-4800-a013-76ce540e35f1",
                                "sense_id": "4a4a368b-8045-3890-944b-79eeedb35d48",
                                "text": "By eleven years old, the young genius had outlearned most of his teachers."
                            }
                        ]
                    },
                    {
                        "sense_id": "afa22dfb-8e54-338f-ae4e-c64a99e2e6b1",
                        "entry_id": "35b31722-6a08-3096-bee4-b104658ce88e",
                        "glosses": [
                            "To learn (something) completely and thoroughly; to exhaust knowledge of."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d6f1b184-705e-4acb-95c1-f365695658b6",
                                "sense_id": "afa22dfb-8e54-338f-ae4e-c64a99e2e6b1",
                                "text": "But when as nought according to his mind / He could outlearne"
                            },
                            {
                                "example_id": "49e71a8f-5329-4153-b6f9-43b5f6029173",
                                "sense_id": "afa22dfb-8e54-338f-ae4e-c64a99e2e6b1",
                                "text": "To love and be beloved; / Men and gods have not outlearned it; / And, how oft soe'er they've turned it, / 'Tis not to be improved."
                            }
                        ]
                    }
                ],
