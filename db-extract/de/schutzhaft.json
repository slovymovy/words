                    {
                        "sense_id": "bc34dfc5-8abd-3582-b41a-ab132dcdb98a",
                        "entry_id": "801e658a-3ee9-387a-bbc4-2f36c86f53a5",
                        "glosses": [
                            "eine Haft, die dem Schutz einer gefährdeten Person gilt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb34f6dc-e621-4146-8239-6722ea8cb58e",
                                "sense_id": "bc34dfc5-8abd-3582-b41a-ab132dcdb98a",
                                "text": "Das Mittel der Schutzhaft ist in der neueren politischen Justiz vielfach missbraucht worden."
                            },
                            {
                                "example_id": "593fc32f-e5a5-4892-b234-1f46aa620ccb",
                                "sense_id": "bc34dfc5-8abd-3582-b41a-ab132dcdb98a",
                                "text": "„Seine Schwiegermutter erreichte, daß er von den sardinischen Behörden in Schutzhaft genommen und auf das Fort Miolans gebracht wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c4a92b70-206d-43cd-9a81-d3ca40dbc603",
                        "source_entry_id": "801e658a-3ee9-387a-bbc4-2f36c86f53a5",
                        "source_sense_id": "bc34dfc5-8abd-3582-b41a-ab132dcdb98a",
                        "source_sense_description": "eine Haft, die dem Schutz einer gefährdeten Person gilt",
                        "target_lang_word": "protective custody",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "protective custody",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64bfb0a0-2e83-3f5a-8717-1366b92f2449",
                                        "entry_id": "b3a8f52d-bf2b-377b-8b1c-59ed5149189b",
                                        "glosses": [
                                            "Lawful confinement of a person or close supervision of his or her movements, on a voluntary or involuntary basis, by authorities in order to safeguard that person from attack or other dangers."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa66950c-78ee-485e-870f-044ab526a0d0",
                                                "sense_id": "64bfb0a0-2e83-3f5a-8717-1366b92f2449",
                                                "text": "A so‐called star witness in the Brooklyn grand jury inquiry of alleged links between the police and gamblers sought unsuccessfully yesterday to free himself from protective custody."
                                            },
                                            {
                                                "example_id": "b855a2ea-88b1-4002-89c3-a92203ff9ed0",
                                                "sense_id": "64bfb0a0-2e83-3f5a-8717-1366b92f2449",
                                                "text": "The government has earmarked a paltry $1.2 million . . ., not enough to properly fund even the state-run counseling centers—the only institutions with the authority to put battered children into protective custody."
                                            },
                                            {
                                                "example_id": "591928cd-82d6-4a94-978b-32709caa0470",
                                                "sense_id": "64bfb0a0-2e83-3f5a-8717-1366b92f2449",
                                                "text": "Authorities charged a man today with 'arson causing death' after a week of devasting fires that killed a total of more than 180 people in Australia, and whisked him into protective custody to guard him from public fury."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
