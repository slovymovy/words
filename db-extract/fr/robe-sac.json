                        "examples": [
                            {
                                "example_id": "b28f5531-8bba-4591-8f67-1a42ae968e9e",
                                "sense_id": "e11ab5da-19d0-37f3-bf44-2948cf0a41e9",
                                "text": "Ces robes-sacs n’étaient supportables que sur de très jeunes, très minces et très jolies femmes qui, à Berlin comme ailleurs, n’étaient pas la majorité."
                            },
                            {
                                "example_id": "3b92b8fa-43f1-402a-937b-5befe703bb6f",
                                "sense_id": "e11ab5da-19d0-37f3-bf44-2948cf0a41e9",
                                "text": "Puis elle avait pris le papier pisseux et l’avait fourré dans une poche de sa robe-sac."
                            },
                            {
                                "example_id": "58a9a29e-8232-446e-9ce7-502c35cf1ba0",
                                "sense_id": "e11ab5da-19d0-37f3-bf44-2948cf0a41e9",
                                "text": "Ça, ce sont les robes-sacs du temps où j’étais enceinte."
                            }
                        ]
                    }
