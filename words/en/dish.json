                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "criticism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The critics really <w>dished</w> it <w>out</w> in their review of the play.",
                            "target_lang_translations": {
                                "ru": "Критики в своем обзоре пьесы действительно <w>разнесли</w> её в пух и прах."
                            }
                        },
                        {
                            "text": "He spent the interview <w>dishing</w> his former business partners.",
                            "target_lang_translations": {
                                "ru": "Всё интервью он <w>поливал грязью</w> своих бывших деловых партнеров."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dish it out"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Критиковать или плохо отзываться о ком-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "критиковать",
                                "target_lang_sense_clarification": "высказывать недовольство"
                            },
                            {
                                "target_lang_word": "ругать",
                                "target_lang_sense_clarification": "выражать неодобрение"
                            }
                        ]
