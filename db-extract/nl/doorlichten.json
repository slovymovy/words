                                        "entry_id": "77b994a5-dac5-3f30-9758-e76b164385d8",
                                        "glosses": [
                                            "etwas analysieren oder erforschen, sich etwas sehr genau anschauen, um es zu verstehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93940c68-3290-4edd-86f0-fb4059638f5f",
                                                "sense_id": "1efa22cf-0aef-359a-821e-e799578de4fc",
                                                "text": "Der Kommissar untersuchte den Tatort, um Hinweise auf den Täter zu finden."
                                            },
                                            {
                                                "example_id": "ed57cf2d-b613-4baa-a9d7-fd5e929c19f2",
                                                "sense_id": "1efa22cf-0aef-359a-821e-e799578de4fc",
                                                "text": "Im Labor untersucht man die DNA-Proben."
                                            },
                                            {
                                                "example_id": "dc9f398b-c230-4e2f-b13e-3a018f5d858f",
                                                "sense_id": "1efa22cf-0aef-359a-821e-e799578de4fc",
                                                "text": "Die Arbeitsgruppe untersucht, wie man die Öle recyceln kann."
                                            },
                                            {
                                                "example_id": "15cfac82-844f-4337-8c06-04feedc50da9",
                                                "sense_id": "1efa22cf-0aef-359a-821e-e799578de4fc",
                                                "text": "Diese Fragestellung sollten wir noch etwas genauer untersuchen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5d739478-d892-3384-9c05-38452cf4aa4c",
                                        "entry_id": "77b994a5-dac5-3f30-9758-e76b164385d8",
                                        "glosses": [
                                            "den körperlichen und/oder psychischen Zustand eines Patienten überprüfen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53306a59-306e-4c3b-8c22-0d82630aee34",
                                                "sense_id": "5d739478-d892-3384-9c05-38452cf4aa4c",
                                                "text": "Er hatte Schmerzen und ließ sich deshalb von seinem Hausarzt untersuchen."
                                            }
                                        ],
