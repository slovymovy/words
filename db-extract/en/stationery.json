                                        "examples": [
                                            {
                                                "example_id": "123a69eb-2e8a-42f8-b2e3-02f0ba76c4a7",
                                                "sense_id": "3712e2f0-c484-32eb-9cfb-c2fcc0508813",
                                                "text": "Une papeterie se trouvait sur le ruisseau de la Maronne vers 1750. En 1813 elle fabriquait encore du papier d'écolier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "210e6cb6-ef2e-3b7e-8235-aed24fef5bc8",
                                        "entry_id": "15e47114-0aa6-33cb-842d-58bbdf94f58b",
