                                                "sense_id": "8226570c-59e6-3b83-81ea-ad64922b8a5c",
                                                "text": "If you're trekking all day, a map is a must."
                                            },
                                            {
                                                "example_id": "0993c416-3e98-4dae-9599-0716644c4b6c",
                                                "sense_id": "8226570c-59e6-3b83-81ea-ad64922b8a5c",
                                                "text": "\"There are no musts in my life - I'm free, white, and twenty-one.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "must",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49e67801-0fe6-3c28-8c2a-5a5b188c508b",
                                        "entry_id": "c52be3ee-c734-3b3d-a9f7-b8c0e4cd5be2",
