                        "fausse prophétie"
                    ]
                },
                {
                    "sense_id": "568134bf-7112-3273-b3a7-76942838f092",
                    "sense_definition": "Annonce d'un événement futur faite par conjecture, intuition ou déduction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "prevision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les économistes avaient formulé une sombre <w>prophétie</w> sur l'avenir du marché."
                        },
                        {
                            "text": "La panique générale a transformé cette crainte en une <w>prophétie</w> autoréalisatrice."
                        }
                    ],
                    "synonyms": [
                        "prédiction",
                        "pronostic",
                        "prévision"
                    ],
                    "common_phrases": [
