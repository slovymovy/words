                                                "sense_id": "f04e0abd-b119-338f-9770-964f03d2fa67",
                                                "text": "Although he was unused to the situation, he tried to act naturally."
                                            },
                                            {
                                                "example_id": "1c1bf686-4e67-4719-bace-acb1a29e9d77",
                                                "sense_id": "f04e0abd-b119-338f-9770-964f03d2fa67",
                                                "text": "Ying Ying, a panda at a Hong Kong theme park, has given birth to twins that were conceived naturally, a cause for celebration for conservationists rooting for the survival of this vulnerable and low-libido species."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcfdf839-7b3c-3b32-b864-565a867067c3",
                                        "entry_id": "eba5a0c9-7120-3eda-a9cc-4f8895c42d9d",
                                        "glosses": [
                                            "Inherently or by nature."
