                        "entry_id": "e1264e4e-d6da-36f0-8228-d48dbccc4e0d",
                        "glosses": [
                            "Relatif à la production ou au commerce des draps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66b16563-5d6f-4075-866a-61141513ed91",
                                "sense_id": "26c0f530-9e95-34de-832e-efa1c02e60b7",
                                "text": "Sedan, cette perle de l’industrie drapière, est complètement dévalisée; les Boches n'y ont laissé que 3 % du matériel de 1914 […]."
                            }
                        ]
                    }
