                                        "entry_id": "4008f7b8-4e3a-3f7c-bfc1-c2b6d8d70d19",
                                        "glosses": [
                                            "A foolish woman."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK",
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
