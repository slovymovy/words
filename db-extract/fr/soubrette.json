                                    {
                                        "sense_id": "b8e2653d-2b7a-3359-8b80-64f6f0eb7596",
                                        "entry_id": "3cedf8bc-f5e2-3d0d-8259-93fb645e7890",
                                        "glosses": [
                                            "kleine oder junge Zofe"
                                        ],
                                        "tags": [],
