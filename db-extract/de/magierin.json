                    },
                    {
                        "sense_id": "0cb13ab4-8d48-33dc-8bb2-7c18705cded1",
                        "entry_id": "0db1f7ae-4fa1-3caa-bd2a-d0d9b4806272",
                        "glosses": [
                            "weibliche Person, die Zaubertricks vorführt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d495178-3ef8-41bc-a741-1855cbf6f429",
                                "sense_id": "0cb13ab4-8d48-33dc-8bb2-7c18705cded1",
                                "text": "Die Magierin zauberte ein Kaninchen aus seinem Zylinder hervor."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1a1300c-994d-49eb-aee4-413ffbdf994c",
                        "source_entry_id": "0db1f7ae-4fa1-3caa-bd2a-d0d9b4806272",
                        "source_sense_id": "9a86b5d5-8247-38b3-a3d9-962d2efa57cf",
                        "source_sense_description": "weibliche Person, die vermeintlich übernatürlich Magie beherrscht und anwendet",
                        "target_lang_word": "magician",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magician",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be32a7af-05bf-308f-a589-3d338eb862b4",
                                        "entry_id": "7e277995-1aa9-37fe-8a21-b0244f50f275",
                                        "glosses": [
                                            "A person who plays with or practices allegedly supernatural magic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "edab4312-801b-32c5-944b-3a854383347d",
                                        "entry_id": "7e277995-1aa9-37fe-8a21-b0244f50f275",
                                        "glosses": [
                                            "A spiritualist or practitioner of mystic arts."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef09fe4d-7a1a-4658-83d3-48b930985975",
                                                "sense_id": "edab4312-801b-32c5-944b-3a854383347d",
                                                "text": "The truth is that [Isaac] Newton was very much a product of his time. The colossus of science was not the first king of reason, Keynes wrote after reading Newton’s unpublished manuscripts. Instead “he was the last of the magicians”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34007c1c-fa53-32ff-aa95-7cbacff68428",
                                        "entry_id": "7e277995-1aa9-37fe-8a21-b0244f50f275",
                                        "glosses": [
                                            "A performer of tricks or an escapologist or an illusionist."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9844c99d-7d6e-3600-bdd8-9338a3634fb4",
                                        "entry_id": "7e277995-1aa9-37fe-8a21-b0244f50f275",
                                        "glosses": [
                                            "An amazingly talented craftsman or scientist."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "89277be3-c94c-3600-8ed1-d47e7e3abdef",
                                        "entry_id": "7e277995-1aa9-37fe-8a21-b0244f50f275",
                                        "glosses": [
                                            "A person who astounds; an enigma."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ba64137-5319-43cd-8621-63842728b44b",
                        "source_entry_id": "0db1f7ae-4fa1-3caa-bd2a-d0d9b4806272",
                        "source_sense_id": "9a86b5d5-8247-38b3-a3d9-962d2efa57cf",
                        "source_sense_description": "weibliche Person, die vermeintlich übernatürlich Magie beherrscht und anwendet",
                        "target_lang_word": "magicienne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magicienne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b05ebe95-96a3-317d-9538-b24ac1f11b2b",
                                        "entry_id": "24b57900-395d-3f83-a96f-22fdde76ab02",
                                        "glosses": [
                                            "Celle qui pratique la magie."
                                        ],
                                        "tags": [
                                            "Fantastique",
                                            "Jeux de rôle",
                                            "Jeux de rôle d’action-aventure"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbc32b7d-4bb4-4347-b461-98b474598b74",
                                                "sense_id": "b05ebe95-96a3-317d-9538-b24ac1f11b2b",
                                                "text": "Nous attendions qu’on nous rejoigne, que toutes les femmes du monde laissent tomber leurs éviers ou leur sous-comité, pour leur révéler ce grand secret si bien gardé et à nous transmis par les magiciennes : que le diable est un fort bel homme."
                                            },
                                            {
                                                "example_id": "52ed2584-78c3-4574-9fa3-e6644b162aa6",
                                                "sense_id": "b05ebe95-96a3-317d-9538-b24ac1f11b2b",
                                                "text": "Elle fut l’alchimiste trop savante, la magicienne sans chapeau conoïde, dont les yeux smaragdins et la chair aphrodisiaque opérèrent l’inéluctable transmutation de mes métaux si précieux ! dans son aumonière aux fermoirs d’or."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05685d87-e9c3-363f-855b-3a73e4e51b2a",
                                        "entry_id": "24b57900-395d-3f83-a96f-22fdde76ab02",
                                        "glosses": [
                                            "Illusionniste, prestidigitatrice."
                                        ],
                                        "tags": [
                                            "Prestidigitation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3416a20b-e85d-4d2a-838f-cf94340b75dc",
                                                "sense_id": "05685d87-e9c3-363f-855b-3a73e4e51b2a",
                                                "text": "Caroline Marx n’est pas seulement une jeune femme sympathique connue pour ses talents de magicienne, c’est aussi une artiste complète. Outre ses talents d’illusionniste, elle maîtrise également la danse, le chant, le piano."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de89fb88-535e-370d-9344-b55f740c3f43",
                                        "entry_id": "24b57900-395d-3f83-a96f-22fdde76ab02",
                                        "glosses": [
                                            "Femme qui réalise des prodiges dans son domaine, à tel point qu’elle semble recourir à la magie."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47b6f6dd-8ebf-487f-97e3-bc5e43acbc2b",
                                                "sense_id": "de89fb88-535e-370d-9344-b55f740c3f43",
                                                "text": "Je me réjouis d’être femme : comédienne de tous les rôles, magicienne de tous les charmes."
                                            },
                                            {
                                                "example_id": "d4dd2ca5-8b8d-4fa4-a7bd-138f03b09adb",
                                                "sense_id": "de89fb88-535e-370d-9344-b55f740c3f43",
                                                "text": "Grâce aux magiciennes du standard de Matignon, ils l’appelèrent aussitôt et prirent rendez-vous avec lui pour le lendemain, à 9 heures, au bar du Lutétia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
