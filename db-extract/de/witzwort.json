                ],
                "senses": [
                    {
                        "sense_id": "08402d38-d875-30fd-9631-06fe3b2bb964",
                        "entry_id": "c607861b-d090-38ee-b49c-e8a4359f4124",
                        "glosses": [
                            "Wort, mit dem die angesprochene Sache oder Person ins Witzige gezogen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4a40930-bfdc-4360-8ccf-6130100c1ad9",
                                "sense_id": "08402d38-d875-30fd-9631-06fe3b2bb964",
                                "text": "„Bald wiederum ist das Schlagwort eine Augenblicksschöpfung, eine rednerische Entgleisung, ein Witzwort, ein Spitzname, eine kräftige Verwünschung, eine blendende Phrase, bald eine wohlausgesonnene Losung, ein zündendes Programmwort, eine Parteibezeichnung, ein origineller Titel, eine Herausforderung oder Versprechung.“"
                            },
                            {
                                "example_id": "b5ffe2e4-e374-4841-b2d5-87b187b90fb1",
                                "sense_id": "08402d38-d875-30fd-9631-06fe3b2bb964",
                                "text": "Ladendorf (1906) nennt „Bergfex“ und „Gewohnheitstier“ als Witzworte: „Bergfex, ein volkstümliches Witzwort zur Verspottung moderner (namentlich extravaganter) Touristen…“"
                            },
                            {
                                "example_id": "80abd1a0-9528-473a-9090-bf8333d65c1f",
                                "sense_id": "08402d38-d875-30fd-9631-06fe3b2bb964",
                                "text": "„…alle seine religiöse und seine revolutionäre Inbrunst ergoß sich in ein antikes Versmaß und brach - sich grotesk überschlagend - mit einem spitzen aktuellen Witzwort ab.“"
                            },
                            {
                                "example_id": "a46bc8ef-4316-49bf-ad5a-191f91d527be",
                                "sense_id": "08402d38-d875-30fd-9631-06fe3b2bb964",
                                "text": "„Die Dänen in der Ladentür kamen mit spöttischen Witzworten und grinsten breit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "43e17ec1-09e2-3056-aca3-b479cd1c822e",
                        "entry_id": "c607861b-d090-38ee-b49c-e8a4359f4124",
                        "glosses": [
                            "Ausspruch voller Witz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0121c8dc-4850-49e8-a465-bbefd93782d6",
                                "sense_id": "43e17ec1-09e2-3056-aca3-b479cd1c822e",
                                "text": "Witzwort im Sinne von ‚witzige Bemerkung‘ findet sich noch in Wörterbüchern der Gegenwart."
                            },
                            {
                                "example_id": "17e37541-8ea3-4f61-88ae-997935db9d6f",
                                "sense_id": "43e17ec1-09e2-3056-aca3-b479cd1c822e",
                                "text": "„Es ist ein ständig umlaufendes Witzwort seiner Kompanie, daß der Alte die Absicht haben soll, den Leuten zu befehlen, daß sie ihre Schuhe ausziehen, bevor sie die Kaserne betreten.“"
                            },
                            {
                                "example_id": "03134737-c1e9-4d99-958f-2b98e04dcb9f",
                                "sense_id": "43e17ec1-09e2-3056-aca3-b479cd1c822e",
                                "text": "„Und so zeigt sich, daß oft ein einziges Witzwort die Einstellung einer Stadt, eines Stammes, eines Volkes besser kennzeichnet als lange Geschichten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
