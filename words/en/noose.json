{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d699bd36-b5ed-3356-b31a-6a22ac4105ff",
                    "sense_definition": "An adjustable loop of rope, such as the one placed around the neck in hangings, or the one at the end of a lasso.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cowboy expertly threw the rope, catching the running calf with a tight <w>noose</w>.",
                            "target_lang_translations": {
                                "ru": "Ковбой мастерски метнул верёвку, поймав бегущего телёнка тугой <w>петлёй</w>."
                            }
                        },
                        {
                            "text": "He felt as if he were putting his head in a <w>noose</w> by signing that risky contract.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя так, словно сам лезет головой в <w>петлю</w>, подписывая этот рискованный контракт."
                            }
                        }
                    ],
                    "synonyms": [
                        "loop",
                        "lasso"
                    ],
                    "common_phrases": [
                        "head in a noose",
                        "tighten the noose"
                    ],
                    "target_lang_definitions": {
                        "ru": "Затягивающаяся петля из верёвки (удавка, петля на лассо или виселице)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "петля",
                                "target_lang_sense_clarification": "затягивающаяся верёвочная петля"
                            },
                            {
                                "target_lang_word": "удавка",
                                "target_lang_sense_clarification": "петля для удушения или повешения"
                            },
                            {
                                "target_lang_word": "аркан",
                                "target_lang_sense_clarification": "лассо, затягивающаяся петля для ловли животных"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bf346885-cf2b-3875-81f5-03d445dc85ef",
                    "sense_definition": "To tie or catch in a noose; to entrap or ensnare.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunter managed to <w>noose</w> the wild animal before it could escape into the thick brush.",
                            "target_lang_translations": {
                                "ru": "Охотнику удалось <w>поймать в петлю</w> дикое животное до того, как оно успело скрыться в густом кустарнике."
                            }
                        },
                        {
                            "text": "They attempted to <w>noose</w> the horse, but it was too quick and broke free.",
                            "target_lang_translations": {
                                "ru": "Они попытались <w>заарканить</w> лошадь, но та оказалась слишком быстрой и вырвалась на свободу."
                            }
                        }
                    ],
                    "synonyms": [
                        "ensnare",
                        "entrap",
                        "snare"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ловить или связывать с помощью петли; затягивать петлю; заманивать в ловушку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ловить петлёй",
                                "target_lang_sense_clarification": "захватывать с помощью аркана или силка"
                            },
                            {
                                "target_lang_word": "заарканить",
                                "target_lang_sense_clarification": "поймать с помощью лассо или аркана"
                            },
                            {
                                "target_lang_word": "накинуть петлю",
                                "target_lang_sense_clarification": "зацепить или поймать верёвочной петлёй"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}