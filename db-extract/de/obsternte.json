                    {
                        "sense_id": "fd690c91-dd27-332c-97e1-b8012a5adf49",
                        "entry_id": "376e5341-cf99-367a-8935-ab2e54eff326",
                        "glosses": [
                            "das Ernten von Obst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1866131d-1a78-41cd-98d1-c53649b7da65",
                                "sense_id": "fd690c91-dd27-332c-97e1-b8012a5adf49",
                                "text": "Für die Obsternte werden noch Hilfsarbeiter gesucht."
                            },
                            {
                                "example_id": "9aa05dc4-0889-49f0-8959-0d63d3889087",
                                "sense_id": "fd690c91-dd27-332c-97e1-b8012a5adf49",
                                "text": "„So gab es die Zentral-Einkaufsgesellschaft mit zahlreichen spezialisierten Unterorganisationen; der Kriegsausschuss der deutschen Obstverarbeitungsindustrie etwa sollte dafür sorgen, einen größeren Teil der Obsternte über Monate haltbar zu machen.“"
                            },
                            {
                                "example_id": "a3f7269a-142b-45f3-8b88-01444d9edaea",
                                "sense_id": "fd690c91-dd27-332c-97e1-b8012a5adf49",
                                "text": "„Dort wurden sie im fruchtbaren Stellenbosch Valley von Farmern für die Obst- und Gemüseernte sowie für die Weinlese eingestellt, und auch von den Fabriken, die diese Produkte verarbeiteten und verpackten.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
