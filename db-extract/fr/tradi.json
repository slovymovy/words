                "senses": [
                    {
                        "sense_id": "d99441c4-c458-3341-b284-e014f7e40ebf",
                        "entry_id": "d8a2fc07-b6d2-30c7-84e1-c1912c31af50",
                        "glosses": [
                            "Traditionnel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "903100e6-46f7-4d27-a852-d619396b076d",
                                "sense_id": "d99441c4-c458-3341-b284-e014f7e40ebf",
                                "text": "« Arrêtez de ne regarder que le montant de l'étiquette » dit-il, en invitant à comparer le prix/kilo du plat industriel et celui en rayon « tradi »."
                            },
                            {
                                "example_id": "350c0cef-0992-4f18-bf92-d731f6b01203",
                                "sense_id": "d99441c4-c458-3341-b284-e014f7e40ebf",
                                "text": "Quand il s’agit de résumer la cuisine Bocuse, les proches de Bocuse citent naturellement Paul qui portait au pinacle une cuisine avec « des os et des arêtes », c’est-à-dire goûtue, tradi, pas chichiteuse."
                            },
                            {
                                "example_id": "0f2ba859-aff4-4501-b343-e0cedff1095f",
                                "sense_id": "d99441c4-c458-3341-b284-e014f7e40ebf",
                                "text": "On va manquer de baguettes tradi, chauffe !\nClémence ouvre la chambre de pousse, sort les pâtes. C'est parti."
                            }
                        ]
                    },
                    {
                        "sense_id": "ad49a188-af32-3272-bdfc-e93d53ebfc7b",
                        "entry_id": "d8a2fc07-b6d2-30c7-84e1-c1912c31af50",
                        "glosses": [
                            "Traditionaliste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b729872e-057e-452d-ba00-a2e02e7f596c",
                                "sense_id": "ad49a188-af32-3272-bdfc-e93d53ebfc7b",
                                "text": "Les Hommes interrogés à découvert, de fait, citent tous l’encouragement discret de prêtres « tradis » de Versailles à l’égard de leurs actions."
                            },
                            {
                                "example_id": "e16144be-3fc6-405d-94b7-3348ecc0cef3",
                                "sense_id": "ad49a188-af32-3272-bdfc-e93d53ebfc7b",
                                "text": "Elle-même à l’époque n’était certainement pas grunge, je le voyais plutôt comme une Versaillaise, enfin une Versaillaise modérée, un peu tradi sans être intégriste."
                            }
                        ]
                    }
