                        "entry_id": "02bcddef-d665-389e-a1ca-d45a92947b8a",
                        "glosses": [
                            "Qui a rapport aux polynômes."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "04c09734-9570-3290-b230-4c0f4c752b32",
                        "entry_id": "02bcddef-d665-389e-a1ca-d45a92947b8a",
                        "glosses": [
                            "Qui s’écrit ou se décrit à l’aide d’un polynôme."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "45ea144d-3c8a-47b6-b147-9ff6b39e4826",
                                "sense_id": "04c09734-9570-3290-b230-4c0f4c752b32",
                                "text": "Équation polynomiale."
                            },
                            {
                                "example_id": "c1e063b5-310d-42a9-a10c-7e9ada8b0e23",
                                "sense_id": "04c09734-9570-3290-b230-4c0f4c752b32",
                                "text": "Courbe polynomiale."
                            },
                            {
                                "example_id": "62bd36b0-acd5-4539-8fd2-9d41b9d01f72",
                                "sense_id": "04c09734-9570-3290-b230-4c0f4c752b32",
                                "text": "De manière générale, pour beaucoup de problèmes à résoudre, les algorithmes utilisés ont une complexité polynomiale, c’est-à-dire que les ressources consommées (le temps et la mémoire) augmentent proportionnellement à Nᵃ, où a est un nombre réel."
                            }
                        ]
                    },
                    {
                        "sense_id": "f2d7b98b-d594-3684-8713-277a401183a6",
                        "entry_id": "02bcddef-d665-389e-a1ca-d45a92947b8a",
                        "glosses": [
                            "Dont la complexité est polynomiale en les paramètres considérés."
                        ],
                        "tags": [
                            "Algorithmique"
                        ],
                        "examples": [
                            {
                                "example_id": "9754d3d7-0d65-4c71-84b8-b3c32e4c8301",
                                "sense_id": "f2d7b98b-d594-3684-8713-277a401183a6",
                                "text": "Il s’agit d’un algorithme polynomial."
                            }
                        ]
                    }
                ],
