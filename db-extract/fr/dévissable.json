                        "sense_id": "1efb1f27-4ac3-3728-8ca5-6604e567d216",
                        "entry_id": "375673ce-2978-3d50-ac08-64bf4aee11f1",
                        "glosses": [
                            "Que l’on peut dévisser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "706c175b-66b1-4a40-986b-16b32c0cb72e",
                                "sense_id": "1efb1f27-4ac3-3728-8ca5-6604e567d216",
                                "text": "On verse cette substance dans l’obus par le culot, qui est dévissable ; elle détone sous l’influence d'un détonateur, qui est lui-même muni d’un allumeur."
                            },
                            {
                                "example_id": "78485384-984d-43e2-a29b-86047fd3462e",
                                "sense_id": "1efb1f27-4ac3-3728-8ca5-6604e567d216",
                                "text": "Malgré son image de cousine pauvre, la capsule dévissable est en fait la meilleure option en ce qui concerne la conservation du vin, car elle est neutre, étanche et prévient à coup sûr la contamination au trichloroanisole ou TCA."
                            },
                            {
                                "example_id": "4bb33472-ef6c-424f-bec4-cb3ad252b7a8",
                                "sense_id": "1efb1f27-4ac3-3728-8ca5-6604e567d216",
                                "text": "Dans une démarche responsable, le flacon grand format (150 ml) est rechargeable, grâce à son spray cap dévissable et à la technologie RT-Twist de Techniplast."
                            }
                        ]
                    }
