                ],
                "senses": [
                    {
                        "sense_id": "f656cb35-71b6-3f47-b798-12bcb1754b5f",
                        "entry_id": "5954b860-3b07-3d46-bbcd-e765ce31be5c",
                        "glosses": [
                            "vorrangiges Thema in der Entwicklung von etwas, auf das die Aufmerksamkeit, der Fokus gerichtet werden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59517a54-fea9-4c9a-b32f-eaa0d7e5bd7d",
                                "sense_id": "f656cb35-71b6-3f47-b798-12bcb1754b5f",
                                "text": "„Entwicklungsschwerpunkte waren deshalb vor allem mehr Komfort und mehr Ausstattung bis hin zum mit Leder bezogenen Armaturenbrett - weil man dafür Aufpreise verlangen kann.“"
                            },
                            {
                                "example_id": "602ecfc7-4c02-405a-8608-bd5445d48bea",
                                "sense_id": "f656cb35-71b6-3f47-b798-12bcb1754b5f",
                                "text": "„Die Entwicklungsschwerpunkte der Schule zielen insgesamt sehr stark auf die musikalische, sowie sprachliche Entwicklung ab.“"
                            },
                            {
                                "example_id": "88b3f737-775a-4f08-878c-4714da2578fd",
                                "sense_id": "f656cb35-71b6-3f47-b798-12bcb1754b5f",
                                "text": "„Mit meiner Mentorin besprach ich zu Beginn des Praxissemesters, welche Entwicklungsschwerpunkte ich für mich setzten wollte.“"
                            },
                            {
                                "example_id": "bacc9005-6c5e-4fb0-aea2-8cd4f3764a24",
                                "sense_id": "f656cb35-71b6-3f47-b798-12bcb1754b5f",
                                "text": "„Der Entwicklungsschwerpunkt ist in der Jugend und im frühen Erwachsenenalter, aber der Prozess der Identitätsentwicklung endet nie.“"
                            },
                            {
                                "example_id": "86f1b3b8-5099-4e13-aa63-5fd91c1ab536",
                                "sense_id": "f656cb35-71b6-3f47-b798-12bcb1754b5f",
                                "text": "„Die Entwicklungsschwerpunkte folgen den aktuellen Themen – neue Marktchancen wittert Burmester aber vor allem in der Ausstattung von Luxusautos, und auch begüterte Jachtbesitzer sind im Visier: für sie gibt es seit Herbst eine eigene Produktlinie.“"
                            },
                            {
                                "example_id": "50bb342d-7a85-494c-b63e-adff2898c2ec",
                                "sense_id": "f656cb35-71b6-3f47-b798-12bcb1754b5f",
                                "text": "„In einer solchen Phase der Ungewissheit und der technologischen Instabilität ist es überaus wichtig, Entwicklungsschwerpunkte festzulegen.“"
                            },
                            {
                                "example_id": "16ad784c-816d-4fc8-ac4e-97234d362146",
                                "sense_id": "f656cb35-71b6-3f47-b798-12bcb1754b5f",
                                "text": "„Als Entwicklungsschwerpunkte für den Lamborghini des dritten Jahrtausends nennen die Italiener die Bereiche Antrieb, Energiespeichersysteme, Werkstoffe, Design und Emotionalität.“"
                            },
                            {
                                "example_id": "697ffbd8-2d6d-4573-b9f7-d93bdb3f2349",
                                "sense_id": "f656cb35-71b6-3f47-b798-12bcb1754b5f",
                                "text": "„Entwicklungsschwerpunkte wie die Sanierung der Universität Irchel müssten jetzt angegangen werden, sagte die Sprecherin Claudia Marty Fässler (Adliswil).“"
                            },
                            {
                                "example_id": "07878912-a777-4e41-9071-1fb126382105",
                                "sense_id": "f656cb35-71b6-3f47-b798-12bcb1754b5f",
                                "text": "„Die Unternehmen und ihre Forschungs- und Entwicklungsschwerpunkte sind zu heterogen.“"
                            },
                            {
                                "example_id": "d2011270-0b5f-48d7-918b-d524f9ae0bce",
                                "sense_id": "f656cb35-71b6-3f47-b798-12bcb1754b5f",
                                "text": "„Seidl darf sich durchaus in Einklang sehen mit den Empfehlungen einer kürzlich vorgestellten Expertise zur Energie- und CO₂-Bilanz, die dem Landkreis rät, regionale Entwicklungsschwerpunkte zu setzen und etwa Standorte für Windkraft- und Photovoltaikanlagen auszuweisen.“"
                            },
                            {
                                "example_id": "64e1b70c-19e8-4959-ba12-618f66d36b0b",
                                "sense_id": "f656cb35-71b6-3f47-b798-12bcb1754b5f",
                                "text": "„Für diese Unternehmen ist Künstliche Intelligenz einer der Entwicklungsschwerpunkte für die nächsten Jahre – denn um Fahrzeuge autonom fahren zu lassen, reicht das klassische Programmieren nicht aus.“"
                            },
                            {
                                "example_id": "87dd17ec-62b7-4e92-9ff3-ac7a4551f0cf",
                                "sense_id": "f656cb35-71b6-3f47-b798-12bcb1754b5f",
                                "text": "„Neben den von der Andermatt Swiss Alps AG realisierten Wohnungen und Apartmenthäusern gibt es im Urserntal weitere Entwicklungsschwerpunkte.“"
                            },
                            {
                                "example_id": "4da82237-4e25-4cec-b45d-8b1e03ad8b34",
                                "sense_id": "f656cb35-71b6-3f47-b798-12bcb1754b5f",
                                "text": "„Denn die Entwicklungsschwerpunkte in der Stadt verschieben sich, eine Debatte über die Gestaltung neuer Gebiete wie im Südosten Berlins zwischen Media-Spree und Flughafen Schönefeld sei dringend erforderlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
