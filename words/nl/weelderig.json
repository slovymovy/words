    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f86f9c79-8c32-3a3e-8e81-da70a0c6ff08",
                    "sense_definition": "Gekenmerkt door overvloed, pracht en rijkdom; luxe en vol.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "luxurious",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij woonden in een <w>weelderig</w> ingericht huis in het centrum van de stad.",
                            "target_lang_translations": {
                                "fr": "Ils habitaient une maison meublée avec <w>luxe</w> dans le centre-ville."
                            }
                        },
                        {
                            "text": "Het hotel had een <w>weelderige</w> tuin vol met kleurrijke bloemen en planten.",
                            "target_lang_translations": {
                                "fr": "L'hôtel possédait un jardin <w>luxuriant</w> rempli de fleurs et de plantes colorées."
                            }
                        }
                    ],
                    "synonyms": [
                        "luxueus",
                        "overdadig",
                        "rijk"
                    ],
                    "antonyms": [
                        "sober",
                        "armmoedig"
                    ],
                    "common_phrases": [
                        "weelderige tuin",
                        "weelderige plantengroei"
                    ],
                    "target_lang_definitions": {
                        "fr": "Caractérisé par l'abondance, la magnificence et la richesse ; luxueux et opulent."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "luxueux",
                                "target_lang_sense_clarification": "pour un cadre de vie ou un objet de grand standing"
                            },
                            {
                                "target_lang_word": "opulent",
                                "target_lang_sense_clarification": "qui montre une grande richesse et abondance"
                            },
                            {
                                "target_lang_word": "fastueux",
                                "target_lang_sense_clarification": "qui montre un luxe ostentatoire"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f76b924f-1f82-3116-9654-96f5d6323191",
                    "sense_definition": "Zeer krachtig, vol en overvloedig groeiend.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij trok de aandacht met zijn <w>weelderige</w> bos krullend haar.",
                            "target_lang_translations": {
                                "fr": "Il attirait l'attention avec sa <w>fournie</w> chevelure bouclée."
                            }
                        },
                        {
                            "text": "Na de regen transformeerde het landschap in een <w>weelderige</w> vegetatie.",
                            "target_lang_translations": {
                                "fr": "Après la pluie, le paysage s'est transformé en une végétation <w>luxuriante</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "tierend",
                        "uitbundig"
                    ],
                    "antonyms": [
                        "dor",
                        "kaal"
                    ],
                    "common_phrases": [
                        "weelderige haardos",
                        "weelderige vegetatie"
                    ],
                    "target_lang_definitions": {
                        "fr": "Qui pousse ou croît de manière très forte, dense et abondante."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "luxuriant",
                                "target_lang_sense_clarification": "pour la végétation ou les plantes"
                            },
                            {
                                "target_lang_word": "abondant",
                                "target_lang_sense_clarification": "pour la chevelure ou la pousse"
                            },
                            {
                                "target_lang_word": "fourni",
                                "target_lang_sense_clarification": "très dense, en parlant des cheveux"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "422bb1f0-3229-3965-b777-6093db607bb5",
                    "sense_definition": "Genoeglijk gevuld, met ronde en volle vormen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "body_shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De schilder hield van modellen met een <w>weelderig</w> figuur.",
                            "target_lang_translations": {
                                "fr": "Le peintre aimait les modèles à la silhouette <w>opulente</w>."
                            }
                        },
                        {
                            "text": "De serveerster met haar <w>weelderige</w> vormen bracht het eten naar tafel.",
                            "target_lang_translations": {
                                "fr": "La serveuse aux formes <w>généreuses</w> a apporté le repas à table."
                            }
                        }
                    ],
                    "synonyms": [
                        "wulps",
                        "volslank",
                        "gevuld"
                    ],
                    "antonyms": [
                        "magers",
                        "slank"
                    ],
                    "common_phrases": [
