                "senses": [
                    {
                        "sense_id": "a1cac984-deb7-31e1-bcc7-cc4bdd743852",
                        "entry_id": "e8a3e11a-a546-3300-8ef0-fc9a77899cbf",
                        "glosses": [
                            "рыбол. сильный клёв рыбы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa49da96-a798-4ef3-8722-e1bc4f74e6b3",
                                "sense_id": "a1cac984-deb7-31e1-bcc7-cc4bdd743852",
                                "text": "Главное — попасть на уловистое место, ведь из-за разнообразного рельефа дна рыба держалась небольшими скоплениями, и буквально на соседних лунках мог быть и настоящий жор, и полное бесклевье."
                            }
                        ]
                    },
                    {
                        "sense_id": "bb4acb6d-2082-3c8e-bdb0-efdb4e8478a7",
                        "entry_id": "e8a3e11a-a546-3300-8ef0-fc9a77899cbf",
                        "glosses": [
                            "прост. сильное желание есть у человека"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0310eb4d-3d37-4fbc-97e1-281cfb800dc3",
                                "sense_id": "bb4acb6d-2082-3c8e-bdb0-efdb4e8478a7",
                                "text": "На Илью с перепугу накатил жор, он опустошал одну за другой банки с хозяйской тушёнкой и запивал хозяйской «изабеллой»."
                            }
                        ]
                    }
