                {
                    "sense_id": "4dc70115-0e4e-3b2d-88f3-dac6baf6e608",
                    "sense_definition": "A person native to ancient Rome or its Empire.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person_ancient",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient <w>Latins</w> established laws that still influence us today.",
                            "target_lang_translations": {
                                "ru": "Древние <w>латины</w> установили законы, которые влияют на нас и сегодня.",
                                "zh": "古代<w>罗马人</w>制定的法律至今仍影响着我们。"
                            }
                        },
                        {
                            "text": "Conflict often arose between the <w>Latins</w> and neighboring tribes.",
                            "target_lang_translations": {
                                "ru": "Часто возникали конфликты между <w>латинами</w> и соседними племенами.",
                                "zh": "<w>罗马人</w>与邻近部落之间经常发生冲突。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Roman"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уроженец Древнего Рима или его империи.",
                        "zh": "古罗马或其帝国的原住民。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лати́н",
                                "target_lang_sense_clarification": "историческое название племени"
                            },
                            {
                                "target_lang_word": "ри́млянин",
                                "target_lang_sense_clarification": "житель Рима"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "古罗马人",
                                "target_lang_sense_clarification": "历史称呼"
                            }
                        ]
                    }
                }
            ]
        },
        {
