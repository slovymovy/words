                    "frequency": "Middle",
                    "semantic_group_id": "luminosite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mes yeux ont mis quelques secondes à s'habituer à la <w>pénombre</w> de la chambre."
                        },
                        {
                            "text": "Nous sommes restés un long moment assis dans la <w>pénombre</w> du salon pour discuter calmement."
                        }
                    ],
