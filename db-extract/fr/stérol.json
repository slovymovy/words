                    },
                    {
                        "translation_id": "4ada2a79-8dbc-42ec-a0c8-69e2c4d25f01",
                        "source_entry_id": "e218e7e4-9a47-3899-a0a7-34ada25c412b",
                        "source_sense_id": "c4169a26-7394-3c45-a332-200e2d793450",
