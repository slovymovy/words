{
    "word_family": [
        "élimination",
        "éliminatoire",
        "éliminateur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "36ef9178-7db7-39fe-b954-f4205150c499",
                    "sense_definition": "Faire disparaître, écarter ou supprimer ce qui est inutile, gênant ou indésirable.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "supprimer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut nettoyer soigneusement les fruits pour <w>éliminer</w> tous les résidus de pesticides."
                        },
                        {
                            "text": "Cette nouvelle mesure vise à <w>éliminer</w> les risques d'accident sur le lieu de travail."
                        }
                    ],
                    "common_phrases": [
                        "éliminer les risques",
                        "éliminer les erreurs"
                    ]
                },
                {
                    "sense_id": "9b7338fd-1cbb-3dae-b82c-92e7010b5df1",
                    "sense_definition": "Écarter un participant d'une sélection, d'un examen ou d'une compétition sportive.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ecarter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Notre équipe préférée a été <w>éliminée</w> dès le premier tour du tournoi."
                        },
                        {
                            "text": "Le jury a décidé d'<w>éliminer</w> trois candidats après l'épreuve orale."
                        }
                    ],
                    "common_phrases": [
                        "éliminer un candidat",
                        "être éliminé au premier tour"
                    ]
                },
                {
                    "sense_id": "4dd4fd00-207d-305a-a1cb-12e67f3b2264",
                    "sense_definition": "Expulser des substances ou des déchets hors de l'organisme.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physiologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Boire beaucoup d'eau aide les reins à <w>éliminer</w> plus rapidement les toxines accumulées."
                        },
                        {
                            "text": "Le corps humain <w>élimine</w> naturellement la caféine au bout de quelques heures."
                        }
                    ],
                    "synonyms": [
                        "excréter",
                        "évacuer"
                    ],
                    "common_phrases": [
                        "éliminer les toxines",
                        "éliminer les déchets"
                    ]
                },
                {
                    "sense_id": "8ecb6c79-7f77-3690-afab-63b0b0281cb6",
                    "sense_definition": "Faire mourir de façon violente ; tuer ou assassiner un adversaire ou un témoin.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tuer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le criminel voulait <w>éliminer</w> tous les témoins gênants pour assurer son impunité."
                        },
                        {
                            "text": "Dans ce roman d'espionnage, le dictateur cherche à <w>éliminer</w> ses principaux rivaux politiques."
                        }
                    ],
                    "common_phrases": [
                        "éliminer un témoin",
                        "éliminer un rival"
                    ]
                },
                {
                    "sense_id": "0369292c-63fb-3aba-83e1-cd69e81e6c0c",
                    "sense_definition": "Faire disparaître une inconnue ou une variable dans un système d'équations.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mathematiques",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La méthode consiste à soustraire les deux lignes pour <w>éliminer</w> l'inconnue principale."
                        },
                        {
                            "text": "En combinant astucieusement ces relations, le professeur <w>élimine</w> la variable du calcul."
                        }
                    ],
                    "common_phrases": [
                        "éliminer une variable",
                        "éliminer une inconnue"
                    ]
                }
            ]
        }
    ]
