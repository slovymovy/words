                    {
                        "sense_id": "16364d23-6f81-3cf7-be17-7a2c3b0595f8",
                        "entry_id": "c7a3ae9b-a55e-3191-ae23-bffe93d451ce",
                        "glosses": [
                            "weltweit verbreitetes Insekt aus der Klasse der Gliederfüßer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "303aee62-935a-4f96-9e27-64babc9b4b44",
                                "sense_id": "16364d23-6f81-3cf7-be17-7a2c3b0595f8",
                                "text": "„Von einem riesigen Hundertfüßer gefressen zu werden, ist wirklich nicht die Art, wie ich mir meinen Abgang vorgestellt habe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
