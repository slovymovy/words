                "senses": [
                    {
                        "sense_id": "0ce4ae29-beab-33db-91fc-c0f220245503",
                        "entry_id": "77eb2ecd-9330-39ee-ae8e-314a647dc869",
                        "glosses": [
                            "głowa chanatu, tytuł oznaczający władcę w dawnych krajach Wschodu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61860047-ba7f-4fb3-bf8b-1061b3c41124",
                                "sense_id": "0ce4ae29-beab-33db-91fc-c0f220245503",
                                "text": "Misjonarze i poszukiwacze przygód, tacy jak Marco Polo, mogli bez przeszkód wędrować przez bezkresne państwo chanów."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d81414d-c5d0-4bb1-9153-6aae9b2a92d5",
                        "source_entry_id": "77eb2ecd-9330-39ee-ae8e-314a647dc869",
                        "source_sense_id": "0ce4ae29-beab-33db-91fc-c0f220245503",
                        "target_lang_word": "khan",
