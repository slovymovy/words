                                    {
                                        "sense_id": "2b3e1ec2-d6f2-38bc-ba34-1bee769db287",
                                        "entry_id": "abb64d08-c15c-3e32-98ba-200a3cd732ab",
                                        "glosses": [
                                            "Disjoncteur qui interrompt le courant électrique lorsque la somme algébrique des intensités de ses circuits est supérieure à une intensité prédéfinie, par exemple en cas de fuite de courant vers la terre"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e67f2c2b-8c23-417e-b042-aab7c9ca1b9d",
                                                "sense_id": "2b3e1ec2-d6f2-38bc-ba34-1bee769db287",
                                                "text": "Le courant de défaut recommandé pour un disjoncteur différentiel protégeant un lieu humide est de trente milliampères."
                                            }
                                        ]
                                    }
                                ]
                            }
