                            "trait_type": "archaic",
                            "comment": "This is an archaic interjection."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "用于表达深切悲伤或哀痛的感叹词。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "唉",
                                "target_lang_sense_clarification": "表示悲伤或叹息的感叹词。"
                            }
                        ]
                    }
