                        "source_sense_id": "7e1d0c9e-5e68-3a8a-bfe3-9368d8d686c3",
                        "target_lang_word": "stuffed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stuffed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "548d5b27-6ba1-3ddd-be87-3e17c524e116",
                                        "entry_id": "105e1061-eed8-3a4a-96b0-c04ecc1c5abf",
