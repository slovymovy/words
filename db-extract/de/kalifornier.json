                "senses": [
                    {
                        "sense_id": "5acd05ce-ede8-3e4d-a133-3c455e7e0f9a",
                        "entry_id": "1c679b50-98e8-3ecf-802b-49ee0d5308b7",
                        "glosses": [
                            "Einwohner des US-Bundesstaates Kalifornien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd1bf26a-0238-4cfb-b635-08464aa591ac",
                                "sense_id": "5acd05ce-ede8-3e4d-a133-3c455e7e0f9a",
                                "text": "Die Hälfte aller Kalifornier lebt in Städten."
                            },
                            {
                                "example_id": "5d5d0b29-34c1-47ba-820a-f0d5a88494f6",
                                "sense_id": "5acd05ce-ede8-3e4d-a133-3c455e7e0f9a",
                                "text": "„An diesem Tag flog der Kalifornier Mike Harker, der als Soldat in Deutschland stationiert war, mit einem Hängegleiter von der Zugspitze.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f9ca5ce6-f15d-36fc-8678-66b3cbf80731",
                        "entry_id": "1c679b50-98e8-3ecf-802b-49ee0d5308b7",
                        "glosses": [
                            "mittelgroße Kaninchenrasse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfce5483-9adc-4a74-9f10-663baa426290",
                                "sense_id": "f9ca5ce6-f15d-36fc-8678-66b3cbf80731",
                                "text": "Weiße Neuseeländer und Kalifornier sind weniger bekannte Rassen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
