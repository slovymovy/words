                        "glosses": [
                            "Crâner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c224488c-87c7-4772-a2ce-21751d72c290",
                                "sense_id": "3f9bfd18-facc-3bdb-acb2-682338114c52",
                                "text": "On ne crânouillait pas."
                            },
                            {
                                "example_id": "38261ffd-c177-4151-ab6b-4a325eb9c8bb",
                                "sense_id": "3f9bfd18-facc-3bdb-acb2-682338114c52",
                                "text": "À vingt ans, ce fils de maroquiniers de la rue du temple (Paris, IIIᵉ), crânouille gentiment entre les bancs de la Sorbonne où il retrouve son pote Laurent Habib (futur directeur du groupe Euro RSCG) et les cours de tennis de Deauville."
                            },
                            {
                                "example_id": "b5ada2ec-c879-47bf-8cec-2487100c17d3",
                                "sense_id": "3f9bfd18-facc-3bdb-acb2-682338114c52",
                                "text": "Y’a pas d’âge prédéterminé pour claquer subitement + aide à la relativisation pour les gens de sa génération qui crânouillent et qui se croivent ^([sic]) immortels pour les siècles des siècles (amen)."
                            }
                        ]
                    }
