                    {
                        "translation_id": "ad76c494-bac2-41a6-9df8-3821b74adeb2",
                        "source_entry_id": "568a2629-7709-3068-803b-9be0a8025b87",
                        "source_sense_id": "97734908-e4c6-3717-b34e-8cedced62ee0",
                        "target_lang_word": "Revolte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Revolte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "04bf3127-505c-3471-b608-802d540d6435",
                                        "entry_id": "7db16d9f-8035-3ea1-b39b-5cbfff3ce582",
                                        "glosses": [
                                            "massiver Widerstand gegen bestimmte Zustände, die als unhaltbar betrachtet werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c687f86-1cbe-4254-91be-7b57893f7519",
                                                "sense_id": "04bf3127-505c-3471-b608-802d540d6435",
                                                "text": "In dem Land brach eine offene Revolte aus."
                                            },
                                            {
                                                "example_id": "ff66277a-5ab9-4656-8897-f149ea6cb0f7",
                                                "sense_id": "04bf3127-505c-3471-b608-802d540d6435",
                                                "text": "„Man raunte, dass die Revolte am Tag des heiligen Thomas, also am 21. Dezember, ausbrechen werde.“"
                                            },
                                            {
                                                "example_id": "1ca28218-62ec-4c57-936a-d87a5955b815",
                                                "sense_id": "04bf3127-505c-3471-b608-802d540d6435",
                                                "text": "„Nun eskaliert die Revolte.“"
                                            },
                                            {
                                                "example_id": "f4c5da72-54fd-475a-b96f-e59b6817dd5c",
                                                "sense_id": "04bf3127-505c-3471-b608-802d540d6435",
                                                "text": "„All diese Revolten und kriegerischen Aufstände wurden von den Truppen der Kolonialmächte niedergeschlagen.“"
                                            },
                                            {
                                                "example_id": "f29f74cb-636f-4406-b5b6-000d7f10ce3d",
                                                "sense_id": "04bf3127-505c-3471-b608-802d540d6435",
                                                "text": "„Der Unmut der Bevölkerung wuchs und es kam sowohl in Sizilien als auch in Neapel zu Revolten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c9027429-c417-4e51-b8bf-be2498a237b8",
