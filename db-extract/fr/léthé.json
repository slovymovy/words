        "fr-extract.jsonl": [
            {
                "entry_id": "5e5790c4-d881-3f87-92b2-c51762f48b2d",
                "word": "Léthé",
                "pos": "name",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f7f5dd25-aa3b-43b2-b1a5-87e23a6ab59b",
                        "entry_id": "5e5790c4-d881-3f87-92b2-c51762f48b2d",
                        "tags": [
                            "orthographe ancienne"
                        ],
                        "form": "Léthée"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c8c5cfd5-0727-3820-9c64-cff358ee1803",
                        "entry_id": "5e5790c4-d881-3f87-92b2-c51762f48b2d",
                        "glosses": [
                            "En mythologie grecque, fleuve des Enfers où les ombres des morts allaient boire pour oublier le passé."
                        ],
                        "tags": [
                            "Cours d’eau"
                        ],
                        "examples": [
                            {
                                "example_id": "1ebf8bb9-b1e2-462b-9c06-7d7c1c7c42fd",
                                "sense_id": "c8c5cfd5-0727-3820-9c64-cff358ee1803",
                                "text": "Ces âmes [des champs Élysées, après mille ans] allaient boire de l’eau du Léthé, et demandaient instamment à rentrer dans de nouveaux corps, et à revoir la lumière du jour."
                            },
                            {
                                "example_id": "7cc096ea-2a52-4d03-91fc-486a7b9d6a75",
                                "sense_id": "c8c5cfd5-0727-3820-9c64-cff358ee1803",
                                "text": "Il n’a su réchauffer ce cadavre hébété\nOù coule au lieu de sang l’eau verte du Léthé."
                            }
                        ]
                    },
                    {
                        "sense_id": "67cb2377-d547-39c5-b580-e322fe825453",
                        "entry_id": "5e5790c4-d881-3f87-92b2-c51762f48b2d",
                        "glosses": [
                            "Oubli."
                        ],
                        "tags": [
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "ea119a0f-9cb7-48cd-bf43-8d2a7f5c6e11",
                                "sense_id": "67cb2377-d547-39c5-b580-e322fe825453",
                                "text": "J’ai trop vu, trop senti, trop aimé dans ma vie ;\nJe viens chercher vivant le calme du Léthé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d4af5a07-a4d1-4e6a-8289-411689d1d586",
                        "source_entry_id": "5e5790c4-d881-3f87-92b2-c51762f48b2d",
                        "target_lang_word": "Lethe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lethe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c1967f10-b932-32f3-9a72-48c351507ca9",
                                        "entry_id": "0f0a7e97-9eb3-3d22-9f4f-3a9d4d741f6a",
                                        "glosses": [
                                            "einer der Flüsse in der Unterwelt der griechischen Mythologie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8251eb63-ab10-4b98-bd83-9b5231d071c0",
                                                "sense_id": "c1967f10-b932-32f3-9a72-48c351507ca9",
                                                "text": "„In der griechischen Mythologie ist die Lethe der Fluss des Vergessens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0b18e89-147d-4594-afb0-6635d3d01e19",
                        "source_entry_id": "5e5790c4-d881-3f87-92b2-c51762f48b2d",
                        "target_lang_word": "Lethe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lethe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35ad8b24-3b4e-34b8-98bf-b03f8ac1f835",
                                        "entry_id": "0c4a9e33-443d-3f8f-9b11-732d43b4e1f6",
                                        "glosses": [
                                            "The personification of oblivion, daughter of Eris."
                                        ],
                                        "tags": [
                                            "Greek"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "386b342b-05f7-3964-9146-30e5f4ea3d4f",
                                        "entry_id": "0c4a9e33-443d-3f8f-9b11-732d43b4e1f6",
                                        "glosses": [
                                            "The river which flows through Hades from which the souls of the dead drank so that they would forget their time on Earth."
                                        ],
                                        "tags": [
                                            "Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f578632-6ad4-4aac-a072-ea106f5d87a5",
                                                "sense_id": "386b342b-05f7-3964-9146-30e5f4ea3d4f",
                                                "text": "No wonder these mortal Folks have so many Complaints, […] if they were dead now, and to be settled here for ever, they'd be damn'd before they'd make such a Rout come over—“But care, I suppose, is thirsty; and till they have drench’d themselves with Lethe, there will be no quiet among ’em” however, I’ll e’en to work; and so, friend Æsop, and brother Mercury, good bye to ye."
                                            },
                                            {
                                                "example_id": "6cc209a0-f2a1-47dd-9b39-707a366ed4eb",
                                                "sense_id": "386b342b-05f7-3964-9146-30e5f4ea3d4f",
                                                "text": "My heart aches, and a drowsy numbness pains / My sense, as though of hemlock I had drunk, / Or emptied some dull opiate to the drains / One minute past, and Lethe-wards had sunk:"
                                            },
                                            {
                                                "example_id": "f1e4a488-e269-43f8-9c91-b281250f4f73",
                                                "sense_id": "386b342b-05f7-3964-9146-30e5f4ea3d4f",
                                                "text": "For two-and-twenty years he [Doctor Guillotin], unguillotined, shall hear nothing but guillotine, see nothing but guillotine; then dying, shall through long centuries wander, as it were, a disconsolate ghost, on the wrong side of Styx and Lethe; his name like to outlive Cæsar’s."
                                            },
                                            {
                                                "example_id": "8b417558-7533-43c8-96ad-28ff00408413",
                                                "sense_id": "386b342b-05f7-3964-9146-30e5f4ea3d4f",
                                                "text": "By the grey sea-side, unassuaged, unheard of, / Unbeloved, unseen in the ebb of twilight, / Ghosts of outcast women return lamenting, / Purged not in Lethe,"
                                            },
                                            {
                                                "example_id": "7557ced7-1e8f-42fa-83d6-471f9239e399",
                                                "sense_id": "386b342b-05f7-3964-9146-30e5f4ea3d4f",
                                                "text": "A well-fed man is not driven to drink by the craving that torments the hungry; and the comfortable do not crave for the boon of forgetfulness. Gin is the only Lethe of the miserable."
                                            },
                                            {
                                                "example_id": "17374a3d-9be5-4105-b189-5a8f931e4776",
                                                "sense_id": "386b342b-05f7-3964-9146-30e5f4ea3d4f",
                                                "text": "When we have done penance, and are purified, and have drunk of the fountain of Lethe and bathed in the fountain of Eunoe, the mistress of our soul raises us to the Paradise of Heaven."
                                            },
                                            {
                                                "example_id": "f25725dd-e017-4e10-b5dc-9d13badd77db",
                                                "sense_id": "386b342b-05f7-3964-9146-30e5f4ea3d4f",
                                                "text": "oblivion n.: Lethe. In Greek mythology, Lethe (pronounced LEEthee) is one of the several rivers of Hades. Those who drink from it experience complete forgetfulness. Today it is used to refer to one in an oblivious or forgetful state."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
