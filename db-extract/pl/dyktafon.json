                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8aec25c2-0c74-4df2-9041-8f6c95a482d4",
                        "source_entry_id": "c0359879-6812-3784-8955-93555877e65b",
                        "source_sense_id": "473cf4c3-1ba2-30e8-8ffc-05f542a3ed51",
                        "target_lang_word": "Diktiergerät",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diktiergerät",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cbbd8bd6-4a83-382d-b56a-7f5844df038d",
                                        "entry_id": "8a1ef1fb-bc4e-3d88-a47e-07e102b3a918",
                                        "glosses": [
                                            "Gerät zum Aufsprechen und Abhören von Text"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ac57b66-287a-4a54-8a02-3fcd2ca7d99c",
                                                "sense_id": "cbbd8bd6-4a83-382d-b56a-7f5844df038d",
                                                "text": "Der Bauleiter ging durch den Rohbau und hielt sämtliche Mängel auf seinem Diktiergerät fest."
                                            },
                                            {
                                                "example_id": "b9793e11-6ab1-4c60-a87c-3793f843611c",
                                                "sense_id": "cbbd8bd6-4a83-382d-b56a-7f5844df038d",
                                                "text": "Chef, Ihr Diktiergerät muss defekt sein, auf dem Band ist nur ein Rauschen zu hören!"
                                            },
                                            {
                                                "example_id": "1bcbd725-e2c1-407b-8301-3ad9082eb1e1",
                                                "sense_id": "cbbd8bd6-4a83-382d-b56a-7f5844df038d",
                                                "text": "„Jeder Befund wird außerdem vom Obduzenten auf ein Diktiergerät gesprochen.“"
                                            },
                                            {
                                                "example_id": "a9d96c34-a852-4d04-90ee-ab1853854254",
                                                "sense_id": "cbbd8bd6-4a83-382d-b56a-7f5844df038d",
                                                "text": "„Er horchte nach, ob das Diktiergerät noch lief, musste sichergehen, dass das Geständnis aufgezeichnet wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae44efae-1df2-44c8-93d6-b705e970a4e8",
                        "source_entry_id": "c0359879-6812-3784-8955-93555877e65b",
                        "source_sense_id": "473cf4c3-1ba2-30e8-8ffc-05f542a3ed51",
                        "target_lang_word": "Diktafon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "989760d6-d360-4eee-a38b-3c7657ef071d",
                        "source_entry_id": "c0359879-6812-3784-8955-93555877e65b",
                        "source_sense_id": "473cf4c3-1ba2-30e8-8ffc-05f542a3ed51",
                        "target_lang_word": "диктофон",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "диктофон",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7a95ff5d-1516-3eeb-a083-1e86ae85bd53",
                                        "entry_id": "4c181be9-251c-3641-9113-f5c90266601e",
                                        "glosses": [
                                            "устройство, специально предназначенное для записи речи, и, как правило, портативное"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55c68a12-31cd-4b5a-813a-e1694bd2e164",
                                                "sense_id": "7a95ff5d-1516-3eeb-a083-1e86ae85bd53",
                                                "text": "Кованько и Горошков летали на Фарманах с установленными близ пилотского места диктофонами. При полете диктовали в рупор диктофона. Шум мотора не мешает записи."
                                            },
                                            {
                                                "example_id": "7b620665-53a3-45e3-a3cc-fc989d3909f6",
                                                "sense_id": "7a95ff5d-1516-3eeb-a083-1e86ae85bd53",
                                                "text": "Кайзер произносит пред аппаратом диктофона в своей ставке воинственные речи и «валики» рассылаются по воинским частям."
                                            },
                                            {
                                                "example_id": "7da24f18-c8c1-466e-8dff-0401a4a6f056",
                                                "sense_id": "7a95ff5d-1516-3eeb-a083-1e86ae85bd53",
                                                "text": "Окинув взглядом потертые чехлы фотоаппаратов и миниатюрный диктофон, торчащий из нагрудного кармана, продавец понял, что перед ним не просто один из тысяч туристов, проходящих здесь ежедневно и готовых восхищаться подряд всем увиденным."
                                            },
                                            {
                                                "example_id": "a0c7d836-6fba-4ee2-813e-92c7b7b3ccf0",
                                                "sense_id": "7a95ff5d-1516-3eeb-a083-1e86ae85bd53",
                                                "text": "Оказалось, что он, не полагаясь на собственную память, успел вовремя нажать нужную кнопку, тем самым включив диктофон на мобильном телефоне."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
