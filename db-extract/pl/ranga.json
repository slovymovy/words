                                        "examples": [
                                            {
                                                "example_id": "a8ea6d67-1dbd-41ee-86fa-6d14e4167519",
                                                "sense_id": "b6730257-02c2-3e1a-9170-2becf6356b21",
                                                "text": "Richter des Bundesgerichtshofes haben einen hohen Rang."
                                            },
                                            {
                                                "example_id": "fbaad817-9ee6-4d0d-9066-ba261b1e337c",
                                                "sense_id": "b6730257-02c2-3e1a-9170-2becf6356b21",
                                                "text": "„Fast alle, die im Höhenbergsteigen Rang und Namen haben, sind an der Lhotse-Südwand gescheitert, insgesamt rund ein Dutzend Expeditionen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "50a8fa2a-e1c7-3d85-9048-654476bc5ed8",
                                        "entry_id": "5cd87fd5-b21c-313a-9faa-8c26089f83f6",
                                        "glosses": [
                                            "Platzierung in einem Wettbewerb"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8677fbf3-ba29-418d-87de-939c8414c037",
                                                "sense_id": "50a8fa2a-e1c7-3d85-9048-654476bc5ed8",
                                                "text": "Trotz guter Leistung kam er über einen 10. Rang nicht hinweg."
                                            },
                                            {
                                                "example_id": "8b4eb560-c216-4945-b46a-3a0765566704",
                                                "sense_id": "50a8fa2a-e1c7-3d85-9048-654476bc5ed8",
                                                "text": "„In aktuellen Umfragen liegt er in der Beliebtheit der Berlin-Politiker nur noch auf Rang zehn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ad6f2fd4-ebe9-3180-897c-ed722f1957a6",
                                        "entry_id": "5cd87fd5-b21c-313a-9faa-8c26089f83f6",
                                        "glosses": [
