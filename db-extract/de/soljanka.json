                "senses": [
                    {
                        "sense_id": "f3d8a611-29ee-38a1-8b37-9eb382f9f0a1",
                        "entry_id": "17e63620-3c40-32d8-ae3d-650f59f12fee",
                        "glosses": [
                            "säuerliche Suppe der russischen und ukrainischen Küche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f624618-2656-4ec2-99f6-37923ad460f1",
                                "sense_id": "f3d8a611-29ee-38a1-8b37-9eb382f9f0a1",
                                "text": "Soljanka ist neben Borschtsch wohl die berühmteste russische Suppe."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "172b32f8-c0b9-3067-a7df-5e3a5452bf79",
                        "entry_id": "17e63620-3c40-32d8-ae3d-650f59f12fee",
                        "glosses": [
                            "Tomatensuppe mit Fleisch, Wurst und Sauerkraut als Einlage, die besonders in den ostdeutschen Bundesländern bekannt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c92824dc-36ad-49f3-a845-c5289f092d09",
                                "sense_id": "172b32f8-c0b9-3067-a7df-5e3a5452bf79",
                                "text": "Die Soljanka gehörte zu den beliebtesten Eintöpfen der DDR-Gastronomie."
                            },
                            {
                                "example_id": "5eb28743-67b6-41e2-afdc-d283cb143508",
                                "sense_id": "172b32f8-c0b9-3067-a7df-5e3a5452bf79",
                                "text": "„Aber erst als mein Leitartikler seinen Löffel in die beigefarbene Soljanka tunkte, wurde ihm klar, dass sein Vergleich gewaltig hinkte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
