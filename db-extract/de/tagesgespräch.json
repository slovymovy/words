                        "glosses": [
                            "eine spektakuläre Neuigkeit, über die viele an einem bestimmten Tag sprechen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0e0932b-0446-47f7-a978-b7914b6444cf",
                                "sense_id": "410f7bc9-fb40-31f2-9c0f-4c5b4b2aea4f",
                                "text": "Zurzeit ist das Hochwasser an der Elbe wieder einmal das Tagesgespräch."
                            },
                            {
                                "example_id": "758be00e-356f-49d6-90cd-7336bb1652fd",
                                "sense_id": "410f7bc9-fb40-31f2-9c0f-4c5b4b2aea4f",
                                "text": "„Einen oder zwei Tage später sagte mir Pater Giorgi, das Tagesgespräch in Rom sei die mißlungene Entführung der Tochter des Advokaten Dalacqua; man halte mich für den Anstifter der ganzen Sache, und das mißbillige er sehr.“"
                            }
                        ],
