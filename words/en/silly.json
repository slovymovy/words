                    "sense_definition": "Pious, holy, or good.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "archaic_meanings",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>silly</w> man spent his days in prayer and contemplation.",
                            "target_lang_translations": {
                                "ru": "<w>Блаженный</w> человек проводил свои дни в молитве и созерцании.",
                                "tr": "<w>Mübarek</w> adam günlerini dua ve tefekkürle geçirirdi.",
                                "de": "Der <w>selige</w> Mann verbrachte seine Tage mit Gebet und Kontemplation."
                            }
                        },
                        {
                            "text": "In ancient texts, the term was used to describe <w>silly</w> saints.",
                            "target_lang_translations": {
                                "ru": "В древних текстах этот термин использовался для описания <w>благочестивых</w> святых.",
                                "tr": "Eski metinlerde bu terim, <w>saf</w> azizleri tanımlamak için kullanılırdı.",
