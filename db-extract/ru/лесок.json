                    {
                        "form_id": "725f9062-9d99-4b1c-8276-8a5a62958b31",
                        "entry_id": "6fa177af-bd17-37e4-89c4-0ec9214a56ea",
                        "tags": [
                            "singular",
                            "locative"
                        ],
                        "form": "в леску́"
                    },
                    {
                        "form_id": "b3f26d77-c6e6-4a6d-a6f6-5303215466b7",
                        "entry_id": "6fa177af-bd17-37e4-89c4-0ec9214a56ea",
                        "tags": [
                            "singular"
                        ],
                        "form": "леску́"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "985dcba7-f09e-3081-87e9-3d4fd1da0683",
                        "entry_id": "6fa177af-bd17-37e4-89c4-0ec9214a56ea",
                        "glosses": [
                            "уменьш.-ласк. к лес"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cede3c2-468e-4974-8f2b-903b4e05323f",
                                "sense_id": "985dcba7-f09e-3081-87e9-3d4fd1da0683",
                                "text": "Ты знаешь тот лесок, что за нашею левадою, и, верно, знаешь за тем же лесом широкий луг: в нём двадцать без малого десятин; а травы столько, что можно каждый год продавать больше, чем на сто рублей, особенно, если, как говорят, в Гадяче будет конный полк."
                            },
                            {
                                "example_id": "6057802c-68cd-481c-87fd-7e894e159a3a",
                                "sense_id": "985dcba7-f09e-3081-87e9-3d4fd1da0683",
                                "text": "Анна Васильевна, дай бог ей здоровья, леску мне на домишко изволили пожаловать, да в контору приказ отдать позабыли-с…"
                            },
                            {
                                "example_id": "ce07601c-b746-412f-b524-079ac54f986a",
                                "sense_id": "985dcba7-f09e-3081-87e9-3d4fd1da0683",
                                "text": "За Облепихиным двором, в сторону Земляного вала ― лесок, а в леску хатка Облепихиной сестры, колдовки Фимки."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a23ef95d-112e-458e-94c0-e46f99339ef1",
                        "source_entry_id": "6fa177af-bd17-37e4-89c4-0ec9214a56ea",
                        "source_sense_id": "985dcba7-f09e-3081-87e9-3d4fd1da0683",
                        "target_lang_word": "Wäldchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wäldchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "78d72d80-b9b4-3834-bca0-25bce3ca1dc3",
                                        "entry_id": "4d2fdbd3-1e28-3c64-8583-c4c500bf9cc0",
                                        "glosses": [
                                            "kleiner Wald"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9edc24dd-4070-40a4-b18c-ade49b1abf5e",
                                                "sense_id": "78d72d80-b9b4-3834-bca0-25bce3ca1dc3",
                                                "text": "Er lebt in seinem Landhaus neben einem Wäldchen."
                                            },
                                            {
                                                "example_id": "153baa88-e5eb-4246-9931-ff2d9a932c56",
                                                "sense_id": "78d72d80-b9b4-3834-bca0-25bce3ca1dc3",
                                                "text": "„Der Fußgängerweg vorm Wäldchen führte zu einem Spielplatz, der für Babys war.“"
                                            },
                                            {
                                                "example_id": "452dc002-ee5e-4224-9cc1-d9478f596ce9",
                                                "sense_id": "78d72d80-b9b4-3834-bca0-25bce3ca1dc3",
                                                "text": "„Sie führte mich nach einer Premierenfeier in das Wäldchen, das neben ihrem (unbetretbaren) Studentenheim lag.“"
                                            },
                                            {
                                                "example_id": "c6b4bcec-24e7-4862-8354-5bd711e91d85",
                                                "sense_id": "78d72d80-b9b4-3834-bca0-25bce3ca1dc3",
                                                "text": "„Martin kümmerte sich um die Zugpferde, die sie weiter hinten in einem Wäldchen angepflockt hatten.“"
                                            },
                                            {
                                                "example_id": "b1e14731-7acb-4e8d-85dd-4cbaaee5e7e0",
                                                "sense_id": "78d72d80-b9b4-3834-bca0-25bce3ca1dc3",
                                                "text": "„Vor dem Mietshaus führt ein Feldweg in Richtung eines kleinen Wäldchens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "194e9949-7d52-4e8b-aaab-a3642be8fff7",
                        "source_entry_id": "6fa177af-bd17-37e4-89c4-0ec9214a56ea",
                        "source_sense_id": "985dcba7-f09e-3081-87e9-3d4fd1da0683",
                        "target_lang_word": "Gehölz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gehölz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "678508f9-016d-3126-b4e4-2db7f621c4f6",
                                        "entry_id": "233673b8-6e57-3a07-a1f6-7c40f6f5b389",
                                        "glosses": [
                                            "kleiner Wald, (meist schwacher) Baumbestand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97cad35c-d79b-45ab-b887-0d9b9958bcef",
                                                "sense_id": "678508f9-016d-3126-b4e4-2db7f621c4f6",
                                                "text": "Am Rande des Dorfes steht ein kleines Gehölz."
                                            },
                                            {
                                                "example_id": "8c13c28b-e43d-4fae-bd22-a0dd9867eb9c",
                                                "sense_id": "678508f9-016d-3126-b4e4-2db7f621c4f6",
                                                "text": "Die Treiber und Hunde kämpften sich mühsam durch das dichte Gehölz."
                                            },
                                            {
                                                "example_id": "ea2d5ddd-933e-49bf-9dab-83fefc88dcb9",
                                                "sense_id": "678508f9-016d-3126-b4e4-2db7f621c4f6",
                                                "text": "Die Rehe sind in das Gehölz verschwunden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a80a6a1c-cb9c-3249-b594-d81b766eba2b",
                                        "entry_id": "233673b8-6e57-3a07-a1f6-7c40f6f5b389",
                                        "glosses": [
                                            "allgemein für verholzende Pflanzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62fd296a-bf88-4877-9792-5c97d1e762d6",
                                                "sense_id": "a80a6a1c-cb9c-3249-b594-d81b766eba2b",
                                                "text": "Viele strauchartige Gewächse bezeichnet man als Gehölz."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08814470-8ee2-4a80-bf42-9b18a11f41f7",
                        "source_entry_id": "6fa177af-bd17-37e4-89c4-0ec9214a56ea",
                        "source_sense_id": "985dcba7-f09e-3081-87e9-3d4fd1da0683",
                        "target_lang_word": "Hain",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hain",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d032bc97-1fde-3f66-a3d6-506b22b8df52",
                                        "entry_id": "5e443c85-8bf3-358b-8295-5b242d7d0516",
                                        "glosses": [
                                            "kleiner lichter Wald (der häufig wie ein Park besonders gepflegt wird oder der Verehrung einer Gottheit dient)"
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55fb04bc-4288-47f6-b692-a242af63ab15",
                                                "sense_id": "d032bc97-1fde-3f66-a3d6-506b22b8df52",
                                                "text": "„Moderne Forscher halten den Hain für ein natürliches Erosionsprodukt, Spuren menschlicher Bearbeitung konnten nirgendwo nachgewiesen werden.“"
                                            },
                                            {
                                                "example_id": "4f5563c7-df70-4e7a-9323-f134d0bfa37e",
                                                "sense_id": "d032bc97-1fde-3f66-a3d6-506b22b8df52",
                                                "text": "„Hier sträubt sich kein Pförtner,",
                                                "translation": "Sind allen gemein.“"
                                            },
                                            {
                                                "example_id": "fa986135-0b98-4f3d-8da3-3fd650a2ba08",
                                                "sense_id": "d032bc97-1fde-3f66-a3d6-506b22b8df52",
                                                "text": "„Ein heilig Dunkel füllet den ernsten Hain:",
                                                "translation": "Dass nicht die Jungfraun des Haines zürnen!“"
                                            },
                                            {
                                                "example_id": "9e4bda61-28d5-4970-9855-51c661662114",
                                                "sense_id": "d032bc97-1fde-3f66-a3d6-506b22b8df52",
                                                "text": "„Wer du, o Jüngling! auch seist, noch Fremdling im Hain Afroditens,",
                                                "translation": "Amor, im Tempel versteckt, füllt mit Verlangen den Hain.“"
                                            },
                                            {
                                                "example_id": "aa06b59d-da7d-48dc-a891-1176f01a0bee",
                                                "sense_id": "d032bc97-1fde-3f66-a3d6-506b22b8df52",
                                                "text": "„Es ist die Quelle Egeria im heiligen Hain der Diana.“"
                                            },
                                            {
                                                "example_id": "b6682baf-c89e-4858-9a4c-6a4f8f94724d",
                                                "sense_id": "d032bc97-1fde-3f66-a3d6-506b22b8df52",
                                                "text": "„Auf dunklem Irrweg in finstern Hainen",
                                                "translation": "Es dämmerte — es wurde hell!“"
                                            },
                                            {
                                                "example_id": "9a5cd850-abc6-4ee0-91fe-1b055f7a2cc3",
                                                "sense_id": "d032bc97-1fde-3f66-a3d6-506b22b8df52",
                                                "text": "„Horch, der Hain erschallt von Liedern,",
                                                "translation": "Für ein glücklich liebend Paar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Hain",
                                "target_lang_code": "de",
