                "senses": [
                    {
                        "sense_id": "10480b1a-3310-322f-b473-47d55328d7f4",
                        "entry_id": "840189bd-5810-39d2-ba72-b86b751c2395",
                        "glosses": [
                            "Archäologie: Grab, in dem ein (vermuteter) Fürst bestattet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dad6481b-2e43-4c00-9355-de118847e751",
                                "sense_id": "10480b1a-3310-322f-b473-47d55328d7f4",
                                "text": "„Da viele Gräber bereits im Altertum wegen ihrer reichen Beigaben geplündert und zerstört wurden, ist eine vollständig erhaltene Grabanlage, wie z.B. das Fürstengrab von Hochdorf bei Ludwigsburg in Baden-Württemberg, eine wahre archäologische Sensation.“"
                            },
                            {
                                "example_id": "559d8d9b-a0f3-4f52-ab2b-42e98f6e82a0",
                                "sense_id": "10480b1a-3310-322f-b473-47d55328d7f4",
                                "text": "„Im Umfeld trifft man heute noch auf Großgrabhügel, sogenannte Fürstengräber.“"
                            },
                            {
                                "example_id": "b2275ff0-dc5f-4d4c-a358-6572507047e3",
                                "sense_id": "10480b1a-3310-322f-b473-47d55328d7f4",
                                "text": "„1994 wurden die sogenannten Fürstengräber ausgehoben, eine Arbeit, die drei Jahre dauerte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
