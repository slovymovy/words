                "senses": [
                    {
                        "sense_id": "30cd9ad9-3e44-3f49-99af-c077c9968da9",
                        "entry_id": "865f38e1-54cb-31e5-a01c-114efe3b29d2",
                        "glosses": [
                            "Qui est coiffé ; qui est surmonté."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "cedea834-af47-4910-9a2d-b7978c14a5cb",
                                "sense_id": "30cd9ad9-3e44-3f49-99af-c077c9968da9",
                                "text": "L’entrée était d’ailleurs réduite à deux piliers sommés de petits lions de pierre, poncés par le temps qui leur avait fait des museaux de moutons."
                            },
                            {
                                "example_id": "e2e74cf6-e892-41e5-8165-9a23d4680eab",
                                "sense_id": "30cd9ad9-3e44-3f49-99af-c077c9968da9",
                                "text": "Et toujours la masse colossale du Kilimandjaro, sommé de ses neiges, veillait sur les espaces brûlants et sauvages."
                            },
                            {
                                "example_id": "e470461a-8770-46d7-b04f-e169f6c3378f",
                                "sense_id": "30cd9ad9-3e44-3f49-99af-c077c9968da9",
                                "text": "La montagne de Locronan (F.) étant, elle, sommée d’un temple, peut-être inclus parmi les étapes d’un rite processionnaire indigène,"
                            }
                        ]
                    },
                    {
                        "sense_id": "9b94d9eb-4cfb-3331-b969-969dd8c0eef4",
                        "entry_id": "865f38e1-54cb-31e5-a01c-114efe3b29d2",
                        "glosses": [
                            "Qui est surmonté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc198ca8-6494-41e0-9b5e-d7e32ac27363",
                                "sense_id": "9b94d9eb-4cfb-3331-b969-969dd8c0eef4",
                                "text": "Les armes d’Arcueil-Cachan se composent de deux écussons accolés […] Les deux écussons accolés par la pointe et sommés d’une couronne murale de cinq tours."
                            }
                        ]
                    }
                ],
