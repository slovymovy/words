                                        "glosses": [
                                            "Prénom français."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0e02095-8b06-446e-9466-a6756ba371b1",
                                                "sense_id": "56e210ca-cf8c-3052-86d1-4908576d83d3",
                                                "text": "Teddy Thomas, Quentin Lespiaucq, Georges-Henri Colombe Reazel et Thierry Paiva, eux, étaient encore présents au milieu de leurs nouveaux coéquipiers."
                                            },
                                            {
                                                "example_id": "9d7b765b-1336-4156-b13f-120728b702c4",
                                                "sense_id": "56e210ca-cf8c-3052-86d1-4908576d83d3",
                                                "text": "À Plymouth, où se déroule le 3ᵉ acte du circuit Sail GP, les Français, emmenés par le Vannetais Quentin Delapierre, ont bien démarré la première journée."
                                            }
                                        ]
