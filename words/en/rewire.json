{
    "word_family": [
        "wire",
        "wiring",
        "wiretap",
        "wireless"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e5a5bbeb-afaa-3353-bede-d94aaf44fce5",
                    "sense_definition": "To replace or reconnect electrical wires in a building, system, or piece of equipment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wiring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The electrician said that we need to <w>rewire</w> the entire house.",
                            "target_lang_translations": {
                                "ru": "Электрик сказал, что нам нужно <w>полностью заменить проводку</w> во всем доме."
                            }
                        },
                        {
                            "text": "I had to <w>rewire</w> the old lamp because the cord was frayed.",
                            "target_lang_translations": {
                                "ru": "Мне пришлось <w>заменить провод</w> в старой лампе, так как шнур перетерся."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rewire a house",
                        "rewire the system"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заменять или заново подключать электропроводку в здании, системе или приборе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заменить проводку",
                                "target_lang_sense_clarification": "полная замена проводов"
                            },
                            {
                                "target_lang_word": "перемонтировать проводку",
                                "target_lang_sense_clarification": "монтаж заново"
                            },
                            {
                                "target_lang_word": "переподключить",
                                "target_lang_sense_clarification": "подключить провода по-новому"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7983f92-ceb3-3e9c-949b-3e9956594817",
                    "sense_definition": "To fundamentally change the functioning, habits, or logic of a system, process, or the brain.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "alteration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Therapy can help you <w>rewire</w> your brain to handle stress more effectively.",
                            "target_lang_translations": {
                                "ru": "Терапия может помочь <w>перестроить</w> работу вашего мозга, чтобы эффективнее справляться со стрессом."
                            }
                        },
                        {
                            "text": "The engineers had to <w>rewire</w> the software architecture to improve overall performance.",
                            "target_lang_translations": {
                                "ru": "Инженерам пришлось <w>перестроить</w> архитектуру программного обеспечения, чтобы повысить общую производительность."
                            }
                        }
                    ],
                    "synonyms": [
                        "reconfigure",
                        "reprogram"
                    ],
                    "common_phrases": [
                        "rewire the brain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Коренным образом изменять функционирование, привычки или логику системы, процесса или мозга."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перестроить",
                                "target_lang_sense_clarification": "изменить структуру или паттерны"
                            },
                            {
                                "target_lang_word": "перепрограммировать",
                                "target_lang_sense_clarification": "изменить логику или реакции"
                            },
                            {
                                "target_lang_word": "перенастроить",
                                "target_lang_sense_clarification": "настроить на другой лад"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b80624e1-4daa-3f8a-906b-03099dd0093c",
                    "sense_definition": "The act or process of replacing or repairing the electrical wiring in a building or device.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "wiring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "An old property like this will probably require a complete <w>rewire</w> before moving in.",
                            "target_lang_translations": {
                                "ru": "В таком старом доме перед заселением, скорее всего, потребуется полная <w>замена проводки</w>."
                            }
                        },
                        {
                            "text": "The cost of the electrical <w>rewire</w> was much higher than we expected.",
                            "target_lang_translations": {
                                "ru": "Стоимость <w>замены электропроводки</w> оказалась намного выше, чем мы ожидали."
                            }
                        }
                    ],
                    "common_phrases": [
                        "complete rewire",
                        "electrical rewire"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс замены либо ремонта электропроводки в здании или устройстве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замена проводки",
                                "target_lang_sense_clarification": "электромонтажные работы"
                            },
                            {
                                "target_lang_word": "переразводка",
                                "target_lang_sense_clarification": "прокладка кабелей заново"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}