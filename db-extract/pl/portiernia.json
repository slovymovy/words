                                "target_senses": [
                                    {
                                        "sense_id": "c8eb9a28-9fee-3ecd-8cb0-4afc9d84d4fe",
                                        "entry_id": "bdb06ff0-f4b4-3663-9874-9ef0a8ab7902",
                                        "glosses": [
                                            "Charge de concierge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1478e4a-8ea1-4e65-be17-06c0c64b0880",
                                                "sense_id": "c8eb9a28-9fee-3ecd-8cb0-4afc9d84d4fe",
                                                "text": "Il a la conciergerie, on lui a donné la conciergerie de tel château, etc."
                                            },
                                            {
                                                "example_id": "29ae806e-e502-4fa2-989c-419d439c49cc",
                                                "sense_id": "c8eb9a28-9fee-3ecd-8cb0-4afc9d84d4fe",
                                                "text": "Là, derrière un vitrage, était assis un concierge, ou plutôt un officier de conciergerie, car il portait une tunique à boutons dorés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b64d904-3b5a-3a97-9a7f-06773fd05349",
                                        "entry_id": "bdb06ff0-f4b4-3663-9874-9ef0a8ab7902",
                                        "glosses": [
                                            "Demeure et le logement d’un concierge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f59c188-73e7-4bf3-809c-2be5ef3824ad",
                                                "sense_id": "5b64d904-3b5a-3a97-9a7f-06773fd05349",
                                                "text": "La conciergerie de Fontainebleau."
                                            },
                                            {
                                                "example_id": "1f0ef0dc-91fc-40dc-9ebe-1fb40a1d1133",
                                                "sense_id": "5b64d904-3b5a-3a97-9a7f-06773fd05349",
                                                "text": "Décidément, entre les portes d’entrée codées, les locataires et la conciergerie, cet endroit est digne d’une forteresse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77c045d8-ceb5-3b94-b96c-559af1ef7a5f",
                                        "entry_id": "bdb06ff0-f4b4-3663-9874-9ef0a8ab7902",
                                        "glosses": [
                                            "Prison où les parlements tenaient leurs prisonniers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7365d907-b1e7-41c7-988b-31d2561c6542",
                                                "sense_id": "77c045d8-ceb5-3b94-b96c-559af1ef7a5f",
                                                "text": "Il fut mené à la conciergerie."
                                            },
                                            {
                                                "example_id": "937c7c24-99d3-4548-9a6e-ae54d608849e",
                                                "sense_id": "77c045d8-ceb5-3b94-b96c-559af1ef7a5f",
                                                "text": "La conciergerie de Paris."
                                            }
                                        ]
                                    }
                                ]
