                "senses": [
                    {
                        "sense_id": "39acff18-54cc-3d30-919f-b57cd02c6f2b",
                        "entry_id": "d018b3a0-9229-3cf7-8b67-e12ceeadd5d9",
                        "glosses": [
                            "Donner un caractère europhile à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a364253c-2be9-4911-898e-f6c032cccd28",
                                "sense_id": "39acff18-54cc-3d30-919f-b57cd02c6f2b",
                                "text": "on nous europhilise"
                            },
                            {
                                "example_id": "4e233c7f-48bc-447f-8f01-06dd51ed056d",
                                "sense_id": "39acff18-54cc-3d30-919f-b57cd02c6f2b",
                                "text": "Quant à Fini, malgré son passé néo-fasciste, il a évolué, s'est centrisé, libéralisé, et europhilisé."
                            },
                            {
                                "example_id": "bc9a9c81-90ef-455f-87ef-64d8851076aa",
                                "sense_id": "39acff18-54cc-3d30-919f-b57cd02c6f2b",
                                "text": "En conséquence pour « s'europhiliser » un peu elle a tenu cette semaine un meeting à la maison des associations de Gujan sur l’avenir du football club du bassin d’Arcachon ; comme si sur le sujet il y avait matière à disserter."
                            }
                        ]
                    }
