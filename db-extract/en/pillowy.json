                                                "sense_id": "3c2e769e-9102-3bfa-95e4-195d168e6a98",
                                                "text": "Weiches Wasser eignet sich gut zum Waschen."
                                            },
                                            {
                                                "example_id": "98951c03-fe1a-45e2-ab7b-ce3cd19f78b1",
                                                "sense_id": "3c2e769e-9102-3bfa-95e4-195d168e6a98",
                                                "text": "„Die Dosierung ist von der Wasserhärte abhängig. Weiches Wasser erfordert die geringste Waschmittelmenge.“"
                                            },
                                            {
                                                "example_id": "127c52ba-79b6-4440-ab52-bf69906a0582",
                                                "sense_id": "3c2e769e-9102-3bfa-95e4-195d168e6a98",
                                                "text": "„Im Harz ist das Leitungswasser eher weich, im Teutoburger Wald eher hart.“"
                                            }
