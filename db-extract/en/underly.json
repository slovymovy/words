                    {
                        "sense_id": "f2f3fc01-cee6-325d-aec4-6b974ea9f333",
                        "entry_id": "0788622f-c251-3d2b-8e07-0e8bd267d211",
                        "glosses": [
                            "At a lower level."
                        ],
                        "tags": [
                            "obsolete",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "d95fdd8f-2fa2-4419-a7e5-6488110f54e0",
                                "sense_id": "f2f3fc01-cee6-325d-aec4-6b974ea9f333",
                                "text": "The Seed-Branch […] is presently divided into two main Branches, and those two into other less; whereof some underly, others aloft, run along the Coat."
                            }
                        ]
                    },
                    {
                        "sense_id": "417c5eff-70b4-3ed4-afcd-282a1e015258",
                        "entry_id": "0788622f-c251-3d2b-8e07-0e8bd267d211",
                        "glosses": [
                            "In an inferior or inadequate manner; insufficiently (chiefly in opposition to overly)."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "3f8212dd-3698-446c-8926-84af4d3e04d9",
                                "sense_id": "417c5eff-70b4-3ed4-afcd-282a1e015258",
                                "text": "In this case, we are not in a position—at least from the perspective of the rules themselves and the values that lie behind them—to say that they are overly or underly inclusive."
                            },
                            {
                                "example_id": "103413ea-06ef-4ee3-be26-7c6cceb80548",
                                "sense_id": "417c5eff-70b4-3ed4-afcd-282a1e015258",
                                "text": "Overly madeup and underly dressed young women were dancing in a cluster on the floor."
                            },
                            {
                                "example_id": "3fde6c73-6799-4e4d-b84b-0d6d53dc93d1",
                                "sense_id": "417c5eff-70b4-3ed4-afcd-282a1e015258",
                                "text": "Better to struggle claustrophobically from the grasp of an overly adoring parent than to fall serially in love with emotionally cruel or distant partners, which is what everyone with underly adoring parents always does."
                            }
                        ]
                    }
                ],
