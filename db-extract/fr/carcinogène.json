                        "source_sense_id": "59814c54-0098-370b-8ab0-b8c884dde707",
                        "source_sense_description": "Substance qui peut provoquer un cancer.",
                        "target_lang_word": "Karzinogen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Karzinogen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9a2f16f6-b577-3fcf-8c08-b108aa98c65a",
                                        "entry_id": "c2a791a8-66e1-32a1-94fa-4bb9229cc159",
                                        "glosses": [
                                            "etwas, das Krebs verursachen kann (krebserregende Substanzen, Organismen, Strahlungen)"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c92a1790-8ce6-432b-bba2-af062f41a421",
                                                "sense_id": "9a2f16f6-b577-3fcf-8c08-b108aa98c65a",
                                                "text": "„Eine Virushepatitis vom Typ Hepatitis B und Hepatitis C gilt als ein Karzinogen für das hepatozelluläre Karzinom.“"
                                            }
