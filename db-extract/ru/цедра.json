                    {
                        "translation_id": "92ff3d19-20c7-4a92-bfaa-6889a3ba1d2f",
                        "source_entry_id": "72cce933-1233-3148-84ba-49355485004d",
                        "source_sense_id": "a24927f6-5b9c-382b-9a0f-2d68b3d7f18f",
                        "target_lang_word": "zeste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zeste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f2816d1c-7ecb-3a48-8d5b-1b66ea353bb7",
                                        "entry_id": "fa67c77b-b4bb-3125-b0a2-ef29a23e15b5",
                                        "glosses": [
                                            "Partie mince et colorée qu’on coupe sur le dessus de l’écorce des agrumes (orange, citron, cédrat, etc…)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0eef69f-a26b-4442-a566-8c9ff2de4acc",
                                                "sense_id": "f2816d1c-7ecb-3a48-8d5b-1b66ea353bb7",
                                                "text": "Chébran, le tiramisu végan de Nabil Barina, champion du monde du tiramisu sacré à Lyon, avec son Verde à la crème végétale, compotée de pommes cuites en deux façons, pétales de main de Bouddha, zeste de citron vert et café vert !"
                                            },
                                            {
                                                "example_id": "eae641c5-9d10-472f-8550-dae0ab7f97c4",
                                                "sense_id": "f2816d1c-7ecb-3a48-8d5b-1b66ea353bb7",
                                                "text": "Dans un grand bol ou un saladier, mélangez la passata de tomates avec l’huile d’olive, une 1/2 c. à café de sel de mer, l’ail haché, le piment, les lentilles égouttées, la courge râpée, les olives hachées, les câpres et le zeste de citron."
                                            },
                                            {
                                                "example_id": "e6497d19-e8d7-4ec9-931f-66f09af9731c",
                                                "sense_id": "f2816d1c-7ecb-3a48-8d5b-1b66ea353bb7",
                                                "text": "Prélevez le zeste du citron, ainsi que son jus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d4638e3-044c-3ba7-9ff0-6db3aa6580ac",
                                        "entry_id": "fa67c77b-b4bb-3125-b0a2-ef29a23e15b5",
                                        "glosses": [
                                            "Cloison membraneuse qui divise en quatre l’intérieur d’une noix."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7c15c0c-4a5a-4d9d-8de1-fa504485d4f7",
                                                "sense_id": "5d4638e3-044c-3ba7-9ff0-6db3aa6580ac",
                                                "text": "Le zeste d’une noix."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8036f3ff-27cf-3383-bc6e-fe1fb4c964d6",
                                        "entry_id": "fa67c77b-b4bb-3125-b0a2-ef29a23e15b5",
                                        "glosses": [
                                            "Petite quantité de quelque chose."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41a4bbd2-77e6-4b54-8091-21bfe826c2d8",
                                                "sense_id": "8036f3ff-27cf-3383-bc6e-fe1fb4c964d6",
                                                "text": "Vous y trouverez de la passion, un zeste de fantaisie et beaucoup de tendresse."
                                            },
                                            {
                                                "example_id": "c305a60f-0b53-4838-8257-afb518b30677",
                                                "sense_id": "8036f3ff-27cf-3383-bc6e-fe1fb4c964d6",
                                                "text": "Tu m’en mets juste un zeste, s’il te plait."
                                            },
                                            {
                                                "example_id": "178a26e8-a9d9-4f9c-8aed-808d8ecf7608",
                                                "sense_id": "8036f3ff-27cf-3383-bc6e-fe1fb4c964d6",
                                                "text": "Zeste d’humour."
                                            },
                                            {
                                                "example_id": "c5aed805-41f2-4501-b603-0cc731748443",
                                                "sense_id": "8036f3ff-27cf-3383-bc6e-fe1fb4c964d6",
                                                "text": "Zeste d’ironie. Les cinquante titres récupèrent et déroutent, avec un zeste d’ironie et, parfois, avec un léger effet captieux, le lexique sur la pandémie de COVID-19, le vocabulaire et les syntagmes titrés dans les journaux."
                                            },
                                            {
                                                "example_id": "0d9d640a-65d4-443b-9a0b-a90ac2ab7be3",
                                                "sense_id": "8036f3ff-27cf-3383-bc6e-fe1fb4c964d6",
                                                "text": "En 1988 KV Mechelen avait un zeste d'orange dans le vestiaire et sur le terrain: Graeme Rutjes, Erwin Koeman, Aad de Mos, Piet den Boer et Wim Hofkens."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "zeste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c4090513-088d-3e8b-871f-12b7d174327c",
                                        "entry_id": "b8681eff-2b53-3508-844e-80a46f3135ef",
                                        "glosses": [
                                            "Exprime la rapidité ou la soudaineté d’une action."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
