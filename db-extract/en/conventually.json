                            {
                                "example_id": "6cf5d91b-ef83-4ec8-b8ab-fb0c0322e929",
                                "sense_id": "742b1040-30e6-3efd-9c84-b0927d12ddd1",
                                "text": "They possessed one-half of the English sees in so far as there was attached to the cathedral a monastery whose monks served the cathedral, and formed, conventually, the Chapter which had the right of election."
                            },
                            {
                                "example_id": "957b35d3-229d-40bb-b89d-a9c7fd631544",
                                "sense_id": "742b1040-30e6-3efd-9c84-b0927d12ddd1",
                                "text": "Andrew Skinner of Yorkshire, 'a Devote and Oblate of our Order', lived conventually for many years at the monastery in Dieulouard, Lorraine, before returning to England to live with his brother and to die in 1672."
                            }
                        ]
                    }
