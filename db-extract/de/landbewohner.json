                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "36006cae-1d94-392f-a354-1341e3b31eb2",
                                        "entry_id": "4b56e460-2cca-37bf-91b9-bbbab41af19e",
