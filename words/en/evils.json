{
    "word_family": [
        "evil",
        "evilly",
        "evilness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d76927ac-f78f-38ce-b9e1-e1578d00ff26",
                    "sense_definition": "Plural of <w>evil</w>: harmful things, wicked actions, or profound moral wrongs.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "harm_or_wickedness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher wrote extensively about the various <w>evils</w> that plague modern society.",
                            "target_lang_translations": {
                                "zh": "这位哲学家广泛探讨了困扰现代社会的种种<w>弊端</w>。"
                            }
                        },
                        {
                            "text": "When choosing between two <w>evils</w>, it is best to choose neither if possible.",
                            "target_lang_translations": {
                                "zh": "在两<w>害</w>之间做选择时，如果可能的话，最好两者都不选。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wrongs",
                        "vices",
                        "sins"
                    ],
                    "antonyms": [
                        "goods",
                        "virtues"
                    ],
                    "common_phrases": [
                        "lesser of two evils",
                        "social evils"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural form"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "evil 的复数形式：罪恶、祸害或有害之事。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "罪恶",
                                "target_lang_sense_clarification": "道德或法律上的邪恶行径"
                            },
                            {
                                "target_lang_word": "弊端",
                                "target_lang_sense_clarification": "社会、制度等带来的危害与害处"
                            },
                            {
                                "target_lang_word": "祸害",
                                "target_lang_sense_clarification": "引起灾祸的事物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ffb41848-a305-3ca7-8807-2680a67d7fd9",
                    "sense_definition": "A hostile, malicious, or glaring look directed at someone; the evil eye.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "glare",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop giving me <w>evils</w> just because I disagreed with your proposal.",
                            "target_lang_translations": {
                                "zh": "别仅仅因为我不同意你的提议就对我翻<w>白眼</w>。"
                            }
                        },
                        {
                            "text": "She threw him dirty looks and <w>evils</w> across the crowded room all night.",
                            "target_lang_translations": {
                                "zh": "整个晚上，她都在拥挤的人群中朝他投去厌恶的神色和<w>恶狠狠的眼神</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "glare",
                        "stink-eye",
                        "dirty look"
                    ],
                    "common_phrases": [
                        "giving someone evils"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal British slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（英国俚语）充满敌意、恶意或愤怒的怒视、白眼。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "白眼",
                                "target_lang_sense_clarification": "表示嫌恶或愤怒的目光"
                            },
                            {
                                "target_lang_word": "怒视",
                                "target_lang_sense_clarification": "愤怒凶狠的眼神"
                            },
                            {
                                "target_lang_word": "恶狠狠的眼神",
                                "target_lang_sense_clarification": "充满恶意的目光"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}