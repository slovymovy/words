                ],
                "senses": [
                    {
                        "sense_id": "90b5bb54-f7b7-3dbd-9529-986107a9ef6a",
                        "entry_id": "3894a2cd-c13e-3ff4-859a-eef59f9212ed",
                        "glosses": [
                            "устар., рег. стая птиц"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a4cc694-016e-4ec0-8bf4-c11a3997be6d",
                                "sense_id": "90b5bb54-f7b7-3dbd-9529-986107a9ef6a",
                                "text": "Звери ― всегда порознь, даже когда в сплоченных стаях, кулигах, косяках и табунах."
                            }
                        ]
                    },
                    {
                        "sense_id": "fe5772e9-9f06-3a83-bb2a-5c242006e3db",
                        "entry_id": "3894a2cd-c13e-3ff4-859a-eef59f9212ed",
                        "glosses": [
                            "зоол. скопление личинок саранчовых"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33f060ed-c9f8-4e98-a0a0-8ca967125ade",
                                "sense_id": "fe5772e9-9f06-3a83-bb2a-5c242006e3db",
                                "text": "Количество насекомых в кулиге определялось путем обмера площади, занятой кулигой, и учёта средней плотности насекомых на единице площади."
                            }
                        ]
                    }
