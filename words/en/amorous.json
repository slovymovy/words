    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a35469e2-6793-3775-948f-8cbc9ec05699",
                    "sense_definition": "Relating to or produced by love.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "love_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wrote an <w>amorous</w> poem for her partner.",
                            "target_lang_translations": {
                                "zh": "她为伴侣写了一首<w>多情的</w>诗。",
                                "cs": "Napsala svému partnerovi <w>milostnou</w> báseň."
                            }
                        },
                        {
                            "text": "The singer performed an <w>amorous</w> ballad that touched everyone in the room.",
                            "target_lang_translations": {
                                "zh": "歌手演唱了一首<w>多情的</w>民谣，打动了在场的每一个人。",
                                "cs": "Zpěvák předvedl <w>milostnou</w> baladu, která dojala všechny v místnosti."
                            }
                        }
                    ],
                    "synonyms": [
                        "loving",
                        "affectionate"
                    ],
                    "common_phrases": [
                        "amorous poem",
                        "amorous song"
                    ],
                    "target_lang_definitions": {
                        "zh": "与爱情有关的或由爱情产生的。",
                        "cs": "Vztahující se k lásce nebo jí vyvolaný."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "多情的",
                                "target_lang_sense_clarification": "形容充满感情或与爱情相关的"
                            },
                            {
                                "target_lang_word": "爱情的",
                                "target_lang_sense_clarification": "指代与爱情主题相关的"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "milostný",
                                "target_lang_sense_clarification": "týkající se intimní nebo partnerské lásky"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46bb435d-9ca5-3d7a-ab32-2207a2e08c26",
                    "sense_definition": "Inclined to love or sexual desire.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "love_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They were both feeling <w>amorous</w> after the romantic dinner.",
                            "target_lang_translations": {
                                "zh": "浪漫的晚餐后，他们都感到<w>动情</w>了。",
                                "cs": "Po romantické večeři se oba cítili <w>zamilovaně</w>."
                            }
                        },
                        {
                            "text": "He had an <w>amorous</w> disposition and often fell in love quickly.",
                            "target_lang_translations": {
                                "zh": "他天生<w>多情</w>，常常很快就坠入爱河。",
                                "cs": "Měl <w>zamilovanou</w> povahu a často se rychle zamiloval."
                            }
                        }
                    ],
                    "synonyms": [
                        "fond",
                        "affectionate"
                    ],
                    "common_phrases": [
                        "feeling amorous"
                    ],
                    "target_lang_definitions": {
                        "zh": "倾向于爱情或性欲的。",
                        "cs": "Mající sklon k lásce nebo sexuální touze."
                    },
                    "translations": {
                        "zh": [
                            {
