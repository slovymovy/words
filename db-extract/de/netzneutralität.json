        "de-extract.jsonl": [
            {
                "entry_id": "ccd44dc9-3343-3cc6-ae9d-a465af20b1ac",
                "word": "Netzneutralität",
                "pos": "noun",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "97bdd325-e8dc-4915-8dfb-e31debfad82f",
                        "entry_id": "ccd44dc9-3343-3cc6-ae9d-a465af20b1ac",
                        "tags": [
