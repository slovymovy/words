                    {
                        "sense_id": "c48b7fae-99d0-3b25-aa6d-2215a1a96716",
                        "entry_id": "cf634881-eecf-37df-b95b-20b024126d59",
                        "glosses": [
                            "A cartridge that is handloaded."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7f7d0e9-a0c1-457f-974a-b9eeff810a3c",
                                "sense_id": "c48b7fae-99d0-3b25-aa6d-2215a1a96716",
                                "text": "Factory pressures on these items don't run over 46,000 but your handloads undoubtedly would, and the old action design seems to me a poor bet. If you want to build a 6 mm. single-shot, I'd suggest a Winchester high wall, or the action made by Wilbur Hauck of West Arlington, Vermont. —W.P."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
