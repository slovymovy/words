                ],
                "senses": [
                    {
                        "sense_id": "29f3ca75-e910-3e56-8306-b6008613a8b5",
                        "entry_id": "017c494e-7a02-3720-b2f7-d21ee578e66a",
                        "glosses": [
                            "A legal principle usually expressed in Latin, traditionally used to concisely express a wider legal concept or rule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2985fb5a-6c44-46c3-bad5-ca7e641e0988",
                                "sense_id": "29f3ca75-e910-3e56-8306-b6008613a8b5",
                                "text": "The other question was as to the proper legal meaning of the brocard, “heres heredis mei est heres meus.”"
                            },
                            {
                                "example_id": "ff279fdb-c1ea-4e2b-b5bc-728f2d2f8f87",
                                "sense_id": "29f3ca75-e910-3e56-8306-b6008613a8b5",
                                "text": "Blackstone, with a like tenderness of conscience, endeavors to withdraw a single case, a sale of provisions, from the old brocard caveat emptor, and tells us that in such a contract there is a warranty that the provisions are wholesome."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d74fac8-a7e8-4235-8364-7fee8b0d71e2",
                        "source_entry_id": "017c494e-7a02-3720-b2f7-d21ee578e66a",
                        "source_sense_id": "29f3ca75-e910-3e56-8306-b6008613a8b5",
                        "source_sense_description": "A legal principle usually expressed in Latin",
                        "target_lang_word": "brocard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brocard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5a08530e-8cc8-3160-b184-646d3970eeaf",
                                        "entry_id": "70887472-dc97-3fc7-aadb-5509481a5ee5",
                                        "glosses": [
                                            "Parole de moquerie, raillerie piquante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87fb7e5a-d9ee-4749-8973-0f4102da4222",
                                                "sense_id": "5a08530e-8cc8-3160-b184-646d3970eeaf",
                                                "text": "Lancer des brocards."
                                            },
                                            {
                                                "example_id": "5c00d04d-a432-47bd-8bf6-7fbd8185ec99",
                                                "sense_id": "5a08530e-8cc8-3160-b184-646d3970eeaf",
                                                "text": "Essuyer des brocards."
                                            },
                                            {
                                                "example_id": "a3634e2f-f254-4809-8a1c-acdc6558ed7c",
                                                "sense_id": "5a08530e-8cc8-3160-b184-646d3970eeaf",
                                                "text": "Votre honneur m’est cher, et je ne puis souffrir\nQu’aux brocards d’un chacun vous alliez vous offrir."
                                            },
                                            {
                                                "example_id": "d304eeb3-d50b-4514-8cdb-697327452793",
                                                "sense_id": "5a08530e-8cc8-3160-b184-646d3970eeaf",
                                                "text": "Zerbine, rayonnant d’une joie mystérieuse et contenue, acceptait de bonne humeur les brocards de ses camarades sur la puissance de ses charmes."
                                            },
                                            {
                                                "example_id": "7f944b0b-4239-4349-95d8-49af84657c5f",
                                                "sense_id": "5a08530e-8cc8-3160-b184-646d3970eeaf",
                                                "text": "Nous nous battîmes un jour en plein village, sur la place, pour un brocard dont je le poursuivais."
                                            },
                                            {
                                                "example_id": "d8684ccb-6424-48d7-bf50-820389b927eb",
                                                "sense_id": "5a08530e-8cc8-3160-b184-646d3970eeaf",
                                                "text": "Elle ne parle pas ce langage, bien sûr ! Oserait-elle troquer le doux roucoulement méridional contre cette brocaille sèche, ce brocard de pierrailles qu’on jurerait de l’allemand ? Ah ! pécheresse !"
                                            },
                                            {
                                                "example_id": "0ca6e04c-0876-424b-a85a-27616f731c31",
                                                "sense_id": "5a08530e-8cc8-3160-b184-646d3970eeaf",
                                                "text": "Quand on tend l’oreille, spécialement la nuit, dans les maisons de Léandra, on les entend discuter sans arrêt, se rabaisser le caquet, se renvoyer brocards, pouffements, petits rires ironiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3b051d2-b0bb-34fc-9d5c-7341d5d0d421",
                                        "entry_id": "70887472-dc97-3fc7-aadb-5509481a5ee5",
                                        "glosses": [
                                            "Adage, maxime juridique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
