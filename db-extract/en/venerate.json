                                                "example_id": "f5f3049c-0b58-45d1-960c-440852371454",
                                                "sense_id": "35b1a178-a51a-3779-8582-fc0450c89b0e",
                                                "text": "Nick himmelt seine neue Klassenkameradin geradezu an."
                                            },
                                            {
                                                "example_id": "a134e530-105f-4b6a-880a-13fbedac09c7",
                                                "sense_id": "35b1a178-a51a-3779-8582-fc0450c89b0e",
