                        ],
                        "zh": [
                            {
                                "target_lang_word": "爱尔兰人",
                                "target_lang_sense_clarification": "名词，指代民族"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f875f1b0-6e73-352d-86cd-d7d997fe6968",
                    "sense_definition": "A surname originating as an ethnonym.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "group_name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Irish</w> will see you in his office now.",
