        "nl-extract.jsonl": [
            {
                "entry_id": "843d390c-3e6c-3a8a-b5d2-534ba8a28f05",
                "word": "inzoomen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "39074cf1-6570-31a8-b002-68687a51262a",
                        "entry_id": "843d390c-3e6c-3a8a-b5d2-534ba8a28f05",
                        "glosses": [
                            "met filmen en fotograferen een beeld dichterbij halen door te werken met een lens die een langere brandpuntsafstand heeft"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ecec52ea-5bb8-4330-82a7-b4eb0ef61aed",
                                "sense_id": "39074cf1-6570-31a8-b002-68687a51262a",
                                "text": "De kwaliteit is sinds de eerste gemeentecamera in 1998 in Slotervaart enorm toegenomen: van zwart-wit en drie beelden per seconde naar kleur, 360 graden draaibaar en 30 beelden per seconde (geen vertraging). Om een idee te geven: de camera die op de Dam hangt, kan tot het station inzoomen - dan nog zijn de beelden scherp."
                            }
                        ]
                    },
                    {
                        "sense_id": "fffbbd03-7e51-384b-9f67-2636b7bd13ce",
                        "entry_id": "843d390c-3e6c-3a8a-b5d2-534ba8a28f05",
                        "glosses": [
                            "iets nauwkeuriger in meer detail bekijken"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "58f127ca-c893-42fb-8891-89df0345950d",
                                "sense_id": "fffbbd03-7e51-384b-9f67-2636b7bd13ce",
                                "text": "Er was iets naars gebeurd in Velp. Mijn bejaarde moeder deed op de haar kenmerkende manier verslag. Eerst oeverloos inzoomen op totaal niet terzake doende details waardoor het lang onduidelijk bleef wat er was gebeurd. „Het is verschrikkelijk, de Hoofdstraat is afgezet. Mevrouw Sprengers is een van de gewonden.”"
                            },
                            {
                                "example_id": "138aa56e-0b8d-4b2f-944a-f0a534c4d5f4",
                                "sense_id": "fffbbd03-7e51-384b-9f67-2636b7bd13ce",
                                "text": "'We zijn in oorlog - en de vijand woont in Washington.' Madonna opperde eerder al eens dat het Witte Huis met Donald Trump erin best opgeblazen mag worden. De Amerikaanse president vindt, op zijn beurt, de megaster een toonbeeld van slechte smaak. Laten we straks inzoomen op dat laatste."
                            }
                        ]
                    },
                    {
                        "sense_id": "16d34096-66c3-3d4b-b42e-d9b481f264f1",
                        "entry_id": "843d390c-3e6c-3a8a-b5d2-534ba8a28f05",
                        "glosses": [
                            "door het maken van een zoom korter maken"
                        ],
                        "tags": [],
                        "examples": []
                    }
