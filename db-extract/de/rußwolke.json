                            {
                                "example_id": "38d8806f-a8b7-4ede-995b-61a284e0a56a",
                                "sense_id": "ef7ce4cc-be2c-3ca5-be6f-57ae16fe3d2b",
                                "text": "„Holz war tatsächlich etwas, das sie bitter nötig hatten: Der tiefe Kamin war kalt und leer, und eine Rußwolke tanzte in dem eiskalten Wind, der den Schlot herabwehte.“"
                            },
                            {
                                "example_id": "ac1e2fe6-7813-4428-bb1e-0de6df4705b8",
                                "sense_id": "ef7ce4cc-be2c-3ca5-be6f-57ae16fe3d2b",
                                "text": "„Er fuhr mit seinem Pick-up fort und hinterließ eine Rußwolke.“"
                            }
                        ],
