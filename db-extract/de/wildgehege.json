                        "glosses": [
                            "umzäuntes Gelände oder Bereich, in dem Wildtiere gehalten werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52f77bf4-cd0c-4af9-9dec-978012d545cc",
                                "sense_id": "dc3722cb-8386-31ef-97a5-a1f177653978",
                                "text": "„Ich sah ihnen nach, wie sie durch das Spalier der Pechfackeln schritten und Richtung Wildgehege verschwanden.“"
                            },
                            {
                                "example_id": "52374c63-9527-47fb-8a94-b0481be7ae2e",
                                "sense_id": "dc3722cb-8386-31ef-97a5-a1f177653978",
                                "text": "„Er erhielt seinen Namen nach den Wildgehegen, die einer der Burggrafen vor Dürers Zeit im Stadtgraben unterhalten hatte.“"
                            }
                        ],
