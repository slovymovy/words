                "senses": [
                    {
                        "sense_id": "39f72950-25c4-359b-9ee5-5f759b90c28a",
                        "entry_id": "33413c38-f4a8-3d5d-b72e-af9e5574f342",
                        "glosses": [
                            "semantische Beziehung zwischen Wörtern, bei denen eines, das Hyponym, dem anderen (dem Hyperonym) untergeordnet ist, weil es eine speziellere Bedeutung hat"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "93d0ed21-ac9b-49a3-a623-5246cb9dc8d8",
                                "sense_id": "39f72950-25c4-359b-9ee5-5f759b90c28a",
                                "text": "Zwischen den Wörtern Tanne und Baum besteht die Bedeutungsbeziehung der Hyponymie, da \"Tanne\" eine besondere Art von \"Baum\" ist."
                            },
                            {
                                "example_id": "f0224f25-5b2f-404f-911f-71a5df290b26",
                                "sense_id": "39f72950-25c4-359b-9ee5-5f759b90c28a",
                                "text": "„Zu den paradigmatischen Angaben gehören unter anderen Synonymie, Antonymie, Hyponymie, Hyperonymie, Komplenymie und Meronymie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
