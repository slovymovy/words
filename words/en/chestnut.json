                                "target_lang_sense_clarification": "идиома"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "老掉牙的笑话",
                                "target_lang_sense_clarification": "陈旧的笑话"
                            },
                            {
                                "target_lang_word": "陈词滥调",
                                "target_lang_sense_clarification": "陈旧的话题"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f6b59ac-faea-3871-9ccf-95eb6c9ae3bc",
                    "sense_definition": "A horse with a reddish-brown coat and no black points.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "animal_horse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jockey mounted the spirited <w>chestnut</w> before the race began.",
                            "target_lang_translations": {
                                "ru": "Жокей сел на горячего <w>рыжего коня</w> перед началом скачек.",
                                "zh": "比赛开始前，骑师骑上了那匹精神抖擞的<w>栗色马</w>。"
                            }
                        },
                        {
                            "text": "My neighbor owns a beautiful <w>chestnut</w> that he rides on weekends.",
                            "target_lang_translations": {
                                "ru": "У моего соседа есть красивая <w>рыжая лошадь</w>, на которой он катается по выходным.",
                                "zh": "我的邻居有一匹漂亮的<w>栗色马</w>，他周末常骑。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лошадь с рыжей шерстью и гривой того же цвета или светлее (без черного).",
                        "zh": "一种毛色为红褐色且没有黑色斑点的马。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ры́жая ло́шадь",
                                "target_lang_sense_clarification": "масть лошади"
                            },
                            {
                                "target_lang_word": "рыжа́к",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "栗色马",
                                "target_lang_sense_clarification": "马的毛色"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d27daefe-7b79-303e-8286-58a62b8d3fa4",
                    "sense_definition": "The wood obtained from a chestnut tree, used in building and furniture.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dining table was made of solid <w>chestnut</w> and looked very sturdy.",
                            "target_lang_translations": {
                                "ru": "Обеденный стол был сделан из цельного <w>каштана</w> и выглядел очень прочным.",
                                "zh": "餐桌是用实心<w>栗木</w>做的，看起来非常结实。"
                            }
                        },
                        {
                            "text": "Builders often use <w>chestnut</w> for fencing because it resists rot.",
                            "target_lang_translations": {
                                "ru": "Строители часто используют <w>каштан</w> для ограждений, так как он устойчив к гниению.",
                                "zh": "建筑商经常使用<w>栗木</w>做围栏，因为它耐腐烂。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Древесина каштанового дерева, используемая в строительстве и для изготовления мебели.",
                        "zh": "从栗树上获取的木材，用于建筑和家具制作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кашта́н",
                                "target_lang_sense_clarification": "материал"
                            },
                            {
                                "target_lang_word": "древеси́на кашта́на",
                                "target_lang_sense_clarification": "материал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "栗木",
                                "target_lang_sense_clarification": "木材"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd16f896-4c56-3874-acfd-da9fc79d7297",
                    "sense_definition": "A hard, rough patch of skin found on the inner leg of a horse.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The groom checked the <w>chestnut</w> on the horse's leg during grooming.",
                            "target_lang_translations": {
                                "ru": "Конюх осмотрел <w>каштан</w> на ноге лошади во время чистки.",
                                "zh": "马夫在梳理马匹时检查了它腿上的<w>附蝉</w>。"
                            }
                        },
                        {
                            "text": "Each horse has a unique <w>chestnut</w> that can sometimes be used for identification.",
                            "target_lang_translations": {
                                "ru": "У каждой лошади уникальный <w>каштан</w>, который иногда можно использовать для идентификации.",
                                "zh": "每匹马都有独特的<w>附蝉</w>，有时可用于身份识别。"
                            }
                        }
                    ],
                    "synonyms": [
                        "night eye"
                    ],
                    "target_lang_definitions": {
                        "ru": "Роговое образование (участок грубой кожи) на внутренней стороне ноги лошади.",
                        "zh": "马腿内侧的一块坚硬、粗糙的皮肤组织。"
                    },
                    "translations": {
                        "ru": [
