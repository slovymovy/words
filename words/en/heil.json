                            },
                            {
                                "target_lang_word": "кричать «хайль»",
                                "target_lang_sense_clarification": "выкрикивать нацистское приветствие"
                            },
                            {
                                "target_lang_word": "салютовать по-нацистски",
                                "target_lang_sense_clarification": "отдавать нацистское приветствие"
                            }
                        ]
                    }
                }
            ]
        },
