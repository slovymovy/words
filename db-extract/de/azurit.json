                                "target_senses": [
                                    {
                                        "sense_id": "1eadd1b1-8a5b-3045-8840-eed090581543",
                                        "entry_id": "9e8f98f8-327a-3990-b13a-cfe95b5288d7",
                                        "glosses": [
                                            "Minéral de couleur bleue composé à l’état naturel de carbonate de cuivre, de formule Cu₃(CO₃)₂(OH)₂, et servant de minerai de cuivre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2face427-b997-4ff0-a062-c1a907d2b0c4",
                                                "sense_id": "1eadd1b1-8a5b-3045-8840-eed090581543",
                                                "text": "Le bleu intense caractéristique de l’azurite se retrouve dans la majeure partie des tableaux des siècles passés. Réduits en poudre très fine et mélangés à des liants appropriés, les minéraux d’azurite étaient transformés en précieux pigments picturaux."
                                            },
                                            {
                                                "example_id": "117eb2c1-bc89-448d-a6bc-b11f8f8aa58e",
                                                "sense_id": "1eadd1b1-8a5b-3045-8840-eed090581543",
                                                "text": "L’azurite peut être utilisée, comme la malachite comme pigment."
                                            },
                                            {
                                                "example_id": "aa9cb854-221d-407d-a364-45fb5eb74455",
                                                "sense_id": "1eadd1b1-8a5b-3045-8840-eed090581543",
                                                "text": "Dans la collection Guyonneau, sont remarquables les azurites et les tourmalines, dont une énorme en forme de cristal."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
