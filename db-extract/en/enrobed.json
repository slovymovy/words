        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "08587830-5b40-3e1d-ac89-98fe707f19d7",
                "word": "enrobed",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4da0b97d-bc8f-4541-8885-022d61b85b0d",
                        "entry_id": "08587830-5b40-3e1d-ac89-98fe707f19d7",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more enrobed"
                    },
                    {
                        "form_id": "dce34ca0-50cc-461f-90f1-caac05b5564d",
                        "entry_id": "08587830-5b40-3e1d-ac89-98fe707f19d7",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most enrobed"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bd35bf48-ab23-336f-b49d-b8cce3449319",
                        "entry_id": "08587830-5b40-3e1d-ac89-98fe707f19d7",
                        "glosses": [
                            "Wearing a robe or robes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da82182e-d778-4eef-9950-936b8ad51ff2",
                                "sense_id": "bd35bf48-ab23-336f-b49d-b8cce3449319",
                                "text": "Enrobed monks were playing pool out in the street and men squatted along the shop fronts, picking their teeth and gazing vacantly at the gloomy bottle- filled stores across the road."
                            },
                            {
                                "example_id": "cbe601a8-a44f-4e86-bdeb-a55e31f3594a",
                                "sense_id": "bd35bf48-ab23-336f-b49d-b8cce3449319",
                                "text": "The enrobed figures held each others' arms high as they took a step toward the fire, their voices rising as if riding the crackling flames up to the sky, then released each other and stepped back."
                            },
                            {
                                "example_id": "fbc4ad49-7f51-4bc0-8598-eb2c61cf9da8",
                                "sense_id": "bd35bf48-ab23-336f-b49d-b8cce3449319",
                                "text": "Although certain rules have been modified over time (Western monks are not required, for instance, to squat while urinating, the traditional Indian way), most enrobed men and women still follow all 227."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea61335c-9919-3a1a-832e-3234c690cead",
                        "entry_id": "08587830-5b40-3e1d-ac89-98fe707f19d7",
                        "glosses": [
                            "Having been sprayed with liquid chocolate until covered."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "061a4a42-c270-4b08-ba19-779d02e6f3ed",
                                "sense_id": "ea61335c-9919-3a1a-832e-3234c690cead",
                                "text": "Chocolate cookies and enrobed candy bars have a lot of things in them besides chocolate ."
                            },
                            {
                                "example_id": "83f2b675-0f93-4fb2-bd19-617987b50012",
                                "sense_id": "ea61335c-9919-3a1a-832e-3234c690cead",
                                "text": "With enrobed products, an after-freezer to rapidly set the chocolate or coating is normally used."
                            },
                            {
                                "example_id": "05cacc89-6bab-4ee7-8d00-babf6d74efb4",
                                "sense_id": "ea61335c-9919-3a1a-832e-3234c690cead",
                                "text": "Enrobed or dipped chocolate products need up to 20 min of cooling the norm for enrobed cakes is 12-15 min."
                            }
                        ]
                    },
                    {
                        "sense_id": "e36637a6-9822-30c1-8db5-223f0aa1cb22",
                        "entry_id": "08587830-5b40-3e1d-ac89-98fe707f19d7",
                        "glosses": [
                            "Made less astringent by combination with other flavors so as to produce a smoother, more rounded mouthfeel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cde22cdf-79ba-43e4-b692-327b721ed8de",
                                "sense_id": "e36637a6-9822-30c1-8db5-223f0aa1cb22",
                                "text": "In 2007, said Mortet, the tannins are more enrobed; grape sugars were lower (he told me he chaptalized his wines between a half and a full degree) but the skins were dark and ripe and could support more extraction."
                            },
                            {
                                "example_id": "30c9f58b-0843-4ac5-9b42-e32a08e80015",
                                "sense_id": "e36637a6-9822-30c1-8db5-223f0aa1cb22",
                                "text": "The wine seemed too tannic at the beginning, but now the tannins are more enrobed."
                            },
                            {
                                "example_id": "b7b4cc9b-fd3b-487d-936d-eff20b404e7b",
                                "sense_id": "e36637a6-9822-30c1-8db5-223f0aa1cb22",
                                "text": "This starts with the village Vosne-Romanée, which incorporates such climates as Bossières, just below the village, and the well-known Clos de Réas; the wine forms a perfect Vosne snapshot of silken fruit, truffle, forest, and enrobed tannins."
                            }
                        ]
                    }
                ],
