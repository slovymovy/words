                                ]
                            },
                            {
                                "target_word": "fundamental",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cccca04c-a9fc-3847-8926-7f1be8f03732",
                                        "entry_id": "39c497f3-b1b0-3039-ad2f-80251923d753",
                                        "glosses": [
                                            "Related to a foundation, base, or basis; serving as a foundation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6e48d8c2-9d81-329d-826e-bc3c78c6c7a1",
                                        "entry_id": "39c497f3-b1b0-3039-ad2f-80251923d753",
                                        "glosses": [
                                            "Essential; extremely important."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe47154e-6233-494d-8fb7-e9fb4aba62a4",
                                                "sense_id": "6e48d8c2-9d81-329d-826e-bc3c78c6c7a1",
                                                "text": "a fundamental truth; a fundamental axiom; a fundamental element; fundamental principle; fundamental law"
                                            },
                                            {
                                                "example_id": "94dec000-3a86-4ac6-afb2-73fae710cc9b",
                                                "sense_id": "6e48d8c2-9d81-329d-826e-bc3c78c6c7a1",
                                                "text": "A need for belonging seems fundamental to humans."
                                            },
                                            {
                                                "example_id": "f54cd28b-37cf-4bda-b9c2-d279ce9ed9c0",
                                                "sense_id": "6e48d8c2-9d81-329d-826e-bc3c78c6c7a1",
                                                "text": "Seeing the British establishment struggle with the financial sector is like watching an alcoholic […]. Until 2008 there was denial over what finance had become. […] But the scandals kept coming, […]. A broad section of the political class now recognises the need for change but remains unable to see the necessity of a fundamental overhaul. Instead it offers fixes and patches."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3be056a0-7320-4c01-9188-d08b1fd40c36",
                        "source_entry_id": "2301cde0-63db-3ca1-ba82-d30fcc28d0eb",
                        "source_sense_id": "4fa07444-1711-3d51-8062-b388907f900e",
                        "source_sense_description": "aan de basis staande",
                        "target_lang_word": "fondamental",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fondamental",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "49fc16b3-5cca-37fc-b557-264edb9f955b",
                                        "entry_id": "6de7616d-88c9-3a78-ae4b-7e862577ba25",
                                        "glosses": [
                                            "Ce qui précède le commencement, l'origine de toute chose, qui est au fondement de."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec5f03f6-e434-48e1-96b4-62cf33e27594",
                                                "sense_id": "49fc16b3-5cca-37fc-b557-264edb9f955b",
                                                "text": "Je me souviens d'avoir lu autrefois, dans un manuel de Paul Bert, que le principe fondamental de la morale s'appuie sur les enseigne­ments de Zoroastre et sur la Constitution de l'an III."
                                            },
                                            {
                                                "example_id": "302ae74c-3809-4c90-9e02-922e66c597a0",
                                                "sense_id": "49fc16b3-5cca-37fc-b557-264edb9f955b",
                                                "text": "Théorème fondamental de l'algèbre ; Théorème fondamental de l'analyse (ici en un sens historique)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0e89bc0-f6f4-3896-be00-2c988f9fabbe",
                                        "entry_id": "6de7616d-88c9-3a78-ae4b-7e862577ba25",
                                        "glosses": [
                                            "Qui sert de fondement à un édifice, à une construction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf35484d-8dd1-4574-adad-fc401e1ac8ac",
                                                "sense_id": "a0e89bc0-f6f4-3896-be00-2c988f9fabbe",
                                                "text": "La jeunesse regarde fixement l’avenir avec son œil d’aigle, y trace un large plan, y jette une pierre fondamentale ; et tout ce que peut faire notre existence entière, c’est d’approcher de ce premier dessein."
                                            },
                                            {
                                                "example_id": "6cf2b60b-c9ee-4cc1-b3cc-623860f9ddea",
                                                "sense_id": "a0e89bc0-f6f4-3896-be00-2c988f9fabbe",
                                                "text": "Amis alsaciens, c'est décidément bien vrai, vous êtes d'éternels inassouvis, les dilettantes obstinés d'un mécontentement fondamental ; vous avez toujours la nostalgie d'un je ne sais quoi qui n'existait pas hier et qui ne sera pas demain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7406bbec-44fa-3dd2-9729-befaf5a078eb",
                                        "entry_id": "6de7616d-88c9-3a78-ae4b-7e862577ba25",
                                        "glosses": [
                                            "Qui est principal, essentiel."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "183a3d31-a62d-4136-8853-a05f81e6c7fd",
                                                "sense_id": "7406bbec-44fa-3dd2-9729-befaf5a078eb",
                                                "text": "L'individualisme libertaire, l'insoumission aux nécessités fondamentales d'une société la dissolvent."
                                            },
                                            {
                                                "example_id": "fccc6007-76e7-45de-9476-d2e0af0cc4b2",
                                                "sense_id": "7406bbec-44fa-3dd2-9729-befaf5a078eb",
                                                "text": "Dans ce contexte, la clause de revoyure de la loi est considérée, par eux, comme un des éléments fondamentaux de la loi."
                                            }
                                        ]
                                    }
                                ]
                            },
