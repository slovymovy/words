                                            {
                                                "example_id": "0229d652-b0c1-417c-a583-bff3acb8730a",
                                                "sense_id": "bdc08c7f-b127-3fb6-a3aa-a18295606689",
                                                "text": "\"Van mensen die een huwelijksaanzoek deden of bovenop Frans Bauer vielen tot mensen die Take That mochten knuffelen of het gehinnik van een paard na konden doen\", liet RTL eerder weten."
                                            },
                                            {
                                                "example_id": "f7e3f4f0-a860-46d6-9d9d-17f1a192603b",
                                                "sense_id": "bdc08c7f-b127-3fb6-a3aa-a18295606689",
                                                "text": "Geluidsman Henk Meeuwsen verzamelt dierengeluiden en legde al menig paardenscheet vast tijdens filmopnames voor een documentaire over de Oostvaardersplassen. Achteraf is hij daar tóch ontevreden over. Zo bevatten de opnames te veel bijgeluiden, zoals bijvoorbeeld gehinnik."
                                            }
                                        ]
                                    },
