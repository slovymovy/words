                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c05e1fc0-6c6a-430b-9051-0120b4af064d",
                                "sense_id": "42961ff0-ecff-3cab-b069-15fdf5cdd983",
                                "text": "„Sexton wurde gefeuert, aber sie blieb eine Fürsprecherin der Elektromobilität – und eine Kritikerin.“"
