                        "sense_id": "42e46adc-68f5-33a5-97bd-61d7ac7a018b",
                        "entry_id": "584ed0ab-b82d-3118-9e11-142ddd6e3308",
                        "glosses": [
                            "Herstellung von elektrischer Energie, die in einen elektrischen Strom umgewandelt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c26776f-796b-4d67-bb9e-2bbd50d7f0d7",
                                "sense_id": "42e46adc-68f5-33a5-97bd-61d7ac7a018b",
                                "text": "„1920 belief sich die Stromproduktion der Sowjetunion auf kaum ein Viertel der Vorkriegsproduktion und betrug insgesamt eine halbe Milliarde Kilowattstunden.“"
                            },
                            {
                                "example_id": "01590b83-7065-4e3b-8d7a-72e66f6335c7",
                                "sense_id": "42e46adc-68f5-33a5-97bd-61d7ac7a018b",
                                "text": "„[…] in Norddeutschland [werden] an Tagen mit guten Bedingungen für grüne Stromproduktion oft auch Windräder abgeschaltet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6fad5449-6c5e-4654-9968-79514f987045",
                        "source_entry_id": "584ed0ab-b82d-3118-9e11-142ddd6e3308",
                        "source_sense_id": "42e46adc-68f5-33a5-97bd-61d7ac7a018b",
                        "source_sense_description": "Herstellung von elektrischer Energie, die in einen elektrischen Strom umgewandelt werden kann",
                        "target_lang_word": "發電",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "發電",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "4d6a6f94-381c-3424-bbf4-408706eda9e4",
                                        "entry_id": "f801d809-c206-3060-8f73-fa8df58b39a1",
                                        "glosses": [
                                            "將其他能源形式轉換為電力"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6119a8d-cc3f-4156-974e-71a1fcd26c25",
                                                "sense_id": "4d6a6f94-381c-3424-bbf4-408706eda9e4",
                                                "text": "手搖發電"
                                            },
                                            {
                                                "example_id": "4347610f-91db-4310-8fa4-982bdbf06b31",
                                                "sense_id": "4d6a6f94-381c-3424-bbf4-408706eda9e4",
                                                "text": "手摇发电"
                                            },
                                            {
                                                "example_id": "41c6d468-29a6-48df-81c7-1328e2116751",
                                                "sense_id": "4d6a6f94-381c-3424-bbf4-408706eda9e4",
                                                "text": "光伏發電"
                                            },
                                            {
                                                "example_id": "d0954a5d-8d0b-4d74-8a88-9a44c93f1641",
                                                "sense_id": "4d6a6f94-381c-3424-bbf4-408706eda9e4",
                                                "text": "光伏发电"
                                            },
                                            {
                                                "example_id": "88861f26-be1a-4f0f-b3da-94466a060431",
                                                "sense_id": "4d6a6f94-381c-3424-bbf4-408706eda9e4",
                                                "text": "蘇聯已發明了一種太陽能發電機，它能直接利用陽光發電。"
                                            },
                                            {
                                                "example_id": "66c85d15-4829-4c84-aac8-4c417a4ed977",
                                                "sense_id": "4d6a6f94-381c-3424-bbf4-408706eda9e4",
                                                "text": "苏联已发明了一种太阳能发电机，它能直接利用阳光发电。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35d614b2-9b45-3b92-83cf-86dc362bd9eb",
                                        "entry_id": "f801d809-c206-3060-8f73-fa8df58b39a1",
                                        "glosses": [
                                            "自慰，手淫"
                                        ],
                                        "tags": [
                                            "Internet",
                                            "euphemistic",
                                            "neologism"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "發電",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "c8da4509-9c84-320b-bc35-55ecc62b8855",
                                        "entry_id": "44d09350-7197-34e1-ac4c-0590ff86d8bd",
                                        "glosses": [
                                            "拍發電報"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85b4fa17-7a32-4407-a934-5fc3feb80128",
                                                "sense_id": "c8da4509-9c84-320b-bc35-55ecc62b8855",
                                                "text": "繼之接了丁憂電報，我們一面發電給你，一面寫信給各分號。……好有萬把銀子藥材裝到下江來的，行家知道了，便發電到沿江各埠，要扣這一筆貨，這一下子，可全局都被牽動了。……我沒了法子，只得發電到北京、天津，叫停止交易。"
                                            },
                                            {
                                                "example_id": "e52af719-5b76-4fe5-bd0e-57f561f3dee2",
                                                "sense_id": "c8da4509-9c84-320b-bc35-55ecc62b8855",
                                                "text": "继之接了丁忧电报，我们一面发电给你，一面写信给各分号。……好有万把银子药材装到下江来的，行家知道了，便发电到沿江各埠，要扣这一笔货，这一下子，可全局都被牵动了。……我没了法子，只得发电到北京、天津，叫停止交易。"
                                            },
                                            {
                                                "example_id": "b0f92ff1-0e13-4150-90f4-1e29c1f23255",
                                                "sense_id": "c8da4509-9c84-320b-bc35-55ecc62b8855",
                                                "text": "哪知各督軍尚未有言，惟長江巡閱使張勛首先發電，說此令由伍廷芳副署，不合法律，各督軍發電，亦與張勛電相同。"
                                            },
                                            {
                                                "example_id": "c822c168-1394-410c-a0b8-bf3912d8712d",
                                                "sense_id": "c8da4509-9c84-320b-bc35-55ecc62b8855",
                                                "text": "哪知各督军尚未有言，惟长江巡阅使张勋首先发电，说此令由伍廷芳副署，不合法律，各督军发电，亦与张勋电相同。"
                                            },
                                            {
                                                "example_id": "f90255f7-faa2-4b9a-b211-3c0f680ceae0",
                                                "sense_id": "c8da4509-9c84-320b-bc35-55ecc62b8855",
                                                "text": "我非常憤怒了，覺得他簡直不是人，自己的先生被殺了，連打一個電報還害怕，於是便堅執地主張要發電，同他爭起來。結果是主張發電的居多數，他屈服了。其次要推出人來擬電稿。"
                                            },
                                            {
                                                "example_id": "5c74e2e9-6c00-44f7-909b-cf4e9846d7a7",
                                                "sense_id": "c8da4509-9c84-320b-bc35-55ecc62b8855",
                                                "text": "我非常愤怒了，觉得他简直不是人，自己的先生被杀了，连打一个电报还害怕，于是便坚执地主张要发电，同他争起来。结果是主张发电的居多数，他屈服了。其次要推出人来拟电稿。"
                                            },
                                            {
                                                "example_id": "5a7fb9f9-21a5-4b22-818f-e719b873b700",
                                                "sense_id": "c8da4509-9c84-320b-bc35-55ecc62b8855",
                                                "text": "妹今發電之刻尚在人間，大哥至閱電之時，已成隔世！"
                                            },
                                            {
                                                "example_id": "9846685d-da49-49df-9bf5-183068d0e383",
                                                "sense_id": "c8da4509-9c84-320b-bc35-55ecc62b8855",
                                                "text": "妹今发电之刻尚在人间，大哥至阅电之时，已成隔世！"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
