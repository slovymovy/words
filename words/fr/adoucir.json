                {
                    "sense_id": "3c8f516d-e2a7-361f-b485-4b393005669d",
                    "sense_definition": "Rendre un aliment, un goût ou une boisson moins acide, moins amer ou plus sucré.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "saveur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ajoutez une cuillère de miel pour <w>adoucir</w> cette sauce un peu acide.",
                            "target_lang_translations": {
                                "en": "Add a spoonful of honey to <w>sweeten</w> this slightly sour sauce.",
                                "ru": "Добавьте ложку мёда, чтобы <w>смягчить</w> кислинку этого соуса.",
                                "de": "Geben Sie einen Löffel Honig hinzu, um diese etwas saure Soße zu <w>süßen</w>.",
                                "es": "Añada una cucharada de miel para <w>endulzar</w> esta salsa un poco ácida.",
                                "zh": "加一勺蜂蜜，用来<w>中和</w>这份有点酸的酱汁。"
                            }
                        },
                        {
                            "text": "Un peu de lait permet d'<w>adoucir</w> un café trop serré.",
                            "target_lang_translations": {
                                "en": "A little milk helps to <w>mellow</w> a coffee that is too strong.",
                                "ru": "Немного молока позволяет <w>смягчить</w> слишком крепкий кофе.",
                                "de": "Etwas Milch hilft, einen zu starken Kaffee zu <w>mildern</w>.",
                                "es": "Un poco de leche permite <w>suavizar</w> un café demasiado cargado.",
                                "zh": "加一点牛奶，就能<w>冲淡</w>太浓咖啡的苦味。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "adoucir le goût",
                        "adoucir une sauce"
                    ],
                    "target_lang_definitions": {
                        "en": "To make food, a taste, or a drink less sour, less bitter, or sweeter.",
                        "ru": "Делать пищу, вкус или напиток менее кислым, горьким или более сладким.",
                        "de": "Speisen, einen Geschmack oder ein Getränk weniger sauer, weniger bitter oder süßer machen.",
                        "es": "Hacer que un alimento, un sabor o una bebida sea menos ácido, amargo o más dulce.",
                        "zh": "降低食物、味道或饮品的酸味或苦味，或使其更加香甜。"
                    },
                    "translations": {
