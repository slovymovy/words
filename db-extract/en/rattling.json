                                        "entry_id": "2c891171-ef25-3f6c-805b-f2021ce09de7",
                                        "glosses": [
                                            "hohes Geräusch mehrfach aneinanderstoßender harter Teile"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88a603b8-bd0b-40c2-a6b7-4c48a6a75f5f",
                                                "sense_id": "f66aae58-f08d-3445-8d40-bd2caace5baf",
                                                "text": "Und dort stand ich nun im Dunkeln und das einzige, was ich hörte, war das nahende Klappern der Skelettkrieger."
                                            },
                                            {
                                                "example_id": "1b2a460c-b7e0-4dd0-a943-0f1420a0579b",
                                                "sense_id": "f66aae58-f08d-3445-8d40-bd2caace5baf",
                                                "text": "„Ben neben mir verschluckte sich, musste husten und ließ sein Messer mit einem lauten Klappern auf den Teller fallen.“"
                                            },
                                            {
                                                "example_id": "c468efa5-8583-406e-b0f2-51078ae73fe0",
                                                "sense_id": "f66aae58-f08d-3445-8d40-bd2caace5baf",
                                                "text": "„Unter ihren Fingern ordneten sich die Klöppel mit dem Klappern von Kastagnetten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
