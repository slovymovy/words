                                            {
                                                "example_id": "7274cf2c-b1dc-4d05-ac98-f7a7e94b65d3",
                                                "sense_id": "72d3fdc4-139b-346d-9f3e-13204f2cb199",
                                                "text": "\"Why, you see, sir, the times are bad, and I am no speculator. I have a wife and family, and a man with a wife and family must be just before he is generous. Besides, my two youngest children have just had the hooping-cough, and they must have a little country air: all these things are expensive. I appeal to your feelings, sir, whether you would drive a hard bargain with a man in my situation?\""
                                            }
