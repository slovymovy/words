{
    "word_family": [
        "hump",
        "humpbacked"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "97c72658-c1c1-3d1d-a429-d87bc78d6853",
                    "sense_definition": "A humpback whale, known for its long pectoral fins and distinctive songs.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "whale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tourists watched in awe as a giant <w>humpback</w> breached the ocean surface.",
                            "target_lang_translations": {
                                "zh": "当一只巨大的<w>座头鲸</w>跃出海面时，游客们惊叹不已。"
                            }
                        },
                        {
                            "text": "Researchers track each <w>humpback</w> by the unique markings on its tail.",
                            "target_lang_translations": {
                                "zh": "研究人员根据每只<w>座头鲸</w>尾部的独特印记来进行追踪。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "humpback whale"
                    ],
                    "target_lang_definitions": {
                        "zh": "座头鲸，一种以胸鳍较长和鸣声独特闻名的大型鲸类。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "座头鲸",
                                "target_lang_sense_clarification": "大型海洋哺乳动物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84ec01c1-10f5-3051-bb40-d5e3d52093b5",
                    "sense_definition": "An abnormally curved or hunched back caused by curvature of the spine.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_feature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shadow on the wall clearly showed the distinct shape of his <w>humpback</w>.",
                            "target_lang_translations": {
                                "zh": "墙上的阴影清晰地显现出他那明显的<w>驼背</w>轮廓。"
                            }
                        },
                        {
                            "text": "Severe spinal curvature caused him to develop a pronounced <w>humpback</w> over time.",
                            "target_lang_translations": {
                                "zh": "严重的脊柱侧弯随着时间的推移让他形成了严重的<w>驼背</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "因脊柱弯曲等原因导致的驼背。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "驼背",
                                "target_lang_sense_clarification": "身体畸形部位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc0be603-79e2-33af-9aa4-e25898a20b44",
                    "sense_definition": "A person who has a hunched back.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the classic story, the protagonist was a gentle <w>humpback</w> who worked as a bell ringer.",
                            "target_lang_translations": {
                                "zh": "在经典故事中，主角是一个温和的敲钟人，也是个<w>驼背者</w>。"
                            }
                        },
                        {
                            "text": "Cruel villagers often avoided the mysterious <w>humpback</w> out of ignorance and superstition.",
                            "target_lang_translations": {
                                "zh": "残忍的村民出于无知和迷信，常常避开那个神秘的<w>驼子</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hunchback",
                        "crookback"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "now often offensive"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "驼背的人（现常带贬义或过时）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "驼背者",
                                "target_lang_sense_clarification": "驼背的人"
                            },
                            {
                                "target_lang_word": "驼子",
                                "target_lang_sense_clarification": "带贬义，驼背的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4256a61f-7773-38cf-a88f-a4a18032f1a3",
                    "sense_definition": "A prominent hump on the shoulders or back of an animal.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_feature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We could see the dark <w>humpbacks</w> of grazing wild cattle against the morning horizon.",
                            "target_lang_translations": {
                                "zh": "迎着清晨的地平线，我们可以看到正在吃草的野牛那黑色的<w>驼峰</w>。"
                            }
                        },
                        {
                            "text": "The heavy load rested securely right behind the beast's powerful <w>humpback</w>.",
                            "target_lang_translations": {
                                "zh": "沉重的货物稳稳地固定在这头牲畜强壮的<w>背峰</w>正后方。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "动物肩部或背部的隆起部分；驼峰。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "驼峰",
                                "target_lang_sense_clarification": "动物背部隆起"
                            },
                            {
                                "target_lang_word": "背峰",
                                "target_lang_sense_clarification": "动物肩背部隆起"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5478758f-20c4-370f-9bb8-33f9d59279c3",
                    "sense_definition": "A rounded elevation in terrain, such as a ridge, hill, or small island.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_feature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weary hikers climbed slowly over the rocky <w>humpback</w> of the ridge.",
                            "target_lang_translations": {
                                "zh": "疲惫的徒步者缓缓翻越了山脊岩石构成的<w>隆起部</w>。"
                            }
                        },
                        {
                            "text": "We could see the distant <w>humpbacks</w> of forested hills rising above the dense morning fog.",
                            "target_lang_translations": {
                                "zh": "我们能看见远处森林覆盖的小山那如<w>驼峰状隆起</w>的山脊，耸立在浓重的晨雾之上。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "地形上像驼峰般隆起的圆弧状山脊、小丘或岛屿。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "隆起部",
                                "target_lang_sense_clarification": "地形隆起"
                            },
                            {
                                "target_lang_word": "驼峰状隆起",
                                "target_lang_sense_clarification": "圆弧状山脊或小山"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c0eb719-dbc5-343e-8075-02fc2b35fa52",
                    "sense_definition": "A pink salmon (Oncorhynchus gorbuscha), named for the hump developed by breeding males.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Thousands of <w>humpbacks</w> swam upstream each autumn to spawn in the cold mountain creeks.",
                            "target_lang_translations": {
                                "zh": "每年秋天，成千上万条<w>驼背大马哈鱼</w>都会逆流而上，在寒冷的山涧中产卵。"
                            }
                        },
                        {
                            "text": "The local fishermen caught a mature male <w>humpback</w> near the mouth of the river.",
                            "target_lang_translations": {
                                "zh": "当地渔民在河口附近捕获了一条成年的雄性<w>驼背大马哈鱼</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "humpback salmon"
                    ],
                    "target_lang_definitions": {
                        "zh": "驼背大马哈鱼，即粉红鲑（繁殖期雄性背部会隆起）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "驼背大马哈鱼",
                                "target_lang_sense_clarification": "粉红鲑"
                            },
                            {
                                "target_lang_word": "细鳞麻哈鱼",
                                "target_lang_sense_clarification": "粉红鲑学名"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "836a9db2-24f0-36a6-a69e-f40c0e26ea24",
                    "sense_definition": "To engage in the hunting of humpback whales.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "whaling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The whaling vessel spent several brutal months <w>humpbacking</w> across the rough waters of the Atlantic.",
                            "target_lang_translations": {
                                "zh": "这艘捕鲸船在大西洋汹涌的海面上度过了艰苦的数月，一路<w>捕猎座头鲸</w>。"
                            }
                        },
                        {
                            "text": "The crew decided to <w>humpback</w> near the coastline before heading toward the southern whaling grounds.",
                            "target_lang_translations": {
                                "zh": "船员们决定在前往南部捕鲸场之前，先在海岸线附近<w>捕猎座头鲸</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "used in whaling contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "捕猎座头鲸。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "捕猎座头鲸",
                                "target_lang_sense_clarification": "捕鲸行为"
                            },
                            {
                                "target_lang_word": "捕座头鲸",
                                "target_lang_sense_clarification": "猎捕座头鲸"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}