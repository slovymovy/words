                                            },
                                            {
                                                "example_id": "99abbaa7-fccf-4d38-8aac-4127e8d0c570",
                                                "sense_id": "d9088e05-2807-3c20-a9cd-6f55def0b5dc",
                                                "text": "Vera Nugent, a brisk woman of the world, with a fondness for vivid clothing and a Spanish air which went oddly with it, took the trouble one fine day to tackle her brother. “Look here, Jimmy,\" she said as they breasted a mountain pass, “are you quite sure what you are up to with these people?”"
                                            },
                                            {
                                                "example_id": "61982bd7-f874-411e-bfc5-46e8bae908f0",
                                                "sense_id": "d9088e05-2807-3c20-a9cd-6f55def0b5dc",
                                                "text": "With the sea below us grey and storm swept, and the coast line vague in the driving rain, we forged our way up the bank to breast the summit at 37 m.p.h."
                                            },
                                            {
                                                "example_id": "960d42e3-06d7-4134-8641-e123ba627499",
                                                "sense_id": "d9088e05-2807-3c20-a9cd-6f55def0b5dc",
                                                "text": "But this was excelled by the remarkable feat of Iron Duke, on the second run, in accelerating from a dead start at Miller's Dale up 1 in 90 to no less than 53 m.p.h. before breasting the summit at Peak Forest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c743c90b-3a51-3d7f-b83d-0ce4766bde3d",
                                        "entry_id": "2a0148f3-9799-3ac5-9059-aa9a019340d4",
                                        "glosses": [
                                            "To debreast."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0c47cac-56c7-4ed5-a22e-262280388e37",
                                                "sense_id": "c743c90b-3a51-3d7f-b83d-0ce4766bde3d",
                                                "text": "Breast the birds; wash and dry well. Preheat oven to 375 degrees. Place the birds in a roasting pan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
