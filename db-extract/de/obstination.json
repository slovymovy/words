                "senses": [
                    {
                        "sense_id": "f942f519-ee9f-32e5-8abf-5d805d59e611",
                        "entry_id": "ada992d8-d799-3de8-9e46-f81c75ce7a47",
                        "glosses": [
                            "Eigensinn"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "5f9a11a6-827e-4893-99e2-e917676f3f65",
                                "sense_id": "f942f519-ee9f-32e5-8abf-5d805d59e611",
                                "text": "Aufgrund seiner Obstination ignorierte er wiedermal die Ratschläge der Anderen."
                            },
                            {
                                "example_id": "8ce85910-d0b6-4f5f-a612-684794f08974",
                                "sense_id": "f942f519-ee9f-32e5-8abf-5d805d59e611",
                                "text": "„Die unerhörte Frische und Unberührtheit seiner Bilder\" habe Cezanne einzig dieser „Obstination zu verdanken\"."
                            },
                            {
                                "example_id": "d749e455-e350-4939-b2f8-2b8b815601e5",
                                "sense_id": "f942f519-ee9f-32e5-8abf-5d805d59e611",
                                "text": "›Erst gestern habe ich dem Direktor (zum so und so vielten Male) erklärt, der Tannhäuser werde so gegeben wie er ist, oder er werde garnicht gegeben. Was diese Obstination heißt, können Sie gerade jetzt, wie Sie meine Lagen kennen, ab besten beurteilen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "104fd004-6838-4f18-90a6-870cb22f8672",
                        "source_entry_id": "ada992d8-d799-3de8-9e46-f81c75ce7a47",
                        "source_sense_id": "f942f519-ee9f-32e5-8abf-5d805d59e611",
