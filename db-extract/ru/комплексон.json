                                        "examples": [
                                            {
                                                "example_id": "5f976475-7f90-4b31-8f11-c749e2b57d42",
                                                "sense_id": "39ee3a2d-7249-3dd5-9010-e1789760b501",
                                                "text": "In der Lebensmittelchemie werden Komplexbildner eingesetzt, um Aroma, Farbe und Textur von Lebensmitteln zu stabilisieren."
                                            },
                                            {
                                                "example_id": "40e10270-f53f-4ada-be4e-d2390f06bdf7",
                                                "sense_id": "39ee3a2d-7249-3dd5-9010-e1789760b501",
                                                "text": "„Die Komplexbildner stellen eine eigene Funktionsklasse innerhalb der Lebensmittelzusatzstoffe dar.“"
                                            },
                                            {
                                                "example_id": "92640315-9ade-4e43-805f-7d98ee36b043",
                                                "sense_id": "39ee3a2d-7249-3dd5-9010-e1789760b501",
                                                "text": "„Komplexbildner sind Verbindungen, die zur Bildung von Komplexen befähigt sind, besonders zur Komplexierung von Metallen.“"
                                            }
