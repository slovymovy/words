            "senses": [
                {
                    "sense_id": "408aed46-b2ec-3b37-9e09-8cb548c35911",
                    "sense_definition": "Kleines Besteckteil in Form eines Löffels, das vor allem zum Umrühren von Tee oder Kaffee dient.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "besteck",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich rühre den Zucker mit einem kleinen <w>Teelöffel</w> in meinen heißen Tee ein."
                        },
                        {
                            "text": "Neben die Kaffeetasse legte die Kellnerin einen sauberen <w>Teelöffel</w> aus Silber."
                        }
                    ],
                    "common_phrases": [
                        "mit dem Teelöffel umrühren",
                        "ein Teelöffel aus Silber"
                    ]
                },
                {
                    "sense_id": "0c2c0607-675e-3439-a240-564fb7cf4a02",
                    "sense_definition": "Maß für das Volumen von flüssigen oder pulvrigen Zutaten, das etwa fünf Millilitern entspricht.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "masseinheit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Für das Rezept brauchst du genau einen gestrichenen <w>Teelöffel</w> Salz."
                        },
                        {
                            "text": "Gib bitte zwei <w>Teelöffel</w> Honig in die warme Milch, damit sie süß schmeckt."
                        }
                    ],
                    "common_phrases": [
                        "ein gestrichener Teelöffel",
                        "ein gehäufter Teelöffel"
                    ]
                }
            ]
        }
    ]
