                {
                    "sense_id": "5a18e7eb-f31f-3264-b1ab-a59de45388e1",
                    "sense_definition": "Geleden; aanduiding van een tijdstip in het verleden.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb hem drie weken <w>terug</w> voor het laatst gezien.",
                            "target_lang_translations": {
                                "en": "I last saw him three weeks <w>ago</w>.",
                                "ru": "Я видел его в последний раз три недели <w>назад</w>.",
                                "pl": "Widziałem go po raz ostatni trzy tygodnie <w>temu</w>.",
                                "de": "Ich habe ihn das letzte Mal vor drei Wochen gesehen (drei Wochen <w>her</w>).",
                                "fr": "Je l'ai vu pour la dernière fois <w>il y a</w> trois semaines.",
                                "it": "L'ho visto l'ultima volta tre settimane <w>fa</w>.",
                                "cs": "Naposledy jsem ho viděl <w>před</w> třemi týdny.",
                                "tr": "Onu en son üç hafta <w>önce</w> gördüm.",
                                "es": "Lo vi por última vez hace tres semanas <w>atrás</w>."
                            }
                        },
                        {
                            "text": "Dat is al heel lang <w>terug</w> gebeurd.",
                            "target_lang_translations": {
                                "en": "That happened a long time <w>ago</w>.",
                                "ru": "Это случилось уже много времени <w>назад</w>.",
                                "pl": "To wydarzyło się już bardzo dawno <w>temu</w>.",
                                "de": "Das ist schon sehr lange <w>her</w>.",
                                "fr": "Cela s'est produit <w>il y a</w> déjà très longtemps.",
                                "it": "È successo molto tempo <w>fa</w>.",
                                "cs": "To se stalo už velmi dávno <w>zpátky</w>.",
                                "tr": "Bu çok uzun zaman <w>önce</w> oldu.",
                                "es": "Eso sucedió hace ya mucho tiempo <w>atrás</w>."
                            }
                        }
