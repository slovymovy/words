                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scatter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6aa81beb-7355-3aba-a80d-91bc591dd761",
                                        "entry_id": "0a9da12d-b2fd-3cf4-b055-212ece53bd05",
                                        "glosses": [
                                            "To (cause to) separate and go in different directions; to disperse."
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d738f21-674d-4798-9323-c81123fbe02d",
                                                "sense_id": "6aa81beb-7355-3aba-a80d-91bc591dd761",
                                                "text": "The crowd scattered in terror."
                                            },
                                            {
                                                "example_id": "a4122e1c-4314-4be6-a36d-c6dbfd509d5a",
                                                "sense_id": "6aa81beb-7355-3aba-a80d-91bc591dd761",
                                                "text": "Scatter and disperse the giddy Goths."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9f802d7-0fe4-3721-bf10-797475cc0703",
                                        "entry_id": "0a9da12d-b2fd-3cf4-b055-212ece53bd05",
                                        "glosses": [
                                            "To distribute loosely as by sprinkling."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84fd4249-eaf4-4fa7-b687-e127f08fd9d4",
                                                "sense_id": "c9f802d7-0fe4-3721-bf10-797475cc0703",
                                                "text": "Her ashes were scattered at the top of a waterfall."
                                            },
                                            {
                                                "example_id": "7127e540-7df5-47ae-8533-baeffdb517ca",
                                                "sense_id": "c9f802d7-0fe4-3721-bf10-797475cc0703",
                                                "text": "Why should my muse enlarge on Libyan swains, / Their scattered cottages, and ample plains?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c4f405c-eaa4-3031-9413-7ef72b80360d",
                                        "entry_id": "0a9da12d-b2fd-3cf4-b055-212ece53bd05",
                                        "glosses": [
                                            "To deflect (radiation or particles)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec30c67e-7409-4565-a5af-ebeff75cd132",
                                                "sense_id": "9c4f405c-eaa4-3031-9413-7ef72b80360d",
                                                "text": "Chasca's ring is unique. It appears to be, for lack of a better term, a massive piece of alien \"installation art.\" The rings are made of small pieces of synthetic material, and are almost invisible from space. From the ground, they catch and scatter the light of Matano in picturesque ways. It is not known who created the ring or when."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22a27311-0400-368b-b92d-529ded15d6f2",
                                        "entry_id": "0a9da12d-b2fd-3cf4-b055-212ece53bd05",
                                        "glosses": [
                                            "To occur or fall at widely spaced intervals."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f1bc8a7-3903-3122-9c5a-6d7ed3452085",
                                        "entry_id": "0a9da12d-b2fd-3cf4-b055-212ece53bd05",
                                        "glosses": [
                                            "To frustrate, disappoint, and overthrow."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff63fe40-86f7-4918-ab54-3423fd3f3914",
                                                "sense_id": "8f1bc8a7-3903-3122-9c5a-6d7ed3452085",
                                                "text": "to scatter hopes or plans"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be802b24-8653-32bc-b085-7794b6c0bcc8",
                                        "entry_id": "0a9da12d-b2fd-3cf4-b055-212ece53bd05",
                                        "glosses": [
                                            "To be dispersed upon."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98c205b7-400c-4f1e-ae5f-082283387667",
                                                "sense_id": "be802b24-8653-32bc-b085-7794b6c0bcc8",
                                                "text": "Desiccated stalks scattered the fields."
                                            },
                                            {
                                                "example_id": "ea445b8f-eed4-4989-9c04-0a6c35fe77c8",
                                                "sense_id": "be802b24-8653-32bc-b085-7794b6c0bcc8",
                                                "text": "[…] its beauty is obscured by the environmental waste and loose trash that scatter the countryside."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1372703-58d0-3954-8b74-524137a5fc0c",
                                        "entry_id": "0a9da12d-b2fd-3cf4-b055-212ece53bd05",
                                        "glosses": [
                                            "Of a pitcher: to keep down the number of hits or walks."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d4f170f4-6a30-36dd-bb76-865e5f308ee9",
                                        "entry_id": "0a9da12d-b2fd-3cf4-b055-212ece53bd05",
                                        "glosses": [
                                            "To leave."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48896347-b271-4382-be5a-24aee3165f5f",
                                                "sense_id": "d4f170f4-6a30-36dd-bb76-865e5f308ee9",
                                                "text": "When the police showed up, I scattered."
                                            }
                                        ]
                                    }
                                ]
                            },
