                                "target_senses": [
                                    {
                                        "sense_id": "a78f85bc-e04d-39bc-9294-4c67cb975209",
                                        "entry_id": "9c17c0b3-67e5-3bb2-bf93-1dd3d4824bf8",
                                        "glosses": [
                                            "een heel klein scheurtje dat vaak onzichtbaar is maar de sterkte van een constructie wel aantast"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6136de6-fdce-4776-9984-a48fdf9384bd",
                                                "sense_id": "a78f85bc-e04d-39bc-9294-4c67cb975209",
                                                "text": "De andere kwartetleden waren nog niet op de hoogte, want Michael had tijd nodig voordat alles in de openbaarheid kon komen. Hij wilde precies weten wat hun te doen stond, alles zo goed mogelijk voorbereiden voordat ze naar de rechter stapten. Daarom had hij een haarscheurtje in het onderblad verzonnen waarnaar grondig gekeken moest worden en zijn collega's verteld dat de reparatie weken, misschien zelfs maanden kon gaan duren."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22d0a468-7668-38ba-9838-7f1bbcff1431",
                                        "entry_id": "9c17c0b3-67e5-3bb2-bf93-1dd3d4824bf8",
                                        "glosses": [
                                            "kleine beschadigingen die grote gevolgen kunnen hebben"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3b4a78f-4caf-4588-8d9c-75c5eb088d3d",
                                                "sense_id": "22d0a468-7668-38ba-9838-7f1bbcff1431",
                                                "text": "Silvio Berlusconi beschikt nog over een riante meerderheid in het parlement. Hij controleert de media als nooit te voren. Maar de troon van Il Cavaliere (de Ridder), die al vijftien jaar de Italiaanse politiek domineert, vertoont haarscheuren. Zijn gezag is tanende."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
