{
    "word_family": [
        "being"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3da4cf65-789d-3f7e-a0ee-051a9dbac6aa",
                    "sense_definition": "The present tense form of <w>be</w> used for the second-person singular and all plural subjects.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "existence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>are</w> very happy with the results of the project.",
                            "target_lang_translations": {
                                "zh": "他们对项目的结果感到非常满意，他们<w>是</w>很高兴的。",
                                "tr": "Projenin sonuçlarından çok <w>memnunlar</w>."
                            }
                        },
                        {
                            "text": "You <w>are</w> late for the meeting today.",
                            "target_lang_translations": {
                                "zh": "你今天开会<w>是</w>迟到了。",
                                "tr": "Bugün toplantıya <w>geç kaldın</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "how are you",
                        "there are many",
                        "we are here"
                    ],
                    "target_lang_definitions": {
                        "zh": "动词 be 的现在时形式，用于第二人称单数及所有复数主语。",
                        "tr": "İkinci tekil şahıs ve tüm çoğul özneler için kullanılan 'be' (olmak) fiilinin şimdiki zaman hali; Türkçede genellikle ek-fiil (-dir, -sin, -siniz, -ler vb.) olarak karşılık bulur."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "是",
                                "target_lang_sense_clarification": "系动词，用于连接主语和表语，表示状态或身份。"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "olmak",
                                "target_lang_sense_clarification": "Durum veya varlık bildiren temel fiil"
                            },
                            {
                                "target_lang_word": "-dir",
                                "target_lang_sense_clarification": "İsim cümlelerinde bildirme/ek-fiil eki"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1fa5fdb7-9b89-309a-96db-29f462961287",
                    "sense_definition": "A metric unit of area equal to 100 square metres.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small plot of land measures exactly one <w>are</w>.",
                            "target_lang_translations": {
                                "zh": "这块小土地的面积正好是一<w>公亩</w>。",
                                "tr": "Küçük arsa tam olarak bir <w>ar</w> büyüklüğündedir."
                            }
                        },
                        {
                            "text": "Farmers used to measure their fields in <w>ares</w> before hectares became standard.",
                            "target_lang_translations": {
                                "zh": "在公顷成为标准之前，农民过去常以<w>公亩</w>来测量田地。",
                                "tr": "Hektar standart hale gelmeden önce çiftçiler tarlalarını <w>ar</w> ile ölçerdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "square decametre"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rarely used in modern contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "公亩，一种面积单位，等于100平方米。",
                        "tr": "100 metrekareye eşit olan metrik bir yüzey ölçü birimi."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "公亩",
                                "target_lang_sense_clarification": "公制面积单位。"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ar",
                                "target_lang_sense_clarification": "100 metrekarelik yüzey ölçü birimi"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "3f490579-020c-3d5e-b4c6-c649ef1bb3be",
                    "sense_definition": "The abbreviation for the Arab Republic of Egypt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The official documents were stamped with the seal of the <w>ARE</w>.",
                            "target_lang_translations": {
                                "zh": "官方文件上盖有<w>埃及</w>的印章。",
                                "tr": "Resmi belgelere <w>Mısır Arap Cumhuriyeti</w>'nin mührü basılmıştı."
                            }
                        },
                        {
                            "text": "Diplomatic relations between the two countries were managed through the <w>ARE</w> embassy.",
                            "target_lang_translations": {
                                "zh": "两国之间的外交关系通过<w>埃及</w>大使馆进行管理。",
                                "tr": "İki ülke arasındaki diplomatik ilişkiler <w>Mısır</w> büyükelçiliği aracılığıyla yürütülüyordu."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "阿拉伯埃及共和国的缩写。",
                        "tr": "Mısır Arap Cumhuriyeti'nin (Arab Republic of Egypt) kısaltması."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "埃及",
                                "target_lang_sense_clarification": "国家名称。"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "MAC",
                                "target_lang_sense_clarification": "Mısır Arap Cumhuriyeti kısaltması"
                            },
                            {
                                "target_lang_word": "Mısır",
                                "target_lang_sense_clarification": "Ülke adı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf88e718-e266-3060-9297-d54e72815472",
                    "sense_definition": "A small village located in Saaremaa, Estonia.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The travelers stopped in the quiet village of <w>Are</w> during their trip through Estonia.",
                            "target_lang_translations": {
                                "zh": "旅行者在爱沙尼亚旅行期间，在安静的<w>阿雷</w>村停留。",
                                "tr": "Gezginler, Estonya seyahatleri sırasında sakin <w>Are</w> köyünde mola verdiler."
                            }
                        },
                        {
                            "text": "Local traditions in <w>Are</w> have been preserved for many generations.",
                            "target_lang_translations": {
                                "zh": "<w>阿雷</w>的当地传统已经传承了许多代。",
                                "tr": "<w>Are</w>'deki yerel gelenekler nesiller boyunca korunmuştur."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Estonia"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "位于爱沙尼亚萨雷马岛的一个小村庄。",
                        "tr": "Estonya'nın Saaremaa bölgesinde bulunan küçük bir köy."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "阿雷",
                                "target_lang_sense_clarification": "地名音译。"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "Are",
                                "target_lang_sense_clarification": "Estonya'da bir köy adı"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}