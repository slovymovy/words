                                        "entry_id": "b927de65-6500-34fc-b26c-989677cdb60c",
                                        "glosses": [
                                            "Capability; the ability to perform some task."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
