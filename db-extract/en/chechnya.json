                                    {
                                        "sense_id": "7fbbb971-e596-3285-8fcb-a7656b1868d9",
                                        "entry_id": "2ab278ae-3747-3f79-820d-2f8a2c2f39eb",
                                        "glosses": [
                                            "autonome Republik in Südrussland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8193b93f-70a8-4cc9-804d-66e64e6fd1e0",
                                                "sense_id": "7fbbb971-e596-3285-8fcb-a7656b1868d9",
                                                "text": "Laut der Gesellschaft für bedrohte Völker gab es 2002 mit 5695 Menschen in Tschetschenien die weltweit meisten Opfer durch Landminen."
                                            },
                                            {
                                                "example_id": "f151a1f3-81ef-437f-9b57-9092ad77f5a8",
                                                "sense_id": "7fbbb971-e596-3285-8fcb-a7656b1868d9",
                                                "text": "„Hier haben sich Kosaken aus Tschetschenien eingenistet, die 1992 aus Grosny geflüchtet waren, als dort der tschetschenische Aufstand ausbrach.“"
                                            },
                                            {
                                                "example_id": "0149a48a-1518-4bea-aaf0-d6d6bb1311ae",
                                                "sense_id": "7fbbb971-e596-3285-8fcb-a7656b1868d9",
                                                "text": "[Tschetschenienkrieg 1994:] „Am 11.12.1994 marschierten nach gescheiterten Verhandlungen 40.000 russische Soldaten in Tschetschenien ein, […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
