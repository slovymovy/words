                                "target_senses": [
                                    {
                                        "sense_id": "78a8da3a-81ee-3d74-9a87-cfa83b99eff9",
                                        "entry_id": "da0299e1-a45c-34ba-9274-015f98b3f8b5",
                                        "glosses": [
