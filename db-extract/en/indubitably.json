                                    {
                                        "sense_id": "2ebcaa82-0690-3a49-95f6-acdc4c32d5ea",
                                        "entry_id": "0fb4808f-c389-3705-b73d-c722fc8842c6",
                                        "glosses": [
                                            "ohne daran zu rütteln (zu zweifeln); ganz sicher"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37ac3b16-f668-478e-9214-44fa2e8f9d1c",
                                                "sense_id": "2ebcaa82-0690-3a49-95f6-acdc4c32d5ea",
                                                "text": "Das wäre unzweifelhaft legal, aber wäre es auch klug, das jetzt so zu versuchen?"
                                            },
                                            {
                                                "example_id": "01efc733-82f8-4620-a285-f70b0f247747",
                                                "sense_id": "2ebcaa82-0690-3a49-95f6-acdc4c32d5ea",
                                                "text": "Der Verlust des Geldes ist ein unzweifelhafter Fakt, den kannst du nicht schönreden."
                                            },
                                            {
                                                "example_id": "1ce6e579-471b-4a6c-b528-c363cf5f9d2b",
                                                "sense_id": "2ebcaa82-0690-3a49-95f6-acdc4c32d5ea",
                                                "text": "Sie ist eine junge Dame von unzweifelhaftem Ruf."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
