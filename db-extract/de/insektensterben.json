                    },
                    {
                        "form_id": "08d63472-4b93-46d3-8216-778b71f6cbb5",
                        "entry_id": "f76886cd-5b50-3d75-9aa2-755016527d5e",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Insektensterben"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "185536a4-27fa-39c4-9389-d71b7f4a2ff1",
                        "entry_id": "f76886cd-5b50-3d75-9aa2-755016527d5e",
                        "glosses": [
                            "starker Rückgang der Zahl von Insekten, Aussterben von Insektenarten"
                        ],
                        "tags": [
                            "auch"
                        ],
                        "examples": [
                            {
                                "example_id": "36b869ba-47b1-4d79-90a8-7548524baae1",
                                "sense_id": "185536a4-27fa-39c4-9389-d71b7f4a2ff1",
                                "text": "„Seit langer Zeit ist ein massives Insektensterben im Gange.“"
                            },
                            {
                                "example_id": "a112b074-30aa-48e5-a339-dec125097302",
                                "sense_id": "185536a4-27fa-39c4-9389-d71b7f4a2ff1",
                                "text": "„[…] weltweit warnen Wissenschaftler vor einem dramatischen Insektensterben.“"
                            },
                            {
                                "example_id": "a97059ef-ff55-4a54-a496-c3d01a766b5c",
                                "sense_id": "185536a4-27fa-39c4-9389-d71b7f4a2ff1",
                                "text": "„Neunzig Prozent eines Käfers, der als Indikator für das Insektensterben gilt, sind in der Region Basel verschwunden.“"
                            },
                            {
                                "example_id": "9060e7d9-a99d-4334-8778-63a0487296c6",
                                "sense_id": "185536a4-27fa-39c4-9389-d71b7f4a2ff1",
                                "text": "„Eine neue Untersuchung über das Schmetterlingssterben in den USA reiht sich nahtlos in vergangene Berichte über das Insektensterben in Europa ein.“"
                            },
                            {
                                "example_id": "0ae1315c-536b-451a-bc5c-52dcf09d0007",
                                "sense_id": "185536a4-27fa-39c4-9389-d71b7f4a2ff1",
                                "text": "Jeder Ältere kann in Deutschland das Insektensterben selber sehen: Früher war auf einer Autofahrt von Hamburg nach Berlin die Windschutzscheibe zugekleistert, heute bleibt sie fast sauber."
                            },
                            {
                                "example_id": "991acdc7-0fb5-49bc-bf54-af5f5bbffefd",
                                "sense_id": "185536a4-27fa-39c4-9389-d71b7f4a2ff1",
                                "text": "„Vor allem die Krefelder Studie zum Insektensterben, die einen dramatischen Rückgang von Fluginsekten nahelegt, sensibilisierte 2017 Politik und Öffentlichkeit für das Thema.“"
                            },
                            {
                                "example_id": "71360237-a1aa-4139-8074-156b7ff36880",
                                "sense_id": "185536a4-27fa-39c4-9389-d71b7f4a2ff1",
                                "text": "„Das Insektensterben und all die weiteren Folgen auf andere Tiere werden weitergehen, wenn wir unsere industrialisierte Landwirtschaft so weiter betreiben wie bisher.“"
                            },
                            {
                                "example_id": "ee812420-6222-4d6e-82e7-c8c21c04bbe5",
                                "sense_id": "185536a4-27fa-39c4-9389-d71b7f4a2ff1",
                                "text": "[…] „die Ursachen des Insektensterbens liegen auf der Hand.“"
                            },
                            {
                                "example_id": "201f4358-921c-4ca0-990c-9776ad7f6a21",
                                "sense_id": "185536a4-27fa-39c4-9389-d71b7f4a2ff1",
                                "text": "„Der Klimawandel könnte ein großes Insektensterben auslösen.“"
                            },
                            {
                                "example_id": "52fd552a-23b5-4483-a5ec-086c3e89d4da",
                                "sense_id": "185536a4-27fa-39c4-9389-d71b7f4a2ff1",
                                "text": "„Christian Zehe lässt das Thema Insektensterben nicht mehr los und er will nicht tatenlos zusehen, wie Bienen und Schmetterlinge zusehens verschwinden.“"
                            },
                            {
                                "example_id": "c32c5446-7400-41fd-8c73-6e66587154f7",
                                "sense_id": "185536a4-27fa-39c4-9389-d71b7f4a2ff1",
                                "text": "„Als Maßnahme gegen das „Insektensterben“ werden Samentütchen im Handel angeboten oder von Firmen und Behörden verteilt, die im Garten, aber auch in der freien Landschaft, ausgestreut werden.“"
                            },
                            {
                                "example_id": "19945449-0c3c-4247-929f-c1c800209b93",
                                "sense_id": "185536a4-27fa-39c4-9389-d71b7f4a2ff1",
                                "text": "„Als eine wesentliche Ursache [Anmerkung: für den starken Rückgang früher häufiger Vogelarten in Deutschland wie Haussperling, Amsel oder Star] wurde das Insektensterben vermutet.“"
                            },
                            {
                                "example_id": "28f4f1be-4996-484a-b15e-051d672c2345",
                                "sense_id": "185536a4-27fa-39c4-9389-d71b7f4a2ff1",
                                "text": "[Schlagzeile:] „Was tun gegen das Insektensterben?“"
                            },
                            {
                                "example_id": "ee1f5db0-2b15-4119-b717-eb6b73c36ded",
                                "sense_id": "185536a4-27fa-39c4-9389-d71b7f4a2ff1",
                                "text": "„Ein internationales Forscherteam mit Beteiligung der Universität Göttingen hat einen Fahrplan gegen das Insektensterben entwickelt.“"
                            },
                            {
                                "example_id": "6c8bd165-165d-40f4-9b47-3c38cc8b3342",
                                "sense_id": "185536a4-27fa-39c4-9389-d71b7f4a2ff1",
                                "text": "„»Um das Insektensterben aufzuhalten, brauchen wir mehr Lebensraum für Insekten, weniger Pestizide und eine klügere Agrarförderung.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
