                        ],
                        "form": "die Shoshone"
                    },
                    {
                        "form_id": "72e4a0fe-cf42-424c-9e1f-fa0f707d051d",
                        "entry_id": "079346b0-1a93-3aa0-8203-83599d828468",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Shoshonen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "722ddeec-221d-3f96-a696-86dd522c21f7",
                        "entry_id": "079346b0-1a93-3aa0-8203-83599d828468",
                        "glosses": [
                            "ein nordamerikanisches Indianervolk, das das Große Becken besiedelte"
                        ],
                        "tags": [
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "0b69c194-a8e2-4b66-a665-536129740e82",
                                "sense_id": "722ddeec-221d-3f96-a696-86dd522c21f7",
                                "text": "„Mehr als zehntausend Jahre lang hatten die Shoshone und ihre Vorfahren ein kärgliches Leben geführt, an dem sich nur wenig geändert hatte.“"
                            },
                            {
                                "example_id": "ddb73d4d-2e34-4921-96dd-1754578c33f3",
                                "sense_id": "722ddeec-221d-3f96-a696-86dd522c21f7",
                                "text": "„Nach der Version in der Chronik von Many Guns (1938) war White Flathead an einem Kriegszug gegen die Shoshone und Flathead beteiligt.“"
                            },
                            {
                                "example_id": "002642ba-a220-4e0e-9a69-ef00dbb53d26",
                                "sense_id": "722ddeec-221d-3f96-a696-86dd522c21f7",
                                "text": "„In einem erbitterten Kampf der Cheyenne und Shoshonen wird von einer blutdürstigen Frau der Cheyenne berichtet, die Coup zählt, wehrlose Gefangene verwundet und skalpiert[…]“"
                            },
                            {
                                "example_id": "ee0d8f9d-2f5d-4b63-bf49-e5607872e87e",
                                "sense_id": "722ddeec-221d-3f96-a696-86dd522c21f7",
                                "text": "„Zu den Jägern, also schweifenden Stämmen, gehören die Apachen, Navahos, Utas und einige Shoshonen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "37701ecf-0434-3eac-b19f-e679cd2e5bdc",
                        "entry_id": "079346b0-1a93-3aa0-8203-83599d828468",
                        "glosses": [
                            "Angehöriger des gleichnamigen nordamerikanischen Indianervolks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43484760-c0a6-4a26-bdb2-a544827d2c91",
                                "sense_id": "37701ecf-0434-3eac-b19f-e679cd2e5bdc",
                                "text": "„Sie fanden einige Shoshone, die schon lange nicht mehr glaubten, jemals Recht zu bekommen und bereit waren, das Geld anzunehmen.“"
                            },
                            {
                                "example_id": "5f1b78f8-3fc0-4455-9f68-8812a682e824",
                                "sense_id": "37701ecf-0434-3eac-b19f-e679cd2e5bdc",
                                "text": "„Beim Feilschen mit einer Gruppe von Shoshonen um 30 Pferde für den Treck über die Rocky Mountains traf die dolmetschende Sacajawea unverhofft ihren älteren Bruder Cameahwait wieder[…]“"
                            },
                            {
                                "example_id": "a0c7a573-5304-40df-9ccc-61e1f020088d",
                                "sense_id": "37701ecf-0434-3eac-b19f-e679cd2e5bdc",
                                "text": "„Noch ehe er 20 Jahre alt war, hatte er an 19 Kämpfen teilgenommen und war sechs mal verwundet worden. In einem der Gefechte schoss ihm ein Shoshone eine Kugel in den Rücken, was ihm das Reiten über größere Entfernungen erschwerte und ihn später von Kriegszügen abhielt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
