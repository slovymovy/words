                ],
                "senses": [
                    {
                        "sense_id": "ed003353-9214-3b36-b5cc-405a69067729",
                        "entry_id": "5f8567cc-e463-3fea-a256-6ef02512db83",
                        "glosses": [
                            "Personne chargée de faire des rondes de surveillance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fb9e1bf-f0e3-4e56-a321-adfd5b0f27df",
                                "sense_id": "ed003353-9214-3b36-b5cc-405a69067729",
                                "text": "Le récit suivant est extrait d’un entretien avec un rondier d’une entreprise nécessitant ce genre de postes pour des raisons de sécurité et de risque par rapport à l’environnement."
                            },
                            {
                                "example_id": "2e8b9b13-4061-467d-8c72-03841ab7430c",
                                "sense_id": "ed003353-9214-3b36-b5cc-405a69067729",
                                "text": "Tandis que les opérateurs - les chefs de bloc - en salle de commande suivent la charge et le fonctionnement des installations, les rondiers débutent leur périple."
                            }
                        ]
                    },
                    {
                        "sense_id": "08ecef4a-0b1d-3be5-b066-f6d59cb6a61c",
                        "entry_id": "5f8567cc-e463-3fea-a256-6ef02512db83",
                        "glosses": [
                            "Nom vernaculaire donné à plusieurs palmiers du genre Borassus et en particulier à Borassus flabellifer."
                        ],
