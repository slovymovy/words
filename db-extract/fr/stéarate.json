                "senses": [
                    {
                        "sense_id": "2991d198-9ddb-368e-8db6-1fc946f34327",
                        "entry_id": "461154f3-9e93-35e5-b410-4aa83dd98dc3",
                        "glosses": [
                            "Sel qui résulte de la combinaison de l’acide stéarique avec une base."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bf264ce-fca8-4fa8-be3a-0bc85bd5d2bb",
                                "sense_id": "2991d198-9ddb-368e-8db6-1fc946f34327",
                                "text": "Les oléates alcalins, mélangés avec les stéarates et les palmitates, constituent des savons. Ceux-ci sont d'autant plus mous qu'ils contiennent plus d’oléates de potasse, et d'autant plus durs qu'ils sont plus riches en stéarates et palmitates de soude."
                            },
                            {
                                "example_id": "b1b8e666-a848-4107-8d00-d36cdd5226a1",
                                "sense_id": "2991d198-9ddb-368e-8db6-1fc946f34327",
                                "text": "Quel que fût l’état de la mer, dès que je quittais le ponton j’avais en bouche ce remède au sorbitol, à l’aspartame, au stéarate de magnésium et à l’huile de menthe dont j'espérais des miracles."
                            }
                        ]
                    }
                ],
