        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ecedd94f-3472-3dbf-8bc6-174dc59e0e5f",
                    "sense_definition": "A barmaid who wears very little clothing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "revealing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local pub is famous for employing <w>skimpies</w> during the weekend.",
                            "target_lang_translations": {
                                "cs": "Místní hospoda je známá tím, že o víkendech zaměstnává barmanky v <w>sporém oblečení</w>."
                            }
                        },
                        {
                            "text": "Many tourists were surprised to see <w>skimpies</w> working behind the bar.",
                            "target_lang_translations": {
                                "cs": "Mnoho turistů bylo překvapeno, když za barem viděli barmanky v <w>sporém oblečení</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Primarily used in Australian English."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Barman(ka), který(á) nosí velmi málo oblečení (australský slang)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "barmanka ve sporém oblečení",
                                "target_lang_sense_clarification": "ustálený český výraz neexistuje"
                            }
                        ]
                    }
                }
            ]
        }
    ]
