                                        "sense_id": "542c7e21-6a34-3d4e-9444-9dc7c994ae14",
                                        "entry_id": "a75108cd-ad14-3632-bd2a-1d01d6c2aaf0",
                                        "glosses": [
                                            "Beta, genre de plantes de la famille des Amaranthacées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b3168d0-e6e5-4d80-acd7-14627018e656",
                                                "sense_id": "542c7e21-6a34-3d4e-9444-9dc7c994ae14",
                                                "text": "Les terrains imprégnés de sel disparaissaient sous les ansérines, les arroches, les bettes, celles-ci glauques, celles-là rougeâtres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d7ae64f-806f-390d-8ea3-36ad41d55824",
                                        "entry_id": "a75108cd-ad14-3632-bd2a-1d01d6c2aaf0",
                                        "glosses": [
                                            "Beta vulgaris L., la bette ordinaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f20ccd13-d00b-4e51-97fc-0df774b22da3",
                                                "sense_id": "4d7ae64f-806f-390d-8ea3-36ad41d55824",
                                                "text": "Une planche de bettes."
                                            },
                                            {
                                                "example_id": "6380e2a9-85ba-46dd-9f9f-10de04fe15d8",
                                                "sense_id": "4d7ae64f-806f-390d-8ea3-36ad41d55824",
                                                "text": "Manger des bettes."
                                            },
                                            {
                                                "example_id": "ce6f3662-ad27-40a8-b26b-9e47ea5b034f",
                                                "sense_id": "4d7ae64f-806f-390d-8ea3-36ad41d55824",
                                                "text": "Ma mère confectionnait des omelettes sans œufs et des entremets à la margarine, où la saccharine remplaçait le sucre ; elle nous servait de la viande frigorifiée, des biftecks de cheval et de tristes légumes : crosnes, topinambours, bettes, artichauts de Jérusalem."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c469ba5-746d-3859-964a-db3eb6f2a5ba",
                                        "entry_id": "a75108cd-ad14-3632-bd2a-1d01d6c2aaf0",
                                        "glosses": [
                                            "Betterave."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65796c8c-0190-45da-930d-d4045a818e30",
                                                "sense_id": "1c469ba5-746d-3859-964a-db3eb6f2a5ba",
                                                "text": "Bette. Se dit, dans la région de Québec, pour Betterave."
                                            },
                                            {
                                                "example_id": "3828f404-1706-4852-8e29-cc1c5b68c390",
                                                "sense_id": "1c469ba5-746d-3859-964a-db3eb6f2a5ba",
                                                "text": "Tu sais ce merveilleux temps des bettes, des concombres, du blé d’Inde, tu sais l’émotion de constater, de toucher, de mordre, d’avaler une année encore les offrandes affriolantes de la terre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "842795c0-1d24-3a3e-90e0-80319cebb554",
                                        "entry_id": "a75108cd-ad14-3632-bd2a-1d01d6c2aaf0",
                                        "glosses": [
                                            "Tête de quelqu’un, au sens de l’image qu’elle projette, de l’expression qui l’anime."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8df7bd59-d37b-4936-96cd-c8328d788c46",
                                                "sense_id": "842795c0-1d24-3a3e-90e0-80319cebb554",
                                                "text": "Vous auriez dû voir la bette de ma mère lorsqu’elle m’a vu à la télé la première fois alors que je tenais un gros berger allemand au concours de chiens. Je n’avais même pas de chien."
                                            }
                                        ]
                                    }
