                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9582de76-92cc-437f-8f8d-c74f24a35130",
                                "sense_id": "a338459d-0fe4-3158-91b1-5b4a81be8d97",
                                "text": "Compared to Colva and Benaulim, Palolem 's accommodations are overpriced and underkept — expect to pay Rs200 in season for the privilege of crashing in a charmless double and using a common bathroom outside."
                            },
                            {
                                "example_id": "e673f1e7-2b1f-4d8b-a26d-c583ecf0cd71",
                                "sense_id": "a338459d-0fe4-3158-91b1-5b4a81be8d97",
                                "text": "Most houses on Oakland Ave. have large basements that are underkept."
                            }
                        ]
                    }
