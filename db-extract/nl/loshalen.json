        "nl-extract.jsonl": [
            {
                "entry_id": "9f20a31b-1757-329a-a245-d958f184957f",
                "word": "loshalen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0adc4d8c-6ea6-364b-b364-283144b01c75",
                        "entry_id": "9f20a31b-1757-329a-a245-d958f184957f",
                        "glosses": [
                            "los maken wat eerst is vastgemaakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13413c87-c284-4f72-b20b-1cb6b594a2b4",
                                "sense_id": "0adc4d8c-6ea6-364b-b364-283144b01c75",
                                "text": "Kelly, een partijprominent van Sinn Fein, trof zijn auto met wielklem aan na een bezoekje aan de sportschool. Op de beelden is te zien hoe Kelly - die zijn voorbeeldfunctie kennelijk even ’vergeten’ is - de klem loshaalt en op de stoep legt. Naast de auto ligt op dat moment een grote betonschaar."
                            },
                            {
                                "example_id": "f2739e13-10e4-46d9-81b3-4978135baac8",
                                "sense_id": "0adc4d8c-6ea6-364b-b364-283144b01c75",
                                "text": "Op de bodem gaat de frangipane en daa bovenop de appelvulling. Voor een rustieke look, kun je de zijkanten van het deeg iets loshalen en naar binnen vouwen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "822cc607-3f4f-4ac8-b18b-f4e4d288926c",
                        "source_entry_id": "9f20a31b-1757-329a-a245-d958f184957f",
                        "source_sense_id": "0adc4d8c-6ea6-364b-b364-283144b01c75",
                        "target_lang_word": "unpick",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unpick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "45bce65e-35cc-3733-b258-a4276279cbf2",
                                        "entry_id": "fd9aa6f8-e317-3a30-ac82-ea3532cc896d",
                                        "glosses": [
                                            "To undo sewing stitches."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f896c00-9b72-3cd6-b89f-d726f3fa635e",
                                        "entry_id": "fd9aa6f8-e317-3a30-ac82-ea3532cc896d",
                                        "glosses": [
                                            "To undo knitting in order to reuse the wool."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a81e960e-6a9e-3154-9326-77bdf49f1b37",
                                        "entry_id": "fd9aa6f8-e317-3a30-ac82-ea3532cc896d",
                                        "glosses": [
                                            "To unravel or untangle the threads of a rope etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "229de7b5-5f83-3f42-8610-096f627f7b8f",
                                        "entry_id": "fd9aa6f8-e317-3a30-ac82-ea3532cc896d",
                                        "glosses": [
                                            "To unfold; to solve."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2151e2b2-9d2c-4110-b709-dc2c811215ce",
                                                "sense_id": "229de7b5-5f83-3f42-8610-096f627f7b8f",
                                                "text": "Scientists are attempting to unpick the mystery of the “photic sneeze” – a bizarre reflex that causes people to sternutate, or sneeze, in response to bright light – and they need your help."
                                            },
                                            {
                                                "example_id": "9ed827d8-9c85-4433-a627-a5bbcaa0704b",
                                                "sense_id": "229de7b5-5f83-3f42-8610-096f627f7b8f",
                                                "text": "We're going to hazard a guess that 'apple cider vinegar benefits' has been something you've typed into Google a time or two, trying to unpick exactly why your best wellness mate has said you just have to try it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b8dba23-49ad-3837-9545-a9897cc2119c",
                                        "entry_id": "fd9aa6f8-e317-3a30-ac82-ea3532cc896d",
                                        "glosses": [
                                            "To disassemble, to undo."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8db24d08-3a78-4b97-b08f-9e53dc899483",
                                                "sense_id": "3b8dba23-49ad-3837-9545-a9897cc2119c",
                                                "text": "The home team eventually started to unpick the Town defence and Fabregas forced a saved from visiting goalkeeper Marton Fulop after collecting a pass from Bendtner, who played on the right side of the front line."
                                            },
                                            {
                                                "example_id": "fb1959c8-6a45-47a4-9ea9-9f12e041bde7",
                                                "sense_id": "3b8dba23-49ad-3837-9545-a9897cc2119c",
                                                "text": "Any plan to unpick the carefully constructed compromise to keep the Irish border free of checkpoints will enrage other European governments, especially Dublin’s."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e709b9f1-d6bc-322a-befd-c1ee710338b6",
                                        "entry_id": "fd9aa6f8-e317-3a30-ac82-ea3532cc896d",
                                        "glosses": [
                                            "To take apart; criticize harshly."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cc9fd21-3ffb-4600-96e3-941bff0f64f7",
                                                "sense_id": "e709b9f1-d6bc-322a-befd-c1ee710338b6",
                                                "text": "These compulsive men – and a handful of equally obsessive ‘femcels’ – have been likened to terrorists, and their forum posts have been unpicked ad nauseam."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec8cedcf-0d28-344e-8d0e-47018b7a9a6e",
                                        "entry_id": "fd9aa6f8-e317-3a30-ac82-ea3532cc896d",
                                        "glosses": [
                                            "To deselect."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec93760d-9844-4317-a174-3d3de4699ed5",
                        "source_entry_id": "9f20a31b-1757-329a-a245-d958f184957f",
                        "source_sense_id": "0adc4d8c-6ea6-364b-b364-283144b01c75",
                        "target_lang_word": "pull out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pull out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84993ed3-62d8-3cde-af0e-30da34d83298",
                                        "entry_id": "9aad87db-e28e-3ac0-a61f-87115ef3910f",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see pull, out."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b7f1d69-89fa-4dc6-b057-65791cc26adb",
                                                "sense_id": "84993ed3-62d8-3cde-af0e-30da34d83298",
                                                "text": "I need to pull the splinter out of my hand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01cb3729-eba5-39bb-b1a1-cdf9cc4e0230",
                                        "entry_id": "9aad87db-e28e-3ac0-a61f-87115ef3910f",
                                        "glosses": [
                                            "To withdraw; especially of military forces; to retreat."
                                        ],
                                        "tags": [
                                            "also",
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51ac0488-a05e-43ba-9627-609aaa94eaf9",
                                                "sense_id": "01cb3729-eba5-39bb-b1a1-cdf9cc4e0230",
                                                "text": "The troops pulled out of the conflict."
                                            },
                                            {
                                                "example_id": "ed2df8ef-58d9-40a1-a19b-4798f5e71da9",
                                                "sense_id": "01cb3729-eba5-39bb-b1a1-cdf9cc4e0230",
                                                "text": "The mayor pulled out of the race for Senate after numerous opinion polls had him polling at less than 10 percent."
                                            },
                                            {
                                                "example_id": "61572bb4-406a-44a5-bba9-e4cba354ea7b",
                                                "sense_id": "01cb3729-eba5-39bb-b1a1-cdf9cc4e0230",
                                                "text": "The racehorse pulled out of the Stakes with a hurt foot."
                                            },
                                            {
                                                "example_id": "2f647e5a-97e2-4291-bc44-57faaa039083",
                                                "sense_id": "01cb3729-eba5-39bb-b1a1-cdf9cc4e0230",
                                                "text": "Pulling out of Paris would cause serious diplomatic damage."
                                            },
                                            {
                                                "example_id": "52f1145e-e264-43e9-a1f7-99cf207219b0",
                                                "sense_id": "01cb3729-eba5-39bb-b1a1-cdf9cc4e0230",
                                                "text": "There is still time to find a buyer and for them to stabilise the operation, especially if the deal were done by 31 May – when the club’s special licence to carry on is due to expire. There remain plenty of interested parties, who can only see Chelsea’s price dropping as sponsors pull out or consider their associations; as revenue streams are hit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8269eb62-1c2d-3eaa-b8b9-f3b2382a38cc",
                                        "entry_id": "9aad87db-e28e-3ac0-a61f-87115ef3910f",
                                        "glosses": [
                                            "To transition from a dive to level or climbing flight."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8ec917e-6c5b-4c4a-8b53-f4e26080c364",
                                                "sense_id": "8269eb62-1c2d-3eaa-b8b9-f3b2382a38cc",
                                                "text": "After releasing its bomb, the plane pulled out of its dive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5059e3af-bff9-3c7c-aa35-1cd331307a3f",
                                        "entry_id": "9aad87db-e28e-3ac0-a61f-87115ef3910f",
                                        "glosses": [
                                            "To use coitus interruptus as a method of birth control."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfd36f06-3b59-4d54-ae64-88e5060c51ac",
                                                "sense_id": "5059e3af-bff9-3c7c-aa35-1cd331307a3f",
                                                "text": "Shortly before you ejaculate, you can pull out and use your hand (or hers) to push yourself over the edge. Some of my patients claim this is a more natural method of birth control[…]"
                                            },
                                            {
                                                "example_id": "b46e68dc-c7c5-4026-91e1-174704170ff2",
                                                "sense_id": "5059e3af-bff9-3c7c-aa35-1cd331307a3f",
                                                "text": "She'd long since caught the knack of moving with him, and closed her arms and legs around him. “You'll fly with me, Tiberius? Take the last fence with me?” He'd meant to pull out. Coitus interruptus was a term even the scholars failing their Latin knew before they left public school."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c82de0e-90c3-3e71-8ed7-0a63397d9c41",
                                        "entry_id": "9aad87db-e28e-3ac0-a61f-87115ef3910f",
                                        "glosses": [
                                            "To remove something from a container."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "216a0f5b-9494-4849-a430-a8abcfac8f29",
                                                "sense_id": "2c82de0e-90c3-3e71-8ed7-0a63397d9c41",
                                                "text": "He pulled his gun out before she had a chance to scream."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e84f4515-694e-3bf8-bd9e-552ff12efde0",
                                        "entry_id": "9aad87db-e28e-3ac0-a61f-87115ef3910f",
                                        "glosses": [
                                            "To maneuver a vehicle from the side of a road onto the lane."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9176ba4-86a1-47a3-9a83-5635eb4b65eb",
                                                "sense_id": "e84f4515-694e-3bf8-bd9e-552ff12efde0",
                                                "text": "When joining a road, you should check for traffic before pulling out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da9f0a2f-be3e-34b5-ab76-a5e2c47502b2",
                                        "entry_id": "9aad87db-e28e-3ac0-a61f-87115ef3910f",
                                        "glosses": [
                                            "To draw out or lengthen."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d3e0c06-6a02-4279-a372-e637a4dafe8a",
                        "source_entry_id": "9f20a31b-1757-329a-a245-d958f184957f",
                        "source_sense_id": "0adc4d8c-6ea6-364b-b364-283144b01c75",
                        "target_lang_word": "take out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "take out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b191b80a-9df3-3dd0-905c-3a5186d24476",
                                        "entry_id": "a6ed0f20-56ef-382c-87ce-c3419147d62f",
                                        "glosses": [
                                            "To remove."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3f4e1c7-9044-48a2-9824-623a6ccb951b",
                                                "sense_id": "b191b80a-9df3-3dd0-905c-3a5186d24476",
                                                "text": "Thanks to that penny he had just spent so recklessly [on a newspaper] he would pass a happy hour, taken, for once, out of his anxious, despondent, miserable self. It irritated him shrewdly to know that these moments of respite from carking care would not be shared with his poor wife, with careworn, troubled Ellen."
                                            },
                                            {
                                                "example_id": "c4b252d1-fb9c-486f-84a7-65bade530672",
                                                "sense_id": "b191b80a-9df3-3dd0-905c-3a5186d24476",
                                                "text": "At the same time, three sets of obsolete angle point protectors (used for slip connections), which were considered unsatisfactory, were taken out and several redundant connections removed."
                                            },
                                            {
                                                "example_id": "5d37aff5-8d67-4115-9e40-45b3360ee2a6",
                                                "sense_id": "b191b80a-9df3-3dd0-905c-3a5186d24476",
                                                "text": "In France, 27% of voters are currently backing the Front National, a party determined to take the country out of the Paris accord, which it sees as “a communist project”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bcdc2aa-a818-3087-bf76-5811df45fd20",
                                        "entry_id": "a6ed0f20-56ef-382c-87ce-c3419147d62f",
                                        "glosses": [
                                            "To escort someone on a date."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "424052a0-21b9-4951-b06a-96617cced09d",
                                                "sense_id": "8bcdc2aa-a818-3087-bf76-5811df45fd20",
                                                "text": "Let me take you out for dinner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bfb1c7d-b42f-3627-a395-a96cf0a9aca2",
                                        "entry_id": "a6ed0f20-56ef-382c-87ce-c3419147d62f",
                                        "glosses": [
                                            "To immobilize with force; to subdue; to incapacitate."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0448749d-7877-4e24-8228-aaf051f3bbe4",
                                                "sense_id": "4bfb1c7d-b42f-3627-a395-a96cf0a9aca2",
                                                "text": "I don't know if he's close by. He's unarmed, though. He lost his gun when I took him out."
                                            },
                                            {
                                                "example_id": "2bcf2d03-091c-461d-a69d-4423d4b69963",
                                                "sense_id": "4bfb1c7d-b42f-3627-a395-a96cf0a9aca2",
                                                "text": "I tore right through it and took him to the ground and knocked him out cold, \"Ralph, oh your going to pay for that.\" he said and he started fighting me which he was good but not good enough and I took him out in no time."
                                            },
                                            {
                                                "example_id": "563795c7-72ef-422e-9cd2-e003770f0d04",
                                                "sense_id": "4bfb1c7d-b42f-3627-a395-a96cf0a9aca2",
                                                "text": "\"Heard a rumor you took out Mr. Hassel.\" He mimes a punch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b7a5cd1-f905-399d-98d9-a0c3003e4716",
                                        "entry_id": "a6ed0f20-56ef-382c-87ce-c3419147d62f",
                                        "glosses": [
                                            "To obtain by application by a legal or other official process."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f53a84e-5d07-4acf-985b-139f47c8f815",
                                                "sense_id": "9b7a5cd1-f905-399d-98d9-a0c3003e4716",
                                                "text": "take out a loan;  take out medical insurance;  take out a membership;  take out a patent"
                                            },
                                            {
                                                "example_id": "fd2c0c9b-a641-4989-820a-dd04a13cf958",
                                                "sense_id": "9b7a5cd1-f905-399d-98d9-a0c3003e4716",
                                                "text": "Southwark council, which took out the injunction against Matt, believes YouTube has become the \"new playground\" for gang members."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3ff8b57-9695-3bac-b60e-e5c0c47fe5a1",
                                        "entry_id": "a6ed0f20-56ef-382c-87ce-c3419147d62f",
                                        "glosses": [
                                            "To kill or destroy."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a35e01a-af00-4193-8f20-f6ea133f791c",
                                                "sense_id": "e3ff8b57-9695-3bac-b60e-e5c0c47fe5a1",
                                                "text": "The soldiers were instructed to take out the enemy base by any means necessary."
                                            },
                                            {
                                                "example_id": "c13cea3e-9515-4483-9624-5b15885d60d8",
                                                "sense_id": "e3ff8b57-9695-3bac-b60e-e5c0c47fe5a1",
                                                "text": "Anyway, one of the snipers took him out."
                                            },
                                            {
                                                "example_id": "eac8f74a-6646-432e-a515-287f9b39ad25",
                                                "sense_id": "e3ff8b57-9695-3bac-b60e-e5c0c47fe5a1",
                                                "text": "Boss told me when the guy was done, I should take him out."
                                            },
                                            {
                                                "example_id": "36f0e063-22e7-41c7-961b-e88b8c44cf83",
                                                "sense_id": "e3ff8b57-9695-3bac-b60e-e5c0c47fe5a1",
                                                "text": "Before he could get a shot off, Wilder took him out with two shots to the chest, just as Roderick took out the third shooter."
                                            },
                                            {
                                                "example_id": "e76c9c6a-ceaa-444c-a88f-76affc254c0f",
                                                "sense_id": "e3ff8b57-9695-3bac-b60e-e5c0c47fe5a1",
                                                "text": "The Johnston emerges from a smokescreen to find the Haruna at close range. So of course it shoots up the battleship's superstructure whilst ducking back into the smoke as Kongō tries to take it out using its main battery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6447cc42-668f-3015-b628-c9338b2c564b",
                                        "entry_id": "a6ed0f20-56ef-382c-87ce-c3419147d62f",
                                        "glosses": [
                                            "To stun, amaze; to kill."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8ac9b05-e417-4433-a4b5-eb02b9d7bfb5",
                                                "sense_id": "6447cc42-668f-3015-b628-c9338b2c564b",
                                                "text": "These photos are taking me out."
                                            },
                                            {
                                                "example_id": "d370d412-483c-486f-a56a-8f169f71de28",
                                                "sense_id": "6447cc42-668f-3015-b628-c9338b2c564b",
                                                "text": "User directional transsexual (@north0fnorth) added: \"Playing 'Empire State of Mind' while wheeling out the kind of trash bin that every other major U.S. city has had forever and calling it a revolution is taking me out.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3b7df47-1a41-3e3c-9efd-87f6f9da4618",
                                        "entry_id": "a6ed0f20-56ef-382c-87ce-c3419147d62f",
                                        "glosses": [
                                            "To win a sporting event, competition, premiership, etc."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "take out",
                                "target_lang_code": "en",
                                "target_senses": [
