                "senses": [
                    {
                        "sense_id": "91f271db-2792-39ce-a679-ce6956332c74",
                        "entry_id": "a5eb24e6-6c72-302f-bd64-5a73556a163f",
                        "glosses": [
                            "привозившееся из-за границы виноградное вино высокого качества"
                        ],
                        "tags": [
                            "в допетровской Руси"
                        ],
                        "examples": [
                            {
                                "example_id": "0a6f6000-7f48-4580-8cd8-9a4651988699",
                                "sense_id": "91f271db-2792-39ce-a679-ce6956332c74",
                                "text": "На столе горела толстая восковая свеча в серебряном шандале немецкой работы. Тут же, рядом со свечой, стоял вычурный жбан с романеей и золоченая стопка."
                            }
                        ]
                    },
                    {
                        "sense_id": "559fbe82-0357-3f04-accf-267c75003ec2",
                        "entry_id": "a5eb24e6-6c72-302f-bd64-5a73556a163f",
                        "glosses": [
                            "устар. сладкое вино; сладкая настойка на фряжском вине"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51f97396-71dc-4459-8797-69e09f822fb1",
                                "sense_id": "559fbe82-0357-3f04-accf-267c75003ec2",
                                "text": "Кушай, князь, не брезгай нашей хлебом-солью! Чем богаты, тем и рады! Вот романея, вот венгерское, вот мед малиновый…"
                            }
                        ]
                    }
