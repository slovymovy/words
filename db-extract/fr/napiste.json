                        "glosses": [
                            "Qualifie les partisans du Parti russe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb3872fe-b130-4bd2-bdec-66d7dfc3015d",
                                "sense_id": "dc5778f0-ca37-3323-913d-3a9a5fd3fac1",
                                "text": "Le parti napiste, autrement dit le parti russe, fidèle aux traditions de M. Capo-d’Istria, veut la prépondérance de l’église dans l’état. Les plus exagérés du parti vont même jusqu’à réclamer un changement de dynastie, vu que le roi actuel est catholique, et que ses intérêts religieux sont en opposition avec ceux de l’église orthodoxe."
                            }
                        ]
                    }
