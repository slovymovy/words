                                "sense_id": "47600307-26c7-33b9-a8ab-b4df278bf29e",
                                "text": "In het hoogland kan het weer snel veranderen.",
                                "translation": "The weather can change rapidly in the highland.",
                                "english": "The weather can change rapidly in the highland."
                            },
                            {
                                "example_id": "f3cb5c8d-ec55-4be1-aca6-afcb65385e69",
                                "sense_id": "47600307-26c7-33b9-a8ab-b4df278bf29e",
                                "text": "Veel traditionele culturen leven nog steeds in afgelegen hooglanden.",
                                "translation": "Many traditional cultures still live in remote highlands.",
                                "english": "Many traditional cultures still live in remote highlands."
                            }
