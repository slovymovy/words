                                        "examples": [
                                            {
                                                "example_id": "26d2134a-730f-4c4c-9bdb-13bf0a0d68e2",
                                                "sense_id": "f8503f4d-4e50-3a70-a77d-2c1b295cae4b",
                                                "text": "Now only two [men], and now only one, is left, and you see only ghostlike shirt with the sleeve garters, and sober mystery of his mild face […]"
                                            },
