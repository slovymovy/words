                "entry_id": "db73d5c7-91b8-3b35-a11d-602df6a5e698",
                "word": "ruscisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "19d4e63f-77ca-4b45-9273-c49f8c32e265",
                        "entry_id": "db73d5c7-91b8-3b35-a11d-602df6a5e698",
                        "tags": [
                            "plural"
                        ],
                        "form": "ruscismes"
