                ],
                "senses": [
                    {
                        "sense_id": "8dc0debd-3f7b-3ae5-af31-e2efe6375361",
                        "entry_id": "a0a46a5a-9a0c-3602-9d93-07a7be11eabe",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e2abe1e-1046-44bf-9b8c-08dc68a0cdfa",
                                "sense_id": "8dc0debd-3f7b-3ae5-af31-e2efe6375361",
                                "text": "Frau Kiesle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "0e761376-0be5-4879-a35c-682cb6f99f13",
                                "sense_id": "8dc0debd-3f7b-3ae5-af31-e2efe6375361",
                                "text": "Herr Kiesle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2e0c2a30-25b4-4d05-9844-2411182c8d33",
                                "sense_id": "8dc0debd-3f7b-3ae5-af31-e2efe6375361",
                                "text": "Die Kiesles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "72d641ee-1d01-4d35-9193-7b22209b2a4c",
                                "sense_id": "8dc0debd-3f7b-3ae5-af31-e2efe6375361",
                                "text": "Der Kiesle trägt nie die Pullover, die die Kiesle ihm strickt."
                            },
                            {
                                "example_id": "d58d54fd-b80e-4aed-a1b6-dd1fc91452ac",
                                "sense_id": "8dc0debd-3f7b-3ae5-af31-e2efe6375361",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kiesle kommt, geht der Herr Kiesle.“"
                            },
                            {
                                "example_id": "e96f48e4-cec7-4793-80d2-b489f982c9cc",
                                "sense_id": "8dc0debd-3f7b-3ae5-af31-e2efe6375361",
                                "text": "Kiesle kommt und geht."
                            },
                            {
                                "example_id": "e48347a0-6202-4105-bdbb-2d7ed80b1b25",
                                "sense_id": "8dc0debd-3f7b-3ae5-af31-e2efe6375361",
                                "text": "Kiesles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
