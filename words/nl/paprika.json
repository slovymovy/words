                    "frequency": "High",
                    "semantic_group_id": "groente",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik snijd een rode <w>paprika</w> in kleine blokjes voor de salade.",
                            "target_lang_translations": {
