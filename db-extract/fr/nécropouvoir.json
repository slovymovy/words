                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e2fc089-5951-4a1d-8df3-5b2c744e797f",
                                                "sense_id": "ae436c15-a0f1-3342-9d5a-9bd0ca207ac6",
                                                "text": "The portrayal in Kontroll of the underground space of the Budapest subway system as a site of potential resistance against the multiple manifestations of necropower, […]"
                                            },
                                            {
                                                "example_id": "bbf16d54-90b1-43a0-a6a2-d7037123cd58",
                                                "sense_id": "ae436c15-a0f1-3342-9d5a-9bd0ca207ac6",
                                                "text": "Exposure to the gorgoneion exposes the viewer to necropower; in the context of asylum the visibility of the asylum seeker thus potentially exposes the complicity of the normal situation in necropower."
                                            },
                                            {
                                                "example_id": "fe82c829-3604-45c3-8f0f-0392fd319c53",
                                                "sense_id": "ae436c15-a0f1-3342-9d5a-9bd0ca207ac6",
                                                "text": "In wielding this necropower the ultimate site of deployment of this new form of sovereignty is no longer the body as such, but the dead body of the African civilian."
                                            }
                                        ]
                                    }
                                ]
                            }
