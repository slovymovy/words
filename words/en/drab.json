{
    "word_family": [
        "drabness",
        "drabbish",
        "drably"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a1393eb9-68e3-3396-a4eb-885a5ac86b85",
                    "sense_definition": "Lacking brightness or interest; dull, cheerless, and uninspiring, especially in color or atmosphere.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "dullness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The office was painted in a <w>drab</w> grey that made the rainy afternoon feel even more depressing.",
                            "target_lang_translations": {
                                "ru": "Офис был выкрашен в <w>тусклый</w> серый цвет, из-за чего дождливый день казался еще более депрессивным."
                            }
                        },
                        {
                            "text": "He lived a <w>drab</w> life, working behind a bank counter and dreaming of far-off adventures.",
                            "target_lang_translations": {
                                "ru": "Он жил <w>серой</w> жизнью, работая за банковской стойкой и мечтая о далеких приключениях."
                            }
                        }
                    ],
                    "synonyms": [
                        "dull",
                        "dreary",
                        "dingy",
                        "uninspiring",
                        "colorless"
                    ],
                    "antonyms": [
                        "bright",
                        "vibrant",
                        "colorful",
                        "cheerful"
                    ],
                    "common_phrases": [
                        "drab colors",
                        "drab appearance",
                        "drab surroundings"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишенный яркости или интереса; скучный, унылый и невзрачный, особенно по цвету или атмосфере."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тусклый",
                                "target_lang_sense_clarification": "о цвете или атмосфере"
                            },
                            {
                                "target_lang_word": "серый",
                                "target_lang_sense_clarification": "невзрачный, скучный"
                            },
                            {
                                "target_lang_word": "однообразный",
                                "target_lang_sense_clarification": "лишенный интереса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9178b5ea-5598-3ff2-8a20-003bfa7b95e1",
                    "sense_definition": "Of a dull brownish-yellow or dun color, similar to that of heavy cloth.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers were dressed in <w>drab</w> uniforms that blended perfectly with the dusty landscape.",
                            "target_lang_translations": {
                                "ru": "Солдаты были одеты в <w>защитного</w> цвета форму, которая идеально сливалась с пыльным пейзажем."
                            }
                        },
                        {
                            "text": "She chose a <w>drab</w> olive coat to match her professional but understated style.",
                            "target_lang_translations": {
                                "ru": "Она выбрала пальто <w>тускло-оливкового</w> цвета, чтобы оно соответствовало ее профессиональному, но сдержанному стилю."
                            }
                        }
                    ],
                    "synonyms": [
                        "dun",
                        "brownish-yellow",
                        "khaki"
                    ],
                    "common_phrases": [
                        "olive drab"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тусклого коричневато-желтого или серовато-коричневого цвета, похожего на цвет грубой ткани."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "серовато-коричневый",
                                "target_lang_sense_clarification": "о цвете ткани"
                            },
                            {
                                "target_lang_word": "защитный",
                                "target_lang_sense_clarification": "о цвете униформы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4157488b-f2bb-3e49-84e6-5af316db1643",
                    "sense_definition": "A dull or uninteresting appearance, quality, or state of being.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dullness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>drab</w> of the industrial district was only broken by a few neon signs.",
                            "target_lang_translations": {
                                "ru": "<w>Серость</w> промышленного района нарушалась лишь несколькими неоновыми вывесками."
                            }
                        },
                        {
                            "text": "She felt trapped in the <w>drab</w> of her daily routine, longing for some excitement.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала себя в ловушке <w>однообразия</w> своей повседневной рутины, жаждя хоть какого-то оживления."
                            }
                        }
                    ],
                    "synonyms": [
                        "monotony",
                        "dullness"
                    ],
                    "antonyms": [
                        "vibrancy",
                        "excitement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скучный или неинтересный внешний вид, качество или состояние бытия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "серость",
                                "target_lang_sense_clarification": "отсутствие яркости"
                            },
                            {
                                "target_lang_word": "унылость",
                                "target_lang_sense_clarification": "скучное состояние"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00a39a54-7e50-39dd-9a2a-1a193f9a5bd0",
                    "sense_definition": "A dull brownish-yellow or grey color.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpet was woven in various shades of greens and <w>drabs</w> to hide the dirt.",
                            "target_lang_translations": {
                                "ru": "Ковер был соткан из различных оттенков зеленого и <w>серовато-коричневого</w>, чтобы скрыть грязь."
                            }
                        },
                        {
                            "text": "He preferred the subtle <w>drab</w> of natural wool over dyed fabrics.",
                            "target_lang_translations": {
                                "ru": "Он предпочитал неброский <w>естественный цвет</w> натуральной шерсти окрашенным тканям."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тусклый коричневато-желтый или серый цвет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "серовато-коричневый цвет",
                                "target_lang_sense_clarification": "оттенок ткани"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28106e20-4ab0-331b-9da6-7b5668969756",
                    "sense_definition": "A small amount or portion of something, especially money or information.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness only gave them a few <w>drabs</w> of info to keep them interested.",
                            "target_lang_translations": {
                                "ru": "Свидетель выдал им лишь несколько <w>крупиц</w> информации, чтобы поддерживать их интерес."
                            }
                        },
                        {
                            "text": "He spent his inheritance in small <w>drabs</w> until nothing was left.",
                            "target_lang_translations": {
                                "ru": "Он тратил свое наследство мелкими <w>частями</w>, пока ничего не осталось."
                            }
                        }
                    ],
                    "synonyms": [
                        "bit",
                        "scrap",
                        "driblet"
                    ],
                    "common_phrases": [
                        "dribs and drabs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое количество или порция чего-либо, особенно денег или информации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крупица",
                                "target_lang_sense_clarification": "малое количество информации"
                            },
                            {
                                "target_lang_word": "крохи",
                                "target_lang_sense_clarification": "незначительная сумма денег"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a863cfc-58a9-3ac8-86ac-67a6b19170c7",
                    "sense_definition": "A promiscuous woman or a prostitute.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old play depicted the protagonist wasting his fortune on dice and <w>drabs</w>.",
                            "target_lang_translations": {
                                "ru": "В старой пьесе главный герой растрачивал свое состояние на кости и <w>девок</w>."
                            }
                        },
                        {
                            "text": "He was warned to avoid the <w>drabs</w> that frequented the docks at night.",
                            "target_lang_translations": {
                                "ru": "Его предупреждали избегать <w>проституток</w>, которые часто бывали в доках по ночам."
                            }
                        }
                    ],
                    "synonyms": [
                        "harlot",
                        "strumpet",
                        "trollop",
                        "slut"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in historical or literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женщина легкого поведения или проститутка (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потаскуха",
                                "target_lang_sense_clarification": "грубое, устаревшее"
                            },
                            {
                                "target_lang_word": "проститутка",
                                "target_lang_sense_clarification": "женщина, предлагающая секс-услуги"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d1ac49d-5440-3ea0-be26-9a3c513bd2dc",
                    "sense_definition": "An instance of a transgender or non-binary person presenting as the gender assigned at birth rather than their internal identity.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "identity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When she is not performing in drag, she is often dressed in <w>drab</w>.",
                            "target_lang_translations": {
                                "ru": "Когда она не выступает в дрэг-образе, она часто одета в <w>обычную одежду</w>."
                            }
                        },
                        {
                            "text": "The community uses the term <w>drab</w> to describe presenting as one's birth sex.",
                            "target_lang_translations": {
                                "ru": "В сообществе термин <w>«дрэб»</w> используется для описания внешнего вида, соответствующего биологическому полу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dressed in drab"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Specific to the LGBTQ+ and drag communities"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Случай, когда трансгендерный человек или дрэг-артист предстает в обычном повседневном виде, соответствующем полу при рождении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повседневный образ",
                                "target_lang_sense_clarification": "вне сценического образа"
                            },
                            {
                                "target_lang_word": "цивильная одежда",
                                "target_lang_sense_clarification": "сленг сообщества"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d9c0d822-d7fa-380d-884e-97ba3c883a52",
                    "sense_definition": "To consort with prostitutes.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young lord spent his nights drinking and <w>drabbing</w> in the city's lower quarters.",
                            "target_lang_translations": {
                                "ru": "Молодой лорд проводил ночи, выпивая и <w>распутничая</w> в трущобах города."
                            }
                        },
                        {
                            "text": "He was known to <w>drab</w> with any woman who would have him.",
                            "target_lang_translations": {
                                "ru": "Он был известен тем, что <w>путался</w> с любой женщиной, которая была не прочь."
                            }
                        }
                    ],
                    "synonyms": [
                        "whore"
                    ],
                    "common_phrases": [
                        "drinking and drabbing"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in historical literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Общаться или проводить время с проститутками (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распутничать",
                                "target_lang_sense_clarification": "вести аморальный образ жизни"
                            },
                            {
                                "target_lang_word": "шляться",
                                "target_lang_sense_clarification": "по борделям"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}