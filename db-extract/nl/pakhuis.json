                    }
                ],
                "senses": [
                    {
                        "sense_id": "fc072c49-fad6-3c66-8e73-78ef215c26bf",
                        "entry_id": "3ababd12-001b-36a5-88e9-a3113f8da4a2",
                        "glosses": [
                            "een gebouw waar goederen worden opgeslagen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5221abc-ca79-48c5-901f-f00b19ee1634",
                                "sense_id": "fc072c49-fad6-3c66-8e73-78ef215c26bf",
                                "text": "'Die partij ligt daar maar in dat pakhuis, Johannes'."
                            },
                            {
                                "example_id": "abf82a1a-e959-42cd-b27a-fe1440f352a3",
                                "sense_id": "fc072c49-fad6-3c66-8e73-78ef215c26bf",
                                "text": "Hij kon erg geestig en beeldend vertellen en beschreef hoe hij twintig jaar geleden in Londen zwaar in de ‘underground acid dance scene’ had gezeten, op illegale feesten in verlaten pakhuizen die soms wel drie dagen duurden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d8c06cca-b897-49ed-9f25-ebd7006d5f26",
                        "source_entry_id": "3ababd12-001b-36a5-88e9-a3113f8da4a2",
                        "source_sense_id": "fc072c49-fad6-3c66-8e73-78ef215c26bf",
                        "target_lang_word": "Lagerhaus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lagerhaus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7a970dee-1e5a-3533-804e-d1fc3957659e",
                                        "entry_id": "f9e2b13c-0491-3353-bb20-925db7909fe0",
                                        "glosses": [
                                            "ein (meist großes) Gebäude, das zur Lagerung von Waren dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "312fbb0a-1670-492c-aa4d-46e45c8bbca0",
                                                "sense_id": "7a970dee-1e5a-3533-804e-d1fc3957659e",
                                                "text": "Die Lagerhäuser am Hafen sind bereits bis zum Bersten gefüllt."
                                            },
                                            {
                                                "example_id": "2cae68a7-3ed4-418d-aec3-6c5362a67ac4",
                                                "sense_id": "7a970dee-1e5a-3533-804e-d1fc3957659e",
                                                "text": "„Im Gänsemarsch kamen sie aus dem Lagerhaus heraus, marschierten am Fabrikgebäude vorbei und verschwanden im Dschungel.“"
                                            },
                                            {
                                                "example_id": "6ea9808b-c1dc-4fe7-ad16-2761224fa296",
                                                "sense_id": "7a970dee-1e5a-3533-804e-d1fc3957659e",
                                                "text": "„Die Lagerhäuser wurden geleert und die Kaufleute verließen Helgoland.“"
                                            },
                                            {
                                                "example_id": "507d3b95-e8ef-4d79-b6fe-f348fa4d1833",
                                                "sense_id": "7a970dee-1e5a-3533-804e-d1fc3957659e",
                                                "text": "„Wir zerstörten dort mehrere Boote und Lagerhäuser, zündeten die Kasernen an und fügten dem Feind jede Menge weitere Schäden zu, wonach wir den Ort verließen.“"
                                            },
                                            {
                                                "example_id": "8d4aadfb-ec90-4cac-bcf8-e45b882b8d11",
                                                "sense_id": "7a970dee-1e5a-3533-804e-d1fc3957659e",
                                                "text": "„Die Hitze eines brennenden Lagerhauses traf sie so heftig, dass sie in eine Nebenstraße ausweichen mussten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "421b94df-37d0-451d-bd3a-efabef2b4de8",
                        "source_entry_id": "3ababd12-001b-36a5-88e9-a3113f8da4a2",
                        "source_sense_id": "fc072c49-fad6-3c66-8e73-78ef215c26bf",
                        "target_lang_word": "warehouse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "warehouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11b8e501-a2ca-3faf-a195-7d2121a82120",
                                        "entry_id": "1709e971-d7e7-3f14-b71b-87a8e24185c5",
                                        "glosses": [
                                            "A place for storing large amounts of products. In logistics, a place where products go to from the manufacturer before going to the retailer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64e4de8e-9216-4a27-ba07-293d1027fa45",
                                                "sense_id": "11b8e501-a2ca-3faf-a195-7d2121a82120",
                                                "text": "Think of banking today and the image is of grey-suited men in towering skyscrapers. Its future, however, is being shaped in converted warehouses and funky offices in San Francisco, New York and London, where bright young things in jeans and T-shirts huddle around laptops, sipping lattes or munching on free food."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "warehouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58bb13cf-e6cd-32bb-8bf9-a32051aba5a2",
                                        "entry_id": "511ed3fe-7b90-367e-98c8-e23efee0b876",
                                        "glosses": [
                                            "To store in a warehouse or similar."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5696aa84-f320-46a0-93ba-1f39997931c7",
                                                "sense_id": "58bb13cf-e6cd-32bb-8bf9-a32051aba5a2",
                                                "text": "Tobacco, for instance, shrinks materially by frequent reshippings, and as all goods are warehoused as a convenience to importers, duties should be paid on what the importer receives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d281e7e6-0c56-3bdd-91f7-ae3d6c8d138b",
                                        "entry_id": "511ed3fe-7b90-367e-98c8-e23efee0b876",
                                        "glosses": [
                                            "To confine (a person) to an institution for a long period."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "089942bc-da4a-4d29-9481-6127aaae9fed",
                                                "sense_id": "d281e7e6-0c56-3bdd-91f7-ae3d6c8d138b",
                                                "text": "When our elders presented school to us, they did not present it as a place of high learning, but as a means of escape from death and penal warehousing."
                                            },
                                            {
                                                "example_id": "9cdd3a55-6be6-47ef-a239-30b781db0a13",
                                                "sense_id": "d281e7e6-0c56-3bdd-91f7-ae3d6c8d138b",
                                                "text": "We nevertheless pay hundreds of thousands of pounds to process many of these children through the criminal justice system, and to warehouse them for years – and even more if they end up graduating to adult prisons, as most of them do."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f625a07-a021-35a5-99e2-693f4b462a2e",
                                        "entry_id": "511ed3fe-7b90-367e-98c8-e23efee0b876",
                                        "glosses": [
                                            "To acquire and then shelve, simply to prevent competitors from acquiring it."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0aa56ed8-daba-4700-97f7-1a64015bbe5d",
                                                "sense_id": "0f625a07-a021-35a5-99e2-693f4b462a2e",
                                                "text": "the warehousing of syndicated TV shows"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52f66d8d-f725-4cb2-85b7-2f46747f3ba9",
                        "source_entry_id": "3ababd12-001b-36a5-88e9-a3113f8da4a2",
                        "source_sense_id": "fc072c49-fad6-3c66-8e73-78ef215c26bf",
                        "target_lang_word": "entrepôt",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entrepôt",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "012462d5-6bce-3423-99a6-eeafa7eb517d",
                                        "entry_id": "77eb08d5-3456-3e10-8f6a-5ede0a5992b9",
                                        "glosses": [
                                            "Lieu où l’on met des marchandises en dépôt."
                                        ],
                                        "tags": [
                                            "Logistique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67e2064f-92da-4ab7-87ad-9ad5abbec3d9",
                                                "sense_id": "012462d5-6bce-3423-99a6-eeafa7eb517d",
                                                "text": "« C’est un choc, mais nous nous réjouissons qu’il n’y ait pas de blessé », a déclaré Shaoul Abramczyk, président du groupe Les Halles Mandar, à qui appartenait l’entrepôt."
                                            },
                                            {
                                                "example_id": "1da2bdfe-d2df-4cab-91f7-b58358cad940",
                                                "sense_id": "012462d5-6bce-3423-99a6-eeafa7eb517d",
                                                "text": "Çà et là, ce sont des magasins, des entrepôts, des chais, ou bien le cube de béton d'une cave coopérative, sévère comme un blockhaus...."
                                            },
                                            {
                                                "example_id": "74357947-60fe-41df-84c4-d769e58fd63b",
                                                "sense_id": "012462d5-6bce-3423-99a6-eeafa7eb517d",
                                                "text": "Les entreprises de messagerie et de messagerie express exploitent des entrepôts locaux et régionaux qu'elles utilisent pour les opérations de groupage."
                                            },
                                            {
                                                "example_id": "d1e10a4c-8b34-4a80-8ae3-d3a078b8240d",
                                                "sense_id": "012462d5-6bce-3423-99a6-eeafa7eb517d",
                                                "text": "L’image aérienne vient d'en révéler l'importance en mettant en évidence une grande avenue, des monuments, et surtout, les horrea, grands entrepôts d'état, généralement associés à une activité portuaire."
                                            },
                                            {
                                                "example_id": "a70aafc2-2cb5-467b-a7e3-32553733a509",
                                                "sense_id": "012462d5-6bce-3423-99a6-eeafa7eb517d",
                                                "text": "La colère monte chez les routiers, mais aussi parmi les salariés des bases d’entrepôts logistiques et ceux des transports sanitaires, qui ne s’estiment pas protégés contre le coronavirus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d53ba9f7-0aa9-3ac5-a4a3-c31cf8f3c957",
                                        "entry_id": "77eb08d5-3456-3e10-8f6a-5ede0a5992b9",
                                        "glosses": [
                                            "Lieu où les marchandises peuvent rester déposées jusqu’à ce qu’on les exporte ou qu’on en acquitte les droits."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b775fe0d-7e58-4b3d-9a8e-a2b232b90baf",
                                                "sense_id": "d53ba9f7-0aa9-3ac5-a4a3-c31cf8f3c957",
                                                "text": "Marchandises en entrepôt."
                                            },
                                            {
                                                "example_id": "666d17ea-95d9-4cbc-ba93-3d5d161e5a37",
                                                "sense_id": "d53ba9f7-0aa9-3ac5-a4a3-c31cf8f3c957",
                                                "text": "Porter des marchandises à l’entrepôt."
                                            },
                                            {
                                                "example_id": "6178753f-58fc-4162-9609-1c7dad30b214",
                                                "sense_id": "d53ba9f7-0aa9-3ac5-a4a3-c31cf8f3c957",
                                                "text": "L’entrepôt des vins, des eaux-de-vie."
                                            },
                                            {
                                                "example_id": "de2961e1-c9ac-4c99-b812-a4b01f21b540",
                                                "sense_id": "d53ba9f7-0aa9-3ac5-a4a3-c31cf8f3c957",
                                                "text": "Entrepôt réel, entrepôt fictif. L’entrepôt réel est le magasin public, l’entrepôt fictif est le magasin privé où l’on entrepose des marchandises."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7fb8b20-8c86-3c48-9039-e513131b9fdf",
                                        "entry_id": "77eb08d5-3456-3e10-8f6a-5ede0a5992b9",
                                        "glosses": [
                                            "Magasin où l’on vend quelque marchandise pour le compte de l’état."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdf02217-c72a-41e7-bf73-1d5f55c7f903",
                                                "sense_id": "c7fb8b20-8c86-3c48-9039-e513131b9fdf",
                                                "text": "Un entrepôt de tabac."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afbfe3ee-67f3-352b-a697-9a27822cad9c",
                                        "entry_id": "77eb08d5-3456-3e10-8f6a-5ede0a5992b9",
                                        "glosses": [
                                            "Ville, d’un pays, où les marchandises sont déposées temporairement jusqu’à ce qu’on les expédie au lieu de leur consommation."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c781e797-5d35-423e-ae55-9d6712ff5736",
                                                "sense_id": "afbfe3ee-67f3-352b-a697-9a27822cad9c",
                                                "text": "Alexandrie fut longtemps l’entrepôt du commerce de l’Europe et de l’Asie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d5e0ab3-5693-3f7a-9606-f51ea43696ab",
                                        "entry_id": "77eb08d5-3456-3e10-8f6a-5ede0a5992b9",
                                        "glosses": [
                                            "Base, centre de données."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ac11608-26ad-40f9-8eb3-3b1adf839b0a",
                                                "sense_id": "5d5e0ab3-5693-3f7a-9606-f51ea43696ab",
                                                "text": "On y découvre que la Direction générale des finances publiques a en effet constitué « une équipe spécialisée qui réunit progressivement dans un entrepôt unique des données issues des applications professionnelles, personnelles et patrimoniales de la DGFiP ». Et c’est cet entrepôt qui sera nourri progressivement par les données de sources ouvertes, comme le précise cette fois le DPT 2019."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "739a5f65-f92f-4fcf-b529-189bb33f54ca",
                        "source_entry_id": "3ababd12-001b-36a5-88e9-a3113f8da4a2",
                        "source_sense_id": "fc072c49-fad6-3c66-8e73-78ef215c26bf",
                        "target_lang_word": "magasin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magasin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "480914de-7ffd-342f-b847-9bc02fc5f5c6",
                                        "entry_id": "9b86f27b-c579-3010-bc61-352e912da5a2",
                                        "glosses": [
                                            "Entrepôt, dépôt, réserve."
                                        ],
                                        "tags": [
                                            "Logistique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b197ac47-85da-46df-980c-b1732a230bd4",
                                                "sense_id": "480914de-7ffd-342f-b847-9bc02fc5f5c6",
                                                "text": "Et à côté du magasin, ou plus proprement de la salle de dépôt, il y avait un petit bureau."
                                            },
                                            {
                                                "example_id": "0b0df55e-7781-4567-a1a6-778d88d6163a",
                                                "sense_id": "480914de-7ffd-342f-b847-9bc02fc5f5c6",
                                                "text": "Avoir des marchandises en magasin."
                                            },
                                            {
                                                "example_id": "4dbec4de-20fd-48bd-8392-68227d920649",
                                                "sense_id": "480914de-7ffd-342f-b847-9bc02fc5f5c6",
                                                "text": "Les magasins généraux."
                                            },
                                            {
                                                "example_id": "ec779726-adfc-40be-a8c2-176256bae1d6",
                                                "sense_id": "480914de-7ffd-342f-b847-9bc02fc5f5c6",
                                                "text": "Ça et là, ce sont des magasins, des entrepôts, des chais, ou bien le cube de béton d’une cave coopérative, sévère comme un blockhaus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a329c48-a3c1-3dd5-9fce-3698eb8340ec",
                                        "entry_id": "9b86f27b-c579-3010-bc61-352e912da5a2",
                                        "glosses": [
                                            "Local où sont déposées des munitions et toutes sortes d’approvisionnements pour les armées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4634804-ce68-4553-81cb-f3a457e52077",
                                                "sense_id": "0a329c48-a3c1-3dd5-9fce-3698eb8340ec",
                                                "text": "Magasin d’armes, de poudre, etc."
                                            },
                                            {
                                                "example_id": "be0345ef-4b6c-4c16-9c6a-2d70a2f092fc",
                                                "sense_id": "0a329c48-a3c1-3dd5-9fce-3698eb8340ec",
                                                "text": "Magasins de vivres, de fourrages."
                                            },
                                            {
                                                "example_id": "216facc9-156c-4d7b-ac8b-7de4993c4ccc",
                                                "sense_id": "0a329c48-a3c1-3dd5-9fce-3698eb8340ec",
                                                "text": "L’intendance avait ses magasins à tel endroit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0eb6c50-0288-3617-8657-6c88233f300b",
                                        "entry_id": "9b86f27b-c579-3010-bc61-352e912da5a2",
                                        "glosses": [
                                            "Réceptacle, endroit où se loge une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "714f578d-d587-494e-a11f-9d693b55f83b",
                                                "sense_id": "e0eb6c50-0288-3617-8657-6c88233f300b",
                                                "text": "Magasin d’un fusil, d’un revolver : partie d’un fusil ou d’un revolver où se placent les cartouches."
                                            },
                                            {
                                                "example_id": "bfd0defa-fd89-4dc4-96fd-bbca99ce8c9d",
                                                "sense_id": "e0eb6c50-0288-3617-8657-6c88233f300b",
                                                "text": "Il y a les fusils de ces pauvres bougres, dans l’encoignure en face de vous. Donnez-m’en un. Quand le magasin sera vidé, vous me passerez l’autre."
                                            },
                                            {
                                                "example_id": "6345036b-980a-4cb8-b666-9953e2663348",
                                                "sense_id": "e0eb6c50-0288-3617-8657-6c88233f300b",
                                                "text": "Magasin d’un appareil photo : partie de l’appareil où se placent soit les plaques, soit les pellicules."
                                            },
                                            {
                                                "example_id": "eea2395e-0e4b-45ee-ad08-a556a3c4ce51",
                                                "sense_id": "e0eb6c50-0288-3617-8657-6c88233f300b",
                                                "text": "Avec la caméra 16 mm Aaton que j’utilisais, il faut changer de magasin toutes les onze minutes. Des magasins pleins étaient prêts, le changement s’opéra en un éclair et la conversation se poursuivit comme s’il n’y avait eu aucune interruption, Bomba ne s’en avisa pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b394b5c5-ba23-3053-8813-317e15418954",
                                        "entry_id": "9b86f27b-c579-3010-bc61-352e912da5a2",
                                        "glosses": [
                                            "Boutique, lieu de vente de produits ou de denrées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5b88501-db60-444a-abd5-f538cc83aa91",
                                                "sense_id": "b394b5c5-ba23-3053-8813-317e15418954",
                                                "text": "Employé de magasin, celui qui sert les clients, vendeur."
                                            },
                                            {
                                                "example_id": "c539523e-c79b-439b-9e31-9bc148d4cd57",
                                                "sense_id": "b394b5c5-ba23-3053-8813-317e15418954",
                                                "text": "Au retour, ils rencontrèrent un officier et deux hommes qui procédaient à un inventaire sommaire des marchandises utilisables que contenaient les magasins."
                                            },
                                            {
                                                "example_id": "1eea8b47-4b2c-46d9-a713-7b2715592dfe",
                                                "sense_id": "b394b5c5-ba23-3053-8813-317e15418954",
                                                "text": "Entre des maisons grises, des resserres, des magasins d’outillage, des bars, des trottoirs étroits, la rue de Lappe ouvrait sa médiocre perspective."
                                            },
                                            {
                                                "example_id": "f98795e5-c437-42e4-bb37-7e18485a48a4",
                                                "sense_id": "b394b5c5-ba23-3053-8813-317e15418954",
                                                "text": "Près du commissariat […] un magasin de nouveauté s’intitulait, en lettres énormes également : A la Belle Polonaise."
                                            },
                                            {
                                                "example_id": "44452b41-76b4-4cc7-97bc-f870ae12aa9a",
                                                "sense_id": "b394b5c5-ba23-3053-8813-317e15418954",
                                                "text": "Une à une les succursales des magasins de luxe parisiens, londoniens ou berlinois fermaient, devant rouvrir, l’été, dans les stations chic : Chamonix, Royat, ou Aix-les-Bains."
                                            },
                                            {
                                                "example_id": "fb188925-2e9d-4b34-aa4e-c1e093b5dd47",
                                                "sense_id": "b394b5c5-ba23-3053-8813-317e15418954",
                                                "text": "Par exemple, nous sommes allés dans un magasin de vêtements de seconde main il n'y a pas si longtemps et nous avons pris deux paires de pantalons à pattes d’éléphant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcd109ae-66f5-3cac-96ed-af72650d4b91",
                                        "entry_id": "9b86f27b-c579-3010-bc61-352e912da5a2",
                                        "glosses": [
                                            "Variante de magazine."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "783a2a92-7051-4938-a1c5-1f17d3c69b7f",
                                                "sense_id": "bcd109ae-66f5-3cac-96ed-af72650d4b91",
                                                "text": "Le Magasin pittoresque."
                                            },
                                            {
                                                "example_id": "f2fb2b8c-aa23-4315-9ac4-d8139ae761f9",
                                                "sense_id": "bcd109ae-66f5-3cac-96ed-af72650d4b91",
                                                "text": "Le magasin des enfants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dd3ad37-85d3-3721-8f11-9b3eaff138cb",
                                        "entry_id": "9b86f27b-c579-3010-bc61-352e912da5a2",
                                        "glosses": [
                                            "magasin dématérialisé"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18cd990b-c001-4ee2-8411-d14b0d4aeedc",
                                                "sense_id": "5dd3ad37-85d3-3721-8f11-9b3eaff138cb",
                                                "text": "Cette redevance oblige les développeurs d’applications et les magasins d’applications tiers à payer pour utiliser les principaux services d’Apple."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
