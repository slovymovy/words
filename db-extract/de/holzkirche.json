                ],
                "senses": [
                    {
                        "sense_id": "f76171d2-5c8f-3b9c-b693-660dcd389cf9",
                        "entry_id": "938cd288-67d2-37ae-baa9-5e9549cf8e76",
                        "glosses": [
                            "Versammlungsgebäude einer Glaubensgemeinschaft; Holzgebäude, das ganz aus Holz errichtet und zum Abhalten von Ritualen vorgesehen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94436f01-2992-436d-ba65-5f2881f5c4b7",
                                "sense_id": "f76171d2-5c8f-3b9c-b693-660dcd389cf9",
                                "text": "„Die Holzkirche von Joutsa hat fünfhundert Sitzplätze und befindet sich auf einem kleinen Hügel, nur wenige hundert Meter südlich des eigentlichen Ortskerns.“"
                            },
                            {
                                "example_id": "b7606669-d8cf-4ac4-95ad-7eaedae13dc9",
                                "sense_id": "f76171d2-5c8f-3b9c-b693-660dcd389cf9",
                                "text": "„Das Wahrzeichen der Gemeinde Elend ist die \"Kleinste Holzkirche Deutschlands\" mit einer Größe von 5,0 m x 11,0m und 80 Sitzplätzen.“"
                            },
                            {
                                "example_id": "7ea5072c-cc24-4279-acf3-f49e0d7132b2",
                                "sense_id": "f76171d2-5c8f-3b9c-b693-660dcd389cf9",
                                "text": "„Die Clausthaler Marktkirche „Zum Heiligen Geist“ ist die größte Holzkirche Europas. Sie wurde im 17. Jahrhundert errichtet und bietet 2.000 Menschen Platz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f02d88dc-0237-3c67-bc56-4f9aa9942d3c",
                        "entry_id": "938cd288-67d2-37ae-baa9-5e9549cf8e76",
