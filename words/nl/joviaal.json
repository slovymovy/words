    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0c53171e-f83f-3654-8470-13792f05c451",
                    "sense_definition": "Opgewekt en tegelijk aardig en vriendschappelijk in de omgang",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vriendelijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij begroette iedereen met een <w>joviale</w> glimlach.",
                            "target_lang_translations": {
                                "de": "Er begrüßte jeden mit einem <w>jovialen</w> Lächeln."
                            }
                        },
                        {
                            "text": "De gastheer was erg <w>joviaal</w> tegen al zijn bezoekers.",
                            "target_lang_translations": {
                                "de": "Der Gastgeber war zu all seinen Besuchern sehr <w>herzlich</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "amicaal"
                    ],
                    "common_phrases": [
                        "joviale groet"
                    ],
                    "target_lang_definitions": {
                        "de": "Heiter, leutselig und freundschaftlich im Umgang mit anderen Menschen"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "jovial",
                                "target_lang_sense_clarification": "herzlich-heiter und kontaktfreudig"
                            },
                            {
                                "target_lang_word": "leutselig",
                                "target_lang_sense_clarification": "freundlich und wohlwollend auf Menschen zugehend"
                            },
                            {
                                "target_lang_word": "herzlich",
                                "target_lang_sense_clarification": "von warmer, offener Freundlichkeit geprägt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e10c8cd9-e760-3df2-bdaa-cb476bc797e2",
                    "sense_definition": "Goedgunstig, genereus en gulhartig",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vriendelijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met een <w>joviaal</w> gebaar bood hij aan de rekening te betalen.",
                            "target_lang_translations": {
                                "de": "Mit einer <w>großzügigen</w> Geste bot er an, die Rechnung zu bezahlen."
                            }
                        },
                        {
                            "text": "Zijn <w>joviale</w> houding maakte hem erg geliefd bij zijn personeel.",
                            "target_lang_translations": {
                                "de": "Seine <w>warmherzige</w> Art machte ihn bei seinen Mitarbeitern sehr beliebt."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Großzügig, wohlwollend und warmherzig"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "großzügig",
                                "target_lang_sense_clarification": "freigiebig und wohlwollend"
                            },
                            {
                                "target_lang_word": "warmherzig",
                                "target_lang_sense_clarification": "gutherzig und liebevoll gesinnt"
                            },
                            {
                                "target_lang_word": "jovial",
                                "target_lang_sense_clarification": "von heiterer Großmut geprägt"
                            }
                        ]
                    }
                }
            ]
        }
    ]
