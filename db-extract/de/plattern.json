                ],
                "senses": [
                    {
                        "sense_id": "f986ee6a-da6e-3d89-8dda-e5061517c7ba",
                        "entry_id": "9b9da2f2-bffe-39d3-82e9-0c6c601ce9d5",
                        "glosses": [
                            "Tropfen fallen/Regen fällt auf oder gegen etwas (beispielsweise ein Dach, ein Fenster) und erzeugen dabei ein kurzes klopfendes Geräusch"
                        ],
                        "tags": [
                            "North German"
                        ],
                        "examples": [
                            {
                                "example_id": "c29d2bc5-44d1-469d-98eb-b1bd5155a88a",
                                "sense_id": "f986ee6a-da6e-3d89-8dda-e5061517c7ba",
                                "text": "„Der Regen platterte aufs Blechdach“ […]."
                            },
                            {
                                "example_id": "9bf44442-ef43-4a24-a808-2bb1b85db221",
                                "sense_id": "f986ee6a-da6e-3d89-8dda-e5061517c7ba",
                                "text": "„Der Regen platterte unaufhörlich auf das Blechdach über ihnen, tropfte von den Dachrinnen des Lagerhauses, platschte in die Pfützen, die sich auf dem Dock gebildet hatten.“"
                            },
                            {
                                "example_id": "2bdf5bc7-6180-4a38-9a08-0ea9f36e1751",
                                "sense_id": "f986ee6a-da6e-3d89-8dda-e5061517c7ba",
                                "text": "„Regen platterte auf die trockene, festgetretene Erde.“"
                            },
                            {
                                "example_id": "ce57454f-f64f-4a48-97e6-5858705d8508",
                                "sense_id": "f986ee6a-da6e-3d89-8dda-e5061517c7ba",
                                "text": "„Der Regen platterte so stark, dass sie im Nu durchnässt waren.“"
                            },
                            {
                                "example_id": "321021fd-90b1-4ba9-adff-424397aa7cc0",
                                "sense_id": "f986ee6a-da6e-3d89-8dda-e5061517c7ba",
                                "text": "„Immer wieder durchzuckten Blitze den Nachthimmel und Regen platterte gegen die Scheiben.“"
                            },
                            {
                                "example_id": "441313cf-6a56-4fed-b825-cf361ec16960",
                                "sense_id": "f986ee6a-da6e-3d89-8dda-e5061517c7ba",
                                "text": "„Für Stunden hörte es gar nicht mehr auf zu regnen, begleitet von Blitz und Donner. Dicke Tropfen platterten auf das Segelboot und nach kurzer Zeit bildeten sich tiefe Pfützen an Deck und auf dem Bootsanleger.“"
                            },
                            {
                                "example_id": "741950c7-0277-4774-8d92-01219c119e73",
                                "sense_id": "f986ee6a-da6e-3d89-8dda-e5061517c7ba",
                                "text": "„In der Nacht hat es geplattert, bis zum geht nicht mehr.“"
                            },
                            {
                                "example_id": "c4146dfa-a918-47fb-8ae1-0e4e92488876",
                                "sense_id": "f986ee6a-da6e-3d89-8dda-e5061517c7ba",
                                "text": "„Die ganze Nacht durch hatte es „geplattert“, und ans Klettern war erst mal nicht zu denken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
