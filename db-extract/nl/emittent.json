                        "glosses": [
                            "uitgever van aandelen of andere waardepapieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6eee1a9-12ad-447b-8242-31edf66d9bc9",
                                "sense_id": "fee601a1-ced2-39e3-a2cd-1a7bfc612b2c",
                                "text": "Anders gezegd, het is zinvoller dat ze hun portefeuilles spreiden naar andere beleggingsklassen dan dat ze op zoek gaan naar meer rendement zonder rekening te houden met hun eisen betreffende de kwaliteit van de emittenten."
                            },
                            {
                                "example_id": "c36a8186-aa6e-490c-8cb4-a1399b0ab726",
                                "sense_id": "fee601a1-ced2-39e3-a2cd-1a7bfc612b2c",
                                "text": "Deze week kwam de BIS (Bank voor Internationale Betalingen) in het nieuws met een waarschuwing voor oververhitting van PIK obligaties. Dit zijn obligaties waarbij de emittent het recht heeft om de rentebetalingen te verrichten middels uitgifte van nog meer schuld. Voor de kredietcrisis kenden dit soort obligaties een defaultpercentage van 30%."
                            },
                            {
                                "example_id": "18997633-a225-412f-996f-34d00bf00ca7",
                                "sense_id": "fee601a1-ced2-39e3-a2cd-1a7bfc612b2c",
                                "text": "Porsche liet maandag tevens weten tegen een overname van de effectenbeurs in Londen door Deutsche Börse te zijn. Vooral in de rol van emittent, uitgever van aandelen of andere waardepapieren, voelt Porsche zich getroffen."
                            }
                        ]
                    }
