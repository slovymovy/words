                        "glosses": [
                            "een stapsgewijs nauwer wordend net waarmee men paling kan vangen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8262c282-7b8a-464b-879b-2799f40c06ec",
                                "sense_id": "478fa670-5e54-3434-a896-b131a1954f19",
                                "text": "Beroepsvissers die in de Nieuwkoopse Plassen vissen op paling, gaan de openingen van hun fuiken verkleinen om te voorkomen dat ze een otter vangen. Begin deze maand is vastgesteld dat de otter na bijna 40 jaar is teruggekeerd in het natuurgebied in het Groene Hart, maar het dier zou verdrinken als hij in een palingfuik zwemt."
                            },
                            {
                                "example_id": "f571418a-8fea-44b7-b317-edf75657e2e0",
                                "sense_id": "478fa670-5e54-3434-a896-b131a1954f19",
                                "text": "Uit een viswater in Winterswijk is zaterdag een palingfuik van 13 meter lengte gehaald. De fuik is in beslag genomen, meldt wijkagent Willem Saris op Twitter."
                            }
                        ]
                    }
