                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c351ed81-e424-482e-a8e9-471ec78f9059",
                                "sense_id": "891caa1b-476e-3011-a1ea-916ceb046bf8",
                                "text": "Des empilements de conserves bariolaient le fond de la cave, en tas, comme les graviers de couleur d’un kaléidoscope."
                            },
                            {
                                "example_id": "2cdd6854-b6d1-4eb6-8157-b21ecf40374a",
                                "sense_id": "891caa1b-476e-3011-a1ea-916ceb046bf8",
                                "text": "Il enfila le costume, se débarrassa du cadavre et de ses propres affaires souillées dans un empilement de poubelles traînant sur le sol."
                            },
                            {
                                "example_id": "21561b2a-959c-42bd-ba66-a79179f593b9",
                                "sense_id": "891caa1b-476e-3011-a1ea-916ceb046bf8",
                                "text": "À cet instant, le regard de Camille se porta sur un couple de clients qui déambulait derrière un empilement d’ananas Victoria."
                            }
                        ]
                    },
                    {
                        "sense_id": "823311bc-b5ac-35f4-843e-10f8ff79e343",
                        "entry_id": "77a1aa26-c2a5-3a4f-9986-092f61191d4b",
                        "glosses": [
