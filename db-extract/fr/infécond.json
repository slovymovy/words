                        ],
                        "form": "inféconde"
                    },
                    {
                        "form_id": "aebb2c61-d15c-423b-91d7-1cd82c90422f",
                        "entry_id": "60a67367-d911-32e6-aa52-8c6828911936",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "infécondes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "66ca9763-6af5-3e99-a469-75c2c4cb3b32",
                        "entry_id": "60a67367-d911-32e6-aa52-8c6828911936",
                        "glosses": [
                            "Stérile, infertile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7b6e21e-882f-4ed8-bf6f-573ed947eb4f",
                                "sense_id": "66ca9763-6af5-3e99-a469-75c2c4cb3b32",
                                "text": "Une terre inféconde."
                            },
                            {
                                "example_id": "5bc0ea4c-83dc-42f6-b042-64553fa88bf7",
                                "sense_id": "66ca9763-6af5-3e99-a469-75c2c4cb3b32",
                                "text": "Ce champ est infécond."
                            },
                            {
                                "example_id": "de54eb70-c3db-4c61-8e00-dac6efe3f7f9",
                                "sense_id": "66ca9763-6af5-3e99-a469-75c2c4cb3b32",
                                "text": "Des germes inféconds."
                            },
                            {
                                "example_id": "d784816e-ffc5-4ccc-9d6d-7934ff92e371",
                                "sense_id": "66ca9763-6af5-3e99-a469-75c2c4cb3b32",
                                "text": "[…] le cheval et l'âne sont certainement de différentes espèces, puisqu'ils ne produisent ensemble que dés individus viciés et inféconds."
                            },
                            {
                                "example_id": "5d83d8d4-c9fd-4542-97ca-cbd5ad8a787d",
                                "sense_id": "66ca9763-6af5-3e99-a469-75c2c4cb3b32",
                                "text": "Les tamaris fins et frissonnants commencent à se montrer par bandes ; à l’horizon, les belles montagnes dans les lointains violets ; tout à l’entour, les plantes infécondes, filles de la mer et du sable."
                            },
                            {
                                "example_id": "667f2de7-a56b-46e6-906d-842aee6a36ca",
                                "sense_id": "66ca9763-6af5-3e99-a469-75c2c4cb3b32",
                                "text": "C’est tellement sale, la fécondité, la maternité, et le reste ! Si nous étions tous assez purs, assez distingués, pour ne plus en toucher une seule, par dégoût, et si toutes mouraient infécondes, n’est-ce pas ? ce serait au moins finir proprement."
                            },
                            {
                                "example_id": "a8c1f400-2190-47f1-b5fc-5e9ba6ef8cfc",
                                "sense_id": "66ca9763-6af5-3e99-a469-75c2c4cb3b32",
                                "text": "Les femelles infécondes peuvent ne pas avoir d’œstrus, ne pas revenir en chaleur après une mise bas, ou revenir en chaleur après avoir été inséminées (monte naturelle ou insémination artificielle) […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "cbdf06dd-49cc-3e83-9235-2563e45db839",
                        "entry_id": "60a67367-d911-32e6-aa52-8c6828911936",
                        "glosses": [
                            "Improductif."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "aeec9d2c-5282-4a9c-8ebb-9d12c14f3d99",
                                "sense_id": "cbdf06dd-49cc-3e83-9235-2563e45db839",
                                "text": "Il sentait couler dans ses veines toute la sanie des rêves impuissants, des appétences infécondes, et sur son échine s’appesantissait le fardeau de la résignation et de la timidité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "09a793eb-187b-4ab3-be1f-b2cffe5e4aff",
                        "source_entry_id": "60a67367-d911-32e6-aa52-8c6828911936",
                        "target_lang_word": "infertile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infertile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2be59784-3bae-3414-8ef0-b55b99b1f52e",
                                        "entry_id": "d6e812f2-e8b7-30f1-8512-57bffbbd86fa",
                                        "glosses": [
                                            "Not fertile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eacadffd-3857-48ed-8eb9-da9ff2f9384d",
                                                "sense_id": "2be59784-3bae-3414-8ef0-b55b99b1f52e",
                                                "text": "The soil was too infertile to grow crops."
                                            },
                                            {
                                                "example_id": "d980eb0e-32ca-4526-8c76-475be2890533",
                                                "sense_id": "2be59784-3bae-3414-8ef0-b55b99b1f52e",
                                                "text": "The couple sought medical advice for infertile conditions."
                                            },
                                            {
                                                "example_id": "1272e4cf-bce9-42b5-8860-a43cd79f745e",
                                                "sense_id": "2be59784-3bae-3414-8ef0-b55b99b1f52e",
                                                "text": "Deserts are often infertile and unable to support vegetation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
