                    },
                    {
                        "translation_id": "f0b66d26-f69c-4782-a7d7-ac4d223e02f2",
                        "source_entry_id": "1fa34311-42ca-345a-8a70-e94860e39338",
                        "source_sense_id": "105737e2-f188-3c36-a795-25e83e42591f",
                        "source_sense_description": "Venetian boatman who propels a gondola",
                        "target_lang_word": "gondolier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gondolier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f2c2b78d-1749-3cea-8cec-a1992af389bc",
                                        "entry_id": "9e31fc33-26af-3091-a9c1-b110cb2744e1",
                                        "glosses": [
                                            "Celui qui mène une gondole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c79170d2-d1fe-4291-a329-25564c9f90e3",
                                                "sense_id": "f2c2b78d-1749-3cea-8cec-a1992af389bc",
                                                "text": "Chantons et dansons, nous qui sommes joyeux, tandis que ces mélancoliques descendent le canal sur le banc des gondoliers, et pleurent en voyant pleurer les étoiles."
                                            },
                                            {
                                                "example_id": "e26e4f8e-eb3b-4eb6-9d9c-ecac8d897130",
                                                "sense_id": "f2c2b78d-1749-3cea-8cec-a1992af389bc",
                                                "text": "Et crescendo, la querelle s’envenime en injures, bien sûr, et non en coups, car les deux gondoliers savent pratiquer l’art de « rompre le fer »."
                                            },
                                            {
                                                "example_id": "9d699b25-5cfe-41e9-8abe-ec865632ad34",
                                                "sense_id": "f2c2b78d-1749-3cea-8cec-a1992af389bc",
                                                "text": "Les gondoliers ont l’air de croque-morts à présent. Ce sont les fossoyeurs qui plantent Venise dans la mer et l’ensevelissent à gestes tendres, en souvenir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa1f6122-88fd-34e2-ba6d-60992ad8e6cb",
                                        "entry_id": "9e31fc33-26af-3091-a9c1-b110cb2744e1",
                                        "glosses": [
                                            "Personnel chargé de l’approvisionnement, de l’étiquetage et du balisage des marchandises affectées à la vente dans les rayons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5c0d346-ae3e-456a-b09e-b477e7b093f0",
                                                "sense_id": "fa1f6122-88fd-34e2-ba6d-60992ad8e6cb",
                                                "text": "Les gondoliers travaillent fréquemment en position debout, sous le contrôle du chef de rayon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "199dc0de-ac67-4f9e-b2a9-d394f6ae77a9",
                        "source_entry_id": "1fa34311-42ca-345a-8a70-e94860e39338",
                        "source_sense_id": "105737e2-f188-3c36-a795-25e83e42591f",
                        "source_sense_description": "Venetian boatman who propels a gondola",
                        "target_lang_word": "gondolière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gondolière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "68112f96-f768-3230-a8e8-22ca56eb38ad",
                                        "entry_id": "f64ded97-45ec-3803-9345-2fdb2cc7d2d6",
                                        "glosses": [
                                            "Celle qui mène une gondole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4f5a001-53e0-4049-9e3c-b5d07af328a4",
                                                "sense_id": "68112f96-f768-3230-a8e8-22ca56eb38ad",
                                                "text": "Il battait sa maîtresse, La Guiccioli, une gondolière vénitienne qui, du reste, le lui rendait bien."
                                            },
                                            {
                                                "example_id": "76b21a22-fe3f-4147-891e-6426635a8bc5",
                                                "sense_id": "68112f96-f768-3230-a8e8-22ca56eb38ad",
                                                "text": "Grand sourire et cheveux blonds au vent, Giorgia Boscolo actionne avec entrain sa longue rame d’aviron : elle est encore apprentie mais sera bientôt la première femme gondolière en 900 ans d’histoire à Venise."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91eae9c4-d03b-4a2a-aaea-8d597bd849da",
                        "source_entry_id": "1fa34311-42ca-345a-8a70-e94860e39338",
                        "source_sense_id": "105737e2-f188-3c36-a795-25e83e42591f",
                        "source_sense_description": "Venetian boatman who propels a gondola",
                        "target_lang_word": "Gondoliere",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gondoliere",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e5b7382d-0ca9-3dd3-aa75-5264fdfd8bde",
                                        "entry_id": "572869a8-c9fb-3d69-b895-0652f382846c",
                                        "glosses": [
                                            "Person, die beruflich eine Gondel – ein spezielles venezianisches Boot für Lasten und Personen – lenkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73000a66-1e32-4211-b4e1-def8b7b05e5e",
                                                "sense_id": "e5b7382d-0ca9-3dd3-aa75-5264fdfd8bde",
                                                "text": "„Dann stellt sich der Gondoliere auf seinen Platz, stößt ab und leitet mit lautlosen Ruderschlägen das Boot durch den schmalen Kanal; kleine runde Wellen schlagen gluckernd gegen die Planken.“"
                                            },
                                            {
                                                "example_id": "d54d6be5-29f6-4baf-86b1-280b8eeaeaa1",
                                                "sense_id": "e5b7382d-0ca9-3dd3-aa75-5264fdfd8bde",
                                                "text": "„Unter mehreren Gondolieri, die Proviant heranführten, fiel mir einer auf, der sich Biagio nannte.“"
                                            },
                                            {
                                                "example_id": "40e27761-c7e8-44be-898f-7d67f7a853a8",
                                                "sense_id": "e5b7382d-0ca9-3dd3-aa75-5264fdfd8bde",
                                                "text": "„Sie schlief und dämmerte durch die Tage, sie hörte die rauen Rufe der Gondolieri bis spät in die Nacht und das Klatschen der festgemachten Gondeln an der Riva degli Schiavoni.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
