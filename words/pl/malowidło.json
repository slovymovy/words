                    "sense_id": "f2f94596-0e67-385f-aefd-32a8da69d3ce",
                    "sense_definition": "obraz namalowany farbami, zwłaszcza na ścianie, suficie lub innej powierzchni architektonicznej",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sztuka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Konserwatorzy zabytków starannie odnawiają zabytkowe <w>malowidła</w> na ścianach starego kościoła.",
                            "target_lang_translations": {
                                "ru": "Реставраторы памятников старины бережно восстанавливают старинные <w>росписи</w> на стенах старого костёла."
                            }
                        },
                        {
                            "text": "Turyści z całego świata przyjeżdżają oglądać ścienne <w>malowidło</w> w tej zabytkowej kaplicy.",
                            "target_lang_translations": {
                                "ru": "Туристы со всего мира приезжают посмотреть на настенную <w>роспись</w> в этой старинной капелле."
                            }
                        }
                    ],
                    "synonyms": [
                        "fresk",
                        "malunek",
                        "obraz"
                    ],
                    "common_phrases": [
                        "malowidło ścienne",
                        "zabytkowe malowidło",
                        "odkryć malowidła"
                    ],
                    "target_lang_definitions": {
                        "ru": "Картина или изображение, написанное красками, особенно на стене, потолке или другом архитектурном элементе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "роспись",
                                "target_lang_sense_clarification": "настенная или потолочная живопись"
                            },
                            {
                                "target_lang_word": "фреска",
                                "target_lang_sense_clarification": "живопись по штукатурке"
                            },
                            {
                                "target_lang_word": "картина",
                                "target_lang_sense_clarification": "живописное произведение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d15ce1e6-1d62-3c8a-a2ad-6ed77f8d9b3d",
                    "sense_definition": "obraz o niskiej wartości artystycznej, namalowany nieudolnie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sztuka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W prezencie dostałem marne <w>malowidło</w>, którego wstydziłbym się powiesić w salonie.",
                            "target_lang_translations": {
                                "ru": "В подарок я получил жалкую <w>мазню</w>, которую постеснялся бы повесить в гостиной."
                            }
                        },
                        {
                            "text": "Krytyk sztuki bez litości nazwał ten obraz kiczowatym <w>malowidłem</w> domorosłego artysty.",
                            "target_lang_translations": {
                                "ru": "Искусствовед безжалостно назвал эту картину китчевой <w>мазнёй</w> доморощенного художника."
                            }
                        }
                    ],
