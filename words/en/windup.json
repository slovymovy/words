            "senses": [
                {
                    "sense_id": "98047b1a-ee06-3c38-9c63-b81687136f89",
                    "sense_definition": "The final part of an activity or process, often involving a summary or conclusion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "conclusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>windup</w> of the meeting included a brief summary of all the decisions made.",
                            "target_lang_translations": {
                                "ru": "В <w>завершение</w> собрания были кратко подведены итоги всех принятых решений."
                            }
                        },
                        {
                            "text": "During the <w>windup</w> of the project, the team reviewed their final results and achievements.",
                            "target_lang_translations": {
                                "ru": "На этапе <w>завершения</w> проекта команда проанализировала свои окончательные результаты и достижения."
                            }
                        }
                    ],
                    "synonyms": [
                        "conclusion",
                        "wrap-up",
                        "finale"
                    ],
                    "antonyms": [
                        "beginning",
                        "start"
                    ],
                    "common_phrases": [
                        "the windup of"
                    ],
                    "target_lang_definitions": {
