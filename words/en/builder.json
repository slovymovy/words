{
    "word_family": [
        "build",
        "building",
        "rebuild"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1f05f69e-736f-3711-9ca1-fb034cc5907f",
                    "sense_definition": "One who builds or constructs things, especially houses or other structures.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "person_trade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>builder</w> said the new roof would be finished by Friday.",
                            "target_lang_translations": {
                                "ru": "<w>Строитель</w> сказал, что новая крыша будет готова к пятнице.",
                                "zh": "<w>建筑商</w>说新屋顶周五前就能完工。"
                            }
                        },
                        {
                            "text": "We hired a local <w>builder</w> to add a garage to our house.",
                            "target_lang_translations": {
                                "ru": "Мы наняли местного <w>строителя</w>, чтобы пристроить гараж к нашему дому.",
                                "zh": "我们雇了一位当地的<w>建筑工人</w>给房子加盖了一个车库。"
                            }
                        }
                    ],
                    "synonyms": [
                        "constructor"
                    ],
                    "antonyms": [
                        "destroyer",
                        "wrecker"
                    ],
                    "common_phrases": [
                        "master builder",
                        "local builder",
                        "property builder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который строит или конструирует что-либо, особенно дома или другие сооружения.",
                        "zh": "从事建筑工作的人，尤指建造房屋或其他结构的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "строитель",
                                "target_lang_sense_clarification": "профессия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "建筑工人",
                                "target_lang_sense_clarification": "从事建筑施工的体力劳动者"
                            },
                            {
                                "target_lang_word": "建筑商",
                                "target_lang_sense_clarification": "负责承建工程的承包商或公司"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ce0e7f2-4d53-3ff5-932c-91c6b36b7fdc",
                    "sense_definition": "Software that allows the user to create a certain kind of automated output.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "software",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can use a website <w>builder</w> to launch your blog without writing code.",
                            "target_lang_translations": {
                                "ru": "Вы можете использовать <w>конструктор</w> сайтов, чтобы запустить свой блог без написания кода.",
                                "zh": "你可以使用网站<w>生成器</w>来发布博客，而无需编写代码。"
                            }
                        },
                        {
                            "text": "The application includes a query <w>builder</w> to help users find data easily.",
                            "target_lang_translations": {
                                "ru": "Приложение включает в себя <w>построитель</w> запросов, помогающий пользователям легко находить данные.",
                                "zh": "该应用程序包含一个查询<w>构建器</w>，帮助用户轻松查找数据。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "website builder",
                        "form builder",
                        "query builder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Программное обеспечение, позволяющее пользователю создавать определенный вид автоматизированного результата.",
                        "zh": "允许用户创建特定自动化输出的软件工具。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конструктор",
                                "target_lang_sense_clarification": "программный инструмент"
                            },
                            {
                                "target_lang_word": "построитель",
                                "target_lang_sense_clarification": "компонент программы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "生成器",
                                "target_lang_sense_clarification": "用于自动创建代码或数据的软件组件"
                            },
                            {
                                "target_lang_word": "构建器",
                                "target_lang_sense_clarification": "用于配置或创建特定对象的程序模块"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3735f86a-9971-37fd-a2d8-19a591ebb208",
                    "sense_definition": "A short form of <w>bodybuilder</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person_sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gym was full of <w>builders</w> preparing for the upcoming competition.",
                            "target_lang_translations": {
                                "ru": "Спортзал был полон <w>билдеров</w>, готовящихся к предстоящим соревнованиям.",
                                "zh": "健身房里挤满了正在为即将到来的比赛做准备的<w>健美运动员</w>。"
                            }
                        },
                        {
                            "text": "Professional <w>builders</w> follow a very strict diet and exercise routine.",
                            "target_lang_translations": {
                                "ru": "Профессиональные <w>билдеры</w> соблюдают очень строгую диету и режим тренировок.",
                                "zh": "专业的<w>健美运动员</w>遵循非常严格的饮食和锻炼计划。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "clipping of bodybuilder"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращенная форма слова «бодибилдер».",
                        "zh": "健美运动员的口语缩写。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "билдер",
                                "target_lang_sense_clarification": "сленг"
                            },
                            {
                                "target_lang_word": "бодибилдер",
                                "target_lang_sense_clarification": "спортсмен"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "健美运动员",
                                "target_lang_sense_clarification": "从事健美运动的人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
