                        ],
                        "examples": [
                            {
                                "example_id": "5b10cbb8-df22-4aa9-9a1e-0152b894e328",
                                "sense_id": "b9c9bed9-efcf-30c9-800c-6920b4dfb23c",
                                "text": "In het weekeinde loopt de temperatuur weer verder op."
