                "senses": [
                    {
                        "sense_id": "deb86b63-5c0b-3a5e-bf75-7320b99c316e",
                        "entry_id": "a41a6f5e-955a-3a9a-a667-3232f870443d",
                        "glosses": [
                            "Rad an der Vorderachse eines Fahrzeugs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12262c7b-0372-4ac9-98f6-cc380093005b",
                                "sense_id": "deb86b63-5c0b-3a5e-bf75-7320b99c316e",
                                "text": "„Als Joe gerade nicht hinsah, zog Bobby den Schlüssel aus dem Zündschloss und versteckte ihn unter den Vorderrädern.“"
                            },
                            {
                                "example_id": "53bc7e54-767a-450b-b101-ab52a60aca88",
                                "sense_id": "deb86b63-5c0b-3a5e-bf75-7320b99c316e",
                                "text": "„Ich wusste, ich musste durchpowern, aber im gleißenden Licht der Mittagssonne schätzte ich eine tiefe Spurrile falsch ein; mein Vorderrad krachte mit einem harten Stoß hinein, blieb stecken und ich flog über den Lenker – mein erster Sahara-Sturz!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
