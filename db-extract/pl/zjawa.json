                "forms": [],
                "senses": [
                    {
                        "sense_id": "295ef951-aa94-3423-a415-fe35e289ddd8",
                        "entry_id": "d813a38d-034b-3011-adba-d65550d71032",
                        "glosses": [
                            "duch osoby zmarłej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb0fb737-2cc1-4858-b5d0-e90aa3c0456d",
                                "sense_id": "295ef951-aa94-3423-a415-fe35e289ddd8",
                                "text": "Ta zjawa już tak ma, że nie pojawia się dwa razy w tym samym miejscu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "d1f893b4-d13d-32dc-806f-d8ef3691dab5",
                        "entry_id": "d813a38d-034b-3011-adba-d65550d71032",
                        "glosses": [
                            "budzące lęk złudzenie"
                        ],
                        "tags": [],
