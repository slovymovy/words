            {
                "entry_id": "7373526a-4662-315a-95ed-b8205634f2c0",
                "word": "spiff",
                "pos": "verb",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2cafe3af-8c3b-4903-af5f-8de34c1df2e8",
                        "entry_id": "7373526a-4662-315a-95ed-b8205634f2c0",
                        "tags": [
                            "present",
                            "singular",
                            "third-person"
                        ],
                        "form": "spiffs"
                    },
                    {
                        "form_id": "55d4500c-4448-4aca-9225-6eb208ab400b",
                        "entry_id": "7373526a-4662-315a-95ed-b8205634f2c0",
                        "tags": [
                            "participle",
                            "present"
                        ],
                        "form": "spiffing"
                    },
                    {
                        "form_id": "3f74fd4e-2e28-41c8-a6bc-d75c2eb4ec28",
                        "entry_id": "7373526a-4662-315a-95ed-b8205634f2c0",
                        "tags": [
                            "participle",
                            "past"
                        ],
                        "form": "spiffed"
                    },
                    {
                        "form_id": "84c0e828-47c7-4315-8120-51e8ab4dca04",
                        "entry_id": "7373526a-4662-315a-95ed-b8205634f2c0",
                        "tags": [
                            "past"
                        ],
                        "form": "spiffed"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c82c7e2e-a179-30eb-83f2-9530075f3f77",
                        "entry_id": "7373526a-4662-315a-95ed-b8205634f2c0",
                        "glosses": [
                            "(usually with up or out) To make spiffy (attractive, polished, or up-to-date)"
                        ],
                        "tags": [
                            "informal",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b931923b-1813-4608-866f-2708b8901cc7",
                                "sense_id": "c82c7e2e-a179-30eb-83f2-9530075f3f77",
                                "text": "Oh, but we flatter ourselves that we are spiffed out; at all events, we've got our best dresses on."
                            },
                            {
                                "example_id": "99689318-6979-4785-a442-c3a453758705",
                                "sense_id": "c82c7e2e-a179-30eb-83f2-9530075f3f77",
                                "text": "This ensemble may be properly spiffed with a bolo tie, and topped off with a. . ."
                            },
                            {
                                "example_id": "ccc9fdc6-ee2d-47ac-9df8-4105e2a09d1f",
                                "sense_id": "c82c7e2e-a179-30eb-83f2-9530075f3f77",
                                "text": "We dated boys who had their own cars and wow! what fancy cars they were—spiffed and buffed in bright '50s reds or turquoises."
                            },
                            {
                                "example_id": "7df98d70-7056-4da4-8b89-d67dbf3d466c",
                                "sense_id": "c82c7e2e-a179-30eb-83f2-9530075f3f77",
                                "text": "Infrastructure Spiffed?"
                            }
                        ]
                    },
                    {
                        "sense_id": "dffd9e94-1379-304d-bf74-4202498d7405",
                        "entry_id": "7373526a-4662-315a-95ed-b8205634f2c0",
                        "glosses": [
                            "To reward (a salesperson) with a spiff or bonus."
                        ],
                        "tags": [
                            "slang",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6242ced5-fcfd-44d8-8b35-ef145c7ec413",
                                "sense_id": "dffd9e94-1379-304d-bf74-4202498d7405",
                                "text": "It is my confirmed belief that, spiffed or not, the salesman is the consumer's best-qualified and best- informed source of assistance in matters of component selection."
                            },
                            {
                                "example_id": "e94ffa04-8b16-46ee-a4e0-c9b38f40c046",
                                "sense_id": "dffd9e94-1379-304d-bf74-4202498d7405",
                                "text": "The flight to Baton Rouge was ten dollars more. He said not to worry about it. I spiffed the guy twenty bucks and ended up in Baton Rouge a day earlier than I had expected."
                            },
                            {
                                "example_id": "00f81997-cc21-4086-ba21-fe43ba1e8e9c",
                                "sense_id": "dffd9e94-1379-304d-bf74-4202498d7405",
                                "text": "The company made more money, and so did the salesperson who was spiffed on the sale and he was selling a product that most people don't buy."
                            }
                        ]
                    },
                    {
                        "sense_id": "d8764661-1330-3920-830c-3e1f28344130",
                        "entry_id": "7373526a-4662-315a-95ed-b8205634f2c0",
                        "glosses": [
                            "To attach a spiff or bonus to the selling of (a product)"
                        ],
                        "tags": [
                            "slang",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "85c826d1-9ad5-4532-844f-18e754d64bdd",
                                "sense_id": "d8764661-1330-3920-830c-3e1f28344130",
                                "text": "It wasn't my fault if the blamed old store caught fire and gave me a chance to help Ferguson move out some of the stuff that has been 'spiffed' till it looks like red ink had been spilled all over the price-tags."
                            },
                            {
                                "example_id": "63d9e119-ba5f-418f-b416-9ae38c656bfa",
                                "sense_id": "d8764661-1330-3920-830c-3e1f28344130",
                                "text": "Because you can pull out a spiff anywhere you are in the store and the customers are not aware that they are spiffed shoes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fcee61ee-00a2-45fd-a3bc-f03ab91c3b27",
                        "source_entry_id": "7373526a-4662-315a-95ed-b8205634f2c0",
                        "source_sense_description": "to make spiffy",
                        "target_lang_word": "herausputzen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "herausputzen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "41c4b56c-533b-36f6-8eee-cf4ca07aaa86",
                                        "entry_id": "45fd708c-9370-32a1-a038-e787df9382bc",
                                        "glosses": [
                                            "sich festlich kleiden, jemanden/etwas schön zurechtmachen, jemanden/etwas hübsch machen"
                                        ],
                                        "tags": [
                                            "reflexive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6f8cc29-1b35-4afa-a57e-0113843b4f13",
                                                "sense_id": "41c4b56c-533b-36f6-8eee-cf4ca07aaa86",
                                                "text": "„Lucieta und ihre Stiefmutter Margarita haben sich herausgeputzt, Lucieta trägt eine Perlenkette.“"
                                            },
                                            {
                                                "example_id": "a6e72039-a7ea-4093-b4d7-dafa024aa576",
                                                "sense_id": "41c4b56c-533b-36f6-8eee-cf4ca07aaa86",
                                                "text": "Für einen Jahrmarktsbesuch wird Sabine von ihrer älteren Schwester, die eine Affäre mit Goldsohn hat, herausgeputzt."
                                            },
                                            {
                                                "example_id": "67cebbcc-bf91-486d-a128-5e4a840e2891",
                                                "sense_id": "41c4b56c-533b-36f6-8eee-cf4ca07aaa86",
                                                "text": "„Im Fussball gibt’s zwei Sorten Fans: diejenigen, die nur bei grossen internationalen Ereignissen wie der WM oder EM aus den Löchern kriechen und sich mit lustigen Fan-Accessoires herausputzen. Und diejenigen, die jedes Wochenende ihren Club in einem Stadion anfeuern und dafür aufwändige Choreos auf die Beine stellen.“"
                                            },
                                            {
                                                "example_id": "9e636a54-f2ce-4450-bb0d-22a0e39fb894",
                                                "sense_id": "41c4b56c-533b-36f6-8eee-cf4ca07aaa86",
                                                "text": "„Für die Weltausstellung 1900 putzte sich Paris im großen Stil heraus.“"
                                            },
                                            {
                                                "example_id": "dde5aef7-7e3f-42a6-999a-a793419ffb37",
                                                "sense_id": "41c4b56c-533b-36f6-8eee-cf4ca07aaa86",
                                                "text": "„[…] die Verantwortlichen in Stadtverwaltungen und Fremdenverkehrsämtern […] lassen Fassaden herausputzen, Hotels und Erlebnisbäder bauen, zeigen nur das, was glänzt.“"
                                            },
                                            {
                                                "example_id": "7be290ca-2375-4ba4-871e-b78067623eb1",
                                                "sense_id": "41c4b56c-533b-36f6-8eee-cf4ca07aaa86",
                                                "text": "„[Der Immobilieninvestor] Jagdfeld will Heiligendamm wieder herausputzen und dort das schönste und erfolgreichste Grand Hotel Deutschlands errichten.“"
                                            },
                                            {
                                                "example_id": "db7cd1eb-455c-459c-8c1b-44e1a967e72f",
                                                "sense_id": "41c4b56c-533b-36f6-8eee-cf4ca07aaa86",
                                                "text": "„Sein Heimatdorf soll sich binnen zehn Jahren zu einer internationalen touristischen Destination herausputzen.“"
                                            },
                                            {
                                                "example_id": "f5d34f72-2211-41ad-a325-efab4ca0ebe9",
                                                "sense_id": "41c4b56c-533b-36f6-8eee-cf4ca07aaa86",
                                                "text": "„Und während sich die Städte für die kommenden Großereignisse für viel Geld herausputzen, fürchten viele, dort bald nicht mehr leben zu können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
