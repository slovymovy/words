{
    "word_family": [
        "odlot",
        "odlotowy",
        "latać",
        "lecieć",
        "przylatywać",
        "wylatywać"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "08c1d9e8-9cf8-3e70-af09-42ce7a1586e8",
                    "sense_definition": "oddalać się od określonego miejsca drogą powietrzną, unosząc się w powietrzu lub podróżując samolotem",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ruch w powietrzu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ptaki każdego roku późną jesienią <w>odlatują</w> do ciepłych krajów.",
                            "target_lang_translations": {
                                "ru": "Птицы каждый год поздней осенью <w>улетают</w> в тёплые края."
                            }
                        },
                        {
                            "text": "Nasz samolot do Londynu <w>odlatuje</w> za pół godziny z bramki numer cztery.",
                            "target_lang_translations": {
                                "ru": "Наш самолёт в Лондон <w>вылетает</w> через полчаса от выхода номер четыре."
                            }
                        }
                    ],
                    "synonyms": [
                        "wylatywać",
                        "startować"
                    ],
                    "antonyms": [
                        "przylatywać"
                    ],
                    "common_phrases": [
                        "odlatywać do ciepłych krajów",
                        "odlatywać z lotniska"
                    ],
                    "target_lang_definitions": {
                        "ru": "удаляться от определенного места по воздуху (о птицах, самолетах и т. д.)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "улетать",
                                "target_lang_sense_clarification": "о птицах или людях на самолете"
                            },
                            {
                                "target_lang_word": "отлетать",
                                "target_lang_sense_clarification": "о рейсах, по расписанию"
                            },
                            {
                                "target_lang_word": "вылетать",
                                "target_lang_sense_clarification": "отправляться самолетом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "caddb84b-2503-3f4b-962f-bb12e4463b78",
                    "sense_definition": "odczepiać się, odrywać i odpadać od większej całości",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "odrywanie się",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze starej i zniszczonej ściany płatami <w>odlatuje</w> farba.",
                            "target_lang_translations": {
                                "ru": "Со старой и разрушенной стены лохмотьями <w>отлетает</w> краска."
                            }
                        },
                        {
                            "text": "Kafle w łazience były źle przyklejone i powoli <w>odlatują</w> od podłoża.",
                            "target_lang_translations": {
                                "ru": "Плитка в ванной была плохо приклеена и постепенно <w>отваливается</w> от стены."
                            }
                        }
                    ],
                    "common_phrases": [
                        "płatami odlatywać"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potoczne określenie odpadania elementów"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "разг. отваливаться, отставать от какой-либо поверхности или основы"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отваливаться",
                                "target_lang_sense_clarification": "об элементах, плитке, штукатурке"
                            },
                            {
                                "target_lang_word": "отлетать",
                                "target_lang_sense_clarification": "о краске, пуговицах и т. п."
                            },
                            {
                                "target_lang_word": "отслаиваться",
                                "target_lang_sense_clarification": "о краске, покрытиях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4058480-77bc-3cf6-ba61-b168fdd4bcf8",
                    "sense_definition": "tracić kontakt z otoczeniem i rzeczywistością, na przykład pod wpływem alkoholu, narkotyków lub silnego zmęczenia",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "stan psychiczny",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po zażyciu silnych leków przeciwbólowych pacjent powoli <w>odlatywał</w> i tracił kontakt.",
                            "target_lang_translations": {
                                "ru": "После приёма сильных обезболивающих пациент медленно <w>улетал</w> и терял связь с реальностью."
                            }
                        },
                        {
                            "text": "Mój kolega wypił za dużo piwa i po godzinie zupełnie <w>odlatywał</w>.",
                            "target_lang_translations": {
                                "ru": "Мой друг выпил слишком много пива и через час уже совсем <w>отключался</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zupełnie odlatywać"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "używane w slangu w odniesieniu do odurzenia lub utraty przytomności"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "жарг. терять связь с реальностью, «отключаться» под воздействием алкоголя, веществ или сильной усталости"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "улетать",
                                "target_lang_sense_clarification": "терять связь с реальностью от усталости или веществ"
                            },
                            {
                                "target_lang_word": "отключаться",
                                "target_lang_sense_clarification": "засыпать или терять ясность сознания"
                            },
                            {
                                "target_lang_word": "вырубаться",
                                "target_lang_sense_clarification": "терять сознание, засыпать от усталости или опьянения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}