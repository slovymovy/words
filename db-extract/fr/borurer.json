                "senses": [
                    {
                        "sense_id": "b60fc253-25ba-3a32-87ab-6f490e953ddc",
                        "entry_id": "73ee75ac-ca55-3e39-a1af-c5f01fa0f5ad",
                        "glosses": [
                            "Traiter par diffusion de bore."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbed1065-92c4-4d26-9cae-884200ce8ce9",
                                "sense_id": "b60fc253-25ba-3a32-87ab-6f490e953ddc",
                                "text": "Ce procédé permet également de borurer le cobalt."
                            },
                            {
                                "example_id": "7f3c1049-e3ae-4829-8244-23c3e4c148d7",
                                "sense_id": "b60fc253-25ba-3a32-87ab-6f490e953ddc",
                                "text": "Il forme des borures avec les métaux, et peut borurer une cathode en platine dans le borax en fusion, alors que celle en fer est restée inaltérée."
                            },
                            {
                                "example_id": "a749a1c3-7287-4e55-abe5-540fd94f698c",
                                "sense_id": "b60fc253-25ba-3a32-87ab-6f490e953ddc",
                                "text": "La boruration s'effectue en emballant les pièces dans la poudre à borurer, contenue dans des récipients en acier réfractaire et en portant le tout dans un four à traitement thermique à des températures de l'ordre de 850 à 950 °C."
                            }
                        ]
                    }
