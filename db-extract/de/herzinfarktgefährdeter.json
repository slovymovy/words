                ],
                "senses": [
                    {
                        "sense_id": "620ffdc8-bdc2-35f3-b768-fb070ee14636",
                        "entry_id": "b71ab41c-aeb0-3a22-bc4c-4597c8741212",
                        "glosses": [
                            "Person, die (aufgrund gesundheitlicher Faktoren) einem erhöhten Risiko für einen Herzinfarkt ausgesetzt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0239160e-4a59-4bef-b5eb-9b01da4d9835",
                                "sense_id": "620ffdc8-bdc2-35f3-b768-fb070ee14636",
                                "text": "„Obwohl die Angebote, die wohl gesündeste Art von sportlicher Betätigung sind, sei darauf hingewiesen, dass bestimmte Risikogruppen trotzdem gesundheitliche Beeinträchtigungen davontragen können (z. B. Herzinfarktgefährdete bzw. Herzinfarktgenesende).“"
                            },
                            {
                                "example_id": "eb8aaf93-26ea-48e0-baa9-b2b84e57614d",
                                "sense_id": "620ffdc8-bdc2-35f3-b768-fb070ee14636",
                                "text": "„Deutschlands anerkanntester Herzpapst der 80er Jahre, der auf allen Kongressen herumsprang und Vorträge hielt, wunderte sich immer wieder, wie leichtsinnig die Herzinfarktgefährdeten trotz einer realen Gefährdung mit ihrer Gesundheit umgingen.“"
                            },
                            {
                                "example_id": "3ebfe26d-3304-4f03-acd9-ad3b162b6b86",
                                "sense_id": "620ffdc8-bdc2-35f3-b768-fb070ee14636",
                                "text": "„Ich kurbele gelegentlich im Vorbeifahren die Beifahrerscheibe runter und feuere die ohnehin schon Herzinfarktgefährdeten mit dem überraschenden, lautstarken und äußerst motivierenden Schlachtruf:“"
                            },
                            {
                                "example_id": "86eb2305-c629-4bd7-bb36-d137eaee3cfe",
                                "sense_id": "620ffdc8-bdc2-35f3-b768-fb070ee14636",
                                "text": "„Das Ziel der Kampagne war es, die in der bundesdeutschen Wohlstandsgesellschaft durch das ‚Wirtschaftswunder‘ stark gestiegene Zahl Übergewichtiger und Herzinfarktgefährdeter durch sportliche Betätigung zu verringern.“"
                            },
                            {
                                "example_id": "2f68964c-3538-4186-91ed-adfff366bbc5",
                                "sense_id": "620ffdc8-bdc2-35f3-b768-fb070ee14636",
                                "text": "„Die BSG-Rehasportgruppe Homburg steht mit ihren Angeboten auch für Menschen mit Herzbeschwerden, Herzinfakten und Herzinfarktgefährdete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
