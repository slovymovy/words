                        "glosses": [
                            "Canot de pêche rapide, à fond plat et motorisé."
                        ],
                        "tags": [
                            "Mayotte"
                        ],
                        "examples": [
                            {
                                "example_id": "740e877e-be30-4d06-aefd-93968d5c6541",
                                "sense_id": "bdaa318e-01df-3b59-b7cb-edd4c7db7fb2",
                                "text": "Elle s’approcha d’un kwassa sur le point de partir, remit au propriétaire du bateau le montant requis (presque toutes ses économies) et monta à bord."
                            },
                            {
                                "example_id": "1b283aaa-bbed-49b7-b06a-8ac03c114dbe",
                                "sense_id": "bdaa318e-01df-3b59-b7cb-edd4c7db7fb2",
                                "text": "Les mesures prises seront-elles suffisantes empêcher le déferlement de kwassas ?"
                            },
                            {
                                "example_id": "b8099341-bba5-4dc3-a7db-a7d219ec646e",
                                "sense_id": "bdaa318e-01df-3b59-b7cb-edd4c7db7fb2",
                                "text": "Depuis que l’île de Mayotte est un département français, de nombreux comoriens tentent d’y entrer clandestinement par la mer en s’entassant sur des kwassas."
                            }
                        ]
                    }
