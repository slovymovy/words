                        ],
                        "examples": [
                            {
                                "example_id": "3f2f9e0d-a4ea-4318-b2f4-342ff4d395c4",
                                "sense_id": "06cfebce-fad5-3f9a-8ac1-93cf7014ec4c",
                                "text": "Im Biergarten aßen wir heute ein paar dünne Scheiben Emmentaler mit reichlich Salz und Pfeffer."
                            }
                        ],
