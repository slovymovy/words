                                        "glosses": [
                                            "zaburzenia mowy lub rozumienia mowy na skutek uszkodzenia mózgu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "060d81d6-005c-43be-b4f5-d5adb90610e6",
                                                "sense_id": "1ff081f5-41ce-3fab-a7bb-b84aa67fe0b4",
                                                "text": "Stworzyła neurocybernetyczny model przetwarzania wyobrażeń złożonych sytuacji lękotwórczych u chorych z afazją."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cdb08c03-499c-4790-b398-f4b54b66ea91",
