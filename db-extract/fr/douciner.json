                "senses": [
                    {
                        "sense_id": "46942dc9-97de-34ed-93f5-25f778e4e060",
                        "entry_id": "db3a38de-c8ff-3d8d-a84c-7bc52f7daa4d",
                        "glosses": [
                            "Caresser doucement."
                        ],
                        "tags": [
                            "Antilles"
                        ],
                        "examples": [
                            {
                                "example_id": "d0f06cab-b4cf-46a9-a571-8739a834af57",
                                "sense_id": "46942dc9-97de-34ed-93f5-25f778e4e060",
                                "text": "Je chante les comptines et berceuses que ma maman chantait, elle chantait aussi bien sa joie que ses misères quotidiennes, l’important pour moi, c’est qu’elle était là, me doucinant de mots et de mélodies que je savourais yeux fermés."
                            },
                            {
                                "example_id": "23d63086-73a2-4923-8f51-53b1adfcc7d8",
                                "sense_id": "46942dc9-97de-34ed-93f5-25f778e4e060",
                                "text": "Un bilinguisme où le français et le créole se doucinent et se heurtent avec loqans et vitalité."
                            }
                        ]
                    }
                ],
