                                "target_lang_word": "софит",
                                "target_lang_sense_clarification": "широкоизлучатель"
                            },
                            {
                                "target_lang_word": "заливающий свет",
                                "target_lang_sense_clarification": "тип осветительного прибора"
                            }
                        ]
                    }
                }
            ]
        },
        {
