                                "target_lang_sense_clarification": "делать негладким, комкать"
                            },
                            {
                                "target_lang_word": "сминать",
                                "target_lang_sense_clarification": "образовывать неровности и заломы"
                            },
                            {
                                "target_lang_word": "мяться",
                                "target_lang_sense_clarification": "легко покрываться складками (о ткани)"
                            },
                            {
                                "target_lang_word": "загибать",
                                "target_lang_sense_clarification": "делать сгиб или складку"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "弄皱",
                                "target_lang_sense_clarification": "使物品表面出现折痕或皱褶"
                            },
                            {
                                "target_lang_word": "起皱",
                                "target_lang_sense_clarification": "衣物或材料自行产生皱痕"
                            },
                            {
                                "target_lang_word": "压出折痕",
                                "target_lang_sense_clarification": "烫出或压出线条"
                            }
                        ]
                    }
