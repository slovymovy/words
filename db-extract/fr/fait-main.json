                                "target_senses": [
                                    {
                                        "sense_id": "8efdae9c-81c0-383e-b107-dc52e4acc542",
                                        "entry_id": "e159ebca-b732-3f98-b20d-a3dc50ae4d70",
                                        "glosses": [
                                            "určený k použití v ruce či v rukou"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5ea5fb6-a758-432a-a507-25d59933c2d3",
                                                "sense_id": "8efdae9c-81c0-383e-b107-dc52e4acc542",
                                                "text": "Elektrickou vrtačku bohužel nemám, ale můžu ti zapůjčit aspoň ruční."
                                            }
                                        ]
