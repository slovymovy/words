                        "examples": [
                            {
                                "example_id": "447683b6-d674-4644-92ab-bcb4fb2badcc",
                                "sense_id": "4725aa86-2c8c-3480-9243-9d7b844bb72d",
                                "text": "Занимались с Козинцевым у Вали Вирко. Опять всех расчихвостил за «происшествия». Никто ничего не понимает, и все сбиты с толку."
                            },
                            {
                                "example_id": "2c10cb88-0058-4166-83ee-2b6a2286d8d3",
                                "sense_id": "4725aa86-2c8c-3480-9243-9d7b844bb72d",
                                "text": "На пленуме его расчихвостили, только один человек выступил в защиту."
                            }
                        ]
                    }
