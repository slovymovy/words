                "senses": [
                    {
                        "sense_id": "52bf61c5-d82d-372a-a9d9-476cad2d15db",
                        "entry_id": "f5f3c6bc-4649-36bd-bc2d-9ed868095117",
                        "glosses": [
                            "vergoeding die een schipper moet betalen als hij van een havengebruik moet maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb237d9b-12f4-4ddb-9523-00bffc9c85ac",
                                "sense_id": "52bf61c5-d82d-372a-a9d9-476cad2d15db",
                                "text": "Op het Twentse water heeft zich afgelopen weken een kleine revolutie voorgedaan. De havengelden voor de beroepsvaart worden namelijk elektronisch geïncasseerd en niet meer door de havenmeesters."
                            },
                            {
                                "example_id": "5b09539c-eb12-48cf-9684-6849a51b9e5e",
                                "sense_id": "52bf61c5-d82d-372a-a9d9-476cad2d15db",
                                "text": "Financieel directeur Paul Smits sprak dinsdag van gunstige ontwikkelingen. Voor het tweede jaar op rij werd een positieve kasstroom behaald. Die maakte het mogelijk te blijven investeren in de haven en tegelijkertijd de schuld af te bouwen. De omzet nam met 2,6 procent toe tot 677 miljoen euro, met name dankzij een stijging van de havengelden. De winst daarentegen zakte 1,7 procent tot 212 miljoen euro."
                            },
                            {
                                "example_id": "3fbdfa99-06b3-4ab1-b961-f4263cbbbe9f",
                                "sense_id": "52bf61c5-d82d-372a-a9d9-476cad2d15db",
                                "text": "Het Havenbedrijf Rotterdam moedigt het gebruik van schone brandstof met kortingen op het havengeld. De Ternsund krijgt 10 procent reductie. Het schip van de Zweedse rederij Terntank is gloednieuw en bezig aan zijn eerste reis."
                            }
                        ]
                    },
                    {
                        "sense_id": "8d2cf2bd-5470-3bb3-9eba-42984a24d7eb",
                        "entry_id": "f5f3c6bc-4649-36bd-bc2d-9ed868095117",
                        "glosses": [
                            "geld dat een luchtvaartmaatschappij moet betalen als zij gebruik maakt van een luchthaven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2df6bdb7-ca46-4c1c-96de-d3d41da8043d",
                                "sense_id": "8d2cf2bd-5470-3bb3-9eba-42984a24d7eb",
                                "text": "Luchtvaartmaatschappijen gaan vanaf 1 april 2016 minder betalen voor het gebruik van Schiphol. Gemiddeld gaat het om een daling van de havengelden van 11,6 procent, zo maakte het luchthavenbedrijf vandaag bekend."
                            }
                        ]
                    }
