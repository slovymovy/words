                {
                    "sense_id": "6f59776b-2626-369b-afd3-c677ebe41465",
                    "sense_definition": "grote, geheel zwarte zangvogel met een forse snavel (Corvus corax)",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vogel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het dichte bos zagen we een grote zwarte <w>raaf</w> op een tak zitten.",
                            "target_lang_translations": {
                                "en": "In the dense forest we saw a large black <w>raven</w> sitting on a branch."
                            }
                        },
                        {
                            "text": "<w>Raven</w> staan bekend om hun opmerkelijke intelligentie en probleemoplossend vermogen.",
                            "target_lang_translations": {
                                "en": "<w>Ravens</w> are known for their remarkable intelligence and problem-solving ability."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zo zwart als een raaf"
                    ],
                    "target_lang_definitions": {
                        "en": "a large, completely black songbird with a heavy bill (Corvus corax)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "raven",
                                "target_lang_sense_clarification": "common raven"
                            },
