                    },
                    {
                        "translation_id": "baeb2fd1-2a83-46cd-b64e-a2cc0a52c4ba",
                        "source_entry_id": "59ff57d5-e2ed-3ab8-bfb5-b616f7daa06d",
                        "source_sense_id": "df0a0366-b54b-37a2-b2d2-7372666a09ec",
                        "target_lang_word": "classical scholar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "cbb371b8-98d2-4626-a3d4-f6a61f586d57",
                        "source_entry_id": "59ff57d5-e2ed-3ab8-bfb5-b616f7daa06d",
                        "source_sense_id": "df0a0366-b54b-37a2-b2d2-7372666a09ec",
                        "target_lang_word": "humanitaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "humanitaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "16cb3c61-ef1d-3ed9-8c31-dcee9195c618",
                                        "entry_id": "cbb803e6-0890-32ac-a4d6-7abd8eda57a0",
                                        "glosses": [
                                            "Qui vise au bien universel de l’humanité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f22132e7-0614-450e-956e-02f91253de7d",
                                                "sense_id": "16cb3c61-ef1d-3ed9-8c31-dcee9195c618",
                                                "text": "Tout le jargon humanitaire dont les vénérables se gargarisent dans leurs tenues peut très bien être traduit en langage religieux et même chrétien."
                                            },
                                            {
                                                "example_id": "20defaab-e40d-4219-a4e7-7e5a31a26d89",
                                                "sense_id": "16cb3c61-ef1d-3ed9-8c31-dcee9195c618",
                                                "text": "Hier, en France, il fallait être humanitaire, kantien, philosémite. Actuellement, la mode, chez nous, penche vers un christianisme édulcoré."
                                            },
                                            {
                                                "example_id": "6e3f3fdf-fb60-4be6-9ac3-1190a934b9fe",
                                                "sense_id": "16cb3c61-ef1d-3ed9-8c31-dcee9195c618",
                                                "text": "Ils soupirent après 1919 et le wilsonnisme. Grand bien leur fasse. On sait ce que les couplets sur la dernière des guerres, le droit des nations à disposer d’elles-mêmes et ce messianisme humanitaire ont donné comme résultats."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c321bcc-10d1-3868-a7d4-1aa5411ec0dc",
                                        "entry_id": "cbb803e6-0890-32ac-a4d6-7abd8eda57a0",
                                        "glosses": [
                                            "Solidaire, altruiste, qui aide les humains défavorisés."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2984fdb6-a8f5-4da0-990e-fad552d27eb1",
                                                "sense_id": "7c321bcc-10d1-3868-a7d4-1aa5411ec0dc",
                                                "text": "La Croix-Rouge est une association à but humanitaire."
                                            },
                                            {
                                                "example_id": "4e947e77-0b99-4558-9025-207116f949ad",
                                                "sense_id": "7c321bcc-10d1-3868-a7d4-1aa5411ec0dc",
                                                "text": "Pays pauvre qui ne vit que de l’aide humanitaire, notamment française, la Mauritanie reste l’un des bastions les plus réfractaires à l’abolition de l’esclavage."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "humanitaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "07849d5a-f804-32f0-a908-8e6b1d9f36e2",
                                        "entry_id": "ba4e8637-6ea4-3e86-a32a-f9077dde17e5",
                                        "glosses": [
                                            "Personne qui professe des opinions, des doctrines humanitaires."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "83f8f8b0-ea5c-3c83-a971-ecf8a058f3a3",
                                        "entry_id": "ba4e8637-6ea4-3e86-a32a-f9077dde17e5",
                                        "glosses": [
                                            "Personne qui vient en aide aux défavorisés au nom de la solidarité humaine. — Agent, membre d’une organisation d’aide humanitaire."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88b5717e-55ee-4050-9f7c-b49269246ca9",
                                                "sense_id": "83f8f8b0-ea5c-3c83-a971-ecf8a058f3a3",
                                                "text": "Un humanitaire."
                                            },
                                            {
                                                "example_id": "db3fb3ea-9015-46f9-9812-738b25ae77ca",
                                                "sense_id": "83f8f8b0-ea5c-3c83-a971-ecf8a058f3a3",
                                                "text": "J’aurais bien aimé que chaque politique soit un humanitaire et que chaque humanitaire comprenne, qu’en allant vers l’amont et vers la prévention, il faisait aussi un politique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f633cd45-ee9c-33ff-9402-3e34bb03bd03",
                                        "entry_id": "ba4e8637-6ea4-3e86-a32a-f9077dde17e5",
                                        "glosses": [
                                            "Action humanitaire, secteur des organisations d’aide humanitaire, ensemble des acteurs de l’aide humanitaire."
                                        ],
