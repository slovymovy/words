                "senses": [
                    {
                        "sense_id": "1f48b974-3ef5-32e9-ae88-b8700ac5f48c",
                        "entry_id": "64e7f2e1-2b6c-338f-923a-687f98d94b07",
                        "glosses": [
                            "A serf or bondsman born into servitude."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "f80fe3ed-45d5-4b5c-9e5c-c98b638af2b5",
                                "sense_id": "1f48b974-3ef5-32e9-ae88-b8700ac5f48c",
                                "text": "That is, because the girl was his nief, or bondwoman, the daughter of one of his villains"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab3a10ac-b826-4762-8ddc-952df2218428",
                        "source_entry_id": "64e7f2e1-2b6c-338f-923a-687f98d94b07",
                        "source_sense_id": "1f48b974-3ef5-32e9-ae88-b8700ac5f48c",
                        "source_sense_description": "serf or bondsman born into servitude",
                        "target_lang_word": "Sklave",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sklave",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "765c3d2e-e7d8-333d-b845-980ad7d1ccf4",
                                        "entry_id": "96df34da-8707-34e5-bd83-fd03ea7f3094",
                                        "glosses": [
                                            "Mensch, der als Sache im Eigentum eines anderen Menschen steht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9e8bf5b-e9e4-48a2-a3e2-51926f5ce673",
                                                "sense_id": "765c3d2e-e7d8-333d-b845-980ad7d1ccf4",
                                                "text": "Der unartige Sklave wird ausgepeitscht."
                                            },
                                            {
                                                "example_id": "bf634236-63c5-4497-a83c-caf9b3457854",
                                                "sense_id": "765c3d2e-e7d8-333d-b845-980ad7d1ccf4",
                                                "text": "„Doch je mehr Geld, Sklaven und Güter aller Art aus den eroberten Gebieten nach Rom strömten, desto entscheidender veränderte sich das ökonomische und soziale Gleichgewichte in der agrarisch geprägten Stadt.“"
                                            },
                                            {
                                                "example_id": "c940ef63-c0a0-4b2b-8846-a7c1cbdeee0e",
                                                "sense_id": "765c3d2e-e7d8-333d-b845-980ad7d1ccf4",
                                                "text": "„Der Hafen ist ein Hauptumschlagplatz für Gummi, Elfenbein, ganz besonders aber für Sklaven.“"
                                            },
                                            {
                                                "example_id": "f0ee6158-b6d6-4ec8-9c55-8705bd7073df",
                                                "sense_id": "765c3d2e-e7d8-333d-b845-980ad7d1ccf4",
                                                "text": "„Es nützte nichts, weder der Priester noch sonst jemand vermochte ihn davon abzubringen, daß ich nicht sein Diener, sondern sein Sklave sei…“"
                                            },
                                            {
                                                "example_id": "dfd762ce-e14d-42fc-a3ae-7b79b4a107f4",
                                                "sense_id": "765c3d2e-e7d8-333d-b845-980ad7d1ccf4",
                                                "text": "„Erst als ihm die Männer wirklich ausgingen, überwand sich der Süden und unterbreitete den Sklaven dieses Angebot - und tatsächlich, 50 Mann meldeten sich!“"
                                            },
                                            {
                                                "example_id": "a7a393f1-880d-4f57-8e87-f054c2872e28",
                                                "sense_id": "765c3d2e-e7d8-333d-b845-980ad7d1ccf4",
                                                "text": "„Im Alter von 16 Jahren wurde er von Seeräubern nach Irland entführt und musste dort als Sklave leben, bis er auf einem Schiff fliehen konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
