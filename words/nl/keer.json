                    "sense_definition": "De eerste persoon enkelvoud tegenwoordige tijd van <w>keren</w>.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>keer</w> de auto in de smalle straat.",
                            "target_lang_translations": {
