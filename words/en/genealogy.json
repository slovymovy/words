{
    "word_family": [
        "genealogist",
        "genealogical"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "09944eef-bcc6-31e9-ac08-bb187b9f077f",
                    "sense_definition": "The study and formal recording of family descents and history.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "family history",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spent many hours at the local library researching her family <w>genealogy</w> to find her great-grandparents.",
                            "target_lang_translations": {
                                "ru": "Она провела много часов в местной библиотеке, изучая семейную <w>генеалогию</w>, чтобы найти своих прадедушек и прабабушек."
                            }
                        },
                        {
                            "text": "Modern <w>genealogy</w> often involves using DNA tests to discover unknown relatives across the world.",
                            "target_lang_translations": {
                                "ru": "Современная <w>генеалогия</w> часто включает использование тестов ДНК для поиска неизвестных родственников по всему миру."
                            }
                        }
                    ],
                    "common_phrases": [
                        "study genealogy",
                        "research family genealogy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изучение и официальная запись истории и происхождения семей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "генеалогия",
                                "target_lang_sense_clarification": "научная дисциплина"
                            },
                            {
                                "target_lang_word": "родословие",
                                "target_lang_sense_clarification": "изучение истории рода"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ecdcde4-21dd-3ed0-be7e-8c07da2f9afe",
                    "sense_definition": "A record or table showing the descent of a person or family; a family tree.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "family history",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old Bible contained a detailed <w>genealogy</w> written by hand over several generations.",
                            "target_lang_translations": {
                                "ru": "Старая Библия содержала подробную <w>родословную</w>, написанную от руки на протяжении нескольких поколений."
                            }
                        },
                        {
                            "text": "He proudly displayed a printed <w>genealogy</w> that traced his ancestors back to the eighteenth century.",
                            "target_lang_translations": {
                                "ru": "Он с гордостью демонстрировал напечатанную <w>родословную</w>, которая прослеживала его предков до восемнадцатого века."
                            }
                        }
                    ],
                    "common_phrases": [
                        "detailed genealogy",
                        "printed genealogy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Запись или таблица, показывающая происхождение человека или семьи; семейное древо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "родословная",
                                "target_lang_sense_clarification": "документ или перечень"
                            },
                            {
                                "target_lang_word": "генеалогическое древо",
                                "target_lang_sense_clarification": "схема родственных связей"
                            },
                            {
                                "target_lang_word": "генеалогия",
                                "target_lang_sense_clarification": "запись о происхождении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26295a05-1563-36d4-809e-62ae16c5c8c9",
                    "sense_definition": "The actual descent or lineage of a person, family, or group from an ancestor.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "family history",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The book explores the <w>genealogies</w> of major rabbinic dynasties from medieval times to the present.",
                            "target_lang_translations": {
                                "ru": "В книге исследуются <w>родословные</w> крупнейших раввинских династий со времен средневековья до наших дней."
                            }
                        },
                        {
                            "text": "The king's <w>genealogy</w> was used to prove his legitimate right to the throne.",
                            "target_lang_translations": {
                                "ru": "<w>Происхождение</w> короля было использовано для доказательства его законного права на престол."
                            }
                        }
                    ],
                    "synonyms": [
                        "pedigree"
                    ],
                    "common_phrases": [
                        "noble genealogy",
                        "trace a genealogy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Фактическое происхождение или линия преемственности человека, семьи или группы от предка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "родословная",
                                "target_lang_sense_clarification": "происхождение рода"
                            },
                            {
                                "target_lang_word": "происхождение",
                                "target_lang_sense_clarification": "линия предков"
                            },
                            {
                                "target_lang_word": "генеалогия",
                                "target_lang_sense_clarification": "история происхождения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}