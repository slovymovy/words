                "senses": [
                    {
                        "sense_id": "c22441bd-e883-3834-ad50-e2dad1e4ebe2",
                        "entry_id": "96f2d383-0ede-3d90-8b9f-eee3a79e1b9a",
                        "glosses": [
                            "S’évanouir."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "12497e17-5563-4da3-b2b8-45df5045e524",
                                "sense_id": "c22441bd-e883-3834-ad50-e2dad1e4ebe2",
                                "text": "Mon complexe avec les Képis s’avanouissait ; ma philosophie était apparemment épurée."
                            },
                            {
                                "example_id": "13b7157f-1e6a-4b07-9075-e925579896b2",
                                "sense_id": "c22441bd-e883-3834-ad50-e2dad1e4ebe2",
                                "text": "Mais elle devint si pâle qu'il crut qu’elle allait s’avanouir."
                            },
                            {
                                "example_id": "805b7da7-a036-4941-80c1-14629ba3e06f",
                                "sense_id": "c22441bd-e883-3834-ad50-e2dad1e4ebe2",
                                "text": "Le ton qui accompagna celte réponse annonça que tout espoir d’accommodement allait s’avanouir, et Danton sortit en disant: (...)"
                            },
                            {
                                "example_id": "4c12ccf3-bde3-4690-81d8-40801b24e2ea",
                                "sense_id": "c22441bd-e883-3834-ad50-e2dad1e4ebe2",
                                "text": "Elle pensait justement qu’elle allait finir par s’avanouir tellement la faim la tenaillait."
                            }
                        ]
                    }
                ],
