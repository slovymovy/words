                        "form_id": "a57bee9b-4fef-4df7-91fa-85598dac7643",
                        "entry_id": "7b6a8ecc-e7d3-3aab-98d2-8311e5fcc5d7",
                        "tags": [
                            "plural"
                        ],
                        "form": "homos"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bfa4cc2a-fc56-3421-a7bd-db0f534e97cf",
                        "entry_id": "7b6a8ecc-e7d3-3aab-98d2-8311e5fcc5d7",
                        "glosses": [
                            "Homosexuel, homosexuelle."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "8f4a8dc2-9fae-4235-b9ba-804ee3e378f5",
                                "sense_id": "bfa4cc2a-fc56-3421-a7bd-db0f534e97cf",
                                "text": "Beaucoup d’homos n’aspirent pas à l’égalité, mais à l’indifférence."
                            },
                            {
                                "example_id": "ca7db93e-7f78-4187-b5be-279292885d36",
                                "sense_id": "bfa4cc2a-fc56-3421-a7bd-db0f534e97cf",
                                "text": "Dire que la réflexion d’un homo serait le seul fruit de son orientation sexuelle est, à mon sens, profondément homophobe."
                            },
                            {
                                "example_id": "2d760d53-8575-4bf1-9ce9-49796ad9664b",
                                "sense_id": "bfa4cc2a-fc56-3421-a7bd-db0f534e97cf",
                                "text": "Pour le moment j’ai l’impression d’être une créature de foire, une curiosité pour hétéros paumés, pour homos refoulés, qui ont envie de se cogner un transgenre… une fiotte."
                            },
                            {
                                "example_id": "4f99d64d-da6c-46d9-9b66-89486430876e",
                                "sense_id": "bfa4cc2a-fc56-3421-a7bd-db0f534e97cf",
                                "text": "J’ai dépassé la place de la République (ainsi composée en journée : 70 % de skateurs à peine pubères, 20 % de blédards, 8 % d’employés de bureau un sandwich à la main, 2 % de vieux homos venus regarder les skateurs et les blédards), et je me suis retrouvé rue Blondel."
                            },
                            {
                                "example_id": "128851e6-5cde-4579-bccd-99d00580f351",
                                "sense_id": "bfa4cc2a-fc56-3421-a7bd-db0f534e97cf",
                                "text": "Christian Clavier a annoncé hier qu’il préparait un film sur l’homoparentalité, avec Muriel Robin dans le rôle d’une homo qui tente d’adopter."
                            },
                            {
                                "example_id": "b5733b60-5ce1-497e-a9df-942145cbc7e9",
                                "sense_id": "bfa4cc2a-fc56-3421-a7bd-db0f534e97cf",
                                "text": "– Un homme dans votre vie ? – Non, une femme. – Vous vivez avec elle ? – Oui, je suis maintenant une homo qui s’assume."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f4ab6c2-a079-419f-9dec-a37cfd9febae",
                        "source_entry_id": "7b6a8ecc-e7d3-3aab-98d2-8311e5fcc5d7",
