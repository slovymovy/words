                "senses": [
                    {
                        "sense_id": "9ae8a4d3-dbc4-3d36-8c9c-71c36190d532",
                        "entry_id": "43e099b4-21b9-36dd-bc97-96691b4d2966",
                        "glosses": [
                            "am Oberarm getragenes Band, das zur Aufbewahrung kleiner Gegenstände beim Laufen gedacht ist"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "4d56e0c1-37b3-4da6-94d9-67fb1cf5bfd2",
                                "sense_id": "9ae8a4d3-dbc4-3d36-8c9c-71c36190d532",
                                "text": "„Ihr bekommt für 7 € Anmeldegebühr ein Laufarmband, einen Beutel und die Übersichtskarte der Aufstellorte der Banner.“"
                            },
                            {
                                "example_id": "cd74c4d2-976e-43c1-a1c6-fb061c3b52c7",
                                "sense_id": "9ae8a4d3-dbc4-3d36-8c9c-71c36190d532",
                                "text": "„Beginne mit den Schuhen, gehe über Funktionskleidung hin zu Accessoires wie Stirnlampe, Laufarmband, etc.“"
                            },
                            {
                                "example_id": "15c62d1e-80b0-4130-a7e6-bbcd488c3c0f",
                                "sense_id": "9ae8a4d3-dbc4-3d36-8c9c-71c36190d532",
                                "text": "„Das Laufarmband kann für kleine und größere Arme von 8 bis 16 Zoll passen.“"
                            },
                            {
                                "example_id": "38b4979b-f0a5-48c0-8215-9d903f04ece2",
                                "sense_id": "9ae8a4d3-dbc4-3d36-8c9c-71c36190d532",
                                "text": "„Das Laufarmband »Gel Armholder 2.0« von PRO TOUCH hat eine kleine Reißverschlusstasche mit Platz für kleine Gegenstände wie einen MP-3-Player oder ein Mobiltelefon.“"
                            },
                            {
                                "example_id": "1473e66f-4039-425f-8521-74c0b7b01f75",
                                "sense_id": "9ae8a4d3-dbc4-3d36-8c9c-71c36190d532",
                                "text": "„Darüber hinaus ist der Telefonhalter abnehmbar, sodass Sie beim Laufen oder Wandern nicht das gesamte Laufarmband zerlegen müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
