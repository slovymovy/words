                    }
                ],
                "senses": [
                    {
                        "sense_id": "6551f68a-d2dc-363a-9188-352766e1bd00",
                        "entry_id": "0e6cef0f-3abc-3a6a-9199-6395dd87d414",
                        "glosses": [
                            "als straf gedood worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94fa2cf1-eaf5-4ea5-bc3c-9b5f3ba3ffce",
                                "sense_id": "6551f68a-d2dc-363a-9188-352766e1bd00",
                                "text": "De doodstraf is wereldwijd en eeuwenlang een discussiepunt geweest en dat is het nog steeds."
                            },
                            {
                                "example_id": "d0a94d09-5e00-4461-882c-a525a49163c2",
                                "sense_id": "6551f68a-d2dc-363a-9188-352766e1bd00",
                                "text": "De moordenaar zat in de gevangenis waar hij de voltrekking van zijn doodstraf afwachtte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01da6c56-8acc-4b76-9944-6a9e33a8641e",
                        "source_entry_id": "0e6cef0f-3abc-3a6a-9199-6395dd87d414",
                        "source_sense_id": "6551f68a-d2dc-363a-9188-352766e1bd00",
                        "source_sense_description": "als straf gedood worden",
                        "target_lang_word": "Todesstrafe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Todesstrafe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7dfa3f3c-6c9f-31a0-bc1a-a91064ac6eb2",
                                        "entry_id": "b47719d1-692c-3419-8812-3d275024663a",
                                        "glosses": [
                                            "gesetzlich legitimierte Tötung eines Menschen als Strafe für ein Verbrechen, dessen er für schuldig befunden wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1887c7c7-48ee-4c5b-9b68-979fc4c56d3d",
                                                "sense_id": "7dfa3f3c-6c9f-31a0-bc1a-a91064ac6eb2",
                                                "text": "Die Todesstrafe wirft vielfältige ethische, rechtliche und praktische Fragen auf und ihre Vereinbarkeit mit den Menschenrechten ist umstritten."
                                            },
                                            {
                                                "example_id": "e0ea3446-0e56-4b28-9c5a-6f2d5b03f248",
                                                "sense_id": "7dfa3f3c-6c9f-31a0-bc1a-a91064ac6eb2",
                                                "text": "„Wegen des hohen Wertes des Diebesguts und der Umstände der Tat hätte eigentlich die Todesstrafe über sie verhängt werden müssen.“"
                                            },
                                            {
                                                "example_id": "f20d9f35-a29c-4277-91e4-6f2db07c7b31",
                                                "sense_id": "7dfa3f3c-6c9f-31a0-bc1a-a91064ac6eb2",
                                                "text": "Der Statistik zufolge wird die Todesstrafe am häufigsten im Iran (mindestens 507 Hinrichtungen), Saudi-Arabien (146), Irak (125) und Pakistan (60) vollstreckt."
                                            },
                                            {
                                                "example_id": "310299a2-a60c-4f62-a0ec-ed4bb6f06f2b",
                                                "sense_id": "7dfa3f3c-6c9f-31a0-bc1a-a91064ac6eb2",
                                                "text": "„Mayréna fürchtete die Todesstrafe und flüchtete an Bord eines Dampfschiffes, das ihn zurück nach Asien bringen sollte.“"
                                            },
                                            {
                                                "example_id": "2f3aac9d-46c3-489a-81b4-6edf7274611d",
                                                "sense_id": "7dfa3f3c-6c9f-31a0-bc1a-a91064ac6eb2",
                                                "text": "„Wie jedesmal wurde der Ruf nach der Todesstrafe laut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1108cfbb-ba10-4498-9bce-d2a2f8020688",
                        "source_entry_id": "0e6cef0f-3abc-3a6a-9199-6395dd87d414",
                        "source_sense_id": "6551f68a-d2dc-363a-9188-352766e1bd00",
