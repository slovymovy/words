        "fr-extract.jsonl": [
            {
                "entry_id": "cd396489-fc78-3f16-9270-a07cc581e9f5",
                "word": "ras-le-bol",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4faf9d4f-5cb8-3e8c-97c1-9c652266edbb",
                        "entry_id": "cd396489-fc78-3f16-9270-a07cc581e9f5",
                        "glosses": [
                            "Fait d’être excédé, d’en avoir assez."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "d5ead56b-c3eb-4b37-89c1-dc6ef57d5e4b",
                                "sense_id": "4faf9d4f-5cb8-3e8c-97c1-9c652266edbb",
                                "text": "La première partie du livre se présente comme la démonstration d’une évidence : celle d’un ras-le-bol général où il n’y a plus de repères, car plus de sens. De fait, les bases sur lesquelles repose notre société sont déconstruites une à une."
                            },
                            {
                                "example_id": "e4e33722-63ea-4049-8d65-ca4699d854a2",
                                "sense_id": "4faf9d4f-5cb8-3e8c-97c1-9c652266edbb",
                                "text": "Autre motif de ras-le-bol, le repoussoir que constitue la garde rapprochée des gudards de la Marine, plus que jamais aux manettes dans cette campagne […]."
                            },
                            {
                                "example_id": "d66671f2-aa20-4775-8605-76aead231dbf",
                                "sense_id": "4faf9d4f-5cb8-3e8c-97c1-9c652266edbb",
                                "text": "Des mouvements, initiés par les syndicats, qui cristallisent le ras-le-bol et l’épuisement des personnels de nombre d’établissements de santé, ceux du CHU de Clermont-Ferrand, des Ehpad, etc."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "976791c6-0407-4273-8e24-81994af46026",
                        "source_entry_id": "cd396489-fc78-3f16-9270-a07cc581e9f5",
                        "source_sense_id": "4faf9d4f-5cb8-3e8c-97c1-9c652266edbb",
                        "target_lang_word": "Verdruss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verdruss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29a8e325-61ea-382e-bc60-57964c62fcc7",
                                        "entry_id": "e7222bd5-b9fe-3de4-ac0a-49ee3c79a21d",
                                        "glosses": [
                                            "(andauernder) Ärger"
                                        ],
                                        "tags": [
                                            "literary",
                                            "plural",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edf747d9-4005-4ba7-a5af-3ef88eaa4a3a",
                                                "sense_id": "29a8e325-61ea-382e-bc60-57964c62fcc7",
                                                "text": "Sein Verdruss war groß, als er auch diesmal nicht gewählt wurde."
                                            },
                                            {
                                                "example_id": "ea8d7cf2-5f80-4683-bceb-9cf78dd48be3",
                                                "sense_id": "29a8e325-61ea-382e-bc60-57964c62fcc7",
                                                "text": "Er ließ keinen Verdruss erkennen."
                                            },
                                            {
                                                "example_id": "f6209935-d665-495b-95e6-ee803ec0db09",
                                                "sense_id": "29a8e325-61ea-382e-bc60-57964c62fcc7",
                                                "text": "„Es ist eine Kultur des Verdrusses, die sich über das Land gelegt hat, findet der Prediger.“"
                                            },
                                            {
                                                "example_id": "cc97100c-d752-4130-8385-bd22ef5e1298",
                                                "sense_id": "29a8e325-61ea-382e-bc60-57964c62fcc7",
                                                "text": "„Vor allem die nach dem Börsenkrach vom Herbst 1873 einsetzende, lang anhaltende Wirtschaftsflaute sorgte für Verdruss.“"
                                            },
                                            {
                                                "example_id": "286ca306-2942-4d4c-bee2-d45dbcb2715d",
                                                "sense_id": "29a8e325-61ea-382e-bc60-57964c62fcc7",
                                                "text": "„Offenbar gibt es nach elf Jahren Merkel doch einen stärkeren Verdruss an der Kanzlerin als angenommen und von den Umfragen suggeriert.“"
                                            },
                                            {
                                                "example_id": "cfaab7b3-12cb-4fec-97a9-2c0930cbef3e",
                                                "sense_id": "29a8e325-61ea-382e-bc60-57964c62fcc7",
                                                "text": "„Er fühlte ihm den Puls und nahm zu seiner Verwunderung und zu seinem Verdruss wahr, dass der Puls ruhiger war.“"
                                            },
                                            {
                                                "example_id": "aa214dbd-38b8-469a-a8f3-ae01b1d59d19",
                                                "sense_id": "29a8e325-61ea-382e-bc60-57964c62fcc7",
                                                "text": "„Ledermüller kam nun nach Nürnberg zurück, wurde aber zu Hause mit so harten Vorwürfen und Verdrussen gequält, daß er fortlief, und sich zu einem Freund nach Römhild begab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
