                                "sense_id": "17e50f1d-200d-3f08-9676-71b13f33e5cc",
                                "text": "Dem Marquis entspricht im Deutschen der Markgraf, im Italienischen der Marchese und im Englischen der Marquess."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "69ffef79-4bc6-358a-9b43-5c242b95ee97",
