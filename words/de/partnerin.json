                    "examples": [
                        {
                            "text": "Er lebt schon seit mehreren Jahren glücklich mit seiner <w>Partnerin</w> zusammen.",
                            "target_lang_translations": {
                                "en": "He has been living happily with his <w>partner</w> for several years.",
                                "ru": "Он уже несколько лет счастливо живёт вместе со своей <w>партнёршей</w>.",
                                "nl": "Hij woont al enkele jaren gelukkig samen met zijn <w>partner</w>.",
                                "pl": "Już od kilku lat mieszka szczęśliwie ze swoją <w>partnerką</w>.",
                                "fr": "Il vit heureux depuis plusieurs années avec sa <w>compagne</w>.",
                                "it": "Vive felicemente insieme alla sua <w>compagna</w> già da diversi anni.",
                                "cs": "Už několik let žije šťastně se svou <w>partnerkou</w>.",
                                "tr": "Birkaç yıldır <w>partneriyle</w> birlikte mutlu bir şekilde yaşıyor.",
                                "es": "Lleva ya varios años viviendo felizmente con su <w>pareja</w>.",
                                "zh": "他和自己的<w>伴侣</w>已经幸福地在一起生活好几年了。"
                            }
                        },
                        {
                            "text": "Sie brachte ihre neue <w>Partnerin</w> zum gemeinsamen Abendessen mit der Familie mit.",
                            "target_lang_translations": {
                                "en": "She brought her new <w>partner</w> along to dinner with the family.",
                                "ru": "Она привела свою новую <w>партнёршу</w> на совместный ужин с семьёй.",
                                "nl": "Ze nam haar nieuwe <w>partner</w> mee naar het gezamenlijke familiediner.",
                                "pl": "Przyprowadziła swoją nową <w>partnerkę</w> na wspólną kolację z rodziną.",
                                "fr": "Elle a emmené sa nouvelle <w>partenaire</w> au dîner avec la famille.",
                                "it": "Ha portato la sua nuova <w>compagna</w> alla cena insieme alla famiglia.",
                                "cs": "Přivedla svou novou <w>partnerku</w> na společnou večeři s rodinou.",
                                "tr": "Yeni <w>partnerini</w> aileyle birlikte yenen akşam yemeğine getirdi.",
                                "es": "Llevó a su nueva <w>pareja</w> a la cena con la familia.",
                                "zh": "她带了她的新<w>女朋友</w>来参加家庭晚餐。"
                            }
