                                "target_senses": [
                                    {
                                        "sense_id": "c86291d4-5cfc-3b51-a029-62893f364cb6",
                                        "entry_id": "4d547f0e-c9e5-3f70-b818-409150c35861",
                                        "glosses": [
                                            "Cocktail sans alcool."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e5409a4-be4b-46fc-aa6b-75ccc64ffdc8",
                                                "sense_id": "c86291d4-5cfc-3b51-a029-62893f364cb6",
                                                "text": "Sophie opine du bonnet, exagérément, et se commande un mocktail coco-ananas."
                                            },
                                            {
                                                "example_id": "747330e5-bfe2-43ca-be8d-88ff654e97bf",
                                                "sense_id": "c86291d4-5cfc-3b51-a029-62893f364cb6",
                                                "text": "Prenez les devants et rendez tout le monde jaloux avec ces deux recettes de mocktails — des cocktails sans alcool — encore meilleurs que les originaux."
                                            },
                                            {
                                                "example_id": "d5ef4fe6-cf0e-406c-b976-ef3b7d13042a",
                                                "sense_id": "c86291d4-5cfc-3b51-a029-62893f364cb6",
                                                "text": "Et pour conclure dans le mood bien-être, trinquons avec un verre d’une de ces mixtures aromatiques et sophistiquées élaborées sans alcool par des bartenders créatifs, les mocktails."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
