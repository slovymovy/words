                {
                    "sense_id": "0326dd59-5c72-3571-a359-1ed61827ed93",
                    "sense_definition": "Peu de temps après un moment ou un événement donné.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "temps_ecoule",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'assit un moment sur le banc et <w>bientôt</w> le sommeil le gagna.",
                            "target_lang_translations": {
                                "en": "He sat down on the bench for a moment, and <w>soon</w> sleep overcame him.",
                                "ru": "Он на минуту присел на скамейку, и <w>вскоре</w> его одолел сон.",
                                "nl": "Hij ging even op de bank zitten en <w>al snel</w> overviel de slaap hem.",
                                "de": "Er setzte sich einen Moment auf die Bank, und <w>bald</w> übermannte ihn der Schlaf.",
                                "it": "Si sedette un momento sulla panchina e <w>poco dopo</w> lo vinse il sonno.",
                                "cs": "Na chvíli si sedl na lavičku a <w>vzápětí</w> ho přemohl spánek.",
                                "tr": "Bankta bir süre oturdu ve <w>az sonra</w> uyku bastırdı.",
                                "es": "Se sentó un momento en el banco y <w>poco después</w> le venció el sueño.",
                                "zh": "他在长椅上坐了一会儿，<w>不久</w>困意便袭上了他。",
                                "pl": "Usiadł na chwilę na ławce i <w>wkrótce</w> zmorzył go sen."
                            }
                        },
                        {
                            "text": "La pluie s'arrêta enfin, mais un vent glacial se leva <w>bientôt</w>.",
                            "target_lang_translations": {
                                "en": "The rain finally stopped, but <w>before long</w> an icy wind got up.",
                                "ru": "Дождь наконец перестал, но <w>вскоре</w> поднялся ледяной ветер.",
                                "nl": "De regen hield eindelijk op, maar <w>kort daarna</w> stak een ijzige wind op.",
                                "de": "Der Regen hörte endlich auf, doch <w>kurz darauf</w> kam ein eisiger Wind auf.",
                                "it": "La pioggia finalmente cessò, ma <w>poco dopo</w> si alzò un vento gelido.",
                                "cs": "Déšť konečně ustal, ale <w>brzy nato</w> se zvedl ledový vítr.",
                                "tr": "Yağmur sonunda durdu, ama <w>çok geçmeden</w> buz gibi bir rüzgâr esmeye başladı.",
                                "es": "La lluvia por fin cesó, pero <w>al poco tiempo</w> se levantó un viento helado.",
                                "zh": "雨终于停了，但<w>不久之后</w>，一阵刺骨的寒风又刮了起来。",
                                "pl": "Deszcz w końcu ustał, ale <w>wkrótce potem</w> zerwał się lodowaty wiatr."
                            }
                        }
