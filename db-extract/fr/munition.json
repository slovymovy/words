                        ],
                        "form": "munitions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9638b042-d9c9-315a-8f65-8ef996e6cc21",
                        "entry_id": "8856ded2-29f3-356e-a7c2-538cf699269e",
                        "glosses": [
                            "Projectiles, cartouches, etc."
                        ],
                        "tags": [],
                        "note": "Ce terme est généralement utilisé au pluriel",
                        "examples": [
                            {
                                "example_id": "0cf1dcb2-1deb-4755-b7e3-32984624f3c3",
                                "sense_id": "9638b042-d9c9-315a-8f65-8ef996e6cc21",
                                "text": "La première partie du chemin se fit à la raquette, et les bagages, les vivres et les munitions furent portés à force de bras sur des traîneaux sauvages appelés tabaganes."
                            },
                            {
                                "example_id": "99880ab7-3c5b-4c9f-aaaa-5f43c01516a9",
                                "sense_id": "9638b042-d9c9-315a-8f65-8ef996e6cc21",
                                "text": "Les Rifains retranchés dans la montagne, tireurs adroits et ménagers de leurs munitions, s'étaient révélés comme des ennemis redoutables, […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "e95ed834-7a36-32ea-bef9-73577e9d3918",
                        "entry_id": "8856ded2-29f3-356e-a7c2-538cf699269e",
                        "glosses": [
                            "Approvisionnement d’un soldat."
                        ],
                        "tags": [
                            "Plus rare"
                        ],
                        "examples": [
                            {
                                "example_id": "e0d6d385-b43e-4298-bc89-f5ba996e49bd",
                                "sense_id": "e95ed834-7a36-32ea-bef9-73577e9d3918",
                                "text": "Et le voisin, en s’en allant, vit Guillaume mettre sa double charge de poudre dans son fusil de munition, y glisser ses trois lingots et poser l'arme dans un coin de sa boutique."
                            },
                            {
                                "example_id": "c472d5cc-88b3-469a-a179-2539346076e2",
                                "sense_id": "e95ed834-7a36-32ea-bef9-73577e9d3918",
                                "text": "Les jeunes garçons qui dédaignaient mon pain de munition auraient pu m'adresser à ce modèle « de bon pain et de bonne soupe »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f11ef63-419e-4b09-a59e-834ef3c0c483",
                        "source_entry_id": "8856ded2-29f3-356e-a7c2-538cf699269e",
                        "target_lang_word": "Munition",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Munition",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e1b6033c-ea1e-3c52-8954-03029e427b3d",
                                        "entry_id": "ca862e66-3221-3b48-8e4d-bd5475670704",
                                        "glosses": [
                                            "nicht fest mit der Waffe oder dem Werkzeug verbundene, meist nachladbare Teile, welche die eigentlichen Wirkungsträger darstellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8ec3d4b-38f1-46bc-8d63-298327fb8ad0",
                                                "sense_id": "e1b6033c-ea1e-3c52-8954-03029e427b3d",
                                                "text": "Die Munition ist der eigentliche Wirkungsträger einer Waffe."
                                            },
                                            {
                                                "example_id": "897c8c92-2667-430b-9826-2d57e972e06b",
                                                "sense_id": "e1b6033c-ea1e-3c52-8954-03029e427b3d",
                                                "text": "„Sie hängten sich die Karabiner um, schulterten die Panzerfäuste, nahmen die Kisten mit Munition und Handgranaten auf und bewegten sich in der einzigen Gangart, die das Gewicht der Waffen erlaubte…“"
                                            },
                                            {
                                                "example_id": "aa6d64da-dc60-44b0-92c8-20bd24a4763b",
                                                "sense_id": "e1b6033c-ea1e-3c52-8954-03029e427b3d",
                                                "text": "„Zur Herstellung von Munition, aber auch von Düngemitteln für die Landwirtschaft bilden Stickstoffverbindungen (Nitrate), darunter insbesondere Salpeter (NaNO₃) und Salpetersäure (HNO₃), einen unentbehrlichen Grundbestandteil.“"
                                            },
                                            {
                                                "example_id": "20fa8a00-1d26-4ff7-999c-d3614144c43e",
                                                "sense_id": "e1b6033c-ea1e-3c52-8954-03029e427b3d",
                                                "text": "„Eines Tages gelang es mir, sie dazu zu bringen, eine Ladung Munition auf ihrem Rücken bis in die vorderste Linie zu tragen.“"
                                            },
                                            {
                                                "example_id": "3ed88ddf-1de3-4934-b4f5-fe6d9dcd3e08",
                                                "sense_id": "e1b6033c-ea1e-3c52-8954-03029e427b3d",
                                                "text": "„Britische Beutemaschinen mit deutschen Besatzungen warfen nun über dem Partisanengebiet Munition ab, die wirklich zu den Waffen paßte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07efeeb8-68ba-46d8-b48c-232cc8d7ccc4",
                        "source_entry_id": "8856ded2-29f3-356e-a7c2-538cf699269e",
                        "target_lang_word": "ammunition",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
