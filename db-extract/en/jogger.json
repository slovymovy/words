                                        "entry_id": "96ee0fef-2d92-320c-84ff-776bafd1a02b",
                                        "glosses": [
                                            "weibliche Person, die die Sportart Jogging ausübt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ef41617-3a2b-44c6-a961-5da33e30f139",
                                                "sense_id": "fc28f8ef-89c5-34b1-bd70-65e26ab6fb7a",
                                                "text": "„Mehr als ein Jahr nach dem gewaltsamen Tod einer Joggerin in Endingen bei Freiburg hat das Gericht den 40-jährigen Angeklagten zu lebenslanger Haft mit anschließender Sicherungsverwahrung verurteilt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
