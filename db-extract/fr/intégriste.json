                "entry_id": "7c48db3f-d777-3faf-a1fd-dfcaafee06d4",
                "word": "intégriste",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "da629716-5c51-4856-985d-6122f5ec3972",
                        "entry_id": "7c48db3f-d777-3faf-a1fd-dfcaafee06d4",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "intégristes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "11ecd42a-0640-3894-993b-f01df03d8d50",
                        "entry_id": "7c48db3f-d777-3faf-a1fd-dfcaafee06d4",
                        "glosses": [
                            "Relatif à l'intégrisme, au maintien, à l'intégrité de la tradition religieuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99cad2cb-f097-4c8a-a78c-1de3bb2dd2f8",
                                "sense_id": "11ecd42a-0640-3894-993b-f01df03d8d50",
                                "text": "Bref, les frontières entre catholiques « observants », « traditionalistes » et « intégristes » semblent poreuses dans l’entre-soi versaillais."
                            },
                            {
                                "example_id": "77d31c33-44ca-4e14-b1c7-0576fe7242eb",
                                "sense_id": "11ecd42a-0640-3894-993b-f01df03d8d50",
                                "text": "Dans la convention intégriste, il mérite le même sort que son père. On a égorgé pas mal de gosses simplement parce qu’ils avaient des parents soldats ou policiers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5f8169e5-012e-4527-8ee8-b73fa6d14994",
                        "source_entry_id": "7c48db3f-d777-3faf-a1fd-dfcaafee06d4",
                        "source_sense_id": "11ecd42a-0640-3894-993b-f01df03d8d50",
                        "target_lang_word": "strenggläubig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "strenggläubig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dffa99ef-41f9-3206-ae63-01f1607fe9ca",
                                        "entry_id": "cdb642ef-f353-3294-be99-8abe714e4210",
                                        "glosses": [
                                            "sehr fromm, sich streng an die Grundsätze und Vorschriften des Glaubens haltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c699248-4fbb-4bc4-a169-a4c614b5ff00",
                                                "sense_id": "dffa99ef-41f9-3206-ae63-01f1607fe9ca",
                                                "text": "„Mit dem Wandel des Christentums von der strenggläubigen Minderheit zur Massenkirche wurden Strafen reduziert, zum Beispiel entstand das Sakrament der Beichte, und daher ist die Exkommunikation und somit die Rekonziliation selten geworden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb315c96-501d-4ad6-aefd-67d8c3fce51c",
                        "source_entry_id": "7c48db3f-d777-3faf-a1fd-dfcaafee06d4",
                        "source_sense_id": "11ecd42a-0640-3894-993b-f01df03d8d50",
