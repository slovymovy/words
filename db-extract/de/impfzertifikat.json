                "senses": [
                    {
                        "sense_id": "23fc851a-0426-3a7d-b0f0-1a10aa506f19",
                        "entry_id": "a91fdad7-52d9-35b6-9992-36f3322369f4",
                        "glosses": [
                            "Dokument/Beleg, das eine erfolgte Impfung nachweist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "980077c6-2cd3-4d54-a0c3-fb929b3322ef",
                                "sense_id": "23fc851a-0426-3a7d-b0f0-1a10aa506f19",
                                "text": "[Coronapandemie 2021:] „Ihr Impfzertifikat erhalten Bürgerinnen und Bürger nach ihrer Impfung beim Arzt oder im Impfzentrum.“"
                            },
                            {
                                "example_id": "cde2a74b-26fa-44e0-a0f5-775dcab387eb",
                                "sense_id": "23fc851a-0426-3a7d-b0f0-1a10aa506f19",
                                "text": "[Coronapandemie 2021:] „Seit Mitte August 2021 wurden nach Angaben der ZKG auf einem deutschsprachigen Cybercrime-Forum unberechtigt erstellte QR-Codes für den digitalen Corona-Impfausweis zum Preis von zuletzt 350 Euro angeboten, ohne dass eine Impfung tatsächlich erfolgt oder nachgewiesen war. […] Allein im Oktober 2021 sollen so über 500 Impfzertifikate ausgestellt worden sein.“"
                            },
                            {
                                "example_id": "1ce50bdc-c0dc-4509-8c74-1262d2401f59",
                                "sense_id": "23fc851a-0426-3a7d-b0f0-1a10aa506f19",
                                "text": "[Coronapandemie 2021:] „Trainer Markus Anfang tritt bei Werder Bremen zurück – […] Am Donnerstag war bekannt geworden, dass gegen den 47-jährigen Anfang Ermittlungen wegen eines gefälschten Impfzertifikates laufen.“"
                            },
                            {
                                "example_id": "a2ed9d1a-9c74-466d-91ba-26f3f07a566e",
                                "sense_id": "23fc851a-0426-3a7d-b0f0-1a10aa506f19",
                                "text": "[Coronapandemie 2021:] „Das EU-weite digitale Impfzertifikat gilt erstmal nur bis 30.06.2022. Ob die Gültigkeit verlängert wird, ist momentan unklar.“"
                            },
                            {
                                "example_id": "c85e4096-1e4a-48a7-a58d-edc99c53e450",
                                "sense_id": "23fc851a-0426-3a7d-b0f0-1a10aa506f19",
                                "text": "[Coronapandemie 2021:] „Regensburger Berufsschüler sollen gefälschte Impfpässe in Apotheken vorgezeigt haben, um so an ein digitales Impfzertifikat zu kommen. Die Kripo ermittelt.“"
                            },
                            {
                                "example_id": "beef5436-d532-449c-b02a-0dd4dc741865",
                                "sense_id": "23fc851a-0426-3a7d-b0f0-1a10aa506f19",
                                "text": "[Coronapandemie 2021:] „Überraschendes Urteil zu gefälschten Impfausweisen – Wer sich mit einem gefälschten Impfausweis in einer Apotheke ein digitales Impfzertifikat verschafft, macht sich nicht strafbar.“"
                            },
                            {
                                "example_id": "2101adbe-7a79-446c-984c-949ca9e049a7",
                                "sense_id": "23fc851a-0426-3a7d-b0f0-1a10aa506f19",
                                "text": "[Coronapandemie 2021:] „»Die niedersächsischen Generalstaatsanwaltschaften halten die Herstellung und Vorlage gefälschter Impfzertikate zur Erlangung eines digitalen Impfzertifikats in einer Apotheke für strafbar.« So die eindeutige Aussage der Generalstaatsanwaltschaften.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
