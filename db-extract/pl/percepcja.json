                                "target_senses": [
                                    {
                                        "sense_id": "475f579b-1a5b-3ca9-9972-245d2699342d",
                                        "entry_id": "3ebf6920-7f72-3bb4-8fd2-bdec6e0b54ee",
                                        "glosses": [
                                            "aktivita spočívající v tom, že někdo něco vnímá"
                                        ],
                                        "tags": [],
