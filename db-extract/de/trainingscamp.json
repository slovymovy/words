                "senses": [
                    {
                        "sense_id": "69cfe431-0333-3b72-8011-d47fb3689cdf",
                        "entry_id": "f01f10c0-cede-3a6a-ba35-9f5a665ebbb7",
                        "glosses": [
                            "Camp, in dem Trainingsaktivitäten stattfinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcd767bf-f782-4c91-bd95-4ecefb7c8a8c",
                                "sense_id": "69cfe431-0333-3b72-8011-d47fb3689cdf",
                                "text": "„Hilfsangebote für straffällig gewordene Jugendliche gibt es viele, etwa das Trainingscamp von Lothar Kannenberg in Hessen.“"
                            },
                            {
                                "example_id": "32d6b9a5-4a26-4229-9dff-4bcd7bc11285",
                                "sense_id": "69cfe431-0333-3b72-8011-d47fb3689cdf",
                                "text": "„In Süd-Waziristan haben hunderte Taliban und El-Kaida-Terroristen Unterschlupf gefunden, die dort Trainingscamps unterhalten und Anschläge im Ausland vorbereiten.“"
                            },
                            {
                                "example_id": "23e5d6a7-e7b4-43fb-8e55-c3dc79ddeb04",
                                "sense_id": "69cfe431-0333-3b72-8011-d47fb3689cdf",
                                "text": "„Karami hat Kontakt mit einem Mann, der mit ihm im Trainingscamp in Afghanistan war und jetzt in Madrid sitzt.“"
                            }
                        ],
