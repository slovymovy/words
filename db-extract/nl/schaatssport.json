                        "examples": [
                            {
                                "example_id": "48ff3bb9-394f-45ab-bee2-2b3029380a50",
                                "sense_id": "ca1f21dc-47fc-387e-836a-4bc66b78567d",
                                "text": "Sven Kramer staat aan de vooravond van alweer zijn veertiende schaatsseizoen. Het 32-jarige boegbeeld van de schaatssport, onlangs vader geworden, heeft een uitpuilende prijzenkast, maar zijn honger is nog altijd niet gestild."
                            },
                            {
                                "example_id": "035c808b-7cc1-4a6f-a907-6f33ada5d421",
                                "sense_id": "ca1f21dc-47fc-387e-836a-4bc66b78567d",
                                "text": "De ondergang van iSkate heeft bij velen een wrange smaak nagelaten. Sommige schaatsers hebben nog een flinke som geld tegoed, omdat salarissen en bonussen bij herhaling niet zijn uitgekeerd. Hoewel iSkate formeel nog bestaat, heeft het bedrijf als gevolg van de financiële problemen en het niet kunnen vinden van sponsoren de banden met de schaatssport verbroken."
                            }
                        ]
                    }
