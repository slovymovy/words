                        "entry_id": "58e58860-6f07-3f56-bdfe-ac30d627f669",
                        "glosses": [
                            "Qui soûle, qui enivre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e80e750-2659-4128-88c8-772a4198a004",
                                "sense_id": "bb84bfb8-5a00-3c7e-86ac-55c1dae9f13f",
                                "text": "Vers Montevideo — à la grâce de Dieu qui souffle sur leur cime un éternel feu bleu, parmi le noir, le vert et le soufre et les chromes, dans la forêt sans fin et soûlante d’arômes, au seul cri du hocco pour cent mille fantômes."
                            }
                        ]
                    },
                    {
                        "sense_id": "50526356-ea85-3f7a-bca2-48ef99d87ff1",
                        "entry_id": "58e58860-6f07-3f56-bdfe-ac30d627f669",
                        "glosses": [
                            "Qui importune, ennuie."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "4198aac4-6ab9-48ce-81ff-6fb6aabd8dbb",
                                "sense_id": "50526356-ea85-3f7a-bca2-48ef99d87ff1",
                                "text": "Sacha profita de l’abandon de Vera, accaparée par une voisine à la logorrhée soûlante, pour trinquer avec Igor."
                            }
                        ]
                    }
