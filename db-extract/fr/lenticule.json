                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2cee31c-b8dd-48e1-9fa9-cb0c6318181b",
                                "sense_id": "eb4c2da7-a6b7-3759-93a3-4ab38d4aed5b",
                                "text": "Les murs de la maison et la surface aquatique subissent tous deux les assauts d’un végétal prédateur : respectivement, un lierre, une lenticule proliférante, l’Anseria Slimatica."
                            },
                            {
                                "example_id": "262ef899-29fe-480d-a866-aa96e0980299",
                                "sense_id": "eb4c2da7-a6b7-3759-93a3-4ab38d4aed5b",
                                "text": "Une partie des étangs est recouverte d’un soyeux tapis vert composé de lenticules mineures, où l’on est assuré de voir des canards se nourrir."
                            },
                            {
                                "example_id": "ca8a8c15-d9e4-4616-9d16-43f33d186caf",
                                "sense_id": "eb4c2da7-a6b7-3759-93a3-4ab38d4aed5b",
                                "text": "À travers les algues, les lenticules et les sédiments en suspension dans l'eau, j'ai fini par discerner un ballot de jute."
                            }
                        ]
                    }
