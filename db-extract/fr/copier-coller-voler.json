                "senses": [
                    {
                        "sense_id": "cea4ffb5-6b66-30a6-8153-47fedeac5120",
                        "entry_id": "b35b6ed9-a8ff-3ca9-983d-4b47559d7185",
                        "glosses": [
                            "Copier-coller ayant pour objectif le vol ou le plagiat."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "51bf5fa7-969b-41d1-9026-f0d47347db41",
                                "sense_id": "cea4ffb5-6b66-30a6-8153-47fedeac5120",
                                "text": "Merci à un Bon Samaritain de Copier-Coller-VOLER cet Article Inaccessible pour nous les de 99% de Gueux!!! 😤😤😤"
                            },
                            {
                                "example_id": "330b41c8-788a-4009-92ec-cf185686d656",
                                "sense_id": "cea4ffb5-6b66-30a6-8153-47fedeac5120",
                                "text": "De tout temps d’autres ont cru et pensé que s’inspirer de,\nc’était copier-coller-voler.\nComme si donner une autre forme, une autre couleur, une autre saveur à une idée,\nc’était soudain la faire sienne."
                            },
                            {
                                "example_id": "128881e1-54b1-4ca7-8483-a1d42e1648f3",
                                "sense_id": "cea4ffb5-6b66-30a6-8153-47fedeac5120",
                                "text": "C'est horrible de copier coller voler un projet existant (STFX).\nLes gars ayez des valeurs un peu.\nSoyez des hommes.\nVous arrivez a dormir le soir?"
                            },
                            {
                                "example_id": "bc09a7f8-b5ca-4062-84c9-494d289bd5fb",
                                "sense_id": "cea4ffb5-6b66-30a6-8153-47fedeac5120",
                                "text": "COPIE-COLLE-VOLE, ON PEUT RIEN VOIR!!!"
                            }
                        ]
                    }
