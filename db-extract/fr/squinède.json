                        ],
                        "examples": [
                            {
                                "example_id": "9007f757-5523-41ed-924c-58da2b066a83",
                                "sense_id": "4995dad7-3fb0-3176-bb9e-ee6469158f5e",
                                "text": "Se faire tondre en ne faisant qu'une mince frange sur le front, à la manière de zouaves. Aujourd'hui on dirait peut-être se faire une coupe comme un « squinède » (skin-head)."
                            },
                            {
                                "example_id": "62617a74-4da9-48ec-bd43-0080e628cd27",
                                "sense_id": "4995dad7-3fb0-3176-bb9e-ee6469158f5e",
                                "text": "J'ai même un ancien pote goth qui s'est fait massacrer en se faisant traiter de sale squinède si c'est pas malheureux les braves rebelles rapeurs."
                            },
                            {
                                "example_id": "d203d138-8cc4-4579-9471-f570ceb9cd82",
                                "sense_id": "4995dad7-3fb0-3176-bb9e-ee6469158f5e",
                                "text": "Votre tentative de démonstration ne tient pas cinq minutes, le fait est que vous avez du trouver quatre faits divers, commis par des squinèdes, répartis sur les dix dernières années – et qui ont été condamnés par la justice -, pour en contredire vingt autres… quotidiens […]."
                            }
                        ]
                    }
