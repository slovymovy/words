                        "tags": [],
                        "examples": [
                            {
                                "example_id": "116f36d6-d209-49fd-8e12-8e9efea5129c",
                                "sense_id": "2af7ded6-f479-3d64-a2b9-06f2fc409dfe",
                                "text": "„Daraufhin strich der alte Mann seine Kapuze zurück und deutete auf die Familienähnlichkeiten in seinen Gesichtszügen, doch mich packte nur ein Schauder, denn ich hegte keinen Zweifel, dass dieses Gesicht lediglich eine teuflische Wachsmaske war.“"
                            },
                            {
                                "example_id": "40589087-3722-4627-b9c0-2a1fd2b80ddf",
                                "sense_id": "2af7ded6-f479-3d64-a2b9-06f2fc409dfe",
                                "text": "„Vielleicht sollte man, um sich selbst ›ein Bild zu machen‹, die Wachsmaske besichtigen, die am Tag nach seinem Tod abgenommen wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
