                        "translation_id": "97e1daf4-94dd-46fa-a914-593ce137beec",
                        "source_entry_id": "3cce09d4-519c-3264-9613-11b3775308b6",
                        "source_sense_id": "3c3a8751-d280-38fe-bf56-52e986c381a4",
