{
    "word_family": [
        "glorify",
        "glorious",
        "glorification",
        "vainglory"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5a989951-0936-3198-a52e-708497fd48a9",
                    "sense_definition": "High reputation, renown, or honor won by notable achievements.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "honor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young athlete dreamed of winning Olympic <w>glory</w> for his country.",
                            "target_lang_translations": {
                                "ru": "Молодой атлет мечтал завоевать олимпийскую <w>славу</w> для своей страны.",
                                "tr": "Genç atlet ülkesi için olimpiyat <w>zaferi</w> kazanmayı hayal ediyordu."
                            }
                        },
                        {
                            "text": "He was more interested in personal <w>glory</w> than in the success of the team.",
                            "target_lang_translations": {
                                "ru": "Его больше интересовала личная <w>слава</w>, чем успех команды.",
                                "tr": "Kişisel <w>şan</w> ve şöhret, onun için takımın başarısından daha önemliydi."
                            }
                        }
                    ],
                    "synonyms": [
                        "fame",
                        "honor",
                        "honour"
                    ],
                    "antonyms": [
                        "shame",
                        "dishonor",
                        "obscurity"
                    ],
                    "common_phrases": [
                        "win glory",
                        "personal glory",
                        "moment of glory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Высокая репутация, известность или почет, завоеванные выдающимися достижениями.",
                        "tr": "Önemli başarılarla kazanılan yüksek itibar, ün veya onur."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слава",
                                "target_lang_sense_clarification": "широкая известность и почет"
                            },
                            {
                                "target_lang_word": "триумф",
                                "target_lang_sense_clarification": "выдающийся успех"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "şan",
                                "target_lang_sense_clarification": "ün ve şöhret"
                            },
                            {
                                "target_lang_word": "şeref",
                                "target_lang_sense_clarification": "onur ve saygınlık"
                            },
                            {
                                "target_lang_word": "zafer",
                                "target_lang_sense_clarification": "başarıdan doğan gurur"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f62639c-89b7-3509-b890-739aae9a19ab",
                    "sense_definition": "Magnificent or great beauty and splendor.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "splendor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tourists woke up early to see the <w>glory</w> of the sunrise over the mountains.",
                            "target_lang_translations": {
                                "ru": "Туристы проснулись рано, чтобы увидеть <w>великолепие</w> рассвета над горами.",
                                "tr": "Turistler, dağların üzerindeki gün doğumunun <w>görkemini</w> görmek için erken uyandılar."
                            }
                        },
                        {
                            "text": "The palace has been restored to its former <w>glory</w> after years of neglect.",
                            "target_lang_translations": {
                                "ru": "Дворцу вернули его былое <w>величие</w> после многих лет запустения.",
                                "tr": "Saray, yıllarca süren bakımsızlığın ardından eski <w>ihtişamına</w> kavuşturuldu."
                            }
                        }
                    ],
                    "synonyms": [
                        "praise",
                        "worship"
                    ],
                    "common_phrases": [
                        "former glory",
                        "morning glory",
                        "blaze of glory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Величественная или великая красота и великолепие.",
                        "tr": "Muhteşem veya büyük güzellik, ihtişam."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "великолепие",
                                "target_lang_sense_clarification": "пышная красота"
                            },
                            {
                                "target_lang_word": "величие",
                                "target_lang_sense_clarification": "торжественная красота"
                            },
                            {
                                "target_lang_word": "блеск",
                                "target_lang_sense_clarification": "сияющая красота"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "görkem",
                                "target_lang_sense_clarification": "göz alıcı ihtişam"
                            },
                            {
                                "target_lang_word": "ihtişam",
                                "target_lang_sense_clarification": "büyüleyici güzellik"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48449326-7d1f-311c-98c0-b9492ba95125",
                    "sense_definition": "A state of great success or victory.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "honor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team managed to snatch <w>glory</w> in the final minutes of the match.",
                            "target_lang_translations": {
                                "ru": "Команде удалось вырвать <w>победу</w> на последних минутах матча.",
                                "tr": "Takım, maçın son dakikalarında <w>zaferi</w> söküp almayı başardı."
                            }
                        },
                        {
                            "text": "They fought hard on the battlefield, seeking <w>glory</w> and freedom.",
                            "target_lang_translations": {
                                "ru": "Они упорно сражались на поле боя в поисках <w>славы</w> и свободы.",
                                "tr": "<w>Şan</w> ve özgürlük arayışıyla savaş alanında çetin bir mücadele verdiler."
                            }
                        }
                    ],
                    "antonyms": [
                        "defeat",
                        "failure"
                    ],
                    "common_phrases": [
                        "snatch glory",
                        "path to glory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние большого успеха или победы.",
                        "tr": "Büyük bir başarı veya zafer durumu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слава",
                                "target_lang_sense_clarification": "победа и признание"
                            },
                            {
                                "target_lang_word": "триумф",
                                "target_lang_sense_clarification": "блестящий успех"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "zafer",
                                "target_lang_sense_clarification": "büyük başarı"
                            },
                            {
                                "target_lang_word": "başarı",
                                "target_lang_sense_clarification": "kazanılan üstünlük"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23ca3a73-25b4-3cdd-986f-8737379e8f1e",
                    "sense_definition": "Praise, honor, or thanksgiving offered in adoration to a deity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The congregation sang hymns to give <w>glory</w> to God.",
                            "target_lang_translations": {
                                "ru": "Прихожане пели гимны, чтобы воздать <w>славу</w> Богу.",
                                "tr": "Cemaat, Tanrı'yı <w>yüceltmek</w> için ilahiler söyledi."
                            }
                        },
                        {
                            "text": "The ancient temple was built for the <w>glory</w> of the gods.",
                            "target_lang_translations": {
                                "ru": "Древний храм был построен во <w>славу</w> богов.",
                                "tr": "Antik tapınak, tanrıların <w>yüceliği</w> için inşa edilmişti."
                            }
                        }
                    ],
                    "synonyms": [
                        "praise",
                        "worship"
                    ],
                    "common_phrases": [
                        "glory to God",
                        "give glory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Хвала, почет или благодарность, возносимые божеству.",
                        "tr": "Bir tanrıya ibadet amacıyla sunulan övgü, yüceltme veya şükür."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слава",
                                "target_lang_sense_clarification": "религиозное прославление"
                            },
                            {
                                "target_lang_word": "хвала",
                                "target_lang_sense_clarification": "выражение благодарности Богу"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yücelik",
                                "target_lang_sense_clarification": "dini övgü ve kutsallık"
                            },
                            {
                                "target_lang_word": "hamd",
                                "target_lang_sense_clarification": "tanrıya şükür ve övgü"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d5fdcd19-6277-3a92-a115-6a856275bfdd",
                    "sense_definition": "A circle of light or halo represented around the head or body of a holy person in art.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The saint was depicted with a golden <w>glory</w> surrounding her head.",
                            "target_lang_translations": {
                                "ru": "Святая была изображена с золотым <w>нимбом</w> вокруг головы.",
                                "tr": "Azize, başını çevreleyen altın rengi bir <w>hale</w> ile tasvir edilmişti."
                            }
                        },
                        {
                            "text": "The artist used bright colors to paint a <w>glory</w> around the central figure.",
                            "target_lang_translations": {
                                "ru": "Художник использовал яркие цвета, чтобы нарисовать <w>ореол</w> вокруг центральной фигуры.",
                                "tr": "Sanatçı, merkezdeki figürün etrafına bir <w>hare</w> çizmek için canlı renkler kullandı."
                            }
                        }
                    ],
                    "synonyms": [
                        "halo"
                    ],
                    "target_lang_definitions": {
                        "ru": "Круг света или ореол, изображаемый вокруг головы или тела святого в искусстве.",
                        "tr": "Sanatta kutsal kişilerin başının veya vücudunun etrafında çizilen ışık halkası veya hare."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нимб",
                                "target_lang_sense_clarification": "сияние вокруг головы"
                            },
                            {
                                "target_lang_word": "ореол",
                                "target_lang_sense_clarification": "световой круг"
                            },
                            {
                                "target_lang_word": "сияние",
                                "target_lang_sense_clarification": "лучистый свет"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "hare",
                                "target_lang_sense_clarification": "ışık halkası"
                            },
                            {
                                "target_lang_word": "hale",
                                "target_lang_sense_clarification": "baş etrafındaki kutsal ışık"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "136752fb-4c8c-3fdc-8c1a-d420dec7d82d",
                    "sense_definition": "An optical phenomenon of concentric rings caused by light interacting with water droplets in mist.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot observed a rare <w>glory</w> on the clouds below the aircraft.",
                            "target_lang_translations": {
                                "ru": "Пилот наблюдал редкую <w>глорию</w> на облаках под самолетом.",
                                "tr": "Pilot, uçağın altındaki bulutlarda nadir görülen bir <w>gloria</w> olayı gözlemledi."
                            }
                        },
                        {
                            "text": "A <w>glory</w> is often seen by mountain climbers when looking into fog with the sun behind them.",
                            "target_lang_translations": {
                                "ru": "<w>Глорию</w> часто видят альпинисты, когда смотрят в туман, находясь спиной к солнцу.",
                                "tr": "Güneşi arkalarına alan dağcılar, sise baktıklarında sıkça bir <w>gloria</w> halkası görürler."
                            }
                        }
                    ],
                    "synonyms": [
                        "anticorona"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific/meteorological context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оптическое явление в виде концентрических колец, возникающее при взаимодействии света с каплями воды в тумане.",
                        "tr": "Işığın sisteki su damlacıklarıyla etkileşimi sonucu oluşan iç içe geçmiş halkalardan ibaret optik doğa olayı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глория",
                                "target_lang_sense_clarification": "метеорологический термин"
                            },
                            {
                                "target_lang_word": "сияние",
                                "target_lang_sense_clarification": "оптический эффект"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "gloria",
                                "target_lang_sense_clarification": "meteorolojik optik olay"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c707ffbe-19dd-340b-9c6c-ca371bb61853",
                    "sense_definition": "To take great pride or pleasure in something; to exult.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The victorious general seemed to <w>glory</w> in the defeat of his enemies.",
                            "target_lang_translations": {
                                "ru": "Победоносный генерал, казалось, <w>упивался</w> поражением своих врагов.",
                                "tr": "Galip general, düşmanlarının yenilgisiyle <w>gururlanıyor</w> gibi görünüyordu."
                            }
                        },
                        {
                            "text": "She does not just accept her success; she <w>glories</w> in it.",
                            "target_lang_translations": {
                                "ru": "Она не просто принимает свой успех, она им <w>наслаждается</w>.",
                                "tr": "O sadece başarısını kabul etmekle kalmıyor, onunla <w>övünüyor</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "glory in"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывать большую гордость или удовольствие от чего-либо; ликовать.",
                        "tr": "Bir şeyden büyük gurur veya zevk duymak; övünmek, gururlanmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наслаждаться",
                                "target_lang_sense_clarification": "получать удовольствие от успеха"
                            },
                            {
                                "target_lang_word": "упиваться",
                                "target_lang_sense_clarification": "сильно гордиться чем-либо"
                            },
                            {
                                "target_lang_word": "ликовать",
                                "target_lang_sense_clarification": "торжествовать"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "gururlanmak",
                                "target_lang_sense_clarification": "bir şeyle büyük gurur duymak"
                            },
                            {
                                "target_lang_word": "övünmek",
                                "target_lang_sense_clarification": "başarıyla gurur duymak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af5ca11a-2354-3bf8-a409-bbb883d7eddf",
                    "sense_definition": "To shine with a radiant or magnificent light.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "splendor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The setting sun was <w>glorying</w> round the mountain peaks.",
                            "target_lang_translations": {
                                "ru": "Заходящее солнце <w>сияло</w> вокруг горных вершин.",
                                "tr": "Batan güneş, dağ zirvelerinin etrafında <w>ışıldıyordu</w>."
                            }
                        },
                        {
                            "text": "The stained glass windows <w>glory</w> when the light hits them directly.",
                            "target_lang_translations": {
                                "ru": "Витражные окна <w>блистают</w>, когда на них падает прямой свет.",
                                "tr": "Vitray pencereler, ışık doğrudan üzerlerine vurduğunda <w>parlar</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сиять лучистым или великолепным светом.",
                        "tr": "Parlak veya muhteşem bir ışıkla ışıldamak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сиять",
                                "target_lang_sense_clarification": "излучать яркий свет"
                            },
                            {
                                "target_lang_word": "блистать",
                                "target_lang_sense_clarification": "великолепно светиться"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ışıldamak",
                                "target_lang_sense_clarification": "parlak ışık saçmak"
                            },
                            {
                                "target_lang_word": "parlamak",
                                "target_lang_sense_clarification": "görkemli şekilde ışık yaymak"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b8b2c2e9-158c-38f0-84f2-dec1e3bfa7ad",
                    "sense_definition": "A female given name.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Her parents decided to name her <w>Glory</w> because she was born on a bright Sunday.",
                            "target_lang_translations": {
                                "ru": "Ее родители решили назвать ее <w>Глорией</w>, потому что она родилась в яркое воскресенье.",
                                "tr": "Ailesi, parlak bir pazar günü doğduğu için ona <w>Glory</w> adını vermeye karar verdi."
                            }
                        },
                        {
                            "text": "<w>Glory</w> is a less common variation of the name Gloria.",
                            "target_lang_translations": {
                                "ru": "<w>Глори</w> — менее распространенный вариант имени Глория.",
                                "tr": "<w>Glory</w>, Gloria isminin daha az yaygın bir varyasyonudur."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское имя.",
                        "tr": "Bir kadın ismi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Глория",
                                "target_lang_sense_clarification": "имя собственное"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "Glory",
                                "target_lang_sense_clarification": "özel isim"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}