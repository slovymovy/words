{
    "word_family": [
        "mobilization",
        "mobility",
        "mobile",
        "immobilize",
        "demobilize"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8ff778e2-f3bc-365f-9ceb-910b07497ae7",
                    "sense_definition": "To organize or prepare something or someone for action or use.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "organize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The community decided to <w>mobilize</w> resources to help the families affected by the storm.",
                            "target_lang_translations": {
                                "ru": "Община решила <w>мобилизовать</w> ресурсы, чтобы помочь семьям, пострадавшим от шторма."
                            }
                        },
                        {
                            "text": "We need to <w>mobilize</w> support among the local residents before the vote next week.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>заручиться</w> поддержкой местных жителей перед голосованием на следующей неделе."
                            }
                        }
                    ],
                    "synonyms": [
                        "rally",
                        "marshal",
                        "organize"
                    ],
                    "antonyms": [
                        "disorganize"
                    ],
                    "common_phrases": [
                        "mobilize support",
                        "mobilize resources",
                        "mobilize the community"
                    ],
                    "target_lang_definitions": {
                        "ru": "Организовывать или подготавливать что-либо или кого-либо к действию или использованию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мобилизовать",
                                "target_lang_sense_clarification": "ресурсы, силы или поддержку"
                            },
                            {
                                "target_lang_word": "задействовать",
                                "target_lang_sense_clarification": "использовать имеющиеся возможности"
                            },
                            {
                                "target_lang_word": "сплотить",
                                "target_lang_sense_clarification": "людей ради общей цели"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57c328ab-740d-36d8-914a-74d6179d7b9b",
                    "sense_definition": "To assemble and prepare military forces and equipment for active service or war.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government began to <w>mobilize</w> troops along the border as tensions continued to rise.",
                            "target_lang_translations": {
                                "ru": "Правительство начало <w>мобилизовать</w> войска вдоль границы, так как напряженность продолжала расти."
                            }
                        },
                        {
                            "text": "It took several weeks to <w>mobilize</w> the army for the upcoming peacekeeping mission.",
                            "target_lang_translations": {
                                "ru": "Потребовалось несколько недель, чтобы <w>подготовить</w> армию к предстоящей миротворческой миссии."
                            }
                        }
                    ],
                    "synonyms": [
                        "call up",
                        "conscript"
                    ],
                    "antonyms": [
                        "demobilize"
                    ],
                    "common_phrases": [
                        "mobilize troops",
                        "mobilize the army",
                        "mobilize for war"
                    ],
                    "target_lang_definitions": {
                        "ru": "Собирать и подготавливать вооруженные силы и технику к активной службе или войне."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мобилизовать",
                                "target_lang_sense_clarification": "войска или армию"
                            },
                            {
                                "target_lang_word": "призывать",
                                "target_lang_sense_clarification": "на военную службу"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}