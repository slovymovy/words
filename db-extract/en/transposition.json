                    {
                        "translation_id": "2bfa6a16-eb15-4532-b82e-e117c1e4c61a",
                        "source_entry_id": "b79c0093-9fda-379c-b59f-1d780efe5502",
                        "source_sense_description": "incorporation of the EU directive into domestic law",
                        "target_lang_word": "transposition",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transposition",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "10c1637c-1474-32a2-9c14-0f001ff2d166",
                                        "entry_id": "d1d56118-5b84-333a-a7c9-45a94015e2f7",
                                        "glosses": [
                                            "Action de transposer ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cc35e69-e666-4410-b29b-1b6a9d69edca",
                                                "sense_id": "10c1637c-1474-32a2-9c14-0f001ff2d166",
                                                "text": "… mais il faut faire attention que ces répétitions de ventes & d’achats qui multiplient infructueusement la circulation ne sont que transposition, & augmentation de frais sans production de richesses."
                                            },
                                            {
                                                "example_id": "5ccac318-9b4c-493f-965f-385aa28d7910",
                                                "sense_id": "10c1637c-1474-32a2-9c14-0f001ff2d166",
                                                "text": "Les équipements de télécommunications, que l’on appelle des répéteurs, assurent les mêmes fonctions qu’un relai hertzien : ils reçoivent les émissions provenant de la Terre et les réémettent vers la Terre après amplification et transposition en fréquence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2462f22f-3357-3ab5-80a0-a4f8d87cda8d",
                                        "entry_id": "d1d56118-5b84-333a-a7c9-45a94015e2f7",
                                        "glosses": [
                                            "Action d’intervertir l’ordre dans lequel les mots sont habituellement rangés."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01080f38-15da-4bdf-ab66-997347e296b8",
                                                "sense_id": "2462f22f-3357-3ab5-80a0-a4f8d87cda8d",
                                                "text": "Transposition vicieuse, élégante."
                                            },
                                            {
                                                "example_id": "309e243a-32d8-40d8-87f2-c9fbd278dec9",
                                                "sense_id": "2462f22f-3357-3ab5-80a0-a4f8d87cda8d",
                                                "text": "La poésie supporte mieux les transpositions que la prose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ebf88c4-b280-3edf-b0ba-f609fc4046d7",
                                        "entry_id": "d1d56118-5b84-333a-a7c9-45a94015e2f7",
                                        "glosses": [
                                            "Interversion de feuilles d’impression, de cahiers d’écriture."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7294a7a8-4867-39ea-9de4-11890b89d47e",
                                        "entry_id": "d1d56118-5b84-333a-a7c9-45a94015e2f7",
                                        "glosses": [
                                            "Action de faire passer d’un ton dans un autre ; résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17ed987b-6ca3-40a2-9460-0a0399e9964a",
                                                "sense_id": "7294a7a8-4867-39ea-9de4-11890b89d47e",
                                                "text": "S’exercer à la transposition."
                                            },
                                            {
                                                "example_id": "da9711d5-5ae9-47a0-9e04-e79254fd1f6c",
                                                "sense_id": "7294a7a8-4867-39ea-9de4-11890b89d47e",
                                                "text": "Ce n’est pas le ton original, c’est une transposition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5973e832-2e63-3622-a5f0-27bde5f34b17",
                                        "entry_id": "d1d56118-5b84-333a-a7c9-45a94015e2f7",
                                        "glosses": [
                                            "Changement de la localisation d’un fragment d’ADN sur le génome."
                                        ],
                                        "tags": [
                                            "Génétique"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7426a000-a5c7-3e72-8242-be99ff4dd79c",
                                        "entry_id": "d1d56118-5b84-333a-a7c9-45a94015e2f7",
                                        "glosses": [
                                            "Permutation échangeant exactement deux éléments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00b5b844-7645-48ec-b46e-4dd8578db9c9",
                                                "sense_id": "7426a000-a5c7-3e72-8242-be99ff4dd79c",
                                                "text": "La permutation de 1,2,3,4,5 qui envoie 1 sur 3 et 3 sur 1 tout en laissant 2, 4 et 5 inchangés est une transposition, que l’on peut noter σ_(1,3) ou (1 3)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cca3b09b-d675-35a6-90cd-ee9de57826cb",
                                        "entry_id": "d1d56118-5b84-333a-a7c9-45a94015e2f7",
                                        "glosses": [
                                            "Pour une matrice, permutation échangeant chaque ligne en une colonne et vice versa, donnant la matrice transposée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1378931f-b0ce-4d80-844e-3bb77327da8c",
                                                "sense_id": "cca3b09b-d675-35a6-90cd-ee9de57826cb",
                                                "text": "La transposition de la matrice 1 2\\3 4\\5 6 donne la matrice transposée 1 3 5\\2 4 6."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7369d6d-80ef-3c78-a265-320b8c02d02e",
                                        "entry_id": "d1d56118-5b84-333a-a7c9-45a94015e2f7",
                                        "glosses": [
                                            "Action de transposer une directive, une décision de l’Union européenne en droit interne."
                                        ],
                                        "tags": [
                                            "European-Union"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6c7c63d-5759-4f80-b20b-067d13fa014c",
                                                "sense_id": "d7369d6d-80ef-3c78-a265-320b8c02d02e",
                                                "text": "La circulaire du Premier ministre du 27 septembre 2004 relative à la procédure de transposition en droit interne des directives et décisions-cadres négociées dans le cadre des institutions européennes prévoit l’élaboration, dès le stade de la négociation du texte européen, d’une analyse d’impact […]."
                                            },
                                            {
                                                "example_id": "bbff1e69-b1b6-4a9c-bc4b-1880b2787829",
                                                "sense_id": "d7369d6d-80ef-3c78-a265-320b8c02d02e",
                                                "text": "Or, en France, puisqu’on aime quand c’est compliqué, on a introduit, lors de la transposition de la Directive européenne relative aux déchets, deux notions différentes pour le seul terme de re-use : le réemploi ET la réutilisation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fd6c840-89a7-3627-b056-08b2c5d4a987",
                                        "entry_id": "d1d56118-5b84-333a-a7c9-45a94015e2f7",
                                        "glosses": [
                                            "Technique de restauration où l’on enlève le support original d’une peinture (toile ou panneau) pour en mettre un nouveau."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0cbeec7a-f97f-3f99-b11b-a92276748202",
                                        "entry_id": "d1d56118-5b84-333a-a7c9-45a94015e2f7",
                                        "glosses": [
                                            "Dérivation impropre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
