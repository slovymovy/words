                "senses": [
                    {
                        "sense_id": "6689dbbd-19b6-3b96-a388-d1759b2fd4e4",
                        "entry_id": "6b431f43-efa3-3b75-9fa3-fc04cc552f02",
                        "glosses": [
                            "Person, die mit dem Fahrrad oder auf einem Motorrad fährt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd5d6209-49e2-452a-898c-abd4eefea908",
                                "sense_id": "6689dbbd-19b6-3b96-a388-d1759b2fd4e4",
                                "text": "„Der Biker wurde in ein Krankenhaus gebracht, wo er kurze Zeit später seinen schweren Verletzungen erlag.“"
                            },
                            {
                                "example_id": "e5fa459f-da86-483a-8008-82e0d301b925",
                                "sense_id": "6689dbbd-19b6-3b96-a388-d1759b2fd4e4",
                                "text": "„Tausende Biker aus ganz Hessen haben am Samstag in Wiesbaden gegen eine vom Bundesrat geforderte strengere Regulierung von Motorradlärm demonstriert.“"
                            },
                            {
                                "example_id": "d714ee22-5579-4e56-9de7-197814cd524d",
                                "sense_id": "6689dbbd-19b6-3b96-a388-d1759b2fd4e4",
                                "text": "Die jungen Biker rasten die Straße entlang."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
