                "senses": [
                    {
                        "sense_id": "b9324266-94f8-34ee-9a29-ec36e58757c9",
                        "entry_id": "01e3d769-b1c8-3012-bb62-fac0d882266f",
                        "glosses": [
                            "Fußbekleidung, die jemand beim Baden oder bei ähnlichen Gelegenheiten tragen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23be74ef-d8a6-4939-b4d3-bbc7106cac59",
                                "sense_id": "b9324266-94f8-34ee-9a29-ec36e58757c9",
                                "text": "„Denn etwa Flip-Flops oder Badelatschen könnten von den Pedalen rutschen, sich verkanten oder nicht genügend Halt bei stärkerem Bremsen bieten.“"
                            },
                            {
                                "example_id": "dbc59305-ee71-4d64-9eb5-d55ad1472bc0",
                                "sense_id": "b9324266-94f8-34ee-9a29-ec36e58757c9",
                                "text": "„An den Füßen hatten sowohl Männer wie Frauen billige Badelatschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
