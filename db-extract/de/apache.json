                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c10704a-5aa5-457a-927a-afc0fcc613ca",
                        "source_entry_id": "230a2de9-df6c-3958-9ea6-0f4c9f20e114",
                        "source_sense_id": "a9ddde7c-7cad-3149-bc88-a79d1b6cda95",
                        "source_sense_description": "Angehöriger der gleichnamigen Indianernation im Südwesten der Vereinigten Staaten",
                        "target_lang_word": "apache",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apache",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9c3bae1b-458d-3c5d-b074-dfd830b23d6f",
                                        "entry_id": "86266668-b935-3a2f-bb72-fde27b2a7757",
                                        "glosses": [
                                            "Relatif aux Apaches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a850013-10a5-48e8-8fdf-64f7f9a851f5",
                                                "sense_id": "9c3bae1b-458d-3c5d-b074-dfd830b23d6f",
                                                "text": "Cette dernière a présenté des excuses publiques à l’actrice, apache et yaqui, jadis célébrée par des militants pour sa démarche, mais mise au ban par les professionnels du cinéma."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "apache",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fbbe8bc4-bae1-3e08-8c0c-826c7e2a5ab3",
                                        "entry_id": "31ec815c-2fc2-3aba-8e0b-8ee270fd4ccf",
                                        "glosses": [
                                            "Langue parlée par les Apaches."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "apache",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "91e203bb-919c-355e-83d5-3f6e95e4464f",
                                        "entry_id": "29209e89-5d2e-3162-b037-f24e19505ad6",
                                        "glosses": [
                                            "Malfaiteur, bandit, hors-la-loi."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33975fbe-96b8-406b-acfe-ee8fb5b3acae",
                                                "sense_id": "91e203bb-919c-355e-83d5-3f6e95e4464f",
                                                "text": "Ce journal bien informé m'a accusé de donner aux ouvriers des conseils d’apache (7 avril 1907)."
                                            },
                                            {
                                                "example_id": "0563dc3b-141f-4444-9aa2-1a41ba96ca98",
                                                "sense_id": "91e203bb-919c-355e-83d5-3f6e95e4464f",
                                                "text": "Les femmes qui se vendent relèveront la tête. Elles se syndiqueront pour se défendre contre l’injure du passant, le vol, le risque, la maladie, la domination de la tenancière, du logeur, de l’usurière, de l’apache."
                                            },
                                            {
                                                "example_id": "cf24932b-ec75-4814-ac69-a06d0a04910f",
                                                "sense_id": "91e203bb-919c-355e-83d5-3f6e95e4464f",
                                                "text": "La T.S.F. les a bien servis, elle qui présente les victimes comme des escarpes et des apaches."
                                            },
                                            {
                                                "example_id": "671b8d6d-7894-411f-93e9-2d5c9081f515",
                                                "sense_id": "91e203bb-919c-355e-83d5-3f6e95e4464f",
                                                "text": "La nuit dernière Vienne présentait un spectacle extraordinaire; le feu faisait rage par toute la ville ; les juifs étaient poursuivis le long des rues, sous les injures et les attaques d'une foule d'apaches qui se targuent d'appartenir à l'une des nations les plus grandes et les plus civilisées de ce monde."
                                            },
                                            {
                                                "example_id": "4d4b4778-c7f3-4df4-a75c-237cc235dc70",
                                                "sense_id": "91e203bb-919c-355e-83d5-3f6e95e4464f",
                                                "text": "Le conseil général des Vosges propose, le 30 septembre 1910, de mettre les vagabonds et les « apaches » dans la Légion étrangère."
                                            },
                                            {
                                                "example_id": "227a7d17-a7c7-4221-8702-3ffc0943ee4b",
                                                "sense_id": "91e203bb-919c-355e-83d5-3f6e95e4464f",
                                                "text": "Il y a un siècle à peine, en France, seuls étaient glabres les hommes d’Église et les domestiques. Barbes fluviales des socialistes et des anarchistes, favoris des libéraux et des maitres d’hôtel, impériale des bonapartistes, rouflaquettes des apaches, les visages affichaient les convictions politiques et les conditions sociales."
                                            },
                                            {
                                                "example_id": "7c068fe3-32e8-4345-9709-9b3f4d069742",
                                                "sense_id": "91e203bb-919c-355e-83d5-3f6e95e4464f",
                                                "text": "Dans la seconde moitié du XIXᵉ siècle, un « modèle londonien » avait été expérimenté dans le Paris populaire, à travers l’emploi de l’uniforme et de la déambulation ostensible pour soumettre et bannir « apaches » et « communards »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1924a036-d002-30ed-bd2f-070575ff0079",
                                        "entry_id": "29209e89-5d2e-3162-b037-f24e19505ad6",
                                        "glosses": [
                                            "Individu peu recommandable, indigne de considération."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec68689d-adf7-4639-9d79-71532841e315",
                                                "sense_id": "1924a036-d002-30ed-bd2f-070575ff0079",
                                                "text": "Hitler — avec sa mèche, sa figure de voyou, sa petite moustache verticale qui lui tombe du nez, et ses lubies de moraliste saoul, fut juché au pouvoir par deux vieux drôles : Hindenbourg et Clemenceau (l’absurde malfaisance du Traité de Versailles est la seule thèse qui rime à quelque chose dans l’argumentation de cet apache)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
