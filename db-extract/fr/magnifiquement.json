                    },
                    {
                        "translation_id": "1d510bf9-e2c5-42ce-a882-e43847c592a4",
                        "source_entry_id": "78657fed-97b4-399e-ad35-dd49096d04c3",
                        "target_lang_word": "großartig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "großartig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "82eec423-5a71-301c-9c88-5120160a8b3e",
                                        "entry_id": "92eb0f19-1534-3307-ba82-ad519a5f5d4d",
                                        "glosses": [
                                            "deutlich besser als der Durchschnitt, sehr gut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1515787f-1408-4b17-a32d-089f720f9718",
                                                "sense_id": "82eec423-5a71-301c-9c88-5120160a8b3e",
                                                "text": "Das hast du großartig gemacht!"
                                            },
                                            {
                                                "example_id": "89e8d2a3-6918-4939-9d03-bb49a4daacf2",
                                                "sense_id": "82eec423-5a71-301c-9c88-5120160a8b3e",
                                                "text": "Er ist ein großartiger Mensch."
                                            },
                                            {
                                                "example_id": "cb7949bc-cae4-43bf-aadf-0692cc181621",
                                                "sense_id": "82eec423-5a71-301c-9c88-5120160a8b3e",
                                                "text": "Alle Freunde zu der Feier einzuladen, ist eine großartige Idee."
                                            },
                                            {
                                                "example_id": "2806d9a3-fd05-4c3f-b59c-7c6b668a2929",
                                                "sense_id": "82eec423-5a71-301c-9c88-5120160a8b3e",
                                                "text": "„Er glänzte bei geselligen Anlässen gerne mit haarsträubenden Anekdoten und hatte schon bald den Ruf weg, ein vorzüglicher Erzähler und großartiger Spaßvogel zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac335cbf-b160-495e-bd2d-2f6cafa6ba4c",
                        "source_entry_id": "78657fed-97b4-399e-ad35-dd49096d04c3",
                        "target_lang_word": "gorgeously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gorgeously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f52a1b37-c380-39df-bd69-44f2c4c76c1b",
                                        "entry_id": "d1e18dbe-ec10-3542-b18e-2c95dc9b6a11",
                                        "glosses": [
                                            "In a gorgeous manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8eb11c6-93b3-4e1b-b1af-e6f9cfe703ee",
                                                "sense_id": "f52a1b37-c380-39df-bd69-44f2c4c76c1b",
                                                "text": "Some of these were dressed most gorgeously, others becomingly, and several sneaked in with fantail bangers, calling themselves \"Gentlemen of the Nineteenth Century.\""
                                            },
                                            {
                                                "example_id": "290ecb9f-fa40-4049-8b98-23517966cd7c",
                                                "sense_id": "f52a1b37-c380-39df-bd69-44f2c4c76c1b",
                                                "text": "What other television show would feature a gorgeously designed sequence where a horrifically mutated Pierre and Marie Curie, their bodies swollen to Godzilla-like proportions from prolonged exposure to the radiation that would eventually kill them, destroy an Asian city with their bare hands like vengeance-crazed monster-Gods?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a2ded87-9cf5-4363-9e1a-ca07f7a1de59",
                        "source_entry_id": "78657fed-97b4-399e-ad35-dd49096d04c3",
                        "target_lang_word": "lavishly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lavishly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6aec1e98-27b7-3392-b227-d6c0f8cc9345",
                                        "entry_id": "0f37fed8-6a18-361f-b07c-8bc271c52478",
                                        "glosses": [
                                            "In a lavish manner, expending profusely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad29e08c-a41a-4469-9aa0-6dce014a6879",
                                                "sense_id": "6aec1e98-27b7-3392-b227-d6c0f8cc9345",
                                                "text": "He was noted to entertain lavishly, throwing the biggest and best parties in town."
                                            },
                                            {
                                                "example_id": "4609325d-f69e-4709-a038-0b5dc29d081b",
                                                "sense_id": "6aec1e98-27b7-3392-b227-d6c0f8cc9345",
                                                "text": "At twilight in the summer[…]the mice come out. They[…]eat the luncheon crumbs. Mr. Checkley, for instance, always brought his dinner in a paper parcel in his coat-tail pocket, and ate it when so disposed, sprinkling crumbs lavishly—the only lavishment of which he was ever guilty—on the floor."
                                            },
                                            {
                                                "example_id": "a6a5b260-b1d1-44da-ac5c-f9dffcfcd21c",
                                                "sense_id": "6aec1e98-27b7-3392-b227-d6c0f8cc9345",
                                                "text": "I suspect fruity language is lavishly used on building sites and in 10 Downing Street, but not so much in middle-ranking jobs. Iain Duncan Smith once told a Treasury mandarin on the phone \"If you ever speak to my officials like that again I'll bite your balls off and send them to you in a box.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
