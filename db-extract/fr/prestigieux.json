                                    {
                                        "sense_id": "32f9d7fa-98f4-35d7-bd19-47f06d289fa9",
                                        "entry_id": "7685375e-547c-3443-8830-8b2ea73650e7",
                                        "glosses": [
                                            "von (vielen) Menschen geschätzt und respektiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04c9f081-2bf1-4547-88ad-6f2b12641bef",
                                                "sense_id": "32f9d7fa-98f4-35d7-bd19-47f06d289fa9",
                                                "text": "Albert Einstein ist ein weltweit angesehener Wissenschaftler."
                                            },
                                            {
                                                "example_id": "ae985569-e82a-4e34-8582-e5a9c879f974",
                                                "sense_id": "32f9d7fa-98f4-35d7-bd19-47f06d289fa9",
                                                "text": "In das angesehene Wissenschaftsmagazin Nature hat es bisher nur ein einziges ISS-Experiment namens Maxi (Monitor of All-sky X-ray Image) geschafft."
                                            },
                                            {
                                                "example_id": "ed65100a-c889-409a-a66e-035488810dfa",
                                                "sense_id": "32f9d7fa-98f4-35d7-bd19-47f06d289fa9",
                                                "text": "… Bill Clinton … Heute ist er wahrscheinlich der beliebteste Politiker der USA und hoch angesehen."
                                            },
                                            {
                                                "example_id": "6c6c02c7-45f6-4fe5-841d-b05ada18a7df",
                                                "sense_id": "32f9d7fa-98f4-35d7-bd19-47f06d289fa9",
                                                "text": "Die Expertenregierung solle aus \"angesehenen und nicht-politischen Persönlichkeiten\" bestehen, sagte der Chef der sozialistischen Pasok-Partei, Evangelos Venizelos."
                                            },
                                            {
                                                "example_id": "682fd5fd-e639-4871-a9b1-2ba271b2dea6",
                                                "sense_id": "32f9d7fa-98f4-35d7-bd19-47f06d289fa9",
                                                "text": "Wenn aber ein Kind aus einer Bevölkerungsgruppe, die nicht so angesehen ist, in die Schule kommt, wird die gleiche Begabung in einen Nachteil umgemünzt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
