                    {
                        "sense_id": "a7da24bb-58d5-378d-8cd9-23a8f1365695",
                        "entry_id": "b62d8697-b145-3f27-a7db-80f1d49bf6f2",
                        "glosses": [
                            "ruimte vanwaaruit criminelen hun activiteiten ontplooien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75e9c461-1634-4dba-9bc4-269971029917",
                                "sense_id": "a7da24bb-58d5-378d-8cd9-23a8f1365695",
                                "text": "De inval van de politie in het 'rovershol'bij het Drentse Zuidlaren, waar in december vorig jaar twee Kosovaarse inbrekers werden ontdekt, was onrechtmatig. De mannen leefden in het hol en dat was daarom aan te merken als woning, betoogde de advocaat van een van de verdachten vrijdag voor de rechtbank in Assen."
                            },
                            {
                                "example_id": "f28bcdc3-f9bf-4218-bd88-5c09a4737c1f",
                                "sense_id": "a7da24bb-58d5-378d-8cd9-23a8f1365695",
                                "text": "De captain kwam bij justitie in beeld via honderden afgeluisterde telefoongesprekken bij het bedrijf X. in Y. Volgens het OM was dat een 'rovershol' waar tientallen drugscriminelen onderling afspraken maakten."
                            }
                        ]
                    }
