                        "entry_id": "1c2f788e-1fcd-3733-9ad0-47402100df69",
                        "glosses": [
                            "Le fait d’être en prison."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "f434bd79-c6b3-4f54-bc42-ba191a293907",
                                "sense_id": "9dcdfcea-3a17-3cbe-8f83-1aef8a04d5e3",
                                "text": "Génonville avait en 1718 profité de l’embastillement de Voltaire pour devenir l'amant de Suzanne Catherine de Livry."
                            }
                        ]
                    },
                    {
                        "sense_id": "faad1a7b-f58b-3991-82fb-252955dc0497",
                        "entry_id": "1c2f788e-1fcd-3733-9ad0-47402100df69",
                        "glosses": [
                            "Le fait d’être dans un lieu dans lequel la liberté est limitée ou contrainte."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "68021c9d-331f-4928-a87d-f15784b38709",
                                "sense_id": "faad1a7b-f58b-3991-82fb-252955dc0497",
                                "text": "Vint l’heure du noble devoir patriotique. Fagerolle tira ses mois d’embastillement militaire sans trop de dommages, dans un régiment de marsouins, à Toulon."
                            },
                            {
                                "example_id": "0d15e86d-5740-4604-a14f-bf079871bdac",
                                "sense_id": "faad1a7b-f58b-3991-82fb-252955dc0497",
                                "text": "L’embastillement sanitaire et épidémiologique peut pour autant nuire davantage que l’emmurement volontaire de l’abstraction créative ? Peut-il conduire à un esseulement frisant la déréliction ?"
                            }
                        ]
                    }
