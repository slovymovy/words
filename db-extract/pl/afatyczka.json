                "senses": [
                    {
                        "sense_id": "461d9442-03d3-3a6f-aebb-f7fa54383c9c",
                        "entry_id": "556af52a-fd61-3fed-8806-8a5ae838e372",
                        "glosses": [
                            "female equivalent of afatyk (“aphasic”) (one who is afflicted by symptoms of aphasia)"
                        ],
                        "tags": [
                            "feminine",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "3d31ca32-d7fd-432a-9dcc-e6a2425088f3",
                                "sense_id": "461d9442-03d3-3a6f-aebb-f7fa54383c9c",
                                "text": "Jedna z afatyczek na pytanie, dlaczego nie uczęszcza na zajęcia, odpowiedziała bo mne z tax rrożżena vzlozommić.",
                                "translation": "One of the aphasics when asked why she didn't attend the classes, she replied because mey from tax rrożżena vzlozommić.",
                                "english": "One of the aphasics when asked why she didn't attend the classes, she replied because mey from tax rrożżena vzlozommić."
                            },
                            {
                                "example_id": "565a8412-2068-4d16-94dc-9bbe559a528d",
                                "sense_id": "461d9442-03d3-3a6f-aebb-f7fa54383c9c",
                                "text": "Afatyczka podróżuje w ultramarynowej wołdze, która chroni ją przed bezpośrednim kontaktem z rzeczywistością realną.",
                                "translation": "Aphasic travels in an ultramarine volga, which protects her from direct contact with real reality.",
                                "english": "Aphasic travels in an ultramarine volga, which protects her from direct contact with real reality."
                            },
                            {
                                "example_id": "1468b6de-7d64-4064-b709-71ec03194845",
                                "sense_id": "461d9442-03d3-3a6f-aebb-f7fa54383c9c",
                                "text": "Staje się zatem w sensie metaforycznym afatyczką dla otaczających ją osób.",
                                "translation": "Thus, she becomes, in a metaphorical sense, an aphasic for those around her.",
                                "english": "Thus, she becomes, in a metaphorical sense, an aphasic for those around her."
                            }
                        ]
                    }
                ],
