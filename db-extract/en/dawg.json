        "zh-extract.jsonl": [
            {
                "entry_id": "43da0fe6-3fe5-3c79-8b0e-058f61919577",
                "word": "dawg",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "cec4f609-96bb-40f0-942f-5c29113aee6a",
                        "entry_id": "43da0fe6-3fe5-3c79-8b0e-058f61919577",
                        "tags": [
                            "plural"
                        ],
                        "form": "dawgs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "07d6bb77-cb78-3c1e-9130-5bac7a1d127e",
                        "entry_id": "43da0fe6-3fe5-3c79-8b0e-058f61919577",
                        "glosses": [
                            "dog的發音拼寫"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "0d6f6d0d-5765-4133-807e-aa76c62d93c5",
                                "sense_id": "07d6bb77-cb78-3c1e-9130-5bac7a1d127e",
                                "text": "That dawg won't hunt.",
                                "translation": "那主意行不通。（直譯：那隻狗不會打獵。）"
                            }
                        ]
                    },
                    {
                        "sense_id": "b059bad1-fb17-350e-8928-e691bd83abcf",
                        "entry_id": "43da0fe6-3fe5-3c79-8b0e-058f61919577",
                        "glosses": [
                            "對親近朋友（通常為男性）的稱呼"
                        ],
                        "tags": [
                            "US",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "819530e0-4db9-4ea1-a4dd-6d1d4884cb4c",
                                "sense_id": "b059bad1-fb17-350e-8928-e691bd83abcf",
                                "text": "Sup, dawg?",
                                "translation": "嘿，兄弟，最近怎樣？"
                            },
                            {
                                "example_id": "9442766e-b93f-40c2-a480-21d39db5c9da",
                                "sense_id": "b059bad1-fb17-350e-8928-e691bd83abcf",
                                "text": "“Wow. What do you know? Huh. That was easy.” “Totes malotes, dawg.” “Just kind of hard to believe, you know?” “Believe it, Morty. And once again, I'm flying away with everything I can carry, and the Zigerions got nothing of mine.”",
                                "translation": "「哇，你瞧。嘿，真容易。」「完全正確，兄弟。」「只是有點難以置信，你知道嗎？」「相信吧，莫蒂。我又一次帶著我能拿走的所有東西飛走了，那些齊格里安人什麼都沒從我這得到。」"
                            },
                            {
                                "example_id": "270c794e-f8fb-4ef9-bdcd-81ee47d10d72",
                                "sense_id": "b059bad1-fb17-350e-8928-e691bd83abcf",
                                "text": "All up in my phone, lookin' at pictures from the other night / She gon' be upset if she keep scrollin' to the left, dawg",
                                "translation": "（她）一直在翻我的手機，看那天晚上的照片 / 老兄，如果她繼續往左滑，絕對會翻臉的"
                            },
                            {
                                "example_id": "5b58ea5f-63db-4e87-9be6-193096d6dfbc",
                                "sense_id": "b059bad1-fb17-350e-8928-e691bd83abcf",
                                "text": "I'm not usually on African food, but the smell of that jollof is peng right now my dawg!",
                                "translation": "我平常不太吃非洲菜，但這碗加納炒飯的味道現在聞起來正翻了，兄弟！"
                            },
                            {
                                "example_id": "f1e8aede-e199-42f0-bce3-69ebb2c2384c",
                                "sense_id": "b059bad1-fb17-350e-8928-e691bd83abcf",
                                "text": "“Totes malotes, dawg,” Abby shot me with a finger-gun. “And trust me, I'm amazing at it, just like everything else. So, order the pizza, Sandy, and let's get this show on the road. This is going to be f-u-u-u-u-u-u-n.”",
                                "translation": "「完全沒錯，兄弟，」艾比對著我比了個指槍。「相信我，我就算做這件事也跟做其他事一樣厲害。所以點披薩吧，桑迪，讓我們開始吧。這絕對會超——級——好——玩。」"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ]
    }
