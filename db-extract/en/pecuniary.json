                        "target_lang_word": "pécuniaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pécuniaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e255ab5d-fd52-35ed-aad3-213bb289f865",
                                        "entry_id": "f199a72a-18bd-38cf-a26e-3e29665d7a60",
                                        "glosses": [
                                            "Relatif à l’argent ; qui consiste en argent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "799529cb-c3fa-4885-8883-080d74f3b668",
                                                "sense_id": "e255ab5d-fd52-35ed-aad3-213bb289f865",
                                                "text": "Il est des cas où la satisfaction pécuniaire est demandée par la nature même du délit : il est d'autres cas où c'est la seule que les circonstances permettent."
                                            },
                                            {
                                                "example_id": "1afbd973-54c3-43f5-8fd6-2e71b0281a94",
                                                "sense_id": "e255ab5d-fd52-35ed-aad3-213bb289f865",
                                                "text": "Ce pauvre homme, sans moyens pécuniaires, premier clerc depuis dix ans, atteignait alors à l’âge de quarante ans et se voyait clerc pour le reste de ses jours."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57e9a836-ab5a-4c04-9829-85cad72e7f0c",
                        "source_entry_id": "3efd1202-509f-34b8-a8c9-de3dd2d5ad4f",
