                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b86b7d1-8d96-4ce5-87dd-5fbddb298439",
                                "sense_id": "c2f61ded-a18c-366c-a670-716a265f150a",
                                "text": "Allow me to state, that by standing such an instructive example before the world, you exercise the most effective revolutionary propaganda; because, if the misresult of French revolutions discouraged the nations from shaking off the oppressor's yoke, your victory, and still more, your unparalleled prosperity, has encouraged oppressed nations to dare what you dared."
                            },
                            {
                                "example_id": "d4b33a98-9d6e-4493-a9fc-54e497982f51",
                                "sense_id": "c2f61ded-a18c-366c-a670-716a265f150a",
                                "text": "Their vaunted liberty of thought and act is of that revolutionary sort which brings in the deeper, harder bondage of physical and spiritual oppression: full of \"sordid misbeliefs, mispursuits, misresults,” to be trodden under foot shortly."
                            },
                            {
                                "example_id": "466f6e2b-aef0-47df-a686-404c21daca5c",
                                "sense_id": "c2f61ded-a18c-366c-a670-716a265f150a",
                                "text": "The serious misresult of blindness comes not at all after paraffin of high melting point."
                            }
                        ]
                    }
