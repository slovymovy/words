                        "glosses": [
                            "Autopsie effectuée sans intervention chirurgicale grâce à l'imagerie médicale."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "63f2e1f1-e56d-4573-a8c9-474fb76875e1",
                                "sense_id": "bd8ed8ab-d57a-35fc-bb88-4bb03b7832a7",
                                "text": "Or, une nouvelle autopsie a été pratiquée sur les dépouilles après leur rapatriement en France, grâce à la technique révolutionnaire de la «virtopsie» (par résonance magnétique ou IRM) à Compiègne (Oise)."
                            },
                            {
                                "example_id": "f205460d-e767-42a5-b91a-4760db4933ee",
                                "sense_id": "bd8ed8ab-d57a-35fc-bb88-4bb03b7832a7",
                                "text": "De nos jours, le développement des autopsies virtuelles – les virtopsies – permet de réaliser la dissection des corps en utilisant uniquement l'outil radiographique."
                            }
                        ]
                    }
