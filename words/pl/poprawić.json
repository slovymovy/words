                                "target_lang_sense_clarification": "качество, условия, показатели"
                            },
                            {
                                "target_lang_word": "поднять",
                                "target_lang_sense_clarification": "настроение"
                            },
                            {
                                "target_lang_word": "поправить",
                                "target_lang_sense_clarification": "здоровье, финансовое положение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da89781c-5f74-31e3-a67a-d22d0b7e81c9",
                    "sense_definition": "przybrać na wadze, stać się tęższym",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sąsiedzi zauważyli, że po powrocie z sanatorium nieco się <w>poprawił</w>.",
                            "target_lang_translations": {
                                "ru": "Соседи заметили, что после возвращения из санатория он немного <w>поправился</w>."
                            }
                        },
                        {
                            "text": "Po zimie trochę się <w>poprawiła</w>, więc musi zmienić niektóre ubrania.",
                            "target_lang_translations": {
                                "ru": "После зимы она немного <w>поправилась</w>, поэтому ей нужно сменить часть одежды."
                            }
                        }
                    ],
                    "synonyms": [
