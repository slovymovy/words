            "senses": [
                {
                    "sense_id": "789e035c-6330-34cf-8e99-e152fd70dd8b",
                    "sense_definition": "A flammable liquid mixture of refined petroleum, used primarily as fuel for internal combustion engines.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fuel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to stop at the next station to buy some <w>gasoline</w>.",
                            "target_lang_translations": {
                                "ru": "Нам нужно остановиться на следующей заправке, чтобы купить <w>бензин</w>.",
                                "zh": "我们需要在下一个加油站停下来加点<w>汽油</w>。"
                            }
                        },
                        {
                            "text": "The price of <w>gasoline</w> has risen significantly over the last few months.",
                            "target_lang_translations": {
                                "ru": "Цена на <w>бензин</w> значительно выросла за последние несколько месяцев.",
                                "zh": "过去几个月里<w>汽油</w>价格大幅上涨。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gas",
                        "petrol"
                    ],
                    "common_phrases": [
                        "unleaded gasoline",
                        "gasoline station",
                        "gasoline engine",
                        "gasoline tank",
                        "gasoline pump"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly North America"
                        }
                    ],
                    "target_lang_definitions": {
