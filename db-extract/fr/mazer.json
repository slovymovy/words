                "senses": [
                    {
                        "sense_id": "a8cfccdd-d92f-36d5-8be0-5a33d3ef2cd3",
                        "entry_id": "53917542-427e-3003-a9eb-a53e14d7196d",
                        "glosses": [
                            "Affiner (de la fonte) avant l’affinage définitif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77dd4485-084c-4fe5-9f4d-991ade1eee92",
                                "sense_id": "a8cfccdd-d92f-36d5-8be0-5a33d3ef2cd3",
                                "text": "Pour mazer la fonte, on la soumet à la fusion dans un foyer de forge, on la coule en plaques minces, et on la brise en morceaux."
                            },
                            {
                                "example_id": "a80e4247-c5d7-4505-a47e-7b575d528fb7",
                                "sense_id": "a8cfccdd-d92f-36d5-8be0-5a33d3ef2cd3",
                                "text": "La mine calcareuse a, en outre, l’inconvénient de rendre le premier laitier ferreux, apte à mazer la fonte et à rendre son expulsion du creuset difficile."
                            }
                        ]
                    }
                ],
