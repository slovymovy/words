                                "example_id": "6ca8ba05-9551-4974-87ee-cf56e039fadc",
                                "sense_id": "75cf4b96-6a48-3ecd-8823-0b12a34d1c82",
                                "text": "There was no housekey on Robb Johnson's body when it was found"
                            },
                            {
                                "example_id": "8a9c8bd1-d6c1-476d-bf95-c44d982bc279",
                                "sense_id": "75cf4b96-6a48-3ecd-8823-0b12a34d1c82",
                                "text": "Lock contends that this evidence was purposefully used by the prosecutor to prove that Lock possessed the housekey which Milano testified she gave to him for entry into Blanton's house."
