                ],
                "senses": [
                    {
                        "sense_id": "ebdebad8-b467-3cdf-a646-1184bd76d1e8",
                        "entry_id": "7c72f963-6717-3150-9e31-794880473d90",
                        "glosses": [
                            "Substance naturelle, présente dans la plupart des tissus humains et animaux, obtenue également par synthèse, douée d'activités biologiques multiples, comme le déclenchement d'un signal de douleur transmis au cerveau. Il existe une vingtaine de prostaglandines différentes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ef1f6ef-1f6c-473f-a850-7d482aaa78bf",
                                "sense_id": "ebdebad8-b467-3cdf-a646-1184bd76d1e8",
                                "text": "Dans cette mécanique bien huilée, la prostaglandine joue un rôle de premier plan."
                            },
                            {
                                "example_id": "472710f1-4f8c-405c-a8bf-d7f07f33d500",
                                "sense_id": "ebdebad8-b467-3cdf-a646-1184bd76d1e8",
                                "text": "Les prostaglandines existent en faibles quantités dans la plupart des tissus animaux (prostate, poumons, cerveau, muscles, etc.)."
                            },
                            {
                                "example_id": "d5319bc7-3e11-4048-888a-dab89854864f",
                                "sense_id": "ebdebad8-b467-3cdf-a646-1184bd76d1e8",
                                "text": "L'abréviation de prostaglandine est Pg."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5aa5610a-205b-4a34-b82a-02b4a2575695",
                        "source_entry_id": "7c72f963-6717-3150-9e31-794880473d90",
                        "source_sense_id": "ebdebad8-b467-3cdf-a646-1184bd76d1e8",
                        "target_lang_word": "Prostaglandin",
                        "target_lang_code": "de",
