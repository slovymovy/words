        "fr-extract.jsonl": [
            {
                "entry_id": "442980ae-4a0d-3032-a1e0-40df93bf1533",
                "word": "soupirail",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2503a127-91c0-49d6-8be7-6ddee2eed89e",
                        "entry_id": "442980ae-4a0d-3032-a1e0-40df93bf1533",
                        "tags": [
                            "plural"
                        ],
                        "form": "soupiraux"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6dc4affe-a365-3a5a-a0d4-4d9974102567",
                        "entry_id": "442980ae-4a0d-3032-a1e0-40df93bf1533",
                        "glosses": [
                            "Ouverture pratiquée à la partie inférieure d’un édifice, pour donner un peu d’air et de jour à une cave, à un sous-sol, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2da39095-6120-4f32-8b4a-2d25c1622af6",
                                "sense_id": "6dc4affe-a365-3a5a-a0d4-4d9974102567",
                                "text": "La seule lumière qui l’éclairât filtrait à travers deux soupiraux hors de la portée de la main du prisonnier."
                            },
                            {
                                "example_id": "38c09cc9-f720-4a6c-8c09-b05eacf585b4",
                                "sense_id": "6dc4affe-a365-3a5a-a0d4-4d9974102567",
                                "text": "On eût dit des âmes en peine aux soupiraux du purgatoire qui donnent sur l’enfer."
                            },
                            {
                                "example_id": "33532292-6a5e-4292-9d5f-d351a364c1c6",
                                "sense_id": "6dc4affe-a365-3a5a-a0d4-4d9974102567",
                                "text": "Ils allaient pénétrer dans la maison, lorsque des coups de feu partirent d'un soupirail ouvert au ras du sol."
                            },
                            {
                                "example_id": "7ca45d59-0a37-4055-a1ca-57ee9c0e7070",
                                "sense_id": "6dc4affe-a365-3a5a-a0d4-4d9974102567",
                                "text": "Le prisonnier qui sommeillait, les bras repliés sous la barbe, frissonna et se dressa brusquement, hagard, le coeur battant. Il vit la brume du matin qui coulait par le soupirail."
                            },
                            {
                                "example_id": "6409bd79-1f18-43ba-baba-0a13e460d596",
                                "sense_id": "6dc4affe-a365-3a5a-a0d4-4d9974102567",
                                "text": "Sinon, le châtelain de contrebande s’amuse à évoquer d’hypothétiques reclus qu’il retiendrait dans les entrailles sans soupirail de son foirail."
                            },
                            {
                                "example_id": "351ff559-de58-4bb6-98fe-1be53d7a7aa4",
                                "sense_id": "6dc4affe-a365-3a5a-a0d4-4d9974102567",
                                "text": "Le tout est éclairé par le brin de lumière naturelle qui passe à travers les soupiraux."
                            }
                        ]
                    },
                    {
                        "sense_id": "b68cfa65-145f-36e5-87ed-aeea40bff0cd",
                        "entry_id": "442980ae-4a0d-3032-a1e0-40df93bf1533",
                        "glosses": [
                            "Ouverture."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "468c509f-f7a1-452a-8e13-f5be71bdc772",
                                "sense_id": "b68cfa65-145f-36e5-87ed-aeea40bff0cd",
                                "text": "Je me sens transporté et tout enivré de ma propre pensée, comme s’il m'arrivait par un soupirail intérieur une bouffée de parfums chauds."
                            },
                            {
                                "example_id": "e668c1fc-bb03-4bc3-a8eb-3ed4dbe11d35",
                                "sense_id": "b68cfa65-145f-36e5-87ed-aeea40bff0cd",
                                "text": "La question est de savoir si c’est servir l’Europe, même libérale, que de la réintroduire par le soupirail du Parlement alors qu’elle [a] été expulsée par la porte du vote populaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad4c43af-98b9-421c-b5f0-5020f4864bbe",
                        "source_entry_id": "442980ae-4a0d-3032-a1e0-40df93bf1533",
                        "target_lang_word": "Kellerfenster",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kellerfenster",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db34ab08-70d3-339f-a5b0-5b4fbcbd93de",
                                        "entry_id": "52ebfada-1664-383f-acd5-df7881971d65",
                                        "glosses": [
                                            "Fenster eines Kellerraumes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36367fc1-a153-49a2-87eb-8ff536fab02f",
                                                "sense_id": "db34ab08-70d3-339f-a5b0-5b4fbcbd93de",
                                                "text": "„Drei Wochen lang habe sie im Juni das Haus nur in Begleitung verlassen dürfen, erst in der Nacht auf den 27. Juni gelang ihr durch ein Kellerfenster die Flucht zu ihrem Freund.“"
                                            },
                                            {
                                                "example_id": "4ca793f3-7b06-4993-bef1-271d5f44b374",
                                                "sense_id": "db34ab08-70d3-339f-a5b0-5b4fbcbd93de",
                                                "text": "„Sie kennen die Schwachstellen und steigen manchmal durch das Kellerfenster, ein anderes Mal durch die Terrassentüre ein.“"
                                            },
                                            {
                                                "example_id": "b9365770-4dae-48cf-9398-ff21ef077fdd",
                                                "sense_id": "db34ab08-70d3-339f-a5b0-5b4fbcbd93de",
                                                "text": "„Max Schulz schlurfte zu den Kellerfenstern, um zu sehen, ob Frau Holle zu Hause war, aber die Fenster waren verhängt und er konnte nichts sehen.“"
                                            },
                                            {
                                                "example_id": "73b48093-4095-4eb0-a4fe-89a5b45aaefd",
                                                "sense_id": "db34ab08-70d3-339f-a5b0-5b4fbcbd93de",
                                                "text": "„Nur hinter unserem Rücken spendet ein halbhohes Kellerfenster trübes Licht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed1cae84-3684-455e-85c4-cda44ce04e14",
                        "source_entry_id": "442980ae-4a0d-3032-a1e0-40df93bf1533",
                        "target_lang_word": "Luftloch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Luftloch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "86e104f7-222f-3da1-9190-87907b42ed4e",
                                        "entry_id": "d3fc9fa9-9f78-3af5-a4f9-04343111648a",
                                        "glosses": [
                                            "Öffnung zum Aus- und Eintreten der Luft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7199a923-d02d-4db6-8b4b-69216bbce1ce",
                                                "sense_id": "86e104f7-222f-3da1-9190-87907b42ed4e",
                                                "text": "Gritta stieg auf den Felsblock, der vor dem Luftloch der Höhle lag."
                                            },
                                            {
                                                "example_id": "f5261a0f-6228-4d7e-aa56-9fdc6a8f7edf",
                                                "sense_id": "86e104f7-222f-3da1-9190-87907b42ed4e",
                                                "text": "„Man sah auch, wie er durch seine Luftlöcher mächtige Fontänen ausstieß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dcf2abdb-0ad9-3ebb-80a5-4df53d34ef90",
                                        "entry_id": "d3fc9fa9-9f78-3af5-a4f9-04343111648a",
                                        "glosses": [
                                            "Fallwind, der Flugzeuge absacken lässt"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99b6d978-9e21-4d91-96fb-3aa58507b1c4",
                                                "sense_id": "dcf2abdb-0ad9-3ebb-80a5-4df53d34ef90",
                                                "text": "„Fliegen mit Kleinkind. Ich würde mich nicht als leichtfertigen Menschen betrachten, ich gehe nur nicht gleich vom Schlimmsten aus. Beinahe-Abstürze, Notlandungen, gigantische Luftlöcher? Hätte ich in der Luft jemals um mein Leben bangen müssen, würde ich überhaupt nicht mehr fliegen, ohne Kind nicht und mit Kind erst recht nicht.“"
                                            },
                                            {
                                                "example_id": "e492afe8-89ec-44f2-8b6b-f696df53c53b",
                                                "sense_id": "dcf2abdb-0ad9-3ebb-80a5-4df53d34ef90",
                                                "text": "„Doch wieder gab es während der Reise ein großes Luftloch und ein paar kleinere Turbulenzen, die den Passagieren zuweilen schweißnasse Hände bereiteten.“"
                                            },
                                            {
                                                "example_id": "5eb85718-e131-4683-a699-41b814ab10a8",
                                                "sense_id": "dcf2abdb-0ad9-3ebb-80a5-4df53d34ef90",
                                                "text": "„Sie durchflogen Luftlöcher, und in der Maschine wurde es ganz still.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
