                "senses": [
                    {
                        "sense_id": "6d263bda-94d5-38b1-a7cd-9b40099fb191",
                        "entry_id": "4aa311e4-20a5-3d35-85c0-dfbd29035847",
                        "glosses": [
                            "Holz der Eibe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aee39b5f-89ee-45f8-b383-fa692f66f0ec",
                                "sense_id": "6d263bda-94d5-38b1-a7cd-9b40099fb191",
                                "text": "In der Küche standen Stühle aus Eibenholz."
                            },
                            {
                                "example_id": "fa709e8e-51c4-4b23-adf3-39723f6ba516",
                                "sense_id": "6d263bda-94d5-38b1-a7cd-9b40099fb191",
                                "text": "„Die Wissenschaftler errechneten, daß die Schützen von Azincourt mit ihren 168 bis 183 Zentimeter großen Bogen aus Eibenholz […] eine wirksame Maximalreichweite bis zu 200 Meter erzielten, wobei die 71 bis 76 Zentimeter langen Pfeile mit 130 km/h und in einem Winkel von etwa 50 Grad auftrafen.“"
                            },
                            {
                                "example_id": "3298d601-f078-4373-99f4-6a29b87bdfab",
                                "sense_id": "6d263bda-94d5-38b1-a7cd-9b40099fb191",
                                "text": "„Als einfacher Fußknecht trägt man vier, fünf, mitunter sogar sechs Meter lange federnde Spieße mit Schäften aus Eiben- oder Eschenholz und Spitzen aus Eisen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
