                ],
                "senses": [
                    {
                        "sense_id": "c2fac713-8030-3f76-a724-f40a3eeab331",
                        "entry_id": "e7902fa7-6191-3c63-b8ae-67919eae0f3c",
                        "glosses": [
                            "deutscher Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f467bc0-c402-471c-a840-73963e34e587",
                                "sense_id": "c2fac713-8030-3f76-a724-f40a3eeab331",
                                "text": "Die Diezes/Diezens wollen ein Lokal eröffnen."
                            },
                            {
                                "example_id": "75d4e444-92e2-461d-80b8-9e8faaab0b78",
                                "sense_id": "c2fac713-8030-3f76-a724-f40a3eeab331",
                                "text": "Frau Diez hat in der Lotterie gewonnen."
                            },
                            {
                                "example_id": "14e09f90-a67c-4afc-bb30-be71eace751d",
                                "sense_id": "c2fac713-8030-3f76-a724-f40a3eeab331",
                                "text": "Diez senior lebt nun in der Toskana."
                            },
                            {
                                "example_id": "70dccf8f-0b87-4816-afc9-ae5240aa306a",
                                "sense_id": "c2fac713-8030-3f76-a724-f40a3eeab331",
                                "text": "Herrn Diez’ Vergesslichkeit nimmt zu."
                            },
                            {
                                "example_id": "edaffd68-e44d-47eb-927c-9dcb9f916edd",
                                "sense_id": "c2fac713-8030-3f76-a724-f40a3eeab331",
                                "text": "Die junge Diez macht eine Ausbildung zur Optikerin."
                            },
                            {
                                "example_id": "db4ffec1-3a6f-4bd5-a6e5-f73db4538831",
                                "sense_id": "c2fac713-8030-3f76-a724-f40a3eeab331",
                                "text": "„Hallo Diez, altes Haus“, begrüßte Karola ihre Freundin."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
