{
    "word_family": [
        "realization",
        "realizable",
        "reality",
        "real",
        "realistic",
        "realist"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b6d77743-c5aa-39c5-87b6-3ea04ee99ff5",
                    "sense_definition": "To become aware of, understand, or appreciate a fact or situation.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>realized</w> that he had left his umbrella on the train.",
                            "target_lang_translations": {
                                "ru": "Он <w>осознал</w>, что оставил свой зонт в поезде.",
                                "zh": "他<w>意识到</w>自己把伞落在火车上了。"
                            }
                        },
                        {
                            "text": "I did not <w>realize</w> the importance of the meeting until it was over.",
                            "target_lang_translations": {
                                "ru": "Я не <w>осознавал</w> важности встречи, пока она не закончилась.",
                                "zh": "直到会议结束，我才<w>明白</w>这次会议的重要性。"
                            }
                        }
                    ],
                    "synonyms": [
                        "understand",
                        "comprehend",
                        "grasp",
                        "recognize",
                        "notice"
                    ],
                    "common_phrases": [
                        "realize that",
                        "realize the importance",
                        "realize a mistake",
                        "realize the truth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Осознать, понять или оценить факт или ситуацию.",
                        "zh": "指意识到、理解或领会某个事实或情况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осознавать",
                                "target_lang_sense_clarification": "понимать, сознательно усваивать"
                            },
                            {
                                "target_lang_word": "понимать",
                                "target_lang_sense_clarification": "постигать смысл"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "意识到",
                                "target_lang_sense_clarification": "指突然或逐渐明白某事"
                            },
                            {
                                "target_lang_word": "明白",
                                "target_lang_sense_clarification": "指理解或清楚某事"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "efd60ca9-3273-3111-860b-d1383f48aab1",
                    "sense_definition": "To convert a plan, dream, or ambition into reality; to achieve or accomplish.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The objectives of the project were never fully <w>realized</w>.",
                            "target_lang_translations": {
                                "ru": "Цели проекта так и не были полностью <w>реализованы</w>.",
                                "zh": "该项目的目标从未完全<w>实现</w>。"
                            }
                        },
                        {
                            "text": "She worked hard to <w>realize</w> her dream of becoming a musician.",
                            "target_lang_translations": {
                                "ru": "Она много работала, чтобы <w>осуществить</w> свою мечту стать музыкантом.",
                                "zh": "她努力工作以<w>实现</w>她成为音乐家的梦想。"
                            }
                        }
                    ],
                    "synonyms": [
                        "achieve",
                        "accomplish",
                        "fulfill",
                        "complete"
                    ],
                    "common_phrases": [
                        "realize a dream",
                        "realize a goal",
                        "realize one's potential",
                        "fully realize"
                    ],
                    "target_lang_definitions": {
                        "ru": "Воплотить план, мечту или амбицию в реальность; достичь или выполнить.",
                        "zh": "指将计划、梦想或抱负变为现实；达成或实现。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осуществлять",
                                "target_lang_sense_clarification": "приводить в исполнение"
                            },
                            {
                                "target_lang_word": "реализовывать",
                                "target_lang_sense_clarification": "претворять в жизнь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "实现",
                                "target_lang_sense_clarification": "指使目标或梦想成为现实"
                            },
                            {
                                "target_lang_word": "达成",
                                "target_lang_sense_clarification": "指完成目标或协议"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d4508d8-2660-3afb-8977-c639f797a820",
                    "sense_definition": "To convert an asset or property into money, typically by selling it.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "By <w>realizing</w> the company’s assets, the liquidator was able to pay the debts.",
                            "target_lang_translations": {
                                "ru": "<w>Реализовав</w> активы компании, ликвидатор смог погасить долги.",
                                "zh": "通过将公司资产<w>变现</w>，清算人得以偿还债务。"
                            }
                        },
                        {
                            "text": "Profits from the investment can be <w>realized</w> at any time by selling the shares.",
                            "target_lang_translations": {
                                "ru": "Прибыль от инвестиций может быть <w>реализована</w> в любое время путем продажи акций.",
                                "zh": "通过出售股票，投资收益可以随时<w>变现</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sell",
                        "liquidate"
                    ],
                    "common_phrases": [
                        "realize assets",
                        "realize a profit",
                        "realize capital"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обратить актив или имущество в деньги, обычно путем продажи.",
                        "zh": "指将资产或财产变现，通常通过出售的方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реализовывать",
                                "target_lang_sense_clarification": "обращать в деньги"
                            },
                            {
                                "target_lang_word": "продавать",
                                "target_lang_sense_clarification": "сбывать за деньги"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "变现",
                                "target_lang_sense_clarification": "指将资产转化为现金"
                            },
                            {
                                "target_lang_word": "出售",
                                "target_lang_sense_clarification": "指通过卖出资产获取资金"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}