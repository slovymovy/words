                                "sense_id": "e49f9bd5-8580-37d7-9c4f-66e64cf4d926",
                                "text": "Gość przy stole z ruletką z niedowierzaniem patrzył, jak kula zatrzymuje się na dwudziestce."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
