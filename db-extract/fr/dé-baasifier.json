                ],
                "senses": [
                    {
                        "sense_id": "2e1f4f90-8071-344b-bd97-febef03a9e8f",
                        "entry_id": "60d50fda-bded-3a47-89f3-b966da32f053",
                        "glosses": [
                            "Débarrasser de l’influence du parti Baas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0994663d-2c32-4fc6-827f-4b945b1f75dd",
                                "sense_id": "2e1f4f90-8071-344b-bd97-febef03a9e8f",
                                "text": "En conséquence, Washington s'est dirigé vers le renversement d'Assad avec le but de dé-baasifier la Syrie."
                            },
                            {
                                "example_id": "d464e517-87eb-4519-ba0c-6647897bf4db",
                                "sense_id": "2e1f4f90-8071-344b-bd97-febef03a9e8f",
                                "text": "L'Armée et l'appareil de sécurité irakien seront aussi dé-baasifiés mais aussi démantelés, ce qui entraînera de nombreux officiers et forces de l'ordre à perdre leur emploi après avoir subi la torture de la part de l'armée américaine."
                            },
                            {
                                "example_id": "dee96fc1-326a-42a7-a318-3984e6c868d6",
                                "sense_id": "2e1f4f90-8071-344b-bd97-febef03a9e8f",
                                "text": "Ils les soutenaient parce qu’ils voulaient dé-baasifier : se débarrasser de l’armée et de tout ce qui avait eu un lien avec Saddam, ce qui est vraiment stupide."
                            }
                        ]
                    }
                ],
