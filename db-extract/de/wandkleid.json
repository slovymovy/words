                "senses": [
                    {
                        "sense_id": "5975065e-c463-3a47-9e00-05cfaeb4d343",
                        "entry_id": "3efee3e4-c5ee-30b4-9a6b-2a17135f1a34",
                        "glosses": [
                            "dekorative Beschichtung von Wänden aus Papier, Textilien oder Kunststoff"
                        ],
                        "tags": [
                            "humorous",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "08dc82dc-9260-449c-9399-061c8bf6e26a",
                                "sense_id": "5975065e-c463-3a47-9e00-05cfaeb4d343",
                                "text": "„Statistiken zu folge boomt das schicke Wandkleid, das sich neu erfunden hat. Vor allem in Gestalt der praktischen Vliestapete erfreuen sich neuartige Fototapetenmuster aus der Digitaldruck-Werkstatt an einem Marktanteil von rund 70 Prozent und mehr.“"
                            },
                            {
                                "example_id": "87812e05-014d-4685-88fb-2a7b4b87f306",
                                "sense_id": "5975065e-c463-3a47-9e00-05cfaeb4d343",
                                "text": "„Die erste Aufgabe: Ein neues Wandkleid für den Eingangsbereich des Caritas-Umsonst-Ladens in der Sindelfinger Straße 12 in Böblingen.“"
                            },
                            {
                                "example_id": "5fcd4b75-10b9-4ab8-ad73-176a94f6a192",
                                "sense_id": "5975065e-c463-3a47-9e00-05cfaeb4d343",
                                "text": "„Die alte Tapete muss meist runter, sagt Bliedtner. ‚Außer Glattvliestapete, auf die kann man einfach drauftapezieren.‘ Ist das bisherige Wandkleid ab, wird Tiefgrund aufgetragen.“"
                            },
                            {
                                "example_id": "13398a54-7fb4-4ff4-ac43-71f060ed8b71",
                                "sense_id": "5975065e-c463-3a47-9e00-05cfaeb4d343",
                                "text": "„Der Designer Harald Glööckler inszeniert seine Tapeten als Modeshow. Zum aufwendigen Wandkleid serviert der umtriebige Modeschöpfer gleich noch das passenden Musterhäuschen ‚Petit Palais‘.“"
                            },
                            {
                                "example_id": "63056cc3-162c-422e-8546-1b819909d8b3",
                                "sense_id": "5975065e-c463-3a47-9e00-05cfaeb4d343",
                                "text": "„Wer bei Tapeten an Raufaser denkt, wird Augen machen, wenn er die Wandkleider aus der Welter Manufaktur sieht: Sie sind mit Blattgold überzogen, mit Porzellanmehl bestäubt oder handgemalt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
