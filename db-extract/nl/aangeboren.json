                                "target_senses": [
                                    {
                                        "sense_id": "ef3c1a89-513d-399e-a8e1-f0a03e6f6465",
                                        "entry_id": "599843b7-b0b0-3ade-8cf4-32b489fe9a21",
                                        "glosses": [
                                            "Qui est né avec nous, est héréditaire et déterminé en naissant, même si cela se manifeste après la naissance."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2453dda-5613-4b73-a97e-cf259dbed82d",
                                                "sense_id": "ef3c1a89-513d-399e-a8e1-f0a03e6f6465",
                                                "text": "Puis, après avoir reconnu par ces moyens, innés pour ainsi dire chez les femmes, toute l'étendue de l'amour qu'elle avait inspiré, madame d'Aiglemont sourit à l'espoir d'une prompte guérison, …."
                                            },
                                            {
                                                "example_id": "ba1febb6-dc10-482a-ad03-8fb7ef61402a",
                                                "sense_id": "ef3c1a89-513d-399e-a8e1-f0a03e6f6465",
                                                "text": "Il faut croire que cette disposition à ne voir dans la vie que les minutes où elle porte le voile des veuves est innée et qu’il l’a aussi naturellement qu’il a les cheveux blonds et les yeux couleur d’eau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56a27fee-1bbf-3c19-96cf-c2b6262f913e",
                                        "entry_id": "599843b7-b0b0-3ade-8cf4-32b489fe9a21",
                                        "glosses": [
                                            "Qui est inhérent à l’esprit humain et non acquis par l’expérience."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d786e971-5c3e-41b7-9492-df73332be544",
                                                "sense_id": "56a27fee-1bbf-3c19-96cf-c2b6262f913e",
                                                "text": "S'il y a quelque chose de démontré hors des mathématiques, c’est qu’il n'y a point d’idées innées dans l’homme."
                                            },
                                            {
                                                "example_id": "c7a654eb-f5de-4810-b1c6-24fce7a73f2b",
                                                "sense_id": "56a27fee-1bbf-3c19-96cf-c2b6262f913e",
                                                "text": "Il n'y a point de notions innées ; l’homme vient au monde comme une table rase sur laquelle les objets de la nature se gravent avec le temps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae442441-07a1-3179-9c65-b9a42dc34331",
                                        "entry_id": "599843b7-b0b0-3ade-8cf4-32b489fe9a21",
                                        "glosses": [
                                            "Dessiné sur l'élément concerné, mais sans relief."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ac08c71-e986-47e5-bc8b-12c0f352674c",
                                                "sense_id": "ae442441-07a1-3179-9c65-b9a42dc34331",
                                                "text": "Le Tricholome prétentieux présente des fibrilles innées noirâtres sur son chapeau"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "002d0ebb-1238-33c0-af87-1691073324e3",
                                        "entry_id": "e3237e09-0361-3abe-8a89-e55b84f160bc",
