                "senses": [
                    {
                        "sense_id": "d48da82f-125b-304c-bf0a-2d170ba361b3",
                        "entry_id": "7c5f5d48-8655-3bc0-81bf-2decf239a319",
                        "glosses": [
                            "Éclairer insuffisamment ou moins que la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a9a2a80-72e6-45f8-a9a5-da3fe0a871d2",
                                "sense_id": "d48da82f-125b-304c-bf0a-2d170ba361b3",
                                "text": "D'une manière très générale, les jeunes chef opérateurs / directeurs photos appliqués ont tendance à plutôt suréclairer une scène qu'à la sous-éclairer."
                            },
                            {
                                "example_id": "ab518529-a941-4919-be43-e7faeae9415d",
                                "sense_id": "d48da82f-125b-304c-bf0a-2d170ba361b3",
                                "text": "On me reproche parfois de sous-éclairer."
                            },
                            {
                                "example_id": "6a2fab7e-08a3-4839-b15e-8ab6e5ae1615",
                                "sense_id": "d48da82f-125b-304c-bf0a-2d170ba361b3",
                                "text": "Son naturel méfiant et mystérieux l'avait poussé à sous-éclairer la pièce."
                            }
                        ]
                    },
                    {
                        "sense_id": "9fa77b76-2215-3d29-9e1a-b364d0d48c23",
                        "entry_id": "7c5f5d48-8655-3bc0-81bf-2decf239a319",
                        "glosses": [
                            "Éclairer par en-dessous."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f561b05-0a5d-48de-a20e-b33d3a9ae3c9",
                                "sense_id": "9fa77b76-2215-3d29-9e1a-b364d0d48c23",
                                "text": "De plus, on y a ajouté un circuit d’éclairage intérieur 20 mA qui permet d’éclairer la cabine ou de sous-éclairer le tableau de bord."
                            }
                        ]
                    }
