        "nl-extract.jsonl": [
            {
                "entry_id": "4b5f7063-2f02-3736-921d-7167c02b69f5",
                "word": "knusjes",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9f60aded-4d31-3675-b95a-d932ccc6f600",
                        "entry_id": "4b5f7063-2f02-3736-921d-7167c02b69f5",
                        "glosses": [
                            "op een gezellige, huiselijke manier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b53720fd-6331-4d12-a69a-15bdbd50bd3d",
                                "sense_id": "9f60aded-4d31-3675-b95a-d932ccc6f600",
                                "text": "Coachbuilders Lavocat et Marsaud tekenden voor het ontwerp van deze langgerekte auto. De torpedo-achtige body biedt plaats aan vier personen, maar reken er op dat je dan wel knusjes tegen elkaar aan zit."
                            },
                            {
                                "example_id": "954f781b-22e5-4b40-b246-2fd0ea4d3f23",
                                "sense_id": "9f60aded-4d31-3675-b95a-d932ccc6f600",
                                "text": "May en Trump kwamen hand in hand op de foto te staan, knusjes en intiem, een krachtig beeld ter onderstreping van de speciale relatie tussen de vermoeide en verstofte voormalige kolonisator en zijn van triomfalisme blakende oud-kolonie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7740a509-1544-427c-bc13-c62930bd9e4a",
                        "source_entry_id": "4b5f7063-2f02-3736-921d-7167c02b69f5",
                        "source_sense_id": "9f60aded-4d31-3675-b95a-d932ccc6f600",
                        "target_lang_word": "cosily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cosily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8456985-b6dd-33b1-95af-44bf595a2b10",
                                        "entry_id": "80ddcc5c-9a3c-3c80-a1ce-783e34132caa",
                                        "glosses": [
                                            "In a cosy manner."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66314ad2-bb20-4f18-b237-10003e64925d",
                                                "sense_id": "a8456985-b6dd-33b1-95af-44bf595a2b10",
                                                "text": "This brought them to the fireside, where the easy-chair was drawn cosily up, and the tea things stood ready to the sitter’s elbow, the very sugar in the cup."
                                            },
                                            {
                                                "example_id": "7c77cd5b-464d-4d66-bb26-078112339553",
                                                "sense_id": "a8456985-b6dd-33b1-95af-44bf595a2b10",
                                                "text": "It's hard to put your hands into the pockets of a suit coat. Mine were tucked away cosily in the deep pockets of my zipped-up leather jacket."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0614d4c-fbe4-48ae-8571-7102b0e3faf2",
                        "source_entry_id": "4b5f7063-2f02-3736-921d-7167c02b69f5",
                        "source_sense_id": "9f60aded-4d31-3675-b95a-d932ccc6f600",
                        "target_lang_word": "snugly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "snugly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "56906fa9-df19-3a50-9571-6fa0f321b0af",
                                        "entry_id": "983692b2-d521-3573-a8ea-a7818f038cf9",
                                        "glosses": [
                                            "Tightly, with limited space to move, in a snug manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a508519-ddf7-4d3b-8e1e-307d5f05c82d",
                                                "sense_id": "56906fa9-df19-3a50-9571-6fa0f321b0af",
                                                "text": "The peg fit so snugly in the hole that it couldn't be pulled out by hand."
                                            },
                                            {
                                                "example_id": "1d1619c8-daf0-4a5e-9816-8585a0474aff",
                                                "sense_id": "56906fa9-df19-3a50-9571-6fa0f321b0af",
                                                "text": "He’s wrapped up snugly in a cozy bubble of self-regard, talking for his own sake more than anyone else’s."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b13324ce-3230-4097-86b6-7e3d61472739",
                        "source_entry_id": "4b5f7063-2f02-3736-921d-7167c02b69f5",
                        "source_sense_id": "9f60aded-4d31-3675-b95a-d932ccc6f600",
                        "target_lang_word": "cosy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cosy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7820802f-d8aa-398a-bb5b-4ec3452e04da",
                                        "entry_id": "02e1fb04-7759-3b0e-bb9f-37b84f9dd8a2",
                                        "glosses": [
                                            "Affording comfort and warmth; snug; social and comfortable."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce6b576a-2c2d-4f99-a08f-e2ba39fb9434",
                                                "sense_id": "7820802f-d8aa-398a-bb5b-4ec3452e04da",
                                                "text": "Mr. Pickwick expressed the pleasure it would afford him to meet the medical fellows; and Mr. Bob Sawyer had informed him that he meant to be very cosey, and that his friend Ben was to be one of the party, they shook hands and separated"
                                            },
                                            {
                                                "example_id": "eba523ae-b462-484c-a8d7-91dbd87d448b",
                                                "sense_id": "7820802f-d8aa-398a-bb5b-4ec3452e04da",
                                                "text": "One of us must marry well; Meg didn't, Jo won't, Beth can't, yet,—so I shall, and make everything cosy all round."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c688eb5-63a0-3597-b216-7150c2812c12",
                                        "entry_id": "02e1fb04-7759-3b0e-bb9f-37b84f9dd8a2",
                                        "glosses": [
                                            "Warm and comfortable."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24f7d8eb-ad11-45da-b3c8-28893a7a1d2e",
                                                "sense_id": "6c688eb5-63a0-3597-b216-7150c2812c12",
                                                "text": "I feel very cosy here in my bed."
                                            }
                                        ]
                                    }
                                ]
