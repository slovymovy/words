                "senses": [
                    {
                        "sense_id": "8e7e1096-f5af-391e-ab1d-2fd2a7efd451",
                        "entry_id": "34c7ca96-10ea-3bf1-9eae-2c7070a315f5",
                        "glosses": [
                            "von Drogen geprägter Ort, Bereich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d93f8e4c-e64d-4dec-b9cc-6721a2088b7b",
                                "sense_id": "8e7e1096-f5af-391e-ab1d-2fd2a7efd451",
                                "text": "„Einige Zeit zuvor, müde von viel zu vielen Stunden im Auto, hatten sie sich einen Film im Fernsehen angesehen, eine in Mexiko spielende Komödie mit einem Schauspieler, der ungefähr drei Tage lang eine große Nummer gewesen war, bevor er im Drogensumpf versank und ihm nur noch Gastauftritte in Billigproduktionen wie dieser und der klägliche, schnell verblassende Ruhm von Schlagzeilen in der Boulevardpresse blieben.“"
                            },
                            {
                                "example_id": "f87fbea2-37e5-452d-962e-6db540f47910",
                                "sense_id": "8e7e1096-f5af-391e-ab1d-2fd2a7efd451",
                                "text": "„Niemand, nicht einmal seine Freunde und Angehörigen, niemand wusste, wie tief er im Drogensumpf steckte und wie krankhaft er sich nach Aufmerksamkeit sehnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
