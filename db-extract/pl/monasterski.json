                "senses": [
                    {
                        "sense_id": "f22c95ec-5a62-3ffa-b99c-5c434e7cd85e",
                        "entry_id": "c70b1dd8-1155-3149-b83c-687f7efd5e4b",
                        "glosses": [
                            "związany z Monasterem (Münsterem), dotyczący Monasteru (Münsteru)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e79ccb99-75fc-49b2-a380-910e9b9068dc",
                                "sense_id": "f22c95ec-5a62-3ffa-b99c-5c434e7cd85e",
                                "text": "Do tego układu przystąpił biskup monasterski, Maksymilian Droste-Vischering, trewirski, Jerzy Hommer, paderborneński, Klemens Ledebur i polecali proboszczom błogosławić małżeństwa mieszane bez żądania gwarancji, przepisanych prawem kanonicznym"
                            },
                            {
                                "example_id": "796f3fef-1005-4ae8-9a32-1d47e1a00170",
                                "sense_id": "f22c95ec-5a62-3ffa-b99c-5c434e7cd85e",
                                "text": "Potępienie przez cały obóz polskiej reformacji wielkiej wojny chłopskiej (1525) czy komuny monasterskiej (1534) przechodzi w debatę nad tym, czy protestantyzm naprawdę prowadzi do podważenia istniejących struktur państwowych i społeczno-politycznych"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
