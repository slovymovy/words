                ],
                "senses": [
                    {
                        "sense_id": "a584b72e-7f7c-371f-8c98-cd136992eaac",
                        "entry_id": "f38cd572-279e-3fd9-80de-62751cb0c6cb",
                        "glosses": [
                            "Classer deux à deux tous les hommes d’un équipage, pour qu’ils s’aident ou se remplacent mutuellement dans le même service, dans le même emploi."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "8fbe3016-ebc7-4bde-aacf-d5a806b8a9ef",
                                "sense_id": "a584b72e-7f7c-371f-8c98-cd136992eaac",
                                "text": "Rappelez-vous : l’Alose était amatelotée avec le Saint-Pierre, dont le capitaine était aussi un Loisel."
                            },
                            {
                                "example_id": "c872d75e-48ae-4561-bfb4-af786d03f908",
                                "sense_id": "a584b72e-7f7c-371f-8c98-cd136992eaac",
                                "text": "Querguelen, solitaire à ce bord, aurait bien voulu s’amateloter avec Le Karec, qu’il pensait Ouessantin comme lui."
                            }
                        ]
                    },
                    {
                        "sense_id": "b408cbc5-3463-3ae1-a330-23a72f2da455",
                        "entry_id": "f38cd572-279e-3fd9-80de-62751cb0c6cb",
                        "glosses": [
                            "S’associer pour une tâche, pour défricher un terrain."
                        ],
