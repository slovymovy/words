{
    "word_family": [
        "ball",
        "room"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e99bf793-eccc-354d-a738-11afa2afb7a2",
                    "sense_definition": "A large room designed for formal dancing and social events.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dancing_space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guests gathered in the grand <w>ballroom</w> for the opening dance.",
                            "target_lang_translations": {
                                "zh": "客人们聚集在宏伟的<w>舞厅</w>里准备开场舞。"
                            }
                        },
                        {
                            "text": "They decorated the <w>ballroom</w> with flowers for the wedding reception.",
                            "target_lang_translations": {
                                "zh": "他们用鲜花装饰了<w>宴会厅</w>，以迎接婚礼招待会。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dancehall"
                    ],
                    "common_phrases": [
                        "grand ballroom"
                    ],
                    "target_lang_definitions": {
                        "zh": "用于正式舞会和社交活动的宽敞大厅。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "舞厅",
                                "target_lang_sense_clarification": "指专门用于跳舞的宽敞房间或场所。"
                            },
                            {
                                "target_lang_word": "宴会厅",
                                "target_lang_sense_clarification": "指酒店或大型建筑中用于举办正式宴会和舞会的厅堂。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50b1593d-17a2-38af-a8c2-2f1b4ab0bbc0",
                    "sense_definition": "A style of formal, elegant partner dancing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dancing_style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has been taking lessons in <w>ballroom</w> for several years.",
                            "target_lang_translations": {
                                "zh": "她学习<w>交谊舞</w>已经好几年了。"
                            }
                        },
                        {
                            "text": "The couple performed a beautiful <w>ballroom</w> routine at the competition.",
                            "target_lang_translations": {
                                "zh": "这对舞伴在比赛中表演了一套优美的<w>交谊舞</w>动作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ballroom dancing"
                    ],
                    "common_phrases": [
                        "ballroom dancing"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种正式、优雅的双人交谊舞风格。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "交谊舞",
                                "target_lang_sense_clarification": "指在社交场合进行的双人舞，通常指代标准舞或拉丁舞。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "32a81f47-c72f-3c68-86d5-52c829836296",
                    "sense_definition": "To participate in formal partner dancing.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "dancing_style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>ballroom</w> all night at the gala.",
                            "target_lang_translations": {
                                "zh": "他们决定在晚会上通宵<w>跳交谊舞</w>。"
                            }
                        },
                        {
                            "text": "It is rare to see young people <w>ballroom</w> in modern clubs.",
                            "target_lang_translations": {
                                "zh": "在现代俱乐部里很少见到年轻人<w>跳交谊舞</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "参加正式的双人交谊舞活动。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "跳交谊舞",
                                "target_lang_sense_clarification": "指进行交谊舞这一动作。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}