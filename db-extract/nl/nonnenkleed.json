                        "entry_id": "621f04fd-9479-3aa1-a22c-f327c6a5dcd0",
                        "glosses": [
                            "de kleding van een kloosterzuster"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75dc607c-01cc-433a-b476-7f9a621ca24d",
                                "sense_id": "77984694-3864-35df-b690-913e891fa117",
                                "text": "Sinds vijf jaar geeft ze turnlessen. Haar nonnenkleed hangt ze dan aan de haak– voor de foto maakte ze even een uitzondering – dus stellen de kinderen weinig vragen. Maar de ouders weten maar al te goed dat ze een zuster is."
                            },
                            {
                                "example_id": "ad713511-a4d7-48eb-952a-0109bcdf6f49",
                                "sense_id": "77984694-3864-35df-b690-913e891fa117",
                                "text": "Aguilera kwam het toneel op in een nonnenkleed, maar wierp dat al snel af. Gekleed in een minuscuul topje en lederen beenstukken claimde ze de prijs voor \"het laten zien van de meeste huid\", waarmee ze de critici van haar schaarse kledij opnieuw uitdaagde."
                            }
                        ]
                    }
