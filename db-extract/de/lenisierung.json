                                "target_senses": [
                                    {
                                        "sense_id": "e4fa0b1a-0639-3652-a35b-b7132fb09207",
                                        "entry_id": "2fb0d42c-4d75-33e2-8d1b-3e778d64e047",
                                        "glosses": [
                                            "vermindering van een opgelegde straf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98b38e1c-dc2b-4c2a-956d-949829b427b5",
                                                "sense_id": "e4fa0b1a-0639-3652-a35b-b7132fb09207",
                                                "text": "De schorsing van vijftien duels werd algemeen al gezien als niet reëel. De verwachte verzachting kwam er op aandringen van de Kameroenese president Paul Biya."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba9dba1c-d0c4-3f33-a3aa-9f35900603a8",
                                        "entry_id": "2fb0d42c-4d75-33e2-8d1b-3e778d64e047",
                                        "glosses": [
                                            "het zachter maken van iets"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fcde6adb-3e65-38ba-9b03-4499f6907096",
                                        "entry_id": "2fb0d42c-4d75-33e2-8d1b-3e778d64e047",
                                        "glosses": [
                                            "het minder intens maken van iets"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82860279-f6f7-43c1-90a5-0bd8e6620a1c",
                                                "sense_id": "fcde6adb-3e65-38ba-9b03-4499f6907096",
                                                "text": "VVD en PvdA hebben een nieuw akkoord. De arbeidskorting en de heffingskorting gaan omhoog voor lagere inkomens en wordt afgebouwd voor hogere inkomens. Ook komt er 250 miljoen euro vrij voor een \"sociale agenda\". Dit geld is er voor verzachting van de maatregelen in de WW en het ontslagrecht."
                                            },
                                            {
                                                "example_id": "0faba2ba-9940-4bb3-89a5-2964b3eed2f5",
                                                "sense_id": "fcde6adb-3e65-38ba-9b03-4499f6907096",
                                                "text": "De VVD wil de gevolgen van de bezuinigingsplannen verzachten. Maar wat die verzachting betekent is niet duidelijk, zegt politiek verslaggever Jeroen van Dommelen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
