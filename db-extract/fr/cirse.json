                        "sense_id": "f21c4eeb-37d5-3456-8b28-b69d1545c120",
                        "entry_id": "a43be2a7-edcd-38e7-88c0-61e6f8071d7d",
                        "glosses": [
                            "Plantes du genre Cirsium, aux feuilles épineuses, de la famille des Astéracées, très proche du chardon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4eaebfa-0f41-48d5-bad8-dabcac68e8db",
                                "sense_id": "f21c4eeb-37d5-3456-8b28-b69d1545c120",
                                "text": "Chardons noirs, cirses, les pics-de-lance entravent nos godasses, nos pieds s’emberlificotent dans les crocs armés des ronces aux fruits bleuâtres."
                            },
                            {
                                "example_id": "1aa2a1c6-2b17-4e78-852b-e279453622b9",
                                "sense_id": "f21c4eeb-37d5-3456-8b28-b69d1545c120",
                                "text": "Ce cirse est une plante dite « hygrophile » ; autrement dit, elle pousse préférentiellement sur les sols dans lesquels circule de l’eau."
                            }
                        ]
                    }
