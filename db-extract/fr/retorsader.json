                "senses": [
                    {
                        "sense_id": "0e299f49-0e5a-3d6b-b346-2b4da6ceaa4a",
                        "entry_id": "62bbb691-f8a8-35c1-9750-33cfe9ce5ae9",
                        "glosses": [
                            "Torsader à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85bf9607-144d-4a46-8cc0-a1254ba4ca2b",
                                "sense_id": "0e299f49-0e5a-3d6b-b346-2b4da6ceaa4a",
                                "text": "La feuille d'érable peut se broder au fil plat (toujours bien lisser le fil) ou au fil torsadé (en pensant à retorsader à chaque point)."
                            },
                            {
                                "example_id": "6749afdb-bdb1-471c-b884-b972f0faa033",
                                "sense_id": "0e299f49-0e5a-3d6b-b346-2b4da6ceaa4a",
                                "text": "Enfin, sur la partie inférieure il est mieux de retorsader plus serré car c’est la partie qui supportera le nœud d’archer."
                            },
                            {
                                "example_id": "cb8dc06d-ff05-4bc8-ad98-e769bc1e46ff",
                                "sense_id": "0e299f49-0e5a-3d6b-b346-2b4da6ceaa4a",
                                "text": "(...) \"en même temps\" serait plus juste qu'\"ensuite\" car l'Aka torsade deux brins successivement sur la largeur d'une paume, puis les retorsade deux à deux immédiatement après, et recommence cette série de gestes (sa corde augmente ainsi de paumée en paumée...)."
                            }
                        ]
                    }
