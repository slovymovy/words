                "senses": [
                    {
                        "sense_id": "980ea55a-c6e2-367c-b157-fad4f5be850f",
                        "entry_id": "6389c8f7-4b28-3fdd-b0cb-12687826b71c",
                        "glosses": [
                            "Lokal, das jemand am meisten mag"
