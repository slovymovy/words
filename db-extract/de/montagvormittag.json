                            {
                                "example_id": "e895f39a-6e62-4a54-99b8-18b590df2cb2",
                                "sense_id": "edc41566-f1d2-3863-b74e-1d8fc7c5c44d",
                                "text": "Diese Woche haben wir den Montagvormittag dazu genutzt, endlich mal die Schränke in unserem Büro auszumisten."
                            },
                            {
                                "example_id": "3a9617e1-7f37-4549-a1d2-74f2f222d651",
                                "sense_id": "edc41566-f1d2-3863-b74e-1d8fc7c5c44d",
                                "text": "Montagvormittage verlaufen meistens sehr stressig, weil die Arbeit vom Wochenende aufgelaufen ist."
                            }
