            {
                "entry_id": "6f970e9f-9801-33d6-bff7-b54cc09d24ad",
                "word": "bisounours",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "623ab3d5-74f2-3d08-9557-b1a03dc3d4bf",
                        "entry_id": "6f970e9f-9801-33d6-bff7-b54cc09d24ad",
                        "glosses": [
                            "Personne jugée politiquement enfantine ou naïve."
                        ],
                        "tags": [
                            "ironic"
                        ],
                        "examples": [
                            {
                                "example_id": "6769647d-7a24-476f-8b99-72736be85f06",
                                "sense_id": "623ab3d5-74f2-3d08-9557-b1a03dc3d4bf",
                                "text": "Une Nation n’est pas une auberge espagnole, ni un monde de bisounours où la tolérance suffirait à éviter tous les conflits."
                            },
                            {
                                "example_id": "5dde4325-dde0-4c63-b965-f22cd99d2511",
                                "sense_id": "623ab3d5-74f2-3d08-9557-b1a03dc3d4bf",
                                "text": "Trompés par une image mièvre en décalage avec la réalité, les bisounours se font rouler dans la farine."
                            },
                            {
                                "example_id": "25c24204-a0b5-431e-ab59-f14cb5431384",
                                "sense_id": "623ab3d5-74f2-3d08-9557-b1a03dc3d4bf",
                                "text": "Ceux qui y résistent et qui prônent le mélange, l’inclusion ou le vivre ensemble sont dépeints en « bisounours » naïfs et inconscients de la dureté du monde."
                            },
                            {
                                "example_id": "cbbe5501-4bb1-43fd-8f2e-148467ec2094",
                                "sense_id": "623ab3d5-74f2-3d08-9557-b1a03dc3d4bf",
                                "text": "La gauche ne doit pas jouer les bisounours : il faut qu'elle désobéisse aux institutions européennes et applique un plan B radical."
                            }
                        ]
                    }
                ],
