                ],
                "senses": [
                    {
                        "sense_id": "823e748e-f3b3-3f67-bb75-88ba13cddb45",
                        "entry_id": "54c28f92-2793-35a1-9342-50a5644fb893",
                        "glosses": [
                            "wirtschaftliche Krise infolge Kreditausfällen, Leerständen und sinkenden Preisen in der Immobilienbranche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cd42111-f67a-416c-b7cd-80113a4c3f6a",
                                "sense_id": "823e748e-f3b3-3f67-bb75-88ba13cddb45",
                                "text": "„Seit der letzten Immobilienkrise Ende der 90er-Jahre stiegen die Preise für das durchschnittliche Wohneigentum um über 100 Prozent.“"
                            },
                            {
                                "example_id": "9f1ae734-b605-4926-9b8c-c220e5ca1275",
                                "sense_id": "823e748e-f3b3-3f67-bb75-88ba13cddb45",
                                "text": "[26. August 2007:] „Die Landesbank Baden-Württemberg übernimmt die finanziell angeschlagene Sachsen LB. Sie war durch die Immobilienkrise in den USA in eine finanzielle Schieflage geraten.“"
                            },
                            {
                                "example_id": "ee78172d-a860-48d7-8b0d-f1f6c987683a",
                                "sense_id": "823e748e-f3b3-3f67-bb75-88ba13cddb45",
                                "text": "„Die Folgen der Immobilienkrise haben Millionen Hauseigentümer in den USA in den Ruin getrieben.“"
                            },
                            {
                                "example_id": "f54038e3-bcbe-467e-908d-4e301111fd30",
                                "sense_id": "823e748e-f3b3-3f67-bb75-88ba13cddb45",
                                "text": "„Viele seiner Bücher spielen in New York, Bezüge zum Vietnam- oder Irakkrieg finden sich darin genauso wie zur Immobilienkrise 2007, die viele US-Amerikaner in den finanziellen Ruin trieb.“"
                            },
                            {
                                "example_id": "6c23baff-c4b2-4bb9-b8ab-d6c81e028ef9",
                                "sense_id": "823e748e-f3b3-3f67-bb75-88ba13cddb45",
                                "text": "„Die globale Finanzkrise, die 2007 als Immobilienkrise in den USA begann, hat fast überall auf der Welt zu einem deutlich abgeschwächten Wirtschaftswachstum oder zur Rezession geführt.“"
                            },
                            {
                                "example_id": "8c2a2b05-82c3-4761-9402-92f9f6cc66f5",
                                "sense_id": "823e748e-f3b3-3f67-bb75-88ba13cddb45",
                                "text": "„Die verbrieften Immobilienkredite waren zunächst von Rating-Agenturen als \"mit geringem Risiko behaftet\" bewertet worden – im Verlauf der Immobilienkrise wurden die Papiere jedoch zunehmend schlechter bewertet.“"
                            },
                            {
                                "example_id": "fad1a6ca-ff17-429c-af61-3b3d30330917",
                                "sense_id": "823e748e-f3b3-3f67-bb75-88ba13cddb45",
                                "text": "„Die Beschäftigung in der Baubranche ist nach der Immobilienkrise 2007 zu großen Teilen weggebrochen.“"
                            },
                            {
                                "example_id": "783efa64-ff94-41c0-a07d-fa79410edc7d",
                                "sense_id": "823e748e-f3b3-3f67-bb75-88ba13cddb45",
                                "text": "„Die Bank hatte sich nicht von der Spanischen[sic!] Immobilienkrise in 2008 erholt.“"
                            },
                            {
                                "example_id": "aa8b7eaf-dd47-4233-8f65-120c7393558b",
                                "sense_id": "823e748e-f3b3-3f67-bb75-88ba13cddb45",
                                "text": "„Es wurde bekannt, dass in den Büchern der Banco Popular rund 37 Milliarden Euro „fauler Kredite“ aus der Immobilienkrise standen, bei einer Gesamtbilanzsumme von 98 Milliarden Euro.“"
                            },
                            {
                                "example_id": "f585065c-6fd1-4e83-9c5d-c1854a8b70fc",
                                "sense_id": "823e748e-f3b3-3f67-bb75-88ba13cddb45",
                                "text": "[Die Tea-Party-Bewegung] „bildete sich 2009 in Opposition gegen die finanz- und wirtschaftspolitischen Maßnahmen der Regierung von Barack Obama zur Bekämpfung der US-Immobilienkrise“"
                            },
                            {
                                "example_id": "24e5d904-21fd-4ab7-ac98-f66d66b23530",
                                "sense_id": "823e748e-f3b3-3f67-bb75-88ba13cddb45",
                                "text": "[Schlagzeile:] „Chinas Kampf gegen die Immobilienkrise“"
                            },
                            {
                                "example_id": "1b7ef23c-9090-47a4-93cb-317ef0d8b9e0",
                                "sense_id": "823e748e-f3b3-3f67-bb75-88ba13cddb45",
                                "text": "„»Die Immobilienkrise strahlt auf andere Bereiche der Wirtschaft ab und verunsichert viele Konsumenten«, stellt der Chefvolkswirt der Commerzbank, Jörg Krämer fest.“"
                            },
                            {
                                "example_id": "81d72bcd-bd38-4d05-baf1-3472d19b4a9b",
                                "sense_id": "823e748e-f3b3-3f67-bb75-88ba13cddb45",
                                "text": "„In Chinas Immobilienkrise ist der Handel mit Papieren des angeschlagenen Riesenkonzerns Country Garden an der Börse in Hongkong gestoppt worden.“"
                            },
                            {
                                "example_id": "62cf15f6-d9c1-43d4-9c9d-a39b99328ed0",
                                "sense_id": "823e748e-f3b3-3f67-bb75-88ba13cddb45",
                                "text": "„Die wirtschaftlichen Daten sind schwach, die Immobilienkrise hält China im Griff.“"
                            },
                            {
                                "example_id": "66451d3c-565d-4215-9ada-926058285caa",
                                "sense_id": "823e748e-f3b3-3f67-bb75-88ba13cddb45",
                                "text": "„Zudem hat die Immobilienkrise viele Privatpersonen in China geschädigt: rund 70 Prozent ihrer Ersparnisse legen die Menschen in Immobilien an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
