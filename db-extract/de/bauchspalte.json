                "senses": [
                    {
                        "sense_id": "8b1e2122-d772-37b2-8461-e6f06dba879c",
                        "entry_id": "8015b18c-d4de-3bb6-9842-c10fa76bd351",
                        "glosses": [
                            "offene Bauchdecke nach der Geburt mit zum Teil außenliegenden Organen, meist dem Darm; Gastroschisis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e677002-2b00-49b4-8422-7992c6c8c753",
                                "sense_id": "8b1e2122-d772-37b2-8461-e6f06dba879c",
                                "text": "„In den minder hohen Graden von Brust- und Bauchspalte erstreckt sich die Spaltung von der Brust aus nur bis auf den Nabel, es liegen dann gewöhnlich nicht die sämmtlichen Brust und Baucheingeweide, sondern nur Herz, Leber, Magen, Milz und ein Theil des Dünndarms vor […].“"
                            },
                            {
                                "example_id": "09771fa2-1d59-4cac-a028-d02af68e69c1",
                                "sense_id": "8b1e2122-d772-37b2-8461-e6f06dba879c",
                                "text": "„Die vorliegende Missbildung ist nach der Försterschen Nomenclatur eine Bauchspalte, Gastroschisis, und gehört zu den einfachen Bildungshemmungen; sie zeigt ein Stehenbleiben der Entwicklung auf einer Stufe des Foetallebens an, welche vor der achten Woche liegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
