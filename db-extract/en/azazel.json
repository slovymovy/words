    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "acc0bc9d-b945-30f4-b866-5363e715bfd8",
                "word": "Azazel",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a837769b-59af-336e-9974-01ae1e2e2ef7",
                        "entry_id": "acc0bc9d-b945-30f4-b866-5363e715bfd8",
                        "glosses": [
                            "A fallen angel in some traditions of Judaism and Christianity."
                        ],
                        "tags": [
                            "Judaism"
                        ],
                        "examples": [
                            {
                                "example_id": "488488c1-946f-4989-a889-2a4383ccdd54",
                                "sense_id": "a837769b-59af-336e-9974-01ae1e2e2ef7",
                                "text": "Then strait commands that at the warlike sound / Of Trumpets loud and Clarions be upreard / His mighty Standard ; that proud honour claim'd / Azazel as his right, a Cherub tall:"
                            }
                        ]
                    },
                    {
                        "sense_id": "abe2aabe-4797-3aed-a9a1-832a9b11f84b",
                        "entry_id": "acc0bc9d-b945-30f4-b866-5363e715bfd8",
                        "glosses": [
                            "Satan."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f397b5da-7743-35ec-851e-fb4139fd5a59",
                        "entry_id": "acc0bc9d-b945-30f4-b866-5363e715bfd8",
                        "glosses": [
                            "The name of Iblis."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0650b4c5-dc6b-44fd-b679-64f3851f0675",
                        "source_entry_id": "acc0bc9d-b945-30f4-b866-5363e715bfd8",
                        "source_sense_description": "a fallen angel",
                        "target_lang_word": "Asasel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
