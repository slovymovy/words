    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "9465b86c-3828-3cdb-80af-65e537baed10",
                "word": "monokini",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3cd899be-aa38-419b-8848-b949ac018b83",
                        "entry_id": "9465b86c-3828-3cdb-80af-65e537baed10",
                        "tags": [
                            "plural"
                        ],
                        "form": "monokinis"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "09820e34-ba81-3f9b-a7a5-edf626e3400c",
                        "entry_id": "9465b86c-3828-3cdb-80af-65e537baed10",
                        "glosses": [
                            "The lower part of a bikini without the upper part (i.e., topless)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5de06d7-0cc0-4e9b-b64d-16206d5ecb21",
                                "sense_id": "09820e34-ba81-3f9b-a7a5-edf626e3400c",
                                "text": "All this so impressed the Appellate Court in Aix-en-Provence that it reversed the convictions. \"Inasmuch as the spectacle of the nudity of the human body has nothing intrinsic in it that would outrage normal, even delicate decency, and since Claudine Durand concealed her sexual parts with a sufficiently opaque monokini, we acquit her.\""
                            },
                            {
                                "example_id": "6ef745fe-7b62-455c-a695-421ce287bf8c",
                                "sense_id": "09820e34-ba81-3f9b-a7a5-edf626e3400c",
                                "text": "French academics and historians have spent the early summer months pondering the sociological meaning of the demise of France's once-favourite piece of beachwear, the \"monokini\" – the bottom half of a bikini with no top."
                            },
                            {
                                "example_id": "e13cf6f9-300c-4062-a137-5d0b7fa93132",
                                "sense_id": "09820e34-ba81-3f9b-a7a5-edf626e3400c",
                                "text": "In fact, the San Francisco Chronicle featured a photo of a woman in a monokini — her exposed breasts clearly visible — on its front page."
                            }
                        ]
                    },
                    {
                        "sense_id": "7074ef2a-f67b-3723-a27e-3662442be5e7",
                        "entry_id": "9465b86c-3828-3cdb-80af-65e537baed10",
                        "glosses": [
                            "A one-piece swimsuit, which may cover both the chest and the crotch (as contrasted with a bikini, which consists of two pieces)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "545de3a4-2ca8-4bbf-ab49-32b3e51ede84",
                                "sense_id": "7074ef2a-f67b-3723-a27e-3662442be5e7",
                                "text": "[Psylocke is] wearing a mix between a monokini and cut-out swimwear, a wardrobe change[.]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f4568b9b-aa2d-406b-9735-8e96d8634954",
                        "source_entry_id": "9465b86c-3828-3cdb-80af-65e537baed10",
                        "source_sense_description": "bikini worn without the upper part",
                        "target_lang_word": "monokini",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monokini",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4294855b-c080-3bf0-b3c1-ab5932eeca4f",
                                        "entry_id": "494bd41e-cd68-3e12-bced-41892f901530",
                                        "glosses": [
                                            "bikini zonder bovenstuk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "356aeb75-b3dd-4ade-bf67-6e5a3a2d086d",
                                                "sense_id": "4294855b-c080-3bf0-b3c1-ab5932eeca4f",
                                                "text": "\"De hel, dat is het Heineken Huis.\"Je traint tientallen jaren om als zwaantje in een gymzaal te hangen, met meer kans op geen medaille dan wel, terwijl het ware goud op het strand van Copacabana gewillig in een te kleine monokini naar je smacht met een caipirinha in haar hand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08d407b0-41c8-3b7c-ad7d-3645abf90188",
                                        "entry_id": "494bd41e-cd68-3e12-bced-41892f901530",
                                        "glosses": [
                                            "bikini waarbij boven- en benedendeel met elkaar zijn verbonden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d466c514-afb0-47b0-869c-2317caf360d6",
                                                "sense_id": "08d407b0-41c8-3b7c-ad7d-3645abf90188",
                                                "text": "Jasmijn: **** Deze variant op het badpak blijft prima zitten. Sandra: *** Hangt een beetje af van het soort monokini, maar de meeste zijn swim proof."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7d875de-eda0-4841-8d40-2be6c5b41387",
                        "source_entry_id": "9465b86c-3828-3cdb-80af-65e537baed10",
                        "source_sense_description": "bikini worn without the upper part",
                        "target_lang_word": "monokini",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monokini",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5538cc20-a597-3a60-88b0-8c35a4c93dab",
                                        "entry_id": "4432a66a-8353-37ee-a025-cb22cf5cae39",
                                        "glosses": [
                                            "Maillot de bain laissant les seins nus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97acc007-1fa6-4367-a6a8-0a7311022ea9",
                                                "sense_id": "5538cc20-a597-3a60-88b0-8c35a4c93dab",
                                                "text": "Le ministre de l’Intérieur a demandé aux préfets de rappeler aux maires qu’il ne leur appartenait pas d’autoriser le port du monokini. Ce maillot de bain, précise M. Frey, constitue un outrage public à la pudeur qui relève de l’article 330 du code pénal."
                                            },
                                            {
                                                "example_id": "63f76323-e632-4a3e-83be-cd3712a90e19",
                                                "sense_id": "5538cc20-a597-3a60-88b0-8c35a4c93dab",
                                                "text": "Aujourd'hui, le fait pour une femme de bronzer seins nus sur les plages ne rentre plus dans le cadre du délit d’exhibition sexuelle de l’article 222-32 du Code pénal, compte tenu de l’évolution des mœurs et de son usage répandu. Cependant, les municipalités peuvent, si elles le souhaitent, interdire le monokini sur leur plage par arrêté municipal."
                                            },
                                            {
                                                "example_id": "687b4546-f64b-4e4a-b4f7-e8e5ab33216e",
                                                "sense_id": "5538cc20-a597-3a60-88b0-8c35a4c93dab",
                                                "text": "Je ne faisais pas de monokini\n A tokyo^([sic]) tout nu\n A tokyo^([sic]) tout nu\n Je ne faisais pas (x2)\n De monokini !(X2)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8bcfed0b-483a-45c4-acfb-d63adafedf49",
                        "source_entry_id": "9465b86c-3828-3cdb-80af-65e537baed10",
                        "source_sense_description": "bikini worn without the upper part",
                        "target_lang_word": "Monokini",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Monokini",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "61c521ab-dca1-3b73-b442-4194251a7fce",
                                        "entry_id": "2cd43928-f7da-37cb-bb06-2f7bb9d46317",
                                        "glosses": [
                                            "Anfang der 1960er-Jahre entstandener einteiliger Badeanzug, der die Brust unbedeckt lässt"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "596b8bb9-5c89-46d1-95f6-8e0451638aee",
                                                "sense_id": "61c521ab-dca1-3b73-b442-4194251a7fce",
                                                "text": "„Wohlgeformte Mannequins führten anfangs Nachthemden und Bikinis, alsbald aber nur noch Monokinis vor.“"
                                            },
                                            {
                                                "example_id": "d56b2d54-3d1c-4452-9d7e-edcb787deb85",
                                                "sense_id": "61c521ab-dca1-3b73-b442-4194251a7fce",
                                                "text": "„Jetzt hat die Leitung des Alpamare in Bad Tölz der blanken Brust Lizenz erteilt: Für ihre 9,50 Mark Eintritt können Damen den Fitness- und Badebetrieb jetzt auch im Monokini nutzen.“"
                                            },
                                            {
                                                "example_id": "54c1ea37-d1a6-4d66-84a6-4d76bde7fa33",
                                                "sense_id": "61c521ab-dca1-3b73-b442-4194251a7fce",
                                                "text": "„In den Badeanlagen von Fregene bei Rom oder in den Dünen von Ostia nimmt längst niemand mehr am Monokini Anstoß.“"
                                            },
                                            {
                                                "example_id": "ebd54129-a11d-4d27-8796-544203f8ddda",
                                                "sense_id": "61c521ab-dca1-3b73-b442-4194251a7fce",
                                                "text": "„Die Mode des Monokini scheint das Watt nie überquert zu haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "662e4cef-0ed1-3a7a-b203-b0b05204c1a9",
                                        "entry_id": "2cd43928-f7da-37cb-bb06-2f7bb9d46317",
                                        "glosses": [
                                            "modernes Kleidungsstück, das von Frauen beim Baden getragen wird und aus einem Oberteil sowie einer Hose besteht, wobei zwischen diesen beiden Elementen eine Verbindung etwa mittels eines Stückes Textil, eines Bandes oder eines Ringes hergestellt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d24a158-d9f2-4657-a577-57d5d783f271",
                                                "sense_id": "662e4cef-0ed1-3a7a-b203-b0b05204c1a9",
                                                "text": "„Der Schnitt des Monokini ist ebenfalls vielseitig. Es gibt viele verschiedenen Verbindungsvarianten. So kann zum Beispiel ein Streifen Stoff direkt und gerade über den Bauchnabel führen, ein anderer Monokini hingegen hat zwei Verbindungsteile, die sich links und rechts an den Seiten befinden, oder sich sogar überkreuzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
