                },
                {
                    "sense_id": "209adb72-ba37-32e2-b46c-a65b1a7c4882",
                    "sense_definition": "Niewiele wart, mający niską wartość moralną lub artystyczną.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wartosc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie interesuje mnie jego <w>tani</w> poklask i nieszczere komplementy.",
                            "target_lang_translations": {
                                "ru": "Меня не интересуют его <w>дешёвая</w> популярность и неискренние комплименты.",
                                "en": "I am not interested in his <w>cheap</w> applause and insincere compliments.",
                                "de": "Mich interessiert sein <w>billiger</w> Applaus und seine unaufrichtigen Komplimente nicht."
                            }
                        },
                        {
                            "text": "Ten film to tylko <w>tania</w> rozrywka bez głębszego przesłania.",
                            "target_lang_translations": {
                                "ru": "Этот фильм — всего лишь <w>дешёвое</w> развлечение без глубокого смысла.",
                                "en": "This movie is just <w>trashy</w> entertainment with no deeper message.",
                                "de": "Dieser Film ist nur <w>billige</w> Unterhaltung ohne tiefere Botschaft."
                            }
                        }
