                                        "examples": [
                                            {
                                                "example_id": "968874bb-c9d5-42f1-8398-1729333199a2",
                                                "sense_id": "039bb1e2-9045-333b-b167-92d9484981df",
                                                "text": "Avoir la roupie au nez."
                                            },
                                            {
                                                "example_id": "6f762fe3-489d-4bc2-ac0a-5e246233dc13",
                                                "sense_id": "039bb1e2-9045-333b-b167-92d9484981df",
                                                "text": "Il lui coule perpétuellement du nez une roupie qu’il recueille dans un mouchoir rouge, grand comme un drap."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e154e164-b01c-3872-a6ef-1938a6f59e54",
                                        "entry_id": "c9aa5bf9-bbb4-3d89-b43c-d002c8c452f6",
                                        "glosses": [
