                "senses": [
                    {
                        "sense_id": "328c2b9a-5781-3326-b517-dbf64738da49",
                        "entry_id": "01fc1d5d-6d43-324a-b6fd-7578dc88b23d",
                        "glosses": [
                            "Stagner à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ad65e72-6a07-4fcb-9f15-5354f2fb1432",
                                "sense_id": "328c2b9a-5781-3326-b517-dbf64738da49",
                                "text": "Mais quand nous retombons las, nous l'écoutons restagner de partout et nous sommes plus tristes, pas assez forts pour un tapage éternel ou pour nous faire au Silence éternel."
                            },
                            {
                                "example_id": "fc68ed95-e3de-4fe2-82b0-0126912b8288",
                                "sense_id": "328c2b9a-5781-3326-b517-dbf64738da49",
                                "text": "Car la cause qui la faisoit hausser et restagner auparavant ne subsistant plus, son effet devoit cesser aussi."
                            },
                            {
                                "example_id": "fa84c486-9649-489f-93a8-7559d4961958",
                                "sense_id": "328c2b9a-5781-3326-b517-dbf64738da49",
                                "text": "Ils ont remis un coup de boost, mais il restagnent aux alentours de 1000."
                            }
                        ]
                    }
