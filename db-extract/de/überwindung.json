                                    {
                                        "sense_id": "53c83a9c-a9c7-303e-b896-fe7aba7df98a",
                                        "entry_id": "df10f817-96e8-346a-a189-596203259974",
                                        "glosses": [
                                            "The act by which something is overcome, or surmounted."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa780856-3a47-4923-b8c6-7619e300b0ef",
                                                "sense_id": "53c83a9c-a9c7-303e-b896-fe7aba7df98a",
                                                "text": "Ther with all cam kyng Arthur but with a fewe peple and slewe on the lyfte hand and on the ryght hand that wel nyhe ther escaped no man / but alle were slayne to the nombre of xxx M / And whan the bataille was all ended the kynge kneled doune and thanked god mekely / and thenne he sente for the quene and soone she was come / and she maade grete Ioye of the ouercomynge of that bataille"
                                            },
                                            {
                                                "example_id": "9106cddb-9390-48c6-9f06-8519b62cff80",
                                                "sense_id": "53c83a9c-a9c7-303e-b896-fe7aba7df98a",
                                                "text": "In the eyes of their witnesses, exemplary figures redeem their own suffering, which in turn emboldens these witnesses to attempt painful self-overcomings of their own."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
