                "senses": [
                    {
                        "sense_id": "e0af34e6-f68b-3513-a5bf-31eabb1dba81",
                        "entry_id": "e8fb83cc-81ed-3a02-bf12-f6d192ebde5d",
                        "glosses": [
                            "The theory of poetry, or of literature in general."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2508a30-e189-4ea5-944d-5f9386217666",
                                "sense_id": "e0af34e6-f68b-3513-a5bf-31eabb1dba81",
                                "text": "Both significantly build on the poetics of death and dissolution that Black and Tan broached so powerfully[…]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a33ad110-6922-42ee-8ac1-fd59bfee0be6",
                        "source_entry_id": "e8fb83cc-81ed-3a02-bf12-f6d192ebde5d",
                        "source_sense_id": "e0af34e6-f68b-3513-a5bf-31eabb1dba81",
                        "source_sense_description": "the theory of poetry",
                        "target_lang_word": "poétique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poétique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "45d0e48b-fae9-36e5-8f2e-47f47a51d027",
                                        "entry_id": "55883ec8-ddaf-34e8-8549-c745ce422750",
                                        "glosses": [
                                            "Qui concerne la poésie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcd8733b-7b29-4d07-8df7-c4cf85ddb3ef",
                                                "sense_id": "45d0e48b-fae9-36e5-8f2e-47f47a51d027",
                                                "text": "Style poétique."
                                            },
                                            {
                                                "example_id": "74d9b0d9-07d2-411e-a732-3e53b0a94ce9",
                                                "sense_id": "45d0e48b-fae9-36e5-8f2e-47f47a51d027",
                                                "text": "Génie Poétique."
                                            },
                                            {
                                                "example_id": "78e728e6-d99c-4318-9167-0905c0b951e3",
                                                "sense_id": "45d0e48b-fae9-36e5-8f2e-47f47a51d027",
                                                "text": "Imagination poétique."
                                            },
                                            {
                                                "example_id": "f2b45a10-7cc7-4adb-8128-837f219f9bab",
                                                "sense_id": "45d0e48b-fae9-36e5-8f2e-47f47a51d027",
                                                "text": "Enthousiasme poétique."
                                            },
                                            {
                                                "example_id": "e22e44fc-dffa-4927-acfb-94edfbe509f1",
                                                "sense_id": "45d0e48b-fae9-36e5-8f2e-47f47a51d027",
                                                "text": "Licence poétique se dit de certaines libertés que les poètes se donnent dans leurs vers, contre les règles ordinaires de la langue ou de la versification, et qui ne seraient pas reçues dans la prose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5968a283-e36e-3fad-9978-73d28601e0c7",
                                        "entry_id": "55883ec8-ddaf-34e8-8549-c745ce422750",
                                        "glosses": [
                                            "Qui concerne la poésie.",
                                            "Il se dit, par ironie, d’une altération de la vérité."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fa87a55-838b-4c86-afaf-f1cab98effa3",
                                                "sense_id": "5968a283-e36e-3fad-9978-73d28601e0c7",
                                                "text": "Il y a dans ce récit des licences poétiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef4a7228-99b7-317a-a9ee-99b5ae50efc6",
                                        "entry_id": "55883ec8-ddaf-34e8-8549-c745ce422750",
                                        "glosses": [
                                            "Ce qui est relatif aux qualités de la poésie, de ce qui en offre les caractères d’élévation, d’inspiration, d’images, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9c68352-e9e5-49e3-9618-2dfe5ba578d6",
                                                "sense_id": "ef4a7228-99b7-317a-a9ee-99b5ae50efc6",
                                                "text": "Le sentiment poétique."
                                            },
                                            {
                                                "example_id": "a001d353-da45-44c3-8cfb-bba7d9dfc4e8",
                                                "sense_id": "ef4a7228-99b7-317a-a9ee-99b5ae50efc6",
                                                "text": "Prose poétique."
                                            },
                                            {
                                                "example_id": "2f16519d-22c7-41c6-a826-3a9b0ef60bf5",
                                                "sense_id": "ef4a7228-99b7-317a-a9ee-99b5ae50efc6",
                                                "text": "C’est une nature poétique."
                                            },
                                            {
                                                "example_id": "7d79803e-8319-459f-af3c-5749625640ad",
                                                "sense_id": "ef4a7228-99b7-317a-a9ee-99b5ae50efc6",
                                                "text": "Ce paysage a quelque chose de poétique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "poétique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd5d80ba-081e-345e-bceb-93fefc00f64d",
                                        "entry_id": "9f73f81b-6d7f-3870-ad07-a71e4f21577a",
                                        "glosses": [
                                            "Traité de l’art de la poésie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e02c0a5f-340f-49bb-bfd6-1bf92c8c770d",
                                                "sense_id": "fd5d80ba-081e-345e-bceb-93fefc00f64d",
                                                "text": "La poétique d’Horace est le modèle des poèmes didactiques, et jamais on n’a renfermé tant de sens en si peu de vers."
                                            },
                                            {
                                                "example_id": "68c5ec58-9f40-46d7-b57f-2c63f2896428",
                                                "sense_id": "fd5d80ba-081e-345e-bceb-93fefc00f64d",
                                                "text": "Les quatre Poétiques, se dit du traité d’Aristote et des poèmes d’Horace, de Boileau et de Vida, qui ont été réunis en un volume classique."
                                            },
                                            {
                                                "example_id": "af68cf8f-1efd-4f24-b925-71bd15438bd7",
                                                "sense_id": "fd5d80ba-081e-345e-bceb-93fefc00f64d",
                                                "text": "La Poétique d’Aristote."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf094fff-50ea-3787-882c-19a30c508e0d",
                                        "entry_id": "9f73f81b-6d7f-3870-ad07-a71e4f21577a",
                                        "glosses": [
                                            "Ensemble de conceptions de la poésie propre à un poète, à une école…"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b6b0c30-49e9-41ab-9596-1649f9c1808b",
                                                "sense_id": "bf094fff-50ea-3787-882c-19a30c508e0d",
                                                "text": "C’est une poétique à quoi les commerçants de tous poils sont sensibles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "697523c6-432d-322a-9cc2-2d539fa9f591",
                                        "entry_id": "9f73f81b-6d7f-3870-ad07-a71e4f21577a",
                                        "glosses": [
                                            "Ensemble cohérent de principes esthétiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dadd9e2f-37f5-41d0-86f0-b653fb03f3f6",
                                                "sense_id": "697523c6-432d-322a-9cc2-2d539fa9f591",
                                                "text": "La Poétique de l’espace Gaston Bachelard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5c7eb31-8733-3280-986c-0b8f2bc9305e",
                                        "entry_id": "9f73f81b-6d7f-3870-ad07-a71e4f21577a",
                                        "glosses": [
                                            "Théorie de la littérature."
                                        ],
                                        "tags": [
                                            "Depuis Paul Valéry"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9339c2b-d6f8-4ec2-8c25-1544c0da7000",
                        "source_entry_id": "e8fb83cc-81ed-3a02-bf12-f6d192ebde5d",
