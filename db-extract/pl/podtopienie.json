                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3d400dd-021c-485e-8b64-bf5daf99f808",
                                "sense_id": "c0dd14f6-0051-3660-b53a-1f5c93d24336",
                                "text": "Gospodarstwa w dolinie uległy podtopieniom."
                            },
                            {
                                "example_id": "30b10e33-fac7-4e7c-8b35-708e79ab421a",
                                "sense_id": "c0dd14f6-0051-3660-b53a-1f5c93d24336",
                                "text": "Przeprowadzono także badania otoczenia małych zbiorników wodnych, obszarów podmokłych wskutek podtopień cieków i jezior pod kątem występowania schistosomatozy"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30d0c140-e315-4228-a00c-133ff1aff045",
                        "source_entry_id": "d2711ca6-1e18-3d71-8234-5978375ab3eb",
                        "source_sense_id": "c0dd14f6-0051-3660-b53a-1f5c93d24336",
                        "target_lang_word": "Hochwasser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hochwasser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1d9fe414-0eaa-3c50-9cf5-c9ec53d75b8b",
                                        "entry_id": "6e134787-fd04-3d5f-9bcd-b548df7f3038",
                                        "glosses": [
                                            "bei Bächen oder Flüssen über die Ufer getretenes Wasser"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f55748b7-0c85-4f27-a321-4633489a15dc",
                                                "sense_id": "1d9fe414-0eaa-3c50-9cf5-c9ec53d75b8b",
                                                "text": "Bei Hochwasser werden oft die Keller der Anrainer überschwemmt."
                                            },
                                            {
                                                "example_id": "c8681c56-da3c-4a99-b985-137cb35c0fd2",
                                                "sense_id": "1d9fe414-0eaa-3c50-9cf5-c9ec53d75b8b",
                                                "text": "„Die Römer legten die Siedlung vermutlich absichtlich nicht in der direkten Nähe des Zusammenflusses von Rhein und Mosel an, weil dieses Gebiet bei Hochwasser stets überflutet ist.“"
                                            },
                                            {
                                                "example_id": "87f126cc-8044-43b5-b25e-e1e61e3fb137",
                                                "sense_id": "1d9fe414-0eaa-3c50-9cf5-c9ec53d75b8b",
                                                "text": "„Nur zu meiner Schule in Vallendar kam das Hochwasser nicht hin.“"
                                            },
                                            {
                                                "example_id": "17cebe0b-13f7-47fb-9fd8-21f7ed1e1335",
                                                "sense_id": "1d9fe414-0eaa-3c50-9cf5-c9ec53d75b8b",
                                                "text": "„Ein schweres Unwetter führt am 8. Juli 1926 zum Hochwasser im Steintorbereich.“"
                                            },
                                            {
                                                "example_id": "eea1b687-2532-4737-91e9-e1cd8d1fca31",
                                                "sense_id": "1d9fe414-0eaa-3c50-9cf5-c9ec53d75b8b",
                                                "text": "„Wir laufen runter zum Rhein, der nach tagelangem Dauerregen und Unwettern Hochwasser führt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7abe0f2d-4bae-3b84-b6c9-6d755d5a33af",
                                        "entry_id": "6e134787-fd04-3d5f-9bcd-b548df7f3038",
                                        "glosses": [
                                            "Hochstand des Wassers am Ende der Flut"
                                        ],
                                        "tags": [
                                            "Meeresküste"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd696d8f-2384-4ed7-afe2-f3a30e6dacb7",
                                                "sense_id": "7abe0f2d-4bae-3b84-b6c9-6d755d5a33af",
                                                "text": "Bei Sturm kann Hochwasser der Küste gefährlich werden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54c91a09-f1ee-4813-ae72-90816ced018f",
                        "source_entry_id": "d2711ca6-1e18-3d71-8234-5978375ab3eb",
                        "source_sense_id": "c0dd14f6-0051-3660-b53a-1f5c93d24336",
                        "target_lang_word": "Überschwemmung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Überschwemmung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84fd42ad-aff0-31cd-a7cb-89f43535a845",
                                        "entry_id": "fb23950c-35b0-3129-8ca5-c2624885108c",
                                        "glosses": [
                                            "Zustand, der eintritt, wenn Gewässer über die Ufer treten und umliegende Gebiete unter Wasser setzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03ab9add-ca48-422f-a019-7386d55887ee",
                                                "sense_id": "84fd42ad-aff0-31cd-a7cb-89f43535a845",
                                                "text": "Die Überschwemmung richtete in der Umgebung viele Schäden an."
                                            },
                                            {
                                                "example_id": "c921f568-57c0-4c92-9657-4b166eeb2fcf",
                                                "sense_id": "84fd42ad-aff0-31cd-a7cb-89f43535a845",
                                                "text": "„Noch nie dagewesene Überschwemmungen durch zwei Tage Regen, wie er sonst in zwei Monaten fällt, haben in Deutschland und Belgien mindestens 209 Menschenleben gekostet.“"
                                            },
                                            {
                                                "example_id": "af24a684-b99d-41e8-9cfc-71ca26f5fb4a",
                                                "sense_id": "84fd42ad-aff0-31cd-a7cb-89f43535a845",
                                                "text": "„Bei der Überschwemmung in der Haseldorfer Marsch 1976 war trotz großer Verwüstungen kein Mensch in Schleswig-Holstein ums Leben gekommen.“"
                                            },
                                            {
                                                "example_id": "e8f738eb-5833-49da-ac21-6653e5ae5866",
                                                "sense_id": "84fd42ad-aff0-31cd-a7cb-89f43535a845",
                                                "text": "[Schlagzeile:] „Gewitter ohne Ende - «Lokale Überschwemmungen und hochgehende Bäche weiterhin möglich»“"
                                            },
                                            {
                                                "example_id": "69d5b6de-45f2-40e8-91a1-63e4daf9c7e2",
                                                "sense_id": "84fd42ad-aff0-31cd-a7cb-89f43535a845",
                                                "text": "„Die Monate Juli und August 2021 sind von extremen Wetterlagen geprägt - Dürre und Brände in Südeuropa, Russland und Amerika, schwere Überschwemmungen in Asien.“"
                                            },
                                            {
                                                "example_id": "2c21a36c-deb5-490c-9051-758d8053bb35",
                                                "sense_id": "84fd42ad-aff0-31cd-a7cb-89f43535a845",
                                                "text": "„Die jüngsten Überschwemmungen und Hitzewellen sind ein Zeichen für das Ende eines stabilen Klimas.“"
                                            },
                                            {
                                                "example_id": "3e0559d9-9fad-4859-891a-b2fa6207164d",
                                                "sense_id": "84fd42ad-aff0-31cd-a7cb-89f43535a845",
                                                "text": "„Nach einem Monat mit beispiellosen Überschwemmungen und Waldbränden in Europa können wir nicht wirklich überrascht sein, wenn ein neues Gutachten wieder einmal die vom Menschen verursachte Erderwärmung für diese Katastrophen verantwortlich macht.“"
                                            },
                                            {
                                                "example_id": "87e050c5-ce37-41fe-afea-0a327ad8980a",
                                                "sense_id": "84fd42ad-aff0-31cd-a7cb-89f43535a845",
                                                "text": "„Die dramatischen Überschwemmungen in Nordrhein-Westfalen und Rheinland-Pfalz wecken in Goslar und im Harz Erinnerungen an das Hochwasser von 2017.“"
                                            },
                                            {
                                                "example_id": "67dc482c-8958-4acc-9895-a196665abc58",
                                                "sense_id": "84fd42ad-aff0-31cd-a7cb-89f43535a845",
                                                "text": "„Während im Süden Italiens schwere Waldbrände wüten, gibt es im Norden Überschwemmungen.“"
                                            },
                                            {
                                                "example_id": "bfbf88f7-81eb-4e2a-9f21-ab8952928b25",
                                                "sense_id": "84fd42ad-aff0-31cd-a7cb-89f43535a845",
                                                "text": "„In einigen Gebieten des Kantons Tessin hat es am Samstag stark geregnet. […] Es kam zu zahlreichen Überschwemmungen und Erdrutschen. In Bellinzona wurde ein Kindergarten überschwemmt.“"
                                            },
                                            {
                                                "example_id": "af5e7e54-e937-4cbb-ae84-5adb430a3dca",
                                                "sense_id": "84fd42ad-aff0-31cd-a7cb-89f43535a845",
                                                "text": "„Für die nahe Zukunft vermuten sie [Anmerkung: die Forscher] folgendes: Entlang der nördlichen US-Küste könnte es häufiger Überschwemmungen geben, und in Europa mehr Extremwetterereignisse.“"
                                            },
                                            {
                                                "example_id": "18e0d321-66d4-4937-9dd6-c29df7410ec1",
                                                "sense_id": "84fd42ad-aff0-31cd-a7cb-89f43535a845",
                                                "text": "„Seit Jahrhunderten lagern die Überschwemmungen, die auf den Halligen mit niedrigen Deichen durchschnittlich vier- bis fünfmal im Jahr und auf den Halligen ohne jeden Küstenschutz durchschnittlich vierzig bis fünfzig Mal im Jahr stattfinden, Sedimente ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8634eee0-3ebb-3e0e-888a-a3b0a2e721aa",
                                        "entry_id": "fb23950c-35b0-3129-8ca5-c2624885108c",
                                        "glosses": [
                                            "starke, bedrohliche oder störende Ausdehnung von Fremdem oder Unerwünschtem"
                                        ],
                                        "tags": [
                                            "bildlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ce1e85f-4d31-4cde-920f-94f609e4ae7f",
                                                "sense_id": "8634eee0-3ebb-3e0e-888a-a3b0a2e721aa",
                                                "text": "Die EU versucht, die Überschwemmung des europäischen Marktes mit chinesischen Textilwaren einzudämmen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
