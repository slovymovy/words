{
    "word_family": [
        "canton",
        "cantonal",
        "cantonnement",
        "cantonnier",
        "décantonner"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "69257151-27b2-3072-84a4-c8b739578d11",
                    "sense_definition": "Se restreindre volontairement à un domaine, une tâche ou une attitude sans chercher à en sortir.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'écrivain refuse de se <w>cantonner</w> à un seul genre littéraire."
                        },
                        {
                            "text": "L'avocat ne veut pas se <w>cantonner</w> dans son rôle traditionnel et prend part aux débats publics."
                        }
                    ],
                    "synonyms": [
                        "se borner",
                        "se limiter",
                        "se restreindre"
                    ],
                    "common_phrases": [
                        "se cantonner à",
                        "se cantonner dans son rôle"
                    ]
                },
                {
                    "sense_id": "fefea7be-f6fd-3aec-9ea8-c5f8585e324d",
                    "sense_definition": "Circonscrire ou enfermer quelqu'un ou quelque chose dans des limites étroites.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La direction a décidé de <w>cantonner</w> ce département à des missions purement administratives."
                        },
                        {
                            "text": "Le professeur tente de <w>cantonner</w> le débat aux questions essentielles du programme."
                        }
                    ],
                    "synonyms": [
                        "circonscrire",
                        "confiner",
                        "limiter",
                        "restreindre"
                    ],
                    "antonyms": [
                        "élargir",
                        "étendre"
                    ],
                    "common_phrases": [
                        "cantonner à un rôle"
                    ]
                },
                {
                    "sense_id": "03ff3bd1-e0be-3e59-a86b-6f0e83745ba6",
                    "sense_definition": "Assigner un lieu d'hébergement provisoire à des troupes militaires dans des habitations ou des granges.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le général ordonna de <w>cantonner</w> des troupes dans les villages situés le long du fleuve."
                        },
                        {
                            "text": "Les autorités durent <w>cantonner</w> les régiments dans les faubourgs en attendant les ordres."
                        }
                    ],
                    "synonyms": [
                        "caserner",
                        "loger"
                    ],
                    "common_phrases": [
                        "cantonner des troupes"
                    ]
                },
                {
                    "sense_id": "8651a4ec-b33b-345c-aaec-6afeabd2b5c2",
                    "sense_definition": "Prendre son cantonnement et s'installer temporairement, en parlant de soldats ou de troupes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le bataillon <w>cantonne</w> dans cette petite commune depuis le début de la semaine."
                        },
                        {
                            "text": "Durant la campagne d'hiver, l'armée <w>cantonnait</w> chez les habitants des bourgades voisines."
                        }
                    ],
                    "synonyms": [
                        "bivouaquer"
                    ]
                },
                {
                    "sense_id": "67bd5b02-7a0e-3d4f-bb38-4eaa9b86efea",
                    "sense_definition": "Se retrancher dans un lieu protégé pour s'y fortifier ou s'y défendre face à un adversaire.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les insurgés se sont <w>cantonnés</w> dans les montagnes rocheuses pour résister à l'offensive."
                        },
                        {
                            "text": "Le détachement se <w>cantonna</w> derrière les vieux remparts de la ville fortifiée."
                        }
                    ],
                    "synonyms": [
                        "se fortifier",
                        "se retrancher"
                    ]
                }
            ]
        }
    ]
}