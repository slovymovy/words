                                                "sense_id": "0302cba9-948b-399e-8e29-edb91c97fbd5",
                                                "text": "galaxy filament"
                                            },
                                            {
                                                "example_id": "2c6a137d-9daa-4486-b14d-09dc0eb7789b",
                                                "sense_id": "0302cba9-948b-399e-8e29-edb91c97fbd5",
                                                "text": "the Ursa Major Filament"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "600f1b7d-d38d-39e8-9b81-e056b9fb7487",
                                        "entry_id": "e05cc4d0-2d97-30e8-b6c4-9c5c88b41ec1",
                                        "glosses": [
                                            "The stalk of a flower stamen, supporting the anther."
                                        ],
                                        "tags": [],
