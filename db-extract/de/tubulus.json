                                    {
                                        "sense_id": "68b7f48e-6850-391f-8474-32fd176cd6e7",
                                        "entry_id": "58a521fa-3116-396a-9ba7-68aaf5239d5f",
                                        "glosses": [
                                            "Structure organique en forme de petit tube."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c30f573-1f4a-4e3c-b1ef-ff012855514c",
                                                "sense_id": "68b7f48e-6850-391f-8474-32fd176cd6e7",
                                                "text": "Tubules lactifères de la glande mammaire."
                                            },
                                            {
                                                "example_id": "f57b9ebe-0e06-4992-85c0-3636ea061f9b",
                                                "sense_id": "68b7f48e-6850-391f-8474-32fd176cd6e7",
                                                "text": "H. W. Smith (1937) et Darmady (1953) ont achevé de démontrer la part considérable qui revient au tubule rénal dans l'expression biologique des néphropathies."
                                            },
                                            {
                                                "example_id": "a8a7de23-07df-4be4-aaf0-b4815ff273d3",
                                                "sense_id": "68b7f48e-6850-391f-8474-32fd176cd6e7",
                                                "text": "Tubule dentinaire, chacun des espaces tubulaires microscopiques contenus dans la dentine et s'étendant de la limite pulpo-dentaire jusqu'à la limite de l'émail."
                                            }
                                        ]
