                ],
                "senses": [
                    {
                        "sense_id": "ee75c060-99d9-3f3f-acfc-a4489457608d",
                        "entry_id": "7436a7b1-b93f-312b-85a8-9c3c745884a5",
                        "glosses": [
                            "Se référer à soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46948baf-c76c-4c68-a865-faceab410459",
                                "sense_id": "ee75c060-99d9-3f3f-acfc-a4489457608d",
                                "text": "Insensiblement, cet univers électronique donne la sensation de pouvoir vivre en autarcie, de s’exiger depuis soi, de s’auto-référer, de s’auto-satisfaire, puisque sa nature intangible est de ne pas nous tenir au courant de ce qu’il est censé faire pour nous."
                            },
                            {
                                "example_id": "ddbec606-43f7-42e8-a4cd-6ff86878f6f0",
                                "sense_id": "ee75c060-99d9-3f3f-acfc-a4489457608d",
                                "text": "Ce phénomène épargne sans doute la France, qui n’a pas de cinéaste-monstre, pouvant s’auto-référer comme nom d’auteur par-dessus les instances critiques."
                            }
                        ]
                    }
