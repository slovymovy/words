                        "glosses": [
                            "Eigenschaft, rhetorisch begabt zu sein, sich besonders überzeugend auszudrücken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff5d620b-2875-4a42-a6f2-7ad9759aad5c",
                                "sense_id": "83d7333b-22f2-36e5-bf23-4adb3fc33fb9",
                                "text": "„Er nützte in den Sonntagspredigten seine Rednergabe aus und wurde bald der beliebteste Volksprediger.“"
                            },
                            {
                                "example_id": "615b5d22-e974-4422-83f0-ff93ee36d17e",
                                "sense_id": "83d7333b-22f2-36e5-bf23-4adb3fc33fb9",
                                "text": "„Schau dir die Leute nur an, die deine Rednergabe loben, deinem Reichtum zulaufen, um deine Freundschaft buhlen und deine Macht bewundern!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
