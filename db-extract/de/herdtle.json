                "senses": [
                    {
                        "sense_id": "2a7167a1-ef87-303a-aa4a-a0d933703532",
                        "entry_id": "84900221-bda3-309b-8975-6be51a5f7874",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68b20e29-0998-4490-a5b1-83f620f4a798",
                                "sense_id": "2a7167a1-ef87-303a-aa4a-a0d933703532",
                                "text": "Herr Herdtle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "1e10ec6c-60cb-4f5a-bfc5-6c1bd4691b35",
                                "sense_id": "2a7167a1-ef87-303a-aa4a-a0d933703532",
                                "text": "Die Herdtles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "5219935e-67d1-4f4a-9122-6b16775e6689",
                                "sense_id": "2a7167a1-ef87-303a-aa4a-a0d933703532",
                                "text": "Frau Herdtle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a2dcd3f2-6951-4a16-8200-235ccf73a321",
                                "sense_id": "2a7167a1-ef87-303a-aa4a-a0d933703532",
                                "text": "Der Herdtle trägt nie die Schals, die die Herdtle ihm strickt."
                            },
                            {
                                "example_id": "2b2505e8-0010-499b-afc3-cff438968175",
                                "sense_id": "2a7167a1-ef87-303a-aa4a-a0d933703532",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Herdtle kommt, geht der Herr Herdtle.“"
                            },
                            {
                                "example_id": "2c70fac9-c795-4dd2-b5b2-245d6d059c08",
                                "sense_id": "2a7167a1-ef87-303a-aa4a-a0d933703532",
                                "text": "Herdtle kommt und geht."
                            },
                            {
                                "example_id": "9980b98a-640e-48fe-a08b-3f70719f5a32",
                                "sense_id": "2a7167a1-ef87-303a-aa4a-a0d933703532",
                                "text": "Herdtles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
