                "senses": [
                    {
                        "sense_id": "a606bdca-1955-36d1-b8b2-87953860ee7a",
                        "entry_id": "c5390c69-2d57-3fa2-a232-da007ad2790a",
                        "glosses": [
                            "Betrieb, der Kleidung verkauft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d4102a0-cea3-458f-8d1a-352fc4b35851",
                                "sense_id": "a606bdca-1955-36d1-b8b2-87953860ee7a",
                                "text": "„Nachdem sie das riesige Bekleidungsgeschäft hinter sich gelassen hatte, in dem alles nur ein paar Euro kostete, bog sie links ab.“"
                            },
                            {
                                "example_id": "02ac6208-b4a8-42c0-be9a-f2dc41fd3b77",
                                "sense_id": "a606bdca-1955-36d1-b8b2-87953860ee7a",
                                "text": "„Wir standen in einem Bekleidungsgeschäft, Musik dröhnte aus den Lautsprechern und die Luft war erfüllt vom Geruch nach Plastik und gefärbten Stoffen und Schweiß, als wir zu den Umkleiden gingen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67710b2d-6e5e-4c07-aa02-3a0585bbc1f8",
                        "source_entry_id": "c5390c69-2d57-3fa2-a232-da007ad2790a",
                        "source_sense_id": "a606bdca-1955-36d1-b8b2-87953860ee7a",
                        "source_sense_description": "Betrieb, der Kleidung verkauft",
                        "target_lang_word": "magasin de vêtements",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magasin de vêtements",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "122af8e6-8ea1-3b36-84e8-727da6adebb5",
                                        "entry_id": "c4b6fd43-bcec-3fbf-ae07-e0e57f81f8e5",
                                        "glosses": [
                                            "Magasin où l’on vend des articles d’habillement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a627c33a-cbcf-4171-9529-48dca3f8bf13",
                                                "sense_id": "122af8e6-8ea1-3b36-84e8-727da6adebb5",
                                                "text": "À la place de ce café se trouvait jadis une librairie, qui fut remplacée par un magasin de vêtements (on disait de fringues), puis enfin par ce café."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
