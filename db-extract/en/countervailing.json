                        "entry_id": "e3d8a92f-49c0-33b6-a95c-728384c4d0ae",
                        "glosses": [
                            "Compensating with equal force."
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "6c444dd8-7850-4e49-b2b0-01b727b3ee31",
                                "sense_id": "434c5811-c00d-3885-8d80-03a321375c9d",
                                "text": "countervailing duty"
                            },
                            {
                                "example_id": "bf316893-9b24-4c4d-a4c0-c3c8b6c82bf8",
                                "sense_id": "434c5811-c00d-3885-8d80-03a321375c9d",
                                "text": "For every attribute that encourages diversity and decentralization on the Web, there is a countervailing push toward homogeneity and concentration."
                            },
                            {
                                "example_id": "e5f5bd3b-deb4-46e6-b321-473645ba10b3",
                                "sense_id": "434c5811-c00d-3885-8d80-03a321375c9d",
                                "text": "We need countervailing action soon. Every day brings evidence that the mere prospect of Brexit is damaging a British economy that is in enough trouble already."
                            },
                            {
                                "example_id": "28085d71-dc52-48a7-9e72-f6aa98326bad",
                                "sense_id": "434c5811-c00d-3885-8d80-03a321375c9d",
                                "text": "Trump, Kayleigh McEnany said, “makes hiring decisions based on the fact that he likes to have countervailing viewpoints … he likes the model of having a ‘team of rivals’ like what we saw in President Lincoln’s administration”."
                            }
                        ]
                    }
