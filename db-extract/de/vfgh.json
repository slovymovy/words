                "word": "VfGH",
                "pos": "abbrev",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5bab2e74-b306-3fa0-bbf4-ed763beb18d1",
                        "entry_id": "155867a5-2c5c-3d44-8173-6cc5ed4d9ec3",
                        "glosses": [
                            "Österreichischer Verfassungsgerichtshof mit Sitz in Wien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aab91b3b-362e-4f44-a5f2-8116a68dd0e3",
                                "sense_id": "5bab2e74-b306-3fa0-bbf4-ed763beb18d1",
                                "text": "Wie Verfassungsgerichte grundsätzlich, so erfüllt auch der österreichische Verfassungsgerichtshof (VfGH) eine politische Funktion."
                            },
                            {
                                "example_id": "314eb52b-33ae-45c7-a954-f5b26b7b752f",
                                "sense_id": "5bab2e74-b306-3fa0-bbf4-ed763beb18d1",
                                "text": "Von den verschiedenen Arten möglicher Verfahren vor dem Verfassungsgerichtshof (VfGH) sind es vor allem drei, die für den Einzelnen bedeutsam sein können, nämlich Verfahren hinsichtlich bestimmter vermögensrechtlicher Ansprüche, Normenkontrollverfahren sowie Entscheidungsbeschwerden (Erkenntnis- und Beschlussbeschwerdeverfahren)."
                            },
                            {
                                "example_id": "4fdf9215-69a1-434d-8fab-705ce01b95d6",
                                "sense_id": "5bab2e74-b306-3fa0-bbf4-ed763beb18d1",
                                "text": "Anlass für das Prüfungsverfahren des Verfassungsgerichtshofes (VfGH) waren Verkäufe von Grundstücken aus dem Bestand der ehemaligen Bundesforste."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
