                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "421d8aa3-23ee-32af-ae26-f093bc1d3eb3",
                "word": "Nuxalk",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5a247dd2-7359-3a78-8d5e-0a908ab25671",
                        "entry_id": "421d8aa3-23ee-32af-ae26-f093bc1d3eb3",
                        "glosses": [
                            "Première Nation de Colombie-Britannique au Canada."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84414e42-7a23-4d57-9acf-429697eb4d23",
                                "sense_id": "5a247dd2-7359-3a78-8d5e-0a908ab25671",
                                "text": "L’été dernier, un accord historique a été signé entre le gouvernement et deux nations autochtones de la région, Kitasoo/Xai’xais et Nuxalk, pour gratifier leurs gardiens des mêmes pouvoirs que les agents des parcs provinciaux; une première en Colombie-Britannique."
                            },
                            {
                                "example_id": "c2b95bd2-1d19-4fd7-9a1b-8472ddf6e26e",
                                "sense_id": "5a247dd2-7359-3a78-8d5e-0a908ab25671",
                                "text": "L'honorable John Duncan, ministre des Affaires autochtones et du développement du Nord canadien, a félicité la Nation des Nuxalk pour les travaux de rénovation majeurs exécutés à l'école Acwsalcta. Ce projet a été réalisé grâce à un investissement de 8,4 millions de dollars du Plan d'action économique du Canada (PAEC) ."
                            }
                        ]
                    }
                ],
