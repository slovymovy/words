    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "98e6135f-5ef4-3618-985b-b15b6aaf479d",
                    "sense_definition": "Приводить в круговое движение вокруг оси или центра.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "вращение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мальчик сидел на скамейке и долго <w>вертел</w> в руках блестящую монету.",
                            "target_lang_translations": {
                                "en": "The boy sat on the bench and <w>twirled</w> a shiny coin in his hands for a long time."
                            }
                        },
                        {
                            "text": "Механик начал медленно <w>вертеть</w> ручку старого прибора, проверяя его работу.",
                            "target_lang_translations": {
                                "en": "The mechanic began to slowly <w>turn</w> the handle of the old device, checking its operation."
                            }
                        }
                    ],
                    "synonyms": [
                        "вращать",
                        "крутить"
                    ],
                    "common_phrases": [
                        "вертеть ручку",
                        "вертеть в руках"
                    ],
                    "target_lang_definitions": {
                        "en": "To cause something to rotate around an axis or center; to spin or turn something around in one's hands."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "twirl",
                                "target_lang_sense_clarification": "spin or turn an object around lightly"
                            },
                            {
                                "target_lang_word": "turn",
                                "target_lang_sense_clarification": "rotate a handle, knob, or object"
                            },
                            {
                                "target_lang_word": "spin",
                                "target_lang_sense_clarification": "rotate something rapidly or continuously"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f22221a7-9925-3d00-9bfa-ac0465cb74df",
                    "sense_definition": "Поворачивать в разные стороны, шевелить из стороны в сторону.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "вращение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Перестань постоянно <w>вертеть</w> головой во время урока и слушай учителя.",
                            "target_lang_translations": {
                                "en": "Stop constantly <w>turning</w> your head around during the lesson and listen to the teacher."
                            }
                        },
                        {
                            "text": "Собака радостно <w>вертела</w> хвостом при виде своего вернувшегося хозяина.",
                            "target_lang_translations": {
                                "en": "The dog happily <w>wagged</w> its tail at the sight of its returned owner."
                            }
                        }
                    ],
                    "synonyms": [
                        "крутить"
                    ],
                    "common_phrases": [
                        "вертеть головой",
                        "вертеть хвостом"
                    ],
                    "target_lang_definitions": {
                        "en": "To turn in various directions or move from side to side repeatedly."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "turn",
                                "target_lang_sense_clarification": "look or move one's head around"
                            },
                            {
                                "target_lang_word": "wag",
                                "target_lang_sense_clarification": "move a tail back and forth"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae577ab4-1850-33c0-97d9-19a2a0616530",
                    "sense_definition": "Оказывать сильное влияние, полностью подчинять кого-либо своей воле.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "манипуляция",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она умеет ловко <w>вертеть</w> людьми и всегда добивается желаемого результата.",
                            "target_lang_translations": {
                                "en": "She knows how to skillfully <w>manipulate</w> people and always achieves the desired result."
                            }
                        },
                        {
                            "text": "Этот хитрый чиновник привык <w>вертеть</w> своими наивными помощниками как вздумается.",
                            "target_lang_translations": {
                                "en": "This cunning official was used to <w>twisting</w> his naive assistants <w>around his little finger</w> as he pleased."
                            }
                        }
                    ],
                    "synonyms": [
                        "крутить"
                    ],
                    "common_phrases": [
                        "вертеть как хочет",
                        "вертеть людьми"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "переносное значение"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To manipulate or exert complete control over someone; to bend to one's will."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "manipulate",
                                "target_lang_sense_clarification": "control someone skillfully or deviously"
                            },
                            {
                                "target_lang_word": "twist around one's finger",
                                "target_lang_sense_clarification": "have complete control over someone"
                            },
                            {
                                "target_lang_word": "wind",
                                "target_lang_sense_clarification": "direct or govern someone at one's pleasure"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f5b56fbd-8c33-34df-a60e-55e06dae42d3",
                    "sense_definition": "Делать отверстия с помощью бурава, сверла; сверлить.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Старый плотник привычно <w>вертел</w> дыры в толстых сосновых досках буравом.",
                            "target_lang_translations": {
                                "en": "The old carpenter habitually <w>bored</w> holes in the thick pine boards with an auger."
                            }
                        },
                        {
                            "text": "Мастер долго <w>вертел</w> отверстие в дубовой балке перед установкой замка.",
                            "target_lang_translations": {
                                "en": "The craftsman took a long time <w>drilling</w> an opening in the oak beam before installing the lock."
                            }
                        }
                    ],
                    "common_phrases": [
                        "вертеть дыры"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "просторечное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To make holes using an auger, gimlet, or drill; to bore."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bore",
                                "target_lang_sense_clarification": "make a hole with a revolving tool"
                            },
                            {
                                "target_lang_word": "drill",
                                "target_lang_sense_clarification": "make holes in material"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}