        "fr-extract.jsonl": [
            {
                "entry_id": "83325727-8f01-37da-bfbe-2de017b3593d",
                "word": "mauviette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dd9b13a1-fd9e-41dc-b65a-769497a27dee",
                        "entry_id": "83325727-8f01-37da-bfbe-2de017b3593d",
                        "tags": [
                            "plural"
                        ],
                        "form": "mauviettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "11e125ad-5305-3dad-bea9-7c1d73664ac7",
                        "entry_id": "83325727-8f01-37da-bfbe-2de017b3593d",
                        "glosses": [
                            "Espèce d’alouette : l’alouette commune (Alauda arvensis)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10917946-b811-406a-ac67-fe61bb7e99e8",
                                "sense_id": "11e125ad-5305-3dad-bea9-7c1d73664ac7",
                                "text": "Ah ! si de cette fenêtre, où grésille une lumière, était seulement tombée dans la corne de mon feutre une mauviette rôtie au lieu de cette fleur fanée."
                            },
                            {
                                "example_id": "39e8a45d-c316-4b3e-af00-754c229f2a42",
                                "sense_id": "11e125ad-5305-3dad-bea9-7c1d73664ac7",
                                "text": "Pâté de mauviette, brochettes de mauviette."
                            },
                            {
                                "example_id": "0b8a8740-2532-4e62-b861-595d0ef48b30",
                                "sense_id": "11e125ad-5305-3dad-bea9-7c1d73664ac7",
                                "text": "D’ailleurs, est-ce qu’un homme aurait voulu d’elle, sans un sou, pas plus grosse qu’une mauviette."
                            }
                        ]
                    },
                    {
                        "sense_id": "df8b14af-f444-34e0-97aa-b76821edec9c",
                        "entry_id": "83325727-8f01-37da-bfbe-2de017b3593d",
                        "glosses": [
                            "voire Personne grêle, fragile, ou d’un naturel peureux."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "6441b793-dadf-4385-842e-9dd7f2a23d44",
                                "sense_id": "df8b14af-f444-34e0-97aa-b76821edec9c",
                                "text": "Le fait est que le petit Chose était ridiculement petit ; et puis, l’air si jeune, si mauviette !…"
                            },
                            {
                                "example_id": "1c4ce6f4-6bc4-4e21-904c-a9ea42d0f360",
                                "sense_id": "df8b14af-f444-34e0-97aa-b76821edec9c",
                                "text": "Je suis plutôt pas la mauviette, mais ce truc-là me rend presque malade."
                            },
                            {
                                "example_id": "829eae0b-0200-4bde-b099-cf4db9709165",
                                "sense_id": "df8b14af-f444-34e0-97aa-b76821edec9c",
                                "text": "« … et tu n’as rien, tu n’es pas malade, tu te laisses aller comme un bébé, une vraie mauviette… à onze ans ne pas pouvoir se dominer à ce point, c’est honteux. C’est la dernière fois que tu as été au cinéma… »"
                            },
                            {
                                "example_id": "bd918aca-cbb9-48f4-8001-816e6ba08d3a",
                                "sense_id": "df8b14af-f444-34e0-97aa-b76821edec9c",
                                "text": "— Personne ne me traite de mauviette."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6494cc95-4e9c-43fd-8c11-471eb1e49b6e",
                        "source_entry_id": "83325727-8f01-37da-bfbe-2de017b3593d",
                        "source_sense_description": "Personne grêle",
                        "target_lang_word": "Schwächling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwächling",
                                "target_lang_code": "de",
