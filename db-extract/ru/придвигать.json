                            {
                                "example_id": "f34d3b24-1331-4f0a-b63a-6bd1ae784955",
                                "sense_id": "7e3f08ba-c392-3831-9912-75dc73ad487e",
                                "text": "Бедному Ионису приходилось теперь палкой придвигать еду, которую он приносил мне и львёнку."
                            },
                            {
                                "example_id": "028de196-00be-49d5-a232-44b17b95c939",
                                "sense_id": "7e3f08ba-c392-3831-9912-75dc73ad487e",
                                "text": "Кресло я, конечно, придвигать не стал, не до того."
                            }
                        ]
                    },
