                                        "examples": [
                                            {
                                                "example_id": "2861fe26-92ba-415c-9ee3-4eeeff42cbec",
                                                "sense_id": "1dfa1d8f-0abb-36e4-b04a-4016f1d013fd",
                                                "text": "Als die Zeit herum war, konnten wir uns umziehen und nach Haus fahren."
                                            },
