                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "8f7827a3-ad67-454d-b3eb-147e0c9a291c",
                                "sense_id": "133ef80f-3c94-3cc0-b3d8-221455002164",
                                "text": "Hij was gekleed in een uniform met de aanduidingen van de SOE en de rang van sergeant, gedoucht en geschoren toen hij op de afrondende afspraak verscheen met kolonel Grumpy, zoals iedereen de chef noemde, en zijn twee assistenten."
                            }
                        ]
                    },
                    {
                        "sense_id": "55a84525-b21e-39ee-942f-9bc5dc45ae1b",
                        "entry_id": "56348806-3f52-3b2a-ad17-f69ac713051d",
                        "glosses": [
                            "lijmklem, verbastering van het Franse serre-joint."
                        ],
                        "tags": [],
                        "examples": []
                    }
