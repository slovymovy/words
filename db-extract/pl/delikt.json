                    {
                        "translation_id": "4cc96963-8ada-4c93-a789-be9fd9f0dc56",
                        "source_entry_id": "2aac32df-6775-3ab2-a589-6f103e47c182",
                        "source_sense_id": "44ab64ee-1637-36c1-a8d0-5512f8786fd6",
                        "target_lang_word": "délit",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "délit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dc785e74-6f03-36b6-b8f6-e672c6885bcb",
                                        "entry_id": "5498cff8-dcb9-385b-830b-669104ab4c53",
                                        "glosses": [
                                            "Toute infraction, consciente ou non, aux lois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd21778f-19cc-42bc-8705-32e3d98d1ec5",
                                                "sense_id": "dc785e74-6f03-36b6-b8f6-e672c6885bcb",
                                                "text": "Commettre un délit."
                                            },
                                            {
                                                "example_id": "32bea161-27c5-437c-bd6d-53fc99b70a66",
                                                "sense_id": "dc785e74-6f03-36b6-b8f6-e672c6885bcb",
                                                "text": "La peine n’était pas proportionnée au délit."
                                            },
                                            {
                                                "example_id": "38930c1f-3729-462f-aa0c-8972393d22c9",
                                                "sense_id": "dc785e74-6f03-36b6-b8f6-e672c6885bcb",
                                                "text": "Prendre quelqu’un en flagrant délit."
                                            },
                                            {
                                                "example_id": "5f844f11-e041-4ee9-83cb-93143515ae07",
                                                "sense_id": "dc785e74-6f03-36b6-b8f6-e672c6885bcb",
                                                "text": "Corps du délit. Voyez « corps »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dad42ffa-2a0e-3066-a4cb-8fe0300a0490",
                                        "entry_id": "5498cff8-dcb9-385b-830b-669104ab4c53",
                                        "glosses": [
                                            "Infraction que la loi punit de peines correctionnelles."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "082c046d-1671-47d7-99ee-179947a3d84e",
                                                "sense_id": "dad42ffa-2a0e-3066-a4cb-8fe0300a0490",
                                                "text": "Individuellement ou en \"petty sessions\", les Magistrats procèdent à la recherche, dans leur voisinage, des contraventions, délits et crimes de toute espèce."
                                            },
                                            {
                                                "example_id": "9fa68e61-2db6-4b88-8226-1a11b02f7165",
                                                "sense_id": "dad42ffa-2a0e-3066-a4cb-8fe0300a0490",
                                                "text": "Mais le chantage est un délit, Monsieur le juge. Il faut l'établir."
                                            },
