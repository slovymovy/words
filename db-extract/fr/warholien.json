                        "entry_id": "58a2f248-dea1-32c9-9bb1-7c5bf0af0a70",
                        "glosses": [
                            "Relatif à Andy Warhol, à son travail, à son style."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "446ef629-eb91-495c-b14a-a330a53f15be",
                                "sense_id": "0536d94d-2d71-3f64-acc5-d66740c5085e",
                                "text": "Les lieux Etagi, Tchaki, Arkhitektor, Pechatny Dvor, comptent parmi ces « multispaces » qui conjuguent l’esprit Factory warholienne et la tendance « social network »."
                            },
                            {
                                "example_id": "37d87f19-4e46-434c-bf97-0ae6b63767f4",
                                "sense_id": "0536d94d-2d71-3f64-acc5-d66740c5085e",
                                "text": "Nos ambitions se réduisaient au quart d’heure de gloire warholien, un éphémère, et puis s’en va. Avec les autres époques, nous avions le sentiment de ne plus tenir la comparaison."
                            }
                        ]
                    }
