{
    "word_family": [
        "forbearance",
        "forbearing"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6608cf20-453d-34c0-9e73-6c564df2b87a",
                    "sense_definition": "To choose not to do something or to avoid an action.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "abstain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>forbore</w> to mention the mistake because I did not want to embarrass my colleague.",
                            "target_lang_translations": {
                                "de": "Ich <w>unterließ</w> es, den Fehler zu erwähnen, weil ich meinen Kollegen nicht in Verlegenheit bringen wollte."
                            }
                        },
                        {
                            "text": "The committee decided to <w>forbear</w> from making any final decisions until the investigation was complete.",
                            "target_lang_translations": {
                                "de": "Der Ausschuss beschloss, sich endgültiger Entscheidungen <w>zu enthalten</w>, bis die Untersuchung abgeschlossen war."
                            }
                        }
                    ],
                    "synonyms": [
                        "abstain",
                        "refrain",
                        "avoid"
                    ],
                    "antonyms": [
                        "indulge"
                    ],
                    "common_phrases": [
                        "forbear from"
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas bewusst nicht tun oder eine Handlung unterlassen; sich einer Sache enthalten."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "unterlassen",
                                "target_lang_sense_clarification": "eine Handlung nicht ausführen"
                            },
                            {
                                "target_lang_word": "sich enthalten",
                                "target_lang_sense_clarification": "auf etwas verzichten, etw. nicht tun"
                            },
                            {
                                "target_lang_word": "verzichten",
                                "target_lang_sense_clarification": "von einer Handlung absehen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0ffd80d-6ad8-3c2a-8ffc-e1cff54df43d",
                    "sense_definition": "To remain patient and calm when someone has annoyed or provoked you.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "abstain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Even when the customer was rude, the clerk managed to <w>forbear</w> and remained professional.",
                            "target_lang_translations": {
                                "de": "Selbst als der Kunde unhöflich war, gelang es dem Angestellten, <w>Nachsicht zu üben</w> und professionell zu bleiben."
                            }
                        },
                        {
                            "text": "It takes great strength of character to <w>forbear</w> when you are being treated unfairly.",
                            "target_lang_translations": {
                                "de": "Es erfordert große Charakterstärke, <w>sich zu beherrschen</w>, wenn man ungerecht behandelt wird."
                            }
                        }
                    ],
                    "synonyms": [
                        "endure",
                        "tolerate"
                    ],
                    "target_lang_definitions": {
                        "de": "Geduldig und ruhig bleiben, wenn man verärgert oder provoziert wird; Nachsicht üben."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Nachsicht üben",
                                "target_lang_sense_clarification": "geduldig oder nachsichtig bleiben"
                            },
                            {
                                "target_lang_word": "sich beherrschen",
                                "target_lang_sense_clarification": "die Ruhe bewahren und nicht aufbrausen"
                            },
                            {
                                "target_lang_word": "Geduld haben",
                                "target_lang_sense_clarification": "ruhig und gelassen ausharren"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "deac2cae-2e4b-3524-8d96-5066dc6f2857",
                    "sense_definition": "To pause or wait before taking action.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pause",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge asked the lawyers to <w>forbear</w> for a moment while he reviewed the evidence.",
                            "target_lang_translations": {
                                "de": "Der Richter bat die Anwälte, einen Moment <w>innezuhalten</w>, während er die Beweise prüfte."
                            }
                        },
                        {
                            "text": "We must <w>forbear</w> until we have all the necessary information to proceed safely.",
                            "target_lang_translations": {
                                "de": "Wir müssen <w>abwarten</w>, bis wir alle notwendigen Informationen haben, um sicher fortzufahren."
                            }
                        }
                    ],
                    "synonyms": [
                        "pause",
                        "hesitate"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely literary or archaic."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Innehalten oder abwarten, bevor man handelt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "innehalten",
                                "target_lang_sense_clarification": "im Tun pausieren"
                            },
                            {
                                "target_lang_word": "abwarten",
                                "target_lang_sense_clarification": "mit der Handlung zögern bzw. warten"
                            },
                            {
                                "target_lang_word": "zögern",
                                "target_lang_sense_clarification": "eine Weile warten, unschlüssig pausieren"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5159085-47f1-3786-a792-163dfc9c7afb",
                    "sense_definition": "To refuse or decline to listen or comply.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "refuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stubborn child would <w>forbear</w> to follow the instructions given by his teacher.",
                            "target_lang_translations": {
                                "de": "Das starrsinnige Kind <w>weigerte sich</w>, den Anweisungen seiner Lehrerin zu folgen."
                            }
                        },
                        {
                            "text": "They chose to <w>forbear</w> the offer, preferring to find their own way forward.",
                            "target_lang_translations": {
                                "de": "Sie entschieden sich dafür, das Angebot <w>abzulehnen</w>, und zogen es vor, ihren eigenen Weg zu gehen."
                            }
                        }
                    ],
                    "synonyms": [
                        "decline",
                        "refuse"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is archaic."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Sich weigern oder ablehnen, zuzuhören oder einer Anweisung zu folgen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "sich weigern",
                                "target_lang_sense_clarification": "etwas nicht befolgen wollen"
                            },
                            {
                                "target_lang_word": "ablehnen",
                                "target_lang_sense_clarification": "etwas zurückweisen oder nicht annehmen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dc39c386-842c-358c-aca8-7900ba82a5d5",
                    "sense_definition": "An ancestor or forefather.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt a deep connection to the land where his <w>forbears</w> had lived for centuries.",
                            "target_lang_translations": {
                                "de": "Er spürte eine tiefe Verbundenheit mit dem Land, auf dem seine <w>Vorfahren</w> jahrhundertelang gelebt hatten."
                            }
                        },
                        {
                            "text": "The family history book detailed the lives of his <w>forbears</w> dating back to the seventeenth century.",
                            "target_lang_translations": {
                                "de": "Das Familienbuch beschrieb das Leben seiner <w>Ahnen</w> bis zurück ins siebzehnte Jahrhundert."
                            }
                        }
                    ],
                    "synonyms": [
                        "ancestor",
                        "forefather"
                    ],
                    "antonyms": [
                        "descendant"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This is a less common spelling of forebear."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Person, von der man in direkter Linie abstammt; Vorfahre."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Vorfahr",
                                "target_lang_sense_clarification": "Vorfahre einer Person oder Familie"
                            },
                            {
                                "target_lang_word": "Ahn",
                                "target_lang_sense_clarification": "gehoben oder literarisch für Vorfahre"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}