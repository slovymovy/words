    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "327d1d6f-1d42-3d00-94db-04c3d66f3bc5",
                    "sense_definition": "zginać coś płaskiego lub wiotkiego, aby zmniejszyć powierzchnię",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "zginanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musisz starannie <w>złożyć</w> tę kartkę na pół, aby zmieściła się do koperty.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно аккуратно <w>сложить</w> этот листок пополам, чтобы он поместился в конверт."
                            }
                        },
                        {
                            "text": "Po prasowaniu dokładnie <w>złożył</w> koszulę i włożył ją do szafy.",
                            "target_lang_translations": {
                                "ru": "После глажки он аккуратно <w>сложил</w> рубашку и убрал её в шкаф."
                            }
                        }
                    ],
                    "common_phrases": [
                        "złożyć na pół",
                        "złożyć w kostkę"
                    ],
                    "target_lang_definitions": {
                        "ru": "согнуть или свернуть что-либо плоское или мягкое, чтобы уменьшить размер"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сложить",
                                "target_lang_sense_clarification": "бумагу, одежду, ткань"
                            },
                            {
                                "target_lang_word": "согнуть",
                                "target_lang_sense_clarification": "пополам или в несколько раз"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ddbc434-d075-3949-9af6-dfbb428447ac",
                    "sense_definition": "łączyć poszczególne elementy w jedną całość",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "montowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój brat bez problemu sam <w>złożył</w> nowe biurko według instrukcji.",
                            "target_lang_translations": {
                                "ru": "Мой брат без проблем сам <w>собрал</w> новый письменный стол по инструкции."
                            }
                        },
                        {
                            "text": "Dzieci wspólnie <w>złożyły</w> duży model samolotu z małych klocków.",
                            "target_lang_translations": {
                                "ru": "Дети вместе <w>собрали</w> большую модель самолёта из мелких деталей конструктора."
                            }
                        }
                    ],
                    "common_phrases": [
                        "złożyć meble",
                        "złożyć komputer"
                    ],
                    "target_lang_definitions": {
                        "ru": "соединить отдельные части или детали в единое целое"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "собрать",
                                "target_lang_sense_clarification": "мебель, конструктор, компьютер"
                            },
                            {
                                "target_lang_word": "смонтировать",
                                "target_lang_sense_clarification": "конструкцию, механизм"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "070ddade-769c-3414-b032-27200f94c9b4",
                    "sense_definition": "oficjalnie przekazać dokument, wniosek lub oświadczenie",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "oficjalne_przekazanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musimy jak najszybciej <w>złożyć</w> wniosek o nowy dowód osobisty w urzędzie.",
                            "target_lang_translations": {
                                "ru": "Нам нужно как можно скорее <w>подать</w> заявление на получение нового удостоверения личности в ведомство."
                            }
                        },
                        {
                            "text": "Podania należy <w>złożyć</w> osobiście w dziekanacie przed końcem miesiąca.",
                            "target_lang_translations": {
                                "ru": "Заявления необходимо <w>подать</w> лично в деканат до конца месяца."
                            }
                        }
