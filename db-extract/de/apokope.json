                    {
                        "translation_id": "6928ad85-d38c-4a7f-b35a-8f51549c2d9d",
                        "source_entry_id": "40cd286e-d595-3466-95b2-2d15f0f5aa4a",
                        "source_sense_id": "dcb65fa1-06af-371d-93a8-6f7725aec26a",
                        "source_sense_description": "Wegfall eines oder mehrerer Laute oder auch einer Silbe am Wortende",
                        "target_lang_word": "apocope",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apocope",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "406c4dd9-cad6-3dec-8bed-523b3c2fe542",
                                        "entry_id": "518a151b-cc9b-31e3-a412-31c6009c4b92",
                                        "glosses": [
                                            "Élision d’un ou plusieurs phonèmes en fin de mot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33b52700-1969-4ac5-9f20-bcf6b77b4737",
                                                "sense_id": "406c4dd9-cad6-3dec-8bed-523b3c2fe542",
                                                "text": "Les mots ciné et cinéma sont formés par apocope à partir du mot cinématographe."
                                            },
                                            {
                                                "example_id": "ded849e6-6e55-4e45-b4a4-d68f7e5dabe8",
                                                "sense_id": "406c4dd9-cad6-3dec-8bed-523b3c2fe542",
                                                "text": "Autre apocope non moins inadmissible : ru pour ruisseau."
                                            },
                                            {
                                                "example_id": "6ca567c8-81d6-480d-816c-8b6f073db7ca",
                                                "sense_id": "406c4dd9-cad6-3dec-8bed-523b3c2fe542",
                                                "text": "Toutes ces questions sont autant d’invitations à reposer le problème de l’apocope verbale et de l’apocope vocalique en général."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "482272da-e2e9-3d4f-a1a0-0c5b25bf6c5e",
                                        "entry_id": "518a151b-cc9b-31e3-a412-31c6009c4b92",
                                        "glosses": [
                                            "Élision d’un ou plusieurs phonèmes en fin de mot.",
                                            "Résultat de cette élision."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "405f34d0-8ccc-4a78-9c54-eff581ab6669",
                                                "sense_id": "482272da-e2e9-3d4f-a1a0-0c5b25bf6c5e",
                                                "text": "Si bien que, gavé d’informations tant sur le patois taafien constitué d’abréviations reposantes, d’apocopes imprévisibles, d’aphérèses inattendues et de métonymies subtiles - OP pour opération portuaire, DZ pour drop zone, bib pour médecin, bout de bois pour menuisier, pimponker pour pompier, etc., j’en passe et des meilleures - que sur le décor de mon futur séjour, j’ai fini par me demander pourquoi diable me donner le mal (de mer) d’y aller, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb0c0d2e-e6d9-3b46-ad10-fb7e2898478f",
                                        "entry_id": "518a151b-cc9b-31e3-a412-31c6009c4b92",
                                        "glosses": [
                                            "Élision d’un ou plusieurs phonèmes en fin de mot.",
                                            "Disparition en fin de mot d’un e caduc non élidable, pour gagner une syllabe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25e99e15-4022-4b90-a305-1c90471e7533",
                                                "sense_id": "fb0c0d2e-e6d9-3b46-ad10-fb7e2898478f",
                                                "text": "Les problèmes de l’apocope et de la syncope ne sont pas propres à la scansion réaliste du vers moderne."
                                            }
                                        ]
                                    }
                                ]
                            },
