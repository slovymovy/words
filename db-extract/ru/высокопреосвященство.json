                    {
                        "translation_id": "01571ac6-01aa-4e02-a238-5cef5613ad23",
                        "source_entry_id": "8a3dc285-01b1-3be0-94d3-2a0d1ad5eb46",
                        "source_sense_id": "4ef19498-92f5-38d7-897e-196238582712",
                        "target_lang_word": "Eminenz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eminenz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cbf479f5-d096-3e12-a5d4-53e8564eff5e",
                                        "entry_id": "e3615bf1-6e6f-3be7-8b87-1f874dbdf005",
                                        "glosses": [
                                            "Würdentitel und protokollarische Anrede der Kardinäle der römisch-katholischen Kirche und altorientalischer Bischöfe; Anrede als Seine Eminenz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03ecac41-d429-4ad1-bcdb-112f4dbc8e17",
                                                "sense_id": "cbf479f5-d096-3e12-a5d4-53e8564eff5e",
                                                "text": "Seine Eminenz Walter Kardinal Kasper bekam den Ehrendoktor verliehen."
                                            },
                                            {
                                                "example_id": "6319b77d-b492-49c9-ba45-b857770e24a9",
                                                "sense_id": "cbf479f5-d096-3e12-a5d4-53e8564eff5e",
                                                "text": "„Seine Eminenz speiste allein mit mir und gab sich betont gütig; ich legte die größte Befriedigung an den Tag, denn meine Eigenliebe war stärker als mein Kummer und erlaubte mir nicht, den Beobachtern den geringsten Grund zur Annahme zu geben, ich sei in Ungnade gefallen.“"
                                            },
                                            {
                                                "example_id": "b9adf0e7-3808-456e-a5c8-9dcf97d5caf1",
                                                "sense_id": "cbf479f5-d096-3e12-a5d4-53e8564eff5e",
                                                "text": "„Bei feierlichen Anlässen, zum Beispiel in der Universität der früheren Bundeshauptstadt Bonn, waren neben anderen Würdenträgern häufig Eminenzen, Exzellenzen und Magnifizenzen zu begrüßen, vielfach auch mit Namensnennung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2b5e6d9c-b913-31e3-8a47-0bb8a16ac947",
                                        "entry_id": "e3615bf1-6e6f-3be7-8b87-1f874dbdf005",
                                        "glosses": [
                                            "eine solche Person, Kardinal"
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d70a39e6-a670-4603-96e2-6bde3f5532ba",
                                                "sense_id": "2b5e6d9c-b913-31e3-8a47-0bb8a16ac947",
                                                "text": "„Dann fing der Papst an, die Zeremonie der liturgischen Gebete zu halten, an denen einige der Eminenzen und Exzellenzen teilnahmen, Papst Schenouda hielt ein Wort zum Trost unter den Tränen des Volkes, Männer und Frauen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3385d703-98bc-4a19-aee5-8e512f5eb620",
                        "source_entry_id": "8a3dc285-01b1-3be0-94d3-2a0d1ad5eb46",
                        "source_sense_id": "4ef19498-92f5-38d7-897e-196238582712",
                        "target_lang_word": "éminence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éminence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9cb60928-ec59-3398-800c-6ac193f08317",
                                        "entry_id": "66a1bd5c-11b5-3040-92ad-956877fd1a5d",
                                        "glosses": [
                                            "Lieu éminent ; monticule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e791602d-c041-4b2e-a5a6-925ad5a6db74",
                                                "sense_id": "9cb60928-ec59-3398-800c-6ac193f08317",
                                                "text": "Des maladies pestilentielles désolaient de plus les Gaulois campés dans des bas-fonds, au milieu d'un cercle d’éminences et sur un terrain brûlant, que tant d'incendies avaient imprégné d'exhalaisons enflammées, et où le moimdre vent les offusquait de poussière et de cendre."
                                            },
                                            {
                                                "example_id": "32018015-c322-42cd-b5ef-70382c86b88b",
                                                "sense_id": "9cb60928-ec59-3398-800c-6ac193f08317",
                                                "text": "Les membres de la commission furent logés à l’établissement des missionnaires, vaste case proprement bâtie sur une éminence."
                                            },
                                            {
                                                "example_id": "62717e94-46b2-4862-be4e-8fcdd8e766f9",
                                                "sense_id": "9cb60928-ec59-3398-800c-6ac193f08317",
                                                "text": "Le 22 janvier 1793, vers huit heures du soir, une vieille dame descendait, à Paris, l’éminence rapide qui finit devant l’église Saint-Laurent, dans le faubourg Saint-Martin."
                                            },
                                            {
                                                "example_id": "6b42e520-d6ee-49f3-b6da-035a8411dce4",
                                                "sense_id": "9cb60928-ec59-3398-800c-6ac193f08317",
                                                "text": "Une grande pierre avait seule glissé jusqu’à la base de l’éminence."
                                            },
                                            {
                                                "example_id": "5f684e0f-1349-432e-bbee-dd425eea5cc6",
                                                "sense_id": "9cb60928-ec59-3398-800c-6ac193f08317",
                                                "text": "Peu avant de parvenir au village de Champion, la grande route de Namur à Louvain gravit, en quittant la ferme dite de Ponty ou des Pauvres, une éminence dont le sommet se trouve à quelques pas de la borne kilométrique nᵒ 4."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f9302a8-7906-3021-9662-ca1325d95e31",
                                        "entry_id": "66a1bd5c-11b5-3040-92ad-956877fd1a5d",
                                        "glosses": [
                                            "Saillie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7972a23-c3f2-47e1-ba93-63b248a453f1",
                                                "sense_id": "5f9302a8-7906-3021-9662-ca1325d95e31",
                                                "text": "Les éminences des os."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a3d0ba2-e265-37ff-b822-d08a3f03e8c6",
                                        "entry_id": "66a1bd5c-11b5-3040-92ad-956877fd1a5d",
                                        "glosses": [
                                            "Titre d’honneur qu’on donne aux cardinaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b2390ea-cff5-471e-b13e-06514a5933c5",
                                                "sense_id": "0a3d0ba2-e265-37ff-b822-d08a3f03e8c6",
                                                "text": "Vous avez été choisi, par le comité des professeurs, pour faire le discours latin à Son Éminence. Son Éminence nous honorera de sa visite dans une quinzaine de jours ; tenez-vous prêt."
                                            },
                                            {
                                                "example_id": "32f74f4c-d160-4f71-8ea2-e63dec66c582",
                                                "sense_id": "0a3d0ba2-e265-37ff-b822-d08a3f03e8c6",
                                                "text": "C’est ce que leur ont dit leurs parents\nLe bedeau et même Son Éminence\nL’archiprêtre qui prêche au couvent\nEt c’est pour ça et c’est pour ça qu’elles dansent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
