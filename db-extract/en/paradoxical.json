                                            {
                                                "example_id": "8a06099c-47a1-4204-9f0f-85594a15570c",
                                                "sense_id": "32954c6c-7baa-3ef2-a8b3-d54873a1c2ed",
                                                "text": "Dat is een paradoxaal verschijnsel."
                                            }
