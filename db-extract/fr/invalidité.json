                ],
                "senses": [
                    {
                        "sense_id": "fe07eb27-8588-32fb-ab8f-978fbfa36221",
                        "entry_id": "3bc984f9-2a86-3270-90eb-9aa0487f9623",
                        "glosses": [
                            "Manque de validité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40b1b931-7f74-44ca-ac84-a7d34ca496ab",
                                "sense_id": "fe07eb27-8588-32fb-ab8f-978fbfa36221",
                                "text": "Il démontra l’invalidité de la procédure."
                            },
                            {
                                "example_id": "b4611db6-22b2-45b1-8d0f-70fa354bfdbc",
                                "sense_id": "fe07eb27-8588-32fb-ab8f-978fbfa36221",
                                "text": "L’invalidité d’un contrat, d’un titre."
                            },
                            {
                                "example_id": "091c203c-3eb2-4923-b6a3-85b58f2c3491",
                                "sense_id": "fe07eb27-8588-32fb-ab8f-978fbfa36221",
                                "text": "L’invalidité d’un mariage."
                            }
                        ]
                    },
                    {
                        "sense_id": "9b4b6ca4-7935-3ed4-a9d5-6cda1d56747c",
                        "entry_id": "3bc984f9-2a86-3270-90eb-9aa0487f9623",
                        "glosses": [
                            "Impossibilité de se servir d’un ou de plusieurs membres, insuffisance fonctionnelle d’un ou de plusieurs organes, handicap."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34506340-9524-41db-8183-fa74f990c759",
                                "sense_id": "9b4b6ca4-7935-3ed4-a9d5-6cda1d56747c",
                                "text": "La carte d’invalidité atteste que son détenteur est handicapé."
                            }
                        ]
                    },
                    {
                        "sense_id": "166eb7ef-f74b-3647-b818-d7982a986a85",
                        "entry_id": "3bc984f9-2a86-3270-90eb-9aa0487f9623",
                        "glosses": [
                            "Incapacité de travail résultant de cette impossibilité ou de cette insuffisance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f431d8a-2d22-4cb0-8009-4d57d8e17479",
                                "sense_id": "166eb7ef-f74b-3647-b818-d7982a986a85",
                                "text": "Pension d’invalidité."
                            },
                            {
                                "example_id": "b452f027-e600-4c6e-8b67-ab6241657882",
                                "sense_id": "166eb7ef-f74b-3647-b818-d7982a986a85",
                                "text": "Les pensions reçues pour une invalidité temporaire ou définitive sont imposables."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6d10528-47a5-4d56-956d-61cec3f207df",
                        "source_entry_id": "3bc984f9-2a86-3270-90eb-9aa0487f9623",
                        "source_sense_description": "Manque de validité",
                        "target_lang_word": "Ungültigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ungültigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a5ce0f76-ec91-332e-adb5-339ebb5a8f22",
                                        "entry_id": "652c6c5c-ba0c-30b6-a5a8-4ba938e56916",
                                        "glosses": [
                                            "Eigenschaft, Zustand, nicht gültig zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2acfedf7-43f7-4f64-ae3b-ff75e2b0e4fd",
                                                "sense_id": "a5ce0f76-ec91-332e-adb5-339ebb5a8f22",
                                                "text": "„Das Darmstädter Gericht hatte im wesentlichen drei Tatbestände als Gründe für die Ungültigkeit der Wahl aufgeführt.“"
                                            },
                                            {
                                                "example_id": "1164d589-ac4e-415b-9e2c-bf629fd2c50b",
                                                "sense_id": "a5ce0f76-ec91-332e-adb5-339ebb5a8f22",
                                                "text": "„Bundespräsident Frank-Walter Steinmeier kritisierte: ‚Bisher hat der Oberste Wahlrat keine überzeugenden Gründe genannt, die zu einer Ungültigkeit der Wahlen in Istanbul führen müssen.‘“"
                                            },
                                            {
                                                "example_id": "e16ec85c-4b77-44a9-91b2-b3b5223d7537",
                                                "sense_id": "a5ce0f76-ec91-332e-adb5-339ebb5a8f22",
                                                "text": "„Zusätzliche Bemerkungen sind ohne Bedeutung, führen aber nicht automatisch zur Ungültigkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
