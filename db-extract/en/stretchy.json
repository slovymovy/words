                                            {
                                                "example_id": "bc997883-707e-41c5-b5af-5d1674929aaf",
                                                "sense_id": "8e8c6306-5e9a-3513-b330-48b09e159a0d",
                                                "text": "Wenn der Preis wenig steigt und die Nachfrage dadurch drastisch sinkt, haben wir es mit einer elastischen Nachfrage zu tun."
