                    {
                        "translation_id": "9c976976-8526-4d3d-a154-f34d380d29ad",
                        "source_entry_id": "19ae3697-d0db-3718-bb87-940fde0d353b",
                        "source_sense_id": "37ecfc18-1e23-336f-84c5-e6f62affaddb",
                        "target_lang_word": "ламантин",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ламантин",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "54851390-8356-39fb-9324-7458772b7035",
                                        "entry_id": "1fe21b2f-21e7-3911-85a4-9967c7276d70",
                                        "glosses": [
                                            "зоол. млекопитающее из семейства ламантиновых (лат. Trichechidae, Manatidae)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a777d75-c540-4546-87b5-c18c39cb2e43",
                                                "sense_id": "54851390-8356-39fb-9324-7458772b7035",
                                                "text": "Лишь водные теплокровные млекопитающие, вроде китов, кашалотов, дельфинов, тюленей, моржей, ламантинов, некогда перешедших для жизни с суши в водную среду, сохраняют высокую температуру тела благодаря своим внешним покровам ― толстой коже и толстым слоям подкожного жира."
                                            },
                                            {
                                                "example_id": "da177024-5f9c-4ef4-83cc-03bd7bbf33c5",
                                                "sense_id": "54851390-8356-39fb-9324-7458772b7035",
                                                "text": "Здесь очевидное недоразумение: Стеллер, повидимому, путает морскую корову, встречавшуюся исключительно у берегов Берингова и Медного островов, и открытую моряками Беринговой экспедиции, с другими представителями группы Sirenia ― дюгонем и ламантином, задолго известными до экспедиции Беринга."
                                            },
                                            {
                                                "example_id": "d508672f-6446-4bc3-b4ae-ab4690a9cce4",
                                                "sense_id": "54851390-8356-39fb-9324-7458772b7035",
                                                "text": "Что же касается конкретно легенды о сиренах, то за ними стоят вполне реальные морские животные — дюгони и ламантины (в науке они и в самом деле отнесены к группе сирен)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
