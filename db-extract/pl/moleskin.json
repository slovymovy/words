                    {
                        "translation_id": "76ae0aa3-6236-4bf6-8c72-f58cba5cfcf3",
                        "source_entry_id": "5073bdb6-402b-317d-a7a7-efd70273d54c",
                        "source_sense_id": "85c51fe3-73e5-3d82-9fb5-bb6093d44444",
