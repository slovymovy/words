{
    "word_family": [
        "revamping",
        "revamped",
        "revampment"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2423345f-4acf-35ca-86f9-d8773ee51a74",
                    "sense_definition": "To improve, renew, renovate, or revise something to make it more modern or effective.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "improvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They plan to <w>revamp</w> the historical theater in the old downtown to attract more visitors.",
                            "target_lang_translations": {
                                "ru": "Они планируют <w>обновить</w> исторический театр в старом центре города, чтобы привлечь больше посетителей."
                            }
                        },
                        {
                            "text": "The company decided to <w>revamp</w> the website to provide a better user experience for its customers.",
                            "target_lang_translations": {
                                "ru": "Компания решила <w>модернизировать</w> веб-сайт, чтобы сделать его более удобным для своих клиентов."
                            }
                        }
                    ],
                    "synonyms": [
                        "overhaul",
                        "refurbish",
                        "renovate",
                        "reorganize",
                        "modernize"
                    ],
                    "common_phrases": [
                        "revamp the website",
                        "revamp the image",
                        "revamp the system"
                    ],
                    "target_lang_definitions": {
                        "ru": "Улучшить, обновить, реконструировать или пересмотреть что-либо, чтобы сделать это более современным или эффективным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обновлять",
                                "target_lang_sense_clarification": "делать иным, новым или заменять устаревшее"
                            },
                            {
                                "target_lang_word": "модернизировать",
                                "target_lang_sense_clarification": "усовершенствовать в соответствии с современными требованиями"
                            },
                            {
                                "target_lang_word": "реконструировать",
                                "target_lang_sense_clarification": "коренным образом перестраивать или восстанавливать"
                            },
                            {
                                "target_lang_word": "переделывать",
                                "target_lang_sense_clarification": "изменять с целью улучшения"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2f5f1af0-5b99-3952-a404-70cc6c84c1d5",
                    "sense_definition": "An act of improving, renewing, or revising something; a new and improved version.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "improvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The store's recent <w>revamp</w> has led to a significant increase in weekly sales.",
                            "target_lang_translations": {
                                "ru": "Недавнее <w>обновление</w> магазина привело к значительному росту еженедельных продаж."
                            }
                        },
                        {
                            "text": "After a major <w>revamp</w> of the curriculum, students found the courses much more engaging.",
                            "target_lang_translations": {
                                "ru": "После серьезной <w>переработки</w> учебной программы студенты сочли курсы гораздо более интересными."
                            }
                        }
                    ],
                    "synonyms": [
                        "renovation",
                        "overhaul",
                        "makeover",
                        "reconstruction"
                    ],
                    "common_phrases": [
                        "major revamp",
                        "complete revamp",
                        "undergo a revamp"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт улучшения, обновления или пересмотра чего-либо; новая и улучшенная версия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обновление",
                                "target_lang_sense_clarification": "процесс придания нового вида или замены старого"
                            },
                            {
                                "target_lang_word": "реорганизация",
                                "target_lang_sense_clarification": "изменение структуры или системы"
                            },
                            {
                                "target_lang_word": "модернизация",
                                "target_lang_sense_clarification": "усовершенствование чего-либо"
                            },
                            {
                                "target_lang_word": "переработка",
                                "target_lang_sense_clarification": "существенное изменение или улучшение версии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}