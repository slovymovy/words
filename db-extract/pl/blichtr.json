                        "cross_references": [
                            {
                                "target_word": "glitz",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91ea4dc3-4934-3f52-9a96-4310cc026e53",
                                        "entry_id": "834d43c2-ac50-33aa-a253-1e0813b2e3c4",
                                        "glosses": [
                                            "Garish, brilliant showiness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1375f0f-14d3-4138-b1ee-42bdb9f6b050",
                                                "sense_id": "91ea4dc3-4934-3f52-9a96-4310cc026e53",
                                                "text": "The glitz of the award ceremony was obvious."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "05efd073-43a4-4efb-a1c5-3134969050d9",
                        "source_entry_id": "18723aee-93d7-391b-9697-490b1d76ac16",
                        "source_sense_id": "67c25d37-ad0e-3bd9-9787-42461e7555c3",
                        "target_lang_word": "Flitter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flitter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "343aecc3-c543-38f3-ab3c-1448c0129df2",
                                        "entry_id": "982bfed9-5695-3ac0-8b44-e55a43fc1f3a",
                                        "glosses": [
                                            "ausgestanzte Form aus dünnem Metallblech oder Kunststoff, die der Dekoration dient"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c16b911f-3539-4ed3-8efc-f54eb1720e33",
                                                "sense_id": "343aecc3-c543-38f3-ab3c-1448c0129df2",
                                                "text": "Sein Zylinder war mit unzähligen Flittern geschmückt!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "eeb28638-4b55-339e-b398-77844a03605e",
                                        "entry_id": "982bfed9-5695-3ac0-8b44-e55a43fc1f3a",
                                        "glosses": [
                                            "etwas Schmückendes, das glänzt, aber nutz- und wertlos ist"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d929fb97-bfa8-4536-8a25-2a536dc3bf04",
                                                "sense_id": "eeb28638-4b55-339e-b398-77844a03605e",
                                                "text": "All der Flitter in diesem Haus machte ihn rasend. Er warf ihn hinaus und lebte von da an bescheiden und einfach."
                                            },
                                            {
                                                "example_id": "e571d841-e5c9-40ff-a8ae-115aa27aa978",
                                                "sense_id": "eeb28638-4b55-339e-b398-77844a03605e",
                                                "text": "„Von Guste, die er für seine Taufpatin hielt, erbte Janosch die Vorliebe für Gold und Flitter.“"
                                            },
                                            {
                                                "example_id": "6c7cbbe0-a68e-4e0a-b5b4-2604151192a5",
                                                "sense_id": "eeb28638-4b55-339e-b398-77844a03605e",
                                                "text": "„Ihren Flitter hatte sie abgelegt.“"
                                            },
                                            {
                                                "example_id": "6e48b5bb-0d5b-4a50-b61f-a2fc9b165c4c",
                                                "sense_id": "eeb28638-4b55-339e-b398-77844a03605e",
                                                "text": "„Äußerer Flitter ist ein ausgezeichnetes Gegengewicht gegen ein so schlechtes Geschenk der Natur.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
