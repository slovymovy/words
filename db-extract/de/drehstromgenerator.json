                "senses": [
                    {
                        "sense_id": "eb5922db-c345-3196-a0f9-be7d626ec8a9",
                        "entry_id": "9f9edbd6-5721-323c-807b-58cb2f5d4fa4",
                        "glosses": [
                            "Maschine, die mechanische Arbeit in Drehstrom umwandelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3dd424f-3f49-4055-8cf9-d2ca1b464107",
                                "sense_id": "eb5922db-c345-3196-a0f9-be7d626ec8a9",
                                "text": "„Dabei unterstützt ein integrierter Startergenerator den Motor beim Beschleunigen und erzeugt durch regeneratives Bremsen effizienter Strom als ein herkömmlicher Drehstromgenerator.“"
                            },
                            {
                                "example_id": "559ce47f-76df-4dac-9486-0593e58bd04c",
                                "sense_id": "eb5922db-c345-3196-a0f9-be7d626ec8a9",
                                "text": "„Das Antriebssystem des Öko-Multipla besteht aus einem 1,6-Liter-Vierventil-Benzinmotor mit 103 PS (75 kW), einem 30 kW starken Elektromotor, 15 Nickel-Metallhydrid-Batterien mit einer Leistung von 19 kWh und einem Drehstromgenerator (15 kW) mit Gleichrichter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
