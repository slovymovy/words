                                        "sense_id": "b8b0b9d8-dfc4-3444-aaff-7d5ba8b8ce18",
                                        "entry_id": "dd4cf046-9daf-38f5-8e74-3393d7d90214",
                                        "glosses": [
                                            "eine neue Entwicklung einleitend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24626ed0-cf02-4020-b537-a14e33fbef6e",
                                                "sense_id": "b8b0b9d8-dfc4-3444-aaff-7d5ba8b8ce18",
                                                "text": "Die Forscher machten bahnbrechende Entdeckungen."
                                            },
                                            {
                                                "example_id": "2550a480-677c-4304-863a-323995505835",
                                                "sense_id": "b8b0b9d8-dfc4-3444-aaff-7d5ba8b8ce18",
                                                "text": "Mit ihrer Arbeit wirkte sie bahnbrechend."
                                            },
                                            {
                                                "example_id": "f7f23369-01c8-430f-9520-55be02303a46",
                                                "sense_id": "b8b0b9d8-dfc4-3444-aaff-7d5ba8b8ce18",
                                                "text": "[Nobelpreisträger Syukuro Manabe:] „Im Jahr 1970 hatte er in einer bahnbrechenden Studie – der ersten, die konkrete Angaben zur zukünftigen Erderwärmung machte – vorausgesagt, dass die globalen Temperaturen zwischen den Jahren 1970 und 2000 um 0,57 Grad Celsius ansteigen würden. Der tatsächlich aufgezeichnete Temperaturanstieg betrug ungefähr 0,54 Grad Celsius.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40499a56-13d4-417d-ac13-f9e7a8d552b6",
                        "source_entry_id": "6be73211-06a0-3f38-a114-e9fd8cddebb4",
                        "source_sense_id": "777fd16f-7da3-32f0-a122-6ea374848603",
                        "source_sense_description": "resembling a trailblazer; innovative or pioneering",
                        "target_lang_word": "wegweisend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wegweisend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "15811ae7-86bf-36d3-9bd9-245e8c10d9b7",
                                        "entry_id": "334b8c03-5bb1-32d2-b6b1-0e7e59847c5b",
                                        "glosses": [
                                            "für die zukünftige Entwicklung sehr wichtig"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48bf2c83-5730-4aee-b4f4-78ebbd1576ff",
                                                "sense_id": "15811ae7-86bf-36d3-9bd9-245e8c10d9b7",
                                                "text": "Marconis Entdeckung der Funkwellen war wegweisend für die Kommunikation über große Entfernungen."
                                            },
                                            {
                                                "example_id": "43a4de47-ae68-43c0-a1b4-5a961a414882",
                                                "sense_id": "15811ae7-86bf-36d3-9bd9-245e8c10d9b7",
                                                "text": "„Ludwig Mies van der Rohe war einer der wegweisendsten Architekten des 20. Jahrhunderts.“"
                                            },
                                            {
                                                "example_id": "c131e7d9-ccb1-4f11-8839-b696b90c3b14",
                                                "sense_id": "15811ae7-86bf-36d3-9bd9-245e8c10d9b7",
                                                "text": "„»Gutenberg hat mit seiner wegweisenden Erfindung die Vermittlung von Wissen und Bildung für jedermann ermöglicht.«“"
                                            },
                                            {
                                                "example_id": "3f679bb2-b2b7-47de-9705-eeb94fbc9e00",
                                                "sense_id": "15811ae7-86bf-36d3-9bd9-245e8c10d9b7",
                                                "text": "[James Watson:] „Er lernte den neuseeländischen Biophysiker Maurice Wilkins kennen, der die DNS röntgenanalytisch untersuchte – eine Begegnung, die wegweisend sein sollte.“"
                                            },
                                            {
                                                "example_id": "0904e741-5a78-498b-b519-47907f75fef4",
                                                "sense_id": "15811ae7-86bf-36d3-9bd9-245e8c10d9b7",
                                                "text": "[Wasserstoff als Energieträger:] […] „Diese Projekte waren revolutionär und wegweisend. Den Durchbruch des Wasserstoffs brachten sie aber nicht.“"
                                            },
                                            {
                                                "example_id": "e994bc02-c003-4a8e-adac-e1141a65f1dc",
                                                "sense_id": "15811ae7-86bf-36d3-9bd9-245e8c10d9b7",
                                                "text": "„Im Dezember 2021 erklärte der Europäische Gerichtshof in einem unionsweit wegweisenden Urteil, dass das von ihm gesprochene Recht auch die Rechtsprechung der Verfassungsgerichte der Mitgliedstaaten außer Kraft setzen könne.“"
                                            },
                                            {
                                                "example_id": "bf2e647b-356e-4ab7-99ca-c139043975db",
                                                "sense_id": "15811ae7-86bf-36d3-9bd9-245e8c10d9b7",
                                                "text": "„Kalifornien ist in vielerlei Hinsicht Vorreiter in den USA.“ […] „Selbst beim Datenschutz gilt das kalifornische Gesetz als wegweisend.“"
                                            },
                                            {
                                                "example_id": "cc25bd63-6f64-452d-9b05-105d574e1953",
                                                "sense_id": "15811ae7-86bf-36d3-9bd9-245e8c10d9b7",
                                                "text": "„Japans Premier Kishida sprach bei der Unterzeichnung von einem wegweisenden Abkommen, das die Sicherheitszusammenarbeit zwischen Japan und Australien \"auf ein neues Niveau heben wird\".“"
                                            },
                                            {
                                                "example_id": "39e0fac4-86e1-4cd1-a6b1-5650db4e806d",
                                                "sense_id": "15811ae7-86bf-36d3-9bd9-245e8c10d9b7",
                                                "text": "„Technische Innovationen und Personalentwicklungsmaßnahmen im Militär der Vereinigten Staaten sind für die Partner in der NATO, deren führendes Mitglied die Vereinigten Staaten sind, und andere Verbündete wegweisend.“"
                                            },
                                            {
                                                "example_id": "bc7891a1-d4ed-4c89-89fc-235b796c0d38",
                                                "sense_id": "15811ae7-86bf-36d3-9bd9-245e8c10d9b7",
                                                "text": "„David Bowies Album \"The Rise and Fall of Ziggy Stardust and the Spiders from Mars\" ist wegweisend in der Pop-Geschichte.“"
                                            },
                                            {
                                                "example_id": "5f5bbdfe-6f64-4ec6-a8ab-a9623ef31994",
                                                "sense_id": "15811ae7-86bf-36d3-9bd9-245e8c10d9b7",
                                                "text": "[Musik – \"The Cure\":] „Die Band gilt als wegweisend für das Genre des Gothic Rock,“ […]."
                                            },
                                            {
                                                "example_id": "0d195ccc-9aed-4174-8e7c-0eb0e66974c0",
                                                "sense_id": "15811ae7-86bf-36d3-9bd9-245e8c10d9b7",
                                                "text": "[Monty Python:] „Ihr humoristischer Einfluss gilt bis heute als wegweisend und wurde von zahlreichen Komikern adaptiert und weiterentwickelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3af63e36-b619-31ac-9b9e-9a1334aadb80",
                                        "entry_id": "334b8c03-5bb1-32d2-b6b1-0e7e59847c5b",
                                        "glosses": [
                                            "die richtige Richtung anzeigend"
                                        ],
                                        "tags": [
                                            "no-comparative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2640d505-7fd0-4b84-919f-2ccb5a187ed4",
                                                "sense_id": "3af63e36-b619-31ac-9b9e-9a1334aadb80",
                                                "text": "„Die Richtlinien für die wegweisende Beschilderung auf Autobahnen (RWBA) sind ein in Deutschland gültiges technisches Regelwerk und regeln die Gestaltung der wegweisenden Beschilderung auf Bundesautobahnen.“"
                                            },
                                            {
                                                "example_id": "f64c6d12-89dc-4889-ba1f-7c5c4b460347",
                                                "sense_id": "3af63e36-b619-31ac-9b9e-9a1334aadb80",
                                                "text": "„Mit Hilfe der wegweisenden Beschilderung, die Teil der Straßenausstattung ist, können sich ortsunkundige Verkehrsteilnehmer während der Fahrt orientieren und so Irrfahrten verhindern.“"
                                            },
                                            {
                                                "example_id": "ed9e2867-271e-4d04-8e15-e2efb721188b",
                                                "sense_id": "3af63e36-b619-31ac-9b9e-9a1334aadb80",
                                                "text": "„Die Ausgestaltung und Aufstellung der wegweisenden Zeichen richten sich nach den Richtlinien für wegweisende Beschilderung außerhalb von Autobahnen (RWB) und den Richtlinien für wegweisende Beschilderung auf Autobahnen (RWBA).“"
                                            },
                                            {
                                                "example_id": "02d36dda-ab2a-4964-b867-087dee300fdb",
                                                "sense_id": "3af63e36-b619-31ac-9b9e-9a1334aadb80",
                                                "text": "„Bayerische Apps – Wegweisende Helferlein für unterwegs – Wer in Bayern von A nach B will, dem bieten jede Menge Apps Orientierung – für Auto-, Rad-, Bus- und Bahnfahrer oder Fußgänger.“"
                                            },
                                            {
                                                "example_id": "f7321595-d057-4874-9643-0e5e85570ded",
                                                "sense_id": "3af63e36-b619-31ac-9b9e-9a1334aadb80",
                                                "text": "„Jonathan presste die Lippen zusammen und hielt seinen Arm wegweisend Richtung Gestrüpp. Luna sah ihn noch einige Sekunden erschüttert an. »Ist das dein Ernst? Du willst wirklich in diese Stadt?«“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e44b9f1f-a2ca-4d0f-b022-6bf741f6f57a",
                        "source_entry_id": "6be73211-06a0-3f38-a114-e9fd8cddebb4",
                        "source_sense_id": "777fd16f-7da3-32f0-a122-6ea374848603",
                        "source_sense_description": "resembling a trailblazer; innovative or pioneering",
                        "target_lang_word": "richtungsweisend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "richtungsweisend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2592ff29-4bbc-301b-b76f-7aa31735bd55",
                                        "entry_id": "10566383-06af-30c2-924d-526763f03b72",
                                        "glosses": [
                                            "für die zukünftige Entwicklung sehr wichtig"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b2e5756-c3fb-4346-a98b-ed451480bbdb",
                                                "sense_id": "2592ff29-4bbc-301b-b76f-7aa31735bd55",
                                                "text": "Jimmy Wales traf mit der Gründung von Wikipedia im Jahr 2001 eine richtungsweisende Entscheidung für freies Wissen."
                                            },
                                            {
                                                "example_id": "070ae5ad-d800-48da-a985-39f09d4c5214",
                                                "sense_id": "2592ff29-4bbc-301b-b76f-7aa31735bd55",
                                                "text": "[…] „R. H. Lotze und W. Wundt begründeten eine Physiologische Psychologie. Wundt konnte 1879 ein psychologisches Laboratorium in Leipzig einrichten. Diese neue Laboratoriumswissenschaft wurde richtungsweisend.“"
                                            },
                                            {
                                                "example_id": "d1384ac3-0341-48a6-9b8a-222f3d912091",
                                                "sense_id": "2592ff29-4bbc-301b-b76f-7aa31735bd55",
                                                "text": "[Strahlenschutz als Forschungsgebiet:] „Weltweit richtungsweisend ist dabei die International Commission on Radiological Protection (ICRP).“"
                                            },
                                            {
                                                "example_id": "848c389a-63a5-4ddf-a924-aced9eb4e345",
                                                "sense_id": "2592ff29-4bbc-301b-b76f-7aa31735bd55",
                                                "text": "„Trotz aller Mängel waren der BMP-1 und BMP-2 richtungsweisende Konstruktionen für die Entwicklung von Schützenpanzern.“"
                                            },
                                            {
                                                "example_id": "7393da2c-e2b8-4b6a-8dad-b21088a3aaf1",
                                                "sense_id": "2592ff29-4bbc-301b-b76f-7aa31735bd55",
                                                "text": "„Entscheidend ist das Erreichen der langfristigen Umweltziele. Wichtig ist es jetzt, ökologisch verträgliche und richtungsweisende Entwicklungen anzustoßen.“"
                                            },
                                            {
                                                "example_id": "d806f5bc-6d87-44dc-86a7-4175a72ebc3c",
                                                "sense_id": "2592ff29-4bbc-301b-b76f-7aa31735bd55",
                                                "text": "„Eine richtungsweisende Entscheidung, wie es mit dem Impfstoff von AstraZeneca weitergeht, wird am Donnerstag von der Europäischen Arzneimittel-Agentur (EMA) in Amsterdam erwartet.“"
                                            },
                                            {
                                                "example_id": "6db95b3e-ff6d-420c-ac75-8dec05463103",
                                                "sense_id": "2592ff29-4bbc-301b-b76f-7aa31735bd55",
                                                "text": "[Gehörlosenschulen:] „Anders als in Frankreich entwickelte sich in Deutschland eine vor allem lautsprachlich orientierte, orale Methode - richtungsweisend als sogenannte \"deutsche Methode\".“"
                                            },
                                            {
                                                "example_id": "e0d6eb08-00a5-497b-b17f-2208fb2975df",
                                                "sense_id": "2592ff29-4bbc-301b-b76f-7aa31735bd55",
                                                "text": "[Polnische Gewerkschaft Solidarność:] „Eine wichtige Inspiration kam von dem aus Polen stammenden Papst Johannes Paul II. Während einer Messe in Warschau 1979 fiel sein berühmter Satz \"Fürchtet euch nicht\", der für Millionen Polen richtungsweisend wurde.“"
                                            },
                                            {
                                                "example_id": "74b0052f-549d-4823-9f3f-490923cefad5",
                                                "sense_id": "2592ff29-4bbc-301b-b76f-7aa31735bd55",
                                                "text": "„In einer richtungsweisenden Rede wies der Gouverneur der englischen Zentralbank Mark Carney auf die finanziellen Risiken des Klimawandels hin und forderte ein Umdenken im Finanzsektor.“"
                                            },
                                            {
                                                "example_id": "c4fe33c8-e7ad-4b79-8b34-f3a00925fd65",
                                                "sense_id": "2592ff29-4bbc-301b-b76f-7aa31735bd55",
                                                "text": "„In Italien und Österreich stehen richtungsweisende Abstimmungen an – Entscheidungen, die auch für die EU relevant sind.“"
                                            },
                                            {
                                                "example_id": "c9d3ccba-7881-4c1f-98a8-042ca7e48c24",
                                                "sense_id": "2592ff29-4bbc-301b-b76f-7aa31735bd55",
                                                "text": "„In der Stichwahl in zwei Wochen geht es in Frankreich um eine richtungsweisende Entscheidung zwischen Emmanuel Macron und Marine Le Pen.“"
                                            },
                                            {
                                                "example_id": "74afbe5f-0cf7-4c97-8ecc-a8fef569759e",
                                                "sense_id": "2592ff29-4bbc-301b-b76f-7aa31735bd55",
                                                "text": "[Wirtschaft:] „Am Donnerstagmorgen zog der richtungsweisende Terminkontrakt Euro-Bund-Future um etwa ein Prozent auf 167,64 Punkte an.“"
                                            },
                                            {
                                                "example_id": "f2e44584-f8de-4df4-98ff-0d19d3f8d1b7",
                                                "sense_id": "2592ff29-4bbc-301b-b76f-7aa31735bd55",
                                                "text": "[…] „Werder Bremen steht vor einem richtungsweisenden Bundesliga-Spiel.“"
                                            },
                                            {
                                                "example_id": "22647590-3660-41b8-b333-3c7a3ae88f7f",
                                                "sense_id": "2592ff29-4bbc-301b-b76f-7aa31735bd55",
                                                "text": "„Die zwei richtungsweisenden britischen Architekten der Gegenwart sind Richard Rogers und Norman Foster.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
