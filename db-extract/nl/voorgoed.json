        "nl-extract.jsonl": [
            {
                "entry_id": "2a110f69-ad8b-39d8-ac7a-331af2fa872b",
                "word": "voorgoed",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0039428f-bf92-3b66-a972-b5a452352872",
                        "entry_id": "2a110f69-ad8b-39d8-ac7a-331af2fa872b",
                        "glosses": [
                            "op permanente basis, niet meer aan verandering onderhevig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c32fb19d-ab8e-4814-a1d6-eba92c3d134a",
                                "sense_id": "0039428f-bf92-3b66-a972-b5a452352872",
                                "text": "In 1453 kwam er voorgoed een einde aan het Byzantijnse Rijk."
                            },
                            {
                                "example_id": "1eb1f300-2cee-4c4f-a8d5-a4e4effd6b78",
                                "sense_id": "0039428f-bf92-3b66-a972-b5a452352872",
                                "text": "Even wordt het spannend. Gids Rogier Meeus heeft honderduit gewaarschuwd tegen de de gevaren van de Hoge Venen, waar mensen ooit voorgoed verdwenen. Na een uitleg over het absorberend vermogen van veenmos stapt de gids –tussen de 65 en de 70– mis. Snel zakt hij weg in hetzelfde drabbige goedje. Reddende handen trekken hem eruit. „Dank u wel. Ik ben ook geen 20 meer, hè?”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8dd21557-38c4-4b54-8044-9ce149d8426b",
                        "source_entry_id": "2a110f69-ad8b-39d8-ac7a-331af2fa872b",
                        "source_sense_id": "0039428f-bf92-3b66-a972-b5a452352872",
                        "target_lang_word": "endgültig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "endgültig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cc044597-49fe-3226-91ca-e08b48647f73",
                                        "entry_id": "b6afdcd9-d5bf-3d2c-b4dd-083e623a1ca2",
                                        "glosses": [
                                            "ein für alle Mal, nicht mehr änderbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "189b6e39-7e09-4212-a780-ef2bc2da2689",
                                                "sense_id": "cc044597-49fe-3226-91ca-e08b48647f73",
                                                "text": "„Unsägliche Müdigkeit, Sarkasmus, hellste Zuversicht und kalte Verachtung, grelle Panik und die endgültigste Selbstaufgabe treffen hier in allen vorstellbaren Varianten aufeinander.“"
                                            },
                                            {
                                                "example_id": "0f229519-233a-4724-b19c-1d7a7d5ab0ed",
                                                "sense_id": "cc044597-49fe-3226-91ca-e08b48647f73",
                                                "text": "Meine Einstellung zu ihm ist jetzt endgültig.",
                                                "translation": "Gelegentlich ist Steigerung möglich:"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "043e8556-72ac-4abf-a7f7-447fcf06438a",
                        "source_entry_id": "2a110f69-ad8b-39d8-ac7a-331af2fa872b",
                        "source_sense_id": "0039428f-bf92-3b66-a972-b5a452352872",
                        "target_lang_word": "for good",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "for good",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2da308dd-7a1c-3e3b-9b9a-026e88b96218",
                                        "entry_id": "cbdd3dbc-8625-3b60-a00b-ad8477bb7cef",
                                        "glosses": [
                                            "In a way that is conclusive and final."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb4cf32c-8b77-4284-bb2a-9bbeaef57fbc",
                                                "sense_id": "2da308dd-7a1c-3e3b-9b9a-026e88b96218",
                                                "text": "A bad haircut is no fun, but at least you’re not stuck with it for good, only until it grows out."
                                            },
                                            {
                                                "example_id": "a772a9b6-5605-4a10-8ff2-7685166c3c2a",
                                                "sense_id": "2da308dd-7a1c-3e3b-9b9a-026e88b96218",
                                                "text": "This day I left Chelsea for good (that's a genteel phrase) and am got into Suffolk street."
                                            },
                                            {
                                                "example_id": "1fa832c9-f30e-4356-81fc-116a0c0865bd",
                                                "sense_id": "2da308dd-7a1c-3e3b-9b9a-026e88b96218",
                                                "text": "[S]he was dozing in the elbovv-chair, having refuſed to lie dovvn, ſaying, She ſhould ſoon, ſhe hoped, lie dovvn for good."
                                            },
                                            {
                                                "example_id": "da837811-83a9-4e30-93d6-966f8cb70d07",
                                                "sense_id": "2da308dd-7a1c-3e3b-9b9a-026e88b96218",
                                                "text": "Well, now, I'm no scholar, and you're a lad as can read and figure; and, to put it straight, do you take it as a dead man is dead for good, or do he come alive again?"
                                            },
                                            {
                                                "example_id": "0e6d4d43-3708-4846-bac4-34e68c4f9b57",
                                                "sense_id": "2da308dd-7a1c-3e3b-9b9a-026e88b96218",
                                                "text": "What I want is to get out of this fix, for good—so I can go to sleep at night without worrying over what's going to happen to me tomorrow, and next month, and next year."
                                            },
                                            {
                                                "example_id": "d8d9d8df-57b1-40b0-8dfc-fd70e04da8ed",
                                                "sense_id": "2da308dd-7a1c-3e3b-9b9a-026e88b96218",
                                                "text": "Yes, and thanks for the trouble you took from her eyes. I thought it was there for good so I never tried."
                                            },
                                            {
                                                "example_id": "2c724c74-efe6-4486-b239-6ed145bf5531",
                                                "sense_id": "2da308dd-7a1c-3e3b-9b9a-026e88b96218",
                                                "text": "Whatever I said, whatever I did, I didn't mean it / I just want you back for good"
                                            },
                                            {
                                                "example_id": "f139ba97-f0d0-4a1c-b281-8cd0bde1b3bd",
                                                "sense_id": "2da308dd-7a1c-3e3b-9b9a-026e88b96218",
                                                "text": "He […] unbuttons the bottom of his jacket so the rumors can be dispelled for good: he no longer wears his double belts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
