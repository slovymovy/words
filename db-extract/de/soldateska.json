                    {
                        "sense_id": "a122668b-4295-3ca0-a59c-deb8f56f1f67",
                        "entry_id": "d497a325-1b7f-3843-aeaf-c757040639bd",
                        "glosses": [
                            "Soldatesque : ensemble de soldats brutaux et pillards."
                        ],
                        "tags": [
                            "collective",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "0322bb4b-1235-495e-a730-cec8c9496cef",
                                "sense_id": "a122668b-4295-3ca0-a59c-deb8f56f1f67",
                                "text": "Die Plünderungen der Soldateska des Diktators waren schlimm genug, aber das Wirken seiner Steuerbehörde erwies sich als noch schlimmer.",
                                "translation": "Les pillages commis par la soldatesque du dictateur étaient bien assez graves, mais l’action de son administration fiscale se révéla encore pire."
                            }
                        ]
                    }
