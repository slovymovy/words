                        "sense_id": "b087c53e-2f8c-3dce-bba6-85e0cf2929f2",
                        "entry_id": "ca98cbfa-5f3c-30fe-8e16-0c17488f85e7",
                        "glosses": [
                            "Qui malmène."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "1780b35c-800e-4fdd-8a3c-42516387a153",
                                "sense_id": "b087c53e-2f8c-3dce-bba6-85e0cf2929f2",
                                "text": "Car elle accepte le mystère de ce qui est dans la saveur terriblement délectable de son rude chaos malmeneur, lacérateur;"
                            },
                            {
                                "example_id": "e03d6012-168b-40b7-8ea9-62ca4d73459c",
                                "sense_id": "b087c53e-2f8c-3dce-bba6-85e0cf2929f2",
                                "text": "Il avait beau prétendre que cette passion malmeneuse, cette volupté tendue lui avait à jamais « quitté le sang », on ne savait jamais quand elle pouvait resurgir et vous happer, requin émergeant sans crier gare de la mer calme"
                            }
                        ]
                    }
                ],
