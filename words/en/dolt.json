{
    "word_family": [
        "doltish",
        "doltishness",
        "doltishly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1070ad27-6606-332f-8d98-79ebf331a27d",
                    "sense_definition": "A stupid, clumsy, or foolish person; a dullard or blockhead.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt like a complete <w>dolt</w> after locking his keys inside the car.",
                            "target_lang_translations": {
                                "fr": "Il s'est senti comme un parfait <w>imbécile</w> après avoir enfermé ses clés dans la voiture."
                            }
                        },
                        {
                            "text": "Only an absolute <w>dolt</w> would ignore the clear warning signs posted along the cliff.",
                            "target_lang_translations": {
                                "fr": "Seul un <w>idiot</w> absolu ignorerait les panneaux d'avertissement pourtant clairs affichés le long de la falaise."
                            }
                        }
                    ],
                    "synonyms": [
                        "blockhead",
                        "dullard",
                        "dunce",
                        "fool",
                        "idiot",
                        "moron",
                        "nincompoop",
                        "nitwit",
                        "oaf"
                    ],
                    "antonyms": [
                        "genius"
                    ],
                    "common_phrases": [
                        "absolute dolt",
                        "complete dolt"
                    ],
                    "target_lang_definitions": {
                        "fr": "Personne stupide, maladroite ou sotte ; individu niais ou nigaud."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "imbécile",
                                "target_lang_sense_clarification": "personne manquant d'intelligence ou de bon sens"
                            },
                            {
                                "target_lang_word": "idiot",
                                "target_lang_sense_clarification": "personne stupide ou sotte"
                            },
                            {
                                "target_lang_word": "nigaud",
                                "target_lang_sense_clarification": "personne niaise et niaiseuse"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7ecf734b-fd14-3ce6-96d4-805ad5614b26",
                    "sense_definition": "To act in a foolish or stupid manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the whole afternoon <w>dolting</w> around instead of finishing his work.",
                            "target_lang_translations": {
                                "fr": "Il a passé toute l'après-midi à <w>faire l'idiot</w> au lieu de terminer son travail."
                            }
                        },
                        {
                            "text": "Stop <w>dolting</w> in front of the guests and behave properly.",
                            "target_lang_translations": {
                                "fr": "Arrête de <w>faire l'imbécile</w> devant les invités et tiens-toi correctement."
                            }
                        }
                    ],
                    "synonyms": [
                        "fool around"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare or obsolete usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Agir de manière stupide ou insensée ; faire l'idiot (archaïque)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "faire l'idiot",
                                "target_lang_sense_clarification": "se comporter de manière stupide"
                            },
                            {
                                "target_lang_word": "faire l'imbécile",
                                "target_lang_sense_clarification": "agir bêtement"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41a58c4f-a51e-3c8c-a14c-047fc98087e0",
                    "sense_definition": "To fool, deceive, or trick someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The clever swindler managed to <w>dolt</w> the unsuspecting travelers out of their money.",
                            "target_lang_translations": {
                                "fr": "L'escroc astucieux est parvenu à <w>duper</w> les voyageurs naïfs pour leur soutirer de l'argent."
                            }
                        },
                        {
                            "text": "He was easily <w>dolted</w> by the exaggerated claims made in the advertisement.",
                            "target_lang_translations": {
                                "fr": "Il s'est facilement laissé <w>berner</w> par les affirmations exagérées de la publicité."
                            }
                        }
                    ],
                    "synonyms": [
                        "deceive",
                        "dupe",
                        "fool",
                        "trick"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare or obsolete usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Tromper, duper ou berner quelqu'un (archaïque)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "duper",
                                "target_lang_sense_clarification": "tromper ou abuser quelqu'un"
                            },
                            {
                                "target_lang_word": "berner",
                                "target_lang_sense_clarification": "tromper par de fausses promesses ou apparences"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}