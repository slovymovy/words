                "senses": [
                    {
                        "sense_id": "fd4a70e5-fcc0-3258-bcfb-b80b69b95506",
                        "entry_id": "3847fcab-7df5-3b8b-ab29-25335fdb89f6",
                        "glosses": [
                            "Unsinn"
                        ],
                        "tags": [
                            "colloquial",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "70777122-9c19-460f-933e-4cc3af0664fa",
                                "sense_id": "fd4a70e5-fcc0-3258-bcfb-b80b69b95506",
                                "text": "„Erzähl nich sonnen Driss!“ - Erzähl' mir keinen Unsinn!"
                            },
                            {
                                "example_id": "8d80a933-16df-4da5-9d0b-37c2d57d0bb4",
                                "sense_id": "fd4a70e5-fcc0-3258-bcfb-b80b69b95506",
                                "text": "„Michael fing eine Unterhaltung fast immer mit den Worten »Dä Driss (der Mist)!« an! Irgendwann sagte ich ihm, dass ich überlege, über all das, »dä Driss«, ein Buch zu schreiben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0e3c13db-5738-3d69-9d61-3697c8912f22",
                        "entry_id": "3847fcab-7df5-3b8b-ab29-25335fdb89f6",
                        "glosses": [
                            "Mist, Scheiße"
                        ],
                        "tags": [
                            "colloquial",
                            "regional"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1e271fe-a87a-46fe-a5e5-1400e7eb4274",
                        "source_entry_id": "3847fcab-7df5-3b8b-ab29-25335fdb89f6",
                        "source_sense_id": "fd4a70e5-fcc0-3258-bcfb-b80b69b95506",
                        "source_sense_description": "umgangssprachlich, regional, rheinländisch: Unsinn",
                        "target_lang_word": "nonsense",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nonsense",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f84c921c-d824-334d-9624-33530a2601f7",
                                        "entry_id": "5e7a4a90-3e7d-36cb-a8a8-02c209538e68",
                                        "glosses": [
                                            "Letters or words, in writing or speech, that have no meaning or pattern or seem to have no meaning."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e51733b-4103-42bf-bb36-3547b6a7227f",
                                                "sense_id": "f84c921c-d824-334d-9624-33530a2601f7",
                                                "text": "After my father had a stroke, every time he tried to talk, it sounded like nonsense."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2e44b80-22f7-3592-a017-a66f9df445e8",
                                        "entry_id": "5e7a4a90-3e7d-36cb-a8a8-02c209538e68",
                                        "glosses": [
                                            "An untrue statement."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2ba7ff3-5f3c-4588-8048-aadc33b3146a",
                                                "sense_id": "b2e44b80-22f7-3592-a017-a66f9df445e8",
                                                "text": "You have seen it for yourselves in the play by Aristophanes, where Socrates goes whirling round, proclaiming that he is walking on air, and uttering a great deal of other nonsense about things of which I know nothing whatsoever."
                                            },
                                            {
                                                "example_id": "70321e25-9766-460f-9e19-4a9cdb85423a",
                                                "sense_id": "b2e44b80-22f7-3592-a017-a66f9df445e8",
                                                "text": "While at the hospital, David kept screaming and yelling nonsense, stating Vladimir Putin bailed him out of jail and is a god."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89b006da-574e-35bc-9704-c3c6d074e1d4",
                                        "entry_id": "5e7a4a90-3e7d-36cb-a8a8-02c209538e68",
                                        "glosses": [
                                            "That which is silly, illogical and lacks any meaning, reason or value; that which does not make sense."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bbbaf6b9-d8e8-3056-a480-62a2e0e247ae",
                                        "entry_id": "5e7a4a90-3e7d-36cb-a8a8-02c209538e68",
                                        "glosses": [
                                            "Something foolish."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abecf1f0-d1b1-4309-8ee7-a787fcd58f55",
                                                "sense_id": "bbbaf6b9-d8e8-3056-a480-62a2e0e247ae",
                                                "text": "and central banks lend vast sums against marshmallow backed securities, or other nonsenses creative bankers dreamed up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e20a78c8-6ba3-3318-9f81-e82255fd1ba6",
                                        "entry_id": "5e7a4a90-3e7d-36cb-a8a8-02c209538e68",
                                        "glosses": [
                                            "A type of poetry that contains strange or surreal ideas, as, for example, that written by Edward Lear."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "afd1081c-defe-32bb-a6d9-b28232b02999",
                                        "entry_id": "5e7a4a90-3e7d-36cb-a8a8-02c209538e68",
                                        "glosses": [
                                            "A damaged DNA sequence whose products are not biologically active, that is, that does nothing."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "nonsense",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "575c28a7-86cf-3d1e-a117-ddab3e634247",
                                        "entry_id": "6ed31c16-6ed7-3607-9bbb-896227debd38",
                                        "glosses": [
                                            "To make nonsense of;"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d682a32c-9f26-4cae-a7c6-6a5a3e78aa0c",
                                                "sense_id": "575c28a7-86cf-3d1e-a117-ddab3e634247",
                                                "text": "At the Haymarket all this is nonsensed by an endeavor to steer between Mr. Stanley Weyman's rights as author of the story and the prescriptive right of the leading actor to fight popularly and heroically against heavy odds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "986af08d-39bc-34c9-8ccb-18794cc1c18f",
                                        "entry_id": "6ed31c16-6ed7-3607-9bbb-896227debd38",
                                        "glosses": [
                                            "To attempt to dismiss as nonsense; to ignore or belittle the significance of something; to render unimportant or puny."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7625b9a0-d083-4f8e-a596-ba1af24f1af0",
                                                "sense_id": "986af08d-39bc-34c9-8ccb-18794cc1c18f",
                                                "text": "\"They haven't nonsensed these workouts. They've taken them and used them very well. I didn't know how they'd respond, but they've responded.\""
                                            },
                                            {
                                                "example_id": "c0dfef1f-f82a-4fbd-b24e-337f3ebcea30",
                                                "sense_id": "986af08d-39bc-34c9-8ccb-18794cc1c18f",
                                                "text": "Very commanding: very much 'end of this nonsensing'. Mister Fared spread his hands and shook his thin head imperceptibly, as if to say he understood."
                                            },
                                            {
                                                "example_id": "e5c5ab8f-9847-4078-9d3a-f3877511fcb1",
                                                "sense_id": "986af08d-39bc-34c9-8ccb-18794cc1c18f",
                                                "text": "He further nonsensed press suggestions that the Petroleum Unit was set up to assist in the administration of sporting activities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9c7a792-728f-3852-80cb-30dea3631f65",
                                        "entry_id": "6ed31c16-6ed7-3607-9bbb-896227debd38",
                                        "glosses": [
                                            "To joke around, to waste time"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7969aa5-2c12-4376-991f-3ef3c240d263",
                                                "sense_id": "c9c7a792-728f-3852-80cb-30dea3631f65",
                                                "text": "When he meant \"go and get one\" he said to go and get one, with no nonsensing around about \"liking\" to get one."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nonsense",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d34fd531-2868-35c7-829b-12b5d9fbd955",
                                        "entry_id": "016e1720-503a-3e09-bb5f-d125013d42c6",
                                        "glosses": [
                                            "Nonsensical."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "82662a12-c222-37d6-87a9-dbf97b143fb2",
                                        "entry_id": "016e1720-503a-3e09-bb5f-d125013d42c6",
                                        "glosses": [
                                            "Resulting from the substitution of a nucleotide in a sense codon, causing it to become a stop codon (not coding for an amino-acid)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "nonsense",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "460cb0e6-7876-38cb-a118-8ae0fd414c86",
                                        "entry_id": "8d4ac082-5c59-3125-ae7d-34d0ff75433b",
                                        "glosses": [
                                            "An emphatic rejection of something one has just heard and does not believe or agree with."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fe5a0b6-1513-4c30-b61f-7e761ed4e03e",
                                                "sense_id": "460cb0e6-7876-38cb-a118-8ae0fd414c86",
                                                "text": "The operators present this as a passenger benefit by claiming it provides early notice. Nonsense! This just means that passengers can't find any information about the train they thought they were catching. It simply disappears."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d8617da-6294-4dee-95a3-d714f3893960",
                        "source_entry_id": "3847fcab-7df5-3b8b-ab29-25335fdb89f6",
                        "source_sense_id": "fd4a70e5-fcc0-3258-bcfb-b80b69b95506",
                        "source_sense_description": "umgangssprachlich, regional, rheinländisch: Unsinn",
                        "target_lang_word": "folderol",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "folderol",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a3810157-6581-339b-a924-cb3c7c1dbecc",
                                        "entry_id": "35ed1904-54de-3737-8f35-d9d23d1e27cc",
                                        "glosses": [
                                            "Nonsense or foolishness."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d196713d-5859-4f88-86b6-2a04f5e35708",
                                                "sense_id": "a3810157-6581-339b-a924-cb3c7c1dbecc",
                                                "text": "William Maclay, a Pennsylvania Democrat and a senator, was a watchdog against the development of any monarchial folderol gathering about the office of the president."
                                            },
                                            {
                                                "example_id": "c700ecac-0a87-420f-b89e-83df4e53fb03",
                                                "sense_id": "a3810157-6581-339b-a924-cb3c7c1dbecc",
                                                "text": "[The librarian] rang the bell at nine. I hurried over to Philosophy and grabbed anything. It was another Nietzsche: Man and Superman. I knew that would get her. Before stamping it, she flipped a few pages.\n\"My!\" she said. \"What books you read!\"\nI said, \"Haw. That's nothing. I never read folderol.\"\nShe smiled good night."
                                            },
                                            {
                                                "example_id": "141ede72-0bc0-45bd-bec2-fa75fbc43f50",
                                                "sense_id": "a3810157-6581-339b-a924-cb3c7c1dbecc",
                                                "text": "In this confrontation with the magic of science and the magic of folderol, it is almost impossible not to side with the magic of folderol, and the silly, but relatively benign, Merlin."
                                            },
                                            {
                                                "example_id": "62c23a4f-5ab4-4029-9ca1-71c4f2bacea6",
                                                "sense_id": "a3810157-6581-339b-a924-cb3c7c1dbecc",
                                                "text": "“To say the essay has 'development of ideas' is absolute folderol.”\n“I beg your pardon?” Maria asked.\n“Folly,” he explained pedantically. “Poppycock. Gibberish.”\n“I know what folderol means,” Maria said. “I just think you better watch what you say.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5aa0913a-c35a-3f56-996f-ea60f4400a09",
                                        "entry_id": "35ed1904-54de-3737-8f35-d9d23d1e27cc",
                                        "glosses": [
                                            "A decorative object of little value; a trifle or gewgaw."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc3e491a-119b-49a5-a275-04e8f1fc629e",
                                                "sense_id": "5aa0913a-c35a-3f56-996f-ea60f4400a09",
                                                "text": "And they made a mistake there: the prizes were a lot of folderols and doodads like poetry books and illustrated Testaments, instead of something a real live kid would want to work for, like real cash or a speedometer for his motor cycle."
                                            },
                                            {
                                                "example_id": "9e0116d3-719d-4c63-a176-f2abe2b09b07",
                                                "sense_id": "5aa0913a-c35a-3f56-996f-ea60f4400a09",
                                                "text": "He didn't share Miss Flora's penchant for collecting gaudy, useless knickknacks, and wouldn't have bought any of those foolish, foreign fandangles and folderols if he did have the money to waste."
                                            },
                                            {
                                                "example_id": "43b3286e-2f09-4369-b801-5b83d1c02c38",
                                                "sense_id": "5aa0913a-c35a-3f56-996f-ea60f4400a09",
                                                "text": "“I notice you're not keen on folderols.”\n“Folderols?” Amanda echoed uncomprehendingly.\n“My grandmother's term for decorative items, pictures, knick-knacks,” Connor's hand swept the room."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
