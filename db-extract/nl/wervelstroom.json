                "translations": [
                    {
                        "translation_id": "099176b6-1884-4b90-98c3-d084e899eae9",
                        "source_entry_id": "1e4486d2-8caf-3f9d-ad60-5fd5a24b6526",
                        "source_sense_id": "b9cd31b9-fea8-3957-bc73-6b31dc45706b",
                        "target_lang_word": "Wirbelstrom",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wirbelstrom",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bf10355c-2579-38b8-a92b-9bcaa451a011",
                                        "entry_id": "b5bb6ca5-e7fc-35d2-8586-e031a5b78232",
                                        "glosses": [
                                            "Strom, der in einem ausgedehnten elektrischen Leiter in einem sich zeitlich ändernden Magnetfeld oder in einem bewegten Leiter in einem zeitlich konstanten, dafür räumlich inhomogenen Magnetfeld induziert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26ae664d-450b-4d8a-b818-626ee11159cf",
                                                "sense_id": "bf10355c-2579-38b8-a92b-9bcaa451a011",
                                                "text": "„Bei den Seescheiden tritt das Wasser durch die Aufnahmeöffnung des Mantels in einen weiten Kiemensack, dessen ganze innere Fläche von einem Gitterwerke ausgekleidet ist, das quere Maschen zeigt und wo jede Masche mit äußerst lebhaft schwingenden Wimperhaaren ausgekleidet ist. Der Wirbelstrom, den diese Wimperhaare erregen, zieht das Wasser durch die äußere Öffnung in den Kiemensack herein. Jede Masche bildet einen Schlitz, durch den das Wasser nach außen abfließt, sich in der Kloake sammelt und durch die Auswurfsöffnung des Mantels ausgestoßen wird.“"
                                            },
                                            {
                                                "example_id": "8be2466c-2580-4c76-b895-d4d1d57a091d",
                                                "sense_id": "bf10355c-2579-38b8-a92b-9bcaa451a011",
                                                "text": "„Wirbelströme erzeugen ihrerseits ein Magnetfeld, das gemäß der Lenzschen Regel der Änderung des Feldes entgegenwirkt. Dadurch wird bei hohen Frequenzen und großen Querschnitten der Strom aus der Mitte des Leiters verdrängt (Skin-Effekt).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9593def9-47a9-3bd5-a836-8e59d447cebd",
                                        "entry_id": "b5bb6ca5-e7fc-35d2-8586-e031a5b78232",
                                        "glosses": [
                                            "Wasserstrom, der sich in Wirbeln bewegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26f74d49-d4d5-40f7-90cf-82c4bf4aa46e",
                                                "sense_id": "9593def9-47a9-3bd5-a836-8e59d447cebd",
                                                "text": "Das Papierboot blieb in einem Wirbelstrom hängen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
