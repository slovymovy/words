                "word": "boutasse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7e68fc2c-38b1-4b4b-9f82-cdef06d82078",
                        "entry_id": "13bc4292-22c5-3de6-bf76-8877fcfe44dc",
