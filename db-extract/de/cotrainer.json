                "senses": [
                    {
                        "sense_id": "2d483d9a-6f1a-33f9-aab0-748a4801de2a",
                        "entry_id": "45e27042-286d-33b0-a602-ddbe341ac812",
                        "glosses": [
                            "unterstützender, dem verantwortlichen Cheftrainer nachgeordneter Trainer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbc17d29-c04b-4f86-95bb-6b5f036a3939",
                                "sense_id": "2d483d9a-6f1a-33f9-aab0-748a4801de2a",
                                "text": "„Daraus folgt zunächst, dass es für Trainerinnen schwieriger ist, einen Mann als Cotrainer zu finden.“"
                            },
                            {
                                "example_id": "1173b798-65af-426f-ae52-7209133a0435",
                                "sense_id": "2d483d9a-6f1a-33f9-aab0-748a4801de2a",
                                "text": "„Der heutige Cotrainer des FC Bayern, ein Bochumer Urgestein wie Legat, hat dem Talent am Anfang der Zusammenarbeit eins klargemacht: ‚Wenn Du nicht wieder zurück auf die Straße willst, dann musst du kämpfen, kämpfen, kämpfen.‘“"
                            },
                            {
                                "example_id": "fa7e812a-2540-4b42-be44-8a22402b0e42",
                                "sense_id": "2d483d9a-6f1a-33f9-aab0-748a4801de2a",
                                "text": "„Cotrainer Markus Schupp ist für den Trainingsbetrieb zuständig und muss möglichweise auch im Bundesligaspiel gegen Wolfsburg auf der Bank sitzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
