                                "target_senses": [
                                    {
                                        "sense_id": "778f8d33-2bdb-336e-a3e5-492ec736f181",
                                        "entry_id": "ebc13478-d5cd-3c98-a83b-d02c7c9c4e6f",
                                        "glosses": [
                                            "Movement as a stream."
                                        ],
