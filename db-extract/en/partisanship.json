                "senses": [
                    {
                        "sense_id": "7b7a8e46-a3b9-352a-9a8f-fdab65358839",
                        "entry_id": "59ae7a26-0bc8-3640-afe3-0d23bfa359e7",
                        "glosses": [
                            "An inclination to be partisan or biased; partiality."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0f5046cc-efc5-4c85-83a0-ff1edcd96948",
                                "sense_id": "7b7a8e46-a3b9-352a-9a8f-fdab65358839",
                                "text": "In this moment of constant campaigning and tribal partisanship, even the courts have had difficulty puncturing the ideological bubbles that Mr. Trump and Fox News pundits have created."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce00e3ad-1cb0-4e88-b072-61ca90638470",
                        "source_entry_id": "59ae7a26-0bc8-3640-afe3-0d23bfa359e7",
