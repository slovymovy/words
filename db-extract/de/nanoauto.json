                "senses": [
                    {
                        "sense_id": "3c4b444f-5a62-3caf-844a-781acfdf5b4f",
                        "entry_id": "5dc226f1-fe2f-3406-bd21-f09991454a3b",
                        "glosses": [
                            "Gefährt, das aus einem Molekül oder auch mehreren Molekülen gebaut wird"
                        ],
                        "tags": [
                            "Nanotechnologie",
                            "Transport"
                        ],
                        "examples": [
                            {
                                "example_id": "64706485-e532-44a6-9f72-9229a1554fe8",
                                "sense_id": "3c4b444f-5a62-3caf-844a-781acfdf5b4f",
                                "text": "„Auch in der Nanowelt kann jetzt gefahren werden: Wissenschaftler haben das erste, aus nur einem einzigen Molekül bestehende „Nanoauto“ gebaut. Nach Ansicht der Forscher könnte dies ein erster wichtiger Schritt hin zu der Entwicklung weiterer molekularer Maschinen sein.“"
                            },
                            {
                                "example_id": "7b367e31-a216-4e1d-8e44-a600bf75f639",
                                "sense_id": "3c4b444f-5a62-3caf-844a-781acfdf5b4f",
                                "text": "„Hundertmal so viel Leistungsdichte wie ein BMW-Sechszylindermotor. Im vergangenen Jahr bereits machte ein Nanoauto Schlagzeilen, dessen vier Räder aus Buckyballs bestehen, kugelförmigen Kohlenstoffmolekülen. Wissenschaftler um James Tour von der texanischen Rice University hatten es gebaut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
