            {
                "entry_id": "f020c835-298e-395f-8cb2-8fd8b07a675d",
                "word": "sturend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2ab108e5-4f0c-3404-92da-9f9b342a93d4",
                        "entry_id": "f020c835-298e-395f-8cb2-8fd8b07a675d",
                        "glosses": [
                            "bezig met iets of iemand in een bepaalde richting te laten gaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c852245-9b57-462e-8ef0-83598a72e208",
                                "sense_id": "2ab108e5-4f0c-3404-92da-9f9b342a93d4",
                                "text": "De laatste periode van Polman aan het hoofd van Unilever was tumultueus, met de mislukte samenvoeging van de hoofdkantoren in Londen en Rotterdam in de Maasstad als dieptepunt. Daarnaast speelde in Nederland de discussie over de afschaffing van de dividendbelasting waarin Unilever een sturende rol zou hebben gehad."
                            },
                            {
                                "example_id": "77792453-f451-4a87-8047-321a1ff6d244",
                                "sense_id": "2ab108e5-4f0c-3404-92da-9f9b342a93d4",
                                "text": "Foodwatch bracht hiertegenin dat de zuivelproducent ‘sturende vragen’ heeft gesteld waardoor de respondenten in hun oordeel een bepaalde richting uit werden geduwd."
                            },
                            {
                                "example_id": "92ddd6eb-8cad-4ce5-b181-0adc914a8db5",
                                "sense_id": "2ab108e5-4f0c-3404-92da-9f9b342a93d4",
                                "text": "We hebben vooral een sturende en begeleidende rol.”"
                            },
                            {
                                "example_id": "edadb7c2-1ca6-4b23-ae37-311926feb39b",
                                "sense_id": "2ab108e5-4f0c-3404-92da-9f9b342a93d4",
                                "text": "'Een ongeluk als dit hoeft toch niet te betekenen dat ons huidige thuisland bij de oorlog betrokken wordt?' Achteraf vroeg hij zich af wat hij eigenlijk voor antwoord verwacht had op die op zijn zachtst gezegd sturende vraag."
                            }
                        ]
                    }
