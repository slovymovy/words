    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3cd74d38-2d7b-3db6-ae23-0a4a62c9190d",
                    "sense_definition": "Débarrasser un passage, une voie ou un lieu de ce qui l'encombre ou l'obstrue.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "liberer_espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les pompiers ont travaillé toute la nuit pour <w>dégager</w> la route bloquée par les arbres."
                        },
                        {
                            "text": "Merci de <w>dégager</w> la table du salon avant que les invités n'arrivent."
                        }
                    ],
                    "antonyms": [
                        "bloquer",
                        "encombrer",
                        "obstruer"
                    ],
                    "common_phrases": [
                        "dégager la voie",
                        "dégager le passage",
                        "dégager la route"
                    ]
                },
                {
                    "sense_id": "78a191fc-eac5-3e86-8d72-4f3e310f6d64",
                    "sense_definition": "Partir, quitter les lieux sur un ton impératif ou hostile.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "partir_intimidation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Dégage</w> de là tout de suite ou j'appelle immédiatement la police !"
                        },
                        {
                            "text": "Il s'est mis en colère et a crié à tout le monde de <w>dégager</w>."
                        }
                    ],
                    "synonyms": [
                        "gicler",
                        "jarcler"
                    ],
                    "antonyms": [
                        "rester"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier et impoli"
                        }
                    ]
                },
                {
                    "sense_id": "ec2eca84-3a6a-361a-9256-f27fde76c37a",
                    "sense_definition": "Émettre ou diffuser dans l'air une odeur, une chaleur, de la lumière ou une sensation particulière.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emanation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette plante tropicale <w>dégage</w> un parfum très sucré au coucher du soleil."
                        },
                        {
                            "text": "Le radiateur ancien <w>dégage</w> une chaleur agréable dans toute la pièce."
                        }
                    ],
                    "antonyms": [
                        "absorber"
                    ],
                    "common_phrases": [
                        "dégager une odeur",
                        "dégager de la chaleur"
                    ]
                },
                {
                    "sense_id": "82a8afa9-3392-3d1c-bdd8-e8d0614fe403",
                    "sense_definition": "Retirer quelqu'un ou quelque chose d'un endroit où il est coincé ou retenu prisonnier.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "liberer_espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les secouristes ont réussi à <w>dégager</w> le conducteur coincé dans sa voiture."
                        },
                        {
                            "text": "Il tenta vainement de <w>dégager</w> son pied coincé entre deux grosses pierres."
                        }
