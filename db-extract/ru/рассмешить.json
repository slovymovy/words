                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c4b9880-1d54-4ff6-93df-8941deeec31e",
                                "sense_id": "fbba0ba8-478e-3f44-9922-9513e43a8704",
                                "text": "Она была из смешливых и, когда рассмешат, смеялась неслышно, колыхаясь и трясясь всем телом, до тех пор, что самой тошно уж становилось.",
                                "translation": "She was given to laughter and when anything amused her, she laughed inaudibly, quivering and shaking all over till she felt ill.",
                                "english": "She was given to laughter and when anything amused her, she laughed inaudibly, quivering and shaking all over till she felt ill."
                            }
                        ]
                    }
                ],
