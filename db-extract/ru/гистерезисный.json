                                        "sense_id": "4a726da3-2477-33be-87d8-0e5217007e92",
                                        "entry_id": "913d22c5-ef5c-301b-a868-41ae138eaa71",
                                        "glosses": [
                                            "Magnetic friction in dynamos, by which every reversal of magnetism in the iron causes dissipation of energy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
