                        "examples": [
                            {
                                "example_id": "54028e5c-bd5a-42a6-ad6b-ce8d2f72e10d",
                                "sense_id": "d03790a0-694c-3b53-8607-fb0f1c196140",
                                "text": "Ainsi pour ce grade nouveau et important, la Faculté était inconvocable, à cause d’un doyen cassé et indifférent, et d’autre part, il faut que tout soit décidé, imprimé, approuvé en trois jours."
                            },
                            {
                                "example_id": "9a5cb2c2-0816-4370-8035-83fca8f2927e",
                                "sense_id": "d03790a0-694c-3b53-8607-fb0f1c196140",
                                "text": "S’il s’est effectivement agi, dans ce chapitre, d’une deuxième histoire de ventre, il faut dire que cette histoire s’est révélée bien difficile à écrire pour l’enfant adopté. … Ventre inconvocable, au surgissement redouté."
                            },
                            {
                                "example_id": "55bbe6ac-496e-4a3e-b3ff-d889431d5a5c",
                                "sense_id": "d03790a0-694c-3b53-8607-fb0f1c196140",
                                "text": "Les technologies numériques ouvrent de nouvelles formes de représentation, elles permettent d’envisager une écriture visuelle qui enrichit notre projet actuel. Elles interviennent pour raconter et donner à voir des imaginaires inconvocables d’une autre façon."
                            }
                        ]
                    }
