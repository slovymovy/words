                        "glosses": [
                            "ziekenhuis waar patiënten met ernstige brandwonden kan behandelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab62ea8a-03a1-4279-b419-18f90fcc6de0",
                                "sense_id": "4f6ed410-88b7-38bc-9e3e-b19e7ba20cfe",
                                "text": "Op het eerste gezicht lijkt het een beetje goed nieuws: er kwamen wat minder vuurwerkslachtoffers op de spoedeisende hulpen dan vorig jaar. Maar de slachtoffers waren wel ernstiger gewond dan andere jaren en ze waren vaak jong. Die verwondingen aan gezicht en handen zijn vaak zo erg, dat zelfs de artsen van het brandwondenziekenhuis ervan onder de indruk zijn."
                            },
                            {
                                "example_id": "4fbc6694-9d7b-4749-9c1d-a2cd0804dc3c",
                                "sense_id": "4f6ed410-88b7-38bc-9e3e-b19e7ba20cfe",
                                "text": "Vier gewonden zijn naar het ziekenhuis gebracht, een van hen is in kritieke toestand. Hij ligt in het brandwondenziekenhuis in Beverwijk. Zes andere gewonden konden ter plekke worden behandeld. Zij hebben rook ingeademd."
                            }
                        ]
                    }
