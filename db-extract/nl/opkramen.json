                        "examples": [
                            {
                                "example_id": "ee33c70b-31c6-40be-902c-542a8f4c6327",
                                "sense_id": "db602a27-306d-365f-9389-14345c639c73",
                                "text": "OPKRASSEN. Curieus is dat veel woorden met als betekenis `opstappen, weggaan' betrekkelijk jong zijn. Dit geldt bijvoorbeeld ook voor opkrassen, dat pas in 1838 voor het eerst is gesignaleerd. Het Woordenboek der Nederlandsche Taal geeft als definitie `weggaan, zich wegpakken, opkramen' en vermeldt dat we hier te maken hebben met `gemeenzame taal'. Hij is opgekrast werd ook gebruikt voor `hij is gestorven'. Een vormvariant was opkrossen."
                            },
                            {
                                "example_id": "60ebf135-7ac1-4fa4-aaf7-be2d36b8915e",
                                "sense_id": "db602a27-306d-365f-9389-14345c639c73",
                                "text": "Ritchie De Laet boekte een deugddoende overwinning tegen Newcastle, dat op zoek mag naar een nieuwe coach. Targetspits Ulloa kopte het enige doelpunt van de wedstrijd tegen de netten, na 39 minuten. De Laet speelde 90 minuten bij Leicester. Newcastle is de eerste Premier League-club die moet opkramen in de FA Cup."
                            }
                        ]
                    }
