                "senses": [
                    {
                        "sense_id": "c11ce398-2a4b-3f30-89fb-44dbec441ac4",
                        "entry_id": "c8cd2272-52ec-3b59-9c67-467466911957",
                        "glosses": [
                            "in der Mitte eines Schildes befindliche Wölbung, unter der sich ein ein Griffloch für den Träger befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dde1c550-bdeb-41a5-bea6-d7fd2f9a8124",
                                "sense_id": "c11ce398-2a4b-3f30-89fb-44dbec441ac4",
                                "text": "„Herausragende Einzelstücke der keltischen Kunst aus Britannien sind der Bronzebeschlag eines Schildes, der im 19. Jahrhundert im Fluss Witham bei Lincoln zutage kam, sowie die beiden Schildbuckel aus Bronze, die ebenfalls im 19. Jahrhundert bei Wandsworth in der Themse gefunden wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42ca3e3c-8b57-4e00-b41e-fbe9de1844fd",
                        "source_entry_id": "c8cd2272-52ec-3b59-9c67-467466911957",
                        "source_sense_id": "c11ce398-2a4b-3f30-89fb-44dbec441ac4",
                        "target_lang_word": "umbo",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "umbo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9723a25d-5b0e-3f4a-a738-e40679ca8e78",
                                        "entry_id": "5e1cbce9-973c-3f4c-b52b-4d95dac7daf1",
                                        "glosses": [
                                            "Pointe, cône, calotte faisant saillie au milieu d’un bouclier."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e1096c3-3857-4ad9-9a06-317608aa7a76",
                                                "sense_id": "9723a25d-5b0e-3f4a-a738-e40679ca8e78",
                                                "text": "Souvent en métal, l’umbo servait de renfort, protégeait le poing tenant le bouclier, repoussait et détournait les coups et jouait quelquefois dans la mêlée le rôle d’arme contondante."
                                            },
                                            {
                                                "example_id": "825385eb-c0ea-4fc8-8952-ec91fc776aac",
                                                "sense_id": "9723a25d-5b0e-3f4a-a738-e40679ca8e78",
                                                "text": "Des vociférations éclatèrent en face d’un portique, où les soldats avaient suspendu leurs boucliers. Les housses étant défaites, on voyait sur les umbo la figure de César. C’était pour les Juifs une idolâtrie."
                                            },
                                            {
                                                "example_id": "b18a786f-540d-49ff-b948-258ad25ac9b2",
                                                "sense_id": "9723a25d-5b0e-3f4a-a738-e40679ca8e78",
                                                "text": "L’arme [= le bouclier celte] est composée d’une planche, d’un demi-fuseau en bois (la spina), d’une coque en fer rivetée destinée à protéger la main (l’umbo), d’une poignée horizontale parfois renforcée d’une barrette (le manipule) et éventuellement de renforts métalliques (les orles)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "279fc0b6-4223-3c9b-94b9-49283c8369ff",
                                        "entry_id": "5e1cbce9-973c-3f4c-b52b-4d95dac7daf1",
                                        "glosses": [
                                            "Le bouclier tout entier."
                                        ],
