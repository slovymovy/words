                    {
                        "translation_id": "7a1a264a-f618-4bc9-931f-5ecb665b4d90",
                        "source_entry_id": "e7ff0b45-4e91-3d35-b4c6-57311833b12f",
                        "source_sense_id": "1bf36688-cdbc-345b-a700-e9f9fb40be0c",
                        "source_sense_description": "an adherent of Sikhism",
                        "target_lang_word": "Sikh",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sikh",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e7e818e-8ee3-3efb-9dfc-03ca5de1d971",
                                        "entry_id": "6f73071c-701b-3f5e-82d3-1a4c3ff32eb9",
                                        "glosses": [
                                            "Anhänger des Sikhismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c76f1fd9-1ca7-466f-a8ac-b3875a0ab5b2",
                                                "sense_id": "2e7e818e-8ee3-3efb-9dfc-03ca5de1d971",
                                                "text": "„Sikhs, Marathen und Rajputen schärften ihre Waffen für den Kampf gegen Delhi.“"
                                            },
                                            {
                                                "example_id": "190afe70-2e00-485e-b7e0-1b43a05b246e",
                                                "sense_id": "2e7e818e-8ee3-3efb-9dfc-03ca5de1d971",
                                                "text": "„Bis vor zwei Monaten lebten Sikhs in Deutschland unbemerkt von der Mehrheitsgesellschaft.“"
                                            },
                                            {
                                                "example_id": "5a85588e-9a1f-4c3f-8f3e-b76fa1feb05a",
                                                "sense_id": "2e7e818e-8ee3-3efb-9dfc-03ca5de1d971",
                                                "text": "„Als Zeichen, dass bei den Sikh jeder Mensch die gleiche Würde hat, heißen bis heute alle Männer mit Nachnamen Sing (wörtlich: Löwe) und alle Frauen Kaur (Prinzessin).“"
                                            },
                                            {
                                                "example_id": "97faae74-c4dc-4a17-a23f-46c1ddc66f76",
                                                "sense_id": "2e7e818e-8ee3-3efb-9dfc-03ca5de1d971",
                                                "text": "„Viele Muslime fanden sich auf der indischen Seite der Trennlinie, viele Hindus und Sikhs auf der pakistanischen.“"
                                            },
                                            {
                                                "example_id": "60fbb725-58d8-4a3d-ad83-4f00e0e2ccda",
                                                "sense_id": "2e7e818e-8ee3-3efb-9dfc-03ca5de1d971",
                                                "text": "„Kaschmir, das in pakistanischen Darstellungen häufig zu einem Ort der Sehnsucht verklärt wird, wurde im 18. Jahrhundert zunächst von den Afghanen und Anfang des 19. Jahrhunderts von den Sikhs in Besitz genommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "117a436b-252e-358f-a240-66c2b8c8f5fd",
                                        "entry_id": "6f73071c-701b-3f5e-82d3-1a4c3ff32eb9",
                                        "glosses": [
                                            "Mann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1277184e-e2ba-42d2-923c-bf5efede9c99",
                                                "sense_id": "117a436b-252e-358f-a240-66c2b8c8f5fd",
                                                "text": "„Sikhs, Marathen und Rajputen schärften ihre Waffen für den Kampf gegen Delhi.“"
                                            },
                                            {
                                                "example_id": "8d49c78b-42f4-4b07-9a97-3f45e5f805f5",
                                                "sense_id": "117a436b-252e-358f-a240-66c2b8c8f5fd",
