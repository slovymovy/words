                    },
                    {
                        "translation_id": "eea4c641-9bfb-472f-a696-23a95f1abb01",
                        "source_entry_id": "05041be1-f2a5-3d3a-ba83-c6c0ed0a3406",
                        "source_sense_description": "машинист железнодорожной техники",
                        "target_lang_word": "train driver",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "cf486100-6651-4668-818d-b58cfcf7d1df",
                        "source_entry_id": "05041be1-f2a5-3d3a-ba83-c6c0ed0a3406",
                        "source_sense_description": "машинист железнодорожной техники",
                        "target_lang_word": "Lokführer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lokführer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f76a1b8-96e7-3857-a54b-bcec16a2224a",
                                        "entry_id": "72768f2b-936b-376e-ab5a-fb552160f422",
                                        "glosses": [
                                            "Lokomotivführer"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93f08f56-2b1c-497f-9a7e-ccc39961cf9a",
                                                "sense_id": "1f76a1b8-96e7-3857-a54b-bcec16a2224a",
                                                "text": "Die Lokführer wollen einen eigenen Lohnabschluss."
                                            },
                                            {
                                                "example_id": "046a8a54-063d-4717-8fb4-1d5951db7405",
                                                "sense_id": "1f76a1b8-96e7-3857-a54b-bcec16a2224a",
                                                "text": "„Ich lese in einem alten Lexikon, dass Lokführer mehrere Jahre als Bahnarbeiter in Bahnschlossereien und Schweißereien ausgebildet wurden.“"
                                            },
                                            {
                                                "example_id": "47211656-005b-4cc3-a044-60c86039fcaa",
                                                "sense_id": "1f76a1b8-96e7-3857-a54b-bcec16a2224a",
                                                "text": "„Sein Vater war ebenfalls Lokführer und Grubenarbeiter in Teilzeit.“"
                                            },
                                            {
                                                "example_id": "6ca097f4-31ab-4d8f-9b8e-554445ddcf80",
                                                "sense_id": "1f76a1b8-96e7-3857-a54b-bcec16a2224a",
                                                "text": "„Die Deutsche Bahn könnte schon in wenigen Jahren Züge ohne Lokführer auf die Schienen schicken.“"
                                            },
                                            {
                                                "example_id": "7471c6e6-5a7a-4875-8b3d-1516c6a21507",
                                                "sense_id": "1f76a1b8-96e7-3857-a54b-bcec16a2224a",
                                                "text": "„Wir flüchten auf die Lokomotive und nach ein paar Sekunden auf der anderen Seite wieder herunter am Zug entlang, indessen der Lokführer Abfahrtssignale tutet und erst rückwärts und dann möglichst schwungvoll wieder voraus rangiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
