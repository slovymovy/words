                        "examples": [
                            {
                                "example_id": "33dab73f-9b95-474b-bdca-5696a674dd77",
                                "sense_id": "e13b672e-e1ba-3a24-a6f3-c4220939b66b",
                                "text": "L’on peut certes relever dans Histoire et dogme la présence récurrente de nombreux théologoumènes proprement chrétiens et, plus encore, la construction d’une problématique à leur voisinage immédiat."
                            }
                        ]
                    },
                    {
                        "sense_id": "acfe8dc0-f603-305f-ac3f-5f71be692e75",
                        "entry_id": "16f2ed0f-cbd2-36c6-ae07-9080ffc958e4",
                        "glosses": [
                            "Affirmation théologique présentée dans les récits bibliques comme un fait historique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e60a9b03-f03c-4c3a-a7ad-c8f73412ff9f",
                                "sense_id": "acfe8dc0-f603-305f-ac3f-5f71be692e75",
                                "text": "Cette tradition relative à la virginité de Marie est parfois considérée comme un théologoumène, à savoir une affirmation théologique présentée comme un fait historique d’une réalité saisissable seulement dans la foi."
                            }
                        ]
                    }
