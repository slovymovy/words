                        "cross_references": [
                            {
                                "target_word": "Gestapo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0fc95c3d-72ab-32f7-a19f-c98dd2d4e1e4",
                                        "entry_id": "0eab6197-5afb-37e0-850b-9e977f034aee",
                                        "glosses": [
                                            "The secret police of Nazi Germany."
                                        ],
                                        "tags": [
                                            "Nazism",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55ce5bf9-a549-477d-ad8b-8bf7e05f1bdd",
                                                "sense_id": "0fc95c3d-72ab-32f7-a19f-c98dd2d4e1e4",
                                                "text": "Fortunately this was Spain and not Germany. The Spanish secret police had some of the spirit of the Gestapo, but not much of its competence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0948d925-3fcc-3b7c-b542-aa32b9a95284",
                                        "entry_id": "0eab6197-5afb-37e0-850b-9e977f034aee",
                                        "glosses": [
                                            "Any militant oppressive force or group."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "derogatory",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2721929d-8c71-48ef-aef1-d75ead487a76",
                                                "sense_id": "0948d925-3fcc-3b7c-b542-aa32b9a95284",
                                                "text": "Men were frog-marched by the feminist Gestapo into accepting an alien 'politically correct' agenda."
                                            },
                                            {
                                                "example_id": "55800c24-83b5-451b-9510-9834da311cba",
                                                "sense_id": "0948d925-3fcc-3b7c-b542-aa32b9a95284",
                                                "text": "One of those injured by the immigration Gestapo spoke to WSWS reporter Kimie Saito, his head wrapped in white bandages stained with blood."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c96bfd99-123a-4ada-837b-ae7ca538bf33",
                        "source_entry_id": "a6c0c8da-bed8-3ddb-b97b-28bdeeefd613",
                        "source_sense_id": "092069cf-1d74-3dd8-ac1a-5f20ba6e0416",
