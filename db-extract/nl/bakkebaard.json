                                "target_senses": [
                                    {
                                        "sense_id": "23bd691a-74c3-3936-95bf-ed5614134147",
                                        "entry_id": "f6e263a9-bd2a-3b0e-ac17-600cfd036e5a",
                                        "glosses": [
                                            "zwischen Wangen und Ohren wachsender Teil des Haupthaars"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "488aedcc-16d4-4ea8-85a3-a86c095d1a4f",
                                                "sense_id": "23bd691a-74c3-3936-95bf-ed5614134147",
                                                "text": "Ein Markenzeichen von Elvis Presley waren die Koteletten."
                                            },
                                            {
                                                "example_id": "22a30d4b-87ac-47f7-8e10-90f0918bc96e",
                                                "sense_id": "23bd691a-74c3-3936-95bf-ed5614134147",
                                                "text": "„Am vierten Fenster saß ein sehr wohlgekleideter, jugendlich verfetteter Herr mit altmodisch attraktiven Koteletten und einem zugleich weichen und herrischen und jedenfalls hinreißenden Bonvivantgesicht.“"
                                            },
                                            {
                                                "example_id": "256644d1-f884-46ef-8c6b-49111843dc31",
                                                "sense_id": "23bd691a-74c3-3936-95bf-ed5614134147",
                                                "text": "„Er trug einen Anzug aus geköpertem Barchent, seine Haltung war steif, der Backenbart zu Koteletten gestutzt; so wirkte er wie ein Beamter und Dandy zugleich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Koteletten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f84a1155-0909-3111-beb3-f3fdd1de9313",
                                        "entry_id": "0520d0b0-83c2-38e1-a9bd-15c139c089e2",
                                        "glosses": [
                                            "Dativ Plural des Substantivs Kotelett"
                                        ],
                                        "tags": [
                                            "dative",
                                            "form-of",
                                            "plural"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1598359-44e8-4a2c-baf3-5027dd67ced7",
                        "source_entry_id": "b0d274ea-5603-302c-b181-abc20214e939",
                        "source_sense_id": "8c4108ca-2faf-3b84-a8b7-f52a871d459e",
                        "source_sense_description": "deel van het baardhaar dat groeit vanaf de kaaklijnen tot aan de haargrens boven de oren.",
                        "target_lang_word": "Backenbart",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Backenbart",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0d54ca4b-74eb-3ee1-b9e4-2d744fea84fb",
                                        "entry_id": "2472b55b-47fd-3f4e-8fdb-96bcd1ac1781",
                                        "glosses": [
                                            "dichte Behaarung vor allem an Wangen und Kinn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e24fddf-2037-4812-9edc-de2cae4ca8de",
                                                "sense_id": "0d54ca4b-74eb-3ee1-b9e4-2d744fea84fb",
                                                "text": "Er ließ sich einen Backenbart wachsen."
                                            },
                                            {
                                                "example_id": "6b26fc11-037b-4543-aaec-40c9f4e46306",
                                                "sense_id": "0d54ca4b-74eb-3ee1-b9e4-2d744fea84fb",
                                                "text": "„Er hatte sich von ganz unten hochgearbeitet und strahlte dank seiner Körpergröße, seiner buschigen Augenbrauen und seines langen Backenbarts Autorität aus.“"
                                            },
                                            {
                                                "example_id": "47591031-8ead-42ab-a1af-aa6b7e1c8d45",
                                                "sense_id": "0d54ca4b-74eb-3ee1-b9e4-2d744fea84fb",
                                                "text": "„Als ich die Zahnarztpraxis verließ, stand unten auf der Straße ein Mann mit einem Backenbart, der mir mit den Augen zuzwinkerte; er machte eine merkwürdige Geste, indem er die Wand des nächsten Hauses hinauf zeigte.“"
                                            },
                                            {
                                                "example_id": "1b231a33-5cc9-43a0-80f5-4cf0446cca9c",
                                                "sense_id": "0d54ca4b-74eb-3ee1-b9e4-2d744fea84fb",
                                                "text": "„Sie trugen Backenbärte, die neueste Mode, und ihre Jacken hatten zu breite Schultern und zu enge Taillen.“"
                                            },
                                            {
                                                "example_id": "f92a7399-466d-417d-87dc-933926fd5313",
                                                "sense_id": "0d54ca4b-74eb-3ee1-b9e4-2d744fea84fb",
                                                "text": "„Mr Mathews wirkte mit seinem abgetragenen Jackett und dem verfilzten Backenbart zwar seltsam altmodisch, war aber vornehm und freundlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
