                                "target_senses": [
                                    {
                                        "sense_id": "e02cbf7b-2c17-363e-a3c3-35ccc1100f0c",
                                        "entry_id": "261b88af-f26c-3a62-a2bd-5235191e37b1",
                                        "glosses": [
                                            "via een omweg"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "937e0331-474e-4270-aef8-9b0991fd5c82",
                                                "sense_id": "e02cbf7b-2c17-363e-a3c3-35ccc1100f0c",
                                                "text": "Tenslotte mag men van wetenschap en techniek niet het (menselijk) geluk verwachten; zij dragen daar onrechtstreeks wel krachtig toe bij door het scheppen van betere materiële bestaansvoorwaarden, door het bestrijden van fysiek lijden (geneeskunde), door het verschaffen van beter inzicht in de zo gecompliceerde menselijke gedragingen (biologie, psychologie, sociologie)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "460c67a8-8fca-4af7-bee2-2f3779b4b4c8",
                        "source_entry_id": "7b21f595-4fb3-3a90-8b32-7647c73dcca5",
                        "source_sense_id": "60aa1d42-36dc-3866-97e8-bf5c9972190d",
                        "source_sense_description": "suggested without being stated directly",
                        "target_lang_word": "sous-entendu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sous-entendu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9033c471-37ee-3550-86b3-fc6154a820e6",
                                        "entry_id": "d9471cc4-1a97-36d8-bf64-de5bbe733041",
                                        "glosses": [
                                            "Non dit, mais implicite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49d9dc07-52a6-47f9-b93d-704ffb009369",
                                                "sense_id": "9033c471-37ee-3550-86b3-fc6154a820e6",
                                                "text": "C'est (existant), proposition principale absolue et elliptique.\nLe sujet est ce, simple et incomplexe; le verbe est est; l'attribut est existant, il est sous-entendu ; il est simple et incomplexe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sous-entendu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1a05c651-2478-3c96-bd8a-b29253509726",
                                        "entry_id": "64308db3-0adc-3206-87bf-3d30c9a3812f",
                                        "glosses": [
                                            "Non-dit, quelque chose d’implicite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df3ac38e-0b26-4fd5-82a9-b8ddcc1d604a",
                                                "sense_id": "1a05c651-2478-3c96-bd8a-b29253509726",
                                                "text": "Mon père, qui ne pouvait pas deviner ce qu’il y avait de sous-entendu dans cette réponse, s’en montra satisfait."
                                            },
                                            {
                                                "example_id": "13cfc980-96cb-452c-974b-bab773f7e721",
                                                "sense_id": "1a05c651-2478-3c96-bd8a-b29253509726",
                                                "text": "Il y a dans cette lettre bien des sous-entendus."
                                            },
                                            {
                                                "example_id": "b69c47c8-d838-41b8-8b79-b1918fe2b87f",
                                                "sense_id": "1a05c651-2478-3c96-bd8a-b29253509726",
                                                "text": "Seulement, dans son air d’importance finaude, dans sa correction de magistrat mondain aux yeux d’acier, perçaient toutes sortes de sous-entendus, comme s’il était au courant déjà des moindres détails et qu’il eût promis de grands événements pour le lendemain."
                                            },
                                            {
                                                "example_id": "6a692aba-ee92-4013-baad-23d97613e677",
                                                "sense_id": "1a05c651-2478-3c96-bd8a-b29253509726",
                                                "text": "Tacite le sait, il ne dit d’ailleurs pas vraiment le contraire, mais fidèle à son habitude générale il manie le sous-entendu avec un art consommé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ee608e3-e8ba-3cfd-86a9-48a7990c79bf",
                                        "entry_id": "64308db3-0adc-3206-87bf-3d30c9a3812f",
                                        "glosses": [
                                            "Allusion grivoise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe90e44b-6274-473e-b5e2-a5417a039279",
                                                "sense_id": "6ee608e3-e8ba-3cfd-86a9-48a7990c79bf",
                                                "text": "Cette chanson est pleine de sous-entendus."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sous-entendu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7616f47a-1dd0-3745-a245-dbb1930c1dfe",
                                        "entry_id": "ba4ddfdf-49e2-3574-a882-43feb51343fd",
                                        "glosses": [
