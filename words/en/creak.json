{
    "word_family": [
        "creaky",
        "creakiness"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3171cac5-d9b8-338b-a5ca-72bdb3d5a462",
                    "sense_definition": "To make a prolonged, harsh grating or squeaking sound, especially when moving or under pressure.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old wooden stairs <w>creak</w> loudly whenever someone walks on them at night.",
                            "target_lang_translations": {
                                "ru": "Старая деревянная лестница громко <w>скрипит</w> каждый раз, когда кто-то идет по ней ночью."
                            }
                        },
                        {
                            "text": "She pushed the heavy door open, listening to it <w>creak</w> on its rusty hinges.",
                            "target_lang_translations": {
                                "ru": "Она толкнула тяжелую дверь, слушая, как та <w>скрипит</w> на ржавых петлях."
                            }
                        }
                    ],
                    "synonyms": [
                        "squeak",
                        "groan",
                        "grate"
                    ],
                    "common_phrases": [
                        "creak open"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать резкий, протяжный скрежещущий или пищащий звук, особенно при движении или под давлением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скрипеть",
                                "target_lang_sense_clarification": "издавать скрип при движении или нагрузке"
                            },
                            {
                                "target_lang_word": "скрипнуть",
                                "target_lang_sense_clarification": "однократно издать скрип"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1318ed40-859e-362e-84d3-2bc1ab56c7b2",
                    "sense_definition": "To show signs of severe strain, deterioration, or weakness under pressure or through age.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "strain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The public healthcare system began to <w>creak</w> under the sudden surge of patients.",
                            "target_lang_translations": {
                                "ru": "Государственная система здравоохранения начала <w>трещать по швам</w> под внезапным наплывом пациентов."
                            }
                        },
                        {
                            "text": "The country's aging infrastructure is starting to <w>creak</w> after decades of neglected maintenance.",
                            "target_lang_translations": {
                                "ru": "Стареющая инфраструктура страны начинает <w>сдавать</w> после десятилетий отсутствия должного обслуживания."
                            }
                        }
                    ],
                    "synonyms": [
                        "falter",
                        "strain"
                    ],
                    "common_phrases": [
                        "creak under the strain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявлять признаки сильного напряжения, ухудшения состояния или слабости под давлением либо от старости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трещать по швам",
                                "target_lang_sense_clarification": "испытывать сильную перегрузку, разваливаться"
                            },
                            {
                                "target_lang_word": "скрипеть",
                                "target_lang_sense_clarification": "с трудом функционировать под большой нагрузкой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "055ae753-6fe4-35f5-b625-d6178b959fa6",
                    "sense_definition": "To cause something to make a grating or squeaking noise.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He shifted his weight nervously, <w>creaking</w> the leather armchair as he spoke.",
                            "target_lang_translations": {
                                "ru": "Он нервно переминался с места на место, заставляя кожаное кресло <w>скрипеть</w>, пока говорил."
                            }
                        },
                        {
                            "text": "The dancers moved slowly, carefully avoiding <w>creaking</w> the fragile wooden floorboards.",
                            "target_lang_translations": {
                                "ru": "Танцоры двигались медленно, стараясь не <w>скрипеть</w> хрупкими деревянными половицами."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять что-либо издавать скрипящий или скрежещущий звук."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скрипеть",
                                "target_lang_sense_clarification": "производить скрип чем-либо"
                            },
                            {
                                "target_lang_word": "скрипнуть",
                                "target_lang_sense_clarification": "однократно заставить что-либо издать скрип"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "813e54f1-c78d-30e4-8eed-ca3d65764919",
                    "sense_definition": "A harsh, high-pitched squeaking or grating sound.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>creak</w> of a floorboard upstairs startled everyone in the room.",
                            "target_lang_translations": {
                                "ru": "Внезапный <w>скрип</w> половицы наверху напугал всех в комнате."
                            }
                        },
                        {
                            "text": "With a loud <w>creak</w>, the old gate swung open in the wind.",
                            "target_lang_translations": {
                                "ru": "С громким <w>скрипом</w> старые ворота распахнулись от ветра."
                            }
                        }
                    ],
                    "synonyms": [
                        "squeak",
                        "groan"
                    ],
                    "common_phrases": [
                        "loud creak"
                    ],
                    "target_lang_definitions": {
                        "ru": "Резкий скрипящий или скрежещущий звук."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скрип",
                                "target_lang_sense_clarification": "резкий скрежещущий звук трения"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "55875168-fc06-3a20-9ff3-4e0163d042dc",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Creak</w> was invited to present his findings at the annual history conference.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Крик</w> был приглашен представить результаты своих исследований на ежегодной исторической конференции."
                            }
                        },
                        {
                            "text": "The company archives recorded that the founder's original family name was <w>Creak</w>.",
                            "target_lang_translations": {
                                "ru": "Архивы компании зафиксировали, что первоначальной фамилией основателя была <w>Крик</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Крик",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}