    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7bfa9b22-edc6-3d80-984a-2962311b93d4",
                    "sense_definition": "Charme séduisant et sophistiqué, associé à l'élégance, à la beauté et au monde du spectacle.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "charme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le festival de cinéma a retrouvé tout son <w>glamour</w> avec l'arrivée des plus grandes vedettes internationales."
                        },
                        {
                            "text": "Cette nouvelle séance photo met en valeur le <w>glamour</w> naturel de la jeune actrice."
                        }
                    ],
                    "synonyms": [
                        "charme",
                        "séduction",
                        "prestige"
                    ],
                    "common_phrases": [
                        "manquer de glamour",
                        "plein de glamour"
                    ]
                },
                {
                    "sense_id": "2c9bf406-c818-32b7-99b5-678ed8ef4973",
                    "sense_definition": "Dans les contes et légendes gaéliques, sortilège ou pouvoir magique créant une illusion d'optique trompeuse.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "magie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Selon cette vieille légende, la sorcière utilisait un puissant <w>glamour</w> pour tromper les voyageurs égarés."
                        },
                        {
                            "text": "Le chevalier tenta sans succès de briser le mystérieux <w>glamour</w> qui masquait la véritable apparence du château."
                        }
                    ],
                    "synonyms": [
                        "illusion",
                        "sortilège"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "folklore écossais"
                        }
                    ]
                },
                {
                    "sense_id": "fb279e78-8c72-3019-9105-3d5e552f7ec3",
                    "sense_definition": "Créature fantastique polymorphe issue des croyances et contes traditionnels écossais.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "folklore",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les villageois racontaient qu'un redoutable <w>glamour</w> rôdait dans les bois en prenant la forme d'un loup."
                        },
                        {
                            "text": "Dans ce conte traditionnel, le héros doit combattre un dangereux <w>glamour</w> capable de se métamorphoser."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "folklore écossais"
                        }
                    ]
                },
                {
                    "sense_id": "1c025b29-7051-30ca-a8fd-c7835a0cfbd5",
                    "sense_definition": "État d'insouciance poétique et de rêverie mélancolique considéré comme propre à l'esprit britannique.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "reverie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'écrivain décrivait avec mélancolie le <w>glamour</w> qui enveloppait la campagne anglaise au crépuscule."
                        },
                        {
                            "text": "Ce poème illustre parfaitement le <w>glamour</w> propre à l'esprit romantique britannique du dix-neuvième siècle."
                        }
                    ],
                    "synonyms": [
                        "rêverie"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "usage littéraire ancien"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "653a7951-127d-3549-95cf-edd7a29c1e94",
                    "sense_definition": "Qui possède un charme séduisant, élégant et sophistiqué.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "charme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle portait une longue robe noire particulièrement <w>glamour</w> pour la prestigieuse cérémonie annuelle."
                        },
                        {
                            "text": "Ce métier d'enquêteur semble passionnant à l'écran, mais la réalité quotidienne est bien moins <w>glamour</w>."
