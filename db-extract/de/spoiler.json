                        "source_sense_id": "325b91a6-f034-3471-b5a5-fc305b6d3f36",
                        "source_sense_description": "Luftfahrt: bewegliche Klappe auf der Oberseite der Tragflächen von Flugzeugen",
                        "target_lang_word": "déporteur",
