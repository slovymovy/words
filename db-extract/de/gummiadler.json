                "senses": [
                    {
                        "sense_id": "0d448ab9-1d6f-3e95-a10e-28a9ef3f0226",
                        "entry_id": "08711dae-9729-3882-a2fb-1abaa81a0b9f",
                        "glosses": [
                            "(minderwertiges, zähes) Brathähnchen"
                        ],
                        "tags": [
                            "colloquial",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "276f95ad-2c40-42b0-b843-0498a0bd7e1c",
                                "sense_id": "0d448ab9-1d6f-3e95-a10e-28a9ef3f0226",
                                "text": "„Glanz und Elend der Wiesn sind die Brathendln, die, wenn das Stoßgeschäft läuft, oft alles andere als knusprig sind (immerhin wurden im vergangenen Jahr knapp eine halbe Million ‚Gummiadler‘ gebraten).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49de1532-0258-4580-9bd6-703cd7f54e98",
                        "source_entry_id": "08711dae-9729-3882-a2fb-1abaa81a0b9f",
                        "source_sense_id": "0d448ab9-1d6f-3e95-a10e-28a9ef3f0226",
                        "source_sense_description": "(minderwertiges, zähes) Grillhähnchen",
                        "target_lang_word": "rubber chicken",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rubber chicken",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc28985d-095d-3362-b967-9c45d72cd507",
                                        "entry_id": "7675b6e0-0c7d-306b-8450-84d3f8f1022f",
                                        "glosses": [
                                            "A hollow, bright yellow toy or prop depicting a plucked chicken that emits a squeak when squeezed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bee60ea-d656-4c54-923e-f2f369d6ba73",
                                                "sense_id": "dc28985d-095d-3362-b967-9c45d72cd507",
                                                "text": "The hack comic produced a rubber chicken, to the groans and boos of the audience."
                                            },
                                            {
                                                "example_id": "04a96b5b-bace-4c73-ad59-4c4b76614661",
                                                "sense_id": "dc28985d-095d-3362-b967-9c45d72cd507",
                                                "text": "Men who have squeaked the rubber chicken on Broadway, or wooed humanity with a fringe of swaying, porpoise-hide shoe-laces, were swallowed up in the gray shadows of the storm."
                                            },
                                            {
                                                "example_id": "4dfb9e8d-091c-48db-b7c8-13244f7fc963",
                                                "sense_id": "dc28985d-095d-3362-b967-9c45d72cd507",
                                                "text": "The rubber chicken is probably the best example of a prop used for schtick."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8155212-abd2-39c6-b66b-fcab6c9f44cf",
                                        "entry_id": "7675b6e0-0c7d-306b-8450-84d3f8f1022f",
                                        "glosses": [
                                            "The mediocre food served at social events, especially political fundraisers."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "colloquial",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ceff72af-cc5c-4710-98a5-a7ea6fa29463",
                                                "sense_id": "b8155212-abd2-39c6-b66b-fcab6c9f44cf",
                                                "text": "The bill of fare consisted of an india-rubber chicken and boiled eggs."
                                            },
                                            {
                                                "example_id": "68558744-b243-4504-96ab-7c42a4405c32",
                                                "sense_id": "b8155212-abd2-39c6-b66b-fcab6c9f44cf",
                                                "text": "It was the hoedowns and the caucuses and the rubber chicken dinners and the big DFL blowouts at the Minneapolis Auditorium."
                                            },
                                            {
                                                "example_id": "f55c4df0-db1c-4ac3-9f24-fe55b98a8d39",
                                                "sense_id": "b8155212-abd2-39c6-b66b-fcab6c9f44cf",
                                                "text": "She had felt the same way about attending political gatherings—the rubber-chicken luncheons and living room campaign coffee hours— back when Brandon had been a candidate for public office."
                                            },
                                            {
                                                "example_id": "9c80320f-e38d-42de-ba81-5338a69a9e0a",
                                                "sense_id": "b8155212-abd2-39c6-b66b-fcab6c9f44cf",
                                                "text": "This is an annual shindig where politicians and members of the media sit down together, have a few beers and eat some rubber chicken, and political leaders of the day make a few silly speeches at their own expense."
                                            },
                                            {
                                                "example_id": "25d4a5f7-b47a-4a95-9e6b-3150f21ef9a0",
                                                "sense_id": "b8155212-abd2-39c6-b66b-fcab6c9f44cf",
                                                "text": "What the hell have you devoted all these years to politics for if all you want to do is to work the rubber chicken circuit and hang out with elderly activists!'"
                                            },
                                            {
                                                "example_id": "ba47bd39-3596-4758-89ac-20009d128097",
                                                "sense_id": "b8155212-abd2-39c6-b66b-fcab6c9f44cf",
                                                "text": "I found both the rubber chicken and the political offering equally unappetising."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1789f664-6fa0-3f58-a28e-96e4d2240513",
                                        "entry_id": "7675b6e0-0c7d-306b-8450-84d3f8f1022f",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see rubber, chicken."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
