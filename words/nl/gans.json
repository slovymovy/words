    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "742dd757-1b94-3a9e-810e-a6d5dc408d78",
                    "sense_definition": "Een grote watervogel uit de familie van de eendachtigen, bekend om het vliegen in V-formatie.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "watervogels",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de herfst zie je vaak een grote troep <w>ganzen</w> in de lucht vliegen.",
                            "target_lang_translations": {
                                "en": "In the autumn, you often see a large flock of <w>geese</w> flying in the sky.",
                                "ru": "Осенью часто можно увидеть в небе большую стаю <w>гусей</w>."
                            }
                        },
                        {
                            "text": "De boer houdt een tamme <w>gans</w> om zijn erf te bewaken tegen indringers.",
                            "target_lang_translations": {
                                "en": "The farmer keeps a tame <w>goose</w> to guard his yard against intruders.",
                                "ru": "Фермер держит ручного <w>гуся</w>, чтобы охранять свой двор от незваных гостей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een tamme gans",
                        "een troep ganzen"
                    ],
                    "target_lang_definitions": {
                        "en": "A large waterfowl of the family Anatidae, known for flying in V-formation.",
                        "ru": "Крупная водоплавающая птица семейства утиных, известная тем, что летает клином."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "goose",
                                "target_lang_sense_clarification": "the bird"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "гусь",
                                "target_lang_sense_clarification": "птица"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c5a1efe-3c4e-3312-958b-6b220606a028",
                    "sense_definition": "Een beledigende term voor een vrouw die men als dom of naïef beschouwt.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "beledigingen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij gedraagt zich soms als een domme <w>gans</w> door alles zomaar te geloven.",
                            "target_lang_translations": {
                                "en": "She sometimes behaves like a silly <w>goose</w> by just believing everything.",
                                "ru": "Она иногда ведет себя как глупая <w>гусыня</w>, веря всему подряд."
                            }
                        },
                        {
                            "text": "Zeg niet zulke onaardige dingen tegen haar, ze is geen domme <w>gans</w>.",
                            "target_lang_translations": {
                                "en": "Don't say such unkind things to her; she is no silly <w>goose</w>.",
                                "ru": "Не говори ей таких гадостей, она вовсе не глупая <w>гусыня</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "domme gans"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt in de combinatie 'domme gans'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An insulting term for a woman considered to be stupid or naive.",
                        "ru": "Оскорбительное обозначение женщины, которую считают глупой или наивной."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "goose",
                                "target_lang_sense_clarification": "a silly person"
                            },
                            {
                                "target_lang_word": "silly goose",
                                "target_lang_sense_clarification": "idiomatic expression for a naive person"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "гусыня",
                                "target_lang_sense_clarification": "о глупой женщине"
                            },
                            {
                                "target_lang_word": "дурочка",
                                "target_lang_sense_clarification": "наивная или глупая особа"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "be137946-c5ba-37d5-acac-135319addcfe",
                    "sense_definition": "Over de gehele omvang of tijdsduur; niet onderbroken of verdeeld.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geheel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij heeft de <w>ganse</w> dag hard gewerkt in de tuin zonder te rusten.",
                            "target_lang_translations": {
                                "en": "He worked hard in the garden the <w>whole</w> day without resting.",
                                "ru": "Он <w>весь</w> день упорно работал в саду без отдыха."
                            }
                        },
                        {
                            "text": "Het <w>ganse</w> land was in rep en roer na het grote nieuws.",
                            "target_lang_translations": {
                                "en": "The <w>entire</w> country was in turmoil after the big news.",
                                "ru": "<w>Вся</w> страна была в смятении после важных новостей."
                            }
                        }
                    ],
                    "synonyms": [
                        "geheel",
                        "heel",
                        "volledig",
                        "compleet"
                    ],
                    "antonyms": [
                        "ongans"
                    ],
                    "common_phrases": [
                        "de ganse dag",
                        "het ganse land"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "vaker gebruikt in Vlaanderen of in plechtige taal"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Over the entire extent or duration; uninterrupted or undivided.",
                        "ru": "На протяжении всего объема или времени; непрерывный или неразделенный."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "entire",
                                "target_lang_sense_clarification": "whole or complete"
                            },
                            {
                                "target_lang_word": "whole",
                                "target_lang_sense_clarification": "full duration or extent"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "весь",
                                "target_lang_sense_clarification": "целиком"
                            },
                            {
                                "target_lang_word": "целый",
                                "target_lang_sense_clarification": "полный период или объем"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "determiner",
            "senses": [
                {
                    "sense_id": "fa59a9f9-9aff-3d4c-b9b5-7153e588513b",
                    "sense_definition": "Verwijst naar de totaliteit van een zelfstandig naamwoord; synoniem aan 'heel'.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geheel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>ganse</w> familie kwam bij elkaar om het jubileum te vieren.",
                            "target_lang_translations": {
                                "en": "The <w>whole</w> family came together to celebrate the anniversary.",
                                "ru": "<w>Вся</w> семья собралась вместе, чтобы отпраздновать юбилей."
                            }
                        },
                        {
                            "text": "Hij heeft de <w>ganse</w> boel bij elkaar geschreeuwd toen hij boos was.",
                            "target_lang_translations": {
                                "en": "He shouted the <w>whole</w> place down when he was angry.",
                                "ru": "Он поднял крик на <w>весь</w> дом, когда разозлился."
                            }
                        }
                    ],
                    "synonyms": [
                        "heel",
                        "geheel",
                        "volledig"
                    ],
                    "common_phrases": [
                        "de ganse familie",
                        "de ganse boel"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "komt vaker voor in Belgisch-Nederlands"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Refers to the totality of a noun; synonymous with 'whole'.",
                        "ru": "Относится к совокупности существительного; синоним слова «весь»."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "whole",
                                "target_lang_sense_clarification": "the entirety of a group or thing"
                            },
                            {
                                "target_lang_word": "entire",
                                "target_lang_sense_clarification": "the complete set"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "весь",
                                "target_lang_sense_clarification": "целостность группы или предмета"
                            },
                            {
                                "target_lang_word": "целый",
                                "target_lang_sense_clarification": "полный состав"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ccd09d60-b038-39d0-b44a-b0205d01b0be",
                    "sense_definition": "In alle opzichten of over de gehele oppervlakte; totaal.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geheel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij was <w>gans</w> alleen in het grote, donkere bos achter het huis.",
                            "target_lang_translations": {
                                "en": "She was <w>entirely</w> alone in the large, dark forest behind the house.",
                                "ru": "Она была <w>совсем</w> одна в большом темном лесу за домом."
                            }
                        },
                        {
                            "text": "De plannen zijn <w>gans</w> anders gelopen dan we oorspronkelijk hadden verwacht.",
                            "target_lang_translations": {
                                "en": "The plans turned out <w>quite</w> differently than we had originally expected.",
                                "ru": "Планы пошли <w>совершенно</w> иначе, чем мы изначально ожидали."
                            }
                        }
                    ],
                    "synonyms": [
                        "geheel",
                        "helemaal",
                        "volledig"
                    ],
                    "common_phrases": [
                        "gans alleen"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "in Nederland vooral in vaste uitdrukkingen of poëzie"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "In all respects or over the entire surface; totally.",
                        "ru": "Во всех отношениях или по всей поверхности; полностью."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "entirely",
                                "target_lang_sense_clarification": "completely"
                            },
                            {
                                "target_lang_word": "quite",
                                "target_lang_sense_clarification": "totally or completely"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "совсем",
                                "target_lang_sense_clarification": "полностью, абсолютно"
                            },
                            {
                                "target_lang_word": "совершенно",
                                "target_lang_sense_clarification": "в полной мере"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "fd37ada4-e323-386b-aea0-c45aff16d726",
                    "sense_definition": "Een achternaam die voorkomt in het Nederlandse taalgebied.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Meneer <w>Gans</w> is de auteur van dit historische boek over de stad.",
                            "target_lang_translations": {
                                "en": "Mr. <w>Gans</w> is the author of this historical book about the city.",
                                "ru": "Господин <w>Ганс</w> — автор этой исторической книги о городе."
                            }
                        },
                        {
                            "text": "In het telefoonboek staan verschillende mensen met de achternaam <w>Gans</w>.",
                            "target_lang_translations": {
                                "en": "There are several people with the surname <w>Gans</w> in the phone book.",
                                "ru": "В телефонной книге есть несколько человек с фамилией <w>Ганс</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "familienaam"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A surname occurring in the Dutch-speaking region.",
                        "ru": "Фамилия, встречающаяся в нидерландоязычном регионе."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Gans",
                                "target_lang_sense_clarification": "family name"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "Ганс",
                                "target_lang_sense_clarification": "фамилия"
                            }
