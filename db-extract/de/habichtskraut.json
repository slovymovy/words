                                "example_id": "d7146c62-7933-4c3a-a34e-6b10b1183720",
                                "sense_id": "0948c5d9-499b-325a-b021-312a76e83546",
                                "text": "Die meisten Habichtskräuter haben gelbe Blüten."
                            },
                            {
                                "example_id": "a1094b36-72f2-4b19-83a5-7ae76ea28851",
                                "sense_id": "0948c5d9-499b-325a-b021-312a76e83546",
                                "text": "„Als im August das Habichtskraut verblüht war und der Herbst nahte, steckte Henriette einen Bund Heidekraut in die Vase.“"
                            }
                        ],
