                "senses": [
                    {
                        "sense_id": "6228ffe2-26ca-3f79-8b46-d76a970c1c6b",
                        "entry_id": "b7821d38-e1f9-3e68-bfb5-1d2ecaa6b5e4",
                        "glosses": [
                            "Passer au vilebrequin."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "b4a2428f-577d-43cb-96af-84c406c6ce23",
                                "sense_id": "6228ffe2-26ca-3f79-8b46-d76a970c1c6b",
                                "text": "On a dû vilebrequiner ce mur car les clous n’y entraient pas."
                            },
                            {
                                "example_id": "50ac74fb-d1fa-442b-b001-c4a9ee201d91",
                                "sense_id": "6228ffe2-26ca-3f79-8b46-d76a970c1c6b",
                                "text": "perso, j'aimerais bien le refaire vilebrequiner plutôt qu'en faire un choli pied de lampe ^^"
                            }
                        ]
                    },
                    {
                        "sense_id": "699eb0c9-35b0-3a86-84a4-f7204a2fcad1",
                        "entry_id": "b7821d38-e1f9-3e68-bfb5-1d2ecaa6b5e4",
                        "glosses": [
                            "Fonctionner, pour un vilebrequin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e930cc0-17f3-489c-bb96-8f36f6d1ad80",
                                "sense_id": "699eb0c9-35b0-3a86-84a4-f7204a2fcad1",
                                "text": "Les coussinets se sont collés au vilebrequin qui, de ce fait, ne pouvait plus vilebrequiner."
                            },
                            {
                                "example_id": "0c9fa44f-3ab8-46f6-ad0e-c3c5bd658c03",
                                "sense_id": "699eb0c9-35b0-3a86-84a4-f7204a2fcad1",
                                "text": "On retiendra donc qu'en l'état actuel des choses, et tant qu'une bonne somme d'argent n'aura pas été dépensée pour corriger ça, le vilebrequin ne sera plus à même de vilebrequiner"
                            },
                            {
                                "example_id": "3965aec9-e11e-4911-9ec7-f887201fcc41",
                                "sense_id": "699eb0c9-35b0-3a86-84a4-f7204a2fcad1",
                                "text": "Il faut rendre au bas moteur le rôle qui lui appartient c’est à dire de transformer un mouvement alternatif en mouvement rotatif, en clair l’embiellage doit embieller et le vilebrequin doit vilebrequiner."
                            }
                        ]
                    }
