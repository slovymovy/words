                    {
                        "sense_id": "5335dc7e-53d0-3204-adfb-6a6ee3877652",
                        "entry_id": "e961837b-e64d-38da-b9a2-aa39b8963e73",
                        "glosses": [
                            "Dated form of tick tock."
                        ],
                        "tags": [
                            "alt-of",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "44b58153-2787-4c9f-8ba5-85c4d46c39d2",
                                "sense_id": "5335dc7e-53d0-3204-adfb-6a6ee3877652",
                                "text": "A wild young fellow coming home late one night, heard, while he was putting the key into the lock, something on the ground that continually went ticktack, ticktack, ticktack. Stooping down he found it was a silver watch[…]"
                            },
                            {
                                "example_id": "549117c3-6a5b-4c11-8167-d88323257a09",
                                "sense_id": "5335dc7e-53d0-3204-adfb-6a6ee3877652",
                                "text": "Damn the thing, why didn't it stop – with its monotonous ticktack; ticktack; ticktack – he could feel it inside his head where it seemed to strike innumerable little blows, on a strained chord it was bent on snapping."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
