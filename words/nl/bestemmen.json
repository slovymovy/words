{
    "word_family": [
        "bestemming",
        "bestemmingsplan",
        "onbestemd"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0f5c3860-dd80-3392-8da3-990078d55c0c",
                    "sense_definition": "een bepaald doel of een specifieke functie voor iets aanwijzen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "doel_toewijzen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gemeente heeft de grond <w>bestemd</w> voor woningen.",
                            "target_lang_translations": {
                                "en": "The municipality has <w>designated</w> the land for housing.",
                                "ru": "Муниципалитет <w>отвёл</w> эту землю под жильё."
                            }
                        },
                        {
                            "text": "Na veel beraad is besloten het gebied te <w>bestemmen</w> tot natuurgebied.",
                            "target_lang_translations": {
                                "en": "After much deliberation, it was decided to <w>zone</w> the area as a nature reserve.",
                                "ru": "После долгих обсуждений было решено <w>придать</w> этой территории статус заповедника."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanwijzen",
                        "toewijzen",
                        "reserveren"
                    ],
                    "common_phrases": [
                        "bestemmen voor woningen",
                        "bestemmen tot natuurgebied"
                    ],
                    "target_lang_definitions": {
                        "en": "To designate or assign a specific purpose or function to something.",
                        "ru": "Определять конкретное назначение, цель или функцию для чего-либо."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to designate",
                                "target_lang_sense_clarification": "to officially assign a purpose"
                            },
                            {
                                "target_lang_word": "to earmark",
                                "target_lang_sense_clarification": "to set aside for a specific use"
                            },
                            {
                                "target_lang_word": "to zone",
                                "target_lang_sense_clarification": "specifically for land or urban planning"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "предназначать",
                                "target_lang_sense_clarification": "определять назначение или цель"
                            },
                            {
                                "target_lang_word": "отводить",
                                "target_lang_sense_clarification": "выделять участок земли или ресурсы"
                            },
                            {
                                "target_lang_word": "выделять",
                                "target_lang_sense_clarification": "резервировать под определенную задачу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a57cecc6-2d7e-37a0-bcda-ecfd00f95f20",
                    "sense_definition": "iets aan iemand toekennen of voor iemand reserveren",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "toekennen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze mooie bloemen <w>bestem</w> ik voor mijn vrouw.",
                            "target_lang_translations": {
                                "en": "I <w>intend</w> these beautiful flowers for my wife.",
                                "ru": "Эти прекрасные цветы я <w>предназначаю</w> для своей жены."
                            }
                        },
                        {
                            "text": "Dit boek is <w>bestemd</w> voor Nederland en Vlaanderen.",
                            "target_lang_translations": {
                                "en": "This book is <w>meant</w> for the Netherlands and Flanders.",
                                "ru": "Эта книга <w>предназначена</w> для Нидерландов и Фландрии."
                            }
                        }
                    ],
                    "synonyms": [
                        "toebedelen",
                        "toekennen"
                    ],
                    "common_phrases": [
                        "bestemd voor iemand",
                        "bestemd voor gebruik"
                    ],
                    "target_lang_definitions": {
                        "en": "To intend something for a specific person or group, or to reserve it for them.",
                        "ru": "Адресовать что-либо конкретному лицу, группе или резервировать для них."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to intend",
                                "target_lang_sense_clarification": "to be meant for someone"
                            },
                            {
                                "target_lang_word": "to destine",
                                "target_lang_sense_clarification": "to set apart for a specific recipient"
                            },
                            {
                                "target_lang_word": "to reserve",
                                "target_lang_sense_clarification": "to keep something for a particular person"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "предназначать",
                                "target_lang_sense_clarification": "адресовать кому-либо"
                            },
                            {
                                "target_lang_word": "назначать",
                                "target_lang_sense_clarification": "определять для кого-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7452f2fb-d0da-3875-8fa3-c8d5dce767e7",
                    "sense_definition": "door het lot of een hogere macht bepalen wat er zal gebeuren",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "lot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het lot had anders <w>bestemd</w> voor de jonge koning.",
                            "target_lang_translations": {
                                "en": "Fate had <w>ordained</w> otherwise for the young king.",
                                "ru": "Судьба иначе <w>распорядилась</w> молодым королем."
                            }
                        },
                        {
                            "text": "Zij voelde dat zij voor elkaar <w>bestemd</w> waren.",
                            "target_lang_translations": {
                                "en": "She felt that they were <w>destined</w> for each other.",
                                "ru": "Она чувствовала, что они были <w>созданы друг для друга</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "beschikken",
                        "voorbestemmen"
                    ],
                    "common_phrases": [
                        "voor elkaar bestemd"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak in lijdende vorm gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To be determined by fate or a higher power.",
                        "ru": "Определять судьбу или будущее волей судьбы или высших сил."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to destine",
                                "target_lang_sense_clarification": "to be fated or preordained"
                            },
                            {
                                "target_lang_word": "to ordain",
                                "target_lang_sense_clarification": "to be decreed by fate or deity"
                            },
                            {
                                "target_lang_word": "to fate",
                                "target_lang_sense_clarification": "to be meant to happen by destiny"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "предопределять",
                                "target_lang_sense_clarification": "решать судьбу заранее"
                            },
                            {
                                "target_lang_word": "уготавливать",
                                "target_lang_sense_clarification": "готовить кому-либо участь"
                            },
                            {
                                "target_lang_word": "судить",
                                "target_lang_sense_clarification": "быть сужденным судьбой"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}