                ],
                "senses": [
                    {
                        "sense_id": "d262536c-0e68-3e04-acc4-3109bc5a21d2",
                        "entry_id": "23eb4aa8-fad1-3260-90b3-e568e12e59b1",
                        "glosses": [
                            "Aprikose"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "25d30bf9-3c3c-4ce8-b464-a8b672c3a1e7",
                                "sense_id": "d262536c-0e68-3e04-acc4-3109bc5a21d2",
                                "text": "Aus Marillen kann man einen Obstschnaps herstellen."
                            },
                            {
                                "example_id": "16747232-0374-4c55-bb89-66f9ca00a887",
                                "sense_id": "d262536c-0e68-3e04-acc4-3109bc5a21d2",
                                "text": "„Am liebsten würde Hans Krenn ja jede Wachauer Marille einzeln auffangen, sobald sie reif vom Baum fällt. Denn die Marille, so sagt der begnadete Schnapsbrenner aus dem südlichen Waldviertel, ‚ist eine wahre Diva‘.“"
                            },
                            {
                                "example_id": "dd3ac247-c51f-427d-a613-f3ad310f347a",
                                "sense_id": "d262536c-0e68-3e04-acc4-3109bc5a21d2",
                                "text": "„Er ist Obmann des Vereins Wachauer Marille und bewirtschaftet nahe Aggsbach 1.200 Marillenbäume.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
