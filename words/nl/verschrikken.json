                    "sense_id": "044f035d-c079-362a-bc57-2481e5035264",
                    "sense_definition": "iemand plotseling bang maken of doen schrikken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "schrikken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De harde knal van de uitlaat deed de voorbijgangers <w>verschrikken</w>.",
                            "target_lang_translations": {
                                "en": "The loud bang from the exhaust <w>startled</w> the passers-by.",
                                "fr": "La forte détonation du pot d'échappement a fait <w>sursauter</w> les passants."
                            }
                        },
                        {
                            "text": "Je moet de vogels niet <w>verschrikken</w> als ze rustig in de tuin zitten te eten.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>frighten</w> the birds when they are quietly eating in the garden.",
                                "fr": "Tu ne dois pas <w>effaroucher</w> les oiseaux lorsqu'ils mangent paisiblement dans le jardin."
                            }
                        }
                    ],
                    "synonyms": [
                        "opschrikken",
                        "bang maken"
                    ],
                    "antonyms": [
                        "geruststellen",
                        "kalmeren"
                    ],
                    "common_phrases": [
                        "iemand verschrikken"
                    ],
                    "target_lang_definitions": {
                        "en": "To suddenly make someone afraid or cause them to startle",
                        "fr": "Faire peur ou effrayer soudainement quelqu'un"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "frighten",
                                "target_lang_sense_clarification": "to cause to feel fear or alarm"
                            },
                            {
                                "target_lang_word": "startle",
                                "target_lang_sense_clarification": "to cause a sudden shock or surprise"
                            },
                            {
                                "target_lang_word": "scare",
                                "target_lang_sense_clarification": "to make someone afraid"
                            },
                            {
                                "target_lang_word": "alarm",
                                "target_lang_sense_clarification": "to fill with sudden fear or anxiety"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "effrayer",
                                "target_lang_sense_clarification": "causer une peur subite"
                            },
                            {
                                "target_lang_word": "faire peur",
                                "target_lang_sense_clarification": "provoquer la peur"
                            },
                            {
                                "target_lang_word": "effaroucher",
                                "target_lang_sense_clarification": "faire fuir en effrayant, en particulier des animaux"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d279ee9-57bd-38ad-9eef-2f3f1056527a",
                    "sense_definition": "plotseling bang worden door een onverwachte gebeurtenis",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "schrikken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>verschrok</w> enorm toen de deur plotseling met een luide klap dichtsloeg.",
                            "target_lang_translations": {
                                "en": "I <w>was</w> terribly <w>startled</w> when the door suddenly slammed shut with a loud bang.",
                                "fr": "J'ai eu une <w>peur bleue</w> quand la porte a soudainement claqué avec fracas."
                            }
                        },
                        {
                            "text": "Zij is erg <w>verschrokken</w> van het slechte nieuws dat ze vanmorgen kreeg.",
                            "target_lang_translations": {
                                "en": "She was very <w>frightened</w> by the bad news she received this morning.",
                                "fr": "Elle a été très <w>secouée</w> par la mauvaise nouvelle qu'elle a reçue ce matin."
                            }
                        }
                    ],
                    "synonyms": [
                        "schrikken"
                    ],
                    "common_phrases": [
                        "erg verschrikken"
                    ],
                    "target_lang_definitions": {
