{
    "word_family": [
        "somberness",
        "somberly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "475f0346-b178-3549-a4b1-09383e5522d2",
                    "sense_definition": "Dark, gloomy, or dull in color or tone; grave, serious, or melancholy in mood.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mood_and_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The funeral was a <w>somber</w> occasion, with everyone dressed in dark colors and speaking in hushed tones.",
                            "target_lang_translations": {
                                "ru": "Похороны были <w>мрачным</w> событием: все были одеты в темные цвета и разговаривали приглушенными голосами.",
                                "pl": "Pogrzeb był <w>ponurą</w> uroczystością, na której wszyscy ubrani byli w ciemne kolory i rozmawiali przyciszonymi głosami."
                            }
                        },
                        {
                            "text": "He wore a <w>somber</w> expression after hearing the disappointing news about the project.",
                            "target_lang_translations": {
                                "ru": "У него было <w>угрюмое</w> выражение лица после того, как он услышал разочаровывающие новости о проекте.",
                                "pl": "Miał <w>posępny</w> wyraz twarzy po usłyszeniu rozczarowujących wieści o projekcie."
                            }
                        }
                    ],
                    "synonyms": [
                        "gloomy",
                        "grave",
                        "melancholy",
                        "solemn"
                    ],
                    "antonyms": [
                        "cheerful",
                        "bright"
                    ],
                    "common_phrases": [
                        "somber mood",
                        "somber expression",
                        "somber colors"
                    ],
                    "target_lang_definitions": {
                        "ru": "Темный, мрачный или тусклый по цвету или тону; серьезный, угрюмый или меланхоличный по настроению.",
                        "pl": "Ciemny, ponury lub przytłumiony pod względem koloru lub tonu; poważny, posępny lub melancholijny w nastroju."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мрачный",
                                "target_lang_sense_clarification": "о настроении, атмосфере или цвете"
                            },
                            {
                                "target_lang_word": "угрюмый",
                                "target_lang_sense_clarification": "о выражении лица или настроении"
                            },
                            {
                                "target_lang_word": "печальный",
                                "target_lang_sense_clarification": "грустный, меланхоличный"
                            },
                            {
                                "target_lang_word": "темный",
                                "target_lang_sense_clarification": "о цветах или тонах"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "ponury",
                                "target_lang_sense_clarification": "o nastroju, atmosferze lub kolorze"
                            },
                            {
                                "target_lang_word": "posępny",
                                "target_lang_sense_clarification": "o wyrazie twarzy lub usposobieniu"
                            },
                            {
                                "target_lang_word": "poważny",
                                "target_lang_sense_clarification": "o nastroju, uroczysty i smutny"
                            },
                            {
                                "target_lang_word": "ciemny",
                                "target_lang_sense_clarification": "o stonowanych, przygnębiających kolorach"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1f4dea3a-0c0f-3af4-830c-43ed2d06d880",
                    "sense_definition": "To make or become dark, gloomy, or serious.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "make_gloomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden bad news <w>sombered</w> the festive atmosphere of the party.",
                            "target_lang_translations": {
                                "ru": "Внезапная плохая новость <w>омрачила</w> праздничную атмосферу вечеринки.",
                                "pl": "Niespodziewana zła wiadomość <w>zmąciła</w> świąteczną atmosferę przyjęcia."
                            }
                        },
                        {
                            "text": "As the sky began to <w>somber</w> with heavy rain clouds, we decided to head back indoors.",
                            "target_lang_translations": {
                                "ru": "Когда небо начало <w>темнеть</w> от тяжелых дождевых туч, мы решили вернуться в дом.",
                                "pl": "Gdy niebo zaczęło <w>ciemnieć</w> od ciężkich chmur deszczowych, postanowiliśmy wrócić do środka."
                            }
                        }
                    ],
                    "synonyms": [
                        "darken",
                        "sadden"
                    ],
                    "antonyms": [
                        "brighten",
                        "cheer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать или становиться темным, мрачным или серьезным.",
                        "pl": "Czynić ciemnym, ponurym lub poważnym albo stawać się takim."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "омрачать",
                                "target_lang_sense_clarification": "делать мрачным, портить настроение"
                            },
                            {
                                "target_lang_word": "омрачаться",
                                "target_lang_sense_clarification": "становиться мрачным, темнеть"
                            },
                            {
                                "target_lang_word": "темнеть",
                                "target_lang_sense_clarification": "о небе или атмосфере"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zmącić",
                                "target_lang_sense_clarification": "popsuć, zakłócić nastrój"
                            },
                            {
                                "target_lang_word": "zachmurzyć",
                                "target_lang_sense_clarification": "o twarzy, niebie lub nastroju"
                            },
                            {
                                "target_lang_word": "posępnieć",
                                "target_lang_sense_clarification": "stawać się posępnym"
                            },
                            {
                                "target_lang_word": "ciemnieć",
                                "target_lang_sense_clarification": "stawać się ciemnym, mrocznym"
                            }
                        ]
                    }
                }
            ]
        }
    ]
