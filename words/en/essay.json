{
    "word_family": [
        "essayist",
        "essayistic"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5bd9b8cd-a871-3f47-b98b-2b591d1ddc72",
                    "sense_definition": "A written composition of moderate length, exploring a particular issue or subject.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "writing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher asked every student to write a short <w>essay</w> about their summer vacation.",
                            "target_lang_translations": {
                                "ru": "Учитель попросил каждого ученика написать короткое <w>сочинение</w> о летних каникулах.",
                                "tr": "Öğretmen her öğrenciden yaz tatilleri hakkında kısa bir <w>kompozisyon</w> yazmasını istedi."
                            }
                        },
                        {
                            "text": "She spent the entire weekend working on her college <w>essay</w> to ensure it was perfect.",
                            "target_lang_translations": {
                                "ru": "Она провела все выходные, работая над своим вступительным <w>эссе</w>, чтобы оно было идеальным.",
                                "tr": "Kusursuz olduğundan emin olmak için tüm hafta sonunu üniversite başvuru <w>denemesi</w> üzerinde çalışarak geçirdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "composition",
                        "paper",
                        "article",
                        "treatise"
                    ],
                    "common_phrases": [
                        "college essay",
                        "write an essay",
                        "essay collection",
                        "short essay"
                    ],
                    "target_lang_definitions": {
                        "ru": "Письменная работа среднего объема, посвященная определенной теме или вопросу.",
                        "tr": "Belirli bir konuyu veya sorunu inceleyen, orta uzunlukta yazılı kompozisyon."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эссе",
                                "target_lang_sense_clarification": "литературный жанр или вид работы"
                            },
                            {
                                "target_lang_word": "сочинение",
                                "target_lang_sense_clarification": "ученическая или творческая работа"
                            },
                            {
                                "target_lang_word": "очерк",
                                "target_lang_sense_clarification": "небольшое произведение с изложением фактов"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "deneme",
                                "target_lang_sense_clarification": "edebi tür veya düşünce yazısı"
                            },
                            {
                                "target_lang_word": "kompozisyon",
                                "target_lang_sense_clarification": "öğrenci çalışması veya yazılı ödev"
                            },
                            {
                                "target_lang_word": "makale",
                                "target_lang_sense_clarification": "belirli bir konuda yazılmış inceleme yazısı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe011b6c-c9b5-3c60-beb9-37cbecad23ce",
                    "sense_definition": "An initial attempt or effort to do something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attempt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His first <w>essay</w> at public speaking was met with polite but hesitant applause.",
                            "target_lang_translations": {
                                "ru": "Его первая <w>попытка</w> публичного выступления была встречена вежливыми, но нерешительными аплодисментами.",
                                "tr": "Topluluk önünde konuşma konusundaki ilk <w>girişimi</w> kibar ama tereddütlü alkışlarla karşılandı."
                            }
                        },
                        {
                            "text": "This project represents our first <w>essay</w> into the international market.",
                            "target_lang_translations": {
                                "ru": "Этот проект представляет собой нашу первую <w>пробу</w> сил на международном рынке.",
                                "tr": "Bu proje, uluslararası pazara ilk <w>adımımızı</w> temsil ediyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "attempt",
                        "endeavor",
                        "trial",
                        "effort"
                    ],
                    "common_phrases": [
                        "first essay"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Первоначальная попытка или усилие сделать что-либо.",
                        "tr": "Bir şeyi yapmak için yapılan ilk girişim veya çaba."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "попытка",
                                "target_lang_sense_clarification": "старание сделать что-то впервые"
                            },
                            {
                                "target_lang_word": "проба",
                                "target_lang_sense_clarification": "первый опыт в чем-либо"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "girişim",
                                "target_lang_sense_clarification": "bir işe başlama çabası"
                            },
                            {
                                "target_lang_word": "deneme",
                                "target_lang_sense_clarification": "ilk tecrübe veya çaba"
                            },
                            {
                                "target_lang_word": "teşebbüs",
                                "target_lang_sense_clarification": "resmi veya edebi anlamda ilk adım"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8993071c-d925-3a45-af65-8addf409f367",
                    "sense_definition": "A proposed design for a postage stamp or a banknote that was not officially issued.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "design",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rare stamp <w>essay</w> was sold at the auction for a surprisingly high price.",
                            "target_lang_translations": {
                                "ru": "Редкое <w>эссе</w> марки было продано на аукционе по удивительно высокой цене.",
                                "tr": "Nadir pul <w>deneme baskısı</w> açık artırmada şaşırtıcı derecede yüksek bir fiyata satıldı."
                            }
                        },
                        {
                            "text": "Collectors often look for an <w>essay</w> to see the artist's original vision for the currency.",
                            "target_lang_translations": {
                                "ru": "Коллекционеры часто ищут <w>пробный оттиск</w>, чтобы увидеть первоначальный замысел художника для валюты.",
                                "tr": "Koleksiyoncular, sanatçının para birimi için orijinal vizyonunu görmek adına genellikle bir <w>taslak baskı</w> ararlar."
                            }
                        }
                    ],
                    "synonyms": [
                        "proof",
                        "trial"
                    ],
                    "common_phrases": [
                        "stamp essay"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in philately and numismatics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проект дизайна почтовой марки или банкноты, который не был официально выпущен.",
                        "tr": "Resmi olarak basılmamış bir posta pulu veya banknot tasarım taslağı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эссе",
                                "target_lang_sense_clarification": "термин в филателии"
                            },
                            {
                                "target_lang_word": "пробный оттиск",
                                "target_lang_sense_clarification": "неутвержденный дизайн"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "deneme baskısı",
                                "target_lang_sense_clarification": "filatelide henüz onaylanmamış pul tasarımı"
                            },
                            {
                                "target_lang_word": "taslak",
                                "target_lang_sense_clarification": "resmi olmayan tasarım"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d05dcdd5-27f2-32d5-b8dc-c175cf8e0762",
                    "sense_definition": "A test or experiment to determine the quality or nature of something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "test",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist performed an <w>essay</w> to check the purity of the gold sample.",
                            "target_lang_translations": {
                                "ru": "Ученый провел <w>анализ</w>, чтобы проверить чистоту образца золота.",
                                "tr": "Bilim insanı, altın numunesinin saflığını kontrol etmek için bir <w>analiz</w> gerçekleştirdi."
                            }
                        },
                        {
                            "text": "Before the final production, they conducted a small <w>essay</w> of the new chemical process.",
                            "target_lang_translations": {
                                "ru": "Перед окончательным запуском производства они провели небольшое <w>испытание</w> нового химического процесса.",
                                "tr": "Son üretimden önce, yeni kimyasal sürecin küçük bir <w>denemesini</w> gerçekleştirdiler."
                            }
                        }
                    ],
                    "synonyms": [
                        "assay",
                        "test",
                        "trial"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "now more commonly spelled as assay"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытание или эксперимент для определения качества или природы чего-либо.",
                        "tr": "Bir şeyin niteliğini veya yapısını belirlemek için yapılan test veya deney."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "анализ",
                                "target_lang_sense_clarification": "проверка состава или чистоты"
                            },
                            {
                                "target_lang_word": "проба",
                                "target_lang_sense_clarification": "испытание образца"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "analiz",
                                "target_lang_sense_clarification": "saflık veya kalite kontrol testi"
                            },
                            {
                                "target_lang_word": "deneme",
                                "target_lang_sense_clarification": "test veya deney"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2a257c6e-a37e-34c8-aad1-2566b8d16149",
                    "sense_definition": "To attempt or try to do something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attempt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mountain climber decided to <w>essay</w> the difficult peak despite the worsening weather.",
                            "target_lang_translations": {
                                "ru": "Альпинист решил <w>попытаться</w> покорить сложную вершину, несмотря на ухудшающуюся погоду.",
                                "tr": "Dağcı, kötüleşen havaya rağmen zorlu zirveye tırmanmayı <w>dene meye</w> karar verdi."
                            }
                        },
                        {
                            "text": "She would <w>essay</w> a smile even though she felt quite nervous about the interview.",
                            "target_lang_translations": {
                                "ru": "Она <w>попыталась</w> улыбнуться, хотя очень нервничала из-за собеседования.",
                                "tr": "Mülakat konusunda oldukça gergin hissetmesine rağmen gülümsemeye <w>yeltenecekti</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "attempt",
                        "try",
                        "undertake",
                        "endeavor"
                    ],
                    "common_phrases": [
                        "essay a smile",
                        "essay a task"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary or formal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пытаться или пробовать сделать что-либо (в книжном стиле).",
                        "tr": "Bir şeyi yapmaya kalkışmak veya denemek (edebi kullanımı)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пытаться",
                                "target_lang_sense_clarification": "делать попытку"
                            },
                            {
                                "target_lang_word": "предпринимать",
                                "target_lang_sense_clarification": "пробовать совершить действие"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yeltenmek",
                                "target_lang_sense_clarification": "bir şeye kalkışmak"
                            },
                            {
                                "target_lang_word": "girişmek",
                                "target_lang_sense_clarification": "bir işi yapmayı denemek"
                            },
                            {
                                "target_lang_word": "denelemek",
                                "target_lang_sense_clarification": "yapmayı denemek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "378f6121-4a98-3ed5-91e1-6414e534b6c3",
                    "sense_definition": "To move forth or sally out, especially in a military context.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knights prepared to <w>essay</w> forth from the castle gates at dawn.",
                            "target_lang_translations": {
                                "ru": "Рыцари приготовились <w>выступить</w> из ворот замка на рассвете.",
                                "tr": "Şövalyeler şafak vakti kale kapılarından dışarı <w>huruç etmeye</w> hazırlandı."
                            }
                        },
                        {
                            "text": "The troops would <w>essay</w> out to meet the enemy on the open field.",
                            "target_lang_translations": {
                                "ru": "Войска должны были <w>выйти</w> навстречу врагу в открытом поле.",
                                "tr": "Birlikler açık alanda düşmanla karşılaşmak için dışarı <w>atılacaktı</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "sally",
                        "venture"
                    ],
                    "antonyms": [
                        "retreat"
                    ],
                    "common_phrases": [
                        "essay forth"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выступать или совершать вылазку, особенно в военном контексте (архаизм).",
                        "tr": "Özellikle askeri bağlamda dışarı çıkmak veya huruç etmek (eski dil)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выступать",
                                "target_lang_sense_clarification": "выходить в поход"
                            },
                            {
                                "target_lang_word": "совершать вылазку",
                                "target_lang_sense_clarification": "выходить против врага"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "huruç etmek",
                                "target_lang_sense_clarification": "kaleden dışarı çıkıp saldırmak"
                            },
                            {
                                "target_lang_word": "ileri atılmak",
                                "target_lang_sense_clarification": "düşmana karşı harekete geçmek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}