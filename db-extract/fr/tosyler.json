                                "example_id": "c614b5db-63d3-4d3b-8b0a-a7e8744afc19",
                                "sense_id": "98f35773-1234-3868-ac48-6f51744e6f66",
                                "text": "TMSCl protège l’alcool (à ne pas confondre avec TsCl pour tosyler)"
