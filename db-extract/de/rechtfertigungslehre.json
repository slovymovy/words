                ],
                "senses": [
                    {
                        "sense_id": "bec15432-505a-38e0-9ee0-7d68eb02850a",
                        "entry_id": "8ece7c61-8bf2-3381-9b8f-a3859ad02b06",
                        "glosses": [
                            "protestantische Lehre, die sich mit der Frage beschäftigt, unter welchen Voraussetzungen das durch Sünde belastete Verhältnis zwischen Mensch und Gott wieder versöhnt werden könne"
                        ],
                        "tags": [
                            "Theologie"
                        ],
                        "examples": [
                            {
                                "example_id": "b2166b1c-d70c-448a-b300-563cb72c0514",
                                "sense_id": "bec15432-505a-38e0-9ee0-7d68eb02850a",
                                "text": "„Im Zentrum der Theologie Martin Luthers steht die Rechtfertigungslehre.“"
                            },
                            {
                                "example_id": "2f510f15-9ba8-4317-9041-ba64a4e35ef4",
                                "sense_id": "bec15432-505a-38e0-9ee0-7d68eb02850a",
                                "text": "„So befreiend sich die Rechtfertigungslehre auf die Psyche von Menschen auswirken kann, so gibt es doch auch zahlreiche Menschen, die unter ihrem Glauben leiden.“"
                            },
                            {
                                "example_id": "b6066d04-18dc-4b4f-bda3-99fbbb493d2f",
                                "sense_id": "bec15432-505a-38e0-9ee0-7d68eb02850a",
                                "text": "„Diese Eigenart des Urchristentums als Bekehrungsreligion bildete gewissermaßen den Entdeckungszusammenhang der paulinischen Rechtfertigungslehre und der für sie charakteristischen Anthropologie.“"
                            },
                            {
                                "example_id": "a58b742f-9e9c-4585-b173-a1f4a0371aab",
                                "sense_id": "bec15432-505a-38e0-9ee0-7d68eb02850a",
                                "text": "„Seitdem haben sich zwei unterschiedliche Rechtfertigungslehren auf katholischer und evangelischer Seite entwickelt, die sich u.a. in Tridentinum und Confessio Augustana niederschlugen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
