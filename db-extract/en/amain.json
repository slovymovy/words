                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b07cd61-c1bc-4b79-bf1c-a41a5ff8673e",
                        "source_entry_id": "97fce729-e78d-3993-8bfa-41790f3b64cf",
