                                                "example_id": "7a7b9635-48bc-42d3-9714-b06821f8d06b",
                                                "sense_id": "01921680-ef7b-36f8-858b-48228b41600a",
                                                "text": "„Frühnebel wabern noch auf den Feldern, sammeln sich in den Senken und unter den Hecken, die die Felder parzelleiren.“"
                                            }
                                        ],
