                            {
                                "example_id": "aa31cf07-28b5-4c05-8602-83ea0643ce19",
                                "sense_id": "b8d1496e-0c93-385a-a124-c4f23eb73411",
                                "text": "De schrijver beschrijft op precieuze wijze de voorwerpen."
                            }
                        ]
                    },
                    {
                        "sense_id": "d4299eb2-7e6c-3b1a-a2c2-e935d4d6414e",
                        "entry_id": "f9ee6d4b-e240-3070-97e2-2987aa700c98",
                        "glosses": [
                            "kostbaar"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "cca1b676-2137-30fa-8f80-f47b407ac921",
                        "entry_id": "f9ee6d4b-e240-3070-97e2-2987aa700c98",
                        "glosses": [
                            "bekakt, gemaakt deftig, overdreven fijnzinnig"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "8eadf470-ffea-4b01-9d7e-186c745438e2",
                                "sense_id": "cca1b676-2137-30fa-8f80-f47b407ac921",
                                "text": "Achter het raam zaten twee dames met precieuze gebaartjes thee te drinken."
                            },
                            {
                                "example_id": "f16016aa-a78a-4bd6-a95e-178adaeee46f",
                                "sense_id": "cca1b676-2137-30fa-8f80-f47b407ac921",
                                "text": "Meneer de wijnkenner. Gaat straks precieus zitten nippen aan mousserende vuiligheid, die de kruidenier nog niet voor een knaak zou durven verkopen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dde7c9c2-b7db-4395-b792-e35a5a87131f",
                        "source_entry_id": "f9ee6d4b-e240-3070-97e2-2987aa700c98",
                        "source_sense_id": "b8d1496e-0c93-385a-a124-c4f23eb73411",
                        "source_sense_description": "nauwkeurig, verfijnd",
                        "target_lang_word": "precious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "precious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4e1c128-cb20-3e32-820a-d41afbea3c2d",
                                        "entry_id": "febba2b8-e730-3693-bb40-7298bbace7c8",
                                        "glosses": [
                                            "Of high value or worth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1437c237-98a2-472d-94e3-949b979e84b2",
                                                "sense_id": "c4e1c128-cb20-3e32-820a-d41afbea3c2d",
                                                "text": "People are a good thing, the most precious resource in a rich economy, so the progressive-minded feel. Only misanthropists disagree or the dottier Malthusians who send green-ink tweets deploring any state assistance for child-rearing."
                                            },
                                            {
                                                "example_id": "c8b495a7-ace4-4f20-9044-d7b9167ad041",
                                                "sense_id": "c4e1c128-cb20-3e32-820a-d41afbea3c2d",
                                                "text": "The crown had many precious gemstones. This building work needs site access, and tell the city council that I don't care about a few lorry tyre ruts across their precious grass verge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8355c347-8580-39ba-a925-6bf059039b0d",
                                        "entry_id": "febba2b8-e730-3693-bb40-7298bbace7c8",
                                        "glosses": [
                                            "Regarded with love or tenderness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "beb5aca3-800c-405d-bde2-782510713e7d",
                                                "sense_id": "8355c347-8580-39ba-a925-6bf059039b0d",
                                                "text": "The way my partner looks at me is just so precious."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96b0cb4a-f6a6-3354-ab29-e66de11fa969",
                                        "entry_id": "febba2b8-e730-3693-bb40-7298bbace7c8",
                                        "glosses": [
                                            "Treated with too much reverence."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c6db09c-6079-4f72-b243-bdbfc0b5a92f",
                                                "sense_id": "96b0cb4a-f6a6-3354-ab29-e66de11fa969",
                                                "text": "He spent hours painting the eyes of the portrait, which his fellow artists regarded as a bit precious."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4513584f-5370-3843-9407-70792f6109f7",
                                        "entry_id": "febba2b8-e730-3693-bb40-7298bbace7c8",
                                        "glosses": [
                                            "Excessively complicated."
                                        ],
                                        "tags": [
                                            "ironic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8c8bde72-af6f-3152-b63a-235f49af0b41",
                                        "entry_id": "febba2b8-e730-3693-bb40-7298bbace7c8",
                                        "glosses": [
                                            "Extremely protective or strict (about something)."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96e0d2c2-571d-4687-a5a2-2503b4d73616",
                                                "sense_id": "8c8bde72-af6f-3152-b63a-235f49af0b41",
                                                "text": "Writers are often very precious about their work."
                                            },
                                            {
                                                "example_id": "305491b4-dc16-4de8-bc8f-1aded5ec359a",
                                                "sense_id": "8c8bde72-af6f-3152-b63a-235f49af0b41",
                                                "text": "Pro chefs can be very precious about their kit. Watch a bartender trying to borrow a simple, cheap fruit-knife from the kitchen and you'll see what I mean."
                                            },
                                            {
                                                "example_id": "03068a68-e932-46ab-ad75-5c716e8d1918",
                                                "sense_id": "8c8bde72-af6f-3152-b63a-235f49af0b41",
                                                "text": "Well, I didn't realize it until almost after the fact. I wrote all these songs very quickly; I did a whole lot of material and wasn't too precious about it. The lyric writing was done in much the same way. I wrote stuff and sang it, and the demos stuck, which is different from what I've done before, when I edited it."
                                            },
                                            {
                                                "example_id": "16026958-8130-4e24-b7b4-4a679025c981",
                                                "sense_id": "8c8bde72-af6f-3152-b63a-235f49af0b41",
                                                "text": "Hearing what a struggle it was for her, I began to understand why some people are so precious about being Irish. Being second-generation Irish, she had the option to hide behind her accent. Instead she would thump her fist to defend Irish people from those speaking out against them."
                                            },
                                            {
                                                "example_id": "a5da088b-be0b-40a0-8f32-1930e79f8437",
                                                "sense_id": "8c8bde72-af6f-3152-b63a-235f49af0b41",
                                                "text": "The course is not precious about overly academic sources, either. ¶ \"The students are confused when I tell them to try and trace something down with a quick Wikipedia search, because they've been told not to do it,\" she [Christina Ladam] said. \"Not for research papers, but if you're trying to find out if a site is legitimate or if somebody has a history as a conspiracy theorist and you show them how to follow the page's citation, it's quick and effective, which means it's more likely to be used.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06f6260d-a2f1-3f74-881e-f4dc1cd7c878",
                                        "entry_id": "febba2b8-e730-3693-bb40-7298bbace7c8",
                                        "glosses": [
                                            "Blasted; damned."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21bfd846-a193-45a7-b4d7-17598890bbd1",
                                                "sense_id": "06f6260d-a2f1-3f74-881e-f4dc1cd7c878",
                                                "text": "It’s all owing to your precious caution that they got hold of it. If you had let me burn it, and taken my word that it was gone, it would have been a heap of ashes behind the fire, instead of being whole and sound, inside of my great-coat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4c4f9db-f55e-3f86-9866-c8660e3df8dd",
                                        "entry_id": "febba2b8-e730-3693-bb40-7298bbace7c8",
                                        "glosses": [
                                            "Contrived to be cute or charming."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0afc818-8df0-45dc-9dd8-b555ccd99ae0",
                                                "sense_id": "f4c4f9db-f55e-3f86-9866-c8660e3df8dd",
                                                "text": "In the abstract, Stuhlbarg’s twinkly-eyed sidekick suggests Joe Pesci in Lethal Weapon 2 by way of late-period Robin Williams with an alien twist, but Stuhlbarg makes a character that easily could have come across as precious into a surprisingly palatable, even charming man."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9759cc93-3d2c-34b4-b515-da9d8af3a32c",
                                        "entry_id": "febba2b8-e730-3693-bb40-7298bbace7c8",
                                        "glosses": [
                                            "Thorough; utter."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cf4c6a8-9c0c-4c96-a55f-5c7060bb269b",
                                                "sense_id": "9759cc93-3d2c-34b4-b515-da9d8af3a32c",
                                                "text": "a precious rascal"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "precious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4dc47a7e-663b-3cac-814c-8f7e3dea3d9e",
                                        "entry_id": "bbc56882-dbf5-3d90-ac7e-a30f2135b4bd",
                                        "glosses": [
                                            "Someone (or something) who is loved; a darling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cbf0721-f4cf-42fa-a3b0-89444da26de6",
                                                "sense_id": "4dc47a7e-663b-3cac-814c-8f7e3dea3d9e",
                                                "text": "“It isn't fair, my precious, is it, to ask us what it's got in its nassty little pocketses?”"
                                            },
                                            {
                                                "example_id": "ec96e562-df4d-4bb8-861d-4459d2ebaede",
                                                "sense_id": "4dc47a7e-663b-3cac-814c-8f7e3dea3d9e",
                                                "text": "She sat down with the dogs in her lap. \"I won't neglect you for any one, will I, my preciouses?\""
                                            },
                                            {
                                                "example_id": "94eb7db1-e22c-4cf2-91fd-b1779c1e5762",
                                                "sense_id": "4dc47a7e-663b-3cac-814c-8f7e3dea3d9e",
                                                "text": "What'll it take to get it through to you precious?\nI'm over this, why do you wanna throw it away like this?\nSuch a mess, why would I want to watch you?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "precious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "709fdd51-50ff-3beb-8639-140117fb9ffa",
                                        "entry_id": "3acc34d2-020e-3cc1-b6d0-d1f5594b6b35",
                                        "glosses": [
                                            "Very; an intensifier."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b9d1b1c-b599-4898-8a15-edb5eb3b33f1",
                                                "sense_id": "709fdd51-50ff-3beb-8639-140117fb9ffa",
                                                "text": "There is precious little we can do."
                                            },
                                            {
                                                "example_id": "bf8926bd-f7b6-49bf-b029-f1d384b7be9c",
                                                "sense_id": "709fdd51-50ff-3beb-8639-140117fb9ffa",
                                                "text": "precious few pictures of him exist"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0993130f-8bd7-42d2-9e70-0f04ff3fc022",
                        "source_entry_id": "f9ee6d4b-e240-3070-97e2-2987aa700c98",
                        "source_sense_id": "b8d1496e-0c93-385a-a124-c4f23eb73411",
                        "source_sense_description": "nauwkeurig, verfijnd",
                        "target_lang_word": "précieux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "précieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "04b9587c-2f2b-3d28-a74c-dc5bfc9ecd84",
                                        "entry_id": "f5d22391-7813-31ec-8fab-dbf094d77906",
                                        "glosses": [
                                            "Qui est de grand prix."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23e73a3f-7603-48ed-a83b-53f9f3b21ebb",
                                                "sense_id": "04b9587c-2f2b-3d28-a74c-dc5bfc9ecd84",
                                                "text": "Les peuples préhistoriques ont eu des conventions monétaires, de coquillages, pierres, pépites ou lingots de métaux précieux, de valeur intrinsèque relative constante, pour acheter des objets moins portatifs dont le possesseur était titulaire. C'était des constitutions financières démocratiques de l'âge d'or."
                                            },
                                            {
                                                "example_id": "0f2e6642-5e5c-4fa3-8193-6f01a6b1cdac",
                                                "sense_id": "04b9587c-2f2b-3d28-a74c-dc5bfc9ecd84",
                                                "text": "Une étoffe précieuse."
                                            },
                                            {
                                                "example_id": "f6071426-0eda-4c9e-a361-93faca86a6a3",
                                                "sense_id": "04b9587c-2f2b-3d28-a74c-dc5bfc9ecd84",
                                                "text": "Des meubles précieux."
                                            },
                                            {
                                                "example_id": "cab4ab3b-74fc-4864-ab95-ff1c48dd7af2",
                                                "sense_id": "04b9587c-2f2b-3d28-a74c-dc5bfc9ecd84",
                                                "text": "Cet ouvrage, que la matière et le travail rendent également précieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b12958c-1af7-3ede-ab25-7d27488571db",
                                        "entry_id": "f5d22391-7813-31ec-8fab-dbf094d77906",
                                        "glosses": [
                                            "Qualifie les choses dont on peut tirer une grande utilité, un grand profit."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e14a5889-b096-4896-a178-6b3d7fbf64cc",
                                                "sense_id": "1b12958c-1af7-3ede-ab25-7d27488571db",
                                                "text": "Il ne disait pas encore , comme Franklin, que « le temps, c'est de l'argent », mais ce principe s'appliquait déjà en un sens spirituel : le temps est infiniment précieux parce que toute heure de travail perdue était une heure de moins au service de la gloire de Dieu."
                                            },
                                            {
                                                "example_id": "bff422e8-738e-4fd7-8822-c210622b95eb",
                                                "sense_id": "1b12958c-1af7-3ede-ab25-7d27488571db",
                                                "text": "A cette occasion, il me revient à l'esprit certain passage de Marcel Schwob, cet admirable artiste qu'il est toujours précieux de relire […]."
                                            },
                                            {
                                                "example_id": "1f998816-725a-4393-ac63-0d10b94ddacf",
                                                "sense_id": "1b12958c-1af7-3ede-ab25-7d27488571db",
                                                "text": "Les moments sont précieux, pour faire réussir ce dont il s’agit, il n’y a point de temps à perdre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be86a2e7-f1d3-3028-a54c-63d9924912fe",
                                        "entry_id": "f5d22391-7813-31ec-8fab-dbf094d77906",
                                        "glosses": [
                                            "Se dit de tout ce qui nous est cher et dont nous faisons un cas particulier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dca2db7a-c3ef-4367-be78-cf72e4c21844",
                                                "sense_id": "be86a2e7-f1d3-3028-a54c-63d9924912fe",
                                                "text": "Madame Hanson a la gracieuseté de nous apporter des fleurs, la chose la plus précieuse qu'elle puisse nous offrir sous ce triste climat; […]."
                                            },
                                            {
                                                "example_id": "e5a123ba-0039-435f-8640-c93754bfb756",
                                                "sense_id": "be86a2e7-f1d3-3028-a54c-63d9924912fe",
                                                "text": "Avec la pénurie de gel hydroalcoolique liée à l'épidémie du coronavirus, l'alcool est devenue une denrée précieuse."
                                            },
                                            {
                                                "example_id": "c0a6c17b-d0b2-42c0-89ee-b6ed4cda121a",
                                                "sense_id": "be86a2e7-f1d3-3028-a54c-63d9924912fe",
                                                "text": "Je garde cette lettre comme un gage précieux de son amitié."
                                            },
                                            {
                                                "example_id": "582248cc-38f9-4ac4-bb18-4f45e1c21d62",
                                                "sense_id": "be86a2e7-f1d3-3028-a54c-63d9924912fe",
                                                "text": "Sa vie est précieuse à l’état, à sa famille."
                                            },
                                            {
                                                "example_id": "24657e5f-9c02-43f3-916f-4d04ffe0a45e",
                                                "sense_id": "be86a2e7-f1d3-3028-a54c-63d9924912fe",
                                                "text": "Conservez cette tête précieuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9acb9e8-7a20-3d4f-806b-39d256671794",
                                        "entry_id": "f5d22391-7813-31ec-8fab-dbf094d77906",
                                        "glosses": [
                                            "Se dit de tout ce qui nous est cher et dont nous faisons un cas particulier.",
                                            "Les écritures disent dans le même sens :"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76994b57-6716-49d3-903a-6b749293d4ed",
                                                "sense_id": "f9acb9e8-7a20-3d4f-806b-39d256671794",
                                                "text": "La mort des saints est précieuse devant Dieu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b670541d-15cc-31fe-9a11-5d40c749ede5",
                                        "entry_id": "f5d22391-7813-31ec-8fab-dbf094d77906",
                                        "glosses": [
                                            "Ce qui est d’une délicatesse extrême."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3c253d5-624e-4d93-b117-7a9a05b34491",
                                                "sense_id": "b670541d-15cc-31fe-9a11-5d40c749ede5",
                                                "text": "Une belle idée qui donna beaucoup de vie aux façades et de précieux !"
                                            },
                                            {
                                                "example_id": "ddefc894-3701-427e-8077-302416095480",
                                                "sense_id": "b670541d-15cc-31fe-9a11-5d40c749ede5",
                                                "text": "Ce tableau est d’un fini précieux."
                                            },
                                            {
                                                "example_id": "3be3c595-8fc0-413c-a0bd-ab5415bf128c",
                                                "sense_id": "b670541d-15cc-31fe-9a11-5d40c749ede5",
                                                "text": "Ce bijou est d’un travail précieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ac9c91b-d5bb-3d0b-a37d-9062f0d42984",
                                        "entry_id": "f5d22391-7813-31ec-8fab-dbf094d77906",
                                        "glosses": [
                                            "Qui est recherché, affecté, qui manque de simplicité, de naturel."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1f73870-e461-4057-a83c-5c8ed23889f9",
                                                "sense_id": "9ac9c91b-d5bb-3d0b-a37d-9062f0d42984",
                                                "text": "Il a des manières précieuses, un air précieux."
                                            },
                                            {
                                                "example_id": "423d5457-6c5d-4e51-88a4-19351de9ccfa",
                                                "sense_id": "9ac9c91b-d5bb-3d0b-a37d-9062f0d42984",
                                                "text": "Il parle un langage précieux."
                                            },
                                            {
                                                "example_id": "8b1785ab-1c12-40b6-b43d-4c8c97b7aefd",
                                                "sense_id": "9ac9c91b-d5bb-3d0b-a37d-9062f0d42984",
                                                "text": "Style précieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb476ac3-8544-3039-a68c-084594514818",
                                        "entry_id": "f5d22391-7813-31ec-8fab-dbf094d77906",
                                        "glosses": [
                                            "Relatif à une essence relativement rare, car tolérant mal la présence proche d’autres pieds de même essence (essence asociale), poussant donc isolément."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88b8c8ad-8624-441c-92a5-4a5124ef3200",
                                                "sense_id": "cb476ac3-8544-3039-a68c-084594514818",
                                                "text": "Ces dégagements doivent être réalisés également au profit de feuillus précieux s’ils sont rares, mais de façon mesurée pour le frêne, l’érable et le merisier afin d’éviter qu’ils ne se développent trop vite au-dessus des chênes et forment des houppiers qui auront ensuite du mal à s’élaguer. Il est préférable de favoriser ces essences en groupe plutôt qu’en individus isolés."
                                            }
                                        ]
                                    }
                                ]
