{
    "word_family": [
        "fawn",
        "fawner",
        "fawningly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b647fb80-1d2e-37f7-924f-041b2eac6911",
                    "sense_definition": "Seeking favor by way of flattery; behaving in a servile or submissive way to gain approval.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "flattery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager was surrounded by <w>fawning</w> employees who laughed at every single one of his jokes.",
                            "target_lang_translations": {
                                "ru": "Менеджера окружали <w>подобострастные</w> сотрудники, которые смеялись над каждой его шуткой."
                            }
                        },
                        {
                            "text": "She found his <w>fawning</w> behavior quite pathetic and wished he would just speak his mind.",
                            "target_lang_translations": {
                                "ru": "Она находила его <w>угодливое</w> поведение довольно жалким и хотела, чтобы он просто говорил то, что думает."
                            }
                        }
                    ],
                    "synonyms": [
                        "obsequious",
                        "sycophantic",
                        "servile",
                        "flattering"
                    ],
                    "antonyms": [
                        "assertive",
                        "independent",
                        "disdainful"
                    ],
                    "common_phrases": [
                        "fawning",
                        "fawning"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стремящийся добиться расположения с помощью лести; ведущий себя подобострастно или покорно ради одобрения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подобострастный",
                                "target_lang_sense_clarification": "льстивый и раболепный"
                            },
                            {
                                "target_lang_word": "угодливый",
                                "target_lang_sense_clarification": "чрезмерно стремящийся угодить"
                            },
                            {
                                "target_lang_word": "льстивый",
                                "target_lang_sense_clarification": "содержащий похвалу ради выгоды"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9964afbe-cfa9-351c-b2be-9fe83996141d",
                    "sense_definition": "The present participle and gerund of <w>fawn</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog was <w>fawning</w> over its owner, wagging its tail and licking her hand.",
                            "target_lang_translations": {
                                "ru": "Собака <w>ласкалась</w> к хозяйке, виляя хвостом и лижа ей руку."
                            }
                        },
                        {
                            "text": "By <w>fawning</w> and flattery, he managed to convince the committee to approve his project.",
                            "target_lang_translations": {
                                "ru": "С помощью <w>заискивания</w> и лести ему удалось убедить комитет одобрить его проект."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fawning"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола «fawn» (ласкаться, лебезить)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лебезящий",
                                "target_lang_sense_clarification": "заискивающий перед кем-то"
                            },
                            {
                                "target_lang_word": "ласкающийся",
                                "target_lang_sense_clarification": "о животном, проявляющем привязанность"
                            },
                            {
                                "target_lang_word": "заискивающий",
                                "target_lang_sense_clarification": "старающийся понравиться"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1f32cdd9-da93-34bd-a980-bbb3033fdac4",
                    "sense_definition": "The act of giving servile flattery or showing excessive affection to gain favor.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "flattery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was tired of the constant <w>fawning</w> of his subordinates and longed for an honest conversation.",
                            "target_lang_translations": {
                                "ru": "Он устал от постоянного <w>подобострастия</w> своих подчиненных и жаждал честного разговора."
                            }
                        },
                        {
                            "text": "The court was full of feigned courtesies and <w>fawnings</w> from those seeking the king's attention.",
                            "target_lang_translations": {
                                "ru": "Двор был полон притворной вежливости и <w>заискиваний</w> со стороны тех, кто искал внимания короля."
                            }
                        }
                    ],
                    "synonyms": [
                        "sycophancy",
                        "obsequiousness",
                        "flattery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт рабской лести или проявление чрезмерной привязанности для получения выгоды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подобострастие",
                                "target_lang_sense_clarification": "рабская покорность и лесть"
                            },
                            {
                                "target_lang_word": "угодничество",
                                "target_lang_sense_clarification": "стремление во всем угождать"
                            },
                            {
                                "target_lang_word": "заискивание",
                                "target_lang_sense_clarification": "попытка добиться расположения лестью"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
