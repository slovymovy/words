                            {
                                "target_lang_word": "vrazit",
                                "target_lang_sense_clarification": "prudké nebo neopatrné umístění"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "795a7cc4-1a7e-3eef-9ffd-99f95c29f710",
                    "sense_definition": "To move a boat away from the shore or bank by pushing with an oar or pole.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fishermen grabbed their oars and <w>shoved</w> off from the dock.",
                            "target_lang_translations": {
                                "ru": "Рыбаки схватили весла и <w>отчалили</w> от пристани.",
                                "zh": "渔夫们抓起船桨，把船从码头<w>撑离岸边</w>了。",
                                "cs": "Rybáři popadli vesla a <w>odrazili</w> od mola."
                            }
                        },
                        {
                            "text": "We need to <w>shove</w> the raft into the deeper water.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>столкнуть</w> плот на глубину.",
                                "zh": "我们得把木筏<w>推离岸边</w>，进入更深的水域。",
                                "cs": "Musíme <w>odstrčit</w> vor do hlubší vody."
                            }
                        }
                    ],
                    "synonyms": [
                        "push off",
                        "launch"
                    ],
                    "common_phrases": [
                        "shove off",
                        "shove from shore"
