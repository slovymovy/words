            "senses": [
                {
                    "sense_id": "a61e9153-75f0-39b8-9820-edd22212b462",
                    "sense_definition": "Личное местоимение второго лица множественного числа; используется для обращения к нескольким лицам.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Куда <w>вы</w> идёте так поздно?",
                            "target_lang_translations": {
                                "en": "Where are <w>you</w> going so late?",
                                "nl": "Waar gaan <w>jullie</w> zo laat naartoe?",
                                "pl": "Dokąd <w>wy</w> idziecie tak późno?",
                                "de": "Wohin geht <w>ihr</w> so spät?",
                                "fr": "Où <w>vous</w> allez si tard ?",
                                "it": "Dove <w>andate</w> così tardi?",
                                "cs": "Kam <w>vy</w> jdete tak pozdě?",
                                "tr": "Bu kadar geç saatte nereye <w>siz</w> gidiyorsunuz?",
                                "es": "¿A dónde <w>van</w> tan tarde?",
                                "zh": "这么晚了，<w>你们</w>要去哪儿？"
                            }
                        },
                        {
                            "text": "<w>Вы</w> все должны внимательно слушать учителя.",
                            "target_lang_translations": {
                                "en": "<w>You</w> all must listen carefully to the teacher.",
                                "nl": "<w>Jullie</w> moeten allemaal aandachtig naar de leraar luisteren.",
                                "pl": "<w>Wy</w> wszyscy musicie uważnie słuchać nauczyciela.",
                                "de": "<w>Ihr</w> alle müsst dem Lehrer aufmerksam zuhören.",
                                "fr": "<w>Vous</w> devez tous écouter attentivement le professeur.",
                                "it": "<w>Voi</w> tutti dovete ascoltare attentamente l'insegnante.",
                                "cs": "<w>Vy</w> všichni musíte pozorně poslouchat učitele.",
                                "tr": "<w>Siz</w> hepiniz öğretmeni dikkatlice dinlemelisiniz.",
                                "es": "<w>Ustedes</w> todos deben escuchar atentamente al profesor.",
                                "zh": "<w>你们</w>大家都应该认真听老师讲课。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "вы все",
                        "кто вы",
                        "где вы"
                    ],
                    "target_lang_definitions": {
                        "en": "Second-person plural pronoun; used to address multiple people.",
                        "nl": "Persoonlijk voornaamwoord tweede persoon meervoud; gebruikt om meerdere personen aan te spreken.",
                        "pl": "Zaimek osobowy drugiej osoby liczby mnogiej; używany do zwracania się do grupy osób.",
                        "de": "Personalpronomen der zweiten Person Plural; wird verwendet, um mehrere Personen direkt anzusprechen.",
                        "fr": "Pronom personnel de la deuxième personne du pluriel ; utilisé pour s'adresser à plusieurs personnes.",
                        "it": "Pronome personale di seconda persona plurale; usato per rivolgersi a più persone.",
                        "cs": "Osobní zájmeno druhé osoby množného čísla; používá se pro oslovení více osob.",
                        "tr": "İkinci çoğul şahıs zamiri; birden fazla kişiye hitap etmek için kullanılır.",
                        "es": "Pronombre personal de segunda persona del plural; se utiliza para dirigirse a varias personas.",
                        "zh": "第二人称复数代词，用于称呼多个人。"
                    },
