                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The DJ played a mix of house and <w>trap</w> music.",
                            "target_lang_translations": {
                                "ru": "Диджей играл смесь хауса и <w>трэпа</w>.",
                                "zh": "DJ播放了一段浩室音乐和<w>陷阱音乐</w>的混音。"
                            }
                        },
                        {
                            "text": "Many modern pop songs use elements of <w>trap</w>.",
                            "target_lang_translations": {
                                "ru": "Многие современные поп-песни используют элементы <w>трэпа</w>.",
                                "zh": "许多现代流行歌曲都运用了<w>陷阱音乐</w>的元素。"
                            }
                        }
