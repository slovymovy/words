                "senses": [
                    {
                        "sense_id": "33fac7db-6875-3487-b6b3-b4ac3658e9bf",
                        "entry_id": "4cbe426a-e03c-376c-bde9-256829a7050d",
                        "glosses": [
                            "Schulbildung, die durch eine Grundschule vermittelt wird"
                        ],
                        "tags": [
                            "Bildung"
                        ],
                        "examples": [
                            {
                                "example_id": "54af72bf-ab13-4eae-8f32-b1e8b79b83e8",
                                "sense_id": "33fac7db-6875-3487-b6b3-b4ac3658e9bf",
                                "text": "„Merkel kennt die Lage am Tschad-See und die Quote der Kinder mit Grundschulbildung in Niger.“"
                            },
                            {
                                "example_id": "c8745fca-18ba-439c-b8f2-fbb07fe3b0f0",
                                "sense_id": "33fac7db-6875-3487-b6b3-b4ac3658e9bf",
                                "text": "„Für die Grundschulbildung werden die Anforderungen in einem integrativen Konzept ‚Grundschulbildung‘ beschrieben, für die Förderschule in einem eigenen Fachkonzept ‚Pädagogik der Förderschule/Sonderschule‘.“"
                            },
                            {
                                "example_id": "cbfb264a-c107-4afc-bbdd-f434d31854af",
                                "sense_id": "33fac7db-6875-3487-b6b3-b4ac3658e9bf",
                                "text": "„Dazu zählt zum Beispiel das Versprechen, die Zahl der absolut Armen - heute etwa 1,2 Millionen Menschen - um die Hälfte zu vermindern, jedem Kind eine Grundschulbildung zu ermöglichen, die Kindersterblichkeit um zwei Drittel zu reduzieren und die Ausbreitung des HI-Virus einzudämmen.“"
                            },
                            {
                                "example_id": "aff1890f-ea71-4689-825b-0558362d2139",
                                "sense_id": "33fac7db-6875-3487-b6b3-b4ac3658e9bf",
                                "text": "„Bei den Millenniums-Zielen hatte man sich noch auf die Grundschulbildung beschränkt.“"
                            },
                            {
                                "example_id": "de850c79-9f55-49c8-8171-3861bf694d39",
                                "sense_id": "33fac7db-6875-3487-b6b3-b4ac3658e9bf",
                                "text": "„Es gibt 800 Millionen Analphabeten auf der Welt und 100 Millionen Kinder ohne Zugang zu Grundschulbildung - das ist ein beachtlicher Markt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
