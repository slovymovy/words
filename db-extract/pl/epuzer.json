                ],
                "senses": [
                    {
                        "sense_id": "0e24bbbb-64e8-3b56-9625-ab4255ec094b",
                        "entry_id": "a06360c4-86d1-3ca5-8073-b5fa5a92fb15",
                        "glosses": [
                            "kandydat do małżeństwa, konkurent"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "418ef122-a7b2-45d8-a123-106ac518c0ed",
                                "sense_id": "0e24bbbb-64e8-3b56-9625-ab4255ec094b",
                                "text": "Dwie śliczne córki z góry skazane były na staropanieństwo, bo w całej Kowienszczyznie nie znalazłby się dostatecznie godny epuzer"
                            },
                            {
                                "example_id": "968aa071-6556-4c7a-a681-e67c12213bec",
                                "sense_id": "0e24bbbb-64e8-3b56-9625-ab4255ec094b",
                                "text": "Otrzymawszy ogładę damy z towarzystwa, stała się jednocześnie ofiarą społeczeństwa kastowego. (…) Dla młodych mężczyzn ze środowiska, które opuściła, była zbyt uczona, dla epuzerów ze środowiska, o którym marzyła, pozostała zbyt wielką prostaczką"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "64a4a011-a374-4ee4-804b-24f7716a8992",
                        "source_entry_id": "a06360c4-86d1-3ca5-8073-b5fa5a92fb15",
                        "source_sense_id": "0e24bbbb-64e8-3b56-9625-ab4255ec094b",
                        "target_lang_word": "suitor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suitor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83dac2ac-d90c-3207-b00d-e9cec04ab763",
                                        "entry_id": "28cb1188-460e-3968-8b81-4fb269cfcc48",
                                        "glosses": [
                                            "One who pursues someone, especially a woman, for a romantic relationship or marriage; a wooer; one who falls in love with or courts someone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2621bbf8-ec3f-4a0c-9df6-4f6c34a1657e",
                                                "sense_id": "83dac2ac-d90c-3207-b00d-e9cec04ab763",
                                                "text": "(Notice that \"Lysias\" begins from the realistic assumption that an attractive young man with many suitors will \"gratify\" one of them, the only question being which. Rightly or wrongly, he treats the question, \"Shall I at all?\" as already resolved.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "546e2a88-a85f-3e0c-b969-6bca69dd0063",
                                        "entry_id": "28cb1188-460e-3968-8b81-4fb269cfcc48",
                                        "glosses": [
                                            "A person or organization that expresses an interest in working with, or taking over, another."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3022a34-92e5-4a6e-ab48-4c7b6da5842f",
                                                "sense_id": "546e2a88-a85f-3e0c-b969-6bca69dd0063",
                                                "text": "[…] and Mortimer asserted he had no shortage of suitors ready, willing, and able to make acquisition loans […]"
                                            },
                                            {
                                                "example_id": "2eb4b99d-e94b-4ece-baf7-6d8d8a525000",
                                                "sense_id": "546e2a88-a85f-3e0c-b969-6bca69dd0063",
                                                "text": "The Betaville blog wrote earlier this week about market speculation that Adevinta was attracting takeover interest, without naming the suitors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2e5448d-d0e6-3b0e-b322-beae8736754f",
                                        "entry_id": "28cb1188-460e-3968-8b81-4fb269cfcc48",
                                        "glosses": [
                                            "A party to a suit or litigation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "19904872-cb01-37db-94fd-06feba9a9f9c",
                                        "entry_id": "28cb1188-460e-3968-8b81-4fb269cfcc48",
                                        "glosses": [
                                            "One who sues, petitions, solicits, or entreats; a petitioner."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "suitor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3633516a-133b-389f-b62c-daeaadf65433",
                                        "entry_id": "e2c57ad6-03b5-3d82-bd58-f257600a7f34",
                                        "glosses": [
                                            "To play the suitor; to woo; to make love."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51643bf3-a54c-41eb-bd78-ff05f817f375",
                        "source_entry_id": "a06360c4-86d1-3ca5-8073-b5fa5a92fb15",
                        "source_sense_id": "0e24bbbb-64e8-3b56-9625-ab4255ec094b",
                        "target_lang_word": "épouseur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "épouseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d55c617e-17e3-3fbf-84a4-fb39e8bfb98c",
                                        "entry_id": "6e52557b-7ba1-30c5-a57c-b956bc8765d8",
                                        "glosses": [
                                            "Celui qui est disposé à se marier et dont les intentions sont connues."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c748ac8-c3f8-4f0e-9c1a-660eef34e474",
                                                "sense_id": "d55c617e-17e3-3fbf-84a4-fb39e8bfb98c",
                                                "text": "Elvire de Charmois était une grosse personne assez bien faite, fraîche, et vêtue avec recherche, grâce aux soins de sa mère, qui la tenait toujours sous les armes, prête à passer la revue des épouseurs."
                                            },
                                            {
                                                "example_id": "2a948a49-5142-47cc-a305-cacf918d73d6",
                                                "sense_id": "d55c617e-17e3-3fbf-84a4-fb39e8bfb98c",
                                                "text": "Grâce à ses cinq millions de dot, elle ne manquait pas d’épouseurs ; mais, peu flattée, elle avait coutume de dire, avec son rire mauvais : « Pardi ! pour cinq millions, ils iraient en choisir une à la Salpêtrière. »"
                                            },
                                            {
                                                "example_id": "8daac27d-8558-408c-a757-0e97bd1c9874",
                                                "sense_id": "d55c617e-17e3-3fbf-84a4-fb39e8bfb98c",
                                                "text": "Pas une fille ne se serait mariée sans le consulter sur son épouseur."
                                            },
                                            {
                                                "example_id": "c7fd793f-bbe1-4a73-a9fb-361ea5637ea4",
                                                "sense_id": "d55c617e-17e3-3fbf-84a4-fb39e8bfb98c",
                                                "text": "En marchant à côté d’elle, il lui avait parlé de sa situation, de ses goûts, des économies qu’il avait faites ; puis il lui avait dit qu’elle serait sage de se marier, qu’elle lui plaisait beaucoup, qu’il se proposait comme épouseur enfin !"
                                            },
                                            {
                                                "example_id": "d60dbcc5-e375-4e5f-9f92-e3740294ebde",
                                                "sense_id": "d55c617e-17e3-3fbf-84a4-fb39e8bfb98c",
                                                "text": "Je me serais finalement épargné la réputation de déloyauté et d’imposture que la Morette m’imputa avec tout le crédit d’injures que les jeunes filles ont à leur disposition quand un épouseur échappe à leurs griffes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d68ba2b2-f52a-302c-adb0-7efe728346ce",
                                        "entry_id": "6e52557b-7ba1-30c5-a57c-b956bc8765d8",
                                        "glosses": [
                                            "Celui qui a pris parti pour une cause."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb526aa9-2193-4d76-915c-7a56adb4a385",
                                                "sense_id": "d68ba2b2-f52a-302c-adb0-7efe728346ce",
                                                "text": "Épouseur vigilant de toutes les querelles et prud’homme renommé pour la solidité de ses ailerons, il jouissait dans le populaire d’une considération de justicier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
