                    },
                    {
                        "translation_id": "9dc97ede-953e-43ad-b480-850eb4c31cad",
                        "source_entry_id": "721dbf68-2dd7-3f88-b596-18f6ef877ed0",
                        "source_sense_id": "6519ad9f-a827-3684-81fc-e4eaa430691f",
                        "target_lang_word": "antireligieux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antireligieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d8338ecc-101a-383b-b23f-112e00bdf4b1",
                                        "entry_id": "34b2dd7c-1f19-37ff-bc03-eb5dfcd89e03",
                                        "glosses": [
                                            "Qui est opposé à toute religion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e42dd6e-0392-4793-b3ab-48667b086f50",
                                                "sense_id": "d8338ecc-101a-383b-b23f-112e00bdf4b1",
                                                "text": "La lutte, de politique qu’elle était, devient antireligieuse."
                                            },
                                            {
                                                "example_id": "60b9e23b-fc53-4b25-aa03-5ede1b49aa71",
                                                "sense_id": "d8338ecc-101a-383b-b23f-112e00bdf4b1",
                                                "text": "Nous sommes en chemin vers une affirmation paradoxale : plus je suis croyant, moins je devrais le montrer. La laïcité est anticléricale et non antireligieuse, comme l’actera la loi de décembre 1905."
                                            },
                                            {
                                                "example_id": "1cbc279d-3a83-494e-a725-07b491e6418f",
                                                "sense_id": "d8338ecc-101a-383b-b23f-112e00bdf4b1",
                                                "text": "Un tel paradoxe, joint à une réserve plus grave sur le bien-fondé de la campagne antireligieuse menée en U.R.S.S., était de nature à actualiser et à valabiliser d’une manière frappante la discussion sur l’opportunité de mener, dans la mesure de nos moyens, une lutte analogue en France : je répète qu’entre nous cette discussion avait eu lieu la veille au soir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
