                                        "entry_id": "e6cb7064-066d-3282-8908-e115664ab81f",
                                        "glosses": [
                                            "Qui frustre, qui laisse un sentiment de manque, d'incomplétude, qui ne comble pas les désirs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44336c67-9d58-403e-8223-c471902ea958",
                                                "sense_id": "297a5d7c-137b-3d84-b4a6-88bac7bc33de",
                                                "text": "Cette audition a été frustrante pour tout le monde, la moitié des élèves n'ayant pas pu présenter leur travail par manque de temps."
                                            },
                                            {
                                                "example_id": "84e54f2d-f46e-4e06-8f91-9e4c4a5358f0",
                                                "sense_id": "297a5d7c-137b-3d84-b4a6-88bac7bc33de",
                                                "text": "Et cette grisaille qui dure depuis des mois... Si ça n'est pas frustrant, ça !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
