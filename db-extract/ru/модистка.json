                        "entry_id": "ba4aa65f-6596-3f78-98bc-52868ad28c1f",
                        "glosses": [
                            "устар. мастерица по изготовлению женских шляп, а также платья и белья"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4691af3a-3d41-4a7d-9ebe-c22d158fbf82",
                                "sense_id": "f20c864f-9fdb-399a-a41e-80239254c95e",
                                "text": "Для визитов Варвара заблаговременно заказала шляпу лучшей местной модистке."
                            }
                        ]
                    }
                ],
                "translations": [
