                ],
                "senses": [
                    {
                        "sense_id": "59b2a743-8061-32cc-9f54-3f254de39bb9",
                        "entry_id": "9989b6e9-aa1e-361d-875e-341d5b6c3c9c",
                        "glosses": [
                            "Vertreter der Gattung der Birken aus der Familie der Birkengewächse"
                        ],
                        "tags": [
                            "Betula",
                            "Betulaceae"
                        ],
                        "examples": [
                            {
                                "example_id": "5f267672-5951-4648-9e7d-029c6373bde2",
                                "sense_id": "59b2a743-8061-32cc-9f54-3f254de39bb9",
                                "text": "„Die Moorbirke ähnelt im Wuchs oberflächlich betrachtet der Sandbirke, hat aber eine fast bräunliche Rinde.“"
                            },
                            {
                                "example_id": "fbdc0f9c-37d5-4ddf-94ab-58713de6e403",
                                "sense_id": "59b2a743-8061-32cc-9f54-3f254de39bb9",
                                "text": "„Im Unterschied zur Hängebirke, deren junge Zweige stets kahl sind, weisen diese nämlich bei der Moorbirke eine dichte, flaumartige Behaarung auf.“"
                            },
                            {
                                "example_id": "03bf2c5d-e7b3-4ec0-b813-ad768a4fac96",
                                "sense_id": "59b2a743-8061-32cc-9f54-3f254de39bb9",
                                "text": "„Bei der Hängebirke ist die Krone des älteren Baumes durch die schlaff überhängenden Äste viel dichter und zierlicher als bei der Moorbirke, deren Äste besenartig aufrecht stehen.“"
                            },
                            {
                                "example_id": "1d49bab1-258a-476a-bf14-2a1c15a8c823",
                                "sense_id": "59b2a743-8061-32cc-9f54-3f254de39bb9",
                                "text": "„Die Moorbirke ist eine Pionierpflanze, besonders in Nordfinnland.“"
                            },
                            {
                                "example_id": "c9785991-c1b0-48bd-ba2d-738792f89abb",
                                "sense_id": "59b2a743-8061-32cc-9f54-3f254de39bb9",
                                "text": "„Sie kannte die Plätze der knorrigen Moorbirken und die Buschgruppen aus Weiden und Ebereschen, wo Birkhühner und Wiesenpieper nisteten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
