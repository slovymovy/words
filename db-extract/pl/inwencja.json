                                "target_word": "находчивость",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "369fee35-436f-3e1e-b88d-34183b1ab5a3",
                                        "entry_id": "8f0d8903-8905-3282-b3c5-be31710ab5a1",
                                        "glosses": [
                                            "свойство по значению прилагательного находчивый; умение быстро находить выход из затруднительного положения; сообразительность"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "921e0c3c-cbec-4894-87b9-46c69421c853",
                                                "sense_id": "369fee35-436f-3e1e-b88d-34183b1ab5a3",
                                                "text": "Побег был совершён с необыкновенной находчивостью и незаурядною смелостью."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
