                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0811d681-843d-46e2-8982-e40d3357b018",
                        "source_entry_id": "c28524db-12af-32da-ba54-a8de9cb68a39",
                        "source_sense_id": "db97e0af-6098-3bc8-93ca-7c29d0b32717",
                        "source_sense_description": "vieze dampen of rook uitstotend",
                        "target_lang_word": "smoky",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "smoky",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94def12b-df87-3628-bd78-e32dde464aca",
                                        "entry_id": "14c3bbd7-25c1-3eaa-9219-f71ebe5a297b",
                                        "glosses": [
                                            "Filled with smoke."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e74c65a5-edd0-405a-82b8-f3dafdd430a3",
                                                "sense_id": "94def12b-df87-3628-bd78-e32dde464aca",
                                                "text": "a smoky cabin"
                                            },
                                            {
                                                "example_id": "9988048d-1734-4b7b-b3e7-fafcfef8f9fc",
                                                "sense_id": "94def12b-df87-3628-bd78-e32dde464aca",
                                                "text": "Some sate turning of spits, and the place being all smoaky, made me thinke on hell, for the ioynts of meat lay as if they had bene broyling in the infernall fier […]"
                                            },
                                            {
                                                "example_id": "901ef49e-4111-45a2-a7d9-598d7973cac0",
                                                "sense_id": "94def12b-df87-3628-bd78-e32dde464aca",
                                                "text": "[We] never had better fires in England, then in the dry, ſmoaky houſes of Kecoughtan: […]"
                                            },
                                            {
                                                "example_id": "a3e14b37-b768-4553-b9e1-e50658882d1d",
                                                "sense_id": "94def12b-df87-3628-bd78-e32dde464aca",
                                                "text": "[…] even the smoky air of one of the most smoky streets of the suburbs is chearful, and salubrious, to the oppression I felt in the chamber we have just left […]"
                                            },
                                            {
                                                "example_id": "c31f7fb0-42c0-40da-9eaf-02e0b1dc9f6e",
                                                "sense_id": "94def12b-df87-3628-bd78-e32dde464aca",
                                                "text": "1819, Percy Bysshe Shelley, “Peter Bell the Third,” Part 3, in The Poetical Works of Percy Bysshe Shelley, London: Edward Moxon, 1839, p. 240,\nHell is a city much like London—\nA populous and a smoky city;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6a729c3-129f-3f14-9b26-1e3b4a2e5ae0",
                                        "entry_id": "14c3bbd7-25c1-3eaa-9219-f71ebe5a297b",
                                        "glosses": [
                                            "Filled with smoke.",
                                            "Filled with or enveloped in tobacco smoke."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d147d278-c838-498c-8973-c5a676e533d5",
                                                "sense_id": "d6a729c3-129f-3f14-9b26-1e3b4a2e5ae0",
                                                "text": "a smoky bar"
                                            },
                                            {
                                                "example_id": "e5e343c7-7c48-4fcd-afcb-329d61c2f248",
                                                "sense_id": "d6a729c3-129f-3f14-9b26-1e3b4a2e5ae0",
                                                "text": "“Say, little coon, let’s see you hit a step for the boys! […]”\n“I can’t,” Sandy said, frowning instead of smiling, and growing warm as he stood there in the smoky circle of grinning white men. “I don’t know how to dance.”"
                                            },
                                            {
                                                "example_id": "46436124-96ab-4e53-bb94-98ba670f5947",
                                                "sense_id": "d6a729c3-129f-3f14-9b26-1e3b4a2e5ae0",
                                                "text": "In the evenings he argued the toss at smoky meetings in pubs and school halls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "664cd641-6df2-3b79-907d-631b965d0677",
                                        "entry_id": "14c3bbd7-25c1-3eaa-9219-f71ebe5a297b",
                                        "glosses": [
                                            "Giving off smoke."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc49aa4c-4d5f-4e27-a489-7a31b578e155",
                                                "sense_id": "664cd641-6df2-3b79-907d-631b965d0677",
                                                "text": "a smoky oil lamp"
                                            },
                                            {
                                                "example_id": "a3154809-5458-4eff-b1aa-f38794c9efaa",
                                                "sense_id": "664cd641-6df2-3b79-907d-631b965d0677",
                                                "text": "[…] is it I\nThat drive thee from the sportive court, where thou\nWast shot at with fair eyes, to be the mark\nOf smoky muskets?"
                                            },
                                            {
                                                "example_id": "a7a9b375-b307-48f3-bcfb-92cc151508ec",
                                                "sense_id": "664cd641-6df2-3b79-907d-631b965d0677",
                                                "text": "1894, George Santayana, Sonnet, in Sonnets and Other Verses, Cambridge, MA: Stone and Kimball, p. 5,\nOur knowledge is a torch of smoky pine\nThat lights the pathway but one step ahead\nAcross a void of mystery and dread."
                                            },
                                            {
                                                "example_id": "a0172b84-c20a-4a43-95f1-b7eea7e3f4de",
                                                "sense_id": "664cd641-6df2-3b79-907d-631b965d0677",
                                                "text": "The dawn of the oil age was fairly recent. Although the stuff was used to waterproof boats in the Middle East 6,000 years ago, extracting it in earnest began only in 1859 after an oil strike in Pennsylvania.[…]It was used to make kerosene, the main fuel for artificial lighting after overfishing led to a shortage of whale blubber. Other liquids produced in the refining process, too unstable or smoky for lamplight, were burned or dumped."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3e0a288-1982-395c-9299-a969d0cb9032",
                                        "entry_id": "14c3bbd7-25c1-3eaa-9219-f71ebe5a297b",
                                        "glosses": [
                                            "Of a colour or colour pattern similar to that of smoke."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7a78431-6df0-47a5-935f-081de46c6291",
                                                "sense_id": "c3e0a288-1982-395c-9299-a969d0cb9032",
                                                "text": "The Pismire kinde of Aetius hath a smoky body, an ash-coloured neck, and the back as it were adorned with stars."
                                            },
                                            {
                                                "example_id": "043d23d3-72a6-4c70-ab30-d26e85d962a5",
                                                "sense_id": "c3e0a288-1982-395c-9299-a969d0cb9032",
                                                "text": "[…] the broken walls and roofs were distinguishable even at that distance, and sometimes a part, which had been repaired, contrasted its colour with the black and smoky hues of the remainder."
                                            },
                                            {
                                                "example_id": "5924a864-4ecd-4950-a1e9-21afe5858733",
                                                "sense_id": "c3e0a288-1982-395c-9299-a969d0cb9032",
                                                "text": "There is more clear gold and scarlet in our old country mornings; more purple, brown, and smoky orange in those of the new."
                                            },
                                            {
                                                "example_id": "3a3433ec-8d99-41c1-8d1e-5ba01370a487",
                                                "sense_id": "c3e0a288-1982-395c-9299-a969d0cb9032",
                                                "text": "The saleswomen, with their all-black ensembles and smoky eyelids, were as open and affirming as the sight of RuPaul's spread legs in the Viva Glam lipstick ads."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23a0c174-4a52-3376-b4c7-3d9d2386c47c",
                                        "entry_id": "14c3bbd7-25c1-3eaa-9219-f71ebe5a297b",
                                        "glosses": [
                                            "Having a flavour or odour like smoke; flavoured with smoke."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "490ff964-4991-45b8-af51-e7f41434448b",
                                                "sense_id": "23a0c174-4a52-3376-b4c7-3d9d2386c47c",
                                                "text": "a smoky whisky"
                                            },
                                            {
                                                "example_id": "9e81e78a-2056-4b58-bfe6-515644cf6361",
                                                "sense_id": "23a0c174-4a52-3376-b4c7-3d9d2386c47c",
                                                "text": "[…] thei abstain from a smoky peace of Bacon or hard salted and poudred biefe or suche lyke […]"
                                            },
                                            {
                                                "example_id": "53579c88-c449-41cb-84b8-c9a46b8c435f",
                                                "sense_id": "23a0c174-4a52-3376-b4c7-3d9d2386c47c",
                                                "text": "[S]ome Dutch officers complained that the ſoup was ſmoaky, and the beef was tough, we adventurers declared that we never had taſted a more delicious repaſt; [...]"
                                            },
                                            {
                                                "example_id": "bde1eaae-fe48-4cc7-be31-943a4418ad6e",
                                                "sense_id": "23a0c174-4a52-3376-b4c7-3d9d2386c47c",
                                                "text": "I smelled it the moment I entered—that sweet smoky reek."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16ed0e3c-a368-3212-aa2d-21b265462600",
                                        "entry_id": "14c3bbd7-25c1-3eaa-9219-f71ebe5a297b",
                                        "glosses": [
                                            "Resembling or composed of smoke."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "852c1243-427b-4e92-8ec0-2c061641349d",
                                                "sense_id": "16ed0e3c-a368-3212-aa2d-21b265462600",
                                                "text": "And let thy mustie vapours march so thicke,\nThat in their smoakie rankes, his smothred light\nMay set at noone, and make perpetuall night."
                                            },
                                            {
                                                "example_id": "f55808cd-3ba6-46d6-b6ae-782a952cd55a",
                                                "sense_id": "16ed0e3c-a368-3212-aa2d-21b265462600",
                                                "text": "[…] I too gave notice to the various wild inhabitants of Walden vale, by a smoky streamer from my chimney, that I was awake."
                                            },
                                            {
                                                "example_id": "8aed2aa5-0982-4d89-9176-82bd7df5408b",
                                                "sense_id": "16ed0e3c-a368-3212-aa2d-21b265462600",
                                                "text": "And now the sky was a bright sea sown with islands; they shrank and crumbled and drifted away, islands no more, but a multitude of plumes and flakes and smoky wreaths hastily scudding, for the sun had lifted his tranquil eye on the heavens […]"
                                            },
                                            {
                                                "example_id": "f9e34606-0829-427e-825e-d7756c6ea250",
                                                "sense_id": "16ed0e3c-a368-3212-aa2d-21b265462600",
                                                "text": "He [the bull] had horns galore, a coat of gold and a sweet smoky breath coming out of his nostrils […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "418afc34-839f-3e75-b981-d2acc9782e19",
                                        "entry_id": "14c3bbd7-25c1-3eaa-9219-f71ebe5a297b",
                                        "glosses": [
                                            "Blackened by smoke."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ce69019-13da-48ed-aa37-4f69c6cbedc1",
                                                "sense_id": "418afc34-839f-3e75-b981-d2acc9782e19",
                                                "text": "Shepheard I take thy word,\nAnd trust thy honest offer’d courtesie,\nWhich oft is sooner found in lowly sheds\nWith smoakie rafters, then in tapstrie halls,\nAnd courts of Princes […]",
                                                "translation": "Comus",
                                                "english": "Comus"
                                            },
                                            {
                                                "example_id": "3b4f2a27-7c8e-4f73-bd2b-5425d57df731",
                                                "sense_id": "418afc34-839f-3e75-b981-d2acc9782e19",
                                                "text": "The room smelt close and unwholesome; the walls were dirt-discoloured; and the ceiling blackened. There was an old smoky bust over the mantel-shelf, and a dusty clock above the dock […]"
                                            },
                                            {
                                                "example_id": "d3b9e343-58de-4095-b5d6-1ed880503d36",
                                                "sense_id": "418afc34-839f-3e75-b981-d2acc9782e19",
                                                "text": "The ruddy brick floor smiled up at the smoky ceiling […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e75fa096-7c9d-30e6-bf71-e3a86c095e92",
                                        "entry_id": "14c3bbd7-25c1-3eaa-9219-f71ebe5a297b",
                                        "glosses": [
                                            "Having a deep, raspy quality, often as a result of smoking tobacco."
                                        ],
                                        "tags": [
                                            "of a person's voice"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e107ddb-62ac-4a20-93eb-f1bc4ecbb500",
                                                "sense_id": "e75fa096-7c9d-30e6-bf71-e3a86c095e92",
                                                "text": "“Stop the York four-day stage!” said he, forcing his smoky voice through a world of throat-embracing shawl […]"
                                            },
                                            {
                                                "example_id": "b169956b-a54a-47da-b9cf-7c7f2e8df1ff",
                                                "sense_id": "e75fa096-7c9d-30e6-bf71-e3a86c095e92",
                                                "text": "Father laughed his smoky laugh. […] The smoky laughter like a bridge between them over your head."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "822100a9-6312-383a-b313-841d52c9885c",
                                        "entry_id": "14c3bbd7-25c1-3eaa-9219-f71ebe5a297b",
                                        "glosses": [
                                            "Attractive in a sensual way; sultry."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e39b3850-c85b-4869-8ab1-9ed977d92880",
                                                "sense_id": "822100a9-6312-383a-b313-841d52c9885c",
                                                "text": "There was still that smoky little thing about her. The sexy swaying walk, the dark voice."
                                            },
                                            {
                                                "example_id": "bdd1e07b-d0ae-4c92-8e0c-caedb087e61d",
                                                "sense_id": "822100a9-6312-383a-b313-841d52c9885c",
                                                "text": "Frankly, I don’t think his smoky Armenian looks drew their attention so much as the languid elegance of his manner […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "312e1eba-8ddf-3dd3-abd5-606e2abda388",
                                        "entry_id": "14c3bbd7-25c1-3eaa-9219-f71ebe5a297b",
                                        "glosses": [
                                            "Having a dark, thick, bass sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b41ac2d6-3c17-47e4-8adb-7490c6a2ed91",
                                                "sense_id": "312e1eba-8ddf-3dd3-abd5-606e2abda388",
                                                "text": "a few smoky jazz notes"
                                            },
                                            {
                                                "example_id": "fe602750-9dbb-453e-80a5-a26ae3941598",
                                                "sense_id": "312e1eba-8ddf-3dd3-abd5-606e2abda388",
                                                "text": "1962, Philip Larkin, “Billie’s Golden Years,” The Daily Telegraph, 17 October, 1962, republished in All What Jazz: A Record Diary, 1961—1971, New York: Farrar Straus Giroux, 1985, p. 73,\n[…] the sombre and magnificent Davis fronts both his Quartet and Gil Evans’s orchestra, pouring out a succession of smoky and sonorous solos […]"
                                            },
                                            {
                                                "example_id": "ac263a15-97ae-45c0-a194-08e0cf4ec709",
                                                "sense_id": "312e1eba-8ddf-3dd3-abd5-606e2abda388",
                                                "text": "The organ took on a dark, smoky sonority at evening service, and there was no doubt that the organ was adapting its normal sounds to accompany God’s own sepulchral responses […] to those prayers that were offered to him."
                                            },
                                            {
                                                "example_id": "ada6b61b-09e4-4464-8528-ca61f9b7aa1e",
                                                "sense_id": "312e1eba-8ddf-3dd3-abd5-606e2abda388",
                                                "text": "[…] there emerged from the car a pair of the sort of legs which soundtrack editors are unable to see without needing to slap a smoky saxophone solo all over […]"
                                            },
                                            {
                                                "example_id": "426ed6cf-d332-4210-ba94-bd73ba8fbb3c",
                                                "sense_id": "312e1eba-8ddf-3dd3-abd5-606e2abda388",
                                                "text": "Then, just as the music, slow and smoky, loads up the air, his smile bright as ever, he wrinkles his nose and turns away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87424104-f62e-3418-b6dc-b514e7951d05",
                                        "entry_id": "14c3bbd7-25c1-3eaa-9219-f71ebe5a297b",
                                        "glosses": [
                                            "Giving off steam or vapour."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e95f81f-4f59-42ea-be33-8a967fa349f2",
                                                "sense_id": "87424104-f62e-3418-b6dc-b514e7951d05",
                                                "text": "1594, Thomas Kyd (translator), Cornelia (Cornélie) by Robert Garnier, London: Nicholas Ling and John Busbie, Act V,\nHe wrencht it [his sword] to the pommel through his sides,\nThat fro the wound the smoky blood ran bubling,\nWhere-with he staggred;"
                                            },
                                            {
                                                "example_id": "c040c4a8-0e10-4f8b-bd9e-ddcddc1e346a",
                                                "sense_id": "87424104-f62e-3418-b6dc-b514e7951d05",
                                                "text": "Dark was the Path, and difficult, and steep,\nAnd thick with Vapours from the smoaky Deep."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8eb45f85-26fe-3e17-b7d6-d6a5f89219c8",
                                        "entry_id": "14c3bbd7-25c1-3eaa-9219-f71ebe5a297b",
                                        "glosses": [
                                            "Obscuring or insubstantial like smoke."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "085f827a-9649-47f7-9c8f-437dce23314e",
                                                "sense_id": "8eb45f85-26fe-3e17-b7d6-d6a5f89219c8",
                                                "text": "[…] to shewe them selfe playnely, to hate & deteste and abhorre vtterly, the pestylent contagyon of all suche smoky communycacyon."
                                            },
                                            {
                                                "example_id": "c6d5f237-02ab-4078-a832-b854e8543b53",
                                                "sense_id": "8eb45f85-26fe-3e17-b7d6-d6a5f89219c8",
                                                "text": "If besides vayne crakes of smoky speeches, ye shewe no demonstration of sounde proofe, why these bragges of yours should be true, let vs graunt your saying."
                                            },
                                            {
                                                "example_id": "af4b2706-f62f-4897-92b2-ff21ee97cfbe",
                                                "sense_id": "8eb45f85-26fe-3e17-b7d6-d6a5f89219c8",
                                                "text": "[…] scrambling with such distracted violence for the smoaky honours, the nominal wealth, the intoxicating pleasures of a few hasty daies […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17ad248f-418a-3644-b826-4674bf1ab7d8",
                                        "entry_id": "14c3bbd7-25c1-3eaa-9219-f71ebe5a297b",
                                        "glosses": [
                                            "Suspicious; open to suspicion; jealous."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d993e42-fb24-4dbb-ac62-3967b49e67c0",
                                                "sense_id": "17ad248f-418a-3644-b826-4674bf1ab7d8",
                                                "text": "1765, Samuel Foote, The Commissary, Act I, in The Works of Samuel Foote, London: George Robinson et al., 1799, Volume 2, p. 18,\n[…] this old brother of ours tho’ is smoky and shrewd, and tho’ an odd, a sensible fellow;"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd56a79d-6825-4230-8f85-948d49cc0e9f",
                        "source_entry_id": "c28524db-12af-32da-ba54-a8de9cb68a39",
                        "source_sense_id": "db97e0af-6098-3bc8-93ca-7c29d0b32717",
                        "source_sense_description": "vieze dampen of rook uitstotend",
                        "target_lang_word": "smelly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "smelly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "602af9ee-c6fc-3638-a46f-ad2506454807",
                                        "entry_id": "e7664904-b4eb-3c22-871e-2d6ef26a203b",
                                        "glosses": [
                                            "Having a bad smell."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "debd374c-a41b-4e86-98cc-ed942fa4c5f6",
                                                "sense_id": "602af9ee-c6fc-3638-a46f-ad2506454807",
                                                "text": "She was hesitant to remove her shoes, as her socks were rather smelly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b93c8bfb-c088-35b1-bb4a-0e3219b911fd",
                                        "entry_id": "e7664904-b4eb-3c22-871e-2d6ef26a203b",
                                        "glosses": [
                                            "Having a quality that arouses suspicion."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9518c047-3c6c-4305-8e16-3847937c7ac4",
                                                "sense_id": "b93c8bfb-c088-35b1-bb4a-0e3219b911fd",
                                                "text": "The detective read the documents and thought, \"Something sure is smelly about this case.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a71c3ab2-d631-3212-a30f-a7ef585a80c9",
                                        "entry_id": "e7664904-b4eb-3c22-871e-2d6ef26a203b",
                                        "glosses": [
                                            "Having signs that suggest a design problem; having a code smell."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55733606-8914-443d-a8bc-3cc27c423be3",
                                                "sense_id": "a71c3ab2-d631-3212-a30f-a7ef585a80c9",
                                                "text": "That smelly code needs to be refactored."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "smelly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0be60303-4e26-3186-a17a-e83950011b61",
                                        "entry_id": "6a4fcb65-88aa-39dc-8939-47ac7362150a",
                                        "glosses": [
                                            "A smelly person."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "707b0f2c-71ab-4eae-a798-c3bd1d8c211d",
                                                "sense_id": "0be60303-4e26-3186-a17a-e83950011b61",
                                                "text": "And I can get home myself, thank you. Little smelly."
                                            },
                                            {
                                                "example_id": "5f2211eb-9214-4f94-b6a3-dc7f470e8131",
                                                "sense_id": "0be60303-4e26-3186-a17a-e83950011b61",
                                                "text": "Or if you know any piglets with water pistols, maybe you could throw them a bottle of gargle and say, ‘Hoy you smellies, I bet you can’t squirt the little dangly thing up the dark end of my gob with this’."
                                            },
                                            {
                                                "example_id": "a02e8d6d-5a1c-4d98-a451-496c9dad3404",
                                                "sense_id": "0be60303-4e26-3186-a17a-e83950011b61",
                                                "text": "However, according to [Joey] Owens, these anarchists are all a bunch of smellies, who run away “screaming” while forever being hit over the head with iron bars by victorious fascists."
                                            },
                                            {
                                                "example_id": "09c78b3b-c474-4539-a0d5-b3efc0cc85bd",
                                                "sense_id": "0be60303-4e26-3186-a17a-e83950011b61",
                                                "text": "Both of them had been called “little smellies,” because Hillie insisted their breath reeked of garlic and fish."
                                            },
                                            {
                                                "example_id": "48ffdd3c-40ec-4e5a-878d-f57e64c22979",
                                                "sense_id": "0be60303-4e26-3186-a17a-e83950011b61",
                                                "text": "I have two little smellies to think of too. Family is big and cost of living in this city is increasing by the day."
                                            }
                                        ]
                                    }
                                ]
                            },
