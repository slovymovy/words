                "senses": [
                    {
                        "sense_id": "e5c8cd8c-eeb7-36db-9900-36f818e38ac5",
                        "entry_id": "c86671bc-9a21-369e-8317-463b11d760e3",
                        "glosses": [
                            "Gericht, das hauptsächlich oder ausschließlich aus einer Suppe besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "840f34ac-a744-40c9-a657-e53761b14127",
                                "sense_id": "e5c8cd8c-eeb7-36db-9900-36f818e38ac5",
                                "text": "„Zwar verspürte Robert noch Hunger, aber vielleicht war es in dieser Gegend üblich, sich mittags mit einem Suppengericht zu begnügen, und die Mahlzeit war schon beendet.“"
                            },
                            {
                                "example_id": "c533406e-0bdc-47c4-8053-74bc159e37b5",
                                "sense_id": "e5c8cd8c-eeb7-36db-9900-36f818e38ac5",
                                "text": "„Eingeladen zu der Aktion hatte die Interessengemeinschaft Behinderter und ihrer Freunde (IBF), vorbereitet wurde das Suppengericht von der Schnelleinsatzgruppe Versorgung der Feuerwehr Speyer.“"
                            },
                            {
                                "example_id": "a67b91a3-4a38-4751-b164-17657d7a5be1",
                                "sense_id": "e5c8cd8c-eeb7-36db-9900-36f818e38ac5",
                                "text": "„ Im Angebot befinden sich verschiedene Gerichte, wobei das Angebot ein vegetarisches Gericht, ein Salatangebot und ein Suppengericht umfasst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
