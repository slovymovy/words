                    }
                ],
                "senses": [
                    {
                        "sense_id": "7065c93a-371b-3bdb-8894-f000953d6e08",
                        "entry_id": "2c053e67-fd35-35c3-9325-2f2f3f5dbe0d",
                        "glosses": [
                            "Forme pronominale de élargir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd1e62f4-90cd-4c41-8a04-509b1b4b5dd0",
                                "sense_id": "7065c93a-371b-3bdb-8894-f000953d6e08",
                                "text": "À mesure que les rives du fleuve s’élargissent et que je descends vers la mer, je sens tomber de mes épaules le manteau de douceur dont m’enveloppait ton amour."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "15d6c226-c206-4570-b472-ad559d581b09",
                        "source_entry_id": "2c053e67-fd35-35c3-9325-2f2f3f5dbe0d",
                        "source_sense_id": "7065c93a-371b-3bdb-8894-f000953d6e08",
                        "target_lang_word": "widen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "widen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e3b4720-c769-38b4-8560-9cd000a11960",
                                        "entry_id": "aa95f84d-b507-3ae0-997b-53cdc83aa093",
                                        "glosses": [
                                            "To become wide or wider."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a4c3042-bc0d-4056-84b2-98df301d4dd6",
                                                "sense_id": "7e3b4720-c769-38b4-8560-9cd000a11960",
                                                "text": "His eyes widened as her negligee fell to the floor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d05e3e3b-e3f3-30ee-85c8-62862be0d7cb",
                                        "entry_id": "aa95f84d-b507-3ae0-997b-53cdc83aa093",
                                        "glosses": [
                                            "To make wide or wider."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7d6f1aa-f7b2-4d4a-80d4-89850a776d95",
                                                "sense_id": "d05e3e3b-e3f3-30ee-85c8-62862be0d7cb",
                                                "text": "But he still saw his side produce a rousing display which owed much to their lauded prowess from set-pieces, despite Uefa regulations meaning the pitch had to be widened and, in the process, the run-up area for Delap's long throws reduced."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bff008c-e3e6-33a7-8e68-f2bb1063057e",
                                        "entry_id": "aa95f84d-b507-3ae0-997b-53cdc83aa093",
                                        "glosses": [
                                            "To let out clothes to a larger size."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cd6f64f-9cb6-4ab5-b73c-f76024c28fd2",
                                                "sense_id": "9bff008c-e3e6-33a7-8e68-f2bb1063057e",
                                                "text": "She widened his trousers for him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8413944-274c-3d64-aecb-ac45f143a9bb",
                                        "entry_id": "aa95f84d-b507-3ae0-997b-53cdc83aa093",
                                        "glosses": [
                                            "To broaden or extend in scope or range."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d48a1381-05b3-49c4-96c7-242551addd96",
                                                "sense_id": "b8413944-274c-3d64-aecb-ac45f143a9bb",
                                                "text": "The police widened their enquiries."
                                            },
                                            {
                                                "example_id": "94f2f40e-301c-417a-a10d-481caeb68e21",
                                                "sense_id": "b8413944-274c-3d64-aecb-ac45f143a9bb",
                                                "text": "While the primary focus of the Sexual Orientation Committee had been to lobby for gay rights legislation, the new Task Force hopes to widen its activities. The Task Force ― in addition to lobbying — hopes to function as an \"umbrella organization,\" facilitating communication between the state's many gay groups."
                                            },
                                            {
                                                "example_id": "bdfc7893-199f-463d-8e07-b8a0f84e6a02",
                                                "sense_id": "b8413944-274c-3d64-aecb-ac45f143a9bb",
                                                "text": "Correspondent Gerardo Arreola interviewed Castro Espín for the Jan. 9, 2006, issue of La Jornada about the move to widen rights for transsexuals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53a7fbea-ef17-3cdc-b561-e1a5e1b5b2e7",
                                        "entry_id": "aa95f84d-b507-3ae0-997b-53cdc83aa093",
                                        "glosses": [
                                            "To convert to a data type that can hold a larger number of distinct values."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcc32b38-cc29-402f-a01b-56c06ff0c8ad",
                                                "sense_id": "53a7fbea-ef17-3cdc-b561-e1a5e1b5b2e7",
                                                "text": "to widen a short variable to an int variable"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
