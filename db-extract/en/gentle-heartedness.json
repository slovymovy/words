                        ],
                        "examples": [
                            {
                                "example_id": "7fe016cf-bf2a-4331-b6cf-8d397fd93a95",
                                "sense_id": "edca32c8-3551-3f02-a545-25fdd25c60ed",
                                "text": "There was a halo about everything that Uncle John did, the radiance that goes with great kindness, the jovial gentle-heartedness of a humane man."
                            }
                        ]
                    },
                    {
                        "sense_id": "2b56e0d5-f074-3b2e-b6cc-ebef2b8e6a21",
                        "entry_id": "6d6106e6-ae25-3763-90ff-2dccdf266d0d",
                        "glosses": [
                            "Meekness, mildness."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3c087ccd-0b23-4182-b849-9bb78ee2f726",
                                "sense_id": "2b56e0d5-f074-3b2e-b6cc-ebef2b8e6a21",
                                "text": "Gentle-heartedness follows from humble-heartedness. When I know my proper place, and am therefore free to appreciate and affirm the invaluable goodness of my neighbor, I can afford to be gentle."
                            }
                        ]
                    },
                    {
                        "sense_id": "257a9b6b-461d-3822-aec8-de515a1d8b34",
                        "entry_id": "6d6106e6-ae25-3763-90ff-2dccdf266d0d",
                        "glosses": [
                            "Refinement; high-born graciousness."
                        ],
                        "tags": [
                            "archaic",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e1928c5e-b7c7-41b5-8086-5de3665084dd",
                                "sense_id": "257a9b6b-461d-3822-aec8-de515a1d8b34",
                                "text": "And she was deserving of this love, because of her graciousness, her refinement, her gentle-heartedness and her piety."
                            }
                        ]
                    }
