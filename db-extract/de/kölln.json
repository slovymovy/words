                "senses": [
                    {
                        "sense_id": "6d97ba2d-0a7b-33bc-aba9-46a1debb8483",
                        "entry_id": "b4831e0d-b247-3925-bd9b-c84446852905",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10c3d079-b08f-40df-af6d-5374bb6ab63a",
                                "sense_id": "6d97ba2d-0a7b-33bc-aba9-46a1debb8483",
                                "text": "Frau Kölln ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d05fe7ea-089a-43ae-824d-a15ce3d35756",
                                "sense_id": "6d97ba2d-0a7b-33bc-aba9-46a1debb8483",
                                "text": "Herr Kölln wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "1799f7ad-b9f7-47f3-be5d-ef408c7c739d",
                                "sense_id": "6d97ba2d-0a7b-33bc-aba9-46a1debb8483",
                                "text": "Die Köllns fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "9fe68c56-2807-4c81-9fdf-5f3467122f4c",
                                "sense_id": "6d97ba2d-0a7b-33bc-aba9-46a1debb8483",
                                "text": "Der Kölln trägt nie die Schals, die die Kölln ihm strickt."
                            },
                            {
                                "example_id": "9f1690d6-ab29-49b9-98d1-ed5ab5ecf7db",
                                "sense_id": "6d97ba2d-0a7b-33bc-aba9-46a1debb8483",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kölln kommt, geht der Herr Kölln.“"
                            },
                            {
                                "example_id": "39375091-9af7-468b-80ca-7fc266a9efea",
                                "sense_id": "6d97ba2d-0a7b-33bc-aba9-46a1debb8483",
                                "text": "Kölln kommt und geht."
                            },
                            {
                                "example_id": "3ecdd15f-0920-4b34-86cc-5e86cd867151",
                                "sense_id": "6d97ba2d-0a7b-33bc-aba9-46a1debb8483",
                                "text": "Köllns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
