                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dullness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f1a5ecf4-db3a-3891-92da-2fb80a2f9bf7",
                                        "entry_id": "7ab4bf01-7cf6-32c1-a443-3c46534f99ff",
                                        "glosses": [
                                            "The quality of being slow of understanding things; stupidity."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "230fa280-ce7d-3cf5-943e-1446e12bd546",
                                        "entry_id": "7ab4bf01-7cf6-32c1-a443-3c46534f99ff",
                                        "glosses": [
                                            "The quality of being uninteresting; boring; humorless or irksome."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9eae842-3b2a-4dde-9451-0191c4d27b66",
                                                "sense_id": "230fa280-ce7d-3cf5-943e-1446e12bd546",
                                                "text": "If to raise malicious smiles at the infirmities or misfortunes of those who have never injured us be the province of wit or Humour, Heaven grant me a double Portion of Dullness—"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b94769bf-51cb-3f2f-af31-15a21321f48c",
                                        "entry_id": "7ab4bf01-7cf6-32c1-a443-3c46534f99ff",
                                        "glosses": [
                                            "Lack of interest or excitement."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a7f70f71-2bb7-392a-9ddb-1a273dbbf141",
                                        "entry_id": "7ab4bf01-7cf6-32c1-a443-3c46534f99ff",
                                        "glosses": [
                                            "The lack of visual brilliance; want of sheen."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ad8e207-7d45-47e3-8180-59e2a5d5e6eb",
                                                "sense_id": "a7f70f71-2bb7-392a-9ddb-1a273dbbf141",
                                                "text": "dullness of autumn"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d666009-b4a3-32a2-b985-e9eee4c3335a",
                                        "entry_id": "7ab4bf01-7cf6-32c1-a443-3c46534f99ff",
                                        "glosses": [
                                            "bluntness."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f409a5a0-b913-30f7-a144-e2aa94056048",
                                        "entry_id": "7ab4bf01-7cf6-32c1-a443-3c46534f99ff",
                                        "glosses": [
                                            "The quality of not perceiving or kenning things distinctly."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f2e0863-2cbb-4687-a6d8-79fb0a569c39",
                                                "sense_id": "f409a5a0-b913-30f7-a144-e2aa94056048",
                                                "text": "dullness of sight, or of hearing"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "572b30c9-72f3-3661-9606-15b65cfc82f3",
                                        "entry_id": "7ab4bf01-7cf6-32c1-a443-3c46534f99ff",
                                        "glosses": [
                                            "Drowsiness."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8f2ca56-8d54-4dba-a99d-30c018943622",
                                                "sense_id": "572b30c9-72f3-3661-9606-15b65cfc82f3",
                                                "text": "Prospero: […]Thou art inclin'd to sleep. 'Tis a good dulness, / And give it way— I know thou canst not choose."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81f3b8d7-19fb-49a7-bbe0-1f9429a81453",
                        "source_entry_id": "3179ddf0-41c5-3c56-87bd-05510b13b7aa",
                        "source_sense_id": "79d65640-91dc-37ff-98fa-8834e3525594",
                        "source_sense_description": "door gebrek aan contrasten saai en eentonig",
                        "target_lang_word": "monotony",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monotony",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "313a4753-f279-3db6-9cd7-7e32511a24c4",
                                        "entry_id": "8fa84b7d-258b-3778-86e7-624477c125bb",
                                        "glosses": [
                                            "Tedium as a result of repetition or a lack of variety."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a58f06d-465d-468d-b444-dada5a7403a7",
                                                "sense_id": "313a4753-f279-3db6-9cd7-7e32511a24c4",
                                                "text": "It matters little to trace the rapidity of the land journey, or the monotony of the sea voyage—alike unmarked by adventure. Robert Evelyn landed at Southampton,..."
                                            },
                                            {
                                                "example_id": "8dd69ff7-074d-411a-9fa5-723640b6be62",
                                                "sense_id": "313a4753-f279-3db6-9cd7-7e32511a24c4",
                                                "text": "Yet second-hand romance and second-hand emotion are surely better than the dull, soul-killing monotony which life brings to most of the human race."
                                            },
                                            {
                                                "example_id": "c1c43bbf-8f0c-40af-b9b9-93b2b9aa4554",
                                                "sense_id": "313a4753-f279-3db6-9cd7-7e32511a24c4",
                                                "text": "Transform my death into a conduit\nThis body separate from the fear of fear\nInside a coping mechanism of monotony\nI will destroy the double vision that I was forced to leave"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a36512d-1ae8-31ac-9f60-183a93b98e87",
                                        "entry_id": "8fa84b7d-258b-3778-86e7-624477c125bb",
                                        "glosses": [
                                            "The property of a monotonic function."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7e3c04be-25d2-394e-ab9e-2cd0228adfd5",
                                        "entry_id": "8fa84b7d-258b-3778-86e7-624477c125bb",
                                        "glosses": [
                                            "The quality of having an unvarying tone or pitch."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51dfe704-4883-44e1-82cd-cee23abd42b2",
                        "source_entry_id": "3179ddf0-41c5-3c56-87bd-05510b13b7aa",
                        "source_sense_id": "79d65640-91dc-37ff-98fa-8834e3525594",
                        "source_sense_description": "door gebrek aan contrasten saai en eentonig",
                        "target_lang_word": "uniformity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uniformity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43fde87a-3c48-32ed-b0ef-4ce6fedbb3c1",
                                        "entry_id": "10096311-b140-31ff-9cd9-ffe85cbfabd1",
                                        "glosses": [
                                            "The quality or state of being uniform.",
                                            "The quality or state of having the same characteristics or form as other things, and lacking variety; (countable) an instance of this."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04062325-55cc-40b5-80a7-35e67081590c",
                                                "sense_id": "43fde87a-3c48-32ed-b0ef-4ce6fedbb3c1",
                                                "text": "The buildings are all of brick, of a goodly heigth, and an excellent vniformity in moſt of the ſtreets, the toppes riſing vvith battlements."
                                            },
                                            {
                                                "example_id": "cbc0d4a2-d5fb-46ab-a563-de6285d7d02e",
                                                "sense_id": "43fde87a-3c48-32ed-b0ef-4ce6fedbb3c1",
                                                "text": "It remaines, that I collect as vvell as I can, thoſe memorials vvhich I find of this expedition ſcattered in diuers places: a vvorke neceſſarie, for that the greatneſſe of this action vvas ſuch, as ought not to bee omitted in a generall Hiſtorie; yet not eaſie, the conſent of thoſe that haue vvritten thereof, being nothing neare to vniformitie."
                                            },
                                            {
                                                "example_id": "54f78b8c-15ec-4160-a11c-79a72e1ae323",
                                                "sense_id": "43fde87a-3c48-32ed-b0ef-4ce6fedbb3c1",
                                                "text": "Houſes are built to Liue in, and not to Looke on: Therefore let Vſe bee preferred before Vniformitie; Except vvhere both may be had."
                                            },
                                            {
                                                "example_id": "805e5b89-4321-4fd2-ba0d-92bc194de8df",
                                                "sense_id": "43fde87a-3c48-32ed-b0ef-4ce6fedbb3c1",
                                                "text": "[T]his diſtinction of Honour vvill bring forth a ſeemly and gracefull Uniformity over all the Kingdome."
                                            },
                                            {
                                                "example_id": "aa6655f9-0c93-4f23-ad0b-d8e5f985611b",
                                                "sense_id": "43fde87a-3c48-32ed-b0ef-4ce6fedbb3c1",
                                                "text": "Uniformity alſo much pleaſeth the eye; and 'tis obſerved that free-ſtone, like a fair complexion, ſooneſt vvaxeth old, vvhileſt brick keeps her beauty longeſt."
                                            },
                                            {
                                                "example_id": "bb988016-88d9-4cc8-918c-c5c105ad2fbd",
                                                "sense_id": "43fde87a-3c48-32ed-b0ef-4ce6fedbb3c1",
                                                "text": "Steeples, &c. have generally been varied from the cone, to take off from their too great ſimplicity, and inſtead of their circular baſes, polygons of different, but even numbers of ſides, have been ſubſtituted, I ſuppoſe for the ſake of uniformity. […] Yet, in my mind, odd numbers have the advantage over the even ones, as varieth is more pleaſing than uniformity, vvhere the ſame end is anſvver'd by both; […]"
                                            },
                                            {
                                                "example_id": "1efb075c-5161-48f5-af3c-951893132054",
                                                "sense_id": "43fde87a-3c48-32ed-b0ef-4ce6fedbb3c1",
                                                "text": "To produce therefore a perfect grandeur in ſuch things as vve have been mentioning, there ſhould be a perfect ſimplicity, an abſolute uniformity in diſpoſition, ſhape and colouring."
                                            },
                                            {
                                                "example_id": "50612fae-812a-4771-8b0e-f9194b90c7b2",
                                                "sense_id": "43fde87a-3c48-32ed-b0ef-4ce6fedbb3c1",
                                                "text": "[T]he tents are all ranged in a ſtrait line, novv Lady Gorget, can any thing be vvorſe than a ſtrait line; and is not there a horrid uniformity in their infinite viſta of canvas? no curve, no break, and the avenue of marquees abominable."
                                            },
                                            {
                                                "example_id": "b56e2998-abfc-443e-bf67-018fae5fc3dc",
                                                "sense_id": "43fde87a-3c48-32ed-b0ef-4ce6fedbb3c1",
                                                "text": "The uniformity of the wheel diameters of diesel and electric locomotives and m.u. trains impairs the spreading of grease from one point fed by the lubricator and the growing traffic of m.u. trains and railcars has increased the need for lubrication and for check rails in certain places."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8d8389f-fb0b-31c5-aedc-6d77d8e6651f",
                                        "entry_id": "10096311-b140-31ff-9cd9-ffe85cbfabd1",
                                        "glosses": [
                                            "The quality or state of being uniform.",
                                            "Often followed by of: the quality or state of a thing always having the same characteristics or form; consistency or regularity in appearance or operation."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5aaafeee-4d5c-433d-ac72-287dc9d264a4",
                                                "sense_id": "b8d8389f-fb0b-31c5-aedc-6d77d8e6651f",
                                                "text": "The uniformity of the decor"
                                            },
                                            {
                                                "example_id": "2cbc9583-e776-4edf-ab9a-dc1b3dfdf660",
                                                "sense_id": "b8d8389f-fb0b-31c5-aedc-6d77d8e6651f",
                                                "text": "Brown was the first livery selected for the company by Brunel nearly 108 years ago, and it continued until October, 1864, when the Directors decided that, to relieve the uniformity, carriages of all classes should be painted white from the waist upwards."
                                            },
                                            {
                                                "example_id": "6d167f7c-a394-402a-be5b-c283c29057ea",
                                                "sense_id": "b8d8389f-fb0b-31c5-aedc-6d77d8e6651f",
                                                "text": "There is no uniformity: clay-and-straw cob walls and thatch roofs stand happily next to brick and tile, timber and stone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "813e6e54-d4a6-33a0-b2b8-bd0b51516f4e",
                                        "entry_id": "10096311-b140-31ff-9cd9-ffe85cbfabd1",
                                        "glosses": [
                                            "The quality or state of being uniform.",
                                            "Often followed by of: especially of one's life: lack of variety; tedious sameness; monotony."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4c1687a8-3f1e-3a77-83f8-e8187fc03cf6",
                                        "entry_id": "10096311-b140-31ff-9cd9-ffe85cbfabd1",
                                        "glosses": [
                                            "The quality or state of being uniform.",
                                            "The condition or state described by uniformitarianism (“the scientific principle that natural laws and processes operated in the past in the same way and at the same rates that they operate today, and sometimes in the same way everywhere in the universe as well”)."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efc1b064-16ea-4414-80f4-d56c37684df5",
                                                "sense_id": "4c1687a8-3f1e-3a77-83f8-e8187fc03cf6",
                                                "text": "It must be granted at once, to the advocates of this geological uniformity, that we are not arbitrarily to assume the existence of catastrophes. The degree of uniformity and continuity with which terromotive forces have acted, must be collected, not from any gratuitous hypothesis, but from the facts of the case."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab107eb9-2858-31f0-b01a-e32dba78a199",
                                        "entry_id": "10096311-b140-31ff-9cd9-ffe85cbfabd1",
                                        "glosses": [
                                            "The quality or state of being uniform.",
                                            "Adherence to or conformity with one viewpoint, set of observances, etc."
                                        ],
                                        "tags": [
                                            "especially",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "622df9ba-22be-4837-99e8-ef20d1cec763",
                                                "sense_id": "ab107eb9-2858-31f0-b01a-e32dba78a199",
                                                "text": "Novv, vvhen the father of their Church, vvho gladly vvould heale the ſoare of the daugheer^([sic]) of his people ſoftly and ſleightly, and make the beſt of it, findeth ſo great fault vvith them for their oddes and iarring; vve hope the children haue no great cauſe to vaunt of their vniformitie."
                                            },
                                            {
                                                "example_id": "de0a3316-38a8-4cdc-b433-3711365faafe",
                                                "sense_id": "ab107eb9-2858-31f0-b01a-e32dba78a199",
                                                "text": "VVhither Mr. [William] Dell is arrived, let his Sermon againſt Reformation, and his Treatiſe againſt Uniformity vvitneſs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a919814-a092-4c6f-aa45-2d29c946686e",
                        "source_entry_id": "3179ddf0-41c5-3c56-87bd-05510b13b7aa",
                        "source_sense_id": "79d65640-91dc-37ff-98fa-8834e3525594",
                        "source_sense_description": "door gebrek aan contrasten saai en eentonig",
                        "target_lang_word": "boredom",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boredom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a83dcef2-bdef-3af0-8207-f9d9a8c285bf",
                                        "entry_id": "8ef9026f-ef23-381e-b75f-b3b6084b8917",
                                        "glosses": [
                                            "The state of being bored."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d046b215-2f83-401e-96f1-3b14d304d4ff",
                                                "sense_id": "a83dcef2-bdef-3af0-8207-f9d9a8c285bf",
                                                "text": "[…]only last Sunday, my Lady, in the desolation of Boredom and the clutch of Giant Despair, almost hated her own maid for being in spirits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf6a7b5f-af87-3ac5-94a8-98c0190381e5",
                                        "entry_id": "8ef9026f-ef23-381e-b75f-b3b6084b8917",
                                        "glosses": [
                                            "An instance or period of being bored; a bored state."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2baf0df7-7135-40b5-8ff6-e8c45afd0d6a",
                                                "sense_id": "cf6a7b5f-af87-3ac5-94a8-98c0190381e5",
                                                "text": "If we are seeking a more original conception of boredom then we must also correspondingly endeavour to envisage a more original form of boredom, thus presumably a boredom in which we become more bored than in the situation we have characterized."
                                            },
                                            {
                                                "example_id": "416c46fe-635c-44d7-bb97-c50a39923561",
                                                "sense_id": "cf6a7b5f-af87-3ac5-94a8-98c0190381e5",
                                                "text": "Yet that earlier characterization was of a kind of boredom that can be portrayed as resembling acedia; that is, a boredom that I can be held responsible for, either in its genesis or its persistence."
                                            },
                                            {
                                                "example_id": "30756af5-7f48-48a6-84d4-56dcfdd2b94f",
                                                "sense_id": "cf6a7b5f-af87-3ac5-94a8-98c0190381e5",
                                                "text": "See more citations at boredoms."
                                            }
                                        ]
                                    }
                                ]
