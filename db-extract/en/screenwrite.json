                                "example_id": "e23c0602-e30b-40c5-a250-c2f77f78a960",
                                "sense_id": "4b78afd7-cd15-3575-a09d-f0310920d75a",
                                "text": "The stage is set for Jeffrey to convince Sandy to help him, and his words recall Dune's Duke Leto's words to his son, Paul, which Lynch had screenwritten from Frank Herbert's novel."
                            },
