                "senses": [
                    {
                        "sense_id": "74ef3d8c-7d99-37c7-b2b7-769a61cce0e4",
                        "entry_id": "1fcbba73-32fe-3cec-9c38-af8f6bf8b05d",
                        "glosses": [
                            "Freude, Genuss, Lust am Spielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9bc9413-c372-4694-a7e7-ae450eb5b37d",
                                "sense_id": "74ef3d8c-7d99-37c7-b2b7-769a61cce0e4",
                                "text": "„So lehren Sie sich und andere, fair zu spielen, so stören Sie die Spiellaune nicht mit garstigem Streit.“"
                            },
                            {
                                "example_id": "22135704-93ce-41db-ac9b-3dfb58383a7d",
                                "sense_id": "74ef3d8c-7d99-37c7-b2b7-769a61cce0e4",
                                "text": "„Durch spannende Spielangebote gelingt es meist, die Spiellaune wiederzugewinnen.“"
                            },
                            {
                                "example_id": "3593d7d2-f5c7-4620-ae4a-47de06a50fec",
                                "sense_id": "74ef3d8c-7d99-37c7-b2b7-769a61cce0e4",
                                "text": "„Gegen Ende der Spielzeit kam noch NHL-Rückkehrer Marco Sturm hinzu, der sich trotz längerer Pause in bester Spiellaune präsentierte und mit sechs Punkten aus fünf Partien zum Topscorer in den Playoffs avancierte.“"
                            },
                            {
                                "example_id": "fe0e149b-958e-4dab-a500-8f512b6e407d",
                                "sense_id": "74ef3d8c-7d99-37c7-b2b7-769a61cce0e4",
                                "text": "„Obwohl manche russischen und nordischen Meister sich gerne mit Wodka und ähnlichen geistigen Getränken in Spiellaune versetzten, machte dieses Beispiel wenig Schule, vielleicht auch angesichts von Vorkommnissen abgeschreckt, bei denen der Spieler am Brett einschlief.“"
                            },
                            {
                                "example_id": "9819b972-515c-4e4e-af65-2bf4502c9054",
                                "sense_id": "74ef3d8c-7d99-37c7-b2b7-769a61cce0e4",
                                "text": "„RB Leipzig kann sich dem Ruf des Bayern-Jägers nicht mehr entziehen und ist in seiner Spiellaune nicht zu stoppen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
