                                        "entry_id": "bb4ce505-3a0b-3c5c-9fda-8b3fc79ef354",
                                        "glosses": [
                                            "Console de jeu de la marque Nintendo."
                                        ],
                                        "tags": [
                                            "Jeux vidéo"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8538b938-65e5-4a3b-87b4-6dbf191e9c29",
                                                "sense_id": "288b9110-7322-33d7-af5a-79068561a6e3",
                                                "text": "Les enfants sont nourris gratuitement et disposent d’une Nintendo dans leur chambre."
                                            },
                                            {
                                                "example_id": "1c79a308-9a79-4867-83cb-fdf67ccb90d7",
                                                "sense_id": "288b9110-7322-33d7-af5a-79068561a6e3",
                                                "text": "Qu’il s’agisse d’une Nintendo ou d’une simple sucette, si bébé exige, bébé obtient."
                                            },
                                            {
                                                "example_id": "4bb80a60-f1a9-4b40-b22d-737c8e18eb9c",
                                                "sense_id": "288b9110-7322-33d7-af5a-79068561a6e3",
                                                "text": "Je les vois regarder la télévision avec de beaux programmes d'enfants, ou bien manipuler des Nintendos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "affa9616-2d49-3065-9950-1e01bef0224f",
                                        "entry_id": "bb4ce505-3a0b-3c5c-9fda-8b3fc79ef354",
                                        "glosses": [
                                            "Console de jeu."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Nintendo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5a01002c-3603-39a7-8ebc-9a61c0ba7c96",
                                        "entry_id": "88f4dfbc-a471-373e-bb9d-b10e83c9ca46",
                                        "glosses": [
                                            "Nom d’une entreprise produisant des consoles de jeux vidéo."
                                        ],
                                        "tags": [
                                            "Industrie",
                                            "Jeux vidéo"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15906db9-3658-4671-8f25-a388c5dcd52f",
                                                "sense_id": "5a01002c-3603-39a7-8ebc-9a61c0ba7c96",
                                                "text": "C’est un mariage qui peut étonner. Celui de la célèbre marque d’horlogerie de luxe TAG Heuer et de Nintendo."
                                            }
                                        ]
                                    }
