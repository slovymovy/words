                "senses": [
                    {
                        "sense_id": "0dba3265-4df8-32f3-903a-a5a12bfe5451",
                        "entry_id": "28694d97-b7d5-3279-9715-697f59f6289e",
                        "glosses": [
                            "Vorgang, der einen Geruch zu einem anderen Element oder zu einer Gruppe in Verbindung setzt; das Zuordnen oder das Zugeordnetwerden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1d66836-8bd2-4e60-b8ac-8a10bb5ba294",
                                "sense_id": "0dba3265-4df8-32f3-903a-a5a12bfe5451",
                                "text": "Für die Geruchszuordnung ist die Angabe des Geruchsstoff notwendig."
                            },
                            {
                                "example_id": "97be523a-53a8-4f24-befb-fbb909bdb946",
                                "sense_id": "0dba3265-4df8-32f3-903a-a5a12bfe5451",
                                "text": "„Oder es bleiben die für die Geruchsentwicklung, Geruchsentfaltung, Geruchswahrnehmung, Geruchsbeurteilung und Geruchszuordnung deutlich unterscheidenden Merkmale der Lufttemperatur, Luftfeuchtigkeit, oder Luftgeschwindigkeit unberücksichtigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e93c7f79-4c8b-3bf1-a7c9-e1ba312fd654",
                        "entry_id": "28694d97-b7d5-3279-9715-697f59f6289e",
                        "glosses": [
                            "die bestehende inhaltliche Verbindung eines Geruchs zu einem anderen oder zu einer Gruppe; das Zugeordnetsein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ea61ccd-61f4-4892-98a1-0f6b482bf667",
                                "sense_id": "e93c7f79-4c8b-3bf1-a7c9-e1ba312fd654",
                                "text": "„Oder es bleiben die für die Geruchsentwicklung, Geruchsentfaltung, Geruchswahrnehmung, Geruchsbeurteilung und Geruchszuordnung deutlich unterscheidenden Merkmale der Lufttemperatur, Luftfeuchtigkeit, oder Luftgeschwindigkeit unberücksichtigt.“"
                            },
                            {
                                "example_id": "67f8c1f4-493e-43b9-b180-3b4d3f5d4a8a",
                                "sense_id": "e93c7f79-4c8b-3bf1-a7c9-e1ba312fd654",
                                "text": "Es besteht eine eindeutige Geruchszuordnung von Geruchsstoff und Geruchsquelle."
                            },
                            {
                                "example_id": "3bb5e750-d061-4185-9bc6-8ab3ad968281",
                                "sense_id": "e93c7f79-4c8b-3bf1-a7c9-e1ba312fd654",
                                "text": "„ Auffallend ist, dass einem der Teilnehmer bei der ersten Aufgabe die Geruchszuordnung deutlich leichter fiel - er beantwortete hier zwölf Fragen richtig, allerdings nur vier bei Zuordnung der Textlabels.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
