                "senses": [
                    {
                        "sense_id": "96a78c0a-7fdd-3776-a13b-1c04b5c01e51",
                        "entry_id": "57f40619-dc54-39a7-959f-a191c453994b",
                        "glosses": [
                            "susceptible to twitching a lot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd175c12-61e8-4923-be08-8ee885cb0506",
                                "sense_id": "96a78c0a-7fdd-3776-a13b-1c04b5c01e51",
                                "text": "For the most part, however, his hunched, twitchy, wide-eyed take doesn’t seem like a believable portrait of social awkwardness so much as just a forced, awkward performance."
                            }
                        ]
                    },
                    {
                        "sense_id": "e5a59c57-3005-308c-b870-9fb482a8e612",
                        "entry_id": "57f40619-dc54-39a7-959f-a191c453994b",
                        "glosses": [
                            "irritable, cranky, nervous, anxious, worried"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "f2e9f3cc-5bec-477e-81f2-4f6dfd3dbb98",
                                "sense_id": "e5a59c57-3005-308c-b870-9fb482a8e612",
                                "text": "Johnson's contract expires in November, and four weeks as memorable for scandals off the pitch as any achievements on it will do little to appease the notoriously twitchy committee-men at the Rugby Football Union."
                            },
                            {
                                "example_id": "63050847-6ee8-4f2f-9349-cdd931702ce8",
                                "sense_id": "e5a59c57-3005-308c-b870-9fb482a8e612",
                                "text": "Railways don't normally feature, but Conservative MPs are getting twitchy about this nationwide local issue."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ceba872-051d-4dd2-83d1-60404cffdc7a",
                        "source_entry_id": "57f40619-dc54-39a7-959f-a191c453994b",
                        "source_sense_description": "inclined to twitch a lot",
                        "target_lang_word": "unruhig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unruhig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1b8c3d8e-0996-38e1-93fc-1f2cb6cdb74c",
                                        "entry_id": "3014eea0-9d6d-3857-aac3-dcaedde2f43b",
                                        "glosses": [
                                            "nervös, nicht gelassen"
                                        ],
                                        "tags": [
                                            "Sinnesstimmung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73e7faa1-bc91-4b84-8b92-3a166ae0bbf9",
                                                "sense_id": "1b8c3d8e-0996-38e1-93fc-1f2cb6cdb74c",
                                                "text": "Er ist heute schon den ganzen Tag so unruhig."
                                            },
                                            {
                                                "example_id": "757abf8a-d6e4-47cd-857d-c131d5ba990c",
                                                "sense_id": "1b8c3d8e-0996-38e1-93fc-1f2cb6cdb74c",
                                                "text": "Als Gregor Samsa eines Morgens aus unruhigen Träumen erwachte, fand er sich in seinem Bett zu einem ungeheuren Ungeziefer verwandelt."
                                            },
                                            {
                                                "example_id": "247e7b25-b6bd-4c75-adbc-143bda29e8f7",
                                                "sense_id": "1b8c3d8e-0996-38e1-93fc-1f2cb6cdb74c",
                                                "text": "Allgemein sind die Märkte sehr unruhig, nicht nur China sondern auch allgemein in den asiatischen Ländern, Lateinamerika und der Westen. Je größer die Abhängigkeit von China, desto unruhiger ist der Markt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e9dde843-0c46-3c48-9d0f-d546e813d23e",
                                        "entry_id": "3014eea0-9d6d-3857-aac3-dcaedde2f43b",
                                        "glosses": [
                                            "sich unregelmäßig, aber stetig bewegend"
                                        ],
                                        "tags": [
                                            "Bewegung und Verhalten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2a171bd-6b0a-40a8-a7e5-e3611cfdc237",
                                                "sense_id": "e9dde843-0c46-3c48-9d0f-d546e813d23e",
                                                "text": "Es stellten sich bei der Läuferin Schwindel und ein unruhiger Puls ein."
                                            },
                                            {
                                                "example_id": "dcbd5f32-98db-48fa-9db6-f7030c1b5740",
                                                "sense_id": "e9dde843-0c46-3c48-9d0f-d546e813d23e",
                                                "text": "Wir blickten auf die zunehmend unruhigere Ostsee hinaus."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "42928036-b0d1-3422-bea5-9d0cf40a1308",
                                        "entry_id": "3014eea0-9d6d-3857-aac3-dcaedde2f43b",
                                        "glosses": [
                                            "hektisch und laut, vielleicht sogar gefährlich"
                                        ],
                                        "tags": [
                                            "Umfeld"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "677dd14a-b27e-4cfe-bb4f-cc11fef58c32",
                                                "sense_id": "42928036-b0d1-3422-bea5-9d0cf40a1308",
                                                "text": "Das Hotel lag in einer unruhigen Gegend."
                                            },
                                            {
                                                "example_id": "50b072e2-7fe6-4a34-92d1-0fcf44737998",
                                                "sense_id": "42928036-b0d1-3422-bea5-9d0cf40a1308",
                                                "text": "Die beiden waren in einer unruhigen Gegend aufgewachsen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
