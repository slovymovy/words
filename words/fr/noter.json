                    ]
                },
                {
                    "sense_id": "2952bf52-6c2c-38f3-947f-d6c859d6be73",
                    "sense_definition": "Évaluer ou porter un jugement sur la compétence ou la conduite d'un employé.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "evaluation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce responsable administratif a été très bien <w>noté</w> par sa hiérarchie cette année."
                        },
                        {
                            "text": "Une telle attitude risque de mal vous faire <w>noter</w> auprès de la direction."
                        }
                    ],
                    "common_phrases": [
