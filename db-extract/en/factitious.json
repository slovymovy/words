                        ]
                    },
                    {
                        "translation_id": "597b1a7d-0dc9-43a1-8cb7-1a4c79de5f4d",
                        "source_entry_id": "9d307584-2fc9-332d-895f-fdce8dcf0ab7",
                        "source_sense_description": "counterfeit, fabricated",
                        "target_lang_word": "factice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "factice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d5dfcb2a-1875-31e9-a08c-3e8f960f75d0",
                                        "entry_id": "3da865cb-1769-30f4-ac9f-4542c9ae2a6e",
                                        "glosses": [
                                            "Qui est fait artificiellement ou imité de la nature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9aaaf68c-c795-4cdb-85c6-e01427d5e9d5",
                                                "sense_id": "d5dfcb2a-1875-31e9-a08c-3e8f960f75d0",
                                                "text": "Point de raillerie! « L'Europe est dans un état tel, que la moindre effervescence peut mettre en péril son repos, son équilibre factice. »"
                                            },
                                            {
                                                "example_id": "b253aa17-774b-4ac2-8dc1-bfb2ee13dca8",
                                                "sense_id": "d5dfcb2a-1875-31e9-a08c-3e8f960f75d0",
                                                "text": "Ces pierres factices ont beaucoup mieux résisté aux agents atmosphériques que les pierres de grès ; elles sont composées d’un mortier parfaitement dur, mêlé de cailloux concassés de la grosseur d’un œuf, et ont dû être façonnées dans des caisses de bois."
                                            },
                                            {
                                                "example_id": "d3140633-4794-49b7-a2d8-6e35043ea41e",
                                                "sense_id": "d5dfcb2a-1875-31e9-a08c-3e8f960f75d0",
                                                "text": "Il passa devant plusieurs tableaux et eut l’impression de la sécheresse et de l’inutilité d’un art si factice, et qui ne valait pas les courants d’air et de soleil d’un palazzo de Venise, ou d’une simple maison au bord de la mer."
                                            },
                                            {
                                                "example_id": "63c58cd2-f0c9-4d75-8f76-afaac8e18873",
                                                "sense_id": "d5dfcb2a-1875-31e9-a08c-3e8f960f75d0",
                                                "text": "Nul n'oserait contester que, depuis 1918, les spéculations sur les denrées alimentaires ont été générales et sans frein. Le public se doute bien un peu qu'on l’affame et que les hauts prix maintenus malgré toutes les tentatives sont factices. Mais qui accuser ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dfc1b31-c0b6-3330-a7fd-06eb7685e3c1",
                                        "entry_id": "3da865cb-1769-30f4-ac9f-4542c9ae2a6e",
                                        "glosses": [
                                            "Qualifie la reproduction d’un objet ne conservant que son apparence sans aucune de ses fonctionnalités."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "859a2e02-1a8d-46f1-a248-425d184d3426",
                                                "sense_id": "3dfc1b31-c0b6-3330-a7fd-06eb7685e3c1",
                                                "text": "Certains particuliers désirent surfer sur la vague de popularité des caméras en installant des caméras factices sur leur propriété. Est-ce véritablement efficace ?"
                                            },
                                            {
                                                "example_id": "b521ebf0-3f3f-4c8b-adb7-74eba4d1a517",
                                                "sense_id": "3dfc1b31-c0b6-3330-a7fd-06eb7685e3c1",
                                                "text": "Samedi, un homme a été abattu à Chinon en brandissant une arme factice vers les gendarmes."
                                            },
                                            {
                                                "example_id": "df1ebca6-965a-48ff-bb56-0d80ba506d8c",
                                                "sense_id": "3dfc1b31-c0b6-3330-a7fd-06eb7685e3c1",
                                                "text": "Dans une interview donnée mardi à France 3, le rappeur grenoblois expliquait que tout est factice dans le clip : armes et drogues. Il doit à présent s’en expliquer devant la justice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8d740b5-3731-3105-9fc6-76259ab75c60",
                                        "entry_id": "3da865cb-1769-30f4-ac9f-4542c9ae2a6e",
                                        "glosses": [
                                            "Qualifie des sentiments feints, forcés, contraires à ceux qu’on éprouve réellement."
                                        ],
                                        "tags": [
                                            "common",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "166e1d03-1240-47ad-9a4f-4107923b6732",
                                                "sense_id": "f8d740b5-3731-3105-9fc6-76259ab75c60",
                                                "text": "Ses douleurs secrètes planèrent toujours sur sa gaieté factice comme un léger nuage qui dérobe imparfaitement le soleil."
                                            },
                                            {
                                                "example_id": "5f915655-32d7-416a-966c-83bb600f042f",
                                                "sense_id": "f8d740b5-3731-3105-9fc6-76259ab75c60",
                                                "text": "Ce fut donc le clergé qui, à Plassans, mena la réaction. La noblesse devint son prête-nom, rien de plus ; il se cacha derrière elle, il la gourmanda, la dirigea, parvint même à lui rendre une vie factice."
                                            },
                                            {
                                                "example_id": "837ea8b5-1d06-45d9-8b8c-3e6245230118",
                                                "sense_id": "f8d740b5-3731-3105-9fc6-76259ab75c60",
                                                "text": "[…], seule la volonté farouche de vivre encore pour le revoir lui avaient donné une force factice pour lutter contre la phtisie dévorante, rapide."
                                            },
                                            {
                                                "example_id": "4aa970eb-effb-423e-8182-ee291dd66209",
                                                "sense_id": "f8d740b5-3731-3105-9fc6-76259ab75c60",
                                                "text": "Patrick multipliait les calembours mais sa gaieté semblait un peu factice."
                                            },
                                            {
                                                "example_id": "971d427d-92c5-4a79-b898-43011e044d86",
                                                "sense_id": "f8d740b5-3731-3105-9fc6-76259ab75c60",
                                                "text": "le propre de TikTok c'est de faire des formats amateurs qui signent une proximité, une promiscuité factice, ça paraît spontané et ça vise à rendre sympathique mais c'est travaillé sélectionné en amont"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "052f8f22-fd75-34dc-a512-7564b3159c10",
                                        "entry_id": "3da865cb-1769-30f4-ac9f-4542c9ae2a6e",
                                        "glosses": [
                                            "Qualifie un besoin, une envie, qu’on s’est créé à soi-même, qui est l’effet d’une habitude, d’un caprice."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "pejorative"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5cb0f057-e9d9-39bd-b2cf-7a57c64a8c7b",
                                        "entry_id": "3da865cb-1769-30f4-ac9f-4542c9ae2a6e",
                                        "glosses": [
                                            "Qualifie un recueil fait de pièces diverses reliées ensemble."
                                        ],
                                        "tags": [
                                            "Librairie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "28b1303c-0321-3dff-bf88-7ac586f67266",
                                        "entry_id": "3da865cb-1769-30f4-ac9f-4542c9ae2a6e",
                                        "glosses": [
                                            "Qualifie un mot qui est dérivé d’un autre mot suivant l’analogie ordinaire, mais dont l’usage n’est pas établi."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "factice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "45d1afdf-e46f-3c70-a93c-c200fd355310",
                                        "entry_id": "c7120945-adcb-3a93-932a-8f3fbccf5cc8",
                                        "glosses": [
                                            "Ce qui est artificiel, superficiel, feint. (Ne s’emploie qu’au singulier)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "918f2af6-4bd0-43c7-8e10-743b4ee9644b",
                                                "sense_id": "45d1afdf-e46f-3c70-a93c-c200fd355310",
                                                "text": "On peut, de fait, être sincère dans le factice (c’est ce qu’écrit, du reste, Gide) ; mais le factice empêche la sincérité de tenir, de se maintenir, de durer et de pouvoir être reprise par la suite : c’est que les deux termes ne recouvrent pas le même domaine."
                                            },
                                            {
                                                "example_id": "82ed7c38-f6e6-4566-8a59-94eaa33dd106",
                                                "sense_id": "45d1afdf-e46f-3c70-a93c-c200fd355310",
                                                "text": "Si les questions du masque et de la scène convoquent la notion d’imposture, la question du factice aussi. Le factice et le fétiche, comme nous l’avons souligné au sujet de l’image et des représentations, sont deux noms qui proviennent du même mot latin facticius, « artificiel»."
                                            },
                                            {
                                                "example_id": "282bed86-2ccd-4183-a9b8-2939a9ff3b03",
                                                "sense_id": "45d1afdf-e46f-3c70-a93c-c200fd355310",
                                                "text": "Singapour fait cet effet de luxe, de gratuité, de factice éblouissant, d’apparat et de culte de la facilité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4b5674a-1fd9-3b49-8908-39900582c6f6",
                                        "entry_id": "c7120945-adcb-3a93-932a-8f3fbccf5cc8",
                                        "glosses": [
                                            "Reproduction, utilisée à des fins d’étalage publicitaire, d’un objet proposé à la vente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58f03275-f232-4e2d-9aa3-30bb347fdd7a",
                                                "sense_id": "c4b5674a-1fd9-3b49-8908-39900582c6f6",
                                                "text": "Un factice géant est une reproduction géante généralement en matière plastique d’un article à promouvoir."
                                            },
                                            {
                                                "example_id": "7864cc1d-078a-498a-800e-8c9e99e33203",
                                                "sense_id": "c4b5674a-1fd9-3b49-8908-39900582c6f6",
                                                "text": "Il existe plusieurs tailles de factices de celui correspondant à la taille du flacon en vente jusqu’au géant, que l’on pouvait présenter dans une vitrine et visible de loin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4460e556-e1ce-36af-92f9-0ec7b6086183",
                                        "entry_id": "c7120945-adcb-3a93-932a-8f3fbccf5cc8",
                                        "glosses": [
                                            "Additif d’origine végétale, utilisé dans l’élaboration de caoutchoucs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72610748-cafc-4d93-a189-02a88447232d",
                                                "sense_id": "4460e556-e1ce-36af-92f9-0ec7b6086183",
                                                "text": "Le factice est un pur produit de chimie du végétal obtenu par vulcanisation des huiles végétales, par exemple des huiles de colza, de ricin, de soja ou de lin, pour obtenir une gomme qui est le plus souvent broyée pour faciliter son introduction dans des formulations de caoutchouc où il joue un rôle de dispersant."
                                            },
                                            {
                                                "example_id": "7aac77a4-a211-4e48-9fa9-10e88e454af0",
                                                "sense_id": "4460e556-e1ce-36af-92f9-0ec7b6086183",
                                                "text": "Le factice est un additif pour caoutchouc biosourcé et le seul ingrédient non extractible. Sa formidable compatibilité avec tous les élastomères le rend indispensable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
