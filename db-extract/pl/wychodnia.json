                "senses": [
                    {
                        "sense_id": "f8ccfe7a-f4b7-359c-9d6f-f6304a749dbe",
                        "entry_id": "4fae2194-4005-3f6b-a1b0-09e4bfbbecf8",
                        "glosses": [
                            "miejsce, w którym skała (ciało, warstwa geologiczna) wychodzi ponad powierzchnię ziemi"
                        ],
