                                    {
                                        "sense_id": "396b2e11-5b63-3f64-a30f-cbbae6ecf4d8",
                                        "entry_id": "81e3001f-24e0-3c75-841e-660e6d6db610",
                                        "glosses": [
                                            "To destroy by fire."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8c5c04c-6cf3-4526-8a89-c0d353496262",
                                                "sense_id": "396b2e11-5b63-3f64-a30f-cbbae6ecf4d8",
                                                "text": "All four engines and the entire train were derailed, and owing to the fact that all the vehicles except the sleeping cars were gas-lit, the whole of the coaching stock except the two rear brakes was burned out, beginning with the two front coaches, which were completely wrecked."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7c45de2-dfa1-3764-89f8-1479ab00fc38",
                                        "entry_id": "81e3001f-24e0-3c75-841e-660e6d6db610",
                                        "glosses": [
                                            "To become extinguished due to lack of fuel."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b6b9d00-8eb2-454e-af77-14dcf9425e94",
                                                "sense_id": "b7c45de2-dfa1-3764-89f8-1479ab00fc38",
                                                "text": "The candle finally burned out."
                                            },
                                            {
                                                "example_id": "88544d5c-7517-42f5-b864-d387b56207f0",
                                                "sense_id": "b7c45de2-dfa1-3764-89f8-1479ab00fc38",
                                                "text": "1847, Charlotte Brontë, Jane Eyre, Chapter XVIII\nMr. Mason, shivering as some one chanced to open the door, asked for more coal to be put on the fire, which had burnt out its flame, though its mass of cinder still shone hot and red. The footman who brought the coal, in going out, stopped near Mr. Eshton's chair, and said something to him in a low voice, of which I heard only the words, \"old woman,\"—\"quite troublesome.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09a432a6-6f12-3d19-ad59-bd82ea3f3365",
                                        "entry_id": "81e3001f-24e0-3c75-841e-660e6d6db610",
                                        "glosses": [
                                            "To become nonfunctional (especially of lightbulbs or similar light-producing devices)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b823cd71-96a9-3152-b385-1d1e6dfbb0c4",
                                        "entry_id": "81e3001f-24e0-3c75-841e-660e6d6db610",
                                        "glosses": [
                                            "To tire due to overwork; to overwork to one's limit."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "861fd1bc-b9bb-4e04-a97d-6755f9008cb6",
                                                "sense_id": "b823cd71-96a9-3152-b385-1d1e6dfbb0c4",
                                                "text": "After six months of twelve-hour workdays, most people just burn out and quit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14085869-e5a7-3751-844c-a19e1d77a159",
                                        "entry_id": "81e3001f-24e0-3c75-841e-660e6d6db610",
                                        "glosses": [
                                            "To cause (someone) to tire due to overwork; to cause (someone) to overwork to one's limit."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5ce2b8b1-13b2-3c4e-b2e4-731a3355c7c4",
                                        "entry_id": "81e3001f-24e0-3c75-841e-660e6d6db610",
                                        "glosses": [
                                            "To end one's shift at a job."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f40c0354-d012-4220-9756-c12601d61728",
                                                "sense_id": "5ce2b8b1-13b2-3c4e-b2e4-731a3355c7c4",
                                                "text": "I start my shift at three in the afternoon, and get to burn out at midnight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f36f7ae0-d205-3a7e-a70b-3cbf159987b6",
                                        "entry_id": "81e3001f-24e0-3c75-841e-660e6d6db610",
                                        "glosses": [
                                            "To have one's tires skid against the ground; to peel off, peel out."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b058a4d-d4ae-3192-8882-795e885d7344",
                                        "entry_id": "81e3001f-24e0-3c75-841e-660e6d6db610",
                                        "glosses": [
                                            "To make (someone) unavailable for work involving exposure to ionizing radiation by employing (the person) in such work until the person's accumulated exposure reaches the maximum permitted for an administrative period, typically a year."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6effd79-07c1-4225-bfd1-d19fc499d758",
                                                "sense_id": "3b058a4d-d4ae-3192-8882-795e885d7344",
                                                "text": "The repairs on this nuclear reactor have burned out every welder in the province."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7929d460-4c81-36ea-84a3-68bc5639c517",
                                        "entry_id": "81e3001f-24e0-3c75-841e-660e6d6db610",
                                        "glosses": [
                                            "To use up too much energy when first bowled and to therefore not finish strongly."
                                        ],
