                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "32fae0d8-277d-3343-9527-e50728a7b540",
                                        "entry_id": "ef0b7935-35e9-37d4-ad6b-8eccb1a1be09",
