                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biogenèse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e33a99ca-2522-3619-bcac-00aa062b54ce",
                                        "entry_id": "9b9c5c75-87be-3479-96ab-f8aab15df9f9",
                                        "glosses": [
                                            "Théorie selon laquelle un être vivant ne peut provenir que d’un autre être vivant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6e3e0ce-3903-4014-8b34-80ccb32d908b",
                                                "sense_id": "e33a99ca-2522-3619-bcac-00aa062b54ce",
                                                "text": "On nomme aujourd'hui abiogenèse … la production d’êtres vivants sans l’intervention d’autres êtres vivants ; biogenèse, la reproduction d’un vivant par un vivant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "784b70b0-f9d0-360c-9e2d-a96d5b33eb1d",
                                        "entry_id": "9b9c5c75-87be-3479-96ab-f8aab15df9f9",
                                        "glosses": [
                                            "Ensemble des conditions physiques et chimiques ayant permis l’apparition de la vie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f7a89499-9b09-3869-891a-c8d8050f3fbf",
                                        "entry_id": "9b9c5c75-87be-3479-96ab-f8aab15df9f9",
                                        "glosses": [
                                            "Élaboration par un organisme vivant de substances diverses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23b028a9-97e5-4b92-b3d3-6afcf9c7bca8",
                                                "sense_id": "f7a89499-9b09-3869-891a-c8d8050f3fbf",
                                                "text": "Les bancs de coraux sont le résultat d’une biogenèse d’animaux de l’embranchement des Cnidaires."
                                            },
                                            {
                                                "example_id": "ea15119f-197b-48d6-b9ab-8c322c9a6792",
                                                "sense_id": "f7a89499-9b09-3869-891a-c8d8050f3fbf",
                                                "text": "Le mode vie autotrophique des plantes repose entièrement sur l'intégrité du chloroplaste et notamment l'étape de la biogénèse"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
