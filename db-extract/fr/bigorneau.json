        "fr-extract.jsonl": [
            {
                "entry_id": "c3ccb355-c66d-36fb-8251-b32604cbca45",
                "word": "bigorneau",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a7b0d243-8b30-4e7f-b424-1fc308a0fb4e",
                        "entry_id": "c3ccb355-c66d-36fb-8251-b32604cbca45",
                        "tags": [
                            "plural"
                        ],
                        "form": "bigorneaux"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b1d07d9b-c011-3e3e-b402-59ff3b70e62e",
                        "entry_id": "c3ccb355-c66d-36fb-8251-b32604cbca45",
                        "glosses": [
                            "Coquillage marin comestible à forme d’escargot, du genre Littorina, en particulier Littorina littorea."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ee4fcc8-67b6-4a65-b778-57516103c6d0",
                                "sense_id": "b1d07d9b-c011-3e3e-b402-59ff3b70e62e",
                                "text": "— « Mère Le Gannec, je veux des palourdes… mère Le Gannec, je veux des bigorneaux… » Ah ! dame, on lui en donnait des palourdes et des bigorneaux !"
                            },
                            {
                                "example_id": "ebb31776-c99b-4361-85e1-fbbdf2dc6e35",
                                "sense_id": "b1d07d9b-c011-3e3e-b402-59ff3b70e62e",
                                "text": "Joss ne savait que griller des bars, ouvrir des huîtres et gober des bigorneaux. Si bien que soir après soir, il mangeait des conserves."
                            },
                            {
                                "example_id": "93ecc127-d4cc-4d0a-9050-150f7fe9c6fe",
                                "sense_id": "b1d07d9b-c011-3e3e-b402-59ff3b70e62e",
                                "text": "À douze ans, sa fille avait la sociabilité d’un bigorneau."
                            },
                            {
                                "example_id": "77f7e0ae-0d7b-4c4b-b162-adf1e319e187",
                                "sense_id": "b1d07d9b-c011-3e3e-b402-59ff3b70e62e",
                                "text": "On privilégiera les abords de la Cotinière, sur Oléron, pour les étrilles, les oursins, les bigorneaux et les patelles."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f1062bf-5122-35f9-824d-e5dcdfaf32db",
                        "entry_id": "c3ccb355-c66d-36fb-8251-b32604cbca45",
                        "glosses": [
                            "Tout autre coquillage de forme analogue."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b3d3ac54-c43e-3940-9330-0f84e16015c8",
                        "entry_id": "c3ccb355-c66d-36fb-8251-b32604cbca45",
                        "glosses": [
                            "Petite bigorne. ^([1])"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d1627c11-2974-36ad-997b-822660e86f13",
                        "entry_id": "c3ccb355-c66d-36fb-8251-b32604cbca45",
                        "glosses": [
                            "Extrémité arrondie de la bigorne."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "28a46033-a4ee-38bf-8a2e-c55f8bd75d1f",
                        "entry_id": "c3ccb355-c66d-36fb-8251-b32604cbca45",
                        "glosses": [
                            "Téléphone. (en raison probablement de la forme évasée du microphone et de l'écouteur)."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "53cac199-8aa6-4bef-90e6-000def6749c8",
                                "sense_id": "28a46033-a4ee-38bf-8a2e-c55f8bd75d1f",
                                "text": "En sortant du spectacle, il est allé boire un verre sans se presser, a encore filé un coup de bigorneau, puis s’est rendu chez Dany Darnys."
                            }
                        ]
                    },
                    {
                        "sense_id": "3820d242-d9b3-3e86-99ea-2a6571e3078a",
                        "entry_id": "c3ccb355-c66d-36fb-8251-b32604cbca45",
                        "glosses": [
                            "Personne quelconque ; quidam."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b097e2df-4397-4e2e-a80f-961cd53d91c1",
                                "sense_id": "3820d242-d9b3-3e86-99ea-2a6571e3078a",
                                "text": "Sur les cinq bigorneaux qu’on vous alignera pour le juger, derrière le tapis, y en aura pas un d’assez culotté pour bien savoir ce que c’est que la frousse !…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "599a35b7-19e1-4ed4-b11b-fca767931610",
                        "source_entry_id": "c3ccb355-c66d-36fb-8251-b32604cbca45",
                        "source_sense_description": "littorine",
                        "target_lang_word": "Strandschnecke",
