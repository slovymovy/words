                "senses": [
                    {
                        "sense_id": "5431da69-c99c-3d7c-bbe5-be64b5a25b40",
                        "entry_id": "318cad3e-5c1c-3497-97d9-ef571c1b9407",
                        "glosses": [
                            "Syndicat français regroupant des personnes fournissant des prestations sexuelles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcb79bb8-8490-467a-845d-c5749a414fde",
                                "sense_id": "5431da69-c99c-3d7c-bbe5-be64b5a25b40",
                                "text": "Une escort et actrice porno, par ailleurs militante du Syndicat du travail sexuel (Strass), s’est filmée le 11 mars, au sein de la mairie de Paris en plein acte sexuel, avec, selon elle, un client, durant la Nuit des fiertés."
                            },
                            {
                                "example_id": "d754d21d-42b6-4ab6-a360-a43cf12e15ce",
                                "sense_id": "5431da69-c99c-3d7c-bbe5-be64b5a25b40",
                                "text": "HelloAsso est une entreprise sociale et solidaire, qui fournit gratuitement ses technologies de paiement à l’organisme Syndicat du travail sexuel - Strass."
                            },
                            {
                                "example_id": "382810f0-5ffe-4f04-b059-89d608cec685",
                                "sense_id": "5431da69-c99c-3d7c-bbe5-be64b5a25b40",
                                "text": "Berthe, 27 ans, est la nouvelle représentante du Syndicat du travail sexuel (Strass) dans l’Indre."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "902fcb8b-a375-315b-902d-089cd5de9f9f",
                "word": "strass",
