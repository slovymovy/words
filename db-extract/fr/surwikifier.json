                "senses": [
                    {
                        "sense_id": "58b533ea-fa59-33eb-95fb-31a8fa794480",
                        "entry_id": "04933b73-f601-3c1d-9610-fec2e4adab37",
                        "glosses": [
                            "Wikifier plus que nécessaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b66bfd52-88b3-4ae9-844e-ca33c6590796",
                                "sense_id": "58b533ea-fa59-33eb-95fb-31a8fa794480",
                                "text": "Si vous voulez vraiment mon avis, je trouve que la surcatégorisation automatique à outrance participe au phénomène de surwikifier Wikipédia au détriment de la cohérence du contenu."
                            },
                            {
                                "example_id": "3aac765a-44ed-4bf5-af41-26e6c25fe5f8",
                                "sense_id": "58b533ea-fa59-33eb-95fb-31a8fa794480",
                                "text": "Tryptophane06 ( d · c · b ), tu as tendance à surwikifier un peu."
                            },
                            {
                                "example_id": "69558c79-2320-47cc-b075-e9714ea13971",
                                "sense_id": "58b533ea-fa59-33eb-95fb-31a8fa794480",
                                "text": "Ainsi, par exemple, la section #À propos de l’auteur du présent texte est probablement surwikifiée."
                            }
                        ]
                    }
