        "ru-extract.jsonl": [],
        "nl-extract.jsonl": [
            {
                "entry_id": "4f6ef6d7-397e-3e71-aecd-6864e8f60a69",
                "word": "voortleven",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bb1f6132-2a8d-3c3b-9a2e-ff996baa3d37",
                        "entry_id": "4f6ef6d7-397e-3e71-aecd-6864e8f60a69",
                        "glosses": [
                            "doorgaan met leven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "945a3685-9ca5-4822-8e83-f049b2fe266f",
                                "sense_id": "bb1f6132-2a8d-3c3b-9a2e-ff996baa3d37",
                                "text": "Zij leefden nog een lange tijd voort na het bereiken van de pensioengerechtigde leeftijd."
                            }
                        ]
                    },
                    {
                        "sense_id": "3df5c26e-766d-3cfd-aebf-9d3525200371",
                        "entry_id": "4f6ef6d7-397e-3e71-aecd-6864e8f60a69",
                        "glosses": [
                            "doorgaan met te bestaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89ba44bc-1acd-4216-ad68-6f0a283918a0",
                                "sense_id": "3df5c26e-766d-3cfd-aebf-9d3525200371",
                                "text": "Hij bleef nog lang voortleven in hun herinnering."
                            },
                            {
                                "example_id": "f5b47ba8-f5d6-46fd-a8d4-ad5abbb8e683",
                                "sense_id": "3df5c26e-766d-3cfd-aebf-9d3525200371",
                                "text": "Graag zou ik willen geloven in een ziel die doorleeft na de dood, maar ik geloof eerder dat de zielen van onze overleden vrienden voortleven in de harten van mensen die aan hen terugdenken."
                            },
                            {
                                "example_id": "23f0c9b3-9af8-4cee-ab23-def5c7dbe99c",
                                "sense_id": "3df5c26e-766d-3cfd-aebf-9d3525200371",
                                "text": "Ze bezong in haar muziek de tegenslagen en successen in het leven. Ik vind het heel bijzonder dat ze Liesbeth - de musical nog heeft kunnen meemaken. Ik zal haar nooit vergeten en hoop dat haar muziek nog lang zal voortleven."
                            }
                        ]
                    }
                ],
