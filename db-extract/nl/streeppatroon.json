                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8943325-da95-46e7-807a-867201d44aa7",
                                "sense_id": "ac9cf1e3-719d-34be-a876-bd2541e76d0b",
                                "text": "Toen ik tussen twee stenen stapte, zag ik een vreemde kiezel liggen met een streeppatroon."
                            },
                            {
                                "example_id": "ea937f31-99c0-4c50-ad30-117c29a94c85",
                                "sense_id": "ac9cf1e3-719d-34be-a876-bd2541e76d0b",
                                "text": "Het gestreepte pak is bedoeld om de haai af te schrikken. Alle dieren kunnen namelijk onderscheid maken tussen zwart en wit. En het contrasterende streeppatroon werkt in de natuur als een waarschuwing: eet mij niet."
                            }
                        ]
