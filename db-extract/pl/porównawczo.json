                    {
                        "translation_id": "0321eb31-7af5-4d75-9c0e-1284fbb87ea4",
                        "source_entry_id": "a70bf018-416a-3b6e-b514-9f83b99f04fb",
                        "source_sense_id": "41c98137-fb9e-3f1d-9ded-b2c6903de3b1",
