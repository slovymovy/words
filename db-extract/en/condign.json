                    {
                        "translation_id": "985418dc-55b6-42da-9478-8961b938ec3e",
                        "source_entry_id": "86b65d74-7f98-36c7-88a4-d3e90dd21722",
                        "source_sense_id": "fb61cf76-bc0e-3008-8048-8d9f922526bd",
