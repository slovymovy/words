{
    "word_family": [
        "simulate",
        "simulation",
        "simulator",
        "simulative"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "56ad0581-922c-35a7-84b2-34d1f894a9c0",
                    "sense_definition": "A small removable card in a mobile phone that stores data and identifies the subscriber.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "telecommunications",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to buy a local <w>sim</w> card so I can use the internet while traveling.",
                            "target_lang_translations": {
                                "ru": "Мне нужно купить местную <w>сим-карту</w>, чтобы пользоваться интернетом в путешествии."
                            }
                        },
                        {
                            "text": "The phone operators were ordered to block any <w>sim</w> not linked to a national identity number.",
                            "target_lang_translations": {
                                "ru": "Операторам связи было приказано заблокировать любую <w>симку</w>, не привязанную к национальному идентификационному номеру."
                            }
                        }
                    ],
                    "synonyms": [
                        "SIM card",
                        "subscriber identity module"
                    ],
                    "common_phrases": [
                        "sim card",
                        "dual sim",
                        "prepaid sim"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая съемная карта в мобильном телефоне, которая хранит данные и идентифицирует абонента."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сим-карта",
                                "target_lang_sense_clarification": "мобильная связь"
                            },
                            {
                                "target_lang_word": "симка",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "efac955f-5d1c-343f-9525-3125faee5c4d",
                    "sense_definition": "A video game or software program that mimics real-world activities, such as flying or driving.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "simulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the whole weekend playing a flight <w>sim</w> in his room.",
                            "target_lang_translations": {
                                "ru": "Он провел все выходные, играя в авиа<w>симулятор</w> у себя в комнате."
                            }
                        },
                        {
                            "text": "Many racing <w>sims</w> require a steering wheel controller for the best experience.",
                            "target_lang_translations": {
                                "ru": "Многие гоночные <w>симуляторы</w> требуют наличия руля для лучшего погружения."
                            }
                        }
                    ],
                    "synonyms": [
                        "simulator",
                        "simulation"
                    ],
                    "common_phrases": [
                        "flight sim",
                        "racing sim",
                        "dating sim"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "shortened form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Видеоигра или компьютерная программа, имитирующая реальную деятельность, например, полет или вождение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "симулятор",
                                "target_lang_sense_clarification": "жанр игр"
                            },
                            {
                                "target_lang_word": "сим",
                                "target_lang_sense_clarification": "геймерский сленг"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5bb7da6-2243-3215-97af-2a2bcde1390a",
                    "sense_definition": "A specific session or scenario conducted within a simulator for training or testing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "simulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilots completed a three-hour <w>sim</w> to practice emergency landings.",
                            "target_lang_translations": {
                                "ru": "Пилоты прошли трехчасовую <w>симуляцию</w>, чтобы отработать аварийную посадку."
                            }
                        },
                        {
                            "text": "During the medical <w>sim</w>, the students had to react quickly to a heart attack scenario.",
                            "target_lang_translations": {
                                "ru": "Во время медицинской <w>симуляции</w> студенты должны были быстро среагировать на сценарий сердечного приступа."
                            }
                        }
                    ],
                    "synonyms": [
                        "simulation"
                    ],
                    "common_phrases": [
                        "training sim",
                        "emergency sim"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "professional jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретная сессия или сценарий, проводимый в симуляторе для обучения или тестирования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "симуляция",
                                "target_lang_sense_clarification": "процесс обучения"
                            },
                            {
                                "target_lang_word": "тренировка на симуляторе",
                                "target_lang_sense_clarification": "профессиональный контекст"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2e618a8d-cc1c-3ddb-a7ef-d790e1740040",
                    "sense_definition": "To <w>simulate</w> something, especially in a computer environment or for testing purposes.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "simulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineers will <w>sim</w> the bridge's stress levels before starting construction.",
                            "target_lang_translations": {
                                "ru": "Инженеры <w>смоделируют</w> уровень нагрузки на мост перед началом строительства."
                            }
                        },
                        {
                            "text": "We need to <w>sim</w> the entire process to find any potential errors.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>симулировать</w> весь процесс, чтобы найти возможные ошибки."
                            }
                        }
                    ],
                    "synonyms": [
                        "simulate",
                        "model"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Моделировать или имитировать что-либо, особенно в компьютерной среде или для целей тестирования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "симулировать",
                                "target_lang_sense_clarification": "технический процесс"
                            },
                            {
                                "target_lang_word": "моделировать",
                                "target_lang_sense_clarification": "создавать модель"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e9134971-a889-307c-9d76-b21892334dc9",
                    "sense_definition": "A male given name, often used as a short form of <w>Simon</w> or <w>Simeon</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "His friends call him <w>Sim</w> instead of using his full name, Simon.",
                            "target_lang_translations": {
                                "ru": "Друзья зовут его <w>Сим</w> вместо полного имени Саймон."
                            }
                        },
                        {
                            "text": "The witness was a man named <w>Sim</w> Doolittle, a local fish hawker.",
                            "target_lang_translations": {
                                "ru": "Свидетелем был человек по имени <w>Сим</w> Дулиттл, местный торговец рыбой."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужское имя, часто используемое как краткая форма имен Саймон или Симеон."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Сим",
                                "target_lang_sense_clarification": "имя собственное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e541824-9b7a-3dea-86fa-ea5079bf610c",
                    "sense_definition": "A surname of Scottish, Korean, or Hokkien origin.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Professor <w>Sim</w> published a groundbreaking paper on East Asian history.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>Сим</w> опубликовал новаторскую работу по истории Восточной Азии."
                            }
                        },
                        {
                            "text": "The <w>Sim</w> family has lived in this part of Scotland for generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Сим</w> жила в этой части Шотландии на протяжении многих поколений."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия шотландского, корейского или хоккиенского происхождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Сим",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}