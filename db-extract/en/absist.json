                                    {
                                        "sense_id": "a11f6930-6347-38a1-b738-0a476f838daf",
                                        "entry_id": "ee95401a-598e-38fb-ab26-f5246ba2798a",
                                        "glosses": [
                                            "eine Sache nicht weiter verfolgen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6cc2924-21cf-49a4-bfd3-66da39a8e8a8",
                                                "sense_id": "a11f6930-6347-38a1-b738-0a476f838daf",
                                                "text": "Viele Studenten haben davon abgelassen, diese Mühe weiter auf sich zu nehmen."
                                            },
                                            {
                                                "example_id": "090cf3ea-091f-46e6-88c9-f2656d08771c",
                                                "sense_id": "a11f6930-6347-38a1-b738-0a476f838daf",
                                                "text": "Die Mutter ließ davon ab, auf ihre Tochter weiter einzureden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "af6ec729-737d-38e9-b51c-baf07d75466b",
                                        "entry_id": "ee95401a-598e-38fb-ab26-f5246ba2798a",
                                        "glosses": [
                                            "eine Person nicht weiter bedrängen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3587bc06-b1d2-4d67-8bf6-88818549c06e",
                                                "sense_id": "af6ec729-737d-38e9-b51c-baf07d75466b",
                                                "text": "Nach ihrer heftigen Gegenwehr ließ er von ihr ab."
                                            },
                                            {
                                                "example_id": "af57dc11-b87f-4c1e-8b55-aad6646f39bc",
                                                "sense_id": "af6ec729-737d-38e9-b51c-baf07d75466b",
                                                "text": "Lass von diesen Kerlen ab, die dich nur zum Alkohol verführen!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "003b4cf7-fb06-3d17-9e0d-2c79eae10003",
                                        "entry_id": "ee95401a-598e-38fb-ab26-f5246ba2798a",
                                        "glosses": [
                                            "etwas (wie zum Beispiel eine Menge) reduzieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd2bbd2d-92f6-49ae-9682-12b1b3885ffe",
                                                "sense_id": "003b4cf7-fb06-3d17-9e0d-2c79eae10003",
                                                "text": "Der Mechaniker ließ das Öl vom Auto in eine Wanne ab."
                                            },
                                            {
                                                "example_id": "22f4dc6b-0558-4571-b784-c3e72b0d339e",
                                                "sense_id": "003b4cf7-fb06-3d17-9e0d-2c79eae10003",
                                                "text": "Im öffentlichen Schwimmbad ist das Wasser leider abgelassen worden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "dbce97af-1ef6-3982-be41-6565f35fd0f5",
                                        "entry_id": "ee95401a-598e-38fb-ab26-f5246ba2798a",
                                        "glosses": [
                                            "den Emotionen freien Lauf lassen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90b47367-0e0f-4b66-9ca2-883f93efd3d6",
                                                "sense_id": "dbce97af-1ef6-3982-be41-6565f35fd0f5",
                                                "text": "Danach hat er ordentlich Dampf abgelassen."
                                            },
                                            {
                                                "example_id": "9e1a9a56-647c-4cea-a6cb-f859c10b5b5e",
                                                "sense_id": "dbce97af-1ef6-3982-be41-6565f35fd0f5",
                                                "text": "Lasse ein wenig Dampf ab, bevor du an deinem Ärger erstickst."
