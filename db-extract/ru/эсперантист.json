                        "form": "эсперанти́сте"
                    },
                    {
                        "form_id": "d849b4ff-3d79-46b9-a7fd-33ca8ee138fd",
                        "entry_id": "88d2c653-0a3a-383a-8409-cf3ab48cd358",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "эсперанти́стах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4bca620e-7349-3c6b-b4ab-8e1cd9a5f2f6",
                        "entry_id": "88d2c653-0a3a-383a-8409-cf3ab48cd358",
                        "glosses": [
                            "тот, кто говорит на эсперанто или иначе использует этот язык"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3b4192a-df05-4aa0-b5a6-4ede726cfc77",
                                "sense_id": "4bca620e-7349-3c6b-b4ab-8e1cd9a5f2f6",
                                "text": "Два лета подряд мы с ними дружили, а потом они перестали ездить в Глинково — был арестован их отец, энтузиаст-эсперантист. 〈…〉 Сперва в газетах писали, что в эпоху коммунизма будут разговаривать на столь удобном международном языке, а потом всех эсперантистов за переписку с заграницей пересажали и, обвинив в шпионаже, сослали в разные трущобы. Общество эсперантистов было закрыто."
                            }
                        ]
                    },
                    {
                        "sense_id": "40f74988-2217-3739-a123-71fe4b5020fa",
                        "entry_id": "88d2c653-0a3a-383a-8409-cf3ab48cd358",
                        "glosses": [
                            "специалист в области эсперанто"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb64b869-0f0a-4f3b-91b4-82983d28b872",
                                "sense_id": "40f74988-2217-3739-a123-71fe4b5020fa",
                                "text": "Лекция эсперантиста из Калифорнии[.] «Лекция о Калифорнии» Д. Э. Парриша привлекла вчера в Политехнический музей довольно много публики."
                            },
                            {
                                "example_id": "6cc9d127-260b-4e4a-b534-3307969708cd",
                                "sense_id": "40f74988-2217-3739-a123-71fe4b5020fa",
                                "text": "Эсперантист г. Парриш, представитель Калифорнии, выехал вчера из Одессы на Балканский полуостров."
                            },
                            {
                                "example_id": "f909bcd8-257a-498e-b792-0b77794cab53",
                                "sense_id": "40f74988-2217-3739-a123-71fe4b5020fa",
                                "text": "Занятиями руководит специально приглашённый из Богемии эсперантист д-р Юкль."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e431ea10-a9a7-406d-b17f-9df80949042d",
                        "source_entry_id": "88d2c653-0a3a-383a-8409-cf3ab48cd358",
                        "source_sense_description": "тот, кто говорит на эсперанто или иначе использует этот язык",
                        "target_lang_word": "Esperantist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Esperantist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c4c5bda-23f6-3213-943a-fcfac7a14ea1",
                                        "entry_id": "5432b410-b90e-3655-a2db-fad01aedfef2",
                                        "glosses": [
                                            "Of, relating to, or characteristic of Esperanto."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6cc0619-d264-4d43-9c51-092b6aceb008",
                                                "sense_id": "4c4c5bda-23f6-3213-943a-fcfac7a14ea1",
                                                "text": "Underlying every Esperanto enthusiast is the Esperantist ideal that the world would be a better place if everyone could understand each other better."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Esperantist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20533da8-da65-356b-b9c2-6e159ec4a4c4",
                                        "entry_id": "3b794dd5-ec51-316d-9a43-97748f59ed9c",
                                        "glosses": [
                                            "A specialist or speaker of Esperanto, the international auxiliary language designed by L. L. Zamenhof."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01cd761f-afb9-4041-92d4-ecec6376889f",
                                                "sense_id": "20533da8-da65-356b-b9c2-6e159ec4a4c4",
                                                "text": "A growing number of Esperantists all over the world are using the services of the U. E. A."
                                            },
                                            {
                                                "example_id": "b768bb4e-0c22-47b3-af14-fc6b8b172de4",
                                                "sense_id": "20533da8-da65-356b-b9c2-6e159ec4a4c4",
                                                "text": "It is said that many of the early Catholic Esperantists, in particular, were frightened by this prospect—and it is, indeed, true that the Catholic element in early Idism is striking."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b0e8843-ccc0-4b10-9f7f-3cd9d213c52b",
                        "source_entry_id": "88d2c653-0a3a-383a-8409-cf3ab48cd358",
                        "source_sense_description": "тот, кто говорит на эсперанто или иначе использует этот язык",
                        "target_lang_word": "esperantista",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "esperantista",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "c05f3267-1ca4-3cf0-b008-477dc1da3fad",
                                        "entry_id": "b37cf89d-f55d-3541-9132-e256ed5b54c1",
                                        "glosses": [
                                            "relativo all'esperanto"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93d8e5b1-d8ba-45e7-b070-cd8bfc430d76",
                                                "sense_id": "c05f3267-1ca4-3cf0-b008-477dc1da3fad",
                                                "text": "la grammatica esperantista è volutamente molto semplificata e regolare"
                                            }
                                        ]
