                "senses": [
                    {
                        "sense_id": "f0cde4c8-3bab-303c-9ce6-d6e8b1bf9465",
                        "entry_id": "94f7f629-8253-380f-b598-94b20fabbf3d",
                        "glosses": [
                            "Stuhl, der im Freien/im Garten benutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43f8f2ec-708d-41ba-85f4-071741d1bfa5",
                                "sense_id": "f0cde4c8-3bab-303c-9ce6-d6e8b1bf9465",
                                "text": "„Auch gab es ein kleines Café im Freien, und vor dem Café waren ein paar Gartentische mit richtigen Gartenstühlen aufgestellt, wo wir etwas zu trinken bekommen konnten.“"
                            },
                            {
                                "example_id": "1813a0d8-9050-4869-85ce-cfd5245b77be",
                                "sense_id": "f0cde4c8-3bab-303c-9ce6-d6e8b1bf9465",
                                "text": "„Noch immer barfuß, beugte er sich weit aus dem Schlafzimmerfenster und sah Fabrizzio auf einem der Gartenstühle sitzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
