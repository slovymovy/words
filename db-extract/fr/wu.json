                                    {
                                        "sense_id": "d070fb29-f15e-3b7e-b2b6-0bd24a430dae",
                                        "entry_id": "f15d5117-5f81-34c7-9066-1ab73a1fd4e4",
                                        "glosses": [
                                            "A historic and cultural region of China around the mouth of the Yangtze River, whence:",
                                            "The family of Chinese languages spoken in that region, including Shanghainese and Suzhounese, the second-most spoken family after Mandarin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a81e5823-23a0-497f-83d6-e60f2f2c6bfb",
                                                "sense_id": "d070fb29-f15e-3b7e-b2b6-0bd24a430dae",
                                                "text": "Linguists say the Wu dialect widely spoken in Shanghai, to take one prominent example, shares only about 31 percent lexical similarity with Mandarin, or roughly the same as English and French.\nThe encounter at the Datian market began when the dumpling seller approached the foreigner with a phrase that sounded like \"goodbye\" in the Wu dialect. Knowing it must mean something else, the foreigner guessed she was asking his name, and provided it, producing a laugh from the woman who explained, switching to Mandarin, that she had asked if he had eaten lately."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d43e18e1-c071-38ea-a0b7-cdcada174885",
                                        "entry_id": "f15d5117-5f81-34c7-9066-1ab73a1fd4e4",
                                        "glosses": [
                                            "A historic and cultural region of China around the mouth of the Yangtze River, whence:",
                                            "The kingdom ruled by the Ji family from Wuxi and then Suzhou during the Spring and Autumn period of China's Zhou dynasty."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ece7479-9e2f-4711-8c93-14653b625cb6",
                                                "sense_id": "d43e18e1-c071-38ea-a0b7-cdcada174885",
                                                "text": "The finest private gardens were built in Suzhou, a graceful old city with a network of canals and a cultured ambiance. It was founded in the sixth century B.C. as the capital of the kingdom of Wu and flourished as a center of trade and scholarship under successive dynasties."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e714ad52-393d-38f0-b660-3d2fed755e6f",
                                        "entry_id": "f15d5117-5f81-34c7-9066-1ab73a1fd4e4",
                                        "glosses": [
                                            "A historic and cultural region of China around the mouth of the Yangtze River, whence:",
                                            "A common surname from Chinese"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b95c842e-ca23-35a8-8853-a1b6ce5eddbc",
                                        "entry_id": "f15d5117-5f81-34c7-9066-1ab73a1fd4e4",
                                        "glosses": [
                                            "A historic and cultural region of China around the mouth of the Yangtze River, whence:",
                                            "The kingdom ruled by the Sun family from Ezhou and Nanjing during the Three Kingdoms interregnum following China's Han dynasty."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a34105f-ae44-42f8-aa6e-bd1b264dff67",
                                                "sense_id": "b95c842e-ca23-35a8-8853-a1b6ce5eddbc",
                                                "text": "I deeply regretted having to miss seeing Hsing-ping, a very old town built by the ruler of the Wu Kingdom in the Three Kingdoms period of the third century."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f89649aa-0b1e-3947-b3ba-27d5f27d6fd2",
