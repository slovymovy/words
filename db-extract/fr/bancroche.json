                    {
                        "sense_id": "fd089d89-f696-3dd5-8702-f795d59d76c4",
                        "entry_id": "e85b1476-20b2-3493-a548-3d6334c86e43",
                        "glosses": [
                            "Personne difforme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83e57f16-58e9-4ab5-865c-c9c7d1c9a253",
                                "sense_id": "fd089d89-f696-3dd5-8702-f795d59d76c4",
                                "text": "En guise d'oraison funèbre, la critique ne sera pas tendre pour Lautrec : elle le traitera de gnome monstrueux, de rejeton informe, de bancroche contrefait."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a2c8ba3-34fd-3967-90e1-fcd56ef57043",
                        "entry_id": "e85b1476-20b2-3493-a548-3d6334c86e43",
                        "glosses": [
                            "Personne mal vue ou malmenée par la vie."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "e3ba5848-51b8-4eba-8429-d543fcf9b117",
                                "sense_id": "7a2c8ba3-34fd-3967-90e1-fcd56ef57043",
                                "text": "Il y a du drôle de monde autour de lui : des percepteurs, des prostituées, beaucoup de bancroches."
                            }
                        ]
                    }
