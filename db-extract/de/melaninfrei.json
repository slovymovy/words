                    },
                    {
                        "form_id": "88e9a4d8-b313-4158-83ce-500e8af83657",
                        "entry_id": "a06faaf2-88c5-3fff-a900-0c115faa88d2",
                        "tags": [
                            "positive",
                            "predicative",
                            "singular",
                            "neuter"
                        ],
                        "form": "es ist melaninfrei"
                    },
                    {
                        "form_id": "bff89cec-895c-480e-a15a-3f166343062b",
                        "entry_id": "a06faaf2-88c5-3fff-a900-0c115faa88d2",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind melaninfrei"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "004afb45-69cd-3a40-8d82-f66d75525d93",
                        "entry_id": "a06faaf2-88c5-3fff-a900-0c115faa88d2",
                        "glosses": [
                            "kein Melanin enthaltend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1743d1c2-5811-4bfd-bce8-6ab9cbabad43",
                                "sense_id": "004afb45-69cd-3a40-8d82-f66d75525d93",
                                "text": "„Mit Hilfe der Massonschen Färbung läßt sich nachweisen, daß der gesamte epitheliale Bereich des Klarzellakanthoms melaninfrei ist, während hingegen im Corium Pigment aufscheint (Cramer).“"
                            },
                            {
                                "example_id": "ace12932-7283-48c1-9c49-8e92dcee8516",
                                "sense_id": "004afb45-69cd-3a40-8d82-f66d75525d93",
                                "text": "„Die Federkiele des Großgefieders innerhalb der Aufhellungszone sind melaninfrei.“"
                            },
                            {
                                "example_id": "4c316d9f-ed47-4a01-a490-209086989a93",
                                "sense_id": "004afb45-69cd-3a40-8d82-f66d75525d93",
                                "text": "„Bei albinotischen Individuen, bei welchen auch diese Retinaschicht melaninfrei ist, erscheint die Iris infolge einer Reflexion der vielen Chorioideablutgefäße des Augenhintergrundes trübrot.“"
                            },
                            {
                                "example_id": "5795bcec-a852-42f0-8ffd-36b825cde680",
                                "sense_id": "004afb45-69cd-3a40-8d82-f66d75525d93",
                                "text": "„Teile der Tumoren können pigmentfrei sein, selten ist der Primärtumor völlig melaninfrei (amelanotisches Melanom).“"
                            },
                            {
                                "example_id": "55a8a93c-1a86-4315-ab95-d0ff3087e811",
                                "sense_id": "004afb45-69cd-3a40-8d82-f66d75525d93",
                                "text": "„Ihre Haut war melaninfrei, alabasterglatt und so weiß wie jedes Klischee, das einem dazu einfallen mag.“"
                            },
                            {
                                "example_id": "1f72d887-cba2-44e7-8a43-bd930338d7fa",
                                "sense_id": "004afb45-69cd-3a40-8d82-f66d75525d93",
                                "text": "„Hellblonde und weiße Haare sind nahezu melaninfrei und somit gegen den Laserbeschuss resistent.““"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
