                "senses": [
                    {
                        "sense_id": "3a98d99b-e6c4-3bd2-a3ee-e366de28d46e",
                        "entry_id": "2cc89e14-1677-3a92-b600-e7f9b3fd7af3",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83f50564-143f-4763-bd5f-f7dc11e27e45",
                                "sense_id": "3a98d99b-e6c4-3bd2-a3ee-e366de28d46e",
                                "text": "Frau Leipoldt ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c458d9e7-618c-4a9f-806f-025d265951f0",
                                "sense_id": "3a98d99b-e6c4-3bd2-a3ee-e366de28d46e",
                                "text": "Herr Leipoldt wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d71000ad-325c-45c2-aa67-ffd17bfe4fa2",
                                "sense_id": "3a98d99b-e6c4-3bd2-a3ee-e366de28d46e",
                                "text": "Die Leipoldts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "b89818eb-fe17-4adc-bdf0-368bd90cddae",
                                "sense_id": "3a98d99b-e6c4-3bd2-a3ee-e366de28d46e",
                                "text": "Der Leipoldt trägt nie die Schals, die die Leipoldt ihm strickt."
                            },
                            {
                                "example_id": "0f08054c-d906-47e0-83a5-fe603b0e661d",
                                "sense_id": "3a98d99b-e6c4-3bd2-a3ee-e366de28d46e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Leipoldt kommt, geht der Herr Leipoldt.“"
                            },
                            {
                                "example_id": "ef76b636-8f9a-42e3-8b66-c2b52f6212ba",
                                "sense_id": "3a98d99b-e6c4-3bd2-a3ee-e366de28d46e",
                                "text": "Leipoldt kommt und geht."
                            },
                            {
                                "example_id": "ca227c1d-df98-428a-8c7e-9f0a19ce9038",
                                "sense_id": "3a98d99b-e6c4-3bd2-a3ee-e366de28d46e",
                                "text": "Leipoldts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
