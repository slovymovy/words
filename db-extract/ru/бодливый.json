                                        "examples": [
                                            {
                                                "example_id": "bc413623-4eec-4ca6-909b-d39ac17362a2",
                                                "sense_id": "a5d4309c-8dc4-38af-8370-e67a49eab3fc",
                                                "text": "Given the current situation, I don't think that's possible."
                                            }
                                        ]
