                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66b6d9a9-762e-44aa-bf74-c960b0f71196",
                                "sense_id": "9d74a353-ac51-3ea3-83e8-dc0630e97b2a",
                                "text": "L’intégration neuronale est une caractéristique portée par le cône axonique du neurone, localisé à la naissance de l’axone."
                            },
                            {
                                "example_id": "013d8d9f-1516-498f-a391-12be4351ad98",
                                "sense_id": "9d74a353-ac51-3ea3-83e8-dc0630e97b2a",
                                "text": "Les terminaisons axoniques synaptiques constituent un bouton présynaptique, au contact d’une autre cellule (neurone ou fibre musculaire), dont elle peuvent influencer l’activité."
                            }
                        ]
                    }
