                ],
                "senses": [
                    {
                        "sense_id": "0119cd1c-192d-3a03-bc1f-6f72e22df850",
                        "entry_id": "580528e4-28f2-31d8-b9cb-84170fffec4e",
                        "glosses": [
                            "Raumteil eines Kühlschrankes in der Tür"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dddff2bd-ede9-40d6-a8a0-16457dfb9331",
                                "sense_id": "0119cd1c-192d-3a03-bc1f-6f72e22df850",
                                "text": "Im Türfach stehen zwei Flaschen Wein."
                            },
                            {
                                "example_id": "ecf08bff-045a-4d0d-a663-e2a3c5575a99",
                                "sense_id": "0119cd1c-192d-3a03-bc1f-6f72e22df850",
                                "text": "In den Türfächern ist es relativ warm, aber kühl genug für Butter oder Eier."
                            },
                            {
                                "example_id": "eb59c09d-4be2-40a4-ba76-c2883e45ac8b",
                                "sense_id": "0119cd1c-192d-3a03-bc1f-6f72e22df850",
                                "text": "Nur leicht zu kühlende Produkte wie Butter und Getränke sollten in den Türfächern aufbewahrt werden."
                            },
                            {
                                "example_id": "a834119b-9f28-46a0-b26e-dce87853ab60",
                                "sense_id": "0119cd1c-192d-3a03-bc1f-6f72e22df850",
                                "text": "Dort und auf der Glasplatte, die das Obst- und Gemüsefach vom Rest des Innenraums abteilt, ist es deutlich kühler als beispielsweise in den Türfächern."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
