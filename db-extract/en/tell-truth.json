                        "entry_id": "34c14ecc-7373-3f2f-9460-18f5c98703e7",
                        "glosses": [
                            "Exposing the truth; revealing; illuminating."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "b7532bc4-c1a8-48ba-bf0f-633665603649",
                                "sense_id": "ff7ad3f2-1bd9-316c-9fba-096baabfde20",
                                "text": "In short, Ovid's Imagination in his Metamorphoſes never made more unaccountable Changes, than would appear thro' ſuch a Tell-truth Mirrour […]"
                            },
                            {
                                "example_id": "efe7154c-7468-4732-8375-42a9b334cf3f",
                                "sense_id": "ff7ad3f2-1bd9-316c-9fba-096baabfde20",
                                "text": "Because the sun has a tell-truth ray, / He's shut from the magic wonders"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
