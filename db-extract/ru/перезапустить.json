                "senses": [
                    {
                        "sense_id": "538a0a18-b0d5-33ec-808c-ebd25dc18cf8",
                        "entry_id": "3d8932e5-f8e2-328f-80ca-ce26c95a8541",
                        "glosses": [
                            "запустить заново, иначе"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34cd3e0e-7e9e-435f-9d9f-46cbcca6c52b",
                                "sense_id": "538a0a18-b0d5-33ec-808c-ebd25dc18cf8",
                                "text": "Я склонен думать, что и 13-го, и 15-го января причина остановки была одна и та же: образование льда в компрессоре. Просто 13-го слой его был тоньше или он быстро растаял, и мотор удалось перезапустить."
                            },
                            {
                                "example_id": "d47259fb-cce8-49bf-9f76-1c342255a37d",
                                "sense_id": "538a0a18-b0d5-33ec-808c-ebd25dc18cf8",
                                "text": "После окончания проверки и дефрагментации файлов компьютер можно перезапустить в стандартном режиме."
                            }
                        ]
                    }
