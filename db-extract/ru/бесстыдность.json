                "translations": [
                    {
                        "translation_id": "479be244-dc21-46e1-a898-6ad8d4633fab",
                        "source_entry_id": "50d589ef-d5a9-39c8-9117-bc6b3735bdff",
                        "source_sense_id": "93a3d8d3-7b73-3192-ac12-d6b9a4296019",
                        "target_lang_word": "effronterie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "effronterie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "746bda6a-f9bf-3195-83f1-5ec246315e13",
                                        "entry_id": "036e5316-5ffa-3492-b59f-4b101174ecfc",
                                        "glosses": [
                                            "Caractère, attitude de celui qui est effronté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e68b0ec-4f9d-4e50-8cfe-a8617cc77068",
                                                "sense_id": "746bda6a-f9bf-3195-83f1-5ec246315e13",
                                                "text": "… nous entendions la respiration des chèvres. Il y en eut même quelques-unes qui pénétrèrent dans notre logis et qui s’y installèrent malgré nous, avec l’effronterie drôle propre à leur espèce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fd2083e-eb7c-3445-8172-c3ded3dc526e",
                                        "entry_id": "036e5316-5ffa-3492-b59f-4b101174ecfc",
                                        "glosses": [
                                            "Manière d’agir, de parler de celui qui est effronté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d937d83-3eef-4a81-bdbe-411f80e49838",
                                                "sense_id": "1fd2083e-eb7c-3445-8172-c3ded3dc526e",
                                                "text": "M. Clausel prit la parole, et il eut l’effronterie de déclarer qu’aussitôt que la Chambre serait prorogée, il imprimerait un Mémoire à ce sujet."
                                            },
                                            {
                                                "example_id": "fe79b30b-cdfb-4867-8a8f-a810a730e67f",
                                                "sense_id": "1fd2083e-eb7c-3445-8172-c3ded3dc526e",
                                                "text": "(…) une vieille dame en chapeau jaune, à mine basse de pourvoyeuse, et deux mineures, deux fillettes de treize ou quatorze ans, déhanchées, d’une effronterie gênante."
                                            },
                                            {
                                                "example_id": "6ef282ee-21f9-4b8a-911a-6aac34ed815d",
                                                "sense_id": "1fd2083e-eb7c-3445-8172-c3ded3dc526e",
                                                "text": "Culotté le corvidé ! qui n'hésitait pas à tirer les plumes de la queue du convive pour le forcer à s'éloigner. Vite lassé par tant d’effronterie, l'aigle noir s'est brutalement retourné, bec grand ouvert, ailes déployées, au comble de l'irritation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "455ca92e-1cc2-4fd4-a574-cd0d36158de9",
                        "source_entry_id": "50d589ef-d5a9-39c8-9117-bc6b3735bdff",
                        "source_sense_id": "93a3d8d3-7b73-3192-ac12-d6b9a4296019",
                        "target_lang_word": "impudence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impudence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4aab296d-9c52-3a08-8cee-a98da240cf0d",
                                        "entry_id": "c91be646-1c05-3d71-bd2c-8e63b6a63f6f",
                                        "glosses": [
                                            "Manque de pudeur, effronterie extrême."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c527bcec-da9f-4ed1-8bac-cdd4b0869d3f",
                                                "sense_id": "4aab296d-9c52-3a08-8cee-a98da240cf0d",
                                                "text": "Ces rustres n’eussent pas osé agir avec une impudence aussi inconcevable s’ils ne se sentaient appuyés par quelque forte bande."
                                            },
                                            {
                                                "example_id": "61c4aaf9-3b13-4125-b583-37caba2a21ac",
                                                "sense_id": "4aab296d-9c52-3a08-8cee-a98da240cf0d",
                                                "text": "Le Truculentus représente la vie et les gestes d'une gueuse, qui, par sa rapacité, ses éhontements et l’impudence de sa mauvaise foi, révolterait même les blasés de nos petits théâtres."
                                            },
                                            {
                                                "example_id": "5829aa3a-ba5f-4d33-b6ff-95630ea2eccd",
                                                "sense_id": "4aab296d-9c52-3a08-8cee-a98da240cf0d",
                                                "text": "Ce mouvement était inimitable; il avait la canaillerie, l’impudence, la persuasion d’un dresseur, d’un tombeur de femmes."
                                            },
                                            {
                                                "example_id": "08df7dfe-809a-4acf-8017-cde05dc42b4a",
                                                "sense_id": "4aab296d-9c52-3a08-8cee-a98da240cf0d",
                                                "text": "En effet, je n'en ai pas, et cela m'est égal, mais je ne désire pas supporter une nouvelle impudence de votre part !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b759090-72b8-3865-a62f-fb3bee915733",
                                        "entry_id": "c91be646-1c05-3d71-bd2c-8e63b6a63f6f",
                                        "glosses": [
                                            "Action et parole impudentes."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c1842c6-5508-4fe4-bf06-2fdc85f1db2c",
                                                "sense_id": "9b759090-72b8-3865-a62f-fb3bee915733",
                                                "text": "Il mérite d’être châtié pour ses impudences."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82f4b0d6-5d49-4457-a618-59588b1b1b28",
                        "source_entry_id": "50d589ef-d5a9-39c8-9117-bc6b3735bdff",
                        "source_sense_id": "93a3d8d3-7b73-3192-ac12-d6b9a4296019",
                        "target_lang_word": "impudeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impudeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1522a179-c92e-3c98-ab7d-f6b646a0dab1",
                                        "entry_id": "306729dc-e9f0-3feb-9200-280cf77a4af9",
                                        "glosses": [
                                            "Défaut de pudeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb9fcaf2-342e-475c-8356-a68a6bc6c316",
                                                "sense_id": "1522a179-c92e-3c98-ab7d-f6b646a0dab1",
                                                "text": "Leurs chansons et les gestes de leur danse étaient d’une impudeur ardente qui enflammait peu à peu les spectateurs très nombreux ce soir-là."
                                            },
                                            {
                                                "example_id": "df21ecd0-95e4-49e1-ae28-a00740e61a48",
                                                "sense_id": "1522a179-c92e-3c98-ab7d-f6b646a0dab1",
                                                "text": "[…] la chaste fille fit tomber ses vêtements avec une impudeur sublime, et, relevant ses cheveux comme Aphrodite sortant de la mer, elle se tint debout sous le rayon lumineux."
                                            },
                                            {
                                                "example_id": "73d6948d-74ab-4fb3-b15e-d42f347db2eb",
                                                "sense_id": "1522a179-c92e-3c98-ab7d-f6b646a0dab1",
                                                "text": "Une blouse de soie blanche ouvrait les bras avec une sorte d’impudeur sur le fauteuil à bascule."
                                            },
                                            {
                                                "example_id": "1343a1ad-bc2d-4645-9558-a3cd5f899391",
                                                "sense_id": "1522a179-c92e-3c98-ab7d-f6b646a0dab1",
                                                "text": "Il se rappela qu’elle portait une robe si étroitement ajustée que certaines parties de son corps se laissaient voir avec précision, et que la robe fût rouge aggravait cette impudeur."
                                            },
                                            {
                                                "example_id": "debb03cc-2a1f-4a4e-8536-da333641184d",
                                                "sense_id": "1522a179-c92e-3c98-ab7d-f6b646a0dab1",
                                                "text": "On dit que ces professionnelles ont des charmes secrets, […] ; qu’un homme vicieux trouve en elles des partenaires expertes, aux impudeurs extraordinaires, aux habiles jeux de la débauche et de la lubricité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abe64b31-0346-323b-b457-b458ef3e795e",
                                        "entry_id": "306729dc-e9f0-3feb-9200-280cf77a4af9",
                                        "glosses": [
                                            "Défaut de la retenue qu’exige le sentiment de la dignité personnelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecf23601-b6ec-4bbd-82b7-03ff4d53b5a0",
                                                "sense_id": "abe64b31-0346-323b-b457-b458ef3e795e",
                                                "text": "Gorgés de biens, ils ont l’impudeur de demander encore."
                                            },
                                            {
                                                "example_id": "aa00a248-9bf6-4d6c-b399-b11ef60f482c",
                                                "sense_id": "abe64b31-0346-323b-b457-b458ef3e795e",
                                                "text": "Moi, les politiciens me choquent, par l’impudeur avec laquelle ils mentent"
                                            },
                                            {
                                                "example_id": "64e396f7-1879-4265-a0ce-40687ef10ffe",
                                                "sense_id": "abe64b31-0346-323b-b457-b458ef3e795e",
                                                "text": "L’impudeur de certains jeunes professeurs ne connaîtra donc plus de bornes ? Sous l’influence des romans libertins et du cinéma immoral, l’Université elle-même se croit tout permis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
