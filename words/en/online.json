                },
                {
                    "sense_id": "722c3bc2-e49f-30fb-9c38-3473afb2db18",
                    "sense_definition": "Available on, done by, or obtained through the Internet.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "internet_service",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I prefer to read <w>online</w> newspapers rather than buying physical copies.",
                            "target_lang_translations": {
                                "ru": "Я предпочитаю читать <w>онлайн</w>-газеты, а не покупать бумажные экземпляры.",
                                "pl": "Wolę czytać gazety <w>internetowe</w> niż kupować wydania papierowe."
                            }
                        },
                        {
                            "text": "We bought the concert tickets through an <w>online</w> booking system.",
                            "target_lang_translations": {
                                "ru": "Мы купили билеты на концерт через <w>онлайн</w>-систему бронирования.",
                                "pl": "Kupiliśmy bilety na koncert przez <w>internetowy</w> system rezerwacji."
                            }
