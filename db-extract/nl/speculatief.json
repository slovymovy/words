                "translations": [
                    {
                        "translation_id": "0eb661b8-9a30-4df5-a370-a06121a140b2",
                        "source_entry_id": "1a4fb487-43da-33c5-9b9d-8d58b17920a1",
                        "target_lang_word": "speculative",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "speculative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc0e891f-4dfb-346c-b3c7-eafbdc8a91f3",
                                        "entry_id": "6f2ee8af-7ac2-39a7-977a-0c2a730ba1e7",
                                        "glosses": [
                                            "Characterized by speculation; based on guessing, unfounded opinions, or extrapolation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8860b5b5-a930-4171-9404-7447ddc7b4a6",
                                                "sense_id": "bc0e891f-4dfb-346c-b3c7-eafbdc8a91f3",
                                                "text": "Like The Handmaid's Tale, Oryx and Crake is a speculative fiction, not a science fiction proper."
                                            },
                                            {
                                                "example_id": "59990fad-1d38-44fe-8b82-0c41687a49de",
                                                "sense_id": "bc0e891f-4dfb-346c-b3c7-eafbdc8a91f3",
                                                "text": "When not inaccurate, much commentary on the contents of Hobson-Jobson is couched in hedges or relies on speculative estimates in the absence of exact information."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccba3dbb-d54e-3b4d-ade4-f935b915b8f3",
                                        "entry_id": "6f2ee8af-7ac2-39a7-977a-0c2a730ba1e7",
                                        "glosses": [
                                            "Pursued as a gamble, with possible large profits or losses; risky."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3831429b-23ff-4f64-931c-c725f747f345",
                                                "sense_id": "ccba3dbb-d54e-3b4d-ade4-f935b915b8f3",
                                                "text": "Tranquillo Barnetta was the grateful beneficiary of uncertain England defending and poor goalkeeping from Joe Hart as he twice saw speculative free-kicks end in the back of the net in the first half."
                                            },
                                            {
                                                "example_id": "d572e1aa-7f40-40d7-bbc7-6dc4ce7b76f2",
                                                "sense_id": "ccba3dbb-d54e-3b4d-ade4-f935b915b8f3",
                                                "text": "Little seemed on when Sánchez cut in from the left and sent a speculative low shot through a crowd of players, but though Federici had it covered he could not hold on to the ball and it squirmed over the line through his legs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecd460a5-ae39-354f-9bb6-d70e97d89664",
                                        "entry_id": "6f2ee8af-7ac2-39a7-977a-0c2a730ba1e7",
                                        "glosses": [
                                            "Pertaining to financial speculation; Involving or resulting from high-risk investments or trade."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc276337-b14a-4dc4-ae0f-52ec1a63dd4d",
                                                "sense_id": "ecd460a5-ae39-354f-9bb6-d70e97d89664",
                                                "text": "\"Don't dare laugh at us!\" smiled his sister. \"I wish we were back in Tenth Street. But so many children came[…]and the Tenth Street house wasn't half big enough; and a dreadful speculative builder built this house and persuaded Austin to buy it. Oh, dear, and here we are among the rich and great; and the steel kings and copper kings and oil kings and their heirs and dauphins. Do you like the house?\""
                                            },
                                            {
                                                "example_id": "7c6f1b36-b601-442c-a24f-731138cce6c0",
                                                "sense_id": "ecd460a5-ae39-354f-9bb6-d70e97d89664",
                                                "text": "In other words, it is critical to know whether a currency is under high speculative pressure for every month in the sample."
                                            },
                                            {
                                                "example_id": "3fde59a9-2c19-4f5e-82d5-f09268fabbb4",
                                                "sense_id": "ecd460a5-ae39-354f-9bb6-d70e97d89664",
                                                "text": "It was written between 1929 and 1930 and deals with a famine caused by speculative investments of the Meat King of Chicago, Pierpont Mauler."
                                            },
                                            {
                                                "example_id": "bb2820dd-1c61-44e1-a617-87e5767774d9",
                                                "sense_id": "ecd460a5-ae39-354f-9bb6-d70e97d89664",
                                                "text": "Empirical tests of speculative bubbles, including those assessing early warning indicators in the context of financial crises, are forced to contend with other difficult measurement and inference issues."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
