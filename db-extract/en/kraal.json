{
    "word": "kraal",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "bb815237-9e9b-3d2d-b4cd-aad007c64830",
                "word": "kraal",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "62756c2d-90ac-41cc-9775-6b7ed31c3956",
                        "entry_id": "bb815237-9e9b-3d2d-b4cd-aad007c64830",
                        "tags": [
                            "plural"
                        ],
                        "form": "kraals"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fa564101-167c-3b3a-965d-6f6416f0ad54",
                        "entry_id": "bb815237-9e9b-3d2d-b4cd-aad007c64830",
                        "glosses": [
                            "In Central and Southern Africa, a small rural community."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41ea13b0-9840-4621-b303-d99dd2c921a9",
                                "sense_id": "fa564101-167c-3b3a-965d-6f6416f0ad54",
                                "text": "Onanis is the permanent residence of a kraal of very poor Hill-Damaras, who subsist chiefly upon the few wild roots which their sterile neighborhood produces."
                            },
                            {
                                "example_id": "7333fdeb-c8d1-461c-ba65-0bdb01d29a00",
                                "sense_id": "fa564101-167c-3b3a-965d-6f6416f0ad54",
                                "text": "‘The paraffin box covered with newsprint, and the primus, and the bucket standing on the floor, and a photo of our kraal’s chief on the wall.’"
                            }
                        ]
                    },
                    {
                        "sense_id": "638ef762-53c6-3519-9c85-c3bb3b8cba46",
                        "entry_id": "bb815237-9e9b-3d2d-b4cd-aad007c64830",
                        "glosses": [
                            "In Central and Southern Africa, a rural village of huts surrounded by a stockade."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a216433e-f403-4771-86ec-b70b0d9d9b85",
                                "sense_id": "638ef762-53c6-3519-9c85-c3bb3b8cba46",
                                "text": "A kraal was a homestead and usually included a simple fenced-in enclosure for animals, fields for growing crops, and one or more thatched huts."
                            }
                        ]
                    },
                    {
                        "sense_id": "5bf05793-ea97-3b29-b63d-56e18b95b632",
                        "entry_id": "bb815237-9e9b-3d2d-b4cd-aad007c64830",
                        "glosses": [
                            "An enclosure for livestock."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "536bdd67-4cee-4dcb-86ed-9292a2c99fb7",
                                "sense_id": "5bf05793-ea97-3b29-b63d-56e18b95b632",
                                "text": "The animal, which is now six years old, was born naturally from the mating of a female goat with a male sheep sharing the same kraal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed6e2136-fdbd-4480-ac52-27fcd1a13cd8",
                        "source_entry_id": "bb815237-9e9b-3d2d-b4cd-aad007c64830",
                        "source_sense_description": "rural African community",
                        "target_lang_word": "kraal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kraal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "70105ea1-2989-36df-85cc-dc18c655b1d2",
                                        "entry_id": "b887b3b0-354a-393c-9c0c-708297d1e4ba",
                                        "glosses": [
                                            "Village indigène en Afrique du Sud."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fe0076d-c009-4e35-a86a-e63044cceb50",
                                                "sense_id": "70105ea1-2989-36df-85cc-dc18c655b1d2",
                                                "text": "Je ne crois pas que dans les kraals des Hottentots et dans les campements des Kalmouks on puisse rencontrer rien de plus sauvage, de plus barbare et de plus primitif."
                                            },
                                            {
                                                "example_id": "42f6e596-318e-4922-807a-4c945ca4dc90",
                                                "sense_id": "70105ea1-2989-36df-85cc-dc18c655b1d2",
                                                "text": "Il y a Nada aussi, Nada the Lily, avec ses grands yeux et ses cheveux bouclés, sa peau couleur de cuivre, descendante d’une princesse noire et d’un Blanc, seule survivante du kraal assassiné par Chaka."
                                            },
                                            {
                                                "example_id": "fe1213b8-c3f9-4824-b50c-bc50eec54582",
                                                "sense_id": "70105ea1-2989-36df-85cc-dc18c655b1d2",
                                                "text": "Et parfois, j’ai envie qu’un léopard ou un lion saute dans le kraal pour me tuer et m’emmener pour de bon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fe67934-162e-340d-a710-679ffa3527f4",
                                        "entry_id": "b887b3b0-354a-393c-9c0c-708297d1e4ba",
                                        "glosses": [
                                            "Ensemble de bâtisses."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "072be6f7-189c-4ca5-b860-d90bfdaa02a9",
                                                "sense_id": "2fe67934-162e-340d-a710-679ffa3527f4",
                                                "text": "Nous logions dans un kraal de baraques en tôle ondulée, au milieu d’un paysage de prairies retournées à l’état sauvage, dans le vert desquelles luisaient d’innombrables fleurs jaunes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4fecfe1-0816-3ef4-844d-7b16234916c5",
                                        "entry_id": "b887b3b0-354a-393c-9c0c-708297d1e4ba",
                                        "glosses": [
                                            "Enclos à bétail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0e64690-a46b-4428-9225-d7e13e3077e1",
                                                "sense_id": "c4fecfe1-0816-3ef4-844d-7b16234916c5",
                                                "text": "J’apercevais de chaque côté des hameaux indolents – des grappes de huttes et des kraals en branches épineuses – goûtant le soleil matinal après la pluie."
                                            },
                                            {
                                                "example_id": "d8642a89-4801-473e-9742-69543d586f87",
                                                "sense_id": "c4fecfe1-0816-3ef4-844d-7b16234916c5",
                                                "text": "Il y avait probablement plus d’un millier de huttes dans cet endroit, toutes disséminées autour d’un kraal central où l’on parquait le bétail pour la nuit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "577a36bb-b37a-46e1-9842-ed7750f9896d",
