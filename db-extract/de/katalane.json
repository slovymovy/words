                ],
                "translations": [
                    {
                        "translation_id": "5d58c7f6-86c8-4e48-a388-8f0dd2aa07d1",
                        "source_entry_id": "9628d85a-4d20-3326-8efd-c27c91a51f16",
                        "source_sense_id": "134b7da9-48ef-3e00-8155-02e367f5ada6",
