                    }
                ],
                "senses": [
                    {
                        "sense_id": "6d0d8a60-fac5-3cb0-9267-b38c52a0ebe0",
                        "entry_id": "40127bd4-6ed2-3dfb-89c0-c027087f94ce",
                        "glosses": [
                            "heilwens die direct na het uitspreken wordt bekrachtigd door het samen nuttigen van een slok – meestal alcoholische – drank"
                        ],
                        "tags": [
                            "cultuur"
                        ],
                        "examples": [
                            {
                                "example_id": "5e207a06-c9d7-4221-8055-45404332fd7e",
                                "sense_id": "6d0d8a60-fac5-3cb0-9267-b38c52a0ebe0",
                                "text": "Met een glas champagne in zijn hand brak een bruidegom met elke conventie tijdens de huwelijksreceptie. Wat een toost op de onvoorwaardelijke liefde voor zijn vrouw moest worden, veranderde in een ode aan een 36-jarige spits."
                            },
                            {
                                "example_id": "6eb21655-37cd-409f-99be-3796ddc76865",
                                "sense_id": "6d0d8a60-fac5-3cb0-9267-b38c52a0ebe0",
                                "text": "Bij de bedwelmende geur van seringen brengen we een toost uit. Op de fragiliteit van talent. En op leraren die het vuur van hun leerlingen weten aan te wakkeren."
                            }
                        ]
                    },
                    {
                        "sense_id": "eeae192a-13ab-3e3f-bd9a-687f56d57d0e",
                        "entry_id": "40127bd4-6ed2-3dfb-89c0-c027087f94ce",
                        "glosses": [
                            "handeling waarbij een heilwens wordt uitgesproken en meteen bekrachtigd door het samen nuttigen van een slok – meestal alcoholische – drank"
                        ],
                        "tags": [
                            "cultuur"
                        ],
                        "examples": [
                            {
                                "example_id": "c85480d7-8fd2-407a-bf7b-56b929eb3e34",
                                "sense_id": "eeae192a-13ab-3e3f-bd9a-687f56d57d0e",
                                "text": "Op gestipte glazen als deze staan zelden vrouwfiguren. Wel mannen, kinderen en cherubijntjes, en heel soms een toost tussen een man en een vrouw."
                            },
                            {
                                "example_id": "55b7f484-2aa9-46be-a56d-bd062a578810",
                                "sense_id": "eeae192a-13ab-3e3f-bd9a-687f56d57d0e",
                                "text": "Na afloop van de toost zongen de leden van het koningshuis gezamenlijk een 'lang zal hij leven' voor koning Willem-Alexander."
                            }
                        ]
                    }
                ],
