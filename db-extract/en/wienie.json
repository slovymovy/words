                                    {
                                        "sense_id": "13804250-4a8e-39b7-ab6d-0df4e5053e39",
                                        "entry_id": "5254bf8b-8ddf-3e3f-abdc-6da989e8f3f6",
                                        "glosses": [
                                            "männliches Geschlechtsorgan verschiedener Tiere, so auch des Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9aad97ce-d6a9-4574-ac7e-b26cf59d1302",
                                                "sense_id": "13804250-4a8e-39b7-ab6d-0df4e5053e39",
                                                "text": "Er zog ein Kondom über seinen Penis."
                                            },
                                            {
                                                "example_id": "f52e9f77-5e11-4945-a04a-7eb22263bccd",
                                                "sense_id": "13804250-4a8e-39b7-ab6d-0df4e5053e39",
                                                "text": "Schlangen haben zwei Penes."
                                            },
                                            {
                                                "example_id": "a2bbdd6b-802d-42a2-92e5-cbe1a9d96a8e",
                                                "sense_id": "13804250-4a8e-39b7-ab6d-0df4e5053e39",
                                                "text": "„Denn dort gab er die Geschichte zum Besten, wie man den Bullen früher nach der Schlachtung die Penisse abschnitt, sie gerbte und daraus Pferdepeitschen machte.“"
                                            },
                                            {
                                                "example_id": "6ec8d164-aba1-4467-9bce-713d2da9f2f0",
                                                "sense_id": "13804250-4a8e-39b7-ab6d-0df4e5053e39",
                                                "text": "„Auch die Religion im alten Ägypten begann mit dem Penis.“"
                                            },
                                            {
                                                "example_id": "ae0c3d72-af0f-4539-8ae1-37b4e2728984",
                                                "sense_id": "13804250-4a8e-39b7-ab6d-0df4e5053e39",
                                                "text": "„Gefordert ist, gerade für die jüdische Gemeinschaft: Über den Rand des Penis blicken, den Mut haben, die Beschneidungen der Rede und der sozialen Teilhabe zu thematisieren. Doch genau dies findet gerade nicht statt.“"
                                            },
                                            {
                                                "example_id": "4f9ceed1-7875-468b-9b97-8206f895dcb4",
                                                "sense_id": "13804250-4a8e-39b7-ab6d-0df4e5053e39",
                                                "text": "„Dann kam mir ein komischer Gedanke in den Sinn - daß danach die Eichel meines Penis gefühllos sein würde.“"
                                            },
                                            {
                                                "example_id": "0b247e75-817b-49b7-849c-4870146785d4",
                                                "sense_id": "13804250-4a8e-39b7-ab6d-0df4e5053e39",
                                                "text": "„Man kann im Metaversum wie ein Gorilla oder ein Drachen oder ein gigantischer sprechender Penis aussehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
