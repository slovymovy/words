                        "behendig dribbelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To move or run across a field with a ball at one's feet or in one's hand by repeatedly moving or bouncing it."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to dribble",
                                "target_lang_sense_clarification": "in sports like soccer or basketball"
                            }
