                "senses": [
                    {
                        "sense_id": "40a32200-0edf-3166-8436-1a74bbf90984",
                        "entry_id": "103825d4-8946-3c5d-b247-a25355f1bc41",
                        "glosses": [
                            "eine einzelne Nudelplatte der Sorte Lasagne"
                        ],
                        "tags": [
                            "Kochkunst"
                        ],
                        "examples": [
                            {
                                "example_id": "10f7470e-1986-4763-8be7-85e5e2fa60e3",
                                "sense_id": "40a32200-0edf-3166-8436-1a74bbf90984",
                                "text": "„Dabei mit einer Lasagneplatte beginnen, diese mit drei Scheiben Seeteufel belegen und mit etwas Tomaten-Oliven-Sauce bestreichen.“"
                            },
                            {
                                "example_id": "0b1bab82-606e-4977-b8cc-dd568b94a7e3",
                                "sense_id": "40a32200-0edf-3166-8436-1a74bbf90984",
                                "text": "„Spinat mit Käsesauce und Lasagneplatten abwechselnd in die Form schichten. Die Schollenfilets in der mittleren Spinatschicht platzieren. Mit einer Lasagneplatte abschließen, Crème fraîche daraufverteilen, Salbei und Parmesan darüberstreuen.“"
                            },
                            {
                                "example_id": "dc31534c-faa3-4f78-910c-4fd8c4c50dc8",
                                "sense_id": "40a32200-0edf-3166-8436-1a74bbf90984",
                                "text": "„Mit 3 Lasagneblättern belegen, ein Viertel der Béchamelsauce, den restlichen Spinat und das restliche Geflügelragout darauf verteilen und mit Lasagneplatten abschließen.“"
                            },
                            {
                                "example_id": "6a1189c3-f673-482d-8b02-77e1a6b1dfb6",
                                "sense_id": "40a32200-0edf-3166-8436-1a74bbf90984",
                                "text": "„Sie lag zwischen zwei glitschigen Felsbrocken eingeklemmt, die mit Tang überzogen waren und aussahen wie große grüne Lasagneplatten.“"
                            },
                            {
                                "example_id": "4262b90f-39b3-4805-8273-6a088848dd53",
                                "sense_id": "40a32200-0edf-3166-8436-1a74bbf90984",
                                "text": "„Die simple italienische [Nudelmaschine] aus Edelstahl mit Kurbel ist ideal für Lasagneplatten, Bandnudeln und flache Spaghetti.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
