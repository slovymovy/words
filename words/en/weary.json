                                "target_lang_sense_clarification": "etwas nicht mehr ertragen oder tun wollen"
                            },
                            {
                                "target_lang_word": "leid",
                                "target_lang_sense_clarification": "etwas satt haben"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "407f457d-e44a-3e9f-8790-0991a4ca4bb1",
                    "sense_definition": "Expressive of fatigue.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fatigued",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave me a <w>weary</w> smile before closing her eyes to sleep.",
