                "senses": [
                    {
                        "sense_id": "c6d57197-9c64-38bd-b7ba-1c5a88140739",
                        "entry_id": "1840924d-bc84-3208-ab37-d926d7881d29",
                        "glosses": [
                            "достичь более высокого общественного положения, большего значения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00944b6a-627e-43aa-adfc-050228648e68",
                                "sense_id": "c6d57197-9c64-38bd-b7ba-1c5a88140739",
                                "text": "Все возвысьтесь на высоту добродетелей, как на гору, и отрясите свои грехи, как тину, как нечистоту, как тление и источник тления."
                            },
                            {
                                "example_id": "c36eb247-90a6-47bd-bf23-67fff76113b6",
                                "sense_id": "c6d57197-9c64-38bd-b7ba-1c5a88140739",
                                "text": "Сколько кто погрузится в смирение, столько возвысится в преуспеянии."
                            }
                        ]
                    }
                ],
