                                    }
                                ]
                            },
                            {
                                "target_word": "imperative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64776650-b20e-3f01-94f7-a6742c64ab47",
                                        "entry_id": "6f40d7d5-f72b-32bd-bcaa-4f974b6c0aa4",
                                        "glosses": [
                                            "The grammatical mood expressing an order (see jussive). In English, the imperative form of a verb is the same as that of the bare infinitive."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ef05d3b-3bbc-472c-8fbc-5d041215e0a1",
                                                "sense_id": "64776650-b20e-3f01-94f7-a6742c64ab47",
                                                "text": "The verbs in sentences like \"Do it!\" and \"Say what you like!\" are in the imperative."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6be7413-fa51-3bff-804e-d113803afca8",
                                        "entry_id": "6f40d7d5-f72b-32bd-bcaa-4f974b6c0aa4",
                                        "glosses": [
                                            "A verb in the imperative mood."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7d5be373-4ab4-3c91-8e1c-d5cf407cac73",
                                        "entry_id": "6f40d7d5-f72b-32bd-bcaa-4f974b6c0aa4",
                                        "glosses": [
                                            "An essential action, a must: something which is imperative."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97dd3542-1e1f-4ad4-87ad-c29bf223a78d",
                                                "sense_id": "7d5be373-4ab4-3c91-8e1c-d5cf407cac73",
                                                "text": "Visiting Berlin is an imperative."
                                            },
                                            {
                                                "example_id": "8d93fcd6-6058-4c96-9322-0ad262a52c36",
                                                "sense_id": "7d5be373-4ab4-3c91-8e1c-d5cf407cac73",
                                                "text": "Anything grandiose or historically based tends to sound flat and banal when it reaches English, partly because translators get stuck between contradictory imperatives: juggling fidelity to the original sense with what is vocally viable, they tend to resort to a genteel fustian which lacks either poetic resonance or demotic realism, adding to a sense of artificiality rather than enhancing credibility."
                                            },
                                            {
                                                "example_id": "26804bb8-5cac-4507-9f9c-b55f5badbbb6",
                                                "sense_id": "7d5be373-4ab4-3c91-8e1c-d5cf407cac73",
                                                "text": "The new imperative for investment is the Government's objective to secure carbon-neutral transport emissions by 2040."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
