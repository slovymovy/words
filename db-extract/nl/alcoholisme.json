                                                "text": "effects of alcoholism"
                                            },
                                            {
                                                "example_id": "5d3f5f08-d607-4ded-85f4-29dd1b6345e6",
                                                "sense_id": "beaf052f-fc6f-38be-aaff-4a881aab186a",
