                    "frequency": "Low",
                    "semantic_group_id": "zorgen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij had veel <w>kommer</w> over de toekomst van haar kinderen in deze onzekere tijden.",
                            "target_lang_translations": {
                                "en": "She had much <w>worry</w> about the future of her children in these uncertain times."
                            }
                        },
                        {
                            "text": "Na het faillissement was er alleen nog maar <w>kommer</w> en kwel in het gezin.",
                            "target_lang_translations": {
                                "en": "After the bankruptcy, there was nothing but <w>misery</w> and woe in the family."
                            }
                        }
