{
    "word_family": [
        "célébration",
        "célèbre",
        "célébrité",
        "célébrant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6148f12d-bcf0-3b3c-ab88-11747e42612b",
                    "sense_definition": "Marquer un événement ou une fête par des réjouissances ou une cérémonie.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fête",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toute la famille se réunit ce soir pour <w>célébrer</w> l'anniversaire de grand-mère."
                        },
                        {
                            "text": "Les supporters sont descendus dans la rue afin de <w>célébrer</w> la victoire de leur équipe."
                        }
                    ],
                    "synonyms": [
                        "fêter"
                    ],
                    "common_phrases": [
                        "célébrer un anniversaire",
                        "célébrer une victoire"
                    ]
                },
                {
                    "sense_id": "29982edd-76b5-3ecd-99c5-f7e61d1b1eb5",
                    "sense_definition": "Accomplir avec solennité les rites ou les cérémonies d'une religion ou d'un culte.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "culte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le prêtre du village a accepté de <w>célébrer</w> leur mariage samedi prochain."
                        },
                        {
                            "text": "Chaque dimanche matin, le prêtre <w>célèbre</w> une messe solennelle dans cette chapelle."
                        }
                    ],
                    "common_phrases": [
                        "célébrer un mariage",
                        "célébrer la messe",
                        "célébrer un culte"
                    ]
                },
                {
                    "sense_id": "7eb9dd5e-2c95-33e6-84d0-11a520a0a982",
                    "sense_definition": "Louer publiquement et avec éclat ; vanter avec ferveur les mérites de quelqu'un ou de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "éloge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce poème magnifique a été composé pour <w>célébrer</w> la beauté de la nature."
                        },
                        {
                            "text": "Le discours du maire <w>célébrait</w> le dévouement exceptionnel des pompiers volontaires."
                        }
                    ],
                    "synonyms": [
                        "exalter"
                    ],
                    "common_phrases": [
                        "célébrer la mémoire",
                        "célébrer les mérites"
                    ]
                }
            ]
        }
    ]
}