                ],
                "senses": [
                    {
                        "sense_id": "ce20027f-b18a-3398-859d-b763c9cbfd2d",
                        "entry_id": "5ba277be-38a0-3f27-8093-46c2bdaa87e7",
                        "glosses": [
                            "Faire revenir à l'état qui précédait une concaténation, reséparer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "653eecd4-dce7-4eb0-be69-1e02dca7da45",
                                "sense_id": "ce20027f-b18a-3398-859d-b763c9cbfd2d",
                                "text": "Pratiquant et renouvelant sans cesse l’exercice solennel ou facétieux de la narration, ils ne se lassent jamais de morceler les mots, de les déconcaténer et de les reconcaténer, de prêter l'oreille aux effets acoustiques et de saisir les opportunités sémantiques auxquelles ils parviennent."
                            },
                            {
                                "example_id": "5a7e4fc1-b693-4b8d-9ab6-021c55d313f4",
                                "sense_id": "ce20027f-b18a-3398-859d-b763c9cbfd2d",
                                "text": "Les champs à exporter apparaissant en gras peuvent être déconcaténés automatiquement sur Excel."
                            },
                            {
                                "example_id": "9f1b929e-8fe8-4eec-95f4-16cb8909c002",
                                "sense_id": "ce20027f-b18a-3398-859d-b763c9cbfd2d",
                                "text": "Vous avez un tableau avec une cellule qui contient un texte ou une valeur et vous ne souhaitez qu’en récupérer une partie, il faudra donc désassembler ou déconcaténer la chaîne."
                            },
                            {
                                "example_id": "64d644b2-8b50-4f1f-8217-1ab6a9acab2b",
                                "sense_id": "ce20027f-b18a-3398-859d-b763c9cbfd2d",
                                "text": "Autant je sais concaténer une colonne, autant je ne sais pas en déconcaténer plusieurs."
                            },
                            {
                                "example_id": "eefd9ada-45be-446a-b858-530c0d6cbf1d",
                                "sense_id": "ce20027f-b18a-3398-859d-b763c9cbfd2d",
                                "text": "Dans ce cas, l'étape peut les déconcaténer en lignes distinctes pour la sortie."
                            }
                        ]
                    }
                ],
