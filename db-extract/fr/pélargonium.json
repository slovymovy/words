                                        "glosses": [
                                            "Een sierplant van het geslacht Pelargonium"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c75cde4-8294-43ac-ba80-968c612ce6b6",
                                                "sense_id": "7a52d4f7-e30d-399e-ad8e-70c4790e1c75",
                                                "text": "De geranium staat in bloei."
                                            },
                                            {
                                                "example_id": "1a624044-09aa-4c49-ad65-f2387715de33",
                                                "sense_id": "7a52d4f7-e30d-399e-ad8e-70c4790e1c75",
                                                "text": "Schuin achter het podium bevond zich een klein raam dat op straat uitzag. In de vensterbank stond een geranium naar buiten te kijken."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cafc28d6-25bf-3f84-9eca-e769f7887be6",
                                        "entry_id": "e5eeb68c-5e79-3202-ab70-c0ff85da7b07",
