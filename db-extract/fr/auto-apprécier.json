                        "sense_id": "2442c2a1-5382-361c-abf9-5a6a621a210c",
                        "entry_id": "f72a07f5-5a93-3a83-a7bf-600476e94e3b",
                        "glosses": [
                            "Apprécier soi-même."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b8fd37ce-ed1d-3e4f-9e46-8ab29b83551e",
                        "entry_id": "f72a07f5-5a93-3a83-a7bf-600476e94e3b",
                        "glosses": [
                            "S’apprécier soi-même."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "975320b1-042f-4011-9b75-4e60395179ce",
                                "sense_id": "b8fd37ce-ed1d-3e4f-9e46-8ab29b83551e",
                                "text": "Tout comme on ne peut être en train de danser et s'auto-apprécier, selon un adage dendi, les politiciens ne se rendent pas compte du degré de leur déviance dans le bal masqué qu'ils orchestrent à outrance."
                            },
                            {
                                "example_id": "60c486f9-c7f3-4f51-bba3-a6a3f67988ac",
                                "sense_id": "b8fd37ce-ed1d-3e4f-9e46-8ab29b83551e",
                                "text": "Le penchant à s'auto-apprécier au détriment d'autres proches par les compétences et par le public visé traverse également les institutions à statut identique."
                            }
                        ]
                    }
