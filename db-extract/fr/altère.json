                        "sense_id": "abd6755f-e4b1-3f0a-ba78-a877d1c87e30",
                        "entry_id": "d965d5d1-4ff9-36b6-a27e-9932a0395cfd",
                        "glosses": [
                            "Troisième personne du singulier de l’indicatif présent du verbe altérer."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "3afae5ba-c8d2-4a0f-9083-4ff0b7ad4230",
                                "sense_id": "abd6755f-e4b1-3f0a-ba78-a877d1c87e30",
                                "text": "Cela n’altère en rien la mondanéité de l’expérience mais l’ouvre plutôt : le monde cru sauvé n’est pas un monde « dé-mondanisé » mais bien un monde accompli comme monde."
                            },
                            {
                                "example_id": "3ca1243b-b16a-4892-bf6f-54bf3fb98b05",
                                "sense_id": "abd6755f-e4b1-3f0a-ba78-a877d1c87e30",
                                "text": "Ceci ne signifie toutefois pas que le médicament n’ altère pas l’aptitude à la conduite."
                            }
                        ]
