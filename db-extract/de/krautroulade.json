                ],
                "senses": [
                    {
                        "sense_id": "257f55e5-3cf8-3ff0-b82a-2b6bdd132a73",
                        "entry_id": "c9c84a3a-4bd7-3b4d-bae9-3136e6915565",
                        "glosses": [
                            "Gericht aus Hackfleisch, das in Krautblätter (Weißkohlblätter) eingerollt und geschmort wird"
                        ],
                        "tags": [
                            "Austrian German",
                            "South-German"
                        ],
                        "examples": [
                            {
                                "example_id": "ab3d9827-df2c-4abe-bd0a-c4dc9eaddeb0",
                                "sense_id": "257f55e5-3cf8-3ff0-b82a-2b6bdd132a73",
                                "text": "„Die Krautrouladen, nach alter Schule nur mit Schweinefleisch gefüllt und mit schmalzigem, dezent papriziertem Saftl versehen, das noch das Aroma des Holzofens atmet, sind grandios.“"
                            },
                            {
                                "example_id": "dabef677-e0f7-46e6-81fd-034bfcb920db",
                                "sense_id": "257f55e5-3cf8-3ff0-b82a-2b6bdd132a73",
                                "text": "„[…] als Hauptgericht können die Gäste unter anderem zwischen bayerischer Bauern-Ente, einem amerikanischen Weihnachtstruthahn oder Krautrouladen wählen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
