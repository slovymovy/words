                "senses": [
                    {
                        "sense_id": "63bf60b0-3ea7-334d-a19f-e1f08a14a6ba",
                        "entry_id": "c866905a-e1e6-3ef9-815e-b1306a2818be",
                        "glosses": [
                            "an einem Auto befestigtes Gestell zum Transportieren von Ladung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9065ebcf-7681-4667-82e7-cfd51804ecd6",
                                "sense_id": "63bf60b0-3ea7-334d-a19f-e1f08a14a6ba",
                                "text": "„Bogarts Dachträger knallte mit einem dumpfen Geräusch genau in die scharfe Kante der Garagentür, und dann blieben beide stehen.“"
                            },
                            {
                                "example_id": "e98f17fd-196c-4f29-ae6d-c2b25d803fce",
                                "sense_id": "63bf60b0-3ea7-334d-a19f-e1f08a14a6ba",
                                "text": "„Hier könnte man beispielsweise einen Dachträger für einen VW Golf genau so gut wie für einen Passat oder Touareg anbieten, aber nicht, wenn das Auto ein Cabrio mit Stoffdach ist.“"
                            },
                            {
                                "example_id": "f2b1ae57-53b3-4729-866f-fcf724287c3a",
                                "sense_id": "63bf60b0-3ea7-334d-a19f-e1f08a14a6ba",
                                "text": "„Das Auto samt Dachträger ist gerammelt voll – diesmal auch schon ohne Katzen – und ich kann mir einfach nicht vorstellen, wie es jemals möglich sein sollte hier zwei oder mehr Kinder samt Gepäck reinzubringen.“"
                            },
                            {
                                "example_id": "3e47925b-b6b7-4b23-b517-4abd831ab7b3",
                                "sense_id": "63bf60b0-3ea7-334d-a19f-e1f08a14a6ba",
                                "text": "„Benutzen Sie für die Befestigung der Kajaks zusätzliche mit dem Dachträger fest verschraubte Hilfsmittel wie Mittelstange, Kajakbügel für vertikale bzw. horizontale Bootslagerung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
