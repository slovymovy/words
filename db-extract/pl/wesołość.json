                        "translation_id": "33e9dda8-97b6-4f02-9f7e-152d47fbeb51",
                        "source_entry_id": "dcad35e0-f30d-3894-bab2-0f37ef7fac50",
                        "source_sense_id": "6b0e6d87-2bf1-37e1-be8f-e421a54d3aed",
                        "target_lang_word": "Fröhlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fröhlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64d89ccd-5ad5-3181-a8cb-466e4745d28d",
                                        "entry_id": "bf264646-eeca-3a4e-b1ad-37f1c4f8bd9d",
                                        "glosses": [
                                            "Zustand, Stimmung einer Person oder Gruppe voller erkennbarer Freude"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17cf35cf-c8d0-4521-a5ea-40d01854e1f3",
                                                "sense_id": "64d89ccd-5ad5-3181-a8cb-466e4745d28d",
                                                "text": "Ihre Fröhlichkeit wirkte auf alle anderen ansteckend."
                                            },
                                            {
                                                "example_id": "e08ccdd2-c7b1-4e28-8ce5-ffb261643579",
                                                "sense_id": "64d89ccd-5ad5-3181-a8cb-466e4745d28d",
                                                "text": "„In diesem Augenblick trat die Sonne völlig aus den Wolken heraus, und der kraftvolle Schall des einzelnen Schusses und der Glanz der hellen Sonne flossen für alle zu einem einzigen Eindruck von Kühnheit und Fröhlichkeit zusammen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be64ea85-721c-4595-8ca1-4faec923ac4f",
                        "source_entry_id": "dcad35e0-f30d-3894-bab2-0f37ef7fac50",
                        "source_sense_id": "6b0e6d87-2bf1-37e1-be8f-e421a54d3aed",
                        "target_lang_word": "весёлость",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "весёлость",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bf8b12ee-ff28-3341-870f-6faf220187f5",
                                        "entry_id": "7879b893-a96d-3b9d-905f-e2ed8191719b",
                                        "glosses": [
                                            "свойство или состояние по значению прилагательного весёлый"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccb8f25c-f779-4425-9479-e9d2163232f3",
                                                "sense_id": "bf8b12ee-ff28-3341-870f-6faf220187f5",
                                                "text": "Софья Карповна, ободрённая его весёлостью, удвоила своё злословие насчёт бедного Фрышкина."
                                            },
                                            {
                                                "example_id": "0373e698-606d-4eab-a6e7-bb0cd61ea7a1",
                                                "sense_id": "bf8b12ee-ff28-3341-870f-6faf220187f5",
                                                "text": "Но в страду и бабы не разговорчивы: плечи у них болят, поясницы ломит, а тут жар пёклый, духота несусветная, ― не до весёлостей уж."
                                            },
                                            {
                                                "example_id": "dae045b3-f1e7-4546-a35b-bd73fe36c4ac",
                                                "sense_id": "bf8b12ee-ff28-3341-870f-6faf220187f5",
                                                "text": "— Так, — сказал Губошлёп, не утрачивая своей загадочной весёлости."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e8afc76-c8b8-3ba3-8fd0-9ccd10c69e43",
                                        "entry_id": "7879b893-a96d-3b9d-905f-e2ed8191719b",
                                        "glosses": [
                                            "устар. веселье, развлечения"
                                        ],
                                        "tags": [
                                            ", обычно мн. число"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ac3e965-bd73-4ed7-adb2-480bc5c26bc2",
                                                "sense_id": "6e8afc76-c8b8-3ba3-8fd0-9ccd10c69e43",
                                                "text": "Но кузнец шёл и ничего не видал и не участвовал в тех весёлостях, которые когда-то любил более всех."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
