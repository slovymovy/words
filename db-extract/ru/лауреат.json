                ],
                "senses": [
                    {
                        "sense_id": "b48b04cc-2ecf-32df-bf69-a018f40a543f",
                        "entry_id": "62123602-6f31-3fe2-bb17-186940cdd734",
                        "glosses": [
                            "тот, кто удостоен особой премии за выдающиеся достижения в области науки, искусства, народного хозяйства"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d70a0e4-c52a-48c8-9891-41e7e5355ceb",
                                "sense_id": "b48b04cc-2ecf-32df-bf69-a018f40a543f",
                                "text": "Выбор лауреата в области физиологии и медицины — право Стокгольмского института медицины и хирургии."
                            },
                            {
                                "example_id": "032782fa-cae6-429b-ba40-c75a0db374bf",
                                "sense_id": "b48b04cc-2ecf-32df-bf69-a018f40a543f",
                                "text": "88 лауреатов Нобелевской премии выступили в защиту Сахарова и Солженицына."
                            }
                        ]
                    },
                    {
                        "sense_id": "5183f62f-e871-3d81-96c5-e286e69a9642",
                        "entry_id": "62123602-6f31-3fe2-bb17-186940cdd734",
                        "glosses": [
                            "победитель конкурса"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e12adb8f-b78a-472f-b8bf-6713ca3c25bb",
                                "sense_id": "5183f62f-e871-3d81-96c5-e286e69a9642",
                                "text": "Лауреаты конкурса — солисты, хоры, оркестры, танцевальные ансамбли — участвовали в красочном апофеозе молодого творчества в «Концертхаузе»."
                            }
                        ]
                    },
                    {
                        "sense_id": "16a568dc-21dd-30c8-98e8-62180ac36c7b",
                        "entry_id": "62123602-6f31-3fe2-bb17-186940cdd734",
                        "glosses": [
                            "устар. тот, кто окончил художественное учебное заведение с наградой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25c3d43f-730c-4a14-afae-f9c1ebfc8ca0",
                                "sense_id": "16a568dc-21dd-30c8-98e8-62180ac36c7b",
                                "text": "Российские академии художеств слали своих лауреатов доучиваться в Париж."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ebd24d6a-b2f6-4863-aa5f-3e2bfb9ca0cb",
                        "source_entry_id": "62123602-6f31-3fe2-bb17-186940cdd734",
                        "source_sense_description": "тот, кто удостоен особой премии за выдающиеся достижения в области науки, искусства, народного хозяйства",
                        "target_lang_word": "laureate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laureate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b5ef05c-75c0-3de3-bc0e-53a2a55ead67",
                                        "entry_id": "4a4facb4-48ec-381b-8323-66418679b255",
                                        "glosses": [
                                            "Crowned, or decked, with laurel."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "postpositional",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c038b74-fee5-4418-bbd7-556b9a6b9028",
                                                "sense_id": "0b5ef05c-75c0-3de3-bc0e-53a2a55ead67",
                                                "text": "To strew the laureate hearse where Lycid lies."
                                            },
                                            {
                                                "example_id": "9aedd582-7c37-40ff-9303-22f444dca8bb",
                                                "sense_id": "0b5ef05c-75c0-3de3-bc0e-53a2a55ead67",
                                                "text": "Soft on her lap her laureate son reclines."
                                            },
                                            {
                                                "example_id": "ae927201-5b7f-40ef-a5a7-b89396b630e2",
                                                "sense_id": "0b5ef05c-75c0-3de3-bc0e-53a2a55ead67",
                                                "text": "Although the post of poet laureate as we know it was not established until John Dryden's appointment in 1668,"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "laureate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb2a98ba-14ea-36a3-9889-ccc5acd2fac4",
                                        "entry_id": "c472f1a6-369a-3727-8125-b531ba782149",
                                        "glosses": [
                                            "One crowned with laurel, such as a poet laureate or Nobel laureate."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cb92c4e-4221-417f-8a62-78f85f3176ac",
                                                "sense_id": "cb2a98ba-14ea-36a3-9889-ccc5acd2fac4",
                                                "text": "a learn'd laureate"
                                            },
                                            {
                                                "example_id": "adb51daf-82c3-4c86-8445-093eb6968af8",
                                                "sense_id": "cb2a98ba-14ea-36a3-9889-ccc5acd2fac4",
                                                "text": "Maria Ressa, the chief executive and cofounder of Rappler, and Dmitry Muratov, the editor-in-chief of Novaya Gazeta, were named as this year’s laureates by Berit Reiss-Andersen, the chair of the Norwegian Nobel committee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dbab257-b9dc-3442-b3ff-6ac0e537e497",
                                        "entry_id": "c472f1a6-369a-3727-8125-b531ba782149",
                                        "glosses": [
                                            "A graduate of a university."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "laureate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eedd9e77-86ee-37fc-ad52-5db881205536",
                                        "entry_id": "edb7a0b0-b095-35ca-8d1a-452fc692fede",
                                        "glosses": [
                                            "To honor with a wreath of laurel, as formerly was done in bestowing a degree at English universities."
                                        ],
