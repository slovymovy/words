                                        "glosses": [
                                            "An inferior person; a subhuman, especially in Nazi racial hierarchy."
                                        ],
                                        "tags": [
                                            "Nazism",
                                            "derogatory",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
