                                "example_id": "df30299d-5a93-49ee-8315-e42e112e97b2",
                                "sense_id": "4944dd30-f3ef-3f7d-9396-8867812b136c",
                                "text": "Toutes ces techniques de marketing visant à « campagnardiser » des produits de l'industrie me mettent hors de moi parce qu'elles vendent, à bas prix, de l'illusion."
                            },
                            {
                                "example_id": "e0ae8c34-2e28-4d58-b234-067e25e094c0",
                                "sense_id": "4944dd30-f3ef-3f7d-9396-8867812b136c",
                                "text": "On va le campagnardiser, ce citadin !"
                            },
                            {
                                "example_id": "c050441d-f42f-41bf-9578-cdbe716fecac",
                                "sense_id": "4944dd30-f3ef-3f7d-9396-8867812b136c",
                                "text": "Fais gaffe tu vas te campagnardiser aussi toi."
                            }
                        ]
