                                            "genitive prepositional",
                                            "with-dative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a6fef88-d453-4391-9483-061628a65ec9",
                                                "sense_id": "2903650d-0a0b-3af2-9022-72450026cd55",
                                                "text": "Laut DPA hat es bei dem Erdbeben 80 Tote gegeben."
                                            },
                                            {
                                                "example_id": "9a1f13e9-79ec-4d1b-9818-9e65982c9f8a",
                                                "sense_id": "2903650d-0a0b-3af2-9022-72450026cd55",
                                                "text": "„Führen Gespräche mit Lehrern und Schulpsychologen jedoch zu nichts, können schulpflichtige Schüler laut Bayerischen Erziehungs- und Unterrichtsgesetzes (BayEug) für Absenzen belangt werden.“"
                                            },
                                            {
                                                "example_id": "7ba7837d-6fe8-4a16-bed3-df921134f060",
                                                "sense_id": "2903650d-0a0b-3af2-9022-72450026cd55",
                                                "text": "„Vor 30 Jahren (1980) gewann Beat Spreiter laut «Vaterland» die Landesmeisterschaften im Deltafliegen vor Hansjörg Frommelt und Markus Erne.“"
                                            },
                                            {
                                                "example_id": "bff64f85-8450-4ba0-8d7d-c163b917257d",
                                                "sense_id": "2903650d-0a0b-3af2-9022-72450026cd55",
                                                "text": "„Laut Aussage der Veranstalter liege die Bestmarke im Drachensteigen derzeit bei 674 Fluggeräten.“"
                                            },
                                            {
                                                "example_id": "85502fa2-b04a-4967-b358-21cd4183d7f3",
                                                "sense_id": "2903650d-0a0b-3af2-9022-72450026cd55",
                                                "text": "[…] „In Deutschland verursachen Flüge laut Statistischem Bundesamt und Öko-Institut pro Jahr etwa 28 Millionen Tonnen CO2 – ungefähr 3 Prozent der Treibhausgase.“"
                                            },
                                            {
                                                "example_id": "912f7ccf-763f-42a8-b589-7317d319b9a3",
                                                "sense_id": "2903650d-0a0b-3af2-9022-72450026cd55",
                                                "text": "„Eine plötzliche Vertragskündigung durch Yahoo beendete laut dem Verein die Geschäftsbeziehung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
