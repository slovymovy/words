                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67bd1ab0-48ad-46c2-bee3-b9bc0f830651",
                                "sense_id": "3179b601-7e80-3062-81af-0aa3cecc80d0",
                                "text": "A force de tâtonner et de retâtonner, de taper et de retaper, quelque chose finit par entrer dans la tête de Beppino."
                            },
                            {
                                "example_id": "d0b5a28d-c3fc-442d-9063-361db96727f2",
                                "sense_id": "3179b601-7e80-3062-81af-0aa3cecc80d0",
                                "text": "Il baisse l'os, regarde la salle, replace l'os, retâtonne, se signe et passe l'os au suivant."
                            }
                        ]
                    }
