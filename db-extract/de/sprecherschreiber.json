                "senses": [
                    {
                        "sense_id": "c001f347-c5ca-38c2-ba00-12c6feef5543",
                        "entry_id": "eb75b2f2-0cdc-3880-8d57-c549e19ce4b0",
                        "glosses": [
                            "user of a language (either speaking or writing, explicitly agnostic as to the medium of language use)"
                        ],
                        "tags": [
                            "jargon",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "c47e0c6a-af43-47d4-b963-2376e33724b5",
                                "sense_id": "c001f347-c5ca-38c2-ba00-12c6feef5543",
                                "text": "Innovationen werden gefunden oder gemacht, aber sie werden auch von einzelnen akzeptiert und damit erst verbreitet. Und dazu braucht es uns, die simplen Sprecherschreiber.",
                                "translation": "Innovations are either found or made, but they are also accepted by individuals, and are thereby spread. And that requires us, the basic users of the language.",
                                "english": "Innovations are either found or made, but they are also accepted by individuals, and are thereby spread. And that requires us, the basic users of the language."
                            },
                            {
                                "example_id": "5dda497e-2fae-4ff5-ae10-95a80dc97efd",
                                "sense_id": "c001f347-c5ca-38c2-ba00-12c6feef5543",
                                "text": "Ich sehe nomina instrumenti als Subtyp der nomina agentis, weil ein Sprecherschreiber, der z.B. Toaster bildet, das Bezeichnete offenbar als etwas Handelndes wahrnimmt […]",
                                "translation": "I consider nomina instrumenti a subtype of nomina agentis, because a user of the language forming e.g. \"Toaster\" apparently views the described object as the performer of an action […]",
                                "english": "I consider nomina instrumenti a subtype of nomina agentis, because a user of the language forming e.g. \"Toaster\" apparently views the described object as the performer of an action […]"
                            }
                        ]
                    }
