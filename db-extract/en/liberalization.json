                                "example_id": "98e451cb-07e2-4124-ba51-f418270c5d97",
                                "sense_id": "483a1f72-dfb5-3f5b-a583-e19df2811b51",
                                "text": "Paisley's three year \"Save Ulster from Sodomy\" campaign has been a significant force in preventing until now the liberalization of laws about gayness in the British protectorate."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a275757-1a94-36d9-9122-21b2114839c1",
                        "entry_id": "cb4bad59-a1f6-331d-9a93-bb6fa280b880",
                        "glosses": [
                            "the lessening of government regulations and restrictions in an economy in exchange for greater participation by private entitiesᵂᵖ"
