        "nl-extract.jsonl": [
            {
                "entry_id": "d562aa25-9881-3f58-8d41-8700a3c14e96",
                "word": "overstort",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "8317872c-9f64-4298-a4c7-16f7b5b88336",
                        "entry_id": "d562aa25-9881-3f58-8d41-8700a3c14e96",
                        "tags": [
                            "plural"
                        ],
                        "form": "overstorten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e24a3a5e-d41a-3e99-90ec-aaea304bce3d",
                        "entry_id": "d562aa25-9881-3f58-8d41-8700a3c14e96",
                        "glosses": [
                            "plaats waar het water van een kanaal, naar een lager gelegen water kan lopen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b90b0f2-20f7-41a8-8254-1a7c9c09fcc9",
                                "sense_id": "e24a3a5e-d41a-3e99-90ec-aaea304bce3d",
                                "text": "Donderdagavond en nacht en gisteren overdag werd de waterkant gerepareerd en een kanogoot fungeerde als extra overstort."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f5ca87c-04cf-374f-a180-fd5f6cdabb27",
                        "entry_id": "d562aa25-9881-3f58-8d41-8700a3c14e96",
                        "glosses": [
                            "een kunstwerk met als doel het afvoeren van (pieken in) overtollig rioolwater vanuit de gemengde riolering naar het oppervlaktewater"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3ba6ce9-c74d-427f-b660-517bde4d301a",
                                "sense_id": "9f5ca87c-04cf-374f-a180-fd5f6cdabb27",
                                "text": "Door een overstort van het riool was er tijdelijk een gebrek aan zuurstof in de beek."
                            },
                            {
                                "example_id": "26cbacb6-e1ec-4043-85c1-cd3e8add1619",
                                "sense_id": "9f5ca87c-04cf-374f-a180-fd5f6cdabb27",
                                "text": "Ook worden maatregelen genomen om te voorkomen dat het relatief schone regenwater nog langer in het riool terecht komt en zich daar mengt met het vieze water. Als het riool vol raakt, komt het overtollige vervuilde water namelijk via een overstort in de Regge terecht."
                            },
                            {
                                "example_id": "4495f11f-d6e4-4d93-b53b-4298edf5bb3b",
                                "sense_id": "9f5ca87c-04cf-374f-a180-fd5f6cdabb27",
                                "text": "Het waterschap Brabantse Delta dreigt de gemeente Moerdijk met dwangsommen omdat de capaciteit van het riool op het grote industrieterrein Moerdijk onvoldoende is. Het riool loopt regelmatig over. Vervuild afvalwater komt dan terecht in de haven, aldus een woordvoerster vandaag. Per overstort dreigt het waterschap met 10.000 euro boete."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42b1d616-5e1e-4d27-849c-2ce5bcc42063",
                        "source_entry_id": "d562aa25-9881-3f58-8d41-8700a3c14e96",
                        "source_sense_id": "e24a3a5e-d41a-3e99-90ec-aaea304bce3d",
                        "source_sense_description": "noodafvoer voor een kanaal",
                        "target_lang_word": "storm overflow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3c9e58b8-2505-42af-96fa-35bfee5c5ccd",
                        "source_entry_id": "d562aa25-9881-3f58-8d41-8700a3c14e96",
                        "source_sense_id": "e24a3a5e-d41a-3e99-90ec-aaea304bce3d",
                        "source_sense_description": "noodafvoer voor een kanaal",
                        "target_lang_word": "flood water spillway",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d76d1e6b-b973-4465-b92d-583f90e836ec",
                        "source_entry_id": "d562aa25-9881-3f58-8d41-8700a3c14e96",
                        "source_sense_id": "e24a3a5e-d41a-3e99-90ec-aaea304bce3d",
                        "source_sense_description": "noodafvoer voor een kanaal",
                        "target_lang_word": "overflow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overflow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd92c25c-aefe-367d-8047-f4500fb09247",
                                        "entry_id": "de1229f3-bd10-3173-a4da-74c8cff004d9",
                                        "glosses": [
                                            "To flow over the brim of (a container)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed4f73d9-1b1d-4d9b-9ac6-5bdbf79869a5",
                                                "sense_id": "dd92c25c-aefe-367d-8047-f4500fb09247",
                                                "text": "The shadows had begun to overflow Their stagnant puddles on the nightward side, When presently the roar of battle died"
                                            },
                                            {
                                                "example_id": "5dcd88ce-4d75-4237-8520-3ff554a992c9",
                                                "sense_id": "dd92c25c-aefe-367d-8047-f4500fb09247",
                                                "text": "The river overflowed the levee into the road."
                                            },
                                            {
                                                "example_id": "6fdf40f2-237c-448a-9e53-0596e97a06cf",
                                                "sense_id": "dd92c25c-aefe-367d-8047-f4500fb09247",
                                                "text": "Theſe are they that went ouer Ioꝛden in the firſt moneth, when it had ouerflowen all his* bankes, and they put to flight all them of the valleis, both toward the Eaſt, and toward the Weſt."
                                            },
                                            {
                                                "example_id": "93dccfff-8809-4719-861d-38dc374e24e2",
                                                "sense_id": "dd92c25c-aefe-367d-8047-f4500fb09247",
                                                "text": "Locally heavy rains on the 21st caused more than 2 feet of overflow on Salt Creek at Ashland, Nebr., on the 22d. Some county roads were inundated. Mill Creek which flows into the Platte River at Louisville, Nebr., overflowed its banks from the heavy rain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7efee754-1601-35b1-b055-f76f989916a0",
                                        "entry_id": "de1229f3-bd10-3173-a4da-74c8cff004d9",
                                        "glosses": [
                                            "To cover with a liquid, literally or figuratively."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c057b9b0-bea7-42e3-a1a1-8fc2cf0543e6",
                                                "sense_id": "7efee754-1601-35b1-b055-f76f989916a0",
                                                "text": "The flash flood overflowed most of the parkland and some homes."
                                            },
                                            {
                                                "example_id": "c427a33d-de9e-4ad2-86f4-d86e1112c38c",
                                                "sense_id": "7efee754-1601-35b1-b055-f76f989916a0",
                                                "text": "So when they were working that evening at the pumps, there was on this head no small gamesomeness slily going on among them, as they stood with their feet continually overflowed by the rippling clear water […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72470a9e-66ea-34ff-ba5b-7b2323a28fd0",
                                        "entry_id": "de1229f3-bd10-3173-a4da-74c8cff004d9",
                                        "glosses": [
                                            "To cause an overflow."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aba55d4e-96ab-34ba-817a-95ebbb8112ef",
                                        "entry_id": "de1229f3-bd10-3173-a4da-74c8cff004d9",
                                        "glosses": [
                                            "To flow over the brim of a container."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74883003-fb76-47c5-9cb1-0d95a1db3094",
                                                "sense_id": "aba55d4e-96ab-34ba-817a-95ebbb8112ef",
                                                "text": "The waters overflowed into the Ninth Ward."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7b2096d-4f24-365c-a8c7-b006e728c072",
                                        "entry_id": "de1229f3-bd10-3173-a4da-74c8cff004d9",
                                        "glosses": [
                                            "To be subject to a load that exceeds limits or capacity."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a987c483-2973-4b14-9d79-138dcb13ab8e",
                                                "sense_id": "f7b2096d-4f24-365c-a8c7-b006e728c072",
                                                "text": "The hospital ER was overflowing with flu cases."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85e10ced-e199-3306-b1eb-6c51c58d1b09",
                                        "entry_id": "de1229f3-bd10-3173-a4da-74c8cff004d9",
                                        "glosses": [
                                            "To be subject to a load that exceeds limits or capacity.",
                                            "To have something in superabundance; to abound in something."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1cdcf71-360f-48ce-9ce1-6e06b45e5165",
                                                "sense_id": "85e10ced-e199-3306-b1eb-6c51c58d1b09",
                                                "text": "I see and feel that I want the first requisite — a heart overflowing with Divine love towards sinners"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a18647ef-4312-3565-9da9-62f1b946a2e9",
                                        "entry_id": "de1229f3-bd10-3173-a4da-74c8cff004d9",
                                        "glosses": [
                                            "To (cause to) exceed the available numeric range."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57f5dc99-e4f3-4a73-84e7-2d2787bdac07",
                                                "sense_id": "a18647ef-4312-3565-9da9-62f1b946a2e9",
                                                "text": "Calculating 255+1 will overflow an eight-bit byte."
                                            },
                                            {
                                                "example_id": "d6f9bda3-8554-4112-81ce-c1438c7e7a98",
                                                "sense_id": "a18647ef-4312-3565-9da9-62f1b946a2e9",
                                                "text": "Some programs, especially online games, tend to have coding problems that leave them with memory holes - in other words, they don't delete information from your PC's memory once they're finished with it, they just keep adding and adding until everything overflows. Eventually, this can cause the game to crash to desktop, but adding more memory can help prevent this."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "overflow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc0ebeee-8611-3df9-9393-8ae603f24da9",
                                        "entry_id": "0a7bd1bb-9866-3c5e-8198-0ce56d939750",
                                        "glosses": [
                                            "The spillage resultant from overflowing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "848f8224-7e80-4606-8e2d-99f5845d371e",
                                                "sense_id": "bc0ebeee-8611-3df9-9393-8ae603f24da9",
                                                "text": "High crests of these overflows were: Manhattan, 23.0 feet, 8.0 above bankful, on June 16–17; Wamego, 20.8 feet, 4.8 feet above bankful, on June 17; Topeka, 26.8 feet, 5.8 feet above bankful, on June 17; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8baa165-d294-3d48-965d-4c143f3314bb",
                                        "entry_id": "0a7bd1bb-9866-3c5e-8198-0ce56d939750",
                                        "glosses": [
                                            "An outlet for escape of excess material."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a7b7a134-0fb4-3680-853f-d781e7633694",
                                        "entry_id": "0a7bd1bb-9866-3c5e-8198-0ce56d939750",
                                        "glosses": [
                                            "Excess, superabundance"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63f78808-bb7d-48aa-ad24-8cea743a7a96",
                                                "sense_id": "a7b7a134-0fb4-3680-853f-d781e7633694",
                                                "text": "GCN: Do you have an overflow of scripts?\nJG: I have more than we could ever do, certainly. But there's never an overflow of quality, and quality is really hard to come by, real quality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4beaf252-af8f-358b-8d62-de0a35d1556d",
                                        "entry_id": "0a7bd1bb-9866-3c5e-8198-0ce56d939750",
                                        "glosses": [
                                            "The situation where a value exceeds the available numeric range."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
