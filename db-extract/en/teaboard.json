                                "example_id": "f57e1263-d9e2-48d4-89e6-6425c39bd002",
                                "sense_id": "dccf3492-0ff5-3e7f-8ba6-387bf5d5d512",
                                "text": "I remember, for instance, to have remarked in one of the rooms several small tables and teaboards, ornamented with some good copies of engravings, executed and varnished over at the manufactory of Ekaterinabourg."
                            },
                            {
                                "example_id": "8e793ca8-1934-4456-9568-93203f5261c5",
                                "sense_id": "dccf3492-0ff5-3e7f-8ba6-387bf5d5d512",
                                "text": "He had a large level countenance, like a teaboard: the original flatness of his nose not having (contrary to John's theory) preserved it from a further depression, the result of one of his many battles."
                            }
                        ]
