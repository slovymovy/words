                    {
                        "sense_id": "a2aafc29-08d9-3ac7-a0a7-718406afffc1",
                        "entry_id": "c6411657-aabe-3e9c-b782-364bb4f63197",
                        "glosses": [
                            "A country in Southern Europe, including most of the Iberian peninsula. Official name: Kingdom of Spain. Capital and largest city: Madrid."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71eeb6c0-5ff5-4dd2-bdd2-8c65377094d3",
                                "sense_id": "a2aafc29-08d9-3ac7-a0a7-718406afffc1",
                                "text": "The mountains of Spain consist of parallel ranges, running from east to west[…]"
                            },
                            {
                                "example_id": "3473cf13-7a9f-4a78-9796-1b60ea27304f",
                                "sense_id": "a2aafc29-08d9-3ac7-a0a7-718406afffc1",
                                "text": "Spain fought with France constantly from 1494 through the 1540s, especially over Italy."
                            },
                            {
                                "example_id": "643977b7-fd2f-4064-8fe4-7dc91c4112da",
                                "sense_id": "a2aafc29-08d9-3ac7-a0a7-718406afffc1",
                                "text": "Police in eastern Spain have arrested three people and seized 11 litres of ayahuasca, 117 San Pedro cactus plants and several bottles of toad poison after raiding two rural properties that were used to host lucrative spiritual retreats promising “astral journeys”."
                            }
                        ]
