                "senses": [
                    {
                        "sense_id": "e978adb3-e051-3272-88dc-e3cb89e66a7f",
                        "entry_id": "c2dd398e-9204-3b5a-b385-e864d6f86aff",
                        "glosses": [
                            "Coenagrionidae een dier dat behoort tot een van honderden soorten van de Coenagrionidae"
                        ],
                        "tags": [
                            "libellen"
                        ],
                        "examples": [
                            {
                                "example_id": "eac1dbdf-3887-49d2-a962-886d82d35999",
                                "sense_id": "e978adb3-e051-3272-88dc-e3cb89e66a7f",
                                "text": "De waterjuffers zijn de meest soortenrijke familie van de juffers Zygoptera, een van de twee onderordes van de libellen Odonata."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8131241f-f9d5-460a-b947-f5d042b713ec",
                        "source_entry_id": "c2dd398e-9204-3b5a-b385-e864d6f86aff",
                        "source_sense_id": "e978adb3-e051-3272-88dc-e3cb89e66a7f",
                        "source_sense_description": "een dier dat behoort tot een van honderden soorten van de Coenagrionidae",
                        "target_lang_word": "Libelle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Libelle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7b2d4ad3-57af-315a-8b43-557801506209",
                                        "entry_id": "ae7ae7fb-f8e4-32c8-b76d-f0f46f93dccc",
                                        "glosses": [
                                            "Vertreter einer Ordnung von am Wasser lebenden, stabförmigen Raubinsekten mit vier nicht faltbaren Flügeln (Odonata)"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cf5856f-29fe-4d15-b249-a6e432f7aa09",
                                                "sense_id": "7b2d4ad3-57af-315a-8b43-557801506209",
                                                "text": "Im Sommer gibt es bei uns am Teich viele schöne Libellen."
                                            },
                                            {
                                                "example_id": "cbb1619b-adea-4244-88d3-89438696838f",
                                                "sense_id": "7b2d4ad3-57af-315a-8b43-557801506209",
                                                "text": "„Vögel sangen in den alten Bäumen, ein Specht klopfte emsig, und über dem silbernen See tanzten flirrend Libellen.“"
                                            },
                                            {
                                                "example_id": "69e98450-a5aa-4aab-b8ed-61e3db7a9176",
                                                "sense_id": "7b2d4ad3-57af-315a-8b43-557801506209",
                                                "text": "«Marcel badete ebenfalls, und wir lagen rücklings im Wasser, Mund geschlossen, um nichts zu schlucken, es war ein trübes und warmes Wasser, das stank, jede Bewegung hinterläßt Bläschen, immerhin Wasser, lästig nur die zahllosen Libellen und Herbert, der weiter drängte, und der Gedanke, es könnte Schlangen geben.»"
                                            },
                                            {
                                                "example_id": "3050073d-012c-408f-88ed-03bd6d1c5e25",
                                                "sense_id": "7b2d4ad3-57af-315a-8b43-557801506209",
                                                "text": "„Am vermoderten Dorfteich haben wir im Sommer zwei oder drei Libellen.“"
                                            },
                                            {
                                                "example_id": "b8f5e902-0505-461f-94ea-9ade9a660dcb",
                                                "sense_id": "7b2d4ad3-57af-315a-8b43-557801506209",
                                                "text": "„Jeder, der sich für diese schönen Tiere interessiert, kann sich also unbesorgt auch in der Natur mit ihnen beschäftigen, denn die Libellen haben weder einen Stechrüssel am Kopf, noch einen Giftstachel am Körperende.“"
                                            },
                                            {
                                                "example_id": "5152e651-43e5-44d8-91a8-2d89fea751b6",
                                                "sense_id": "7b2d4ad3-57af-315a-8b43-557801506209",
                                                "text": "„Die Libelle bat bei ihr um Asyl, bekam eine Absage und starb im Schnee.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f8522408-07c8-3575-b2d2-e5f9bf213ec5",
                                        "entry_id": "ae7ae7fb-f8e4-32c8-b76d-f0f46f93dccc",
                                        "glosses": [
                                            "eine Art gebogene Haarspange"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57b8a565-95fe-4a10-8d20-d2d686c1d934",
                                                "sense_id": "f8522408-07c8-3575-b2d2-e5f9bf213ec5",
                                                "text": "„Das Kleid, der Pelz und die Libelle im Haar, die nach der Fotositzung in Vergessenheit geraten war. Sie hatte das Schmuckstück daraufhin kurzerhand im Haar belassen und würde es am morgigen Tag zurückgeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3752f202-a37e-3482-868b-936878306c6a",
                                        "entry_id": "ae7ae7fb-f8e4-32c8-b76d-f0f46f93dccc",
                                        "glosses": [
                                            "Teil von bestimmten Messinstrumenten bestehend aus einem mit einer Flüssigkeit und einer Luft- beziehungsweise Gasblase gefüllten Röhrchen aus Glas oder Kunststoff, mit dem die horizontale beziehungsweise vertikale Lage eines Gegenstandes überprüft wird"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87c60438-4154-4d60-acbf-67d58a28cfb3",
                                                "sense_id": "3752f202-a37e-3482-868b-936878306c6a",
                                                "text": "„Liegt die Gasblase genau zwischen den beiden Markierungen und ist die Libelle richtig justiert, so befindet sich der zu prüfende Gegenstand in der horizontal bzw. vertikalen Lage.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5cd767de-5c2d-4136-9d89-fbb30374df00",
                        "source_entry_id": "c2dd398e-9204-3b5a-b385-e864d6f86aff",
