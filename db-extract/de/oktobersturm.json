                ],
                "senses": [
                    {
                        "sense_id": "ab98a4ff-dc50-3782-8b94-5039451c8032",
                        "entry_id": "543a0dc2-3613-3e95-8d82-9ed9c65e1ae8",
                        "glosses": [
                            "im Monat Oktober wehender, kräftiger Sturm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11182bfd-b99f-459b-a28f-23d7634b8f45",
                                "sense_id": "ab98a4ff-dc50-3782-8b94-5039451c8032",
                                "text": "„Bei einem Oktobersturm vor der Küste von Gibraltar war ihr Schiff mit Mann und Maus untergegangen.“"
                            },
                            {
                                "example_id": "fe658bbc-d105-4d7a-80c6-3c0c2205cb26",
                                "sense_id": "ab98a4ff-dc50-3782-8b94-5039451c8032",
                                "text": "„Draußen heulte der Oktobersturm um die spitzen Giebel des alten Rathauses, in dem das Polizeibureau gleichfalls untergebracht war.“"
                            },
                            {
                                "example_id": "c66e93cb-3799-4f5e-aea3-f8540ad5a32f",
                                "sense_id": "ab98a4ff-dc50-3782-8b94-5039451c8032",
                                "text": "„Am Herbsthimmel, auf den sie unverwandt die Augen richtete, flogen im Oktobersturm die Wolken.“"
                            },
                            {
                                "example_id": "d9a0f5f5-9616-446d-a835-b9306f0ea178",
                                "sense_id": "ab98a4ff-dc50-3782-8b94-5039451c8032",
                                "text": "„Zufällig erhob sich draußen ein Windstoß und der Oktobersturm fegte die Blätter von den großen Bäumen des Tiergartens, jenseits der Straße.“"
                            },
                            {
                                "example_id": "327e78dd-172c-4037-b75d-5724ea21a109",
                                "sense_id": "ab98a4ff-dc50-3782-8b94-5039451c8032",
                                "text": "„Es war der letzte Abend vor den Herbstferien und draußen tobte der erste Oktobersturm.“"
                            },
                            {
                                "example_id": "62f0635e-f4db-4931-a47b-a40018298a81",
                                "sense_id": "ab98a4ff-dc50-3782-8b94-5039451c8032",
                                "text": "„Unheilbringende Oktoberstürme sind über die Nordseeküste dahingebraust, als der gespenstische Schimmelreiter über den Deich zu jagen scheint, die kleinen Menschen erinnernd an des Deichgrafen stolzen, herrlichen Tod.“"
                            },
                            {
                                "example_id": "2b06daac-54a7-499d-a78e-48efc539e53c",
                                "sense_id": "ab98a4ff-dc50-3782-8b94-5039451c8032",
                                "text": "„An den Fenstern rüttelte der Oktobersturm, ein heftiger, trockener Wüstenwind, dessen Kälte einem durch Mark und Bein ging.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "32d9be18-8329-363e-bc61-4ad0526e5e53",
                        "entry_id": "543a0dc2-3613-3e95-8d82-9ed9c65e1ae8",
                        "glosses": [
                            "Deckname für eine Militäraktion"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd6cf6d0-e51c-49f3-ba91-218782e8ca43",
                                "sense_id": "32d9be18-8329-363e-bc61-4ad0526e5e53",
                                "text": "„Wie verfahren damals die Lage war, konnte man auch 1965 am Herbstmanöver ‚Oktobersturm‘ der NVA sehen, an dem auch Truppen der UdSSR, Polens und der CSSR beteiligt waren.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
