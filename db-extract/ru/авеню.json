                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f50b965-3ee1-4f7a-9f2f-f04509500f5b",
                        "source_entry_id": "79b57eac-6ccd-3bbd-ae25-7f39f18a33f5",
                        "source_sense_id": "0594de3b-da94-338a-aec6-dd3bbcd55d55",
                        "target_lang_word": "avenue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "avenue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5eafb834-7d9f-3e68-b647-760473d76796",
                                        "entry_id": "52f058be-c173-3d16-91dc-5b391f8a0c6f",
                                        "glosses": [
                                            "Voie urbaine d’importance et de taille diverses. Toutefois, en général, une avenue est moins importante qu’un boulevard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e85a7dfe-b0a2-4b69-ad0d-c90b82862eee",
                                                "sense_id": "5eafb834-7d9f-3e68-b647-760473d76796",
                                                "text": "La grande avenue était complètement déserte : on avait accordé trois heures aux habitants pour vider les lieux, et tout le monde, semblait-il, s’était hâté d’en profiter."
                                            },
                                            {
                                                "example_id": "83129a9e-de10-44d4-a685-bf1d53d56074",
                                                "sense_id": "5eafb834-7d9f-3e68-b647-760473d76796",
                                                "text": "On les retrouve au kébab du coin, au bout de l’avenue Jean-Jaurès où une pancarte annonce : « Dernier kébab avant le périph », au Café de la musique du parc de la Villette, au café MK2 du quai de Seine."
                                            },
                                            {
                                                "example_id": "2dc90ce1-c358-4858-aebe-68e8f72ee629",
                                                "sense_id": "5eafb834-7d9f-3e68-b647-760473d76796",
                                                "text": "L’image aérienne vient d'en révéler l'importance en mettant en évidence une grande avenue, des monuments, et surtout, les horrea, grands entrepôts d'état, généralement associés à une activité portuaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f586d7d-1d62-3d21-a6b4-99c8ac711f11",
                                        "entry_id": "52f058be-c173-3d16-91dc-5b391f8a0c6f",
                                        "glosses": [
                                            "Allée plantée d'arbres conduisant à une habitation, à un édifice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc94adb4-9803-49a1-afbd-7bc75821fbe2",
                                                "sense_id": "4f586d7d-1d62-3d21-a6b4-99c8ac711f11",
                                                "text": "Ces clés lui furent remises à l’instant même ; chacune d’elles portait un billet qui devait servir à la faire reconnaître, et à partir de ce moment le sieur de La Coste fut chargé de la garde de toutes les portes et de toutes les avenues."
                                            },
                                            {
                                                "example_id": "1fc47d22-36e1-4c5a-90d7-866b4f6166d3",
                                                "sense_id": "4f586d7d-1d62-3d21-a6b4-99c8ac711f11",
                                                "text": "Gardes, saisissez-vous de cet homme et le branchez incontinent au premier arbre de mon avenue."
                                            },
                                            {
                                                "example_id": "8c1930c4-34d8-4540-a93a-da2d8640cc2a",
                                                "sense_id": "4f586d7d-1d62-3d21-a6b4-99c8ac711f11",
                                                "text": "Les gardes occupaient toutes les avenues du palais. — L’armée s’empara de toutes les avenues des montagnes."
                                            },
                                            {
                                                "example_id": "f612a8d7-62d5-4a42-99dc-7c3334ff9247",
                                                "sense_id": "4f586d7d-1d62-3d21-a6b4-99c8ac711f11",
                                                "text": "Plus bas commence la longue avenue de noyers qui conduit au vieux château de Landreville."
                                            },
                                            {
                                                "example_id": "53b8778f-67e5-4549-a0dd-84c06f464a21",
                                                "sense_id": "4f586d7d-1d62-3d21-a6b4-99c8ac711f11",
                                                "text": "Une avenue d’ormes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ace4fc5e-2323-3ccd-909f-aff7b89b68f9",
                                        "entry_id": "52f058be-c173-3d16-91dc-5b391f8a0c6f",
                                        "glosses": [
                                            "Voie urbaine bordée d’arbres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eae042eb-e8c8-4185-b653-e668a83f8854",
                                                "sense_id": "ace4fc5e-2323-3ccd-909f-aff7b89b68f9",
                                                "text": "La route que nous suivons est d’abord une belle avenue d’eucalyptus traversant des champs de céréales et montant doucement jusqu'à son point culminant, à 620 mètres."
                                            },
                                            {
                                                "example_id": "f086c177-bb28-45dd-a53b-79b3b9d7408a",
                                                "sense_id": "ace4fc5e-2323-3ccd-909f-aff7b89b68f9",
                                                "text": "Bien qu’il connût la route, il s’avançait avec précaution, dans cette avenue que bordaient d’énormes arbres dont les cimes se perdaient dans l’ombre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83745309-5a82-3188-ac64-091e3b85954d",
                                        "entry_id": "52f058be-c173-3d16-91dc-5b391f8a0c6f",
                                        "glosses": [
                                            "Dans les villes, large artère rectiligne, ouvrant une perspective."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e144745-1a94-4f5a-8875-aac423675447",
                                                "sense_id": "83745309-5a82-3188-ac64-091e3b85954d",
                                                "text": "Je me suis promené sur l’avenue des Champs-Élysées."
                                            },
                                            {
                                                "example_id": "19f10f02-257d-4c56-b98b-c73f0ecba5e4",
                                                "sense_id": "83745309-5a82-3188-ac64-091e3b85954d",
                                                "text": "L’avenue de l'Opéra conduit au palais Garnier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7629ce4e-5453-39a0-bc02-f2a775e7fd83",
                                        "entry_id": "52f058be-c173-3d16-91dc-5b391f8a0c6f",
                                        "glosses": [
                                            "Rue importante, quelle que soit son orientation, en particulier quand elle est bordée d’arbres."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "677e0c37-c097-467c-86db-0432ba248104",
                                                "sense_id": "7629ce4e-5453-39a0-bc02-f2a775e7fd83",
                                                "text": "Quand tout dort encore, les larges avenues de Carpentras voient affluer des amoncellements d’asperges, de petits pois, de pomme de terre, de cerises et de fraises."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c925f40-fae5-39ee-87c1-925d53a92717",
                                        "entry_id": "52f058be-c173-3d16-91dc-5b391f8a0c6f",
                                        "glosses": [
                                            "Chemin ou sentier pratiqué en vue d’une pipée."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09673840-70fc-4aa0-a82c-77e62a904c34",
                                                "sense_id": "7c925f40-fae5-39ee-87c1-925d53a92717",
                                                "text": "Quand les perches vivantes qu'on veut faire servir sont trop grosses pour être inclinées dans l’avenue, on leur donne un léger coup de serpe à la hauteur de 3 à 4 pieds et demi, ce qui donne la facilité de les abaisser. Si on n’a pas de perches voisines de l’avenue qu'on puisse plier, on emploie les branches qu'on a coupées, soit sur l'arbre de pipée, soit pour former les allées, et on les fixe solidement en terre, en leur donnant toujours une certaine inclinaison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a10756f-1131-3f2b-bfe7-810288c42de7",
                                        "entry_id": "52f058be-c173-3d16-91dc-5b391f8a0c6f",
                                        "glosses": [
                                            "Moyen qui conduit à un but."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9437e425-b42d-4784-88ef-e7b696c33d26",
                                                "sense_id": "9a10756f-1131-3f2b-bfe7-810288c42de7",
                                                "text": "Cette année-là, nos relations n’allèrent pas beaucoup plus loin : une ou deux chasses où M. de Bray me pria de prendre part, quelques visites reçues ou rendues, et qui me firent mieux connaître les chemins de son village qu’elles ne m’ouvrirent les avenues discrètes de son amitié."
                                            },
                                            {
                                                "example_id": "6006f6c6-d931-404e-b3f8-1be8ae29a0db",
                                                "sense_id": "9a10756f-1131-3f2b-bfe7-810288c42de7",
                                                "text": "Échanger avec ses supérieurs, non selon le mode de la soumission, de la séduction ou de la révolte, mais dans une perspective d’entraide et de solidarité, représente une autre avenue de la connaissance de soi."
                                            },
                                            {
                                                "example_id": "d2ddf1cc-9994-4c85-b44b-4eca9fd112c7",
                                                "sense_id": "9a10756f-1131-3f2b-bfe7-810288c42de7",
                                                "text": "Le biochar, charbon produit par pyrolyse et utilisé comme amendement, présente plusieurs avantages et s’avère une avenue prometteuse pour une agriculture durable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "avenue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0093538e-41dc-3b79-9f3a-41dda433029d",
                                        "entry_id": "e22e107f-8bf5-388c-9a66-133f03d870d7",
                                        "glosses": [
                                            "Féminin singulier de avenu."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
