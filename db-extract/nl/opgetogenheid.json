                                        "sense_id": "f2956160-daae-3a49-a1bc-71f0ea733839",
                                        "entry_id": "869f1663-f7c4-32d3-b9f2-2f609131a941",
                                        "glosses": [
                                            "A feeling of joy and pride."
                                        ],
                                        "tags": [
