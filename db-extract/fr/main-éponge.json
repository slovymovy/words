                        "examples": [
                            {
                                "example_id": "57517a85-d71f-4080-9854-3abbcef926c4",
                                "sense_id": "aa7e2a8e-035d-372a-bbff-26a745ffc703",
                                "text": "Il humecta une main-éponge, se baigna le visage, et s’observa un instant, dans la glace."
                            },
                            {
                                "example_id": "047563ea-23f2-4e3c-9a2b-b6515a18f937",
                                "sense_id": "aa7e2a8e-035d-372a-bbff-26a745ffc703",
                                "text": "Dévêtue, Roma a posé, dans son bain, juste sa boîte à savon, le thermomètre supporté par une gaine en bois (mais il ne fonctionne plus), des mains-éponges, des pierres ponce, diverses brosses, souvent un sucre insubmersible, farce offerte à Roma petite par son père."
                            },
                            {
                                "example_id": "94c86207-7026-4cc8-92b6-08feaab5d31c",
                                "sense_id": "aa7e2a8e-035d-372a-bbff-26a745ffc703",
                                "text": "Laurence chercha une main-éponge propre dans un petit sac."
                            }
                        ]
