                            },
                            {
                                "target_lang_word": "истлевание",
                                "target_lang_sense_clarification": "медленный распад растительных остатков, превращение в тлен"
                            },
                            {
                                "target_lang_word": "прение",
                                "target_lang_sense_clarification": "разложение влажной растительной массы"
                            },
                            {
                                "target_lang_word": "трухлявление",
                                "target_lang_sense_clarification": "разрушение древесины с превращением в труху"
                            }
                        ]
