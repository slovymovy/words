                {
                    "sense_id": "64ba68b5-19c6-3f54-8221-5fd606c13031",
                    "sense_definition": "A piece of popcorn.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "food_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He threw a few <w>popcorns</w> into the air and tried to catch them in his mouth.",
                            "target_lang_translations": {
                                "ru": "Он подбросил несколько <w>зерен попкорна</w> в воздух и попытался поймать их ртом.",
                                "zh": "他往空中扔了几<w>粒</w>爆米花，并试图用嘴接住。",
                                "es": "Lanzó unas cuantas <w>palomitas</w> al aire e intentó atraparlas con la boca."
                            }
                        },
                        {
                            "text": "I found a stale <w>popcorn</w> under the sofa cushion.",
                            "target_lang_translations": {
                                "ru": "Я нашел черствое <w>зерно попкорна</w> под диванной подушкой.",
                                "zh": "我在沙发垫下发现了一<w>粒</w>变质的爆米花。",
                                "es": "Encontré una <w>palomita</w> vieja debajo del cojín del sofá."
                            }
