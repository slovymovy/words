                    },
                    {
                        "translation_id": "bf1e4296-2eab-47c3-8ebf-2fc854d43e05",
                        "source_entry_id": "51063060-6507-3481-9e5a-51ac4aedd20a",
                        "source_sense_description": "of, relating to, consisting of, or resembling a cell or cells",
                        "target_lang_word": "zellulär",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zellulär",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ee4bb93-9928-317f-bf74-76aaa2ea171a",
                                        "entry_id": "4cb7f328-b3cb-3b89-8ecb-d826cb7358a5",
                                        "glosses": [
                                            "auf die kleinste lebende Einheit im Körper (eine Zelle)/Zellen bezogen, von der Art einer Zelle, durch Zellen vermittelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce820ce7-3cfa-4281-870b-3b21f672d3cc",
                                                "sense_id": "1ee4bb93-9928-317f-bf74-76aaa2ea171a",
                                                "text": "Die zelluläre Immunantwort erfolgt durch Zellen, vor allem durch T-Lymphozyten, die weißen Blutkörperchen."
                                            },
                                            {
                                                "example_id": "019b59a8-e3f9-4b42-9003-f37154c42d9f",
                                                "sense_id": "1ee4bb93-9928-317f-bf74-76aaa2ea171a",
                                                "text": "„Abb. 3: Schematische Darstellung der zellulären Vorgänge, die von der Phagocytose und intrazellulären Verarbeitung von Antigen (links) bis zur Antikörperbildung (rechts oben) ablaufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5a1abe4f-8612-3b38-b8df-8b9279bf1176",
                                        "entry_id": "4cb7f328-b3cb-3b89-8ecb-d826cb7358a5",
                                        "glosses": [
                                            "aus Zellen bestehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d935cfb-fbd0-407c-a20a-d7263e466dd6",
                                                "sense_id": "5a1abe4f-8612-3b38-b8df-8b9279bf1176",
                                                "text": "„Da sie des Weiteren keine zelluläre Struktur und damit eigenen Metabolismus besitzen, sind für sie Wirtszellen zur eigenen Vermehrung essentiell. Als Wirte kommen für sie Tiere, Pflanzen, Menschen und sogar Bakterien in Frage.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
