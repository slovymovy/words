                "senses": [
                    {
                        "sense_id": "6d44c6f4-f44d-3bf6-ac98-5658f5f65c90",
                        "entry_id": "14f1e66e-433a-363a-9343-6a0c8b8b2a3e",
                        "glosses": [
                            "Réservoir, pour les liquides ou aussi pour les autres substances en vrac."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e8d2fd9-24ee-43b7-8597-d10696d4f9e6",
                                "sense_id": "6d44c6f4-f44d-3bf6-ac98-5658f5f65c90",
                                "text": "Wir müssen Wasser sparen: Wegen der anhaltenden Dürre sind die Reservoirs fast leer.",
                                "translation": "Nous devons économiser l’eau : en raison de la sécheresse persistante, les réservoirs sont presque vides."
                            },
                            {
                                "example_id": "d79671ee-6980-4792-adf9-cc989634d2ce",
                                "sense_id": "6d44c6f4-f44d-3bf6-ac98-5658f5f65c90",
                                "text": "Zentralschmierung - ein Schmierstoff-Reservoir für 1 bis 35 Schmierstellen.",
                                "translation": "Lubrification centralisée – un réservoir de lubrifiant pour 1 à 35 points de graissage."
                            }
                        ]
                    }
                ],
