                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "ac19b8e6-1377-4a60-98c5-cdb26c79d791",
                                "sense_id": "d64cac77-b012-3970-82ed-d3518aea8802",
                                "text": "Laughing, Ms. Vanderbilt said: “I have two very WASPy friends who are quite disapproving. One of them said, ‘I think it’s going to ruin your reputation.’"
                            },
                            {
                                "example_id": "e8dc8a50-4e0f-4831-a2d3-1fdbb397bf70",
                                "sense_id": "d64cac77-b012-3970-82ed-d3518aea8802",
                                "text": "She was the kind of Wasp-y pretty I desperately wanted to be – the type of beauty that provoked starry-eyed crushes instead of ass slaps."
                            }
                        ]
                    }
