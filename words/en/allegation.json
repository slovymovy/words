{
    "word_family": [
        "allege",
        "alleged",
        "allegedly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4ed3f80d-67ce-3a15-9fd0-b04b30fb0a84",
                    "sense_definition": "A statement or claim that someone has done something wrong or illegal, typically one made without proof.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "accusation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police are investigating a serious <w>allegation</w> of fraud against the company director.",
                            "target_lang_translations": {
                                "ru": "Полиция расследует серьезное <w>обвинение</w> в мошенничестве против директора компании."
                            }
                        },
                        {
                            "text": "She decided to deny the <w>allegation</w> immediately during the press conference.",
                            "target_lang_translations": {
                                "ru": "Она решила немедленно опровергнуть <w>обвинение</w> во время пресс-конференции."
                            }
                        }
                    ],
                    "synonyms": [
                        "accusation",
                        "assertion",
                        "charge"
                    ],
                    "common_phrases": [
                        "deny the allegation",
                        "serious allegation",
                        "false allegation",
                        "unfounded allegation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заявление или утверждение о том, что кто-то совершил что-то неправильное или незаконное, обычно сделанное без доказательств."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обвинение",
                                "target_lang_sense_clarification": "приписывание кому-либо вины или проступка"
                            },
                            {
                                "target_lang_word": "утверждение",
                                "target_lang_sense_clarification": "голословное заявление о чьей-либо вине"
                            },
                            {
                                "target_lang_word": "заявление",
                                "target_lang_sense_clarification": "сообщение о правонарушении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "311e63df-ae43-306e-b013-427743f534e0",
                    "sense_definition": "The formal act of <w>allege</w> or asserting something as a fact in a legal context.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "accusation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>allegation</w> of these facts must be supported by physical evidence in court.",
                            "target_lang_translations": {
                                "ru": "<w>Утверждение</w> этих фактов должно быть подкреплено вещественными доказательствами в суде."
                            }
                        },
                        {
                            "text": "The lawyer focused on the <w>allegation</w> of misconduct to build his defense strategy.",
                            "target_lang_translations": {
                                "ru": "Адвокат сосредоточился на <w>заявлении</w> о неправомерных действиях, чтобы выстроить стратегию защиты."
                            }
                        }
                    ],
                    "synonyms": [
                        "assertion",
                        "impeachment"
                    ],
                    "common_phrases": [
                        "formal allegation",
                        "legal allegation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное заявление или утверждение чего-либо как факта в юридическом контексте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заявление",
                                "target_lang_sense_clarification": "официальное утверждение фактов в суде"
                            },
                            {
                                "target_lang_word": "обвинение",
                                "target_lang_sense_clarification": "юридический акт предъявления претензий"
                            },
                            {
                                "target_lang_word": "утверждение",
                                "target_lang_sense_clarification": "изложение фактов в правовом споре"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}