                "senses": [
                    {
                        "sense_id": "cd0e3475-7f88-32ed-b935-b821e4bed462",
                        "entry_id": "6273aa46-b1d4-30ac-844e-31675d2096af",
                        "glosses": [
                            "A food additive made from a purified extract of red seaweed, commonly used as a thickening agent."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30342b04-e9b8-4415-8001-60d4f91de0d0",
                        "source_entry_id": "6273aa46-b1d4-30ac-844e-31675d2096af",
                        "source_sense_id": "cd0e3475-7f88-32ed-b935-b821e4bed462",
                        "source_sense_description": "Food additive made from extract of red seaweed",
                        "target_lang_word": "carraghénane",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carraghénane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6d745a24-419d-3c02-8b39-cdf9caae1ce5",
                                        "entry_id": "83b9b1e0-7a43-33f7-8ffd-502b05161cce",
                                        "glosses": [
                                            "Groupe de plusieurs polysaccharides extraits de différentes algues et utilisé comme épaississant par l’industrie alimentaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8f548c8-6625-42df-8fd3-80fd10e235a3",
                                                "sense_id": "6d745a24-419d-3c02-8b39-cdf9caae1ce5",
                                                "text": "Les carraghénanes sont des substances extraites de la paroi des Rhodobiontes (Végétaux Rouges) de l’ordre des Gigartinales et des Cryptonémiales."
                                            },
                                            {
                                                "example_id": "91c7ffb0-362c-4db6-aecb-d3f37a361c30",
                                                "sense_id": "6d745a24-419d-3c02-8b39-cdf9caae1ce5",
                                                "text": "Il est composé d’amidons, de gélifiants, de galactomannane (fibre végétale) et de carraghénane (extrait d’algue rouge), qui apparaissent dans la liste des ingrédients sous le dénominations « E410 », « E412 », « E417 » ou « E407 ». — (« Analogue (fromage) : Des fils à la pâte », Malbouffe, le dico, Les Dossiers du Canard enchaîné nᵒ 147, avril 2018, page 9)"
                                            },
                                            {
                                                "example_id": "21fe65f6-2beb-4e21-9e5d-2c238c5f06ef",
                                                "sense_id": "6d745a24-419d-3c02-8b39-cdf9caae1ce5",
                                                "text": "Les extraits d’algues, en particulier les carraghénanes, sont utilisés comme épaississants ou gélifiants dans les desserts lactés, les soupes, les glaces pour ne nommer que ceux-là."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4126539-a738-4316-96f0-7ba3e0cc1ece",
                        "source_entry_id": "6273aa46-b1d4-30ac-844e-31675d2096af",
                        "source_sense_id": "cd0e3475-7f88-32ed-b935-b821e4bed462",
                        "source_sense_description": "Food additive made from extract of red seaweed",
                        "target_lang_word": "Carrageen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Carrageen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23a33df6-5ee7-32da-8833-b6a487645656",
                                        "entry_id": "43183faf-fdf4-3de3-88e8-0c99f3dde8fc",
                                        "glosses": [
                                            "aus der getrockneten Rotalge Chondrus crispus gewonnener Rohstoff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c49220dd-4e2f-4958-a198-1dc160114ea3",
                                                "sense_id": "23a33df6-5ee7-32da-8833-b6a487645656",
                                                "text": "„Das wichtigste Algenprodukt ist das aus Rotalgen gewonnene Carrageen.“"
                                            },
                                            {
                                                "example_id": "afe3953f-b5b1-4c7c-87ef-f9be26730801",
                                                "sense_id": "23a33df6-5ee7-32da-8833-b6a487645656",
                                                "text": "„Carrageen ist ein Gemisch unverzweigter Polysaccharide, die aus teilweise sulfatveresterten D-Galactose- und 3,6-Dehydrogalactoseresten bestehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
