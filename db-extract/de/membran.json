                ],
                "senses": [
                    {
                        "sense_id": "3e4a1a33-10ee-309a-a676-76fe0e90a516",
                        "entry_id": "1a258b44-5c37-3b93-965c-699ec7fd02d4",
                        "glosses": [
                            "dünne Trennschicht"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "64ee17d9-fc95-4920-b5ad-9a0ce9145c82",
                                "sense_id": "3e4a1a33-10ee-309a-a676-76fe0e90a516",
                                "text": "Die Lösung wird durch eine Membran gefiltert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ed5026bf-ce8c-304e-a936-bd528525b769",
                        "entry_id": "1a258b44-5c37-3b93-965c-699ec7fd02d4",
                        "glosses": [
                            "dünne, aus Lipiden bestehende Schicht, die Zellkompartimente abgrenzt"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "505a6343-6c8c-40f4-bc50-1d18fc0710fd",
                                "sense_id": "ed5026bf-ce8c-304e-a936-bd528525b769",
                                "text": "An der Membran einer Zelle finden wichtige biochemische Reaktionen statt."
                            },
                            {
                                "example_id": "34332bfe-4da4-4d4c-812d-226cea68774e",
                                "sense_id": "ed5026bf-ce8c-304e-a936-bd528525b769",
                                "text": "„Zellen sind wie mikroskopisch kleine Blasen, umhüllt von speziellen Membranen, die sie vor der Außenwelt schützen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "d6325a1a-adc0-3339-ae7e-b3b9b53b69ae",
                        "entry_id": "1a258b44-5c37-3b93-965c-699ec7fd02d4",
                        "glosses": [
                            "biaxial gespannte Fläche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fbf89b1-f9a2-4cdb-954e-858f3f522ae3",
                                "sense_id": "d6325a1a-adc0-3339-ae7e-b3b9b53b69ae",
                                "text": "Über den Rahmen wird eine Membran gespannt, und schon haben wir eine Trommel."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bb210a24-ccd8-433b-a7b7-94fd462ad0fb",
                        "source_entry_id": "1a258b44-5c37-3b93-965c-699ec7fd02d4",
                        "source_sense_id": "3e4a1a33-10ee-309a-a676-76fe0e90a516",
                        "source_sense_description": "allgemein: dünne Trennschicht",
                        "target_lang_word": "membrane",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "membrane",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ddd4cace-4c47-3937-991b-e69624723506",
                                        "entry_id": "27a54d56-5945-38ed-8fd2-f160963a3ab0",
                                        "glosses": [
                                            "A flexible enclosing or separating tissue forming a plane or film and separating two environments.",
                                            "A mechanical, thin, flat flexible part that can deform or vibrate when excited by an external force."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0ea349a1-460f-346c-ab53-450a11d28677",
                                        "entry_id": "27a54d56-5945-38ed-8fd2-f160963a3ab0",
                                        "glosses": [
                                            "A flexible enclosing or separating tissue forming a plane or film and separating two environments.",
                                            "A flexible or semiflexible covering or waterproofing whose primary function is to exclude water."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88e83424-a685-445f-bd54-2b323fd57376",
                                                "sense_id": "0ea349a1-460f-346c-ab53-450a11d28677",
                                                "text": "Then they backed the membrane with a gel matrix containing a perfluorocarbon (PFC) propellant and fluorescent \"nanobullets\" about a micron wide, and hit it with ultrasound."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00e69636-0303-322d-add1-b5b4e1a6753d",
                                        "entry_id": "27a54d56-5945-38ed-8fd2-f160963a3ab0",
                                        "glosses": [
                                            "A flexible enclosing or separating tissue forming a plane or film and separating two environments.",
                                            "A microscopic double layer of lipids and proteins forming the boundary of cells or organelles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "382dc958-3eb4-35a9-99c8-6b4685f6ef11",
                                        "entry_id": "27a54d56-5945-38ed-8fd2-f160963a3ab0",
                                        "glosses": [
                                            "A piece of parchment forming part of a roll."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c3d9096-5d6d-4387-b39e-34d92fe3a866",
                        "source_entry_id": "1a258b44-5c37-3b93-965c-699ec7fd02d4",
                        "source_sense_id": "3e4a1a33-10ee-309a-a676-76fe0e90a516",
                        "source_sense_description": "allgemein: dünne Trennschicht",
                        "target_lang_word": "membrane",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "membrane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d5b57da3-bde1-3e18-8de7-fd624c207a1b",
                                        "entry_id": "b5789cae-7a7c-3323-9bc8-8910300bc361",
                                        "glosses": [
                                            "Tissu organique animal servant à former, envelopper, séparer ou tapisser des cellules ou des organes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7335a13-c6a2-49d7-91c8-4d60a56e25b7",
                                                "sense_id": "d5b57da3-bde1-3e18-8de7-fd624c207a1b",
                                                "text": "Enfin, il faut noter qu’une sonde fluorescente peut pénétrer par des mécanismes différents selon le règne cellulaire considéré : ainsi le jaune Lucifer (Lucifer Yellow) déclaré imperméant aux membranes animales est en fait transporté activement par une membrane de cellule végétale (Cole et al, 1991)."
                                            },
                                            {
                                                "example_id": "9dd51f64-d81d-46cb-930a-36b204d4f465",
                                                "sense_id": "d5b57da3-bde1-3e18-8de7-fd624c207a1b",
                                                "text": "On constate, en outre, que la chauve-souris peut voler malgré l’ablation d’une notable étendue de la membrane de ses ailes, pourvu que la partie restante corresponde aux espaces interdigitaux."
                                            },
                                            {
                                                "example_id": "2480b86f-d86a-4f02-ab39-63b9898d3e0f",
                                                "sense_id": "d5b57da3-bde1-3e18-8de7-fd624c207a1b",
                                                "text": "Dans l'état de vacuité, la membrane muqueuse de l’estomac est d'une couleur grisâtre. Au moment où les aliments s’accumulent dans le réservoir gastrique, cette membrane devient rose, […]."
                                            },
                                            {
                                                "example_id": "ce634756-0daf-438b-8748-8057fb147a67",
                                                "sense_id": "d5b57da3-bde1-3e18-8de7-fd624c207a1b",
                                                "text": "La membrane plasmique de la cellule végétale est doublée extérieurement d’une paroi cellulosique qui devient rigide au terme de la différenciation cellulaire ; les cellules végétales ont donc une forme définie.^([1])"
                                            },
                                            {
                                                "example_id": "e2a956bc-60dc-4cf1-b571-a7c12c38d5d6",
                                                "sense_id": "d5b57da3-bde1-3e18-8de7-fd624c207a1b",
                                                "text": "Fausse membrane, tissu qui se forme quelquefois à la surface des membranes muqueuses et séreuses lorsqu’elles sont enflammées."
                                            },
                                            {
                                                "example_id": "ddbba517-e1b8-42a3-8911-8a6263e19a42",
                                                "sense_id": "d5b57da3-bde1-3e18-8de7-fd624c207a1b",
                                                "text": "Dans le croup il se forme une fausse membrane qui obstrue les voies respiratoires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13e6956f-ef5c-30ab-8fb6-508c2327f30d",
                                        "entry_id": "b5789cae-7a7c-3323-9bc8-8910300bc361",
                                        "glosses": [
                                            "Enveloppe de certaines parties d’une plante."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c4a3b95-fd32-4a2e-b84c-93744700c783",
                                                "sense_id": "13e6956f-ef5c-30ab-8fb6-508c2327f30d",
                                                "text": "La membrane d’une tige."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1d30a8c-b2ae-3c0a-8a92-6502fd39af36",
                                        "entry_id": "b5789cae-7a7c-3323-9bc8-8910300bc361",
                                        "glosses": [
                                            "la membrane vibrante d’un haut-parleur, d’un instrument de musique — tambour, timbale, etc."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ab9541ad-ea86-306b-a6cd-30aca8a3abb2",
                                        "entry_id": "b5789cae-7a7c-3323-9bc8-8910300bc361",
                                        "glosses": [
                                            "Planchettes qui se placent en dessus et en dessous d’une pile de cahiers que l’on met en presse."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa41872c-0360-44a0-a3d2-dbbaf7617cb3",
