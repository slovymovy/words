        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7cc25d4e-ce72-385a-b109-5034134635c4",
                    "sense_definition": "Mentally ill or unable to think clearly, often in a way that is dangerous or wild.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police were called to handle a <w>deranged</w> individual who was shouting at passersby in the park.",
                            "target_lang_translations": {
                                "ru": "Полицию вызвали, чтобы разобраться с <w>безумным</w> человеком, который кричал на прохожих в парке."
                            }
                        },
                        {
                            "text": "After weeks of isolation, he began to exhibit <w>deranged</w> behavior that worried his family.",
                            "target_lang_translations": {
                                "ru": "После нескольких недель изоляции он начал проявлять <w>ненормальное</w> поведение, которое обеспокоило его семью."
                            }
                        }
                    ],
                    "synonyms": [
                        "insane",
                        "mad",
                        "unbalanced",
                        "demented"
                    ],
                    "antonyms": [
