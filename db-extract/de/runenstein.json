                ],
                "senses": [
                    {
                        "sense_id": "1112ad54-7ace-3c71-8e56-c1101b8bfdb8",
                        "entry_id": "065e3819-2dd1-3c33-95c9-d1b3f4ee7d2a",
                        "glosses": [
                            "(großer) aufrecht stehender Stein mit Runeninschrift"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4112d251-0f46-4366-96ca-79ad6710cc35",
                                "sense_id": "1112ad54-7ace-3c71-8e56-c1101b8bfdb8",
                                "text": "„Die Wikinger hinterlassen Tausende von Runensteinen - Findlinge mit Ornamenten und eingeritzten Zeichen, die nur wenige von ihnen lesen können - und verbreiten Zeichen auf ihren Reisen in der ihnen bekannten Welt, von Grönland bis Griechenland, von Russland bis Island (…).“"
                            },
                            {
                                "example_id": "ee87b213-5f2b-43a5-b556-f82d93cc6e5d",
                                "sense_id": "1112ad54-7ace-3c71-8e56-c1101b8bfdb8",
                                "text": "„Die Denkmäler des älteren Futharks, besonders Abwehr- und Schutzrunen, sind häufig an Waffen, Amuletten, Gebrauchs- und Schmuckgegenständen, im Norden auch auf Felsen und Grabsteinen, sogenannten Runensteinen, aufgefunden worden.“"
                            },
                            {
                                "example_id": "ea7c2d75-cb52-4a0a-9e8a-6ff09adb8d81",
                                "sense_id": "1112ad54-7ace-3c71-8e56-c1101b8bfdb8",
                                "text": "„Welchen Teil der Steinkiste der Runenstein bildete, ließ sich nicht mehr ausmachen.“"
                            },
                            {
                                "example_id": "51136f9e-34e7-4877-bc5c-98c635a72643",
                                "sense_id": "1112ad54-7ace-3c71-8e56-c1101b8bfdb8",
                                "text": "„Der 4m hohe Runenstein von Björketorp, dessen Inschrift sich ausdrücklich als »Schadenprophezeiung« ankündigt, bildet mit zwei inschriftlosen eine Steinsetzung in Dreiecksform, die, noch heute am alten Platz stehend, ein eindrucksvolles Monument darstellt.“"
                            },
                            {
                                "example_id": "069aa6e4-f09c-4487-a3ca-a9a21dfee1ee",
                                "sense_id": "1112ad54-7ace-3c71-8e56-c1101b8bfdb8",
                                "text": "„Manche Wikinger rühmten auch sich selbst auf einem Runenstein - aus politischen Gründen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
