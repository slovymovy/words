                    {
                        "sense_id": "27151271-8a36-3f8e-9ea0-a747abd412fe",
                        "entry_id": "2089e526-263f-37dd-a5f1-58312dc88d5b",
                        "glosses": [
                            "Féminin singulier de rôdeur."
                        ],
