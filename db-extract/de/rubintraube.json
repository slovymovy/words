                "senses": [
                    {
                        "sense_id": "d09e11e1-2224-337e-af01-baf1d1b810d5",
                        "entry_id": "55163c86-f649-355d-9b48-edfe3ca59432",
                        "glosses": [
                            "sehr alte französische, farbstoffintensive, rote Rebsorte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dc876b4-a869-41da-b566-2d0d6091233b",
                                "sense_id": "d09e11e1-2224-337e-af01-baf1d1b810d5",
                                "text": "„Nie reifte da eine Rubintraube und nie strömte aus ihr der Göttersaft, der süße Wein, in den gelben Becher!“"
                            },
                            {
                                "example_id": "9190795e-922a-4400-87ba-f0a27139e739",
                                "sense_id": "d09e11e1-2224-337e-af01-baf1d1b810d5",
                                "text": "„[…] und besonders trauert er den Reben am Rhein nach: „Bacchus kennt diese Gegend nicht; seit der Schöpfung ward hier kein Thyrsusstab geschwungen, kein Bacchanal gefeiert; nie rötet da die Oktobersonne eine Rubintraube, […]“"
                            },
                            {
                                "example_id": "008c35c1-bab7-4312-a29e-3e756cf0a0ea",
                                "sense_id": "d09e11e1-2224-337e-af01-baf1d1b810d5",
                                "text": "Farbstoffintensive Rebsorten wie die Rubintraube werden häufig zu Deckrotweinen verarbeitet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
