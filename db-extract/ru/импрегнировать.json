                                                "sense_id": "41e37b2c-8f37-30ec-81c5-996691a4b209",
                                                "text": "To Tartarize, ta²r'ta⁴r-i¹ze, v. a.\n To impregnate with tartar."
                                            },
                                            {
                                                "example_id": "5dd6690b-cc94-45c5-b564-4076b6de931a",
                                                "sense_id": "41e37b2c-8f37-30ec-81c5-996691a4b209",
                                                "text": "We find those charæ which secrete the largest quantity of calcareous matter in their stems to abound near springs impregnated with carbonate of lime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a696e93e-fac4-30c9-8a56-0df688b93e96",
                                        "entry_id": "fccbed81-a8c5-3111-a637-ba9bd30bdf08",
                                        "glosses": [
                                            "To fill pores or spaces with a substance."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "462b7252-2479-41b0-a38a-a71abdb3b495",
                                                "sense_id": "a696e93e-fac4-30c9-8a56-0df688b93e96",
                                                "text": "It takes a little time for the personal fatty acids to impregnate new shoes or boots, but from the scent point of view leather is a sponge, and the personal scent is left."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "209ee9cc-8766-33ec-b2e1-00b7cd455df1",
                                        "entry_id": "fccbed81-a8c5-3111-a637-ba9bd30bdf08",
                                        "glosses": [
                                            "To become pregnant."
                                        ],
                                        "tags": [
                                            "dated",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c259e49-98d2-45aa-abea-2ec471056cf2",
                                                "sense_id": "209ee9cc-8766-33ec-b2e1-00b7cd455df1",
                                                "text": "Were they, like Spanish Jennets, to impregnate by the Wind, they could not have thought on a more proper Invention."
                                            }
                                        ]
                                    }
                                ]
