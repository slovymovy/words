{
    "word_family": [
        "supplier",
        "supplement",
        "supplementary",
        "supple",
        "suppleness"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1d7942b1-a544-3a8a-ac1d-5f3247ca4ff0",
                    "sense_definition": "To provide something or make it available for use.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "provide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local farm <w>supplies</w> fresh vegetables to the nearby grocery stores every morning.",
                            "target_lang_translations": {
                                "ru": "Местная ферма каждое утро <w>поставляет</w> свежие овощи в близлежащие продуктовые магазины."
                            }
                        },
                        {
                            "text": "The government promised to <w>supply</w> money for the war effort.",
                            "target_lang_translations": {
                                "ru": "Правительство пообещало <w>выделить</w> деньги на военные нужды."
                            }
                        }
                    ],
                    "common_phrases": [
                        "supply money for"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять что-либо или делать это доступным для использования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поставлять",
                                "target_lang_sense_clarification": "снабжать товарами или услугами"
                            },
                            {
                                "target_lang_word": "снабжать",
                                "target_lang_sense_clarification": "обеспечивать необходимым"
                            },
                            {
                                "target_lang_word": "предоставлять",
                                "target_lang_sense_clarification": "давать в пользование"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c03653a-4269-3177-8bea-6c8abddb8096",
                    "sense_definition": "To furnish or equip someone or something with necessary items.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "provide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The army must <w>supply</w> soldiers with ammunition before they head to the front lines.",
                            "target_lang_translations": {
                                "ru": "Армия должна <w>снабдить</w> солдат боеприпасами перед тем, как они отправятся на передовую."
                            }
                        },
                        {
                            "text": "It is necessary to <w>supply</w> a furnace with fuel to keep the house warm.",
                            "target_lang_translations": {
                                "ru": "Необходимо <w>обеспечивать</w> печь топливом, чтобы в доме было тепло."
                            }
                        }
                    ],
                    "common_phrases": [
                        "supply with ammunition",
                        "supply with fuel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Снабжать или оснащать кого-либо или что-либо необходимыми предметами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снабжать",
                                "target_lang_sense_clarification": "обеспечивать ресурсами"
                            },
                            {
                                "target_lang_word": "снаряжать",
                                "target_lang_sense_clarification": "подготавливать, выдавая экипировку"
                            },
                            {
                                "target_lang_word": "оснащать",
                                "target_lang_sense_clarification": "оборудовать технически"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2dd99e9-98d1-3e98-926a-680f5f6be144",
                    "sense_definition": "To fill up or keep full by providing a continuous flow.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "replenish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Large rivers are <w>supplied</w> by smaller streams that flow down from the mountains.",
                            "target_lang_translations": {
                                "ru": "Большие реки <w>питаются</w> более мелкими ручьями, стекающими с гор."
                            }
                        },
                        {
                            "text": "The reservoir is <w>supplied</w> by rainwater collected during the winter months.",
                            "target_lang_translations": {
                                "ru": "Резервуар <w>наполняется</w> дождевой водой, собранной в зимние месяцы."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заполнять или поддерживать наполненным путем обеспечения непрерывного потока."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "питать",
                                "target_lang_sense_clarification": "о водоемах или системах"
                            },
                            {
                                "target_lang_word": "наполнять",
                                "target_lang_sense_clarification": "обеспечивать приток"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3fb381d-323b-3e44-a0db-f98da932f63c",
                    "sense_definition": "To compensate for or make up for a deficiency or lack.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "compensate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He worked hard to <w>supply</w> the defect in his education by reading extensively.",
                            "target_lang_translations": {
                                "ru": "Он много работал, чтобы <w>восполнить</w> пробелы в своем образовании, много читая."
                            }
                        },
                        {
                            "text": "The new evidence helped to <w>supply</w> the missing pieces of the investigation.",
                            "target_lang_translations": {
                                "ru": "Новые улики помогли <w>восстановить</w> недостающие детали расследования."
                            }
                        }
                    ],
                    "synonyms": [
                        "fulfill"
                    ],
                    "common_phrases": [
                        "supply the defect"
                    ],
                    "target_lang_definitions": {
                        "ru": "Компенсировать или восполнять недостаток или нехватку чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восполнять",
                                "target_lang_sense_clarification": "устранять пробел или недостаток"
                            },
                            {
                                "target_lang_word": "пополнять",
                                "target_lang_sense_clarification": "добавлять недостающее"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30eaf17b-bbb8-3b27-a2a4-e5bf412ac9b0",
                    "sense_definition": "To serve instead of or take the place of something else.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "substitute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The evening star appeared to <w>supply</w> the light of the absent sun.",
                            "target_lang_translations": {
                                "ru": "Вечерняя звезда появилась, словно желая <w>заменить</w> свет зашедшего солнца."
                            }
                        },
                        {
                            "text": "In the absence of a proper tool, a heavy stone had to <w>supply</w> its place.",
                            "target_lang_translations": {
                                "ru": "За отсутствием подходящего инструмента, его место пришлось <w>занять</w> тяжелому камню."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "often used in literary or poetic contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Служить вместо чего-либо или занимать место чего-либо другого."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заменять",
                                "target_lang_sense_clarification": "служить заменой"
                            },
                            {
                                "target_lang_word": "замещать",
                                "target_lang_sense_clarification": "выполнять функцию отсутствующего"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "06556aa3-ceb4-39fd-9565-8e2db6eda0ca",
                    "sense_definition": "An amount of something that is available for use.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A steady <w>supply</w> of good drinking water is essential for any healthy community.",
                            "target_lang_translations": {
                                "ru": "Постоянный <w>запас</w> хорошей питьевой воды необходим для любого здорового общества."
                            }
                        },
                        {
                            "text": "The store has a limited <w>supply</w> of the new gaming consoles in stock.",
                            "target_lang_translations": {
                                "ru": "В магазине имеется ограниченный <w>запас</w> новых игровых приставок."
                            }
                        }
                    ],
                    "common_phrases": [
                        "water supply",
                        "limited supply",
                        "steady supply"
                    ],
                    "target_lang_definitions": {
                        "ru": "Количество чего-либо, доступное для использования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запас",
                                "target_lang_sense_clarification": "накопленные ресурсы"
                            },
                            {
                                "target_lang_word": "ресурс",
                                "target_lang_sense_clarification": "источник чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8699f73-ccfd-39e7-9398-33437a7249fb",
                    "sense_definition": "The act or process of providing something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "act",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The basic economic principle of <w>supply</w> and demand determines the price of goods.",
                            "target_lang_translations": {
                                "ru": "Основной экономический принцип <w>предложения</w> и спроса определяет цену товаров."
                            }
                        },
                        {
                            "text": "The <w>supply</w> of electricity was interrupted during the heavy thunderstorm.",
                            "target_lang_translations": {
                                "ru": "<w>Подача</w> электроэнергии была прервана во время сильной грозы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "supply and demand"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс предоставления чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снабжение",
                                "target_lang_sense_clarification": "процесс обеспечения"
                            },
                            {
                                "target_lang_word": "поставка",
                                "target_lang_sense_clarification": "доставка товаров"
                            },
                            {
                                "target_lang_word": "предложение",
                                "target_lang_sense_clarification": "экономический термин (спрос и предложение)"
                            },
                            {
                                "target_lang_word": "подача",
                                "target_lang_sense_clarification": "например, электричества или воды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "faf427a3-9eda-3546-89d6-2d76e9b25bd6",
                    "sense_definition": "Necessary items or provisions, especially food and equipment.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers packed enough <w>supplies</w> to last for a week in the mountains.",
                            "target_lang_translations": {
                                "ru": "Пешие туристы упаковали достаточно <w>припасов</w>, чтобы их хватило на неделю в горах."
                            }
                        },
                        {
                            "text": "Medical <w>supplies</w> were flown into the disaster zone by the Red Cross.",
                            "target_lang_translations": {
                                "ru": "Медицинские <w>материалы</w> были доставлены в зону бедствия Красным Крестом."
                            }
                        }
                    ],
                    "synonyms": [
                        "provision"
                    ],
                    "common_phrases": [
                        "medical supplies",
                        "office supplies",
                        "school supplies"
                    ],
                    "target_lang_definitions": {
                        "ru": "Необходимые предметы или провизия, особенно еда и оборудование."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "припасы",
                                "target_lang_sense_clarification": "продовольствие и материалы"
                            },
                            {
                                "target_lang_word": "товары",
                                "target_lang_sense_clarification": "предметы потребления"
                            },
                            {
                                "target_lang_word": "принадлежности",
                                "target_lang_sense_clarification": "инструменты или материалы для дела"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b06736b-1f63-3c29-bb73-ee31f9d3a27e",
                    "sense_definition": "An amount of money provided by a government to meet national expenditures.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee met to vote <w>supplies</w> for the upcoming fiscal year.",
                            "target_lang_translations": {
                                "ru": "Комитет собрался, чтобы проголосовать за <w>ассигнования</w> на следующий финансовый год."
                            }
                        },
                        {
                            "text": "Parliament debated the allocation of <w>supplies</w> for the national defense budget.",
                            "target_lang_translations": {
                                "ru": "Парламент обсуждал распределение <w>средств</w> на бюджет национальной обороны."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vote supplies"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сумма денег, предоставляемая правительством для покрытия государственных расходов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ассигнования",
                                "target_lang_sense_clarification": "выделенные бюджетные средства"
                            },
                            {
                                "target_lang_word": "субсидии",
                                "target_lang_sense_clarification": "денежная помощь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b095d9cb-7553-3f26-bc68-3b1e81db83a2",
                    "sense_definition": "A person, such as a teacher or clergyman, who temporarily fills the place of another.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The school had to hire a <w>supply</w> teacher because the regular one was ill.",
                            "target_lang_translations": {
                                "ru": "Школе пришлось нанять <w>замещающего</w> учителя, так как постоянный заболел."
                            }
                        },
                        {
                            "text": "A <w>supply</w> priest was sent to the parish while the vicar was on leave.",
                            "target_lang_translations": {
                                "ru": "В приход был направлен <w>временный</w> священник, пока викарий был в отпуске."
                            }
                        }
                    ],
                    "common_phrases": [
                        "supply teacher"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек (например, учитель или священник), временно замещающий другого."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заменяющий",
                                "target_lang_sense_clarification": "временный сотрудник"
                            },
                            {
                                "target_lang_word": "сменщик",
                                "target_lang_sense_clarification": "тот, кто работает на подмене"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "694f38d3-d0a6-3c82-ae40-35800f83796b",
                    "sense_definition": "In a manner that is flexible or <w>supple</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gymnast moved <w>supply</w> across the floor, showing incredible flexibility.",
                            "target_lang_translations": {
                                "ru": "Гимнаст <w>гибко</w> двигался по полу, демонстрируя невероятную пластичность."
                            }
                        },
                        {
                            "text": "She bent <w>supply</w> to the movements of the pony as it climbed the bank.",
                            "target_lang_translations": {
                                "ru": "Она <w>податливо</w> изгибалась в такт движениям пони, когда тот взбирался на берег."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bent supply"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Гибко или податливо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гибко",
                                "target_lang_sense_clarification": "плавно и эластично"
                            },
                            {
                                "target_lang_word": "податливо",
                                "target_lang_sense_clarification": "легко изгибаясь"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}