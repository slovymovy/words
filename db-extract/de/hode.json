                "senses": [
                    {
                        "sense_id": "af8699f1-d3fc-3e4f-ac70-5ebc8811de13",
                        "entry_id": "7502f687-313f-318f-9cf8-d2f7d120fe33",
                        "glosses": [
                            "männliche Keimdrüse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3526762-9030-4033-8d4b-d3baaafc6b50",
                                "sense_id": "af8699f1-d3fc-3e4f-ac70-5ebc8811de13",
                                "text": "„Bald gehet die Wahrscheinlichkeit in Gewissheit über; die Geschwulst wird täglich minder und die Hode befindet sich bald ganz wieder im Normalstande.“"
                            },
                            {
                                "example_id": "53071279-a92e-41f9-9c50-4c5df956e40a",
                                "sense_id": "af8699f1-d3fc-3e4f-ac70-5ebc8811de13",
                                "text": "„Ebenso wie Spitzy verwirft auch Winternitz die Kastration, auch dann, wenn der Hode atrophisch ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
