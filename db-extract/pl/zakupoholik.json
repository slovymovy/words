                "senses": [
                    {
                        "sense_id": "0864c738-d501-3f9d-90b8-846d318ff967",
                        "entry_id": "d9b656e0-cb56-3084-96de-f845b82b4401",
                        "glosses": [
                            "osoba uzależniona od robienia zakupów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "201bde9d-752e-453c-9e29-f7c6862c02f8",
                                "sense_id": "0864c738-d501-3f9d-90b8-846d318ff967",
                                "text": "Zakupoholika zwykle nie popycha w nałóg żaden kryzys wewnętrzny (mąż zostawił, to kupuję na pocieszenie), ale wabik zewnętrzny. Hasło w mediach, opinia koleżanki, chwilowy snobizm. Mechanizm: zakupoholik nie może się obejść bez swojej zabawki, czy będzie to dwusetna para butów - co czasem graniczy z chorobą psychiczną, czy kolejny luks - drobiazg, co jest zdecydowanie bardziej powszechne"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f470328d-4a23-497e-94d8-50d7005934ef",
