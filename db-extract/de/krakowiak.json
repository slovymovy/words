                    },
                    {
                        "translation_id": "569aa142-769a-475e-9702-d1ddefb8a581",
                        "source_entry_id": "4f418652-eb7d-32d9-8ab8-eeca85e88e91",
                        "source_sense_id": "375c0211-e3ba-3876-ad9b-eac6687901c0",
                        "source_sense_description": "traditioneller polnischer Tanz",
                        "target_lang_word": "krakowiak",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "krakowiak",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e4fe426e-c2cc-3087-ad31-be301033141e",
                                        "entry_id": "90f6add0-3a2e-3462-a28f-f5516b4f1033",
                                        "glosses": [
                                            "Danse traditionnelle polonaise, généralement accompagnée de chants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "755fdadf-7768-4613-bc39-34dfcfe23222",
                                                "sense_id": "e4fe426e-c2cc-3087-ad31-be301033141e",
                                                "text": "La mazure ou mazurka, dans sa forme primitive et comme les gens du peuple la dansent, n’est qu’une espèce de krakowiak, seulement moins vive et moins sautillante."
                                            },
                                            {
                                                "example_id": "b0e48010-ec87-4edd-add8-0bbf40e45df5",
                                                "sense_id": "e4fe426e-c2cc-3087-ad31-be301033141e",
                                                "text": "La Mazurka, le Krakowiak et la Polonaise étaient les principales danses nationales du pays de Chopin. Il se servit des motifs d’un Krakowiak pour composer l’œuvre pareillement dénommée."
                                            },
                                            {
                                                "example_id": "3847b452-9a9c-4c15-aa47-27104e4d6b2d",
                                                "sense_id": "e4fe426e-c2cc-3087-ad31-be301033141e",
                                                "text": "Le dynamisme des mouvements et la richesse des costumes ont fait du Krakowiak une des danses polonaises les plus typiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74668e43-977f-396d-8b5b-f2b89a7789ae",
                                        "entry_id": "90f6add0-3a2e-3462-a28f-f5516b4f1033",
                                        "glosses": [
                                            "Genre musical à 2 temps basé sur cette danse, le plus souvent chanté, et proche de la polonaise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "656478bd-b43a-4eb1-8c35-c9bbce174fa0",
                                                "sense_id": "74668e43-977f-396d-8b5b-f2b89a7789ae",
                                                "text": "La krakowiak est une création spontanée des Polonais ; le nombre de ces chansons s’étend à l’infini, et beaucoup sont inspirées par l’amour …."
                                            },
                                            {
                                                "example_id": "aba752de-fcc6-4bdb-8d90-ee8862b63938",
                                                "sense_id": "74668e43-977f-396d-8b5b-f2b89a7789ae",
                                                "text": "On connaît encore de cet artiste un concerto en la mineur, avec accompagnement d’orchestre, exécuté par lui en 1841 à Varsovie, une fantaisie pour piano seul, une fantaisie en ré mineur sur des mazoureks et krakowiaks, une Marche pour piano seul, enfin une romance dédiée à Mᵐᵉ Pruszak."
                                            },
                                            {
                                                "example_id": "034de4ae-1244-4e7a-9372-646c193e7cc8",
                                                "sense_id": "74668e43-977f-396d-8b5b-f2b89a7789ae",
                                                "text": "Sauf exceptions notées, la polonaise et le krakowiak (traité en rondo par Chopin dans son op. 14 et dans le finale du Concerto op. 11) ont un accent fixe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
