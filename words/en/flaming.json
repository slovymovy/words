                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кричащий",
                                "target_lang_sense_clarification": "броский, чересчур яркий"
                            },
                            {
                                "target_lang_word": "вопиющий",
                                "target_lang_sense_clarification": "нескрываемый, явный"
                            },
                            {
                                "target_lang_word": "бросающийся в глаза",
                                "target_lang_sense_clarification": "привлекающий всеобщее внимание"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "efd2e23d-58db-3fbb-8ce7-66aca56f47e3",
                    "sense_definition": "An act of sending abusive, hostile, or vitriolic messages online.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "internet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The user received a harsh <w>flaming</w> after posting spam in the group forum.",
                            "target_lang_translations": {
                                "ru": "Пользователь подвергся жесткому <w>флеймингу</w> после публикации спама на форуме группы."
                            }
                        },
                        {
                            "text": "She decided to leave the platform to avoid another painful <w>flaming</w> by strangers.",
                            "target_lang_translations": {
                                "ru": "Она решила покинуть платформу, чтобы избежать очередной болезненной <w>травли</w> со стороны незнакомцев."
                            }
                        }
                    ],
                    "synonyms": [
                        "roasting",
                        "bashing"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Internet terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Публикация оскорбительных, враждебных или агрессивных сообщений в интернете (флейминг)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "флейминг",
                                "target_lang_sense_clarification": "сетевая травля или перепалка"
                            },
                            {
                                "target_lang_word": "травля",
                                "target_lang_sense_clarification": "агрессивные нападки в сети"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5775b82-ba1f-3df6-b41d-ce810f0bdd8e",
                    "sense_definition": "The act of subjecting something directly to fire or open flames.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "thermal_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Repeated <w>flamings</w> of the soil were required to eradicate all the weeds completely.",
                            "target_lang_translations": {
                                "ru": "Потребовались неоднократные <w>обжиги</w> почвы, чтобы полностью уничтожить все сорняки."
                            }
                        },
                        {
                            "text": "The procedure involved rapid <w>flaming</w> to clear unwanted organic residue.",
                            "target_lang_translations": {
                                "ru": "Процедура включала быстрое <w>опаливание</w> для удаления нежелательных органических остатков."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Термическая обработка поверхности прямым воздействием открытого огня."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обжиг",
                                "target_lang_sense_clarification": "обработка пламенем"
                            },
                            {
                                "target_lang_word": "опаливание",
                                "target_lang_sense_clarification": "воздействие огнем"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d99c6e8-bb7d-3727-94d4-2c128e4c1305",
                    "sense_definition": "The process of sterilizing an instrument by passing it through an open flame.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "thermal_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician performed <w>flaming</w> on the inoculation loop before transferring the bacteria.",
                            "target_lang_translations": {
                                "ru": "Лаборант провел <w>прокаливание</w> бактериологической петли перед переносом бактерий."
                            }
                        },
                        {
                            "text": "Proper laboratory technique requires <w>flaming</w> the neck of the test tube.",
                            "target_lang_translations": {
                                "ru": "Правильная лабораторная техника требует <w>фламбирования</w> горлышка пробирки."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стерилизация лабораторного инструмента путем прокаливания в пламени горелки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прокаливание",
                                "target_lang_sense_clarification": "стерилизация в пламени"
                            },
                            {
                                "target_lang_word": "фламбирование",
                                "target_lang_sense_clarification": "обработка инструмента пламенем"
                            }
                        ]
                    }
                }
            ]
        },
        {
