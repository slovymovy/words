                                                "sense_id": "0be1b014-8a24-352e-9bc6-69222d760246",
                                                "text": "The verdict of not guilty created a true furor in the courtroom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68a6fd5a-a33e-3126-9f7e-01c00877774f",
                                        "entry_id": "2a7ddb51-f9b3-3d98-87d8-90fd1643a3ea",
                                        "glosses": [
                                            "A state of intense excitement."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ce812cd-6ada-4e99-be92-0708fadfb868",
                                                "sense_id": "68a6fd5a-a33e-3126-9f7e-01c00877774f",
                                                "text": "The story of the princess's affair caused a furor among journalists."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8de9215-a9b2-4e16-898c-9a92a3abed11",
                        "source_entry_id": "d3ee9168-94c9-3a9c-b89a-7de342c8e665",
