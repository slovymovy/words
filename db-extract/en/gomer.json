                        "entry_id": "03773391-f416-34d5-9840-f5c4533d9dae",
                        "glosses": [
                            "The eldest son of Japheth. Equivalent to the Cimmerians."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d15d3f34-99b8-4027-b922-e1707a3f2a75",
                                "sense_id": "1337f855-f4d9-334f-ace1-48df672b32c6",
                                "text": "The sons of Japheth; Gomer, and Magog, and Madai, and Javan, and Tubal, and Meshech, and Tiras."
                            }
                        ]
                    }
                ],
