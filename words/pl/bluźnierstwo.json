                },
                {
                    "sense_id": "d8a78716-4a0d-3f5c-81c1-ecfb3eedc674",
                    "sense_definition": "wulgarny, obraźliwy lub gwałtowny wyraz; przekleństwo",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "jezykowe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gdy uderzył się w palec, zaczął bez opamiętania miotać głośne <w>bluźnierstwa</w>.",
                            "target_lang_translations": {
                                "ru": "Ударив палец, он принялся безудержно выкрикивать громкие <w>ругательства</w>."
