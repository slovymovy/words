                                "example_id": "37ccb517-a057-43ee-87c5-d3726a0a3d23",
                                "sense_id": "78e715d3-8cb4-3b24-9d47-088315939819",
                                "text": "Kobieta trzymała w klatce jakieś ptaszysko, które pokrzykiwało, całkowicie zagłuszając jej mowę."
                            },
                            {
                                "example_id": "207b207a-10a6-435e-b0d0-ae8dc4b70920",
                                "sense_id": "78e715d3-8cb4-3b24-9d47-088315939819",
                                "text": "Książę trochę opierzył głuszca, ale ptaszysko uciekło."
                            }
                        ],
