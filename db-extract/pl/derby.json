                                        "glosses": [
                                            "Course hippique réservée aux chevaux de trois ans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25c93e9e-52c7-40bc-9bfb-a8bb199052cf",
                                                "sense_id": "fc121c7b-c47b-3198-8be0-0c17eb4d7b4b",
                                                "text": "Un cheval de derby, un excellent cheval de course."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8679569-0121-3174-b475-e80a2b675156",
                                        "entry_id": "6fd1bc2f-e368-3f03-bfd1-8affceba906f",
                                        "glosses": [
                                            "Match entre deux villes proches géographiquement (ou deux équipes de la même ville)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd6d33da-c8d0-4228-9e7c-161cc532c65f",
                                                "sense_id": "e8679569-0121-3174-b475-e80a2b675156",
                                                "text": "Le derby mancunien entre City et United a largement tourné à l’avantage des Cityzens (6-3)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5182f48c-48f7-3f09-9d40-cee141ec05a9",
                                        "entry_id": "6fd1bc2f-e368-3f03-bfd1-8affceba906f",
                                        "glosses": [
                                            "Chaussure basse ou montante dont les quartiers sont assemblés sur la claque de manière à faciliter la chausse, et se lacent sur le cou-de-pied."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4829cfe-c438-4b21-8166-b3d336a6881f",
                                                "sense_id": "5182f48c-48f7-3f09-9d40-cee141ec05a9",
                                                "text": "Aux pieds l’élégant aura des derbys ou des richelieux, bouts fleuris ou non."
                                            },
                                            {
                                                "example_id": "1b3c99d8-a390-4d98-a968-2fc0ec7d45e4",
                                                "sense_id": "5182f48c-48f7-3f09-9d40-cee141ec05a9",
                                                "text": "La collection estivale Hugo & Enzo présente des derbies, des richelieux ou des mocassins aux lignes aussi épurées que les chaussures féminines."
                                            },
                                            {
                                                "example_id": "78a73a16-2d15-474b-b662-30c4e789b084",
                                                "sense_id": "5182f48c-48f7-3f09-9d40-cee141ec05a9",
                                                "text": "À l'origine le derby était une chaussure montante pour la course à pied."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c46e6b17-c86d-3e22-9846-ddde44fa5680",
