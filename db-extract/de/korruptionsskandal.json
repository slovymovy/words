                "senses": [
                    {
                        "sense_id": "488d546d-3670-3e39-ae6e-bbe12c161c59",
                        "entry_id": "59ce3d9b-8020-3e4e-861f-3d98908bfb6f",
                        "glosses": [
                            "durch Bekanntwerden von Korruption ausgelöster Skandal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17a82ac4-0699-4499-94c3-9421295ceccc",
                                "sense_id": "488d546d-3670-3e39-ae6e-bbe12c161c59",
                                "text": "„Aufgrund seiner diversen Korruptionsskandale gilt Zardari vielen nicht als der legitime Nachfolger Benazir Bhuttos und ist selbst in den Reihen der PPP äußerst umstritten.“"
                            },
                            {
                                "example_id": "433387de-44c3-44fa-8851-fbef1e5704c9",
                                "sense_id": "488d546d-3670-3e39-ae6e-bbe12c161c59",
                                "text": "„Dieses lange Exil fern dem Präsidium hatte er antreten müssen, nachdem er Anfang der 1970er-Jahre als vielversprechender Zivilpolizist die oberen Ränge bei einem berühmten Korruptionsskandal gegen sich aufgebracht hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
