                "senses": [
                    {
                        "sense_id": "e724f4de-1a14-3f23-b4b0-440554a315b1",
                        "entry_id": "f74e8a8e-cc70-3704-9300-f2ef0c46e942",
                        "glosses": [
                            "Fotografie aus der Luft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c40adb04-c2c1-4a17-87e4-cb4f0122102b",
                                "sense_id": "e724f4de-1a14-3f23-b4b0-440554a315b1",
                                "text": "Obwohl diese Luftaufnahme aus 11.000 Metern gemacht wurde, kann man fast alle Details erkennen."
                            },
                            {
                                "example_id": "97ae8c6a-6285-47b0-b702-85e0cdfdf510",
                                "sense_id": "e724f4de-1a14-3f23-b4b0-440554a315b1",
                                "text": "Die Flak ist auf diesen Luftaufnahmen deutlich zu erkennen."
                            },
                            {
                                "example_id": "d6bcd8b8-aef6-481d-8c43-06778865bd30",
                                "sense_id": "e724f4de-1a14-3f23-b4b0-440554a315b1",
                                "text": "„Seit April 1944 lagen den Alliierten detaillierte Luftaufnahmen vor, die Menschen auf dem Weg von der Rampe in die Gaskammern zeigten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
