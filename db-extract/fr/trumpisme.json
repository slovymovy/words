        "fr-extract.jsonl": [
            {
                "entry_id": "96c07e33-7666-3d39-ae80-3873c0c37d2c",
                "word": "trumpisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a20fd52e-6bff-431f-aa7f-448bbd1135a2",
                        "entry_id": "96c07e33-7666-3d39-ae80-3873c0c37d2c",
                        "tags": [
                            "plural"
                        ],
                        "form": "trumpismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e3740302-e369-332f-93c3-7faad1ae8295",
                        "entry_id": "96c07e33-7666-3d39-ae80-3873c0c37d2c",
                        "glosses": [
                            "Ensemble des idées défendues par Donald Trump, ou soutien à ses idées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb5ddd7b-a26c-4b6e-94df-693ce014cd69",
                                "sense_id": "e3740302-e369-332f-93c3-7faad1ae8295",
                                "text": "Le trumpisme est l’enfant du Parti républicain ou, plus exactement, ce qu’est devenue cette formation depuis trente ans."
                            },
                            {
                                "example_id": "9fce6813-b52c-4fe4-b354-293f43391c51",
                                "sense_id": "e3740302-e369-332f-93c3-7faad1ae8295",
                                "text": "Le « trumpisme » est « un agrégat de positions et d’idées latentes dans l’histoire des États-Unis, qui ressurgissent ponctuellement »."
                            },
                            {
                                "example_id": "896fbb2a-1262-48fe-a43f-940983f4dce6",
                                "sense_id": "e3740302-e369-332f-93c3-7faad1ae8295",
                                "text": "Narcissisme, chauvinisme, sophisme, cynisme, syncrétisme, matérialisme, racisme, militarisme, inhumanisme, ignorantisme, incivisme, exhibitionnisme, le « Trumpisme » se dresserait comme un paradigme honteux qui fait l’éloge des ténèbres. En cette ère de lumière et de modernité, l’humanité doit s’atteler à éradiquer cette idéologie obtuse, dans la célérité !"
                            }
                        ]
                    },
                    {
                        "sense_id": "0aa2dc0f-aa06-33c5-a35a-b48faa2d8234",
                        "entry_id": "96c07e33-7666-3d39-ae80-3873c0c37d2c",
                        "glosses": [
                            "Phrase particulière à Donald J. Trump"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d685a5c2-2243-47d1-8a84-1b7f3663621d",
                                "sense_id": "0aa2dc0f-aa06-33c5-a35a-b48faa2d8234",
                                "text": "Beaucoup mieux que les « raffarinades », voici les « trumpismes » : une série de phrases stupides, ubuesques, incroyables mais vraies du candidat républicain."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "abf30776-0f0d-4230-92b6-b49d0fc0cc60",
                        "source_entry_id": "96c07e33-7666-3d39-ae80-3873c0c37d2c",
                        "target_lang_word": "Trumpismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trumpismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ab16e870-9634-39c5-92a0-eabbc0703b22",
                                        "entry_id": "c7f83534-4125-313d-88e1-2828daf06dde",
                                        "glosses": [
                                            "durch den US-Präsidenten Donald Trump ^(→ WP) geprägte Politik"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8f36c3f-51e6-46e6-ae41-2202afb1b8db",
                                                "sense_id": "ab16e870-9634-39c5-92a0-eabbc0703b22",
                                                "text": "„Der Trumpismus bedeutet für Asien nicht zuletzt ein gesteigertes Risiko der Verbreitung von Atomwaffen.“"
                                            },
                                            {
                                                "example_id": "894542dd-8b9d-43f0-a189-4881de527318",
                                                "sense_id": "ab16e870-9634-39c5-92a0-eabbc0703b22",
                                                "text": "„Das Titelbild des SPIEGEL zeigt nicht, was ist, sondern was sein wird, wenn sich der Trumpismus Bahn bricht.“"
                                            },
                                            {
                                                "example_id": "484bb3b4-f7e6-4be7-a70b-e28a820c97eb",
                                                "sense_id": "ab16e870-9634-39c5-92a0-eabbc0703b22",
                                                "text": "„Deshalb ist der Trumpismus ein Phänomen, dem wir mit noch größerer Irritation begegnen als entsprechenden Bewegungen in Europa.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a27a644-f0ff-4a17-acfd-5f55c346240f",
                        "source_entry_id": "96c07e33-7666-3d39-ae80-3873c0c37d2c",
                        "target_lang_word": "Trumpism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trumpism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f58eb7a1-1706-3ea4-82fb-98d7431701dd",
                                        "entry_id": "76d74d50-0403-36d7-9366-34845630acc8",
                                        "glosses": [
                                            "The philosophy and politics espoused by Donald Trump."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa96cbd0-bc5a-4bb9-a67f-e95f058304ea",
                                                "sense_id": "f58eb7a1-1706-3ea4-82fb-98d7431701dd",
                                                "text": "What is Trumpism? Or, to put it more tartly, is there a coherent political philosophy underlying his candidacy?...There can be Reaganism without Reagan. There can be no Trumpism without Trump...Trumpism is not so much a theory of government as a celebration of one individual's claimed capacity to govern."
                                            },
                                            {
                                                "example_id": "848ee96b-0ee3-4592-b5f7-276221957c73",
                                                "sense_id": "f58eb7a1-1706-3ea4-82fb-98d7431701dd",
                                                "text": "Given Latin America's right-wing turn’s affinities with Trumpism, it is tempting to see it as part of the global wave of right-wing populism making its way through the United States and Western Europe."
                                            },
                                            {
                                                "example_id": "42e3ebb3-f6ab-4b75-9b54-a4b4e06da4ff",
                                                "sense_id": "f58eb7a1-1706-3ea4-82fb-98d7431701dd",
                                                "text": "In fact, when you review the history of Republican climate denial, it looks a lot like Trumpism."
                                            },
                                            {
                                                "example_id": "264d95c3-8e0e-4ba1-8538-5c31c4cec2a6",
                                                "sense_id": "f58eb7a1-1706-3ea4-82fb-98d7431701dd",
                                                "text": "A mixture of isolationism, cronyism, nativist rhetoric, somewhat performative authoritarianism, corporate tax cuts and personality cult, Trumpism is what the president says it is."
                                            },
                                            {
                                                "example_id": "12be8c79-b64c-4c04-b3d8-b3d128ecd741",
                                                "sense_id": "f58eb7a1-1706-3ea4-82fb-98d7431701dd",
                                                "text": "Few are predicting an end to global Trumpism, the nation-first, people-dividing style of governance with a hint of authoritarianism that began to gain traction in Europe and Asia well before Trump's 2016 election."
                                            },
                                            {
                                                "example_id": "7bcf6417-7bb9-40a5-98ef-982ad100e22f",
                                                "sense_id": "f58eb7a1-1706-3ea4-82fb-98d7431701dd",
                                                "text": "Why Trumpism will endure...Trumpism was a long time coming, and it will be a long time going...The durability of Trump and Trumpism is bringing into harsh relief many of the deeper flaws in the U.S. political system...Emerging class differences had just as much to do with today’s political polarization as race did, and this also helps to explain the continuing populist appeal of Trumpism."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Trumpism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95701197-5ff0-3839-9c22-a8e8b9147281",
                                        "entry_id": "722c26f4-7695-3ce2-a569-16d126968401",
                                        "glosses": [
                                            "A characteristic phrase or statement made by Donald Trump."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed7343de-f61d-48a6-b2f9-de7f5a44981c",
                                                "sense_id": "95701197-5ff0-3839-9c22-a8e8b9147281",
                                                "text": "\"That was just painful,\" said one Republican official who […] added that the reality is McConnell—and Ryan and every Republican in a leadership position or facing an election challenge—\"will be stuck dealing with the latest Trumpism every interview of every day, of every month until November.\""
                                            },
                                            {
                                                "example_id": "594dff37-c4a0-4b7b-9b41-73a99fd34125",
                                                "sense_id": "95701197-5ff0-3839-9c22-a8e8b9147281",
                                                "text": "[…] the term Trumpisms entered our vocabulary—complete with a dedicated website categorizing quotations in groups with dropdown menus for easier access: Trumpisms by Region, Trumpisms on Facebook, Trumpisms on Twitter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
