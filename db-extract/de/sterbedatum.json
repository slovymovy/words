                                    {
                                        "sense_id": "3ff8ba86-c299-3c63-a9c9-c5a2619becbd",
                                        "entry_id": "6816ea6b-2756-39ce-bf30-1cb5e263186a",
                                        "glosses": [
                                            "dag van de kalender waarop iemand is doodgegaan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59aeb828-c4bb-48b0-adf1-2567b24cf83f",
                                                "sense_id": "3ff8ba86-c299-3c63-a9c9-c5a2619becbd",
                                                "text": "Zijn moeders sterfdatum hebben ze wel gevonden. Haar vaders ogen werden troebel bij het zien van het bericht op haar laptop. Hij was nog geen drie toen zijn moeder overleed. Te jong voor herinneringen en toch had hij gekeken alsof hij wist wat hij zijn hele leven had moeten missen."
                                            },
                                            {
                                                "example_id": "3e2a2e02-062e-475d-8785-9385179814d4",
                                                "sense_id": "3ff8ba86-c299-3c63-a9c9-c5a2619becbd",
                                                "text": "Met het monument worden de Nederlandse slachtoffers van de Holocaust herdacht die nooit een graf hebben gekregen. Het werk bestaat uit verschillende muren waarop de namen komen te staan van 102.000 vermoorde Joden en 220 Sinti en Roma, met geboorte- en sterfdatum."
                                            }
                                        ]
                                    }
