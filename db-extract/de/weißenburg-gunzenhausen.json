                ],
                "senses": [
                    {
                        "sense_id": "f392937c-cd02-3591-bdea-0284c43ae248",
                        "entry_id": "299ac22c-644d-3f4d-ab30-f6de87d371d5",
                        "glosses": [
                            "Bezeichnung eines Landkreises in Bayern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8a41553-e57b-4548-89d7-0fc741d11bab",
                                "sense_id": "f392937c-cd02-3591-bdea-0284c43ae248",
                                "text": "Der Landkreis Weißenburg-Gunzenhausen liegt im Süden Mittelfrankens und hat eine nennenswerte Bevölkerungsdichte."
                            },
                            {
                                "example_id": "741924ae-4183-4c90-ac32-cb6e7f087aca",
                                "sense_id": "f392937c-cd02-3591-bdea-0284c43ae248",
                                "text": "Meine Vorfahren stammen alle aus dem Landkreis Weißenburg-Gunzenhausen."
                            },
                            {
                                "example_id": "5a6e02a4-67ad-4882-abf4-03a10c7c99b1",
                                "sense_id": "f392937c-cd02-3591-bdea-0284c43ae248",
                                "text": "„‚Wir können als eine der steuerschwächsten Gegenden Bayerns diese Einnahmen und die vielen Arbeitsplätze nicht außer Acht lassen‘, sagt Weißenburg-Gunzenhausens Landrat Gerhard Wägemann (CSU).“"
                            },
                            {
                                "example_id": "92179c07-d72e-49c4-9782-60ce937a04ce",
                                "sense_id": "f392937c-cd02-3591-bdea-0284c43ae248",
                                "text": "„Laut dem Veterinäramt Weißenburg-Gunzenhausen habe es am vorherigen Standort vergleichbare Beanstandungen gegeben, berichtete ein Gerichtssprecher.“"
                            },
                            {
                                "example_id": "7edfb0a8-258b-48c8-b4aa-cd89873a2028",
                                "sense_id": "f392937c-cd02-3591-bdea-0284c43ae248",
                                "text": "„Nur in den Kreisen Neustadt an der Aisch, Ansbach und Weißenburg-Gunzenhausen warnt der Deutsche Wetterdienst noch vor Starkregen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
