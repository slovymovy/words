                "forms": [
                    {
                        "form_id": "a23d3104-8d8e-4130-aa97-8a0d0c94289c",
                        "entry_id": "baa46313-61fd-3643-b9f7-c08adf365965",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "aphones"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1a95fe39-54b2-332b-bf88-6b79d6c3a7e6",
                        "entry_id": "baa46313-61fd-3643-b9f7-c08adf365965",
                        "glosses": [
                            "Qui est sans voix, atteint d’aphonie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e21f3df-9b48-4607-884c-dc1a26a6a5c4",
                                "sense_id": "1a95fe39-54b2-332b-bf88-6b79d6c3a7e6",
                                "text": "Une affection du larynx rend ce malade aphone."
                            },
                            {
                                "example_id": "1b7d3ec5-79ba-4373-b4e6-0791ce4a667c",
                                "sense_id": "1a95fe39-54b2-332b-bf88-6b79d6c3a7e6",
                                "text": "Dix ont guéri rapidement et complètement ; l’un d’eux était aphone depuis mars 1915."
                            },
                            {
                                "example_id": "8bc946ef-84a7-44ab-baab-922cacbb2c38",
                                "sense_id": "1a95fe39-54b2-332b-bf88-6b79d6c3a7e6",
                                "text": "Il ne peut pas te répondre, Obélix, il est aphone.\nBois, ô Picte. Cet élixir va t'aider à retrouver ta voix."
                            }
                        ]
                    },
                    {
                        "sense_id": "11298071-0652-3cd9-809e-1ea49b3b3ed9",
                        "entry_id": "baa46313-61fd-3643-b9f7-c08adf365965",
                        "glosses": [
                            "Sans voix, muet, estomaqué."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "cd62decc-06ac-48a7-94c1-233a1d8318bb",
                                "sense_id": "11298071-0652-3cd9-809e-1ea49b3b3ed9",
                                "text": "Éberlué, aphone, n’en croyant pas ses oreilles, le représentant tenta de se ressaisir :\n— Enfin… Enfin… vous ne croyez tout de même pas que… enfin… Nous aussi, nous participons… avec de vraies femmes !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55011836-8da4-4d34-b73f-f102cf013fde",
                        "source_entry_id": "baa46313-61fd-3643-b9f7-c08adf365965",
                        "target_lang_word": "aphonic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
