                "senses": [
                    {
                        "sense_id": "a096e0d4-cba8-3d89-a6ec-5458cad77e58",
                        "entry_id": "da8a86f8-bb7b-3faa-a521-9aad6ac4b82c",
                        "glosses": [
                            "Any of several names for a thing; an alternative name."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "4c66e5b7-73f4-4739-9618-1b8cab043db8",
                                "sense_id": "a096e0d4-cba8-3d89-a6ec-5458cad77e58",
                                "text": ">> Is there another word for synonym?\n>Actually, there is: poecilonym\nTake care, though; ‘poecilonym’ can only be used for the taxonomic meaning of ‘synonym’--an incorrect or obsolete systematic name for a genus or species."
                            },
                            {
                                "example_id": "cefd6ef7-8725-478a-ba4c-690fe959bbb3",
                                "sense_id": "a096e0d4-cba8-3d89-a6ec-5458cad77e58",
                                "text": "It's high time I looked for another job and got as far away from homonyms, synonyms, antonyms — to say nothing of caconyms, eponyms, and poecilonyms!"
                            },
                            {
                                "example_id": "a8d0aaa0-7db7-4f6d-b28b-43c6d46717cf",
                                "sense_id": "a096e0d4-cba8-3d89-a6ec-5458cad77e58",
                                "text": "Maybe we could all use a few spanking old poecilonyms. Poecilonym? It's an old synonym for synonym that you'll find in these pages. But many words in this dictionary have no real counterparts in today's English."
                            }
                        ]
                    },
                    {
                        "sense_id": "825ac01b-c476-3bec-93ab-45a76215fe95",
                        "entry_id": "da8a86f8-bb7b-3faa-a521-9aad6ac4b82c",
                        "glosses": [
                            "Synonym of hybridism."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efa2f828-142f-432f-9d03-980eb1991437",
                                "sense_id": "825ac01b-c476-3bec-93ab-45a76215fe95",
                                "text": "This is also a type of poecilonym or hybrid word; cf. such a word as “aeneolithic” (=chalcolithic) in English."
                            }
                        ]
                    }
