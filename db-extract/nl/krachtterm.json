                ],
                "translations": [
                    {
                        "translation_id": "3a66f9db-c33d-4855-af96-469e2fb931da",
                        "source_entry_id": "e1af38b4-c692-3a11-813c-db1c30baacef",
                        "source_sense_id": "9f0e5b71-7c80-316c-87ed-8a03a246a99f",
                        "target_lang_word": "Kraftausdruck",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kraftausdruck",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "82abdfb8-6c3c-34d2-a1bc-7217994d806c",
                                        "entry_id": "1a9bc268-c78c-3718-b11c-f087a1b525d9",
                                        "glosses": [
                                            "derber sprachlicher Ausdruck, mit dem der Sprecher seine heftigen Gefühle zum Ausdruck bringt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a298682-094e-44ff-9a9f-879b0302d584",
                                                "sense_id": "82abdfb8-6c3c-34d2-a1bc-7217994d806c",
                                                "text": "Reiners widmet den Kraftausdrücken ein eigenes kleines Kapitel seiner „Stilkunst“."
                                            },
                                            {
                                                "example_id": "2a15da81-0b0b-40c0-9ccc-f6580d57c98f",
                                                "sense_id": "82abdfb8-6c3c-34d2-a1bc-7217994d806c",
                                                "text": "„Der Wortschatz, im allgemeinen arm und einförmig, ist doch reich an Kraftausdrücken.“"
                                            },
                                            {
                                                "example_id": "f84214be-1eb5-48f9-b8b3-01d7a9b05792",
                                                "sense_id": "82abdfb8-6c3c-34d2-a1bc-7217994d806c",
                                                "text": "„Martin Luther, bekannt für seine Neigung zu Kraftausdrücken, trug maßgeblich zur Verbreitung des Wortes bei.“"
                                            },
                                            {
                                                "example_id": "cf61a2b9-3438-4683-8e9a-9128e3365290",
                                                "sense_id": "82abdfb8-6c3c-34d2-a1bc-7217994d806c",
                                                "text": "„Es gibt oder gab bis vor kurzem in Spanien eine spezifische Männersprache, die sich durch solche ritualisierten tacos, ganz vorwiegend sexuelle Kraftausdrücke also, kennzeichnete.“"
                                            },
                                            {
                                                "example_id": "bf5cc45c-6870-400d-acc9-3d0fcf62a282",
                                                "sense_id": "82abdfb8-6c3c-34d2-a1bc-7217994d806c",
                                                "text": "„Ich mußte ihm deutsche Kraftausdrücke beibringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
