                        ]
                    },
                    {
                        "translation_id": "e37ad19f-7603-4922-a398-4532479f514d",
                        "source_entry_id": "23d4ce3f-4d59-35c2-a67c-5291b04c4c50",
                        "source_sense_id": "fd057e1f-6ec4-3a71-9822-bab0fa9df39f",
                        "target_lang_word": "déiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "306b83e1-07cd-322c-bf01-fd6cbf5fd5e2",
                                        "entry_id": "f341c9db-9d8e-3c75-8170-68db0a2c3c05",
                                        "glosses": [
                                            "Qui appartient au déisme, à la croyance à l’existence d’un être suprême."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2422c693-32d3-4f86-b3f5-06d7f50add35",
                                                "sense_id": "306b83e1-07cd-322c-bf01-fd6cbf5fd5e2",
                                                "text": "[…],c’est que le républicanisme de Paine n’est pas à la source de sa pensée politique, ni même de sa conviction philosophique, mais qu’il procède, comme il ressort du Siècle de la Raison, d’une foi déiste primordiale, d’une indignation originelle contre l’alliance de l’Église et de l’État et contre le mensonge et la superstition inhérents au christianisme et au cléricalisme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "232edb2e-5f12-3a42-96db-865224ddc897",
                                        "entry_id": "f341c9db-9d8e-3c75-8170-68db0a2c3c05",
                                        "glosses": [
                                            "Qui adhère à la doctrine déiste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8959f379-4db6-47b9-860c-e2bdb0faf6c3",
                                                "sense_id": "232edb2e-5f12-3a42-96db-865224ddc897",
                                                "text": "Honoré lui-même était impressionné quand il l’entendait dire : « Je suis déiste, comme Victor Hugo », ou bien : « Je respecte toutes les convictions, et j’entends qu’on respecte les miennes. »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "déiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "86913b3a-d4b6-359d-9eed-3dea275ca262",
                                        "entry_id": "4f39ab22-7ab7-3634-8e30-fa1c73046f64",
                                        "glosses": [
                                            "Personne qui adhère à la doctrine déiste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bbcd1c8-0907-4e52-8472-864e700d9b03",
                                                "sense_id": "86913b3a-d4b6-359d-9eed-3dea275ca262",
                                                "text": "Le déiste seul peut faire tête à l’athée. Le superstitieux n’est pas de sa force."
                                            },
                                            {
                                                "example_id": "e8b1bff0-736e-409e-9065-5e38e2187038",
                                                "sense_id": "86913b3a-d4b6-359d-9eed-3dea275ca262",
                                                "text": "Robespierre, lui-même un déiste, introduit le culte de la vertu suprême qui se transforme plus tard en culte de l'Être suprême."
                                            },
                                            {
                                                "example_id": "f8f8e298-ea52-437e-9457-af5f77aa15ba",
                                                "sense_id": "86913b3a-d4b6-359d-9eed-3dea275ca262",
                                                "text": "Le terme \"déiste\" est plutôt utilisé dans le langage théologique pour désigner de manière péjorative ou avec mépris ceux qui se disent croyants mais ignorent les prescriptions religieuses et ne pratiquent pas de culte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
