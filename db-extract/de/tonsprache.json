                "senses": [
                    {
                        "sense_id": "3ff8dd40-ee7d-30ac-8561-5025b8c843db",
                        "entry_id": "06b46a69-91fb-3a34-b69b-643802ca5201",
                        "glosses": [
                            "tonâl/tonlu dil, tonâl/tonlu lisan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3336ee95-83df-45fd-aa4a-8dadb4a53bb0",
                                "sense_id": "3ff8dd40-ee7d-30ac-8561-5025b8c843db",
                                "text": "Chinesisch ist ein Beispiel für eine Tonsprache.",
                                "translation": "Çince, tonâl bir lisana örnektir."
                            },
                            {
                                "example_id": "cc42e59f-0111-463f-8518-02a55bb0e5dd",
                                "sense_id": "3ff8dd40-ee7d-30ac-8561-5025b8c843db",
                                "text": "„Im Unterschied zu Hindi ist das Tibetische eine Tonsprache.",
                                "translation": "Hintçe'nin hilafına Tibetçe tonâl bir lisandır."
                            },
                            {
                                "example_id": "8d4a98aa-2fca-460a-99ce-7b134b452ccc",
                                "sense_id": "3ff8dd40-ee7d-30ac-8561-5025b8c843db",
                                "text": "„Dem hält allerdings Haarmann (…) entgegen, dass dies auch im Vietnamesischen gelang, obwohl das Vietnamesische ebenfalls eine Tonsprache (mit sechs Tönen) ist.“",
                                "translation": "Bununla birlikte, Haarmann (…) bunun (altı tonlu) bir tonâl lisan olmasına rağmen Vietnamcada da mümkün olduğunu söylüyor."
                            }
                        ]
                    }
