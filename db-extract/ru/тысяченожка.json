                "senses": [
                    {
                        "sense_id": "b8cd585c-2a4f-3625-a368-a5682c5dd00d",
                        "entry_id": "d165bbbe-f1ec-369e-b5e5-5f12ae95a3ed",
                        "glosses": [
                            "наземное членистоногое животное с червеобразным телом и большим количеством ножек; многоножка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd3e79e9-ebef-43a6-bc31-c4fcf18b1761",
                                "sense_id": "b8cd585c-2a4f-3625-a368-a5682c5dd00d",
                                "text": "«Сороконожки, стоножки, тысяченожки и, наконец, просто многоножки ― вот под какими названиями известны эти членистоногие, ― говорят энтомологи, ― но все же ни одна многоножка не имеет тысячи ног, хотя сотня-другая их бывает: известны многоножки со 172 парами ног…»"
                            }
                        ]
                    }
