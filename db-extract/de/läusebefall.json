                        "examples": [
                            {
                                "example_id": "2a25bdcd-2b85-45f4-9093-94556def96d5",
                                "sense_id": "c4b8650d-0f3f-30f4-b6b6-aea94e258d6b",
                                "text": "Da es vor allem in Kindergärten und Kindertagesstätten regelmäßig zur Übertragung von Kopfläusen kommt, werden in der hausärztlichen Praxis besonders Kinder mit Läusebefall und den typischen Folgen des Kratzens auf der Kopfhaut vorgestellt."
                            },
                            {
                                "example_id": "7f17092a-dd26-4fdc-b6af-65ee6d072641",
                                "sense_id": "c4b8650d-0f3f-30f4-b6b6-aea94e258d6b",
                                "text": "„Zwischen Färben oder Tönen lagen Welten und ein Läusebefall hatte einmal zum Supergau geführt.“"
                            }
                        ],
