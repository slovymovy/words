                        "source_sense_id": "496e6c48-32d0-37c5-a9f3-2c468e73800e",
                        "source_sense_description": "Werkzeug zum Anziehen beziehungsweise Lösen von Schrauben mit kreuzförmigen Schlitzen",
                        "target_lang_word": "tournevis cruciforme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tournevis cruciforme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7033c602-81f9-3271-9e10-6d2fe9a8f35f",
                                        "entry_id": "070bc572-35b7-34d4-a503-d0df9e268701",
                                        "glosses": [
                                            "Type de tournevis dont la section du bout de la lame est en forme de croix. Il en existe au moins deux modèles courants : pozidriv(e) et phillips, mais on trouve aussi supadrive, Torq-set, ..."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3b43b87-3916-4484-ac3a-2728e1d6d37d",
                                                "sense_id": "7033c602-81f9-3271-9e10-6d2fe9a8f35f",
                                                "text": "Chaque type ne doit être entraîné qu'avec son propre tournevis cruciforme spécial de la bonne taille. Par rapport à une fente droite, ils sont nets et faciles à conduire sans glisser et gouger la surface de travail."
                                            },
                                            {
                                                "example_id": "69c96c2d-cd43-4497-8c2f-a5a98819eb83",
                                                "sense_id": "7033c602-81f9-3271-9e10-6d2fe9a8f35f",
                                                "text": "Face à elle, un homme, la quarantaine, large carrure, visage rasé au tournevis cruciforme, calibré à l’étau limeur, cheveux, sourcils inexistants, sirotait l’alcool qu’il jouait à faire tourner dans le fond de sa tasse à café."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
