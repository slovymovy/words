                                        "examples": [
                                            {
                                                "example_id": "c4c484d6-fd22-4ce6-9f83-3428c5812399",
                                                "sense_id": "7de4c561-b066-39f3-8229-2e6e0493deca",
                                                "text": "Der Bourgeois sieht in seiner Frau ein bloßes Produktionsinstrument. Er hört, daß die Produktionsinstrumente gemeinschaftlich ausgebeutet werden sollen, und kann sich natürlich nichts anderes denken, als daß das Los der Gemeinschaftlichkeit die Weiber gleichfalls treffen wird."
                                            },
                                            {
                                                "example_id": "01eb7708-8e46-4435-9033-cc859a125a68",
                                                "sense_id": "7de4c561-b066-39f3-8229-2e6e0493deca",
                                                "text": "Нет ничего характернее для буржуа, как перенесение черт современных порядков на все времена и народы.",
                                                "translation": "Vladimir Lenin",
                                                "english": "Vladimir Lenin"
                                            }
