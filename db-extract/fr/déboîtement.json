                        "entry_id": "71762d34-026a-30aa-87bc-899881ba568d",
                        "glosses": [
                            "Déplacement d’un os sorti de son articulation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5d63411-ec39-4c0b-812a-c5adc6ac74a8",
                                "sense_id": "8512155b-01cc-3c3b-a27a-a28043e93ca9",
                                "text": "Le déboîtement de l’os du bras."
                            },
                            {
                                "example_id": "36f486ba-95c3-426e-baf1-ae4fb34b2501",
                                "sense_id": "8512155b-01cc-3c3b-a27a-a28043e93ca9",
                                "text": "Luxations, c’est à dire deloueures et desboetures d’os."
                            },
                            {
                                "example_id": "f405a1ee-51a5-4ad8-be0f-9deffc7488d3",
                                "sense_id": "8512155b-01cc-3c3b-a27a-a28043e93ca9",
                                "text": "Si en outre, les os sont déplacés, c’est une luxation ou déboîtement, et l’intervention hâtive du médecin est nécessaire."
                            }
                        ]
                    }
                ],
