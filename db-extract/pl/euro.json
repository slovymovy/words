                                        "glosses": [
                                            "Währung der Europäischen Währungsunion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b3321a2-7857-429e-b2dc-0280d4e156f6",
                                                "sense_id": "d598e1df-7c1b-348e-88d9-f4a377d05d5d",
                                                "text": "100 Eurocent haben denselben Wert wie ein Euro."
                                            },
                                            {
                                                "example_id": "5604c5bf-f9b9-4314-9647-a4d67d7e41c5",
                                                "sense_id": "d598e1df-7c1b-348e-88d9-f4a377d05d5d",
                                                "text": "Heutzutage tut man gut daran, seine Euros beisammenzuhalten."
                                            },
                                            {
                                                "example_id": "7ef20f53-123a-449c-888c-5b1d4ac16f1d",
                                                "sense_id": "d598e1df-7c1b-348e-88d9-f4a377d05d5d",
                                                "text": "Minna gewann in der Lotterie 25 Millionen Euro."
                                            },
                                            {
                                                "example_id": "b702569e-6bc0-412f-b245-79e0921c4b07",
                                                "sense_id": "d598e1df-7c1b-348e-88d9-f4a377d05d5d",
                                                "text": "„Doch ein Austritt könnte das Ende des Euros einleiten.“"
                                            },
                                            {
                                                "example_id": "8de1a7dd-8698-419b-a9f5-3b4c37165380",
                                                "sense_id": "d598e1df-7c1b-348e-88d9-f4a377d05d5d",
                                                "text": "„Wenn es gut läuft, kommt sie am Tag auf fünfundzwanzig Birr, rund einen Euro.“"
                                            },
                                            {
                                                "example_id": "50652746-cfcf-4eaa-82ef-4e7cdddc0bbd",
                                                "sense_id": "d598e1df-7c1b-348e-88d9-f4a377d05d5d",
                                                "text": "„Auf eBay kosten die Modelle von damals zwischen acht und fünfundzwanzig Euro.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
