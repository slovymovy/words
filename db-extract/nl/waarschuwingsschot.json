                "senses": [
                    {
                        "sense_id": "36637352-8c04-38bb-9259-c0b67c286dcc",
                        "entry_id": "b5e01f1f-5d87-30a3-833d-0b3001585d00",
                        "glosses": [
                            "een schot door een politieagent, militair of (buitengewoon) opsporingsambtenaar, afkomstig van een vuurwapen, dat wordt afgevuurd in de lucht (niet gericht op een persoon) ter waarschuwing"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0be32023-8a12-42c7-89d5-adb7027ff227",
                                "sense_id": "36637352-8c04-38bb-9259-c0b67c286dcc",
                                "text": "De man bedreigde de agenten met een mes. Een van de agenten voelde zich daarop genoodzaakt om een waarschuwingsschot te lossen. Maar dat bleek aan dovemansoren gericht. Daarom loste een agent een kogel in het been van de Tilburger. De man is aangehouden en onder politiebegeleiding overgebracht naar het ziekenhuis."
                            }
                        ]
                    },
                    {
                        "sense_id": "4178e408-7376-354c-a85d-1145c6b4d533",
                        "entry_id": "b5e01f1f-5d87-30a3-833d-0b3001585d00",
                        "glosses": [
                            "een schot van de vijand waar men angstig van wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97e257b4-9f53-4149-9935-40a90a4eb118",
                                "sense_id": "4178e408-7376-354c-a85d-1145c6b4d533",
                                "text": "Het tweede waarschuwingsschot van de beloften kwam niet veel later, maar dit keer strandde Jamie Jacobs op doelman Joël Drommel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7efa385b-960d-4369-9352-844c00714a0b",
                        "source_entry_id": "b5e01f1f-5d87-30a3-833d-0b3001585d00",
                        "source_sense_id": "36637352-8c04-38bb-9259-c0b67c286dcc",
                        "source_sense_description": "een schot ter waarschuwing",
                        "target_lang_word": "Warnschuss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Warnschuss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "61cc986b-3ecb-3664-8feb-10dc2acd35d6",
                                        "entry_id": "ae16d7a7-d84e-3b71-95f4-10b9fb88380c",
                                        "glosses": [
                                            "Schuss in die Luft, um jemanden vor möglichem Schusswaffengebrauch zu warnen und zur Aufgabe zu bewegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39df81c8-770a-4bb9-8297-3db909ca3b3e",
                                                "sense_id": "61cc986b-3ecb-3664-8feb-10dc2acd35d6",
                                                "text": "Als der Einbrecher fliehen wollte, gab der Polizist einen Warnschuss ab."
                                            },
                                            {
                                                "example_id": "a1bd9a1c-c0ce-483d-919f-57cf505ccaaa",
                                                "sense_id": "61cc986b-3ecb-3664-8feb-10dc2acd35d6",
                                                "text": "„Er feuerte einen Warnschuss über ihre Köpfe hinweg; als die Krieger sich nicht zurückzogen, schoss er erneut und tötete einen von ihnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ed4a909c-bb65-3450-88ac-a3a4e3430502",
                                        "entry_id": "ae16d7a7-d84e-3b71-95f4-10b9fb88380c",
                                        "glosses": [
                                            "Warnung, die jemandem Nachteile ankündigt"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6a4bf9c-6eb3-4976-a729-cdb22edeea7d",
                                                "sense_id": "ed4a909c-bb65-3450-88ac-a3a4e3430502",
                                                "text": "„Es ist ein Warnschuss an ARD und ZDF.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
