                "translations": [
                    {
                        "translation_id": "14008ef1-dcbc-46ff-927b-2797de80e021",
                        "source_entry_id": "6c537bc0-3ccf-39a7-a7c6-605bfef4a4ac",
                        "source_sense_id": "eaf3e927-07f1-382e-b811-cd486e2336d0",
                        "source_sense_description": "gewaarworden door een van de zintuigen",
                        "target_lang_word": "Perzeption",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Perzeption",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "58aecc37-ef7f-37c4-8218-2ae2eb6b7202",
                                        "entry_id": "8be0900f-3f8f-3340-9c2a-f8a4f4112ad3",
                                        "glosses": [
                                            "sinnliche Wahrnehmung"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "402ec703-4618-4355-954a-ea64924ed67c",
                                                "sense_id": "58aecc37-ef7f-37c4-8218-2ae2eb6b7202",
                                                "text": "„Dies ist nahezu einzigartig in allen 25 EU-Mitgliedstaaten und, gelinde gesagt, in der ausländischen Perzeption undemokratisch für ein europäisches Kernland.“"
                                            },
                                            {
                                                "example_id": "6a28b035-e394-4c6e-a835-71f5ef64fa07",
                                                "sense_id": "58aecc37-ef7f-37c4-8218-2ae2eb6b7202",
                                                "text": "„Die ganze Kunstgeschichte ist letzlich die Geschichte der verschiedenen Arten visueller Perzeption, also eine Geschichte der sich wandelnden Art und Weise, wie der Mensch die Welt gesehen hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2323420d-c25f-3ecd-bd7d-f6d05cbea252",
                                        "entry_id": "8be0900f-3f8f-3340-9c2a-f8a4f4112ad3",
                                        "glosses": [
                                            "Wahrnehmung und Verarbeitung sprachlicher Äußerungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df911faf-fbf3-45e6-9091-08b8b583ad4a",
                                                "sense_id": "2323420d-c25f-3ecd-bd7d-f6d05cbea252",
                                                "text": "„Wenn das aber so ist, dann ist die Unfähigkeit Erwachsener, bestimmte distinktive Laute in anderen Sprachen zu unterscheiden, einfach auf ihre automatisierte Perzeption zurückzuführen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c634fdb3-9ec1-4764-bae4-1b1c4cfd06b7",
                        "source_entry_id": "6c537bc0-3ccf-39a7-a7c6-605bfef4a4ac",
                        "source_sense_id": "eaf3e927-07f1-382e-b811-cd486e2336d0",
                        "source_sense_description": "gewaarworden door een van de zintuigen",
                        "target_lang_word": "Beobachtung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beobachtung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "60b44972-ad20-39a2-b3aa-a59c0007c957",
                                        "entry_id": "5f9c23b3-faf1-3d0e-9ac2-24728a72d164",
                                        "glosses": [
                                            "gezielte, bewusste Untersuchung, Wahrnehmung von etwas"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee7b55d1-2cf8-464a-8c90-9f50db5ae6ba",
                                                "sense_id": "60b44972-ad20-39a2-b3aa-a59c0007c957",
                                                "text": "Beobachtung ist ein wesentlicher Teil wissenschaftlicher Arbeit."
                                            },
                                            {
                                                "example_id": "f87c629b-bf7d-431d-944a-236aa090e7c1",
                                                "sense_id": "60b44972-ad20-39a2-b3aa-a59c0007c957",
                                                "text": "„Erst eine Theorie macht überhaupt eine Beobachtung zu einem geeigneten Datum.“"
                                            },
                                            {
                                                "example_id": "bc1f9fe4-d99f-4070-8bbb-f66da77c8695",
                                                "sense_id": "60b44972-ad20-39a2-b3aa-a59c0007c957",
                                                "text": "„Gerade dieses Exemplar zeichnete sich durch seine besondere Standorttreue aus, was die weitere Beobachtung naturgemäß deutlich erleichtern würde.“"
                                            },
                                            {
                                                "example_id": "91888381-2b33-48f9-9e13-1cfe657e89fc",
                                                "sense_id": "60b44972-ad20-39a2-b3aa-a59c0007c957",
                                                "text": "„Die Welt durch Beobachtung und Vermessung zu erschließen war eine Idee der Aufklärung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0ba22cda-b9e1-3c33-b2bb-9431eec71e8f",
                                        "entry_id": "5f9c23b3-faf1-3d0e-9ac2-24728a72d164",
                                        "glosses": [
                                            "Ergebnis von [1]; das, was beobachtet wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98c79ada-8c23-412a-908e-7d9d8d2bfd0b",
                                                "sense_id": "0ba22cda-b9e1-3c33-b2bb-9431eec71e8f",
                                                "text": "Wir können eine neue Beobachtung mitteilen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e8880a2c-bb3e-335e-b918-2ae48a6538fa",
                                        "entry_id": "5f9c23b3-faf1-3d0e-9ac2-24728a72d164",
                                        "glosses": [
                                            "Befolgung (zum Beispiel von Vorschriften)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b597f78c-6b32-47c4-857c-80a8f0cd5970",
                                                "sense_id": "e8880a2c-bb3e-335e-b918-2ae48a6538fa",
                                                "text": "Die Beobachtung von Gesetzen wird von allen verlangt."
                                            }
