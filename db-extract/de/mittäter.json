                "senses": [
                    {
                        "sense_id": "cd8efa07-7423-352b-aaa7-0d4b9acf5982",
                        "entry_id": "a30cefad-f690-3f8e-b3b3-046a6c366f16",
                        "glosses": [
                            "an einer gemeinschaftlich begangenen Tat Beteiligter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47fd8a74-89fb-4609-a04d-268ae9c58f9b",
                                "sense_id": "cd8efa07-7423-352b-aaa7-0d4b9acf5982",
                                "text": "„Es muß nicht jeder Mittäter den ganzen strafbaren Tatbestand verwirklichen; vielmehr genügt eine vom gleichen bösen Vorsatz getragene, wenn auch zeitlich beschränkte Mitwirkung in irgendeiner Phase der Ausführung der Straftat auch ohne gleichzeitige Anwesenheit am Tatort, mithin ohne daß die Mittäter zugleich tätig werden müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4606bdea-3376-4e92-8da8-c542a0eeb38d",
                        "source_entry_id": "a30cefad-f690-3f8e-b3b3-046a6c366f16",
                        "source_sense_id": "cd8efa07-7423-352b-aaa7-0d4b9acf5982",
                        "source_sense_description": "an einer gemeinschaftlich begangenen Tat Beteiligter",
                        "target_lang_word": "accomplice",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accomplice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "562051d1-a745-3922-8904-5094cd184423",
                                        "entry_id": "c7c6dbae-f42b-39a4-9e4c-caaa98f1ecbe",
                                        "glosses": [
                                            "An associate in the commission of a crime; a participator in an offense, whether a principal or an accessory."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79c438bf-2d62-470c-a350-c4df338e0784",
                                                "sense_id": "562051d1-a745-3922-8904-5094cd184423",
                                                "text": "Childleſs Arturius, vaſtly rich before, / Thus by his Loſſes multiplies his Store: / Suſpected for Accomplice to the Fire, / That burnt his Palace but to build it higher."
                                            },
                                            {
                                                "example_id": "a45118bd-7993-45a9-831f-bdcaffe91a15",
                                                "sense_id": "562051d1-a745-3922-8904-5094cd184423",
                                                "text": "And thou, the curs’d Accomplice of her Treaſon, / Declare thy Meſſage, and expect thy Doom."
                                            },
                                            {
                                                "example_id": "c2a1448a-71f8-4cd5-b2eb-6cc01f7ff092",
                                                "sense_id": "562051d1-a745-3922-8904-5094cd184423",
                                                "text": "“You have a young son, yet you involve yourself in the world of organised crime. Robbing a bank no less! Stealing half a million pounds! Money, I might add, that has never been recovered. You must know where the money is hidden, and yet, Mr Goodie, you refuse to inform the police. You must have had accomplices, but you will not name them. This no doubt is the criminals’ code of honour.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95444974-883d-36a9-8891-b0d490e385b1",
                                        "entry_id": "c7c6dbae-f42b-39a4-9e4c-caaa98f1ecbe",
                                        "glosses": [
                                            "A cooperator."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f14709a-fc8e-44e6-953a-1cecb860f922",
                                                "sense_id": "95444974-883d-36a9-8891-b0d490e385b1",
                                                "text": "Succeſſe vnto our valiant Generall, / And happineſſe to his accomplices."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4acfbfb-daa4-4e38-b230-f40ee5f1ca4d",
                        "source_entry_id": "a30cefad-f690-3f8e-b3b3-046a6c366f16",
                        "source_sense_id": "cd8efa07-7423-352b-aaa7-0d4b9acf5982",
                        "source_sense_description": "an einer gemeinschaftlich begangenen Tat Beteiligter",
