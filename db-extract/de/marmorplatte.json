                "senses": [
                    {
                        "sense_id": "1138983c-e055-3a37-804b-fd486bc3d386",
                        "entry_id": "d51e887b-c9fd-3274-bc9c-85d862fde35f",
                        "glosses": [
                            "Platte, hergestellt aus Marmor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f061f59-5bf1-44f0-9a75-4cb31cff598a",
                                "sense_id": "1138983c-e055-3a37-804b-fd486bc3d386",
                                "text": "„Es ist groß, es gehört zur Luxusklasse, doch die schwarze Marmorplatte ist nackt, keine Inschrift, kein Name, kein Foto.“"
                            },
                            {
                                "example_id": "7faf2b5c-af47-4c31-8478-076a2ec4c484",
                                "sense_id": "1138983c-e055-3a37-804b-fd486bc3d386",
                                "text": "„Die Marmorplatten waren noch nass und glatt.“"
                            },
                            {
                                "example_id": "2115a960-3962-4e44-abe7-03d631273b53",
                                "sense_id": "1138983c-e055-3a37-804b-fd486bc3d386",
                                "text": "„Auf riesige schwarze Marmorplatten ließen die Hinterbliebenen Abbilder ihrer Toten eingravieren.“"
                            },
                            {
                                "example_id": "7710f39f-27b3-4f8a-999f-cbfc34acbd2e",
                                "sense_id": "1138983c-e055-3a37-804b-fd486bc3d386",
                                "text": "„Unter einer Marmorplatte in der Schniergruft wird mein Geheimnis ruhen.“"
                            },
                            {
                                "example_id": "1e45a9b8-13e6-490b-a3ab-033cc4318e84",
                                "sense_id": "1138983c-e055-3a37-804b-fd486bc3d386",
                                "text": "„Wells lächelte, klopfte mit dem Schlüsselanhänger aus Pressspan zweimal auf die Marmorplatte des Empfangsschalters und ging die Treppe hinauf.“"
                            },
                            {
                                "example_id": "252657f2-0510-440e-9952-c8496268a11c",
                                "sense_id": "1138983c-e055-3a37-804b-fd486bc3d386",
                                "text": "„Ich sah mich um und betrachtete die vielen Marmorplatten, auf denen Särge - oder die Überreste von Särgen - standen.“"
                            },
                            {
                                "example_id": "5bc2279c-ed7b-43a6-911b-f1f66c96479b",
                                "sense_id": "1138983c-e055-3a37-804b-fd486bc3d386",
                                "text": "„Der Mann, der micht hereingebeten hatte, saß in einem großen, bequemen Polstersessel neben einem Wohnzimmertisch mit Marmorplatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
