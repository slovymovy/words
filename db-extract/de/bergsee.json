                "senses": [
                    {
                        "sense_id": "dac1c5fd-efb4-3438-9811-f67684949e7b",
                        "entry_id": "33469be1-11ff-3e95-a4ab-ffe495deb601",
                        "glosses": [
                            "See, der von Bergen umgeben ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8284ed53-022b-4c5d-8a34-50b6c3d89fdd",
                                "sense_id": "dac1c5fd-efb4-3438-9811-f67684949e7b",
                                "text": "„Und dann ist da noch der Schwarzensee, mit knapp 23 Hektar der größte Bergsee der Schladminger Tauern.“"
                            },
                            {
                                "example_id": "4fdfcab5-1c95-4632-b376-75a45915329a",
                                "sense_id": "dac1c5fd-efb4-3438-9811-f67684949e7b",
                                "text": "„Mal kreisrund, mal länglich wie ein Fjord, manchmal unergründlich tief, dann wieder seicht, mal blauer Farbtupfer inmitten grauer Felswüste und andernorts geheimnisvoll grün schimmernd in einer idyllischen Wiesenmulde - Bergseen sind so unterschiedlich wie die Berggipfel, zwischen denen sie liegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
