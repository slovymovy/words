                "senses": [
                    {
                        "sense_id": "8708f4cd-6541-3319-ad80-773ed06d2bfd",
                        "entry_id": "a0703bc0-4259-3765-98ec-e61d5e800fe2",
                        "glosses": [
                            "Kurzwort für Kriminalpolizei"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "baeabd98-eed1-4a8b-a2e3-692721d47337",
                                "sense_id": "8708f4cd-6541-3319-ad80-773ed06d2bfd",
                                "text": "Die Streifenpolizisten haben sofort die Kripo gerufen als sie den Toten vorfanden."
                            },
                            {
                                "example_id": "59ca82a1-e20b-459a-8770-4e71a3a9e242",
                                "sense_id": "8708f4cd-6541-3319-ad80-773ed06d2bfd",
                                "text": "Die Kripo Augsburg konnte mehrere Kilogramm Heroin beschlagnahmen."
                            },
                            {
                                "example_id": "89deb8ca-0f15-4541-b7cd-40e4e87ca188",
                                "sense_id": "8708f4cd-6541-3319-ad80-773ed06d2bfd",
                                "text": "„Er brauchte sie nur in seinem Zimmer zu verstecken und die Kripo zu benachrichtigen.“"
                            },
                            {
                                "example_id": "c566933b-e645-40fc-9436-1dd5ab937b13",
                                "sense_id": "8708f4cd-6541-3319-ad80-773ed06d2bfd",
                                "text": "„Hauptkommissar Kielholz will die Sache nicht von vornherein der Kripo überlassen.“"
                            },
                            {
                                "example_id": "62159d46-8b34-4050-996c-9d27f6635db7",
                                "sense_id": "8708f4cd-6541-3319-ad80-773ed06d2bfd",
                                "text": "„Bei der Kripo Vesturland hatten sie es vor allem mit Verkehrsunfällen zu tun.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
