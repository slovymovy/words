                        "glosses": [
                            "Qualifie des animaux et des végétaux qui sont parsemés de taches en forme de points."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d852c679-fc4a-408b-a79a-914b3266db7f",
                                "sense_id": "40e782cc-e9ba-3202-b459-af271918e611",
                                "text": "Corselet transversal, arrondi et bordé latéralement, très-fortement ponctué sur les bords, plus lisse et finement ponctué au milieu, où il est marqué d'une ligne longitudinale."
                            }
                        ]
                    },
                    {
                        "sense_id": "19afb7a2-a2e1-307c-8075-07b2773d6537",
