                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b6098329-febf-40fd-8073-9fe60ee44c7e",
                                "sense_id": "62c4bd98-3fdf-3413-83ad-4f6f67e72b08",
                                "text": "Professor Burns will be invigilating over the final examinations to ensure that the students do not cheat."
                            }
                        ]
                    },
                    {
                        "sense_id": "5070798b-f5ce-3209-9607-6f2706e3b166",
                        "entry_id": "53d6efb8-2a35-3293-b8a4-75857d85151c",
                        "glosses": [
                            "To keep watch."
                        ],
