                    }
                ],
                "translations": [
                    {
                        "translation_id": "bff52859-a8cb-46de-a9ae-7a58bc190fba",
                        "source_entry_id": "a872ffba-582b-3b61-b494-ff1aab2080c6",
                        "source_sense_id": "cd4dd23a-5d64-37d0-8067-5cf8b38e4717",
                        "target_lang_word": "broker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "broker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf2fc302-dbb4-3ee6-ba94-2d74b510642e",
                                        "entry_id": "cfa629db-139b-31c2-b63d-e4929a574eaf",
                                        "glosses": [
                                            "comparative form of broke: more broke"
                                        ],
                                        "tags": [
                                            "comparative",
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "broker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "98b0effe-4c05-399a-a1e9-768d8159b971",
                                        "entry_id": "3c7518e2-1942-3f1f-81c2-9b791c0dd815",
                                        "glosses": [
                                            "A mediator between a buyer and seller."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1892116-20be-4e11-bec7-6e59fc3a6d73",
                                                "sense_id": "98b0effe-4c05-399a-a1e9-768d8159b971",
                                                "text": "It is singular how forcibly this passage in my narrative brings to my mind a picture which used to be, some years ago, at a broker's—that charnel-house of the comforts and graces of life. It had been taken out of its frame, and leant in a dark and dusty corner against a perpendicular armchair, whose rigid uprightness seemed suited only to the parlour of a dentist, repose being the last idea it suggested."
                                            },
                                            {
                                                "example_id": "860640f9-bb52-4257-a226-1b4b38202922",
                                                "sense_id": "98b0effe-4c05-399a-a1e9-768d8159b971",
                                                "text": "Liz Brent, broker at Go Brent in Maryland and Washington, DC, said she’s spent the past few months changing how she presents properties by emphasizing photographs, 3-D tours, and video vignettes for homes online."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c7abd9d-b066-3287-adea-d5e708c44f11",
                                        "entry_id": "3c7518e2-1942-3f1f-81c2-9b791c0dd815",
                                        "glosses": [
                                            "A stockbroker."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "95227d6e-cd10-37c5-af03-b7f5495a3e8f",
                                        "entry_id": "3c7518e2-1942-3f1f-81c2-9b791c0dd815",
                                        "glosses": [
                                            "A mediator in general, one who liaises between two or more parties to attempt to achieve an outcome of some kind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "806b8055-b0bf-4614-8c6b-a2f1efee61ea",
                                                "sense_id": "95227d6e-cd10-37c5-af03-b7f5495a3e8f",
                                                "text": "The peace plan was representative of Benedict's inability to appear as a neutral broker of peace"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d398019-76e6-37d5-955c-a6b333fbae34",
                                        "entry_id": "3c7518e2-1942-3f1f-81c2-9b791c0dd815",
                                        "glosses": [
                                            "An agent involved in the exchange of messages or transactions."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "broker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d4fecd4-7d81-36b9-830d-3e8d6ad99749",
                                        "entry_id": "72b4ecd2-97c8-3857-adfb-84e0e66e800d",
                                        "glosses": [
                                            "To act as a broker; to mediate in a sale or transaction."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79369f23-7d1a-3bca-a4f2-99bca02d2432",
                                        "entry_id": "72b4ecd2-97c8-3857-adfb-84e0e66e800d",
                                        "glosses": [
                                            "To act as a broker in; to bring about through brokering or negotiation; to arrange or negotiate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abcd72cd-1b3b-4336-9086-5ccc19708ec0",
                                                "sense_id": "79369f23-7d1a-3bca-a4f2-99bca02d2432",
                                                "text": "When you first arrived on Menae, I had a hard time seeing how you flying off with one of our best generals would benefit our fight against the Reapers. However, as I now watch turian and krogan fighters working together to take down a Reaper destroyer, I must admit I am impressed. You've brokered an alliance that many thought impossible."
                                            },
                                            {
                                                "example_id": "5d2fd6a7-92b4-4233-b733-1340290e722a",
                                                "sense_id": "79369f23-7d1a-3bca-a4f2-99bca02d2432",
                                                "text": "In Armando Iannucci’s sitcom The Thick of It, government spin doctor Malcolm Tucker brokers a peace with his opposition counterpart."
                                            },
                                            {
                                                "example_id": "c2ac6425-afb5-4ea5-b957-0a7794a3d0f7",
                                                "sense_id": "79369f23-7d1a-3bca-a4f2-99bca02d2432",
                                                "text": "\"To help Eurostar survive, we brokered an agreement with the ORR and Department for Transport to defer part of their charging regime, and that helped its liquidity... that was the only way that it could survive."
                                            },
                                            {
                                                "example_id": "74f9958d-3448-4d8b-b8dd-45a19a0b7040",
                                                "sense_id": "79369f23-7d1a-3bca-a4f2-99bca02d2432",
                                                "text": "He would be well advised to be cautious, despite the fragile ceasefire that the US President Donald Trump and the Emir of Qatar brokered. Though President Trump reportedly told Israel not to kill Iran's supreme leader, Israeli Prime Minister Benjamin Netanyahu did not rule it out."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
