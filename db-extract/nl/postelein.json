                    {
                        "sense_id": "857afa39-aaf7-39c0-94e7-3e5253f13983",
                        "entry_id": "562d7c18-060f-34dd-b906-745f9f702658",
                        "glosses": [
                            "Portulaca oleracea (syn. Portulaca sativa) een eenjarige plant, die behoort tot de posteleinfamilie (Portulacaceae). De soort komt van nature voor in India en het Midden-Oosten. De opgaande vorm van postelein wordt in Azië, Suriname, Griekenland, België en Nederland gebruikt als groente. In Iran wordt de groente al meer dan 2000 jaar gegeten. Ook bestaan er cultivars met grote bloemen voor de siertuin"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6fafca30-4f95-3ecd-a2e0-be4a82a59c91",
                        "entry_id": "562d7c18-060f-34dd-b906-745f9f702658",
                        "glosses": [
                            "blad van de Portulaca oleracea, gebruikt als voedsel"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f8e7551-f6cc-4e86-ac98-3639b2ed0242",
                        "source_entry_id": "562d7c18-060f-34dd-b906-745f9f702658",
                        "source_sense_id": "857afa39-aaf7-39c0-94e7-3e5253f13983",
                        "source_sense_description": "bepaalde soort eenjarige groene plant, Portulaca oleracea",
                        "target_lang_word": "Portulak",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Portulak",
                                "target_lang_code": "de",
