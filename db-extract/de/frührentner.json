                                        "glosses": [
                                            "Relatif à une personne en préretraite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18dbacd5-6ed5-4f8a-86a0-f61b76f69e2e",
                                                "sense_id": "88ba7ae8-3b87-3aa1-98af-6bc02b0ceb4a",
                                                "text": "Les conclusions de cette étude des baux inquiètent Louis Plamondon, président de l’Association québécoise de défense des droits des personnes retraitées et préretraitées."
                                            }
                                        ]
                                    }
