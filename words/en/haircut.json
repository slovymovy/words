                            },
                            {
                                "target_lang_word": "剪发",
                                "target_lang_sense_clarification": "剪头发的动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3582c1a2-3e2a-3307-8e05-c90d2320ea55",
                    "sense_definition": "The specific style or shape into which the hair is cut.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "hair_grooming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She showed off her new <w>haircut</w> to her friends at school.",
                            "target_lang_translations": {
                                "ru": "Она похвасталась своей новой <w>стрижкой</w> перед школьными друзьями.",
                                "zh": "她在学校向朋友们展示了她的新<w>发型</w>。"
                            }
                        },
                        {
                            "text": "That short <w>haircut</w> really suits the shape of your face.",
                            "target_lang_translations": {
                                "ru": "Эта короткая <w>стрижка</w> действительно подходит к форме твоего лица.",
                                "zh": "那个短<w>发型</w>真的很适合你的脸型。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hairstyle"
                    ],
                    "common_phrases": [
                        "new haircut",
                        "short haircut",
                        "bad haircut"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенный стиль или форма, придаваемая волосам.",
                        "zh": "头发被剪成的特定样式或形状。"
                    },
                    "translations": {
