                    {
                        "sense_id": "5fe8961d-04b0-32c8-b5f5-d222fa046052",
                        "entry_id": "23d2c0d4-7367-3807-aff9-d1db263af1df",
                        "glosses": [
                            "das Fest Erscheinung des Herrn/Epiphanie am 6. Januar"
                        ],
                        "tags": [
                            "Kalender"
                        ],
                        "examples": [
                            {
                                "example_id": "39c692fe-6da2-42a2-9740-f7444d054d00",
                                "sense_id": "5fe8961d-04b0-32c8-b5f5-d222fa046052",
                                "text": "In Baden-Württemberg ist der Dreikönigstag ein gesetzlicher Feiertag."
                            },
                            {
                                "example_id": "24d9b054-756c-4e62-8273-06f1e7c86a93",
                                "sense_id": "5fe8961d-04b0-32c8-b5f5-d222fa046052",
                                "text": "„Der Dreikönigstag ist leider ein Sonntag, daher gilt es dann von Jänner bis Ende März, eine ziemliche Durststrecke zu überwinden - kein Feiertag, geschweige denn Fenstertag in Sicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
