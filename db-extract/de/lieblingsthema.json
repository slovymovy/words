                ],
                "senses": [
                    {
                        "sense_id": "d337d0b2-6a62-35ee-bc1a-228cbf1d43e9",
                        "entry_id": "772596ec-917e-3fa8-8787-07ea62aba30d",
                        "glosses": [
                            "Thema, über das sich jemand besonders gern/oft auslässt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb699e81-d23f-47b4-a8e7-aa09ce49d159",
                                "sense_id": "d337d0b2-6a62-35ee-bc1a-228cbf1d43e9",
                                "text": "„Angela ließ sich in höchsten Tönen über gute Schulen und billigen Wein aus, bevor sie zu ihrem Lieblingsthema kam.“"
                            },
                            {
                                "example_id": "64bc35b1-18ee-4cd9-b1dd-eb9d2b8a2011",
                                "sense_id": "d337d0b2-6a62-35ee-bc1a-228cbf1d43e9",
                                "text": "„Auf das Lieblingsthema des Vaters, geringschätzige Witzeleien über die Militärs der Gegenwart und besonders über Bonaparte, ging er nicht ein.“"
                            },
                            {
                                "example_id": "64a294dc-1872-48b8-889d-fdcbd1bc8d2a",
                                "sense_id": "d337d0b2-6a62-35ee-bc1a-228cbf1d43e9",
                                "text": "„Remarque kehrt in diesem Roman zu einem seiner Lieblingsthemen zurück.“"
                            },
                            {
                                "example_id": "56b1b8ac-4d4c-4fe5-9c71-c9ad83286282",
                                "sense_id": "d337d0b2-6a62-35ee-bc1a-228cbf1d43e9",
                                "text": "„Aber dann, mit fünfzehn, ließ sich das Thema nicht mehr vermeiden, es schien das zu sein, worüber alle sprachen, es war in jeder Mädchenzeitschrift, es war im Fernsehen, und es war Milenas Lieblingsthema: die Liebe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
