                                        "examples": [
                                            {
                                                "example_id": "31970f51-9b73-40be-aed4-c818839dfe54",
                                                "sense_id": "c19a7948-d1be-3f89-8475-a391fbae1025",
                                                "text": "The Acting Minister must sign Executive Council documents in a Minister's absence."
                                            },
                                            {
                                                "example_id": "ad6225de-4b70-485e-a228-298b96f72235",
                                                "sense_id": "c19a7948-d1be-3f89-8475-a391fbae1025",
                                                "text": "The CEO is currently in a hospital. The CFO is acting CEO in the meantime."
                                            },
                                            {
                                                "example_id": "c7875055-6bce-4539-b518-6b00752d27d3",
                                                "sense_id": "c19a7948-d1be-3f89-8475-a391fbae1025",
                                                "text": "Amy Gleason is the acting administrator of the US DOGE Service, the agency that houses the temporary Department of Government Efficiency, a White House official told CNN on Tuesday."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
