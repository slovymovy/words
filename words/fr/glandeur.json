                    "sense_id": "7112dabb-4ca3-3c2e-8fb3-be935bcbbacc",
                    "sense_definition": "Personne oisive qui évite l'effort et passe son temps à ne rien faire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "paresse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis qu'il a terminé ses examens, il passe ses journées sur le canapé comme un vrai <w>glandeur</w>.",
                            "target_lang_translations": {
                                "en": "Ever since he finished his exams, he's been spending his days on the sofa like a real <w>slacker</w>.",
                                "ru": "С тех пор как он закончил экзамены, он проводит дни на диване, как настоящий <w>лентяй</w>.",
                                "nl": "Sinds hij zijn examens heeft afgerond, brengt hij zijn dagen op de bank door als een echte <w>luiaard</w>.",
                                "de": "Seit er seine Prüfungen abgeschlossen hat, verbringt er seine Tage auf dem Sofa wie ein echter <w>Faulenzer</w>.",
                                "pl": "Odkąd skończył egzaminy, spędza dnie na kanapie jak prawdziwy <w>leń</w>.",
                                "it": "Da quando ha finito gli esami, passa le sue giornate sul divano come un vero <w>fannullone</w>.",
                                "cs": "Od té doby, co dokončil zkoušky, tráví dny na gauči jako pravý <w>flákač</w>.",
                                "tr": "Sınavlarını bitirdiğinden beri günlerini kanepede geçiriyor, tam bir <w>tembel</w> gibi.",
                                "es": "Desde que terminó sus exámenes, pasa los días en el sofá como un verdadero <w>vago</w>.",
                                "zh": "自从考完试，他整天窝在沙发上，活脱脱一个真正的<w>懒鬼</w>。"
                            }
                        },
                        {
                            "text": "Son colocataire est un <w>glandeur</w> de première qui ne fait jamais la vaisselle.",
                            "target_lang_translations": {
                                "en": "His flatmate is a first-class <w>slacker</w> who never does the dishes.",
                                "ru": "Его сосед по квартире — первоклассный <w>лентяй</w>, который никогда не моет посуду.",
                                "nl": "Zijn huisgenoot is een volleerde <w>luiaard</w> die nooit de afwas doet.",
                                "de": "Sein Mitbewohner ist ein <w>Faulenzer</w> erster Güte, der nie den Abwasch macht.",
                                "pl": "Jego współlokator to <w>leń</w> pierwszej wody, który nigdy nie zmywa naczyń.",
                                "it": "Il suo coinquilino è un <w>fannullone</w> di prima categoria che non fa mai i piatti.",
                                "cs": "Jeho spolubydlící je <w>flákač</w> prvního řádu, který nikdy nemyje nádobí.",
                                "tr": "Ev arkadaşı, hiç bulaşık yıkamayan birinci sınıf bir <w>tembel</w>.",
                                "es": "Su compañero de piso es un <w>vago</w> de primera que nunca lava los platos.",
                                "zh": "他的室友是个十足的<w>懒虫</w>，从来不洗碗。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fainéant",
                        "flemmard",
                        "paresseux"
