                "senses": [
                    {
                        "sense_id": "d5616c79-4443-3c83-ab00-1f8421584023",
                        "entry_id": "a00878e0-9866-3800-80d9-7e495d989ef6",
                        "glosses": [
                            "Gebäude, in dem Aufführungen im Rahmen von Festspielen stattfinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c01e9e8c-ec7f-4ea3-8a62-48fafdca6504",
                                "sense_id": "d5616c79-4443-3c83-ab00-1f8421584023",
                                "text": "Eingepackt in ein oranges Batikmusterkleid, lockte sie im Großen Festspielhaus mit glockenhellem Timbre in üppige Gefilde."
                            },
                            {
                                "example_id": "e9071887-4648-4b05-a4a1-4e91e873fdcd",
                                "sense_id": "d5616c79-4443-3c83-ab00-1f8421584023",
                                "text": "„Rund 400 Blasmusiker haben sich am Samstag vor dem Festspielhaus versammelt, um für den Erhalt der Militärmusik zu demonstrieren.“"
                            },
                            {
                                "example_id": "ac70e095-2f78-465b-a185-9283000e29dd",
                                "sense_id": "d5616c79-4443-3c83-ab00-1f8421584023",
                                "text": "„Als Zuschauer verfolgt man den zum Teil urkomischen Schlagabtausch - noch bevor der erste Ton aus dem Graben des Großen Salzburger Festspielhauses ertönt - nur über die Übertitelungsanlage.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
