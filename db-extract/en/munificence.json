                    },
                    {
                        "translation_id": "4c116713-eb6e-4b8a-8bc1-d839bf9c130d",
                        "source_entry_id": "83e3f4a7-f0c1-30f1-a82b-4df546bb2d80",
                        "source_sense_id": "8414f495-3b88-3a95-84de-e0fdd135c3b6",
                        "source_sense_description": "the quality of being munificent; generosity",
                        "target_lang_word": "générosité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "générosité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2e7cb7ba-ac98-3b4a-a295-e3f94d604b0f",
                                        "entry_id": "d78f48d2-77ee-30c1-b6f4-e87a6c2fe2b7",
                                        "glosses": [
                                            "Disposition à donner plus qu’on n’est tenu de donner et à recevoir moins qu’on pourrait réclamer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55357a90-c84a-4d20-9712-edc93494e5b5",
                                                "sense_id": "2e7cb7ba-ac98-3b4a-a295-e3f94d604b0f",
                                                "text": "Sa générosité n'est pas faiblesse ; son obligeance ne dépasse pas les obligations normales et naturelles ; aucune arrière-pensée en son comportement."
                                            },
                                            {
                                                "example_id": "0001200f-2370-4aba-8a1c-c0ad8411e80b",
                                                "sense_id": "2e7cb7ba-ac98-3b4a-a295-e3f94d604b0f",
                                                "text": "À son hypocrite travail d’approche, n’avaient répondu que des demi-promesses et de menues privautés, en échange de gestes de générosité financière d’importance croissante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "009b63e1-f16e-31f4-aeba-e119b727c559",
                                        "entry_id": "d78f48d2-77ee-30c1-b6f4-e87a6c2fe2b7",
                                        "glosses": [
                                            "Noblesse, élévation de sentiments."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f9cff8a-7411-4cd4-b351-3847735b02cc",
                                                "sense_id": "009b63e1-f16e-31f4-aeba-e119b727c559",
                                                "text": "Au début de son pontificat, il s'était, il est vrai, montré bienveillant, moins par générosité naturelle, que dans le dessein de favoriser la conversion des juifs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38ca1a12-783b-302d-bbf5-83b26c3cf181",
                                        "entry_id": "d78f48d2-77ee-30c1-b6f4-e87a6c2fe2b7",
                                        "glosses": [
                                            "Actes de générosité."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c41f912c-f0ef-4b2c-a511-98de696afa6a",
                                                "sense_id": "38ca1a12-783b-302d-bbf5-83b26c3cf181",
                                                "text": "Faire des générosités."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77a8b3dc-2b46-4eaf-9c51-3ae51d2c872c",
                        "source_entry_id": "83e3f4a7-f0c1-30f1-a82b-4df546bb2d80",
                        "source_sense_id": "8414f495-3b88-3a95-84de-e0fdd135c3b6",
                        "source_sense_description": "the quality of being munificent; generosity",
                        "target_lang_word": "munificence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "munificence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "216dc9ec-71a4-3a2c-9501-3acf37a4a14b",
                                        "entry_id": "20338ab0-3d54-3daf-bf3e-31af576cb9fe",
                                        "glosses": [
                                            "Disposition qui porte à faire de grandes libéralités."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9a5c20d-72b9-4a8c-a1fc-b101bf10ea95",
                                                "sense_id": "216dc9ec-71a4-3a2c-9501-3acf37a4a14b",
                                                "text": "…, ces moines, logés nourris et vêtus gratuitement dans des monastères fondés et dotés par la munificence des rois, des seigneurs de terre ou des fidèles, pouvaient donner à des prix très-modiques la publicité aux ouvrages de l’esprit."
                                            },
                                            {
                                                "example_id": "fa3eacba-7902-49b3-9bb0-428ff2990d81",
                                                "sense_id": "216dc9ec-71a4-3a2c-9501-3acf37a4a14b",
                                                "text": "Ce naïf soldat, […], se crut l’homme le plus heureux du monde, en se voyant propriétaire d’une maison que la munificence de son chef garnit d’un joli mobilier, […]"
                                            },
                                            {
                                                "example_id": "c8e3d25d-2fd0-4d9b-8835-22ad74bf5eff",
                                                "sense_id": "216dc9ec-71a4-3a2c-9501-3acf37a4a14b",
                                                "text": "Si l’on donne foi au bruit généralement accrédité d’une promesse de subside en hommes et en argent faite par la ville affranchie, […], on aura trouvé le secret de cette munificence."
                                            },
                                            {
                                                "example_id": "4fa70c32-a03d-4eb0-b235-6e96350808c7",
                                                "sense_id": "216dc9ec-71a4-3a2c-9501-3acf37a4a14b",
                                                "text": "Melvin Phelps passait de groupe en groupe pour s’excuser que le buffet n'atteigne pas à la munificence de l’an dernier."
                                            },
                                            {
                                                "example_id": "d9de4e56-d62f-4def-b864-971b26fa8aad",
                                                "sense_id": "216dc9ec-71a4-3a2c-9501-3acf37a4a14b",
                                                "text": "Marius ne possède que deux livrées qu'il doit à la misérable munificence de mon pauvre papa, et je ne crois pas qu'il ait un costume en propre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1050d0e-3d0b-42b7-a0a9-d7d7bc4f5597",
                        "source_entry_id": "83e3f4a7-f0c1-30f1-a82b-4df546bb2d80",
