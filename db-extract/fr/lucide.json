        "fr-extract.jsonl": [
            {
                "entry_id": "b99c519e-b74a-3e28-a259-03073559f742",
                "word": "lucide",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a6fd3603-cc8d-406b-8ba2-5bf1e4933b6d",
                        "entry_id": "b99c519e-b74a-3e28-a259-03073559f742",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "lucides"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2f6cf9aa-a8ee-3f0a-9c29-b322d0b396b2",
                        "entry_id": "b99c519e-b74a-3e28-a259-03073559f742",
                        "glosses": [
                            "Qui conçoit les choses clairement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b77a3a28-0e24-4a6a-be5b-99506ad7a056",
                                "sense_id": "2f6cf9aa-a8ee-3f0a-9c29-b322d0b396b2",
                                "text": "On n’est jamais trop lucide, et mieux vaut, dans le doute, noircir le tableau, au moins intellectuellement, que l’enjoliver : cela évitera imprudences et désillusions."
                            },
                            {
                                "example_id": "fe1cbaf8-23c6-4a2d-85e5-f09e9d74d820",
                                "sense_id": "2f6cf9aa-a8ee-3f0a-9c29-b322d0b396b2",
                                "text": "Un esprit lucide."
                            },
                            {
                                "example_id": "fc9faa74-6714-4cc1-b9b4-d855f8c10b77",
                                "sense_id": "2f6cf9aa-a8ee-3f0a-9c29-b322d0b396b2",
                                "text": "Des idées lucides."
                            },
                            {
                                "example_id": "ebcc3217-4489-4371-855b-bea5b5e19ea0",
                                "sense_id": "2f6cf9aa-a8ee-3f0a-9c29-b322d0b396b2",
                                "text": "Des raisonnements lucides."
                            }
                        ]
                    },
                    {
                        "sense_id": "1caff4b6-8166-3798-9c42-9a302e7a7201",
                        "entry_id": "b99c519e-b74a-3e28-a259-03073559f742",
                        "glosses": [
                            "Qui perçoit les choses clairement."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "81f47526-781c-4de8-ba87-98f5f9b8884c",
                                "sense_id": "1caff4b6-8166-3798-9c42-9a302e7a7201",
                                "text": "Ces messieurs étaient attablés autour de vichy-fraise et de vittel-cassis, innocents breuvages qui, […], jouissent d'une rassurante vertu, laissant le cerveau lucide quand on se voit obligé de boire souvent et qu'on ne veut pas courir le risque de s'enivrer."
                            }
                        ]
                    },
                    {
                        "sense_id": "5627663c-3a0f-3e52-bd69-c5ddbab84a2d",
                        "entry_id": "b99c519e-b74a-3e28-a259-03073559f742",
                        "glosses": [
                            "Dont la raison revient par intervalles, en parlant d’une personne dont la tête est dérangée."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "4ed87557-fce5-43c2-b6bf-d21178603c33",
                                "sense_id": "5627663c-3a0f-3e52-bd69-c5ddbab84a2d",
                                "text": "Elle se leva, très faible mais l'esprit lucide. Chose singulière ! C'est à peine si elle se rendait compte de ce qui se passait en ces heures d'ivresse."
                            }
                        ]
                    },
                    {
                        "sense_id": "466ae1ea-8033-3855-8ed1-7e66f3260eef",
                        "entry_id": "b99c519e-b74a-3e28-a259-03073559f742",
                        "glosses": [
                            "Transparent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8da4cd15-c3f1-4cff-8e0e-6a73989d6422",
                                "sense_id": "466ae1ea-8033-3855-8ed1-7e66f3260eef",
                                "text": "Jeanne, je vous apporterai des cires colorées et lucides comme des joyaux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6bb8abbd-4e7e-4ec0-b79b-096cbcbb83ef",
                        "source_entry_id": "b99c519e-b74a-3e28-a259-03073559f742",
                        "target_lang_word": "lucid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lucid",
