    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "93643b52-87ba-3cb0-90f0-708b7dfda346",
                "word": "imbecility",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b49dfe8b-37f7-4187-a069-b2858e655651",
                        "entry_id": "93643b52-87ba-3cb0-90f0-708b7dfda346",
                        "tags": [
                            "plural"
                        ],
                        "form": "imbecilities"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9dac915f-553c-3fed-8aa7-7c904aa08ba4",
                        "entry_id": "93643b52-87ba-3cb0-90f0-708b7dfda346",
                        "glosses": [
                            "The quality of being imbecile; weakness; feebleness, especially of mind."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a12dee79-f749-4ca1-99ce-d0da588c00a5",
                                "sense_id": "9dac915f-553c-3fed-8aa7-7c904aa08ba4",
                                "text": "The police prosecutor hammered at him and the bench had a go at him, and they commanded from him such a madhouse particularity between the distinctions of looking and seeing that Bradly was reduced to imbecility, and so contradictious were his mutterings that he was openly suspected of trying to shield that wretched tramp, whom Bradly would have gladly seen sunk in the bottomless pit reserved for snoopers."
                            }
                        ]
                    },
                    {
                        "sense_id": "4379559f-3985-3561-89a6-51c321ae9229",
                        "entry_id": "93643b52-87ba-3cb0-90f0-708b7dfda346",
                        "glosses": [
                            "Something imbecilic; a stupid action, behaviour, etc."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b3801e1c-13e1-494c-a52f-24f87b2c35e3",
                                "sense_id": "4379559f-3985-3561-89a6-51c321ae9229",
                                "text": "The Parnassian theory of art is mere imbecility."
                            },
                            {
                                "example_id": "302b1e77-8471-4b98-87ca-7b029a6c50fe",
                                "sense_id": "4379559f-3985-3561-89a6-51c321ae9229",
                                "text": "The procedure of musical comedy is not reducible to a coherent formula, so that its imbecilities may be annotated by super imbecilities."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f673409-90ad-4071-b476-9fa19dc8a929",
                        "source_entry_id": "93643b52-87ba-3cb0-90f0-708b7dfda346",
                        "source_sense_description": "quality of imbecile, stupid behaviour",
                        "target_lang_word": "imbécilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imbécilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f4f2da34-be64-344a-b8d7-5c3783d0dba2",
                                        "entry_id": "8d96e443-a8c6-388c-ad6f-693c12900948",
                                        "glosses": [
                                            "Variante orthographique de imbécillité."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01b613a4-d3e7-495b-a2aa-aec5d3bfb6dd",
                                                "sense_id": "f4f2da34-be64-344a-b8d7-5c3783d0dba2",
                                                "text": "Seguin, à la fin du XIXᵉ siècle, isole à nouveau l’idiotie et l’imbécilité dont il reconnaît l’incurabilité, de l’« arriération mentale » caractérisée par une lenteur plus ou moins récupérable du développement intellectuel."
                                            },
                                            {
                                                "example_id": "1d34cd2f-0f27-4dd1-8e23-90d67926daa7",
                                                "sense_id": "f4f2da34-be64-344a-b8d7-5c3783d0dba2",
                                                "text": "La puérilité est assimilée à l’imbécilité."
                                            },
                                            {
                                                "example_id": "08db1747-97f1-497d-ad58-cc9e07b76fa8",
                                                "sense_id": "f4f2da34-be64-344a-b8d7-5c3783d0dba2",
                                                "text": "Mais la veritable sagesse en découvre tout la fourberie, et fait voir sensiblement l’iniquité de ses loix et de ses maximes, et fait sentir l’imbécilité de ceux qui se soumettent volontairement à son joug."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e3614cc-0f1f-4c8b-ad22-e773757a99c7",
