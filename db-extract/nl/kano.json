                                "sense_id": "47d935d9-f3c7-3000-8abf-47a420dc4705",
                                "text": "We peddelden met de kano over de rustige rivier.",
                                "translation": "We paddled the canoe along the calm river.",
                                "english": "We paddled the canoe along the calm river."
                            },
                            {
                                "example_id": "c150089f-1e00-4ffc-9419-3305ec474279",
                                "sense_id": "47d935d9-f3c7-3000-8abf-47a420dc4705",
                                "text": "De kinderen vonden het leuk om in de kano's te varen tijdens het zomerkamp.",
                                "translation": "The children enjoyed paddling in the canoes during summer camp.",
                                "english": "The children enjoyed paddling in the canoes during summer camp."
                            },
                            {
                                "example_id": "9a166a0c-295f-4a74-9cd3-378b924447bc",
                                "sense_id": "47d935d9-f3c7-3000-8abf-47a420dc4705",
                                "text": "Huur een kanootje en geniet van een ontspannen dag op het meer.",
                                "translation": "Rent a little canoe and enjoy a relaxing day on the lake.",
                                "english": "Rent a little canoe and enjoy a relaxing day on the lake."
                            }
                        ]
