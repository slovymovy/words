                ],
                "senses": [
                    {
                        "sense_id": "c38d3262-95f3-3232-aa54-56b675d1d776",
                        "entry_id": "092e270a-7191-3eda-998d-8d7065ce7b98",
                        "glosses": [
                            "первичная партийная организация, насчитывающая менее 15 человек; подразделение в крупной первичной партийной организации"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d32755d5-a9a0-4a8f-948a-f8d5c3081227",
                                "sense_id": "c38d3262-95f3-3232-aa54-56b675d1d776",
                                "text": "Все усилия партгруппы и рабочих направлены на борьбу с браком."
                            },
                            {
                                "example_id": "e7a9f869-7b0b-4a15-ab62-7383701108c0",
                                "sense_id": "c38d3262-95f3-3232-aa54-56b675d1d776",
                                "text": "Вместо серьезного разбора секретарь парткома на собрании партгруппы Физиологического института в мягком тоне указал т. Айрапетьянцу на недопустимость таких фактов, как посещение квартиры врага народа и связь с племянницей Рыкова."
                            }
                        ]
                    },
                    {
                        "sense_id": "8293443d-3028-3bc0-a339-2df58512e2ad",
                        "entry_id": "092e270a-7191-3eda-998d-8d7065ce7b98",
                        "glosses": [
                            "заседание такого подразделения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9b4ea9e-eba9-4f79-b754-4f364d66ed66",
                                "sense_id": "8293443d-3028-3bc0-a339-2df58512e2ad",
                                "text": "Пива я все же выпил, побрился и пошел на партгруппу…"
                            },
                            {
                                "example_id": "75fcdcb4-7822-4050-b388-439d04136a39",
                                "sense_id": "8293443d-3028-3bc0-a339-2df58512e2ad",
                                "text": "Говорили, что еще на партгруппе сомневались: почему беспартийный?"
                            }
                        ]
                    }
                ],
