                ],
                "senses": [
                    {
                        "sense_id": "9d8be629-e7cd-3569-a554-2a5d172b5d51",
                        "entry_id": "60fdad90-4de5-3740-8fd6-747c07b0ceab",
                        "glosses": [
                            "bestehende Gesamtheit der Versorgung mit Strom aus ganz unterschiedlichen Energieträgern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a7b16b4-106c-4b80-ab3d-57c16db6804e",
                                "sense_id": "9d8be629-e7cd-3569-a554-2a5d172b5d51",
                                "text": "„Wir arbeiten daran, immer mehr Windstrom aus eigenen Anlagen in unseren Strommix zu integrieren.“"
                            },
                            {
                                "example_id": "25efa062-9939-4950-acfa-1c5759a6209c",
                                "sense_id": "9d8be629-e7cd-3569-a554-2a5d172b5d51",
                                "text": "„Der Emissionsfaktor für den deutschen Strommix wird berechnet aus den direkten CO2-Emissionen die bei der gesamten Stromerzeugung entstehen und den für den Endverbrauch netto zur Verfügung stehenden Strom aus der Stromerzeugung in Deutschland.“"
                            },
                            {
                                "example_id": "6c824447-63bd-48b2-8fce-1a6bee2fd47e",
                                "sense_id": "9d8be629-e7cd-3569-a554-2a5d172b5d51",
                                "text": "„Der Strommix eines Energieversorgers ist die prozentuale Aufteilung seiner Stromlieferungen nach Primärenergieträgern.“"
                            },
                            {
                                "example_id": "c77592c4-7770-41be-b1fe-6228658c0153",
                                "sense_id": "9d8be629-e7cd-3569-a554-2a5d172b5d51",
                                "text": "„In diesem Fall gibt der Strommix an, welche prozentuale Zusammensetzung der Strom zu einem bestimmten Zeitpunkt im gesamten deutschen Stromnetz hat.“"
                            },
                            {
                                "example_id": "125df13b-09fc-4471-800e-e619691f7cad",
                                "sense_id": "9d8be629-e7cd-3569-a554-2a5d172b5d51",
                                "text": "„Die Energieversorger, bei denen Verbraucher Strom kaufen , beziehen ihren Strom aus unterschiedlichen Erzeugerquellen. Da die Produktion von Strom je nach Stromerzeugungsart mit unterschiedlich hohen CO2-Emissionen verbunden ist, gibt der Strommix Auskunft über die CO2-Intensität des Stroms.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
