                "senses": [
                    {
                        "sense_id": "bfaa6d0f-d272-3e65-b6a7-1432f4951db0",
                        "entry_id": "832f53b1-8b4d-3d13-93ea-ad2d221851fb",
                        "glosses": [
                            "wielka gwiazda, gwiazdozbiór lub kometa"
                        ],
                        "tags": [
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "d02c5f94-5f09-45c0-84a0-95c37b5fa366",
                                "sense_id": "bfaa6d0f-d272-3e65-b6a7-1432f4951db0",
                                "text": "Ani gwiaździce, co się w morzach palą, / A mają w świetle tęczowe kolory / I są gwiazdami w ciemnicy pod falą / Tak błyszczącymi, że mórz dziwotwory,"
                            },
                            {
                                "example_id": "382d93e9-582f-415b-b8a6-3183d5e530d5",
                                "sense_id": "bfaa6d0f-d272-3e65-b6a7-1432f4951db0",
                                "text": "Zjawia się, święta miesięczna dziewica / Łąki mgłą śćmione … przesrebrna gwiaździca / Srebrną swą strzałą rani i przenika."
                            },
                            {
                                "example_id": "6ad35a70-2794-44fd-8a6f-798e6fc28e66",
                                "sense_id": "bfaa6d0f-d272-3e65-b6a7-1432f4951db0",
                                "text": "Wróć, czekam cię tęskliwie, drogo moja srebrna, / Zasłuchana w księżyce, gwiaździce i słońca!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
