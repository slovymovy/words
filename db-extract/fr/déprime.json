                    },
                    {
                        "translation_id": "668a39f5-65a0-4923-a026-fe51d046b318",
                        "source_entry_id": "78938a18-f2ba-322e-9030-c75132ba6834",
                        "source_sense_id": "6edc80e8-a9d0-3b18-bd0f-041c24f7d4f1",
                        "source_sense_description": "umgangssprachlich, übertragen: Flaute",
                        "target_lang_word": "Flaute",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flaute",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9fc3a366-1cd5-3792-850a-2c19d56180e5",
                                        "entry_id": "fc4ee122-9231-3340-a7f1-62a46e104cc4",
                                        "glosses": [
                                            "Moment beziehungsweise Situation, in der kein Wind herrscht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa96260b-64ce-4f34-a0f5-98fec3b3c54f",
                                                "sense_id": "9fc3a366-1cd5-3792-850a-2c19d56180e5",
                                                "text": "Auf Grund der Flaute, konnte das Segelschiff nicht auslaufen."
                                            },
                                            {
                                                "example_id": "bd4da4ff-095b-4ed3-8fc3-9d639ae791b3",
                                                "sense_id": "9fc3a366-1cd5-3792-850a-2c19d56180e5",
                                                "text": "„Die Rückreise dauerte wegen häufiger Flauten und Gegenwind 66 Tage.“"
                                            },
                                            {
                                                "example_id": "78dd2b2f-a2ee-4279-a6ed-5d0fb24675bb",
                                                "sense_id": "9fc3a366-1cd5-3792-850a-2c19d56180e5",
                                                "text": "„Sie lag wie wir in der Flaute, und die Schiffe ankerten ein wenig verstreut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "979a09ef-2e82-30a5-b4f6-0483d1d70611",
                                        "entry_id": "fc4ee122-9231-3340-a7f1-62a46e104cc4",
                                        "glosses": [
                                            "geringe Nachfrage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a57f85ce-57df-4d5f-8c82-7f42c3668f14",
                                                "sense_id": "979a09ef-2e82-30a5-b4f6-0483d1d70611",
                                                "text": "Alle Kaufleute des Ortes beklagen die Flaute nach dem Bau der Ortsumfahrung."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5d4081a1-d476-340f-995f-e3ff46b6dcd4",
                                        "entry_id": "fc4ee122-9231-3340-a7f1-62a46e104cc4",
                                        "glosses": [
                                            "Stimmungstief, Motivationsschwäche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fab16f7-beb5-4ed4-9b15-e44152f6694d",
                                                "sense_id": "5d4081a1-d476-340f-995f-e3ff46b6dcd4",
                                                "text": "Nach der Flaute in der ersten Spielhälfte wollte der Trainer mehr Einsatz sehen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
