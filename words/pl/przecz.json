                    "sense_id": "e3bd9b49-7573-31ab-aaf7-1f67dfe4dd81",
                    "sense_definition": "druga osoba liczby pojedynczej trybu rozkazującego od czasownika <w>przeczyć</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie <w>przecz</w> jego słowom, dopóki sam nie sprawdzisz wszystkich faktów.",
                            "target_lang_translations": {
                                "en": "Do not <w>contradict</w> his words until you check all the facts yourself."
                            }
                        },
                        {
                            "text": "Mów prawdę i nie <w>przecz</w> temu, co przed chwilą sam widziałeś na własne oczy.",
                            "target_lang_translations": {
                                "en": "Tell the truth and do not <w>deny</w> what you saw with your own eyes just a moment ago."
                            }
                        }
                    ],
                    "synonyms": [
                        "zaprzeczaj"
                    ],
                    "antonyms": [
                        "potwierdzaj"
                    ],
                    "common_phrases": [
                        "nie przecz faktom"
                    ],
                    "traits": [
