                "senses": [
                    {
                        "sense_id": "b0e85e56-fe80-34c6-856e-8c6bf4fedfcf",
                        "entry_id": "f1798e62-1b2e-3deb-b001-bb8f31e961c6",
                        "glosses": [
                            "комплекс технических сооружений для снабжения водой города, жилья, сооружений и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d200d21f-d9bf-4044-ac3a-e8e0d20d2a78",
                                "sense_id": "b0e85e56-fe80-34c6-856e-8c6bf4fedfcf",
                                "text": "Саратовский водопровод, построенный ещё в 1927 году, сейчас уже с трудом справляется с нуждами растущего города, а город продолжает расти."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f1d47c4-49ae-48d2-8fd0-1a5ef4520881",
