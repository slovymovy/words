                    "sense_id": "0a95d991-aa14-31e7-945c-8fd5a1434dfe",
                    "sense_definition": "uroczyste porozumienie lub sojusz polityczny, wojskowy albo społeczny zawarty między państwami bądź grupami",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "polityka_i_stosunki",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Oba państwa postanowiły zawrzeć <w>przymierze</w> wojskowe w obliczu rosnącego zagrożenia.",
                            "target_lang_translations": {
                                "en": "Both countries decided to enter into a military <w>alliance</w> in the face of the growing threat."
                            }
                        },
                        {
                            "text": "Władcy podpisali tajne <w>przymierze</w>, które miało zapewnić im wzajemną pomoc.",
                            "target_lang_translations": {
                                "en": "The rulers signed a secret <w>alliance</w> that was meant to ensure mutual assistance."
                            }
                        }
                    ],
                    "synonyms": [
                        "sojusz",
                        "alians",
                        "koalicja",
                        "pakt",
                        "porozumienie",
                        "unia"
