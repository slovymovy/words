                                        "entry_id": "4c666428-eb03-34ee-babc-231c46e80637",
                                        "glosses": [
                                            "Écran orientable disposé au dessus du pare-brise d'un véhicule afin de protéger le conducteur de la lumière directe du soleil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b36f218-0b73-44db-95ad-a71a3a87a719",
                                                "sense_id": "e1daaa43-39be-3f1e-bf23-f5d85170fef9",
                                                "text": "Il abattit son pare-soleil et se regarda dans le miroir de courtoisie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "725ea42c-a1d4-3dfb-bd56-170b8e454f61",
                                        "entry_id": "4c666428-eb03-34ee-babc-231c46e80637",
                                        "glosses": [
                                            "Écran mobile ou fixe, intérieur ou extérieur limitant les apports lumineux ou thermiques du soleil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ec0ec73-dcd6-4109-b698-a004950d4712",
                                                "sense_id": "725ea42c-a1d4-3dfb-bd56-170b8e454f61",
                                                "text": "Si en vacances vous faites rimer repos avec une pointe de boulot, le pare-soleil Belveo vous évitera d’avoir le soleil en plein dans le rideau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e2c7e10-9c70-3406-a181-bd2a5a4c0f77",
                                        "entry_id": "4c666428-eb03-34ee-babc-231c46e80637",
                                        "glosses": [
                                            "Pièce amovible et opaque qui protège l’objectif des rayons du soleil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9945bfa-fe15-4734-ad7e-e913790a20c0",
                                                "sense_id": "1e2c7e10-9c70-3406-a181-bd2a5a4c0f77",
                                                "text": "Difficile de considérer le pare-soleil comme un accessoire, il est indispensable. Mais pas toujours fourni avec l'objectif. Un pare-soleil sert principalement à éviter le flare ([…])."
                                            }
                                        ]
                                    }
                                ]
                            }
