                ],
                "senses": [
                    {
                        "sense_id": "a2bd2099-d1c7-36c0-93d4-bbbe9e7f990c",
                        "entry_id": "3f72bde4-6ff0-34ed-b1e8-085c96339205",
                        "glosses": [
                            "mehr oder weniger rundes, meist durchbrochenes (je nach Verwendungszweck verschieden geformtes) Kunststoffelement an der Unterseite eines Skistocks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "499cb35a-f835-487e-bdc2-afdcee2a713c",
                                "sense_id": "a2bd2099-d1c7-36c0-93d4-bbbe9e7f990c",
                                "text": "„Die Skistöcke bohren sich in den Boden. Es ist schwer, sie aus dem tiefen Schnee zu ziehen. Der Skiteller, altmodisch, ein runder Ring, der mit einem Lederiemen am Stock befestigt ist, bleibt unten hängen.“"
                            },
                            {
                                "example_id": "9863bf51-1d7d-43fb-945f-ae67fe6d186e",
                                "sense_id": "a2bd2099-d1c7-36c0-93d4-bbbe9e7f990c",
                                "text": "„Tourenstöcke werden im Aufstieg meist 10–15 cm länger gestellt als in der Abfahrt, die Skiteller besitzen eine mittlere Größe.“"
                            },
                            {
                                "example_id": "ad4e9621-c165-43d8-a1fb-7113c3073022",
                                "sense_id": "a2bd2099-d1c7-36c0-93d4-bbbe9e7f990c",
                                "text": "„Das letzte Beinpaar trägt am vorletzten Beinglied abspreizbare Lamellen, die sich beim Vorwärtsschieben automatisch spreizen – wie ein Skiteller im Tiefschnee.“"
                            },
                            {
                                "example_id": "61cb44bb-20c1-4cbc-b65d-8242a3bad5a9",
                                "sense_id": "a2bd2099-d1c7-36c0-93d4-bbbe9e7f990c",
                                "text": "„Sind die Skistöcke verbogen bzw. geknickt? Sind die Skiteller intakt?“"
                            },
                            {
                                "example_id": "1de5c0ca-57ce-4fc2-8c14-0687b7c79833",
                                "sense_id": "a2bd2099-d1c7-36c0-93d4-bbbe9e7f990c",
                                "text": "„Wichtig bei diesem Sport ist es auch, die Wanderstöcke nicht zu vergessen: \"Bei den Stöcken darauf achten, dass Skiteller montiert sind\", ergänzt Wallinger.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
