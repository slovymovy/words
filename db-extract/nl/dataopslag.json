                        "glosses": [
                            "medium waar men informatie in vastlegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0198a492-1b0d-4e2c-ad4a-35dde9311dea",
                                "sense_id": "4715202f-eff5-363f-b704-201e2e7d000e",
                                "text": "Digitale dataopslag werkt met nullen en enen die in een bepaalde volgorde staan. De informatie ligt opgesloten in de volgorde van nullen en enen. Bij data-opslag in dna worden geen enen en nullen gebruikt, maar, simpel gezegd, de letters C, G, A en T. De data worden opgeslagen door een keten van die bouwstenen vast te leggen in een dna-streng, die ook weer kan worden afgelezen."
                            }
                        ]
