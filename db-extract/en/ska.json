        "de-extract.jsonl": [
            {
                "entry_id": "0d751a5d-39c9-3bd9-8b1d-6b11abc31c61",
                "word": "SKA",
                "pos": "abbrev",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "95b957f4-ae99-3383-b04a-2dc02cb0d914",
                        "entry_id": "0d751a5d-39c9-3bd9-8b1d-6b11abc31c61",
                        "glosses": [
                            "Abkürzung für Square Kilometer Array"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2dd468a-625d-47ce-9ea0-b7d93ba5010d",
                                "sense_id": "95b957f4-ae99-3383-b04a-2dc02cb0d914",
                                "text": "„Es ist ein Riesenteleskop für Radiowellen, das Astronomen gegenwärtig planen. Ebenso wie bei ähnlichen Vorläuferprojekten geht es nicht um eine einzelne Antenne. Vielmehr umfasst das «Square Kilometer Array», kurz SKA, 3000 miteinander verbundene Parabolantennen. Sie sollen sich über Ländergrenzen hinweg ersterechen, angeordnet auf einer riesigen Spirale. Die vorgesehene Gesamtfläche summiert sich zu einem Quadratkilometer und soll der Anlage eine bisher unerreichte Leitungsfähigkeit verleihen: 50-mal empfinlicher als jedes Radioteleskop zuvor soll sie sein. Für den Bau werden 1,5 Milliarden Euro veranschlagt, schon in drei Jahren könnte er beginnen.“"
                            },
                            {
                                "example_id": "c4bcb316-58f0-4999-aac3-4bfa5effbf12",
                                "sense_id": "95b957f4-ae99-3383-b04a-2dc02cb0d914",
                                "text": "The SKA will address fundamental unanswered questions about our Universe.",
                                "translation": "Das SKA wird auf bisher unbeantwortete, grundlegende Fragen über unser Universum antworten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
