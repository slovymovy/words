                        ],
                        "examples": [
                            {
                                "example_id": "690c8545-2583-4a27-8abb-291703c2a6c5",
                                "sense_id": "61af369d-0eee-397e-b42a-51f5fac8858b",
                                "text": "Omdat ik niet uit de toon wilde vallen, ontdeed ik mij geleidelijk aan van een paar slechte gewoonten, zoals op de grond spuwen, waarmee ik van kindsbeen af mijn viriliteit had aangegeven. (…) Maar nu ik me opmaak om terug te keren naar het nest, besef ik dat de eigenschappen die ik heb verworven helaas geen deugd meer zijn, maar een last. Hoe moet ik in hemelsnaam opnieuw leren om perfect te fluimen?"
                            }
                        ]
                    }
