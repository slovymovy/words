                                    {
                                        "sense_id": "0b725236-b4d9-3b79-8b67-fbffd903aed8",
                                        "entry_id": "92ace16a-f4d3-3923-8857-7890f58203c2",
                                        "glosses": [
                                            "Nachahmung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fc08d17-b2e2-4ebd-a6de-02c816c8f8b9",
                                                "sense_id": "0b725236-b4d9-3b79-8b67-fbffd903aed8",
                                                "text": "„Dennoch hält die Mimesis, die so verheerend wirkt, auch eine Lösung bereit.“"
                                            },
                                            {
                                                "example_id": "e662b040-cbc0-429d-a749-7dbbc06fe0f2",
                                                "sense_id": "0b725236-b4d9-3b79-8b67-fbffd903aed8",
                                                "text": "Mimesis ist mehr als bloße Nachbildung, mehr als Abbildung, sie beschreibt den ganzen kreativen Prozess des Nachbildens, der da in Gang gesetzt wird."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
