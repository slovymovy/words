                "senses": [
                    {
                        "sense_id": "0b60604e-f10c-3a45-9606-4ad1b68b784c",
                        "entry_id": "fb1c154e-bbdf-37c7-9487-30be7938b272",
                        "glosses": [
                            "lijst met de meest verkochte boeken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21c217cf-9203-4cc3-9ee1-314c62497888",
                                "sense_id": "0b60604e-f10c-3a45-9606-4ad1b68b784c",
                                "text": "De dienst, die opgezet wordt door de uitgeefconcerns WPG en LannooMeulenhoff, moet later dit jaar beschikbaar komen. De twee concerns hebben met uitgeverijen als De Bezige Bij, Bruna, Meulenhoff en Querido bijna de helft van de Nederlandstalige e-boekenmarkt in handen. Een groot deel van de bestsellerslijst zal via de dienst te lezen zijn."
                            },
                            {
                                "example_id": "e28c6057-2c36-47a6-a88e-067ff801ca64",
                                "sense_id": "0b60604e-f10c-3a45-9606-4ad1b68b784c",
                                "text": "Volgens directeur Chris Herschdorfer van uitgeverij Ambo Anthos kreeg de toch al goed lopende verkoop dit jaar een impuls nadat de roman in de bestsellerslijst van de New York Times was terechtgekomen."
                            },
                            {
                                "example_id": "55e23d1a-1439-4012-b7b3-bae1f4cb899c",
                                "sense_id": "0b60604e-f10c-3a45-9606-4ad1b68b784c",
                                "text": "Sinds het advocatenkantoor heeft gelekt dat de succesvolle Rowling Koekoeksjong heeft geschreven, staat het boek in de Britse bestsellerslijst en verschijnt de ene na de andere vertaling."
                            }
                        ]
                    }
