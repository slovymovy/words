                "senses": [
                    {
                        "sense_id": "53640580-bc4a-3822-9f3d-7521b8f58ce0",
                        "entry_id": "491bee3f-c826-38c1-8e8a-01aee88ed320",
                        "glosses": [
                            "legale Droge in vielen Getränken und Arzneien; Alkohol mit der Summenformel C₂H₅OH"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "102b3329-13f1-41e0-b8fc-aa81e72b8b53",
                                "sense_id": "53640580-bc4a-3822-9f3d-7521b8f58ce0",
                                "text": "Ethanol wird durch Gärung gewonnen."
                            },
                            {
                                "example_id": "31cb331f-487c-47ac-8177-f217c6fd6f7f",
                                "sense_id": "53640580-bc4a-3822-9f3d-7521b8f58ce0",
                                "text": "„In Brasilien tanken viele Autos E85, ein Gemisch aus 85% Ethanol und 15% Benzin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "633cce1b-8d18-401f-88ab-6884f587a58f",
                        "source_entry_id": "491bee3f-c826-38c1-8e8a-01aee88ed320",
                        "source_sense_id": "53640580-bc4a-3822-9f3d-7521b8f58ce0",
                        "target_lang_word": "ethanol",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ethanol",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87af4ace-57e7-3c82-bbda-ac747897d12c",
                                        "entry_id": "946b3039-f1d4-3c88-b500-0e64eaa73173",
                                        "glosses": [
                                            "A simple aliphatic alcohol formally derived from ethane by replacing one hydrogen atom with a hydroxyl group: CH₃-CH₂-OH."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5ed5333-904c-4526-a2c8-e05b176813f5",
                                                "sense_id": "87af4ace-57e7-3c82-bbda-ac747897d12c",
                                                "text": "Our stomachs and livers have an enzyme known as alcohol dehydrogenase that breaks down ethanol to make it less toxic for our bodies, said Atlanta gastroenterologist Dr. Preston Stewart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb52eba1-d61f-39aa-a412-86e697c07907",
                                        "entry_id": "946b3039-f1d4-3c88-b500-0e64eaa73173",
                                        "glosses": [
                                            "Specifically, this form of alcohol as a fuel."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b2a74d0-abd4-4d17-abad-1ef3dfc5f7a8",
                                                "sense_id": "bb52eba1-d61f-39aa-a412-86e697c07907",
                                                "text": "In 2007, not one drop of ethanol was produced in Ohio. Today, four ethanol facilities in Ohio are producing two hundred and ninety-five million gallons annually."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90387d3c-6978-40cc-ad6f-b43ec6010eea",
                        "source_entry_id": "491bee3f-c826-38c1-8e8a-01aee88ed320",
                        "source_sense_id": "53640580-bc4a-3822-9f3d-7521b8f58ce0",
                        "target_lang_word": "éthanol",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éthanol",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a1e82eb5-3e95-33b5-ad0d-69416456bde1",
                                        "entry_id": "ff077cde-3b8e-385d-9754-7e787c9283a1",
                                        "glosses": [
                                            "Alcool possédant la formule semi-développée suivante : CH₃-CH₂-OH et qui est l’alcool principal se trouvant dans les boissons alcoolisées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92a3a64e-55f8-4af3-b848-024cd3a2bb4f",
                                                "sense_id": "a1e82eb5-3e95-33b5-ad0d-69416456bde1",
                                                "text": "Un second procédé consiste à traiter le p-fluorophényl sulfinate de sodium par l’iodure d’éthyle dans l’éthanol."
                                            },
                                            {
                                                "example_id": "fab060da-2a24-40c1-932b-e9b4932dd9ed",
                                                "sense_id": "a1e82eb5-3e95-33b5-ad0d-69416456bde1",
                                                "text": "La température de la réaction, variable le long du lit catalytique, dépend d’une part des proportions d’air, d’éthanol et de vapeur d’eau et, d’autre part, de la vitesse de passage des gaz sur le catalyseur."
                                            },
                                            {
                                                "example_id": "ffd5c6db-78b8-4ac0-a8ac-aaabcaa00f6f",
                                                "sense_id": "a1e82eb5-3e95-33b5-ad0d-69416456bde1",
                                                "text": "Les Japonais, et même plus généralement les Asiatiques, tiennent très mal l’alcool, par suite du mauvais fonctionnement chez eux de l’aldéhyde déshydrogénase 2, qui assure la transformation de l’éthanol en acide acétique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
