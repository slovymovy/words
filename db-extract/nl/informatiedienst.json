                        "tags": [],
                        "examples": [
                            {
                                "example_id": "296e4703-c482-4576-bcaa-bd845372ef58",
                                "sense_id": "aa08b4c0-7516-387d-80c2-c247041a0c46",
                                "text": "Felle buien hebben verspreid over het land overlast veroorzaakt en niet alleen op de bevrijdingsfestivals. De Verkeers Informatiedienst (VID) waarschuwde automobilisten dat ze in het hele land rekening moesten houden met zware windstoten."
                            },
                            {
                                "example_id": "9d026a7e-c478-468e-a8e7-82bd67002d4a",
                                "sense_id": "aa08b4c0-7516-387d-80c2-c247041a0c46",
                                "text": "De BBC houdt vanavond definitief op met teletekst, dat in Engeland Ceefax heet. In grote delen van Groot-Brittannië was de informatiedienst in april al onbereikbaar geworden, maar na vanavond zijn de berichten ook voor kijkers in het zuidoosten van Engeland en Noord-Ierland niet meer te zien."
                            }
                        ]
