                                "target_senses": [
                                    {
                                        "sense_id": "38735ace-b00e-3bdd-8801-2c26a0fecf4e",
                                        "entry_id": "9f585cc9-b1dd-3631-b173-31d3cfaea4a6",
                                        "glosses": [
