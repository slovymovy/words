                    {
                        "sense_id": "dbf6c2ed-7d21-3437-ae3a-82f093fa8c18",
                        "entry_id": "7f74b481-5dcc-3b48-a57e-0ee0e426b80a",
                        "glosses": [
                            "een zeer besmettelijke infectieziekte die de darmen aantast"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51a405d8-cfa6-4d49-81eb-16de7606ed14",
                                "sense_id": "dbf6c2ed-7d21-3437-ae3a-82f093fa8c18",
                                "text": "Vroeger kregen mensen veel sneller cholera dan nu."
                            },
                            {
                                "example_id": "0139b2dd-6183-41ef-97e7-4867df872106",
                                "sense_id": "dbf6c2ed-7d21-3437-ae3a-82f093fa8c18",
                                "text": "Eenheid 731 experimenteerde tijdens zijn bestaan met zowat alle gevaarlijke virussen, bacteriën en epidemieën die toen bekend waren, zoals miltvuur, cholera, builenpest, salmonella, tyfus, tetanus, brucellose, botulisme, gasgangreen, malaria, pokken, meningokokkenmeningitis, tuberculose, tularemie en kwade droes.\nTests werden - afhankelijk van de doeleinden - uitgevoerd op dieren, maar ook op mensen: krijgsgevangenen, gevangen verzetsmensen, politieke tegenstanders of 'verdachte' personen"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60cbaf2b-a76c-428c-9458-76761378794c",
                        "source_entry_id": "7f74b481-5dcc-3b48-a57e-0ee0e426b80a",
                        "source_sense_id": "dbf6c2ed-7d21-3437-ae3a-82f093fa8c18",
