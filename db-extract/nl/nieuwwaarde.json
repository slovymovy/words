                "senses": [
                    {
                        "sense_id": "e1af62fd-d542-333c-af04-a3ed4b58bd45",
                        "entry_id": "7eacb28c-68a9-36aa-87f9-3deb3ba24651",
                        "glosses": [
                            "de prijs die je moet betalen voor iets als het nog nieuw is, een term die vaak gebruikt wordt bij verzekeringen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3d45446-e6cb-45f8-9c75-464722b97f3c",
                                "sense_id": "e1af62fd-d542-333c-af04-a3ed4b58bd45",
                                "text": "De verzekering geldt voor auto's met een nieuwwaarde tot 75.000 euro."
                            },
                            {
                                "example_id": "75bbb076-fcac-4900-bfef-6128eaaafcf6",
                                "sense_id": "e1af62fd-d542-333c-af04-a3ed4b58bd45",
                                "text": "De poort en de garagedeur stonden open en Mast zag dat zijn rode Cannondale Super Six – nieuwwaarde ruim 3.000 euro – weg was."
                            },
                            {
                                "example_id": "7f064282-af03-4865-937e-e16fec336a84",
                                "sense_id": "e1af62fd-d542-333c-af04-a3ed4b58bd45",
                                "text": "Heb je schade aan je spullen, dan geef je die op aan de verzekeraar. Die beoordeelt aan de hand van een afschrijvingslijst wat de waarde is. ,,Is het product meer waard dan 40 procent van de nieuwwaarde, dan krijg je vaak de volledige nieuwwaarde uitgekeerd, licht Rodenburg toe. ,,Ligt de waarde onder die 40 procent, krijg je de dagwaarde uitgekeerd."
                            },
                            {
                                "example_id": "341bbe8c-8688-45b4-8cf6-29615d3e5c04",
                                "sense_id": "e1af62fd-d542-333c-af04-a3ed4b58bd45",
                                "text": "Boeve legt uit dat bij het rijden van een auto van de zaak 35 procent van de waarde van de wagen bij het inkomen van de koper moet worden opgeteld als deze belastingaangifte doet. „Bij youngtimers gaat het om 35 procent van de dagwaarde in plaats de nieuwwaarde. Dat scheelt nogal wat”, zegt Boeve."
                            }
                        ]
                    }
