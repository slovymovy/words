                "senses": [
                    {
                        "sense_id": "dcdb18e7-6eb2-3737-8efc-db64f44e622f",
                        "entry_id": "d81ec598-d141-34f4-af63-d4dbfbb452dd",
                        "glosses": [
                            "Donner un caractère professoral à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dee26b2b-423f-41d5-8f46-22f91c105492",
                                "sense_id": "dcdb18e7-6eb2-3737-8efc-db64f44e622f",
                                "text": "La romanistique, professoralisée et équipée de tous les droits à la faculté, sera une discipline historiciste et précisément en ce sens moderne."
                            },
                            {
                                "example_id": "d89ba2e6-9290-4264-b5ac-b106fb603fd9",
                                "sense_id": "dcdb18e7-6eb2-3737-8efc-db64f44e622f",
                                "text": "Durant les premières décennies du xxe siècle, l’économie politique académique se professoralise en se fondant essentiellement sur les principes théoriques et méthodologiques définis par les marginalistes, et plus particulièrement, dans un premier temps, par Marshall."
                            }
                        ]
                    }
