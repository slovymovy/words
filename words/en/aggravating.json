{
    "word_family": [
        "aggravate",
        "aggravation"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ad049d81-3032-3629-97dc-d462efc19aa1",
                    "sense_definition": "Causing annoyance or irritation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "annoying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>aggravating</w> sound of the dripping tap kept me awake all night.",
                            "target_lang_translations": {
                                "cs": "<w>Otravný</w> zvuk kapajícího kohoutku mě celou noc nenechal spát."
                            }
                        },
                        {
                            "text": "It is very <w>aggravating</w> when the computer crashes right before I save my work.",
                            "target_lang_translations": {
                                "cs": "Je velmi <w>rozčilující</w>, když počítač spadne těsně předtím, než si uložím práci."
                            }
                        }
                    ],
                    "synonyms": [
                        "annoying",
                        "irritating",
                        "frustrating"
                    ],
                    "common_phrases": [
                        "aggravating habit",
                        "aggravating situation"
                    ],
                    "target_lang_definitions": {
                        "cs": "Způsobující obtěžování nebo podráždění."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "otravný",
                                "target_lang_sense_clarification": "běžné označení pro něco, co nás obtěžuje"
                            },
                            {
                                "target_lang_word": "dráždivý",
                                "target_lang_sense_clarification": "vyvolávající pocit podráždění"
                            },
                            {
                                "target_lang_word": "rozčilující",
                                "target_lang_sense_clarification": "vyvolávající hněv nebo frustraci"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6ca8f8e-77fd-38e0-9443-9eecfa210f35",
                    "sense_definition": "Making a situation or condition worse or more serious.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "worsening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>aggravating</w> circumstances of the crime led to a much harsher prison sentence.",
                            "target_lang_translations": {
                                "cs": "<w>Přitěžující</w> okolnosti zločinu vedly k mnohem přísnějšímu trestu odnětí svobody."
                            }
                        },
                        {
                            "text": "Ignoring the injury was an <w>aggravating</w> factor that delayed his recovery for months.",
                            "target_lang_translations": {
                                "cs": "Ignorování zranění bylo <w>přitěžujícím</w> faktorem, který jeho uzdravení o měsíce oddálil."
                            }
                        }
                    ],
                    "synonyms": [
                        "worsening",
                        "exacerbating"
                    ],
                    "antonyms": [
                        "alleviating",
                        "extenuating",
                        "mitigating"
                    ],
                    "common_phrases": [
                        "aggravating factor",
                        "aggravating circumstances"
                    ],
                    "target_lang_definitions": {
                        "cs": "Zhoršující situaci nebo stav, činící něco vážnějším."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "přitěžující",
                                "target_lang_sense_clarification": "často používané v právním kontextu (např. přitěžující okolnosti)"
                            },
                            {
                                "target_lang_word": "zhoršující",
                                "target_lang_sense_clarification": "obecný výraz pro proces zhoršování stavu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "944f0883-a68a-3a47-8946-20703ba4108d",
                    "sense_definition": "Present participle and gerund of <w>aggravate</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "worsening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is <w>aggravating</w> the situation by refusing to listen to any advice.",
                            "target_lang_translations": {
                                "cs": "Tím, že odmítá naslouchat jakékoli radě, situaci jen <w>zhoršuje</w>."
                            }
                        },
                        {
                            "text": "Constantly <w>aggravating</w> his old knee injury will only lead to more pain later.",
                            "target_lang_translations": {
                                "cs": "Neustálé <w>zhoršování</w> jeho starého zranění kolene povede později jen k větší bolesti."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb aggravate."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Přítomné příčestí a gerundium slovesa 'aggravate' (zhoršovat)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zhoršující",
                                "target_lang_sense_clarification": "činnost, která vede k horšímu stavu"
                            },
                            {
                                "target_lang_word": "popouzející",
                                "target_lang_sense_clarification": "činnost, která někoho dráždí nebo provokuje"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}