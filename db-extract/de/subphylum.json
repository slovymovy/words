                "senses": [
                    {
                        "sense_id": "a89a6a0e-ab51-3881-87e8-26de593e01a4",
                        "entry_id": "7a647c12-81bb-33d2-9b3c-e93e013846c3",
                        "glosses": [
                            "der Unterstamm; Einteilung in den Tierstämmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23dc7246-e786-4eea-9191-6190ac2b0cc9",
                                "sense_id": "a89a6a0e-ab51-3881-87e8-26de593e01a4",
                                "text": "„Dieser kleine Ast des Subphylum der Würmer umfasst nur die einzige Classe der Räderthierchen […] Einerseits sind die Rotatorien durch ihre tiefsten Formen so innig mit den Turbellarien […] und selbst noch mit den Infusorien andrerseits durch ihre höchsten Formen so nah mit den Crustaceen (Entomostraca) und dadurch mit dem Subphylum der Arthropoden verbunden, dass wir dieselben als eine Zwischenform zwischen den Scoleciden und den Arthropoden betrachten müssen, […]“"
                            },
                            {
                                "example_id": "81741501-0b66-42b7-adf6-92748e24a418",
                                "sense_id": "a89a6a0e-ab51-3881-87e8-26de593e01a4",
                                "text": "„Das Subphylum der Pachycardier zerfällt zunächst in zwei sehr ungleiche Stammäste, von denen der eine bloss die kleine Gruppe der Monorrhinen […] der andere sämtliche übrigen Vertebraten (Amphirhinen) umfasst.“"
                            },
                            {
                                "example_id": "d8c4ea2c-52d6-4d19-9edd-3134a0564bed",
                                "sense_id": "a89a6a0e-ab51-3881-87e8-26de593e01a4",
                                "text": "„Man muss außerdem die exklusiven Merkmale jedes einzelnen Subphylums beachten, weil sowohl Unterschiede als auch Ähnlichkeiten für die Interpretation von Verwandtschaftsverhältnissen wichtig sind. Das Subphylum der Urochordata ist groß und nicht einheitlich.“"
                            },
                            {
                                "example_id": "a2040419-c169-4e13-a6c1-4d1142bdee08",
                                "sense_id": "a89a6a0e-ab51-3881-87e8-26de593e01a4",
                                "text": "„Das riesige Subphylum der Krebse (ca. 42.000 Arten) enthält unter allen Gruppen der Wirbellosen wahrscheinlich nicht nur die meisten Parasiten, sondern auch diejenigen mit den stärksten morphologischen Abwandlungen.“"
                            },
                            {
                                "example_id": "658937fe-81bb-4bb4-85fe-75baeea2aedb",
                                "sense_id": "a89a6a0e-ab51-3881-87e8-26de593e01a4",
                                "text": "„Subphylum: Scolecida – Nur diesem Protostomier-Subphylum fehlen erhaltungsfähige Hartteile ganz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
