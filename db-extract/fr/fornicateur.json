                "senses": [
                    {
                        "sense_id": "5847a19e-4681-3433-8253-b4d7b212f42e",
                        "entry_id": "27700c14-aea1-3d55-a2b5-d8517bf04232",
                        "glosses": [
                            "Celui qui commet le péché de fornication."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f99df467-57cc-4220-a01f-cae34028e3af",
                                "sense_id": "5847a19e-4681-3433-8253-b4d7b212f42e",
                                "text": "L’écriture dit que ni les fornicateurs ni les adultères n’entreront dans le royaume des cieux."
                            },
                            {
                                "example_id": "2dbacfa6-3a49-44b2-842a-91790cb0e4b5",
                                "sense_id": "5847a19e-4681-3433-8253-b4d7b212f42e",
                                "text": "– Je prierai pour Simon, dit Joseph, plus calme, mais je sais que jamais un fornicateur n’entrera dans le royaume de Dieu, parce que l’Écriture le dit formellement. Tous ces garçons avec leurs histoires de femmes ne sont que des enfants de colère. »"
                            },
                            {
                                "example_id": "ef28cf73-5932-4020-a008-59b25c0a921a",
                                "sense_id": "5847a19e-4681-3433-8253-b4d7b212f42e",
                                "text": "«Cette photo est fausse! Car si elle était véridique, ce musulman serait considéré comme un fornicateur par l’islam et passible de 100 coups de fouet!»"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bb2fd449-26d5-4c72-a19c-3715849fcb78",
                        "source_entry_id": "27700c14-aea1-3d55-a2b5-d8517bf04232",
                        "source_sense_id": "5847a19e-4681-3433-8253-b4d7b212f42e",
                        "target_lang_word": "fornicator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fornicator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5558d29-694c-36c3-b58e-f44426ebd7a1",
                                        "entry_id": "e8fd2a09-ba93-3c96-96f8-fbf2efcf3f54",
                                        "glosses": [
                                            "An unmarried person who engages in sexual intercourse, especially when considered to be of an illicit or illegal nature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "120108a5-1d00-44ca-bbdb-f8e9947f95a4",
                                                "sense_id": "f5558d29-694c-36c3-b58e-f44426ebd7a1",
                                                "text": "Know yee not that the vnrighteous ſhall not inherite the kingdome of God? Be not deceiued: neither fornicatours, nor idolaters, nor adulterers, nor effeminate, nor abuſers of themſelues with mankinde, Nor theeues, nor couetous, nor drunkards, nor reuilers, nor extortioners, ſhall inherit the kingdom of God."
                                            },
                                            {
                                                "example_id": "d155ee43-ea53-40dc-89dd-c98da02f9b99",
                                                "sense_id": "f5558d29-694c-36c3-b58e-f44426ebd7a1",
                                                "text": "(As for) the fornicatress and the fornicator, flog each of them, (giving) a hundred stripes, and let not pity for them detain you in the matter of obedience to Allah, if you believe in Allah and the last day, and let a party of believers witness their chastisement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d193bc5-ff66-42cc-b12c-c8d7576e7d57",
                        "source_entry_id": "27700c14-aea1-3d55-a2b5-d8517bf04232",
                        "source_sense_id": "5847a19e-4681-3433-8253-b4d7b212f42e",
