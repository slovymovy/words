                "senses": [
                    {
                        "sense_id": "f65347ca-30c8-32a3-8c78-84bc9874486a",
                        "entry_id": "557c4d42-7ec5-35e7-ad56-5f0095b02bc7",
                        "glosses": [
                            "Donner un caractère comorien, ou plus comorien, à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70bfdeeb-e3ce-4cd3-9834-f3dcb9522346",
                                "sense_id": "f65347ca-30c8-32a3-8c78-84bc9874486a",
                                "text": "Mais il est vrai qu'au début on a dû « comorianiser » l'éducation pour pouvoir alphabétiser tout le monde."
                            },
                            {
                                "example_id": "d76893ce-b7e2-4f81-939a-f337b98fa533",
                                "sense_id": "f65347ca-30c8-32a3-8c78-84bc9874486a",
                                "text": "Oui, nous ne sommes que dans la phase de vouloir enseigner le comorien et non de comorianiser l'enseignement, ce qui est une toute autre histoire."
                            },
                            {
                                "example_id": "891370a9-5308-4ce6-9f30-11890efa9e65",
                                "sense_id": "f65347ca-30c8-32a3-8c78-84bc9874486a",
                                "text": "Le leadership de la Banque centrale des Comores (BCC) vient d'être entièrement 'comorianisé'."
                            }
                        ]
                    }
