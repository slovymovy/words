                "senses": [
                    {
                        "sense_id": "2f7b2a86-1bdc-3ac0-88bf-a0cef2d3532f",
                        "entry_id": "eaaa3dfe-c201-332b-9305-a1d7f1ba9836",
                        "glosses": [
                            "afkorting van bruto binnenlands product: totale (geld)waarde van alle in een land (of andersoortige productie-eenheid) geproduceerde goederen en diensten gedurende een bepaalde periode"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b4c148c-127d-4546-9b9c-f15f144a77ef",
                                "sense_id": "2f7b2a86-1bdc-3ac0-88bf-a0cef2d3532f",
                                "text": "Als het huidige steunpakket volgend jaar stopt, moeten de Grieken tot 2020 maatregelen nemen. In 2019 moeten eerst de pensioenen met 1 procent van het bruto binnenlands product (bbp) worden gekort. Het jaar daarop moet Griekenland 1 procent van het bbp aan extra inkomstenbelasting ophalen. Griekenland had vorig jaar een geschat bbp van 290,5 miljard dollar (274 miljard euro). De economische hervormingen omvatten zo ruwweg 5,5 miljard euro."
                            }
                        ]
                    }
                ],
