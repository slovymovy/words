                        "sense_id": "73ef0982-60f6-377d-a78b-132ef6605f74",
                        "entry_id": "22c79420-668a-3706-a3dc-aa241a274fbd",
                        "glosses": [
                            "ton vol gaten die de 50 dochters van Danaos volgens de Griekse mythologie, als straf voor een moord op hun echtgenoten, moesten proberen te vullen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afd7eb4c-d569-4f9e-9dbc-3f6e25d6a20d",
                                "sense_id": "73ef0982-60f6-377d-a78b-132ef6605f74",
                                "text": "Als wraak vermoordde ze elk hun man, behalve Hypermnestra, die echt van haar man, Lygkeus, hield. De andere Danaïden kregen als straf dat ze in de Tartarus een bodemloos vat moesten vullen, het Danaïdenvat."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a77703b-b7e0-3b98-b8ea-1afce7eb3084",
                        "entry_id": "22c79420-668a-3706-a3dc-aa241a274fbd",
                        "glosses": [
                            "verouderde spelling of vorm van danaïdenvat tot 2006"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "6e82aed3-6559-4a66-be9a-f9eb4c9d66d5",
                                "sense_id": "1a77703b-b7e0-3b98-b8ea-1afce7eb3084",
                                "text": "Het geheugen van een mens is vaak een Danaïdenvat, maar toch niet altijd."
                            }
                        ]
                    }
