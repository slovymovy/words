                "senses": [
                    {
                        "sense_id": "c6844ed6-03cf-3572-a65c-d80de5162312",
                        "entry_id": "7418c61f-1961-3fe0-9f73-b96840d64375",
                        "glosses": [
                            "Zustand, bei dem sich zwei oder mehr Dinge ausschließen"
                        ],
                        "tags": [
                            "meist Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "f8cc5f5b-2c38-4494-9863-8989133784a9",
                                "sense_id": "c6844ed6-03cf-3572-a65c-d80de5162312",
                                "text": "Die Unvereinbarkeit einer Stromerzeugung mit fossilen Energien mit dem Klimaschutz ist offensichtlich."
                            },
                            {
                                "example_id": "6f328a0f-1669-4b6c-a174-4e73dfae12f6",
                                "sense_id": "c6844ed6-03cf-3572-a65c-d80de5162312",
                                "text": "[Diskriminierung von Sinti und Roma:] „Erst 1970 wurde die Landfahrerordnung wegen Unvereinbarkeit mit dem Grundgesetz aufgehoben.“"
                            },
                            {
                                "example_id": "cabd6a7f-290f-4086-9946-93eb0a670e67",
                                "sense_id": "c6844ed6-03cf-3572-a65c-d80de5162312",
                                "text": "„Erst am 10. Mai 1957 hob das Bundesarbeitsgericht den Lehrerinnen-Zölibat auf, mit dem Hinweis auf die Unvereinbarkeit der Vorschrift mit dem Grundgesetz.“"
                            },
                            {
                                "example_id": "11c5f236-7ea7-4c92-b402-5c8b54decbb8",
                                "sense_id": "c6844ed6-03cf-3572-a65c-d80de5162312",
                                "text": "„Die Unvereinbarkeit ihres Jobs mit dem Wunsch zu reisen ließ sie schließlich kündigen.“"
                            },
                            {
                                "example_id": "3701285d-07af-40df-bf1c-9d12c8b676a3",
                                "sense_id": "c6844ed6-03cf-3572-a65c-d80de5162312",
                                "text": "„Aufgrund der Unvereinbarkeit eines politischen Amtes mit einer Funktion bei Global 2000 verabschiedete sich Gewessler Mitte Juni 2019 von der Umweltschutzorganisation.“"
                            },
                            {
                                "example_id": "913e7636-f1e4-4951-9346-662757958b19",
                                "sense_id": "c6844ed6-03cf-3572-a65c-d80de5162312",
                                "text": "[14. Oktober 1938:] „Ungarn bricht die am 9. Oktober in Komorn begonnenen Verhandlungen mit der tschechoslowakischen Regierung über künftige Grenzkorrekturen wegen Unvereinbarkeit der Standpunkte ab.“"
                            },
                            {
                                "example_id": "2ee06a67-22ec-41b5-a23c-8d6bc9b2043a",
                                "sense_id": "c6844ed6-03cf-3572-a65c-d80de5162312",
                                "text": "„«Aus unserer Tradition als Friedenskirche, die sich immer dafür eingesetzt hatte, dass Christen etwa keinen Militärdienst leisten müssen, geht eine klare Unvereinbarkeit von Christentum und Waffengewalt hervor.»“"
                            },
                            {
                                "example_id": "d833e5ef-61af-410d-91e3-abdf3dcaeb92",
                                "sense_id": "c6844ed6-03cf-3572-a65c-d80de5162312",
                                "text": "„Inzwischen sieht sie die Ursachen für die Unvereinbarkeit von Beruf und Familie nicht mehr als individuelles, sondern als strukturelles Problem.“"
                            },
                            {
                                "example_id": "b8052bd0-7971-44cc-ab6f-4a8adf305450",
                                "sense_id": "c6844ed6-03cf-3572-a65c-d80de5162312",
                                "text": "„Die Regeln der Kantone bezüglich der Unvereinbarkeit der Mitgliedschaft in der Kantonsregierung und im Nationalrat oder Ständerat sind unterschiedlich.“"
                            },
                            {
                                "example_id": "3e1cc5d6-6911-4a86-9ece-7b138d91225f",
                                "sense_id": "c6844ed6-03cf-3572-a65c-d80de5162312",
                                "text": "„Die Interessen der einzelnen Staaten könnten unterschiedlicher nicht sind. – 196 Staaten, 196 Interessen – Trotz ihrer scheinbaren Unvereinbarkeit versucht die Weltgemeinschaft seit 20 Jahren, sich auf eine gemeinsame Klimapolitik zu verständigen.“"
                            },
                            {
                                "example_id": "c640bed9-bf14-47e6-8d24-8482d79963b3",
                                "sense_id": "c6844ed6-03cf-3572-a65c-d80de5162312",
                                "text": "„In ihrer \"Gründlichen Untersuchung der Ursachen, die das weibliche Geschlecht vom Studieren abhalten\" widerlegt Dorothea Erxleben schlüssig die tradierten Maximen der Unvereinbarkeit von Weiblichkeit und Bildung. Die Abhandlung beeindruckt sogar Friedrich II. von Preußen.“"
                            },
                            {
                                "example_id": "b7e160ac-5c43-4843-b3f7-bc312f24e9f4",
                                "sense_id": "c6844ed6-03cf-3572-a65c-d80de5162312",
                                "text": "„Auf ein Verbot [Anmerkung: der Partei AfD] kann es aber gar nicht ankommen, weil nicht dem Bundesverfassungsgericht, sondern allein der Gewerkschaft die Beurteilung der politischen Unvereinbarkeit zusteht.“"
                            },
                            {
                                "example_id": "4bfc9c89-5bf4-499d-9d58-f3b41d6038fa",
                                "sense_id": "c6844ed6-03cf-3572-a65c-d80de5162312",
                                "text": "„Gogol musste ständig verreisen, denn sein Leben war eine Aneinanderreihung von Krisen. Rom, Paris, Baden-Baden, in die Schweiz, und immer wieder zurück nach Russland. Er war ein Getriebener - getrieben von Schuldgefühlen, die der Unvereinbarkeit seiner sexuellen Neigungen mit seiner tiefen Religiosität entsprangen,“ […]."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
