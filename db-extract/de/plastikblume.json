                                "example_id": "5a74530a-1a18-494c-a669-1a711808891d",
                                "sense_id": "216a0cb8-1c4a-3eec-b09c-bceb0050e995",
                                "text": "„Daneben hatte ein rotes Rad mit einem mit blauen Plastikblumen geschmückten Korb gestanden.“"
                            },
