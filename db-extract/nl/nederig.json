                ],
                "senses": [
                    {
                        "sense_id": "03a06534-595e-326d-bafb-cb4111ab37d9",
                        "entry_id": "2cddf931-6a55-3c2f-a83f-d3550f8105cf",
                        "glosses": [
                            "een onderdanige houding aannemend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e5ea294-4c12-4cbc-a247-4905e6cd7bfe",
                                "sense_id": "03a06534-595e-326d-bafb-cb4111ab37d9",
                                "text": "Hij maakte een buiging als een nederige dienaar."
                            },
                            {
                                "example_id": "87f5c989-0f47-439d-b504-e5af8a52ed40",
                                "sense_id": "03a06534-595e-326d-bafb-cb4111ab37d9",
                                "text": "`Ik weet het; zei de majordomus. 'Het was ijdele hoop dat dit u zou ontgaan. Ik vraag u met klem de grootmoedigheid op te brengen om mijn nederige excuses te aanvaarden. Deze uit de toon vallende decoratie is het jammerlijke gevolg van het enthousiasme van de nieuwe eigenaar.'"
                            },
                            {
                                "example_id": "02281a9f-0f9b-4bb9-9fa4-392e3f3572eb",
                                "sense_id": "03a06534-595e-326d-bafb-cb4111ab37d9",
                                "text": "Blijf je hele leven lang leren, zo blijf je nederig, leergierig en niet arrogant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5407cb2-5904-4394-a6c7-86847b77df49",
                        "source_entry_id": "2cddf931-6a55-3c2f-a83f-d3550f8105cf",
                        "source_sense_id": "03a06534-595e-326d-bafb-cb4111ab37d9",
                        "source_sense_description": "een onderdanige houding aannemend",
                        "target_lang_word": "humble",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "humble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46245d54-b7bb-3791-b41a-0cd0c4afae0b",
                                        "entry_id": "b51db3c4-08cc-3ec5-9b29-cc31b3d14792",
                                        "glosses": [
                                            "Not pretentious or magnificent; unpretending; unassuming."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ffc71b1-881b-4cb7-8e62-3dafbe8a309e",
                                                "sense_id": "46245d54-b7bb-3791-b41a-0cd0c4afae0b",
                                                "text": "He lives in a humble one-bedroom cottage."
                                            },
                                            {
                                                "example_id": "cdbd778a-d506-427f-85cc-26af91d4ba00",
                                                "sense_id": "46245d54-b7bb-3791-b41a-0cd0c4afae0b",
                                                "text": "17th century, Abraham Cowley, The Shortness of Life and Uncertainty of Riches\nThe wise example of the heavenly lark.\nThy fellow poet, Cowley, mark,\nAbove the clouds let thy proud music sound,\nThy humble nest build on the ground."
                                            },
                                            {
                                                "example_id": "c93406ed-4a15-4574-9b6b-761b33676e81",
                                                "sense_id": "46245d54-b7bb-3791-b41a-0cd0c4afae0b",
                                                "text": "Roominess and unroominess in a human dwelling, even of the humblest kind, are important matters in their bearing upon man's character."
                                            },
                                            {
                                                "example_id": "94d04674-393c-4f1a-9876-68075b0330d4",
                                                "sense_id": "46245d54-b7bb-3791-b41a-0cd0c4afae0b",
                                                "text": "Undoubtedly it can be said that the humble 0-6-0 has been the backbone for general service, or general utility on British railways right from their earliest days, and is likely to remain so."
                                            },
                                            {
                                                "example_id": "4c42e996-3962-4583-8639-aefa9ae56782",
                                                "sense_id": "46245d54-b7bb-3791-b41a-0cd0c4afae0b",
                                                "text": "Lucky that my lips not only mumble / They spill kisses like a fountain / Lucky that my breasts are small and humble / So you don't confuse 'em with mountains"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92b4e3bf-71f8-34e1-b7b2-202dffa6d634",
                                        "entry_id": "b51db3c4-08cc-3ec5-9b29-cc31b3d14792",
                                        "glosses": [
                                            "Having a low opinion of oneself; not proud, arrogant, or assuming; modest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07c7e152-915d-4c6d-a9e7-b96cdf67583d",
                                                "sense_id": "92b4e3bf-71f8-34e1-b7b2-202dffa6d634",
                                                "text": "But he giueth more grace, wherefore he saith, God resisteth the proude, but giueth grace vnto the humble."
                                            },
                                            {
                                                "example_id": "5237af3f-3817-4e89-af7f-d6f66b5f7242",
                                                "sense_id": "92b4e3bf-71f8-34e1-b7b2-202dffa6d634",
                                                "text": "She ſhould be humble, who would pleaſe;\n And ſhe muſt ſuffer, who can love."
                                            },
                                            {
                                                "example_id": "a7eb669c-d9dc-4395-986f-c79c750ee9d9",
                                                "sense_id": "92b4e3bf-71f8-34e1-b7b2-202dffa6d634",
                                                "text": "Rosol's 65 winners to Nadal's 41 was one of the crucial statistics in the 3hr 18min match that ended in a 6-7, 6-4, 6-4, 2-6, 6-4 triumph labelled a \"miracle\" by Rosol, who was humble enough to offer commiserations to Nadal."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "humble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6457d03a-e633-3651-834d-d95e0ae3f6eb",
                                        "entry_id": "a5adbf42-c9ff-3aa2-8609-1e1334bb9d73",
                                        "glosses": [
                                            "An arrest based on weak evidence intended to demean or punish the subject."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "052b0fca-7f87-4254-a60b-429968dceb66",
                                                "sense_id": "6457d03a-e633-3651-834d-d95e0ae3f6eb",
                                                "text": "You're on a corner in my district, it ain't gonna be about no humble, it ain't gonna be about no loitering charge, nothing like that. There gonna be some biblical shit happening to you on the way to that motherfucking jail wagon."
                                            },
                                            {
                                                "example_id": "604347a8-4086-423a-a1a8-816b54fe255e",
                                                "sense_id": "6457d03a-e633-3651-834d-d95e0ae3f6eb",
                                                "text": "Years ago, guys on Baltimore's streets would have, by definition, called an arrest for loitering a \"humble.\""
                                            },
                                            {
                                                "example_id": "d8f45d19-fa6d-4a21-9582-2711981e30a8",
                                                "sense_id": "6457d03a-e633-3651-834d-d95e0ae3f6eb",
                                                "text": "A humble is a cheap, inconsequential arrest that nonetheless gives the guy a night or two in jail before he sees a court commissioner. You can arrest people on “failure to obey,” it’s a humble. Loitering is a humble. These things were used by police officers going back to the ‘60s in Baltimore. It’s the ultimate recourse for a cop who doesn't like somebody who's looking at him the wrong way."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "humble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ca8eab2-b813-3862-b422-71f60bb0549e",
                                        "entry_id": "82a1562d-124b-3baa-9584-b151079d67ba",
                                        "glosses": [
                                            "To defeat or reduce the power, independence, or pride of."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc3e0338-0807-4095-b89b-5d71149c443c",
                                                "sense_id": "6ca8eab2-b813-3862-b422-71f60bb0549e",
                                                "text": "Here, take this purse, thou whom the heaven's plagues have humbled to all strokes."
                                            },
                                            {
                                                "example_id": "16deb8bc-812c-4742-871a-2c805aa8bb49",
                                                "sense_id": "6ca8eab2-b813-3862-b422-71f60bb0549e",
                                                "text": "Humble yourselues therefore vnder the mighty hand of God, that hee may exalt you in due time,"
                                            },
                                            {
                                                "example_id": "20b1e612-154e-49e9-85b9-95c3c6dcfce7",
                                                "sense_id": "6ca8eab2-b813-3862-b422-71f60bb0549e",
                                                "text": "But, after the death of the master, the servant proved himself capable of supplying with eminent ability the master's place, and was renowned throughout Europe as one of the great Triumvirate which humbled the pride of Lewis the Fourteenth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dbede45-44c0-31df-89ce-5b7e02646894",
                                        "entry_id": "82a1562d-124b-3baa-9584-b151079d67ba",
                                        "glosses": [
                                            "To make humble or lowly; to make less proud or arrogant; to make meek and submissive."
                                        ],
                                        "tags": [
                                            "often",
                                            "reflexive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bcf3778-db2e-40bd-90a3-82f28c2387ea",
                                                "sense_id": "6dbede45-44c0-31df-89ce-5b7e02646894",
                                                "text": "And you say you've been humbled in love / Cut down in your love / Forced to kneel in the mud next to me"
                                            },
                                            {
                                                "example_id": "9814e0cb-3052-4c92-afbb-cf3e0ae86f60",
                                                "sense_id": "6dbede45-44c0-31df-89ce-5b7e02646894",
                                                "text": "The final, quiet moments of the book return to Sten; his experience of his sick son humbles him, just as his aging body humbles him, and Boyle seems to suggest this makes him a better man."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "humble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a658a03-14b1-3190-9f48-5a2acedd9eb2",
                                        "entry_id": "d444be39-b0c2-351d-a035-24183c9739dd",
                                        "glosses": [
                                            "To hum."
                                        ],
