{
    "word_family": [
        "stifle"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a3b8e753-22c1-3291-b2bb-1ed3e3719b28",
                    "sense_definition": "Extremely hot and uncomfortable, making it difficult to breathe.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "temperature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The air in the small room was <w>stifling</w> because there was no ventilation.",
                            "target_lang_translations": {
                                "pl": "Powietrze w małym pokoju było <w>duszne</w>, ponieważ nie było wentylacji."
                            }
                        },
                        {
                            "text": "We walked through the <w>stifling</w> heat of the desert at midday.",
                            "target_lang_translations": {
                                "pl": "Szliśmy przez <w>upalny</w> żar pustyni w południe."
                            }
                        }
                    ],
                    "synonyms": [
                        "suffocating",
                        "sweltering"
                    ],
                    "antonyms": [
                        "refreshing"
                    ],
                    "common_phrases": [
                        "stifling heat"
                    ],
                    "target_lang_definitions": {
                        "pl": "Ekstremalnie gorący i nieprzyjemny, utrudniający oddychanie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "duszny",
                                "target_lang_sense_clarification": "odnoszące się do powietrza lub atmosfery"
                            },
                            {
                                "target_lang_word": "upalny",
                                "target_lang_sense_clarification": "odnoszące się do bardzo wysokiej temperatury"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aab68c48-95e4-306c-8c54-8e9f3155b55f",
                    "sense_definition": "The present participle and gerund of <w>stifle</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was <w>stifling</w> a yawn during the long and boring lecture.",
                            "target_lang_translations": {
                                "pl": "Podczas długiego i nudnego wykładu <w>tłumiła</w> ziewnięcie."
                            }
                        },
                        {
                            "text": "The government is <w>stifling</w> economic growth with these new regulations.",
                            "target_lang_translations": {
                                "pl": "Rząd <w>dławi</w> wzrost gospodarczy tymi nowymi przepisami."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Imiesłów czasu teraźniejszego i rzeczownik odczasownikowy od słowa 'stifle' (tłumić, dusić)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "tłumienie",
                                "target_lang_sense_clarification": "powstrzymywanie emocji lub rozwoju"
                            },
                            {
                                "target_lang_word": "duszenie",
                                "target_lang_sense_clarification": "fizyczne powstrzymywanie oddechu lub rozwoju"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c88e26ea-6de2-3be8-9895-1d1f06029778",
                    "sense_definition": "The act of preventing something from developing or being expressed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>stifling</w> of new ideas can lead to a stagnant company culture.",
                            "target_lang_translations": {
                                "pl": "<w>Tłumienie</w> nowych pomysłów może prowadzić do stagnacji kultury firmy."
                            }
                        },
                        {
                            "text": "Critics argue that the <w>stifling</w> of free speech is a threat to democracy.",
                            "target_lang_translations": {
                                "pl": "Krytycy twierdzą, że <w>dławienie</w> wolności słowa stanowi zagrożenie dla demokracji."
                            }
                        }
                    ],
                    "synonyms": [
                        "suppression",
                        "restraint"
                    ],
                    "antonyms": [
                        "encouragement"
                    ],
                    "target_lang_definitions": {
                        "pl": "Akt powstrzymywania czegoś przed rozwojem lub wyrażeniem."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "tłumienie",
                                "target_lang_sense_clarification": "hamowanie rozwoju lub ekspresji"
                            },
                            {
                                "target_lang_word": "dławienie",
                                "target_lang_sense_clarification": "blokowanie swobodnego przepływu lub działania"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}