                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dd17ec7a-8df5-3950-88a8-18cb1a697222",
                    "sense_definition": "The act of sending something through the air with force.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
