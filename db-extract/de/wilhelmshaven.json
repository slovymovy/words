                ],
                "senses": [
                    {
                        "sense_id": "74924ed4-c128-3c20-b34d-f3b189543f95",
                        "entry_id": "dc57baf6-e84a-3eb3-9ebc-86b5a327ca44",
                        "glosses": [
                            "Stadt in Niedersachsen, Deutschland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "917e5a3e-bddd-4c61-a862-e4f837575bca",
                                "sense_id": "74924ed4-c128-3c20-b34d-f3b189543f95",
                                "text": "Der Schauspieler Hans Clarin wurde in Wilhelmshaven geboren."
                            },
                            {
                                "example_id": "181fdcf3-2b89-4119-828d-23e80d2b867c",
                                "sense_id": "74924ed4-c128-3c20-b34d-f3b189543f95",
                                "text": "„Das Stadtgebiet Wilhelmshavens ist für statistische Zwecke in fünf Stadtbereiche […] eingeteilt.“"
                            },
                            {
                                "example_id": "0bef1c1f-1085-417c-960b-8f20d1595d12",
                                "sense_id": "74924ed4-c128-3c20-b34d-f3b189543f95",
                                "text": "Ich bin in Wilhelmshaven geboren."
                            },
                            {
                                "example_id": "2845b275-64c3-45c0-bb02-0d9bd9226b00",
                                "sense_id": "74924ed4-c128-3c20-b34d-f3b189543f95",
                                "text": "Wir haben in Wilhelmshaven unseren Urlaub verbracht."
                            },
                            {
                                "example_id": "f42240ed-80dc-4ab6-ad18-f8f33af72b16",
                                "sense_id": "74924ed4-c128-3c20-b34d-f3b189543f95",
                                "text": "Nach Wilhelmshaven führen viele Wege."
                            },
                            {
                                "example_id": "d4d29673-56e4-4bba-8247-663b13934b20",
                                "sense_id": "74924ed4-c128-3c20-b34d-f3b189543f95",
                                "text": "Wilhelmshaven liegt auf der Nordhalbkugel."
                            },
                            {
                                "example_id": "afb3a3d4-51e0-4dbf-91fc-3bf34bade87e",
                                "sense_id": "74924ed4-c128-3c20-b34d-f3b189543f95",
                                "text": "Das Wilhelmshaven des 18. Jahrhunderts war, weil es noch nicht existierte, auf keiner Karte zu finden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
