            "pos": "noun",
            "senses": [
                {
                    "sense_id": "87ff2d61-0e19-3a5a-aa14-8c2d9d4132b7",
                    "sense_definition": "People considered to be of a low, disreputable, or undesirable social class.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "social_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They started charging a modest fee in an effort to keep the <w>riffraff</w> out.",
                            "target_lang_translations": {
                                "ru": "Они начали взимать небольшую плату, пытаясь не пускать всякий <w>сброд</w>."
                            }
                        },
                        {
                            "text": "The club owner hired extra security to ensure that no <w>riffraff</w> could enter the private party.",
                            "target_lang_translations": {
                                "ru": "Владелец клуба нанял дополнительную охрану, чтобы никакой <w>сброд</w> не проник на закрытую вечеринку."
                            }
                        }
                    ],
                    "synonyms": [
                        "rabble",
                        "trash",
                        "plebs"
                    ],
                    "common_phrases": [
                        "keep out riffraff"
                    ],
                    "target_lang_definitions": {
                        "ru": "Люди низкого социального происхождения, сомнительного поведения или нежелательные в обществе; сброд или чернь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сброд",
                                "target_lang_sense_clarification": "презрительно о деклассированных или нежелательных людях"
                            },
                            {
                                "target_lang_word": "чернь",
                                "target_lang_sense_clarification": "устаревшее, презрительно о низших слоях общества"
                            },
                            {
                                "target_lang_word": "отребье",
                                "target_lang_sense_clarification": "презрительно о никчемных или опустившихся людях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c2391da-41a3-3ba3-aa16-2e7e09d91401",
                    "sense_definition": "Waste material or refuse.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "waste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the storm, the beach was covered in <w>riffraff</w> and debris.",
                            "target_lang_translations": {
                                "ru": "После шторма пляж был усыпан <w>мусором</w> и обломками."
                            }
                        },
                        {
                            "text": "He spent the entire afternoon clearing the <w>riffraff</w> from the garden path.",
                            "target_lang_translations": {
                                "ru": "Он провел весь день, убирая <w>хлам</w> с садовой дорожки."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is largely historical or literary."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мусор, отходы или хлам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хлам",
                                "target_lang_sense_clarification": "ненужные вещи, старье"
                            },
                            {
                                "target_lang_word": "мусор",
                                "target_lang_sense_clarification": "отбросы, сор"
                            }
                        ]
                    }
                }
            ]
        }
    ]
