                    {
                        "sense_id": "085966f2-5c2d-30c6-b9ce-5f5b8eccb051",
                        "entry_id": "bce91114-c172-3b8c-9c6f-7b7dbd95a01b",
                        "glosses": [
                            "Zeitraum, der den Samstag und Sonntag als arbeitsfreie Tage umfasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0efb8399-adc9-4d87-b2db-526ca4427f44",
                                "sense_id": "085966f2-5c2d-30c6-b9ce-5f5b8eccb051",
                                "text": "Über das Weekend fahren wir zu meinen Eltern nach Köln."
                            },
                            {
                                "example_id": "b5ad3a21-ad9b-441f-89af-8f4ae97562fb",
                                "sense_id": "085966f2-5c2d-30c6-b9ce-5f5b8eccb051",
                                "text": "„Dann kann ich Weekend machen, vor Sonntagabend brauche ich nicht wieder hier zu sein.“"
                            },
                            {
                                "example_id": "9596d0bd-8ef4-4c31-99ca-f3c64a840152",
                                "sense_id": "085966f2-5c2d-30c6-b9ce-5f5b8eccb051",
                                "text": "„Die Weekends verbrachte er drüben in Florida, meist mit Mädchen, die nicht älter waren als seine Tochter Betsy.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
