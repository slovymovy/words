                },
                {
                    "sense_id": "7f190003-fa5f-34ec-9442-05673cdd698c",
                    "sense_definition": "Charcuterie préparée à base de chaudins et de panse de porc embossés, puis cuite ou fumée.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "charcuterie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons acheté une <w>andouille</w> fumée au marché pour garnir nos galettes.",
                            "target_lang_translations": {
                                "en": "We bought a smoked <w>andouille</w> at the market to fill our galettes.",
                                "ru": "Мы купили на рынке копчёную <w>колбасу</w>, чтобы начинить наши галеты.",
                                "de": "Wir haben auf dem Markt eine geräucherte <w>Andouille</w> gekauft, um unsere Galettes damit zu füllen.",
                                "es": "Compramos un <w>embutido</w> ahumado en el mercado para rellenar nuestras galettes.",
                                "zh": "我们在市场上买了一根熏制的<w>安杜伊香肠</w>，用来给薄饼填馅。"
                            }
                        },
                        {
                            "text": "Le charcutier coupe de fines tranches d'<w>andouille</w> pour l'apéritif.",
                            "target_lang_translations": {
                                "en": "The butcher cuts thin slices of <w>andouille</w> for the aperitif.",
                                "ru": "Мясник нарезает тонкими ломтиками <w>колбасу</w> для аперитива.",
                                "de": "Der Metzger schneidet dünne Scheiben <w>Andouille</w> für den Aperitif ab.",
                                "es": "El charcutero corta finas lonchas de <w>embutido</w> para el aperitivo.",
                                "zh": "肉店师傅切下几片薄薄的<w>安杜伊香肠</w>，用来做开胃小吃。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "andouille de Guémené",
                        "andouille de Vire"
                    ],
                    "target_lang_definitions": {
                        "en": "A pork sausage made from pig's chitterlings and tripe, then cooked or smoked.",
                        "ru": "Свиная колбаса из кишок и рубца, которую варят или коптят.",
                        "de": "Wurst aus Schweinedarm und Kutteln, die gekocht oder geräuchert wird.",
                        "es": "Embutido elaborado con tripa y panza de cerdo, que se cocina o se ahúma.",
                        "zh": "一种用猪小肠和猪肚制成的猪肉香肠，经煮熟或熏制而成。"
                    },
