                "translations": [
                    {
                        "translation_id": "e0f735cd-6935-4378-966c-364ce2124b9e",
                        "source_entry_id": "c84d4ff7-73c7-37ea-9c3c-0a5c95cc1e63",
                        "source_sense_id": "87d9f296-52bb-3324-9c0a-a29d2ce2e0b4",
                        "target_lang_word": "punnet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "punnet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "803561ab-c356-3a52-a950-bb1aa61a43b1",
                                        "entry_id": "d4720704-0981-3849-b261-19c1eddf3753",
                                        "glosses": [
                                            "A small basket or receptacle for collecting and selling fruit, particularly strawberries."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac39dfea-f198-41a0-ac2b-36f1c3e3ae58",
                                                "sense_id": "803561ab-c356-3a52-a950-bb1aa61a43b1",
                                                "text": "Thus, according to the same Year-Book, a sea-kale punnet measures 8 in. in diameter at the top and 7½ in. at the bottom, being 2 in. deep, while a radish punnet is 8 in. in diameter and 1 in. deep, if to hold six “hands,” or 9 in. by 1 in. for twelve “hands.” A mushroom punnet is 7 in. by 1 in., while a salading punnet is 5 in. by 2 in."
                                            },
                                            {
                                                "example_id": "a21fdd31-e50f-4a09-90e6-eaec5fb48f24",
                                                "sense_id": "803561ab-c356-3a52-a950-bb1aa61a43b1",
                                                "text": "Another type of splint basket, called a punnet, was used in the strawberry trade of New York City between 1815 and 1850.[…]Punnets and pottles found little favor except in the vicinity of Boston and New York and were soon discarded for more convenient and less expensive packages."
                                            },
                                            {
                                                "example_id": "ea18bf57-8c1e-44ef-98e8-fd85a172861a",
                                                "sense_id": "803561ab-c356-3a52-a950-bb1aa61a43b1",
                                                "text": "Most of the fruit for market is picked and sold in punnets, but for jam making buckets are used, similar to the raspberry bucket."
                                            },
                                            {
                                                "example_id": "8e927382-bde9-4be9-8cd0-63b2949cdcfd",
                                                "sense_id": "803561ab-c356-3a52-a950-bb1aa61a43b1",
                                                "text": "Early this season, Ross Lill got together with a plastics firm to produce a flat tray to replace the commonly used punnet."
                                            },
                                            {
                                                "example_id": "9db61f0d-018d-48bb-a7e8-f7c483dc6a58",
                                                "sense_id": "803561ab-c356-3a52-a950-bb1aa61a43b1",
                                                "text": "However we recommend, particularly in cooler climates, sowing tomato seeds into a seed tray or punnet and allowing the seedlings to grow before they are transplanted into the garden."
                                            },
                                            {
                                                "example_id": "57cd474b-4cb9-4c70-adf0-8ff14f9a4dff",
                                                "sense_id": "803561ab-c356-3a52-a950-bb1aa61a43b1",
                                                "text": "‘But rather than spend £5 on a small punnet of exotic berries, a family would be better off buying regular and larger quantities of fresh fruit and vegetables from their local market.[…]’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
