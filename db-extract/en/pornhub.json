                    {
                        "sense_id": "997a2ca3-5573-34e2-a7e2-cb001b2cf704",
                        "entry_id": "cb283c80-f0b4-398d-939c-53818209c8c6",
                        "glosses": [
                            "A pornographic website; a porn tube."
                        ],
                        "tags": [
                            "informal"
