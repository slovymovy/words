                    },
                    {
                        "form_id": "03420cfb-d7ff-47d0-8a7d-81f92016ef96",
                        "entry_id": "2b45be5d-aa14-3799-b755-87c3ca51ec7b",
                        "tags": [
                            "accusative",
                            "plural"
