                        "cross_references": []
                    },
                    {
                        "translation_id": "27ed4371-83da-4a31-9422-852f5f6f7067",
                        "source_entry_id": "81008b77-d3f6-3a08-ae8a-7eb567ecea16",
                        "source_sense_id": "964c47fa-0cad-3612-af79-3e8dd072471b",
                        "target_lang_word": "rain forest",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rain forest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "977202aa-8f8b-34e9-8b49-853b66c377bf",
                                        "entry_id": "7904db58-422f-31fd-a6af-6e4054b78275",
                                        "glosses": [
                                            "Alternative form of rainforest."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74bb843e-4ff6-4872-8e8e-7ca7d4cff890",
                                                "sense_id": "977202aa-8f8b-34e9-8b49-853b66c377bf",
                                                "text": "In recent years, the problems of the tropical rain forests have become an almost daily topic of conversation."
                                            },
                                            {
                                                "example_id": "58785e0e-74a4-4f95-8b9d-f758b9ed0671",
                                                "sense_id": "977202aa-8f8b-34e9-8b49-853b66c377bf",
                                                "text": "2002, Rain Forests of the World, Marshall Cavendish Corporation, page 449,\nTropical rain forests have a greater variety of plants than any other place on Earth."
                                            },
                                            {
                                                "example_id": "9755185b-a566-4141-a2e6-fc7a3235fde5",
                                                "sense_id": "977202aa-8f8b-34e9-8b49-853b66c377bf",
                                                "text": "Here's some more left-wing nonsense, this time from the environmentalists, the folks who gave us the rain forest. \"Save the rain forest.\" They decided to call it that because they needed to raise money, and they knew no one would give them money to save a jungle. \"Save the jungle\" doesn't sound right."
                                            },
                                            {
                                                "example_id": "63dffe3b-7876-4587-9d95-1f40864bad10",
                                                "sense_id": "977202aa-8f8b-34e9-8b49-853b66c377bf",
                                                "text": "A large number of everyday foodstuffs that we enjoy today have their origins in the rain forests of the world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39ede32e-5061-445b-b49c-7d5bec531298",
                        "source_entry_id": "81008b77-d3f6-3a08-ae8a-7eb567ecea16",
