                        "glosses": [
                            "Basses eaux produites par l'enlèvement momentané des barrages qui relèvent le niveau de la Mayenne."
                        ],
                        "tags": [
                            "Mayenne"
                        ],
                        "examples": [
                            {
                                "example_id": "f66019f9-afce-4e82-b85f-34b7dbf45be6",
                                "sense_id": "1fb45331-5c44-34a1-8ce2-1a4cd502696c",
                                "text": "Le temps de l'écourue."
                            },
                            {
                                "example_id": "4f3c95ec-5577-43e5-9e35-38fd73025692",
                                "sense_id": "1fb45331-5c44-34a1-8ce2-1a4cd502696c",
                                "text": "Durant les écourues, en vous promenant sur le lit à sec de la rivière, vous pourrez découvrir les arrivoirs, débouchés de canalisations de rivières ou d'égouts."
                            },
                            {
                                "example_id": "dc5dd971-9093-453f-995b-137deb21b48f",
                                "sense_id": "1fb45331-5c44-34a1-8ce2-1a4cd502696c",
                                "text": "En septembre 2024, la rivière Mayenne sera mise à sec. Cette opération, appelée « écourues », a pour but de réaliser une inspection générale des barrages et écluses, et de faire des travaux."
                            }
                        ]
