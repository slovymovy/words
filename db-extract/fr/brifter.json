                        ],
                        "examples": [
                            {
                                "example_id": "9ab72670-91e5-4f2f-bd66-65799a008047",
                                "sense_id": "d162761f-4575-343d-8f8e-65225d9326fa",
                                "text": "Ne me dis pas qu’il ne t’a pas été agréable d'aller brifter chez le Garde dans tout l’éclat de ta beauté, d’ailleurs bien réelle, éblouissante et remarquée !"
                            },
                            {
                                "example_id": "245ed811-2d88-4d63-8149-9977a337aaf3",
                                "sense_id": "d162761f-4575-343d-8f8e-65225d9326fa",
                                "text": "Oh, puis tu m’emmerdes, continue à brifter ta barquette de carottes râpées et laisse moi regarder la Vie, la vraie se dérouler sous mes yeux."
                            }
                        ]
                    }
