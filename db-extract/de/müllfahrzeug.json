                "senses": [
                    {
                        "sense_id": "e7ce922b-53e3-3594-8acf-49ac207dba33",
                        "entry_id": "c6460b06-99a5-323e-bf49-e8bb46552a26",
                        "glosses": [
                            "spezielles Fahrzeug, dass den Müll transportiert, der durch die Entleerung von Mülltonnen in das Fahrzeug gelangt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "651837c8-d3cc-4c25-9c33-44ef9cfc9f03",
                                "sense_id": "e7ce922b-53e3-3594-8acf-49ac207dba33",
                                "text": "„Ersten Erkenntnissen zufolge soll das Müllfahrzeug wie immer, wenn der Rückwärtsgang eingelegt wird, auch am Freitag laute und regelmäßige Piepstöne von sich gegeben haben.“"
                            },
                            {
                                "example_id": "b195b433-440a-476f-b51d-046a16f33d8c",
                                "sense_id": "e7ce922b-53e3-3594-8acf-49ac207dba33",
                                "text": "„Ein 51-jähriger Pkw-Fahrer aus Dassel aus geriet am Donnerstag aus ungeklärter Ursache auf die gegenüberliegende Fahrbahn und stieß dort frontal mit einem Müllfahrzeug zusammen.“"
                            },
                            {
                                "example_id": "27888c9d-4a57-459c-907d-f0225021e16c",
                                "sense_id": "e7ce922b-53e3-3594-8acf-49ac207dba33",
                                "text": "„Tietjen hat seine Ausbildung bei der HAMEG im August letzten Jahres begonnen und verfügt bereits über die erforderlichen Fahrerlaubnisse zum Steuern der mächtigen Müllfahrzeuge.“"
                            },
                            {
                                "example_id": "b476867f-0dc3-4b76-82ae-30a5239e3268",
                                "sense_id": "e7ce922b-53e3-3594-8acf-49ac207dba33",
                                "text": "„Ein Müllfahrzeug der Hamburger Stadtreinigung ist am Dienstagnachmittag gegen 16.30 Uhr auf der Berner Brücke auf die Seite gestürzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
