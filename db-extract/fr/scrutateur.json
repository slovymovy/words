                                "target_senses": [
                                    {
                                        "sense_id": "f0bfaefa-ed4d-3818-a60d-c38a34db2f9b",
                                        "entry_id": "7133f54a-4351-3f01-9d04-b0fb1a28965b",
                                        "glosses": [
                                            "One who scrutinizes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87f03e99-3de1-4d25-b3fe-d5a41727155c",
                                                "sense_id": "f0bfaefa-ed4d-3818-a60d-c38a34db2f9b",
                                                "text": "The world's Alberto Grimaldis can fight scrutiny by burying truth in committees, dullness and misinformation, or by intimidating the scrutinizers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
