{
    "word_family": [
        "severance",
        "severable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "34005b57-f492-31a4-81d0-19c439492f04",
                    "sense_definition": "To cut something off or separate it completely.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The accident caused the machine to <w>sever</w> the power cable.",
                            "target_lang_translations": {
                                "pl": "Wypadek spowodował, że maszyna <w>odcięła</w> kabel zasilający."
                            }
                        },
                        {
                            "text": "He decided to <w>sever</w> all ties with his former business partners.",
                            "target_lang_translations": {
                                "pl": "Postanowił <w>zerwać</w> wszelkie kontakty ze swoimi byłymi partnerami biznesowymi."
                            }
                        }
                    ],
                    "synonyms": [
                        "cut off"
                    ],
                    "common_phrases": [
                        "sever ties"
                    ],
                    "target_lang_definitions": {
                        "pl": "Odciąć lub całkowicie oddzielić coś od całości."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "odcinać",
                                "target_lang_sense_clarification": "oddzielać coś od całości poprzez cięcie"
                            },
                            {
                                "target_lang_word": "odciąć",
                                "target_lang_sense_clarification": "dokonana forma oddzielenia czegoś"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e654d89-7b59-3862-9046-5cd88fa29f04",
                    "sense_definition": "To disconnect or terminate a relationship or legal agreement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company had to <w>sever</w> its contract with the supplier due to poor quality.",
                            "target_lang_translations": {
                                "pl": "Firma musiała <w>rozwiązać</w> umowę z dostawcą z powodu niskiej jakości."
                            }
                        },
                        {
                            "text": "They agreed to <w>sever</w> the legal partnership after many years of conflict.",
                            "target_lang_translations": {
                                "pl": "Zgodzili się <w>rozwiązać</w> partnerstwo prawne po wielu latach konfliktu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sever a contract"
                    ],
                    "target_lang_definitions": {
                        "pl": "Zerwać relację, kontrakt lub porozumienie prawne."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zrywać",
                                "target_lang_sense_clarification": "kończyć relację lub umowę"
                            },
                            {
                                "target_lang_word": "rozwiązywać",
                                "target_lang_sense_clarification": "formalne zakończenie umowy lub kontraktu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a87246e7-4b36-307a-9c39-c28aa6c5b1ab",
                    "sense_definition": "To be separated or parted from something or someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was difficult to be <w>severed</w> from his family during the long war.",
                            "target_lang_translations": {
                                "pl": "Trudno było <w>zostać odciętym</w> od rodziny podczas długiej wojny."
                            }
                        },
                        {
                            "text": "The island was <w>severed</w> from the mainland by the rising tide.",
                            "target_lang_translations": {
                                "pl": "Wyspa została <w>odcięta</w> od stałego lądu przez przypływ."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Zostać oddzielonym od kogoś lub czegoś."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zostać odciętym",
                                "target_lang_sense_clarification": "być odizolowanym od kogoś lub czegoś"
                            },
                            {
                                "target_lang_word": "odizolować się",
                                "target_lang_sense_clarification": "stan bycia oddzielonym od otoczenia"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e80a59b1-cb81-3eb7-ace5-640ed811d456",
                    "sense_definition": "To make a clear distinction between two things.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "distinction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge had to <w>sever</w> the two cases because they involved different legal issues.",
                            "target_lang_translations": {
                                "pl": "Sędzia musiał <w>rozdzielić</w> te dwie sprawy, ponieważ dotyczyły różnych kwestii prawnych."
                            }
                        },
                        {
                            "text": "It is important to <w>sever</w> fact from fiction in this report.",
                            "target_lang_translations": {
                                "pl": "Ważne jest, aby <w>oddzielić</w> fakty od fikcji w tym raporcie."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Dokonać wyraźnego rozróżnienia między dwiema rzeczami."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rozróżniać",
                                "target_lang_sense_clarification": "dostrzegać różnicę między rzeczami"
                            },
                            {
                                "target_lang_word": "oddzielać",
                                "target_lang_sense_clarification": "stawiać wyraźną granicę między pojęciami"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}