                    {
                        "translation_id": "d997906b-0238-4c6e-8c03-fbc993f3382a",
                        "source_entry_id": "8e4b8de7-55d0-36e7-8f57-02e8f76021fd",
                        "source_sense_description": "a photo containing someone or something that is photobombing",
                        "target_lang_word": "photobomb",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "photobomb",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "81dbb984-474f-3043-af9f-6670ec0db541",
                                        "entry_id": "a74c04bc-d648-327e-8bfb-fffb0953cb62",
                                        "glosses": [
                                            "Photographie victime d’un photobombeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c34421a9-a72a-432f-9cff-0d264529c38f",
                                                "sense_id": "81dbb984-474f-3043-af9f-6670ec0db541",
                                                "text": "Dans le cas d’un photobomb involontaire, la scène en arrière-plan doit éclipser celle du premier plan. Un physique, une expression, un accessoire ou une scène insolites font un bon photobomb."
                                            },
                                            {
                                                "example_id": "c8e40b29-cb83-4745-974d-3f948e15c42c",
                                                "sense_id": "81dbb984-474f-3043-af9f-6670ec0db541",
                                                "text": "Un bon « photobomb » peut être hilarant quand il est fait exactement au bon moment, mais encore plus quand les personnes impliquées sont riches et célèbres."
                                            },
                                            {
                                                "example_id": "719414b0-f8a3-45ce-80cc-51bd2da185de",
                                                "sense_id": "81dbb984-474f-3043-af9f-6670ec0db541",
                                                "text": "L’acteur britannique est passé quant à lui maître dans l’art du « photobomb » - s’incruster dans une photo sans en avertir son auteur au préalable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
