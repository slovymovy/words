                "senses": [
                    {
                        "sense_id": "d73de08e-085a-3013-ac87-20bb93c94c97",
                        "entry_id": "30c1f3ff-7623-330c-842e-751b7b75c89e",
                        "glosses": [
                            "een fout in het beoordelen van een persoon of situatie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "352df568-e35a-4173-a9aa-0882ce477e7a",
                                "sense_id": "d73de08e-085a-3013-ac87-20bb93c94c97",
                                "text": "Constant was ik met mezelf in gesprek over praktische zaken, zoals hoeveel water mee te nemen en wat te doen als ik zou verdwalen, tot mezelf afvragen of ik niet te ver was gegaan door mijn gezin zo lang te verlaten. Ook sprak ik mezelf af en toe streng toe en schold mezelf uit als ik weer eens een inschattingsfout had gemaakt."
                            },
                            {
                                "example_id": "40b05136-7458-4036-b22a-adf8739548ba",
                                "sense_id": "d73de08e-085a-3013-ac87-20bb93c94c97",
                                "text": "Halsema had een eind aan de onverwacht druk bezochte demonstratie moeten maken, omdat de volksgezondheid in gevaar was, aldus de opstellers. Ze verweten haar dat ze veel inschattingsfouten heeft gemaakt. De burgemeester erkende dat, betuigde daarover haar spijt en zegde toe dat ze de gang van zaken laat onderzoeken."
                            }
                        ]
                    }
