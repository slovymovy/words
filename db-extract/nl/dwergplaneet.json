                                        "glosses": [
                                            "A planetary (world-like) body of the Solar system, that directly orbits the Sun like the classical planets but does not gravitationally dominate other bodies in the region of its orbit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31610be0-7f62-439a-8072-104ef1eb4387",
                                                "sense_id": "8551dd20-32f7-32ce-9968-89ba1c013d21",
                                                "text": "A member of the Fomor Belt, Bres is a dwarf planet with no atmosphere."
                                            }
                                        ]
                                    }
                                ]
                            }
