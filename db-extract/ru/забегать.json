                        "entry_id": "bec3b39d-4e16-300e-bbf1-4df45844870e",
                        "glosses": [
                            "to get [with в (v, + accusative) or на (na, + accusative) ‘somewhere’] by running or as if by running"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc472ef3-eefd-48df-84f2-f7be263125b4",
                                "sense_id": "06af9ac7-87ec-3ad3-9d02-6075a1b7d664",
                                "text": "Он ка́ждый день забега́ет туда́ пе́ред рабо́той.",
                                "translation": "He runs that way every day before work.",
                                "english": "He runs that way every day before work."
                            }
                        ]
                    },
                    {
                        "sense_id": "3b2a96be-3248-3c40-bf39-a1e8424a8038",
                        "entry_id": "bec3b39d-4e16-300e-bbf1-4df45844870e",
                        "glosses": [
                            "to run ahead (in anticipation), to run before someone"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72928607-85d3-4127-9a8e-0cf7d25c0e9b",
                                "sense_id": "3b2a96be-3248-3c40-bf39-a1e8424a8038",
                                "text": "Не на́до забега́ть вперёд!",
                                "translation": "No need to run ahead!",
                                "english": "No need to run ahead!"
                            }
                        ]
