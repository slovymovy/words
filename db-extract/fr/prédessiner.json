                ],
                "senses": [
                    {
                        "sense_id": "2c61bb49-3108-3d67-9dd0-a8f76e6087dc",
                        "entry_id": "f2a25890-9b31-3634-93a5-08e8adf30dc4",
                        "glosses": [
                            "Dessiner de façon préalable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "841bc23b-be48-453e-8766-54ebde8ab8da",
                                "sense_id": "2c61bb49-3108-3d67-9dd0-a8f76e6087dc",
                                "text": "Aussi pensait-il que, si le passé ne peut jamais prédessiner notre action, il faut cependant apprendre à dire l'histoire avec nos mots, dans nos mots, pour avoir chance d'inscrire notre action dans le temps."
                            },
                            {
                                "example_id": "fca3b992-cedb-42e2-9800-31ef5f760063",
                                "sense_id": "2c61bb49-3108-3d67-9dd0-a8f76e6087dc",
                                "text": "Dans certains cas, il apparaît difficile de voir se prédessiner, dans l'organisation de la réflexion, des pratiques, et du système social de la science — ce vers quoi celle-ci conduit."
                            }
                        ]
                    }
