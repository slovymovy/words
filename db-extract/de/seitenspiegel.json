                                        "glosses": [
                                            "Either of a pair of mirrors on the sides of a car or other vehicle that enable the driver to see to the side and behind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a96bfbd-d3cf-4199-bbe8-b7976283654c",
                                                "sense_id": "9d44f09e-469e-376c-a992-9d2c3f4a5353",
                                                "text": "I could see the dog running behind me in my wing mirror, but couldn't do anything about it."
                                            }
