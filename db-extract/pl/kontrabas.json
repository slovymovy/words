                    {
                        "translation_id": "ded2d654-843a-4cca-b323-b559fe4b3481",
                        "source_entry_id": "b3bd02fb-cb1a-33cc-b827-18d0185537a8",
                        "source_sense_id": "973bb034-b266-3cf4-b2e8-5dd5b072addd",
                        "target_lang_word": "contrabas",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contrabas",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0c4f6637-05a4-3925-8ed8-10b007b3bb0e",
                                        "entry_id": "30c4a4d2-3aff-38d6-8898-2d7c05d98973",
                                        "glosses": [
                                            "het laagstklinkende muziekinstrument van de strijkinstrumenten met een lagere toon dan de bas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91ab73ff-47bd-42e3-8d89-424bb77cc0de",
                                                "sense_id": "0c4f6637-05a4-3925-8ed8-10b007b3bb0e",
                                                "text": "Niek de Groot is voor het eerst met de contrabas te horen tijdens een concerttournee met violiste Liza Ferschtman. Vanaf 9 april treedt hij op in Enschede, Heerlen, Groningen, Leiden, Haarlem en Nijmegen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c62dbbdd-e03b-49dc-8cd0-dcfabe624c47",
                        "source_entry_id": "b3bd02fb-cb1a-33cc-b827-18d0185537a8",
                        "source_sense_id": "973bb034-b266-3cf4-b2e8-5dd5b072addd",
                        "target_lang_word": "Kontrabass",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kontrabass",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0d925550-b072-3954-9809-0b5e4bcd3912",
                                        "entry_id": "bbef6391-fc44-30de-af8e-f359ab72a95b",
                                        "glosses": [
                                            "größtes und tiefstes der heute im Orchester verwendeten Streichinstrumente"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ebc50b8-e8ee-40a9-8693-a4cc720e50ef",
                                                "sense_id": "0d925550-b072-3954-9809-0b5e4bcd3912",
                                                "text": "„Zwar ist der Kontrabass ein Orchester-Instrument und dient dort den Streichern als Fundament. Dennoch ist auf ihm Virtuosität entwickelt worden. Sogar Doppelgriffe und Flageolett sind möglich.“"
                                            },
                                            {
                                                "example_id": "e9cecbe6-ad15-45c8-9f6c-9c7d71d11f4f",
                                                "sense_id": "0d925550-b072-3954-9809-0b5e4bcd3912",
                                                "text": "Mit Kontrabass und Gitarre tourt er [Reinhard Röhrs] durch Deutschland und rezitiert Texte von Christian Morgenstern."
                                            },
                                            {
                                                "example_id": "0dc21e7d-1988-4ef8-a1eb-e9670ad5ab60",
                                                "sense_id": "0d925550-b072-3954-9809-0b5e4bcd3912",
                                                "text": "„Im zweiten Akt stellten die bemalten Kartons Grabmonumente vor, und in der Leinwand war ein Loch, das den Mond bedeutete, und das Rampenlicht war durch Schirme abgedämpft, und die Trompeten und Kontrabässe gaben dumpfe Basstöne von sich, und von rechts und links kam eine Menge von Menschen in schwarzen Mänteln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a780ba96-33b8-471b-ae17-cfcd93eed1e5",
                        "source_entry_id": "b3bd02fb-cb1a-33cc-b827-18d0185537a8",
                        "source_sense_id": "973bb034-b266-3cf4-b2e8-5dd5b072addd",
                        "target_lang_word": "контраба́с",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "контраба́с",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3648379a-4a75-39bb-9a53-04890b53641d",
                                        "entry_id": "cd8b29ec-bd46-36d8-8278-a12d1bbd3aff",
                                        "glosses": [
                                            "муз. самый большой по размеру смычковый музыкальный инструмент наиболее низкого регистра"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a049060-4892-43e5-b6fd-280f825a50b0",
                                                "sense_id": "3648379a-4a75-39bb-9a53-04890b53641d",
                                                "text": ".. скрипка взвизгивала, у правого уха хрипел контрабас .."
                                            },
                                            {
                                                "example_id": "88e96e9a-d00f-4758-a538-72847c435663",
                                                "sense_id": "3648379a-4a75-39bb-9a53-04890b53641d",
                                                "text": "Скрипки и контрабасы .. заиграли первую фигуру кадрили на мотивы «Прекрасной Eлены» .."
                                            },
                                            {
                                                "example_id": "9e971f30-fd8b-4034-8c81-c0134d0264ac",
                                                "sense_id": "3648379a-4a75-39bb-9a53-04890b53641d",
                                                "text": "На эстраде возвышался контрабас в чехле, лежал на стуле саксофон — музыканты уже пришли."
                                            },
                                            {
                                                "example_id": "6dc452bf-3f18-4270-84f6-a1490390df4a",
                                                "sense_id": "3648379a-4a75-39bb-9a53-04890b53641d",
                                                "text": "Со времени своего появления в 16 в. в Германии контрабас имел от трёх до пяти жильных струн; в 20 в. обычное число струн — четыре."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "контраба́с",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6299b05a-5154-3a07-a6d1-11400821bee3",
                                        "entry_id": "4017d7bf-5609-3fef-99b0-8111a6ef5810",
                                        "glosses": [
                                            "воен. жарг., пренебр. то же, что контрактник; военный, проходящий службу по контракту"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "003c367f-1984-46b2-96d4-6ba0c4d4e6d2",
                                                "sense_id": "6299b05a-5154-3a07-a6d1-11400821bee3",
                                                "text": "Офицеры ВДВ жалуются, что псковские «контрабасы» после получки массово уходят в самоволку и не возвращаются, пока всё не пропьют."
                                            },
                                            {
                                                "example_id": "13dadc38-f719-4847-ac4b-b0381d626125",
                                                "sense_id": "6299b05a-5154-3a07-a6d1-11400821bee3",
                                                "text": "Все шакалы вместе с прапорами и контрабасами ужрались дешёвой бесланской водки .. и пребывали в разной степени невменяемости."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6ed3ca8-2bfd-3056-ba0b-917f663a64fa",
                                        "entry_id": "4017d7bf-5609-3fef-99b0-8111a6ef5810",
                                        "glosses": [
                                            "жарг., пренебр. то же, что контрабандист"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfaca297-f667-4964-bbaf-0cdd2e693c95",
                                                "sense_id": "f6ed3ca8-2bfd-3056-ba0b-917f663a64fa",
                                                "text": "Основную массу пересекающих ныне польско-российскую границу составляют «контрабасы», как называют здесь тех, кто промышляет нелегальной приграничной торговлей. ❬…❭ Возвращающиеся после удачной поездки российские «контрабасы» рассказали «НИ» о том, что на границе широко развит всевозможный «сопровождающий» бизнес."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "контраба́с",
                                "target_lang_code": "ru",
