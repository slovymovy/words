                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "443dda84-7a3d-4e8d-8ec8-f6443b65731b",
                        "source_entry_id": "cd848de0-7dc8-3082-80b0-f59c14cc2962",
                        "source_sense_id": "30eb7fbe-74b0-3ca1-80bb-6311ed44c685",
