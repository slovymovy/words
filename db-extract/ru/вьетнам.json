                                                "example_id": "023d2cc2-c381-4434-a291-38775f37d3a7",
                                                "sense_id": "543ac90f-a55b-393d-8f47-1daca3398e05",
                                                "text": "Judy is the great deceiver / Judy is your Viet Nam"
