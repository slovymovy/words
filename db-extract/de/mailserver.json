                "senses": [
                    {
                        "sense_id": "ae6a5563-f79d-3082-8365-b48e49663ab2",
                        "entry_id": "75f64c9c-0344-3bf5-9ec8-3e5a43ee895c",
                        "glosses": [
                            "Server zum Empfangen, Speichern und Senden von E-Mails"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a29da02d-508d-4809-b5df-0e7cea61b3dd",
                                "sense_id": "ae6a5563-f79d-3082-8365-b48e49663ab2",
                                "text": "„Der Standardspeicherplatz, den zum Beispiel die Mailserver von Microsoft vorsehen, ist da bald erschöpft.“"
                            },
                            {
                                "example_id": "083b76e2-adda-4a0f-bba1-26518a0ec755",
                                "sense_id": "ae6a5563-f79d-3082-8365-b48e49663ab2",
                                "text": "„Wenn es um einen guten Zweck geht, ist das Netz immer dabei, und einige Leute hatten offensichtlich ihre Mailserver darauf programmiert, alle paar Sekunden eine Mail an Santa Claus loszuschicken.“"
                            }
                        ],
