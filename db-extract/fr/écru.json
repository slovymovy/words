                    },
                    {
                        "form_id": "1760cebd-afa0-4214-afe4-443f87530c26",
                        "entry_id": "9aba55d2-f52c-3bc4-8540-77fadd27d298",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "écrues"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9f5693f3-c805-3abc-88a5-35596be30b0c",
                        "entry_id": "9aba55d2-f52c-3bc4-8540-77fadd27d298",
                        "glosses": [
                            "Encore à l’état naturel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b769dc1-266b-4e00-a84d-089342ad45e1",
                                "sense_id": "9f5693f3-c805-3abc-88a5-35596be30b0c",
                                "text": "Soie écrue, celle qui n’a pas été mise à l’eau bouillante."
                            },
                            {
                                "example_id": "0dd3ec45-0c98-4755-8674-c641b191a3a1",
                                "sense_id": "9f5693f3-c805-3abc-88a5-35596be30b0c",
                                "text": "Fil écru, celui qui n’a pas été lavé."
                            },
                            {
                                "example_id": "feb1680d-13ce-472f-955d-caabaae6db2c",
                                "sense_id": "9f5693f3-c805-3abc-88a5-35596be30b0c",
                                "text": "Toile écrue, celle qui n’a pas été blanchie."
                            },
                            {
                                "example_id": "6f2e94d4-31b7-434e-8178-3be6d78b56a7",
                                "sense_id": "9f5693f3-c805-3abc-88a5-35596be30b0c",
                                "text": "On devra s’arrêter plus tôt ou plus tard, selon qu’il faudra, ou simplement dégrisonner les toiles écrues, ou leur donner divers tons blancs (blanc bourgeois, blanc de Senlis, blanc demi-lait, plein-lait) ; c’est du reste ce qui ressortira de l’exposé rapide que nous allons donner des manipulations successives."
                            }
                        ]
                    },
                    {
                        "sense_id": "76cc0681-d70e-38fb-9fd2-08b9936870e7",
                        "entry_id": "9aba55d2-f52c-3bc4-8540-77fadd27d298",
                        "glosses": [
                            "De couleur blanche légèrement teintée de jaune, comme celle de la toile non blanchie. #FEFEE0"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccdefddb-fb9a-4340-8aaa-ae34ca1e1ae4",
                                "sense_id": "76cc0681-d70e-38fb-9fd2-08b9936870e7",
                                "text": "C'était une grande pièce de laine, de couleur écrue, un habit majestueux mais lourd et encombrant. La toge était jetée sur l'épaule gauche, drapée sous le bras droit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c232a109-8c42-4c27-81bf-0aea411b39fb",
                        "source_entry_id": "9aba55d2-f52c-3bc4-8540-77fadd27d298",
                        "source_sense_description": "blanc cassé",
                        "target_lang_word": "ecru",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ecru",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "92a4d8db-dfe9-312e-ba5a-60b9a6c51f31",
                                        "entry_id": "e08ba7f3-b078-3e0f-8347-5bda632be1b1",
                                        "glosses": [
                                            "A beige colour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb0f2a94-395b-42f2-85ff-a86e34a3b6d2",
                                                "sense_id": "92a4d8db-dfe9-312e-ba5a-60b9a6c51f31",
                                                "text": "We have descended Tian Shan and entered the Taklamakan Desert, a barren landscape painted in ecru—no shrubs, no grass, only waves upon waves of naked ridges the color of buff, the highest few spotted with white specks of snow."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ecru",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f567372a-7946-3931-8c47-c5cccc8f4f56",
                                        "entry_id": "3440c47e-8607-33fa-bc45-cdf3fd5379c3",
                                        "glosses": [
                                            "Of a beige colour."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "146304d4-9078-4521-80f4-be13ab650136",
                                                "sense_id": "f567372a-7946-3931-8c47-c5cccc8f4f56",
                                                "text": "Miriam fell in love with a tulle-and-lace gown, but Judy returned to the first one they'd looked at, an ecru satin bridal gown..."
                                            },
                                            {
                                                "example_id": "6b5f0d04-da15-4d9f-a7e2-1cbb8a924b79",
                                                "sense_id": "f567372a-7946-3931-8c47-c5cccc8f4f56",
                                                "text": "I might rethink my cream suit, I say. “Do you really have a cream suit?” she sighs. “Is it cream or is it ecru?” With that, I learn a new word."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
