            "senses": [
                {
                    "sense_id": "9f91f538-50f0-3d80-98c5-29b7169702cf",
                    "sense_definition": "The act of comforting, pacifying, or relieving someone or something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gentle <w>soothing</w> of his worried mind took hours of patient listening and understanding.",
                            "target_lang_translations": {
                                "pl": "Łagodne <w>ukojenie</w> jego zatroskanego umysłu wymagało wielu godzin cierpliwego słuchania i zrozumienia."
                            }
                        },
                        {
                            "text": "She preferred the quiet <w>soothing</w> of a trusted friend over the noise of the crowded room.",
                            "target_lang_translations": {
                                "pl": "Wolała ciche <w>pocieszenie</w> ze strony zaufanego przyjaciela niż hałas zatłoczonego pokoju."
                            }
