                "senses": [
                    {
                        "sense_id": "6b55d121-d778-3564-9aab-7ccc7310c7ba",
                        "entry_id": "74665882-dedc-3293-8364-44568f9898cc",
                        "glosses": [
                            "Währung, in der für Export und Außenhandel Rechnungen geschrieben werden; Währung, in der ein Importeur den Exporteur für gelieferte Waren bezahlt"
                        ],
                        "tags": [
                            "Bankwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "0b2486cb-42d2-4f86-af4c-1721fbfaa1ff",
                                "sense_id": "6b55d121-d778-3564-9aab-7ccc7310c7ba",
                                "text": "„Der Euro ist internationale Fakturierungswährung.“"
                            },
                            {
                                "example_id": "dd391a95-69c1-4c03-91ea-3263ca46fe17",
                                "sense_id": "6b55d121-d778-3564-9aab-7ccc7310c7ba",
                                "text": "„Die Wahl der geeigneten Fakturierungswährung im Außenhandel kann jedoch zusätzlich von anderen Aspekten beeinflusst sein.“"
                            },
                            {
                                "example_id": "f80ca745-80b3-448d-82aa-1e25e0ac2f16",
                                "sense_id": "6b55d121-d778-3564-9aab-7ccc7310c7ba",
                                "text": "„Die internationale Rolle einer Währung wird üblicherweise an ihren Funktionen als Anlage- und Emissionswährung, Reservewährung, Fakturierungs- und Transaktionswährung sowie als Ankerwährung für die Wechselkurspolitik gemessen.“"
                            },
                            {
                                "example_id": "76d73a74-db9a-4f43-b1f7-8236feef8e9a",
                                "sense_id": "6b55d121-d778-3564-9aab-7ccc7310c7ba",
                                "text": "„Laut britischen Medienberichten sollen arabische Golfstaaten Gespräche mit Russland, China, Japan und Frankreich führen, um den Dollar als Fakturierungswährung abzulösen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
