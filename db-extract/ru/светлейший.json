                "senses": [
                    {
                        "sense_id": "290fffd1-61f8-3c68-a6e4-ae3858e4b4d8",
                        "entry_id": "2b48af9d-805d-3944-ac5a-c6dc4cf6f0e0",
                        "glosses": [
                            "устар. превосх. ст. к прил. светлый"
                        ],
                        "tags": [
                            "superlative"
                        ],
                        "examples": [
                            {
                                "example_id": "19873419-3ec8-4810-a399-cd6ff8cfacae",
                                "sense_id": "290fffd1-61f8-3c68-a6e4-ae3858e4b4d8",
                                "text": "Пахом сказал: светлейшему // Вельможному боярину, // Министру государеву, // А Пров сказал: царю…"
                            }
                        ]
                    },
                    {
                        "sense_id": "3a5d452c-6f24-3825-8a4d-c364b706be29",
                        "entry_id": "2b48af9d-805d-3944-ac5a-c6dc4cf6f0e0",
                        "glosses": [
                            "субстантивир., истор. то же, что светлейший князь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7bff3e9-8169-4377-a762-5c582be010c5",
                                "sense_id": "3a5d452c-6f24-3825-8a4d-c364b706be29",
                                "text": "В доме Шевалье частенько бывали самые знатные вельможи: светлейший князь Петр Васильевич Лопухин, граф Пален, Андрей Семенович Кологривов, Иван Александрович Нарышкин, граф Соллогуб, граф Федор Васильевич Ростопчин."
                            }
                        ]
                    }
