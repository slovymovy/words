            "senses": [
                {
                    "sense_id": "897d4f62-1e2e-3fc4-99c8-a9515ba87e95",
                    "sense_definition": "проводить хирургическую операцию над кем-либо",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "surgery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Хирург будет <w>оперировать</w> пациента завтра утром.",
                            "target_lang_translations": {
                                "en": "The surgeon will <w>operate</w> on the patient tomorrow morning."
                            }
                        },
                        {
                            "text": "Опытный врач <w>оперировал</w> пострадавшего несколько часов.",
                            "target_lang_translations": {
                                "en": "The experienced doctor <w>operated</w> on the victim for several hours."
                            }
                        }
                    ],
                    "common_phrases": [
                        "оперировать пациента",
                        "оперировать больного"
                    ],
                    "target_lang_definitions": {
