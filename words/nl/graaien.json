{
    "word_family": [
        "graai",
        "gegraai",
        "graaicultuur",
        "graaier",
        "graaimachine"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e2467710-a458-35d3-b104-e645a8ae4e6e",
                    "sense_definition": "met de handen ergens in rondtasten om iets te pakken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tasten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij begon in zijn diepe zakken te <w>graaien</w> op zoek naar zijn fietssleutels.",
                            "target_lang_translations": {
                                "en": "He started <w>rummaging</w> in his deep pockets looking for his bike keys."
                            }
                        },
                        {
                            "text": "De kinderen mochten na het feestje in de grabbelton <w>graaien</w> voor een cadeautje.",
                            "target_lang_translations": {
                                "en": "After the party, the children were allowed to <w>scrabble</w> in the lucky dip for a gift."
                            }
                        }
                    ],
                    "synonyms": [
                        "grabbelen",
                        "tasten",
                        "woelen"
                    ],
                    "common_phrases": [
                        "in de grabbelton graaien",
                        "in je zakken graaien"
                    ],
                    "target_lang_definitions": {
                        "en": "To grope or rummage around with one's hands in order to find or grab something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to rummage",
                                "target_lang_sense_clarification": "searching through something"
                            },
                            {
                                "target_lang_word": "to grope",
                                "target_lang_sense_clarification": "feeling around blindly"
                            },
                            {
                                "target_lang_word": "to scrabble",
                                "target_lang_sense_clarification": "using hands quickly to find something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "143dfcee-4cdf-3945-ae67-1309927a40cc",
                    "sense_definition": "iets snel of hebberig wegnemen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pakken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dief wist snel wat sieraden uit de vitrine te <w>graaien</w> en rende weg.",
                            "target_lang_translations": {
                                "en": "The thief managed to quickly <w>snatch</w> some jewelry from the display case and ran away."
                            }
                        },
                        {
                            "text": "Zodra de schaal met koekjes op tafel kwam, begon iedereen gulzig te <w>graaien</w>.",
                            "target_lang_translations": {
                                "en": "As soon as the bowl of cookies was placed on the table, everyone started <w>grabbing</w> greedily."
                            }
                        }
                    ],
                    "synonyms": [
                        "grissen",
                        "wegpakken",
                        "stelen"
                    ],
                    "common_phrases": [
                        "alles bij elkaar graaien"
                    ],
                    "target_lang_definitions": {
                        "en": "To take something away quickly, greedily, or roughly."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to snatch",
                                "target_lang_sense_clarification": "taking quickly"
                            },
                            {
                                "target_lang_word": "to grab",
                                "target_lang_sense_clarification": "taking roughly or greedily"
                            },
                            {
                                "target_lang_word": "to scramble",
                                "target_lang_sense_clarification": "competing to grab something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b04bf82-c530-3eaf-a18e-69d4f9609f30",
                    "sense_definition": "zichzelf op een oneerlijke of hebzuchtige manier verrijken, vaak in een hoge functie",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "verrijken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De publieke opinie was woedend toen bleek dat de directeuren bleven <w>graaien</w> ondanks de verliezen.",
                            "target_lang_translations": {
                                "en": "Public opinion was furious when it turned out the directors continued <w>lining their pockets</w> despite the losses."
                            }
                        },
                        {
                            "text": "Er moet een wet komen die het ongegeneerd <w>graaien</w> aan de top van het bedrijfsleven stopt.",
                            "target_lang_translations": {
                                "en": "There must be a law that stops the shameless <w>greed</w> at the top of the business world."
                            }
                        }
                    ],
                    "synonyms": [
                        "zakkenvullen"
                    ],
                    "common_phrases": [
                        "graaien aan de top"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt in een politieke of maatschappelijke context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To enrich oneself in a greedy or dishonest way, especially in high-level positions."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to line one's pockets",
                                "target_lang_sense_clarification": "enriching oneself dishonestly"
                            },
                            {
                                "target_lang_word": "to help oneself",
                                "target_lang_sense_clarification": "taking greedily from funds"
                            },
                            {
                                "target_lang_word": "to grab",
                                "target_lang_sense_clarification": "metaphorical greed for money"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "39ab28ef-eb2d-3491-94ba-ec0746e91992",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>graai</w>",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met een paar snelle <w>graaien</w> had hij zijn tas vol met appels gestopt.",
                            "target_lang_translations": {
                                "en": "With a few quick <w>grabs</w>, he had filled his bag with apples."
                            }
                        },
                        {
                            "text": "Zijn onhandige <w>graaien</w> in de donkere la leverden niets op.",
                            "target_lang_translations": {
                                "en": "His clumsy <w>groping</w> in the dark drawer yielded nothing."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural form of the noun 'graai', referring to the act of grabbing or reaching for something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grabs",
                                "target_lang_sense_clarification": "plural acts of reaching"
                            },
                            {
                                "target_lang_word": "snatches",
                                "target_lang_sense_clarification": "quick attempts to take something"
                            }
                        ]
                    }
                }
            ]
        }
    ]
