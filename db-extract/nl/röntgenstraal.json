        "nl-extract.jsonl": [
            {
                "entry_id": "d739d6b4-ae4f-374c-9903-19e730980bef",
                "word": "röntgenstraal",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "d218c55d-40e2-4e5c-bf32-1ba06bf42cea",
                        "entry_id": "d739d6b4-ae4f-374c-9903-19e730980bef",
                        "tags": [
                            "plural"
                        ],
                        "form": "röntgenstralen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "96ddc32b-743a-3ff6-8fe9-961ee889e9a9",
                        "entry_id": "d739d6b4-ae4f-374c-9903-19e730980bef",
                        "glosses": [
                            "electromagnetische straling waarbij de fotonen een energie hebben van 124eV tot 1240 keV, een frequentie van 3×10^16 Hz tot 3×10^19 Hz en een golflengte van 0.01 tot 10 nanometers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6894e1b7-ecbe-421a-989d-4e108ba056b7",
                                "sense_id": "96ddc32b-743a-3ff6-8fe9-961ee889e9a9",
                                "text": "Het Federaal Agentschap voor Nucleaire Controle (FANC) vraagt de wielersector om waakzaam te zijn met de toestellen die fietsen scannen op elektrische motoren. Bij het gebruik van de apparatuur komen mogelijk schadelijke röntgenstralen vrij. De organisatie reageert daarmee op de aankondiging van de Belgische wielerbond KBWB om de mechanische fraude in de sport harder te gaan bestrijden."
                            }
                        ]
                    },
                    {
                        "sense_id": "734f0e13-a376-3c04-a099-9fb332954920",
                        "entry_id": "d739d6b4-ae4f-374c-9903-19e730980bef",
                        "glosses": [
                            "foto gemaakt met röntgenstralen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53b37499-9409-4035-b414-2eb07d399091",
                                "sense_id": "734f0e13-a376-3c04-a099-9fb332954920",
                                "text": "Hermans kwam woensdag ten val vlak na de finish op de Muur van Hoei in de Waalse Pijl. “We hebben röntgenstralen genomen en daaruit bleek dat hij bij die val twee ribben heeft gebroken”, aldus Michel Cerfontaine, ploegdokter van het Zwitserse team."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9464f296-6398-4870-ab85-40133ab81fe7",
                        "source_entry_id": "d739d6b4-ae4f-374c-9903-19e730980bef",
                        "source_sense_id": "96ddc32b-743a-3ff6-8fe9-961ee889e9a9",
                        "source_sense_description": "(natuurkunde) electromagnetische straling waarbij de fotonen een energie hebben van 124eV tot 1240 keV, een frequentie van 3×10^16 Hz tot 3×10^19 Hz en een golflengte van 0.01 tot 10 nanometers",
                        "target_lang_word": "X-ray",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "X-ray",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b296b28-7cd9-3578-8a69-688aa0a4d18a",
                                        "entry_id": "a8b86c0c-7c97-3a8c-9096-6384aca65eab",
                                        "glosses": [
                                            "Short wavelength electromagnetic radiation usually produced by bombarding a metal target in a vacuum. Used to create images of the internal structure of objects; this is possible because X-rays pass through most objects and can expose photographic film."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc71d7d2-c0a5-45b5-9cbd-cd6180b52ac1",
                                                "sense_id": "1b296b28-7cd9-3578-8a69-688aa0a4d18a",
                                                "text": "X-rays are light with a wavelength between 0.1 and 10 nm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f662f9e-fded-3bf5-95b2-6aa8289828a8",
                                        "entry_id": "a8b86c0c-7c97-3a8c-9096-6384aca65eab",
                                        "glosses": [
                                            "A radiograph: a photograph made with X-rays."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81fd8457-507d-4162-a31d-45e5a97ec310",
                                                "sense_id": "2f662f9e-fded-3bf5-95b2-6aa8289828a8",
                                                "text": "The doctor ordered some X-rays of my injured wrist."
                                            },
                                            {
                                                "example_id": "59e7c72d-b98f-439d-bf0d-73f984aab188",
                                                "sense_id": "2f662f9e-fded-3bf5-95b2-6aa8289828a8",
                                                "text": "And this friendly was not without its injury worries, with defender Gary Cahill substituted early on after a nasty, needless push by Dries Mertens that caused him to collide with goalkeeper Joe Hart, an incident that left the Chelsea defender requiring a precautionary X-ray at Wembley."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "921ee723-83b1-329c-9801-77af9b4972f1",
                                        "entry_id": "a8b86c0c-7c97-3a8c-9096-6384aca65eab",
                                        "glosses": [
                                            "An X-ray machine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8483fe02-c4f0-31a5-b5f1-fefd94aab18b",
                                        "entry_id": "a8b86c0c-7c97-3a8c-9096-6384aca65eab",
                                        "glosses": [
                                            "A tactical motif where a piece exerts influence or control over a square, piece, or line indirectly through another intervening piece."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "X-ray",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1b3a0bf-7b67-3087-898f-10ec1b3bfc72",
                                        "entry_id": "4a40ea0e-ce0b-3476-b50d-5c41c8e48c70",
                                        "glosses": [
                                            "To take a radiograph of; to obtain an image of using X-ray radiation, especially for the purpose of medical diagnostic evaluation."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0f280e9-306b-4e26-8d11-837b222f09d1",
                                                "sense_id": "c1b3a0bf-7b67-3087-898f-10ec1b3bfc72",
                                                "text": "Of course there was nothing wrong with my left wrist. They X-rayed the wrong arm!"
                                            },
                                            {
                                                "example_id": "98f727c1-ccff-4fcc-a0d7-26f8b8dd4755",
                                                "sense_id": "c1b3a0bf-7b67-3087-898f-10ec1b3bfc72",
                                                "text": "1925, Sidney Coe Howard, They Knew What They Wanted (Doubleday, Page and Company), Act II, page 116.\nBoth legs broken in the morning. Tibia, fibula, femur, and ischium. X-rayed and set inside of an hour after the accident."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a1b847d-0783-3ea3-a1f5-78ba9a7fb8b8",
                                        "entry_id": "4a40ea0e-ce0b-3476-b50d-5c41c8e48c70",
                                        "glosses": [
                                            "Of a piece, to exert indirect influence, by either attacking, defending, or controlling an opponent's or friendly piece through an intervening piece along a rank, file, or diagonal."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "X-ray",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d2479833-5a95-3ccc-8aff-7f64aadc7005",
                                        "entry_id": "008607c6-12ac-34f6-b37a-18fa42f5ae2e",
                                        "glosses": [
                                            "Of or relating to X-rays."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b3479cb-1e5d-4587-8e80-28d3a869f648",
                                                "sense_id": "d2479833-5a95-3ccc-8aff-7f64aadc7005",
                                                "text": "I had to put my bags through an X-ray scanner at the airport."
                                            },
                                            {
                                                "example_id": "192b17f1-037e-4043-8bdd-fe539f6b1976",
                                                "sense_id": "d2479833-5a95-3ccc-8aff-7f64aadc7005",
                                                "text": "Who will fly and have X-ray eyes— And be known as the man no bullet can kill?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
