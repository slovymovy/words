        "fr-extract.jsonl": [
            {
                "entry_id": "f1ca3c51-6e0d-34e3-95dd-c7790b3cc19f",
                "word": "compétitivité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ecca19ac-438e-4531-82fe-52ca7f8acc0d",
                        "entry_id": "f1ca3c51-6e0d-34e3-95dd-c7790b3cc19f",
                        "tags": [
                            "plural"
                        ],
                        "form": "compétitivités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ba3ad9ba-1b14-334e-93be-936ad88551a4",
                        "entry_id": "f1ca3c51-6e0d-34e3-95dd-c7790b3cc19f",
                        "glosses": [
                            "Capacité d’une offre, d’une entreprise à affronter la concurrence avec des chances de succès."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "efbd9e5c-6434-43df-a000-2f0ceeabfec4",
                                "sense_id": "ba3ad9ba-1b14-334e-93be-936ad88551a4",
                                "text": "La performance de la sphère publique est aujourd’hui une composante essentielle de la compétitivité qu’impose la mondialisation."
                            },
                            {
                                "example_id": "86898277-3a86-4018-b3da-750ef62c30c7",
                                "sense_id": "ba3ad9ba-1b14-334e-93be-936ad88551a4",
                                "text": "Compétitivité prix (ou compétitivité coût), compétitivité hors-prix : l’Allemagne est un bon exemple de cette distinction, ses coûts de production sont parmi les plus élevés au monde, elle a donc une très faible compétitivité prix. Mais la qualité de ses produits est telle qu’elle exporte ses produits dans le monde entier. Elle a donc une très forte compétitivité hors prix."
                            },
                            {
                                "example_id": "8ceb3ce7-cc27-4289-bb4a-72f2a2556232",
                                "sense_id": "ba3ad9ba-1b14-334e-93be-936ad88551a4",
                                "text": "L’étude pointe un manque de compétitivité des cultures européennes, un frein majeur à l’indépendance protéique, que ce soit par rapport au soja importé, mais aussi par rapport aux cultures céréalières, en concurrence avec les protéines végétales dans la rotation des cultures."
                            }
                        ]
                    },
                    {
                        "sense_id": "2884dfe4-bab2-3954-922d-5e6d1055904a",
                        "entry_id": "f1ca3c51-6e0d-34e3-95dd-c7790b3cc19f",
                        "glosses": [
                            "Performance à l’exportation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8acd335c-a036-42ff-bd0e-dd0043f161fe",
                                "sense_id": "2884dfe4-bab2-3954-922d-5e6d1055904a",
                                "text": "La DGCIS et la compétitivité"
                            },
                            {
                                "example_id": "8a25102f-3167-4ed5-a447-27621ba70719",
                                "sense_id": "2884dfe4-bab2-3954-922d-5e6d1055904a",
                                "text": "L’innovation dans les services constitue un facteur de compétitivité pour l’ensemble de l’économie française."
                            },
                            {
                                "example_id": "1deac6a0-963f-4549-b693-0f07df174c8f",
                                "sense_id": "2884dfe4-bab2-3954-922d-5e6d1055904a",
                                "text": "La compétitivité de l’ensemble de l’économie, à la fois coût et hors coût, dépend fortement de celle des entreprises de services."
                            }
                        ]
                    },
                    {
                        "sense_id": "21db9802-dbca-33b4-bd74-3892f4e38da8",
                        "entry_id": "f1ca3c51-6e0d-34e3-95dd-c7790b3cc19f",
                        "glosses": [
                            "Capacité d'un État à améliorer durablement le niveau de vie de ses habitants et à leur procurer un haut niveau d'emploi et de cohésion sociale dans un environnement de qualité. (Union européenne)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09016010-bb12-4b2b-ab4c-9d6c69d1ce3d",
                                "sense_id": "21db9802-dbca-33b4-bd74-3892f4e38da8",
                                "text": "Autrement dit, la compétitivité est l'aptitude d'un territoire à maintenir et à attirer les activités et investisseurs au service de l'amélioration durable du bien être des populations concernées."
                            }
                        ]
                    },
                    {
                        "sense_id": "838dda38-c5b0-3463-a850-bab62705fc9f",
                        "entry_id": "f1ca3c51-6e0d-34e3-95dd-c7790b3cc19f",
                        "glosses": [
                            "Caractère d’un sportif ou d’une équipe face à la compétition."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
