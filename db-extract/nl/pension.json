                                "sense_id": "d479aa55-48c1-34b1-83a7-25a71f8ff066",
                                "text": "Ik groeide op in een pension."
                            }
                        ]
                    },
                    {
                        "sense_id": "696c837d-d9a0-350b-b827-596e41ba9bb3",
                        "entry_id": "32266e47-fbc5-3ad9-94d7-edb957cb6e5a",
