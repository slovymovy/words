    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "9e43b257-ea11-3d1a-99b5-9a2283b20768",
                "word": "notarial",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e5d5ac72-fca7-381d-be54-f6e2c60e5e92",
                        "entry_id": "9e43b257-ea11-3d1a-99b5-9a2283b20768",
                        "glosses": [
                            "Pertaining to a notary or notaries."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "b569704f-dd4a-41df-b72d-9a4bc265b90a",
                                "sense_id": "e5d5ac72-fca7-381d-be54-f6e2c60e5e92",
                                "text": "There were outspoken attacks on the free field in law from 1797 onwards, and lawyers were reintroduced in 1800, as was a state system of notarial certification in 1803."
                            }
                        ]
                    },
                    {
                        "sense_id": "a032eb6b-50c1-30a2-8fe8-02b42a90e90a",
                        "entry_id": "9e43b257-ea11-3d1a-99b5-9a2283b20768",
                        "glosses": [
                            "Written or executed by a notary."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a1cafe2-d489-452f-bead-f339b75993a8",
                        "source_entry_id": "9e43b257-ea11-3d1a-99b5-9a2283b20768",
                        "source_sense_description": "pertaining to a notary or notaries",
                        "target_lang_word": "notarial",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "notarial",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5bc847c2-c636-3304-ad66-54cfe0b29702",
                                        "entry_id": "b8ff2945-c719-3c0a-b2c9-a3237259b2a5",
                                        "glosses": [
                                            "Relatif à la fonction de notaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1006be7-baa8-43d9-9d82-5c2152f37b2f",
                                                "sense_id": "5bc847c2-c636-3304-ad66-54cfe0b29702",
                                                "text": "Il n'en demeure pas moins que la substitution des archives judiciaires aux archives notariales amène un changement de tonalité dans l'éclairage : à une vision « lisse » se substitue une vision « rugueuse » des relations sociales."
                                            },
                                            {
                                                "example_id": "e176f5d8-3c9c-4de2-afeb-d871c57f39ff",
                                                "sense_id": "5bc847c2-c636-3304-ad66-54cfe0b29702",
                                                "text": "La compulsion des minutiers notariaux nous apporte donc d'utiles renseignements sur la répartition géographique des terres libres, et permet de mesurer, même de façon très approximative, l'importance des survivances allodiales dans le Bordelais d'Ancien Régime."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14a3b4ae-c57a-40c9-8169-731f2be61e3d",
                        "source_entry_id": "9e43b257-ea11-3d1a-99b5-9a2283b20768",
                        "source_sense_description": "pertaining to a notary or notaries",
                        "target_lang_word": "notariell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "notariell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0f5d0952-f272-37e5-978d-bf93d17328c1",
                                        "entry_id": "ee062f12-55a4-3f20-9999-935e79f57ec4",
                                        "glosses": [
                                            "durch einen speziellen Juristen (Notar) erstellt/angefertigt/ausgeführt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "188e51cf-9551-4623-9b72-6cc8811162a3",
                                                "sense_id": "0f5d0952-f272-37e5-978d-bf93d17328c1",
                                                "text": "„Der Widerruf kann nur in notariell beurkundeter Form erklärt werden, wobei er auch in einem notariellen Testament mit aufgenommen werden kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
