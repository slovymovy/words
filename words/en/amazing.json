                {
                    "sense_id": "71ef85b0-8e88-3342-be5d-25b3b55057ae",
                    "sense_definition": "Causing wonder and amazement; very surprising.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "surprising",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is <w>amazing</w> how much technology has changed in just ten years.",
                            "target_lang_translations": {
                                "ru": "<w>Поразительно</w>, как сильно изменились технологии всего за десять лет.",
                                "nl": "Het is <w>verbazingwekkend</w> hoeveel technologie in slechts tien jaar is veranderd.",
                                "zh": "仅仅十年间科技发生了如此大的变化，真是<w>令人惊叹</w>。",
                                "tr": "Teknolojinin sadece on yıl içinde bu kadar değişmiş olması <w>şaşırtıcı</w>.",
                                "pl": "To <w>zdumiewające</w>, jak bardzo technologia zmieniła się w zaledwie dziesięć lat.",
                                "de": "Es ist <w>erstaunlich</w>, wie sehr sich die Technologie in nur zehn Jahren verändert hat.",
                                "fr": "C'est <w>étonnant</w> de voir à quel point la technologie a changé en seulement dix ans.",
                                "it": "È <w>sorprendente</w> quanto la tecnologia sia cambiata in soli dieci anni.",
                                "cs": "Je <w>neuvěřitelné</w>, jak moc se technologie změnila za pouhých deset let.",
                                "es": "Es <w>asombroso</w> cuánto ha cambiado la tecnología en solo diez años."
                            }
                        },
                        {
                            "text": "The <w>amazing</w> discovery of the ancient ruins surprised the entire team of archaeologists.",
                            "target_lang_translations": {
                                "ru": "<w>Удивительное</w> открытие древних руин удивило всю команду археологов.",
                                "nl": "De <w>wonderbaarlijke</w> ontdekking van de oude ruïnes verraste het hele team van archeologen.",
                                "zh": "对古代遗迹的<w>惊人</w>发现让整个考古队感到震惊。",
                                "tr": "Antik kalıntıların <w>hayret verici</w> keşfi, tüm arkeolog ekibini şaşırttı.",
                                "pl": "<w>Niezwykłe</w> odkrycie starożytnych ruin zaskoczyło cały zespół archeologów.",
                                "de": "Die <w>unglaubliche</w> Entdeckung der antiken Ruinen überraschte das gesamte Archäologenteam.",
                                "fr": "L'<w>incroyable</w> découverte de ces ruines antiques a surpris toute l'équipe d'archéologues.",
                                "it": "La <w>sbalorditiva</w> scoperta delle antiche rovine sorprese l'intera squadra di archeologi.",
                                "cs": "<w>Ohromující</w> objev starověkých ruin překvapil celý tým archeologů.",
                                "es": "El <w>sorprendente</w> descubrimiento de las ruinas antiguas sorprendió a todo el equipo de arqueólogos."
                            }
                        }
                    ],
