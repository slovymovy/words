                "senses": [
                    {
                        "sense_id": "9ac2f59c-b0e4-3de3-b2a8-e88505c4a488",
                        "entry_id": "fafbcd1c-e875-304f-a308-44adf5b5a636",
                        "glosses": [
                            "To free from slavery or captivation (thraldom)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "73a7b25d-9975-4b66-8b3d-1854ccf2f06c",
                                "sense_id": "9ac2f59c-b0e4-3de3-b2a8-e88505c4a488",
                                "text": "He noted Gandhi’s sense of satyagraha and a statement of Lincoln’s during the depths of the Civil War: “We must disenthrall ourselves, and then we shall save our country.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd5a9ab1-3731-4822-bdcb-b1f014614778",
                        "source_entry_id": "fafbcd1c-e875-304f-a308-44adf5b5a636",
                        "source_sense_id": "9ac2f59c-b0e4-3de3-b2a8-e88505c4a488",
                        "source_sense_description": "To free from slavery or captivation",
                        "target_lang_word": "befreien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "befreien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "424b0471-42c2-334f-9ba8-2741d5bbb344",
                                        "entry_id": "c5816ee0-5170-3ccf-9c3f-a5af48903e94",
                                        "glosses": [
                                            "aus einer Zwangslage entkommen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "faff86bd-e8dc-4707-8cb3-3d4f1b77abe4",
                                                "sense_id": "424b0471-42c2-334f-9ba8-2741d5bbb344",
                                                "text": "Sie konnte sich aus seiner Umklammerung nicht befreien."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cbd39336-ae3f-375b-81a9-17071e37d0b4",
                                        "entry_id": "c5816ee0-5170-3ccf-9c3f-a5af48903e94",
                                        "glosses": [
                                            "jemands Zwangslage beenden"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca8cd00a-02fb-4d6d-9dda-6c80e40272e3",
                                                "sense_id": "cbd39336-ae3f-375b-81a9-17071e37d0b4",
                                                "text": "Die Therapie hat mich von meiner Trunksucht befreit."
                                            },
                                            {
                                                "example_id": "4b605b92-04dd-4acf-aabf-46e0bdf37d06",
                                                "sense_id": "cbd39336-ae3f-375b-81a9-17071e37d0b4",
                                                "text": "Das Sonderkommando hat die Geisel befreit."
                                            },
                                            {
                                                "example_id": "4406c08e-0faf-4971-b518-4cf28b7e10d4",
                                                "sense_id": "cbd39336-ae3f-375b-81a9-17071e37d0b4",
                                                "text": "„Am 23. Juli 1944 wurde das deutsche Konzentrations- und Vernichtungslager Majdanek am Rande der polnischen Stadt Lublin von sowjetischen Soldaten befreit.“"
                                            },
                                            {
                                                "example_id": "fa452bae-2e45-44b6-a86a-ae4ebc503ed2",
                                                "sense_id": "cbd39336-ae3f-375b-81a9-17071e37d0b4",
                                                "text": "„Am 11. April 1945 wurden die KZs Buchenwald und Mittelbau-Dora in Thüringen von US-Truppen befreit.“"
                                            },
                                            {
                                                "example_id": "e33925c7-6e98-47c5-8de6-74ed81fd9dff",
                                                "sense_id": "cbd39336-ae3f-375b-81a9-17071e37d0b4",
                                                "text": "[Richard von Weizsäcker, 8. Mai 1985:] […] „»Der 8. Mai war ein Tag der Befreiung. Er hat uns alle befreit von dem menschenverachtenden System der nationalsozialistischen Gewaltherrschaft.«“"
                                            },
                                            {
                                                "example_id": "ebbc1776-4636-4ff7-b1b4-2c38a1a3e956",
                                                "sense_id": "cbd39336-ae3f-375b-81a9-17071e37d0b4",
                                                "text": "„[…] Wer Privatinsolvenz beantragt und das mehrjährige Verfahren erfolgreich durchläuft, kann zu Lasten der Gläubigerinnen und Gläubiger von seinen Restschulden befreit werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "41893fa5-7729-3d52-9a2c-3d20ba214219",
                                        "entry_id": "c5816ee0-5170-3ccf-9c3f-a5af48903e94",
                                        "glosses": [
                                            "etwas Störendes überwinden; von etwas Störendem loskommen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a5cdd4a-9f1c-4dbb-bc9d-3e4e717b05c4",
                                                "sense_id": "41893fa5-7729-3d52-9a2c-3d20ba214219",
                                                "text": "Vor der anstehenden Klausur befreite er seine Gedanken von allerlei Unsinn."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "bc309632-968c-3ad3-8344-81f4defd6ebe",
                                        "entry_id": "c5816ee0-5170-3ccf-9c3f-a5af48903e94",
                                        "glosses": [
                                            "etwas Störendes von etwas entfernen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e0781b1-9bb7-4bdb-a1b2-cee147d9ae6c",
                                                "sense_id": "bc309632-968c-3ad3-8344-81f4defd6ebe",
                                                "text": "Vor der Restauration mussten wir das Boot von Algen befreien."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
