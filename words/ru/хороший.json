{
    "word_family": [
        "хорошо",
        "хорошенький",
        "хорошеть",
        "похорошеть",
        "хорошист",
        "хорошесть"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "516bc803-e60d-358e-bf0c-84a8488769ba",
                    "sense_definition": "Обладающий положительными качествами, свойствами; такой, как нужно, вполне удовлетворяющий каким-либо требованиям.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Сегодня очень <хорошая> погода для долгой прогулки в парке.",
                            "target_lang_translations": {
                                "en": "The weather is very <good> today for a long walk in the park.",
                                "zh": "今天天气非常<好>，适合在公园里长距离散步。"
                            }
                        },
                        {
                            "text": "Желаю вам всего <хорошего> и большой удачи в делах.",
                            "target_lang_translations": {
                                "en": "I wish you all the <best> and great luck in business.",
                                "zh": "祝你一切都<好>，事业顺利。"
                            }
                        },
                        {
                            "text": "Мой отец — очень <хороший> и добрый человек.",
                            "target_lang_translations": {
                                "en": "My father is a very <good> and kind man.",
                                "zh": "我父亲是一个非常<好>且善良的人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "неплохо́й",
                        "добрый",
                        "прекрасный",
                        "отличный"
                    ],
                    "antonyms": [
                        "плохо́й",
                        "нехоро́ший"
                    ],
                    "common_phrases": [
                        "всего хорошего",
                        "хороший человек",
                        "хорошая погода",
                        "хорошее настроение"
                    ],
                    "target_lang_definitions": {
                        "en": "Possessing positive qualities; suitable, satisfactory, or kind.",
                        "zh": "具有积极品质、属性；合适、令人满意或善良。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "good",
                                "target_lang_sense_clarification": "general positive quality"
                            },
                            {
                                "target_lang_word": "nice",
                                "target_lang_sense_clarification": "pleasant or agreeable"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "好",
                                "target_lang_sense_clarification": "通用的正面评价"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a10057b9-bc76-3d36-b447-a27c6f63786f",
                    "sense_definition": "Привлекательный внешне, красивый, миловидный (часто используется с выражением «собой»).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот молодой актёр удивительно <хорош> собой и очень талантлив.",
                            "target_lang_translations": {
                                "en": "This young actor is surprisingly <good-looking> and very talented.",
                                "zh": "这位年轻演员长得非常<好看>，而且很有才华。"
                            }
                        },
                        {
                            "text": "Она была так <хороша> в этом новом вечернем платье.",
                            "target_lang_translations": {
                                "en": "She was so <beautiful> in that new evening dress.",
                                "zh": "她穿上那件新晚礼服真是太<漂亮>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "краси́вый",
                        "милови́дный",
                        "очарова́тельный",
                        "пригожий"
                    ],
                    "common_phrases": [
                        "хорош собой",
                        "очень хороша"
                    ],
                    "target_lang_definitions": {
                        "en": "Physically attractive or beautiful.",
                        "zh": "外表有吸引力，漂亮，美观。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "good-looking",
                                "target_lang_sense_clarification": "attractive appearance (often used for men or general)"
                            },
                            {
                                "target_lang_word": "beautiful",
                                "target_lang_sense_clarification": "aesthetically pleasing (often used for women)"
                            },
                            {
                                "target_lang_word": "handsome",
                                "target_lang_sense_clarification": "good-looking (usually for men)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "好看",
                                "target_lang_sense_clarification": "外表美观"
                            },
                            {
                                "target_lang_word": "漂亮",
                                "target_lang_sense_clarification": "形容人或事物美观"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0d30a96-1259-31ca-a302-6c0c21f3281c",
                    "sense_definition": "Значительный по размеру, силе или степени проявления.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы прошли довольно <хорошее> расстояние пешком до станции.",
                            "target_lang_translations": {
                                "en": "We walked a pretty <good> distance to the station.",
                                "zh": "我们步行走了<相当长>的一段距离才到车站。"
                            }
                        },
                        {
                            "text": "Ему достался <хороший> кусок праздничного торта.",
                            "target_lang_translations": {
                                "en": "He got a <good> piece of the birthday cake.",
                                "zh": "他分到了<一大块>生日蛋糕。"
                            }
                        }
                    ],
                    "synonyms": [
                        "большо́й",
                        "значи́тельный",
                        "кру́пный"
                    ],
                    "antonyms": [
                        "незначительный"
                    ],
                    "common_phrases": [
                        "хороший кусок",
                        "хороший пинок"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used to emphasize size or degree"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Significant in size, amount, or degree.",
                        "zh": "在尺寸、数量或程度上相当大。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "good",
                                "target_lang_sense_clarification": "large in amount or size"
                            },
                            {
                                "target_lang_word": "solid",
                                "target_lang_sense_clarification": "substantial"
                            },
                            {
                                "target_lang_word": "sizable",
                                "target_lang_sense_clarification": "fairly large"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "相当大",
                                "target_lang_sense_clarification": "强调规模或程度"
                            },
                            {
                                "target_lang_word": "不小",
                                "target_lang_sense_clarification": "口语中表示数量可观"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f2f756a-ff8b-3b17-88b8-e9367967b5fc",
                    "sense_definition": "Ласковое обращение к близкому человеку.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не плачь, мой <хороший>, всё скоро наладится.",
                            "target_lang_translations": {
                                "en": "Don't cry, my <dear>, everything will work out soon.",
                                "zh": "别哭，我<亲爱的>，一切很快就会好起来的。"
                            }
                        },
                        {
                            "text": "Послушай меня, <хороший> мой, так делать нельзя.",
                            "target_lang_translations": {
                                "en": "Listen to me, my <sweetheart>, you can't do that.",
                                "zh": "听我说，我<亲爱的>，不能这样做。"
                            }
                        }
                    ],
                    "synonyms": [
                        "дорого́й",
                        "люби́мый",
                        "ми́лый"
                    ],
                    "common_phrases": [
                        "мой хороший"
                    ],
                    "target_lang_definitions": {
                        "en": "An affectionate address to a close person.",
                        "zh": "对亲近之人的亲昵称呼。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dear",
                                "target_lang_sense_clarification": "term of endearment"
                            },
                            {
                                "target_lang_word": "sweetheart",
                                "target_lang_sense_clarification": "affectionate term"
                            },
                            {
                                "target_lang_word": "honey",
                                "target_lang_sense_clarification": "informal term of endearment"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "亲爱的",
                                "target_lang_sense_clarification": "亲昵的称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "446f9e8f-08e3-31ca-9268-b0209e3a83bd",
                    "sense_definition": "Используется для выражения иронии, неодобрения или отрицания чего-либо.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Тоже мне, <хорош> друг, забыл поздравить с праздником!",
                            "target_lang_translations": {
                                "en": "Some <fine> friend you are, forgot to wish me a happy holiday!",
                                "zh": "你算什么<好>朋友，连节日祝福都忘了！"
                            }
                        },
                        {
                            "text": "<Хорош> отдых, когда приходится работать весь отпуск!",
                            "target_lang_translations": {
                                "en": "<Nice> vacation, when you have to work the whole time!",
                                "zh": "这算什么<好>假期，整个假期都得工作！"
                            }
                        }
                    ],
                    "common_phrases": [
                        "хорош гусь",
                        "хорошенькое дело"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "ironic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used to express irony, disapproval, or negation.",
                        "zh": "用于表达讽刺、不赞成或否定。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fine",
                                "target_lang_sense_clarification": "ironic usage"
                            },
                            {
                                "target_lang_word": "nice",
                                "target_lang_sense_clarification": "sarcastic usage"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "好",
                                "target_lang_sense_clarification": "反语，表示讽刺"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f5be0fb-1bc1-3503-88b6-0ab48a6321e4",
                    "sense_definition": "Находящийся в состоянии алкогольного опьянения.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Гость пришёл на вечеринку уже изрядно <хороший>.",
                            "target_lang_translations": {
                                "en": "The guest arrived at the party already pretty <tipsy>.",
                                "zh": "客人来参加聚会时已经有点<微醺>了。"
                            }
                        },
                        {
                            "text": "Муж вернулся домой весёлый и немного <хороший>.",
                            "target_lang_translations": {
                                "en": "My husband returned home cheerful and a little <tipsy>.",
                                "zh": "丈夫回家时很高兴，还有点<微醺>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "подвы́пивший",
                        "пья́ный"
                    ],
                    "antonyms": [
                        "трезвый"
                    ],
                    "common_phrases": [
                        "уже хороший"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "In a state of alcohol intoxication.",
                        "zh": "处于醉酒状态。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tipsy",
                                "target_lang_sense_clarification": "slightly drunk"
                            },
                            {
                                "target_lang_word": "drunk",
                                "target_lang_sense_clarification": "intoxicated"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "微醺",
                                "target_lang_sense_clarification": "略有醉意"
                            },
                            {
                                "target_lang_word": "醉",
                                "target_lang_sense_clarification": "醉酒状态"
                            }
                        ]
                    }
                }
            ]
        }
    ]
