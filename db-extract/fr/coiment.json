                        "entry_id": "6a1847a6-c7aa-3510-a893-3a77b4e9557c",
                        "glosses": [
                            "D’une manière coite, paisible."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "bc81a896-e235-47b2-862e-0421c89615f0",
                                "sense_id": "0a19e61d-3951-3177-892e-8533d410e759",
                                "text": "Il était là coiment."
                            },
                            {
                                "example_id": "9c2a29d3-1c0b-4668-9172-304bb4f3bb00",
                                "sense_id": "0a19e61d-3951-3177-892e-8533d410e759",
                                "text": "L’un finement trompe une ville forte,\nL’autre coiment une maison séduit"
                            },
                            {
                                "example_id": "7109bb9f-69bc-45d1-a062-bacb082b476c",
                                "sense_id": "0a19e61d-3951-3177-892e-8533d410e759",
                                "text": "Le prédicateur, depuis Genève, exhorte les réformés de Loudun à la même prudence : « Tenez-vous cachés le plus coiment possible, ne provoquant point la rage de vos ennemis, mais plutôt tâchant, par modestie, douceur et honnêteté de vie, gagner ceux qui ne sont pas du tout incorrigibles. »"
                            }
                        ]
                    }
