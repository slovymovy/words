                "senses": [
                    {
                        "sense_id": "e63805b4-4ecb-332f-93d3-a888c26ad7d6",
                        "entry_id": "59c507c7-a8b5-301c-993b-c07e1558d4b8",
                        "glosses": [
                            "besonderer Preisnachlass, der nur unter bestimmten Bedingungen gewährt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44480f0c-b19c-40c0-a03f-40e3448570fe",
                                "sense_id": "e63805b4-4ecb-332f-93d3-a888c26ad7d6",
                                "text": "„Einerseits fällt der Sonderrabatt weg, den der Kreml im Dezember dem damals noch amtierenden ukrainischen Präsidenten Wiktor Janukowitsch zugesagt hatte, andererseits hat Russland auch den Rabatt gekündigt, den Moskau bislang an Kiew für die Stationierung der Schwarzmeerflotte auf der Krim zahlte.“"
                            },
                            {
                                "example_id": "58e366a4-867c-434b-a076-2d6f973656ff",
                                "sense_id": "e63805b4-4ecb-332f-93d3-a888c26ad7d6",
                                "text": "„Wie sich der Sonderrabatt von 20 Prozent für Betroffene des Hochwassers umsatzmäßig auswirkt, könne sie noch nicht sagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
