                    {
                        "sense_id": "f13e2341-fa0f-3467-bc85-0418184ae89e",
                        "entry_id": "26c5b124-e8f6-3e00-8e1f-ef6b378bf717",
                        "glosses": [
                            "A change in nature, form, or quality."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ee6ed08a-2de2-35b6-b176-6b0660ac0710",
                        "entry_id": "26c5b124-e8f6-3e00-8e1f-ef6b378bf717",
                        "glosses": [
                            "The transference of a bodily function or disease to another part of the body, specifically the development of a secondary area of disease remote from the original site, as with some cancers."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e1284ca6-0e1b-47ac-ab81-5b97dd12e905",
                                "sense_id": "ee6ed08a-2de2-35b6-b176-6b0660ac0710",
                                "text": "Stayed in her own house, searched her body each morning and examined her conscience each night for progressive symptoms of the metastasis she feared was in her."
                            }
                        ]
                    },
                    {
                        "sense_id": "f09c091b-12cf-36bb-a90b-c1638dd2c871",
                        "entry_id": "26c5b124-e8f6-3e00-8e1f-ef6b378bf717",
                        "glosses": [
                            "The spread of something harmful to another location, like the metastasis of a cancer."
                        ],
                        "tags": [
                            "countable",
                            "figuratively",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "413b416f-ba9f-3acf-8fc1-6d0151b46fa3",
                        "entry_id": "26c5b124-e8f6-3e00-8e1f-ef6b378bf717",
                        "glosses": [
                            "Denying adversaries' arguments and turning the arguments back on them."
