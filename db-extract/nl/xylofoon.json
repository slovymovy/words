                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c20a085e-8d9d-44f0-9e5b-b621c22bef04",
                                                "sense_id": "2c83924f-0ba9-3859-bf22-fb00afdfd879",
                                                "text": "In Orffs „Carmina Burana“ spielt das Xylophon eine wichtige Rolle."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8378ae23-7079-4959-8c7d-f58ca59c75f8",
                        "source_entry_id": "541ab2dc-d394-36de-913d-f82c71445ef9",
                        "source_sense_id": "96618a8c-48b3-3689-849b-4a6c04312ae4",
                        "source_sense_description": "melodisch slaginstrument dat bestaat uit een reeks op toon gestemde hardhouten staafjes waar met kleine hamertjes op geslagen wordt",
                        "target_lang_word": "xylophone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "xylophone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "586255ca-c9cc-3131-8781-c95d503cf4fd",
                                        "entry_id": "8ad14f29-fb8c-3ebb-b9b1-f19a29153be7",
                                        "glosses": [
                                            "Any musical instrument (percussion idiophone) made of wooden slats graduated so as to make the sounds of the scale when struck with a small drumstick-like mallet; the standard Western concert xylophone or one of its derivatives."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b73f0f7-f3cc-4be5-8084-2ba257d7202b",
                                                "sense_id": "586255ca-c9cc-3131-8781-c95d503cf4fd",
                                                "text": "All I know how to play on my xylophone is \"Mary Had a Little Lamb\". Would you like to hear it?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "xylophone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1881f521-ca29-3cf7-b0df-58690ddd796b",
                                        "entry_id": "17e8d764-b9fd-3a94-9bfe-93f5bc80c7e8",
                                        "glosses": [
                                            "To play a xylophone or to play something else as though it was a xylophone."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "401d1ee5-d500-3fcb-9ab4-7932952eb8f2",
                                        "entry_id": "17e8d764-b9fd-3a94-9bfe-93f5bc80c7e8",
                                        "glosses": [
                                            "To move above a ridged surface or series of surfaces so as to hit every ridge, in a manner similar to playing quickly and sequentially on a xylophone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbd61f08-7ac3-4db5-8250-00c0073f2b49",
                                                "sense_id": "401d1ee5-d500-3fcb-9ab4-7932952eb8f2",
                                                "text": "my eager fingers xylophoning over the memories"
                                            },
                                            {
                                                "example_id": "9cac74ea-71ec-4941-acf6-bd4bc80f3fce",
                                                "sense_id": "401d1ee5-d500-3fcb-9ab4-7932952eb8f2",
                                                "text": "Like a cat, I arch into the back of the bench, my spine xylophoning along the slats while the tension of the day slowly drains out of me. I'm totally chill and mellow."
                                            },
                                            {
                                                "example_id": "bd58b1e8-42b4-4329-9fe1-4dc4af2ff9ad",
                                                "sense_id": "401d1ee5-d500-3fcb-9ab4-7932952eb8f2",
                                                "text": "The others waged active war, claws xylophoning across Jack's pinwheeling swords."
                                            },
                                            {
                                                "example_id": "bede3f35-4c7b-4670-9214-68b626c117be",
                                                "sense_id": "401d1ee5-d500-3fcb-9ab4-7932952eb8f2",
                                                "text": "His right hand, the good one, found one of Glass's ankles, pulled. Glass fell, her ulna, clavicle, pevis, and kneecap xylophoning along stair edges."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df82f16e-1706-4324-a075-6e04c129b1e4",
                        "source_entry_id": "541ab2dc-d394-36de-913d-f82c71445ef9",
                        "source_sense_id": "96618a8c-48b3-3689-849b-4a6c04312ae4",
                        "source_sense_description": "melodisch slaginstrument dat bestaat uit een reeks op toon gestemde hardhouten staafjes waar met kleine hamertjes op geslagen wordt",
                        "target_lang_word": "xylophone",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "xylophone",
