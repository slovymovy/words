                                "sense_id": "91ea410b-38f4-3242-83a9-aa691f14e5e1",
                                "text": "Une robe de guingan."
                            },
                            {
                                "example_id": "fe351db2-58fb-4244-8f2a-fddc288d04d5",
                                "sense_id": "91ea410b-38f4-3242-83a9-aa691f14e5e1",
                                "text": "Une culotte de grosse toile jaune, une chemise de guingan, quelquefois un mouchoir ou un vieux chapeau sur la tête, point de bas, point de souliers, voilà l’habillement des hommes."
                            },
                            {
                                "example_id": "014f09af-171b-4f98-8545-bcd5579859f7",
                                "sense_id": "91ea410b-38f4-3242-83a9-aa691f14e5e1",
                                "text": "...les rideaux de toile perse doublée de guingan rose..."
                            }
                        ]
