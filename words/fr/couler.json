                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de partir, il a <w>coulé</w> discrètement un petit mot dans la poche de son manteau."
