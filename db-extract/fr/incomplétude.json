                                        "entry_id": "96359764-c915-3ff4-9d63-56a5ec9c1a18",
                                        "glosses": [
                                            "Eigenschaft, Zustand, nicht alle zu nötigen Teile zu haben, also Lücken zu enthalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35c7087a-f235-4a86-89ca-2b44c6839047",
                                                "sense_id": "ec55f7ee-14b7-37c3-8873-8c88b7272d4b",
                                                "text": "Aufgrund der Unvollständigkeit seiner Arbeit hat er nicht die volle Punktzahl erreicht."
                                            },
                                            {
                                                "example_id": "ec9d8218-7442-49c2-b7cb-785577c36ae6",
                                                "sense_id": "ec55f7ee-14b7-37c3-8873-8c88b7272d4b",
                                                "text": "Die Unvollständigkeit einiger Werke des vor kurzem verstorbenen Komponisten motivierte viele andere Musiker, sie zu vollenden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b1b4e92e-8f9a-3f1a-8d5b-0faa60e8ce7b",
                                        "entry_id": "96359764-c915-3ff4-9d63-56a5ec9c1a18",
                                        "glosses": [
                                            "Stelle, an der etwas fehlt, das dort sein sollte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
