                "senses": [
                    {
                        "sense_id": "da772fca-e36f-37a9-8326-daac06ec237d",
                        "entry_id": "7b616b4f-8c47-3cfc-a45d-32a0dba2c88e",
                        "glosses": [
                            "Acanthus L., rodzaj roślin, bylin lub krzewów, z rodziny akantowatych; ."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7db6423c-5434-411c-ae79-7ef7b948aba6",
                                "sense_id": "da772fca-e36f-37a9-8326-daac06ec237d",
                                "text": "Akant jest piękną, okazałą byliną rzadko uprawianą w polskich ogrodach."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "104103e0-cba6-3dfe-a094-3b679dd50fb9",
                        "entry_id": "7b616b4f-8c47-3cfc-a45d-32a0dba2c88e",
                        "glosses": [
                            "motyw dekoracyjny w formie stylizowanych liści, gałązek i kwiatów akantu (1.1)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf6f07ff-2b7c-4676-a550-42701745cf8c",
                                "sense_id": "104103e0-cba6-3dfe-a094-3b679dd50fb9",
                                "text": "Motyw akantu stosowany jest w architekturze od starożytności."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70d7200f-b131-4b03-bddd-82de76c87350",
                        "source_entry_id": "7b616b4f-8c47-3cfc-a45d-32a0dba2c88e",
                        "source_sense_id": "da772fca-e36f-37a9-8326-daac06ec237d",
                        "target_lang_word": "acanthus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acanthus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3eef7c3f-b289-378d-9ad9-6b7c927ce3fe",
                                        "entry_id": "514a9a05-333e-36d2-b0f5-7a781f49005f",
                                        "glosses": [
                                            "A member of the genus Acanthus of herbaceous prickly plants with toothed leaves, (family Acanthaceae, order Lamiales (formerly Scrophulariales)) found in the south of Europe, Asia Minor, and India."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "198cb26b-6e86-4f84-b5e3-405faabf2dcf",
                                                "sense_id": "3eef7c3f-b289-378d-9ad9-6b7c927ce3fe",
                                                "text": "The picture before which they paused represented one of those ruined fountains so common to Italy. Francesca gazed upon it as if it had been an old friend: many a time, beside such a one, with its curved and broken marble, had she wreathed the acanthus that hung around it, the green and trailing foliage so profuse in the South, into shapes even more fanciful than those which once suggested the Corinthian capital."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2296dcc4-eb19-3003-99ed-928577657f34",
                                        "entry_id": "514a9a05-333e-36d2-b0f5-7a781f49005f",
                                        "glosses": [
                                            "An ornament resembling the foliage or leaves of Acanthus spinosus, used in the capitals of the Corinthian and composite orders."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ceaf9003-8623-4e78-af9a-f1e7b9be9c5e",
                                                "sense_id": "2296dcc4-eb19-3003-99ed-928577657f34",
                                                "text": "It is difficult to imagine that Bernard of Clairvaux was gullible enough to accept dozens of historiated windows, grisaille fields of griffins, mosaic pavements, carved acanthus capitals, inhabited vine columns, and golden altarware on the strength of the justifications offered by a single window, one tympanum, and Suger's libelli."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0123023d-7466-4482-be56-eef744b48c3a",
                        "source_entry_id": "7b616b4f-8c47-3cfc-a45d-32a0dba2c88e",
                        "source_sense_id": "104103e0-cba6-3dfe-a094-3b679dd50fb9",
