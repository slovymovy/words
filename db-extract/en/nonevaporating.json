                                "sense_id": "c74279bc-8f34-3cd9-849c-fc77ac1fc275",
                                "text": "The pails are made to hold 14 quarts, and are said to be nonfreezing, nonevaporating and noncorrosive."
                            },
                            {
                                "example_id": "fdac48cb-355b-4933-9503-664cb58b99ea",
                                "sense_id": "c74279bc-8f34-3cd9-849c-fc77ac1fc275",
                                "text": "This can be avoided by expelling the water from the traps and filling them with kerosene, glycerin or some other nonevaporating material, thus insuring the comfort and health of subsequent occupants."
                            },
                            {
                                "example_id": "64d70642-d52b-41c0-98fc-a184699619e1",
                                "sense_id": "c74279bc-8f34-3cd9-849c-fc77ac1fc275",
                                "text": "Here, mainly light components evaporate, while nonevaporating, heavier components reach the evaporation chamber of the intermediate stage 2."
                            }
