                ],
                "senses": [
                    {
                        "sense_id": "ba4dbc25-7ff0-3ab2-9851-814a1d2ddf02",
                        "entry_id": "e67fa1a0-1037-3bc9-938f-f26d71b80388",
                        "glosses": [
                            "de netheid en rustigheid vaak met een religieuze tint"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d98e415-bac7-4218-8420-5adb2d13fdad",
                                "sense_id": "ba4dbc25-7ff0-3ab2-9851-814a1d2ddf02",
                                "text": "Het Waalse vocaal ensemble Vox Luminis zingt de complexe polyfone en soms wringende Mariamuziekstukken met grote intensiteit en stemmigheid. Verder klinken nog Te Deum laudamus, een deels gregoriaans Miserere en twee orgelsonates. De afwisseling in virtuoze compositorische technieken is groot, deze stichtelijkheid leidt tot verheffende vroomheid."
                            },
                            {
                                "example_id": "edc13076-917a-468e-b5c6-69c06ba9e69e",
                                "sense_id": "ba4dbc25-7ff0-3ab2-9851-814a1d2ddf02",
                                "text": "Alsof The Bad Seeds de degens kruisen met de jonge Leonard Cohen, zo klinkt The National. … Studioplaat nummer zes is opnieuw uitstekend en zal The National vermoedelijk nog groter maken: de stemmigheid is haast ongemerkt wat grootser en toegankelijker geworden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ffe10ca8-a572-4727-a815-5587c524f54c",
                        "source_entry_id": "e67fa1a0-1037-3bc9-938f-f26d71b80388",
                        "source_sense_id": "ba4dbc25-7ff0-3ab2-9851-814a1d2ddf02",
                        "source_sense_description": "ernst",
                        "target_lang_word": "modesty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "modesty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0aa111ba-e157-3804-8328-483b46f1c26b",
                                        "entry_id": "7f4011fc-1436-3671-acb0-a80564210559",
                                        "glosses": [
                                            "The quality of being modest; having a limited and not overly high opinion of oneself and one's abilities."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83a91821-dcfd-466d-84ae-c66850791baa",
                                                "sense_id": "0aa111ba-e157-3804-8328-483b46f1c26b",
                                                "text": "At her invitation he outlined for her the succeeding chapters with terse military accuracy ; and what she liked best and best understood was avoidance of that false modesty which condescends, turning technicality into pabulum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "174e3b69-ffe2-34e2-a038-a80f346051fa",
                                        "entry_id": "7f4011fc-1436-3671-acb0-a80564210559",
                                        "glosses": [
                                            "Moderate behaviour; reserve."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c402cf68-4e85-3f8c-be2a-22eaa5b69ffa",
                                        "entry_id": "7f4011fc-1436-3671-acb0-a80564210559",
                                        "glosses": [
                                            "Pudency, avoidance of sexual explicitness."
                                        ],
                                        "tags": [
                                            "specifically",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b203066-537c-4b5a-aa64-ccc3d0417121",
                                                "sense_id": "c402cf68-4e85-3f8c-be2a-22eaa5b69ffa",
                                                "text": "... but the cars of chaste women have either coverings thrown over them, or white sheets hung over; for instance, on the cars of the female part of the family of the deceased Nawabs Khanduran and Muzaffar Khan, there used generally to be fastened thick dirty white cloths, and in like manner also on their palanquins—although one brother was the chief treasurer, and the other a commander of seven thousand men. And most assuredly this is a requirement of modesty; for one whose palanquin or cart is turned out with much splendour, verily the idea comes to the minds of the sight-seers and common people, that in it there must be some lovely one, bright as the morning, the envy of the fairies. Hence, for the cars or palanquins for women to ride in to be greatly embroidered is, in the opinion of certain men of standing, who are worthy to be trusted, of great infamy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c9c05f5-f2b3-4a48-b7ed-7177ac9794c3",
                        "source_entry_id": "e67fa1a0-1037-3bc9-938f-f26d71b80388",
                        "source_sense_id": "ba4dbc25-7ff0-3ab2-9851-814a1d2ddf02",
                        "source_sense_description": "ernst",
                        "target_lang_word": "moderation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moderation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94184a9d-e523-3e18-b399-8d1c3df43fd7",
                                        "entry_id": "c1d8eced-ca24-3fb1-840d-f27f9021cdcf",
                                        "glosses": [
                                            "The state or quality of being moderate; avoidance of extremes"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e84038c-44ec-47a2-9498-458216a68410",
                                                "sense_id": "94184a9d-e523-3e18-b399-8d1c3df43fd7",
                                                "text": "...It regulates and governs the Passions of the Mind, and brings them into due moderation and frame..."
                                            },
                                            {
                                                "example_id": "cf777ed3-3f6a-4215-8e1e-a80ac10c3a07",
                                                "sense_id": "94184a9d-e523-3e18-b399-8d1c3df43fd7",
                                                "text": "Mr. Chairman, at this moment I stand astonished at my own moderation!"
                                            },
                                            {
                                                "example_id": "40214534-ff55-4198-a690-1a7a9bf298bf",
                                                "sense_id": "94184a9d-e523-3e18-b399-8d1c3df43fd7",
                                                "text": "America is a model of force and freedom and moderation - with all the coarseness and rudeness of its people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11042b05-a7f9-30bf-aaa5-2b2a147eb1f5",
                                        "entry_id": "c1d8eced-ca24-3fb1-840d-f27f9021cdcf",
                                        "glosses": [
                                            "An instance of moderating: bringing something away from extremes, especially in a beneficial way"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5efccf78-2695-490f-b209-5367c2697431",
                                                "sense_id": "11042b05-a7f9-30bf-aaa5-2b2a147eb1f5",
                                                "text": "With the quick moderation of the weather some buying has appeared that had been held up because of the extremely cold weather […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c5b6379-0011-365e-b209-54d98c81ca0e",
                                        "entry_id": "c1d8eced-ca24-3fb1-840d-f27f9021cdcf",
                                        "glosses": [
                                            "The process of moderating a discussion"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
