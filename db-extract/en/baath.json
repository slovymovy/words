    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "6e09f61a-e4bb-3a64-a4a4-76d7d23c57c4",
                "word": "Baath",
                "pos": "name",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7a37c957-726d-4729-8d22-c1d7e7e0873c",
                        "entry_id": "6e09f61a-e4bb-3a64-a4a4-76d7d23c57c4",
                        "tags": [
                            "canonical"
                        ],
                        "form": "the Baath"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "db22d5f5-7ada-3181-8b6c-4d2d7d515978",
                        "entry_id": "6e09f61a-e4bb-3a64-a4a4-76d7d23c57c4",
                        "glosses": [
                            "The Arab Socialist Baath Party, a secular Arab socialist political party present in several countries in the Middle East, most prominently Iraq and Syria."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92f75bf3-b2e4-4954-9738-32d90a459f3b",
                                "sense_id": "db22d5f5-7ada-3181-8b6c-4d2d7d515978",
                                "text": "Today it is they that proclaim the slogan of \"federation\"—which is opposed to the Baath's postulates."
                            },
                            {
                                "example_id": "d711997c-c1d8-4f2c-a1b3-aa27833cc467",
                                "sense_id": "db22d5f5-7ada-3181-8b6c-4d2d7d515978",
                                "text": "Nasser had a country without a party, but the Baath was still a party without a country."
                            },
                            {
                                "example_id": "ac7d2659-b08b-473f-a479-3d4522e1c603",
                                "sense_id": "db22d5f5-7ada-3181-8b6c-4d2d7d515978",
                                "text": "For the Party to succeed in achieving these aims, Aflaq insisted that the Baath had to be nationalist, populist, socialist and revolutionary."
                            },
                            {
                                "example_id": "a3efb8d6-1889-4abc-9f19-e00fea896cd6",
                                "sense_id": "db22d5f5-7ada-3181-8b6c-4d2d7d515978",
                                "text": "The Baath was small but well organized and bold, and could not be intimidated."
                            },
                            {
                                "example_id": "95bd5915-970e-4e6b-bd26-8ad50f433ecf",
                                "sense_id": "db22d5f5-7ada-3181-8b6c-4d2d7d515978",
                                "text": "The Baath is an avowedly secular party that has pursued socialist economic policies and at one time was aligned with the \"godless\" Soviet Union."
                            },
                            {
                                "example_id": "c0e14842-6793-4ba7-b37a-d88338e885da",
                                "sense_id": "db22d5f5-7ada-3181-8b6c-4d2d7d515978",
                                "text": "The 1973 War was an opportunity for decision makers to demonstrate that their work under the Baath was substantively different than their predecessors, [...]"
                            },
                            {
                                "example_id": "c25b0498-a68d-45f0-af99-f34d54a6b7b7",
                                "sense_id": "db22d5f5-7ada-3181-8b6c-4d2d7d515978",
                                "text": "The Baath was the party of the downtrodden, stacked with minorities and the rural poor of all sects, including Sunni."
                            },
                            {
                                "example_id": "c7e73633-0af5-43a2-b21a-c09a5d5a93b9",
                                "sense_id": "db22d5f5-7ada-3181-8b6c-4d2d7d515978",
                                "text": "It was on this platform that the Baath would bring glory, honor, and enlightenment back to the Arab World in the wake of European colonialism."
                            }
                        ]
                    }
                ],
