                                            "finance"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56ee8848-933b-46c8-b76b-27e24b59462a",
                                                "sense_id": "d3b84c2b-cfe1-3a4a-992d-bb15db688e5c",
                                                "text": "Die Kurse sind wieder gefallen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "7250dfd2-73a2-3dfe-b8bf-13514e16312e",
                                        "entry_id": "aff728a0-68bf-3550-a2d0-0120bddd3df0",
