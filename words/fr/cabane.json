                    "sense_definition": "Prison ou lieu d'enfermement carcéral.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "enfermement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après le cambriolage manqué, le voleur a passé trois années entières en <w>cabane</w>."
