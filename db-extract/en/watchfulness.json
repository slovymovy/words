    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b5a3c981-3a18-32a6-b64d-882a528d7b62",
                "word": "watchfulness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b9b9d164-cbfb-4e76-a415-e31d32f6a7ad",
                        "entry_id": "b5a3c981-3a18-32a6-b64d-882a528d7b62",
                        "tags": [
                            "plural"
                        ],
                        "form": "watchfulnesses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ce07ae8d-8174-3915-bd32-5dcb068d4620",
                        "entry_id": "b5a3c981-3a18-32a6-b64d-882a528d7b62",
                        "glosses": [
                            "The state or quality of being watchful; alertness, vigilance or wakefulness."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1b2ecd44-da6a-4d86-a326-cc0f4fda3aba",
                                "sense_id": "ce07ae8d-8174-3915-bd32-5dcb068d4620",
                                "text": "Continuous watchfulness is maintained around the clock."
                            },
                            {
                                "example_id": "a2545ad7-97d3-476c-a61c-8603a1bfd96e",
                                "sense_id": "ce07ae8d-8174-3915-bd32-5dcb068d4620",
                                "text": "The first thing to be undertaken in this weighty work, is a watchfulness over the failings and an inlargement of the dominion, of the Senses."
                            },
                            {
                                "example_id": "16d3e218-335d-491c-8316-39e63800bd37",
                                "sense_id": "ce07ae8d-8174-3915-bd32-5dcb068d4620",
                                "text": "1784, Samuel Johnson, letter addressed to Mr. Langton dated 25 August, 1784, cited in James Boswell, The Life of Samuel Johnson, London: Charles Dilly, 1791, Volume 2, p. 545,\nNights of watchfulness produce torpid days […]"
                            },
                            {
                                "example_id": "e93076aa-20cf-4d99-b908-544330b0151c",
                                "sense_id": "ce07ae8d-8174-3915-bd32-5dcb068d4620",
                                "text": "Every dark form in the dimness had its ominous quality, its peculiar suggestion of alert watchfulness."
                            },
                            {
                                "example_id": "93c7ce21-a023-4e77-b160-bbefeb92c717",
                                "sense_id": "ce07ae8d-8174-3915-bd32-5dcb068d4620",
                                "text": "The steady rhythm of the engines, the fact that he had been sleeping badly, the boredom of a flight that he had done so many times before and did not want to do again, the long humiliation and unhappiness that was always in the background of his mind, all fought against his watchfulness."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17586830-7d00-43cd-be42-7c55b1634079",
                        "source_entry_id": "b5a3c981-3a18-32a6-b64d-882a528d7b62",
                        "source_sense_id": "ce07ae8d-8174-3915-bd32-5dcb068d4620",
                        "source_sense_description": "alertness, vigilance or wakefulness",
                        "target_lang_word": "насторо́женность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "насторо́женность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7a32d9e5-0663-3da2-9b87-bf6292e011c8",
                                        "entry_id": "db6ec068-7b8b-30ef-83a0-15a5e8217989",
                                        "glosses": [
                                            "свойство или состояние по значению прилагательного настороженный; напряжённая внимательность в ожидании чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea688fb4-01ac-478c-b96d-f62c7be53ffe",
                                                "sense_id": "7a32d9e5-0663-3da2-9b87-bf6292e011c8",
                                                "text": "Подозрительная настороженность, не оставлявшая его все время, как-то побледнела, и на душу нашла тихая, музыкальная печаль."
                                            },
                                            {
                                                "example_id": "c09cecde-cfc5-49e9-aed4-955a50a085a3",
                                                "sense_id": "7a32d9e5-0663-3da2-9b87-bf6292e011c8",
                                                "text": "Лес вызывал у меня чувство душевного покоя и уюта; в этом чувстве исчезали все мои огорчения, забывалось неприятное, и в то же время у меня росла особенная настороженность ощущений: слух и зрение становились острее, память ― более чуткой, вместилище впечатлений ― глубже."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9ae0cfc-1182-4783-aef1-deec0a577bf8",
                        "source_entry_id": "b5a3c981-3a18-32a6-b64d-882a528d7b62",
