                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden loud noise <w>frightened</w> the birds away from the garden.",
                            "target_lang_translations": {
                                "ru": "Внезапный громкий шум <w>спугнул</w> птиц из сада.",
                                "tr": "Ani ve yüksek ses kuşları bahçeden <w>ürküttü</w>.",
                                "nl": "Het plotselinge harde geluid <w>verschrikte</w> de vogels uit de tuin.",
                                "pl": "Nagły, głośny hałas <w>wystraszył</w> ptaki z ogrodu.",
                                "de": "Das plötzliche laute Geräusch <w>erschreckte</w> die Vögel und vertrieb sie aus dem Garten.",
                                "fr": "Le bruit soudain et fort a <w>effrayé</w> les oiseaux, qui se sont envolés du jardin.",
                                "it": "L'improvviso rumore forte ha <w>spaventato</w> gli uccelli facendoli scappare dal giardino.",
                                "cs": "Náhlý hlasitý zvuk ptáky ze zahrady <w>vyděsil</w> a zahnal.",
                                "es": "El ruido fuerte y repentino <w>asustó</w> a los pájaros, alejándolos del jardín.",
                                "zh": "突如其来的巨大声响把花园里的鸟儿<w>吓</w>跑了。"
                            }
                        },
                        {
                            "text": "The elephant was <w>frightened</w> by the tiny mice running around.",
                            "target_lang_translations": {
                                "ru": "Слон был <w>напуган</w> крошечными мышами, бегающими вокруг.",
                                "tr": "Fil, etrafta koşturan minik farelerden <w>korktu</w>.",
                                "nl": "De olifant werd <w>bang gemaakt</w> door de kleine muisjes die rondrenden.",
                                "pl": "Słoń był <w>przestraszony</w> biegającymi wokół małymi myszami.",
                                "de": "Der Elefant war von den kleinen Mäusen, die herumliefen, <w>verängstigt</w>.",
                                "fr": "L'éléphant a été <w>effrayé</w> par les minuscules souris qui couraient autour.",
                                "it": "L'elefante è stato <w>spaventato</w> dai minuscoli topi che correvano in giro.",
                                "cs": "Slon byl <w>vystrašený</w> z malých myší, které pobíhaly kolem.",
                                "es": "El elefante estaba <w>asustado</w> por los pequeños ratones que corrían alrededor.",
                                "zh": "大象被周围乱跑的小老鼠<w>惊吓</w>到了。"
                            }
                        }
