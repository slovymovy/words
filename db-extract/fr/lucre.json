                                                "sense_id": "d126d7b6-3d1b-39e8-8919-6f2b09b43db5",
                                                "text": "The word preached did not profit them."
                                            },
                                            {
                                                "example_id": "5ebb371d-d8f8-453a-9150-3c954ba59e7c",
                                                "sense_id": "d126d7b6-3d1b-39e8-8919-6f2b09b43db5",
