                        "glosses": [
                            "Type d’avion militaire (Lockheed Martin F-22 Raptor)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06bbc915-0b3f-413c-a9c3-49237e1c8aab",
                                "sense_id": "eea138c5-1c68-39dd-be5c-257e16328ecb",
                                "text": "Le laboratoire Lawrence Livermore, l’un des centres de recherche scientifique militaire les plus avancés du monde, développe une famille de drones dénommés Raptor Talon (griffe de rapace)."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b3827fb-c969-30e7-8d19-1b2934f2c035",
                        "entry_id": "57b4e5f7-7a5a-3447-b72c-087934e72531",
                        "glosses": [
                            "Nom d’un moteur-fusée de SpaceX, conçu pour l’exploration et la colonisation de la planète Mars."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d77d1680-466b-4977-b48e-38d37c8bc67b",
                                "sense_id": "1b3827fb-c969-30e7-8d19-1b2934f2c035",
                                "text": "Les estimations les plus récentes annoncent que le Raptor aura une poussée de 2300kN – environ trois fois la poussée des moteurs Merlin 1D utilisés actuellement par SpaceX, et environ un tiers de la poussée du moteur F-1 utilisé par Saturn V pour le mythique programme Apollo."
                            }
                        ]
