                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0f008652-3c27-34e5-b13e-1d04134f66ee",
                                        "entry_id": "ba87c7aa-90b5-3697-9d8c-0fa3ac067caa",
                                        "glosses": [
                                            "Habitant de la Souabe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
