                                            {
                                                "example_id": "b077b2a6-6474-4fbe-ac6c-558d9f177f27",
                                                "sense_id": "a51597be-b069-3b42-8291-1585e9f2e41a",
                                                "text": "„Eine alte Kirche ragt mächtig und hoch daraus hervor, Mauerreste einer Festung und eines massiven Turmes erinnern an vergangene Zeiten, da die Fürsten von Aragwi mit den Georgiern Krieg führten.“"
                                            },
                                            {
                                                "example_id": "9ccb7deb-dc4b-45f5-a9bb-59955cce2ee0",
                                                "sense_id": "a51597be-b069-3b42-8291-1585e9f2e41a",
                                                "text": "„Die Stahltür des Turmes war wie immer unverschlossen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bb7785ed-791c-321e-8d8a-39db9338ea25",
                                        "entry_id": "4e4acfd1-b261-31e1-8734-7c75cc96e1a1",
                                        "glosses": [
                                            "schlank aufragender Gebäudeteil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99771dbf-0155-413f-a53f-347b01b53f82",
                                                "sense_id": "bb7785ed-791c-321e-8d8a-39db9338ea25",
                                                "text": "Der Turm dieser Kirche ist sehr hoch."
                                            },
                                            {
                                                "example_id": "653aae2a-5b41-41eb-9190-a268d798449d",
                                                "sense_id": "bb7785ed-791c-321e-8d8a-39db9338ea25",
                                                "text": "„Im Turm war eine Art Bogen oder Loch, und man konnte eine sehr kleine Glocke erkennen.“"
                                            },
                                            {
                                                "example_id": "7ca18b60-c0ec-4857-9133-b0086d2b85fe",
                                                "sense_id": "bb7785ed-791c-321e-8d8a-39db9338ea25",
                                                "text": "„Auf dem Weg zur Moselmündung rücken schon bald die Türme der Kirche St. Kastor in den Mittelpunkt.“"
                                            },
                                            {
                                                "example_id": "6291a064-085f-47b4-ad56-2c7cf307af7c",
                                                "sense_id": "bb7785ed-791c-321e-8d8a-39db9338ea25",
                                                "text": "„1772 zerstörte eine Lawine einen Teil der Kathedrale und ein Treppenhaus, das sich möglicherweise in einem Turm befand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ac5db9de-62b4-3faa-b00e-05e98a60d963",
                                        "entry_id": "4e4acfd1-b261-31e1-8734-7c75cc96e1a1",
                                        "glosses": [
                                            "Spielfigur beim Schach"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3527e8a-7cfc-4fea-a831-3eb663a43bc9",
                                                "sense_id": "ac5db9de-62b4-3faa-b00e-05e98a60d963",
                                                "text": "„Weiß gab auf, er verliert einen Turm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "2545694b-8fd6-3850-8e5a-c830ac4a7b84",
                                        "entry_id": "4e4acfd1-b261-31e1-8734-7c75cc96e1a1",
                                        "glosses": [
                                            "etwas Hohes, Starkes, Festes"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e44a15fd-3e60-40f4-81a1-050e93e59522",
                                                "sense_id": "2545694b-8fd6-3850-8e5a-c830ac4a7b84",
                                                "text": "Seine Freundin war sicherer Turm, mit ihr an der Seite hat er viel durchgestanden."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "f73ca9d7-afc1-3033-8004-e8abafd82604",
                                        "entry_id": "4e4acfd1-b261-31e1-8734-7c75cc96e1a1",
                                        "glosses": [
                                            "drehbares Modul auf einem Panzer, an welches das Geschütz befestigt ist"
                                        ],
                                        "tags": [
                                            "Panzertechnik"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    }
