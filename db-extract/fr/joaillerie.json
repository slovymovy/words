                                "target_word": "Schmuckgeschäft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f6174ae6-9146-3daa-a474-feb97230f9d2",
                                        "entry_id": "4b952f98-557a-3896-b951-0d3d927fda06",
                                        "glosses": [
                                            "gewerbliche Räumlichkeiten, in denen Schmuck zum Verkauf angeboten werden"
                                        ],
                                        "tags": [],
