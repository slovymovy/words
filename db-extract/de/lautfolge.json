                "senses": [
                    {
                        "sense_id": "c230507b-1e72-30c4-8369-751f55476d15",
                        "entry_id": "f1a7c3fc-e22d-329d-9b67-378568924025",
                        "glosses": [
                            "Aufeinanderfolge von Lauten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "faef2b4a-ee7f-4258-902d-ed178df0f9de",
                                "sense_id": "c230507b-1e72-30c4-8369-751f55476d15",
                                "text": "„Lautfolgen sind grundsätzlich in Silben organisiert.“"
                            },
                            {
                                "example_id": "3dba2b84-4003-4884-a125-f01dfa2eb8a5",
                                "sense_id": "c230507b-1e72-30c4-8369-751f55476d15",
                                "text": "„Bei der Haplologie oder Silbenschichtung werden zwei gleiche Lautfolgen zu einer einzigen vereinfacht.“"
                            },
                            {
                                "example_id": "01347209-6ade-4c52-95f5-57ed3d7f1c3c",
                                "sense_id": "c230507b-1e72-30c4-8369-751f55476d15",
                                "text": "„Erst, wenn man einen Ausschnitt der Lautfolge isoliert, kann man leichter bestimmen, ob ein fester oder ein loser Anschluß - linguistisch gesprochen: eine geschlossene oder offene Junktur - vorliegt.“"
                            },
                            {
                                "example_id": "e8577d16-2de5-422b-adb1-6bb550d523d8",
                                "sense_id": "c230507b-1e72-30c4-8369-751f55476d15",
                                "text": "„Bezeichnungen können nur schlecht abgerufen und in der korrekten Lautfolge realisiert werden“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
