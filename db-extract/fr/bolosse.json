                        "glosses": [
                            "Prune ou prunelle."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "0ad44db8-4139-44e4-8b8a-6fe400cc2ec0",
                                "sense_id": "f022bdef-7a2a-3ed1-b39a-381a45a86d14",
                                "text": "nᵒ 7 les Bretons (M. Le Gall, lettre) emploient le nom de prun qui est le mot grec et latin. Ils ont d'autres noms Bolosse ou Bêlasse pour le fruit sauvage du Prunus insititia et Hirin ou Irin pour celui du Pr. spinosa."
                            },
                            {
                                "example_id": "44938b40-db74-4874-a1a7-8e1454ef4ffc",
                                "sense_id": "f022bdef-7a2a-3ed1-b39a-381a45a86d14",
                                "text": "BELOSSE, sf Prunelle, prune sauvage, fruit du prunelier. Terme suisse-roman savoisien et vieux français. A Fribourg on dit Bolosse, à Lyon et dans le Jura pelosse, en Normandie Bloche. A Reims on donne aux prunes le nom générique de balosses."
                            }
                        ]
                    }
