                ],
                "senses": [
                    {
                        "sense_id": "4e02174a-2571-35c8-bf7f-e7579ece5346",
                        "entry_id": "9ee6d3e3-08de-3ab6-9f2b-ea76cc320c25",
                        "glosses": [
                            "Qui est garni de champignons ou de moisissures."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "171159a5-e078-4762-b50d-7ff1d08ab0c6",
                                "sense_id": "4e02174a-2571-35c8-bf7f-e7579ece5346",
                                "text": "La route est impraticable, l'eau du robinet terreuse, les draps de lit trempés, les habits champignonneux. Le lagon, habituellement bleu-vert transparent, devient marron à force de réceptionner la terre qui s'y déverse."
                            },
                            {
                                "example_id": "fc41ac98-8ee7-4735-8d65-175847445f17",
                                "sense_id": "4e02174a-2571-35c8-bf7f-e7579ece5346",
                                "text": "En sus de ces escapades champêtres de plus en plus fréquentes, pour éviter qu'il s'étiolât, qu'il (« on ne sait jamais ») se tuberculosât dans l'air champignonneux du cagibi, on envoyait J, fort aise, se rechlorophyller pour des périodes longues à la campagne."
                            },
                            {
                                "example_id": "638830df-7f1e-44d4-b107-d1d11ff6c3e1",
                                "sense_id": "4e02174a-2571-35c8-bf7f-e7579ece5346",
                                "text": "Ah ! cette auberge, quelle tanière ! enfumée, humide, champignonneuse !"
                            }
                        ]
                    },
                    {
                        "sense_id": "fb19eaea-037c-3c05-a491-9071d8db313e",
                        "entry_id": "9ee6d3e3-08de-3ab6-9f2b-ea76cc320c25",
                        "glosses": [
                            "Relatif aux champignons ou aux moisissures."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b9ff0e8-795b-4560-b7c3-0d7ef01bf4cd",
                                "sense_id": "fb19eaea-037c-3c05-a491-9071d8db313e",
                                "text": "La masse champignonneuse prolifère en même temps et bientôt elle forme autour de la papille une sorte de manchon. Les sporules s'insinuent en outre entre les cellules épithéliales les plus superficielles et les dissocient."
                            }
                        ]
                    }
