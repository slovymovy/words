                        "tags": [],
                        "examples": [
                            {
                                "example_id": "746bdd01-b801-4528-a7e7-d9d06f34863d",
                                "sense_id": "19d61db6-2520-36e9-b8f9-cfbc4a8e85cd",
                                "text": "„Zwei Tage später, als er auf kaum mehr als einer Raupenschlepperpiste in der schwarzen Erde durch die Sümpfe östlich von Lafayette fuhr - Lebenseichen-Gehölze und Totwasser-Bayous, aus deren grünem Schlick Zypressen-Baumknie ragten -, kam er an eine Weggabelung und blieb mit laufendem Motor stehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e7e05153-4670-30d9-aa4d-21d12c30a52c",
                        "entry_id": "189326fa-6de8-365a-af25-eb8ba47cdc29",
                        "glosses": [
                            "Ort im US-Bundesstaat Indiana"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44ed7253-320c-4f54-b2cf-5a07d38e9b2d",
                                "sense_id": "e7e05153-4670-30d9-aa4d-21d12c30a52c",
                                "text": "„Die Leiche der zweite entführten Frau wurde zuerst gefunden, wie sie im Wabash im Geschäftsviertel von Lafayette, Indiana, trieb, direkt unterhalb der Interstate 65.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
