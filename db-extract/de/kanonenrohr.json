                "senses": [
                    {
                        "sense_id": "1bb316ec-67cd-308c-9f5a-916b4cbeb97d",
                        "entry_id": "3c3592ad-5665-390e-84c3-82e5115aa9a4",
                        "glosses": [
                            "Rohr einer Kanone"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7284b757-ed32-4a08-9b5b-360389cb800a",
                                "sense_id": "1bb316ec-67cd-308c-9f5a-916b4cbeb97d",
                                "text": "„Durch die allgemeine Einführung von gezogenen Kanonenrohren nach 1860 waren die Festungswerke nicht mehr zeitgemäß - ihre Ära war damit beendet, denn sie wurden vom Militär kaum noch benutzt.“"
                            },
                            {
                                "example_id": "44f2177c-81d9-4d6c-8b01-32909dc9a63b",
                                "sense_id": "1bb316ec-67cd-308c-9f5a-916b4cbeb97d",
                                "text": "„Ich sah Kanonenrohre, die fast umgeknickt waren.“"
                            },
                            {
                                "example_id": "2723f238-d9a9-428b-8b22-600b2d989632",
                                "sense_id": "1bb316ec-67cd-308c-9f5a-916b4cbeb97d",
                                "text": "„In den ersten Julitagen verließen sie Wilna, nachdem sie das Wort Moskau auf die Kanonenrohre gemalt hatten.“"
                            },
                            {
                                "example_id": "fd05f443-499a-4565-ac6c-42434ea5be54",
                                "sense_id": "1bb316ec-67cd-308c-9f5a-916b4cbeb97d",
                                "text": "„Die Bundeswehr füllt damit Kanonenrohre auf, um Fehlschüsse bei Truppenübungen zu vermeiden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
