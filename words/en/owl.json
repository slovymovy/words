{
    "word_family": [
        "owlet",
        "owlish",
        "owlishly",
        "owlishness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "52dc849f-2363-3399-a6ce-d92dc5cd2b61",
                    "sense_definition": "A nocturnal bird of prey with large eyes, a flat face, and a hooked beak.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "birds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>owl</w> sat silently on a branch, waiting for a mouse to move in the grass.",
                            "target_lang_translations": {
                                "ru": "<w>Сова</w> молча сидела на ветке, ожидая, когда в траве зашевелится мышь."
                            }
                        },
                        {
                            "text": "We heard a <w>screech</w> <w>owl</w> calling from the woods behind our house last night.",
                            "target_lang_translations": {
                                "ru": "Прошлой ночью мы слышали, как в лесу за нашим домом кричала <w>совка</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "screech owl",
                        "barn owl",
                        "snowy owl",
                        "wise owl"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ночная хищная птица с большими глазами, плоским лицом и крючковатым клювом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сова",
                                "target_lang_sense_clarification": "общее название птицы"
                            },
                            {
                                "target_lang_word": "филин",
                                "target_lang_sense_clarification": "крупная птица семейства совиных"
                            },
                            {
                                "target_lang_word": "сыч",
                                "target_lang_sense_clarification": "небольшая птица семейства совиных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01ea53c9-f8f8-303c-b484-e2ba6834bda3",
                    "sense_definition": "A person who is active at night or who appears wise and serious.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My brother is a total <w>night</w> <w>owl</w> who prefers to study after midnight.",
                            "target_lang_translations": {
                                "ru": "Мой брат — настоящая ночная <w>сова</w>, он предпочитает учиться после полуночи."
                            }
                        },
                        {
                            "text": "He sat there like a solemn <w>owl</w>, listening to the debate without saying a word.",
                            "target_lang_translations": {
                                "ru": "Он сидел там с видом важной <w>совы</w>, слушая дебаты и не говоря ни слова."
                            }
                        }
                    ],
                    "synonyms": [
                        "night owl"
                    ],
                    "antonyms": [
                        "lark"
                    ],
                    "common_phrases": [
                        "night owl"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который активен ночью или выглядит мудрым и серьезным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сова",
                                "target_lang_sense_clarification": "о человеке, ведущем ночной образ жизни"
                            },
                            {
                                "target_lang_word": "полуночник",
                                "target_lang_sense_clarification": "человек, который поздно ложится спать"
                            },
                            {
                                "target_lang_word": "сыч",
                                "target_lang_sense_clarification": "об угрюмом или нелюдимом человеке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "546175e6-c71d-3988-8471-b3b34bf91f0b",
                    "sense_definition": "A politician who holds moderate views, positioned between aggressive hawks and peaceful doves.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "politics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The senator was known as an <w>owl</w> for his balanced approach to foreign policy.",
                            "target_lang_translations": {
                                "ru": "Сенатор был известен как «<w>сова</w>» за свой взвешенный подход к внешней политике."
                            }
                        },
                        {
                            "text": "In a room full of hawks and doves, the <w>owl</w> sought a middle ground.",
                            "target_lang_translations": {
                                "ru": "В комнате, полной «ястребов» и «голубей», «<w>сова</w>» искала компромисс."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Политик, придерживающийся умеренных взглядов, занимающий позицию между агрессивными «ястребами» и миролюбивыми «голубями»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сова",
                                "target_lang_sense_clarification": "политик-центрист"
                            },
                            {
                                "target_lang_word": "умеренный политик",
                                "target_lang_sense_clarification": "человек с взвешенным подходом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e874595-75e5-34cb-9064-b538f51a14a3",
                    "sense_definition": "A type of butterfly with large spots on its wings that look like eyes.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "insects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>owl</w> butterfly uses its large eyespots to scare away potential predators.",
                            "target_lang_translations": {
                                "ru": "Бабочка-<w>сова</w> использует свои большие пятна-глазки, чтобы отпугивать потенциальных хищников."
                            }
                        },
                        {
                            "text": "We spotted a beautiful <w>owl</w> resting on a tropical leaf in the conservatory.",
                            "target_lang_translations": {
                                "ru": "В оранжерее мы заметили красивую <w>бабочку-сову</w>, отдыхающую на тропическом листе."
                            }
                        }
                    ],
                    "synonyms": [
                        "owl butterfly"
                    ],
                    "common_phrases": [
                        "owl butterfly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вид бабочки с крупными пятнами на крыльях, похожими на глаза."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бабочка-сова",
                                "target_lang_sense_clarification": "название насекомого"
                            },
                            {
                                "target_lang_word": "калиго",
                                "target_lang_sense_clarification": "научное название рода"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ccc3881-bc27-3f56-9bde-e81bd80cbfb2",
                    "sense_definition": "A specific breed of domestic pigeon with a short beak and a frill of feathers on its breast.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "birds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The breeder specialized in the African <w>owl</w>, a popular variety of fancy pigeon.",
                            "target_lang_translations": {
                                "ru": "Заводчик специализировался на африканских <w>совиных голубях</w>, популярной разновидности декоративных голубей."
                            }
                        },
                        {
                            "text": "At the bird show, the English <w>owl</w> won first prize for its unique plumage.",
                            "target_lang_translations": {
                                "ru": "На выставке птиц английский <w>совиный голубь</w> получил первый приз за уникальное оперение."
                            }
                        }
                    ],
                    "synonyms": [
                        "owl pigeon"
                    ],
                    "common_phrases": [
                        "owl pigeon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенная порода домашних голубей с коротким клювом и жабо из перьев на груди."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совиный голубь",
                                "target_lang_sense_clarification": "порода голубей"
                            },
                            {
                                "target_lang_word": "чайка",
                                "target_lang_sense_clarification": "русское название данной группы пород голубей"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "45685356-9069-34a0-824a-91394b5826d0",
                    "sense_definition": "To engage in the illegal transport or smuggling of goods, especially wool or sheep.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "crime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the eighteenth century, many coastal villagers would <w>owl</w> wool to avoid high taxes.",
                            "target_lang_translations": {
                                "ru": "В восемнадцатом веке многие жители прибрежных деревень <w>контрабандно вывозили</w> шерсть, чтобы избежать высоких налогов."
                            }
                        },
                        {
                            "text": "The authorities struggled to catch those who chose to <w>owl</w> across the channel at night.",
                            "target_lang_translations": {
                                "ru": "Власти изо всех сил пытались поймать тех, кто решал <w>заниматься контрабандой</w> через канал по ночам."
                            }
                        }
                    ],
                    "synonyms": [
                        "smuggle"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used historically for smuggling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заниматься незаконной перевозкой или контрабандой товаров, особенно шерсти или овец."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заниматься контрабандой",
                                "target_lang_sense_clarification": "незаконно перевозить товары"
                            },
                            {
                                "target_lang_word": "контрабандно вывозить",
                                "target_lang_sense_clarification": "особенно шерсть в историческом контексте"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}