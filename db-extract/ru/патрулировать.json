                ],
                "translations": [
                    {
                        "translation_id": "f7c10d39-9098-4cfb-b0b3-49c5ffa84059",
                        "source_entry_id": "85490998-5efb-3b0e-b460-7175c9c9adcf",
                        "source_sense_id": "a594a978-77ec-332b-bfe8-3fed31f24d0c",
                        "target_lang_word": "patrol",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "patrol",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ed09e08-67eb-3869-a7ac-559ac7f5f9c8",
                                        "entry_id": "407ea250-6816-3ed3-88c6-52a7e01bf317",
                                        "glosses": [
                                            "A going of the rounds along the chain of sentinels and between the posts, by a guard, usually consisting of three or four men, to insure greater security from attacks on the outposts."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4f26d94-dba1-48a1-92da-efb1db31c68d",
                                                "sense_id": "4ed09e08-67eb-3869-a7ac-559ac7f5f9c8",
                                                "text": "Four members of the squadron were on patrol."
                                            },
                                            {
                                                "example_id": "784277f8-6591-4083-80d8-79185e245ecd",
                                                "sense_id": "4ed09e08-67eb-3869-a7ac-559ac7f5f9c8",
                                                "text": "The watch consisted of twelve convicts—men selected for their good behaviour. Immediately after tattoo had beat they began their patrol. 'No complaint was ever made of them,' remarks Phillip, and they were expressly cautioned to avoid disputes with soldiers or seamen ( many of whom were as great thieves as the convicts themselves)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5da61ca-8ea6-3a50-86ad-ff4ac594714b",
                                        "entry_id": "407ea250-6816-3ed3-88c6-52a7e01bf317",
                                        "glosses": [
                                            "A movement, by a small body of troops beyond the line of outposts, to explore the country and gain intelligence of the enemy's whereabouts."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b0f9379f-13e0-3322-bd1b-97f13d478e31",
                                        "entry_id": "407ea250-6816-3ed3-88c6-52a7e01bf317",
                                        "glosses": [
                                            "The guards who go the rounds for observation; a detachment whose duty it is to patrol."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "646a397d-b3f0-4fe7-aa3f-c18d9dffefd3",
                                                "sense_id": "b0f9379f-13e0-3322-bd1b-97f13d478e31",
                                                "text": "After cordial good-bye to our hospitable hostess we motored back to Chaumont where we dined with Colonel Mitchell; and then with another long drive we finally reached home tired but happy at 3.30 in the morning. There staring me in the face was an order directing me to lead my patrol over the lines in the morning at five o'clock, sharp! An hour and a half sleep for an utterly worn out aviator!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dc5a6d0-4060-342f-b41e-cdb89ad1d4a9",
                                        "entry_id": "407ea250-6816-3ed3-88c6-52a7e01bf317",
                                        "glosses": [
                                            "The largest division of officers within a police department or sheriff's office, whose assignment is to patrol and respond to calls for service."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a7733d41-1c8a-3b12-9424-44f77b85ce8d",
                                        "entry_id": "407ea250-6816-3ed3-88c6-52a7e01bf317",
                                        "glosses": [
                                            "Any perambulation of a particular line or district to guard it; also, the people thus guarding."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed7badb3-49b6-4b64-b253-6b0838e8e418",
                                                "sense_id": "a7733d41-1c8a-3b12-9424-44f77b85ce8d",
                                                "text": "a fire patrol"
                                            },
                                            {
                                                "example_id": "8113ebe2-e9cc-42c6-b29d-544981f21e04",
                                                "sense_id": "a7733d41-1c8a-3b12-9424-44f77b85ce8d",
                                                "text": "1787-1788, Alexander Hamilton, The Federalist Papers\nIn France there is an army of patrols […] to secure her fiscal regulations."
                                            },
                                            {
                                                "example_id": "1b7de271-754a-4f03-b991-f704c8bf7f70",
                                                "sense_id": "a7733d41-1c8a-3b12-9424-44f77b85ce8d",
                                                "text": "a customs patrol"
                                            },
                                            {
                                                "example_id": "fb6bed12-cf37-490d-bbda-9fdb3534876d",
                                                "sense_id": "a7733d41-1c8a-3b12-9424-44f77b85ce8d",
                                                "text": "Philadelphia’s foot-patrol strategy was developed after a study in 2009 by criminologists from Temple University, which is in the 22nd district. A randomised trial overturned the conventional view that foot patrols make locals like the police more and fear crime less, but do not actually reduce crime. In targeted areas, violent crime decreased by 23%."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b761cba0-58f9-39b1-b48a-505726f12700",
                                        "entry_id": "407ea250-6816-3ed3-88c6-52a7e01bf317",
                                        "glosses": [
                                            "A unit of a troop, usually defined by certain ranks or age groups within the troop, and ideally comprised of six to eight members."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91e3c31e-21b4-41b2-9933-1450a65a6fc6",
                                                "sense_id": "b761cba0-58f9-39b1-b48a-505726f12700",
                                                "text": "On a makeshift bed in the corner was an old woman looking very sick. Then a patrol of \"Missioner\" Scouts appeared on the scene: one seized a broom and swept out the room; the next made up the fire with some fuel he had procured and made her a cup of tea; another mended the rickety table, bed and chair, making them at any rate serviceable, while a fourth straightened out the bedclothes, propped the old lady up, and did his best to cheer her until the tea was ready."
                                            },
                                            {
                                                "example_id": "db5de139-756c-42f0-bdd5-235bb6f55877",
                                                "sense_id": "b761cba0-58f9-39b1-b48a-505726f12700",
                                                "text": "The formation of the boys into Patrols of from six to eight and training them as separate units each under its own responsible leader is the key to a good Troop."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "patrol",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ced7064c-4723-305b-87ef-b4b6dc3b96c2",
                                        "entry_id": "5d005e86-bb36-34c0-bf97-5cf48de73853",
                                        "glosses": [
                                            "To go the rounds along a chain of sentinels; to traverse a police district or beat."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7ce44a85-0aa8-3aa1-8750-27841051e79f",
                                        "entry_id": "5d005e86-bb36-34c0-bf97-5cf48de73853",
                                        "glosses": [
                                            "To go the rounds of, as a sentry, guard, or policeman"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91c259cd-2eee-4d03-8482-da71fe431959",
                                                "sense_id": "7ce44a85-0aa8-3aa1-8750-27841051e79f",
                                                "text": "to patrol a frontier"
                                            },
                                            {
                                                "example_id": "d9d15620-0164-4f97-97ae-db905915b07e",
                                                "sense_id": "7ce44a85-0aa8-3aa1-8750-27841051e79f",
                                                "text": "to patrol a beat"
                                            },
                                            {
                                                "example_id": "e8029724-3727-4b4c-9c84-0d1bd12a4565",
                                                "sense_id": "7ce44a85-0aa8-3aa1-8750-27841051e79f",
                                                "text": "Watchmen are stationed continuously at each end of the bridge, and the main spans are patrolled twice during the night."
                                            },
                                            {
                                                "example_id": "e5d8961c-d131-4b0a-88be-540e434079f8",
                                                "sense_id": "7ce44a85-0aa8-3aa1-8750-27841051e79f",
                                                "text": "Whether attempting to keep the peace in Bosnia, evacuating American citizens from Albania, or patrolling the world's seas and skies, our service men and women risk capture by unfriendly foreign forces."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
