                ],
                "senses": [
                    {
                        "sense_id": "9f83c6a4-3c5f-3b75-9f2f-795bed42b787",
                        "entry_id": "22378167-7cec-3664-a566-4ff72619c165",
                        "glosses": [
                            "в странах Западной Европы: наёмный лёгкий экипаж, запряжённый лошадьми"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33076ec4-2e03-4af1-be98-c53512dcef15",
                                "sense_id": "9f83c6a4-3c5f-3b75-9f2f-795bed42b787",
                                "text": "Я нанял фиакр, приказав ехать к себе, и прибыл в четыре ночи к подъезду, узнав, что ещё не спят."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c57da5c-5072-4384-a166-87d8885e7e97",
                        "source_entry_id": "22378167-7cec-3664-a566-4ff72619c165",
                        "source_sense_id": "9f83c6a4-3c5f-3b75-9f2f-795bed42b787",
                        "target_lang_word": "fiacre",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fiacre",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71f71962-d628-357b-b0fd-3b1592fba111",
                                        "entry_id": "721700b1-9cfa-3274-8f16-09e709fac313",
                                        "glosses": [
                                            "A small horse-drawn carriage for hire; a hackney carriage."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55b9c639-55ad-4098-a699-99b14a9cafc1",
                                                "sense_id": "71f71962-d628-357b-b0fd-3b1592fba111",
                                                "text": "On the road to Choissi, a fiacre, or hackney-coach, stopped, and out came five or six men, armed with musquets, who took post, each behind a separate tree."
                                            },
                                            {
                                                "example_id": "eb2246ed-f721-452f-88f2-7fd8f7ff1250",
                                                "sense_id": "71f71962-d628-357b-b0fd-3b1592fba111",
                                                "text": "Poor Jim, with his arms folded and his little legs out in the open fiacre, drank in the sparkling Paris noon and carried his eyes from one side of their vista to the other."
                                            },
                                            {
                                                "example_id": "fd0608de-6944-4484-b19d-4e83385c9e37",
                                                "sense_id": "71f71962-d628-357b-b0fd-3b1592fba111",
                                                "text": "The boy who might have fetched us a fiacre was now doing something else, so we had to go back to the station, and there we found only one, which was falling to pieces."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59a08a09-cad2-41ac-a8ac-9c2efd68fdfa",
                        "source_entry_id": "22378167-7cec-3664-a566-4ff72619c165",
                        "source_sense_id": "9f83c6a4-3c5f-3b75-9f2f-795bed42b787",
                        "target_lang_word": "Fiaker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fiaker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "077a2db6-b3ec-3816-933e-777d9ade20e2",
                                        "entry_id": "aa6daf44-2cc0-3abc-b8d7-2b13602cb784",
                                        "glosses": [
                                            "Mietkutsche mit zwei Pferden"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b33a391e-c996-47e2-9d84-56b57310abd0",
                                                "sense_id": "077a2db6-b3ec-3816-933e-777d9ade20e2",
                                                "text": "„Er eilte die Treppe hinab, setzte sich in den nächsten Fiaker und fuhr aufs Land.“"
                                            },
                                            {
                                                "example_id": "6dc484e6-4b85-4a84-915c-5c3bf140f07b",
                                                "sense_id": "077a2db6-b3ec-3816-933e-777d9ade20e2",
                                                "text": "„In den engen Gassen der historischen Altstadt war der Fiaker umgestürzt, was die Tiere aber nur weiter aufgestachelt hatte.“"
                                            },
                                            {
                                                "example_id": "1ffc4c23-7959-44f0-b3c2-a1fd587e3ce1",
                                                "sense_id": "077a2db6-b3ec-3816-933e-777d9ade20e2",
                                                "text": "„Ich nahm den erstbesten Fiaker, den ich fand, und fuhr zu Patu, dem ich wutschnaubend mein Erlebnis erzählte.“"
                                            },
                                            {
                                                "example_id": "9f4c7be7-8391-42a1-a378-e3b9806d5295",
                                                "sense_id": "077a2db6-b3ec-3816-933e-777d9ade20e2",
                                                "text": "In Wien sind die Fiaker heute eine beliebte Touristenattraktion."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "14a875c6-6234-3a82-8a25-98cccb5cc040",
                                        "entry_id": "aa6daf44-2cc0-3abc-b8d7-2b13602cb784",
                                        "glosses": [
                                            "Fahrer, Lenker eines Fiakers^([1])"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1091d879-c91e-41c0-ae98-4b5b93cadde0",
                                                "sense_id": "14a875c6-6234-3a82-8a25-98cccb5cc040",
                                                "text": "„Die Fiaker vor dem Bahnhofe machten mir ihre komfortabelsten Gesichter, nannten mich »Herr Baron« und als mir das nicht zu genügen schien, »Herr Graf«; ich aber versetzte ohne allen Adelsstolz: »Nein, meine Herren, jetzt wird gegangen.«“"
                                            },
                                            {
                                                "example_id": "5cfa6acd-7388-493f-820d-bf4dae84fff3",
                                                "sense_id": "14a875c6-6234-3a82-8a25-98cccb5cc040",
                                                "text": "„Und dem Fiaker müsse man nun auch ein übermäßiges Trinkgeld geben.“"
                                            },
                                            {
                                                "example_id": "def5110a-3173-4aaf-a137-096e3abfe8ef",
                                                "sense_id": "14a875c6-6234-3a82-8a25-98cccb5cc040",
                                                "text": "„Unglaubwürdig laut, so als hätten die Fiaker verborgene Lautsprecher integriert, die den perfekten Hufsound verstärken, knallten die traurigen Gäule ihre Eisen aufs Pflaster.“"
                                            },
                                            {
                                                "example_id": "2049f17a-aed8-4db0-8d7f-5707c334feef",
                                                "sense_id": "14a875c6-6234-3a82-8a25-98cccb5cc040",
                                                "text": "In Wien sind die Fiaker heute eine beliebte Touristenattraktion."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b0d9c2e1-cde1-3ac6-a276-661e52b7f20a",
                                        "entry_id": "aa6daf44-2cc0-3abc-b8d7-2b13602cb784",
                                        "glosses": [
                                            "großer Mokka im Glas mit viel Zucker und einem Stamperl Sliwowitz oder Rum"
                                        ],
                                        "tags": [
                                            "Wien"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc4b9eca-b381-42f6-803c-e752f9140291",
                                                "sense_id": "b0d9c2e1-cde1-3ac6-a276-661e52b7f20a",
                                                "text": "Einen Fiaker bitte, ein Glas Wasser, Zahnstocher und die Zeitung."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
