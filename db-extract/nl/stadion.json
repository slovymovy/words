                        "sense_id": "6fb6cb30-34a1-3da8-adeb-e0a20bd8008b",
                        "entry_id": "7f19d43c-8b56-3b26-8301-14b8018f6514",
                        "glosses": [
                            "groot complex voorzien van sportvelden, tribunes en bijbehorende nutsvoorzieningen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73278f54-edb8-40ce-bdd3-5ca01ce9f253",
                                "sense_id": "6fb6cb30-34a1-3da8-adeb-e0a20bd8008b",
                                "text": "Toeters en vlaggen: Volgens de regionale omroep RTV Oost was het ook druk in de omgeving van het stadion van de club, De Adelaarshorst. Voorbijkomende auto's toeterden erop los en mensen hingen met vlaggen uit het raam."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "728139d9-fb1e-4a83-9a16-79e374b3ad39",
                        "source_entry_id": "7f19d43c-8b56-3b26-8301-14b8018f6514",
                        "source_sense_id": "6fb6cb30-34a1-3da8-adeb-e0a20bd8008b",
                        "target_lang_word": "Stadion",
