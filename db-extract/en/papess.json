                                        "sense_id": "8ff97b20-70b2-3b92-86bd-309834421a05",
                                        "entry_id": "ed4c73c0-7d09-32df-969a-a97419e390be",
                                        "glosses": [
                                            "weibliche Person als Oberhaupt der Römisch-Katholischen Kirche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cc2d102-d663-41cb-b7c1-d268f0afe548",
                                                "sense_id": "8ff97b20-70b2-3b92-86bd-309834421a05",
                                                "text": "Bei Päpstin Johanna (auch „Johannes Anglicus\") handelt es sich um eine Figur, von der noch heute unklar ist, ob ihre Existenz eine Legende ist oder einen historischen Kern besitzt."
                                            },
                                            {
                                                "example_id": "d27c526d-c8c7-4e85-af56-ac172daf2444",
                                                "sense_id": "8ff97b20-70b2-3b92-86bd-309834421a05",
                                                "text": "„Der «Papst-Kaiser-Rotulus», der um 1432 im Rhein-Main-Gebiet entstanden ist, reiht 1400 Jahre Papstgeschichte als Bildfolge aneinander. Unter den Päpsten führt die Rolle unter anderen auch die umstrittene Päpstin Johanna auf. (Bild: Berlin, Staatsbibliothek)“ www.nzz.ch"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
