                ],
                "senses": [
                    {
                        "sense_id": "dc8a0951-3ca8-377d-b7c6-be132d4d7f01",
                        "entry_id": "09bb2576-8af6-3b49-88c7-4c9768f6dbf5",
                        "glosses": [
                            "состоящий из клочков; сбитый в клочья"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11d9a2c1-42d4-48ed-bf83-3d93225436f2",
                                "sense_id": "dc8a0951-3ca8-377d-b7c6-be132d4d7f01",
                                "text": "Приснилось это клочковатое бегущее серенькое небо, а под ним беззвучная стая грачей"
                            }
                        ]
                    },
                    {
                        "sense_id": "769a6970-c6a9-32ce-b66a-03afab9b4d79",
                        "entry_id": "09bb2576-8af6-3b49-88c7-4c9768f6dbf5",
                        "glosses": [
                            "перен., разг. неровный, отрывистый"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f85fd1c9-9e75-4c46-8ca9-897b0fcbb004",
                        "source_entry_id": "09bb2576-8af6-3b49-88c7-4c9768f6dbf5",
                        "target_lang_word": "floconneux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "floconneux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a69c89bb-28c4-379f-a80d-3874e4a3fc80",
                                        "entry_id": "5250a0e7-0080-3ba9-96e4-cdf2f647b938",
                                        "glosses": [
                                            "Qui a la forme de flocons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a115121-7ad0-49fc-9212-cb724f8c04bd",
                                                "sense_id": "a69c89bb-28c4-379f-a80d-3874e4a3fc80",
                                                "text": "Il saisit Héloïse, l'enlève entre ses bras comme une balle de fougère, une sachée de linaigrettes floconneuses, et la transporte doucement, parmi les couvertures qu'il rabat sur elle."
                                            },
                                            {
                                                "example_id": "d7c05a6a-ad42-403c-9c55-ff42c6b6e836",
                                                "sense_id": "a69c89bb-28c4-379f-a80d-3874e4a3fc80",
                                                "text": "C'était une soirée délicieuse : dans le firmament d'une douceur et d'une pureté inénarrables, la lune gravitait solitaire, chassant devant elle une multitude de petits nuages floconneux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
