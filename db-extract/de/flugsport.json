                ],
                "senses": [
                    {
                        "sense_id": "b062d8f3-bf8e-3ac2-8559-f385c6216701",
                        "entry_id": "ff0e9d97-9e4c-3685-8b9f-ddd607e5ff22",
                        "glosses": [
                            "Sportart, bei der sich ein Pilot mittels eines Fluggeräts durch die Luft bewegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f045c268-ff93-4359-a8b7-338e46d42ad9",
                                "sense_id": "b062d8f3-bf8e-3ac2-8559-f385c6216701",
                                "text": "„Argelander vermutet den Schlüssel für die Sozialprobleme in der schon sehr früh aufgetretenen Leidenschaft für den Flugsport.“"
                            },
                            {
                                "example_id": "81a14857-5000-4f24-a42a-8e11b7ea79f4",
                                "sense_id": "b062d8f3-bf8e-3ac2-8559-f385c6216701",
                                "text": "„Ausgerechnet Neuseeland, dessen Einwohner sich nach einem flugunfähigen Vogel stolz Kiwis nennen, hat sich diesem ungewöhnlichen Flugsport verschrieben.“"
                            },
                            {
                                "example_id": "8d27b603-8e34-4565-91c1-9353b77042e5",
                                "sense_id": "b062d8f3-bf8e-3ac2-8559-f385c6216701",
                                "text": "„Ich habe nie bestritten, daß Niemela sich auf dem Gebiete des Flugsports Verdienste erworben hat.“"
                            },
                            {
                                "example_id": "949bd070-7109-4c79-bc2a-bf7d92b913c4",
                                "sense_id": "b062d8f3-bf8e-3ac2-8559-f385c6216701",
                                "text": "„Der Sonderlandeplatz dient dem privaten Geschäftsverkehr und dem Flugsport.“"
                            },
                            {
                                "example_id": "3318b9f0-2d99-4cfa-af43-8f69dbf070d6",
                                "sense_id": "b062d8f3-bf8e-3ac2-8559-f385c6216701",
                                "text": "„Jordanien sei an der Etablierung des Flugsports sehr interessiert.“"
                            },
                            {
                                "example_id": "d9f565d2-b661-4148-a30c-573895a93e8c",
                                "sense_id": "b062d8f3-bf8e-3ac2-8559-f385c6216701",
                                "text": "Das Kunstfliegen gilt als die Königsdisziplin des Flugsports.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
