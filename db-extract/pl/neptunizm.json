                            {
                                "example_id": "95b4636d-0144-4d60-82d0-bfd4e4d34e12",
                                "sense_id": "2505ca30-0fc2-3dc0-8ad9-9e6f8cb34e93",
                                "text": "W XVIII wieku neptunizm dominował w geologii, zanim został obalony przez teorię wulkanizmu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
