                    {
                        "translation_id": "c6d910f8-99b1-4b93-94fa-37b5f637de41",
                        "source_entry_id": "0f737de0-210a-3c88-93e2-29d3b5897121",
                        "source_sense_description": "direct, without intermediate stages",
                        "target_lang_word": "unmittelbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unmittelbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "34e8e709-b8cf-39a7-b288-9d2d10aa35ca",
                                        "entry_id": "58f555b5-dc5c-301b-84d3-49abd7033ffa",
                                        "glosses": [
                                            "ohne etwas dazwischen"
                                        ],
                                        "tags": [
                                            "räumlich",
                                            "nicht steigerbar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bbb1bc6-2aa0-4ec4-aede-cc7b049bfba7",
                                                "sense_id": "34e8e709-b8cf-39a7-b288-9d2d10aa35ca",
                                                "text": "Die zwei Grundstücke grenzen unmittelbar aneinander."
                                            },
                                            {
                                                "example_id": "14573639-9ad3-45dc-abf8-e9e1328d549d",
                                                "sense_id": "34e8e709-b8cf-39a7-b288-9d2d10aa35ca",
                                                "text": "„Nicht zu verwechseln übrigens mit dem hessischen Nesselröden bei Herleshausen ist die unmittelbar an der ehemaligen innerdeutschen Grenze gelegene gleichnamige Eichsfeldgemeinde seit 1973 ein Ortsteil von Duderstadt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "15a3a1d0-2896-3075-b2da-85128aa143f0",
                                        "entry_id": "58f555b5-dc5c-301b-84d3-49abd7033ffa",
                                        "glosses": [
                                            "anschließend, gleich danach eintretend"
                                        ],
                                        "tags": [
                                            "temporal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf3fa544-5e37-44e6-8f72-20bea31dae35",
                                                "sense_id": "15a3a1d0-2896-3075-b2da-85128aa143f0",
                                                "text": "Unmittelbar nach seinem letzten Wort stolperte er, sodass er zu Boden fiel."
                                            },
                                            {
                                                "example_id": "79e3d4af-d1e5-4051-9915-acfa009d01b8",
                                                "sense_id": "15a3a1d0-2896-3075-b2da-85128aa143f0",
                                                "text": "„Die unmittelbarste und sichtbarste Folge der Abdankungsankündigung des Königs waren Demonstrationen für die Republik in Madrid, Barcelona und einigen wichtigen Provinzstädten.“"
                                            },
                                            {
                                                "example_id": "32829f3c-44dc-4194-b370-d4b9021f0053",
                                                "sense_id": "15a3a1d0-2896-3075-b2da-85128aa143f0",
                                                "text": "„Unmittelbar unter seinen Nachfolgern jedoch setzte der Zerfall des Mauryareiches ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "89f4ff03-9e84-3d8d-a31d-9d69f0e1337a",
                                        "entry_id": "58f555b5-dc5c-301b-84d3-49abd7033ffa",
                                        "glosses": [
                                            "sehr nahe"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8698fdc-f7e1-4844-93f7-717a5110e552",
                                                "sense_id": "89f4ff03-9e84-3d8d-a31d-9d69f0e1337a",
                                                "text": "Wir haben hier unmittelbaren Kontakt zur Bevölkerung."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72f0a463-f720-4d64-9a66-fc0e7feb480f",
