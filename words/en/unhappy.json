{
    "word_family": [
        "happy",
        "happiness",
        "unhappiness",
        "happily",
        "unhappily"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e54d1644-b449-3db5-b67a-143c12133c4b",
                    "sense_definition": "Not happy; feeling sadness or sorrow.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt very <w>unhappy</w> when her best friend moved away.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала себя очень <w>несчастной</w>, когда её лучшая подруга переехала.",
                                "zh": "当她最好的朋友搬走时，她感到非常<w>难过</w>。"
                            }
                        },
                        {
                            "text": "He had an <w>unhappy</w> childhood filled with many difficulties.",
                            "target_lang_translations": {
                                "ru": "У него было <w>несчастливое</w> детство, полное множества трудностей.",
                                "zh": "他有一个充满困难的<w>不快乐</w>的童年。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sad",
                        "miserable",
                        "depressed",
                        "gloomy",
                        "sorrowful",
                        "dejected",
                        "downcast",
                        "upset"
                    ],
                    "antonyms": [
                        "happy",
                        "glad",
                        "joyful",
                        "delighted",
                        "joyous"
                    ],
                    "common_phrases": [
                        "feel unhappy",
                        "unhappy childhood",
                        "unhappy marriage",
                        "look unhappy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не счастливый; испытывающий грусть или печаль.",
                        "zh": "不快乐；感到悲伤或忧愁。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "несчастный",
                                "target_lang_sense_clarification": "испытывающий горе или страдание"
                            },
                            {
                                "target_lang_word": "грустный",
                                "target_lang_sense_clarification": "испытывающий легкую печаль"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不快乐",
                                "target_lang_sense_clarification": "指心情不愉快"
                            },
                            {
                                "target_lang_word": "难过",
                                "target_lang_sense_clarification": "指感到悲伤或痛苦"
                            },
                            {
                                "target_lang_word": "不开心",
                                "target_lang_sense_clarification": "指情绪低落"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67e0019e-ee67-30b7-8567-4d2a4b8849d6",
                    "sense_definition": "Not satisfied or pleased with a situation or service.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "satisfaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>unhappy</w> customer demanded a refund for the broken product.",
                            "target_lang_translations": {
                                "ru": "<w>Недовольный</w> клиент потребовал возврата денег за сломанный товар.",
                                "zh": "那位<w>不满</w>的顾客要求为损坏的产品退款。"
                            }
                        },
                        {
                            "text": "I am <w>unhappy</w> with the way the company handled my complaint.",
                            "target_lang_translations": {
                                "ru": "Я <w>недоволен</w> тем, как компания обошлась с моей жалобой.",
                                "zh": "我对公司处理我投诉的方式感到<w>不满意</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dissatisfied",
                        "disgruntled",
                        "displeased",
                        "disappointed",
                        "frustrated"
                    ],
                    "antonyms": [
                        "happy",
                        "glad"
                    ],
                    "common_phrases": [
                        "unhappy with",
                        "unhappy about",
                        "unhappy customer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не удовлетворенный или не довольный ситуацией или услугой.",
                        "zh": "对某种情况或服务不满意。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "недовольный",
                                "target_lang_sense_clarification": "выражающий претензии или неудовлетворение"
                            },
                            {
                                "target_lang_word": "неудовлетворённый",
                                "target_lang_sense_clarification": "не получивший желаемого"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不满",
                                "target_lang_sense_clarification": "对现状不满意"
                            },
                            {
                                "target_lang_word": "不满意",
                                "target_lang_sense_clarification": "对某事感到不悦"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92eed8fa-4462-3995-86dd-34bb63f9f5c9",
                    "sense_definition": "Not lucky; marked by misfortune.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "luck",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "By an <w>unhappy</w> coincidence, they both arrived at the exact same awkward moment.",
                            "target_lang_translations": {
                                "ru": "По <w>несчастливому</w> стечению обстоятельств, они оба прибыли в один и тот же неловкий момент.",
                                "zh": "由于一个<w>不幸</w>的巧合，他们都在同一个尴尬的时刻到达了。"
                            }
                        },
                        {
                            "text": "The project failed due to a series of <w>unhappy</w> events beyond our control.",
                            "target_lang_translations": {
                                "ru": "Проект провалился из-за череды <w>неудачных</w> событий, неподвластных нам.",
                                "zh": "由于一系列我们无法控制的<w>不幸</w>事件，项目失败了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unlucky",
                        "unfortunate",
                        "ill-fated",
                        "hapless",
                        "luckless"
                    ],
                    "antonyms": [
                        "happy"
                    ],
                    "common_phrases": [
                        "unhappy coincidence",
                        "unhappy fate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неудачливый; отмеченный несчастьем или невезением.",
                        "zh": "不走运的；遭遇不幸的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "несчастливый",
                                "target_lang_sense_clarification": "приносящий несчастье или неудачу"
                            },
                            {
                                "target_lang_word": "неудачный",
                                "target_lang_sense_clarification": "сопровождающийся неудачей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不幸的",
                                "target_lang_sense_clarification": "指遭遇灾祸或运气不好"
                            },
                            {
                                "target_lang_word": "倒霉的",
                                "target_lang_sense_clarification": "指运气极差"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da4ab044-3f3a-3273-b907-ad4d5cb4fab6",
                    "sense_definition": "Not suitable or appropriate for a specific occasion.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "suitability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was an <w>unhappy</w> choice of words that offended almost everyone in the room.",
                            "target_lang_translations": {
                                "ru": "Это был <w>неудачный</w> выбор слов, который обидел почти всех в комнате.",
                                "zh": "这是一个<w>不恰当</w>的措辞，冒犯了房间里的几乎所有人。"
                            }
                        },
                        {
                            "text": "The decor was an <w>unhappy</w> mix of conflicting styles and colors.",
                            "target_lang_translations": {
                                "ru": "Декор представлял собой <w>неудачное</w> сочетание противоречивых стилей и цветов.",
                                "zh": "这种装饰是风格和颜色相互冲突的<w>不协调</w>组合。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inappropriate",
                        "unsuitable",
                        "unfit",
                        "inapt"
                    ],
                    "antonyms": [
                        "happy"
                    ],
                    "common_phrases": [
                        "unhappy choice",
                        "unhappy compromise"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не подходящий или не уместный для конкретного случая.",
                        "zh": "不适合或不恰当的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неудачный",
                                "target_lang_sense_clarification": "плохо подобранный"
                            },
                            {
                                "target_lang_word": "неподходящий",
                                "target_lang_sense_clarification": "не соответствующий ситуации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不恰当的",
                                "target_lang_sense_clarification": "指不合时宜或不合适"
                            },
                            {
                                "target_lang_word": "不合适的",
                                "target_lang_sense_clarification": "指不符合要求"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "36dc1c18-55bf-3c01-b0d6-d8537afd655d",
                    "sense_definition": "A person who is not happy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He did not want to join the group of <w>unhappies</w> complaining in the corner.",
                            "target_lang_translations": {
                                "ru": "Он не хотел присоединяться к группе <w>несчастных</w>, жалующихся в углу.",
                                "zh": "他不想加入角落里那群抱怨的<w>不幸的人</w>。"
                            }
                        },
                        {
                            "text": "The author describes the lives of various <w>unhappies</w> searching for meaning.",
                            "target_lang_translations": {
                                "ru": "Автор описывает жизни различных <w>несчастных</w> в поисках смысла.",
                                "zh": "作者描述了各种寻找人生意义的<w>不幸的人</w>的生活。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который не счастлив.",
                        "zh": "不快乐的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "несчастный",
                                "target_lang_sense_clarification": "субстантивированное прилагательное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不幸的人",
                                "target_lang_sense_clarification": "指处于悲伤或困境中的人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1fd70544-d3db-339f-9a60-0cf5178bcbc4",
                    "sense_definition": "To make someone unhappy or sad.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tragic news <w>unhappied</w> the entire household for weeks.",
                            "target_lang_translations": {
                                "ru": "Трагическая новость <w>опечалила</w> весь дом на несколько недель.",
                                "zh": "这则悲剧新闻让全家人<w>难过</w>了好几个星期。"
                            }
                        },
                        {
                            "text": "Do not let these dark thoughts <w>unhappy</w> your mind.",
                            "target_lang_translations": {
                                "ru": "Не позволяй этим мрачным мыслям <w>расстраивать</w> твой разум.",
                                "zh": "不要让这些阴暗的想法<w>扰乱</w>你的心智。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sadden",
                        "depress",
                        "grieve",
                        "deject"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать кого-то несчастным или грустным.",
                        "zh": "使某人感到不快乐或悲伤。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опечалить",
                                "target_lang_sense_clarification": "вызвать печаль"
                            },
                            {
                                "target_lang_word": "расстроить",
                                "target_lang_sense_clarification": "испортить настроение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使……悲伤",
                                "target_lang_sense_clarification": "导致他人情绪低落"
                            },
                            {
                                "target_lang_word": "使……难过",
                                "target_lang_sense_clarification": "让某人感到痛苦"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}