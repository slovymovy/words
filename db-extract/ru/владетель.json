                                "target_senses": [
                                    {
                                        "sense_id": "9830fe38-51fa-33e3-a838-3d7a4c17cfa3",
                                        "entry_id": "beb6b1dc-b4a4-33ad-ab0e-03e490ad1c48",
                                        "glosses": [
                                            "A (usually rigid), flat, rectangular measuring or drawing device with graduations in units of measurement; a straightedge with markings."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f71e138c-83be-3a46-b6b3-79f053352c3b",
                                        "entry_id": "beb6b1dc-b4a4-33ad-ab0e-03e490ad1c48",
                                        "glosses": [
                                            "A person who rules or governs; someone or something that exercises dominion or controlling power over others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88701457-d984-4082-9a19-f881366d5b7f",
                                                "sense_id": "f71e138c-83be-3a46-b6b3-79f053352c3b",
                                                "text": "The carcharhinids are unquestionably the rulers of the seas, because of their abundance, their strength and speed, and their unchallenged position as the number one predators in the marine ecosystem."
                                            },
                                            {
                                                "example_id": "3a41b167-e6cb-4f4d-bc46-dd5746c6e3a1",
                                                "sense_id": "f71e138c-83be-3a46-b6b3-79f053352c3b",
                                                "text": "LIKE THE MANDARINS of old, the rulers of China live behind high walls. When they emerge, which they rarely do, they travel in cars with rear windows curtained like sedan chairs.\nThey live in the Chung Nan Hai, a walled park adjacent to the Forbidden City from where ancient dynasties ruled the Celestial Empire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ruler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca777100-4eb8-3fdd-a176-aa3a975047a3",
                                        "entry_id": "8c54f52b-5cb1-34db-b62d-ff0a57e7e115",
                                        "glosses": [
                                            "To beat with a ruler (as a traditional school punishment)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "12fb48a3-f23b-45de-b8d5-89ff84e45050",
                        "source_entry_id": "f016703d-f193-368d-a4d9-5adc52b47893",
                        "source_sense_description": "правитель",
                        "target_lang_word": "souverain",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "souverain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7076cf0d-1b0e-3548-a32f-8bdb7918fb43",
                                        "entry_id": "a471587f-46f6-3f97-903a-be189aabe693",
                                        "glosses": [
                                            "Qui est suprême ; excellent ; qui est au plus haut point en son genre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1262fb5-a5c4-43ed-bea0-fc153bbf021b",
                                                "sense_id": "7076cf0d-1b0e-3548-a32f-8bdb7918fb43",
                                                "text": "Si je pensais que le souverain bien fût la joie, je ne douterais point qu'on ne dût tâcher de se rendre joyeux, à quelque prix que ce pût être, et j'approuverais la brutalité de ceux qui noient leurs déplaisirs dans le vin, ou les étourdissent avec du pétun."
                                            },
                                            {
                                                "example_id": "1e4e118a-3b37-415b-b4b8-0e9fbf5b5030",
                                                "sense_id": "7076cf0d-1b0e-3548-a32f-8bdb7918fb43",
                                                "text": "Mme Sidonie, malgré ses travaux écrasants, trouva moyen de venir chaque soir faire des tisanes, qu’elle prétendait souveraines."
                                            },
                                            {
                                                "example_id": "bd967176-0a16-4e1b-bafd-6b125d0d436f",
                                                "sense_id": "7076cf0d-1b0e-3548-a32f-8bdb7918fb43",
                                                "text": "Eh bien, continua Coconnas gravement, ce grand homme ne me paraît pas s’être abusé quand […] il regarde la vertu comme une plante balsamique d’un impérissable parfum et d’une efficacité souveraine pour la guérison des blessures."
                                            },
                                            {
                                                "example_id": "27c45e6d-b9ad-4b1d-b7e0-baef19eae893",
                                                "sense_id": "7076cf0d-1b0e-3548-a32f-8bdb7918fb43",
                                                "text": "Ce fut M. de Chalvet-Rochemonteix qui apprit aux paysans à se prémunir contre les ravages de la carie dans les grains par le sulfatage de la semence, dont les résultats furent souverains. Le mal cessa avec l’application de ce remède."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b4295eb-7e27-35fe-b5c7-34709e253f07",
                                        "entry_id": "a471587f-46f6-3f97-903a-be189aabe693",
                                        "glosses": [
                                            "En parlant d’un remède, dont l’efficacité est totale."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d22e24c-ab59-4358-b8fe-059001630689",
                                                "sense_id": "2b4295eb-7e27-35fe-b5c7-34709e253f07",
                                                "text": "Surtout n’oubliez pas de tenir votre mouchoir devant la bouche. On m’a affirmé que ce remède est souverain contre le brouillard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2deb8076-c250-329a-a1b8-248ab75169e5",
                                        "entry_id": "a471587f-46f6-3f97-903a-be189aabe693",
                                        "glosses": [
                                            "Qui détient l’autorité suprême, ou qui en est revêtu."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfb195ba-821b-4343-8e55-70de74fb6598",
                                                "sense_id": "2deb8076-c250-329a-a1b8-248ab75169e5",
                                                "text": "Il est de notre devoir de choisir dans le sang royal le prince le plus capable de maintenir la puissance souveraine, c’est-à-dire, se reprit-il, celui dont l’élection pourra le plus efficacement servir les intérêts de la noblesse."
                                            },
                                            {
                                                "example_id": "09d1d673-0390-435e-b765-32de78d2e198",
                                                "sense_id": "2deb8076-c250-329a-a1b8-248ab75169e5",
                                                "text": "Allez donc gouverner les hommes, si l’on vous ôte des mains l’argent, le bâton souverain ?"
                                            },
                                            {
                                                "example_id": "4eb93ee6-aed8-40ff-9ad3-26bde89ee226",
                                                "sense_id": "2deb8076-c250-329a-a1b8-248ab75169e5",
                                                "text": "[…] ; la mendicité est soumise, en Belgique, à un arbitraire administratif que l’on peut comparer à celui de la police des mœurs; on sait que cette police, malgré d’innombrables réclamations, continue à être presque souveraine en France."
                                            },
                                            {
                                                "example_id": "26b85605-d475-4b31-b55d-6cb30df3c8a4",
                                                "sense_id": "2deb8076-c250-329a-a1b8-248ab75169e5",
                                                "text": "C’est seulement si le peuple, en qui repose tout pouvoir souverain, délègue une partie de sa souveraineté à des institutions crées spécialement pour résoudre des problèmes spécifiques, que nous pouvons dire que nous avons un gouvernement de forme démocratique."
                                            },
                                            {
                                                "example_id": "327717a2-fc14-4763-9d56-8e4e38390142",
                                                "sense_id": "2deb8076-c250-329a-a1b8-248ab75169e5",
                                                "text": "La question de savoir si une infraction a été commise dans une intention frauduleuse ou à dessein de nuire gît donc en fait et est dès lors laissée à l’appréciation souveraine du juge du fond."
                                            },
                                            {
                                                "example_id": "69b9a989-b4dc-44c7-9a28-9843c65dff27",
                                                "sense_id": "2deb8076-c250-329a-a1b8-248ab75169e5",
                                                "text": "En déployant son armée dans un État souverain pour l’assujettir, le président russe, Vladimir Poutine, a fait éclater l’ordre sécuritaire qui prévalait en Europe depuis la fin de la guerre froide. Personne ne sait ce qui le remplacera."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8314b129-be7a-3a9b-87a4-e54362879395",
                                        "entry_id": "a471587f-46f6-3f97-903a-be189aabe693",
                                        "glosses": [
                                            "Qui appartient à l’État ou qui est dû par l'État."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "souverain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ebca0e9-029e-314b-bd84-37a835083143",
                                        "entry_id": "9171009f-862e-3e83-b145-6378935b9c88",
                                        "glosses": [
                                            "Personne qui possède, en qui réside l’autorité souveraine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "424e6cdb-fcac-4611-95bb-1cdbe2ad6255",
                                                "sense_id": "9ebca0e9-029e-314b-bd84-37a835083143",
                                                "text": "Dans les démocraties, le peuple est le souverain."
                                            },
                                            {
                                                "example_id": "54a0a231-08f1-49e2-81b1-bd2369ef9f5e",
                                                "sense_id": "9ebca0e9-029e-314b-bd84-37a835083143",
                                                "text": "La classe des propriétaires comprend le souverain, les possesseurs des terres et les décimateurs. Cette classe subsiste par le revenu ou produit net de la culture, qui lui est payé annuellement par la classe productive."
                                            },
                                            {
                                                "example_id": "65aefa63-bbaf-4684-af58-dfb3eca04d49",
                                                "sense_id": "9ebca0e9-029e-314b-bd84-37a835083143",
                                                "text": "Mais Mirabeau était réellement l’âme de la Constituante. À la révolution il consacrait sa vie, et la puissance de ses arguments ; le souffle qui animait ses discours faisant de ce tribun le véritable souverain de la Chambre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f82a101f-7302-39ea-8686-a1954d37ce0f",
                                        "entry_id": "9171009f-862e-3e83-b145-6378935b9c88",
                                        "glosses": [
                                            "Personne qui possède, en qui réside l’autorité souveraine.",
                                            "Le peuple."
                                        ],
                                        "tags": [
                                            "Suisse"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00481176-df4a-4291-bb12-5c668a22a2e7",
                                                "sense_id": "f82a101f-7302-39ea-8686-a1954d37ce0f",
                                                "text": "Un référendum rejeté par le souverain qui avait accepté le projet par 55,8% des votants le 22 septembre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "064a2b53-d3a3-37e7-817c-07dfbe803914",
                                        "entry_id": "9171009f-862e-3e83-b145-6378935b9c88",
                                        "glosses": [
                                            "Prince souverain, monarque."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f83c4ba-32a0-4387-893d-03e24e01c347",
                                                "sense_id": "064a2b53-d3a3-37e7-817c-07dfbe803914",
                                                "text": "Tous les souverains de la race normande avaient témoigné la partialité la plus marquée pour leurs sujets normands ; les lois […] avaient été fixées comme un joug sur le cou des habitants subjugués, surcroît féodal, des chaînes dont ils étaient chargés."
                                            },
                                            {
                                                "example_id": "64760e83-1f2d-4ca1-8100-386b995121a1",
                                                "sense_id": "064a2b53-d3a3-37e7-817c-07dfbe803914",
                                                "text": "Les personnes vraiment pieuses doivent se faire un devoir de prier pour l’Église et d’honorer leur évêque ; elles doivent aussi prier pour l’avantage spirituel et temporel de l’État, et honorer leur Souverain."
                                            },
                                            {
                                                "example_id": "de1983ad-7cdf-4085-96f3-1a73c3240b70",
                                                "sense_id": "064a2b53-d3a3-37e7-817c-07dfbe803914",
                                                "text": "Fais le donc approcher, répondit le Roi... le bédouin en question pénétra dans le tref royal, saluant respectueusement le souverain franc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c7db109-2029-369c-a2b1-a3a4695a52b5",
                                        "entry_id": "9171009f-862e-3e83-b145-6378935b9c88",
                                        "glosses": [
                                            "Monnaie d’or du Royaume-Uni qui valait 1 livre sterling, soit 20 shillings (20 s), qui circula jusqu’en 1914."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5769efe6-a0cd-4240-810a-bcc29185ea4c",
                                                "sense_id": "6c7db109-2029-369c-a2b1-a3a4695a52b5",
                                                "text": "Elle remarqua que l’homme mettait un souverain en paiement dans la main de son père."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f70d6e24-516d-3c30-b587-57822b572c7a",
                                        "entry_id": "9171009f-862e-3e83-b145-6378935b9c88",
                                        "glosses": [
                                            "Grosse bouteille de vin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3002b7c7-7967-4419-8b67-0b1b7b8d9bdd",
                        "source_entry_id": "f016703d-f193-368d-a4d9-5adc52b47893",
