                "senses": [
                    {
                        "sense_id": "0d762398-8197-31c5-a427-ea28330a8c69",
                        "entry_id": "4bafd88a-6070-3c33-b732-ff29f3584ca3",
                        "glosses": [
                            "Eingang in ein Gebäude"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94278ce4-d3b8-4414-ae5a-77a6ab8937a1",
                                "sense_id": "0d762398-8197-31c5-a427-ea28330a8c69",
                                "text": "„Er ging weiter und kehrte ein im Gasthaus »Zum Vogel Strauß«, wo die ausgestopfte Gebirgsgemse und der balzende Auerhahn standen, rechts und links von Entrée.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a0eb9c0a-83ef-3e99-8a95-fcfe4bb5e04b",
                        "entry_id": "4bafd88a-6070-3c33-b732-ff29f3584ca3",
                        "glosses": [
                            "Vorspeise beziehungsweise Zwischengericht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4621b35-ce58-4cd6-af6d-b61f0e8dafd6",
                                "sense_id": "a0eb9c0a-83ef-3e99-8a95-fcfe4bb5e04b",
                                "text": "Das Entrée war hervorragend auf das Menü abgestimmt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "c97079c3-8955-3e86-873d-5ca9955a1165",
                        "entry_id": "4bafd88a-6070-3c33-b732-ff29f3584ca3",
                        "glosses": [
                            "Vorspiel zu einem Musikstück"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "c2ace697-877d-4847-99f7-882c898831b1",
                                "sense_id": "c97079c3-8955-3e86-873d-5ca9955a1165",
                                "text": "Die Pause zwischen dem Entrée und dem eigentlichen Stück kam uns etwas zu lang vor."
                            }
                        ],
                        "sense_index_json": "\"3\""
