                "senses": [
                    {
                        "sense_id": "2d56d489-0c5c-3d5a-871c-715ba5c9f94c",
                        "entry_id": "de6f72a4-008c-37fe-b2bb-4998bc519bea",
                        "glosses": [
                            "anerkannte männliche Person, die auf dem Fachgebiet der Lüftung sehr bewandert ist und seine Expertenmeinung abgibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba87a144-f86c-419c-9493-24e87fbed329",
                                "sense_id": "2d56d489-0c5c-3d5a-871c-715ba5c9f94c",
                                "text": "„Für Wohnräume empfiehlt inVENTer-Geschäftsführer und Lüftungsexperte Peter Moser dezentrale Lüftungsanlagen.“"
                            },
                            {
                                "example_id": "8fb73d49-9d12-4110-88f3-d1d5e4609c08",
                                "sense_id": "2d56d489-0c5c-3d5a-871c-715ba5c9f94c",
                                "text": "„Dennis Reichardt (links) und Roger Wenk (rechts) von der Otto Keller AG sowie Leiter GrossprojekteAndré Leder (2. v. l.) und Lüftungsexperte Matijas Marusic beide von Tobler.“"
                            },
                            {
                                "example_id": "6ba33dc6-0cb8-41b9-862c-bc12f4569ced",
                                "sense_id": "2d56d489-0c5c-3d5a-871c-715ba5c9f94c",
                                "text": "„2011 organisierten die Lüftungsexperten vier öffentliche Seminare in Würzburg, Ladenburg, Kassel und Hamburg sowie ein Inhouse-Seminar bei einem Mitgliedsunternehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4681dbeb-add1-38d6-ae5a-9eb435d6236e",
                        "entry_id": "de6f72a4-008c-37fe-b2bb-4998bc519bea",
