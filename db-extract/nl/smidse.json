                        "cross_references": []
                    },
                    {
                        "translation_id": "e0e41af9-52f0-4bbc-991c-fd967a4d1e34",
                        "source_entry_id": "ffc6bea5-ae5a-3ead-b847-a411c68fe2ab",
                        "source_sense_id": "8290e018-5e01-3641-98b6-16b2c0ca0adb",
                        "source_sense_description": "werkplaats van een smid",
                        "target_lang_word": "smithy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "smithy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d79b8b3-ad19-31ce-8100-41b7d9af7f25",
                                        "entry_id": "e4c784cc-1854-3a1c-9c69-6223fecb58e7",
                                        "glosses": [
                                            "The location where a smith (particularly a blacksmith) works, a forge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cae0cedf-f279-4bdf-a844-410f8119e344",
                                                "sense_id": "8d79b8b3-ad19-31ce-8100-41b7d9af7f25",
                                                "text": "Traditionally a village smithy was a busy place because the smith's work was so necessary."
                                            },
                                            {
                                                "example_id": "40a5cc34-40fb-41b8-8fb6-08d531895d33",
                                                "sense_id": "8d79b8b3-ad19-31ce-8100-41b7d9af7f25",
                                                "text": "The workshop with its smithy is still intact, also the loading stage where the narrow-gauge wagons tipped their contents into those of the G.W.R."
                                            },
                                            {
                                                "example_id": "bfd56608-2b44-4664-99fc-f14d3d46d90c",
                                                "sense_id": "8d79b8b3-ad19-31ce-8100-41b7d9af7f25",
                                                "text": "Close to the hump-backed bridge on the lane leading into the Hambleden Valley is a mid-19th-century smithy, its inside walls hung with tools of the blacksmith's trade, though decorative wrought-ironwork is now the main product from its glowing forge."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "smithy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54b3bbb8-381d-37a4-9bc8-3ca255c9b438",
                                        "entry_id": "a54f60d5-3f9e-3b18-978a-3f1d8831af3a",
                                        "glosses": [
                                            "To forge (metal), especially by traditional blacksmith methods."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5af70c84-47b0-445b-aa1b-94c6083522d1",
                                                "sense_id": "54b3bbb8-381d-37a4-9bc8-3ca255c9b438",
                                                "text": "\"That's funny looking mail, Sire,\" said Eustace.\n\"Aye, lad,\" said Tirian. \"No Narnian dwarf smithied that. […]"
                                            },
                                            {
                                                "example_id": "39e3bede-bb92-4f00-b1d0-141bfa7f99d7",
                                                "sense_id": "54b3bbb8-381d-37a4-9bc8-3ca255c9b438",
                                                "text": "So the old smith went out to his smithy and weighed out iron enough to make a stout staff a stone weight, and he smithied it well while his son looked on. […] So they weighed six stone of iron and smithied a great bent club like a shinny, and when that was made and cooled the smith's son said, \"that will do.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a68ce27-69a3-4f32-b0a8-c30f0e2120e2",
                        "source_entry_id": "ffc6bea5-ae5a-3ead-b847-a411c68fe2ab",
                        "source_sense_id": "8290e018-5e01-3641-98b6-16b2c0ca0adb",
                        "source_sense_description": "werkplaats van een smid",
                        "target_lang_word": "forge",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "forge",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "408578a9-d87d-3176-880a-93664b947f06",
                                        "entry_id": "7b01d8cf-e195-3f73-8912-9c1aec095f57",
                                        "glosses": [
                                            "Usine dans laquelle la fonte de fer est transformée en métal."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a083265e-fe9a-4acb-9359-cec602de3fb8",
                                                "sense_id": "408578a9-d87d-3176-880a-93664b947f06",
                                                "text": "Seul témoin de cette époque révolue où la forge de Vendresse sortait 3 tonnes de fonte par jour, rugissant jour et nuit, où la sidérurgie ardennaise battait son plein, son haut-fourneau est d'ailleurs un lieu incontournable."
                                            },
                                            {
                                                "example_id": "4c49adb8-2a87-4c80-82ea-01cee435a94b",
                                                "sense_id": "408578a9-d87d-3176-880a-93664b947f06",
                                                "text": "Toute forge qui ne produirait pas trois cents milliers de fer par an, ne vaudrait pas la peine d’être établie ni maintenue."
                                            },
                                            {
                                                "example_id": "ca63324a-0cee-42fd-ba85-22012e4ad7b5",
                                                "sense_id": "408578a9-d87d-3176-880a-93664b947f06",
                                                "text": "Les intérêts particuliers se réunirent pour représenter que les cent neuf forges qui travaillaient en Angleterre, sans y comprendre celles d’Écosse, produisaient annuellement dix-huit mille tonnes de fer, et occupaient un grand nombre d’ouvriers habiles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f20991c-3ed1-308b-9dd0-c048bb843bd3",
                                        "entry_id": "7b01d8cf-e195-3f73-8912-9c1aec095f57",
                                        "glosses": [
                                            "Haut-fourneau où le minerai est réduit en fonte."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f18a8810-f9e3-3817-806a-552d3ac03eca",
                                        "entry_id": "7b01d8cf-e195-3f73-8912-9c1aec095f57",
                                        "glosses": [
                                            "Fourneau, atelier où les métaux se travaillent au feu et au marteau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b83fe58a-ea51-41c8-8f17-201fa563af45",
                                                "sense_id": "f18a8810-f9e3-3817-806a-552d3ac03eca",
                                                "text": "De grosses mains faites pour souffler la forge."
                                            },
                                            {
                                                "example_id": "ccbbeb1b-b4b8-43c5-ad8a-0b34c06ad02a",
                                                "sense_id": "f18a8810-f9e3-3817-806a-552d3ac03eca",
                                                "text": "Lorsqu'ils [les journalistes] s’imposent la loi de ne parler que des ouvrages encore tout chauds de la forge."
                                            },
                                            {
                                                "example_id": "73a35af8-cb1a-4a19-a2e7-451df0f6dd2e",
                                                "sense_id": "f18a8810-f9e3-3817-806a-552d3ac03eca",
                                                "text": "Au-delà des bornes de la lice, plus d’une forge fut élevée, et ces forges commencèrent bientôt à luire à travers le crépuscule, annonçant le travail des armuriers, qui continuèrent pendant toute la nuit à réparer."
                                            },
                                            {
                                                "example_id": "38759cc3-33af-4146-8768-f0645a905865",
                                                "sense_id": "f18a8810-f9e3-3817-806a-552d3ac03eca",
                                                "text": "Cette forge était comme ensevelie sous des arbres. Il y faisait très sombre ; seule, la lueur rouge d’un foyer formidable éclairait par grands reflets cinq forgerons aux bras nus qui frappaient sur leurs enclumes avec un terrible fracas. Ils se tenaient debout, enflammés comme des démons, les yeux fixés sur le fer ardent qu’ils torturaient ; et leur lourde pensée montait et retombait avec leurs marteaux."
                                            },
                                            {
                                                "example_id": "a4c89c59-0247-4d25-b643-b1ef4ed86733",
                                                "sense_id": "f18a8810-f9e3-3817-806a-552d3ac03eca",
                                                "text": "Parfois, une dame, qui se dit folle de tes poèmes, veut les entendre de ta bouche et tu vois sa gorge se lever et s’abaisser avec une telle rapidité qu’il y aurait de quoi entretenir un feu de forge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e55ed8bd-1a2c-3b04-bb0f-723823f60ee4",
                                        "entry_id": "7b01d8cf-e195-3f73-8912-9c1aec095f57",
                                        "glosses": [
                                            "Métier ou industrie de la transformation des métaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44aa69bc-2322-453a-9887-f063cdd4e7b3",
                                                "sense_id": "e55ed8bd-1a2c-3b04-bb0f-723823f60ee4",
                                                "text": "Dans cette France de la IIIᵉ République, l’avenir de l'économie s'écrit en grande partie dans les Ardennes. Les start-up de l’époque se dénichent dans la sidérurgie ou la forge. Les entrepreneurs les plus en vue se nomment Deville ou Wendel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4987ce98-f864-382b-abf0-8f78d137887c",
                                        "entry_id": "7b01d8cf-e195-3f73-8912-9c1aec095f57",
                                        "glosses": [
                                            "Atelier d’un maréchal-ferrant."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6799e1d-8afc-48ea-a0e9-a92141baf9a6",
                                                "sense_id": "4987ce98-f864-382b-abf0-8f78d137887c",
                                                "text": "On attaquerait la roche à la masse afin d'épargner les burins, car il n'y avait pas de forge pour les recharger."
                                            },
                                            {
                                                "example_id": "3ecf03a5-2aa1-49a3-92d4-3d5cc98c0cde",
                                                "sense_id": "4987ce98-f864-382b-abf0-8f78d137887c",
                                                "text": "Mener un cheval à la forge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93ca3aa0-c1dc-3453-bd57-682fe60d5a36",
                                        "entry_id": "7b01d8cf-e195-3f73-8912-9c1aec095f57",
                                        "glosses": [
                                            "Pierre de liais sur laquelle on bat le plomb à froid."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
