                "senses": [
                    {
                        "sense_id": "cbf9546a-57d9-35d7-9d1b-2fc152245017",
                        "entry_id": "1e102e12-924f-3e0b-9124-69d056777c2d",
                        "glosses": [
                            "de lijn waar gevochten wordt in een militair conflict"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ce5cd3d-cf69-45a3-9919-e4f74788874f",
                                "sense_id": "cbf9546a-57d9-35d7-9d1b-2fc152245017",
                                "text": "In het vredesakkoord is onder meer afgesproken dat de zwaarste wapens tot 70 kilometer van de gevechtslinie moeten worden teruggetrokken. Voor lichtere wapens geldt een afstand van minimaal 25 kilometer."
                            },
                            {
                                "example_id": "b5e702f1-fa19-4490-ac0f-140394feb517",
                                "sense_id": "cbf9546a-57d9-35d7-9d1b-2fc152245017",
                                "text": "Bij een luchtaanval van de NAVO in de buurt van de Oost-Libische stad Brega zijn meerdere opstandelingen gedood. Schattingen over het aantal doden lopen uiteen van vijf tot dertien. De opstandelingen waren met tanks onderweg naar de gevechtslinie tussen Ajdabiya en Brega."
                            },
                            {
                                "example_id": "9d32e996-dfb0-4a20-b5c4-a6de0833d9ed",
                                "sense_id": "cbf9546a-57d9-35d7-9d1b-2fc152245017",
                                "text": "Zo verplaatst de gevechtslinie zich steeds verder naar het oosten, in de richting van Benghazi, een van de steden waar de opstand tegen Kadhafi bijna een maand geleden begon. Intussen wordt de roep om een vliegverbod steeds sterker. De Arabische Liga sprak gisteren steun uit voor het instellen van een vliegverbod boven Libië en heeft de VN-Veiligheidsraad gevraagd om zo'n verbod af te kondigen."
                            }
                        ]
                    }
