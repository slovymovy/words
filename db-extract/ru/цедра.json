                                        "examples": []
                                    },
                                    {
                                        "sense_id": "160a8306-250f-3ef2-a48d-89d4f127abab",
                                        "entry_id": "b398a715-cc6e-35a3-abaa-9388cd2a946c",
                                        "glosses": [
                                            "To make more zesty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5edf6f7c-3da0-440c-b6c7-f5354e29c93e",
                                                "sense_id": "160a8306-250f-3ef2-a48d-89d4f127abab",
                                                "text": "Strains ſo artleſs tho’ we proffer,\nHearts o’er flowing zest the offer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
