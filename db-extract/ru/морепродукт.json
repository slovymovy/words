                "senses": [
                    {
                        "sense_id": "13bf2661-875c-3c97-bec5-7d894e4369d0",
                        "entry_id": "09ca1143-0cf7-3bba-95d4-f73c336ea31f",
                        "glosses": [
                            "гастрон. продукт морского промысла (обычно исключая рыбу)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d47daaef-d351-4237-8c23-c4d12ff57e99",
                                "sense_id": "13bf2661-875c-3c97-bec5-7d894e4369d0",
                                "text": "В 1963 году мировой вылов рыбы и других пищевых морепродуктов превысил 45 миллионов тонн."
                            },
                            {
                                "example_id": "7b2df10e-740e-416e-882e-a6e0028aad0d",
                                "sense_id": "13bf2661-875c-3c97-bec5-7d894e4369d0",
                                "text": "В еде я неприхотлива. Люблю морепродукты, рыбу, салаты."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "083246a6-1d4d-4d56-9a04-ac7888cf6dd1",
                        "source_entry_id": "09ca1143-0cf7-3bba-95d4-f73c336ea31f",
                        "source_sense_id": "13bf2661-875c-3c97-bec5-7d894e4369d0",
                        "target_lang_word": "seafood",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seafood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d29293fa-3a6b-3935-808e-c74e51cfe309",
                                        "entry_id": "eb4ceb22-ec7c-3ca0-be4d-10dbc44459f2",
                                        "glosses": [
                                            "Fish, shellfish, seaweed, and other edible aquatic life."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7537d3c-c9fb-415b-b248-c9cfcc8abef5",
                                                "sense_id": "d29293fa-3a6b-3935-808e-c74e51cfe309",
                                                "text": "But most of all, they were jealous because these strangers feasted daily on great turtle, albacore and sail-fish, the sweetest of all seafoods."
                                            },
                                            {
                                                "example_id": "c4afe004-fab5-4b53-84b5-fa563cdca727",
                                                "sense_id": "d29293fa-3a6b-3935-808e-c74e51cfe309",
                                                "text": "Write about radiation levels in seafood, “safe” pollution limits set by pollutors, government policy auctioned for campaign donations and Seaboard's ex juris police force, and you'll raise the temperature of public awareness, fractionally, towards its ignition point."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9b28c47-032d-403c-8008-1ee8a952727e",
                        "source_entry_id": "09ca1143-0cf7-3bba-95d4-f73c336ea31f",
                        "source_sense_id": "13bf2661-875c-3c97-bec5-7d894e4369d0",
