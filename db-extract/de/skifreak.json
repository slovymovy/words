                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25745054-60cf-48b5-8c3f-1452a4cd3738",
                                                "sense_id": "1ba77f24-21c0-357c-9b79-619de1d0b153",
                                                "text": "But high unemployment in the United States, coupled with policy changes that make it more difficult for seasonal foreign workers to get visas, has brought about the return of the American ski bum."
                                            },
                                            {
                                                "example_id": "85bb8214-a7e7-4750-a5ef-cadd4da4a0c3",
                                                "sense_id": "1ba77f24-21c0-357c-9b79-619de1d0b153",
                                                "text": "Many locals thought doing so contradicted the democratic spirit of skiing, where strangers sharing a lift chair might include both billionaires with second homes in Bend and ski bums living in vans."
                                            }
