                        ],
                        "form": "zerged"
                    },
                    {
                        "form_id": "598c8b5d-46ab-41f8-a643-cbaecc4c85a2",
                        "entry_id": "399e4fd2-93a6-3285-8447-da60c03992ce",
                        "tags": [
                            "past"
                        ],
                        "form": "zerged"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cb92eb89-8bb7-32ce-9ca8-73864556ee2b",
                        "entry_id": "399e4fd2-93a6-3285-8447-da60c03992ce",
                        "glosses": [
                            "To attack an opponent with a large swarm of low-level units before they have been able to build sufficient defences."
                        ],
                        "tags": [
                            "dated",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "79419d8e-e135-4d3d-8875-f9f44f6cdf83",
                                "sense_id": "cb92eb89-8bb7-32ce-9ca8-73864556ee2b",
                                "text": "You can't win with small, balanced groups. You have to zerg the mob with a high number of players. They don't have to zerg lower tier encounters just like the lowest tier guilds doesn't have to zerg orc camp 1 in EC. But, at the top end, it's still zerg tactics."
                            },
                            {
                                "example_id": "9fde8f71-5eab-450d-aba0-e8a8f9fb8d69",
                                "sense_id": "cb92eb89-8bb7-32ce-9ca8-73864556ee2b",
                                "text": "The scale and lack of focused content doesn't facilitate this grouping as well as some other games. The good side of that is you don't get the \"wonderful\" experience of zerging around DF with everyone else waiting for something to spawn."
                            },
                            {
                                "example_id": "7f2b176f-641f-4245-91ea-d05faa0f2368",
                                "sense_id": "cb92eb89-8bb7-32ce-9ca8-73864556ee2b",
                                "text": "No one ever did D (or just 3-4 people tried), we just zerged, and we would lose every single AV."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0502c245-e886-4587-b13f-7bdfbfe7868d",
                        "source_entry_id": "399e4fd2-93a6-3285-8447-da60c03992ce",
                        "source_sense_id": "cb92eb89-8bb7-32ce-9ca8-73864556ee2b",
                        "source_sense_description": "To attack an opponent with a large swarm of units before they have been able to build sufficient defences",
                        "target_lang_word": "zerguer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zerguer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f12cc681-b22e-313e-8076-4ace3ead0cde",
                                        "entry_id": "c40c01d4-7b09-3289-98ff-1649685548b7",
                                        "glosses": [
                                            "Créer un grand nombre d’unités basiques à peu de frais afin de réaliser un rush ou de flooder l’adversaire."
                                        ],
                                        "tags": [
                                            "Jeux vidéo"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55a7485f-f5e4-4257-9320-b6382be3fd43",
                                                "sense_id": "f12cc681-b22e-313e-8076-4ace3ead0cde",
                                                "text": "Les joueurs de Starcraft n’en n’ont pas fini de zerguer leurs petits copains puisqu’après avoir fini il y a peu la première ronde suisse, ces chères petites têtes blondes (un peu encrassées à présent) vont devoir pointer à 9h30 ce matin pour enchaîner le deuxième tour…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5ae62cd-4b1b-3ae7-92c6-0ca8dc2409d0",
                                        "entry_id": "c40c01d4-7b09-3289-98ff-1649685548b7",
                                        "glosses": [
                                            "Jouer en surnombre et déferler en masse."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c6e93ed-f231-4a4b-a3df-5bba2066bd28",
                                                "sense_id": "d5ae62cd-4b1b-3ae7-92c6-0ca8dc2409d0",
                                                "text": "Le grognard que je suis n’a pu s’empêcher de tiquer sur les remarques du \"mur de viande communiste\" qui a \"zergué\" la Wermacht (sic) par une tactique du \"nous avons plus d’homme (sic) que vous n’avez de balles\"."
                                            },
                                            {
                                                "example_id": "4919dbcd-0f4f-435e-a77b-a9d788963242",
                                                "sense_id": "d5ae62cd-4b1b-3ae7-92c6-0ca8dc2409d0",
                                                "text": "Nous avons commencé par fuir le Grand Méchant Loup pour finalement le zerguer méchamment, bye bye Mère-Grand..."
                                            },
                                            {
                                                "example_id": "7110e21b-fa1a-4443-a09d-347734349d7e",
                                                "sense_id": "d5ae62cd-4b1b-3ae7-92c6-0ca8dc2409d0",
                                                "text": "Bien qu’un peu gâché par une grosse guilde qui a zergué tout le week-end, les sièges de fort sont plaisants et techniques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
