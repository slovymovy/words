                {
                    "sense_id": "c24b98cc-aeb4-3f7f-a828-52720bc7be22",
                    "sense_definition": "A shop or business where flowers and plants are sold.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "flower_shops",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the gown, we can go to the <w>florist</w>, then stop by the lingerie store.",
                            "target_lang_translations": {
                                "ru": "После платья мы можем зайти к <w>цветочнику</w>, а затем заглянуть в магазин нижнего белья.",
                                "zh": "买完礼服后，我们可以去<w>花店</w>，然后再顺便去内衣店。"
                            }
                        },
                        {
                            "text": "There is a small <w>florist</w> on the corner that sells fresh roses every morning.",
                            "target_lang_translations": {
                                "ru": "На углу есть небольшая <w>цветочная лавка</w>, где каждое утро продают свежие розы.",
                                "zh": "街角有一家小<w>花店</w>，每天早上都卖新鲜的玫瑰。"
                            }
                        }
