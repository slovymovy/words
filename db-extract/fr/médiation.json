        "fr-extract.jsonl": [
            {
                "entry_id": "9eda564f-3aa4-3378-bc71-aa925f97bf80",
                "word": "médiation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5c4b3ba6-c7f8-4b5a-adaf-bf7ea83b3a83",
                        "entry_id": "9eda564f-3aa4-3378-bc71-aa925f97bf80",
                        "tags": [
                            "plural"
                        ],
                        "form": "médiations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "57433abd-26ec-3d32-bf8b-dd3517c0c1ef",
                        "entry_id": "9eda564f-3aa4-3378-bc71-aa925f97bf80",
                        "glosses": [
                            "Moyen indirect par lequel on fait connaître un message ou une intention."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecc59602-4fc5-46e1-9089-79c9c1869f26",
                                "sense_id": "57433abd-26ec-3d32-bf8b-dd3517c0c1ef",
                                "text": "Mais Dieu se fait connaître à travers des médiations sensibles comme la pratique de l'hospitalité, qui est l'exercice même de l'amour."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ca9b48c-b63a-3f2c-9d51-01a79e1d6792",
                        "entry_id": "9eda564f-3aa4-3378-bc71-aa925f97bf80",
                        "glosses": [
                            "Entremise pour mettre d’accord deux personnes, deux partis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28bf3741-d293-4b15-8f85-cb8c2f2a9384",
                                "sense_id": "3ca9b48c-b63a-3f2c-9d51-01a79e1d6792",
                                "text": "Cet accommodement a été fait par la médiation de tel homme d’État."
                            },
                            {
                                "example_id": "d89d632e-b26f-4656-8d28-2f1604b01241",
                                "sense_id": "3ca9b48c-b63a-3f2c-9d51-01a79e1d6792",
                                "text": "On s’est servi de sa médiation."
                            },
                            {
                                "example_id": "9f41e60e-08c9-435c-81a8-a290d0f3f45a",
                                "sense_id": "3ca9b48c-b63a-3f2c-9d51-01a79e1d6792",
                                "text": "Il a offert, on a accepté, on a refusé sa médiation."
                            },
                            {
                                "example_id": "aeb477db-ced6-4ca5-a5b1-f978079a5acd",
                                "sense_id": "3ca9b48c-b63a-3f2c-9d51-01a79e1d6792",
                                "text": "« Médiation armée » s’est dit de l’Acte de médiation dans lequel la puissance qui s’entremet entre les belligérants menace de faire la guerre à celle des deux parties qui n’acceptera pas ses propositions."
                            }
                        ]
                    },
                    {
                        "sense_id": "b5a0b85d-516d-3304-880e-f7f5ff15541d",
                        "entry_id": "9eda564f-3aa4-3378-bc71-aa925f97bf80",
                        "glosses": [
                            "Recherche de conciliation entre deux parties avant une action en justice."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a9cd350-c9be-4670-8bf9-d02d8c7735cb",
                                "sense_id": "b5a0b85d-516d-3304-880e-f7f5ff15541d",
                                "text": "Tout médiateur de la consommation met en place un site Internet consacré à la médiation et fournissant un accès direct aux informations relatives au processus de médiation. Ce site permet aux consommateurs de déposer en ligne une demande de médiation accompagnée des documents justificatifs."
                            },
                            {
                                "example_id": "a0a510b9-e896-4054-9864-62573ce3654b",
                                "sense_id": "b5a0b85d-516d-3304-880e-f7f5ff15541d",
                                "text": "« Nous faisons de plus en plus de médiation avec les bailleurs ou les fournisseurs d’énergie pour étaler les impayés », remarque Fathia, qui accompagne 80 familles."
                            }
                        ]
                    },
                    {
                        "sense_id": "ee777c8b-293a-33cd-8d74-55dc50c56885",
                        "entry_id": "9eda564f-3aa4-3378-bc71-aa925f97bf80",
                        "glosses": [
                            "Communication entre une institution culturelle, un artiste, et le public."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fdfc02b-6227-4af8-b061-fb50c201f2b2",
                                "sense_id": "ee777c8b-293a-33cd-8d74-55dc50c56885",
                                "text": "Notre société s’est dotée d’un service de médiation culturelle exclusivement dédié à la valorisation et à la diffusion du patrimoine archéologique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd03cf5d-3e17-4f0b-9b22-682b93864c09",
                        "source_entry_id": "9eda564f-3aa4-3378-bc71-aa925f97bf80",
                        "target_lang_word": "Vermittlung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vermittlung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0c60cf9f-234c-30e3-9317-92df453ad001",
                                        "entry_id": "43a0550f-089a-31f2-b2ff-cea791145cb3",
                                        "glosses": [
                                            "Herstellung einer noch nicht bestehenden Beziehung, eines erwünschten Ergebnisses"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12dd8976-b517-4a8c-8e58-3e43527ccfe8",
                                                "sense_id": "0c60cf9f-234c-30e3-9317-92df453ad001",
                                                "text": "„Durch Vermittlung seines Klassenlehrers trat die Demonstrationsperson wiederholt im Kinderfunk des Senders Hamburg auf und hinterließ nach Meinung der Redakteurin einen außergewöhnlichen Eindruck …“"
                                            },
                                            {
                                                "example_id": "0d12aceb-3675-4439-bfef-11bf8e398188",
                                                "sense_id": "0c60cf9f-234c-30e3-9317-92df453ad001",
                                                "text": "„Alle Träume kollabierten, und schließlich mußte er nach vielen Rückschlägen dankbar sein, auf Vermittlung Kants hin eine Übersetzerstelle in der von Franzosen geführten Zollverwaltung im Hafen zu erhalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e2fa78d6-129d-34e1-96d5-e0f1842f34cc",
                                        "entry_id": "43a0550f-089a-31f2-b2ff-cea791145cb3",
                                        "glosses": [
                                            "Handlung zum Ausgleich gegensätzlicher/unterschiedlicher Interessen/Meinungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63603d8a-3f0c-4f10-887b-bbafa1e9cf40",
                                                "sense_id": "e2fa78d6-129d-34e1-96d5-e0f1842f34cc",
                                                "text": "Versuche zur Vermittlung zwischen dem Iran und seinen Gegenspielern in der Frage der Kontrolle der Nutzung der Kernenergie sind bisher gescheitert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cb9327f5-c162-3ebd-82fd-cc5fef623e92",
                                        "entry_id": "43a0550f-089a-31f2-b2ff-cea791145cb3",
                                        "glosses": [
                                            "Verbesserung des Wissens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a6a534e-adae-4332-9800-4ec541862a27",
                                                "sense_id": "cb9327f5-c162-3ebd-82fd-cc5fef623e92",
                                                "text": "Unser Lehrer versuchte sich mit nur begrenztem Erfolg in der Vermittlung geografischer Grundkenntnisse."
                                            },
                                            {
                                                "example_id": "c312238b-a48b-4b30-8422-6a73528aabe9",
                                                "sense_id": "cb9327f5-c162-3ebd-82fd-cc5fef623e92",
                                                "text": "„Spielfähigkeit, mehrperspektivisch verstanden und als Leitidee der Vermittlung von Sportspielen interpretiert, beinhaltet eine doppelte Zielsetzung: Während es zum einen um eine allgemeine und spezifische Perspektive der Qualifikation geht, zielen entsprechende Vermittlungsprozesse zum anderen auf persönlichkeitsbildende Aspekte ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "1a9655b9-b58d-3d96-a863-93dbab2842a1",
                                        "entry_id": "43a0550f-089a-31f2-b2ff-cea791145cb3",
                                        "glosses": [
                                            "Schaltung einer technischen Verbindung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08d51319-d18b-4c9c-b575-8a189fb86dab",
                                                "sense_id": "1a9655b9-b58d-3d96-a863-93dbab2842a1",
                                                "text": "In der Vermittlung gehen täglich viele Anrufe ein."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
