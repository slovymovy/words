                        "examples": [
                            {
                                "example_id": "ed65a681-d596-4595-b597-e81ff8e26e0f",
                                "sense_id": "7d560269-9413-32e2-9306-23a7ee4a2b84",
                                "text": "Pourtant, si la causalité entre la maladie et les comportements particuliers des homosexuels est virologiquement fausse (le virus n'est pas spécifique aux gais), force est de constater que ce lien est alors épidémiologiquement fondé (la plupart des personnes atteintes en France sont homosexuelles)."
                            },
                            {
                                "example_id": "8cea93be-2e6c-4b6c-a6a6-6ff3dce04297",
                                "sense_id": "7d560269-9413-32e2-9306-23a7ee4a2b84",
                                "text": "Figure 26 : consommation médicale de 395 patients consultant en médecine générale pour un syndrome grippal virologiquement confirmé."
                            },
                            {
                                "example_id": "2eacefd2-ce6e-4b2b-be2a-f6d53de2d429",
                                "sense_id": "7d560269-9413-32e2-9306-23a7ee4a2b84",
                                "text": "Puis ils l’ont refermé en disant ne vouloir garder que les cas confirmés virologiquement."
                            }
                        ]
                    }
