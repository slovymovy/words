                        "examples": [
                            {
                                "example_id": "4020fb12-8262-4bf2-8cb2-fc34fb87d1b2",
                                "sense_id": "cff9d7e4-3c66-3242-a970-9df25d4bc8e2",
                                "text": "„Court stieg links als Dritter aus und sprang mit seinen Stiefelsohlen auf Betonbröckchen, die groß genug waren, um sich den Knöchel zu brechen, wenn man nicht aufpasste, wo man hintrat.“"
                            },
                            {
                                "example_id": "c2483745-9ff8-4382-8784-2e8a0dfb0143",
                                "sense_id": "cff9d7e4-3c66-3242-a970-9df25d4bc8e2",
                                "text": "„Er nimmt eine Münze aus der Tasche und reibt über den Mörtel zwischen den Steinen, bis er spürt, wie sich ein Betonbröckchen löst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
