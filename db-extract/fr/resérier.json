                "senses": [
                    {
                        "sense_id": "62084c69-635d-38ee-a175-cf4a9e3c91c7",
                        "entry_id": "c2d8e07d-c4e9-3fc0-9f9a-8ed12ef5d817",
                        "glosses": [
                            "Sérier à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69015147-d4d1-4dce-85bc-87657a2d42bc",
                                "sense_id": "62084c69-635d-38ee-a175-cf4a9e3c91c7",
                                "text": "Ils resérient le tout, du plus petit au plus grand, du plus grand au plus petit."
                            },
                            {
                                "example_id": "eab939fb-9086-4128-9e6a-15231e28bd43",
                                "sense_id": "62084c69-635d-38ee-a175-cf4a9e3c91c7",
                                "text": "Mais si l’on défait l’escalier et que l’on désigne un bâton quelconque n, l’enfant éprouve une difficulté systématique à répondre aux mêmes questions, c’est-à-dire à resérier les bâtons de 1 à n et surtout de n au dernier t […]"
                            }
                        ]
                    }
