                "senses": [
                    {
                        "sense_id": "c616af97-4b4e-33c2-9af3-fdc2cfc1eab5",
                        "entry_id": "1499d8c6-e258-36a1-b020-7229c3863411",
                        "glosses": [
                            "Transformer en chlorite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f63bb1b6-ce70-4346-b8cd-9b74616573de",
                                "sense_id": "c616af97-4b4e-33c2-9af3-fdc2cfc1eab5",
                                "text": "Nous avons ici le mica noir qui tend à chloritiser et la ségrégation partielle de fer sous forme de magnétite est peu accentuée."
                            },
                            {
                                "example_id": "299062af-e12d-493f-a64d-f72f8ca8d768",
                                "sense_id": "c616af97-4b4e-33c2-9af3-fdc2cfc1eab5",
                                "text": "Les micas noirs, ferro-magnésiens, réagissent très vite à l’oxydation se mordorisent aussitôt, ce qui est signe d‘un fort gonflement, exsudent de la limonite, se chloritisent éventuellement, se clivent et se brisent à la fois, imposant aux autres unités cristallines de la roche contraintes et détentes qui disloquent la roche."
                            }
                        ]
                    }
