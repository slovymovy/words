                "senses": [
                    {
                        "sense_id": "43507047-4cf6-3d2f-84d7-6305a8567157",
                        "entry_id": "f1f924fa-1059-33ed-99bb-f8a8d7dd3aea",
                        "glosses": [
                            "germanisches Fest der Wintersonnenwende"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31d91d1e-aba3-43bf-9d5b-836f9e09529c",
                                "sense_id": "43507047-4cf6-3d2f-84d7-6305a8567157",
                                "text": "Das Julfest war auch eine zwölftägige Friedenszeit."
                            },
                            {
                                "example_id": "bc2825e1-ff85-4c30-9b1b-13749ff13e10",
                                "sense_id": "43507047-4cf6-3d2f-84d7-6305a8567157",
                                "text": "Das altgermanische Julfest wurde später auf das christliche Weihnachtsfest übertragen."
                            },
                            {
                                "example_id": "715d30d4-9580-47b8-ace4-4a0a4d008c48",
                                "sense_id": "43507047-4cf6-3d2f-84d7-6305a8567157",
                                "text": "„Vieles spricht dafür, dass Harald sich im Winter 1065 dem großen Julfest um die Zeit der Sonnenwende widmen kann, ohne an den nächsten Kriegszug zu denken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
