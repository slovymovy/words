                ],
                "senses": [
                    {
                        "sense_id": "8b80bb55-ce3f-3fae-966b-d8ec8d3973ab",
                        "entry_id": "65d1bd07-ebbe-3a29-8b5b-8b0e3e337ce0",
                        "glosses": [
                            "An outwork. A fortification outside a castle used to split an attacking force; composed of two faces, forming a salient angle whose gorge resembles a half-moon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbf77116-3f17-4ab0-b1b2-98c58a275559",
                                "sense_id": "8b80bb55-ce3f-3fae-966b-d8ec8d3973ab",
                                "text": "It is about 2,500 yards in circuit, is built of red stone, and, according to Von Orlich, is now \" a bastioned quinquangle ; the ancient walls with semicircular bastions face the two streams ; the land side is quite regular, and consists of two bastions, and a half-bastion with three ravelins,\" and stands higher than any ground in face of it."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d118e05c-a2bb-4aa0-a424-3eb5b55896da",
                        "source_entry_id": "65d1bd07-ebbe-3a29-8b5b-8b0e3e337ce0",
                        "source_sense_id": "8b80bb55-ce3f-3fae-966b-d8ec8d3973ab",
                        "source_sense_description": "fortification outside a castle",
                        "target_lang_word": "ravelin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ravelin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "de08d8fe-ea1a-3e4a-b6cf-7fa256c70f5b",
                                        "entry_id": "fc2990bf-340f-30b4-b26f-af8de3f910bd",
                                        "glosses": [
                                            "Demi-lune, mur à angle saillant, destiné à protéger les angles des bastions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9cdaec8-9104-4613-9b87-d20aaeba8711",
                                                "sense_id": "de08d8fe-ea1a-3e4a-b6cf-7fa256c70f5b",
                                                "text": "Il [Charles XII] s'arrêta le 21 jusqu'à minuit sur un petit ravelin tout ruiné par les bombes et par le canon."
                                            },
                                            {
                                                "example_id": "6e621656-fe50-4a3a-aeac-9d9985caabab",
                                                "sense_id": "de08d8fe-ea1a-3e4a-b6cf-7fa256c70f5b",
                                                "text": "Pour se défendre de l'offensive ottomane, les Viennois avaient monté plus de trois cents canons sur les ravelins et les bastions."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ravelin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8be69d58-ea24-3b95-885e-2b72621fea87",
                                        "entry_id": "487a2aaf-7e39-38f2-b539-805ec5c54b21",
                                        "glosses": [
                                            "Invendu défraîchi dans une boutique de chaussures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14acf191-930e-407e-9fd7-a440ba7491cb",
                                                "sense_id": "8be69d58-ea24-3b95-885e-2b72621fea87",
                                                "text": "Le ravelin qualifiait une chaussure défraîchie, tandis que le rivelin était un article démodé, qui n'avait pas trouvé preneur et dont le marchand se débarrassait à prix soldé."
                                            },
                                            {
                                                "example_id": "75504f53-64ba-4484-a5d0-bf93102246cf",
                                                "sense_id": "8be69d58-ea24-3b95-885e-2b72621fea87",
                                                "text": "Une partie de ces commissionnaires trafiquaient autrefois des ravelins, les chaussures restées pour compte aux cordonniers sur mesure, ..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ceb1ca9-3fa6-3251-90c1-c35d07ba5e08",
                                        "entry_id": "487a2aaf-7e39-38f2-b539-805ec5c54b21",
                                        "glosses": [
                                            "Gravier issu de la taille des pavés."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
