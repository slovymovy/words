                "senses": [
                    {
                        "sense_id": "c8f1789f-e58e-3079-a6b2-684a55e8dd87",
                        "entry_id": "24a12571-8b79-36db-aa45-3126a8d818a7",
                        "glosses": [
                            "chemische Substanz mit spezifischer chemischer oder biologischer Aktivität, zum Beispiel in Reaktionen mit anderen Substanzen oder bei der Beeinflussung biologischer Prozesse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98adf2e5-81a4-4233-8d4d-6630bb39460a",
                                "sense_id": "c8f1789f-e58e-3079-a6b2-684a55e8dd87",
                                "text": "„Tee enthält Aktivstoffe, die uns wach machen, unseren Kreislauf ankurbeln, unseren Stoffwechsel anschieben, uns beruhigen oder auch Schmerzen und Verkrampfungen lindern.“"
                            },
                            {
                                "example_id": "fcc59d8d-f4d9-4d55-bbf2-1d4aba3e423a",
                                "sense_id": "c8f1789f-e58e-3079-a6b2-684a55e8dd87",
                                "text": "„Empfehlenswerte Aktivstoffe in Kosmetikprodukten sind zum Beispiel Retinaldehyd und Süßholzwurzelextrakt.“"
                            },
                            {
                                "example_id": "194c6a84-c289-42aa-91f9-49f466d5aed6",
                                "sense_id": "c8f1789f-e58e-3079-a6b2-684a55e8dd87",
                                "text": "„Der weibliche Körper produziert nur etwa ein Zehntel des als wichtigsten männlichen Aktivstoff bezeichneten Botenstoffes Testosteron.“"
                            },
                            {
                                "example_id": "aa848d37-a133-4e29-b160-fa783e17fa0c",
                                "sense_id": "c8f1789f-e58e-3079-a6b2-684a55e8dd87",
                                "text": "„Viele hochwertige Massageprodukte enthalten Vitamine und Mineralien sowie pflanzliche Aktivstoffe, die das Hautbild verfeinern und die Haut an Busen, Bauch, Beinen und Po straffen und festigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
