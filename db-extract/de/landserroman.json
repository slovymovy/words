                        "glosses": [
                            "Roman, in dem es um einen Landser/mehrere Landser geht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d795429c-5d77-482e-9230-3a33102ea887",
                                "sense_id": "306236a0-8578-3fa7-a663-6cddb6686c1e",
                                "text": "„Viele triviale Landserromane erschienen, den Krieg und das Heldentum des deutschen Soldaten preisend.“"
                            },
                            {
                                "example_id": "3397e263-4d1c-4ebc-96ae-f39752a042d0",
                                "sense_id": "306236a0-8578-3fa7-a663-6cddb6686c1e",
                                "text": "„Viel mehr als ein überwiegend ereignisarmes Milieustück, ein verfilmter Landserroman mit angenehm unaufdringlich typisierten Soldaten ist „Beaufort“ dennoch nicht geworden – und im Wettbewerb eines sich auch ästhetisch innovativ verstehenden Weltfestivals nicht eben zwingend am Platz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
