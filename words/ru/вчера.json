                    "semantic_group_id": "figurative_past",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "То, что казалось невозможным ещё <w>вчера</w>, сегодня стало реальностью.",
                            "target_lang_translations": {
                                "en": "What seemed impossible just <w>yesterday</w> has become a reality today.",
                                "zh": "那些<w>昨天</w>看起来不可能的事，今天已经变成了现实。",
                                "de": "Was noch <w>gestern</w> unmöglich schien, ist heute Realität geworden.",
                                "nl": "Wat <w>gisteren</w> nog onmogelijk leek, is vandaag werkelijkheid geworden.",
                                "pl": "To, co wydawało się niemożliwe jeszcze <w>wczoraj</w>, dzisiaj stało się rzeczywistością.",
                                "fr": "Ce qui semblait impossible <w>hier</w> encore est devenu une réalité aujourd'hui.",
                                "it": "Ciò che sembrava impossibile solo <w>ieri</w>, oggi è diventato realtà.",
                                "cs": "To, co se zdálo ještě <w>včera</w> nemožné, se dnes stalo realitou.",
                                "tr": "Daha <w>dün</w> imkansız görünen şey, bugün gerçek oldu.",
                                "es": "Lo que parecía imposible <w>ayer</w>, hoy se ha convertido en realidad."
                            }
                        },
                        {
                            "text": "Эта технология устарела уже <w>вчера</w>.",
                            "target_lang_translations": {
                                "en": "This technology was already outdated <w>yesterday</w>.",
                                "zh": "这项技术在<w>昨天</w>就已经过时了。",
                                "de": "Diese Technologie war schon <w>gestern</w> veraltet.",
                                "nl": "Deze technologie was <w>gisteren</w> al verouderd.",
                                "pl": "Ta technologia była przestarzała już <w>wczoraj</w>.",
                                "fr": "Cette technologie était déjà obsolète <w>hier</w>.",
                                "it": "Questa tecnologia era già obsoleta <w>ieri</w>.",
                                "cs": "Tato technologie byla zastaralá už <w>včera</w>.",
                                "tr": "Bu teknoloji daha <w>dün</w> eskimişti.",
                                "es": "Esta tecnología ya estaba obsoleta <w>ayer</w>."
                            }
                        }
