                    {
                        "translation_id": "77f9fb08-54cc-4152-92f6-c10a574a3308",
                        "source_entry_id": "315a65ff-1ffd-3319-ba70-84c55d99b96e",
                        "source_sense_id": "c45cc5d2-e866-3ddc-81cb-cd2f38401f85",
                        "source_sense_description": "Иноязычные аналоги",
                        "target_lang_word": "Gabrielle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gabrielle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "70775022-2291-3396-b44c-c1bf849aa484",
                                        "entry_id": "ac356df8-0e6a-3441-95bd-da9b55b9ec8b",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0760070f-7368-463a-8de4-ae4d9bb0e77e",
                                                "sense_id": "70775022-2291-3396-b44c-c1bf849aa484",
                                                "text": "— Et Gabrielle Bernier ?… Est-elle aussi de la Société de Géographie ?"
                                            },
                                            {
                                                "example_id": "f9863256-5a6f-4895-833f-045f7e22448b",
                                                "sense_id": "70775022-2291-3396-b44c-c1bf849aa484",
                                                "text": "La rieuse Gabrielle n’a sans doute jamais donné une pensée à ces femmes, dont quelques-unes furent ses aïeules ; tout simplement, la famille lui a choisi cette place, ne sachant trop où mettre la jeune divorcée."
                                            },
                                            {
                                                "example_id": "8b85b560-b05f-4dc1-a49c-b792e6f8d970",
                                                "sense_id": "70775022-2291-3396-b44c-c1bf849aa484",
                                                "text": "C’est avec émotion que la chanteuse, qui a notamment accompagné l’idole des jeunes pendant les années yé-yé et comptait, avec lui, parmi les têtes d’affiche de la revue Salut les copains, réinterprète des titres aussi célèbres que La musique que j’aime’' (1973), Gabrielle (1976), Quelque chose de Tennessee (1985), ou encore Sans pour sang (1999), vendu à plus de 2 millions d’exemplaires et signé par le fils Hallyday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b12fe31-bceb-3c40-880c-56af0f74a33d",
                                        "entry_id": "ac356df8-0e6a-3441-95bd-da9b55b9ec8b",
                                        "glosses": [
                                            "Prénom de Gabrielle d’Estrées, favorite du roi de France Henri IV."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12fb0668-2eab-4348-94a8-c524241d94d5",
                                                "sense_id": "7b12fe31-bceb-3c40-880c-56af0f74a33d",
                                                "text": "— Moi qui tolère un artiste à Héloïse, absolument comme Henri IV permettait Bellegarde à Gabrielle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
