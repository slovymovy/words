                    },
                    {
                        "translation_id": "8bf63834-8ad8-4550-a9fe-037b303cda1f",
                        "source_entry_id": "50496ecb-a1f4-3263-a4ba-df991d7d8102",
                        "source_sense_id": "73ca7216-16bc-395c-88f6-41cd4c25cf52",
                        "source_sense_description": "Sprache des Indianerstamms der Cree, die zwischen den Rocky Mountains und dem Atlantik gesprochen wird",
                        "target_lang_word": "Cree language",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "30b46cc0-e577-4b4d-b908-fd3cb5a3e4ff",
                        "source_entry_id": "50496ecb-a1f4-3263-a4ba-df991d7d8102",
                        "source_sense_id": "73ca7216-16bc-395c-88f6-41cd4c25cf52",
                        "source_sense_description": "Sprache des Indianerstamms der Cree, die zwischen den Rocky Mountains und dem Atlantik gesprochen wird",
                        "target_lang_word": "cri",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cri",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1f543c28-bebf-37c7-89bf-70e1dcea681c",
                                        "entry_id": "de2366bc-c2fa-3785-b2dd-f8a990cb7b97",
                                        "glosses": [
                                            "Action de crier, son perçant ou puissant émis par la voix d’un être humain ou d’un animal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f901bd2-10c8-4609-9541-45224a0e2184",
                                                "sense_id": "1f543c28-bebf-37c7-89bf-70e1dcea681c",
                                                "text": "Jeter, pousser les hauts cris."
                                            },
                                            {
                                                "example_id": "b1618a06-831f-4369-9b27-317b3072dfde",
                                                "sense_id": "1f543c28-bebf-37c7-89bf-70e1dcea681c",
                                                "text": "Cette innovation fit jeter les hauts cris."
                                            },
                                            {
                                                "example_id": "ab25fb04-4723-4e62-8594-77f56e8a86e3",
                                                "sense_id": "1f543c28-bebf-37c7-89bf-70e1dcea681c",
                                                "text": "Et puis le silence, ce grand silence qui plane au-dessus des solitudes islandaises, et que trouble seul le sifflement du vent ou le cri des pluviers dorés."
                                            },
                                            {
                                                "example_id": "6328cf50-44ea-41e8-b3ef-aab96ac5acb7",
                                                "sense_id": "1f543c28-bebf-37c7-89bf-70e1dcea681c",
                                                "text": "On suicide un silence en accouchant d’un cri."
                                            },
                                            {
                                                "example_id": "360a3430-f4e8-45b6-ac14-fe0ef5923e97",
                                                "sense_id": "1f543c28-bebf-37c7-89bf-70e1dcea681c",
                                                "text": "Ne faire qu’un cri, se dit d’un malade qui crie sans discontinuer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f9c9dea-7c70-37d2-8be5-1b393dd15621",
                                        "entry_id": "de2366bc-c2fa-3785-b2dd-f8a990cb7b97",
                                        "glosses": [
                                            "Action de crier, son perçant ou puissant émis par la voix d’un être humain ou d’un animal.",
                                            "Se dit quelquefois au singulier des cris poussés par plusieurs personnes à la fois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7658413-8e73-4b60-a38e-fc3e0651dab3",
                                                "sense_id": "5f9c9dea-7c70-37d2-8be5-1b393dd15621",
                                                "text": "Un cri s’éleva dans l’assemblée."
                                            },
                                            {
                                                "example_id": "03066b97-231d-4181-9831-38ef883a703c",
                                                "sense_id": "5f9c9dea-7c70-37d2-8be5-1b393dd15621",
                                                "text": "Un cri général se fit entendre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6d1c156-06ff-3fa3-8dbb-26e1d70431f0",
                                        "entry_id": "de2366bc-c2fa-3785-b2dd-f8a990cb7b97",
                                        "glosses": [
                                            "Voix ordinaire des animaux, et particulièrement des quadrupèdes et des oiseaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c55a23e5-6591-4c9c-9c4c-63fbd9abc24e",
                                                "sense_id": "e6d1c156-06ff-3fa3-8dbb-26e1d70431f0",
                                                "text": "Imiter le cri d’un oiseau."
                                            },
                                            {
                                                "example_id": "1a5955c1-8462-40f2-99c0-00a1b7e695e8",
                                                "sense_id": "e6d1c156-06ff-3fa3-8dbb-26e1d70431f0",
                                                "text": "Pousser des cris de paon, protester avec aigreur, avec indignation."
                                            },
                                            {
                                                "example_id": "d31f1789-5f4f-482e-be33-c58d27539469",
                                                "sense_id": "e6d1c156-06ff-3fa3-8dbb-26e1d70431f0",
                                                "text": "On n’entend plus que les cris des volailles et des porcs saignés ; les cheminées fument, tout Ramscapelle s’emplit de la joyeuse animation d’un marché oriental."
                                            },
                                            {
                                                "example_id": "f1d37fde-2589-4e3a-9980-6d7e0e767da7",
                                                "sense_id": "e6d1c156-06ff-3fa3-8dbb-26e1d70431f0",
                                                "text": "Chasser à cor et à cri : → voir à cor et à cri"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a73bbce-fefe-3343-ad11-f20d6de3d747",
                                        "entry_id": "de2366bc-c2fa-3785-b2dd-f8a990cb7b97",
                                        "glosses": [
                                            "En parlant des marchands et ouvriers ambulants qui annoncent à haute voix leur genre de commerce ou d’industrie, le prix de ce qu’ils vendent, etc."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff174916-6c1f-4d78-9061-59780554b024",
                                                "sense_id": "4a73bbce-fefe-3343-ad11-f20d6de3d747",
                                                "text": "Les cris de Paris."
                                            },
                                            {
                                                "example_id": "dc3eb8bb-2bc5-42e1-b7d8-90811c7c075c",
                                                "sense_id": "4a73bbce-fefe-3343-ad11-f20d6de3d747",
                                                "text": "Le cri d’un remouleur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccdff9d8-1de0-32e3-9d65-b8b3e0c2d4a0",
                                        "entry_id": "de2366bc-c2fa-3785-b2dd-f8a990cb7b97",
                                        "glosses": [
                                            "Se dit également de certaines phrases brèves que l’on prononce à très haute voix, pour donner quelque avertissement, pour exprimer quelque émotion vive, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e85bacfe-e2f6-4d27-bc16-18180f8cd668",
                                                "sense_id": "ccdff9d8-1de0-32e3-9d65-b8b3e0c2d4a0",
                                                "text": "Mais un appel connu des Bretons frappa son oreille le chant du hibou, qui fut le cri de ralliement des Chouans et qu'on n'entend jamais à Paris."
                                            },
                                            {
                                                "example_id": "d5c153df-1cbb-4ab0-b402-82f1ce130183",
                                                "sense_id": "ccdff9d8-1de0-32e3-9d65-b8b3e0c2d4a0",
                                                "text": "Le cri de « Sauve qui peut ! » — J’entendais les cris : « Au meurtre ! À l’assassin ! » — Des cris séditieux."
                                            },
                                            {
                                                "example_id": "96b9ca80-0c52-4ab0-81ab-971623f1ca2f",
                                                "sense_id": "ccdff9d8-1de0-32e3-9d65-b8b3e0c2d4a0",
                                                "text": "Le bon Piqueur doit sçauoir bien parler en cris, & langages plaisans aux chiens, crier, hucher, & houpper ses compagnons, forhuer en mots longs, & sonner de la trompe."
                                            },
                                            {
                                                "example_id": "53cfa7fa-2600-44ae-a586-b0ace762a985",
                                                "sense_id": "ccdff9d8-1de0-32e3-9d65-b8b3e0c2d4a0",
                                                "text": "À son arrivée dans Paris, Louis Pasteur ne ressemblait guère à cet étudiant, héros de Balzac, qui jetait à la grande ville ce cri plein de confiance : « À nous deux ! »"
                                            },
                                            {
                                                "example_id": "665d69c2-5479-4507-a0b3-3e65397cb0c6",
                                                "sense_id": "ccdff9d8-1de0-32e3-9d65-b8b3e0c2d4a0",
                                                "text": "Cri de guerre, cri d’armes, ou simplement Cri, : Se disait de certains mots qu’une nation, une ville, une maison illustre portait écrits sur ses drapeaux, sur les cottes d’armes, et que les gens de guerre, marchant sous ses bannières, avaient coutume de crier en allant au combat."
                                            },
                                            {
                                                "example_id": "20c36559-fa72-47f4-810b-14c52a2a622c",
                                                "sense_id": "ccdff9d8-1de0-32e3-9d65-b8b3e0c2d4a0",
                                                "text": "Le cri des Français était « Montjoie Saint-Denis ! »"
                                            },
                                            {
                                                "example_id": "fcc889ec-4d58-4f3b-a4af-e276c9d97446",
                                                "sense_id": "ccdff9d8-1de0-32e3-9d65-b8b3e0c2d4a0",
                                                "text": "Le cri de la maison de Bourbon : « Dame ! »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b036f01b-737e-3ddb-94b6-51b02b3cac6f",
                                        "entry_id": "de2366bc-c2fa-3785-b2dd-f8a990cb7b97",
                                        "glosses": [
                                            "Les plaintes et les gémissements des personnes qui sont dans l’oppression, dans l’affliction, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8ffac1f-8566-492a-8c67-3d974cc6d760",
                                                "sense_id": "b036f01b-737e-3ddb-94b6-51b02b3cac6f",
                                                "text": "Le cri de la douleur publique."
                                            },
                                            {
                                                "example_id": "37eeb721-44b3-4ce3-9cf5-873601c7f750",
                                                "sense_id": "b036f01b-737e-3ddb-94b6-51b02b3cac6f",
                                                "text": "Les cris de l’opprimé."
                                            },
                                            {
                                                "example_id": "7446a5f5-12cc-473c-9634-038bcaf306b9",
                                                "sense_id": "b036f01b-737e-3ddb-94b6-51b02b3cac6f",
                                                "text": "Fermer l’oreille au cri de la misère."
                                            },
                                            {
                                                "example_id": "b8fa3435-4cdf-4c56-b87f-421c08af0b94",
                                                "sense_id": "b036f01b-737e-3ddb-94b6-51b02b3cac6f",
                                                "text": "Dieu entend les cris des veuves et des orphelins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db30fbab-5918-37b3-bc98-8e4b57fb5ee3",
                                        "entry_id": "de2366bc-c2fa-3785-b2dd-f8a990cb7b97",
                                        "glosses": [
                                            "Proclamation."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed4fb5a7-b355-45cf-954c-546b966c52bb",
                                                "sense_id": "db30fbab-5918-37b3-bc98-8e4b57fb5ee3",
                                                "text": "Et de par le roi, le cri fut fait à son de trompe, par tous les carrefours, que les aventuriers, gens de peu, faux mendiants et traîneurs de rues, vidassent les lieux, sur peine de la hart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7299ed1-ce44-3b2f-b448-da40a86bf674",
                                        "entry_id": "de2366bc-c2fa-3785-b2dd-f8a990cb7b97",
                                        "glosses": [
                                            "Revendication, demande pressante, toute opinion manifestée hautement ; et alors il s’emploie surtout en parlant de plusieurs personnes qui s’accordent à blâmer, à désapprouver quelqu’un ou quelque chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0756e4a5-8a04-44b2-916b-f333ab99727d",
                                                "sense_id": "e7299ed1-ce44-3b2f-b448-da40a86bf674",
                                                "text": "La véritable affaire n’était pas encore commencée. On n’entendait ni les cris antidynastiques qui étaient attendus ni le grondement orageux de La Marseillaise."
                                            },
                                            {
                                                "example_id": "ce35026b-d067-42d8-87f5-b3ac6b5d0e97",
                                                "sense_id": "e7299ed1-ce44-3b2f-b448-da40a86bf674",
                                                "text": "De Fontainebleau à Montargis et de Pithiviers à Beaugency, on avait tout dit, quand on nommait le brigadier Dussutour, et les représentants de l’autorité militaire ou civile n’avaient qu’un cri pour préconiser la vertu de ce soldat."
                                            },
                                            {
                                                "example_id": "4e6c37cb-cb1b-40f1-a871-eb37a340f55b",
                                                "sense_id": "e7299ed1-ce44-3b2f-b448-da40a86bf674",
                                                "text": "L’État devrait prendre en compte le cri des professeurs."
                                            },
                                            {
                                                "example_id": "2aa8fb02-647b-414b-9280-ec55f1db961f",
                                                "sense_id": "e7299ed1-ce44-3b2f-b448-da40a86bf674",
                                                "text": "Il n’y a qu’un cri sur telle personne, sur telle chose."
                                            },
                                            {
                                                "example_id": "366bd82d-7789-433a-baf7-dd68887d9953",
                                                "sense_id": "e7299ed1-ce44-3b2f-b448-da40a86bf674",
                                                "text": "Un cri général s’éleva contre lui."
                                            },
                                            {
                                                "example_id": "856e21ab-b0f2-4ac6-bdda-fe694844ccb5",
                                                "sense_id": "e7299ed1-ce44-3b2f-b448-da40a86bf674",
                                                "text": "Les cris d’une cabale impuissante."
                                            },
                                            {
                                                "example_id": "2ce44719-2b91-4d79-a914-c0639c221971",
                                                "sense_id": "e7299ed1-ce44-3b2f-b448-da40a86bf674",
                                                "text": "Le cri public : L’opinion publique, favorable ou contraire."
                                            },
                                            {
                                                "example_id": "bf43542e-e0dc-4924-bae3-b0f1e4f625e3",
                                                "sense_id": "e7299ed1-ce44-3b2f-b448-da40a86bf674",
                                                "text": "Braver le cri public."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36a3371c-b46d-33d4-abf5-2b21e9377b6b",
                                        "entry_id": "de2366bc-c2fa-3785-b2dd-f8a990cb7b97",
                                        "glosses": [
                                            "Se dit des mouvements intérieurs qui nous portent à faire une chose ou qui nous en détournent."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c69cde7-577b-4662-a489-acf4cd7e75e5",
                                                "sense_id": "36a3371c-b46d-33d4-abf5-2b21e9377b6b",
                                                "text": "Le cri du cœur."
                                            },
                                            {
                                                "example_id": "1fd62be9-8cb3-43f3-bd02-7312c9ecf5ca",
                                                "sense_id": "36a3371c-b46d-33d4-abf5-2b21e9377b6b",
                                                "text": "Étouffer le cri de la conscience."
                                            },
                                            {
                                                "example_id": "a23abe74-afd1-4c95-a420-f5b0d86e2543",
                                                "sense_id": "36a3371c-b46d-33d4-abf5-2b21e9377b6b",
                                                "text": "Le cri de l’amour maternel."
                                            },
                                            {
                                                "example_id": "fac67c79-736b-435b-b7b6-5311b8f3b0fd",
                                                "sense_id": "36a3371c-b46d-33d4-abf5-2b21e9377b6b",
                                                "text": "Le cri de la nature."
                                            },
                                            {
                                                "example_id": "3085d686-7d27-48f8-9ef3-eff0d1d8639b",
                                                "sense_id": "36a3371c-b46d-33d4-abf5-2b21e9377b6b",
                                                "text": "Le cri du sang."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d928bb84-492a-3fc1-b74a-61dc64e23b4f",
                                        "entry_id": "de2366bc-c2fa-3785-b2dd-f8a990cb7b97",
                                        "glosses": [
                                            "Action de crier permettant au joueur de repousser et de faire tomber les autres."
                                        ],
                                        "tags": [
                                            "Jeux vidéo",
                                            "Dans Aaaah"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e37534e-96b4-416c-969f-14b5c2f44b9c",
                                                "sense_id": "d928bb84-492a-3fc1-b74a-61dc64e23b4f",
                                                "text": "Pour crier, c’est simple, Hurlez dans votre micro !\nNon, je blague, plus sérieusement, pour crier, il vous suffit d’appuyer sur Flèche de bas lorsque votre barre de cri est à fond !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cri",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "56cadaec-eb2d-3fc6-afdc-a6d57402d651",
                                        "entry_id": "9ed23329-c854-36ef-b74f-ad2c9c0342f8",
                                        "glosses": [
                                            "Relatif aux Cris, à leur langue, à leur culture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4c234ca-c0a3-4162-9187-33d30ca51fec",
                                                "sense_id": "56cadaec-eb2d-3fc6-afdc-a6d57402d651",
                                                "text": "La Nation crie."
                                            },
                                            {
                                                "example_id": "517593da-c3f1-4044-8f00-829a40a86e73",
                                                "sense_id": "56cadaec-eb2d-3fc6-afdc-a6d57402d651",
                                                "text": "La Loi québécoise concernant les villages cris."
                                            },
                                            {
                                                "example_id": "335c9154-8382-4678-b0dc-e371d488bf4c",
                                                "sense_id": "56cadaec-eb2d-3fc6-afdc-a6d57402d651",
                                                "text": "Un jeune chasseur cri revenait d'un très long voyage."
                                            },
                                            {
                                                "example_id": "bd5852a9-c79d-4c31-9a6f-a973ab94c92f",
                                                "sense_id": "56cadaec-eb2d-3fc6-afdc-a6d57402d651",
                                                "text": "Sous le titre « Fleur des neiges polaires » est résumée l'histoire d'une très jeune enfant crie nommée Christine."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cri",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4d1b2e15-2638-303e-b07e-3c89a2a384aa",
                                        "entry_id": "955aa48c-3cec-36e7-a893-c5fe2beb3234",
                                        "glosses": [
                                            "Langue des Cris, appartenant à la famille algonquienne. Son code ISO 639-3 est cre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7e06822-fdbd-4360-b41b-03daf6b95a99",
                                                "sense_id": "4d1b2e15-2638-303e-b07e-3c89a2a384aa",
                                                "text": "Les langues algonquiennes dominent l’est du Canada, de la Nouvelle-Écosse aux rives de la baie d’Hudson et même au-delà, le cri étant la plus parlée d’entre elles. […] Le cri et l’ojibwa sont, avec l’inuktitut, les seules langues indigènes dont les linguistes ne prévoient pas l’extinction prochaine. Pour certains d’entre eux, cri, attikamek, innu et naskapi ne sont que des dialectes d’une même langue. Mais les peuples qui les parlent tiennent à marquer leurs différences : Cris et Naskapis ont adopté l’écriture syllabique, alors que les autres utilisent l’alphabet latin. […] Le cri du Sud s’écrit différemment du cri du Nord."
                                            },
                                            {
                                                "example_id": "9ca3864d-180e-4d77-9d77-e86eae8e43df",
                                                "sense_id": "4d1b2e15-2638-303e-b07e-3c89a2a384aa",
                                                "text": "Aujourd’hui, dans les réserves, observe Louis-Jacques Dorais, c’est en cri, en innu ou en atikamekw que se fait l’enseignement, de la maternelle jusqu’à la deuxième ou troisième année."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
