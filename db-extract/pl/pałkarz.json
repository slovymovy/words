                            }
                        ]
                    },
                    {
                        "translation_id": "2d480e99-04fc-4652-b824-a5c65249e899",
                        "source_entry_id": "c004c7e5-1dfd-30fd-a8cc-8a14cc6ed2ac",
                        "source_sense_id": "5ae77b9a-63f5-3886-8655-d035f5362c36",
                        "target_lang_word": "hitter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hitter",
