                                                "example_id": "992c9219-9ced-4d11-95fc-1f620b96a599",
                                                "sense_id": "27a65d47-f8d2-3a99-8ff8-c4f1034f9351",
                                                "text": "„Ramin lässt den Kopf nach hinten auf die Kopfstütze mit Fellüberzug fallen und schließt die Augen.“"
                                            }
                                        ],
