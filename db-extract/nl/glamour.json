            {
                "entry_id": "73167cee-1706-37a8-9c30-13fbb7d10581",
                "word": "glamour",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "31eadf2c-08a8-3cd0-9793-f864de94b1e1",
                        "entry_id": "73167cee-1706-37a8-9c30-13fbb7d10581",
                        "glosses": [
                            "betoverend uiterlijk, schone schijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3edba9bb-74b6-4c24-8731-4b560fd6cf29",
                                "sense_id": "31eadf2c-08a8-3cd0-9793-f864de94b1e1",
                                "text": "Het thema van het feest is \"glitter en glamour\"."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49ba9a95-879a-4fad-8655-e8cf3e1aafec",
                        "source_entry_id": "73167cee-1706-37a8-9c30-13fbb7d10581",
                        "source_sense_id": "31eadf2c-08a8-3cd0-9793-f864de94b1e1",
                        "source_sense_description": "betoverend uiterlijk, schone schijn",
                        "target_lang_word": "Glamour",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Glamour",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e1e288f4-8498-3c68-8a19-2c4f9adb7142",
                                        "entry_id": "34eb7a4b-57fc-3704-ac66-0230e37e1503",
                                        "glosses": [
                                            "luxuriöse/prunkvolle Aufmachung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87494044-0ef8-443a-9b70-e7badc747702",
                                                "sense_id": "e1e288f4-8498-3c68-8a19-2c4f9adb7142",
                                                "text": "„Es muss aber nicht immer der absolute Glamour sein, der die Frauen an den Royals dieser Welt fasziniert, gerade der Gegensatz von offensichtlicher Märchenwelt und durchaus bürgerlichen Problemen fasziniert.“"
                                            },
                                            {
                                                "example_id": "76819e60-e7be-4fdd-999c-bc4dcc9622ab",
                                                "sense_id": "e1e288f4-8498-3c68-8a19-2c4f9adb7142",
                                                "text": "„Der Schriftsteller wiederum traf auf eine Frau, die seinen Idealen nur zu sehr entsprach: schlank, von außergewöhnlicher Schönheit und umstrahlt vom Glamour, dem er schon immer erlegen war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea2df23a-8a3b-4b9b-a269-88af9aa1bc9b",
                        "source_entry_id": "73167cee-1706-37a8-9c30-13fbb7d10581",
                        "source_sense_id": "31eadf2c-08a8-3cd0-9793-f864de94b1e1",
                        "source_sense_description": "betoverend uiterlijk, schone schijn",
                        "target_lang_word": "glamour",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glamour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30473fcc-0ad7-3285-9420-800b40369030",
                                        "entry_id": "655c9e90-93bc-3e97-a670-17c2a9ba64c5",
                                        "glosses": [
                                            "Originally, enchantment; magic charm; especially, the effect of a spell that causes one to see objects in a form that differs from reality, typically to make filthy, ugly, or repulsive things seem beauteous."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb189b02-83db-4d6f-b852-88879ff7c6a2",
                                                "sense_id": "30473fcc-0ad7-3285-9420-800b40369030",
                                                "text": "They often murmur to themselves, they speak\nTo one another seldom, for their woe\nBroods maddening inwardly and scorns to wreak\nItself abroad; and if at whiles it grow\nTo frenzy which must rave, none heeds the clamour,\nUnless there waits some victim of like glamour,\nTo rave in turn, who lends attentive show."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d7134f5-f05b-3061-a1b3-6ce2dd8fa435",
                                        "entry_id": "655c9e90-93bc-3e97-a670-17c2a9ba64c5",
                                        "glosses": [
                                            "Alluring beauty or charm (often with sex appeal)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2ffb738-f1bc-4bbf-87e8-5ded3407a2a0",
                                                "sense_id": "4d7134f5-f05b-3061-a1b3-6ce2dd8fa435",
                                                "text": "glamour magazines; a glamour model"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c234e52-08e1-33de-96a6-48ec248b47cd",
                                        "entry_id": "655c9e90-93bc-3e97-a670-17c2a9ba64c5",
                                        "glosses": [
                                            "Any excitement, appeal, or attractiveness associated with a person, place, or thing; that which makes something appealing."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c90a4da0-384b-4ae7-b010-d8d4a17be801",
                                                "sense_id": "1c234e52-08e1-33de-96a6-48ec248b47cd",
                                                "text": "The idea of being a movie star has lost its glamour for me."
                                            },
                                            {
                                                "example_id": "5c15f878-c147-4125-b1e1-f22785b62d50",
                                                "sense_id": "1c234e52-08e1-33de-96a6-48ec248b47cd",
                                                "text": "“The North Pole was one of these places, I remember. Well, I haven’t been there yet, and shall not try now. The glamour’s off.”"
                                            },
                                            {
                                                "example_id": "fa254fcc-a46e-4d42-b129-e41b4a8e07f8",
                                                "sense_id": "1c234e52-08e1-33de-96a6-48ec248b47cd",
                                                "text": "Boys have not lost their love for adventure, and still have `itchy feet.' Many are seeking glamor jobs, want to be writers, detectives, seamen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4bd30e8-8070-3aef-bc70-2802074eca26",
                                        "entry_id": "655c9e90-93bc-3e97-a670-17c2a9ba64c5",
                                        "glosses": [
                                            "Any artificial interest in, or association with, objects, or persons, through which they appear delusively magnified or glorified."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "11902c89-1080-3de6-b304-025d6cb97597",
                                        "entry_id": "655c9e90-93bc-3e97-a670-17c2a9ba64c5",
                                        "glosses": [
                                            "A kind of haze in the air, causing things to appear different from what they really are."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60153b96-fe44-4980-9de3-f6431b3a89ed",
                                                "sense_id": "11902c89-1080-3de6-b304-025d6cb97597",
                                                "text": "When the golden October comes, with its witching of hazy air that makes a glamour for all things and any landscape, we shall see these offspring of poetic myth stretch out beside the creeks, breaking the tender hulls for their magical chincapins, and feeding on them and on the dreams of which they are the talismans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "896244f2-3a5e-3aed-b8a9-c8c9382262a2",
                                        "entry_id": "655c9e90-93bc-3e97-a670-17c2a9ba64c5",
                                        "glosses": [
                                            "An item, motif, person, image that by association improves appearance."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "23c7e404-79b9-3806-beab-7331bbd2a5ab",
                                        "entry_id": "655c9e90-93bc-3e97-a670-17c2a9ba64c5",
                                        "glosses": [
                                            "A beautiful woman."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "276f977e-378a-4996-acd2-53d4b9440d16",
                                                "sense_id": "23c7e404-79b9-3806-beab-7331bbd2a5ab",
                                                "text": "One of the Qantas staff, a glamour, made her way over to us."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "glamour",
                                "target_lang_code": "en",
                                "target_senses": [
