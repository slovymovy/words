                                                "example_id": "5b617da5-dd4d-4edb-9850-81b6670cc706",
                                                "sense_id": "b179854b-0235-3f3c-84e9-8e1eb516edf1",
                                                "text": "' Mijn kaart lijkt anders behoorlijk te kloppen,' zegt Joy."
                                            },
                                            {
                                                "example_id": "144d49c7-1f0f-419f-b4af-1303c7428a14",
                                                "sense_id": "b179854b-0235-3f3c-84e9-8e1eb516edf1",
                                                "text": "Het - laatste traject gaat behoorlijk steil naar het hooggelegen Racalmuto, de sfeervolle geboorteplaats van de Siciliaanse schrijver Leonardo Sciascia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
