                "senses": [
                    {
                        "sense_id": "e94fb177-f57e-3e2f-b12e-b41178aed59b",
                        "entry_id": "a4da7f6f-8b79-3736-beff-a1d8c453dc20",
                        "glosses": [
                            "een onderdeel van een festiviteit dat wordt uitgevoerd vóór het belangrijkste deel van het programma"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1079e32-6a1c-45c8-9505-1bb5c8c225ed",
                                "sense_id": "e94fb177-f57e-3e2f-b12e-b41178aed59b",
                                "text": "De Ekdoms Kerst Top 30 is traditiegetrouw het voorprogramma van de Top 2000, die tot oudejaarsavond wordt uitgezonden."
                            },
                            {
                                "example_id": "beebfab9-2cdd-49eb-a81d-5e346e160975",
                                "sense_id": "e94fb177-f57e-3e2f-b12e-b41178aed59b",
                                "text": "De race in de haven van Sydney is de traditionele aftrap van het voorprogramma van de Sydney Hobart Yacht Race. De zeilrace van Sydney over de Tasmanzee naar Hobart op het eiland Tasmanië gaat op eerste kerstdag van start. De Wild Oats XI is recordhouder in het aantal overwinningen. Het megajacht won sinds 2005 al negen keer de wedstrijd over 1170 kilometer."
                            },
                            {
                                "example_id": "1b516855-ffc2-4bb0-a05c-b20fe6de5964",
                                "sense_id": "e94fb177-f57e-3e2f-b12e-b41178aed59b",
                                "text": "Volgens de NBB komt Cuba met een \"hele rits\" olympische en mondiale kampioenen naar Rotterdam. Onder anderen Enrico Lacruz, Max van der Pas en Peter Müllenberg moeten voor het nodige weerwerk zorgen namens Oranje. Nouchka Fontijn, goed voor olympisch zilver bij Rio 2016, bokst in het voorprogramma tegen een Oekraïense."
                            }
                        ]
                    }
