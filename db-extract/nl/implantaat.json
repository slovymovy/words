                                        "glosses": [
                                            "To fix firmly or set securely or deeply."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63900ba5-6180-43d0-bf93-01ae1d7cb06b",
                                                "sense_id": "1b52baee-aab6-3800-8543-4fecda42a031",
                                                "text": "That strength of body is often equal to the courage of mind implanted in the fair sex, will not be denied by those who have seen the water-women of Plymouth; the female drudges of Ireland, Wales, and Scotland; the fish-women of Billinsgate; the weeders, podders, and hoppers, who swarm the fields; and the lowest beings of the feminine gender wo swagger in the streets of London."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bfc1311-0138-3039-8d8d-639b2f584930",
                                        "entry_id": "a15997be-7157-3bb8-9d53-e8afe859b28b",
                                        "glosses": [
                                            "To insert (something) surgically into the body."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b44dbd50-4b27-4705-87d2-a6bb403d5957",
                                                "sense_id": "7bfc1311-0138-3039-8d8d-639b2f584930",
                                                "text": "If you prefer a “natural look” for your male Poodle, ask your vet about a vasectomy or implanting artificial testicles (called neuticles)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87af0b3c-0bdf-322d-af02-c9030264374f",
                                        "entry_id": "a15997be-7157-3bb8-9d53-e8afe859b28b",
                                        "glosses": [
                                            "Of an embryo, to become attached to and embedded in the womb."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "implant",
