                "senses": [
                    {
                        "sense_id": "f4fb4535-2418-3638-b4cf-6477542aea78",
                        "entry_id": "f3acdd05-2502-30cf-b21f-c661952f7e79",
                        "glosses": [
                            "het expliciet benoemen (meestal met een bijvoeglijk naamwoord) van een eigenschap die al in het kernbegrip vervat zit, zodat dit inhoudelijk niets toevoegt"
                        ],
                        "tags": [
                            "stijlfiguur"
                        ],
                        "examples": [
                            {
                                "example_id": "8f9203b2-c03f-4c2e-9d8b-955776eb6608",
                                "sense_id": "f4fb4535-2418-3638-b4cf-6477542aea78",
                                "text": "\"Witte sneeuw\" is een duidelijk voorbeeld van een pleonasme."
                            },
                            {
                                "example_id": "40d05b42-0010-4dde-82c4-5836cd372f93",
                                "sense_id": "f4fb4535-2418-3638-b4cf-6477542aea78",
                                "text": "\"Eclectische potpourri\" is een subtieler voorbeeld."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57bbf98e-4498-4b91-affa-1b353a96da5e",
                        "source_entry_id": "f3acdd05-2502-30cf-b21f-c661952f7e79",
                        "source_sense_id": "f4fb4535-2418-3638-b4cf-6477542aea78",
                        "target_lang_word": "Pleonasmus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pleonasmus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d052dd3c-7f24-3c0c-8369-5289a6b965d5",
                                        "entry_id": "26a50cba-b93d-3d9c-9ebc-0e3364602fd5",
                                        "glosses": [
                                            "Verbindung bedeutungsgleicher oder -verwandter Ausdrücke (aber im Gegensatz zur Tautologie verschiedener Wortart) in einer Wortgruppe"
                                        ],
                                        "tags": [
                                            "Rhetorik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af98caa3-5d96-4071-8da9-67090aeb986b",
                                                "sense_id": "d052dd3c-7f24-3c0c-8369-5289a6b965d5",
                                                "text": "„Weißer Schimmel“ und „alter Greis“ werden von Wilpert als Beispiele für Pleonasmen angegeben."
                                            },
                                            {
                                                "example_id": "033bb162-7eaa-47a5-ac8f-549ebef0aabd",
                                                "sense_id": "d052dd3c-7f24-3c0c-8369-5289a6b965d5",
                                                "text": "„Weißer Schimmel“ und „alter Greis“ sind Beispiele für Pleonasmen, da ein Schimmel immer schon weiß und ein Greis immer schon alt ist."
                                            },
                                            {
                                                "example_id": "8c4f2b2a-3bc0-477b-931a-72fc7d978f36",
                                                "sense_id": "d052dd3c-7f24-3c0c-8369-5289a6b965d5",
                                                "text": "„Tautologien und Pleonasmen können im allgemeinen schon als Ausdruck einer pervertierten Sprache verstanden werden, insofern als sie Sprach- und Sprechschwierigkeiten des Menschen aufdecken.“"
                                            },
                                            {
                                                "example_id": "5576edae-3d44-49a6-87d3-436738e7a778",
                                                "sense_id": "d052dd3c-7f24-3c0c-8369-5289a6b965d5",
                                                "text": "„Der hier beschriebene Fall ist ein Beispiel für einen Pleonasmus, damit eng verbunden auch die Tautologie, auf welche wir später auch noch eingehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55238c40-994b-414f-85a5-e724ea84fdbc",
                        "source_entry_id": "f3acdd05-2502-30cf-b21f-c661952f7e79",
                        "source_sense_id": "f4fb4535-2418-3638-b4cf-6477542aea78",
                        "target_lang_word": "pleonasm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pleonasm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "13021526-a466-3ce9-95c4-d48da8023b24",
                                        "entry_id": "fc3b30a6-889e-3b24-9e6d-8b9e5d074e70",
                                        "glosses": [
                                            "Redundancy in wording."
                                        ],
                                        "tags": [
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16967a0f-f97d-4ec2-9314-aeaa2692e01f",
                                                "sense_id": "13021526-a466-3ce9-95c4-d48da8023b24",
                                                "text": "St. Jerome and St. Augustine are both sparing in the employment of the device of pleonasm."
                                            },
                                            {
                                                "example_id": "578bed0b-b25a-400f-a453-2ede51da62b4",
                                                "sense_id": "13021526-a466-3ce9-95c4-d48da8023b24",
                                                "text": "Indeed, pleonasm, the use of superfluous or redundant words, is only part of the broader features of that style, the expressions of which have been so thoroughly analyzed by Franz Neirynck² and which for convenience will here be referred to as \"dualisms.\""
                                            },
                                            {
                                                "example_id": "6f332293-2efb-4858-bc02-a7d4d0a9095e",
                                                "sense_id": "13021526-a466-3ce9-95c4-d48da8023b24",
                                                "text": "My salvation is in my Saviour who saveth me hence the redundancy and pleonasm of my asseveration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23c870b0-5fdc-3367-91d3-620a1722106a",
                                        "entry_id": "fc3b30a6-889e-3b24-9e6d-8b9e5d074e70",
                                        "glosses": [
                                            "A phrase involving pleonasm; a phrase containing one or more words which are redundant because their meaning is expressed elsewhere in the phrase."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7bf2c08-d93d-471b-895e-83c995902c29",
                        "source_entry_id": "f3acdd05-2502-30cf-b21f-c661952f7e79",
                        "source_sense_id": "f4fb4535-2418-3638-b4cf-6477542aea78",
                        "target_lang_word": "pléonasme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pléonasme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a683344d-2514-3f17-a4da-73fa641d2ccc",
                                        "entry_id": "558fd6fc-8f44-3e01-8690-d150881b32f6",
                                        "glosses": [
                                            "Figure de style par laquelle on redouble une expression pour la renforcer."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fb06e25-4aa6-43da-bb5a-3744bc48d952",
                                                "sense_id": "a683344d-2514-3f17-a4da-73fa641d2ccc",
                                                "text": "Ces mots font pléonasme."
                                            },
                                            {
                                                "example_id": "0679c35f-ba03-4d0a-87be-2be32aed71c9",
                                                "sense_id": "a683344d-2514-3f17-a4da-73fa641d2ccc",
                                                "text": "Les expressions : « Je l’ai vu de mes yeux, entendu de mes oreilles » sont des pléonasmes admis et fort usités."
                                            },
                                            {
                                                "example_id": "b1146502-aa9b-46ed-9abb-e54201954913",
                                                "sense_id": "a683344d-2514-3f17-a4da-73fa641d2ccc",
                                                "text": "Quand le pléonasme n’ajoute rien à la force ou à la grâce du discours, il est vicieux."
                                            },
                                            {
                                                "example_id": "67462fc1-e065-47c6-bdde-a39a2be8aa43",
                                                "sense_id": "a683344d-2514-3f17-a4da-73fa641d2ccc",
                                                "text": "Et convenir enfin que l’expression « XVIIIᵉ siècle français » est un pléonasme : le XVIIIᵉ siècle est français par définition."
                                            },
                                            {
                                                "example_id": "9fe50fb2-0840-4049-ab35-b3f2fe9f1c9f",
                                                "sense_id": "a683344d-2514-3f17-a4da-73fa641d2ccc",
                                                "text": "Le désir d’avoir plus est si fort qu’il semble consubstantiel à notre humanité. Les Grecs avaient un mot pour le nommer : pleonexia. On en perçoit encore l’écho dans nos pléonasmes, qui consistent en une surcharge de mots de même signification."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbe9de8e-d5dc-319c-869f-677db455be41",
                                        "entry_id": "558fd6fc-8f44-3e01-8690-d150881b32f6",
                                        "glosses": [
                                            "Redondance de paroles considérée comme vicieuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7edbd51e-f86f-454c-8148-499dde0a157a",
                                                "sense_id": "cbe9de8e-d5dc-319c-869f-677db455be41",
                                                "text": "[…] pas de nuances, pas de différences de qualité, pas de progression ou d’accroissement du bon sens, et parler d’un « gros » bon sens est une expression vide de sens, ou un pléonasme : le bon sens est le bon sens, qui est ce qu’il est, et jamais plus ou moins gros."
                                            },
                                            {
                                                "example_id": "1d1953c9-8a24-4dc3-a95c-026fb1c0a297",
                                                "sense_id": "cbe9de8e-d5dc-319c-869f-677db455be41",
                                                "text": "– Nous pourrions peut-être…\nCe pléonasme insidieux, que j’ai surpris sur tant de lèvres, annonçait le déchaînement des images et des hypothèses."
                                            },
                                            {
                                                "example_id": "e8945c0d-2ead-40f4-a2e2-b51b3d8bf349",
                                                "sense_id": "cbe9de8e-d5dc-319c-869f-677db455be41",
                                                "text": "Mais ce pléonasme n’est pas encore suffisant pour le peuple, qui ne craint pas de dire : au jour d’aujourd'hui. Il nous souvient même d’avoir entendu au jour du jour d’aujourd'hui. Le peuple aime le pléonasme et il dirait volontiers: Un tel, né natif de…, a au jour du jour d’aujourd’hui quarante ans d’âge."
                                            },
                                            {
                                                "example_id": "6f882b19-4809-4bf7-a4b0-cb9dc412b8eb",
                                                "sense_id": "cbe9de8e-d5dc-319c-869f-677db455be41",
                                                "text": "« Monter en haut », « descendre en bas » sont considérés comme des pléonasmes. (Pourtant quand « en haut » ou « en bas » jouent un rôle de comparatif, la redondance est nécessaire : Tu t’es arrêtée au refuge, ou tu es montée en haut ?)"
                                            },
                                            {
                                                "example_id": "ab3709fa-0f85-4045-afa3-b8305f4b89cd",
                                                "sense_id": "cbe9de8e-d5dc-319c-869f-677db455be41",
                                                "text": "« Hurler fort » ; « postulat de départ » ; « hasard imprévu » ; « nous sommes tous unanimes » ; « une panacée universelle »; « un tollé de protestations » sont des pléonasmes."
                                            }
                                        ]
                                    }
                                ]
                            },
