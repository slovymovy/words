    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "55bfb820-74f6-3076-b490-8c758d0b073b",
                "word": "intestate",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5b08957f-9575-3cc6-b9ff-3e867ec0b393",
                        "entry_id": "55bfb820-74f6-3076-b490-8c758d0b073b",
                        "glosses": [
                            "Without a valid will indicating whom to leave one's estate to after death."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b095bcda-9dc9-3e5e-bbf3-b5ac2a6a11b4",
                        "entry_id": "55bfb820-74f6-3076-b490-8c758d0b073b",
                        "glosses": [
                            "Not devised or bequeathed; not disposed of by will."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f957e9b-9b08-4dd0-b566-0aa0bbbf5097",
                        "source_entry_id": "55bfb820-74f6-3076-b490-8c758d0b073b",
                        "source_sense_description": "without a valid will",
                        "target_lang_word": "intestat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intestat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2ace92fa-e3d0-36f2-afae-87525857a39e",
                                        "entry_id": "4da22bca-a6d0-34e7-a79c-33ed7c8b1c48",
                                        "glosses": [
                                            "Qui n’a pas fait de testament."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47ddad31-6def-420b-86ec-3f211833b221",
                                                "sense_id": "2ace92fa-e3d0-36f2-afae-87525857a39e",
                                                "text": "Il y a lieu de penser, d’après la priorité donnée au droit canon sur le droit écrit, que pour la manière de compter les degrés de parenté en matière de succession intestat, on suivait, en Dombes, la supputation ecclésiastique plutôt que la supputation civile."
                                            },
                                            {
                                                "example_id": "2c095ae8-5a7e-4f76-8bda-6155a8d561c2",
                                                "sense_id": "2ace92fa-e3d0-36f2-afae-87525857a39e",
                                                "text": "Les collatéraux, manœuvrés par une nièce Hervouët, prétendent qu’Hervouët n’est pas mort intestat, et que sa veuve a fait disparaître le testament."
                                            },
                                            {
                                                "example_id": "6daa3cfb-2ea0-468b-b826-b87714d0092a",
                                                "sense_id": "2ace92fa-e3d0-36f2-afae-87525857a39e",
                                                "text": "On me prenait pour le notaire ou quelqu’un d’approchant. Mais il ne s’agissait que d’organiser les obsèques : Valorbe était mort intestat."
                                            },
                                            {
                                                "example_id": "ab4c38c2-a8db-4250-9b07-d9e95e8951d9",
                                                "sense_id": "2ace92fa-e3d0-36f2-afae-87525857a39e",
                                                "text": "Mais il est fort improbable qu’un empereur soit mort intestat. Il est tout aussi improbable que le testament fût déclaré non valide, ce qui aurait produit le même résultat."
                                            },
                                            {
                                                "example_id": "0e37fa97-5561-43f3-9932-f940e781f4d6",
                                                "sense_id": "2ace92fa-e3d0-36f2-afae-87525857a39e",
                                                "text": "Plus simplement, il refusait d'envisager sa fin : on voit ainsi, dans les familles, des vieillards obstinés mourir intestats."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "intestat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "06e7bb7c-1706-3274-b6f4-f13fe0c3f3ab",
                                        "entry_id": "8b04f538-5e1f-3633-a994-7e0b89e34c1c",
                                        "glosses": [
                                            "Personne qui n’a pas fait de testament."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b11b6e8-803b-42e7-9f2c-245d86e7793a",
                                                "sense_id": "06e7bb7c-1706-3274-b6f4-f13fe0c3f3ab",
                                                "text": "L’intestat étant considéré comme excommunié, la renaissance du testament profita dans un premier temps à l’église par le biais des legs pieux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
