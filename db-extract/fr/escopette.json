        "fr-extract.jsonl": [
            {
                "entry_id": "17b2362c-aa4a-3fa5-9124-3f0d332f129d",
                "word": "escopette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7513afaf-7fec-489b-ab77-c7d7edf64702",
                        "entry_id": "17b2362c-aa4a-3fa5-9124-3f0d332f129d",
                        "tags": [
                            "plural"
                        ],
                        "form": "escopettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "81b61b6f-b546-3f3b-b8f0-7ffa0a2112a0",
                        "entry_id": "17b2362c-aa4a-3fa5-9124-3f0d332f129d",
                        "glosses": [
                            "Arme à feu, fusil ou carabine que l’on portait ordinairement en bandoulière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6beb8177-7a8d-4f48-838f-f5c4aa987e5e",
                                "sense_id": "81b61b6f-b546-3f3b-b8f0-7ffa0a2112a0",
                                "text": "Cette première balle pensa tuer le pilote, qui riposta d’un coup d’escopette."
                            },
                            {
                                "example_id": "8c3b48c3-530e-4e48-93c3-878b76e6e356",
                                "sense_id": "81b61b6f-b546-3f3b-b8f0-7ffa0a2112a0",
                                "text": "S’il accompagnait des voyageurs son escopette sur l’épaule, pas un voleur n’eût osé les arrêter, leurs valises eussent-elles été remplies de doublons."
                            },
                            {
                                "example_id": "2a6e78c6-7323-4b23-85c0-2da3c58a2e36",
                                "sense_id": "81b61b6f-b546-3f3b-b8f0-7ffa0a2112a0",
                                "text": "Et rougeoyaient face à face la tour de Nesle, d’où le guet sortit l’escopette sur l’épaule, et la tour du Louvre, …."
                            },
                            {
                                "example_id": "83dc17fd-e18d-42d6-b737-46deb16ee197",
                                "sense_id": "81b61b6f-b546-3f3b-b8f0-7ffa0a2112a0",
                                "text": "Elle n’a conservé de la mère patrie que ses mœurs hospitalières, son intolérance religieuse, ses moines, ses guittareros et ses mendiants armés d’escopettes."
                            },
                            {
                                "example_id": "f4dc5e12-5f15-4a6f-80ad-b574bf4ab02f",
                                "sense_id": "81b61b6f-b546-3f3b-b8f0-7ffa0a2112a0",
                                "text": "Un jeune Espagnol, tenant une longue escopette avec sa fourche suspendue à son côté, et la mèche fumante dans la main droite, se promenait nonchalamment sur le rempart, et s’arrêta à considérer Cinq-Mars, qui faisait à cheval le tour des fossés et du marais."
                            },
                            {
                                "example_id": "25825518-9de5-442e-8a31-8a61893da827",
                                "sense_id": "81b61b6f-b546-3f3b-b8f0-7ffa0a2112a0",
                                "text": "Le fanatisme de la Ligue, loin de servir à la règle des mœurs, avait beaucoup contribué au relâchement. On s’était tout permis, parce qu’on avait manié l’escopette et porté le mousquet pour la bonne cause."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc7f0b75-665c-4009-9258-28aaaaf732fd",
                        "source_entry_id": "17b2362c-aa4a-3fa5-9124-3f0d332f129d",
                        "source_sense_id": "81b61b6f-b546-3f3b-b8f0-7ffa0a2112a0",
