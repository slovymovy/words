        "nl-extract.jsonl": [
            {
                "entry_id": "76422844-92ac-3eb5-b51e-7a998411f7a4",
                "word": "eveneens",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "80bd8003-c289-31c1-9d91-0bf9b11ec5b8",
                        "entry_id": "76422844-92ac-3eb5-b51e-7a998411f7a4",
                        "glosses": [
                            "ook, op dezelfde manier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acdba6ff-bab4-4516-8c77-eceeac55aa56",
                                "sense_id": "80bd8003-c289-31c1-9d91-0bf9b11ec5b8",
                                "text": "Hij is zeer geïnteresseerd in wiskunde en Nederlands en zijn vrouw en dochters eveneens."
                            },
                            {
                                "example_id": "73776ed1-0ec6-4802-bd3c-60ad719fd97c",
                                "sense_id": "80bd8003-c289-31c1-9d91-0bf9b11ec5b8",
                                "text": "Haar eveneens donkere haar droeg ze in een dikke vlecht, maar toen ze haar hoofd wendde om Harold aan te kijken, glinsterden er in de ochtendzon rode draden doorheen."
                            },
                            {
                                "example_id": "b9cd0c42-1c95-4842-aae8-780fccbeffd1",
                                "sense_id": "80bd8003-c289-31c1-9d91-0bf9b11ec5b8",
                                "text": "com, voor het eerst uitgezonden in mei 2015, gebaseerd op de documentaire Divided By Race, United By War And Peace, eveneens geproduceerd door The-Latest com)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "58d1e218-56ae-41e7-a848-54e919b9adce",
                        "source_entry_id": "76422844-92ac-3eb5-b51e-7a998411f7a4",
                        "source_sense_id": "80bd8003-c289-31c1-9d91-0bf9b11ec5b8",
                        "source_sense_description": "ook, tevens",
                        "target_lang_word": "gleichfalls",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gleichfalls",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b0f6dba-408a-3243-b30f-f9ba34b80d24",
                                        "entry_id": "4fbc7586-a446-34d4-9fca-fad9446b8b55",
                                        "glosses": [
                                            "(das) ebenfalls"
                                        ],
                                        "tags": [
                                            "bezieht sich auf das Gleiche",
                                            "das eben Gesagte"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55f13d86-f3f9-4130-8f48-76a0cc90ec73",
                                                "sense_id": "3b0f6dba-408a-3243-b30f-f9ba34b80d24",
                                                "text": "Schönes Wochenende! Danke, gleichfalls!"
                                            },
                                            {
                                                "example_id": "77e80923-8281-4056-a161-c9068336da72",
                                                "sense_id": "3b0f6dba-408a-3243-b30f-f9ba34b80d24",
                                                "text": "Das sind meine Eltern, die wollen sich gleichfalls informieren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86dc54ae-3a94-4756-88cb-eb94c56f9fda",
                        "source_entry_id": "76422844-92ac-3eb5-b51e-7a998411f7a4",
                        "source_sense_id": "80bd8003-c289-31c1-9d91-0bf9b11ec5b8",
                        "source_sense_description": "ook, tevens",
                        "target_lang_word": "ebenfalls",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ebenfalls",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "af99534f-63a9-3ddb-862a-5e19bb758e66",
                                        "entry_id": "b96ceba8-315f-30be-9215-0011d7ba61d3",
                                        "glosses": [
                                            "auch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad6644c1-09a4-4ae4-b62c-9281950ff1e9",
                                                "sense_id": "af99534f-63a9-3ddb-862a-5e19bb758e66",
                                                "text": "Ich werde ebenfalls nach Hause gehen."
                                            },
                                            {
                                                "example_id": "c37064aa-4cf4-4829-876a-4827c5468cf9",
                                                "sense_id": "af99534f-63a9-3ddb-862a-5e19bb758e66",
                                                "text": "„Auf gestickte Monogramme sollte man ebenfalls verzichten, denn künftige Lebensabschnittsgefährten schlafen nicht gerne in Bettbezügen mit den Initialen ihrer Vorgänger.“"
                                            },
                                            {
                                                "example_id": "e85277e6-b63f-4c86-9eb1-461818595294",
                                                "sense_id": "af99534f-63a9-3ddb-862a-5e19bb758e66",
                                                "text": "„Er stellte sich dann ebenfalls neben das Pult, schlug die Hacken zusammen und verbeugte sich leicht.“"
                                            },
                                            {
                                                "example_id": "e13ef2df-7f78-4e98-a25c-f82dd39db29f",
                                                "sense_id": "af99534f-63a9-3ddb-862a-5e19bb758e66",
                                                "text": "„Ähnliches deutet sich für das Obereichsfeld an, das nach dem Willen der Erfurter Landesregierung ebenfalls mit den Nachbarkreisen fusionieren soll.“"
                                            },
                                            {
                                                "example_id": "c39b3b98-f3da-47eb-bb1e-653e9a3330c5",
                                                "sense_id": "af99534f-63a9-3ddb-862a-5e19bb758e66",
                                                "text": "„Im geistlichen Kurfürstentum Köln hatten inzwischen ebenfalls die Hexenprozesse sich zu häufen begonnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c9af3b5-7dff-4439-ba6a-06fa625d40e5",
                        "source_entry_id": "76422844-92ac-3eb5-b51e-7a998411f7a4",
                        "source_sense_id": "80bd8003-c289-31c1-9d91-0bf9b11ec5b8",
                        "source_sense_description": "ook, tevens",
                        "target_lang_word": "également",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "également",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "98598b13-b0cf-3778-b00c-4ba2e5037ea5",
                                        "entry_id": "c6533891-8f7a-3e10-a48f-46c902fd9c02",
                                        "glosses": [
                                            "Aussi."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "39435806-a278-3e5a-97d0-bed21c979f66",
                                        "entry_id": "c6533891-8f7a-3e10-a48f-46c902fd9c02",
                                        "glosses": [
                                            "Aussi.",
                                            "D’une façon similaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7419de29-5919-4ffd-866d-7cfdd3fba750",
                                                "sense_id": "39435806-a278-3e5a-97d0-bed21c979f66",
                                                "text": "Les grands festivals annuels en Bretagne constituent les vitrines de promotion de toute cette culture populaire : le FIL de Lorient, la Cornouaille de Quimper, la Lune de Landerneau, les Étonnants voyageurs de Saint-Malo, les (nouvelles) Vieilles charrues de Carhaix et son salon du livre breton, également en plein développement."
                                            },
                                            {
                                                "example_id": "09ea0b32-184e-4cad-b6d1-44c69b103519",
                                                "sense_id": "39435806-a278-3e5a-97d0-bed21c979f66",
                                                "text": "L'acide chlorhydrique est chassé après l'épaillage par un courant d'air chaud également sous pression […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e515131-c532-3a9f-82d2-7086657b7645",
                                        "entry_id": "c6533891-8f7a-3e10-a48f-46c902fd9c02",
                                        "glosses": [
                                            "Aussi.",
                                            "Par ailleurs, de plus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b99e274-b83e-4f05-8f0b-fa5f39179ae7",
                                                "sense_id": "0e515131-c532-3a9f-82d2-7086657b7645",
                                                "text": "Des expériences analogues ont démontré ultérieurement que les nerfs vagues renferment également des nerfs sécréteurs innervant le pancréas."
                                            },
                                            {
                                                "example_id": "a6282424-060e-423a-b333-b52c10e21a81",
                                                "sense_id": "0e515131-c532-3a9f-82d2-7086657b7645",
                                                "text": "Qui plus est, alors que la loi stipulait pour la première fois que les enfants nés de parents ayant résidé huit ans en Allemagne et détenteurs d'un statut de résidence permanent bénéficiaient de la nationalité allemande, elle stipulait également qu'ils devaient abandonner leur deuxième nationalité à leur dix-huitième anniversaire, faute de quoi ils perdraient la nationalité allemande."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c79ca180-266a-3d6b-ae01-b8b2804d220b",
                                        "entry_id": "c6533891-8f7a-3e10-a48f-46c902fd9c02",
                                        "glosses": [
                                            "D’une manière égale, en proportions identiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6da44892-a316-4ede-93cc-3771e9c84e46",
                                                "sense_id": "c79ca180-266a-3d6b-ae01-b8b2804d220b",
                                                "text": "J'étais au désespoir de voir que dans toute la terre, qui appartient également aux hommes, la destinée ne m'eût pas réservé ma portion."
                                            },
                                            {
                                                "example_id": "2c329cf7-9326-4693-b975-2dd8f1463ba1",
                                                "sense_id": "c79ca180-266a-3d6b-ae01-b8b2804d220b",
                                                "text": "Qu'on ne nous demande donc plus de quoi ils vivaient. Ils vivaient d'industrie; ils vivaient dans une alternative de détresse et d'abondance également flétrissantes."
                                            },
                                            {
                                                "example_id": "478bf88d-4ad1-45fa-817d-31590f0b0a99",
                                                "sense_id": "c79ca180-266a-3d6b-ae01-b8b2804d220b",
                                                "text": "Les herbes, nourriture première des herbivores, sont de qualité différente selon les lieux qui les produisent, et les fourrages ne sont pas également composés partout."
                                            },
                                            {
                                                "example_id": "b233876f-f032-4b01-b8b6-fdfc32faf624",
                                                "sense_id": "c79ca180-266a-3d6b-ae01-b8b2804d220b",
                                                "text": "La fin du XIXᵉ siècle a connu deux géants de la lexicographie, Pierre Larousse et Émile Littré qui ont fait des choix opposés et également féconds. L'un a fait un grand dictionnaire encyclopédique, l'autre un grand dictionnaire de langue."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "également",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "991aa19d-90e4-3cec-ba7b-a26a8cc9b524",
                                        "entry_id": "f25ceecd-f2a0-31d8-9d95-5cfa48d1e550",
                                        "glosses": [
                                            "Distribution préalable, faite avant le partage entre héritiers, pour compenser les dotations anticipées faites aux bénéfices de certains héritiers."
                                        ],
                                        "tags": [
                                            "Jurisprudence ancienne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b08b1612-dee3-4cf3-92be-a2d57c10f1d8",
                                                "sense_id": "991aa19d-90e4-3cec-ba7b-a26a8cc9b524",
                                                "text": "Donner à ceux qui ont reçu moins un également tel qu’ils aient autant que celui qui a reçu le plus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
