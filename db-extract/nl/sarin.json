                        "examples": [
                            {
                                "example_id": "4f2d240b-8e69-43f4-b253-853eb1413381",
                                "sense_id": "5e54cca4-0198-3c78-a7ee-502feea1fbe5",
                                "text": "‘Al het beschikbare bewijsmateriaal doet ons besluiten dat de Syrische machthebbers een luchtbom met sarin in Khan Sheikhoun hebben gebruikt’, besloot het rapport. De chemische aanval in Khan Sheikhoun kostte minstens 83 mensen het leven, waaronder naar schatting 27 kinderen. Meer dan 300 gewonden hadden verzorging nodig."
                            },
                            {
                                "example_id": "9e8f503f-bdfc-430c-a9b5-446fa41477a6",
                                "sense_id": "5e54cca4-0198-3c78-a7ee-502feea1fbe5",
                                "text": "De Indonesische Siti Aisyah en de Vietnamese Thi Huong worden ervan beschuldigd Kim Jung Nam op de luchthaven van Kuala Lumpur een chemische substantie in het gezicht te hebben gesmeerd. Het gaat om het zenuwgas XV, een zwaardere versie van het zeer giftige Sarin."
                            }
                        ]
                    }
