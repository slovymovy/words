        "fr-extract.jsonl": [
            {
                "entry_id": "0d3826b2-a1f9-3b40-bc42-e8c5dfedab48",
                "word": "capitonnage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1b0a3c87-86bc-4e66-bd91-fe39ea7571c7",
                        "entry_id": "0d3826b2-a1f9-3b40-bc42-e8c5dfedab48",
                        "tags": [
                            "plural"
                        ],
                        "form": "capitonnages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1e93a57f-f321-3c95-9510-fee1797197b9",
                        "entry_id": "0d3826b2-a1f9-3b40-bc42-e8c5dfedab48",
                        "glosses": [
                            "Action de capitonner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "178801e5-46ef-4564-a43b-a138bad75d60",
                                "sense_id": "1e93a57f-f321-3c95-9510-fee1797197b9",
                                "text": "Dans certaines applications, par exemple pour les enceintes acoustiques, il est nécessaire d’augmenter ces pertes, et les moyens d’y parvenir sont précisément le capitonnage des parois internes ou le rembourrage par des matériaux absorbants poreux ou fibreux."
                            }
                        ]
                    },
                    {
                        "sense_id": "62b26e2f-d161-3c32-ae83-7bf37252a403",
                        "entry_id": "0d3826b2-a1f9-3b40-bc42-e8c5dfedab48",
                        "glosses": [
                            "Substance qui capitonne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cabbc15d-3513-4060-a774-b5c027810abb",
                                "sense_id": "62b26e2f-d161-3c32-ae83-7bf37252a403",
                                "text": "Sur la couchette au capitonnage écarlate, il y avait deux couvertures et un kodak, et, dans un coin, au fond de la nacelle, un gobelet et une bouteille de champagne vide."
                            },
                            {
                                "example_id": "4c44b14e-4059-45d0-ae5c-4a723f6a10dd",
                                "sense_id": "62b26e2f-d161-3c32-ae83-7bf37252a403",
                                "text": "Il s’approchait du canapé et, méthodiquement, sans se hâter, avec une habileté parfaite, il entreprenait de sonder le capitonnage du meuble."
                            },
                            {
                                "example_id": "2b951a1c-4148-433f-bca2-1913f200c27b",
                                "sense_id": "62b26e2f-d161-3c32-ae83-7bf37252a403",
                                "text": "Le motard découvrit ce qu’il cherchait dans l’une des poches pratiquées dans le capitonnage des portières et, sans se donner la peine de procéder à une vérification, il dégonfla les pneus de la traction de quatre coups de poinçon, ramassa le couteau, réenfourcha sa machine et fila."
                            }
                        ]
                    }
                ],
