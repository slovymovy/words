                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "17626fb9-9d9e-34ca-8fd8-11e206c6fbf2",
                        "entry_id": "b9bcbc0d-37c6-32ab-ae37-9549d32bad96",
                        "glosses": [
                            "die aus [1] gewonnenen Bastfasern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d0d594d-bedc-4c33-ad8e-96b32abe63dc",
                                "sense_id": "17626fb9-9d9e-34ca-8fd8-11e206c6fbf2",
                                "text": "Mit dem Slogan „Jute statt Plastik!“ warb die Umweltbewegung für ein umweltbewusstes Einkaufsverhalten."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23045a80-47f6-4bd3-bc82-bd6163b225b4",
                        "source_entry_id": "b9bcbc0d-37c6-32ab-ae37-9549d32bad96",
                        "source_sense_id": "64eeec19-2a28-3759-8213-d5eb848d58c8",
                        "source_sense_description": "Botanik: Pflanze aus der Gattung Corchorus, aus der Fasern zur Textilherstellung gewonnen werden",
                        "target_lang_word": "jute",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jute",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a1c4fb04-929d-3e16-8669-793f8f4cca2c",
                                        "entry_id": "25c9045b-a680-31e9-a613-e16bd567d9da",
                                        "glosses": [
                                            "Qui concerne les Jutes, peuple germanique de la mer du Nord localisé aux premiers siècles de l’ère chrétienne dans la partie méridionale de la péninsule du Jutland, au Danemark."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "jute",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d88b9055-961a-3f0c-b134-f232ecefa789",
                                        "entry_id": "1cdbff41-f0f3-3896-9bd2-5e883809b72c",
                                        "glosses": [
                                            "Malvacée cultivée dans les régions tropicales pour ses fibres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25806f04-1722-417a-b7a1-775403afc910",
                                                "sense_id": "d88b9055-961a-3f0c-b134-f232ecefa789",
                                                "text": "La matière première est le jute, sorte de jonc très-textile qui croît en Bengale; du Bengale on l’apporte en Angleterre, où la Hollande va le chercher pour le tisser chez elle et le reporter ensuite aux Indes Orientales […] sous forme de sacs, qu’on remplit de café."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "387cef74-5bbe-39d9-a6f1-ccf53272453e",
                                        "entry_id": "1cdbff41-f0f3-3896-9bd2-5e883809b72c",
                                        "glosses": [
                                            "Fibre de cette plante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4453f9f-d3f0-47f7-86d5-781edb5ac1c5",
                                                "sense_id": "387cef74-5bbe-39d9-a6f1-ccf53272453e",
                                                "text": "Il a été envoyé dans l’Inde où il devait acheter le jute… Mais si vous ne savez pas ce que c’est qu’une cannetière, vous ne devez pas connaître le jute ?\n— Une herbe ?\n— Un chanvre, un grand chanvre qu’on récolte aux Indes et qu’on file, qu’on tisse, qu’on teint dans les usines de Maraucourt ; c’est le jute qui a fait la fortune de M. Vulfran Paindavoine."
                                            },
                                            {
                                                "example_id": "c644ac42-0c56-4dce-a579-f93f90aa25ab",
                                                "sense_id": "387cef74-5bbe-39d9-a6f1-ccf53272453e",
                                                "text": "Les tiges du Corchorus textilis servent de matière première aux tissus de jute. À la récolte, ses tiges atteignent près de 3 mètres de haut. Elles sont soumises à un rouissage en eau stagnante, et décortiquées pour extraire de longs filaments vigoureux. Ces fibres sont ensuite tendues et séchées rapidement au soleil avant d’être tissées en toile rustique."
                                            },
                                            {
                                                "example_id": "e8b69bad-6779-4e90-9fbb-f85cb50466ba",
                                                "sense_id": "387cef74-5bbe-39d9-a6f1-ccf53272453e",
                                                "text": "Nous nous chauffons au bois et au charbon. […] Des dizaines de sacs, en toile de jute crasseuse, portés par deux hommes au visage de ténèbres où seul le blanc des dents et des yeux jette un peu d’humanité."
                                            },
                                            {
                                                "example_id": "a64d56ca-f462-43cb-8a68-009aceeddbce",
                                                "sense_id": "387cef74-5bbe-39d9-a6f1-ccf53272453e",
                                                "text": "On est vraiment mieux d'y aller avec le jute, qui va se biodégrader dans le fond du lac, tandis que la toile synthétique, il faut la retirer du lac après quelques mois et la nettoyer."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jute",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a6037f3-3866-35f0-a39f-52761c54e9d2",
                                        "entry_id": "5d8b75f7-91a5-36c8-abe1-d143cd884f50",
                                        "glosses": [
                                            "Langue morte, autrefois parlée dans le Jutland."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "jute",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ae2d5279-beb2-3381-8095-be893bfefbbb",
                                        "entry_id": "fd57b317-d239-3da7-80a4-6b889105deb0",
                                        "glosses": [
                                            "Sperme, foutre."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2dbc19b4-d2d2-4e31-87be-3f18dc830130",
                                                "sense_id": "ae2d5279-beb2-3381-8095-be893bfefbbb",
                                                "text": "C’est ensuite un concours de jute où les chasseurs s’appliquent à viser nos visages pour juter."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jute",
                                "target_lang_code": "fr",
