                        "entry_id": "dcd6265a-10c4-354e-a1a3-7696343ed965",
                        "glosses": [
                            "nicht mehr erwerbstätige Frau, die Leistungen aus einer Altersversorgung bezieht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b62c541-eaa0-49a6-8e8e-117d65479f4d",
                                "sense_id": "9ab2c7fc-4390-3bf0-b3b7-736af7be2372",
                                "text": "„Auf die pünktliche Lieferung sei sie angewiesen, sagt die Pensionistin: ‚Ich habe ja Rechnungen zu bezahlen.‘“"
                            },
                            {
                                "example_id": "f9c50d2d-c4b5-4f06-a2f0-1436cfd15402",
                                "sense_id": "9ab2c7fc-4390-3bf0-b3b7-736af7be2372",
                                "text": "„Eine hilfsbereite Pensionistin eilt herbei, nimmt mir die Münzen ab und versenkt sie gekonnt im Gerät.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
