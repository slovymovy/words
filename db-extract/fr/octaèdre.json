        "fr-extract.jsonl": [
            {
                "entry_id": "6aa126b9-398e-3f33-b7f2-0e84cbd97166",
                "word": "octaèdre",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a1e18ebf-6ac7-4061-9962-5cb8369004cd",
                        "entry_id": "6aa126b9-398e-3f33-b7f2-0e84cbd97166",
                        "tags": [
                            "plural"
                        ],
                        "form": "octaèdres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "69d88466-39c9-3b30-9b5c-527610912e3c",
                        "entry_id": "6aa126b9-398e-3f33-b7f2-0e84cbd97166",
                        "glosses": [
                            "Corps solide à huit faces."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "662bdf96-6ef7-4043-be1a-50a042639b6e",
                                "sense_id": "69d88466-39c9-3b30-9b5c-527610912e3c",
                                "text": "L’acide oxalique concentré donne, avec les liqueurs contenant du strontium, à chaud des cristaux monocliniques ; à froid des octaèdres mêlés de tables pseudo-rectangulaires, à extinctions monocliniques."
                            }
                        ]
                    },
                    {
                        "sense_id": "b8418a28-c764-3660-b041-5138d7e84727",
                        "entry_id": "6aa126b9-398e-3f33-b7f2-0e84cbd97166",
                        "glosses": [
                            "Octaèdre régulier, dont les faces font huit triangles équilatéraux."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "95ac5c6f-03ad-437f-b7c3-b1ccbb71a5b8",
                                "sense_id": "b8418a28-c764-3660-b041-5138d7e84727",
                                "text": "Quand il est régulier (ses faces et les angles qui les séparent sont alors identiques), on parle de solide platonicien. Il existe cinq solides platoniciens distincts, le tétraèdre, le cube, l’octaèdre, le dodécaèdre et l’icosaèdre qui comportent respectivement 4, 6, 8, 12 et 20 côtés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eaf64666-098a-4298-9871-60be482bf65b",
                        "source_entry_id": "6aa126b9-398e-3f33-b7f2-0e84cbd97166",
                        "target_lang_word": "Oktaeder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Oktaeder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "24a197be-9a75-32fd-af4a-4849358e3645",
                                        "entry_id": "6de8ce8f-6ce7-3888-b9b2-797e7e09be04",
                                        "glosses": [
                                            "Körper mit acht gleichseitigen Dreiecken als Seitenflächen"
                                        ],
                                        "tags": [
                                            "geometry"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e650963f-316f-4bf4-b3e6-853374164e0f",
                                                "sense_id": "24a197be-9a75-32fd-af4a-4849358e3645",
                                                "text": "Die Lehrerin trug ihren Schülern auf, das Netz eines Oktaeders zu zeichnen."
                                            },
                                            {
                                                "example_id": "581f3aaa-df33-48ef-9734-96d9db10b65d",
                                                "sense_id": "24a197be-9a75-32fd-af4a-4849358e3645",
                                                "text": "Der Oktaeder ist dual zum regelmäßigen Hexaeder."
                                            },
                                            {
                                                "example_id": "dfb494a5-dcd2-45c6-b352-304b6f0ae5bf",
                                                "sense_id": "24a197be-9a75-32fd-af4a-4849358e3645",
                                                "text": "„Die aufgefundenen Erzbrocken ließen auf Vorkommen von ziemlich reinem und fettem Eisenoxydul schließen, das in Oktaedern kristallisiert war; das gleiche sogenannte Magneteisen wird in den Gruben Schwedens und Norwegens gewonnen und ist der Rohstoff für das Qualitätseisen Europas.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec5ce5b3-8e64-4630-8489-0fceb30aeba2",
                        "source_entry_id": "6aa126b9-398e-3f33-b7f2-0e84cbd97166",
