                "senses": [
                    {
                        "sense_id": "10e4caaa-5a07-3b0b-b58c-617cefcab169",
                        "entry_id": "85f294f5-a070-358c-a71a-2c6c368b2360",
                        "glosses": [
                            "Genre d’insectes hyménoptères proches des guêpes, comprenant, dans le monde entier, de très nombreuses espèces sociales, dont le corps est noir et jaune et qui construisent des nids dépourvus d’enveloppe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79eae739-6375-42dc-9296-4e2d724a9fe7",
                                "sense_id": "10e4caaa-5a07-3b0b-b58c-617cefcab169",
                                "text": "La poliste n'est pas une butineuse, c'est un insecte carnivore qui fait la chasse. Elle poursuit sans cesse les larves, les chenilles, et les mouches et autres diptères qui constituent sa nourriture, qu'elle capture et met en pièces pour les manger ensuite."
                            },
                            {
                                "example_id": "75e0cda4-d794-4a9d-a930-e5428aff2a8c",
                                "sense_id": "10e4caaa-5a07-3b0b-b58c-617cefcab169",
                                "text": "C’est une de nos guêpes familières. La poliste française a deux taches jaunes circulaires dans la partie antérieure de l’abdomen."
                            },
                            {
                                "example_id": "bb747fc2-47ca-47c0-8917-ea3e61f007f3",
                                "sense_id": "10e4caaa-5a07-3b0b-b58c-617cefcab169",
                                "text": "Les polistes sont de couleur jaune et noire. Elles sont longues et sveltes et possèdent des pattes plus longues que chez les autres guêpes (figures 1 à 3)."
                            }
                        ]
                    }
                ],
