                    },
                    {
                        "translation_id": "4dd30c67-d6cb-4749-a211-7a8ccb74e108",
                        "source_entry_id": "aa4903fe-26a7-3530-90c8-4dc77152805e",
                        "source_sense_description": "Élément chimique",
                        "target_lang_word": "terbium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "terbium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99a99c99-4537-3bdd-9c8e-2bf0ebf4c10b",
                                        "entry_id": "dde9ec30-a628-32bf-9730-f767948f996f",
                                        "glosses": [
                                            "A metallic chemical element (symbol Tb) with an atomic number of 65: a soft, silvery-white, rare earth metal that is malleable and ductile."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38b5fb93-8002-4e97-8206-61711723c0bc",
                                                "sense_id": "99a99c99-4537-3bdd-9c8e-2bf0ebf4c10b",
                                                "text": "Myanmar is the world's third-largest source of rare earths after China and the US, and last year it accounted for almost half of the global mining of two especially important elements: dysprosium and terbium, which are essential for electric vehicles, wind turbines and certain military gear. […] The most important application of dysprosium and terbium, which belong to a subgroup known as the heavy rare earths, is in devices called neodymium boron magnets, or neo magnets for short. In small quantities, dysprosium and terbium allow neo magnets to operate at far higher temperatures than they otherwise could. Thus improved, they're key components in the drivetrains of EVs; the stronger the magnets, the more efficient an electric motor can be. They can also enhance the rotation of wind turbines and are used in the precision targeting systems of missiles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
