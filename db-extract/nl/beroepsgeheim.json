                            {
                                "example_id": "dff103ec-a05c-4429-b809-a9149d756c6b",
                                "sense_id": "be7cf489-8091-3a1d-b140-e21b847522af",
                                "text": "Schending van het beroepsgeheim is strafbaar volgens art. 272 van het Wetboek van Strafrecht."
