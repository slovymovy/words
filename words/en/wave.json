                        "zh": "人群中人们依次站起坐下以产生涟漪效应的集体活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "волна",
                                "target_lang_sense_clarification": "на стадионе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "人浪",
                                "target_lang_sense_clarification": "体育场活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f64e120-9c92-3864-bb60-a35c9e5beb41",
                    "sense_definition": "The sea or ocean.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "water_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship sailed across the blue <w>wave</w>.",
                            "target_lang_translations": {
                                "ru": "Корабль плыл по синим <w>волнам</w>.",
                                "zh": "船只航行在蓝色的<w>波涛</w>之上。"
                            }
                        },
                        {
                            "text": "Many sailors have been lost beneath the <w>wave</w>.",
                            "target_lang_translations": {
                                "ru": "Многие моряки сгинули в морской <w>пучине</w>.",
                                "zh": "许多水手都葬身于<w>波涛</w>之下。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "literary or poetic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Море или океан (поэтическое).",
                        "zh": "海洋（诗意用法）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "волна",
                                "target_lang_sense_clarification": "поэтическое"
                            },
                            {
                                "target_lang_word": "пучина",
                                "target_lang_sense_clarification": "морская бездна"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "波涛",
                                "target_lang_sense_clarification": "文学用语"
                            }
                        ]
                    }
