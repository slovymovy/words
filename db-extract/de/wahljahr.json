                        "entry_id": "4d92e8b9-a9c0-3cf5-bc5b-b3b1609daf6b",
                        "glosses": [
                            "Jahr, in dem in einem Staat eine Wahl stattfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4df5e79-dc86-4b71-99fe-59542ebba9ee",
                                "sense_id": "791468fc-69b7-36ed-bc80-8949c2cfbec6",
                                "text": "„Es ist das Duell, das so kaum noch einer erwartet hat – und das dieses Wahljahr 2017 spannend machen könnte.“"
                            },
                            {
                                "example_id": "ebf28bfa-9107-4fbd-88bf-0b3e677b279f",
                                "sense_id": "791468fc-69b7-36ed-bc80-8949c2cfbec6",
                                "text": "„Man denkt im Wahljahr nun mal verstärkt an die Wähler, und bei denen ist der Grexit populär.“"
                            }
                        ],
