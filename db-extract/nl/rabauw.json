                "senses": [
                    {
                        "sense_id": "1a68ce70-f07b-3169-99cb-6b7c7981f672",
                        "entry_id": "d3c6f180-7cf4-3569-92d2-f68540bd3d31",
                        "glosses": [
                            "ruw persoon van het minste allooi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6cb00a9-6873-4bcb-a993-5f9ff441a9ac",
                                "sense_id": "1a68ce70-f07b-3169-99cb-6b7c7981f672",
                                "text": "We zeggen: koning Salomon, we zijn het beu geregeerd te worden door uitleggers, prietpraters, omhooggevallen heikneuters of amechtigaards die macht en positie wensen om labiliteiten in hun psychologische evenwicht te herstellen. Wij willen niet langer dat de macht is voor de patsers of de gesofisticeerde rabauwen of de pauwen of de graaiers."
                            },
                            {
                                "example_id": "d8d5bd89-2b0c-4188-9a1f-77ee6e9f03c4",
                                "sense_id": "1a68ce70-f07b-3169-99cb-6b7c7981f672",
                                "text": "De contrecoeur gesupprimeerde annuele anonie van fleemkous Freriks strandt in fikfakken met die rabauw van een omroepgouverneur."
                            }
                        ]
                    },
                    {
