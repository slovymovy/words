                "senses": [
                    {
                        "sense_id": "cbe9b8fc-f80c-3cf2-8875-75e8ba2596c6",
                        "entry_id": "c1940cb8-afd3-3cd9-b756-a6581e4d88e6",
                        "glosses": [
                            "Bereitschaft, eine Gefahr/ein Risiko einzugehen"
                        ],
                        "tags": [
                            "Wirtschaftsjargon"
                        ],
                        "examples": [
                            {
                                "example_id": "79e45ba6-c2b3-4ecf-8379-64107c69ffa7",
                                "sense_id": "cbe9b8fc-f80c-3cf2-8875-75e8ba2596c6",
                                "text": "„Man unterscheidet drei Typen der Risikoeinstellung: Risikofreude (auch Risikosympathie), Risikoneutralität und Risikoscheu (auch Risikoaversion).“"
                            },
                            {
                                "example_id": "4f7ec4b8-2304-4d21-89d3-a5ecde9517a6",
                                "sense_id": "cbe9b8fc-f80c-3cf2-8875-75e8ba2596c6",
                                "text": "„Risikosympathie hingegen tritt beispielsweise bei Glückspielern aber auch bei Börsenspekulanten auf.“"
                            },
                            {
                                "example_id": "8ae47370-37bd-4727-a0bb-bd545bddc0ec",
                                "sense_id": "cbe9b8fc-f80c-3cf2-8875-75e8ba2596c6",
                                "text": "„Risikosympathie liegt vor, wenn der Erwartungswert des Nutzens größer ist als der Nutzen des Erwartungswertes, bei Risikoaversion verhält es sich umgekehrt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
