                "senses": [
                    {
                        "sense_id": "b79c59a9-5c9a-3345-9c8e-dedb0b1e5af5",
                        "entry_id": "98ed2181-7320-3d40-8185-c01696869fce",
                        "glosses": [
                            "candelabrum, girandole"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4066a924-9cd0-43e2-a24d-d5a5dcff7d2b",
                                "sense_id": "b79c59a9-5c9a-3345-9c8e-dedb0b1e5af5",
                                "text": "Им отвели́ большо́й, тё́плый кабине́т, кра́сный с зо́лотом, с то́лстым светло-зелё́ным ковро́м на полу́, с канделя́брами в угла́х и на столе́.",
                                "translation": "A big, warm cabinet was given them, in red and gold with a thick, bright green carpet on the floor, with sconces in the corners and on the table.",
                                "english": "A big, warm cabinet was given them, in red and gold with a thick, bright green carpet on the floor, with sconces in the corners and on the table."
                            },
                            {
                                "example_id": "4a0ecf5f-a231-4580-923c-4737fa674803",
                                "sense_id": "b79c59a9-5c9a-3345-9c8e-dedb0b1e5af5",
                                "text": "Па́льцы Поли́ны сло́вно све́чи в канделя́брах ноче́й,\nСлё́зы Поли́ны преврати́лись в бесконе́чный руче́й.",
                                "translation": "Nautilus Pompilius",
                                "english": "Nautilus Pompilius"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
