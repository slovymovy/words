                                "target_senses": [
                                    {
                                        "sense_id": "6d943e1c-c77b-3181-822d-cf576aacaf7d",
                                        "entry_id": "89e27509-af74-3378-9c68-a207d495798b",
                                        "glosses": [
                                            "A person who swindles, cheats or defrauds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3ced64a-cc6b-42cc-8c76-a7c33a5aec03",
                                                "sense_id": "6d943e1c-c77b-3181-822d-cf576aacaf7d",
                                                "text": "But I got somethin’ to say bearin’ on that swindler who got what was comin’ to him."
                                            },
                                            {
                                                "example_id": "9416d523-bc56-4266-b443-b93f128a220f",
                                                "sense_id": "6d943e1c-c77b-3181-822d-cf576aacaf7d",
                                                "text": "There’s good reason to worry. In an earlier memoir, “Five-Finger Discount,” Stapinski recreated the terrifying world of swindlers, embezzlers, burglars and mobster wannabes who made up her extended Jersey City family."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e292749-ddfe-49e4-b2de-6d4323c41b51",
                        "source_entry_id": "77e6c73f-4e23-32df-9fa2-24059d2b61b8",
                        "source_sense_id": "acbb3daf-8147-3a08-a896-301cfda3f959",
                        "source_sense_description": "iemand die door misleiding een buitensporige betaling voor iets weet te verkrijgen",
                        "target_lang_word": "escroc",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "escroc",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "52045b4e-8364-3f7f-b1a7-e4dd3c19397e",
                                        "entry_id": "95705870-2ef0-312b-8e08-92c49107a0b2",
                                        "glosses": [
                                            "Celui ou celle qui escroque, qui a l’habitude d’escroquer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eecbb514-5831-4d25-803c-65cf0d86812a",
                                                "sense_id": "52045b4e-8364-3f7f-b1a7-e4dd3c19397e",
                                                "text": "Ce Mario Isolino, qui, simple escroc d’abord, était devenu, au moins par l’intention, un assassin."
                                            },
                                            {
                                                "example_id": "55d0b751-7fe6-4668-a526-5384417af48d",
                                                "sense_id": "52045b4e-8364-3f7f-b1a7-e4dd3c19397e",
                                                "text": "De tout temps, en effet, la fille, héroïne de tant de vieux romans, fut la protectrice, la compagne, la consolation du grec, du voleur, du tire-laine, du filou, de l’escroc."
                                            },
                                            {
                                                "example_id": "fc8d35b3-23b8-47e6-a157-15365d67cbda",
                                                "sense_id": "52045b4e-8364-3f7f-b1a7-e4dd3c19397e",
                                                "text": "Al Capin’s méritait son nom. Essayer de me vendre, à ce prix, un pin’s de chat ! Parole, en me prenant pour un pigeon, il tombait mal, cet escroc."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
