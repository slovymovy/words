                        "sense_id": "727a16a7-2508-3e48-aeaf-387323e80b44",
                        "entry_id": "53b7fc2a-60fd-3990-8aad-214400583ef6",
                        "glosses": [
                            "a farming business, a business engaged in agriculture (e.g. a farm, a breeder, a fish nursery)"
                        ],
                        "tags": [
                            "neuter"
                        ],
                        "examples": [
                            {
                                "example_id": "129f23b0-dcbc-46d9-8ef7-115a6a374d11",
                                "sense_id": "727a16a7-2508-3e48-aeaf-387323e80b44",
                                "text": "Dit landbouwbedrijf is gespecialiseerd in biologische producten.",
                                "translation": "This farming business specializes in organic products.",
                                "english": "This farming business specializes in organic products."
                            },
                            {
                                "example_id": "2658ce0a-0bc6-4dfc-895d-82a85fb01cd6",
                                "sense_id": "727a16a7-2508-3e48-aeaf-387323e80b44",
                                "text": "Het landbouwbedrijf heeft te lijden gehad onder de droogte dit jaar.",
                                "translation": "The farm has suffered from the drought this year.",
                                "english": "The farm has suffered from the drought this year."
                            },
                            {
                                "example_id": "1b896469-4c95-4cfa-a011-cbfcec229264",
                                "sense_id": "727a16a7-2508-3e48-aeaf-387323e80b44",
                                "text": "Het landbouwbedrijf wil zijn activiteiten uitbreiden naar viskwekerij.",
                                "translation": "The agricultural business wants to expand its operations into fish farming.",
                                "english": "The agricultural business wants to expand its operations into fish farming."
                            }
                        ]
                    }
