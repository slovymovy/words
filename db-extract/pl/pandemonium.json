                "translations": [
                    {
                        "translation_id": "3eb93548-c661-48f7-89d6-e2dee5635662",
                        "source_entry_id": "a0a33606-0c12-322f-81ef-e7c3d8203723",
                        "source_sense_id": "d398b6f3-5346-33a4-bdec-7f7b7e6793ba",
