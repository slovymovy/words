                ],
                "senses": [
                    {
                        "sense_id": "0213d14b-1215-38a5-9c0e-012a93a4a9fa",
                        "entry_id": "8039b808-e488-3ddc-824d-c217b72fdb96",
                        "glosses": [
                            "angenehmes, nicht übermäßig herausforderndes Tempo, bei dem sich eine Person körperlich wohlfühlt und nicht überanstrengt wird"
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "8a7264c8-5582-4d5e-b732-07c93e6a1330",
                                "sense_id": "0213d14b-1215-38a5-9c0e-012a93a4a9fa",
                                "text": "„Die Läufe haben keinen Wettkampfcharakter, jeder Teilnehmer/in läuft das persönliche Wohlfühltempo, auf eine Zeitnahme wird bewusst verzichtet, weil das gemeinschaftliche Erleben im Vordergrund stehen soll.“"
                            },
                            {
                                "example_id": "714aa0d4-dda1-4b13-98b5-5054572113fa",
                                "sense_id": "0213d14b-1215-38a5-9c0e-012a93a4a9fa",
                                "text": "„Gelaufen wird im ‚Wohlfühltempo‘ mit kurzen Gehpausen, die nach und nach mit fortschreitender Fitness reduziert werden.“"
                            },
                            {
                                "example_id": "df7c5cdf-5dd4-4ff7-b3e1-33fef6d0b8d4",
                                "sense_id": "0213d14b-1215-38a5-9c0e-012a93a4a9fa",
                                "text": "„Es gibt Tage, an denen dein Puls schon zu Beginn des Ausdauertrainings in die Höhe schießt, obwohl du dich noch in deinem Wohlfühltempo befindest.“"
                            },
                            {
                                "example_id": "0cdc047e-1412-4ed1-a342-4e519b78eb6e",
                                "sense_id": "0213d14b-1215-38a5-9c0e-012a93a4a9fa",
                                "text": "„Für alle laufbegeisterten Hobbysportler ist es viel wichtiger, das individuelle Wohlfühltempo zu finden.“"
                            },
                            {
                                "example_id": "15a3a3fb-30a1-4757-901b-d51533f8cb3d",
                                "sense_id": "0213d14b-1215-38a5-9c0e-012a93a4a9fa",
                                "text": "„Ich bin gut gelaunt, fühle mich fit und merke, dass die Truppe um mich herum ein bisschen langsamer als mein Wohlfühltempo unterwegs ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
