                        "glosses": [
                            "Theaterbühne, die für die Vorführung experimenteller Stücke vorgesehen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "958bc349-dfff-40b1-a5c4-f1d946a498e6",
                                "sense_id": "1a51a80e-29c6-3c1b-9865-74a40f521c1e",
                                "text": "„Schon beim Einlass in die Experimentierbühne prasselte Höllenlärm auf die Zuschauer nieder, betäubt sank man auf den nächstbesten Platz.“"
                            },
                            {
                                "example_id": "a8782288-d1bb-44d7-ba89-af91221e5ebf",
                                "sense_id": "1a51a80e-29c6-3c1b-9865-74a40f521c1e",
                                "text": "„Nicht umsonst haben alle nennenswerten Theater Probebühnen, kleine Experimentierbühnen, aber auch die ‚großen Häuser‘ für Schauspiel- und Regiekunst, zeigen also beides, These und Synthese.“"
                            }
