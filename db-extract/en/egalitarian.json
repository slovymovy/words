                                                "example_id": "f0c30e4c-b1c2-4600-9a7e-bb40db780d04",
                                                "sense_id": "998e2e90-ed74-3990-bfae-0288130f4c7b",
                                                "text": "in dit tijdperk van hebzucht zijn er niet veel meer met egalitaire opvattingen"
