                            {
                                "example_id": "608c22a2-8e00-4a77-8316-a7509ba8b5c4",
                                "sense_id": "5016d509-55db-3a2e-b03d-f6dd997d3302",
                                "text": "„Hierhin gehören jene Optimisten, deren ganze Antikritik des Socialismus, wenn sie sich auf ihrer Höhe überhaupt dazu herablassen, darin besteht, daß sie den doch nicht zu läugnenden Uebeln gegenüber nur auf ein Recept verweisen: nur noch immer ‚mehr freie Concurrenz‘ verlangen.“"
                            }
                        ],
