                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15ceb7e6-608b-4bfc-a108-02760dabc583",
                                "sense_id": "36b354ec-4447-30d2-8be0-803d0824b887",
                                "text": "I was angry with my bubble-brained antics and my waddlesome sloth, with my guides, with the thunder, with this stupid maze of rocks."
                            },
                            {
                                "example_id": "d5170ca6-edd2-47ae-b834-4c5b1b0f7288",
                                "sense_id": "36b354ec-4447-30d2-8be0-803d0824b887",
                                "text": "Thru-hiking the AT, he wrote in the opening pages of the ensuing book, would get me fit after years of waddlesome sloth."
                            },
                            {
                                "example_id": "2323f01a-d2b6-4c54-aa27-47f5dc76bdb2",
                                "sense_id": "36b354ec-4447-30d2-8be0-803d0824b887",
                                "text": "Beholding his waddlesome approach out of the tail of her eye, the white animal would whinny a dignified and conservative welcome."
                            }
                        ]
                    }
                ],
