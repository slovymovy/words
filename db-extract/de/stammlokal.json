                "senses": [
                    {
                        "sense_id": "ec3d5cd1-3be8-3bac-859f-116212f432fc",
                        "entry_id": "f51a402a-5b62-3ee6-9ec3-8f3ee3066b40",
                        "glosses": [
                            "öffentliche Gaststätte, welche von einer bestimmten Person regelmäßig besucht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f76dfd4-7d45-450e-b0e9-ed2af6e1b4f2",
                                "sense_id": "ec3d5cd1-3be8-3bac-859f-116212f432fc",
                                "text": "Sonntags gehe ich immer in mein Stammlokal."
                            },
                            {
                                "example_id": "2e28fd22-6e14-4fef-b912-5da53e044d96",
                                "sense_id": "ec3d5cd1-3be8-3bac-859f-116212f432fc",
                                "text": "„An einer Ecke der place Clichy befindet sich das Café Wepler, das lange Zeit mein Stammlokal war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c7cfd79-1f79-41e6-a63a-133d52b01588",
                        "source_entry_id": "f51a402a-5b62-3ee6-9ec3-8f3ee3066b40",
                        "source_sense_id": "ec3d5cd1-3be8-3bac-859f-116212f432fc",
                        "source_sense_description": "öffentliche Gaststätte, welche von einer bestimmten Person regelmäßig besucht wird",
                        "target_lang_word": "favourite pub",
