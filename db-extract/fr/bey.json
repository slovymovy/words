                                        "glosses": [
                                            "титул родоплеменной и феодальной знати, военное и административное звание должностных лиц (правителей областей, военачальников и т. п.)"
                                        ],
                                        "tags": [
                                            "в странах Ближнего и Среднего Востока, а также у тюркских народов Средней Азии и Закавказья"
                                        ],
                                        "examples": [
                                            {
