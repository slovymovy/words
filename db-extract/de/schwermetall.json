                        "source_entry_id": "8802ea18-3323-39b5-8adb-c2404df48e3f",
                        "source_sense_id": "eb141ffe-7a07-38dd-ac65-3c1b46c484de",
                        "source_sense_description": "Metall mit großer Dichte",
                        "target_lang_word": "métal lourd",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "métal lourd",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6ee554f4-c915-385c-963a-1833aec1500a",
                                        "entry_id": "950462a8-1ee6-34b0-811b-50b15e43c708",
                                        "glosses": [
                                            "Élément métallique caractérisé par une masse volumique supérieure à 5 g/cm³."
                                        ],
                                        "tags": [],
                                        "note": "La définition peut varier selon les auteurs",
                                        "examples": [
                                            {
                                                "example_id": "4ca8f5ed-74f8-466b-802d-1ba704ef844c",
                                                "sense_id": "6ee554f4-c915-385c-963a-1833aec1500a",
                                                "text": "On appelle métaux lourds les éléments métalliques naturels caractérisés par une masse volumique élevée, supérieure à 5 g/cm³ ou parfois 4 g/cm³."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "775cbdd8-f686-32c6-a704-16e0a55a6425",
                                        "entry_id": "950462a8-1ee6-34b0-811b-50b15e43c708",
                                        "glosses": [
                                            "Élément-trace métallique, ETM."
                                        ],
                                        "tags": [
                                            "Environnement",
                                            "Appellation abusive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "014322dc-ae33-4988-9b3e-83f1cb6123e6",
                                                "sense_id": "775cbdd8-f686-32c6-a704-16e0a55a6425",
                                                "text": "Si les métaux lourds sont au nombre de 41, les éléments traces métalliques suivants sont les plus contrôlés."
                                            },
                                            {
                                                "example_id": "3ce04956-cde7-48e8-bc97-379ceb7893bc",
                                                "sense_id": "775cbdd8-f686-32c6-a704-16e0a55a6425",
                                                "text": "Les métaux lourds peuvent affecter la vie marine au-delà d’une certaine concentration, et rendre impropres certains produits de la mer à la consommation humaine."
                                            },
                                            {
                                                "example_id": "73cb5834-d9aa-4234-8c28-7a0374388654",
                                                "sense_id": "775cbdd8-f686-32c6-a704-16e0a55a6425",
                                                "text": "Le Haut Conseil souligne qu'il faut privilégier les aliments cultivés « selon des modes de production diminuant l'exposition aux pesticides pour les fruits et légumes, les légumineuses, les produits céréaliers complets, et de varier les espèces et les lieux d'approvisionnement pour les poissons » (à cause de la présence possible de métaux lourds)."
                                            },
                                            {
                                                "example_id": "4b788565-a3af-4947-968b-92318547fb78",
                                                "sense_id": "775cbdd8-f686-32c6-a704-16e0a55a6425",
                                                "text": "La concentration des métaux lourds dans les poissons carnivores du sommet de la chaîne alimentaire est un autre problème lié aux pollutions industrielles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
