        "fr-extract.jsonl": [
            {
                "entry_id": "dbed9fe4-41d5-3212-9a8a-cb45ce4dabe0",
                "word": "cardiaque",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "24b3be81-75f9-4d67-a1cc-0053e1ab86b8",
                        "entry_id": "dbed9fe4-41d5-3212-9a8a-cb45ce4dabe0",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "cardiaques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c534f9c4-9279-33e7-9487-9d9221105a44",
                        "entry_id": "dbed9fe4-41d5-3212-9a8a-cb45ce4dabe0",
                        "glosses": [
                            "Relatif au cœur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5351abab-7148-4238-b4ee-071e6611bbfe",
                                "sense_id": "c534f9c4-9279-33e7-9487-9d9221105a44",
                                "text": "Plus rarement, il existe des troubles cardiaques très marqués : petitesse et fréquence extrême du pouls, lipothymies et syncopes."
                            },
                            {
                                "example_id": "3d8c14a2-e88c-43e6-a9dd-74abb4bab419",
                                "sense_id": "c534f9c4-9279-33e7-9487-9d9221105a44",
                                "text": "Bien que souffrant d’une néphrite chronique avec complications cardiaques, il ne voulut pas consentir à prendre le moindre repos, […]."
                            },
                            {
                                "example_id": "b37e9336-d349-4903-a7d2-3b3be8b584da",
                                "sense_id": "c534f9c4-9279-33e7-9487-9d9221105a44",
                                "text": "Le phosphure de zinc employé comme rodenticide puissant produit en général des lésions nécrotiques ou rénales et entraîne la mort par défaillance cardiaque."
                            }
                        ]
                    },
                    {
                        "sense_id": "62537306-40d4-3daf-b88b-429b9c4daade",
                        "entry_id": "dbed9fe4-41d5-3212-9a8a-cb45ce4dabe0",
                        "glosses": [
                            "Ce qui appartient au cœur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d04b92b7-6066-438f-9673-c2063ad836c0",
                                "sense_id": "62537306-40d4-3daf-b88b-429b9c4daade",
                                "text": "On admet généralement que le nerf vague agit, non pas sur le muscle cardiaque, mais sur les ganglions intracardiaques, parce que le cœur arrêté par tétanisation du nerf vague se contracte encore si on l'excite directement."
                            },
                            {
                                "example_id": "822ae884-5197-4c7f-a69d-58a90b0b250e",
                                "sense_id": "62537306-40d4-3daf-b88b-429b9c4daade",
                                "text": "Artères, veines cardiaques. Nerfs cardiaques."
                            }
                        ]
                    },
                    {
                        "sense_id": "94ea17b9-21a9-3cf5-b4b6-261abe6aeb5c",
                        "entry_id": "dbed9fe4-41d5-3212-9a8a-cb45ce4dabe0",
                        "glosses": [
                            "Qui soigne le cœur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a13fd9ca-6915-44df-b4ad-1a4a90a5444b",
                                "sense_id": "94ea17b9-21a9-3cf5-b4b6-261abe6aeb5c",
                                "text": "remède cardiaque, médicament tonique ou stimulant dont l’action se porte sur le cœur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11ce7348-64e7-431a-ba35-77031685a600",
                        "source_entry_id": "dbed9fe4-41d5-3212-9a8a-cb45ce4dabe0",
                        "target_lang_word": "herzkrank",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "herzkrank",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f733790-8ef0-3668-8621-9e6794db5ede",
                                        "entry_id": "3e13f207-6c41-33af-b1ac-8e66de3c890b",
                                        "glosses": [
                                            "eine Erkrankung des Herzens aufweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6379827d-6736-429d-8f91-a4f9bdfb8f0b",
                                                "sense_id": "8f733790-8ef0-3668-8621-9e6794db5ede",
                                                "text": "„Auf seiner Homepage hat der Verein die Geschichte vieler herzkranker Kinder online gestellt.“"
                                            },
                                            {
                                                "example_id": "beb17c8b-f076-4d41-a1e1-2832339a0e51",
                                                "sense_id": "8f733790-8ef0-3668-8621-9e6794db5ede",
                                                "text": "„Héctor wohnt in der Schusslinie, mit seiner Frau, zwei Töchtern, eine davon herzkrank, und seiner an Alzheimer erkrankten Schwiegermutter.“"
                                            },
                                            {
                                                "example_id": "e72369ad-3b22-420f-9f82-1035b4fc1059",
                                                "sense_id": "8f733790-8ef0-3668-8621-9e6794db5ede",
                                                "text": "„Wer herzkrank ist, neigt eher zu Depressionen.“"
                                            },
                                            {
                                                "example_id": "8b46bcb8-68e0-4a0d-9260-34a9bc9bdae0",
                                                "sense_id": "8f733790-8ef0-3668-8621-9e6794db5ede",
                                                "text": "„Besonders die Klara, die doch herzkrank … und jetzt auch noch ohne Mutter …“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
