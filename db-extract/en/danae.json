                                    {
                                        "sense_id": "a3a20297-ee2c-35d2-ab25-11d45c03cdde",
                                        "entry_id": "b084558a-dccc-3fd3-a503-15cd25721b6a",
                                        "glosses": [
                                            "Fille d’Acrisios, roi d’Argos, et d’Eurydice, est la mère de Persée, et l’amante de Jupiter."
                                        ],
                                        "tags": [
                                            "Mythologie grecque"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d46fa5f9-3305-44ad-8cff-a1169707d0db",
                                                "sense_id": "a3a20297-ee2c-35d2-ab25-11d45c03cdde",
                                                "text": "Cette science de prodigalité, tous ces efforts étaient dépensés pour paraître grand à madame Marneffe, pour être le Jupiter de cette Danaé bourgeoise."
                                            },
                                            {
                                                "example_id": "9123b646-efd4-4888-adc8-ea32ef42580b",
                                                "sense_id": "a3a20297-ee2c-35d2-ab25-11d45c03cdde",
                                                "text": "Elle s’offrait sans défense, tout son corps étalé, demi-nue et pâmée sous le ciel enflammé, comme une Danaé ! Je me crus Jupiter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f583d14-0e5f-36ef-af61-e4676b6dec80",
                                        "entry_id": "b084558a-dccc-3fd3-a503-15cd25721b6a",
                                        "glosses": [
                                            "Astéroïde de la ceinture principale découvert par Hermann Goldschmidt, le 9 septembre 1860, à Paris."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
