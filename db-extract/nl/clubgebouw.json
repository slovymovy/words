                        "glosses": [
                            "gebouw waar leden van een club regelmatig bijeenkomen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "573036f8-a572-4e79-9cd8-8ccfbe1b8a2a",
                                "sense_id": "6db14ec3-7217-308c-be0f-89675c7e2f55",
                                "text": "De Haarlemse voetbalclub Young Boys heeft zijn bestuur weggestuurd. Reden is de politie-inval van woensdagnacht in het clubgebouw, waar op dat moment een illegale pokeravond werd gehouden."
                            },
                            {
                                "example_id": "73ad1194-b223-4507-ba20-00cf35f5f8a3",
                                "sense_id": "6db14ec3-7217-308c-be0f-89675c7e2f55",
                                "text": "Vandaag was de eerste van vier zittingen in de strafzaak tegen twaalf leden van Satudarah. De meesten van hen werden in oktober gearresteerd bij een inval in het clubgebouw in Zundert."
                            }
                        ]
                    }
