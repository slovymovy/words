                                "target_senses": [
                                    {
                                        "sense_id": "e033e5dd-2bb6-3359-8b8f-9d81eea537b0",
                                        "entry_id": "ddb7a03a-c570-3d09-bdab-46cd441fbf4f",
                                        "glosses": [
                                            "The block of programming on television during the middle of the evening, usually between 7:00 pm and 11:00 pm."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "876a620c-046b-38c5-8960-9a874cadba22",
                                        "entry_id": "ddb7a03a-c570-3d09-bdab-46cd441fbf4f",
                                        "glosses": [
                                            "The busiest or most important period."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b79aeef-4409-4536-b4bd-9d38f6271e63",
                                                "sense_id": "876a620c-046b-38c5-8960-9a874cadba22",
                                                "text": "Mass-produced mithai are readily available online, but these five independent shops make their sweets by hand every day, offering their local South Asian communities a taste of the familiar. Diwali is their prime time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be4b0985-1d7b-35a0-8a99-a1840683efb4",
                                        "entry_id": "ddb7a03a-c570-3d09-bdab-46cd441fbf4f",
                                        "glosses": [
                                            "Maturity; the state at which a person or product will be accepted by the mainstream."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "301fa7d8-7704-4407-941c-15dd31b939c2",
                                                "sense_id": "be4b0985-1d7b-35a0-8a99-a1840683efb4",
                                                "text": "It took years longer than proponents had hoped, but wireless data is ready for prime time."
                                            },
                                            {
                                                "example_id": "ebd8ebf5-6362-4748-8991-6e88ba61f901",
                                                "sense_id": "be4b0985-1d7b-35a0-8a99-a1840683efb4",
                                                "text": "Can these measures be regarded as useful, promising, or not ready for prime time? We focus only on the utility of these measures for use by policymakers."
                                            },
                                            {
                                                "example_id": "4f2f8f59-741a-41bf-a15f-546d9a72b99a",
                                                "sense_id": "be4b0985-1d7b-35a0-8a99-a1840683efb4",
                                                "text": "Now, as more and more businesses re-orient themselves to serve the consumer, ethnography has entered prime time."
                                            },
                                            {
                                                "example_id": "a2f7123e-c1a6-4268-8156-4f083b03df8d",
                                                "sense_id": "be4b0985-1d7b-35a0-8a99-a1840683efb4",
                                                "text": "And as with commodity-based models, tour-based models have also not yet reached prime time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bb61598-3a99-35d3-b2a5-19674fef567f",
                                        "entry_id": "ddb7a03a-c570-3d09-bdab-46cd441fbf4f",
                                        "glosses": [
                                            "Spring."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1f6cd229-6f41-30f0-bbd7-966c495ba8f1",
                                        "entry_id": "ddb7a03a-c570-3d09-bdab-46cd441fbf4f",
                                        "glosses": [
                                            "A new period or time of youthfulness; the beginning of something."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
