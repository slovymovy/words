                "senses": [
                    {
                        "sense_id": "6ee31b69-8201-3213-a6c1-4fb999240e28",
                        "entry_id": "a64ad88b-0450-398e-90ad-79045d1c22b5",
                        "glosses": [
                            "Able to be sexually penetrated; available as a target for copulation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "843e5f1f-2342-4a8d-9e2b-e6c6652ddbab",
                                "sense_id": "6ee31b69-8201-3213-a6c1-4fb999240e28",
                                "text": "Here damn is also presented as a play on the word dam, that is, a copulable female."
                            },
                            {
                                "example_id": "50a8117f-c2f3-480d-bc15-97027dc0c698",
                                "sense_id": "6ee31b69-8201-3213-a6c1-4fb999240e28",
                                "text": "The prominent American anthropologist Donald Symons endorses these 'new' theories. For over two decades he too has promoted the 'Darwinian truth' that the human female, just by existing, and being 'continuously copulable', triggers in every passing male the desire to pursue 'easy, anonymous, impersonal, unencumbered sex' with an 'endless succession' of them."
                            },
                            {
                                "example_id": "10fb44e6-5d89-4ad9-abc8-6803d3b24821",
                                "sense_id": "6ee31b69-8201-3213-a6c1-4fb999240e28",
                                "text": "Many female primates (including women) are considered to be \"continuously copulable,\" meaning that copulation can take place anytime, not just at certain points in the estrus cycle."
                            },
                            {
                                "example_id": "bbfc9d2d-befc-4fc0-9900-9e428b9928c4",
                                "sense_id": "6ee31b69-8201-3213-a6c1-4fb999240e28",
                                "text": "Beach goes on to say, \"Although human females are not continuously 'sexually receptive,' they are continuously 'copulable'; and their sexual arousability does not depend on ovarian hormones."
                            }
                        ]
                    },
                    {
                        "sense_id": "ac95210d-f4b6-3196-b4a8-a58f3e0bea09",
                        "entry_id": "a64ad88b-0450-398e-90ad-79045d1c22b5",
                        "glosses": [
                            "Able to engage in sexual reproduction."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "f428692a-5ad8-45d9-96a3-fc47c058dc1c",
                                "sense_id": "ac95210d-f4b6-3196-b4a8-a58f3e0bea09",
                                "text": "Those which produce copulable copulants in one individual are designated as monoecious, while those in which copulable copulants must come from different individuals are considered dioecious."
                            }
                        ]
                    }
                ],
