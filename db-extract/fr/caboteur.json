                        "sense_id": "749172a0-a20e-3067-b650-63c46f7fcf89",
                        "entry_id": "314522b7-f140-3a88-96c6-c4486e800fa8",
                        "glosses": [
                            "Marin qui fait le cabotage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af291bce-cccc-4bf5-bd4d-4f18a42fca32",
                                "sense_id": "749172a0-a20e-3067-b650-63c46f7fcf89",
                                "text": "Edmond était devenu aussi habile caboteur qu’il était autrefois hardi marin ;"
                            }
                        ]
                    },
                    {
                        "sense_id": "9b585592-7afa-3696-adb0-749ff57e7b53",
                        "entry_id": "314522b7-f140-3a88-96c6-c4486e800fa8",
                        "glosses": [
                            "Navire côtier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9275f97-6c55-4964-92f0-807d1f5a8b57",
                                "sense_id": "9b585592-7afa-3696-adb0-749ff57e7b53",
                                "text": "Effectivement, un beau matin l’Utile, petit caboteur qui fait le service de l’île, appareilla, l’emporta avec toute sa famille, et nous revint avec un autre régisseur."
                            },
                            {
                                "example_id": "41111778-a0bb-4bda-8ebc-7ed7d73d6c9a",
                                "sense_id": "9b585592-7afa-3696-adb0-749ff57e7b53",
                                "text": "C’est là qu’ils s'étaient réunis, entrechoquaient leurs verres pleins d’une rude eau-de-vie ou des petits vins de Bordeaux apportés sur ces côtes par les caboteurs."
                            }
                        ]
                    }
