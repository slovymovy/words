                        "examples": [
                            {
                                "example_id": "40ec9411-cbfc-491a-abcf-287906a56946",
                                "sense_id": "e3279647-7abd-390c-8b59-981eca3e4cd9",
                                "text": "„Stetige Verbesserungen der Rauscharmut der Verstärkerelektronik und der Dioden lassen Auflösungen im Bereich von 50 eV erhoffen.“"
                            },
                            {
                                "example_id": "6c599c05-5767-4a28-ba43-cfa10a028c77",
                                "sense_id": "e3279647-7abd-390c-8b59-981eca3e4cd9",
                                "text": "„Aber im Verein mit dem Real Photo Prozessor III wird doch bis zu der noch bei voller Bildgröße einzustellenden Empfindlichkeit von ISO 3200 eine erstaunliche Rauscharmut erreicht.“"
                            },
                            {
                                "example_id": "49af3cec-8eb5-4aa6-8ac2-eb1efcdbe7fd",
                                "sense_id": "e3279647-7abd-390c-8b59-981eca3e4cd9",
                                "text": "„Astronomische CCD-Kameras sind das Beste, was an Empfindlichkeit und Rauscharmut des CCDs für Astronomen zu bekommen ist.“"
                            }
