                ],
                "senses": [
                    {
                        "sense_id": "c9a05ad8-3b49-3e14-a5f0-d181c89b34f4",
                        "entry_id": "d95ced11-02f8-311e-8971-72c955967a34",
                        "glosses": [
                            "römische Göttin des häuslichen Herdes und Herdfeuers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0c45107-3f56-44a0-8e61-b4acf1083d6b",
                                "sense_id": "c9a05ad8-3b49-3e14-a5f0-d181c89b34f4",
                                "text": "Vesta ist die Tochter des Gottes Saturn und der Göttin Ops und Schwester des Göttervaters Jupiter."
                            },
                            {
                                "example_id": "565e1b6a-a6b5-4744-a95c-132d74e8e74a",
                                "sense_id": "c9a05ad8-3b49-3e14-a5f0-d181c89b34f4",
                                "text": "Dieselben Verhältnisse finden wir in Rom, wo die Göttin des Herdfeuers Vesta hieß."
                            },
                            {
                                "example_id": "a6881564-92b3-4203-8115-677b77b0faf6",
                                "sense_id": "c9a05ad8-3b49-3e14-a5f0-d181c89b34f4",
                                "text": "Sechs jungfräuliche Priesterinnen, die Vestalinnen, hüteten Tag und Nacht das heilige Feuer im Tempel der Vesta am Forum."
                            },
                            {
                                "example_id": "e17492af-8ce5-45f5-8e05-698995198030",
                                "sense_id": "c9a05ad8-3b49-3e14-a5f0-d181c89b34f4",
                                "text": "Am Hauptfest der Göttin Vesta, den Vestalia vom 7. bis 15. Juni, zogen die römischen Frauen mit entblößten Füßen zu ihrem Tempel."
                            },
                            {
                                "example_id": "de859f25-b31b-4c51-8644-50b78f023e2e",
                                "sense_id": "c9a05ad8-3b49-3e14-a5f0-d181c89b34f4",
                                "text": "Wenn die höchsten Würdenträger des römischen Staates ihr Amt antraten oder niederlegten, verbanden sie diesen Anlass mit einem Opfer im Tempel der Vesta."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3822e1ce-517f-39e1-a9ec-b585670287cf",
                        "entry_id": "d95ced11-02f8-311e-8971-72c955967a34",
                        "glosses": [
                            "Planetoid mit zirka 516 Kilometer mittlerem Durchmesser, der die Sonne im Asteroidengürtel zwischen den Planeten Mars und Jupiter umkreist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68322b0f-a356-4ccf-9c09-aa430d9178dc",
                                "sense_id": "3822e1ce-517f-39e1-a9ec-b585670287cf",
                                "text": "Vesta wurde am 29. März 1807 von Heinrich Wilhelm Olbers in Bremen als vierter Asteroid entdeckt."
                            },
                            {
                                "example_id": "195866a4-8e7e-455c-842d-9b52fab8b9fa",
                                "sense_id": "3822e1ce-517f-39e1-a9ec-b585670287cf",
                                "text": "Mehr als ein Jahr umkreiste die Nasa-Sonde \"Dawn\" den Asteroiden Vesta."
                            },
                            {
                                "example_id": "85a00f7a-02d6-44d3-ad15-1bd301f0e0a5",
                                "sense_id": "3822e1ce-517f-39e1-a9ec-b585670287cf",
                                "text": "Vesta hat einen Eisenkern wie die großen erdähnlichen Planeten."
                            },
                            {
                                "example_id": "277e8989-e0c2-4e8c-8d8c-a9069b2e4afa",
                                "sense_id": "3822e1ce-517f-39e1-a9ec-b585670287cf",
                                "text": "Vesta ist mit 525,4 Kilometer Durchmesser und 2,6 · 10²⁰ Kilogramm Masse ein vergleichsweise großes Exemplar - bei der Masse wird sie nur vom Zwergplaneten Ceres übertroffen."
                            },
                            {
                                "example_id": "31cf64bc-fb1b-413c-96de-6541f221d0bd",
                                "sense_id": "3822e1ce-517f-39e1-a9ec-b585670287cf",
                                "text": "Das letzte Stündlein von Vesta hätte fast geschlagen: Als ein kosmischer Irrläufer in den Himmelskörper krachte, fehlte nur wenig zum Supercrash."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
