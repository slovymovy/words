                "senses": [
                    {
                        "sense_id": "481dc9ae-741f-30ca-8a85-4f58dc673b68",
                        "entry_id": "dd93380c-fec5-349c-9e4d-d8dbdf544036",
                        "glosses": [
                            "Vorgang, bei dem etwas aufgezeigt, deutlich gemacht wird; das Aufzeigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4bb23d5-e388-4523-8a70-31a693783270",
                                "sense_id": "481dc9ae-741f-30ca-8a85-4f58dc673b68",
                                "text": "„Mit dem Aufweis des Irrationalen in jeder wissenschaftlichen Welterklärung geht es ihm darum zu zeigen, daß eine umfassende Weltsicht letztlich nicht ohne den selbst irrationalen Glauben auskommt.“"
                            },
                            {
                                "example_id": "11982238-63ba-4a05-9e31-77d8058ff634",
                                "sense_id": "481dc9ae-741f-30ca-8a85-4f58dc673b68",
                                "text": "„Maxwell selbst hielt dabei durchaus an der Gültigkeit des Zweiten Hauptsatzes fest; es ging ihm nur um den Aufweis einer Schwierigkeit bei der Verbindung von Mechanik und Thermodynamik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
