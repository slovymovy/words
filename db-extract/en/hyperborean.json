                        "glosses": [
                            "One of a race of people living in the extreme north, beyond the north wind."
                        ],
                        "tags": [
                            "Greek",
                            "capitalized",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "a8e9a0fe-531d-4125-9035-3512afaf2fed",
                                "sense_id": "152b5400-fda6-3d96-b6b3-2025e1cf0f76",
                                "text": "The Hyperboreans venerated Apollo over the other gods."
                            }
                        ]
                    },
                    {
                        "sense_id": "24e2cfc2-83d0-33aa-b60c-65fb345ecc50",
                        "entry_id": "e2a47a60-d304-3280-ac8b-c996606255a1",
                        "glosses": [
                            "Any person living in a northern country, or to the north."
                        ],
                        "tags": [
                            "humorous",
                            "usually"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7bbb5521-791c-47b2-86d1-634bf15d8f6b",
                        "source_entry_id": "e2a47a60-d304-3280-ac8b-c996606255a1",
                        "source_sense_description": "(Greek mythology), one a race of people living in the extreme north",
                        "target_lang_word": "Hyperboréen",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hyperboréen",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9855debc-fc16-3324-b3bd-cf4ebaa50252",
                                        "entry_id": "25854a98-99e4-3024-8db7-b743c5668004",
                                        "glosses": [
                                            "Population celtique du nord-ouest de l’Europe."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75abf11a-218d-440e-b60d-fc687c19a14d",
                                                "sense_id": "9855debc-fc16-3324-b3bd-cf4ebaa50252",
                                                "text": "Or il est remarquable qu’Apollon est le dieu grec qui a le plus de rapport avec les Celtes. On disait qu’il s'était réfugié chez les Hyperboréens, nom que les Grecs avant le IVᵉ siècle donnaient aux populations celtiques du nord-ouest de l’Europe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "749fe54a-393e-3819-a226-e7db93a5b833",
                                        "entry_id": "25854a98-99e4-3024-8db7-b743c5668004",
                                        "glosses": [
                                            "Membre d'un peuple mythique de l'Antiquité, vivant à l'extrême nord. Habitant ou originaire d'Hyperborée, leur territoire."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9f74941-f447-4e59-b450-d196dd0bb1a8",
                                                "sense_id": "749fe54a-393e-3819-a226-e7db93a5b833",
                                                "text": "De pesants Hyperboréens appellent légers ceux qui te servent… Une pambéotie redoutable, une ligue de toutes les sottises, étend sur le monde un couvercle de plomb, sous lequel on étouffe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
