                "senses": [
                    {
                        "sense_id": "4fed6e56-1236-33f6-ac89-453e98eac5d8",
                        "entry_id": "ee32020f-8859-3714-a5ce-f2475b42420d",
                        "glosses": [
                            "symbolischer Preis, den der Verlierer erhält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9db4f2fd-0ae9-4410-b4ef-86042c239df1",
                                "sense_id": "4fed6e56-1236-33f6-ac89-453e98eac5d8",
                                "text": "Mit dem Trostpreis war Ralf nicht zufrieden, lieber hätte er das Spiel gewonnen."
                            },
                            {
                                "example_id": "f6a844f8-9fb8-4f46-9e2d-1b57ac34c9e0",
                                "sense_id": "4fed6e56-1236-33f6-ac89-453e98eac5d8",
                                "text": "Der Sieger erhielt eine Medaille, und die anderen Teilnehmer des Wettbewerbs gingen mit einem Trostpreis nach Hause."
                            },
                            {
                                "example_id": "c12185bd-8da9-4d04-9cea-2d550b92aa08",
                                "sense_id": "4fed6e56-1236-33f6-ac89-453e98eac5d8",
                                "text": "Der Hauptpreis ist schon verlost, aber es sind noch jede Menge Trostpreise zu vergeben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e296d301-3a65-438a-8202-fc65eda9841a",
                        "source_entry_id": "ee32020f-8859-3714-a5ce-f2475b42420d",
                        "source_sense_id": "4fed6e56-1236-33f6-ac89-453e98eac5d8",
                        "source_sense_description": "symbolischer Preis, den der Verlierer erhält",
                        "target_lang_word": "consolation prize",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consolation prize",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "040f7102-181e-34f2-8057-1cde5ff22c0e",
                                        "entry_id": "b96110ab-8e21-3306-9b5f-6d2df730ffa3",
                                        "glosses": [
                                            "An award or small item given to persons or groups of people who do not win an event but are worthy of recognition, especially in a game show."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "963bb2ba-8ccc-48b8-a6f1-adc7366622f3",
                                                "sense_id": "040f7102-181e-34f2-8057-1cde5ff22c0e",
                                                "text": "The row started over who will run for parliament in a wealthy rightwing constituency on the left bank in Paris, a safe seat for Sarkozy's ruling UMP. Dati is already a local mayor in the neighbourhood, a job felt to have been handed to her on a plate when she was a Sarkozy favourite. She has since fallen from grace, and when she left government she took a European parliament seat, considered a consolation prize."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "05be3995-4477-4ee1-b793-5c14e75511ac",
                        "source_entry_id": "ee32020f-8859-3714-a5ce-f2475b42420d",
                        "source_sense_id": "4fed6e56-1236-33f6-ac89-453e98eac5d8",
