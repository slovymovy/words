                            {
                                "target_word": "Sofia",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0f8a137e-8345-3c40-b0ee-2beedb43199b",
                                        "entry_id": "8e9be7d0-d30e-32e0-85d8-0cb33cf8bee1",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcb4dbbd-b994-471d-a7b9-e4a2ddb2801f",
                                                "sense_id": "0f8a137e-8345-3c40-b0ee-2beedb43199b",
                                                "text": "– Vraiment, Sofia, ne pourriez-vous un peu changer votre répertoire ?"
                                            },
                                            {
                                                "example_id": "4f68bcb9-209f-4f62-a198-5b017c636698",
                                                "sense_id": "0f8a137e-8345-3c40-b0ee-2beedb43199b",
                                                "text": "C’est Sofia Essaïdi qui rejoint la troupe, en enfilant la blouse d’une patronne d’usine durant la Première Guerre mondiale."
                                            },
                                            {
                                                "example_id": "5fa5c6c1-add5-4905-ac44-49e684577a61",
                                                "sense_id": "0f8a137e-8345-3c40-b0ee-2beedb43199b",
                                                "text": "Selon l’égyptologue biomédicale Sofia Aziz, le souverain égyptien aurait perdu la vie dans un accident de char dû à une conduite sous l’emprise de l’alcool."
                                            }
                                        ]
                                    }
                                ]
                            }
