            {
                "entry_id": "4382dec7-18f5-37ea-959e-8cc8ae44796a",
                "word": "cruciverbiste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3881ee76-1bbe-4ea8-ab3a-fbd87de35b15",
                        "entry_id": "4382dec7-18f5-37ea-959e-8cc8ae44796a",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
