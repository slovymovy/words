                        "glosses": [
                            "Système à la fois patriarcal et capitaliste."
                        ],
                        "tags": [
                            "neologism",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "c372f6a1-c01f-4e2d-9729-90425b1206d9",
                                "sense_id": "6a62aa18-37b5-3828-b87e-41a1313c3ae8",
                                "text": "Si la place médiatique est offerte à ces féminismes, c’est peut-être qu’ils caressent bien gentiment, chacun à leur façon, le patriarcapitalisme."
                            },
                            {
                                "example_id": "7d5bfc73-9468-47ee-aa2e-97f5dbacd42d",
                                "sense_id": "6a62aa18-37b5-3828-b87e-41a1313c3ae8",
                                "text": "L’État étant considéré comme un support du patriarcapitalisme, il n’est pas question de passer par la loi ou les élections pour transformer la société."
                            }
                        ]
                    }
