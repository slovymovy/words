                {
                    "sense_id": "012f951e-fc0d-3801-802e-74b99db291de",
                    "sense_definition": "Nouer ou attacher de nouveau quelque chose qui était défait ou cassé.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'arrête un instant au bord du chemin pour <w>renouer</w> ses lacets défaits.",
                            "target_lang_translations": {
                                "en": "He stops for a moment at the side of the path to <w>retie</w> his untied shoelaces.",
                                "ru": "Он на минуту останавливается на краю тропинки, чтобы <w>завязать</w> развязанные шнурки.",
                                "de": "Er bleibt einen Moment am Wegrand stehen, um seine offenen Schnürsenkel <w>zuzubinden</w>.",
                                "es": "Se detiene un momento al borde del camino para <w>atar</w> sus cordones desatados.",
                                "zh": "他在小路边停了一会儿，把松开的鞋带<w>系</w>好。"
                            }
                        },
                        {
                            "text": "L'enfant essaie patiemment de <w>renouer</w> le ruban rouge de son paquet cadeau.",
                            "target_lang_translations": {
                                "en": "The child patiently tries to <w>retie</w> the red ribbon on the gift parcel.",
                                "ru": "Ребёнок терпеливо пытается <w>перевязать</w> красную ленту на своём подарочном свёртке.",
                                "de": "Das Kind versucht geduldig, das rote Band seines Geschenkpakets wieder zu <w>binden</w>.",
                                "es": "El niño intenta con paciencia <w>atar</w> de nuevo la cinta roja de su paquete de regalo.",
                                "zh": "孩子耐心地试着把礼品包上的红丝带重新<w>绑</w>好。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rattacher"
                    ],
                    "antonyms": [
                        "dénouer",
                        "détacher"
                    ],
                    "common_phrases": [
                        "renouer ses lacets",
                        "renouer un ruban"
                    ],
                    "target_lang_definitions": {
                        "en": "To tie again something that has come undone or been broken.",
                        "ru": "Снова завязать или привязать то, что развязалось или было сломано.",
                        "de": "Etwas, das sich gelöst hat oder gebrochen ist, wieder zubinden oder verknoten.",
                        "es": "Volver a atar algo que se había desatado o roto.",
                        "zh": "把松开或断开的东西重新系上或绑紧。"
                    },
