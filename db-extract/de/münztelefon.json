                "senses": [
                    {
                        "sense_id": "6698f61e-8372-3be1-8f70-0ef253516b8e",
                        "entry_id": "403b01e4-4301-3869-8f47-8e7f3b059777",
                        "glosses": [
                            "öffentliches Gerät zur Übermittlung von akustischen Signalen, welches nach Bezahlung benutzt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61dbd7f1-17dc-44b6-9152-dc332e4d4717",
                                "sense_id": "6698f61e-8372-3be1-8f70-0ef253516b8e",
                                "text": "Ich habe früher oft das Münztelefon verwendet."
                            },
                            {
                                "example_id": "c3d9524f-afc5-4427-bad7-c2dbe8831877",
                                "sense_id": "6698f61e-8372-3be1-8f70-0ef253516b8e",
                                "text": "„Vier Münztelefone und vier vergeudete 50 Cent-Stücke später die Einsicht, es mit einer Wertkarte zu versuchen.“"
                            },
                            {
                                "example_id": "47418866-db37-4940-b194-c097d6346f25",
                                "sense_id": "6698f61e-8372-3be1-8f70-0ef253516b8e",
                                "text": "„Die Kassiererin legt ihren Hörer auf den Apparat zurück, während Anrath den seinen noch lange nicht in die Gabel an der Seite des Münztelefons hängt.“"
                            },
                            {
                                "example_id": "6df86409-f792-45e3-a184-d4390e1c18a1",
                                "sense_id": "6698f61e-8372-3be1-8f70-0ef253516b8e",
                                "text": "„Ich kann dich nur von einem Münztelefon aus anrufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0efc7d4c-d3f7-4c2b-b5fe-8dad57bbb86c",
                        "source_entry_id": "403b01e4-4301-3869-8f47-8e7f3b059777",
