                "senses": [
                    {
                        "sense_id": "82330705-9e93-34cc-a528-b1fba7e9ae71",
                        "entry_id": "76fb1614-8fe2-3d5e-8c2f-4f3f957d0726",
                        "glosses": [
                            "Pertaining to, or like, a flock."
                        ],
                        "tags": [
                            "not-comparable",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "b7be4133-9a39-4c83-a5ae-c9e8adaf3af2",
                                "sense_id": "82330705-9e93-34cc-a528-b1fba7e9ae71",
                                "text": "Now the Wasp is a winged Insect, gregal or hearding round like a ring, long, having four wings […]"
                            },
                            {
                                "example_id": "a9732826-1369-4b8c-bf5f-faa5d6f436d4",
                                "sense_id": "82330705-9e93-34cc-a528-b1fba7e9ae71",
                                "text": "The old Proverb is very true, Birds of a Feather, will flock together: And so will gregal Beasts too."
                            },
                            {
                                "example_id": "b10cd26e-d2de-4da0-bc33-2de69373fada",
                                "sense_id": "82330705-9e93-34cc-a528-b1fba7e9ae71",
                                "text": "But for this gregal conformity there is, as I have said, a cause and an excuse."
                            },
                            {
                                "example_id": "f5da8cdf-0cf0-4d0b-b7a3-386bd4958984",
                                "sense_id": "82330705-9e93-34cc-a528-b1fba7e9ae71",
                                "text": "Whereas the turbate group can roughly be said to be irrational and unorganised, the gregal group may be described loosely as irrational yet organised."
                            }
                        ]
                    }
                ],
