            "senses": [
                {
                    "sense_id": "2f3668c5-770a-3f4f-84f7-c135950aa5f3",
                    "sense_definition": "Äußerung der Ablehnung oder des Missfallens, um eine bestimmte Handlung oder Entscheidung zu verhindern",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "protest_ablehnung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Anwohner wollten gegen das geplante Bauprojekt sofort energischen <w>Einspruch</w> erheben."
                        },
                        {
                            "text": "Niemand im Kollegium wagte es, gegen den neuen Beschluss der Schulleitung <w>Einspruch</w> einzulegen."
                        }
                    ],
                    "synonyms": [
                        "Widerspruch",
                        "Protest",
                        "Einwand",
                        "Veto"
                    ],
                    "antonyms": [
                        "Zustimmung",
                        "Einverständnis"
                    ],
                    "common_phrases": [
                        "Einspruch erheben",
                        "Einspruch einlegen"
                    ]
                },
                {
                    "sense_id": "8a39ff8c-12d7-3f44-87d3-720b3a5558c2",
                    "sense_definition": "Förmlicher Rechtsbehelf gegen behördliche Bescheide oder gerichtliche Entscheidungen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rechtsmittel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gegen diesen fehlerhaften Bußgeldbescheid sollten Sie innerhalb von zwei Wochen schriftlichen <w>Einspruch</w> einlegen."
                        },
                        {
                            "text": "Das Gericht prüft derzeit, ob der verspätete <w>Einspruch</w> des Angeklagten überhaupt noch zulässig ist."
                        }
                    ],
                    "synonyms": [
                        "Beschwerde",
                        "Widerspruch",
                        "Einsprache"
                    ],
                    "common_phrases": [
                        "schriftlichen Einspruch einlegen",
                        "fristgerechter Einspruch"
                    ]
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "28b90159-dc19-3193-a348-c94961a8b519",
                    "sense_definition": "Ausruf vor Gericht oder in einer förmlichen Debatte, mit dem Einwand gegen ein Vorbringen erhoben wird",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "„<w>Einspruch</w>, Euer Ehren, die Frage der Staatsanwaltschaft führt viel zu weit!“, rief die Verteidigerin."
                        },
                        {
                            "text": "„<w>Einspruch</w>! Diese Behauptung beruht auf reinen Spekulationen und ist nicht bewiesen“, sagte der Anwalt laut."
                        }
                    ],
                    "common_phrases": [
                        "Einspruch Euer Ehren"
                    ]
                }
            ]
        }
    ]
