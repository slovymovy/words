                        "sense_id": "331a0785-6746-3eef-8488-10e15ac590af",
                        "entry_id": "8aee118f-ee13-3329-b723-2672eb64f1b1",
                        "glosses": [
                            "Nom du conflit nord-irlandais qui a eu lieu entre les années 1960 et 2000."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46d7e9f7-16ce-4803-8212-368d44330dde",
                                "sense_id": "331a0785-6746-3eef-8488-10e15ac590af",
                                "text": "Ces incidents font resurgir le spectre des trois décennies sanglantes des « Troubles », la guerre civile entre républicains – principalement des catholiques partisans de la réunification avec l’Irlande – et unionistes protestants, qui ont fait 3 500 morts jusqu’à l’accord de paix du 10 avril 1998, aussi appelé accord du Vendredi saint."
                            }
                        ]
                    }
