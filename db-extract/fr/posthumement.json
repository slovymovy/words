                                "example_id": "28b9a428-eacb-4a8d-a53d-6805f9115d9f",
                                "sense_id": "770078a3-30d8-3ac4-8c45-2d751e5595a4",
                                "text": "des lettres et des papiers publiés posthumement."
                            },
                            {
                                "example_id": "9b52a0df-040b-4ae3-97c8-7b58f218d569",
                                "sense_id": "770078a3-30d8-3ac4-8c45-2d751e5595a4",
                                "text": "Avant de mourir en 2009, l’acteur américain David Carradine avait tourné un film intitulé Eldorado, une production du Britannique Richard Driscoll qui devait prendre l’affiche posthumement."
                            }
                        ]
