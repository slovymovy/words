                                        "examples": [
                                            {
                                                "example_id": "5e880787-c6eb-467e-a721-4109c1d3b1b7",
                                                "sense_id": "b2349d4d-450b-3cb8-a11f-1fcc1ed3ac8f",
                                                "text": "Seine Spezialität besteht darin, sich bei jeder Gelegenheit daneben zu benehmen."
