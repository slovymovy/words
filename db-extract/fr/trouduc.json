                                                "sense_id": "0347d304-e465-3d54-a5a6-0f5ddfa53b27",
                                                "text": "That homemade hot sauce of yours got me twice, both coming and going. My asshole is still sore."
                                            },
                                            {
                                                "example_id": "0ae35788-f51d-453d-aefc-16728a4949fc",
                                                "sense_id": "0347d304-e465-3d54-a5a6-0f5ddfa53b27",
                                                "text": "She said she couldn't wiggle when she had the doorknob in her asshole."
                                            },
                                            {
                                                "example_id": "4dfc3967-710a-4510-b926-fc3921d14092",
                                                "sense_id": "0347d304-e465-3d54-a5a6-0f5ddfa53b27",
                                                "text": "'You talk as if you were born without an asshole,' he cried to Commander Semmes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d08d66dd-a722-3517-842a-07b70b3850cc",
                                        "entry_id": "63070978-44d5-3291-b060-30a86c5c5973",
                                        "glosses": [
                                            "A jerk; an inappropriately or objectionably mean, inconsiderate, contemptible, obnoxious, intrusive, stupid, or rude person."
                                        ],
                                        "tags": [
                                            "US",
