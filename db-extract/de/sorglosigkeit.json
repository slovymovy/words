                "senses": [
                    {
                        "sense_id": "e1143973-f3b6-3593-8b52-117a8a1b7425",
                        "entry_id": "17b7c2a3-95ce-36a5-ba3e-2b8ca87c5889",
                        "glosses": [
                            "Einstellung/Gefühl, sich keine Sorgen machen zu müssen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2df8a888-168c-4d69-a821-f88d15ac78d6",
                                "sense_id": "e1143973-f3b6-3593-8b52-117a8a1b7425",
                                "text": "„Das entsprach wohl so der Sorglosigkeit ihrer Generation, die ihm infolge eines Mißverständnisses das Theater füllte und von der er keine Ahnung hatte.“"
                            },
                            {
                                "example_id": "2237b16d-6bec-4cbe-9779-169739e082ba",
                                "sense_id": "e1143973-f3b6-3593-8b52-117a8a1b7425",
                                "text": "„Im schummrigen Licht des Lokals hatte sie Mühe, die Sorglosigkeit zu spielen, die nötig war, um einen Mann erfolgreich verführen zu können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
