                ],
                "senses": [
                    {
                        "sense_id": "bff44e77-9474-35b5-9aa4-2c4cd2f6474f",
                        "entry_id": "c745d7ac-1672-3286-951e-e6c010365c3a",
                        "glosses": [
                            "vergleichsweise, ungewöhnlich klein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9593392-233a-497c-bf50-f88b7052476c",
                                "sense_id": "bff44e77-9474-35b5-9aa4-2c4cd2f6474f",
                                "text": "„Ein Garten, und sei er nur handtuchgroß, wirke Wunder bei Familien, gerade im Kontrast zu den Wohnblöcken neben der Messe.“"
                            },
                            {
                                "example_id": "425d29a4-a776-40c0-8ab6-814a9d2ac9d1",
                                "sense_id": "bff44e77-9474-35b5-9aa4-2c4cd2f6474f",
                                "text": "„Viel Uferzone ist in den letzten Jahrzehnten in handtuchgroße Parzellen zerfallen, mit unverminderter Bauwut versuchen Investoren die wenigen verbliebenen Lücken zu schließen.“"
                            },
                            {
                                "example_id": "5041dfbc-6072-471e-bb3f-4ef0309c5e43",
                                "sense_id": "bff44e77-9474-35b5-9aa4-2c4cd2f6474f",
                                "text": "„Eine symbolische Geste, dass gerade hier, wo jedes handtuchgroße Grundstück begierige Blicke von Developern erntet, kostbare Quadratmeter für Diskussionen über Kunst reserviert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
