{
    "word_family": [
        "submarine",
        "substitute",
        "subscription",
        "subcontractor",
        "subwoofer",
        "subtitle"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "06a2cabc-fd10-3527-8228-a43457dd3dd5",
                    "sense_definition": "Short form of <w>submarine</w> sandwich; a long bread roll split open and filled with meat, cheese, and vegetables.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to go to the deli and buy some <w>subs</w> for lunch.",
                            "target_lang_translations": {
                                "ru": "Мы решили пойти в кулинарию и купить <w>сэндвичи</w> на обед.",
                                "zh": "我们决定去熟食店买几个<w>潜艇堡</w>当午餐。"
                            }
                        },
                        {
                            "text": "I ordered a turkey <w>sub</w> with extra cheese and pickles.",
                            "target_lang_translations": {
                                "ru": "Я заказал <w>сэндвич</w> с индейкой, дополнительным сыром и маринованными огурцами.",
                                "zh": "我点了一个火鸡<w>潜艇堡</w>，多加了奶酪和酸黄瓜。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hoagie",
                        "grinder",
                        "hero"
                    ],
                    "common_phrases": [
                        "meatball sub",
                        "foot-long sub",
                        "tuna sub"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разновидность сэндвича в длинной разрезанной булке с начинкой из мяса, сыра и овощей.",
                        "zh": "一种长条形三明治，通常用切开的长面包制作，内夹肉类、奶酪和蔬菜。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сэндвич",
                                "target_lang_sense_clarification": "бутерброд"
                            },
                            {
                                "target_lang_word": "саб",
                                "target_lang_sense_clarification": "сэндвич в длинной булке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "潜艇堡",
                                "target_lang_sense_clarification": "一种长条形三明治"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5786424f-0b38-3ea7-a96b-271b8a38fde9",
                    "sense_definition": "Short form of <w>substitute</w>; a person who replaces someone else for a short time, especially a teacher or a sports player.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our regular teacher is sick, so we have a <w>sub</w> today.",
                            "target_lang_translations": {
                                "ru": "Наш постоянный учитель заболел, поэтому сегодня у нас <w>замена</w>.",
                                "zh": "我们的正式老师病了，所以今天我们有位<w>代课老师</w>。"
                            }
                        },
                        {
                            "text": "The coach sent in a <w>sub</w> during the second half of the game.",
                            "target_lang_translations": {
                                "ru": "Тренер выпустил <w>запасного</w> во второй половине игры.",
                                "zh": "教练在下半场派上了一名<w>替补</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sub teacher",
                        "bring on a sub"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который временно заменяет кого-то другого, обычно учителя или игрока в спорте.",
                        "zh": "指临时替代他人工作的人，常见于教师或体育比赛中的替补队员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замена",
                                "target_lang_sense_clarification": "учитель или игрок"
                            },
                            {
                                "target_lang_word": "запасной",
                                "target_lang_sense_clarification": "в спорте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "代课老师",
                                "target_lang_sense_clarification": "临时替代的教师"
                            },
                            {
                                "target_lang_word": "替补",
                                "target_lang_sense_clarification": "体育比赛中的替补队员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "780f29c7-bac9-3597-8ea9-cbb88e071ca9",
                    "sense_definition": "Short form of <w>submarine</w>; a ship that can travel underwater.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crew lived on the <w>sub</w> for three months without seeing the sun.",
                            "target_lang_translations": {
                                "ru": "Экипаж жил на <w>подлодке</w> три месяца, не видя солнца.",
                                "zh": "船员们在<w>潜艇</w>里生活了三个月，没见过太阳。"
                            }
                        },
                        {
                            "text": "They spotted an enemy <w>sub</w> on the radar screen.",
                            "target_lang_translations": {
                                "ru": "Они заметили вражескую <w>субмарину</w> на экране радара.",
                                "zh": "他们在雷达屏幕上发现了一艘敌方<w>潜艇</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "submarine"
                    ],
                    "common_phrases": [
                        "nuclear sub",
                        "enemy sub"
                    ],
                    "target_lang_definitions": {
                        "ru": "Корабль, способный плавать под водой; сокращение от «подводная лодка».",
                        "zh": "能在水下航行的船只，即潜水艇的简称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подлодка",
                                "target_lang_sense_clarification": "разг. подводная лодка"
                            },
                            {
                                "target_lang_word": "субмарина",
                                "target_lang_sense_clarification": "подводная лодка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "潜艇",
                                "target_lang_sense_clarification": "水下航行器"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3cd1949-e103-35cd-bae1-1d36ed0d2e69",
                    "sense_definition": "Short form of <w>subscription</w>; a payment for a service or a person who follows an online channel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "internet_business",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I forgot to renew my magazine <w>sub</w> before it expired.",
                            "target_lang_translations": {
                                "ru": "Я забыл продлить <w>подписку</w> на журнал до истечения её срока.",
                                "zh": "我忘了在过期前续订我的杂志<w>订阅</w>。"
                            }
                        },
                        {
                            "text": "The video channel gained a thousand new <w>subs</w> in one week.",
                            "target_lang_translations": {
                                "ru": "Видеоканал набрал тысячу новых <w>подписчиков</w> за одну неделю.",
                                "zh": "这个视频频道在一周内增加了一千名新<w>订阅者</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "monthly sub",
                        "gift sub"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плата за услугу или человек, подписанный на онлайн-канал.",
                        "zh": "指为某项服务支付的费用，或指关注在线频道的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подписка",
                                "target_lang_sense_clarification": "на услугу"
                            },
                            {
                                "target_lang_word": "подписчик",
                                "target_lang_sense_clarification": "на канал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "订阅",
                                "target_lang_sense_clarification": "支付服务费用"
                            },
                            {
                                "target_lang_word": "订阅者",
                                "target_lang_sense_clarification": "关注频道的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f49d433-38e3-311b-8472-54482e15ef9b",
                    "sense_definition": "Short form of <w>subtitle</w>; text displayed at the bottom of a screen translating or transcribing the dialogue.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "media",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I prefer watching foreign films with <w>subs</w> rather than dubbed audio.",
                            "target_lang_translations": {
                                "ru": "Я предпочитаю смотреть иностранные фильмы с <w>субтитрами</w>, а не в дубляже.",
                                "zh": "我更喜欢看带<w>字幕</w>的外国电影，而不是配音版。"
                            }
                        },
                        {
                            "text": "There was a mistake in the <w>subs</w> that changed the meaning of the scene.",
                            "target_lang_translations": {
                                "ru": "В <w>субтитрах</w> была ошибка, которая изменила смысл сцены.",
                                "zh": "字幕里有个错误，改变了那一幕的意思。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Текст в нижней части экрана, переводящий или дублирующий диалог.",
                        "zh": "显示在屏幕底部，用于翻译或转录对话的文字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "субтитры",
                                "target_lang_sense_clarification": "текст на экране"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "字幕",
                                "target_lang_sense_clarification": "屏幕下方的文字"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02620a79-0538-38e2-9e28-4c9edf418ff1",
                    "sense_definition": "Short form of <w>subcontractor</w>; a person or company hired to do part of a job for another contractor.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "business",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The main builder hired a <w>sub</w> to handle the electrical wiring.",
                            "target_lang_translations": {
                                "ru": "Главный застройщик нанял <w>субподрядчика</w> для выполнения электромонтажных работ.",
                                "zh": "总承包商雇了一名<w>分包商</w>来负责电路布线。"
                            }
                        },
                        {
                            "text": "We need to find a reliable <w>sub</w> to finish the roofing work.",
                            "target_lang_translations": {
                                "ru": "Нам нужно найти надежного <w>субподрядчика</w>, чтобы закончить кровельные работы.",
                                "zh": "我们需要找一个可靠的<w>分包商</w>来完成屋顶工程。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо или компания, нанятые для выполнения части работ для другого подрядчика.",
                        "zh": "受雇为另一承包商完成部分工作的个人或公司。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "субподрядчик",
                                "target_lang_sense_clarification": "исполнитель работ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分包商",
                                "target_lang_sense_clarification": "受雇完成部分工程的单位"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "afa8a1ee-643d-30ac-94ba-f9eea0c28282",
                    "sense_definition": "To perform the duties of another person temporarily, especially as a teacher or in a sports game.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Can you <w>sub</w> for me at work tomorrow morning?",
                            "target_lang_translations": {
                                "ru": "Ты можешь <w>подменить</w> меня на работе завтра утром?",
                                "zh": "明天早上你能帮我<w>代班</w>吗？"
                            }
                        },
                        {
                            "text": "He was <w>subbed</w> into the match during the final ten minutes.",
                            "target_lang_translations": {
                                "ru": "Его <w>выпустили на замену</w> в матче в последние десять минут.",
                                "zh": "他在最后十分钟被<w>替补上场</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sub for someone",
                        "sub in"
                    ],
                    "target_lang_definitions": {
                        "ru": "Временно выполнять обязанности другого человека, особенно учителя, или выходить на замену в спорте.",
                        "zh": "临时履行他人的职责，特别是指代课或在体育比赛中上场替换。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подменять",
                                "target_lang_sense_clarification": "кого-то на работе"
                            },
                            {
                                "target_lang_word": "заменять",
                                "target_lang_sense_clarification": "выполнять чьи-то обязанности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "代班",
                                "target_lang_sense_clarification": "临时替代他人工作"
                            },
                            {
                                "target_lang_word": "替补上场",
                                "target_lang_sense_clarification": "体育比赛中替换队员"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}