{
    "word_family": [
        "rumbling"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "67c01760-eca7-3fcc-89a0-de86cd5e6096",
                    "sense_definition": "A low, heavy, continuous sound, such as that of thunder or a hungry stomach.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>rumble</w> from passing trucks made it hard to sleep at night.",
                            "target_lang_translations": {
                                "zh": "夜里，过往卡车发出的<w>隆隆声</w>让人很难入睡。"
                            }
                        },
                        {
                            "text": "A distant <w>rumble</w> of thunder warned us that a storm was coming.",
                            "target_lang_translations": {
                                "zh": "远处的雷<w>隆隆声</w>提醒我们暴风雨要来了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rumbling"
                    ],
                    "common_phrases": [
                        "distant rumble",
                        "stomach rumble"
                    ],
                    "target_lang_definitions": {
                        "zh": "低沉、厚重、持续的声音，如雷声或饥饿时肚子发出的声音。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "隆隆声",
                                "target_lang_sense_clarification": "低沉而持续的声音，如雷声、卡车声或肚子叫声"
                            },
                            {
                                "target_lang_word": "咕噜声",
                                "target_lang_sense_clarification": "多指肚子饿时发出的连续声音"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed7f56bf-ba6d-336c-8730-a318d43bfe1a",
                    "sense_definition": "A street fight or brawl.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two rival gangs planned a <w>rumble</w> in the alleyway.",
                            "target_lang_translations": {
                                "zh": "两个敌对帮派打算在小巷里来一场<w>群殴</w>。"
                            }
                        },
                        {
                            "text": "Police arrived just before the <w>rumble</w> could turn violent.",
                            "target_lang_translations": {
                                "zh": "就在这场<w>群殴</w>升级为暴力事件之前，警察赶到了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Often associated with mid-20th-century youth gang culture."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "街头斗殴；群架。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "群殴",
                                "target_lang_sense_clarification": "街头斗殴，尤指成群人之间的打斗"
                            },
                            {
                                "target_lang_word": "打群架",
                                "target_lang_sense_clarification": "口语，指一群人互相打架"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be335a77-bdf9-329f-8e76-cab1196765a9",
                    "sense_definition": "A seat for servants, behind the body of a carriage.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kit, well wrapped, was in the <w>rumble</w> behind the carriage.",
                            "target_lang_translations": {
                                "zh": "裹得严严实实的基特坐在马车后面的<w>仆人座</w>上。"
                            }
                        },
                        {
                            "text": "She sat in the <w>rumble</w> of the travelling carriage, exposed to the sharp rain.",
                            "target_lang_translations": {
                                "zh": "她坐在行进中的马车<w>仆人座</w>上，暴露在刺骨的雨中。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to historical horse-drawn carriage design."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "旧时马车车身后部供仆人乘坐的座位。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "仆人座",
                                "target_lang_sense_clarification": "旧时马车车身后部供仆人乘坐的座位"
                            },
                            {
                                "target_lang_word": "车后座",
                                "target_lang_sense_clarification": "指马车后面外露的座位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11372b8a-3aab-3fe2-93a0-a98ec42a3637",
                    "sense_definition": "A rotating cask or box in which small articles are smoothed or polished by friction against each other.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The metal parts were placed in a <w>rumble</w> to remove their sharp edges.",
                            "target_lang_translations": {
                                "zh": "这些金属零件被放进<w>滚磨桶</w>里，以磨掉锋利的边角。"
                            }
                        },
                        {
                            "text": "After hours in the <w>rumble</w>, the stones were perfectly polished.",
                            "target_lang_translations": {
                                "zh": "这些石头在<w>滚磨桶</w>里转了几个小时后，被打磨得非常光滑。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种旋转的桶或箱子，小物件在其中彼此摩擦，从而被磨平或抛光。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "滚磨桶",
                                "target_lang_sense_clarification": "利用零件之间摩擦来去毛刺或抛光的小型滚筒设备"
                            },
                            {
                                "target_lang_word": "滚光桶",
                                "target_lang_sense_clarification": "用于把小物件滚动摩擦后磨光的容器"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "452e7aa4-6dfe-3bd3-8d52-230f704c74df",
                    "sense_definition": "To make a low, heavy, continuous sound.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If I do not eat, my stomach will <w>rumble</w>.",
                            "target_lang_translations": {
                                "zh": "如果我不吃东西，肚子就会<w>咕噜叫</w>。"
                            }
                        },
                        {
                            "text": "I could hear the thunder <w>rumbling</w> in the distance.",
                            "target_lang_translations": {
                                "zh": "我能听见远处雷声在<w>隆隆作响</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rumbling"
                    ],
                    "common_phrases": [
                        "stomach rumbles",
                        "thunder rumbles"
                    ],
                    "target_lang_definitions": {
                        "zh": "发出低沉、厚重、持续的声音。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "隆隆作响",
                                "target_lang_sense_clarification": "发出低沉持续的声音，如雷鸣、车声或肚子叫"
                            },
                            {
                                "target_lang_word": "咕噜叫",
                                "target_lang_sense_clarification": "多指肚子因饥饿而发声"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44458cf2-7785-3f5e-a198-4daccfe3aa62",
                    "sense_definition": "To move while making a rumbling noise.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy truck <w>rumbled</w> over the rough road.",
                            "target_lang_translations": {
                                "zh": "那辆沉重的卡车在崎岖的路上<w>隆隆驶过</w>。"
                            }
                        },
                        {
                            "text": "The train <w>rumbled</w> slowly over the bridge as the sun set.",
                            "target_lang_translations": {
                                "zh": "夕阳西下时，火车<w>隆隆驶过</w>大桥。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "truck rumbles",
                        "train rumbles"
                    ],
                    "target_lang_definitions": {
                        "zh": "伴随着隆隆声移动。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "隆隆驶过",
                                "target_lang_sense_clarification": "一边移动一边发出低沉轰鸣声"
                            },
                            {
                                "target_lang_word": "轰隆前进",
                                "target_lang_sense_clarification": "强调移动时伴随轰隆声"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f467e93-c90f-3d33-a4f5-d1a712c328a0",
                    "sense_definition": "To fight; to brawl.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rival groups decided to <w>rumble</w> in the park after school.",
                            "target_lang_translations": {
                                "zh": "敌对的两伙人决定放学后在公园里<w>打群架</w>。"
                            }
                        },
                        {
                            "text": "They were ready to <w>rumble</w> if anyone challenged their territory.",
                            "target_lang_translations": {
                                "zh": "如果有人挑战他们的地盘，他们随时准备<w>打架</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ready to rumble"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal term for fighting."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "打斗；斗殴。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "打群架",
                                "target_lang_sense_clarification": "口语，指成群打架"
                            },
                            {
                                "target_lang_word": "打架",
                                "target_lang_sense_clarification": "一般地指打斗、斗殴"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c949b9b-2b25-3d57-a83d-34d2a2d41da2",
                    "sense_definition": "To discover deceitful or underhanded behaviour.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective finally <w>rumbled</w> the criminal's secret hideout.",
                            "target_lang_translations": {
                                "zh": "侦探终于<w>识破</w>了那个罪犯秘密藏身处的线索。"
                            }
                        },
                        {
                            "text": "He thought he was clever, but the boss soon <w>rumbled</w> his plan.",
                            "target_lang_translations": {
                                "zh": "他自以为很聪明，但老板很快就<w>识破</w>了他的计划。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "British English usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "识破欺骗或不正当行为；看穿。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "识破",
                                "target_lang_sense_clarification": "看穿、察觉别人隐瞒或欺骗的行为"
                            },
                            {
                                "target_lang_word": "察觉",
                                "target_lang_sense_clarification": "发现可疑或不老实之处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "420e1d13-d3a6-3704-8fb8-a0fa376b9cd1",
                    "sense_definition": "To provide haptic feedback by vibrating.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The game controller will <w>rumble</w> when you hit an obstacle.",
                            "target_lang_translations": {
                                "zh": "你撞到障碍物时，游戏手柄会<w>震动</w>。"
                            }
                        },
                        {
                            "text": "Modern phones <w>rumble</w> to alert you of a new message.",
                            "target_lang_translations": {
                                "zh": "现代手机会通过<w>震动</w>提醒你有新消息。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "通过振动来提供触觉反馈。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "震动",
                                "target_lang_sense_clarification": "设备通过振动提供触觉反馈或提醒"
                            },
                            {
                                "target_lang_word": "振动提醒",
                                "target_lang_sense_clarification": "强调装置发出振动反馈"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "55f879f6-839c-3d9c-b768-dab8f9d1b93d",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Rumble</w> is our new neighbor.",
                            "target_lang_translations": {
                                "zh": "<w>兰布尔</w>先生是我们的新邻居。"
                            }
                        },
                        {
                            "text": "The book was written by an author named <w>Rumble</w>.",
                            "target_lang_translations": {
                                "zh": "这本书是一位名叫<w>兰布尔</w>的作者写的。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一个姓氏。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "兰布尔",
                                "target_lang_sense_clarification": "英文姓氏音译"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2fb994f3-0856-3dd7-9b89-5caa36f96351",
                    "sense_definition": "An unincorporated community in Pike County, Indiana, United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They live in a small town called <w>Rumble</w>.",
                            "target_lang_translations": {
                                "zh": "他们住在一个叫<w>兰布尔</w>的小镇。"
                            }
                        },
                        {
                            "text": "We drove through <w>Rumble</w> on our way to the city.",
                            "target_lang_translations": {
                                "zh": "我们开车去城里的路上经过了<w>兰布尔</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "美国印第安纳州派克县的一个非建制社区。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "兰布尔",
                                "target_lang_sense_clarification": "美国印第安纳州派克县的一个非建制社区名称"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}