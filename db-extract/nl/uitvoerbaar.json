                                    {
                                        "sense_id": "362702c9-5b49-32dc-97ae-e521bf0774d6",
                                        "entry_id": "8e506ff2-3813-3649-b494-b9748e2addeb",
                                        "glosses": [
                                            "Able to be done in practice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "195b9bbb-7868-471b-a731-077426c9a1df",
                                                "sense_id": "362702c9-5b49-32dc-97ae-e521bf0774d6",
                                                "text": "His plan to rid Trafalgar Square of pigeons by bringing in peregrine falcons to eat them was dismissed as not feasible."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
