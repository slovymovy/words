                                "target_senses": [
                                    {
                                        "sense_id": "007de074-3d35-3b96-b271-f782cc5032ef",
                                        "entry_id": "f03ae8ef-8a5e-3838-9fba-e2c2b492ec85",
                                        "glosses": [
                                            "etwas, das besonders gerne gegessen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40c2a080-5a4a-41ae-8048-2873588a810d",
                                                "sense_id": "007de074-3d35-3b96-b271-f782cc5032ef",
                                                "text": "„Jako aber, der sich bereits als Mann fühlte und ein echtes Jagdmesser am Gürtel trug, verzichtete zugunsten von Bruder und Schwester auf die Leckerei.“"
                                            },
                                            {
                                                "example_id": "789416e8-a980-472f-88c5-f19c95e7fb82",
                                                "sense_id": "007de074-3d35-3b96-b271-f782cc5032ef",
                                                "text": "„Da lachten sie beide, und Sylvia kochte Tee und holte die Schokoladendose, in der Adrienne nur die besten, dunkelsten Tafeln aufbewahrte, als besondere Leckerei nach dem Abendessen.“"
                                            },
                                            {
                                                "example_id": "028a6cce-3776-4d6e-b43b-4ec800cb2d9f",
                                                "sense_id": "007de074-3d35-3b96-b271-f782cc5032ef",
                                                "text": "„Der Kaffee und die Leckereien vom Kaufmann in Arnarstapi sind auf dem Tablett arrangiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "52915c6f-b495-3941-8bc9-4cc2a079e849",
                                        "entry_id": "f03ae8ef-8a5e-3838-9fba-e2c2b492ec85",
                                        "glosses": [
                                            "andauerndes Lecken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47278207-fe76-404f-9d16-6d6f8f3983e4",
                                                "sense_id": "52915c6f-b495-3941-8bc9-4cc2a079e849",
                                                "text": "Die Leckerei seiner Sexualpartnerin hat ihn scharf gemacht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
