                        "form": "hakenkruisje"
                    },
                    {
                        "form_id": "f86f31dd-b335-4f09-a72b-e663ee4f0b13",
                        "entry_id": "1a74342c-1c37-374a-8adf-730c15c197f6",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "hakenkruisjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "36e7eb15-f315-344e-98e8-1bbc39aec78c",
                        "entry_id": "1a74342c-1c37-374a-8adf-730c15c197f6",
                        "glosses": [
                            "is een symbool in de vorm van een kruis met aan alle uiteinden een haak."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73ec9b5d-991c-4a21-a968-191bb437bc6d",
                                "sense_id": "36e7eb15-f315-344e-98e8-1bbc39aec78c",
                                "text": "Het hakenkruis is berucht geworden als teken van de Nazi's."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "80e0e3d1-b7a1-44f0-b826-818ea840c9db",
                        "source_entry_id": "1a74342c-1c37-374a-8adf-730c15c197f6",
                        "source_sense_id": "36e7eb15-f315-344e-98e8-1bbc39aec78c",
                        "target_lang_word": "Hakenkreuz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hakenkreuz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "505b195e-f372-3c2a-983e-d6422ef5ecc6",
                                        "entry_id": "1c3c76e2-9775-3187-bbe4-fd25334cd469",
                                        "glosses": [
                                            "ein ursprünglich religiöses Symbol (Sonnenrad, Rad des Lebens und anderes), ein Kreuzsymbol mit gebogenen Armen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67419357-8606-4b13-8d6d-6026aaeb6dc2",
                                                "sense_id": "505b195e-f372-3c2a-983e-d6422ef5ecc6",
                                                "text": "„Auf einer andern Facette sieht man ein Hakenkreuz, wie es häufig auf Goldbracteaten vorkommt; […]“"
                                            },
                                            {
                                                "example_id": "0685c6f3-6727-4b36-9dcd-02e5b645d411",
                                                "sense_id": "505b195e-f372-3c2a-983e-d6422ef5ecc6",
                                                "text": "„Auf dem Kopfe trug er einen Turban mit einem Hakenkreuz.“"
                                            },
                                            {
                                                "example_id": "f27ecba4-39ce-439e-ae38-27fab545f98d",
                                                "sense_id": "505b195e-f372-3c2a-983e-d6422ef5ecc6",
                                                "text": "In einigen Staaten ist das Hakenkreuz ein gesetzlich verbotenes Zeichen und darf nur zu informativen Zwecken (zum Beispiel in Geschichtsbüchern) abgebildet werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "093402af-981e-3cb1-b64b-f331fa236e05",
                                        "entry_id": "1c3c76e2-9775-3187-bbe4-fd25334cd469",
                                        "glosses": [
                                            "dieses Symbol als Emblem der NSDAP, Symbol des Nationalsozialismus"
                                        ],
                                        "tags": [
                                            "insbesondere auch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9cba878-997a-4a14-8c94-88b78b25c44b",
                                                "sense_id": "093402af-981e-3cb1-b64b-f331fa236e05",
                                                "text": "In einigen Staaten ist das Hakenkreuz ein gesetzlich verbotenes Zeichen und darf nur zu informativen Zwecken (zum Beispiel in Geschichtsbüchern) abgebildet werden."
                                            },
                                            {
                                                "example_id": "57e2a570-0fa7-4468-b49e-5de8a8ac3bac",
                                                "sense_id": "093402af-981e-3cb1-b64b-f331fa236e05",
                                                "text": "„Ach so, die Mutter hatte Angst wegen der Hakenkreuze und der Sowjetsterne.“"
                                            },
                                            {
                                                "example_id": "d14eb45f-2c71-428a-93fa-004055a57862",
                                                "sense_id": "093402af-981e-3cb1-b64b-f331fa236e05",
                                                "text": "„Als die Amis kamen, entfernten sie alle Hakenkreuze, aber die schmiedeeisernen Fenstergitter an den Oberlichtern des Kellers haben sie vergessen.“"
                                            },
                                            {
                                                "example_id": "a348054d-9f4c-4f6d-a9c9-b85ce20787e0",
                                                "sense_id": "093402af-981e-3cb1-b64b-f331fa236e05",
                                                "text": "„…all diese Gören sind von der Hitlerjugend, sie haben die Armbinde mit dem Hakenkreuz, die Jugend Hitlers…“"
                                            },
                                            {
                                                "example_id": "10d4476b-3e4c-46f1-ab14-3c6d4deb8364",
                                                "sense_id": "093402af-981e-3cb1-b64b-f331fa236e05",
                                                "text": "„Als sie ihren Garten betreten wollte, hatte auf dem Dach der festen Laube die neue Fahne geweht, das Hakenkreuz, an einem hohen Schaft, schwarz und weiß und rot.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c50ccf6-180e-4cff-9bc1-82bcece187ce",
                        "source_entry_id": "1a74342c-1c37-374a-8adf-730c15c197f6",
                        "source_sense_id": "36e7eb15-f315-344e-98e8-1bbc39aec78c",
                        "target_lang_word": "swastika",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "swastika",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a02179fa-62ef-3653-be73-cad801eb6296",
                                        "entry_id": "da75ad16-074d-3c68-8feb-54ff916c31eb",
                                        "glosses": [
                                            "A cross with arms of equal length all bent halfway along at a 90° angle to the right or to the left, used as a religious symbol by various ancient and modern civilizations, but now mainly seen and used in the West (with arms angled to the right) as a symbol of Nazism and fascism."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f5175a0-e246-439d-9347-55492d0774b9",
                                                "sense_id": "a02179fa-62ef-3653-be73-cad801eb6296",
                                                "text": "This was signed by Dana Da, who added pentacles and pentagrams, and a crux ansata, and half-a-dozen swastikas, and a Triple Tau to his name, just to show that he was all he laid claim to be."
                                            },
                                            {
                                                "example_id": "48fc7d9e-ecaf-4a27-a707-a4fa8f94e516",
                                                "sense_id": "a02179fa-62ef-3653-be73-cad801eb6296",
                                                "text": "It is clear from archaeological finds that they enjoyed wearing Christian crosses, though they might enliven these with such symbols as the Indian swastika which Buddhists had brought them."
                                            },
                                            {
                                                "example_id": "9cb63c6b-335e-48e2-8457-e9537d1c6482",
                                                "sense_id": "a02179fa-62ef-3653-be73-cad801eb6296",
                                                "text": "A GOP office in Hillsborough, North Carolina, was firebombed over the weekend, with a swastika and the words “Nazi Republicans leave town or else” spray painted on an adjacent building, according to local officials."
                                            },
                                            {
                                                "example_id": "60e81e9c-798c-4844-a226-a4063f44b4d0",
                                                "sense_id": "a02179fa-62ef-3653-be73-cad801eb6296",
                                                "text": "Authorities in Connecticut are investigating after swastikas were found drawn on a high school campus in Stamford for the second time since Hamas launched a surprise attack on Israel earlier this month, the school district said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f6a0e94-3631-35bd-af49-f96f22d027e5",
                                        "entry_id": "da75ad16-074d-3c68-8feb-54ff916c31eb",
                                        "glosses": [
                                            "Nazi rule."
                                        ],
                                        "tags": [
                                            "metonymically",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a40764ca-6b29-4d7d-8e06-d0ba4c7afb89",
                                                "sense_id": "3f6a0e94-3631-35bd-af49-f96f22d027e5",
                                                "text": "\"Is that what you think of me? I believe in the Grail, not the Swastika!\""
                                            },
                                            {
                                                "example_id": "c299ccee-ce40-477a-b066-8c6591c9e973",
                                                "sense_id": "3f6a0e94-3631-35bd-af49-f96f22d027e5",
                                                "text": "“I can’t imagine anyone believes in Communist culprits instead of a contract job commissioned on behalf of the swastika.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae5d6d9d-c87e-4646-862a-88ef9e4d59da",
                        "source_entry_id": "1a74342c-1c37-374a-8adf-730c15c197f6",
                        "source_sense_id": "36e7eb15-f315-344e-98e8-1bbc39aec78c",
                        "target_lang_word": "croix gammée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "croix gammée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a4abf219-6001-3bcf-9ab1-de904b142644",
                                        "entry_id": "ccacee35-b023-327b-b0a7-06b03dd4ca27",
                                        "glosses": [
                                            "Svastika, croix dont les branches font un coude à angle droit tournants vers la droite ou sauvastika quand ils tournent vers la gauche."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0febef27-314a-4d49-8de8-ff46670061a5",
                                                "sense_id": "a4abf219-6001-3bcf-9ab1-de904b142644",
                                                "text": "La croix gammée apparaît et disparaît à Chypre avec l’influence phénicienne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b228c6e-7ca4-3fd1-8705-ee2f24dff678",
                                        "entry_id": "ccacee35-b023-327b-b0a7-06b03dd4ca27",
                                        "glosses": [
                                            "Symbole du parti nazi et de son régime."
                                        ],
                                        "tags": [
                                            "Nazism",
                                            "especially"
                                        ],
                                        "note": "Svastika pointant vers la droite (卐) et incliné de 45 degrés",
                                        "examples": [
                                            {
                                                "example_id": "ced085ed-ac8b-4c9f-afdf-fe402fb27c5f",
                                                "sense_id": "3b228c6e-7ca4-3fd1-8705-ee2f24dff678",
                                                "text": "Confusion : le kaiser s'est enfui en Hollande, mais le militarisme demeure et les chefs sociaux-démocrates du nouveau régime, républicain, font alliance avec les généraux monarchistes et les corps francs à croix gammée contre les spartakistes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
