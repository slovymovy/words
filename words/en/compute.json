    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "75b3fff8-fbee-3c9d-9253-ab644ce96611",
                    "sense_definition": "To determine an amount or number by calculation or reckoning.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "calculation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software will <w>compute</w> the total cost including taxes and shipping fees.",
                            "target_lang_translations": {
                                "ru": "Программное обеспечение <w>вычислит</w> общую стоимость, включая налоги и расходы на доставку."
                            }
                        },
                        {
                            "text": "Scientists need to <w>compute</w> the trajectory of the satellite to ensure a safe orbit.",
                            "target_lang_translations": {
                                "ru": "Ученым необходимо <w>рассчитать</w> траекторию спутника, чтобы обеспечить безопасную орбиту."
                            }
                        }
                    ],
                    "synonyms": [
                        "calculate",
                        "reckon",
                        "figure",
                        "estimate"
                    ],
                    "common_phrases": [
                        "compute the total",
                        "compute the value",
                        "compute the trajectory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определять количество или число путем математических вычислений или расчетов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вычислять",
                                "target_lang_sense_clarification": "производить математические действия"
                            },
                            {
                                "target_lang_word": "подсчитывать",
                                "target_lang_sense_clarification": "подводить итог, определять общее количество"
                            },
                            {
                                "target_lang_word": "рассчитывать",
                                "target_lang_sense_clarification": "определять параметры или траекторию"
                            },
                            {
                                "target_lang_word": "исчислять",
                                "target_lang_sense_clarification": "официальный или технический подсчет"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe1891a3-6c80-3882-b206-b442b4993a11",
                    "sense_definition": "To make sense or be logical, often used in negative constructions or to mimic robotic speech.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "understanding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have read the instructions three times, but the logic simply does not <w>compute</w>.",
                            "target_lang_translations": {
                                "ru": "Я прочитал инструкции трижды, но эта логика просто <w>не укладывается в голове</w>."
                            }
                        },
                        {
                            "text": "When he told me he was quitting his dream job, it just didn't <w>compute</w> at first.",
                            "target_lang_translations": {
                                "ru": "Когда он сказал мне, что увольняется с работы своей мечты, это поначалу просто <w>не состыковывалось</w> с реальностью."
                            }
                        }
                    ],
                    "synonyms": [
                        "add up",
                        "make sense"
                    ],
                    "common_phrases": [
                        "does not compute"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used humorously or to mimic robots"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь смысл или быть логичным (часто используется в отрицании или для имитации речи робота)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укладываться в голове",
                                "target_lang_sense_clarification": "быть понятным или логичным"
                            },
                            {
                                "target_lang_word": "состыковываться",
                                "target_lang_sense_clarification": "о логике или фактах"
                            },
                            {
                                "target_lang_word": "вязаться",
                                "target_lang_sense_clarification": "обычно в отрицании: не вяжется"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fcef35c4-7bc7-397c-b930-9dd15baaf94c",
                    "sense_definition": "The amount of computational processing power or resources available for a task.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "computing_resources",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Training large artificial intelligence models requires a massive amount of <w>compute</w>.",
                            "target_lang_translations": {
                                "ru": "Обучение больших моделей искусственного интеллекта требует огромного объема <w>вычислительных ресурсов</w>."
                            }
                        },
                        {
                            "text": "We need to scale up our <w>compute</w> resources to handle the increased traffic on the server.",
                            "target_lang_translations": {
                                "ru": "Нам нужно масштабировать наши <w>вычислительные мощности</w>, чтобы справиться с возросшим трафиком на сервере."
                            }
                        }
                    ],
                    "synonyms": [
                        "processing power"
                    ],
                    "common_phrases": [
                        "amount of compute",
                        "scale up compute",
                        "cloud compute"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical usage in IT and AI fields"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Объем вычислительных мощностей или ресурсов, доступных для выполнения задачи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вычислительные ресурсы",
                                "target_lang_sense_clarification": "мощности процессора"
                            },
                            {
                                "target_lang_word": "вычислительная мощность",
                                "target_lang_sense_clarification": "производительность системы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}