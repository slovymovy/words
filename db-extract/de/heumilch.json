                ],
                "senses": [
                    {
                        "sense_id": "c291a655-84b8-3b5c-a732-2d09e83163d8",
                        "entry_id": "3b85fb34-9572-3559-b367-81b31e1ef941",
                        "glosses": [
                            "eine nach bestimmten Kriterien hergestellte Milch von Tieren (vor allem von Kühen), die ausschließlich mit frischem Grünlandfutter, Heu und Getreide gefüttert werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f82efa5b-717a-4c3c-b296-cd6684ea0713",
                                "sense_id": "c291a655-84b8-3b5c-a732-2d09e83163d8",
                                "text": "Bei der Herstellung der Heumilch wird bewusst auf die Fütterung von Silage und anderen gärenden Futtermitteln verzichtet, da diese einige Milcheigenschaften negativ beeinflussen."
                            },
                            {
                                "example_id": "80b171b8-42d8-4fe0-a9da-bc2969625767",
                                "sense_id": "c291a655-84b8-3b5c-a732-2d09e83163d8",
                                "text": "„Die Heumilch setzt silofreie Fütterung voraus – das heißt, die Bauern verfüttern frisches Gras (im Sommer) oder wohlschmeckendes Heu (im Winter) an ihre Kühe.“"
                            },
                            {
                                "example_id": "d16fb365-0dee-46c6-bf5d-4af88a0e4493",
                                "sense_id": "c291a655-84b8-3b5c-a732-2d09e83163d8",
                                "text": "Der Bio-Fachmarkt Denns BioMarkt führt seit 2010 Heumilch im Kühlregal. Heute stehen vier Heumilche in den Regalen, die Marken Gläserne Molkerei, Demeter Milchbauern Süd, Bio-Heumilchbauern Bayern und regional Schwarzwaldmilch\""
                            },
                            {
                                "example_id": "d6c8c943-a12f-4513-9d02-a1d1c60b43d6",
                                "sense_id": "c291a655-84b8-3b5c-a732-2d09e83163d8",
                                "text": "„Bei 77 % der Beurteilungen der Heumilchen wurde kein Fehlgeschmack festgestellt.\""
                            },
                            {
                                "example_id": "c6b2de7c-86f2-4a7a-9819-7d559a3405b5",
                                "sense_id": "c291a655-84b8-3b5c-a732-2d09e83163d8",
                                "text": "„Die geringsten Infektionen wies im Gegensatz zu den Heumilchen Silomilch bei Verfütterung sauerster ( pH kleiner als 3,8 ) Silagen auf.“"
                            },
                            {
                                "example_id": "423d9eb6-6650-4ea1-954d-060e9c52cecd",
                                "sense_id": "c291a655-84b8-3b5c-a732-2d09e83163d8",
                                "text": "„Diese Milchen waren demnach bakteriologisch als besser zu bewerten als Heumilchen nach reutergetrocknetem Heu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
