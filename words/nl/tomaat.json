                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "voedsel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik snijd een <w>tomaat</w> in kleine blokjes voor de salade.",
