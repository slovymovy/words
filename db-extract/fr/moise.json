                    {
                        "sense_id": "014e392a-1a6e-3591-a095-fb596878efe5",
                        "entry_id": "caaa517a-f0b2-3b04-98d4-9a21c96e0717",
                        "glosses": [
                            "Pièces de bois plates assemblées deux à deux avec des boulons et servant à maintenir la charpente."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e534b253-7c0a-4c94-9b57-bc87a9b32073",
                                "sense_id": "014e392a-1a6e-3591-a095-fb596878efe5",
                                "text": "Cette moise porte une des poulies , sur lesquelles glisse la corde."
                            },
                            {
                                "example_id": "c5b918cd-bafa-447c-aad9-b9954f5cdfe7",
                                "sense_id": "014e392a-1a6e-3591-a095-fb596878efe5",
                                "text": "Si l'on énumère les parties principales d'une de ces fermes, on trouve quatre grands arbalétriers, chacun d'environ 10 mètres en longueur, deux cours de doubles moises de 14 mètres et de 18 mètres, un poinçon et deux contrefiches, sans mentionner les petits arbalétriers qui forment le contour polygonal auquel sont cloués les vaux taillés en courbe."
                            },
                            {
                                "example_id": "4fb93861-aad3-4978-905b-9127ba7c426a",
                                "sense_id": "014e392a-1a6e-3591-a095-fb596878efe5",
                                "text": "Des moises doubles J pinçaient ce poteau D, reposaient sur la longrine F, mordaient les trois poteaux G, H, I, celui G étant appuyé sur le parement incliné du merlon, et venaient saisir le poteau postérieur K également incliné."
                            }
                        ]
                    }
