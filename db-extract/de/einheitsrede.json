                "senses": [
                    {
                        "sense_id": "96bfa990-98e3-371a-9054-e3a8c32633cc",
                        "entry_id": "81332089-dbd8-3101-bb0c-8ddb89bf0f1e",
                        "glosses": [
                            "Ansprache anlässlich des Jahrestages der Deutschen Einheit/der Deutschen Wiedervereinigung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f47b36ca-a6cb-49d1-8bae-2ee711fccfcd",
                                "sense_id": "96bfa990-98e3-371a-9054-e3a8c32633cc",
                                "text": "„Muslimische Vertreter in Deutschland sind zufrieden mit Bundespräsident Wulff und loben dessen Einheitsrede als Zeichen dafür, ‚dass die Muslime keine Bürger zweiter Klasse sind‘.“"
                            },
                            {
                                "example_id": "77014d5d-eebd-4980-be48-cb53efcf783a",
                                "sense_id": "96bfa990-98e3-371a-9054-e3a8c32633cc",
                                "text": "„Seit 1990 gibt es eine Spannung zwischen den Einheitsreden deutscher Politiker und der Wahrnehmung vieler Bürger.“"
                            },
                            {
                                "example_id": "c4b831d8-5399-42e5-84b8-3f78c2add152",
                                "sense_id": "96bfa990-98e3-371a-9054-e3a8c32633cc",
                                "text": "„So sehr, wie sie die Ostdeutschen in ihrer letzten Einheitsrede würdigte, hat sie es in ihrer Amtszeit selten getan.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
