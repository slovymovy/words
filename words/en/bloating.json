            "senses": [
                {
                    "sense_id": "2aa89627-a78f-30c3-b77a-f27ec89310f3",
                    "sense_definition": "An uncomfortable swelling or feeling of fullness, especially in the abdomen due to gas or fluid.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "swelling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Eating too quickly can cause uncomfortable stomach <w>bloating</w> after lunch.",
                            "target_lang_translations": {
                                "nl": "Te snel eten kan na de lunch een onaangenaam <w>opgeblazen gevoel</w> in de maag veroorzaken."
                            }
                        },
                        {
                            "text": "She took herbal tea to reduce the painful <w>bloating</w> in her belly.",
                            "target_lang_translations": {
                                "nl": "Ze dronk kruidenthee om het pijnlijke <w>opgeblazen gevoel</w> in haar buik te verminderen."
                            }
                        }
                    ],
                    "synonyms": [
                        "distension",
                        "swelling",
                        "puffiness"
                    ],
                    "common_phrases": [
