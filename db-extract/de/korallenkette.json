                            {
                                "example_id": "956ad0bc-2c62-4aa3-8e74-398778e9f53b",
                                "sense_id": "294f202b-cc00-347a-ae5a-d4a6b4f8a2f1",
                                "text": "„Ruiz trägt eine Korallenkette und hält zwei Meerkatzen im Arm.“"
                            },
                            {
                                "example_id": "38b0a1af-a25a-4723-8e98-463d9623e5b4",
                                "sense_id": "294f202b-cc00-347a-ae5a-d4a6b4f8a2f1",
                                "text": "„Schon sah er sich von einer Händlerschar umringt, die in lebhaftem Kauderwelsch auf ihn einschwatzte und aus allerlei Verstecken der Gewänder ihm bunte Glas- und Korallenketten, Glücksamulette und billigen Schmuck anbot.“"
                            }
                        ],
