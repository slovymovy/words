                "senses": [
                    {
                        "sense_id": "dc30348d-1a46-35aa-b9c4-3af7048fe8cf",
                        "entry_id": "67a95bb4-d855-369c-abb4-1bf7557e18e8",
                        "glosses": [
                            "im Ennstal gelegene Stadt in der Steiermark in Österreich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e36d622-1055-46c4-8d0c-377e40f9c28f",
                                "sense_id": "dc30348d-1a46-35aa-b9c4-3af7048fe8cf",
                                "text": "„In Summe flossen laut RH 415,78 Millionen Euro nach Schladming, 250 Millionen direkt aus der öffentlichen Hand, der Großteil, 150 Millionen, kam vom Land.“"
                            },
                            {
                                "example_id": "46ceefbc-1a9d-49d2-a8f7-f96ebe798c36",
                                "sense_id": "dc30348d-1a46-35aa-b9c4-3af7048fe8cf",
                                "text": "„Marcel Hirscher meldet sich im Nachtslalom von Schladming nach zwei Niederlagen gegen Clément Noël imposant zurück.“"
                            },
                            {
                                "example_id": "02964127-9dc8-4a93-a00d-6a272a33a12f",
                                "sense_id": "dc30348d-1a46-35aa-b9c4-3af7048fe8cf",
                                "text": "„Der 18-Jährige spezialisierte sich auf Skicross, 2018 nahm er an den Jugend-Weltmeisterschaften in Schladming teil.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
