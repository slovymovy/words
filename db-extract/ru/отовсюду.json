        "ru-extract.jsonl": [
            {
                "entry_id": "721d878e-a218-327a-857d-d47151aae11e",
                "word": "отовсюду",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b9b9aad5-ea1a-3230-81f9-8459877eacf5",
                        "entry_id": "721d878e-a218-327a-857d-d47151aae11e",
                        "glosses": [
                            "со всех сторон, из разных мест"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d6051dd-dd01-466c-a3a5-6b7c34c97ef8",
                                "sense_id": "b9b9aad5-ea1a-3230-81f9-8459877eacf5",
                                "text": "Отовсюду с воды и с берега гремит один общий возглас: «да здравствует Россия, да здравствует Франция!»"
                            },
                            {
                                "example_id": "f3942816-d803-40cb-99dd-b29a7af0fbbd",
                                "sense_id": "b9b9aad5-ea1a-3230-81f9-8459877eacf5",
                                "text": "Завтра — Успеньев день, в богатой станице — праздник, и вот они собрались отовсюду, в надежде, что праздничный день напоит и накормит их досыта, без труда с их стороны."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "014875a8-aeb2-49e0-8d7d-eea83450770e",
                        "source_entry_id": "721d878e-a218-327a-857d-d47151aae11e",
