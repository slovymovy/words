                "senses": [
                    {
                        "sense_id": "394f1950-66f6-30e2-9c7a-cbde9f216b91",
                        "entry_id": "b3a6cc93-cd42-3c72-a1bc-1d3f47fbccaf",
                        "glosses": [
                            "истор. связанный, соотносящийся по значению с существительными гестапо, гестаповец"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b74c4c44-f15e-4413-b057-bc799bc3f7e3",
                                "sense_id": "394f1950-66f6-30e2-9c7a-cbde9f216b91",
                                "text": "Работа разведчиков в Ровно проходила под носом у «всеукраинского гестапо», на глазах жандармерии и тайной гестаповской агентуры."
                            },
                            {
                                "example_id": "796a689b-19c0-4347-8bc6-6de4efb3c7fd",
                                "sense_id": "394f1950-66f6-30e2-9c7a-cbde9f216b91",
                                "text": "Все на нём с иголочки, и гестаповская форма выглядела элегантно."
                            }
                        ]
                    }
