                "senses": [
                    {
                        "sense_id": "4a7b4612-3266-385b-9740-845af916af9a",
                        "entry_id": "bc768427-c254-3c7a-a53c-1e7a140ec9f0",
                        "glosses": [
                            "een muur die ervoor zorgt dat men een grens niet makkelijk kan passeren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2aa99f4f-66d6-4848-a79b-3f4d061f41aa",
                                "sense_id": "4a7b4612-3266-385b-9740-845af916af9a",
                                "text": "‘Denk erom hè… Geen haast,’ riep hij me na terwijl ik naar de grensmuur liep om mijn hand op het koude ijzer te leggen en mezelf moed in te praten: ‘veilig thuiskomen’."
                            },
                            {
                                "example_id": "e539a4a8-d632-48c1-a9f3-aa5df5a3c6a5",
                                "sense_id": "4a7b4612-3266-385b-9740-845af916af9a",
                                "text": "De 19-jarige Miriam Luna probeerde zaterdag de oversteek naar Amerika te maken door over een metershoge stalen grensmuur bij El Paso te klimmen. Ze was in het bijzijn van een 26-jarige man, vermoedelijk haar partner en de vader van de baby, en viel meer dan zes meter naar beneden. De man waarschuwde Amerikaanse grensbeveiligers die een ambulance belden."
                            }
                        ]
                    }
