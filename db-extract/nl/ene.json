                        "examples": [
                            {
                                "example_id": "4217ce76-6715-405f-a79b-0f0c914ccdb8",
                                "sense_id": "e9604771-9791-3260-8d02-faf15ddbfc2e",
                                "text": "De ene man doet het wel, de ander niet."
                            },
                            {
                                "example_id": "ac474e2e-2af7-4c0d-9ca3-82ec51f58e9a",
                                "sense_id": "e9604771-9791-3260-8d02-faf15ddbfc2e",
                                "text": "Aan de ene kant wilde ik in de late middag zo snel mogelijk de pas over, maar aan de andere kant zou het de volgende ochtend veel veiliger zijn doordat de sneeuw ’s ochtends vroeg nog bevroren zou zijn, waardoor er minder kans op wegglijden was."
                            }
                        ]
                    },
                    {
                        "sense_id": "a340d3e7-95fe-34d6-8d48-7e1b57f75be2",
                        "entry_id": "065b7033-50af-3c23-a9b2-bb0d66a5c3ea",
                        "glosses": [
                            "gebruikt om een eenzame uitzondering aan te geven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "610edce4-93e8-4fcb-8172-010f69f1dd5f",
                                "sense_id": "a340d3e7-95fe-34d6-8d48-7e1b57f75be2",
                                "text": "Die ene keer dat je je vergiste zal je heus niet aangerekend worden."
                            }
                        ]
                    }
