                ],
                "senses": [
                    {
                        "sense_id": "321065ed-198d-38b1-ae66-ab813e2f8ec0",
                        "entry_id": "d01e5179-6c33-3f8c-9dae-99bdc866f7b7",
                        "glosses": [
                            "Tasche, die man am Sattel eines Fahrrades/Motorrades oder Reittiers befestigen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9bde212-7b45-48f6-8c5a-b54cf21147ce",
                                "sense_id": "321065ed-198d-38b1-ae66-ab813e2f8ec0",
                                "text": "„Aber ebenso wie ich den Mini-Sprachführer für Portugiesisch ganz unten in meinen Satteltaschen vergraben hatte, verdrängte ich diese Gedanken, ich würde mich später darum kümmern.“"
                            },
                            {
                                "example_id": "d47efdc0-a392-4598-98f6-157dc800bde6",
                                "sense_id": "321065ed-198d-38b1-ae66-ab813e2f8ec0",
                                "text": "„Er wollte bei Einbruch der Nacht ganz allein und was das Pferd laufen könne die Stadt verlassen und sich nach Livorno begeben, ohne mehr als das Allernötigste in einer Satteltasche mitzunehmen, insbesondere sein liebes blaues Band.“"
                            },
                            {
                                "example_id": "0365e699-cf2c-4979-b071-aa8aaa7c58ae",
                                "sense_id": "321065ed-198d-38b1-ae66-ab813e2f8ec0",
                                "text": "„Mit diesen Worten zahlte er an der Bar seine Rechnung, ließ sich die Satteltasche geben, legte sie über den Sattel seines ungeduldig scharrenden Braunen, stieg auf und trabte die Elmstreet hinab in den das Städtchen begrenzenden Wald.“"
                            },
                            {
                                "example_id": "d508ef63-26d6-4e0c-b29a-f1b3aff94809",
                                "sense_id": "321065ed-198d-38b1-ae66-ab813e2f8ec0",
                                "text": "„Als am Nachmittag des 26. Januars der Reiter mit dem ungeöffneten Brief in der Satteltasche nach Götzlack zurückkehrte, wähnte Else ihren Schwiegervater und die Schwägerin mit dem Treck auf dem Weg gen Westen und konzentrierte sich nun auf die eigene Flucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "defbf34b-ed6d-4978-8b92-507c80e94d33",
                        "source_entry_id": "d01e5179-6c33-3f8c-9dae-99bdc866f7b7",
                        "source_sense_id": "321065ed-198d-38b1-ae66-ab813e2f8ec0",
                        "source_sense_description": "Tasche, die man am Sattel eines Fahrrades/Motorrades oder Reittiers befestigen kann",
                        "target_lang_word": "saddlebag",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "saddlebag",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29b1b831-b209-3901-9ab7-ad799e298346",
                                        "entry_id": "70fbbf1e-79da-3033-a626-fd81262deb4a",
                                        "glosses": [
                                            "A covered pouch, usually one of a pair, laid across the back of a horse, donkey, or mule behind its saddle, or hanging over the rear wheel of a motorcycle; often made of leather or (on a motorcycle) a rigid material."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16127fca-0ab1-4f2b-ae4c-6891476d9358",
                                                "sense_id": "29b1b831-b209-3901-9ab7-ad799e298346",
                                                "text": "Frustrated, rushed, you toss the saddlebags filled with textbooks, ungraded papers, and drafts of poems onto the back of your cruiser motorcycle and roar off down Ambler not thinking speed and a strong crosswind will lift the saddlebags into flight like some leather-winged prehistoric bird hanging in the air a second before flopping onto the busiest street in North Abilene."
                                            },
                                            {
                                                "example_id": "4408073c-b6ff-4220-986e-36bf9c80be12",
                                                "sense_id": "29b1b831-b209-3901-9ab7-ad799e298346",
                                                "text": "Lifting the reins over the horse's head, he tied them to a nearby tree limb and moved back to the saddlebags. Untying the leather thongs that bound them behind the saddle, he picked the saddlebags up, hobbled to a nearby tree, and sat down at its base."
                                            },
                                            {
                                                "example_id": "2109d7c4-d9c3-47b5-821b-01dd6277eb4d",
                                                "sense_id": "29b1b831-b209-3901-9ab7-ad799e298346",
                                                "text": "There was no camp, bedroll, or fire and no other sign of a man, just the saddled horse with saddlebags and packs tied on behind it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d6fa017-7291-3d15-924d-d4d780bcaadd",
                                        "entry_id": "70fbbf1e-79da-3033-a626-fd81262deb4a",
                                        "glosses": [
                                            "pannier"
                                        ],
                                        "tags": [
                                            "broadly",
                                            "nonstandard"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1817251e-be51-3bf1-8993-83444e10e52a",
                                        "entry_id": "70fbbf1e-79da-3033-a626-fd81262deb4a",
                                        "glosses": [
                                            "A seat pack or a seat bag (a pouch or a small bag attached to the seat or seat post of a bicycle)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "af5f528c-c249-3823-9bba-8f6a47a629a9",
                                        "entry_id": "70fbbf1e-79da-3033-a626-fd81262deb4a",
                                        "glosses": [
                                            "Loose fatty flesh on a person's upper thighs or buttocks, that hangs like saddlebags."
                                        ],
                                        "tags": [
                                            "US",
                                            "in-plural",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b466f28-fad2-438e-bc76-783de910ffd0",
                                                "sense_id": "af5f528c-c249-3823-9bba-8f6a47a629a9",
                                                "text": "The area treated was always the side of the thighs, where she had visible saddlebags."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07216704-a623-3a9b-91e9-5e9f7c616419",
                                        "entry_id": "70fbbf1e-79da-3033-a626-fd81262deb4a",
                                        "glosses": [
                                            "A style of house with two rooms separated by a small hall and open space."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
