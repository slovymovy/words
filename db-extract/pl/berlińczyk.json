                    {
                        "translation_id": "0d2e770a-8fb5-477c-a713-47fc08ca81a9",
                        "source_entry_id": "e1e08742-f2d8-315a-9493-d2b3592b734c",
                        "source_sense_id": "5797ee83-e983-3306-8cdb-ea47ad38ae48",
                        "target_lang_word": "Berliner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Berliner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "43ec62a0-28b1-330f-99fd-1ac828466364",
                                        "entry_id": "17c96d90-91cc-3706-8a66-02bd31e554c7",
                                        "glosses": [
                                            "Einwohner, Bewohner der Stadt Berlin, eine in Berlin geborene Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fab9ae58-9b57-42c1-8ea3-be25047aa933",
                                                "sense_id": "43ec62a0-28b1-330f-99fd-1ac828466364",
                                                "text": "Er ist gebürtiger Berliner."
                                            },
                                            {
                                                "example_id": "0511bc26-2611-4548-89e7-894911dc2959",
                                                "sense_id": "43ec62a0-28b1-330f-99fd-1ac828466364",
                                                "text": "„Sonderbarerweise sind sehr wenig Berliner hier, meist Hamburger, Bremenser, Mecklenburger, Anhaltiner, und Sachsen. Ich bin sehr zufrieden damit; der Durchschnitts-Berliner ist unausstehlich und doppelt auf Reisen; er ist immer laut, eitel und zudringlich, nicht mir seiner Person, aber durch seine Manieren. ([Anmerkung: Theodor Fontane,] An Frau Emilie, Thale, 1877)“"
                                            },
                                            {
                                                "example_id": "8fa4d35b-4667-4d6e-b9d1-8188fb80f928",
                                                "sense_id": "43ec62a0-28b1-330f-99fd-1ac828466364",
                                                "text": "„Ich kannte einen Bühnenarbeiter, der einmal von einem Berliner beim Militär betrogen worden war und seitdem jeden Berliner und jede Berlinerin wie persönliche Feinde behandelte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Berliner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "016cd99a-5b0b-3f04-be27-25c542b9b238",
                                        "entry_id": "a6382c4b-02bd-3632-97f9-10310b838dca",
                                        "glosses": [
                                            "Berliner Pfannkuchen; ein in Fett ausgebackenes, mit Zuckerguss, Zucker oder Puderzucker bestreutes und mit Marmelade oder Konfitüre gefülltes, rundes Hefegebäck"
                                        ],
                                        "tags": [
                                            "South-German",
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35c4cef0-bc30-4be5-b68f-5e1de0b4d442",
                                                "sense_id": "016cd99a-5b0b-3f04-be27-25c542b9b238",
                                                "text": "Der geborene Berliner sagt „Pfannkuchen“ zum gebackenen Berliner."
                                            },
                                            {
                                                "example_id": "1b002611-d618-4d40-9ac6-5ecfb40da374",
                                                "sense_id": "016cd99a-5b0b-3f04-be27-25c542b9b238",
                                                "text": "„Rund 200.000 deutsche Haushalte essen an Silvester Krapfen, Berliner oder auch Kräppel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Berliner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8af3c955-f8ac-306c-b84d-23649d26b985",
                                        "entry_id": "0fa6af49-b51f-308e-9043-5923d9798375",
                                        "glosses": [
                                            "deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "566f3332-0f44-4f3b-a692-1c747cae7583",
                                                "sense_id": "8af3c955-f8ac-306c-b84d-23649d26b985",
                                                "text": "Frau Berliner ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "8fd83cd1-3f70-40a8-8459-28db69cdeae1",
                                                "sense_id": "8af3c955-f8ac-306c-b84d-23649d26b985",
                                                "text": "Herr Berliner wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "960d008d-5e32-4206-a684-80370d94dc28",
                                                "sense_id": "8af3c955-f8ac-306c-b84d-23649d26b985",
                                                "text": "Die Berliners fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "66518650-05d1-429d-8d09-8d18902e7ffb",
                                                "sense_id": "8af3c955-f8ac-306c-b84d-23649d26b985",
                                                "text": "Der Berliner trägt nie die Schals, die die Berliner ihm strickt."
                                            },
                                            {
                                                "example_id": "0926a499-6995-4ef1-b7bb-8881854a1d3b",
                                                "sense_id": "8af3c955-f8ac-306c-b84d-23649d26b985",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Berliner kommt, geht der Herr Berliner.“"
                                            },
                                            {
                                                "example_id": "53da9a72-c1e3-42fd-af9c-ff7b4598e60e",
                                                "sense_id": "8af3c955-f8ac-306c-b84d-23649d26b985",
                                                "text": "Berliner kommt und geht."
                                            },
                                            {
                                                "example_id": "701feb01-e0be-47ab-8b1a-994d16733e9f",
                                                "sense_id": "8af3c955-f8ac-306c-b84d-23649d26b985",
                                                "text": "Berliners kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Berliner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "668e7da4-a454-3986-8a32-e1701604c496",
                                        "entry_id": "63742d30-2e82-36c7-8d4a-880be34bbcb1",
                                        "glosses": [
                                            "sich auf Berlin beziehend, in der Art und Weise dieser Stadt, aus Berlin kommend, stammend, Berlin betreffend, zu Berlin gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd592470-c592-4149-b7d4-d2128ee34e89",
                                                "sense_id": "668e7da4-a454-3986-8a32-e1701604c496",
                                                "text": "Im Jahr 1989 fiel die Berliner Mauer."
                                            },
                                            {
                                                "example_id": "1713d6f7-175f-4dbe-b93b-66263404ec37",
                                                "sense_id": "668e7da4-a454-3986-8a32-e1701604c496",
                                                "text": "Ein typisches Beispiel für mehrfache Berliner Straßennamen ist „Berliner Straße“."
                                            },
                                            {
                                                "example_id": "bb3914b6-0c2b-432f-bcda-2cc463b13c2b",
                                                "sense_id": "668e7da4-a454-3986-8a32-e1701604c496",
                                                "text": "„Ein Kernproblem der Berliner Lehrerschaft lässt sich jedoch nicht lösen: Die Kollegien sind überaltert, das Durchschnittsalter liegt bei über 50 Jahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3a1faf7-f3b0-4895-b47b-45bb1e8ade0f",
                        "source_entry_id": "e1e08742-f2d8-315a-9493-d2b3592b734c",
                        "source_sense_id": "5797ee83-e983-3306-8cdb-ea47ad38ae48",
                        "target_lang_word": "берлинец",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "берлинец",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fa9917a5-a2aa-3d85-a852-6aea4b7e3a3a",
                                        "entry_id": "6b4f0f24-06ca-3bdb-be5c-2977382b6117",
                                        "glosses": [
                                            "житель или уроженец Берлина"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0586305-198e-49b0-ba2a-8a4eb77088b3",
                                                "sense_id": "fa9917a5-a2aa-3d85-a852-6aea4b7e3a3a",
                                                "text": "В Берлине я, что называется, кожей ощутил напряжённость, недовольство режимом, особенно когда стоял на праздничной трибуне и мимо шли тысячи берлинцев и приехавших в столицу из других городов."
                                            },
                                            {
                                                "example_id": "0fd98658-d567-4b8a-819e-df496d2d1b3d",
                                                "sense_id": "fa9917a5-a2aa-3d85-a852-6aea4b7e3a3a",
                                                "text": "К югу от Бранденбургских ворот лежит Тиргартен ― традиционное место прогулок и отдыха берлинцев."
                                            },
                                            {
                                                "example_id": "073510b6-3f62-4ce6-8bc1-9c0ba8a6a5c8",
                                                "sense_id": "fa9917a5-a2aa-3d85-a852-6aea4b7e3a3a",
                                                "text": "Когда он улыбался, крупные зубы его вспыхивали особенно чистым блеском, и за эту русскую белую улыбку по-своему полюбили его двое других лакеев ― Гуго, коренастый, белокурый берлинец, записывавший счета, и быстрый, востроносый, похожий на рыжую лису Макс, разносивший пиво и кофе по отделениям."
                                            },
                                            {
                                                "example_id": "038b7d0c-0022-4ae5-b250-88ade3672ac7",
                                                "sense_id": "fa9917a5-a2aa-3d85-a852-6aea4b7e3a3a",
                                                "text": "― Ja wo-o-ohl! ― крикнул я вдруг изо всей силы, протянув o, как протягивают берлинцы, поминутно употребляющие в разговоре фразу «ja wohl» и при этом протягивающие букву o более или менее, для выражения различных оттенков мыслей и ощущений."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
