                "senses": [
                    {
                        "sense_id": "0bd5c44d-381a-37b7-b757-51351b45df17",
                        "entry_id": "657f43b5-ac5b-32dc-8b99-ff6c418387a1",
                        "glosses": [
                            "Zweiterfolgreichster bei einem Wettbewerb in einer bestimmten (meist sportlichen) Disziplin, bei dem es um eine Meisterschaft geht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87a7471e-294c-406d-ab5f-bfd3f89f8fd1",
                                "sense_id": "0bd5c44d-381a-37b7-b757-51351b45df17",
                                "text": "„Rapid, zuletzt 2015/16 Vizemeister, hat in dieser Saison verblüfft – vor und während Corona.“"
                            },
                            {
                                "example_id": "ae3209bf-7e1a-47eb-8b41-e9f22925f3ae",
                                "sense_id": "0bd5c44d-381a-37b7-b757-51351b45df17",
                                "text": "„Ein Jahr später waren wir Vizemeister, die zweiterfolgreichste Fußballmannschaft Großbritanniens.“"
                            },
                            {
                                "example_id": "6da479bd-9e4b-423b-b576-f05659f817e3",
                                "sense_id": "0bd5c44d-381a-37b7-b757-51351b45df17",
                                "text": "„Seit der Saison 1963/64 ist der Tabellenzweite der Bundesliga Vizemeister.“"
                            },
                            {
                                "example_id": "65dc59a8-304f-4a37-aa31-be82ccd0fc57",
                                "sense_id": "0bd5c44d-381a-37b7-b757-51351b45df17",
                                "text": "Deutsche Fußball Liga: „Die Champions-League-Qualifikation war schon länger klar, nach dem 4:0 gegen Borussia Mönchengladbach hat der VfB auch den Titel des Vizemeisters […] in der Tasche!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
