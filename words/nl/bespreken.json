{
    "word_family": [
        "bespreking",
        "bespreekbaar",
        "onbesproken",
        "spreken",
        "gesprek"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "12189aa1-1e4c-3606-829a-f8143a9a3d13",
                    "sense_definition": "een gesprek over een bepaald onderwerp voeren; overleggen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "overleg",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Laten we de plannen voor het evenement <w>bespreken</w> tijdens de vergadering.",
                            "target_lang_translations": {
                                "en": "Let's <w>discuss</w> the plans for the event during the meeting."
                            }
                        },
                        {
                            "text": "We moeten de kwestie <w>bespreken</w> voordat we een definitieve beslissing nemen.",
                            "target_lang_translations": {
                                "en": "We need to <w>discuss</w> the issue before we make a final decision."
                            }
                        }
                    ],
                    "synonyms": [
                        "het hebben over",
                        "bediscussiëren"
                    ],
                    "common_phrases": [
                        "kwestie bespreken",
                        "plannen bespreken",
                        "mogelijkheden bespreken"
                    ],
                    "target_lang_definitions": {
                        "en": "to have a conversation about a specific topic; to deliberate or consult"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "discuss",
                                "target_lang_sense_clarification": "to talk about a subject in detail"
                            },
                            {
                                "target_lang_word": "talk over",
                                "target_lang_sense_clarification": "to discuss something thoroughly before making a decision"
                            },
                            {
                                "target_lang_word": "go over",
                                "target_lang_sense_clarification": "to review or examine something together"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f5b3c6c2-399d-3cf3-a334-a2e3e6cdab98",
                    "sense_definition": "vooruit bestellen of reserveren",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "reserveren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij wilden voor de voorstelling twee plaatsen <w>bespreken</w> bij de kassa.",
                            "target_lang_translations": {
                                "en": "They wanted to <w>reserve</w> two seats for the performance at the box office."
                            }
                        },
                        {
                            "text": "Ik wil graag een tafel <w>bespreken</w> voor vier personen vanavond.",
                            "target_lang_translations": {
                                "en": "I would like to <w>book</w> a table for four people tonight."
                            }
                        }
                    ],
                    "common_phrases": [
                        "plaatsen bespreken",
                        "tafel bespreken"
                    ],
                    "target_lang_definitions": {
                        "en": "to order in advance or make a reservation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "reserve",
                                "target_lang_sense_clarification": "to book a table, seat, or room in advance"
                            },
                            {
                                "target_lang_word": "book",
                                "target_lang_sense_clarification": "to arrange for a ticket or service ahead of time"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "128d0db3-53fd-39a7-bd9c-a132a30dacb4",
                    "sense_definition": "een kritische beoordeling geven van een werk; recenseren",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beoordeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het nieuwe boek werd uitgebreid <w>besproken</w> in het literaire supplement van de krant.",
                            "target_lang_translations": {
                                "en": "The new book was <w>reviewed</w> extensively in the newspaper's literary supplement."
                            }
                        },
                        {
                            "text": "De criticus gaat vanavond de nieuwste film <w>bespreken</w> op de nationale televisie.",
                            "target_lang_translations": {
                                "en": "The critic is going to <w>review</w> the latest film on national television tonight."
                            }
                        }
                    ],
                    "common_phrases": [
                        "boek bespreken",
                        "film bespreken"
                    ],
                    "target_lang_definitions": {
                        "en": "to give a critical assessment of a work; to review"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "review",
                                "target_lang_sense_clarification": "to write or give a critical report on a book, film, or play"
                            },
                            {
                                "target_lang_word": "critique",
                                "target_lang_sense_clarification": "to evaluate a work in a detailed and analytical way"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}