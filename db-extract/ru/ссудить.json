                "senses": [
                    {
                        "sense_id": "abe16879-2203-312e-a9f6-f5e06cfcb39b",
                        "entry_id": "88be245f-0c32-3d2f-9770-c84b5b4b8a0a",
                        "glosses": [
                            "дать в долг кому-нибудь что-нибудь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddc87d3b-35dc-4e97-8a8d-9c5ac91bfbc9",
                                "sense_id": "abe16879-2203-312e-a9f6-f5e06cfcb39b",
                                "text": "Ссуди меня пятью рублями. Ссуди мне пять рублей."
                            },
                            {
                                "example_id": "02f7516a-a105-482b-a45e-513c2aa7347a",
                                "sense_id": "abe16879-2203-312e-a9f6-f5e06cfcb39b",
                                "text": "Сделай милость, ссуди меня, - я тебе возвращу."
                            },
                            {
                                "example_id": "10d53e30-8511-4276-9cac-83e80c28d1e0",
                                "sense_id": "abe16879-2203-312e-a9f6-f5e06cfcb39b",
                                "text": "Приятель своего приятеля просил, чтоб бочкою его дни на три он ссудил."
                            }
                        ]
                    }
