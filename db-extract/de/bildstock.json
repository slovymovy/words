                        "cross_references": []
                    },
                    {
                        "translation_id": "8c1a89aa-b482-493d-83f6-91eeb01877c7",
                        "source_entry_id": "22d21f57-ba38-3dd7-9bd1-e21dfafa1f90",
                        "source_sense_id": "b6dd639d-85d0-36b2-a113-6bc556c97a37",
                        "source_sense_description": "Architektur: im Freien auf einem Pfeiler oder Sockel angebrachtes Heiligenbild oder Heiligenfigur",
                        "target_lang_word": "calvaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calvaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4dce7b6d-7aeb-3459-b440-ae26c59fe073",
                                        "entry_id": "5154841e-00ed-32eb-8198-59a8806ca6e2",
                                        "glosses": [
                                            "Mont de Jérusalem, où Jésus-Christ fut crucifié."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d67146b8-2579-41d1-821c-f4cd751f687c",
                                                "sense_id": "4dce7b6d-7aeb-3459-b440-ae26c59fe073",
                                                "text": "Et lorsqu’il prononçait cette phrase désolée : « Mon Dieu, mon Dieu, pourquoi mon âme est-elle triste et pourquoi me troublez-vous ? » le prêtre était bien la figure de Jésus souffrant sur le Calvaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b667d1bc-2c50-3377-b730-2c7fd176d20d",
                                        "entry_id": "5154841e-00ed-32eb-8198-59a8806ca6e2",
                                        "glosses": [
                                            "Monument reproduisant la crucifixion."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c504c42-3133-4dca-b1d4-1f7d80a8f2c2",
                                                "sense_id": "b667d1bc-2c50-3377-b730-2c7fd176d20d",
                                                "text": "En face se verdit à la pluie un de ces bons vieux calvaires bretons, ciselés, sculptés, portant fleurons et personnages."
                                            },
                                            {
                                                "example_id": "5b546453-d726-4dd8-8c5e-2325cee81ddf",
                                                "sense_id": "b667d1bc-2c50-3377-b730-2c7fd176d20d",
                                                "text": "En 1980, Yves-Pascal Castel citait le monument dans son Atlas des croix et calvaires du Finistère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8916b125-3dfc-36b7-881b-d617767fb85b",
                                        "entry_id": "5154841e-00ed-32eb-8198-59a8806ca6e2",
                                        "glosses": [
                                            "Épreuve pénible, très grande douleur ou, au Québec, colère."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f406ee66-aeee-47d3-8f9c-15e12b2b474f",
                                                "sense_id": "8916b125-3dfc-36b7-881b-d617767fb85b",
                                                "text": "Ce service est particulièrement attendu car, dans de nombreuses villes françaises, les transports publics sont un calvaire pour les personnes à mobilité réduite, et dans une moindre mesure, pour les parents dotés de poussettes."
                                            },
                                            {
                                                "example_id": "606d7671-ae47-4dda-9376-4887561767a7",
                                                "sense_id": "8916b125-3dfc-36b7-881b-d617767fb85b",
                                                "text": "Ils sont en calvaire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "calvaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1c222a57-0962-3f20-98f7-0e6956ab6063",
                                        "entry_id": "0582a32a-38de-3123-b755-0e7e625a5ef3",
                                        "glosses": [
                                            "Juron, sacre."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f71bc949-756d-4aa3-8d8d-f3fc24a969a5",
                                                "sense_id": "1c222a57-0962-3f20-98f7-0e6956ab6063",
                                                "text": "Calvaire ! t'écoutes pas encore cet ostie de morron-là !"
                                            },
                                            {
                                                "example_id": "7c43d820-c330-44e0-b32e-7f56be3edeac",
                                                "sense_id": "1c222a57-0962-3f20-98f7-0e6956ab6063",
                                                "text": "Il fonctionne tellement mal (les fréquences ne passent pas à travers certains murs, calvaire !!!) que les policiers et les ambulanciers qui devaient l’utiliser le boudent."
                                            },
                                            {
                                                "example_id": "ebf89096-305e-4888-80ed-4a4b27301e21",
                                                "sense_id": "1c222a57-0962-3f20-98f7-0e6956ab6063",
                                                "text": "Eh ! calvaire ! On va s’enterrer !"
                                            },
                                            {
                                                "example_id": "c59a1a7c-8e63-431c-ae4a-e7922ca390a6",
                                                "sense_id": "1c222a57-0962-3f20-98f7-0e6956ab6063",
                                                "text": "Qui c’est qui t’a dit ça, calvaire ?"
                                            },
                                            {
                                                "example_id": "ef68ee96-e751-4879-9edc-722c4e2f734b",
                                                "sense_id": "1c222a57-0962-3f20-98f7-0e6956ab6063",
                                                "text": "Calvaire ! Tu parles d’une connerie !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b820a295-8bac-48c3-b8a7-1a7e9b782f8e",
                        "source_entry_id": "22d21f57-ba38-3dd7-9bd1-e21dfafa1f90",
                        "source_sense_id": "b6dd639d-85d0-36b2-a113-6bc556c97a37",
                        "source_sense_description": "Architektur: im Freien auf einem Pfeiler oder Sockel angebrachtes Heiligenbild oder Heiligenfigur",
                        "target_lang_word": "cliché",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cliché",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "97ee1967-951d-39cb-bc40-97e346d328fd",
                                        "entry_id": "08dc6446-9d48-3e45-9bf4-b7b483570c19",
                                        "glosses": [
                                            "Commun, rebattu, banal, convenu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccf4e726-9dcb-465b-bb16-6c0a4b617057",
                                                "sense_id": "97ee1967-951d-39cb-bc40-97e346d328fd",
                                                "text": "C’était l’image du bonheur parfait. (En écrivant sur ma mère, en 1986, je l’appellerai « le rêve rose » mais il ne figurera pas dans le livre parce que je n’étais pas sûre de la signification, très clichée, que je lui prêtais alors, celle d’une nostalgie de l’état utérin.)"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cliché",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "abf0841e-9543-3211-ac42-8d9c677083fe",
                                        "entry_id": "e3c3d0d8-9a8f-31ee-89cf-34216e02cdd2",
                                        "glosses": [
                                            "Planche en relief obtenu au moyen du clichage : plaque gravée en relief par un procédé photographique pour imprimer une image ou un texte en typographie."
                                        ],
                                        "tags": [
                                            "Imprimerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3c0788d-d584-416f-a677-50690d1ec999",
                                                "sense_id": "abf0841e-9543-3211-ac42-8d9c677083fe",
                                                "text": "Le cliché d’une page."
                                            },
                                            {
                                                "example_id": "08717662-c6a0-4ce2-850b-de59d7d74d42",
                                                "sense_id": "abf0841e-9543-3211-ac42-8d9c677083fe",
                                                "text": "Faire des corrections sur les clichés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52e18d3e-6796-32ed-a97f-b3ef2dbcac54",
                                        "entry_id": "e3c3d0d8-9a8f-31ee-89cf-34216e02cdd2",
                                        "glosses": [
                                            "Épreuve négative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0be01fc0-1426-482d-b6b9-422ede13d3f0",
                                                "sense_id": "52e18d3e-6796-32ed-a97f-b3ef2dbcac54",
                                                "text": "L’hypogène est un affaiblisseur à base de quinone qui agit comme le persulfate d'ammoniaque en attaquant surtout les parties opaques des clichés sans détruire les demi-teintes légères. Son emploi est donc particulièrement indiqué pour diminuer les contrastes des clichés durs."
                                            },
                                            {
                                                "example_id": "1ed74f8e-b0c9-4ecb-a04a-8cf46f5c62a3",
                                                "sense_id": "52e18d3e-6796-32ed-a97f-b3ef2dbcac54",
                                                "text": "Elle refusait que je la photographiasse, m’expliquant que je ne lui avais pas donné suffisamment d’argent. Alors que moi avec le cliché que je pourrais prendre d’elle, je pouvais gagner plein d’argent là-bas en France sur son dos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4588a35-2f94-38a7-bb27-04e481959b66",
                                        "entry_id": "e3c3d0d8-9a8f-31ee-89cf-34216e02cdd2",
                                        "glosses": [
                                            "Image d’une photographie imprimée"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83e14c02-5522-49c5-8474-7e864a1e1704",
                                                "sense_id": "c4588a35-2f94-38a7-bb27-04e481959b66",
                                                "text": "Le cliché en noir et blanc du chef de l’Etat en plein entraînement de boxe, mise en scène d’une virilité surannée, fait jaser les réseaux sociaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a35dbe6c-c92e-332c-a5fb-dcd720d618a6",
                                        "entry_id": "e3c3d0d8-9a8f-31ee-89cf-34216e02cdd2",
                                        "glosses": [
                                            "Lieu commun ; expression rebattue."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95a57896-fe85-407d-8cd6-ddd28c175b7a",
                                                "sense_id": "a35dbe6c-c92e-332c-a5fb-dcd720d618a6",
                                                "text": "Cette réserve cachait un compliment : au XXᵉ siècle, le poète n’est pas ce distrait, ce tête en l’air cher aux clichés, mais un homme qui sait concilier vie de travail et vie de poésie."
                                            },
                                            {
                                                "example_id": "929dc3a5-369f-462c-aa1e-15f79e0d7c56",
                                                "sense_id": "a35dbe6c-c92e-332c-a5fb-dcd720d618a6",
                                                "text": "Qu’est-ce qu’un cliché, en effet, sinon une vérité qui a perdu la vitalité et la surprise de la découverte ou de l’invention et qui a dégénéré en formule et en évidence?"
                                            },
                                            {
                                                "example_id": "81eeae0c-1940-44f2-b7ee-03f75e4cb9a1",
                                                "sense_id": "a35dbe6c-c92e-332c-a5fb-dcd720d618a6",
                                                "text": "L’autre jour, un ado, dans les clichés de la mode débile des banlieues, parlait à base de « yo » et de « wesh », ne sachant exprimer sa douleur abdominale : le nouveau beauf en quelque sorte !"
                                            },
                                            {
                                                "example_id": "f02f3833-b30d-4344-ab3c-6471d2ff116a",
                                                "sense_id": "a35dbe6c-c92e-332c-a5fb-dcd720d618a6",
                                                "text": "J'aime mon lieu de vie tel qu'il est, assez rustique, sauvage et vivant, pour ne pas ressembler à un cliché dans La Maison de Marie-Claire – soyons honnête, je n'en ai pas les moyens et pourtant je suis une pro dans l’art de la récup’ et du bricolage."
                                            },
                                            {
                                                "example_id": "40fbd993-ec0b-4d91-b8c7-bd37b2dfdb0f",
                                                "sense_id": "a35dbe6c-c92e-332c-a5fb-dcd720d618a6",
                                                "text": "[…] : ce petit branleur avait indiscutablement une tête de vainqueur. Une petite trentaine, les cheveux courts, blonds, brossés en arrière et dorés par le soleil, un physique de maître-nageur, tout du cliché."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb3f5401-932a-3565-8b22-b83b61ac27b3",
                                        "entry_id": "e3c3d0d8-9a8f-31ee-89cf-34216e02cdd2",
                                        "glosses": [
                                            "Synonyme de instantané."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
