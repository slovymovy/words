                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8b919dc-d1d7-4ef3-8373-0a916e6f4b8f",
                                "sense_id": "11c9721e-24d9-373d-af97-8577a5448a79",
                                "text": "Certains linguistes estiment qu’il s’agit plutôt d’un emprunt aux langues turciques, cf. le turcique köbäk ‘chien’."
                            },
                            {
                                "example_id": "21dce54a-cf04-4e7b-b350-e7a4dcaf70e2",
                                "sense_id": "11c9721e-24d9-373d-af97-8577a5448a79",
                                "text": "L’interprétation des données doit évidemment se faire en tenant compte du peu d’étendue de certaines parties de notre coprus, ainsi on ne dispose que d’un seul article pour le celtique, d’un seul également pour le finno-ougrien et d’un seul pour le turcique."
                            }
                        ]
                    }
