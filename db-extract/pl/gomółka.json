                    }
                ],
                "translations": [
                    {
                        "translation_id": "4cbeef2c-7f81-40e4-8f2e-9fda1922e891",
                        "source_entry_id": "f93dd98a-17a3-3cff-8c9d-629028c4e715",
                        "source_sense_id": "eb7da421-66dc-3fb7-809c-33a7d91b953a",
                        "target_lang_word": "lump",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lump",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b0abbec6-0b97-3749-82ad-713c926af197",
                                        "entry_id": "5940c099-65f7-3938-a45c-fd1eaa316eb7",
                                        "glosses": [
                                            "Something that protrudes, sticks out, or sticks together; a cluster or blob; a mound or mass of no particular shape."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79e6cad0-5249-4770-9a88-49eab054a840",
                                                "sense_id": "b0abbec6-0b97-3749-82ad-713c926af197",
                                                "text": "a lump of coal; a lump of clay; a lump of cheese"
                                            },
                                            {
                                                "example_id": "ca25e663-1280-43b0-b3a0-d6eaadc94fd0",
                                                "sense_id": "b0abbec6-0b97-3749-82ad-713c926af197",
                                                "text": "Stir the gravy until there are no more lumps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad5c1d2f-7696-3a82-a817-73b0a53e8aba",
                                        "entry_id": "5940c099-65f7-3938-a45c-fd1eaa316eb7",
                                        "glosses": [
                                            "A swelling or nodule of tissue under the skin or in an internal part of the body."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07160f0b-f4c1-44a0-925d-191a97cfe824",
                                                "sense_id": "ad5c1d2f-7696-3a82-a817-73b0a53e8aba",
                                                "text": "Lumps in the breasts are an indicator of breast cancer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "375a8090-ae36-3706-b785-9ab652774267",
                                        "entry_id": "5940c099-65f7-3938-a45c-fd1eaa316eb7",
                                        "glosses": [
                                            "A group, set, or unit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "442151ce-4d1d-42ba-84d7-68757a118707",
                                                "sense_id": "375a8090-ae36-3706-b785-9ab652774267",
                                                "text": "The money arrived all at once as one big lump sum payment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e254a6b8-92c5-3ae5-8a43-67ff0c17639e",
                                        "entry_id": "5940c099-65f7-3938-a45c-fd1eaa316eb7",
                                        "glosses": [
                                            "A small, shaped mass of sugar, typically about a teaspoonful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00c7c4a2-58c6-4b05-88a3-f9e7abaa5e6b",
                                                "sense_id": "e254a6b8-92c5-3ae5-8a43-67ff0c17639e",
                                                "text": "Do you want one lump or two with your coffee?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e26de98-94f9-3fc9-b4bd-504f423cfb32",
                                        "entry_id": "5940c099-65f7-3938-a45c-fd1eaa316eb7",
                                        "glosses": [
                                            "A dull or lazy person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7f771ad-0e38-43b0-8fae-37744933ced4",
                                                "sense_id": "7e26de98-94f9-3fc9-b4bd-504f423cfb32",
                                                "text": "Don't just sit there like a lump."
                                            },
                                            {
                                                "example_id": "8b4de066-eb67-4aab-940d-d1667dfc89a6",
                                                "sense_id": "7e26de98-94f9-3fc9-b4bd-504f423cfb32",
                                                "text": "\"Thou great Norman lump!\" he muttered. \"If I conjure till Doomsday, I cannot make thee gold.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83185953-efe3-31d6-b7aa-4eca78eacdc1",
                                        "entry_id": "5940c099-65f7-3938-a45c-fd1eaa316eb7",
                                        "glosses": [
                                            "A fat person."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b8ccef57-0bfb-3956-9d6a-7d33bb79c68c",
                                        "entry_id": "5940c099-65f7-3938-a45c-fd1eaa316eb7",
                                        "glosses": [
                                            "A beating or verbal abuse."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e91bbb4d-3e70-46d2-bb29-31d1752bb690",
                                                "sense_id": "b8ccef57-0bfb-3956-9d6a-7d33bb79c68c",
                                                "text": "He's taken his lumps over the years."
                                            },
                                            {
                                                "example_id": "078a5e31-2e0c-4bbb-88d9-0f541d67ec88",
                                                "sense_id": "b8ccef57-0bfb-3956-9d6a-7d33bb79c68c",
                                                "text": "Komer admitted that the United States would probably suffer \"short term lumps\" as a result of Johnson's brusque decision."
                                            },
                                            {
                                                "example_id": "64e33bff-f70c-4bb7-bc59-d47b8ce898f3",
                                                "sense_id": "b8ccef57-0bfb-3956-9d6a-7d33bb79c68c",
                                                "text": "Mr. Katzenberg is now taking his commensurate lumps, particularly because contributors feel he helped disabuse donors’ concerns about Mr. Biden’s physical state."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ce09815-ab6e-388f-8be7-f6b99838cbd0",
                                        "entry_id": "5940c099-65f7-3938-a45c-fd1eaa316eb7",
                                        "glosses": [
                                            "A projection beneath the breech end of a gun barrel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b03235e4-a2d8-391d-9490-6ad31739f06c",
                                        "entry_id": "5940c099-65f7-3938-a45c-fd1eaa316eb7",
                                        "glosses": [
                                            "A kind of fish, the lumpsucker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42f31d6a-b472-44fd-b4b6-97c4a3079c3b",
                                                "sense_id": "b03235e4-a2d8-391d-9490-6ad31739f06c",
                                                "text": "You roast him [the fish] […] just like a lump."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c30038e-8d50-3755-a782-4b8c03533af0",
                                        "entry_id": "5940c099-65f7-3938-a45c-fd1eaa316eb7",
                                        "glosses": [
                                            "Food given to a tramp to be eaten on the road."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fe4266f-1437-43df-b223-3145635139da",
                                                "sense_id": "3c30038e-8d50-3755-a782-4b8c03533af0",
                                                "text": "“A lump,” explained The Whimperer […] “is wot a kin’ lady slips youse w’en youse batter de back door. If she invites youse in and lets youse t’row yer feet unner de table, it’s a set-down. If she slips youse a lunch in a poiper bag, it’s a lump. See? […]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2569343-b6ae-3b2e-acf6-14704f56f4d2",
                                        "entry_id": "5940c099-65f7-3938-a45c-fd1eaa316eb7",
                                        "glosses": [
                                            "The workhouse."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "lump",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ed4860a-ff9c-3065-89ab-7198039b1a16",
                                        "entry_id": "7d826c33-a189-393c-8881-5acfa98ab519",
                                        "glosses": [
                                            "To treat as a single unit; to group together in a casual or chaotic manner (as if forming an ill-defined lump of the items)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "985c59f2-9f44-430a-bf68-f6a4aff7650c",
                                                "sense_id": "8ed4860a-ff9c-3065-89ab-7198039b1a16",
                                                "text": "People tend to lump turtles and tortoises together, when in fact they are different creatures."
                                            },
                                            {
                                                "example_id": "3336dac6-1e50-4711-825a-d4622a747d21",
                                                "sense_id": "8ed4860a-ff9c-3065-89ab-7198039b1a16",
                                                "text": "Most gays don't want to know about us, so lumping us in their support efforts is counter-productive at best."
                                            },
                                            {
                                                "example_id": "ea860857-24b4-46e7-9cfb-169e7dc3a09b",
                                                "sense_id": "8ed4860a-ff9c-3065-89ab-7198039b1a16",
                                                "text": "Pellegrini’s decision to operate with both Edin Dzeko and Agüero in attack certainly looks misjudged bearing in mind that the first way to stop Barcelona is usually to try to crowd midfield and restrict space. Yet it would be wrong to lump all the blame on the manager’s tactics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6476bb2c-c19e-3880-addb-d04aa968b27b",
                                        "entry_id": "7d826c33-a189-393c-8881-5acfa98ab519",
                                        "glosses": [
                                            "To bear (a heavy or awkward burden); to carry (something unwieldy) from one place to another."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "377d1827-05cc-48b9-adb9-7c51e466a6f3",
                                                "sense_id": "6476bb2c-c19e-3880-addb-d04aa968b27b",
                                                "text": "Well, a male body was brought to a certain surgeon by a man he had often employed, and the pair lumped it down on the dissecting table, and then the vendor received his money and went."
                                            },
                                            {
                                                "example_id": "228bc2c3-a2b3-4f98-8d63-d804111f2b4a",
                                                "sense_id": "6476bb2c-c19e-3880-addb-d04aa968b27b",
                                                "text": "I never ceased to be amazed at his prowess at being able to lump two-hundredweight sacks of coal, which seemed as big as he was, up perhaps four flights of narrow stairs"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5c85192-0c30-3214-b956-3fdc013b9cfe",
                                        "entry_id": "7d826c33-a189-393c-8881-5acfa98ab519",
                                        "glosses": [
                                            "To burden (someone) with an undesired task or responsibility."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c53db380-cb38-43a8-98e1-589cfa1f4670",
                                                "sense_id": "f5c85192-0c30-3214-b956-3fdc013b9cfe",
                                                "text": "The Luftwaffe, at this point, was still refusing to play ball completely, however. But someone decided to lump Adolf Galland with command of the air operation, and he decided to work with Luftflotte 3, mobilizing their training units to make up the numbers, since large numbers of that particular formation's fighters had been diverted to the campaign in Russia, which was why the fighter numbers were so much lower than they had been the previous year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68075d04-948d-3fee-8502-a7c9b4b13034",
                                        "entry_id": "7d826c33-a189-393c-8881-5acfa98ab519",
                                        "glosses": [
                                            "To hit or strike (a person)."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd4595c7-baec-4597-bb59-5b27a69e3703",
                                                "sense_id": "68075d04-948d-3fee-8502-a7c9b4b13034",
                                                "text": "If that's the only way you can fight, then you'd better be prepared to get lumped."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa7fa00b-3b76-3541-ab9e-14595129394b",
                                        "entry_id": "7d826c33-a189-393c-8881-5acfa98ab519",
                                        "glosses": [
                                            "To form a lump or lumps."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1b4adfb-8b38-4683-ab07-4c7660336645",
                                                "sense_id": "fa7fa00b-3b76-3541-ab9e-14595129394b",
                                                "text": "Thin the paint with mineral spirits for a medium consistency so that it will not drip or lump."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b0af3c2-3b2a-4def-b615-f75efce23b9b",
                        "source_entry_id": "f93dd98a-17a3-3cff-8c9d-629028c4e715",
                        "source_sense_id": "ec6498a8-efc0-3bd4-8f98-2ef652a616a2",
                        "target_lang_word": "crown glass",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crown glass",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1271f955-9ac8-3e31-8488-0c71f20344f6",
                                        "entry_id": "a9055b62-fd0c-3ccb-855c-a1ec3d7f38d9",
                                        "glosses": [
                                            "An early type of window glass made by blowing glass into a hollow globe (crown) and then flattening it on a punty, reheating and spinning out into a flat disk by centrifugal force."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0487ea24-0e15-304f-aeb5-6eff449d649c",
                                        "entry_id": "a9055b62-fd0c-3ccb-855c-a1ec3d7f38d9",
                                        "glosses": [
                                            "A variety of glass used in lenses and other optical components due to its low refractive index and dispersion. Originally crown glass was made from alkali-lime silicates with approximately 10% potassium oxide, but similar properties may be attained with other recipes."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38f272ea-e24e-4678-b003-df32396db9a1",
                                                "sense_id": "0487ea24-0e15-304f-aeb5-6eff449d649c",
                                                "text": "The convex half of an achromatic lens is composed of crown glass."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
