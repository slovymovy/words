                                "sense_id": "485e9f64-74e6-30aa-b37b-3c87b162bc78",
                                "text": "„Als Jahresmittel werden in der Meteorologie und Klimatologie die Mittelwerte von Messgrößen eines bestimmten Ortes bezeichnet, die sich etwa mit Jahresperiode ändern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
