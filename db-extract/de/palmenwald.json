                "senses": [
                    {
                        "sense_id": "7635d060-bbc4-3082-b1e8-2b43c7cc159b",
                        "entry_id": "5f24bbe0-0674-3d3e-a563-998e995d295a",
                        "glosses": [
                            "vorwiegend aus Palmenbäumen bestehender Wald"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb97f73e-76bc-48af-839f-7d3ccf361481",
                                "sense_id": "7635d060-bbc4-3082-b1e8-2b43c7cc159b",
                                "text": "„Nachdem er die Grenze der Stadt überschritten hatte, gelangte er zwischen ausgedehnten Reis-, Maniok- und Pisangpflanzungen in einen Palmenwald, welcher nach einiger Zeit in einen dichten Teakforst überging.“"
                            },
                            {
                                "example_id": "54cfd382-fe7f-4c8c-8dee-c7656a7a0014",
                                "sense_id": "7635d060-bbc4-3082-b1e8-2b43c7cc159b",
                                "text": "„Vorbei ging es an Palmenwäldern und einsamen Hütten, und plötzlich lag es vor uns: Tenganan – das älteste Dorf Balis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
