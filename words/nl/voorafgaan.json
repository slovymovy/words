{
    "word_family": [
        "voorafgaand",
        "voorafgaande",
        "voorganger",
        "voorgang"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a6d8db35-ce32-3ffd-bf97-fe23f8752423",
                    "sense_definition": "eerder gebeuren of plaatsvinden in de tijd dan iets anders",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "tijdsvolgorde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De seconden die <w>voorafgaan</w> aan een uittrap van de doelman lijken soms wel minuten.",
                            "target_lang_translations": {
                                "en": "The seconds that <w>precede</w> a goalkeeper's goal kick sometimes seem like minutes."
                            }
                        },
                        {
                            "text": "Er moet een grondig onderzoek aan de beslissing <w>voorafgaan</w> om fouten te voorkomen.",
                            "target_lang_translations": {
                                "en": "A thorough investigation must <w>precede</w> the decision to prevent mistakes."
                            }
                        }
                    ],
                    "synonyms": [
                        "voorgaan",
                        "precederen"
                    ],
                    "antonyms": [
                        "volgen",
                        "opvolgen"
                    ],
                    "common_phrases": [
                        "aan de beslissing voorafgaan",
                        "aan de gebeurtenis voorafgaan"
                    ],
                    "target_lang_definitions": {
                        "en": "To happen or take place earlier in time than something else"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "precede",
                                "target_lang_sense_clarification": "to happen before something else"
                            },
                            {
                                "target_lang_word": "go before",
                                "target_lang_sense_clarification": "to occur earlier in time"
                            },
                            {
                                "target_lang_word": "lead up to",
                                "target_lang_sense_clarification": "to happen in the period before an event"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92005e37-a820-3b1d-8d3e-9382c5e1797a",
                    "sense_definition": "belangrijker worden geacht of prioriteit krijgen boven iets anders",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "prioriteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In deze crisissituatie moet veiligheid altijd aan economische belangen <w>voorafgaan</w>.",
                            "target_lang_translations": {
                                "en": "In this crisis situation, safety must always <w>take precedence</w> over economic interests."
                            }
                        },
                        {
                            "text": "Vredesbeleid moet in dit specifieke geval <w>voorafgaan</w> aan ontwikkelingsbeleid.",
                            "target_lang_translations": {
                                "en": "Peace policy must <w>come before</w> development policy in this specific case."
                            }
                        }
                    ],
                    "synonyms": [
                        "voorgaan"
                    ],
                    "antonyms": [
                        "ondergeschikt zijn"
                    ],
                    "common_phrases": [
                        "moet voorafgaan aan"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak gebruikt in formele of beleidsmatige contexten"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To be considered more important or to be given priority over something else"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "take precedence",
                                "target_lang_sense_clarification": "to be more important or have priority"
                            },
                            {
                                "target_lang_word": "precede",
                                "target_lang_sense_clarification": "to have higher rank or priority"
                            },
                            {
                                "target_lang_word": "come before",
                                "target_lang_sense_clarification": "to be more important than"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7361f443-a4d5-35b1-80b6-b8a838cbc26c",
                    "sense_definition": "fysiek voor iemand of iets uit lopen of rijden in een stoet of optocht",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fysieke verplaatsing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De mannen met bijlen en baarden <w>gingen</w> de schutters in de lange optocht <w>vooraf</w>.",
                            "target_lang_translations": {
                                "en": "The men with axes and beards <w>preceded</w> the marksmen in the long procession."
                            }
                        },
                        {
                            "text": "Een muziekkorps zal de stoet <w>voorafgaan</w> tijdens de feestelijke intocht in de stad.",
                            "target_lang_translations": {
                                "en": "A brass band will <w>lead</w> the procession during the festive entry into the city."
                            }
                        }
                    ],
                    "synonyms": [
                        "voorgaan"
                    ],
                    "antonyms": [
                        "volgen",
                        "achteraanlopen"
                    ],
                    "common_phrases": [
                        "de stoet voorafgaan"
                    ],
                    "target_lang_definitions": {
                        "en": "To physically walk or drive in front of someone or something in a procession or parade"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "precede",
                                "target_lang_sense_clarification": "to go in front of in a procession"
                            },
                            {
                                "target_lang_word": "lead",
                                "target_lang_sense_clarification": "to go at the head of a group"
                            },
                            {
                                "target_lang_word": "go ahead of",
                                "target_lang_sense_clarification": "to move in front of"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}