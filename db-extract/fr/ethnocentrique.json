                                "example_id": "f92d2f30-d2e7-4661-b5f0-2956bc81b71a",
                                "sense_id": "0f721a1b-ec26-338a-8978-9b0713799950",
                                "text": "La rhétorique moderne est prolixe en slogans ou percent la suffisance de la sagesse rétrospective et l’anachronisme ethnocentrique."
                            },
                            {
                                "example_id": "dfcff522-2645-4c70-8f36-959d81ce79a1",
                                "sense_id": "0f721a1b-ec26-338a-8978-9b0713799950",
                                "text": "Les Canadiens de toutes les origines manifestent des tendances ethnocentriques, mais les francophones sont les plus ethnocentriques de tous, concluent deux chercheurs de l'université Queen's, de Kingston en Ontario."
                            }
                        ]
