                "senses": [
                    {
                        "sense_id": "f24583b6-f389-3c63-a377-4efa4c5c94b8",
                        "entry_id": "0a567393-c3ff-34e7-90bc-9bb4c51ff237",
                        "glosses": [
                            "feiner Draht aus Platin, der beim Druckvorgang unter Hochspannung gesetzt wird, um elektrische Ladungen auf die Bildtrommel aufzubringen"
                        ],
                        "tags": [
                            "Druckwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "ab0fcd8f-92f3-47a1-a23a-8e6d8a4d5a97",
                                "sense_id": "f24583b6-f389-3c63-a377-4efa4c5c94b8",
                                "text": "„Werden nur noch weiße Seiten ausgegeben, ist der Koronadraht defekt, das Gerät muss vom Fachmann repariert werden.“"
                            },
                            {
                                "example_id": "ef8ca43d-5d12-44d5-966b-e65645ceaf42",
                                "sense_id": "f24583b6-f389-3c63-a377-4efa4c5c94b8",
                                "text": "„Bei Vorversuchen traten Schwierigkeiten durch Längenänderungen des Koronadrahts unter Einfluß der Hochspannung auf.“"
                            },
                            {
                                "example_id": "4b326eab-80f3-4d5b-83c8-90dde5d183b9",
                                "sense_id": "f24583b6-f389-3c63-a377-4efa4c5c94b8",
                                "text": "„In dem Augenblick, in dem er auf irgendeine Taste tippt, fließen sechshundert Volt durch den Koronadraht des Druckers, den ich durchtrennt habe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
