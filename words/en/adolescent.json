            "senses": [
                {
                    "sense_id": "8aab9c6c-53ab-3eb2-9af2-ad64d596dcdf",
                    "sense_definition": "A young person who is developing from a child into an adult",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The program is specifically designed to help a <w>adolescent</w> navigate the challenges of high school.",
                            "target_lang_translations": {
                                "ru": "Программа специально разработана, чтобы помочь <w>подростку</w> справиться с трудностями старшей школы."
                            }
                        },
                        {
                            "text": "Many <w>adolescents</w> struggle with their identity as they transition into adulthood.",
                            "target_lang_translations": {
                                "ru": "Многие <w>подростки</w> сталкиваются с проблемой самоопределения при переходе во взрослую жизнь."
                            }
                        }
                    ],
                    "synonyms": [
                        "teenager",
                        "youth",
                        "minor"
                    ],
                    "antonyms": [
                        "adult"
                    ],
                    "common_phrases": [
                        "troubled adolescent",
                        "healthy adolescent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Молодой человек, находящийся в процессе перехода из детского возраста во взрослый"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подросток",
                                "target_lang_sense_clarification": "человек в возрасте от 12 до 17 лет"
                            },
                            {
                                "target_lang_word": "юноша",
                                "target_lang_sense_clarification": "молодой человек мужского пола"
                            },
                            {
                                "target_lang_word": "девушка",
                                "target_lang_sense_clarification": "молодой человек женского пола"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "012d053d-7229-32a8-b9f0-d5f38ada8159",
                    "sense_definition": "Relating to or characteristic of the stage of life between childhood and adulthood",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "age",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor specializes in <w>adolescent</w> medicine and understands the unique needs of teenagers.",
                            "target_lang_translations": {
                                "ru": "Врач специализируется на <w>подростковой</w> медицине и понимает уникальные потребности тинейджеров."
                            }
                        },
                        {
                            "text": "He displayed <w>adolescent</w> behavior by refusing to take responsibility for his actions.",
                            "target_lang_translations": {
                                "ru": "Он продемонстрировал <w>подростковое</w> поведение, отказавшись брать на себя ответственность за свои поступки."
                            }
                        }
                    ],
                    "synonyms": [
                        "juvenile",
                        "teenage",
                        "youthful"
                    ],
                    "antonyms": [
                        "mature",
                        "adult"
                    ],
                    "common_phrases": [],
                    "target_lang_definitions": {
