                                        "examples": [
                                            {
                                                "example_id": "3ae4f55d-b175-4873-ab20-bb8dd0ffb100",
                                                "sense_id": "a1d385ff-1997-3e0e-afbf-cb90c71bb2d0",
                                                "text": "In January of this year, deposits expanded to 11.294 billion guaranis, but then dropped to 10.219 billion in February."
                                            },
                                            {
                                                "example_id": "82e964ea-7cda-4666-bf47-62cdd2346e70",
                                                "sense_id": "a1d385ff-1997-3e0e-afbf-cb90c71bb2d0",
                                                "text": "The rules of the risk game were as follows: The player was given 8,000 guaranies (two-thirds of a day's wages) and could choose to bet nothing, 2,000, 4,000, 6,000, or all 8,000 guaranies."
                                            },
                                            {
                                                "example_id": "00ef385d-19fe-4da8-abfd-7df3b5952455",
                                                "sense_id": "a1d385ff-1997-3e0e-afbf-cb90c71bb2d0",
                                                "text": "On November 15, the market rate stood at 3,330 guaranies to the dollar."
                                            }
