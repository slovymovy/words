                                        "sense_id": "7bdb0365-78c4-304f-8833-b12821fe1018",
                                        "entry_id": "778f73df-14cc-3c02-8576-a72e3f1359db",
                                        "glosses": [
                                            "Addiction to alcohol."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b3bded96-c1ff-3d99-adde-63a0d0973d79",
                                        "entry_id": "778f73df-14cc-3c02-8576-a72e3f1359db",
                                        "glosses": [
                                            "Specifically periodic alcoholism, characterized by bouts of heavy drinking rather than continuous indulgence in alcohol."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "45b1fd7d-d3aa-3d65-87b1-452f2073cb31",
                                        "entry_id": "778f73df-14cc-3c02-8576-a72e3f1359db",
                                        "glosses": [
                                            "A strong craving for something."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db4a1ba1-35cf-4483-ab6a-580d36eb9516",
                                                "sense_id": "45b1fd7d-d3aa-3d65-87b1-452f2073cb31",
                                                "text": "A most ingenuous youth was Master Snape, round-eyed, round-cheeked, with an ever ready smooth and round unvarnished tale—a youth afflicted with a dipsomania for information."
                                            },
                                            {
                                                "example_id": "90df98c3-e54e-4823-9e73-02ccb7945056",
                                                "sense_id": "45b1fd7d-d3aa-3d65-87b1-452f2073cb31",
                                                "text": "\"You must regard my passion for painting,\" he began once more, \"as a sort of dipsomania—I really can't help myself.\""
                                            },
                                            {
                                                "example_id": "b7135e82-f1e4-4637-9918-5f46fd597dfe",
                                                "sense_id": "45b1fd7d-d3aa-3d65-87b1-452f2073cb31",
                                                "text": "Such a negative outcome seemed impossible to investors experiencing dot-com dipsomania in late 1999 and early 2000."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f98c636f-e57e-4b80-988e-4c2b013ebbdf",
                        "source_entry_id": "93d24247-e363-3467-a7f3-0a36dd4bdb8e",
                        "source_sense_id": "d5fd7058-0b56-3f6b-be0b-622818d09073",
                        "source_sense_description": "anfallsweise auftretende Trunksucht",
                        "target_lang_word": "dipsomanie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dipsomanie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fa677c42-c5e8-3141-b3ed-171d4bc4bf7b",
                                        "entry_id": "04929a66-05c9-394c-a2c6-064f67bd948c",
                                        "glosses": [
                                            "Delirium tremens."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "856fe065-a8bf-4b91-b1f8-65747d898bf3",
                                                "sense_id": "fa677c42-c5e8-3141-b3ed-171d4bc4bf7b",
                                                "text": "Des représentants de commerce chantaient des goualantes de corps de garde en l'honneur de leurs confrères, tous tués au volant en rentrant à leur logis dans un profond état de dipsomanie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae28b705-4ae6-3f05-96ff-1193ef770dd1",
                                        "entry_id": "04929a66-05c9-394c-a2c6-064f67bd948c",
                                        "glosses": [
                                            "Potomanie essentiellement alcoolique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a7ed0b2-7975-414a-94de-285d3aecdd50",
                                                "sense_id": "ae28b705-4ae6-3f05-96ff-1193ef770dd1",
                                                "text": "Le Vrai est vrai, le fait est réel indépendamment du chercheur : simplement, le chercheur en a la passion ; la dipsomanie du fait détermine son caractère, et il se soucie comme d’une guigne de savoir si ses constatations engendreront quelque chose de total, d’humain, d’accompli, ou si elles engendreront quoi que ce soit."
                                            },
                                            {
                                                "example_id": "5a2759b0-618b-4341-ac6f-b18c7cd7f0b8",
                                                "sense_id": "ae28b705-4ae6-3f05-96ff-1193ef770dd1",
                                                "text": "Ils étaient souvent témoins des engueulades entre Gérard et Le Poulpe, mais là, même dans les brumes de leur dipsomanie, ils sentaient percer une manière d'acidité, voire de violence froide qui n'avait jamais été là auparavant, même quand le ton montait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
