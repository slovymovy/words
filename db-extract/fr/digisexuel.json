                ],
                "senses": [
                    {
                        "sense_id": "defaf6d0-4fb5-3186-9eae-fca020936b16",
                        "entry_id": "1237831a-8fcb-3b4d-a34b-4338d85a3e6e",
                        "glosses": [
                            "Individu qui est sexuellement attiré par les robots ou d’autres formes de sexualité basée sur la technologie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9077c5de-a15f-4f2a-8697-541f5c91bd19",
                                "sense_id": "defaf6d0-4fb5-3186-9eae-fca020936b16",
                                "text": "Les gens que nous appelons « digisexuels » se tournent vers des technologies avancées, comme les robots, les environnements de réalité virtuelle (RV) et les dispositifs de rétroaction, aussi connues sous le nom de télésexe, pour remplacer les partenaires humains."
                            },
                            {
                                "example_id": "4293a56e-9be7-46b0-885f-993e86c54638",
                                "sense_id": "defaf6d0-4fb5-3186-9eae-fca020936b16",
                                "text": "Il y a (et aura de plus en plus) des digisexuels, comme il y a des fétichistes, des polyamoureux ou des sadomasochistes."
                            }
                        ]
                    }
                ],
