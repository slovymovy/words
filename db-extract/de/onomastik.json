                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84b148b0-5bfd-4741-b6a2-163a98de6b2f",
                                "sense_id": "f5fe97e6-7bf0-348e-8ec7-b6f99f48fb86",
                                "text": "Die Onomastik erforscht die Entwicklung, Etymologie und Verbreitung von Eigennamen. — L’onomastique étudie le développement, l’étymologie et l’étendue géographique des noms propres."
                            }
                        ]
                    }
                ],
