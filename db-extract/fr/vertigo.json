                                    {
                                        "sense_id": "53e37c38-e9de-38c3-a548-90ba0af6c286",
                                        "entry_id": "da5787f1-9d87-3bfe-82e4-810d548ced88",
                                        "glosses": [
                                            "plötzlicher Anfall von Betriebsamkeit, verrückte Idee, verrückte Laune; hauptsächlich früher: plötzlicher Anfall von Wahnsinn oder Zorn"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb2bfeb1-25d3-4a65-a3c4-0ac44a26c061",
                                                "sense_id": "53e37c38-e9de-38c3-a548-90ba0af6c286",
                                                "text": "Selbst Mitautoren eines Wörterbuches können von einem Rappel befallen werden."
                                            },
                                            {
                                                "example_id": "87ee854d-4df7-4583-8496-66b848b82f7f",
                                                "sense_id": "53e37c38-e9de-38c3-a548-90ba0af6c286",
                                                "text": "Was, das Geld ist noch immer nicht auf meinem Konto? Ich krieg' 'nen Rappel!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
