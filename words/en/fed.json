        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "50a299a8-dd58-3aef-bde1-f4b827b7f18e",
                    "sense_definition": "The central banking system of the United States; short for the Federal Reserve.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "Investors are waiting to see if the <w>Fed</w> will raise interest rates again.",
                            "target_lang_translations": {
                                "ru": "Инвесторы ждут, повысит ли <w>ФРС</w> процентные ставки снова.",
                                "tr": "Yatırımcılar <w>FED</w>'in faiz oranlarını tekrar artırıp artırmayacağını görmek için bekliyor.",
                                "nl": "Beleggers wachten af of de <w>Fed</w> de rente opnieuw zal verhogen.",
                                "fr": "Les investisseurs attendent de voir si la <w>Fed</w> va augmenter à nouveau les taux d'intérêt."
                            }
                        },
                        {
                            "text": "The report suggests that the <w>Fed</w> is concerned about inflation.",
                            "target_lang_translations": {
                                "ru": "В отчете говорится, что <w>ФРС</w> обеспокоена инфляцией.",
                                "tr": "Rapor, <w>FED</w>'in enflasyon konusunda endişeli olduğunu gösteriyor.",
                                "nl": "Het rapport suggereert dat de <w>Fed</w> zich zorgen maakt over de inflatie.",
                                "fr": "Le rapport suggère que la <w>Fed</w> est préoccupée par l'inflation."
                            }
                        }
                    ],
                    "common_phrases": [
                        "the Fed"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "clipping"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Центральная банковская система США; сокращение от Федеральной резервной системы.",
                        "tr": "Amerika Birleşik Devletleri'nin merkez bankacılık sistemi; Federal Rezerv'in kısaltması.",
                        "nl": "Het centrale bankensysteem van de Verenigde Staten; afkorting van Federal Reserve.",
                        "fr": "Le système bancaire central des États-Unis ; abréviation de « Federal Reserve »."
                    },
                    "translations": {
