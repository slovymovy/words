                        "glosses": [
                            "Of, relating to, or influenced by Thomas Hobbes or his philosophical theories."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "deddabbf-fcd3-478e-98dd-df9f9ee96948",
                                "sense_id": "28e585c9-5fc2-390c-8b44-32b90ebb2adb",
                                "text": "a Hobbesian theory of the state"
                            }
                        ]
                    },
                    {
                        "sense_id": "a60d65fa-7021-34b3-ae38-5edb8ba54030",
                        "entry_id": "9f7d6fb7-c7a5-39a6-8e7b-d770abf636cf",
                        "glosses": [
                            "Involving unrestrained, selfish, and uncivilized competition."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "86c0c687-4a9d-4e32-b8ae-f7f19e925bd1",
                                "sense_id": "a60d65fa-7021-34b3-ae38-5edb8ba54030",
                                "text": "a cutthroat, Hobbesian environment"
                            },
                            {
                                "example_id": "d71c5749-4c01-44ff-9045-73a70b6d2d60",
                                "sense_id": "a60d65fa-7021-34b3-ae38-5edb8ba54030",
                                "text": "In Hammett's writings, the social is constructed as a vast Hobbesian landscape of grim functionaries and desperate scrabblers […]"
                            },
                            {
                                "example_id": "2ef3feed-091b-4342-8b3c-961d9c810c8c",
                                "sense_id": "a60d65fa-7021-34b3-ae38-5edb8ba54030",
                                "text": "Yet the focus on pushing for the best result has also fueled what current and former Uber employees describe as a Hobbesian environment at the company, in which workers are sometimes pitted against one another and where a blind eye is turned to infractions from top performers."
                            }
                        ]
                    }
