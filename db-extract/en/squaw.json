                "senses": [
                    {
                        "sense_id": "d31f6219-c61c-30cc-bb78-67e577e88e30",
                        "entry_id": "bc42ab5c-c7c3-392b-8c50-5b09487e1f1a",
                        "glosses": [
                            "A woman, wife; especially a Native American woman."
                        ],
                        "tags": [
                            "ethnic",
                            "offensive",
                            "slur"
                        ],
                        "examples": [
                            {
                                "example_id": "c8fb35ee-d18a-41a8-bf04-bea5176aa374",
                                "sense_id": "d31f6219-c61c-30cc-bb78-67e577e88e30",
                                "text": "The Indian maids, of course, turned out to be a few fat old squaws who knew all about white men."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57c5384b-5c10-4325-8f9c-88672a4832bb",
                        "source_entry_id": "bc42ab5c-c7c3-392b-8c50-5b09487e1f1a",
                        "source_sense_id": "d31f6219-c61c-30cc-bb78-67e577e88e30",
                        "source_sense_description": "a woman, wife; especially a Native American woman",
                        "target_lang_word": "squaw",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "squaw",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1b3ce5d6-d516-3fdb-b823-5bfc572b4735",
                                        "entry_id": "c0aec1cb-25aa-3aed-b9f1-60bbf9673d8e",
                                        "glosses": [
                                            "Femme indienne d’Amérique du Nord."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad5c7118-dd7f-498f-a17d-706247c4ec25",
                                                "sense_id": "1b3ce5d6-d516-3fdb-b823-5bfc572b4735",
                                                "text": "Ces chefs, au nombre d’une douzaine, n’avaient point amené leurs femmes, malheureuses « squaws » qui ne s’élèvent guère au-dessus de la condition d’esclaves."
                                            },
                                            {
                                                "example_id": "8190e56f-9b64-4837-810e-428f2de58608",
                                                "sense_id": "1b3ce5d6-d516-3fdb-b823-5bfc572b4735",
                                                "text": "Si jolie, si délicate – on aurait dit qu’elle n’appartenait pas à la même espèce que les squaws apaches, lourdes, grosses, trapues, qui ne savaient s’exprimer qu’en vociférant, rusées comme des singes, cruelles comme des panthères."
                                            },
                                            {
                                                "example_id": "b6f6df5a-5bd5-45c2-b236-ba53f88e38c9",
                                                "sense_id": "1b3ce5d6-d516-3fdb-b823-5bfc572b4735",
                                                "text": "– Bon sang, y a toutes les chances, au contraire ! Si je trouvais une squaw à mon goût, je serais bien capable de l’épouser."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a0d52ab-f580-48ef-953f-c58d0d9d6c4a",
                        "source_entry_id": "bc42ab5c-c7c3-392b-8c50-5b09487e1f1a",
                        "source_sense_id": "d31f6219-c61c-30cc-bb78-67e577e88e30",
