                "translations": [
                    {
                        "translation_id": "6265a095-fe3c-404b-b298-eab4462e49fc",
                        "source_entry_id": "8dfb4996-08b8-3643-821a-e88dae4ab05d",
                        "source_sense_id": "af664d04-add5-39cc-9708-34a462351b60",
                        "target_lang_word": "sash",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3288f32-8be3-34bd-801a-8b17459afc2d",
                                        "entry_id": "f086d714-b0f4-3e5a-b920-57177d0eb202",
                                        "glosses": [
                                            "A piece of cloth designed to be worn around the waist."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "afe64252-4e0d-38b7-aa42-11dc10295de4",
                                        "entry_id": "f086d714-b0f4-3e5a-b920-57177d0eb202",
                                        "glosses": [
                                            "A decorative length of cloth worn over the shoulder to the opposite hip, often for ceremonial or other formal occasions."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cc99e596-ae6c-3386-ade5-de691a16d42f",
                                        "entry_id": "f086d714-b0f4-3e5a-b920-57177d0eb202",
                                        "glosses": [
                                            "Alternative spelling of shash (“the scarf of a turban”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c130b79d-6afd-443a-b2b8-23cf6e15d32d",
                                                "sense_id": "cc99e596-ae6c-3386-ade5-de691a16d42f",
                                                "text": "So much for the ſilk in Judea called Sheſh in Hebrevv, vvhence haply, that fine linen or ſilk is called Shaſhes vvorn at this day about the heads of eaſtern people."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3217817d-9872-3827-80d5-779843fe990a",
                                        "entry_id": "92f9ff20-4ddb-37b8-8e14-11d3fd0c9cf4",
                                        "glosses": [
                                            "To adorn with a sash."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02ba1f21-6ea9-4f9f-be88-83b063d52b04",
                                                "sense_id": "3217817d-9872-3827-80d5-779843fe990a",
                                                "text": "1796, Edmund Burke, Letters on a Regicide Peace, Letter IV to the Earl Fitzwilliam, in The Works of the Right Honourable Edmund Burke, London: C. and J. Rivington, 1826, Volume 9, p. 46,\n[…] the Costume of the Sans-culotte Constitution of 1793 was absolutely insufferable […] but now they are so powdered and perfumed, and ribanded, and sashed and plumed, that […] there is something in it more grand and noble, something more suitable to an awful Roman Senate, receiving the homage of dependant Tetrarchs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6aae746-93f2-3bcd-9b36-01e36d6e0d30",
                                        "entry_id": "55e541f5-83fc-359d-b584-0c19f70856b4",
                                        "glosses": [
                                            "The opening part of a window, usually containing the glass panes; either hinged to the jamb, or sliding up and down as in a sash window."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c35cafbb-1dda-496f-ba9e-1b80a3463728",
                                                "sense_id": "d6aae746-93f2-3bcd-9b36-01e36d6e0d30",
                                                "text": "Near-synonym: casement"
                                            },
                                            {
                                                "example_id": "d7229011-6003-4302-a264-3525a4712b64",
                                                "sense_id": "d6aae746-93f2-3bcd-9b36-01e36d6e0d30",
                                                "text": "One Morning he pulls off his Diamond Ring, and vvrites upon the Glaſs of the Saſh in my Chamber this Line, You I Love, and you alone."
                                            },
                                            {
                                                "example_id": "b0cc74de-67c9-478a-8b50-812a629fb631",
                                                "sense_id": "d6aae746-93f2-3bcd-9b36-01e36d6e0d30",
                                                "text": "1823, Clement Clarke Moore, “Account of a Visit from St. Nicholas” (“The Night before Christmas”),\nAway to the window I flew like a flash,\nTore open the shutters, and threw up the sash."
                                            },
                                            {
                                                "example_id": "cf89f279-63d6-44d6-9b72-167dc8f50175",
                                                "sense_id": "d6aae746-93f2-3bcd-9b36-01e36d6e0d30",
                                                "text": "\"In judging of that tempestuous wind called Euroclydon,\" says an old writer—of whose works I possess the only copy extant—\"it maketh a marvellous difference, whether thou lookest out at it from a glass window where the frost is all on the outside, or whether thou observest it from that sashless window, where the frost is on both sides, and of which the wight Death is the only glazier.\""
                                            },
                                            {
                                                "example_id": "a3e145cc-a64e-4750-9b6d-de889c0f92fe",
                                                "sense_id": "d6aae746-93f2-3bcd-9b36-01e36d6e0d30",
                                                "text": "She chiefly recalled the Square under snow; cold mornings, and the coldness of the oil-cloth at the window, and the draught of cold air through the ill-fitting sash (it was put right now)!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5808b357-ce51-376b-9f67-b445cd8bf351",
                                        "entry_id": "55e541f5-83fc-359d-b584-0c19f70856b4",
                                        "glosses": [
                                            "A draggable vertical or horizontal bar used to adjust the relative sizes of two adjacent windows."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "03a19315-1e02-340d-a2aa-62147f9557e3",
                                        "entry_id": "55e541f5-83fc-359d-b584-0c19f70856b4",
                                        "glosses": [
                                            "The rectangular frame in which the saw is strained and by which it is carried up and down with a reciprocating motion; the gate."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "67120035-1fb5-3906-b213-2f484a05dc0e",
                                        "entry_id": "55e541f5-83fc-359d-b584-0c19f70856b4",
                                        "glosses": [
                                            "A window-like part of a fume hood which can be moved up and down in order to create a barrier between chemicals and people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19a574f7-9e26-41a2-8d9a-d886f6f38118",
                                                "sense_id": "67120035-1fb5-3906-b213-2f484a05dc0e",
                                                "text": "Each hood is equipped with two sliding sashes, glazed with polished plate wire-glass; […]"
                                            },
                                            {
                                                "example_id": "f0c22476-e531-44a6-bb10-56a7819c4b39",
                                                "sense_id": "67120035-1fb5-3906-b213-2f484a05dc0e",
                                                "text": "[…] it [fume hood] also affords an excellent physical barrier on all four sides of a reacting system when the sash is pulled down."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0af7fcf7-73c2-36d5-8c48-00b7369ca43c",
                                        "entry_id": "96be2cb9-77dc-3e89-b44a-fcecd95a15d4",
                                        "glosses": [
                                            "To furnish with a sash."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35e48290-1762-4de5-a455-408b14869c75",
                                                "sense_id": "0af7fcf7-73c2-36d5-8c48-00b7369ca43c",
                                                "text": "The old Bow-windows he will have preserv'd, but will not have them sash’d,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
