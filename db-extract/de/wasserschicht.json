                "senses": [
                    {
                        "sense_id": "79a323dc-6a4f-3aba-b4ff-f37e15ee74ae",
                        "entry_id": "ee8d3023-f84c-3c3c-bae4-485568e33618",
                        "glosses": [
                            "horizontaler Bereich im Wasser eines Gewässers, der sich durch bestimmte Merkmale (Temperatur, Salzgehalt oder Ähnliches) von anderen Bereichen abgrenzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b7146ee-0ee6-4576-b98f-c09904a43249",
                                "sense_id": "79a323dc-6a4f-3aba-b4ff-f37e15ee74ae",
                                "text": "„Doch seit 2011 breiten sich die Golftange explosionsartig aus – auch an Orten, an denen sie zuvor nicht vorkamen und gefährden dadurch Meerestiere und Korallen, weil sie beispielsweise kaum noch Licht in tiefere Wasserschichten lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3c54315a-f674-317d-9682-13cb1a6c1cdc",
                        "entry_id": "ee8d3023-f84c-3c3c-bae4-485568e33618",
                        "glosses": [
                            "in flächenhafter Ausdehnung über, unter oder zwischen anderem liegendes Wasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fca253a-f22f-48bb-a674-fc62bb65c6f3",
                                "sense_id": "3c54315a-f674-317d-9682-13cb1a6c1cdc",
                                "text": "„Die dicke Wasserschicht über dem Reaktorkern genügt bei abgeschaltetem Reaktor auch als Abschirmung gegen die Strahlung.“"
                            },
                            {
                                "example_id": "d5f9f53f-81c9-4f3f-b69d-b1b5502afede",
                                "sense_id": "3c54315a-f674-317d-9682-13cb1a6c1cdc",
                                "text": "„Die Fahrbahn kann nur dann als nass bezeichnet werden, wenn sich auf ihrer Oberfläche erkennbar eine, sei es auch nur dünne, Wasserschicht gebildet hat.“"
                            },
                            {
                                "example_id": "a61f83ba-0806-4de5-92c0-36f757ad6164",
                                "sense_id": "3c54315a-f674-317d-9682-13cb1a6c1cdc",
                                "text": "„Auch bei einer Wasserschicht auf der Glasplatte schwebt die Klammer weiter.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
