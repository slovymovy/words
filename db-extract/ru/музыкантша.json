                "senses": [
                    {
                        "sense_id": "6ad82b78-22e0-3dc5-a728-44694afd2142",
                        "entry_id": "f21b9952-3f0c-3796-b57d-437bfd4e2065",
                        "glosses": [
                            "женск. к музыкант; прост. то же, что музыкантка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7667d3ac-87b3-4733-b65f-b0b37db986b4",
                                "sense_id": "6ad82b78-22e0-3dc5-a728-44694afd2142",
                                "text": "Женни Рейтер, очень требовательная музыкантша, всегда охотно ему аккомпанировала."
                            },
                            {
                                "example_id": "00a560fa-df6f-4b0a-9a31-c5b9a4f6f727",
                                "sense_id": "6ad82b78-22e0-3dc5-a728-44694afd2142",
                                "text": "Она была хорошая музыкантша и порядочно играла на фортепьяно – \"по милости моих длинных пальцев, – замечала она не без горечи: – у горбатых они всегда такие бывают\"."
                            }
                        ]
                    }
                ],
