                ],
                "senses": [
                    {
                        "sense_id": "c8b85bf0-d684-3ca9-8fbf-e55affc8433d",
                        "entry_id": "0168fe1d-d6fc-3fa9-9e97-7c3ed6e28834",
                        "glosses": [
                            "felt, velveteen"
                        ],
                        "tags": [
                            "relational"
                        ],
                        "examples": [
                            {
                                "example_id": "fe403385-d2ff-4978-836d-27973c166f0d",
                                "sense_id": "c8b85bf0-d684-3ca9-8fbf-e55affc8433d",
                                "text": "В бу́дни ходи́л он в пли́совой ку́ртке, по пра́здникам надева́л серту́к из сукна́ дома́шней рабо́ты; сам запи́сывал расхо́д, и ничего́ не чита́л, кро́ме Сена́тских Ве́домостей.",
                                "translation": "On weekdays he went around in a velveteen jacket, for Sundays he put on a frock coat of homespun broadcloth; he kept the accounts himself and read nothing except the Senate Gazette.",
                                "english": "On weekdays he went around in a velveteen jacket, for Sundays he put on a frock coat of homespun broadcloth; he kept the accounts himself and read nothing except the Senate Gazette."
                            },
                            {
                                "example_id": "0930bf65-1063-43f9-873e-75a168dcdfae",
                                "sense_id": "c8b85bf0-d684-3ca9-8fbf-e55affc8433d",
                                "text": "Прие́зжая сняла́ пальто́, отчего́ опя́ть су́зилась наполови́ну, стащи́ла с себя́ пли́совые сапоги́ и то́же се́ла.",
                                "translation": "The newcomer took off her great coat, which made her shrink to half her size again, she took off her big felt boots, and sat down, too.",
                                "english": "The newcomer took off her great coat, which made her shrink to half her size again, she took off her big felt boots, and sat down, too."
                            }
                        ]
                    }
                ],
