                        "sense_id": "7753fbb5-7e98-362b-aa4e-fc06bc3ac46f",
                        "entry_id": "c5295d1a-edc4-3283-8141-8f87d7a56fb8",
                        "glosses": [
                            "een schema in de tijd van leeractiviteiten om vastgestelde leerdoelen te bereiken en de leerstof, leermiddelen, begeleiding en andere hulpbronnen die daartoe worden ingezet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee26f5d7-d990-4b67-b0b8-022a267d1af7",
                                "sense_id": "7753fbb5-7e98-362b-aa4e-fc06bc3ac46f",
                                "text": "Indien het leerplan wordt goedgekeurd, zendt de inspecteur een exemplaar van dit leerplan aan het bevoegd gezag onder vermelding van de datum, waarop het goedgekeurd is."
                            },
                            {
                                "example_id": "3c77fa9f-efe5-42b2-ad4d-388f56845a8c",
                                "sense_id": "7753fbb5-7e98-362b-aa4e-fc06bc3ac46f",
                                "text": "Tijdens de geschiedenislessen kregen we helemaal buiten het leerplan om uitgebreid les over de moderne Hongaarse geschiedenis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "41bdfa76-65e8-4cc7-93a9-ff6c973ed49a",
                        "source_entry_id": "c5295d1a-edc4-3283-8141-8f87d7a56fb8",
