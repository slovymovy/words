                                "target_senses": [
                                    {
                                        "sense_id": "b85f7aa8-c880-3b03-a825-f2b2bb35482f",
                                        "entry_id": "122603f9-9b15-3eb3-8faa-814596b38a87",
                                        "glosses": [
                                            "wieś lub miasteczko ze słabo rozwiniętą komunikacją, handlem itp."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d7aedc9-0b09-4462-86e1-059abc4d1e6c",
                                                "sense_id": "b85f7aa8-c880-3b03-a825-f2b2bb35482f",
                                                "text": "Mieścina, z której pochodzę, to straszne zadupie."
                                            },
                                            {
                                                "example_id": "6e44282e-6eb6-4e1f-860e-af631af3f6ec",
                                                "sense_id": "b85f7aa8-c880-3b03-a825-f2b2bb35482f",
                                                "text": "Nie mogę do ciebie teraz wpaść, bo jestem u cioci na zadupiu."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cfb56d42-07c6-4044-95d0-b60b853ab2db",
                        "source_entry_id": "9cce2dda-01ab-361c-8c3a-5308354364d9",
                        "source_sense_description": "dirty or unpleasant place",
                        "target_lang_word": "воню́чая дыра́",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "9fc473e6-2645-4135-b3a0-129d7de689b0",
                        "source_entry_id": "9cce2dda-01ab-361c-8c3a-5308354364d9",
                        "source_sense_description": "dirty or unpleasant place",
                        "target_lang_word": "жо́па",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "жо́па",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7e826793-cfb6-3da4-bd71-561650df5b7a",
                                        "entry_id": "2634e723-34bc-3b8c-924f-b90487635df0",
                                        "glosses": [
                                            "груб. ягодицы, попа, задница"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d1e4f97-235a-4904-9d32-57c274669b22",
                                                "sense_id": "7e826793-cfb6-3da4-bd71-561650df5b7a",
                                                "text": "Начиная с того, что я видел голую жопу Государыни (Екатерины II-ой, в день её смерти)."
                                            },
                                            {
                                                "example_id": "2507d448-49c0-4752-8827-45d30667f607",
                                                "sense_id": "7e826793-cfb6-3da4-bd71-561650df5b7a",
                                                "text": "Конечно, я мог бы называть жопу, например, ягодицами, задницей, окрестностями ануса, пятой точкой, седалищем, мягким местом, пониже спины."
                                            },
                                            {
                                                "example_id": "2b6d2e9b-889c-4983-a530-ee72f437b323",
                                                "sense_id": "7e826793-cfb6-3da4-bd71-561650df5b7a",
                                                "text": "Вторая половинка есть у мозга, жопы и таблетки. А я изначально целая."
                                            },
                                            {
                                                "example_id": "ca88ea53-9023-4f6a-a826-67029131b0aa",
                                                "sense_id": "7e826793-cfb6-3da4-bd71-561650df5b7a",
                                                "text": "Я сгорал от стыда, когда Фаина Георгиевна громко говорила мне «на ухо» о проходящей даме: 〈…〉 «С такой жопой надо сидеть дома!»"
                                            },
                                            {
                                                "example_id": "e122ad05-0607-4bba-8b15-b7f8433a7d60",
                                                "sense_id": "7e826793-cfb6-3da4-bd71-561650df5b7a",
                                                "text": "— В Союзе больше не нашлось секретарш с толстой жопой?"
                                            },
                                            {
                                                "example_id": "278c062f-2acc-4b3c-a712-a5898d4b19d5",
                                                "sense_id": "7e826793-cfb6-3da4-bd71-561650df5b7a",
                                                "text": "〈…〉 По спине похлопаю, // Поставлю кверху жопою."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b440a79e-78be-307e-81ea-a59a0247c89f",
                                        "entry_id": "2634e723-34bc-3b8c-924f-b90487635df0",
                                        "glosses": [
                                            "разг. задний проход; анус"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bd5a80f-f61c-4ba7-ac58-8b771e5d1916",
                                                "sense_id": "b440a79e-78be-307e-81ea-a59a0247c89f",
                                                "text": "На шестнадцатом партсъезде // Были слышны голоса: // «Кто последний? Я за вами // Брить на жопе волоса!»"
                                            },
                                            {
                                                "example_id": "52eb07da-7e95-4b6c-99ad-8a92976f519a",
                                                "sense_id": "b440a79e-78be-307e-81ea-a59a0247c89f",
                                                "text": "— А бумажки свои ты можешь в трубочку свернуть и засунуть себе в жопу!"
                                            },
                                            {
                                                "example_id": "2c441ba4-1bb1-48ff-953b-a71c50a736e8",
                                                "sense_id": "b440a79e-78be-307e-81ea-a59a0247c89f",
                                                "text": "— А свой «Гербалайф» в жопу себе засунь."
                                            },
                                            {
                                                "example_id": "3d21c729-7769-48f7-ae55-20b97e7c4e5b",
                                                "sense_id": "b440a79e-78be-307e-81ea-a59a0247c89f",
                                                "text": "— Страшно грустна моя жизнь. А вы хотите, чтобы я воткнула в жопу куст сирени и делала перед вами стриптиз. 〈…〉 — Каждый волен распоряжаться своей жопой, как ему хочется. Поэтому я свою поднимаю и уёбываю."
                                            },
                                            {
                                                "example_id": "4f3869c2-f38c-452a-bc80-33059f86afcc",
                                                "sense_id": "b440a79e-78be-307e-81ea-a59a0247c89f",
                                                "text": "— Рви себе трусы под жопой! Под жопой рви, я сказал! Чтоб как юбка были!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8efec7e5-9adc-3956-975d-78516dd1fbf4",
                                        "entry_id": "2634e723-34bc-3b8c-924f-b90487635df0",
                                        "glosses": [
                                            "перен., шутл. задняя часть чего-либо (обычно о транспортном средстве)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05666fa5-513e-4ed7-8cbd-bd057447e91e",
                                                "sense_id": "8efec7e5-9adc-3956-975d-78516dd1fbf4",
                                                "text": "— Чудак на «Жигулях» жопу автобусу протаранил."
                                            },
                                            {
                                                "example_id": "671d228c-d31d-4c3e-8e08-c1f39ab0b2a1",
                                                "sense_id": "8efec7e5-9adc-3956-975d-78516dd1fbf4",
                                                "text": "Раньше Антон служил на подводной лодке, о чём рассказывал так: … Лежим, не дышим, а закон там — вода, прокурор — акула. Мимо американские лодки скользят, а у нас сердце в пятки уходит. 〈…〉 И вот какая-то подводная блядь клюнула нас подлейшим образом в жопу, а мы отклюнуться не успели. Экранировка нарушилась, началось истечение радиации."
                                            },
                                            {
                                                "example_id": "10ed3eff-2ac0-47ef-b7e8-e0056886abb7",
                                                "sense_id": "8efec7e5-9adc-3956-975d-78516dd1fbf4",
                                                "text": "На второй день в Москве уступил пешеходу дорогу на своей машине — «я хотел, чтобы как в Вашингтоне!» — ему тут же в жопу въехали. Причём, двое сразу — восьмёра и Пежо какой-то!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d89e95e-39db-3f73-a8bd-eb71eeab8b07",
                                        "entry_id": "2634e723-34bc-3b8c-924f-b90487635df0",
                                        "glosses": [
                                            "перен., уничиж., никчёмный, дурной, неприятный человек"
                                        ],
                                        "tags": [
                                            "тж. бран."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15b6cf7d-e1f5-4036-bbe6-799f2e7b0fd9",
                                                "sense_id": "1d89e95e-39db-3f73-a8bd-eb71eeab8b07",
                                                "text": "[Б о р я (к Т а м а р о ч к е):] Больному приготовить сульфу, укол буду делать сам. [П р о х о р о в:] Что же поделаешь, Борис… Новичок… Бред правдоискательства, чувство ложно понятой чести и прочие атавизмы… [Б о р я:] А тебе бы лучше помолчать. Жопа."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9f42eb0-ee19-31c2-b109-29ea70721f35",
                                        "entry_id": "2634e723-34bc-3b8c-924f-b90487635df0",
                                        "glosses": [
                                            "перен., груб., неодобр. удалённая местность; провинция, глубинка; чёрти где, у чёрта на куличках"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28108b57-b431-4266-b183-38a15e12a742",
                                                "sense_id": "f9f42eb0-ee19-31c2-b109-29ea70721f35",
                                                "text": "— В какую же жопу мы забрели!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0746ef03-5111-3cd7-a84b-b3f171dd90e6",
                                        "entry_id": "2634e723-34bc-3b8c-924f-b90487635df0",
                                        "glosses": [
                                            "перен., груб. неприятная ситуация, плохое положение дел"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "541db0f1-90d9-4b35-9ebe-6ea3c7b32d0b",
                                                "sense_id": "0746ef03-5111-3cd7-a84b-b3f171dd90e6",
                                                "text": "— Я в такую жопу попал!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bf81e86-f3f4-31a1-8b65-559d0ef690b1",
                                        "entry_id": "2634e723-34bc-3b8c-924f-b90487635df0",
                                        "glosses": [
                                            "предик. то же, что дрянь"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0815f068-649c-4b79-bbc6-8a9225edd963",
                                                "sense_id": "8bf81e86-f3f4-31a1-8b65-559d0ef690b1",
                                                "text": "— Дело — жопа!"
                                            },
                                            {
                                                "example_id": "ce912c72-ba86-4cae-86aa-d1ed48b32790",
                                                "sense_id": "8bf81e86-f3f4-31a1-8b65-559d0ef690b1",
                                                "text": "Какие перспективы могут открыться? Полная жопа! И больше ничего!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
