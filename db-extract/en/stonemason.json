                    {
                        "translation_id": "cd9a2043-2921-4f93-ad5e-48bf47e8f8b7",
                        "source_entry_id": "d1902eba-4059-39d9-bc12-ef9a9ad4e40a",
                        "source_sense_id": "a3ec2751-5b10-38c5-8e6b-0157d281ff6a",
