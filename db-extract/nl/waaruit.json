                                "example_id": "d16f5a00-ab99-4a36-8e86-ae7aa4ee1c29",
                                "sense_id": "2bd56de7-19b6-3d51-b053-9c9f573e4341",
                                "text": "Waaruit is dat gewonnen?"
                            },
                            {
                                "example_id": "ed382afe-fcdb-4882-808f-eb34940f862f",
                                "sense_id": "2bd56de7-19b6-3d51-b053-9c9f573e4341",
                                "text": "Maar welk verband bestaat er dan tussen industrialisering en de modernisering van sport? En waaruit bestaat modernisering dan precies? Die vraag wordt in dit boek doorlopend gesteld en beantwoord: sport moderniseert in een lange geschiedenis van uniformering, institutionalisering (sportbonden en - verenigingen), codificering (algemeen geldende spelregels) en regulering (niet alles was toegestaan)."
                            },
                            {
                                "example_id": "d3f4e3f6-44a6-4529-9b05-5db1a5ffad65",
                                "sense_id": "2bd56de7-19b6-3d51-b053-9c9f573e4341",
                                "text": "Maar welk verband bestaat er dan tussen industrialisering en de modernisering van sport? En waaruit bestaat modernisering dan precies? Die vraag wordt in dit boek doorlopend gesteld en beantwoord: sport moderniseert in een lange geschiedenis van uniformering, institutionalisering (sportbonden en - verenigingen), codificering (algemeen geldende spelregels) en regulering (niet alles was toegestaan)."
                            }
