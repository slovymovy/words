                                                "example_id": "2c02015e-8311-45c1-a7ce-ac30d740fb6c",
                                                "sense_id": "c22ae10b-4332-35fc-92c0-898776e36eec",
                                                "text": "Les affiches des manifestants sont d’ailleurs peu élogieuses à l’égard du gouvernement."
                                            },
