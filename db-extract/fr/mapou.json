                        "examples": [
                            {
                                "example_id": "1e50747b-ba0a-4274-87f8-b58813486d06",
                                "sense_id": "3c100ca7-b8b1-3c2c-84e7-0332e98083ad",
                                "text": "Léonida, assise devant sa table, ses doigts crochus posés sur la feuille, ses yeux révulsés, en train d’écrire, le vent de la mer devait pousser sur les volets clos, le vent qui sifflait dans les branches du mapou, le vent qui fracassait le navire hollandais sur les roches noires de Maurice, les monticules de pierres qui marquaient le lieu du trésor maudit."
                            },
                            {
                                "example_id": "25d09a6b-0281-421a-b06d-a5230ab76b77",
                                "sense_id": "3c100ca7-b8b1-3c2c-84e7-0332e98083ad",
                                "text": "Par ailleurs, qu’il s’agisse du manguier, du calebassier, du palmier, du cirouellier, de l’avocatier et surtout du mapou, les arbres possèdent une symbolique forte dans le vaudou."
                            }
                        ]
                    }
