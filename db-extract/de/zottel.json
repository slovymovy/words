                "senses": [
                    {
                        "sense_id": "59811676-9936-3c46-90ee-d8eca6971432",
                        "entry_id": "77c2252f-bbd3-34c3-871a-893414ed322b",
                        "glosses": [
                            "a flock of hair or fur clotted by moisture, dirt etc."
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "ed76b2fc-dbf7-432e-b0e9-89847e43a048",
                                "sense_id": "59811676-9936-3c46-90ee-d8eca6971432",
                                "text": "Der Eisbär stieg aus dem Wasser und schüttelte seine nassen Zotteln.",
                                "translation": "The polar bear got out of the water and shook his wet fur.",
                                "english": "The polar bear got out of the water and shook his wet fur."
                            }
                        ]
                    },
                    {
                        "sense_id": "8773f337-b717-3fd7-b602-6d62e3591b1a",
                        "entry_id": "77c2252f-bbd3-34c3-871a-893414ed322b",
                        "glosses": [
                            "a strand of unkempt, thin, or otherwise unattractive hair"
                        ],
                        "tags": [
                            "broadly",
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "f6dfd9e4-5b2c-4c44-916c-bfa83492feff",
                                "sense_id": "8773f337-b717-3fd7-b602-6d62e3591b1a",
                                "text": "Die paar Zotteln, die er noch auf dem Kopf hat, kann er sich auch bald abrasieren."
                            }
                        ]
                    }
                ],
