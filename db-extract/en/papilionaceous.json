                        "glosses": [
                            "Like a butterfly; showy; capricious."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "2f0a81f2-0a0a-4a94-bcd5-b28bc4518a70",
                                "sense_id": "70c9b5dc-820f-3038-8ce3-9937baf6a44a",
                                "text": "Ali G was a glorious, comedic butterfly, but it's my sad duty to report that his exquisitely papilionaceous character is currently being broken upon a wheel."
                            }
                        ]
