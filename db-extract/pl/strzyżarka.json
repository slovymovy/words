                        "cross_references": [
                            {
                                "target_word": "trimmer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d26e468-8b4a-3ade-b5ae-8a961b62793b",
                                        "entry_id": "61623b89-d30e-31c4-88a9-f08aa76a197d",
                                        "glosses": [
                                            "comparative form of trim: more trim"
                                        ],
                                        "tags": [
                                            "comparative",
