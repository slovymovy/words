            "senses": [
                {
                    "sense_id": "7969fed2-2adf-3d68-9caa-af9bcde0d9f8",
                    "sense_definition": "zonder grappen en met veel aandacht of toewijding",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "karakter en houding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op een <w>ernstige</w> toon sprak de meester zijn leerlingen toe over hun gedrag.",
                            "target_lang_translations": {
                                "en": "In a <w>serious</w> tone, the teacher addressed his students about their behavior.",
                                "ru": "<w>Серьёзным</w> тоном учитель обратился к своим ученикам по поводу их поведения."
                            }
                        },
                        {
                            "text": "Hij keek heel <w>ernstig</w> toen hij het slechte nieuws aan zijn familie vertelde.",
                            "target_lang_translations": {
                                "en": "He looked very <w>grave</w> when he told the bad news to his family.",
                                "ru": "Он выглядел очень <w>серьёзным</w>, когда сообщал плохие новости своей семье."
                            }
                        }
                    ],
                    "synonyms": [
                        "serieus"
                    ],
                    "antonyms": [
                        "grappig",
                        "vrolijk"
                    ],
                    "common_phrases": [
                        "op ernstige toon",
                        "een ernstig gezicht"
                    ],
                    "target_lang_definitions": {
                        "en": "without jokes and with a lot of attention or dedication",
                        "ru": "без шуток, с большим вниманием или преданностью делу"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "serious",
                                "target_lang_sense_clarification": "not joking or lighthearted"
                            },
                            {
                                "target_lang_word": "grave",
                                "target_lang_sense_clarification": "very serious and solemn in manner"
                            },
                            {
                                "target_lang_word": "earnest",
                                "target_lang_sense_clarification": "showing sincere and intense conviction"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "серьёзный",
                                "target_lang_sense_clarification": "не склонный к шуткам, вдумчивый"
                            },
                            {
                                "target_lang_word": "солидный",
                                "target_lang_sense_clarification": "внушающий доверие, основательный"
