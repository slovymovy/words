                "senses": [
                    {
                        "sense_id": "4e189685-6a41-3852-bdbe-56fac1c93e6e",
                        "entry_id": "797478f5-e590-37bd-abfc-8230d4b1a48f",
                        "glosses": [
                            "Donner un caractère méritocratique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f58b38e-e65a-4a2d-ad53-cbee33d776dc",
                                "sense_id": "4e189685-6a41-3852-bdbe-56fac1c93e6e",
                                "text": "Et il précise : avec la mise en place de cette forme d’estime sociale, les sociétés capitalistes ont « en quelque sorte méritocratisé » (p. 166) la conception féodale et prémoderne de l’honneur."
                            },
                            {
                                "example_id": "7202b376-e8db-497f-b9bb-79bdba465168",
                                "sense_id": "4e189685-6a41-3852-bdbe-56fac1c93e6e",
                                "text": "Nettoyer, \"méritocratiser\" et démocratiser."
                            },
                            {
                                "example_id": "ad5b30bc-312e-4fba-9e59-715dfe136343",
                                "sense_id": "4e189685-6a41-3852-bdbe-56fac1c93e6e",
                                "text": "Mais on est forcé de constater que le système anglais tend à se méritocratiser alors que le système français à s'aristocratiser."
                            }
                        ]
                    }
