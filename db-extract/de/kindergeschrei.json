                "senses": [
                    {
                        "sense_id": "3c02c209-ad87-3cd5-89ed-db7a6b3cc8cb",
                        "entry_id": "abbe94a0-8023-3ea3-b524-9c6c5d811d48",
                        "glosses": [
                            "Lärm, verursacht durch laute, anhaltende Lautäußerungen (Schreien) von Kindern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b44c4a1-0f8d-4d83-969c-12cda227b6b2",
                                "sense_id": "3c02c209-ad87-3cd5-89ed-db7a6b3cc8cb",
                                "text": "„Eine Katze wühlte in den Mülltonnen, Kindergeschrei drang aus einem Hauseingang, die Straßenkehrer fluchten, weil sich das Blut nicht entfernen ließ.“"
                            },
                            {
                                "example_id": "31e2ee4a-59c0-4351-943c-624717a62dbc",
                                "sense_id": "3c02c209-ad87-3cd5-89ed-db7a6b3cc8cb",
                                "text": "„Kindergeschrei riss die beiden aus ihrem Gespräch.“"
                            },
                            {
                                "example_id": "fae97c39-9ae9-42a8-8058-37091320cdb5",
                                "sense_id": "3c02c209-ad87-3cd5-89ed-db7a6b3cc8cb",
                                "text": "„Bald danach erscholl in dem Zimmer Kindergeschrei.“"
                            },
                            {
                                "example_id": "4d1ddc9f-20e8-44a3-a4a3-5d4a266f4f74",
                                "sense_id": "3c02c209-ad87-3cd5-89ed-db7a6b3cc8cb",
                                "text": "„Und nun erhob sich ein begeistertes Kindergeschrei im Nebenzimmer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
