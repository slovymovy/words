                    {
                        "sense_id": "0a75e0ab-97ea-3181-8475-7beb90f3b20a",
                        "entry_id": "bf01325b-b3a4-325c-ad4a-a7e3b7a17010",
                        "glosses": [
                            "proces niszczenia metalu lub innego materiału na skutek kontaktu z otoczeniem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "851265e6-562e-4081-b313-54db811486e5",
                                "sense_id": "0a75e0ab-97ea-3181-8475-7beb90f3b20a",
                                "text": "Cienka powłoka cyny na blaszanych puszkach z żywnością zapobiega korozji."
                            },
                            {
                                "example_id": "04f720c3-2d7a-46a3-8417-7e2c2a3f2693",
                                "sense_id": "0a75e0ab-97ea-3181-8475-7beb90f3b20a",
                                "text": "Kadłuby statków zabezpiecza się przed korozją przy pomocy anod cynkowych."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
