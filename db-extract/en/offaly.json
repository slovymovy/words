                "senses": [
                    {
                        "sense_id": "c0c1b823-e2ee-3717-9cf0-5b7f3ad21dcd",
                        "entry_id": "a0391361-2283-3be7-9751-dfe6f3b61227",
                        "glosses": [
                            "Alternative form of offally."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "6db50c31-034a-4720-81c2-5edfc0691310",
                                "sense_id": "c0c1b823-e2ee-3717-9cf0-5b7f3ad21dcd",
                                "text": "I also try adding some chopped turkey liver, as recommended by Delia in another recipe, but find the offaly flavour rather strident;"
                            },
                            {
                                "example_id": "9e79396f-2d67-4705-a9ef-dd910d332cf3",
                                "sense_id": "c0c1b823-e2ee-3717-9cf0-5b7f3ad21dcd",
                                "text": "Changes in soluble proteins, free fatty acids and free amino acids were measured, as these degradation products could be responsible for the development of 'livery/offaly' flavor and could also explain the increase meat pH during prolonged chilled meat storage."
                            },
                            {
                                "example_id": "bc09321a-a1df-464f-b43c-d3a33220ad56",
                                "sense_id": "c0c1b823-e2ee-3717-9cf0-5b7f3ad21dcd",
                                "text": "Human volunteeers rated thirteen different commercial pet food samples, concentrating on eighteen so-called flavour attributes: sweet, sour/acid, tuna, herbal, spicy, soy, salty, cereal, caramel, chicken, methionine, vegetable, offaly, meaty, burnt, prawn, rancid, and bitter."
                            },
                            {
                                "example_id": "92a9a6db-89cf-47ca-9672-409e259a7461",
                                "sense_id": "c0c1b823-e2ee-3717-9cf0-5b7f3ad21dcd",
                                "text": "Liver and bacon was my sister's favourite; the astringent taste of offaly cow's liver, layered with strands of streaky bacon and dashed with a hint of English mustard."
                            },
                            {
                                "example_id": "6f825136-e032-46b6-9bba-5af5d081d403",
                                "sense_id": "c0c1b823-e2ee-3717-9cf0-5b7f3ad21dcd",
                                "text": "Hunter-gatherers – and indeed most human populations before the twentieth century – eschewed lean cuts like fillets in favour of the fattier, gnarlier, offalier cuts because these were far more nutritious."
                            }
                        ]
                    }
