                    {
                        "sense_id": "6bd6f2ae-3822-3374-be92-93d2db1b269b",
                        "entry_id": "fad787a5-c41f-378a-8d98-95df4dbb5657",
                        "glosses": [
                            "vermehrte Ausscheidung von Kalzium über den Urin"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "877dd70b-05b3-4a23-a1c7-2bcbbd250612",
                                "sense_id": "6bd6f2ae-3822-3374-be92-93d2db1b269b",
                                "text": "„Durch die Gabe von Calcium in hohen Mengen kann die Ausscheidung von Calcium mit dem Urin (Hyperkalziurie) ansteigen.“"
                            },
                            {
                                "example_id": "4a4cd9c5-6bde-49fd-85a3-a6df677e815a",
                                "sense_id": "6bd6f2ae-3822-3374-be92-93d2db1b269b",
                                "text": "„Demineralisation des Knochens und Osteoporose sind Spätmanifestationen und resultieren aus renalen Störungen der Phosphatrückresorption und Hyperkalziurie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
