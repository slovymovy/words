                "senses": [
                    {
                        "sense_id": "9f1d95fc-ab4b-3c2a-ba2f-3e1a7f9bd4cf",
                        "entry_id": "e8ac202d-86a6-3485-bd81-33d8071f124a",
                        "glosses": [
                            "das Vermindern von Geruch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5c708f1-808b-4a28-87c8-3af70d043698",
                                "sense_id": "9f1d95fc-ab4b-3c2a-ba2f-3e1a7f9bd4cf",
                                "text": "„Zum Zwecke der Geruchsverminderung wurde eine Vorbehandlungsanlage am Standort Steinhof mit mechanischer und biologischer Reinigung in Betrieb genommen.“"
                            },
                            {
                                "example_id": "69fb1466-822b-4d57-b55f-5a8a64c5a4a0",
                                "sense_id": "9f1d95fc-ab4b-3c2a-ba2f-3e1a7f9bd4cf",
                                "text": "„Auch über die Frage, ob durch die Errichtung einer Mauer eine Lärm- und Geruchsverminderung herbeigeführt werden kann, ist ein Beweis durch Sachverständige aufzunehmen.“"
                            },
                            {
                                "example_id": "ea1beadf-2fd7-4128-8915-7ffaaabbd967",
                                "sense_id": "9f1d95fc-ab4b-3c2a-ba2f-3e1a7f9bd4cf",
                                "text": "„Sie kamen zu dem Schluss, dass das Präparat keinen aeroben Prozess einleiten konnte, die Fließfähigkeit nur unwesentlich verändert wurde und eine Geruchsverminderung nicht gelang.“"
                            },
                            {
                                "example_id": "1d69cf7a-4e51-48c1-a9be-474028ee0715",
                                "sense_id": "9f1d95fc-ab4b-3c2a-ba2f-3e1a7f9bd4cf",
                                "text": "„Der Eidelstedter Betrieb hat von sich aus alles nur Erdenkliche zur Geruchsverminderung getan und befolgte alle Verordnungen.“"
                            },
                            {
                                "example_id": "444ebb15-ce17-4bc2-ae74-16b26baf08de",
                                "sense_id": "9f1d95fc-ab4b-3c2a-ba2f-3e1a7f9bd4cf",
                                "text": "„Zustimmung gab es lediglich von der UWV-Fraktion: Deren Chef Martin Croé argumentierte, die beantragten Investitionen sollten ja gerade bewirken, dass es künftig zu einer Geruchsverminderung komme.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
