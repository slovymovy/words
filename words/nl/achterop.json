                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door zijn ziekte is hij <w>achterop</w> geraakt met zijn studie.",
                            "target_lang_translations": {
                                "en": "Due to his illness, he fell <w>behind</w> with his studies.",
                                "ru": "Из-за болезни он <w>отстал</w> в учебе.",
                                "pl": "Z powodu choroby <w>został w tyle</w> z nauką.",
                                "de": "Wegen seiner Krankheit ist er mit seinem Studium <w>in Rückstand geraten</w>.",
                                "fr": "À cause de sa maladie, il a pris du <w>retard</w> dans ses études.",
                                "it": "A causa della sua malattia è rimasto <w>indietro</w> con gli studi.",
                                "cs": "Kvůli nemoci se ve studiu dostal <w>do skluzu</w>.",
                                "tr": "Hastalığı nedeniyle derslerinde <w>geride kaldı</w>.",
                                "es": "Debido a su enfermedad, se ha <w>quedado atrás</w> con sus estudios.",
                                "zh": "因为生病，他的学业<w>落后</w>了。"
                            }
                        },
                        {
                            "text": "Het bedrijf loopt <w>achterop</w> vergeleken met de concurrentie.",
                            "target_lang_translations": {
                                "en": "The company is lagging <w>behind</w> compared to the competition.",
                                "ru": "Компания <w>отстает</w> от конкурентов.",
                                "pl": "Firma <w>zostaje w tyle</w> w porównaniu z konkurencją.",
                                "de": "Das Unternehmen ist im Vergleich zur Konkurrenz <w>zurückgefallen</w>.",
                                "fr": "L'entreprise est <w>à la traîne</w> par rapport à la concurrence.",
                                "it": "L'azienda è <w>indietro</w> rispetto alla concorrenza.",
                                "cs": "Firma je ve srovnání s konkurencí <w>pozadu</w>.",
                                "tr": "Şirket rakiplerine kıyasla <w>geride kalıyor</w>.",
                                "es": "La empresa está <w>atrasada</w> en comparación con la competencia.",
                                "zh": "与竞争对手相比，这家公司正处于<w>落后</w>状态。"
                            }
                        }
