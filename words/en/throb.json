{
    "word_family": [
        "throbbing"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2e121202-8b89-3515-86a6-c1dc748a4e55",
                    "sense_definition": "To pound or beat rapidly or violently",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pulsation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her heart began to <w>throb</w> faster as the moment approached.",
                            "target_lang_translations": {
                                "zh": "随着那一刻的临近，她的心开始剧烈<w>跳动</w>。",
                                "cs": "Jak se ten okamžik blížil, její srdce začalo <w>bušit</w> rychleji."
                            }
                        },
                        {
                            "text": "The drums started to <w>throb</w> loudly during the concert.",
                            "target_lang_translations": {
                                "zh": "音乐会期间，鼓声开始剧烈地<w>跳动</w>。",
                                "cs": "Během koncertu začaly bubny hlasitě <w>bušit</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "pound",
                        "beat",
                        "pulse"
                    ],
                    "common_phrases": [
                        "heart throb"
                    ],
                    "target_lang_definitions": {
                        "zh": "指心脏或鼓声等快速、剧烈地跳动或震动。",
                        "cs": "Rychlé nebo prudké bušení či tlukot, obvykle srdce nebo rytmického zvuku."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "跳动",
                                "target_lang_sense_clarification": "指心脏或脉搏的快速跳动。"
                            },
                            {
                                "target_lang_word": "搏动",
                                "target_lang_sense_clarification": "指有节奏的剧烈跳动。"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "bušit",
                                "target_lang_sense_clarification": "Intenzivní, rytmické údery (např. srdce nebo bubny)."
                            },
                            {
                                "target_lang_word": "bít",
                                "target_lang_sense_clarification": "Rytmický pohyb nebo zvuk (např. srdce)."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3506ed61-8d74-3afd-bc3a-4360921eda80",
                    "sense_definition": "To vibrate or pulsate with a steady rhythm",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pulsation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The machine began to <w>throb</w> with a low hum.",
                            "target_lang_translations": {
                                "zh": "机器开始发出低沉的嗡嗡声并伴随着<w>震动</w>。",
                                "cs": "Stroj začal <w>tepat</w> za doprovodu hlubokého hučení."
                            }
                        },
                        {
                            "text": "The floor seemed to <w>throb</w> under the heavy music.",
                            "target_lang_translations": {
                                "zh": "在强劲的音乐下，地板似乎在<w>颤动</w>。",
                                "cs": "Podlaha se zdála <w>vibrovat</w> pod náporem hlasité hudby."
                            }
                        }
                    ],
                    "synonyms": [
                        "vibrate",
                        "pulsate"
                    ],
                    "target_lang_definitions": {
                        "zh": "指物体以稳定的节奏震动或颤动。",
                        "cs": "Vibrování nebo chvění předmětu v ustáleném rytmu."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "震动",
                                "target_lang_sense_clarification": "指物体因动力而产生的持续颤动。"
                            },
                            {
                                "target_lang_word": "颤动",
                                "target_lang_sense_clarification": "指物体轻微而快速的摆动。"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "tepat",
                                "target_lang_sense_clarification": "Pravidelné, rytmické chvění nebo pulzování."
                            },
                            {
                                "target_lang_word": "vibrovat",
                                "target_lang_sense_clarification": "Rychlé, drobné chvění způsobené mechanickým pohybem."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a005796-2fd8-3e83-a52b-8b9ace4fbfab",
                    "sense_definition": "To pulse painfully in time with the circulation of blood",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pulsation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My injured finger started to <w>throb</w> after I hit it.",
                            "target_lang_translations": {
                                "zh": "我的手指受伤后，开始感到一阵阵的<w>跳痛</w>。",
                                "cs": "Můj poraněný prst začal po úderu <w>tepat</w> bolestí."
                            }
                        },
                        {
                            "text": "The cut on his arm began to <w>throb</w> with pain.",
                            "target_lang_translations": {
                                "zh": "他手臂上的伤口开始感到<w>跳痛</w>。",
                                "cs": "Řezná rána na jeho paži začala bolestivě <w>pulzovat</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "ache",
                        "pulse"
                    ],
                    "target_lang_definitions": {
                        "zh": "指伤口或患处因血液循环而产生的阵阵疼痛。",
                        "cs": "Bolestivé pulzování v místě zranění, které odpovídá tepu krve."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "跳痛",
                                "target_lang_sense_clarification": "特指伤口处随脉搏跳动而产生的疼痛。"
                            },
                            {
                                "target_lang_word": "隐痛",
                                "target_lang_sense_clarification": "指持续性的、伴随脉搏感的疼痛。"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "pulzovat",
                                "target_lang_sense_clarification": "Pocit rytmického pohybu v místě bolesti."
                            },
                            {
                                "target_lang_word": "tepat",
                                "target_lang_sense_clarification": "Bolest, která se projevuje v rytmu srdečního tepu."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22ab811c-dd7f-3f7f-b414-1e1860c82adf",
                    "sense_definition": "To exhibit an attitude or affect powerfully and profoundly",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city seemed to <w>throb</w> with excitement during the festival.",
                            "target_lang_translations": {
                                "zh": "节日期间，这座城市似乎<w>充满</w>了兴奋的气息。",
                                "cs": "Během festivalu město doslova <w>kypělo</w> vzrušením."
                            }
                        },
                        {
                            "text": "The novel <w>throbs</w> with raw emotion and deep insight.",
                            "target_lang_translations": {
                                "zh": "这部小说<w>充满</w>了原始的情感和深刻的见解。",
                                "cs": "Román <w>pulzuje</w> syrovými emocemi a hlubokým vhledem."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指充满某种强烈的情感或活力。",
                        "cs": "Být naplněn silnou energií, emocemi nebo životem."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "充满",
                                "target_lang_sense_clarification": "指某种氛围或情感极其浓厚。"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "kypět",
                                "target_lang_sense_clarification": "Být něčím naplněn až k přetékání (např. životem, emocemi)."
                            },
                            {
                                "target_lang_word": "pulzovat",
                                "target_lang_sense_clarification": "Být plný aktivity a energie."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1a0f3de0-f0e6-35d5-8826-2c5579950593",
                    "sense_definition": "A beating, vibration, or painful pulsation",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pulsation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He could feel a dull <w>throb</w> in his head from the tension.",
                            "target_lang_translations": {
                                "zh": "由于紧张，他能感觉到头部有一种隐隐的<w>跳痛</w>。",
                                "cs": "Cítil v hlavě tupé <w>pulzování</w> způsobené napětím."
                            }
                        },
                        {
                            "text": "The <w>throb</w> in her ankle made it difficult to walk.",
                            "target_lang_translations": {
                                "zh": "她脚踝处的<w>阵痛</w>使她难以行走。",
                                "cs": "Kvůli <w>tepání</w> v kotníku se jí špatně chodilo."
                            }
                        }
                    ],
                    "synonyms": [
                        "pulse",
                        "beat",
                        "vibration"
                    ],
                    "target_lang_definitions": {
                        "zh": "指跳动、震动或阵痛的感觉。",
                        "cs": "Pocit rytmického bušení, vibrace nebo bolestivého pulzování."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "跳动",
                                "target_lang_sense_clarification": "指有节奏的搏动感。"
                            },
                            {
                                "target_lang_word": "阵痛",
                                "target_lang_sense_clarification": "指伤口处一跳一跳的疼痛感。"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "tep",
                                "target_lang_sense_clarification": "Rytmický pohyb nebo bušení."
                            },
                            {
                                "target_lang_word": "pulzování",
                                "target_lang_sense_clarification": "Pocit rytmického chvění nebo bolesti."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}