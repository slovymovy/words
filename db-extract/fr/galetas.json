        "fr-extract.jsonl": [
            {
                "entry_id": "981be94e-7821-369c-a039-87967addd2df",
                "word": "galetas",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0eac362d-7872-35f2-ae61-aeba180f2b5c",
                        "entry_id": "981be94e-7821-369c-a039-87967addd2df",
                        "glosses": [
                            "Logement pratiqué sous les combles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "952a034c-7266-44cf-8a4b-ca8c59089225",
                                "sense_id": "0eac362d-7872-35f2-ae61-aeba180f2b5c",
                                "text": "Puisque du dieu des eaux tu tires ta naissance\n Loger au galetas choque la bienséance. ."
                            },
                            {
                                "example_id": "b20000c7-556e-4d42-92ea-b8f5dafd8a44",
                                "sense_id": "0eac362d-7872-35f2-ae61-aeba180f2b5c",
                                "text": "Une toute jeune fille était debout dans la porte entrebâillée. La lucarne du galetas où le jour paraissait était précisément en face de la porte et éclairait cette figure d’une lumière blafarde."
                            },
                            {
                                "example_id": "d07b1be1-cd0d-4d33-922e-9a7df9e88d05",
                                "sense_id": "0eac362d-7872-35f2-ae61-aeba180f2b5c",
                                "text": "La femme passait sa vie à tricoter des bas à côtes pour son mari, et le mari, timbré de musique, à racler sur son violon de l’ancienne musique de Viotti, dans une chambre à galetas au-dessus de la mienne…"
                            }
                        ]
                    },
                    {
                        "sense_id": "d7e57d92-c277-3260-bed9-c9b1936fea67",
                        "entry_id": "981be94e-7821-369c-a039-87967addd2df",
                        "glosses": [
                            "Logement misérable."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "aee88842-ad19-4b15-bf21-01f92fb8abf1",
                                "sense_id": "d7e57d92-c277-3260-bed9-c9b1936fea67",
                                "text": "Il habite un galetas sale et minuscule."
                            },
                            {
                                "example_id": "a66af358-cdcd-434a-be25-dba3867c2908",
                                "sense_id": "d7e57d92-c277-3260-bed9-c9b1936fea67",
                                "text": "– Croyez-vous que j’entre jamais dans votre galetas pour mon plaisir ?\n– Epargnez-vous la peine d’y entrer à l’avenir."
                            },
                            {
                                "example_id": "be05eaac-58f4-4b76-add8-d2db9555e8af",
                                "sense_id": "d7e57d92-c277-3260-bed9-c9b1936fea67",
                                "text": "« Oui, oui, sans doute, disait Coppée, c’est un brave gars. J’aime mieux ne pas assister à sa toilette.\n— Mais il ne fait pas de toilette, — objectait Lemaître. — J’ai vu une fois, dans son galetas, un pot à eau ébréché et poussiéreux, où moisissait une chaussette rapiécée. »"
                            },
                            {
                                "example_id": "3667779a-950c-4adc-b8d5-29dfe0258e9a",
                                "sense_id": "d7e57d92-c277-3260-bed9-c9b1936fea67",
                                "text": "Une fois il trouve son galetas occupé par un chétif avorton qui dort là : il a les cheveux blancs, il est maigre, à peine plus grand qu’un enfant et il porte un bleu de travail rapiécé."
                            }
                        ]
                    },
                    {
                        "sense_id": "36c04bda-3d87-3c61-84a2-eaf37fe32bee",
                        "entry_id": "981be94e-7821-369c-a039-87967addd2df",
                        "glosses": [
                            "Grenier."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "a331f7fa-24eb-43af-af62-ddaa47207467",
                                "sense_id": "36c04bda-3d87-3c61-84a2-eaf37fe32bee",
                                "text": "Minuit. Des souris courent au-dessus de ma tête, dans le galetas. J’y suis montée une fois, pour inspecter la fenêtre par laquelle, le cas échéant, je pourrais filer par les toits, droit dans les champs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7ddeaac-c577-4491-9b82-fe77343797eb",
                        "source_entry_id": "981be94e-7821-369c-a039-87967addd2df",
                        "source_sense_id": "0eac362d-7872-35f2-ae61-aeba180f2b5c",
                        "source_sense_description": "Logement pratiqué sous les combles.",
                        "target_lang_word": "garret",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "garret",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a4f6aa9-d8b8-3079-b66a-01596b234f73",
                                        "entry_id": "1cbc1a50-6b40-34fb-9e45-eade0d567e62",
                                        "glosses": [
                                            "An attic or semi-finished room just beneath the roof of a house."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb1ccc5c-6a8f-4f1d-92be-76b4fd46b7b4",
                                                "sense_id": "4a4f6aa9-d8b8-3079-b66a-01596b234f73",
                                                "text": "This morning (we living lately in the garret,) I rose, put on my suit with great skirts, having not lately worn any other clothes but them."
                                            },
                                            {
                                                "example_id": "0480271d-644e-466f-a297-aa9114cbb0ca",
                                                "sense_id": "4a4f6aa9-d8b8-3079-b66a-01596b234f73",
                                                "text": "On an exceptionally hot evening early in July a young man came out of the garret in which he lodged in S. Place and walked slowly, as though in hesitation, towards K. bridge."
                                            },
                                            {
                                                "example_id": "ef60c626-2376-4de7-98fb-bb72773eb3d7",
                                                "sense_id": "4a4f6aa9-d8b8-3079-b66a-01596b234f73",
                                                "text": "I was in the main garret, with huge beams and rafters over my head, great spaces around me, a door here and there in sight, and long vistas whose gloom was thinned by a few lurking cobwebbed windows and small dusky skylights."
                                            },
                                            {
                                                "example_id": "fd2e1031-7454-432e-8be5-ecabf9d81c88",
                                                "sense_id": "4a4f6aa9-d8b8-3079-b66a-01596b234f73",
                                                "text": "While a boon to garret-living, financially struggling young musicians, the library has caught the attention of music publishers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f6401e3-eb9f-4087-aef0-bd4fdcf78393",
                        "source_entry_id": "981be94e-7821-369c-a039-87967addd2df",
                        "source_sense_id": "0eac362d-7872-35f2-ae61-aeba180f2b5c",
                        "source_sense_description": "Logement pratiqué sous les combles.",
                        "target_lang_word": "rommelkamer",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rommelkamer",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7255fe02-d468-3225-9487-fdce7aa7678a",
                                        "entry_id": "6270ab4e-ff70-3e9d-a7ac-81091715b40d",
                                        "glosses": [
                                            "een vertrek waarin veel waardeloze spullen staan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4eb466f-daae-4dfa-99ac-e52927f62920",
                                                "sense_id": "7255fe02-d468-3225-9487-fdce7aa7678a",
                                                "text": "Nu is het juist andersom: nu zitten de ouders in de rommelkamer en de kinderen op de bel-etage."
                                            },
                                            {
                                                "example_id": "676f791e-14b0-42a4-bfd0-6acd7a2f27af",
                                                "sense_id": "7255fe02-d468-3225-9487-fdce7aa7678a",
                                                "text": ",,Ik woon samen met mijn vrouw in een appartement van 66 vierkante meter, met één slaapkamer en een rommelkamer waar mijn racefiets en mountainbike in staan. We zijn allebei met pensioen, dus veel thuis. We hebben wel onderburen, maar boven ons zit niets. Het huis is van een wooncorporatie. Bij een storm twee jaar geleden vloog het dak eraf. Dat is vervangen door een goed geïsoleerd dak. We hebben geen gasketel, maar stadsverwarming van Eneco.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
