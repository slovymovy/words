                            {
                                "example_id": "ec686d60-6ead-48b7-9f0e-3dd78a95bffd",
                                "sense_id": "6e8af283-8649-3a1d-900f-c21290f5522e",
                                "text": "В столповой нотации параклит употреблялся в начале песнопения."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "606dc97b-3d69-47fe-932a-974d7f3cfd4d",
                        "source_entry_id": "e1e49e6c-150b-3ff8-8489-72d6b0507b9e",
                        "target_lang_word": "paraclete",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paraclete",
