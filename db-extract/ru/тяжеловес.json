                                        "sense_id": "340378b2-e628-36be-8413-1f93a830074a",
                                        "entry_id": "74da4430-4286-35ac-95d8-bc630b4cc78a",
                                        "glosses": [
                                            "A very large, heavy, or impressive person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11c280f9-cfad-424b-a9f8-e8bab086af2d",
                                                "sense_id": "340378b2-e628-36be-8413-1f93a830074a",
                                                "text": "an intellectual heavyweight"
                                            },
                                            {
                                                "example_id": "da2e008d-96ae-4809-926e-baf8ec829d1e",
                                                "sense_id": "340378b2-e628-36be-8413-1f93a830074a",
                                                "text": "When Time magazine named Ann Coulter among its 100 \"most influential people\" last week, alongside such heavyweights as Ariel Sharon, Bill Clinton, Nelson Mandela, Kim Jong Il and the Dalai Lama, the choice produced guffaws online."
                                            },
                                            {
                                                "example_id": "4398cf37-d433-46ad-9609-4657591143cc",
                                                "sense_id": "340378b2-e628-36be-8413-1f93a830074a",
                                                "text": "Allen Gregory DeLongpre: Who's he?\nPatrick: He's only the most popular kid in school.\nAllen Gregory: Ah, the two heavyweights finally meet. Sure you're tired of all the buzz. Allen Gregory DeLongpre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "223be051-1b4c-35af-81b7-06b3809e3479",
                                        "entry_id": "74da4430-4286-35ac-95d8-bc630b4cc78a",
                                        "glosses": [
                                            "The professional boxing weight class for boxers weighing more than 190 pounds; a boxer in that division."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ed96166d-7d40-3859-a085-dfaa17bb0069",
                                        "entry_id": "74da4430-4286-35ac-95d8-bc630b4cc78a",
                                        "glosses": [
                                            "A similar division and contestant in other sports."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "heavyweight",
