                        "glosses": [
                            "Variété d'argile de couleur bleutée, anciennement utilisée pour détacher les tissus, notamment la laine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bb54075-b0b8-4754-9e4a-2ff9cc3274fd",
                                "sense_id": "9502c1f5-68f1-395b-9bea-972437bcc8c0",
                                "text": "M. Kersten a analysé le minéral que nous avons mentionné dans le Rapport précédent (p. 280, éd. s.), sous le nom de miloschine ou serbiane."
                            },
                            {
                                "example_id": "265fa265-31dc-4b4b-914e-7e31c901d7ca",
                                "sense_id": "9502c1f5-68f1-395b-9bea-972437bcc8c0",
                                "text": "La miloschine a été découverte en Serbie, proche de Rudnjak, sur le mont Zeljin."
                            },
                            {
                                "example_id": "8e8499bf-28b8-4958-ad7d-3a9d1a64dca7",
                                "sense_id": "9502c1f5-68f1-395b-9bea-972437bcc8c0",
                                "text": "La miloschine de Rudniak, en Sibérie, est une argile chromifère de même nature que la Wolckonskite ; sa couleur est d’un vert d’eau."
                            }
                        ]
                    }
