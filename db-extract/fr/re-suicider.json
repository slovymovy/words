                "senses": [
                    {
                        "sense_id": "23e54f57-6243-38ec-b698-fd3b54173a2d",
                        "entry_id": "c84f455d-e1f4-3004-a304-455c55408c02",
                        "glosses": [
                            "Variante orthographique, parfois rencontrée, de resuicider."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "540d0d2e-7e3c-4e9a-93ce-8e27f26fb468",
                                "sense_id": "23e54f57-6243-38ec-b698-fd3b54173a2d",
                                "text": "Je dois me re-suicider."
                            },
                            {
                                "example_id": "172d739f-732d-4ab1-88ff-965c7d713012",
                                "sense_id": "23e54f57-6243-38ec-b698-fd3b54173a2d",
                                "text": "Quand ils la virent, elle se re-suicide et elle revient."
                            },
                            {
                                "example_id": "16a78d21-de55-4529-bff2-a64347bbcbd4",
                                "sense_id": "23e54f57-6243-38ec-b698-fd3b54173a2d",
                                "text": "Sur plus de vingt ans dans Logiques, dans Tel Quel et dans La Fête à Venise, j’ai entendu, compris, trouvé et retrouvé Artaud, suicidé de la société, et de toutes les sociétés qui voudraient le re-suicider par l’oubli ou une fausse dévotion."
                            }
                        ]
                    }
