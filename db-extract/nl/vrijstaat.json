                                "target_senses": [
                                    {
                                        "sense_id": "2b95db9f-7993-325f-a13b-ec68c2a35b3b",
                                        "entry_id": "62f26e6b-f68b-387a-ba62-61b5db855cf7",
                                        "glosses": [
                                            "A political entity whose political status is less than that of a fully sovereign nation-state, as with the former Congo Free State and the former Irish Free State."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "408c5954-b48d-3b0f-baaa-ba03e6552b2c",
                                        "entry_id": "62f26e6b-f68b-387a-ba62-61b5db855cf7",
                                        "glosses": [
                                            "A Federal state, with allegiance to a larger entity, as currently with Germany, and earlier, the relationship between the states of the Holy Roman Empire and the Emperor, and later, the states of the German Empire under the Hohenzollerns."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "08576f8a-0fcd-3444-ae78-b72b136ea621",
                                        "entry_id": "62f26e6b-f68b-387a-ba62-61b5db855cf7",
                                        "glosses": [
                                            "An independent or autonomous political entity whose formal status and relationship to other states is undefined."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "50bd28f7-f693-3d6b-83d9-06a66dca2e57",
                                        "entry_id": "62f26e6b-f68b-387a-ba62-61b5db855cf7",
                                        "glosses": [
                                            "A republic or commonwealth, as with the former Orange Free State, and especially as used for the current United Kingdom to refer to the Commonwealth period under Cromwell."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "89b5a86c-186c-3c0d-bcb5-a8dcbba729d9",
                                        "entry_id": "62f26e6b-f68b-387a-ba62-61b5db855cf7",
                                        "glosses": [
                                            "A condition of not being supported or constrained by outside forces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b7da37e-dda1-45f2-ad07-a2d3e8609ccb",
                                                "sense_id": "89b5a86c-186c-3c0d-bcb5-a8dcbba729d9",
                                                "text": "The steel ring is required by the engineering drawing to have roundness within .25mm TIR while in the free state. Its diameters may be measured in the constrained state while the part is still chucked or fixtured."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f0f0180-ac49-3534-acdf-b7dea2551c92",
                                        "entry_id": "62f26e6b-f68b-387a-ba62-61b5db855cf7",
                                        "glosses": [
                                            "Before the American Civil War, any of the states in which slaveownership was illegal."
                                        ],
                                        "tags": [
                                            "US",
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "699583df-c32f-35a2-a481-c4206413d59c",
                                        "entry_id": "62f26e6b-f68b-387a-ba62-61b5db855cf7",
                                        "glosses": [
                                            "A noun form in Afroasiatic languages contrasting with the construct state by the noun not being dependent (more commonly called absolute state, or indeterminate state if the specific language contrasts a determinate state with the construct state)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
