                                        "entry_id": "6330209d-3e05-3564-ac06-7e778eed4b72",
                                        "glosses": [
                                            "A dessert made from ice cream frozen in a (generally spherical or hemispherical) mold."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1420addb-bc11-3b71-871f-ecef59b96f48",
                                        "entry_id": "6330209d-3e05-3564-ac06-7e778eed4b72",
                                        "glosses": [
                                            "A small, roughly hemispherical, chocolate-covered confection."
                                        ],
                                        "tags": [
                                            "in German cooking"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc478188-ba03-4da0-b304-d777360ac239",
                                                "sense_id": "1420addb-bc11-3b71-871f-ecef59b96f48",
                                                "text": "Sous-chef Daniel O'Reagan prepares an array of tempting desserts, including a zabaglione and marzipan bombe, chocolate mousse torte and an amaretto-flavored cheesecake."
                                            },
                                            {
                                                "example_id": "c75db38e-d2ff-4b73-b999-eb3cfd73ddcd",
                                                "sense_id": "1420addb-bc11-3b71-871f-ecef59b96f48",
                                                "text": "The best dessert by far is the chocolate-caramel bombe, a gorgeous chocolate-dusted dome with a heart of passion fruit crème brûlée."
                                            },
                                            {
                                                "example_id": "985d7541-b62c-4258-aa8f-39075750a917",
                                                "sense_id": "1420addb-bc11-3b71-871f-ecef59b96f48",
                                                "text": "Austria boasts the Mozart ball, a marzipan-filled chocolate ball wrapped in a portrait of the composer. Niemetz of Vienna also manufactures a famous marshmallow bombe called the Schwedenbombe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ded6cdf5-126f-3224-9014-ab25c8879758",
                                        "entry_id": "6330209d-3e05-3564-ac06-7e778eed4b72",
                                        "glosses": [
                                            "An electromechanical device used in early cryptanalysis."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
