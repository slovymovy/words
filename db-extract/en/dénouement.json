                "entry_id": "f7b6dfac-8c57-351f-a4dd-fd5ad51a793e",
                "word": "dénouement",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a19d6d1b-5856-4d8d-925b-9e6edc5f7b28",
                        "entry_id": "f7b6dfac-8c57-351f-a4dd-fd5ad51a793e",
                        "tags": [
                            "plural"
                        ],
                        "form": "dénouements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eade3cd0-dab9-3073-9f59-443367f17aba",
                        "entry_id": "f7b6dfac-8c57-351f-a4dd-fd5ad51a793e",
                        "glosses": [
                            "The conclusion or resolution of a plot; unravelling."
                        ],
                        "tags": [
                            "countable",
                            "figuratively",
                            "often",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1fa44bb4-d49e-43f7-8b64-b44bfefb5f1a",
                                "sense_id": "eade3cd0-dab9-3073-9f59-443367f17aba",
                                "text": "Emily was a great favourite with him; and he had always viewed the attachment, at whose dénouement between her and Lorraine, Lady Mandeville meant to preside, as a somewhat foolish romance."
                            },
                            {
                                "example_id": "95645937-401b-4961-a477-f464f9b3c1e3",
                                "sense_id": "eade3cd0-dab9-3073-9f59-443367f17aba",
                                "text": "At last this affair is moving towards the explosive dénouement he has been craving — the revelation, the release of tension, that will shake the universe in one fierce convulsion, and then allow everything to fall back into its rightful place, restored to normality!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "342b78ea-f31a-41b8-be87-1dc5c612dab2",
                        "source_entry_id": "f7b6dfac-8c57-351f-a4dd-fd5ad51a793e",
                        "source_sense_id": "eade3cd0-dab9-3073-9f59-443367f17aba",
                        "source_sense_description": "the conclusion or resolution of a plot",
                        "target_lang_word": "ontknoping",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ontknoping",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2d60e0a4-b4b5-30e0-9480-bc49e21a3efc",
                                        "entry_id": "7e623f60-3a8f-39cc-a01d-b9e82a8d7b13",
                                        "glosses": [
                                            "afloop, afsluiting, voleindiging, uitkomst, uitslag van een kwestie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f579e4e-d808-4f44-899f-151667a3b533",
                                                "sense_id": "2d60e0a4-b4b5-30e0-9480-bc49e21a3efc",
                                                "text": "Deus ex machina (Latijn: \"god uit een machine\") is een narratieve techniek waarbij er sprake is van een onverwachte ontknoping van een verhaal."
                                            },
                                            {
                                                "example_id": "da64a8e8-b049-4366-ab89-87c62bab1008",
                                                "sense_id": "2d60e0a4-b4b5-30e0-9480-bc49e21a3efc",
                                                "text": "Het werd de spannendste Eurovisie-ontknoping in vele jaren. Maar de uitkomst was die waar Nederland na 44 jaar naar smachtte: Duncan Laurence is winnaar van het Songfestival. Bijna een halve eeuw na de zege van Teach-in komt het festival volgend jaar weer naar Nederland."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "09094008-6c70-40c9-87e9-68239ec1ecac",
