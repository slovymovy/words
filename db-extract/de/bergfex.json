                        "form": "die Bergfexe"
                    },
                    {
                        "form_id": "32cc0fa8-19d2-4209-8460-c7a6dbca02f4",
                        "entry_id": "bc39c786-1fc4-3ae2-948a-e925ed9e4094",
                        "tags": [
                            "accusative",
