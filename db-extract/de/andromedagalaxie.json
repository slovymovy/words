                    {
                        "sense_id": "cacfdf89-23be-3aee-808f-2af49b68cdb0",
                        "entry_id": "c01164dd-faac-3994-b8eb-55b305daf8a0",
                        "glosses": [
                            "Spiralgalaxie im Sternbild Andromeda in 2,5 Millionen Lichtjahren Entfernung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71c25b51-1d1d-4c84-9f09-8d8bc55e3584",
                                "sense_id": "cacfdf89-23be-3aee-808f-2af49b68cdb0",
                                "text": "„Die Milchstraße und die Andromedagalaxie sind die beiden größten Galaxien der lokalen Gruppe.“"
                            },
                            {
                                "example_id": "b500c396-0bd6-46db-be73-8fa2a3f5c578",
                                "sense_id": "cacfdf89-23be-3aee-808f-2af49b68cdb0",
                                "text": "„In der Andromedagalaxie dagegen weisen die vielen alten Sterne im Zentralbereich auf eine helle Vergangenheit hin, in der die Sternbildungsrate viel höher war als heute.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
