                "senses": [
                    {
                        "sense_id": "92e648c7-5873-3e88-b273-b8f63d13b890",
                        "entry_id": "8bb05a0d-3121-3dae-b36d-5a597d3d1111",
                        "glosses": [
                            "finanzielle Ausgaben oder Aufwendungen, die man aufbringt, um sein Leben zu führen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe43ef92-650b-4a15-9159-23656fa5f0f9",
                                "sense_id": "92e648c7-5873-3e88-b273-b8f63d13b890",
                                "text": "Die Lebenshaltungskosten steigen oft schneller als die Einkommen."
                            },
                            {
                                "example_id": "0ab58ad7-3e55-4e7a-8475-c06ab0fd9e38",
                                "sense_id": "92e648c7-5873-3e88-b273-b8f63d13b890",
                                "text": "„In vielen Branchen, etwa dem Braugewerbe, der Buchproduktion, dem Bauwesen und der Holzverarbeitung, galten dieselben Tariflöhne wie vor dem Krieg, die, anders als im September und Oktober 1914, auch gezahlt wurden, aber natürlich viel zu niedrig waren für die gestiegenen Lebenshaltungskosten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "795e6551-1816-4ad7-97b4-23dcfef76b13",
                        "source_entry_id": "8bb05a0d-3121-3dae-b36d-5a597d3d1111",
                        "source_sense_id": "92e648c7-5873-3e88-b273-b8f63d13b890",
                        "source_sense_description": "finanzielle Aufwendungen, die man aufbringt, um sein Leben zu führen",
                        "target_lang_word": "cost of living",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cost of living",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e3b86d9-12aa-36a8-b20e-cd3bef7dc08c",
                                        "entry_id": "e73aee9c-809d-390f-808e-9bfaad329a91",
                                        "glosses": [
                                            "The average cost of a standard set of basic necessities of life, especially of food, shelter and clothing."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b47b7b38-406b-4727-8179-1a1df9719373",
                                                "sense_id": "4e3b86d9-12aa-36a8-b20e-cd3bef7dc08c",
                                                "text": "But the demonstrators remained defiant, pouring into the streets by the thousands and venting their anger over political corruption, the high cost of living and huge public spending for the World Cup and the Olympics."
                                            },
                                            {
                                                "example_id": "065eed45-f1c3-4c43-a55b-57e4e9109d41",
                                                "sense_id": "4e3b86d9-12aa-36a8-b20e-cd3bef7dc08c",
                                                "text": "Labour's Shadow Transport Secretary Louise Haigh said: \"There is a cost-of-living crisis, and the Prime Minister blew nearly £1m of public money on an utterly infeasible vanity project. That's enough to fill 18,000 potholes. This shows the Tories' sheer disrespect for public money.\""
                                            },
                                            {
                                                "example_id": "765b362c-44bb-49b0-9e23-0d8769ebb146",
                                                "sense_id": "4e3b86d9-12aa-36a8-b20e-cd3bef7dc08c",
                                                "text": "The Conservative leadership frontrunner, Liz Truss, has rejected “handouts” as a way of helping people affected by the cost of living crisis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "09979667-91a3-4e3b-9c25-176b3759a7b1",
                        "source_entry_id": "8bb05a0d-3121-3dae-b36d-5a597d3d1111",
                        "source_sense_id": "92e648c7-5873-3e88-b273-b8f63d13b890",
                        "source_sense_description": "finanzielle Aufwendungen, die man aufbringt, um sein Leben zu führen",
                        "target_lang_word": "coût de la vie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coût de la vie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9f6c27ff-1db5-3eab-a774-dad01fc4c711",
                                        "entry_id": "2ef6e8e9-c140-3be5-8a37-44fbf35ceb38",
                                        "glosses": [
                                            "Budget nécessaire à la vie d’un ménage, qui inclut l’hébergement, la nourriture et le transport."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1818a6a5-0c3a-4b6a-998b-7781977c9ce3",
                                                "sense_id": "9f6c27ff-1db5-3eab-a774-dad01fc4c711",
                                                "text": "De la Pologne (8 % d’inflation en décembre 2021) à l’Irlande (+ 5,7 %), en passant par l’Estonie (+ 12 %) et l’Espagne (+ 6 %), partout en Europe la question du coût de la vie est de nouveau au cœur des préoccupations. Dans la zone euro, l’indice des prix a bondi de 5 % en moyenne dans le dernier mois de 2021."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
