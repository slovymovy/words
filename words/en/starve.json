{
    "word_family": [
        "starvation",
        "starveling"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7a779bcf-858e-3089-8afb-94fb919431fc",
                    "sense_definition": "To be very hungry.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "hunger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am absolutely <w>starving</w> because I skipped breakfast this morning.",
                            "target_lang_translations": {
                                "ru": "Я просто <w>умираю с голоду</w>, потому что пропустил завтрак сегодня утром.",
                                "zh": "我今天早上没吃早饭，现在<w>饿极了</w>。"
                            }
                        },
                        {
                            "text": "Is dinner ready yet? I am <w>starving</w> for some real food.",
                            "target_lang_translations": {
                                "ru": "Ужин уже готов? Я <w>умираю как хочу</w> нормальной еды.",
                                "zh": "晚饭好了吗？我<w>饿得要命</w>，想吃点正经食物。"
                            }
                        }
                    ],
                    "synonyms": [
                        "famish"
                    ],
                    "antonyms": [
                        "full",
                        "satiated"
                    ],
                    "common_phrases": [
                        "starving for food"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used hyperbolically to mean very hungry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень сильно хотеть есть; испытывать сильное чувство голода.",
                        "zh": "感到非常饥饿。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "умирать с голоду",
                                "target_lang_sense_clarification": "разговорное преувеличение"
                            },
                            {
                                "target_lang_word": "проголодаться",
                                "target_lang_sense_clarification": "сильно захотеть есть"
                            },
                            {
                                "target_lang_word": "быть очень голодным",
                                "target_lang_sense_clarification": "состояние"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "饿极了",
                                "target_lang_sense_clarification": "形容非常饥饿的状态"
                            },
                            {
                                "target_lang_word": "饿得要命",
                                "target_lang_sense_clarification": "口语化的夸张表达"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f50d299-9eb8-3b59-9472-0d35be8bc66c",
                    "sense_definition": "To die because of lack of food or of not eating.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "hunger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Without any crops to harvest, the villagers began to <w>starve</w> during the long winter.",
                            "target_lang_translations": {
                                "ru": "Без урожая жители деревни начали <w>голодать</w> долгой зимой.",
                                "zh": "由于没有庄稼可收，村民们在漫长的冬天里开始<w>挨饿</w>。"
                            }
                        },
                        {
                            "text": "The explorer was afraid he would <w>starve</w> to death in the wilderness.",
                            "target_lang_translations": {
                                "ru": "Исследователь боялся, что <w>умрет от голода</w> в дикой местности.",
                                "zh": "探险家担心自己会在这片荒野中<w>饿死</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "starve to death"
                    ],
                    "target_lang_definitions": {
                        "ru": "Умирать или страдать от отсутствия пищи.",
                        "zh": "因缺乏食物而死亡或受苦。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "голодать",
                                "target_lang_sense_clarification": "длительное время"
                            },
                            {
                                "target_lang_word": "умирать от голода",
                                "target_lang_sense_clarification": "физическая смерть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挨饿",
                                "target_lang_sense_clarification": "长期缺乏食物"
                            },
                            {
                                "target_lang_word": "饿死",
                                "target_lang_sense_clarification": "因饥饿导致死亡"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c14e727-b22a-38a8-bbf5-ea843e3cf7ff",
                    "sense_definition": "To kill or attempt to kill by depriving of food.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deprivation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cruel captors tried to <w>starve</w> the prisoners into giving up their secrets.",
                            "target_lang_translations": {
                                "ru": "Жестокие похитители пытались <w>морить</w> пленников <w>голодом</w>, чтобы те выдали свои секреты.",
                                "zh": "残忍的俘虏者试图通过<w>饿死</w>囚犯来逼迫他们交出秘密。"
                            }
                        },
                        {
                            "text": "It is a crime to <w>starve</w> an animal by not providing it with proper nourishment.",
                            "target_lang_translations": {
                                "ru": "Это преступление — <w>морить</w> животное <w>голодом</w>, не обеспечивая его надлежащим питанием.",
                                "zh": "不给动物提供适当的营养而将其<w>饿死</w>是犯罪行为。"
                            }
                        }
                    ],
                    "antonyms": [
                        "feed",
                        "nourish"
                    ],
                    "common_phrases": [
                        "starve the enemy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Убивать или пытаться убить, лишая пищи.",
                        "zh": "通过剥夺食物来杀害或试图杀害某人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "морить голодом",
                                "target_lang_sense_clarification": "намеренно лишать еды"
                            },
                            {
                                "target_lang_word": "изнурять голодом",
                                "target_lang_sense_clarification": "доводить до истощения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "饿死",
                                "target_lang_sense_clarification": "使某人因饥饿而死"
                            },
                            {
                                "target_lang_word": "断粮",
                                "target_lang_sense_clarification": "切断食物供应"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05ddab59-d824-34df-9450-9aa93c1ec432",
                    "sense_definition": "To deprive of nourishment or of some vital component.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "deprivation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient's brain was <w>starved</w> of oxygen for several minutes during the accident.",
                            "target_lang_translations": {
                                "ru": "Мозг пациента <w>испытывал кислородное голодание</w> в течение нескольких минут во время аварии.",
                                "zh": "事故发生时，病人的大脑有几分钟<w>缺乏</w>氧气供应。"
                            }
                        },
                        {
                            "text": "The neglected child was <w>starved</w> of affection and attention from his parents.",
                            "target_lang_translations": {
                                "ru": "Заброшенный ребенок был <w>лишен</w> ласки и внимания со стороны родителей.",
                                "zh": "这个被忽视的孩子<w>得不到</w>父母的关爱和关注。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "starved of oxygen",
                        "starved of love"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишать питания или какого-либо жизненно важного компонента (кислорода, внимания).",
                        "zh": "剥夺某人或某物所需的营养或重要成分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испытывать голод",
                                "target_lang_sense_clarification": "в чем-либо (переносное)"
                            },
                            {
                                "target_lang_word": "лишать",
                                "target_lang_sense_clarification": "необходимого ресурса"
                            },
                            {
                                "target_lang_word": "изголодаться",
                                "target_lang_sense_clarification": "по чему-либо (чувствам, вниманию)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "缺乏",
                                "target_lang_sense_clarification": "缺少必要资源"
                            },
                            {
                                "target_lang_word": "得不到",
                                "target_lang_sense_clarification": "指被剥夺了某种情感或物质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "59424fbc-1e0a-3818-9c15-345b4e3fb4f2",
                    "sense_definition": "To force a combatant to submit or surrender by depriving of food, as in a targeted siege.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "siege",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The army decided to <w>starve</w> them out rather than attacking the fortified castle directly.",
                            "target_lang_translations": {
                                "ru": "Армия решила <w>выморить</w> их <w>голодом</w>, вместо того чтобы атаковать укрепленный замок напрямую.",
                                "zh": "军队决定通过<w>困死</w>他们，而不是直接进攻这座坚固的城堡。"
                            }
                        },
                        {
                            "text": "The strategy was to <w>starve</w> the garrison until they had no choice but to surrender.",
                            "target_lang_translations": {
                                "ru": "Стратегия заключалась в том, чтобы <w>морить</w> гарнизон <w>голодом</w>, пока у них не останется иного выбора, кроме как сдаться.",
                                "zh": "该策略是通过<w>围困</w>守军，直到他们别无选择只能投降。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "starve them out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставить противника сдаться, лишив его продовольствия (например, при осаде).",
                        "zh": "通过切断食物供应迫使敌方投降。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выморить голодом",
                                "target_lang_sense_clarification": "заставить сдаться"
                            },
                            {
                                "target_lang_word": "взять измором",
                                "target_lang_sense_clarification": "через лишения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "困死",
                                "target_lang_sense_clarification": "通过围困使其因缺乏补给而屈服"
                            },
                            {
                                "target_lang_word": "围困",
                                "target_lang_sense_clarification": "通过封锁迫使对方投降"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}