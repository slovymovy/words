                },
                {
                    "sense_id": "a5140bff-03a8-3250-9a60-39df5125dcf7",
                    "sense_definition": "A surname.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Candy</w> was surprised by the sudden phone call.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Кэнди</w> был удивлен внезапным телефонным звонком.",
                                "zh": "<w>坎迪</w>先生对这通突如其来的电话感到惊讶。"
                            }
                        },
                        {
                            "text": "The <w>Candy</w> family has lived in this town for generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Кэнди</w> живет в этом городе уже несколько поколений.",
                                "zh": "<w>坎迪</w>一家在这个镇上已经住了好几代人了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
