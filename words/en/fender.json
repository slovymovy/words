{
    "word_family": [
        "defend",
        "defense",
        "defensive"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b5de405f-c67a-3f9a-9d37-31c7a39e9412",
                    "sense_definition": "A panel of a car that encloses the wheel area, especially the front wheels.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "protective_shield",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car's front <w>fender</w> was dented after the minor collision in the parking lot.",
                            "target_lang_translations": {
                                "ru": "Переднее <w>крыло</w> автомобиля помялось после небольшого столкновения на парковке."
                            }
                        },
                        {
                            "text": "He spent the afternoon polishing the <w>fender</w> of his vintage sports car.",
                            "target_lang_translations": {
                                "ru": "Вторую половину дня он провел, полируя <w>крыло</w> своего винтажного спорткара."
                            }
                        }
                    ],
                    "synonyms": [
                        "wing"
                    ],
                    "common_phrases": [
                        "front fender"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кузовная деталь автомобиля, ограждающая колесную арку, особенно над передними колесами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крыло",
                                "target_lang_sense_clarification": "автомобильное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de55e4e1-c447-3eb6-b39f-516fcf966cf4",
                    "sense_definition": "A shield on a bicycle that protects the rider from mud or water.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "protective_shield",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Installing a <w>fender</w> on your bike keeps your clothes clean when riding through puddles.",
                            "target_lang_translations": {
                                "ru": "Установка <w>крыла</w> на велосипед помогает сохранить одежду чистой при езде по лужам."
                            }
                        },
                        {
                            "text": "The plastic <w>fender</w> broke off after hitting a large rock on the trail.",
                            "target_lang_translations": {
                                "ru": "Пластиковое <w>крыло</w> отломилось после удара о большой камень на тропе."
                            }
                        }
                    ],
                    "synonyms": [
                        "mudguard"
                    ],
                    "target_lang_definitions": {
                        "ru": "Щиток на велосипеде, защищающий велосипедиста от брызг грязи и воды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крыло",
                                "target_lang_sense_clarification": "велосипедное"
                            },
                            {
                                "target_lang_word": "брызговик",
                                "target_lang_sense_clarification": "защитный щиток"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b4715a8-8fb2-326e-ae11-30cc457eb529",
                    "sense_definition": "A cushion-like object placed along the side of a boat to prevent damage when moored.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "protective_shield",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain lowered the <w>fender</w> to protect the hull as the boat approached the dock.",
                            "target_lang_translations": {
                                "ru": "Капитан опустил <w>кранец</w>, чтобы защитить корпус, когда лодка приблизилась к причалу."
                            }
                        },
                        {
                            "text": "We tied a large rubber <w>fender</w> to the side of the boat before entering the lock.",
                            "target_lang_translations": {
                                "ru": "Перед заходом в шлюз мы привязали к борту лодки большой резиновый <w>кранец</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Амортизирующее приспособление, вывешиваемое за борт судна для защиты от повреждений при швартовке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кранец",
                                "target_lang_sense_clarification": "морской амортизатор"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd8afe4e-a515-30de-ac95-5a4b7ced1acc",
                    "sense_definition": "A low metal framework in front of a fireplace to catch hot coals and ash.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "protective_shield",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy iron <w>fender</w> kept the stray embers from burning the living room carpet.",
                            "target_lang_translations": {
                                "ru": "Тяжелая железная <w>каминная решетка</w> не давала случайным уголькам прожечь ковер в гостиной."
                            }
                        },
                        {
                            "text": "She polished the brass <w>fender</w> until it shone in the firelight.",
                            "target_lang_translations": {
                                "ru": "Она полировала латунную <w>каминную решетку</w> до тех пор, пока та не засияла в отблесках огня."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Низкая металлическая решетка или ограждение перед камином для задержки выпадающих углей и золы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "каминная решётка",
                                "target_lang_sense_clarification": "ограждение перед камином"
                            },
                            {
                                "target_lang_word": "каминный экран",
                                "target_lang_sense_clarification": "защитный барьер"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ae646dbb-e991-3a2d-8073-56c3597a8a26",
                    "sense_definition": "A guitar produced by the Fender company.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He played a classic <w>Fender</w> during the entire concert.",
                            "target_lang_translations": {
                                "ru": "Весь концерт он играл на классическом <w>Фендере</w>."
                            }
                        },
                        {
                            "text": "Many professional musicians prefer the sound of a vintage <w>Fender</w>.",
                            "target_lang_translations": {
                                "ru": "Многие профессиональные музыканты предпочитают звучание винтажного <w>Фендера</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Гитара производства компании Fender."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Фендер",
                                "target_lang_sense_clarification": "гитара марки Fender"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0b3e4c78-f451-3d64-962e-290b1e4213d8",
                    "sense_definition": "To use fenders to protect the side of a boat.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crew began to <w>fender</w> the boat as they prepared to dock in the narrow harbor.",
                            "target_lang_translations": {
                                "ru": "Команда начала <w>вывешивать кранцы</w>, готовясь к швартовке в узкой гавани."
                            }
                        },
                        {
                            "text": "Make sure to <w>fender</w> the vessel properly before the storm hits the marina.",
                            "target_lang_translations": {
                                "ru": "Обязательно <w>защитите кранцами</w> судно как следует, пока шторм не обрушился на марину."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Снабжать судно кранцами или вывешивать кранцы для защиты борта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вывешивать кранцы",
                                "target_lang_sense_clarification": "для защиты борта судна"
                            },
                            {
                                "target_lang_word": "защищать кранцами",
                                "target_lang_sense_clarification": "борт судна"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "ce56f3ef-3e8c-3632-9565-d18113fc55ae",
                    "sense_definition": "A surname of German origin.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The historian Mr. <w>Fender</w> wrote an extensive book about the region.",
                            "target_lang_translations": {
                                "ru": "Историк мистер <w>Фендер</w> написал подробную книгу об этом регионе."
                            }
                        },
                        {
                            "text": "I met a woman named Sarah <w>Fender</w> at the conference yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера на конференции я встретил женщину по имени Сара <w>Фендер</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия немецкого происхождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Фендер",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bdf60263-b036-3da9-b3bb-30a6a7d651dc",
                    "sense_definition": "A manufacturer of electric guitars.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "brand_or_product_name",
                    "examples": [
                        {
                            "text": "The rock band uses equipment exclusively from <w>Fender</w>.",
                            "target_lang_translations": {
                                "ru": "Рок-группа использует оборудование исключительно от <w>Fender</w>."
                            }
                        },
                        {
                            "text": "She bought her first electric guitar from <w>Fender</w> last summer.",
                            "target_lang_translations": {
                                "ru": "Прошлым летом она купила свою первую электрогитару от <w>Fender</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Компания-производитель электрогитар и музыкального оборудования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Фендер",
                                "target_lang_sense_clarification": "бренд/компания"
                            },
                            {
                                "target_lang_word": "Fender",
                                "target_lang_sense_clarification": "название компании"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}