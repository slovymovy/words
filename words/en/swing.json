{
    "word_family": [
        "swinger",
        "swinging",
        "swingy",
        "upswing",
        "downswing"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dda7629f-2f03-38f7-8183-ac0ddcf8d9b0",
                    "sense_definition": "To move back and forth or from side to side while hanging from a fixed point.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy metal sign <w>swung</w> in the strong wind all night long.",
                            "target_lang_translations": {
                                "ru": "Тяжелая металлическая вывеска всю ночь <w>раскачивалась</w> на сильном ветру.",
                                "zh": "那块沉重的金属招牌在强风中整夜不停地<w>摆动</w>。"
                            }
                        },
                        {
                            "text": "The monkeys like to <w>swing</w> from tree to tree in the jungle.",
                            "target_lang_translations": {
                                "ru": "Обезьяны любят <w>раскачиваться</w> на ветках, перепрыгивая с дерева на дерево в джунглях.",
                                "zh": "猴子喜欢在丛林里从一棵树<w>荡</w>到另一棵树。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "swing back and forth",
                        "swing in the breeze"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться вперед и назад или из стороны в сторону, вися на закрепленной точке.",
                        "zh": "指悬挂在固定点上，来回或左右摆动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "качаться",
                                "target_lang_sense_clarification": "ритмично колебаться"
                            },
                            {
                                "target_lang_word": "раскачиваться",
                                "target_lang_sense_clarification": "совершать колебательные движения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "摆动",
                                "target_lang_sense_clarification": "物体来回晃动"
                            },
                            {
                                "target_lang_word": "摇晃",
                                "target_lang_sense_clarification": "不稳地晃动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b46b1b8-cbc5-3417-8731-4cbf5232e643",
                    "sense_definition": "To move an object in a wide, curving motion with your arm.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>swung</w> his sword as hard as he could to hit the target.",
                            "target_lang_translations": {
                                "ru": "Он <w>взмахнул</w> мечом изо всех сил, чтобы поразить цель.",
                                "zh": "他拼尽全力<w>挥动</w>宝剑，试图击中目标。"
                            }
                        },
                        {
                            "text": "The player <w>swung</w> the bat but missed the ball completely.",
                            "target_lang_translations": {
                                "ru": "Игрок <w>замахнулся</w> битой, но совсем не попал по мячу.",
                                "zh": "球员<w>挥</w>了一下球棒，但完全没打中球。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "swing a bat",
                        "swing your arms"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигать предмет широким дугообразным движением руки.",
                        "zh": "用手臂做大幅度的弧形动作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "размахивать",
                                "target_lang_sense_clarification": "делать широкие движения"
                            },
                            {
                                "target_lang_word": "замахнуться",
                                "target_lang_sense_clarification": "приготовиться к удару"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挥动",
                                "target_lang_sense_clarification": "手臂大幅度摆动"
                            },
                            {
                                "target_lang_word": "抡",
                                "target_lang_sense_clarification": "用力挥动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58435599-de2f-3159-9d0f-fd9053568014",
                    "sense_definition": "To sit on and move a hanging seat back and forth for fun.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "recreation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children laughed as they <w>swung</w> together at the park.",
                            "target_lang_translations": {
                                "ru": "Дети смеялись, когда вместе <w>качались</w> в парке.",
                                "zh": "孩子们在公园里一起<w>荡秋千</w>，笑声不断。"
                            }
                        },
                        {
                            "text": "I used to <w>swing</w> on the porch every evening during the summer.",
                            "target_lang_translations": {
                                "ru": "Летом я каждый вечер <w>качался</w> на крыльце.",
                                "zh": "夏天的时候，我过去每天傍晚都会在门廊上<w>荡秋千</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "swing on a swing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сидеть на подвесном сиденье и двигаться на нем вперед и назад ради забавы.",
                        "zh": "坐在悬挂的座椅上，为了娱乐而前后摆动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "качаться",
                                "target_lang_sense_clarification": "на качелях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "荡秋千",
                                "target_lang_sense_clarification": "在秋千上玩耍"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3e8491c-29b7-3006-9c90-60e43c327e91",
                    "sense_definition": "To change quickly from one mood, opinion, or state to another.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her mood <w>swung</w> from happy to sad in just a few minutes.",
                            "target_lang_translations": {
                                "ru": "Ее настроение <w>изменилось</w> со счастливого на грустное всего за несколько минут.",
                                "zh": "她的情绪在几分钟内就从开心<w>波动</w>到了难过。"
                            }
                        },
                        {
                            "text": "Public opinion began to <w>swing</w> against the new government policy.",
                            "target_lang_translations": {
                                "ru": "Общественное мнение начало <w>склоняться</w> против новой политики правительства.",
                                "zh": "公众舆论开始<w>转向</w>，反对政府的新政策。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shift",
                        "fluctuate"
                    ],
                    "common_phrases": [
                        "mood swing",
                        "swing between extremes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро меняться от одного настроения, мнения или состояния к другому.",
                        "zh": "从一种情绪、观点或状态迅速转变为另一种。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колебаться",
                                "target_lang_sense_clarification": "о мнении или настроении"
                            },
                            {
                                "target_lang_word": "меняться",
                                "target_lang_sense_clarification": "резко переходить в другое состояние"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "波动",
                                "target_lang_sense_clarification": "状态或情绪起伏"
                            },
                            {
                                "target_lang_word": "转变",
                                "target_lang_sense_clarification": "观点或态度的改变"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be437d08-1be3-3c06-8984-332effd6e91c",
                    "sense_definition": "To manage to achieve or afford something, often with some difficulty.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "achievement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If it is not too expensive, I think we can <w>swing</w> it this month.",
                            "target_lang_translations": {
                                "ru": "Если это не слишком дорого, думаю, мы сможем это <w>потянуть</w> в этом месяце.",
                                "zh": "如果不太贵的话，我想我们这个月应该能<w>搞定</w>。"
                            }
                        },
                        {
                            "text": "I am not sure if I can <w>swing</w> a day off work next week.",
                            "target_lang_translations": {
                                "ru": "Я не уверен, что смогу <w>выбить</w> себе выходной на следующей неделе.",
                                "zh": "我不确定下周能不能<w>设法安排</w>一天休假。"
                            }
                        }
                    ],
                    "synonyms": [
                        "truss"
                    ],
                    "common_phrases": [
                        "swing a deal",
                        "swing it"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used in informal speech to mean managing a situation."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Суметь достичь чего-либо или позволить себе что-либо, часто с некоторым трудом.",
                        "zh": "设法完成或负担得起某事，通常伴随一定困难。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "провернуть",
                                "target_lang_sense_clarification": "успешно организовать дело"
                            },
                            {
                                "target_lang_word": "устроить",
                                "target_lang_sense_clarification": "организовать или позволить себе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "搞定",
                                "target_lang_sense_clarification": "成功处理某事"
                            },
                            {
                                "target_lang_word": "设法安排",
                                "target_lang_sense_clarification": "努力达成目标"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4dc38a8e-c6dd-32e5-89ca-ee817be01194",
                    "sense_definition": "To be executed by hanging.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "punishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pirate was told he would <w>swing</w> for his crimes at dawn.",
                            "target_lang_translations": {
                                "ru": "Пирату сказали, что на рассвете он <w>будет болтаться</w> в петле за свои преступления.",
                                "zh": "海盗被告知他将在黎明时因其罪行被<w>绞死</w>。"
                            }
                        },
                        {
                            "text": "In those days, a man could <w>swing</w> for stealing a single horse.",
                            "target_lang_translations": {
                                "ru": "В те времена человека могли <w>повесить</w> за кражу одной-единственной лошади.",
                                "zh": "在那个年代，一个人偷一匹马就可能被<w>绞死</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hang",
                        "dangle",
                        "string up"
                    ],
                    "common_phrases": [
                        "swing for it"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to historical methods of execution."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть казненным через повешение.",
                        "zh": "被处以绞刑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "болтаться",
                                "target_lang_sense_clarification": "в петле"
                            },
                            {
                                "target_lang_word": "быть повешенным",
                                "target_lang_sense_clarification": "казнь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "绞死",
                                "target_lang_sense_clarification": "处决方式"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "69814825-341a-38fc-8620-29f311c938e1",
                    "sense_definition": "A seat suspended by ropes or chains on which someone can sit and move back and forth.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The little girl asked her father to push her on the <w>swing</w>.",
                            "target_lang_translations": {
                                "ru": "Маленькая девочка попросила папу покачать ее на <w>качелях</w>.",
                                "zh": "小女孩请求爸爸推她荡<w>秋千</w>。"
                            }
                        },
                        {
                            "text": "We have a wooden <w>swing</w> hanging from the large oak tree.",
                            "target_lang_translations": {
                                "ru": "У нас на большом дубе висят деревянные <w>качели</w>.",
                                "zh": "我们有一架木制<w>秋千</w>挂在那棵大橡树上。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "playground swing",
                        "tire swing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сиденье, подвешенное на веревках или цепях, на котором можно сидеть и качаться.",
                        "zh": "一种由绳索或链条悬挂的座椅，供人坐着前后摆动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "качели",
                                "target_lang_sense_clarification": "сооружение для забавы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "秋千",
                                "target_lang_sense_clarification": "游乐设施"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b29e9501-e33c-3b60-b273-c260e2eac884",
                    "sense_definition": "The specific way or technique in which someone moves a tool or sports club.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He worked tirelessly for months to improve his golf <w>swing</w>.",
                            "target_lang_translations": {
                                "ru": "Он без устали работал месяцами, чтобы улучшить свой <w>замах</w> в гольфе.",
                                "zh": "他几个月来不懈努力，只为改进自己的高尔夫<w>挥杆</w>动作。"
                            }
                        },
                        {
                            "text": "The coach told the player that his baseball <w>swing</w> was too slow.",
                            "target_lang_translations": {
                                "ru": "Тренер сказал игроку, что его <w>взмах</w> битой в бейсболе слишком медленный.",
                                "zh": "教练告诉球员，他的棒球<w>挥杆</w>太慢了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "golf swing",
                        "baseball swing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенный способ или техника, с помощью которой кто-то замахивается инструментом или спортивной клюшкой.",
                        "zh": "挥动工具或球杆的特定方式或技巧。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замах",
                                "target_lang_sense_clarification": "движение при ударе"
                            },
                            {
                                "target_lang_word": "свинг",
                                "target_lang_sense_clarification": "в гольфе или боксе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挥杆",
                                "target_lang_sense_clarification": "高尔夫或棒球中的动作"
                            },
                            {
                                "target_lang_word": "挥动",
                                "target_lang_sense_clarification": "动作姿势"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f39bf590-8337-354a-8be1-90afc7507b86",
                    "sense_definition": "A style of jazz music with a lively, rhythmic beat popular in the 1930s and 40s.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band played classic <w>swing</w> that made everyone want to dance.",
                            "target_lang_translations": {
                                "ru": "Группа играла классический <w>свинг</w>, под который всем хотелось танцевать.",
                                "zh": "乐队演奏了经典的<w>摇摆乐</w>，让每个人都想跳舞。"
                            }
                        },
                        {
                            "text": "It don't mean a thing if it ain't got that <w>swing</w>.",
                            "target_lang_translations": {
                                "ru": "Все это не имеет значения, если в этом нет <w>свинга</w>.",
                                "zh": "如果少了那种<w>摇摆乐</w>的韵味，一切都毫无意义。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "swing music",
                        "swing band"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стиль джазовой музыки с живым ритмичным битом, популярный в 1930-х и 40-х годах.",
                        "zh": "一种流行于20世纪30和40年代，节奏活泼的爵士乐风格。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свинг",
                                "target_lang_sense_clarification": "направление джаза"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "摇摆乐",
                                "target_lang_sense_clarification": "爵士乐风格"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74ee430e-9323-3204-b110-73d97c66943f",
                    "sense_definition": "A significant change in public opinion or voting patterns.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The latest polls showed a wide <w>swing</w> to the opposition party.",
                            "target_lang_translations": {
                                "ru": "Последние опросы показали значительный <w>сдвиг</w> в сторону оппозиционной партии.",
                                "zh": "最新的民调显示，选民出现了大规模向反对党<w>转向</w>的趋势。"
                            }
                        },
                        {
                            "text": "There was a sudden <w>swing</w> in voter sentiment just before the election.",
                            "target_lang_translations": {
                                "ru": "Прямо перед выборами произошел внезапный <w>поворот</w> в настроениях избирателей.",
                                "zh": "选举前夕，选民情绪发生了突然的<w>波动</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "political swing",
                        "swing to the left"
                    ],
                    "target_lang_definitions": {
                        "ru": "Значительное изменение в общественном мнении или результатах голосования.",
                        "zh": "公众舆论或投票模式的重大转变。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "размах",
                                "target_lang_sense_clarification": "масштаб изменений"
                            },
                            {
                                "target_lang_word": "сдвиг",
                                "target_lang_sense_clarification": "резкое изменение в настроениях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "转向",
                                "target_lang_sense_clarification": "民意或立场的改变"
                            },
                            {
                                "target_lang_word": "波动",
                                "target_lang_sense_clarification": "数据或趋势的变化"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "6a77e8cf-b0f0-3bda-a1cb-740d11b380a4",
                    "sense_definition": "A <w>surname</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local library was named after a prominent citizen named Mr. <w>Swing</w>.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь выдающегося гражданина по фамилии <w>Свинг</w>.",
                                "zh": "当地图书馆是以一位名叫<w>斯温</w>先生的杰出市民命名的。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Свинг",
                                "target_lang_sense_clarification": "фамилия"
                            }
