{
    "word_family": [
        "plenty",
        "plenteous",
        "plentifully",
        "plentifulness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b55aff7c-29ea-3c41-a933-0c21e7b969b6",
                    "sense_definition": "Existing in large numbers or in an ample amount.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "abundance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmers were very happy because they had a <w>plentiful</w> harvest this year.",
                            "target_lang_translations": {
                                "ru": "Фермеры были очень счастливы, потому что в этом году у них был <w>обильный</w> урожай."
                            }
                        },
                        {
                            "text": "There is a <w>plentiful</w> supply of fresh water available for the entire village.",
                            "target_lang_translations": {
                                "ru": "Для всей деревни доступен <w>богатый</w> запас пресной воды."
                            }
                        }
                    ],
                    "synonyms": [
                        "abundant",
                        "ample",
                        "copious",
                        "plenteous",
                        "bountiful"
                    ],
                    "antonyms": [
                        "scarce",
                        "meager",
                        "insufficient",
                        "scant"
                    ],
                    "common_phrases": [
                        "plentiful supply",
                        "plentiful harvest",
                        "plentiful resources"
                    ],
                    "target_lang_definitions": {
                        "ru": "Существующий в большом количестве или в достаточном объеме."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обильный",
                                "target_lang_sense_clarification": "о количестве или запасах"
                            },
                            {
                                "target_lang_word": "изобильный",
                                "target_lang_sense_clarification": "имеющийся в избытке"
                            },
                            {
                                "target_lang_word": "многочисленный",
                                "target_lang_sense_clarification": "о большом количестве предметов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68e3c190-9779-3874-b535-c32d05c77d74",
                    "sense_definition": "Producing or yielding an abundance; fruitful.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abundance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The valley is known for its <w>plentiful</w> soil which supports many types of crops.",
                            "target_lang_translations": {
                                "ru": "Долина известна своей <w>плодородной</w> почвой, на которой произрастают многие виды культур."
                            }
                        },
                        {
                            "text": "During the summer months, the old apple tree remains a <w>plentiful</w> source of fruit.",
                            "target_lang_translations": {
                                "ru": "В летние месяцы старая яблоня остается <w>богатым</w> источником плодов."
                            }
                        }
                    ],
                    "synonyms": [
                        "fruitful",
                        "prolific",
                        "fertile",
                        "fecund"
                    ],
                    "antonyms": [
                        "barren",
                        "unfruitful",
                        "unproductive",
                        "sterile"
                    ],
                    "common_phrases": [
                        "plentiful source",
                        "plentiful year"
                    ],
                    "target_lang_definitions": {
                        "ru": "Производящий или дающий что-либо в изобилии; плодородный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плодородный",
                                "target_lang_sense_clarification": "о почве или земле"
                            },
                            {
                                "target_lang_word": "богатый",
                                "target_lang_sense_clarification": "о ресурсе или источнике"
                            },
                            {
                                "target_lang_word": "изобилующий",
                                "target_lang_sense_clarification": "дающий большой урожай"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd59fa2f-69c4-35c9-a38c-38ac20c13bab",
                    "sense_definition": "Characterized by being lavish, profuse, or spending in a wasteful manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "abundance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was known to be <w>plentiful</w> in expenses, often buying gifts for everyone he met.",
                            "target_lang_translations": {
                                "ru": "Он был известен своей <w>щедростью</w> в расходах, часто покупая подарки всем, кого встречал."
                            }
                        },
                        {
                            "text": "The host provided a <w>plentiful</w> display of food and wine for the celebration.",
                            "target_lang_translations": {
                                "ru": "Хозяин подготовил <w>роскошный</w> стол с едой и вином для праздника."
                            }
                        }
                    ],
                    "synonyms": [
                        "lavish",
                        "profuse",
                        "prodigal",
                        "generous"
                    ],
                    "antonyms": [
                        "stingy",
                        "niggardly",
                        "small"
                    ],
                    "common_phrases": [
                        "plentiful in expenses"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся щедростью, расточительностью или чрезмерным обилием."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щедрый",
                                "target_lang_sense_clarification": "о расходах или подарках"
                            },
                            {
                                "target_lang_word": "роскошный",
                                "target_lang_sense_clarification": "о приеме или угощении"
                            },
                            {
                                "target_lang_word": "расточительный",
                                "target_lang_sense_clarification": "о тратах"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}