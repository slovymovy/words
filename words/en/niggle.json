    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8f70efb4-b254-3cac-9ab6-e4636a17ba90",
                    "sense_definition": "To criticize, complain, or worry excessively about small or unimportant details.",
