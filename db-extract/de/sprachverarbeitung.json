                "senses": [
                    {
                        "sense_id": "a3e6b34d-13aa-3b66-8dcc-0c690c10012f",
                        "entry_id": "141ade69-5b0e-33df-a962-e421f49cb252",
                        "glosses": [
                            "Produktion und Rezeption sprachlicher Äußerungen durch den Menschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed9c2a14-0763-4459-a394-2f526655aead",
                                "sense_id": "a3e6b34d-13aa-3b66-8dcc-0c690c10012f",
                                "text": "Die Sprachverarbeitung ist nur dann möglich, wenn eine Person die betreffende Sprache beherrscht."
                            },
                            {
                                "example_id": "0e1cd624-4766-42b0-8f25-67b67c00d70d",
                                "sense_id": "a3e6b34d-13aa-3b66-8dcc-0c690c10012f",
                                "text": "„Im Bereich derSprachverarbeitung sind bisher vor allem der akustische Analysator und der Hör-Synthesebereich untersucht worden…“"
                            },
                            {
                                "example_id": "00378b2e-fc45-47cc-b4a8-0a37a2f08987",
                                "sense_id": "a3e6b34d-13aa-3b66-8dcc-0c690c10012f",
                                "text": "„Bringen wir nun zum Abschluß die einzelnen Schritte der Sprachverarbeitung unter einen Hut.“"
                            },
                            {
                                "example_id": "bf48feb1-5c70-40a1-ba5d-d8cd1518554b",
                                "sense_id": "a3e6b34d-13aa-3b66-8dcc-0c690c10012f",
                                "text": "„Die Neuropsychologin Prof. Dr. Angela Friederici führt Experimente zur Sprachverarbeitung durch.“"
                            },
                            {
                                "example_id": "66c60728-c3af-4a8e-afab-edc84cc7aaaa",
                                "sense_id": "a3e6b34d-13aa-3b66-8dcc-0c690c10012f",
                                "text": "„Gegenwärtig wisse man noch sehr wenig über die innere Organisation der Sprachverarbeitung beim Kinde.“"
                            },
                            {
                                "example_id": "0b7ab021-24a6-43b8-86c8-ec3ec1599a76",
                                "sense_id": "a3e6b34d-13aa-3b66-8dcc-0c690c10012f",
                                "text": "Manchmal wird unter Sprachverarbeitung nur maschinelle Sprachverarbeitung verstanden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "515d68c3-7bb4-35c0-a261-53a0b69dd97e",
                        "entry_id": "141ade69-5b0e-33df-a962-e421f49cb252",
                        "glosses": [
                            "Analyse und Synthese sprachlicher Äußerungen durch Computer"
                        ],
                        "tags": [
                            "speziell Computerlinguistik"
                        ],
                        "examples": [
                            {
                                "example_id": "0068a608-dca9-43e0-b111-60cf0b7c09ad",
                                "sense_id": "515d68c3-7bb4-35c0-a261-53a0b69dd97e",
                                "text": "Die maschinelle Sprachverarbeitung versuchte u.a., Programme zu entwickeln, mit denen Sätze automatisch analysiert werden können."
                            },
                            {
                                "example_id": "ee9c9c8e-9429-46c8-ac9e-2c15a2b0a4d8",
                                "sense_id": "515d68c3-7bb4-35c0-a261-53a0b69dd97e",
                                "text": "Manchmal wird unter Sprachverarbeitung nur maschinelle Sprachverarbeitung verstanden."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
