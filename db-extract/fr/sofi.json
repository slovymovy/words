                                "target_senses": [
                                    {
                                        "sense_id": "5c015e6d-c4b8-3c94-a30b-e0c9d78cb386",
                                        "entry_id": "69176624-523b-35c6-8236-d9655aadf7b2",
                                        "glosses": [
                                            "A diminutive of the female given name Sophia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21ea9437-1e8b-4f10-863e-20887cd38a26",
                                                "sense_id": "5c015e6d-c4b8-3c94-a30b-e0c9d78cb386",
                                                "text": "I knew Sophy was a good girl, and would not fall in love to make me angry."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Sophy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b1cdf4aa-3eb4-3038-a1dc-7a2cb10fac28",
                                        "entry_id": "11b50eba-e137-31fd-925d-ae3604d88908",
                                        "glosses": [
                                            "Archaic form of Safawi (“a member of the Safavid dynasty”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "322548e6-42b9-4454-8982-8e0aa1659993",
                                                "sense_id": "b1cdf4aa-3eb4-3038-a1dc-7a2cb10fac28",
                                                "text": "The great tent on the lawn, wherein presently we are to sup,—blue and yellow without, and within all braveries of tapestry and of table service,—suggests a state pavilion of the Sophy camped for glittering war."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
