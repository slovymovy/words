                        "glosses": [
                            "A hook for pulling the buttons of gloves and shoes through the buttonholes."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "8c2684e1-7603-476e-bccd-7fff791faec2",
                                "sense_id": "90176dab-157a-3b42-8136-4edfe5f26490",
                                "text": "‘I'm sorry we are so late,’ he was saying. ‘We couldn't find a button-hook, so it took us a long time to button our boots.’"
                            },
                            {
                                "example_id": "55791ccc-1d7d-4e80-bf92-7aac8db2d747",
                                "sense_id": "90176dab-157a-3b42-8136-4edfe5f26490",
                                "text": "Hustlers used to sell shoes like that to the greenhorns fifty years ago with a buttonhook for a bonus."
                            }
                        ]
                    },
                    {
                        "sense_id": "e260488d-ed3b-362c-8e8d-0b15fbae37b2",
                        "entry_id": "60dc06f6-1393-3e59-89bd-ea6e2d41dad2",
                        "glosses": [
                            "A play in which the receiver runs straight downfield, then turns back toward the line of scrimmage."
                        ],
                        "tags": [],
                        "examples": [
