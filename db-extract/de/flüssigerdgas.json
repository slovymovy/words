                "senses": [
                    {
                        "sense_id": "eced0d3e-5e8b-3436-a1cc-712d6181b3a8",
                        "entry_id": "26b0d1ac-a4b0-31cf-81ca-750196bce1ea",
                        "glosses": [
                            "durch Kühlung verflüssigtes Erdgas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c20a63ef-4489-499c-91d8-675e1a90953f",
                                "sense_id": "eced0d3e-5e8b-3436-a1cc-712d6181b3a8",
                                "text": "„Die hohe Nachfrage nach Erdgas in Europa hat den USA im Dezember einen Ausfuhr-Rekord bei Flüssigerdgas (LNG) beschert.“"
                            },
                            {
                                "example_id": "8144ebe2-02a7-4c70-a4c3-fdafa5c64188",
                                "sense_id": "eced0d3e-5e8b-3436-a1cc-712d6181b3a8",
                                "text": "„Das Flüssigerdgas ist wesentlich umweltfreundlicher als Schweröl: Keine Rußpartikel, fast keine Stickstoff- und Schwefelemissionen sowie 20 Prozent weniger CO2-Ausstoß.“"
                            },
                            {
                                "example_id": "6a4e6b68-a5db-4da2-93db-a2edd631a123",
                                "sense_id": "eced0d3e-5e8b-3436-a1cc-712d6181b3a8",
                                "text": "„Die Gewinnung von Flüssigerdgas führt zu radioaktiven Abfällen, vergifteten Flüssen und einer enormen Klimabelastung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
