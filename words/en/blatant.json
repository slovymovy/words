{
    "word_family": [
        "blatantly",
        "blatancy"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "32818614-7cf4-36bb-81a5-4adf1b6bdcb6",
                    "sense_definition": "Completely obvious and unashamed, often in an offensive or annoying way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obviousness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician told a <w>blatant</w> lie during the live television interview.",
                            "target_lang_translations": {
                                "zh": "那位政客在电视直播采访中撒了一个<w>公然的</w>谎。"
                            }
                        },
                        {
                            "text": "There was a <w>blatant</w> disregard for the safety rules at the construction site.",
                            "target_lang_translations": {
                                "zh": "工地上对安全规则表现出<w>明目张胆的</w>无视。"
                            }
                        }
                    ],
                    "synonyms": [
                        "obvious",
                        "glaring",
                        "evident",
                        "palpable"
                    ],
                    "common_phrases": [
                        "blatant lie",
                        "blatant disregard"
                    ],
                    "target_lang_definitions": {
                        "zh": "指行为或言语极其明显、毫不掩饰，通常带有冒犯性或令人反感。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "公然的",
                                "target_lang_sense_clarification": "强调行为公开且不加掩饰，常用于负面语境。"
                            },
                            {
                                "target_lang_word": "明目张胆的",
                                "target_lang_sense_clarification": "形容胆大妄为，毫不顾忌。"
                            },
                            {
                                "target_lang_word": "显而易见的",
                                "target_lang_sense_clarification": "侧重于事实非常明显，不加修饰。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24998847-5a48-38c6-ac04-895664a40917",
                    "sense_definition": "Making a loud, harsh, and unpleasant noise.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>blatant</w> noise from the broken machine kept everyone awake all night.",
                            "target_lang_translations": {
                                "zh": "那台坏机器发出的<w>刺耳</w>噪音让大家整晚都没睡着。"
                            }
                        },
                        {
                            "text": "He played a <w>blatant</w> melody on his trumpet that echoed through the empty hall.",
                            "target_lang_translations": {
                                "zh": "他用小号吹奏出一曲<w>刺耳的</w>旋律，在空荡的大厅里回响。"
                            }
                        }
                    ],
                    "synonyms": [
                        "loud",
                        "harsh"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Often used in literary contexts to describe harsh, clamorous sounds."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指声音刺耳、嘈杂且令人不悦。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "刺耳的",
                                "target_lang_sense_clarification": "形容声音尖锐、难听。"
                            },
                            {
                                "target_lang_word": "嘈杂的",
                                "target_lang_sense_clarification": "形容声音混乱且吵闹。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}