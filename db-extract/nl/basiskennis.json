                "senses": [
                    {
                        "sense_id": "4c1a0941-60a4-3437-9587-b84a4e54e42d",
                        "entry_id": "e05a78e6-c449-3a7b-bf1c-80844bd88f18",
                        "glosses": [
                            "de eerste beginselen van een onderwerp of vakgebied beheersen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3eec8468-08e7-48d0-970b-ec1c9b866d5c",
                                "sense_id": "4c1a0941-60a4-3437-9587-b84a4e54e42d",
                                "text": "Trots kijkt Peter Bolink (42) de zaal in. In het speellokaal van de school zitten meerdere leerlingen van groep 8 aan aparte tafels. In duo’s worden ze ondervraagd over de geleerde stof. Als leraar staat Bolink vierkant achter de praktijklessen die zijn klas heeft gevolgd. „Toen ik hier net begon met werken werd deze cursus al aangeboden. Gelukkig is dat nog steeds het geval. Ze krijgen zo een goede basiskennis mee.”"
                            },
                            {
                                "example_id": "13cb86cb-9109-441f-8bcc-9c2a1f6fa803",
                                "sense_id": "4c1a0941-60a4-3437-9587-b84a4e54e42d",
                                "text": "Dat Van Bommel meertalig is, spreekt in zijn voordeel. Het Duits en Engels beheerst hij, evenals de Spaanse taal. Van Bommel heeft ook basiskennis van het Italiaans, vanwege zijn periode bij AC Milan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6917eb8a-7ed6-4284-867f-cd2060a771b1",
                        "source_entry_id": "e05a78e6-c449-3a7b-bf1c-80844bd88f18",
                        "source_sense_id": "4c1a0941-60a4-3437-9587-b84a4e54e42d",
                        "target_lang_word": "Grundkenntnis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grundkenntnis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fc0d8491-96ef-3d41-b90e-21948c29d03d",
                                        "entry_id": "704004b5-868d-3c04-b7b5-2e408cd59d77",
                                        "glosses": [
                                            "grundlegendes Wissen über ein Thema"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "914eff44-008c-4f0c-ab85-352e6efb40bc",
                                                "sense_id": "fc0d8491-96ef-3d41-b90e-21948c29d03d",
                                                "text": "Der Bewerber hat Grundkenntnisse in vielen Gebieten."
                                            },
                                            {
                                                "example_id": "4a925a7d-7ba6-4716-bb72-a009818b5021",
                                                "sense_id": "fc0d8491-96ef-3d41-b90e-21948c29d03d",
                                                "text": "„Vielleicht dient die kurze Rede Kants, die Grundkenntnisse in Rhetorik verrät, nur dem einzigen Zweck, den verwundeten Soldaten Lampe aufzurichten für die zweite Angriffswelle.“"
                                            },
                                            {
                                                "example_id": "6c5b2451-edda-41b1-b117-691a0e717781",
                                                "sense_id": "fc0d8491-96ef-3d41-b90e-21948c29d03d",
                                                "text": "„Die kenntnisreichsten Mineralforscher des Erzgebirges wären schon über unsere schulischen Grundkenntnisse in Chemie und Physik, die es als naturwissenschaftliche Disziplinen zu ihrer Zeit noch gar nicht gab, erstaunt gewesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
