                "senses": [
                    {
                        "sense_id": "b1b79790-5736-37c5-8ed2-65793d636837",
                        "entry_id": "cd88d8bd-999f-3ded-bc8b-4485f5627070",
                        "glosses": [
                            "een zwijgende vrouw (die veel breit)"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "23d7c115-c944-4187-95f7-180e00aae0b5",
                                "sense_id": "b1b79790-5736-37c5-8ed2-65793d636837",
                                "text": "De kindermeid ontstak de vergulde kaarsen voor de iconen en ging met haar breikous bij de deur zitten."
                            },
                            {
                                "example_id": "cffefbe9-13c1-4bda-bd80-16a4e804ae7e",
                                "sense_id": "b1b79790-5736-37c5-8ed2-65793d636837",
                                "text": "Het eerste nummer verscheen een kleine vijftig jaar geleden als opvolger van het beschaafdere Eva. ‘Dag breikous, dag zeurkous. In Viva is je tijd voorbij’, aldus het typerende statement in het eerste nummer."
                            }
                        ]
                    },
                    {
                        "sense_id": "36e0b1a3-e457-3a79-8f33-b23f966d6fb5",
                        "entry_id": "cd88d8bd-999f-3ded-bc8b-4485f5627070",
                        "glosses": [
                            "een kous die men breit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f62d355b-2437-4b7d-be3c-9561b7579f54",
                                "sense_id": "36e0b1a3-e457-3a79-8f33-b23f966d6fb5",
                                "text": "Na 1980 wijdt Prinses Juliana zich aan hetgeen haar bijzondere interesse heeft. ”Ik ben niet een oude dame met een breikous, een poes en een kanarie”."
                            },
                            {
                                "example_id": "87e32b9a-dfd7-48d8-b50b-8e92267b75d3",
                                "sense_id": "36e0b1a3-e457-3a79-8f33-b23f966d6fb5",
                                "text": "Het ontwapenende in haar vertederde de mensen die haar ontmoetten. Ze wist op haar beurt mensen op hun gemak te stellen. Bij de opening van een huishoudbeurs haalde zij een breikous uit haar tas. De vrouw die zou haar begeleiden, was op slag haar zenuwen kwijt. Als twee keuvelende vriendinnen werkten ze vervolgens het programma af."
                            }
                        ]
                    }
