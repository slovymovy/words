                "senses": [
                    {
                        "sense_id": "b8b32ced-8fa7-3f9d-8207-d54c59832b2c",
                        "entry_id": "2f830fc0-c746-33d7-9302-4acf5603717e",
                        "glosses": [
                            "Donner un caractère dorien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb5ca6c5-47af-4b76-b3d1-cff12a892697",
                                "sense_id": "b8b32ced-8fa7-3f9d-8207-d54c59832b2c",
                                "text": "De fait, dès le tout début de l’époque archaïque, les Argiens auraient « dorianisé » les Cynouriens (Hérodote, VIII, 73)."
                            },
                            {
                                "example_id": "3a7948aa-66f5-46f2-9aa3-a0f21c358597",
                                "sense_id": "b8b32ced-8fa7-3f9d-8207-d54c59832b2c",
                                "text": "A l'époque classique les Thessaliens parlaient une langue intermédiaire entre l'achéen et le dorien, mais étaient-ils des Achéens dorianisés ou des Doriens achéanisés ?"
                            }
                        ]
                    }
