                                        "entry_id": "399b2f86-05b2-3244-82b6-5ee8ec435319",
                                        "glosses": [
                                            "Meuble à compartiments qui sert à classer des papiers, des documents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01220bfc-3b1a-4d9a-ba5e-f4a9aca51143",
                                                "sense_id": "169f8d76-fd76-3f6c-96ef-89d02dcbfd24",
                                                "text": "L’ameublement était sommaire : un bureau, un fauteuil de cuir, des classeurs métalliques, deux petites tables dont l’une supportait une presse à copier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "802a01d8-d670-314c-a537-69e3d38ab1da",
                                        "entry_id": "399b2f86-05b2-3244-82b6-5ee8ec435319",
                                        "glosses": [
                                            "Reliure ou portefeuille à compartiments destinés à accueillir des feuilles de papier amovibles perforées."
                                        ],
                                        "tags": [
                                            "France",
                                            "Suisse"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "726f52f5-1fb6-4c78-be4b-c42694629bdb",
                                                "sense_id": "802a01d8-d670-314c-a537-69e3d38ab1da",
                                                "text": "Depuis une dizaine d’années, à mesure que je les reçois par la poste, j’ai pour habitude de compiler les lettres de refus des maisons d’édition dans un élégant classeur couleur banane."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fee2c353-f9b4-3c20-8aed-4c04098419f0",
                                        "entry_id": "399b2f86-05b2-3244-82b6-5ee8ec435319",
                                        "glosses": [
                                            "Objet ressemblant à un album, dont les pages sont munies de petites bandes collées à leur partie inférieure, destiné au rangement des timbres."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e8037d9a-b2ec-3e2d-8b9a-556a1b72a117",
                                        "entry_id": "399b2f86-05b2-3244-82b6-5ee8ec435319",
                                        "glosses": [
                                            "Fichier créé et manipulé par les tableurs, contenant une ou plusieurs feuilles de calcul et éventuellement des macros."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4b9938dd-9163-3f41-824d-a667c50b47e6",
                                        "entry_id": "399b2f86-05b2-3244-82b6-5ee8ec435319",
                                        "glosses": [
                                            "Celui qui classe."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a2c2eb7-5d1a-4a29-9f9a-b515221ec4ec",
                                                "sense_id": "4b9938dd-9163-3f41-824d-a667c50b47e6",
                                                "text": "En somme, la course aux classements engendre une course aux armements où les classés tentent de manipuler les éléments qui les favorisent alors que les classeurs modifient à leur tour leurs méthodes pour s’adapter aux manipulation."
                                            }
                                        ]
                                    }
                                ]
                            }
