                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "influenza",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a21cafc4-9434-3c70-8d98-b1253d40de76",
                                        "entry_id": "ff5ae873-3495-35ac-a978-9ec2571878e6",
                                        "glosses": [
                                            "An acute contagious disease of the upper airways and lungs, caused by a virus, which rapidly spreads around the world in seasonal epidemics."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dea988fd-e7f1-4c00-9c3a-ddc0366859bb",
                                                "sense_id": "a21cafc4-9434-3c70-8d98-b1253d40de76",
                                                "text": "In early 1919 the Board also issued a film, Dr Wise on Influenza, in which a character called 'Brown' spreads the disease by enacting poor behaviours.\nThis did address transport - by boarding a crowded omnibus, \"Brown may be scattering germs throughout the carriage and giving influenza to a number of people\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "648f0c79-7dd9-4ee6-b060-eff0d6588bbc",
                        "source_entry_id": "a06929d8-5635-363d-8faa-17d96face517",
                        "source_sense_id": "8cf39634-ec46-3b84-8e67-26a0f00a6485",
                        "target_lang_word": "Influenza",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Influenza",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fa034740-a1b7-33e0-aae3-8836fd14a020",
                                        "entry_id": "ed4891ac-df4d-3b12-8649-b9801cd92e2f",
                                        "glosses": [
                                            "eine akute, fieberhafte Virusinfektion, vorwiegend mit Entzündung der Atemwege, welche endemisch, epidemisch oder pandemisch auftritt und durch das Influenzavirus verursacht wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c05fc1a-038f-4d3f-b4d2-842e23923450",
                                                "sense_id": "fa034740-a1b7-33e0-aae3-8836fd14a020",
                                                "text": "Jetzt naht wieder die Zeit, in der die Influenza eine Gefahr gerade für ältere Mitbürger darstellt."
                                            },
                                            {
                                                "example_id": "122cd675-38b7-41b9-8e79-091e89a58d80",
                                                "sense_id": "fa034740-a1b7-33e0-aae3-8836fd14a020",
                                                "text": "Weil ungewöhnlich viele Menschen an Influenza erkrankt sind, hat Gouverneur Cuomo im Bundesstaat New York einen Gesundheitsnotstand ausgerufen."
                                            },
                                            {
                                                "example_id": "23e0e457-f50c-4aa9-8209-ad23b1f3f86a",
                                                "sense_id": "fa034740-a1b7-33e0-aae3-8836fd14a020",
                                                "text": "Zehntausende Menschen erkranken jedes Jahr in Deutschland an der Influenza. Im letzten Jahr sind mehr als 600 Menschen an der Grippe gestorben. Ärzte raten zur Impfung […]"
                                            },
                                            {
                                                "example_id": "2b1026f6-8c32-43e0-b76e-140c675fe083",
                                                "sense_id": "fa034740-a1b7-33e0-aae3-8836fd14a020",
                                                "text": "In der EU ist die saisonale Influenza noch immer die übertragbare Krankheit mit der höchsten Morbidität und Mortalität. In Europa haben bis zu 50 Millionen Menschen jährlich Schätzungen zufolge mit Grippesymptomen zu kämpfen, zwischen 15.000 und 70.000 sterben daran."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89d4ad70-028e-41ad-a4a2-ced9ececae5f",
                        "source_entry_id": "a06929d8-5635-363d-8faa-17d96face517",
                        "source_sense_id": "8cf39634-ec46-3b84-8e67-26a0f00a6485",
                        "target_lang_word": "influenza",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "influenza",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "5113196f-4d23-3b98-a211-25611ba2a875",
                                        "entry_id": "e4dc6a5c-42fd-3749-bb69-73b86da985ee",
                                        "glosses": [
                                            "capacità di produrre un effetto, agendo direttamente o a distanza, su qualcuno o qualcosa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a94f774-aa7c-45cb-9880-ad079b56cc0c",
                                                "sense_id": "5113196f-4d23-3b98-a211-25611ba2a875",
                                                "text": "l'influenza della Luna sulle maree, l'influenza dei fattori atmosferici sul clima"
                                            },
                                            {
                                                "example_id": "ff75f69b-7d56-44a7-807c-9d0e8828caea",
                                                "sense_id": "5113196f-4d23-3b98-a211-25611ba2a875",
                                                "text": "le decisioni politiche hanno un'influenza diretta sulla vita dei cittadini"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96e6ca1d-e7e7-3cbc-871e-ba83fe65a4fd",
                                        "entry_id": "e4dc6a5c-42fd-3749-bb69-73b86da985ee",
                                        "glosses": [
                                            "capacità di influenzare, ovvero dirigere o condizionare, il comportamento altrui, sia attraverso il proprio carisma o il proprio esempio (positivo o negativo che sia), sia attraverso la persuasione, sia attraverso l'intimidazione"
                                        ],
                                        "tags": [
                                            "di persone"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0da472d4-60c2-4e2b-8e70-50ee83a00051",
                                                "sense_id": "96e6ca1d-e7e7-3cbc-871e-ba83fe65a4fd",
                                                "text": "quell'uomo ha una buona/cattiva/pessima influenza su di te"
                                            },
                                            {
                                                "example_id": "914a08d7-3159-4adb-b090-304c587d3758",
                                                "sense_id": "96e6ca1d-e7e7-3cbc-871e-ba83fe65a4fd",
                                                "text": "esercitare un'influenza su qualcuno"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4857a268-c59c-3831-8a6b-b979e05e46d2",
                                        "entry_id": "e4dc6a5c-42fd-3749-bb69-73b86da985ee",
                                        "glosses": [
                                            "malattia virale fortemente contagiosa che provoca infezione anche acuta delle vie respiratorie, con caratteristici sintomi che includono febbre, dolori muscolari e articolari, brividi, tosse e muco; la sua severità può variare molto a seconda del ceppo virale che ne è la causa e delle condizioni generali dell'ammalato"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ccf93c5-3b6d-4980-9296-fad67c765cff",
                                                "sense_id": "4857a268-c59c-3831-8a6b-b979e05e46d2",
                                                "text": "il virus dell'influenza varia nei sintomi per molte persone"
                                            }
                                        ]
                                    }
                                ]
