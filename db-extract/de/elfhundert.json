        "de-extract.jsonl": [
            {
                "entry_id": "8f61a9c3-c04a-3957-89f5-0c57a884bdb5",
                "word": "elfhundert",
                "pos": "num",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "978d02f5-8808-3b5a-9b2e-7d1456743fd9",
                        "entry_id": "8f61a9c3-c04a-3957-89f5-0c57a884bdb5",
                        "glosses": [
                            "die Kardinalzahl, die sich aus Addition von tausend und hundert ergibt; elf mal hundert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a00ba2c2-7092-4ab5-a228-10545f87aaaa",
                                "sense_id": "978d02f5-8808-3b5a-9b2e-7d1456743fd9",
                                "text": "„Denn Ermengarde verkaufte am 6. September des gleichen Jahres ihre gräflichen Rechte an den Grafen Raimund Berengar I. von Barcelona für den Preis von elfhundert Goldunzen.“"
                            },
                            {
                                "example_id": "332df6bf-be9f-4287-a713-ec6b7bf1fc28",
                                "sense_id": "978d02f5-8808-3b5a-9b2e-7d1456743fd9",
                                "text": "„Wenn übrigens Ripalta, der Verfasser der Chronik von Piacenza, berichtet, daß elfhundert seiner Landsleute und unter ihnen er selbst als Sklaven verkauft worden seien, so ist dies nicht, wie Sismondi gethan hat, wörtlich zu nehmen[…]“"
                            },
                            {
                                "example_id": "d2439782-50f6-435d-bf4c-8b27740397dd",
                                "sense_id": "978d02f5-8808-3b5a-9b2e-7d1456743fd9",
                                "text": "„Wir können's zu dem Preis nicht mehr herstellen. Wenn wir es jetzt wieder machen, kostet es mindestens elfhundert.“"
                            },
                            {
                                "example_id": "106f1c9c-009b-4945-bbc8-2fa37faffc60",
                                "sense_id": "978d02f5-8808-3b5a-9b2e-7d1456743fd9",
                                "text": "„Während der Ausgrabung wurden mindestens elfhundert Gräber festgestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
