                        "glosses": [
                            "откалываясь или расщепляясь, оседать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12ea04fb-0631-40a1-bd14-8516bb8d2d73",
                                "sense_id": "2fd0ec9f-2181-3b22-86b3-534fa05c8ffe",
                                "text": "Уже при наружной работе стены глубокой канавы беспрестанно отседали, и земля огромными глыбами обваливалась."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e3fa1f7-ccac-30ee-aa94-f8562ba40357",
                        "entry_id": "dfeb296b-a8f5-364d-a0bf-ba05ee26b7df",
                        "glosses": [
                            "охотн. уходить от погони, обманув, запутав собак (о преследуемом животном)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d99cfba1-fd4e-4c31-bf5d-a33f9f8d3aa1",
                                "sense_id": "0e3fa1f7-ccac-30ee-aa94-f8562ba40357",
                                "text": "Зверь отседает — и в смертной тоске / Плачет помещик, припавший к луке."
                            }
                        ]
                    }
