                        ],
                        "form": "die Fluktuationen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e6321a2d-b96e-330a-8643-5beb18a57fb4",
                        "entry_id": "7525caeb-e99b-36d3-93c8-5b612cbc4b3f",
                        "glosses": [
                            "unregelmäßige, zufällige Veränderung, Schwankung; zum Beispiel die Fluktuation um einen Mittelwert oder zwischen zwei Extremen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40396310-50e5-4bd1-98db-dec951a7898b",
                                "sense_id": "e6321a2d-b96e-330a-8643-5beb18a57fb4",
                                "text": "Der Börsenkurs unterlag im letzten Monat starken Fluktuationen."
                            },
                            {
                                "example_id": "01e6bdfb-dd8d-4a14-a6a0-76e612a7c200",
                                "sense_id": "e6321a2d-b96e-330a-8643-5beb18a57fb4",
                                "text": "„In den Zellen herrschte jetzt zwar eine höhere Fluktuation, doch die Zahl der Gefängnisinsassen war immer noch gefährlich hoch.“"
                            },
                            {
                                "example_id": "8af8924e-4e5d-4c77-b9da-f81e3196628c",
                                "sense_id": "e6321a2d-b96e-330a-8643-5beb18a57fb4",
                                "text": "„In Nürnberg war die Oligarchie ebenso schmal und ebenso abgeschlossen wie in Augsburg, anders als etwa in der Hansestadt Lübeck, wo die Fluktuation der Eliten verhinderte, dass sich eine geburtsständische Exklusivität der politischen Macht herausbildete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2d5c1c0e-0022-4205-8d7a-17acbf12869e",
                        "source_entry_id": "7525caeb-e99b-36d3-93c8-5b612cbc4b3f",
                        "source_sense_id": "e6321a2d-b96e-330a-8643-5beb18a57fb4",
                        "source_sense_description": "unregelmäßige, zufällige Veränderung, Schwankung",
                        "target_lang_word": "fluctuation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fluctuation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "42c38886-bab4-35eb-9148-83820653c6bf",
                                        "entry_id": "3aa27e85-9d2a-313c-8a8f-7322a0ebf8e6",
                                        "glosses": [
                                            "A motion like that of waves; a moving in this and that direction; an irregular rising and falling."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c55ce3bd-e679-46ac-b275-34324846b300",
                                                "sense_id": "42c38886-bab4-35eb-9148-83820653c6bf",
                                                "text": "the fluctuations of the sea"
                                            },
                                            {
                                                "example_id": "52bc70e0-11ab-4545-bd7b-daabca3ddbd7",
                                                "sense_id": "42c38886-bab4-35eb-9148-83820653c6bf",
                                                "text": "The scientific instruments of the day recorded rapid fluctuations in the Earth's magnetic field, as powerful electrical currents flowed through the upper atmosphere."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6418cab-bfa0-39a4-a0d3-50f1f23e6002",
                                        "entry_id": "3aa27e85-9d2a-313c-8a8f-7322a0ebf8e6",
                                        "glosses": [
                                            "A wavering; unsteadiness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d408783e-ca64-4beb-a909-34ac480f3c59",
                                                "sense_id": "f6418cab-bfa0-39a4-a0d3-50f1f23e6002",
                                                "text": "fluctuations of opinion"
                                            },
                                            {
                                                "example_id": "7b8986d6-1f98-41e7-968c-7cad3f9e560f",
                                                "sense_id": "f6418cab-bfa0-39a4-a0d3-50f1f23e6002",
                                                "text": "fluctuations of prices"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9db2c4f1-e87a-3131-aa5e-4ade921debd8",
                                        "entry_id": "3aa27e85-9d2a-313c-8a8f-7322a0ebf8e6",
                                        "glosses": [
                                            "In medicine, a wave-like motion or undulation of a fluid in a natural or abnormal cavity (e.g. pus in an abscess), which is felt during palpation or percussion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e43bbaa3-43ff-4e9b-9cf7-a5a77e894560",
                        "source_entry_id": "7525caeb-e99b-36d3-93c8-5b612cbc4b3f",
                        "source_sense_id": "e6321a2d-b96e-330a-8643-5beb18a57fb4",
                        "source_sense_description": "unregelmäßige, zufällige Veränderung, Schwankung",
                        "target_lang_word": "fluctuation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fluctuation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "869a9904-8f27-3176-b515-8c801d4bdb02",
                                        "entry_id": "88b601ee-00f9-3055-9b40-a0d2c6640921",
                                        "glosses": [
                                            "Variation, défaut de fixité, de permanence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5235e090-2c0c-41ac-a5e2-c9a90e671bfa",
                                                "sense_id": "869a9904-8f27-3176-b515-8c801d4bdb02",
                                                "text": "Cinq années après le départ de Jacques pour le Sud oranais, les fluctuations de la vie militaire l’avaient ramené à Batna."
                                            },
                                            {
                                                "example_id": "d15da3f7-3b69-49d4-9255-1fb7d8f3550e",
                                                "sense_id": "869a9904-8f27-3176-b515-8c801d4bdb02",
                                                "text": "Une fois l’intermittence des signaux quantifiée, il est possible de séparer l’influence de cette disparition sur la fluctuation de fréquence."
                                            },
                                            {
                                                "example_id": "06d9afdd-90cc-417a-96dd-e5bc126de689",
                                                "sense_id": "869a9904-8f27-3176-b515-8c801d4bdb02",
                                                "text": "Le lac Chilwa, au sud-est du lac Malawi, est un autre exemple de lac endoréique présentant des fluctuations importantes de superficie."
                                            },
                                            {
                                                "example_id": "732421c2-b84f-424f-8481-18aea5e3b117",
                                                "sense_id": "869a9904-8f27-3176-b515-8c801d4bdb02",
                                                "text": "La problématique de prise de décision, déjà rencontrée, est travaillée à nouveau avec l’intervalle de fluctuation asymptotique."
                                            },
                                            {
                                                "example_id": "ea4aa99a-76ba-48b6-9235-5e45c4a60416",
                                                "sense_id": "869a9904-8f27-3176-b515-8c801d4bdb02",
                                                "text": "Afin d’anticiper les conséquences des fluctuations économiques sur les clauses financières dans leurs marchés publics, le Premier ministre rappelle l’obligation pour tous les acheteurs d’insérer des clauses de révision de prix lorsque les prestations sur lesquelles ils portent sont exposées à des aléas majeurs du fait de l’évolution raisonnablement prévisible des conditions économiques pendant la période d’exécution des contrats."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "188eb110-5ccb-3a7b-9e28-379512b4ad1d",
                                        "entry_id": "88b601ee-00f9-3055-9b40-a0d2c6640921",
                                        "glosses": [
                                            "Mouvement ondulatoire que l’on communique à un liquide contenu dans une cavité en percutant la paroi avec une main tandis que l’autre perçoit ce mouvement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae13abde-2c81-4fd1-96fc-dda4c15a032b",
                                                "sense_id": "188eb110-5ccb-3a7b-9e28-379512b4ad1d",
                                                "text": "En touchant cette tumeur, on sent qu’il y a fluctuation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
