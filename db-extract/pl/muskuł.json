                                        "sense_id": "72d14abc-6cc4-3fbf-ae12-27d9507e9035",
                                        "entry_id": "8ccc615d-0f7c-365a-8a5b-20fecf501632",
                                        "glosses": [
                                            "Organ, welches durch die Abfolge von Kontraktion und Erschlaffen innere und äußere Strukturen des Organismus bewegen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c78c03ab-6d63-4848-bafd-32a687612ddd",
                                                "sense_id": "72d14abc-6cc4-3fbf-ae12-27d9507e9035",
                                                "text": "Er präsentierte stolz seine Muskeln."
                                            },
                                            {
                                                "example_id": "afff1b18-02b3-4d83-b624-158289810c6d",
                                                "sense_id": "72d14abc-6cc4-3fbf-ae12-27d9507e9035",
                                                "text": "„Er sah zum Dschungel hinauf, und die Muskeln in seinem Gesicht zuckten.“"
                                            },
                                            {
                                                "example_id": "1092ff4b-0150-4f71-8a16-a8459e6d268b",
                                                "sense_id": "72d14abc-6cc4-3fbf-ae12-27d9507e9035",
                                                "text": "„Der Freikletterer bewegt sich in steiler Wand: Er verzichtet auch bei höchsten Schwierigkeitsgraden auf technische Hilfsmittel und setzt sich mit seiner reinen Körperlichkeit, der Kraft und Geschmeidigkeit seiner Muskeln, der Haltefähigkeit seiner Finger und Zehen, dem natürlichen Fels, seinen glatten Wänden, gefurchten Rillen, sperrigen Überhängen aus.“"
                                            },
                                            {
                                                "example_id": "cd77bfc0-7c31-4333-9f5b-107656dfa54b",
                                                "sense_id": "72d14abc-6cc4-3fbf-ae12-27d9507e9035",
                                                "text": "„Die Muskeln auf der Vorderseite sahen gut aus; aber auf der Unterseite waren sie verbraucht und sehnig, und seine Ellbogen stachen spitz aus dem Fleisch.“"
                                            },
                                            {
                                                "example_id": "4d2d30f3-7e88-4705-93e7-16912514e740",
                                                "sense_id": "72d14abc-6cc4-3fbf-ae12-27d9507e9035",
                                                "text": "„Aber weder die Hand noch ein Muskel im Gesicht des Grafen zuckte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
