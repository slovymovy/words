                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5eb9cc06-c413-4a8d-a967-5d8bf0429b78",
                                                "sense_id": "61bd576a-6d98-3c3a-a046-6cc63054ad96",
                                                "text": "Near-synonyms: sifter, strainer, temse"
                                            },
