                    },
                    {
                        "translation_id": "110ae195-ed41-42fa-9113-0440ebafc57f",
                        "source_entry_id": "e1d0c602-5370-37ef-b089-8d2084dfd7d9",
                        "source_sense_id": "4c42162f-102b-3e0c-b0b7-aaee1c2de608",
                        "target_lang_word": "Führerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Führerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a9496e93-8d3f-3b91-84e2-383d69cfb4d4",
                                        "entry_id": "01c59ce4-012a-3ce0-bac3-8e82ef79d39a",
                                        "glosses": [
                                            "leitende Person in einer Organisation, Vereinigung oder Bewegung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dad4345-e618-469d-89c5-57cb9e1f6d77",
                                                "sense_id": "a9496e93-8d3f-3b91-84e2-383d69cfb4d4",
                                                "text": "„Dies nun darf die Führerin mit dem ewigen Kurtisanenlächeln, weil sie drei Jahre in der Volksarmee diente, einer Freiwilligenarmee von etwa 1,2 Millionen Soldaten, der viertgrößten der Welt.“"
                                            },
                                            {
                                                "example_id": "f4ff1319-f35c-4e4d-8fa7-30ce64752365",
                                                "sense_id": "a9496e93-8d3f-3b91-84e2-383d69cfb4d4",
                                                "text": "„Wie wär's, wenn mich irgend jemand zur Abwechslung mal mit meinem richtigen Namen anreden würde? Nachdem ich im »Obst und Gemüse« Claudius und Nick getroffen hatte, geriet ich vor dem Tacheles in eine floridaesk anmutende Touristengruppe, die sich von einer Führerin das Graffiti »Wo ist Käpt'n Nemo? auf der Brandmauer erklären ließ - als sei es die Inschrift auf Schinkels Altem Museum.“"
                                            },
                                            {
                                                "example_id": "aaba913c-815e-46c0-a6d7-7a3cbfe7a412",
                                                "sense_id": "a9496e93-8d3f-3b91-84e2-383d69cfb4d4",
                                                "text": "„Die Führerin seines Haushaltes wusste das zu verhindern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e441a43d-2223-38a1-a0e5-0955f048ecaa",
                                        "entry_id": "01c59ce4-012a-3ce0-bac3-8e82ef79d39a",
                                        "glosses": [
                                            "Person, die Touristen Sehenswürdigkeiten zeigt und erklärt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3ba2854-07af-4923-85ca-69b9c2e5cc3a",
                                                "sense_id": "e441a43d-2223-38a1-a0e5-0955f048ecaa",
                                                "text": "„Diese Gebärde des Zornes widersprach derartig der sonst so unerschütterlichen Ruhe der Prinzessin, und der Schrecken, der sich in der Miene des Fürsten Wassilij ausdrückte, passte so wenig zu seiner sonstigen würdevoll gemessenen Haltung, dass Pierre stehen blieb und seine Führerin über die Brille hinweg fragend ansah.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c360f03d-a644-33d7-bbb4-0c8e0b2a6e44",
                                        "entry_id": "01c59ce4-012a-3ce0-bac3-8e82ef79d39a",
                                        "glosses": [
                                            "die Kurzform von Fahrzeugführerin, der Fahrerin eines Fahrzeuges"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e92885c-484d-4de1-bd61-3aba1bfcaf84",
                        "source_entry_id": "e1d0c602-5370-37ef-b089-8d2084dfd7d9",
                        "source_sense_id": "4c42162f-102b-3e0c-b0b7-aaee1c2de608",
                        "target_lang_word": "Reiseführerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reiseführerin",
