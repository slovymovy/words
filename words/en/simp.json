                            {
                                "target_lang_word": "подпевала",
                                "target_lang_sense_clarification": "льстивый сторонник"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e6206f1-5707-3a48-b3de-ded8e58b6e26",
                    "sense_definition": "a simple person lacking common sense; a fool or simpleton",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "foolish person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I cannot believe what a <w>simp</w> I am for leaving my keys at home again.",
                            "target_lang_translations": {
                                "ru": "Не верится, какой же я <w>простак</w>, что снова забыл ключи дома."
                            }
