                                    },
                                    {
                                        "sense_id": "0f16cea5-0751-3cc0-837b-31a91ab7bae8",
                                        "entry_id": "4333b011-f21b-3bee-a512-4213887856fe",
                                        "glosses": [
                                            "The process of making enriched uranium."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "309ddfc8-c6c7-47ef-8764-298f3d14cae3",
                                                "sense_id": "0f16cea5-0751-3cc0-837b-31a91ab7bae8",
                                                "text": "That stockpile of 60% Uranium, if enriched to 90%, which is a relatively easy step, is enough for about nine bombs, according to experts. Just before the war started, Iran announced that it had built another new secret facility for enrichment that was due to come on stream soon."
                                            },
                                            {
                                                "example_id": "774481bb-baeb-4570-a961-f30ebffb7f87",
                                                "sense_id": "0f16cea5-0751-3cc0-837b-31a91ab7bae8",
                                                "text": "In an interview with CBS broadcast Sunday, Iran’s ambassador to the United Nations, Amir-Saeid Iravani, said that his country’s uranium enrichment will “never stop” because Iran has an “inalienable right” to do so for “peaceful nuclear activity.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69945faf-d7ce-3338-94f2-0264fe6e0e8b",
                                        "entry_id": "4333b011-f21b-3bee-a512-4213887856fe",
                                        "glosses": [
                                            "The addition of sugar to grape juice used to make wine; chaptalization."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "98e44e96-1905-3474-960a-e2d0c71683fc",
                                        "entry_id": "4333b011-f21b-3bee-a512-4213887856fe",
                                        "glosses": [
                                            "Extracurricular activities for students."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "794b4979-66be-32e2-ae87-96c8a434c369",
                                        "entry_id": "4333b011-f21b-3bee-a512-4213887856fe",
                                        "glosses": [
                                            "Stimulation provided for the mental wellbeing of a captive animal."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1582318-4601-4b07-bbd2-dffba16e954e",
                                                "sense_id": "794b4979-66be-32e2-ae87-96c8a434c369",
                                                "text": "The practice of enrichment to address these problems started in zoos and later spread to more intensively managed captive settings, such as farming and animal laboratories."
                                            }
                                        ]
