                "senses": [
                    {
                        "sense_id": "470a96f9-4b5a-37a0-83b4-067503c43cb9",
                        "entry_id": "efe7929b-4a1c-3711-bcfb-14f68ab1cb44",
                        "glosses": [
                            "Person, die für etwas Unerwünschtes verantwortlich gemacht wird"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "07fc7320-d0ad-4cdb-987a-3e203cbd5990",
                                "sense_id": "470a96f9-4b5a-37a0-83b4-067503c43cb9",
                                "text": "Jetzt bin ich wieder der Buhmann, weil keiner in der Lage ist oder in der Lage sein will die Verantwortung zu übernehmen."
                            },
                            {
                                "example_id": "42f3ed07-f334-464d-9d74-2c97d46a09fa",
                                "sense_id": "470a96f9-4b5a-37a0-83b4-067503c43cb9",
                                "text": "Der Buhmann am Baupfusch ist der Bürgermeister."
                            },
                            {
                                "example_id": "b794f76f-d567-4cf3-b327-e3da2d8827a9",
                                "sense_id": "470a96f9-4b5a-37a0-83b4-067503c43cb9",
                                "text": "„Er ist auch ihr Buhmann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6dbbcfde-f9a7-4e49-8e1f-b64ea2acad5b",
                        "source_entry_id": "efe7929b-4a1c-3711-bcfb-14f68ab1cb44",
                        "source_sense_id": "470a96f9-4b5a-37a0-83b4-067503c43cb9",
                        "source_sense_description": "umgangssprachlich: Person, die für etwas Unerwünschtes verantwortlich gemacht wird",
                        "target_lang_word": "scapegoat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scapegoat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d107fe5-b646-385e-a8bc-a534049386e6",
                                        "entry_id": "dc9742c5-0e99-3bed-8fb2-ace071539b77",
                                        "glosses": [
                                            "In the Mosaic Day of Atonement ritual, a goat symbolically imbued with the sins of the people, and sent out alive into the wilderness while another was sacrificed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31c9338c-ca24-4733-9aba-9947fb82367a",
                                                "sense_id": "1d107fe5-b646-385e-a8bc-a534049386e6",
                                                "text": "And Aarõ caſt lottes ouer the .ij. gootes: one lotte for the Lorde, ãd another for a ſcapegoote."
                                            },
                                            {
                                                "example_id": "65fd9b12-4580-4306-bb0c-fdd715b70182",
                                                "sense_id": "1d107fe5-b646-385e-a8bc-a534049386e6",
                                                "text": "[…]; alluding herein unto the heart of man, and the precious bloud of our Saviour; who was typified indeed by the Goat that was ſlain, and the ſcape Goat in the wilderneſſe;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40fb60e8-3bbc-3c0d-ac5e-3bc7639ba69c",
                                        "entry_id": "dc9742c5-0e99-3bed-8fb2-ace071539b77",
                                        "glosses": [
                                            "Someone unfairly blamed or punished for some failure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bfbf842-b869-45cb-80c1-cf859b0b1681",
                                                "sense_id": "40fb60e8-3bbc-3c0d-ac5e-3bc7639ba69c",
                                                "text": "He is making me a scapegoat for his own poor business decisions and the supply chain disruptions caused by the hurricane!"
                                            },
                                            {
                                                "example_id": "9c83b14e-3694-4e0f-8ec0-f6a820c96ffa",
                                                "sense_id": "40fb60e8-3bbc-3c0d-ac5e-3bc7639ba69c",
                                                "text": "The new Secretary of State had been long sick of the perfidy and levity of the First Lord of the Treasury, and began to fear that he might be made a scapegoat to save the old intriguer who, imbecile as he seemed, never wanted dexterity where danger was to be avoided."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scapegoat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8cade3b8-626f-39c8-8b74-fc93954d66e2",
                                        "entry_id": "dc34ac52-9a9f-32df-b79a-9a2ab47d9db8",
                                        "glosses": [
                                            "To unfairly blame or punish someone for some failure; to make a scapegoat of."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03919210-d9ec-4913-b809-0e972c962472",
                                                "sense_id": "8cade3b8-626f-39c8-8b74-fc93954d66e2",
                                                "text": "The question we should be asking is: who benefits when migrants and refugees are scapegoated for anger about housing?"
                                            },
                                            {
                                                "example_id": "2a7e4dfc-ff02-435a-a832-03b5ee1dea00",
                                                "sense_id": "8cade3b8-626f-39c8-8b74-fc93954d66e2",
                                                "text": "People tend to fear and then to scapegoat ... groups which seem to them to be fundamentally different from their own."
                                            },
                                            {
                                                "example_id": "4726e2c4-d53c-49a5-adcc-2f99f459ef53",
                                                "sense_id": "8cade3b8-626f-39c8-8b74-fc93954d66e2",
                                                "text": "They had been used for centuries to justify or rationalize the behavior of that status and conversely to scapegoat and blame some other category of people."
                                            },
                                            {
                                                "example_id": "dfc37a08-c1b8-415c-8bd4-3a3fb745e1be",
                                                "sense_id": "8cade3b8-626f-39c8-8b74-fc93954d66e2",
                                                "text": "And I want to add, as we make these changes, we work together to improve this system, that our intention is not scapegoating and finger-pointing."
                                            },
                                            {
                                                "example_id": "543faf3d-e39b-4942-9f7c-d0cdcc525e09",
                                                "sense_id": "8cade3b8-626f-39c8-8b74-fc93954d66e2",
                                                "text": "Then either the world or others or the self becomes the target for the human tendency to scapegoat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68c2ee1a-4e9d-4441-8358-21e2f208ce02",
                        "source_entry_id": "efe7929b-4a1c-3711-bcfb-14f68ab1cb44",
                        "source_sense_id": "470a96f9-4b5a-37a0-83b4-067503c43cb9",
                        "source_sense_description": "umgangssprachlich: Person, die für etwas Unerwünschtes verantwortlich gemacht wird",
                        "target_lang_word": "fall guy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fall guy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "627b1514-4e67-36a6-983d-921d8a3e317d",
                                        "entry_id": "56548c2f-bf9a-3150-83fe-fd832f9ba92d",
                                        "glosses": [
                                            "One who is gullible and easily duped."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal",
                                            "sometimes"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eeed8f38-5770-3878-aeda-a84e4fbc2cc5",
                                        "entry_id": "56548c2f-bf9a-3150-83fe-fd832f9ba92d",
                                        "glosses": [
                                            "A scapegoat."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e8673c7-894f-470e-aacc-b2700896cce3",
                                                "sense_id": "eeed8f38-5770-3878-aeda-a84e4fbc2cc5",
                                                "text": "Clemons's supporters have over the years given a different rendition of events. In the racially heated atmosphere of St Louis in the early 1990s, they say, Clemons was made the fall guy. Of the four men who were charged with the murders, the three black men were all put on death row while the one white man is now free on parole."
                                            },
                                            {
                                                "example_id": "67ccdfd6-f172-41cd-852f-c8a3233df7d2",
                                                "sense_id": "eeed8f38-5770-3878-aeda-a84e4fbc2cc5",
                                                "text": "Marples, who later fled to Monaco to escape prosecution for fraud, was the driving force behind The Reshaping of British Railways report published on March 27 1963. Dr Richard Beeching [who wrote the report] was just his fall guy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b528aa8-aebe-444a-9aee-2caef39481d1",
                        "source_entry_id": "efe7929b-4a1c-3711-bcfb-14f68ab1cb44",
                        "source_sense_id": "470a96f9-4b5a-37a0-83b4-067503c43cb9",
                        "source_sense_description": "umgangssprachlich: Person, die für etwas Unerwünschtes verantwortlich gemacht wird",
                        "target_lang_word": "bouc émissaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bouc émissaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0b7f407c-20e1-3f03-927e-132f3d7a740c",
                                        "entry_id": "8e60b96c-a7e7-3cac-8296-936bceba0d4a",
                                        "glosses": [
                                            "Bouc que l’on chassait dans le désert, après l’avoir chargé des malédictions que l’on voulait détourner du peuple."
                                        ],
                                        "tags": [
                                            "Biblical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08c96f97-2f9f-46be-91fc-b9eba021e4d2",
                                                "sense_id": "0b7f407c-20e1-3f03-927e-132f3d7a740c",
                                                "text": "Dans les plus profondes strates de mythologisation, là où l’inconscient est projeté, on trouve de nombreux thèmes qui expriment le principe des opposés. On repère déjà une couche très ancienne de mythologisation dans le rituel archaïque du bouc émissaire, lequel sert à projeter l’inconscient sur des situations réelles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "686149a8-260c-3657-a250-afcef7b739ee",
                                        "entry_id": "8e60b96c-a7e7-3cac-8296-936bceba0d4a",
                                        "glosses": [
                                            "Personne sur laquelle on fait retomber les torts des autres, victime expiatoire."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33597a74-2300-4317-96a4-9e8c8318c485",
                                                "sense_id": "686149a8-260c-3657-a250-afcef7b739ee",
                                                "text": "La personne responsable de la frustration est la cible de l’agression, mais en l’absence de cet agent frustrant, l’agression est déplacée vers d’autres personnes (plus communément appelées boucs émissaires)."
                                            },
                                            {
                                                "example_id": "7ce772d5-bdca-440d-82ad-2dcf75c0bf0e",
                                                "sense_id": "686149a8-260c-3657-a250-afcef7b739ee",
                                                "text": "Le chef commet un massacre, un vol ou une injustice, à la suite de quoi, pour ne pas être inquiété, il invente un bouc émissaire et le livre à la vindicte populaire…"
                                            },
                                            {
                                                "example_id": "27d462c8-0382-4d0c-a9ae-dab39a15a410",
                                                "sense_id": "686149a8-260c-3657-a250-afcef7b739ee",
                                                "text": "Dans le moments de déchaînement collectif d’agressivité sur un bouc émissaire, montré du doigt ou exhibé sur l’estrade, le pasteur contribue activement à exacerber la haine de l’autre maléfique : en vociférant dans le micro, en s’agitant en long et en large, en mouillant sa chemise et en transpirant à grosses gouttes."
                                            },
                                            {
                                                "example_id": "041379de-4fd2-4ea9-b020-8e7a208fc3f0",
                                                "sense_id": "686149a8-260c-3657-a250-afcef7b739ee",
                                                "text": "Les messages de haine et les théories du complot qui ciblent des communautés et en font des boucs émissaires sont de plus en plus répandus sur les plateformes en ligne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d3735b7-f148-4de6-8090-f7aa23c744b8",
                        "source_entry_id": "efe7929b-4a1c-3711-bcfb-14f68ab1cb44",
                        "source_sense_id": "470a96f9-4b5a-37a0-83b4-067503c43cb9",
                        "source_sense_description": "umgangssprachlich: Person, die für etwas Unerwünschtes verantwortlich gemacht wird",
                        "target_lang_word": "козёл отпущения",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "козёл отпущения",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b7aff21b-f370-35a6-bdc3-16def1488a58",
                                        "entry_id": "fe2c3c39-1c19-3535-9ed3-a9a7b16e6c09",
                                        "glosses": [
                                            "разг. тот или то, кто или что обвиняется в чужих ошибках, прегрешениях, провалах"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d351d06e-e88a-4006-9603-16e728fb3c24",
                                                "sense_id": "b7aff21b-f370-35a6-bdc3-16def1488a58",
                                                "text": "В Петербурге козлом отпущения намечен ректор, — несчастная жертва — и жертва долга, потому что он добросовестно взялся за дело, на которое призвали его, но не рассчитал ни сил своих, ни условий среды, в которой пришлось действовать!"
                                            },
                                            {
                                                "example_id": "d745ce66-d77e-4f1d-87e3-7178813c2ada",
                                                "sense_id": "b7aff21b-f370-35a6-bdc3-16def1488a58",
                                                "text": "Любому деспоту, насаждающему культ своей личности, нужен козёл отпущения. Если в 1928–1932 годах таким козлом отпущения были кулаки и «буржуазная интеллигенция», то в середине 30-х годов — бывшие члены различных оппозиций."
                                            },
                                            {
                                                "example_id": "99328190-3042-48d1-ae37-7b1a639c4c3d",
                                                "sense_id": "b7aff21b-f370-35a6-bdc3-16def1488a58",
                                                "text": "Бюрократия у нас — вечный козёл отпущения, на неё списываются все неудачи."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
