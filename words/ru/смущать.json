{
    "word_family": [
        "смущение",
        "смущённый",
        "смущённо",
        "смутить",
        "смутиться",
        "смущаться",
        "смута",
        "смутьян"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "90d5f758-2ff0-3523-99e6-856dff60b902",
                    "sense_definition": "Вызывать у кого-либо чувство неловкости, стыда или робости",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "awkwardness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его неожиданные комплименты всегда очень сильно <w>смущали</w> молодую девушку.",
                            "target_lang_translations": {
                                "de": "Seine unerwarteten Komplimente <w>brachten</w> das junge Mädchen immer sehr <w>in Verlegenheit</w>."
                            }
                        },
                        {
                            "text": "Пожалуйста, не нужно меня <w>смущать</w> такими личными вопросами при всех.",
                            "target_lang_translations": {
                                "de": "Bitte hör auf, mich vor allen mit solchen persönlichen Fragen <w>in Verlegenheit zu bringen</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "раскрепощать",
                        "расковывать",
                        "ободрять"
                    ],
                    "common_phrases": [
                        "смущать девушку",
                        "смущать вопросами"
                    ],
                    "target_lang_definitions": {
                        "de": "Bei jemandem ein Gefühl von Verlegenheit, Scham oder Befangenheit hervorrufen"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "in Verlegenheit bringen",
                                "target_lang_sense_clarification": "jemanden beschämen oder schüchtern machen"
                            },
                            {
                                "target_lang_word": "verlegen machen",
                                "target_lang_sense_clarification": "jemanden befangen machen"
                            },
                            {
                                "target_lang_word": "beschämen",
                                "target_lang_sense_clarification": "ein Gefühl von Scham hervorrufen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b18c2cb3-7626-355d-b7ba-58c9f055e2fa",
                    "sense_definition": "Казаться подозрительным, странным или настораживающим; вызывать сомнения",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "doubt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этом выгодном предложении о работе меня очень <w>смущает</w> отсутствие трудового договора.",
                            "target_lang_translations": {
                                "de": "Bei diesem lukrativen Jobangebot <w>macht</w> mich das Fehlen eines Arbeitsvertrags sehr <w>stutzig</w>."
                            }
                        },
                        {
                            "text": "Никого из жильцов дома почему-то не <w>смущал</w> постоянный подозрительный шум по ночам.",
                            "target_lang_translations": {
                                "de": "Aus irgendeinem Grund <w>störte</w> der ständige verdächtige Lärm in der Nacht keinen der Hausbewohner."
                            }
                        }
                    ],
                    "antonyms": [
                        "устраивать"
                    ],
                    "common_phrases": [
                        "никого не смущает",
                        "меня смущает"
                    ],
                    "target_lang_definitions": {
                        "de": "Verdächtig oder seltsam vorkommen; Zweifel oder Skepsis erregen"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "stutzig machen",
                                "target_lang_sense_clarification": "misstrauisch oder skeptisch stimmen"
                            },
                            {
                                "target_lang_word": "stören",
                                "target_lang_sense_clarification": "Bedenken hervorrufen, missfallen"
                            },
                            {
                                "target_lang_word": "Bedenken hervorrufen",
                                "target_lang_sense_clarification": "zweifeln lassen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed4458fa-f3da-3018-98d1-05c9a72fc3d2",
                    "sense_definition": "Приводить в замешательство, вызывать растерянность или недоумение",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "confusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Студент любил <w>смущать</w> преподавателя каверзными вопросами на каждой лекции.",
                            "target_lang_translations": {
                                "de": "Der Student liebte es, den Dozenten in jeder Vorlesung mit kniffligen Fragen <w>aus der Fassung zu bringen</w>."
                            }
                        },
                        {
                            "text": "Неожиданное изменение правил экзамена заметно <w>смущало</w> всех присутствующих в аудитории.",
                            "target_lang_translations": {
                                "de": "Die unerwartete Änderung der Prüfungsregeln <w>verwirrte</w> alle Anwesenden im Hörsaal spürbar."
                            }
                        }
                    ],
                    "common_phrases": [
                        "смущать каверзными вопросами"
                    ],
                    "target_lang_definitions": {
                        "de": "In Verwirrung oder Ratlosigkeit stürzen; aus der Fassung bringen"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verwirren",
                                "target_lang_sense_clarification": "durcheinanderbringen, unsicher machen"
                            },
                            {
                                "target_lang_word": "aus der Fassung bringen",
                                "target_lang_sense_clarification": "die Selbstsicherheit nehmen"
                            },
                            {
                                "target_lang_word": "irritieren",
                                "target_lang_sense_clarification": "verunsichern"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "808a2814-f354-3e2c-a84c-4d02e4c655a9",
                    "sense_definition": "Нарушать чьё-либо душевное спокойствие, вызывать тревогу или опасения",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anxiety",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мрачные слухи о возможном сокращении штата продолжали <w>смущать</w> сотрудников отдела.",
                            "target_lang_translations": {
                                "de": "Düstere Gerüchte über einen möglichen Personalabbau <w>beunruhigten</w> die Mitarbeiter der Abteilung weiterhin."
                            }
                        },
                        {
                            "text": "Внезапность принятого решения очень долго <w>смущала</w> его сердце и не давала уснуть.",
                            "target_lang_translations": {
                                "de": "Die Plötzlichkeit der getroffenen Entscheidung <w>verstörte</w> sein Herz noch lange und ließ ihn nicht schlafen."
                            }
                        }
                    ],
                    "antonyms": [
                        "успокаивать",
                        "утешать",
                        "умиротворять"
                    ],
                    "common_phrases": [
                        "смущать покой",
                        "смущать сердце"
                    ],
                    "target_lang_definitions": {
                        "de": "Den Seelenfrieden stören; Unruhe, Sorge oder Ängste hervorrufen"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "beunruhigen",
                                "target_lang_sense_clarification": "die innere Ruhe stören"
                            },
                            {
                                "target_lang_word": "verstören",
                                "target_lang_sense_clarification": "seelisch durcheinanderbringen"
                            },
                            {
                                "target_lang_word": "bekümmern",
                                "target_lang_sense_clarification": "Sorgen bereiten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b737efc-87a1-37d2-89a0-88f0b2bf2854",
                    "sense_definition": "Подстрекать к неповиновению, сеять раздоры, вызывать мятеж или волнения",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rebellion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Оратор ходил по людным улицам и открыто <w>смущал</w> народ своими опасными речами.",
                            "target_lang_translations": {
                                "de": "Der Redner zog durch belebte Straßen und <w>wiegelte</w> das Volk mit seinen gefährlichen Reden offen <w>auf</w>."
                            }
                        },
                        {
                            "text": "Этот дерзкий мыслитель своими публикациями продолжал упорно <w>смущать</w> умы столичной молодёжи.",
                            "target_lang_translations": {
                                "de": "Dieser kühne Denker fuhr beharrlich fort, mit seinen Veröffentlichungen die Gemüter der hauptstädtischen Jugend <w>zu verwirren</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "мутить",
                        "возмущать",
                        "баламутить",
                        "подстрекать",
                        "провоцировать"
                    ],
                    "antonyms": [
                        "умиротворять",
                        "успокаивать"
                    ],
                    "common_phrases": [
                        "смущать народ",
                        "смущать умы"
                    ],
                    "target_lang_definitions": {
                        "de": "Zu Ungehorsam oder Aufruhr anstacheln; Zwietracht säen oder Unruhe stiften"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "aufwiegeln",
                                "target_lang_sense_clarification": "zu Aufruhr anstiften"
                            },
                            {
                                "target_lang_word": "verführen",
                                "target_lang_sense_clarification": "die Geister verwirren oder aufhetzen"
                            },
                            {
                                "target_lang_word": "aufhetzen",
                                "target_lang_sense_clarification": "Unruhe und Streit schüren"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}