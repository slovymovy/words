                    {
                        "translation_id": "97f5c263-89f5-4346-a343-6c29a791f66c",
                        "source_entry_id": "d4a31400-6b9c-39ce-a6fd-9dcbc0b31bf5",
                        "source_sense_id": "e745957c-3ce1-3a4a-b271-23a8c7e5411c",
                        "target_lang_word": "peevishly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peevishly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30c729ec-a4a1-345b-9070-b617c2626b9a",
                                        "entry_id": "ffb83999-111a-3562-bd50-27e75b96dfc7",
                                        "glosses": [
                                            "In a peevish manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c679419-3e83-47a7-82c0-660ca9460d2c",
                                                "sense_id": "30c729ec-a4a1-345b-9070-b617c2626b9a",
                                                "text": "\"See / Or shut your eyes,\" said Nature peevishly, / \"It nothing skills: I cannot help my case: / 'Tis the Last Judgment's fire must cure this place, / Calcine its clods and set my prisoners free.\""
                                            },
                                            {
                                                "example_id": "3d0d26d2-ce23-4fe7-9635-899aa2a41500",
                                                "sense_id": "30c729ec-a4a1-345b-9070-b617c2626b9a",
                                                "text": "His uncles peevishly claimed the paper."
                                            },
                                            {
                                                "example_id": "e2b2e83b-33c2-41ae-b7e3-17d381b50ab9",
                                                "sense_id": "30c729ec-a4a1-345b-9070-b617c2626b9a",
                                                "text": "Seated in a kitchen chair, and rasping at his scorched shoulders, he said peevishly, \"By ginger, it gives a man the willies, left alone in a place like this all day.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "529b40cd-48c8-42a1-8b0f-ac21a35c513e",
                        "source_entry_id": "d4a31400-6b9c-39ce-a6fd-9dcbc0b31bf5",
                        "source_sense_id": "e745957c-3ce1-3a4a-b271-23a8c7e5411c",
                        "target_lang_word": "querulously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "querulously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86cdf716-b147-350b-9798-3aaf1ebe67b4",
                                        "entry_id": "77e95037-5052-3208-802a-8f2e5654991a",
                                        "glosses": [
                                            "With grumbling, complaining, or whining."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "884314e0-7939-44db-bbc0-30b843851870",
                                                "sense_id": "86cdf716-b147-350b-9798-3aaf1ebe67b4",
                                                "text": "It was his last demonstration for that time; as, after shedding some more tears and querulously complaining that he couldn't breathe, he slowly fell into a slumber."
                                            },
                                            {
                                                "example_id": "8e605732-d4b0-41de-b450-830d5fc3a359",
                                                "sense_id": "86cdf716-b147-350b-9798-3aaf1ebe67b4",
                                                "text": "\"There are no crimes and no criminals in these days,\" he said, querulously. \"What is the use of having brains in our profession. I know well that I have it in me to make my name famous.[…]\""
                                            },
                                            {
                                                "example_id": "8c471a1e-4801-43d1-9b2b-92ed1816cf39",
                                                "sense_id": "86cdf716-b147-350b-9798-3aaf1ebe67b4",
                                                "text": "\"I wish to 'eaven I 'adn't these silly sandals on,\" he cried querulously to the universe. \"They give the whole blessed show away.\""
                                            },
                                            {
                                                "example_id": "8aa6a57b-8342-4b20-9209-082301a0fed3",
                                                "sense_id": "86cdf716-b147-350b-9798-3aaf1ebe67b4",
                                                "text": "\"If we're heroes,\" Dane asked a little querulously, \"what are we doing locked up here?\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
