                "senses": [
                    {
                        "sense_id": "6aa13f64-838b-3f53-a359-d1f1b3f519e8",
                        "entry_id": "d2de16a1-7fb1-3c3e-a094-d4e3f9c3954d",
                        "glosses": [
                            "jemand, der ein Auto kauft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da59f0d2-3f90-425a-91c0-1a34f9185584",
                                "sense_id": "6aa13f64-838b-3f53-a359-d1f1b3f519e8",
                                "text": "Autokäufer wollen immer mehr Informationen zu den angebotenen Modellen."
                            },
                            {
                                "example_id": "2aa5d442-9ee4-4d1c-949b-709eeae60291",
                                "sense_id": "6aa13f64-838b-3f53-a359-d1f1b3f519e8",
                                "text": "„Das Amtsgericht Ansbach entnahm den Ausführungen eines Sachverständigen, dass der Schaden auf der Überschreitung der vorgeschriebenen Wartungsintervalle beruhe, und wies die Klage des Autokäufers ab.“"
                            },
                            {
                                "example_id": "66d5c7a3-e04a-4ba9-af43-0f559ed98c9a",
                                "sense_id": "6aa13f64-838b-3f53-a359-d1f1b3f519e8",
                                "text": "„Mir fiel die Geschichte ein, die er mir erzählt hatte von dem Autokäufer am Kreuzweg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
