        "ru-extract.jsonl": [
            {
                "entry_id": "ed558635-6102-3aed-ac50-fe6a93b480e9",
                "word": "ничё",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "38f665ec-4dc0-351c-9d59-9d414dcce28d",
                        "entry_id": "ed558635-6102-3aed-ac50-fe6a93b480e9",
                        "glosses": [
                            "разг. то же, что ничего"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95006ba4-c6ff-4cee-a3b7-8116a2fb575c",
                                "sense_id": "38f665ec-4dc0-351c-9d59-9d414dcce28d",
                                "text": "― А чё вода? Вода — она ничё. — Вот дура!"
                            },
                            {
                                "example_id": "daa74f89-638e-41a9-8296-eea5b098af0e",
                                "sense_id": "38f665ec-4dc0-351c-9d59-9d414dcce28d",
                                "text": "— Я помню бабку, — сказал я. — Ничё… хорошая была баба. Заговоры знала."
                            },
                            {
                                "example_id": "d7e389b6-7dd8-4db1-996f-52b418d9ce48",
                                "sense_id": "38f665ec-4dc0-351c-9d59-9d414dcce28d",
                                "text": "В классе отодвинул стул к окну и на удивленный вопрос: «Хорё-ок, ты чё?» — ответил однозначно: «А ничё — через плечо не горячо?»"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "ffd52004-75b6-3cb0-b7ac-7be579a399cd",
                "word": "ничё",
                "pos": "pron",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8d11557e-682b-3f2e-9920-eeed3fdd37ce",
                        "entry_id": "ffd52004-75b6-3cb0-b7ac-7be579a399cd",
                        "glosses": [
                            "рег. (сиб.), теперь разг. то же, что ничего"
                        ],
                        "tags": [
                            "первонач.",
                            "преимущ."
                        ],
                        "examples": [
                            {
                                "example_id": "b43d7813-d06d-46e5-b04c-4415bf493257",
                                "sense_id": "8d11557e-682b-3f2e-9920-eeed3fdd37ce",
                                "text": "И даже не спросила, чем заболел. Не спросила ничё и об Иванушке…"
                            },
                            {
                                "example_id": "c6a024ba-aa23-41b1-99c1-594469ec0660",
                                "sense_id": "8d11557e-682b-3f2e-9920-eeed3fdd37ce",
                                "text": "― Ничего. — Шей, я тебе ничё не говорю. ❬…❭ — Да никто ничё и не говорит, я не знаю, чё ты на меня взбеленилась. ❬…❭ — Прямо ничё и сказать нельзя."
                            },
                            {
                                "example_id": "07b5eec6-8d59-4b7e-be5f-9f5a54e6b0a0",
                                "sense_id": "8d11557e-682b-3f2e-9920-eeed3fdd37ce",
                                "text": "Сам возьмёшь, ничё с тобой не сделается."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f7b3a9e7-85f0-4fca-91d7-bde6ef922554",
                        "source_entry_id": "ffd52004-75b6-3cb0-b7ac-7be579a399cd",
                        "source_sense_id": "8d11557e-682b-3f2e-9920-eeed3fdd37ce",
                        "target_lang_word": "nothing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nothing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0dd19e14-ba4a-3cb6-99be-cc7932f73cad",
                                        "entry_id": "fe9bbaa8-6d9e-3d1e-b7ec-1739e63e7981",
                                        "glosses": [
                                            "Not at all; in no way."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5241cf1d-5b05-4f83-a9d2-4ae6f0c5acbb",
                                                "sense_id": "0dd19e14-ba4a-3cb6-99be-cc7932f73cad",
                                                "text": "Nothing too much out of the ordinary."
                                            },
                                            {
                                                "example_id": "7bc240dd-dc3e-49b4-9caa-8585408dfbc8",
                                                "sense_id": "0dd19e14-ba4a-3cb6-99be-cc7932f73cad",
                                                "text": "The answer was an impatient one—but, nothing daunted, he continued."
                                            },
                                            {
                                                "example_id": "53b8f05c-3ea6-4393-abc6-b7a7a827aa03",
                                                "sense_id": "0dd19e14-ba4a-3cb6-99be-cc7932f73cad",
                                                "text": "The Motion from London to Syria is as much as nothing; and nothing altereth the relation which is between them."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nothing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b78151c0-5ac3-3543-a433-12253df8d833",
                                        "entry_id": "4cc32fa4-c155-367f-8a25-6c79899b33c2",
                                        "glosses": [
                                            "Not any thing; no thing."
                                        ],
                                        "tags": [
                                            "indefinite",
                                            "pronoun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b54afed-de49-4aec-b9d8-f76eba2fb138",
                                                "sense_id": "b78151c0-5ac3-3543-a433-12253df8d833",
                                                "text": "Don't just say nothing. Tell me what's going on."
                                            },
                                            {
                                                "example_id": "d0fa8e8b-66db-47a7-b60e-0a9ebc1a04d2",
                                                "sense_id": "b78151c0-5ac3-3543-a433-12253df8d833",
                                                "text": "Nothing bad will happen, will it?"
                                            },
                                            {
                                                "example_id": "de04ff96-67fc-4469-8794-92744d625362",
                                                "sense_id": "b78151c0-5ac3-3543-a433-12253df8d833",
                                                "text": "There remains nothing more to be done."
                                            },
                                            {
                                                "example_id": "3bdfc966-f2eb-4634-a65e-9061a3e623b0",
                                                "sense_id": "b78151c0-5ac3-3543-a433-12253df8d833",
                                                "text": "the players see little or nothing of their cards at first starting"
                                            },
                                            {
                                                "example_id": "d704cba5-92dc-4964-b05c-bd0da49a0969",
                                                "sense_id": "b78151c0-5ac3-3543-a433-12253df8d833",
                                                "text": "A ceremony at which two persons undertake to become one, one undertakes to become nothing, and nothing undertakes to become supportable."
                                            },
                                            {
                                                "example_id": "9fe4de0b-9701-4587-ae17-85286e08634e",
                                                "sense_id": "b78151c0-5ac3-3543-a433-12253df8d833",
                                                "text": "Nothing was too small to receive attention, if a supervising eye could suggest improvements likely to conduce to the common welfare. Mr. Gordon Burnage, for instance, personally visited dust-bins and back premises, accompanied by a sort of village bailiff, going his round like a commanding officer doing billets."
                                            },
                                            {
                                                "example_id": "dfc2c709-d334-4d7a-b076-4d163acd0a8c",
                                                "sense_id": "b78151c0-5ac3-3543-a433-12253df8d833",
                                                "text": "Imagine a country where children do nothing but play until they start compulsory schooling at age seven. Then, without exception, they attend comprehensives until the age of 16. Charging school fees is illegal, and so is sorting pupils into ability groups by streaming or setting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66551e4f-53f2-38a0-9167-e2896e342777",
                                        "entry_id": "4cc32fa4-c155-367f-8a25-6c79899b33c2",
                                        "glosses": [
                                            "An absence of anything, including empty space, brightness, darkness, matter, or a vacuum."
                                        ],
                                        "tags": [
                                            "indefinite",
                                            "pronoun"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "nothing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0658fde9-0038-310e-b620-efc05d9bfb01",
                                        "entry_id": "b9199029-efca-3c82-9464-e3519de44d08",
                                        "glosses": [
                                            "Something trifling, or of no consequence or importance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f878aab4-5312-48bb-b132-7c3d6b7f8238",
                                                "sense_id": "0658fde9-0038-310e-b620-efc05d9bfb01",
                                                "text": "- What happened to your face?\n- It's nothing."
                                            },
                                            {
                                                "example_id": "ca14a0bc-cb89-42e6-94e8-1e69584c5acb",
                                                "sense_id": "0658fde9-0038-310e-b620-efc05d9bfb01",
                                                "text": "Sermons are not like curious inquiries after new nothings, but pursuances of old truths."
                                            },
                                            {
                                                "example_id": "6eec0bd3-e66c-4d60-a57c-4218c961aaed",
                                                "sense_id": "0658fde9-0038-310e-b620-efc05d9bfb01",
                                                "text": "Knuckles: The Egg Carrier is nothing compared to this!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68240e37-72e6-3bfd-9409-5f58932227e5",
                                        "entry_id": "b9199029-efca-3c82-9464-e3519de44d08",
                                        "glosses": [
                                            "A trivial remark especially in the term sweet nothings."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fcf0b2be-66c2-328b-9dde-848c685861fe",
                                        "entry_id": "b9199029-efca-3c82-9464-e3519de44d08",
                                        "glosses": [
                                            "A nobody (insignificant person)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "nothing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df89f4fe-88a8-3616-97bf-fcef3586022e",
                                        "entry_id": "87e1cc48-1623-3d2b-81ea-bf1b09a19229",
                                        "glosses": [
                                            "Completely unimportant."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49ebe9d6-fbf5-4388-84fb-0c008571f4b7",
                                                "sense_id": "df89f4fe-88a8-3616-97bf-fcef3586022e",
                                                "text": "Dallas scored on what had seemed until then like a nothing play."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06a48717-81aa-35c7-8703-fec0334562f5",
                                        "entry_id": "87e1cc48-1623-3d2b-81ea-bf1b09a19229",
                                        "glosses": [
                                            "Lacking effort or commitment."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c96cd78-d6a9-4574-a91e-28e315fd0bbc",
                                                "sense_id": "06a48717-81aa-35c7-8703-fec0334562f5",
                                                "text": "The cricketer played a nothing shot."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nothing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d733a4d-66ed-3a9a-84d7-df2d2aeeb623",
                                        "entry_id": "1b8cb4f2-87a1-3df8-918b-a042d7a92217",
                                        "glosses": [
                                            "Never mind; it's not important; forget what I said."
                                        ],
