{
    "word_family": [
        "clickable",
        "clicker",
        "clicking",
        "clicky",
        "double-click",
        "right-click",
        "left-click"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c97aa9ec-8df4-3d1c-8dd0-e354ca8f1c44",
                    "sense_definition": "To press and release a button on a computer mouse or similar device.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To open the file, you need to <w>click</w> on the icon twice.",
                            "target_lang_translations": {
                                "ru": "Чтобы открыть файл, вам нужно дважды <w>щёлкнуть</w> по иконке."
                            }
                        },
                        {
                            "text": "Please <w>click</w> the button to submit your application.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>нажмите</w> на кнопку, чтобы отправить заявку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "click the button",
                        "click on the link",
                        "double click"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нажать и отпустить кнопку на компьютерной мыши или аналогичном устройстве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щёлкать",
                                "target_lang_sense_clarification": "нажимать на кнопку мыши"
                            },
                            {
                                "target_lang_word": "кликнуть",
                                "target_lang_sense_clarification": "совершить нажатие (комп. жарг.)"
                            },
                            {
                                "target_lang_word": "нажать",
                                "target_lang_sense_clarification": "на кнопку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac5d91d6-6cab-36dd-b7ae-092329b389d8",
                    "sense_definition": "To make a short, sharp sound.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heater started to <w>click</w> as it warmed up.",
                            "target_lang_translations": {
                                "ru": "Обогреватель начал <w>щёлкать</w>, когда нагрелся."
                            }
                        },
                        {
                            "text": "I heard the cameras <w>clicking</w> all around the red carpet.",
                            "target_lang_translations": {
                                "ru": "Я слышал, как вокруг красной дорожки <w>щёлкают</w> затворы камер."
                            }
                        }
                    ],
                    "common_phrases": [
                        "click into place"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать короткий резкий звук."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щёлкать",
                                "target_lang_sense_clarification": "издавать резкий звук"
                            },
                            {
                                "target_lang_word": "пощёлкивать",
                                "target_lang_sense_clarification": "издавать повторяющиеся звуки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c10df15a-9ea7-3f4c-a832-beb5376a159d",
                    "sense_definition": "To become friends or get along well with someone immediately.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We met at a party and we just <w>clicked</w> right away.",
                            "target_lang_translations": {
                                "ru": "Мы познакомились на вечеринке и сразу <w>сошлись</w>."
                            }
                        },
                        {
                            "text": "It is rare to <w>click</w> with a new colleague so quickly.",
                            "target_lang_translations": {
                                "ru": "Редко удается так быстро <w>поладить</w> с новым коллегой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "just clicked"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in informal social contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сразу подружиться или найти общий язык с кем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сойтись",
                                "target_lang_sense_clarification": "найти общий язык"
                            },
                            {
                                "target_lang_word": "поладить",
                                "target_lang_sense_clarification": "сразу найти контакт"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6a578ac-9c9c-3794-a6eb-480b87f8369f",
                    "sense_definition": "To suddenly understand something or for something to make sense.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "understanding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was confused for an hour, but then it suddenly <w>clicked</w>.",
                            "target_lang_translations": {
                                "ru": "Я был в замешательстве целый час, но потом до меня внезапно <w>дошло</w>."
                            }
                        },
                        {
                            "text": "Everything <w>clicked</w> once he explained the final step of the process.",
                            "target_lang_translations": {
                                "ru": "Всё <w>прояснилось</w>, как только он объяснил последний этап процесса."
                            }
                        }
                    ],
                    "common_phrases": [
                        "suddenly clicked"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal way to describe a sudden realization"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапно понять что-то или осознать смысл происходящего."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дойти",
                                "target_lang_sense_clarification": "внезапно стать понятным"
                            },
                            {
                                "target_lang_word": "осенить",
                                "target_lang_sense_clarification": "о внезапной догадке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f22e6b3-3422-340b-9e21-35f71d62422c",
                    "sense_definition": "To move or operate something so that it makes a clicking sound.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>clicked</w> the pen repeatedly while she was thinking.",
                            "target_lang_translations": {
                                "ru": "Она постоянно <w>щёлкала</w> ручкой, пока думала."
                            }
                        },
                        {
                            "text": "He <w>clicked</w> his tongue to show his disapproval.",
                            "target_lang_translations": {
                                "ru": "Он <w>цокнул</w> языком, чтобы выразить свое неодобрение."
                            }
                        }
                    ],
                    "common_phrases": [
                        "click your tongue",
                        "click the latch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводить что-либо в действие так, чтобы раздался щелчок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щёлкать",
                                "target_lang_sense_clarification": "чем-либо, создавая звук"
                            },
                            {
                                "target_lang_word": "щёлкнуть",
                                "target_lang_sense_clarification": "однократно издать звук"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "42cb7e31-6b62-3a8a-ba35-103de795f570",
                    "sense_definition": "The act of pressing a button on a computer mouse.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With a single <w>click</w>, you can delete the entire folder.",
                            "target_lang_translations": {
                                "ru": "Одним <w>щелчком</w> вы можете удалить всю папку."
                            }
                        },
                        {
                            "text": "The software requires a right <w>click</w> to see the menu.",
                            "target_lang_translations": {
                                "ru": "Программа требует <w>нажатия</w> правой кнопкой мыши для вызова меню."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mouse click",
                        "single click",
                        "right click"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по нажатию кнопки на компьютерной мыши."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щелчок",
                                "target_lang_sense_clarification": "нажатие кнопки мыши"
                            },
                            {
                                "target_lang_word": "клик",
                                "target_lang_sense_clarification": "компьютерный термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99404e60-7e8c-34a4-ade9-8fc8f7607e06",
                    "sense_definition": "A short, sharp, slight sound.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lock gave a loud <w>click</w> and the door opened.",
                            "target_lang_translations": {
                                "ru": "Замок издал громкий <w>щелчок</w>, и дверь открылась."
                            }
                        },
                        {
                            "text": "I heard a faint <w>click</w> when the light switch was flipped.",
                            "target_lang_translations": {
                                "ru": "Я услышал слабый <w>щелчок</w>, когда щелкнули выключателем."
                            }
                        }
                    ],
                    "common_phrases": [
                        "audible click",
                        "faint click"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткий, резкий, едва слышный звук."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щелчок",
                                "target_lang_sense_clarification": "резкий звук"
                            },
                            {
                                "target_lang_word": "щёлканье",
                                "target_lang_sense_clarification": "процесс издания звуков"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68ba252c-041c-3b78-9551-e89f8bf32491",
                    "sense_definition": "An instance of a user visiting a website or clicking an online advertisement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The marketing team is tracking the number of <w>clicks</w> on the new ad.",
                            "target_lang_translations": {
                                "ru": "Отдел маркетинга отслеживает количество <w>кликов</w> по новому объявлению."
                            }
                        },
                        {
                            "text": "Advertisers usually pay for each <w>click</w> their website receives.",
                            "target_lang_translations": {
                                "ru": "Рекламодатели обычно платят за каждый <w>переход</w> на их сайт."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pay per click"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business and technology context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Переход пользователя на веб-сайт или нажатие на онлайн-рекламу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клик",
                                "target_lang_sense_clarification": "в интернет-маркетинге"
                            },
                            {
                                "target_lang_word": "переход",
                                "target_lang_sense_clarification": "по ссылке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b20b5fbb-df40-3d93-a1f2-0ddbd502f99c",
                    "sense_definition": "A kilometer; a unit of distance.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The enemy camp is about five <w>clicks</w> north of here.",
                            "target_lang_translations": {
                                "ru": "Вражеский лагерь находится примерно в пяти <w>кликах</w> к северу отсюда."
                            }
                        },
                        {
                            "text": "We have to march another ten <w>clicks</w> before we can rest.",
                            "target_lang_translations": {
                                "ru": "Нам нужно пройти еще десять <w>километров</w>, прежде чем мы сможем отдохнуть."
                            }
                        }
                    ],
                    "common_phrases": [
                        "five clicks away"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "military slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Километр; единица измерения расстояния."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клик",
                                "target_lang_sense_clarification": "километр (военный сленг)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c919541-6bc5-3d7c-a0d0-3adc7e49bcc6",
                    "sense_definition": "A speech sound produced by sucking air into the mouth, found in some African languages.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Xhosa language is famous for its use of various <w>clicks</w>.",
                            "target_lang_translations": {
                                "ru": "Язык коса знаменит использованием различных <w>щёлкающих звуков</w>."
                            }
                        },
                        {
                            "text": "Linguists study how a <w>click</w> is produced in different dialects.",
                            "target_lang_translations": {
                                "ru": "Лингвисты изучают, как произносится <w>щёлкающий звук</w> в разных диалектах."
                            }
                        }
                    ],
                    "synonyms": [
                        "click consonant"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "linguistic terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Звук речи, производимый всасыванием воздуха, характерный для некоторых африканских языков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щёлкающий звук",
                                "target_lang_sense_clarification": "в лингвистике"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "a4df5d78-b377-323d-87c8-22e31c48ba4b",
                    "sense_definition": "Used to represent the sound of a click.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "onomatopoeia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Click</w>! The door was finally locked.",
                            "target_lang_translations": {
                                "ru": "<w>Щёлк</w>! Дверь была наконец заперта."
                            }
                        },
                        {
                            "text": "The light went out—<w>click</w>—and we were in total darkness.",
                            "target_lang_translations": {
                                "ru": "Свет погас — <w>щёлк</w> — и мы оказались в полной темноте."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для имитации звука щелчка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щёлк",
                                "target_lang_sense_clarification": "звукоподражание"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "ac153342-2e33-3ee6-b574-f0245ca4ef2d",
                    "sense_definition": "A family name.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Click</w> was the founder of the local hardware store.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Клик</w> был основателем местного хозяйственного магазина."
                            }
                        },
                        {
                            "text": "The <w>Click</w> family has lived in this county for generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Клик</w> жила в этом округе на протяжении нескольких поколений."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": []
                    }
                },
                {
                    "sense_id": "3df061ab-4328-3650-8646-41966beb2e0a",
                    "sense_definition": "A ghost town located in Llano County, Texas.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "places",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The town of <w>Click</w> was named after an early settler.",
                            "target_lang_translations": {
                                "ru": "Город <w>Клик</w> был назван в честь одного из первых поселенцев."
                            }
                        },
                        {
                            "text": "Tourists sometimes visit the remains of <w>Click</w> in Texas.",
                            "target_lang_translations": {
                                "ru": "Туристы иногда посещают руины города <w>Клик</w> в Техасе."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "specific to Texas, USA"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Город-призрак в округе Ллано, штат Техас."
                    },
                    "translations": {
                        "ru": []
                    }
                }
            ]
        }
    ]
}