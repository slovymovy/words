                "senses": [
                    {
                        "sense_id": "df71b43b-2e53-3559-90a2-e679006a5fa5",
                        "entry_id": "d79fa0c0-adee-324c-bcbb-fb91c3eb4834",
                        "glosses": [
                            "Celui qui tousse."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "83aa8a9a-bd2f-4649-9f22-ae0d0d7033fc",
                                "sense_id": "df71b43b-2e53-3559-90a2-e679006a5fa5",
                                "text": "Rien n’est aussi insupportable au théâtre que les tousseurs."
                            },
                            {
                                "example_id": "1a4b9f6f-9a16-4dfd-8f13-2eb6eeaa9395",
                                "sense_id": "df71b43b-2e53-3559-90a2-e679006a5fa5",
                                "text": "— Ferme la fenêtre ! crièrent dix élèves. On va crever. C’est dégueulasse… J’claque des dents…\nTandis que des tousseurs se déchaînaient."
                            },
                            {
                                "example_id": "be0f3aff-3966-493f-835d-26db82855032",
                                "sense_id": "df71b43b-2e53-3559-90a2-e679006a5fa5",
                                "text": "C'était une famille de tousseurs. Le père, Jacques, toussait, et tous les enfants, avec des intensités variables, toussaient. Ils toussaient tous au moindre rhume, au moindre coup de froid. Au mieux de leur forme, ils toussaient aussi : avant le café, après une promenade, devant une salade de carottes. Tous les douze, treize, quatorze enfants toussaient."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "363207c7-d0f4-4393-aad1-b81bb220e712",
                        "source_entry_id": "d79fa0c0-adee-324c-bcbb-fb91c3eb4834",
                        "source_sense_id": "df71b43b-2e53-3559-90a2-e679006a5fa5",
