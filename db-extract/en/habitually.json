                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3ae2d4cf-c65d-3927-aeb3-b04d24174322",
                        "entry_id": "223a385f-b922-3117-967e-efff71d3156a",
                        "glosses": [
                            "By habit; in a habitual manner."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "f3b906a7-7cdd-43ab-8201-fb8f6f9250dc",
                                "sense_id": "3ae2d4cf-c65d-3927-aeb3-b04d24174322",
                                "text": "He is habitually inattentive of time."
                            }
                        ]
                    },
                    {
                        "sense_id": "72b18936-d792-3bf1-ad6e-689a027d302b",
                        "entry_id": "223a385f-b922-3117-967e-efff71d3156a",
                        "glosses": [
                            "Occurring regularly or usually."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "713e70bb-c42f-4fd9-ba92-4ec1c2aad851",
                                "sense_id": "72b18936-d792-3bf1-ad6e-689a027d302b",
                                "text": "Professor Franklein is habitually pessimistic."
                            },
                            {
                                "example_id": "2b32c2fc-8e30-43e3-b2af-ff8ecae7bdb9",
                                "sense_id": "72b18936-d792-3bf1-ad6e-689a027d302b",
                                "text": "Such recognition is a much-needed boost for Scotland's habitually busiest station."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f29564ea-0329-4fb1-a7e6-c868aa755291",
                        "source_entry_id": "223a385f-b922-3117-967e-efff71d3156a",
                        "source_sense_description": "occurring regularly or usually",
                        "target_lang_word": "gewöhnlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gewöhnlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d90e5ab9-0a36-35e1-973f-6ba68f210cf6",
                                        "entry_id": "d64866d2-e272-357d-aea8-9062249b5f69",
                                        "glosses": [
                                            "so, wie unter diesen Umständen meist oder immer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73cc8492-2ee0-4285-b949-487c64a94afa",
                                                "sense_id": "d90e5ab9-0a36-35e1-973f-6ba68f210cf6",
                                                "text": "Sie antwortete wie gewöhnlich."
                                            },
                                            {
                                                "example_id": "4b933060-adcc-45a2-9f3f-100af430f620",
                                                "sense_id": "d90e5ab9-0a36-35e1-973f-6ba68f210cf6",
                                                "text": "Für gewöhnlich sind sie pünktlich."
                                            },
                                            {
                                                "example_id": "ff0e8436-8d02-4b12-b2a3-b4d4f45e846d",
                                                "sense_id": "d90e5ab9-0a36-35e1-973f-6ba68f210cf6",
                                                "text": "Das ist ein für eine Mutter ganz gewöhnliches Verhalten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4c1b6de5-e564-3994-bb36-33df2746ea3a",
                                        "entry_id": "d64866d2-e272-357d-aea8-9062249b5f69",
                                        "glosses": [
                                            "keine besonderen Merkmale aufweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d429e30e-a582-450e-8487-c0737079b56d",
                                                "sense_id": "4c1b6de5-e564-3994-bb36-33df2746ea3a",
                                                "text": "Wir alle sind gewöhnliche Sterbliche."
                                            },
                                            {
                                                "example_id": "1e2a1a3a-3c38-4563-a88d-a12abe3c3e0a",
                                                "sense_id": "4c1b6de5-e564-3994-bb36-33df2746ea3a",
                                                "text": "Wie kann aus einem ganz gewöhnlichen Menschen plötzlich ein Verbrecher werden?"
                                            },
                                            {
                                                "example_id": "ce71aafb-f960-437f-9e03-a8a53156196b",
                                                "sense_id": "4c1b6de5-e564-3994-bb36-33df2746ea3a",
                                                "text": "„Schließlich waren die Richter des Athener Gerichts, der Heliaia ebenso wie die Teilnehmer an der Volksversammlung keine Rechtsexperten, sondern gewöhnliche Bürger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "31287f72-57d0-3dfa-9237-a9cff7619999",
                                        "entry_id": "d64866d2-e272-357d-aea8-9062249b5f69",
                                        "glosses": [
                                            "von niederer Erziehung seiend"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c3e45ea-74df-413e-b214-62f71fff0413",
                                                "sense_id": "31287f72-57d0-3dfa-9237-a9cff7619999",
                                                "text": "Das Benehmen dieses Kerls ist mir zu gewöhnlich (= zu unfein, grob)."
                                            },
                                            {
                                                "example_id": "860e7544-33e3-442d-a3ed-bf581b6eb6f4",
                                                "sense_id": "31287f72-57d0-3dfa-9237-a9cff7619999",
                                                "text": "Er hat gar zu gewöhnliche Manieren."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a783370b-fbf5-46d1-858a-b8545e0287b7",
                        "source_entry_id": "223a385f-b922-3117-967e-efff71d3156a",
                        "source_sense_description": "occurring regularly or usually",
                        "target_lang_word": "gewohnheitsmäßig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gewohnheitsmäßig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "41f02719-63b7-37f3-87f1-3c81022a2377",
                                        "entry_id": "98b4269e-ab34-3f79-bbdd-715425bd90a3",
                                        "glosses": [
                                            "einer Gewohnheit folgend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9844a60-b06d-43a2-b078-c81b6347f841",
                                                "sense_id": "41f02719-63b7-37f3-87f1-3c81022a2377",
                                                "text": "„Sie lachte. Er lachte ebenfalls und guckte gewohnheitsmäßig nach der Armbanduhr. \"Ich bin unverbesserlich\", klagte sie und kramte in ihrer Handtasche, aus der sie - ohne Knick und Falt - - eine Handvoll - Manuskripte hervorholte und auf die Knie legte.“"
                                            },
                                            {
                                                "example_id": "9937103a-a1c6-41cf-8538-4536df86b089",
                                                "sense_id": "41f02719-63b7-37f3-87f1-3c81022a2377",
                                                "text": "„Wer am heutigen Abend dabei sein will, der darf sich aber nicht gewohnheitsmäßig in die U-Bahn zum Potsdamer Platz setzen, denn die Hauptstadtpremiere von \"Alles auf Zucker\" wird es im Filmtheater am Friedrichshain geben.“"
                                            },
                                            {
                                                "example_id": "cee4c206-3a71-47e1-adcf-4717c1e023b5",
                                                "sense_id": "41f02719-63b7-37f3-87f1-3c81022a2377",
                                                "text": "„Ihnen nämlich, verehrte GEZ-Unterworfene, genau diese gewohnheitsmäßigste aller Angewohnheiten abzugewöhnen: das tägliche, fast schon automatische Einschalten der ‚Tagesschau‘.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
