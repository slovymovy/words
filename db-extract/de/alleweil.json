                        "form": "allerweil"
                    },
                    {
                        "form_id": "15671b35-988f-47a5-b444-a52641d06b1d",
                        "entry_id": "40bc9141-0107-330b-80b5-770690a919b5",
                        "tags": [
                            "variant"
                        ],
                        "form": "allweil"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6d917368-1ec0-3ccf-861b-8da3db24884e",
                        "entry_id": "40bc9141-0107-330b-80b5-770690a919b5",
                        "glosses": [
                            "zu jeder Zeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4e82cb4-4255-40df-9f41-c2b085f5689d",
                                "sense_id": "6d917368-1ec0-3ccf-861b-8da3db24884e",
                                "text": "„Ganz nach altdeutsch-romantischer Tradition, ringt man alleweil um Worte und erzählt sich Märchen (Grimm), wenn nicht bloß unkend wer angeturnt wird (Jahn).“"
                            },
                            {
                                "example_id": "db0b40b1-4d1c-4ac3-8ad3-10652062f6e8",
                                "sense_id": "6d917368-1ec0-3ccf-861b-8da3db24884e",
                                "text": "„In der großen Koalition ist nicht mehr alleweil Sonntag.“"
                            },
                            {
                                "example_id": "028a9d56-78dd-4230-8fde-0adad458d060",
                                "sense_id": "6d917368-1ec0-3ccf-861b-8da3db24884e",
                                "text": "„Klingt banal, doch ist es alleweil besser als Rechenaufgaben wie ‚16 mal 324‘, wie sie vor fünfzehn Jahren noch in den polnischen Schulbüchern standen.“"
                            },
                            {
                                "example_id": "d5dad760-a083-4888-afb9-6806d7e1e9f2",
                                "sense_id": "6d917368-1ec0-3ccf-861b-8da3db24884e",
                                "text": "„Der Erstkläger verpachtete im Jahre 1972 die ihm damals noch allein gehörige und nun im Miteigentum beider Kläger stehende Liegenschaft […] dem Beklagten, seinem Bruder, ‚für alleweil‘, solange der Beklagte als Bauer arbeiten könne und wolle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a46f6bd-e019-4266-8be3-98e66de5ca46",
                        "source_entry_id": "40bc9141-0107-330b-80b5-770690a919b5",
                        "source_sense_id": "6d917368-1ec0-3ccf-861b-8da3db24884e",
                        "source_sense_description": "zu jeder Zeit",
                        "target_lang_word": "always",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "always",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f752e3a-821c-32af-a381-9f0273c18e2c",
                                        "entry_id": "66c4bd36-63f9-3380-9bc5-e7c0f83baf74",
                                        "glosses": [
                                            "At all times; throughout all time; since the beginning."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37b1048c-016a-4312-98cf-cef24fcb655e",
                                                "sense_id": "6f752e3a-821c-32af-a381-9f0273c18e2c",
                                                "text": "God is always the same."
                                            },
                                            {
                                                "example_id": "247dca47-5a2a-4392-a08a-d71d2058aae3",
                                                "sense_id": "6f752e3a-821c-32af-a381-9f0273c18e2c",
                                                "text": "Green has always been my favorite color. I’ve loved it for as long as I can remember."
                                            },
                                            {
                                                "example_id": "e604797a-8906-4603-81cd-d2c45f4e5fc0",
                                                "sense_id": "6f752e3a-821c-32af-a381-9f0273c18e2c",
                                                "text": "Airplanes did not always exist as a form of transportation."
                                            },
                                            {
                                                "example_id": "00e2fdfb-15a9-4f40-a240-a59b2f00ccb3",
                                                "sense_id": "6f752e3a-821c-32af-a381-9f0273c18e2c",
                                                "text": "Plant breeding is always a numbers game.[…]The wild species we use are rich in genetic variation, and individual plants are highly heterozygous and do not breed true. In addition, we are looking for rare alleles, so the more plants we try, the better."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2047b5c9-6a5d-3552-b2cc-0d2dde46997e",
                                        "entry_id": "66c4bd36-63f9-3380-9bc5-e7c0f83baf74",
                                        "glosses": [
                                            "Constantly during a certain period, or regularly at stated intervals (opposed to sometimes or occasionally)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ed5dc33-9b90-41fe-aa21-2b00eb8056d3",
                                                "sense_id": "2047b5c9-6a5d-3552-b2cc-0d2dde46997e",
                                                "text": "In this street, the shops always close during lunchtime."
                                            },
                                            {
                                                "example_id": "fd75fa21-b5bd-4837-a692-2954b04117df",
                                                "sense_id": "2047b5c9-6a5d-3552-b2cc-0d2dde46997e",
                                                "text": "His liveries are black,—his carriage is black,—he always rides a black galloway,—and, faith, if he ever marry again, I think he will show his respect to the sainted Maria by marrying a black woman."
                                            },
                                            {
                                                "example_id": "18121f5c-e758-4cd3-82e9-2f1ab0d5ef52",
                                                "sense_id": "2047b5c9-6a5d-3552-b2cc-0d2dde46997e",
                                                "text": "They burned the old gun that used to stand in the dark corner up in the garret, close to the stuffed fox that always grinned so fiercely. Perhaps the reason why he seemed in such a ghastly rage was that he did not come by his death fairly. And why else was he put away up there out of sight?—and so magnificent a brush as he had too."
                                            },
                                            {
                                                "example_id": "2550f152-88c4-4595-b96a-39b8d2b264f1",
                                                "sense_id": "2047b5c9-6a5d-3552-b2cc-0d2dde46997e",
                                                "text": "And so it had always pleased M. Stutz to expect great things from the dark young man whom he had first seen in his early twenties ; and his expectations has waxed rather than waned on hearing the faint bruit of the love of Ivor and Virginia—for Virginia, M. Stutz thought, would bring fineness to a point in a man like Ivor Marlay,[…]."
                                            },
                                            {
                                                "example_id": "d6715328-d62c-4a80-8b5e-f0e0f60260c0",
                                                "sense_id": "2047b5c9-6a5d-3552-b2cc-0d2dde46997e",
                                                "text": "The highway to the East Coast which ran through the borough of Ebbfield had always been a main road and even now, despite the vast garages, the pylons and the gaily painted factory glasshouses which had sprung up beside it, there still remained an occasional trace of past cultures."
                                            },
                                            {
                                                "example_id": "64f5eb36-5e62-40fd-a1c6-b960fe0db509",
                                                "sense_id": "2047b5c9-6a5d-3552-b2cc-0d2dde46997e",
                                                "text": "She used to always talk about how she wished she had time to write all day, but now she had the time, she never even went near the typewriter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2089baac-4590-30fe-a4da-368e0e94b16f",
                                        "entry_id": "66c4bd36-63f9-3380-9bc5-e7c0f83baf74",
                                        "glosses": [
                                            "if necessary, or if there is no better option; in any event."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c452717-8129-42ad-af27-1ddbb2bedff5",
                                                "sense_id": "2089baac-4590-30fe-a4da-368e0e94b16f",
                                                "text": "I thought I could always go back to work."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed58bd30-d1b8-4336-9ed7-f429f56f2624",
                        "source_entry_id": "40bc9141-0107-330b-80b5-770690a919b5",
                        "source_sense_id": "6d917368-1ec0-3ccf-861b-8da3db24884e",
                        "source_sense_description": "zu jeder Zeit",
                        "target_lang_word": "toujours",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "toujours",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d3c09118-ffab-3e87-8c18-fc7336b31f0b",
                                        "entry_id": "821f9829-0022-3315-9d08-9a488500c81c",
                                        "glosses": [
                                            "En tout temps, continuellement, sans cesse, sans relâche, sans fin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2bf2c89-e8df-4ef0-82e1-4c0d38964d24",
                                                "sense_id": "d3c09118-ffab-3e87-8c18-fc7336b31f0b",
                                                "text": "C’est une source qui coule toujours."
                                            },
                                            {
                                                "example_id": "5fce0191-b46a-4318-99ab-5986843a5076",
                                                "sense_id": "d3c09118-ffab-3e87-8c18-fc7336b31f0b",
                                                "text": "Les Québécois ont toujours entretenu un rapport équivoque avec leur langue. Toujours? Non! Au temps de la Nouvelle-France, la question de la « qualité de la langue » ne se posait pas …."
                                            },
                                            {
                                                "example_id": "ae4b40bb-0861-42c4-9c13-cbbe15998b22",
                                                "sense_id": "d3c09118-ffab-3e87-8c18-fc7336b31f0b",
                                                "text": "Nous n’étions encore que deux enfants\nDeux cœurs neufs à leur printemps\nÉclairant mon ciel comme un soleil\nIl fit naître des merveilles.\nSi les jours, depuis, ont dû passer\nJe n’ai pas oublié\nEt je sais que cet amour\nPeut durer toujours.\nBel amour\nTendre amour\nOui\nTu me suivras toujours\nSi les jours, depuis, ont dû passer\nJe n’ai pas oublié\nCar je sais que cet amour me suivra toujours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd05f5f8-5a80-3c3b-98b6-d6b73e074024",
                                        "entry_id": "821f9829-0022-3315-9d08-9a488500c81c",
                                        "glosses": [
                                            "Le plus souvent ; habituellement ; ordinairement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcef13ff-174f-4c1f-8489-4079fbd8c8d9",
                                                "sense_id": "dd05f5f8-5a80-3c3b-98b6-d6b73e074024",
                                                "text": "D’ailleurs, ce qui est particulier à la politique de l’histoire sainte, c’est que, chaque fois qu’un personnage marquant fait quelque chose de mal, c’est toujours le pauvre peuple qui écope."
                                            },
                                            {
                                                "example_id": "9e38de87-844a-4966-b244-11069de2b660",
                                                "sense_id": "dd05f5f8-5a80-3c3b-98b6-d6b73e074024",
                                                "text": "Il est interrompu par la venue de Claudette, plus sémillante que toujours, la tétance brandie sous un teeshirt représentant un tigre mordoré en train de feuler comme un con."
                                            },
                                            {
                                                "example_id": "51af75de-0ce5-47dc-853d-54a210e08cac",
                                                "sense_id": "dd05f5f8-5a80-3c3b-98b6-d6b73e074024",
                                                "text": "Il est toujours en bonne compagnie. — On le trouve toujours occupé. — Il est toujours en colère. — Il est toujours gai, toujours de bonne humeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0beadb5-9c00-3d3d-af85-ed706c80aeb6",
                                        "entry_id": "821f9829-0022-3315-9d08-9a488500c81c",
                                        "glosses": [
                                            "Comme par le passé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ae17f73-5d5d-4144-b3d7-feb816ed6fbb",
                                                "sense_id": "b0beadb5-9c00-3d3d-af85-ed706c80aeb6",
                                                "text": "Il l’aime toujours. — Elle est toujours aussi belle. — Il est toujours le même."
                                            },
                                            {
                                                "example_id": "db1abba6-c53a-4f3a-bca9-af91d2c64480",
                                                "sense_id": "b0beadb5-9c00-3d3d-af85-ed706c80aeb6",
                                                "text": "Je n'ai toujours pas compris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d67bd600-cea8-342c-80c0-ee5ebea517d4",
                                        "entry_id": "821f9829-0022-3315-9d08-9a488500c81c",
                                        "glosses": [
                                            "Sans exception ; en toute rencontre ; en toute occasion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01122042-6071-419b-83a4-fd98be0321e3",
                                                "sense_id": "d67bd600-cea8-342c-80c0-ee5ebea517d4",
                                                "text": "Moi équipé comme si je partais au Sahara, eux avec de belles chemises et de beaux complets, à part Jullian toujours foutu comme l'as de pique."
                                            },
                                            {
                                                "example_id": "92e64f2f-ae34-4b41-8906-972fb1fade9f",
                                                "sense_id": "d67bd600-cea8-342c-80c0-ee5ebea517d4",
                                                "text": "Les plus grands esprits ne sont pas toujours les plus agréables."
                                            },
                                            {
                                                "example_id": "206a4a40-ccb7-4a11-a263-dc50238165e6",
                                                "sense_id": "d67bd600-cea8-342c-80c0-ee5ebea517d4",
                                                "text": "Les beautés les plus régulières ne sont pas toujours celles qui plaisent le plus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e30541b-0a5a-3c96-9223-d344859ed663",
                                        "entry_id": "821f9829-0022-3315-9d08-9a488500c81c",
                                        "glosses": [
                                            "En attendant, cependant, néanmoins, du moins, en tout cas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d882933-d8b8-468b-a185-92d62bbfa513",
                                                "sense_id": "4e30541b-0a5a-3c96-9223-d344859ed663",
                                                "text": "Je vous suivrai de près, allez toujours. — Prenez toujours cela à compte."
                                            },
                                            {
                                                "example_id": "df80f6ef-94ab-4ec1-bdc3-f8a3bfa96ad0",
                                                "sense_id": "4e30541b-0a5a-3c96-9223-d344859ed663",
                                                "text": "Hélas! dit-il, ma belle dame, quand je vous accorderais sa grâce, mon indulgence ne servirait de rien. Il faut qu'elle soit signée de trois autres de mes confrères. — Signez toujours, dit Almona"
                                            },
                                            {
                                                "example_id": "33c8a880-e4e2-40b7-b71f-5c52614f6241",
                                                "sense_id": "4e30541b-0a5a-3c96-9223-d344859ed663",
                                                "text": "– Tu n’es pas expérimentée, Alice.\n– Autant que toi, toujours…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8865dbc7-2fe9-354b-b849-558514c8e763",
                                        "entry_id": "821f9829-0022-3315-9d08-9a488500c81c",
                                        "glosses": [
                                            "De toute façon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "363e3ecb-d107-42c9-a350-00afe6f7c791",
                                                "sense_id": "8865dbc7-2fe9-354b-b849-558514c8e763",
                                                "text": "Ça peut toujours servir."
                                            },
                                            {
                                                "example_id": "f2bc84b6-ca93-430b-aa0e-928730efa28f",
                                                "sense_id": "8865dbc7-2fe9-354b-b849-558514c8e763",
                                                "text": "C'est toujours ça de gagné."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0abcbc40-a583-4fc8-84de-1e7a11f531e2",
