                        "form": "стря́пчих"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ad40d5d4-c68c-3e45-9045-0fa4b66331b3",
                        "entry_id": "a4212a93-3531-3e36-848a-1571d45ea719",
                        "glosses": [
                            "истор. название должностных лиц, выполнявших различные хозяйственные обязанности при царском дворе"
                        ],
                        "tags": [
                            "на Руси XVI — начала XVIII вв."
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5922db4b-9b2d-3892-b2a7-43b11e61f453",
                        "entry_id": "a4212a93-3531-3e36-848a-1571d45ea719",
                        "glosses": [
                            "истор. чиновник по судебным делам, помощник прокурора, часто выступавший в делах поверенным истца. При всех изменениях статута главным для стряпчего оставался надзор за правильным ходом дел, следствия и судопроизводства."
                        ],
                        "tags": [
                            "в Российском государстве XVIII — первой половины XIX вв."
                        ],
                        "examples": [
                            {
                                "example_id": "78a8e7af-ff11-4ae9-b156-c28a487c0cd4",
                                "sense_id": "5922db4b-9b2d-3892-b2a7-43b11e61f453",
                                "text": "К нему ездил и городничий на широких рыжих дрожках парой, необыкновенно крупный, словно из залежалого материала скроенный человек; ездили прочие чиновники: стряпчий, желтенькое и злобненькое существо; остряк землемер – немецкого происхождения, с татарским лицом; офицер путей сообщения – нежная душа, певец, но сплетник; бывший уездный предводитель – господин с крашеными волосами, взбитой манишкой, панталонами в обтяжку и тем благороднейшим выражением лица, которое так свойственно людям, побывавшим под судом; ездили также два помещика, друзья неразлучные, оба уже немолодые и даже потертые, из которых младший постоянно уничтожал старшего и зажимал ему рот одним и тем же упреком: «Да полноте, Сергей Сергеич: куда вам? Ведь вы слово: пробка – пишете с буки. Да, господа, – продолжал он со всем жаром убеждения, обращаясь к присутствующим, – Сергей Сергеич пишет не пробка, а бробка»."
                            }
                        ]
                    },
                    {
                        "sense_id": "ad1960d6-e7dd-37dc-91c8-2ef29faeca85",
                        "entry_id": "a4212a93-3531-3e36-848a-1571d45ea719",
                        "glosses": [
                            "истор. частный поверенный"
                        ],
                        "tags": [
                            "в Российском государстве до 1917 г."
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12dfe43e-ec41-46f1-86b1-2f61646fd862",
                        "source_entry_id": "a4212a93-3531-3e36-848a-1571d45ea719",
                        "target_lang_word": "Koch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Koch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fdb180be-ac8f-3dcf-b836-321ea868e623",
                                        "entry_id": "07d9b37b-7e8d-3e48-8bdd-ff6bf29a4017",
                                        "glosses": [
                                            "Berufsbezeichnung für eine (männliche^☆) Person, die Speisen zubereitet"
                                        ],
                                        "tags": [
                                            "Beruf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44deb878-b9cb-43b5-a1f9-99d757a3bacf",
                                                "sense_id": "fdb180be-ac8f-3dcf-b836-321ea868e623",
                                                "text": "Der Koch gab sich viel Mühe mit der Zubereitung der Speisen."
                                            },
                                            {
                                                "example_id": "10ba606e-7526-4614-9c73-647b1e5163e4",
                                                "sense_id": "fdb180be-ac8f-3dcf-b836-321ea868e623",
                                                "text": "„Ich habe inzwischen verstanden, dass Köche beneidenswerte Männer sind.“"
                                            },
                                            {
                                                "example_id": "3763087e-470a-40d9-a2b6-e19c8aedf6e5",
                                                "sense_id": "fdb180be-ac8f-3dcf-b836-321ea868e623",
                                                "text": "„Er war Koch, ein Reisender und ein Gourmet.“"
                                            },
                                            {
                                                "example_id": "f20526df-0855-4cba-b0f5-2b8d9dbc7b54",
                                                "sense_id": "fdb180be-ac8f-3dcf-b836-321ea868e623",
                                                "text": "„Unsere Crew war bis auf einen Mann, den Koch, desertiert, so wie es häufig in Charleston vorkommt, und wir zogen den Koch als Ratgeber ins Vertrauen.“"
                                            },
                                            {
                                                "example_id": "89b754dd-0fc8-458d-b972-bd855ff8f044",
                                                "sense_id": "fdb180be-ac8f-3dcf-b836-321ea868e623",
                                                "text": "„Ein Koch hatte zwei Behälter mit Speisen und Zukost und zwei Krüge Güldenprachter Wein hinbringen müssen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Koch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "47e5a6e4-6541-31e2-8df9-b2fa32ea9226",
                                        "entry_id": "37badc99-0706-3566-8e38-2b48e993f4ec",
                                        "glosses": [
                                            "zu Brei Gekochtes"
                                        ],
                                        "tags": [
                                            "Bavarian"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "342015b3-45cd-4565-bd90-86e83352bc9a",
                                                "sense_id": "47e5a6e4-6541-31e2-8df9-b2fa32ea9226",
                                                "text": "„[…] gebe dazu etwas Semmelbröseln, gestoßene Mandeln und Zucker, auch Limonienschalen und Gewürz, und backe das Koch in einer mit Schmalz bestrichenen Rein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Koch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c11a208-e9bf-3634-b584-cd353fb79f74",
                                        "entry_id": "f4bf0f29-655c-3972-9411-8adec62b38df",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "531f38e6-6b46-4dc3-bad8-6a8098a71b48",
                                                "sense_id": "3c11a208-e9bf-3634-b584-cd353fb79f74",
                                                "text": "Frau Koch ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "1ad53361-1a8d-437c-b2f5-a4dd226c1591",
                                                "sense_id": "3c11a208-e9bf-3634-b584-cd353fb79f74",
                                                "text": "Herr Koch wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "ddd74331-f1eb-4da5-b6a0-9fb086f3ee64",
                                                "sense_id": "3c11a208-e9bf-3634-b584-cd353fb79f74",
                                                "text": "Die Kochs fahren heute ins Sauerland."
                                            },
                                            {
                                                "example_id": "8cb037eb-4245-4c11-8ccf-5061dfd2e723",
                                                "sense_id": "3c11a208-e9bf-3634-b584-cd353fb79f74",
                                                "text": "Der Koch trägt nie die Schals, die die Koch ihm strickt."
                                            },
                                            {
                                                "example_id": "53c9bcf7-9bc3-499b-b1e1-5f21716380d5",
                                                "sense_id": "3c11a208-e9bf-3634-b584-cd353fb79f74",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Koch kommt, geht der Herr Koch.“"
                                            },
                                            {
                                                "example_id": "f139779e-b5b8-4597-bf86-8c0b925c5d82",
                                                "sense_id": "3c11a208-e9bf-3634-b584-cd353fb79f74",
                                                "text": "Koch kommt und geht."
                                            },
                                            {
                                                "example_id": "8472ae46-2808-4823-aeb5-a28ebdb7340d",
                                                "sense_id": "3c11a208-e9bf-3634-b584-cd353fb79f74",
                                                "text": "Kochs kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
