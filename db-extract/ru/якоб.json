                                "target_senses": [
                                    {
                                        "sense_id": "ad3c5957-bc15-3901-9c6c-5038e2ae43a5",
                                        "entry_id": "34d03ae7-2160-37b6-9347-40e474956ace",
                                        "glosses": [
                                            "A male given name from Hebrew."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb44d51c-5e3f-4ce5-a07c-3635e558e1e8",
                                                "sense_id": "ad3c5957-bc15-3901-9c6c-5038e2ae43a5",
                                                "text": "\"Georgette. How are you called?\" \"Jacob.\" \"That's a Flemish name.\" \"American too.\" \"You're not a Flamand?\" \"No, American.\" \"Good, I detest Flamands.\" - - -\nBrett smiled at him. \"I've promised to dance this with Jacob,\" she laughed. \"You've a hell of a biblical name, Jake.\""
                                            },
                                            {
                                                "example_id": "075701a3-edf4-4c48-bf22-62e6b9250abd",
                                                "sense_id": "ad3c5957-bc15-3901-9c6c-5038e2ae43a5",
                                                "text": "Analysts and opinion polls had forecast losses for the ANC but a pivotal factor in the party’s staggering decline was former President Jacob Zuma and his newly formed uMkhonto weSizwe (MK) party, which capitalized on widespread discontent within the ANC’s traditional voter base."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f88d2a68-bb5c-30c5-b421-dde398fc4bc6",
                                        "entry_id": "34d03ae7-2160-37b6-9347-40e474956ace",
                                        "glosses": [
                                            "A male given name from Hebrew.",
                                            "One of the sons of Isaac and Rebecca, and twin brother of Esau; father of the Israelites (Jews and Samaritans) by 12 sons by 4 consorts, most famously Judah and Joseph who fathered Manasseh."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bfb0cfe-4a9c-4c66-886d-a21d9c3cc7b4",
                                                "sense_id": "f88d2a68-bb5c-30c5-b421-dde398fc4bc6",
                                                "text": "And the boyes grew; and Eſau was a cunning hunter, a man of the fielde: and Iacob was a plaine man, dwelling in tents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b09a3637-8a33-3c13-b384-c6facec0a071",
                                        "entry_id": "34d03ae7-2160-37b6-9347-40e474956ace",
                                        "glosses": [
                                            "A male given name from Hebrew.",
                                            "The fifth son of Lehi and one of the younger brothers of Nephi, author of one of the books in the Book of Mormon."
                                        ],
                                        "tags": [
                                            "Mormonism"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
