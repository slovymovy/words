        "pl-extract.jsonl": [
            {
                "entry_id": "0f5cc7b5-0983-3cd9-8d37-17ff6419fcbd",
                "word": "absurdalnie",
                "pos": "adv",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "760b5342-766e-33cc-9dea-5cbe3ae0a246",
                        "entry_id": "0f5cc7b5-0983-3cd9-8d37-17ff6419fcbd",
                        "glosses": [
                            "w sposób absurdalny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81734fc8-b405-4cfc-8875-370ae088aa26",
                                "sense_id": "760b5342-766e-33cc-9dea-5cbe3ae0a246",
                                "text": "Obaj doskonale wiemy, że posądzenie państwa o handel narkotykami brzmi absurdalnie, ale z drugiej strony…"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "378b6d2f-97a7-4ef5-83d8-622bd463f380",
                        "source_entry_id": "0f5cc7b5-0983-3cd9-8d37-17ff6419fcbd",
                        "source_sense_id": "760b5342-766e-33cc-9dea-5cbe3ae0a246",
                        "target_lang_word": "absurdly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "absurdly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb3ec769-afc3-32bd-819a-59e7d612a6c7",
                                        "entry_id": "7ec1197c-9f6b-307d-a2b4-15879040ab49",
                                        "glosses": [
                                            "In an absurd fashion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42b488a7-cf12-4329-a501-05dcd9b65de8",
                                                "sense_id": "eb3ec769-afc3-32bd-819a-59e7d612a6c7",
                                                "text": "He orated absurdly."
                                            },
                                            {
                                                "example_id": "8a55540f-ee7d-4fe2-9d84-f621c3dc4581",
                                                "sense_id": "eb3ec769-afc3-32bd-819a-59e7d612a6c7",
                                                "text": "Absurdly, he concluded his oration with a song."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1c59dd4-d412-3b72-9f17-6e432052745c",
                                        "entry_id": "7ec1197c-9f6b-307d-a2b4-15879040ab49",
                                        "glosses": [
                                            "To an extreme degree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80f5d9e1-7a83-4d2a-b3ec-28c31f69b48f",
                                                "sense_id": "a1c59dd4-d412-3b72-9f17-6e432052745c",
                                                "text": "The critics were absurdly extravagant with their praise."
                                            },
                                            {
                                                "example_id": "c343006f-ba50-4032-a8a0-cc538aa97a47",
                                                "sense_id": "a1c59dd4-d412-3b72-9f17-6e432052745c",
                                                "text": "By the year 1765, Richard `Dickie' Tattersall, the absurdly romantic self-styled soldier of fortune and indulged son of an obscenely well-off Yorkshire squire, was brimming with gratitude[.]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e027881-1073-4672-9ec7-e0841a07e3a4",
                        "source_entry_id": "0f5cc7b5-0983-3cd9-8d37-17ff6419fcbd",
                        "source_sense_id": "760b5342-766e-33cc-9dea-5cbe3ae0a246",
                        "target_lang_word": "ridiculously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ridiculously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb142d6e-4fca-39b0-ad2a-118e11f32d82",
                                        "entry_id": "47cb474b-d30e-3978-9faf-89e21ba52a62",
                                        "glosses": [
                                            "In a ridiculous manner. In a way that is funny, embarrassing or extremely implausible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2c4ee00-1d8d-4373-9009-76bcf43331cc",
                                                "sense_id": "eb142d6e-4fca-39b0-ad2a-118e11f32d82",
                                                "text": "From another point of view, it was a place without a soul. The well-to-do had hearts of stone; the rich were brutally bumptious; the Press, the Municipality, all the public men, were ridiculously, vaingloriously self-satisfied."
                                            },
                                            {
                                                "example_id": "38cb003a-fe12-4271-886e-3d69c6227449",
                                                "sense_id": "eb142d6e-4fca-39b0-ad2a-118e11f32d82",
                                                "text": "`I was with the ballet back home, but the money was ridiculously low.'"
                                            },
                                            {
                                                "example_id": "737cd474-4e19-417e-af5c-b5204043ad21",
                                                "sense_id": "eb142d6e-4fca-39b0-ad2a-118e11f32d82",
                                                "text": "It's a shame; not only are nuts quite ridiculously nutritious but, as anyone who's ever shelled out (sorry) for a tiny glass of pistachios in a pub will know, they're a guaranteed crowd-pleaser. But although I happen to have a soft spot for nut roast – an option often preferable to the meat that emerged from the school kitchen – it seems I'm in a cranky minority. A request for recipe recommendations was met with a polite silence on Twitter: vegetarianism, apparently, has moved on a bit. You don't see Yotam Ottolenghi faffing about with nut roasts, do you? But I'm determined to revive the fortunes of this much-maligned classic. After all, Christmas isn't Christmas without a luxury nut selection."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ac58ff9-37e9-379e-9c99-c616cef8d5fd",
                                        "entry_id": "47cb474b-d30e-3978-9faf-89e21ba52a62",
                                        "glosses": [
                                            "extremely; very"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19ac1850-9e9b-4bfc-a709-d1ec208556e4",
                                                "sense_id": "3ac58ff9-37e9-379e-9c99-c616cef8d5fd",
                                                "text": "Thus, after eighteen months of fantastic and ruinous warfare, the companies had come to their senses and agreed to do what they might have done at the start; the only gainers were the passengers who had been carried at ridiculously uneconomic fares."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "316b6676-11a7-4f63-839b-7957c039d999",
                        "source_entry_id": "0f5cc7b5-0983-3cd9-8d37-17ff6419fcbd",
                        "source_sense_id": "760b5342-766e-33cc-9dea-5cbe3ae0a246",
                        "target_lang_word": "absurdement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "absurdement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b91149f2-7796-3531-a42e-180882d131af",
                                        "entry_id": "033c1fad-6964-3830-bcb4-b8aade5713d2",
                                        "glosses": [
                                            "D’une manière absurde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e89a759c-c61f-45a0-a750-5d41e6067221",
                                                "sense_id": "b91149f2-7796-3531-a42e-180882d131af",
                                                "text": "Il était ridicule d’augmenter le conseil, déjà absurdement nombreux"
                                            },
                                            {
                                                "example_id": "43732b8d-d030-4c30-899e-7c65b970ede9",
                                                "sense_id": "b91149f2-7796-3531-a42e-180882d131af",
                                                "text": "Ni les râleurs du collectif « Non aux JO 2024 à Paris », qui assurent que les dépenses de sécurité ont été absurdement sous-évalués et jurent qu’elles s’élèveront, au minimum, à six fois plus que les 182 millions prévus."
                                            },
                                            {
                                                "example_id": "11654563-188d-4c0f-954f-90ccdf20d35e",
                                                "sense_id": "b91149f2-7796-3531-a42e-180882d131af",
                                                "text": "Je ne pense pas aux milliers de déportés absurdement transbahutés là dans un autre siècle, mais au corps vieilli de ma soeur."
                                            },
                                            {
                                                "example_id": "4b3f8aee-97bd-471d-b20e-85d1b06017c5",
                                                "sense_id": "b91149f2-7796-3531-a42e-180882d131af",
                                                "text": "Il a raisonné absurdement. Il a absurdement raisonné."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c8c5312-38b5-4aac-9f78-4be74b20c1d9",
