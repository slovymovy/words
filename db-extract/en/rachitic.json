                                "target_senses": [
                                    {
                                        "sense_id": "3f79c719-1187-329b-a98f-36594dcb0ced",
                                        "entry_id": "dff7878f-b117-333c-8c0a-fe2dcc88f610",
                                        "glosses": [
                                            "an der Krankheit Rachitis leidend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4883ab30-57f7-49aa-bc6a-c9f54b134094",
                                                "sense_id": "3f79c719-1187-329b-a98f-36594dcb0ced",
                                                "text": "„Wie man aus Tierversuchen gesehen hatte, in denen mit artfremder Milch ernährte Tiere schwach und rachitisch wurden, konnte eine minderwertige Konstitution jedoch nicht nur geerbt, sondern auch erworben werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "90130021-e877-3bd7-885e-9dc39678a1da",
                                        "entry_id": "dff7878f-b117-333c-8c0a-fe2dcc88f610",
                                        "glosses": [
                                            "nicht sehr ausgeprägt, unterentwickelt seiend, nicht ergiebig"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "232f004c-d4a7-420a-97e0-e3e8f7b1d71d",
                                                "sense_id": "90130021-e877-3bd7-885e-9dc39678a1da",
                                                "text": "„Das Veranstaltungsprogramm fürs Wochenende sieht nicht mehr ganz so rachitisch aus.“"
                                            },
                                            {
                                                "example_id": "b89cfb41-f7e6-4386-a9f8-e1f21f18b492",
                                                "sense_id": "90130021-e877-3bd7-885e-9dc39678a1da",
                                                "text": "„Das militärhistorische Interesse des neuen US-Stabschefs müßte geradezu rachitisch unterentwickelt sein, wenn er wirklich niemals in den Kriegserinnerungen seines Vaters geblättert haben sollte.“"
                                            },
                                            {
                                                "example_id": "bae62efb-3b12-4f25-972c-4e9650c03bc4",
                                                "sense_id": "90130021-e877-3bd7-885e-9dc39678a1da",
                                                "text": "„Die parlamentarische Situation Italiens lud zu einem solchen Manöver geradezu ein, denn anders als in Japan, dessen Regierung offenkundig auf dem Willen einer breiten Mehrheit basiert, stützt sich Italiens christdemokratischer Ministerpräsident Fernando Tambroni auf eine rachitisch schmale Parlamentsmehrheit.“"
                                            },
                                            {
                                                "example_id": "dd9e5305-0658-462d-a6b7-efb6d8bf7d2a",
                                                "sense_id": "90130021-e877-3bd7-885e-9dc39678a1da",
                                                "text": "„Das Ende staatlicher Beschäftigungsprogramme tat ein Übriges, um das rachitische Wirtschaftswachstum von 0,2 Prozent im zweiten Quartal vollends abzuwürgen.“"
                                            },
                                            {
                                                "example_id": "fd5e24b1-88f0-4ea5-99bd-a1bef34fd5fd",
                                                "sense_id": "90130021-e877-3bd7-885e-9dc39678a1da",
                                                "text": "„Ich war der analoge Höhlenbewohner, der Zausel vom Dienst, der alle Rundmails verpasst, statt zu googeln in seinem wurmstichigen Gedächtnis herumkramt und verzweifelt versucht, mit rachitisch quietschenden Faxgeräten und postkutschenlangsamen Briefen Kontakt zur Außenwelt zu halten. Was wirklich schwer war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
