                "translations": [
                    {
                        "translation_id": "c6aba399-b8ab-409f-84d8-a09aff3c088c",
                        "source_entry_id": "df4d31a8-379b-3257-baf4-8210c993c58e",
                        "source_sense_id": "c0d022d9-683e-3ca1-84bf-b12388c0063d",
                        "source_sense_description": "eine oder mehrere unbestimmte Person(en)",
                        "target_lang_word": "anyone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anyone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "315f6c62-f9c8-399c-9846-2f43202f59d0",
                                        "entry_id": "a4a3da71-3ba3-3a9d-ac97-bc3e7e7ab969",
                                        "glosses": [
                                            "Any person; anybody."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82711216-c425-4eb2-bcc8-130b1e4347f7",
                                                "sense_id": "315f6c62-f9c8-399c-9846-2f43202f59d0",
                                                "text": "Almost anyone can change a light bulb."
                                            },
                                            {
                                                "example_id": "aba4f858-a54c-4a7d-af68-c696ed925f44",
                                                "sense_id": "315f6c62-f9c8-399c-9846-2f43202f59d0",
                                                "text": "The liar's punishment is not in the least that he is not believed, but that he cannot believe anyone else."
                                            },
                                            {
                                                "example_id": "95fceaf5-ccf7-43fc-be10-8cc7bb62405f",
                                                "sense_id": "315f6c62-f9c8-399c-9846-2f43202f59d0",
                                                "text": "“[…] Anyone who knows me will tell you I'm straight, but this time I had six thousand quid at stake. […] I laid 'em long odds because it wasn't in the nature of things that Wynbolt could beat all of them champs. Then—then he smashed one after another, until I got windy—nervous as you might say. […]”"
                                            },
                                            {
                                                "example_id": "474b9063-15c5-400c-9935-a08dce523637",
                                                "sense_id": "315f6c62-f9c8-399c-9846-2f43202f59d0",
                                                "text": "It is tempting to speculate about the incentives or compulsions that might explain why anyone would take to the skies in [the] basket [of a balloon]: perhaps out of a desire to escape the gravity of this world or to get a preview of the next; […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2341d10-e7d4-40da-b4ef-62060cbccd7e",
                        "source_entry_id": "df4d31a8-379b-3257-baf4-8210c993c58e",
                        "source_sense_id": "c0d022d9-683e-3ca1-84bf-b12388c0063d",
