                    "frequency": "High",
                    "semantic_group_id": "realisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'employé doit <w>exécuter</w> cette tâche avant la fin de la journée de travail."
                        },
                        {
                            "text": "Les soldats ont refusé d'<w>exécuter</w> un ordre qui semblait injuste."
                        }
                    ],
                    "synonyms": [
                        "accomplir",
                        "effectuer",
                        "réaliser"
                    ],
                    "common_phrases": [
