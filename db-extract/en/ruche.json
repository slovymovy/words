                    {
                        "sense_id": "3391aace-f080-3b47-a285-f0cf42c5d798",
                        "entry_id": "7ae6a859-cbf7-3f42-a055-3946cd371717",
                        "glosses": [
                            "A small ruff of fluted or pleated fabric worn at neck or wrist."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5ad8350-cb1c-45eb-9bf0-f6f800e4991b",
                                "sense_id": "3391aace-f080-3b47-a285-f0cf42c5d798",
                                "text": "Mrs. Newsome wore at operatic hours a black silk dress—very handsome, he knew it was \"handsome\"—and an ornament that his memory was able further to identify as a ruche."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff8920e9-2710-3bee-8a47-5d020d78cf01",
                        "entry_id": "7ae6a859-cbf7-3f42-a055-3946cd371717",
                        "glosses": [
                            "A pile of arched tiles, used to catch and retain oyster spawn."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4c795da-08cb-4e54-aafc-8af967b9af0e",
                        "source_entry_id": "7ae6a859-cbf7-3f42-a055-3946cd371717",
