                ],
                "senses": [
                    {
                        "sense_id": "96b8b2b2-56b7-39c7-b5bb-2189680062e8",
                        "entry_id": "e3249e42-fe19-30eb-95d9-4b87429250f0",
                        "glosses": [
                            "Relatif au néo-nazisme."
                        ],
                        "tags": [
                            "Nazism"
                        ],
                        "examples": [
                            {
                                "example_id": "fbb96ff7-7a5d-42a5-a5ec-6fdd023d6e7f",
                                "sense_id": "96b8b2b2-56b7-39c7-b5bb-2189680062e8",
                                "text": "Une manifestation néo-nazie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d47fe41-3f2a-4f0d-b327-ac7b9e7052ec",
                        "source_entry_id": "e3249e42-fe19-30eb-95d9-4b87429250f0",
                        "source_sense_id": "96b8b2b2-56b7-39c7-b5bb-2189680062e8",
                        "target_lang_word": "Neonazi",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Neonazi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9eed40a7-7c77-3878-b1ff-bc3308275a5d",
                                        "entry_id": "6b1ad496-f591-30be-bb3f-eb69b0cfc46d",
                                        "glosses": [
                                            "Anhänger des Nationalsozialismus, dessen Aktivität nach dem Untergang des Dritten Reiches stattfindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d20b721-a58a-4cc4-bbf5-68d7dc18ca2f",
                                                "sense_id": "9eed40a7-7c77-3878-b1ff-bc3308275a5d",
                                                "text": "Wenn Neonazis Demonstrationen aufführen, werden sie von der Bundespolizei bewacht."
                                            },
                                            {
                                                "example_id": "da1109f6-b49f-409a-9222-a0baa53c6d84",
                                                "sense_id": "9eed40a7-7c77-3878-b1ff-bc3308275a5d",
                                                "text": "„Starre Ansichten wie diese lassen sich beispielsweise bei Islamisten erkennen, aber genauso bei Neonazis oder anderen Extremisten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3f7d6500-7bee-3b65-a252-d350dfc5f896",
                                        "entry_id": "6b1ad496-f591-30be-bb3f-eb69b0cfc46d",
                                        "glosses": [
                                            "Person mit rechter Gesinnung; Ausländerfeind"
                                        ],
                                        "tags": [
                                            "casual"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9845b591-eb45-433b-a2e0-f7099cfcf4a6",
                                                "sense_id": "3f7d6500-7bee-3b65-a252-d350dfc5f896",
                                                "text": "In dem Viertel wohnen nur Neonazis."
                                            },
                                            {
                                                "example_id": "32ed986e-059f-4935-b130-beff9122bea7",
                                                "sense_id": "3f7d6500-7bee-3b65-a252-d350dfc5f896",
                                                "text": "„Häuser in Mölln und Solingen wurden von Neonazis in Brand gesetzt.“"
                                            },
                                            {
                                                "example_id": "824c966c-f67e-4d30-9f82-231f33b04ba4",
                                                "sense_id": "3f7d6500-7bee-3b65-a252-d350dfc5f896",
                                                "text": "„Vor den Augen der Sicherheitsbehörden hat sich eine Szene von jungen, gewaltbereiten Neonazis etabliert.“"
                                            },
                                            {
                                                "example_id": "419a6a06-66d5-4100-8ba3-71085560f961",
                                                "sense_id": "3f7d6500-7bee-3b65-a252-d350dfc5f896",
                                                "text": "„Auch andernorts verübten junge Neonazis zuletzt schwere Gewalttaten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "caf7e421-b7cd-4036-a592-47c3237ca55e",
                        "source_entry_id": "e3249e42-fe19-30eb-95d9-4b87429250f0",
                        "source_sense_id": "96b8b2b2-56b7-39c7-b5bb-2189680062e8",
                        "target_lang_word": "neo-Nazi",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neo-Nazi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f0c6eb15-a747-3dfe-9aea-420cfb0de42f",
                                        "entry_id": "c2ea2748-9d35-325a-805d-30e32f9c94fd",
                                        "glosses": [
                                            "An adherent of neo-Nazism, any of various (far right, authoritarian, or bigoted) post-World War II Nazi ideologies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a6c8b78-e57b-4552-9c85-9f63e1f1812e",
                                                "sense_id": "f0c6eb15-a747-3dfe-9aea-420cfb0de42f",
                                                "text": "Andrew Anglin, head of the now defunct alt-right publication Daily Stormer, a Neo-Nazi, and friend of Richard Spencer claimed on his site that “the only thing in our movement that really matters [is] anti-Semitism […] Last but not least, President Trump himself was key in mainstreaming alt-right politics, referring to white supremacists and Neo-Nazis as “very fine people”, […]"
                                            },
                                            {
                                                "example_id": "d60e61c0-a308-4e12-b20e-450c8351f60c",
                                                "sense_id": "f0c6eb15-a747-3dfe-9aea-420cfb0de42f",
                                                "text": "Among his first moves, he dismantled Twitter's trust and safety infrastructure, laying off the vast majority of the staff responsible for things like taking down violent threats and hate speech. In their place, he welcomed neo-Nazis."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "neo-Nazi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "570912bf-b33a-35e8-a2b9-bfa829ecba93",
                                        "entry_id": "15e32e81-f7bf-33b7-a0cb-8e24ae12e601",
                                        "glosses": [
                                            "Of or pertaining to neo-Nazism or neo-Nazis."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2955ad6f-9017-4635-838b-4cba2e7bc4b8",
                                                "sense_id": "570912bf-b33a-35e8-a2b9-bfa829ecba93",
                                                "text": "On the whole the Galicians have been at the more pitiful end of the spectrum, trading infantile political insults on the web, each trying desperately to appear more neo-Nazi than the other."
                                            },
                                            {
                                                "example_id": "04281a07-c4d2-4b90-9a0d-ff3709f4dad8",
                                                "sense_id": "570912bf-b33a-35e8-a2b9-bfa829ecba93",
                                                "text": "Wilson has tweeted the phrase “Ausländer Raus” at least four times, including the slogan, “Deutschland den Deutschen. Ausländer raus.” The phrase, which means, “Germany for Germans, foreigners out,” is explicitly considered to be an extremist slogan in Germany with neo-Nazi roots; in fact, a 1992 paper about its use among German skinheads is available on a Department of Justice website."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97d445a3-608d-493b-bd5d-7e963ce25a33",
                        "source_entry_id": "e3249e42-fe19-30eb-95d9-4b87429250f0",
                        "source_sense_id": "96b8b2b2-56b7-39c7-b5bb-2189680062e8",
                        "target_lang_word": "неонацистский",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "неонацистский",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4162e1f0-dd98-3e23-95a4-dfca57a67b9d",
                                        "entry_id": "9dec72b2-a204-3584-bcd8-d3ddf282598a",
                                        "glosses": [
                                            "относящийся к неонацизму, неонацистам"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fb221a3-1b5b-4c67-8ef5-c3e706f316bc",
                                                "sense_id": "4162e1f0-dd98-3e23-95a4-dfca57a67b9d",
                                                "text": "Дания сегодня единственная в Европе страна, в парламенте которой заседает неонацистская партия, больше того, входит в парламентское большинство и правительство."
                                            },
                                            {
                                                "example_id": "f171bd2a-79e5-4295-9f70-06587ce61b2f",
                                                "sense_id": "4162e1f0-dd98-3e23-95a4-dfca57a67b9d",
                                                "text": "Лишь 10 процентов электората неонацистских партий имеют среднее образование (в среднем по стране его имеют почти 30 процентов)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
