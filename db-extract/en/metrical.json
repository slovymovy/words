                                            {
                                                "example_id": "63b4a9b8-7384-4327-bd2f-a2f7a3255c4e",
                                                "sense_id": "8a50ebe9-d91a-3e1d-a345-9ad87f1aaeae",
                                                "text": "„Sämtliche rhythmischen und metrischen Gebilde sind ihrem Wesen nach inkonstant: die einen mehr, die anderen weniger. Man darf wohl sagen, daß jedes neue Gedicht von einiger Bedeutung dem scharfen Beobachter nach irgendeiner formalen Seite hin eine Überraschung bereitet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "50eb6f82-035c-3d67-9c0b-3c8a92249d19",
                                        "entry_id": "2c63d524-485d-30d4-9874-5afa82cca869",
                                        "glosses": [
                                            "auf die Einheit Meter bezogen"
                                        ],
                                        "tags": [
                                            "von Einheiten oder Einheitensystemen"
                                        ],
                                        "examples": [
                                            {
