                        "sense_id": "49e3d78e-a1b3-3816-83d3-1b60261d7e7f",
                        "entry_id": "90100866-33f7-3ef7-b5b2-ec6889e13e76",
                        "glosses": [
                            "Féminin singulier de subordonné."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "d0ab65ee-d2e6-455f-a631-703b0109150f",
                                "sense_id": "49e3d78e-a1b3-3816-83d3-1b60261d7e7f",
                                "text": "On ne peut pas nier l’évidence, à savoir que la situation subordonnée des femmes dans le système universitaire et scientifique les motive plus que les hommes à débiaiser les sciences humaines et à en montrer la dépendance vis-à-vis de postulats visant à rendre invisible l’oppression des femmes ou à la justifier."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7713cf26-b616-49d2-bdf4-759236f40932",
                        "source_entry_id": "90100866-33f7-3ef7-b5b2-ec6889e13e76",
