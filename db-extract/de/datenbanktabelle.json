                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6b4b6414-01c3-32cc-9be4-3e51a0943003",
                                        "entry_id": "04a96dc5-2f91-30e6-9259-ac42d22c500b",
                                        "glosses": [
                                            "A group of people at a table, for example, for a meal, meeting or game."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb1aad5c-0cbb-4975-85bd-54f9f9b3439a",
                                                "sense_id": "6b4b6414-01c3-32cc-9be4-3e51a0943003",
                                                "text": "Alas poore Yorick […] VVhere be your Jibes now? Your Gambals? Your Songs? Your flaſhes of Merriment that were wont to ſet the Table on a Rore?"
                                            },
                                            {
                                                "example_id": "14d89d5a-003b-40d2-bf0c-b21d6a157391",
                                                "sense_id": "6b4b6414-01c3-32cc-9be4-3e51a0943003",
                                                "text": "The humor of my proposition appealed more strongly to Miss Trevor than I had looked for, and from that time forward she became her old self again;[…]. Our table in the dining-room became again the abode of scintillating wit and caustic repartee, Farrar bracing up to his old standard, and the demand for seats in the vicinity rose to an animated competition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6608ab1d-ced5-38a5-b0bd-10de4a98623a",
                                        "entry_id": "04a96dc5-2f91-30e6-9259-ac42d22c500b",
                                        "glosses": [
                                            "A group of people at a table, for example, for a meal, meeting or game.",
                                            "The lineup of players at a given table."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e4e1323-07f9-4623-8f5c-3aba98f88dea",
                                                "sense_id": "6608ab1d-ced5-38a5-b0bd-10de4a98623a",
                                                "text": "That's the strongest table I've ever seen at a European Poker Tour event"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d068a9a-164c-3bc9-9dc4-80b776239d07",
                                        "entry_id": "04a96dc5-2f91-30e6-9259-ac42d22c500b",
                                        "glosses": [
                                            "A group of people at a table, for example, for a meal, meeting or game.",
                                            "A group of players meeting regularly to play a campaign."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b5659407-eaf0-32b6-877b-c5fbe20c2bca",
                                        "entry_id": "04a96dc5-2f91-30e6-9259-ac42d22c500b",
                                        "glosses": [
                                            "A group of people at a table, for example, for a meal, meeting or game.",
                                            "A group of diners at a given table or tables."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4f1acb6-9138-4ac7-b939-63eba20ae11b",
                                                "sense_id": "b5659407-eaf0-32b6-877b-c5fbe20c2bca",
                                                "text": "Table 9 wants another round of beers."
                                            },
                                            {
                                                "example_id": "ac76ea6a-8b84-4b6b-aafe-83ca950414ed",
                                                "sense_id": "b5659407-eaf0-32b6-877b-c5fbe20c2bca",
                                                "text": "John always gets the best tips because he gets the best tables! It's not fair!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ffc806d-91b6-3ef9-aa39-1644b440384e",
                                        "entry_id": "04a96dc5-2f91-30e6-9259-ac42d22c500b",
                                        "glosses": [
                                            "A two-dimensional presentation of data.",
                                            "A matrix or grid of data arranged in rows and columns."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b066f6f-ba5c-4ee4-abaf-f70654a7736e",
                                                "sense_id": "5ffc806d-91b6-3ef9-aa39-1644b440384e",
                                                "text": "I’m using mathesis — a universal science of measurement and order …\nAnd there is also taxinomia a principle of classification and ordered tabulation.\nKnowledge replaced universal resemblance with finite differences. History was arrested and turned into tables …\nWestern reason had entered the age of judgement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a2d24a9-cdc3-3669-b3b2-c957b4dd289b",
                                        "entry_id": "04a96dc5-2f91-30e6-9259-ac42d22c500b",
                                        "glosses": [
                                            "A two-dimensional presentation of data.",
                                            "A collection of arithmetic calculations arranged in a table, such as multiplications in a multiplication table."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a759ea09-b631-4c4e-8212-d0395235fecf",
                                                "sense_id": "3a2d24a9-cdc3-3669-b3b2-c957b4dd289b",
                                                "text": "The children were practising multiplication tables."
                                            },
                                            {
                                                "example_id": "58c0d9e0-6c9b-455f-b3e8-0833a068ade8",
                                                "sense_id": "3a2d24a9-cdc3-3669-b3b2-c957b4dd289b",
                                                "text": "Don’t you know your tables?"
                                            },
                                            {
                                                "example_id": "773fc819-bdef-4604-8aca-364ad710223b",
                                                "sense_id": "3a2d24a9-cdc3-3669-b3b2-c957b4dd289b",
                                                "text": "Here is a table of natural logarithms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aac7e590-6424-32e7-ac68-6b5553d0552b",
                                        "entry_id": "04a96dc5-2f91-30e6-9259-ac42d22c500b",
                                        "glosses": [
                                            "A two-dimensional presentation of data.",
                                            "A lookup table, most often a set of vectors."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8385f440-280a-3704-85a6-420887d1de82",
                                        "entry_id": "04a96dc5-2f91-30e6-9259-ac42d22c500b",
                                        "glosses": [
                                            "A two-dimensional presentation of data.",
                                            "A visual representation of a classification of teams or individuals based on their success over a predetermined period."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a12d3dc0-7662-4f7e-a3bd-6a6501650a4a",
                                                "sense_id": "8385f440-280a-3704-85a6-420887d1de82",
                                                "text": "On this evidence they will certainly face tougher tests, as a depleted Newcastle side seemed to bask in the relative security of being ninth in the table."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d891d8a-74dc-39d7-9d8f-48ae8c4e7572",
