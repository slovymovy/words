    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "97ffbbc6-686e-3868-9318-3272f5f6b59b",
                    "sense_definition": "Troupe ou groupe d'animaux sauvages vivant ensemble, particulièrement de grands herbivores comme les cerfs ou les sangliers.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "troupe_animale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au détour du sentier forestier, nous avons aperçu une <w>harde</w> de cerfs traversant paisiblement la clairière."
                        },
                        {
                            "text": "Les gardes forestiers ont suivi les traces fraîches laissées dans la neige par une grande <w>harde</w> de sangliers."
                        }
                    ],
                    "synonyms": [
                        "troupeau"
                    ],
                    "common_phrases": [
                        "une harde de cerfs",
                        "une harde de sangliers"
                    ]
                },
                {
                    "sense_id": "4f4918f0-0519-3eba-b0ba-0fc8e7757312",
                    "sense_definition": "Vêtement vieux, pauvre ou usagé, le plus souvent employé au pluriel pour désigner des effets personnels misérables.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vetement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le mendiant marchait sous la pluie battante, grelottant sous sa misérable <w>harde</w> déchirée."
                        },
                        {
                            "text": "Avant de fuir la demeure en ruine, elle rassembla rapidement ses vieilles <w>hardes</w> dans un panier."
                        }
                    ],
                    "synonyms": [
                        "guenille",
                        "haillon"
                    ],
                    "common_phrases": [
                        "vieilles hardes"
                    ]
                },
                {
                    "sense_id": "f8438118-fe71-3fe2-b6d5-bec2f9915866",
                    "sense_definition": "Groupe de chiens de chasse attachés ensemble par quatre ou six.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "troupe_animale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le piqueur maintenait fermement la <w>harde</w> de chiens avant le signal du départ de la chasse."
                        },
                        {
                            "text": "Les valets ont détaché la <w>harde</w> pour lancer la meute sur la piste du cerf."
                        }
                    ],
                    "synonyms": [
                        "meute"
                    ]
                },
                {
                    "sense_id": "2170771d-1408-30ab-97fe-944913ae1195",
