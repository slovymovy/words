                "translations": [
                    {
                        "translation_id": "ca067f71-379f-4520-b48c-1afd505f17c2",
                        "source_entry_id": "3adf5bc4-8067-3423-b3d2-0586dd1eb4c9",
                        "source_sense_id": "90514a4c-d091-3b13-9114-6a01f372639d",
                        "source_sense_description": "van de heidenen",
                        "target_lang_word": "heidnisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heidnisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "47d1e3c7-cdb2-3721-93e4-f1033f1cfb76",
                                        "entry_id": "737015a9-271b-3afa-873f-db3d8449e242",
                                        "glosses": [
                                            "die Heiden betreffend, charakteristisch für Heiden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad564573-158f-4d42-94ad-ecfd6b798e1a",
                                                "sense_id": "47d1e3c7-cdb2-3721-93e4-f1033f1cfb76",
                                                "text": "\"So etwa das Osterreiten: Dieser Brauch hat - wie so viele - einen heidnischen Ursprung.\""
                                            },
                                            {
                                                "example_id": "5ef74f42-89cf-4d9e-9f00-647236d41f3b",
                                                "sense_id": "47d1e3c7-cdb2-3721-93e4-f1033f1cfb76",
                                                "text": "„Die verfolgten Christen wurden gezwungen, wenn sie nicht untergehen wollten, sich zu organisieren, neue Kraft zu schöpfen und den Kampf gegen die heidnische Militanz anzunehmen.“"
                                            },
                                            {
                                                "example_id": "ab49ff7b-828f-4405-92aa-78762a8fbc64",
                                                "sense_id": "47d1e3c7-cdb2-3721-93e4-f1033f1cfb76",
                                                "text": "„In Kiew lässt der Konvertit nun alle heidnischen Götterbilder und Statuen zerschlagen oder ins Feuer werfen und befiehlt zudem seinen Untertanen, sich am Ufer des Dnjepr zu einer Massentaufe einzufinden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "924c0289-0b1c-446e-9349-7890414434a5",
                        "source_entry_id": "3adf5bc4-8067-3423-b3d2-0586dd1eb4c9",
                        "source_sense_id": "90514a4c-d091-3b13-9114-6a01f372639d",
                        "source_sense_description": "van de heidenen",
                        "target_lang_word": "pagan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pagan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06aa91ce-6797-317e-af62-13ca97f1f9b8",
                                        "entry_id": "908fb89f-9b33-3c73-8808-e08604feaf47",
                                        "glosses": [
                                            "Relating to, characteristic of religions that differ from main world religions."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5cba8102-3d3a-4827-b471-ef6ab21b580a",
                                                "sense_id": "06aa91ce-6797-317e-af62-13ca97f1f9b8",
                                                "text": "Under Christianization, many converted societies transformed their pagan deities into saints."
                                            },
                                            {
                                                "example_id": "be2a0d03-64a6-48e5-a26d-4d4e1553b870",
                                                "sense_id": "06aa91ce-6797-317e-af62-13ca97f1f9b8",
                                                "text": "Black metal is a subgenre of heavy metal music that typically takes on anti-Christian, satanic and pagan themes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca4384c1-6575-3a95-ac49-867587e3069f",
                                        "entry_id": "908fb89f-9b33-3c73-8808-e08604feaf47",
                                        "glosses": [
                                            "Savage, immoral, uncivilized, wild."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "derogatory",
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "pagan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16039b3b-7303-3bf7-9661-88202b830c4e",
                                        "entry_id": "e5b058e1-d2e6-3997-8485-58f006a5ca59",
                                        "glosses": [
                                            "A person not adhering to a main world religion; a follower of a pantheistic or nature-worshipping religion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9988a6fe-6fc1-49ca-a05c-1d20ffc269e1",
                                                "sense_id": "16039b3b-7303-3bf7-9661-88202b830c4e",
                                                "text": "This community has a surprising number of pagans."
                                            }
                                        ]
                                    },
                                    {
