                "forms": [],
                "senses": [
                    {
                        "sense_id": "2114cf61-9726-3719-b8cf-6d0b9b548fc5",
                        "entry_id": "2b28e9d7-475e-393d-8fea-9633eb697f36",
                        "glosses": [
                            "alle, alle zusammen, bei allen, für alle; alle einer Gruppe, einer Runde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1198efdf-d8dc-4556-9581-95bc41de4fcd",
                                "sense_id": "2114cf61-9726-3719-b8cf-6d0b9b548fc5",
                                "text": "Ich wünsche allerseits einen angenehmen Aufenthalt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "94f47812-22f8-4123-908d-695598e077ed",
                        "source_entry_id": "2b28e9d7-475e-393d-8fea-9633eb697f36",
                        "source_sense_id": "2114cf61-9726-3719-b8cf-6d0b9b548fc5",
                        "source_sense_description": "alle, alle zusammen, bei allen, für alle; alle einer Gruppe, einer Runde",
                        "target_lang_word": "tout le monde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tout le monde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fa4455ed-b7cb-37e1-bbf7-6253a4b05114",
                                        "entry_id": "1a5caf55-d12b-3d1f-bb51-1ca7bda32cdd",
                                        "glosses": [
                                            "Toutes les personnes d’un ensemble donné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f43e5f1-dfa1-422e-a2b1-449cb9ab2ff4",
                                                "sense_id": "fa4455ed-b7cb-37e1-bbf7-6253a4b05114",
                                                "text": "Une autre fatalité pesait sur les Rabalan : ils se suicidaient. Depuis cent ans, on ne connaissait pas un seul Rabalan qui fût mort, comme tout le monde, dans son lit, de mort naturelle."
                                            },
                                            {
                                                "example_id": "904113c7-bb25-494e-89f2-98269d4d3c95",
                                                "sense_id": "fa4455ed-b7cb-37e1-bbf7-6253a4b05114",
                                                "text": "Les immenses succès obtenus par la civilisation matérielle ont fait croire que le bonheur se produirait tout seul, pour tout le monde, dans un avenir tout prochain."
                                            },
                                            {
                                                "example_id": "3e621a8f-f45b-4411-b8d5-1f8bf5dc52a4",
                                                "sense_id": "fa4455ed-b7cb-37e1-bbf7-6253a4b05114",
                                                "text": "Si les trois villages se soulevaient et qu’on tuât deux ou trois gendarmes, guillotinerait-on tout le monde ?"
                                            },
                                            {
                                                "example_id": "7db06f76-0238-41d5-94ca-d0d3974b991d",
                                                "sense_id": "fa4455ed-b7cb-37e1-bbf7-6253a4b05114",
                                                "text": "Toilette du bataillon. Le barbier passe pour particulièrement francophile. Tout le monde va se raser chez lui."
                                            },
                                            {
                                                "example_id": "97278878-44f6-46cf-bf43-4d38ba67e2e2",
                                                "sense_id": "fa4455ed-b7cb-37e1-bbf7-6253a4b05114",
                                                "text": "Le repas était, comme toujours en Polynésie, une affaire très sérieuse et tout le monde mangeait en silence."
                                            },
                                            {
                                                "example_id": "71de622b-0a12-4f84-b7fa-af94bcaf9971",
                                                "sense_id": "fa4455ed-b7cb-37e1-bbf7-6253a4b05114",
                                                "text": "De leur balcon qu'on atteignait par une échelle,, les musiciens déversaient sans répit sur la foule, des airs de valse, de java, de shimmy, de charleston et tout le monde se trémoussait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d8ed968-865f-3324-bcb5-715671504e1d",
                                        "entry_id": "1a5caf55-d12b-3d1f-bb51-1ca7bda32cdd",
                                        "glosses": [
                                            "Toutes les parties prenantes d'une affaire."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a730bb1-1a12-454f-926d-3a2f841fa6ff",
                                                "sense_id": "1d8ed968-865f-3324-bcb5-715671504e1d",
                                                "text": "La proposition rallia tout le monde et l’on se mit en devoir d’en réaliser l’exécution ; […]."
                                            },
                                            {
                                                "example_id": "fbacb302-bae0-44bd-a002-c9ab32b80116",
                                                "sense_id": "1d8ed968-865f-3324-bcb5-715671504e1d",
                                                "text": "Le vin vaut ce qu’il vaut, mais Marthe le touche à bon prix et comme la clientèle est soiffarde, tout le monde est content."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98284435-47cc-49c8-a0fd-9cc0a3d80856",
                        "source_entry_id": "2b28e9d7-475e-393d-8fea-9633eb697f36",
                        "source_sense_id": "2114cf61-9726-3719-b8cf-6d0b9b548fc5",
                        "source_sense_description": "alle, alle zusammen, bei allen, für alle; alle einer Gruppe, einer Runde",
                        "target_lang_word": "tous",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tous",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fc6e47ef-793c-32ca-bccf-ee185fa62f35",
                                        "entry_id": "8dcb5454-5403-3fde-b678-717619e41ae8",
                                        "glosses": [
                                            "Masculin pluriel de tout."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f44030ed-e6a2-41e9-8018-c7a434b51c04",
                                                "sense_id": "fc6e47ef-793c-32ca-bccf-ee185fa62f35",
                                                "text": "Et ne voit-on pas, en plein vingtième siècle que nous sommes, s’agiter et pérambuler des suffisances harnachées de tous les hochets flatteurs, mais dont la seule prétention constitue le mérite, des faux-cols éblouissants surmontés d’officielle sottise et, de-ci de-là, quelques gredins dont s’adorne le blason tel que le définissait Aurélien Scholl : « de galons d’or sur champs d’habits ! »."
                                            },
                                            {
                                                "example_id": "1f019331-203a-42e1-8363-bac2f328033d",
                                                "sense_id": "fc6e47ef-793c-32ca-bccf-ee185fa62f35",
                                                "text": "Il a parcouru tous les États-Unis."
                                            },
                                            {
                                                "example_id": "f17a43b1-1936-491c-8af0-76a1ffdedef0",
                                                "sense_id": "fc6e47ef-793c-32ca-bccf-ee185fa62f35",
                                                "text": "Lettre à tous ceux qui aiment l’école."
                                            },
                                            {
                                                "example_id": "9f920421-77c1-42f7-a5c0-23fa48ceee14",
                                                "sense_id": "fc6e47ef-793c-32ca-bccf-ee185fa62f35",
                                                "text": "Entre amis tous biens sont communs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tous",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b8479070-6531-3593-a35f-5176171d99bd",
                                        "entry_id": "6a81ef11-82b3-3051-8a44-d3f0c7378e9c",
                                        "glosses": [
                                            "Masculin pluriel de tout."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3919040-0f9f-4382-a16f-b7a2dfe38915",
                                                "sense_id": "b8479070-6531-3593-a35f-5176171d99bd",
                                                "text": "Et tous, me voyant en bons termes avec le maître tout-puissant, sont pour moi pleins d’amabilité et de prévenances."
                                            },
                                            {
                                                "example_id": "ee0c94ba-9ade-4b37-ae85-0aa880c675e1",
                                                "sense_id": "b8479070-6531-3593-a35f-5176171d99bd",
                                                "text": "Le long des boutiques éclairées, des ombres se succédaient sans hâte. Il y avait des nègres, quelques Chinois, des blancs. Tous reluquaient les filles."
                                            },
                                            {
                                                "example_id": "3d2c7070-19af-4180-a490-42fa4fd5ec66",
                                                "sense_id": "b8479070-6531-3593-a35f-5176171d99bd",
                                                "text": "Les géants de l’acier ont détrôné les rois du pétrole en 2004. […]. Les dix hommes d'affaires qui se sont le plus enrichis l'an dernier détiennent tous des parts dans les sociétés métallurgiques."
                                            },
                                            {
                                                "example_id": "602614c5-c879-4b15-b973-6863260ea905",
                                                "sense_id": "b8479070-6531-3593-a35f-5176171d99bd",
                                                "text": "Nous tous. Vous tous. Eux tous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b1a9267-1da0-3521-aff2-af029e3c158f",
                                        "entry_id": "6a81ef11-82b3-3051-8a44-d3f0c7378e9c",
                                        "glosses": [
                                            "Tout le monde. — Note d’usage : Il est, dans ce cas, utilisé seulement comme sujet."
                                        ],
                                        "tags": [
                                            "form-of",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fc7c6eb-8e84-43e7-a6f3-0dfa3837aad5",
                                                "sense_id": "6b1a9267-1da0-3521-aff2-af029e3c158f",
                                                "text": "La Perse n’a point de caste. Tous sont égaux chez elle au point de vue religieux."
                                            },
                                            {
                                                "example_id": "73cd7f1f-9a0d-4d76-9f2a-2e5efbd16014",
                                                "sense_id": "6b1a9267-1da0-3521-aff2-af029e3c158f",
                                                "text": "De même si beaucoup, si la plupart, pour ne pas dire tous, négligeaient depuis de longues années leur devoir pascal, il ne s’en trouvait pas un qui, à l’heure dernière, n’appelât à son chevet ce brave vieux bougre qui les avait vus vivre […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
