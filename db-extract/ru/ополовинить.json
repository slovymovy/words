                "senses": [
                    {
                        "sense_id": "1a8ad0de-0ca5-3782-a524-836e89fe5f59",
                        "entry_id": "81e05064-3d9f-3812-94f3-f0c4915505a6",
                        "glosses": [
                            "уменьшить что-либо наполовину; уничтожить половину чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5814a0d-ce70-4d58-a1fe-9eb6e8794c06",
                                "sense_id": "1a8ad0de-0ca5-3782-a524-836e89fe5f59",
                                "text": "Ополовинить кружку молока."
                            },
                            {
                                "example_id": "6f4839ed-e835-454f-af9e-b3f8f60b9c78",
                                "sense_id": "1a8ad0de-0ca5-3782-a524-836e89fe5f59",
                                "text": "Ополовинить стадо."
                            },
                            {
                                "example_id": "ddda5d67-75e1-410e-b561-0a469a5e5213",
                                "sense_id": "1a8ad0de-0ca5-3782-a524-836e89fe5f59",
                                "text": "Он уже ополовинил фруктовую вазу и пришел в благодушное состояние."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5645b265-a443-4db9-9605-e970850316cb",
                        "source_entry_id": "81e05064-3d9f-3812-94f3-f0c4915505a6",
                        "source_sense_id": "1a8ad0de-0ca5-3782-a524-836e89fe5f59",
                        "target_lang_word": "halve",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "halve",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4349e99-ec75-30e5-b23b-7edf116b4645",
                                        "entry_id": "5cdfe89c-dbbb-3c25-b7dc-7fac00e0b7e7",
                                        "glosses": [
                                            "To reduce to half the original amount."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c9d6ae4-feaa-4890-8e64-2b61c034c251",
                                                "sense_id": "b4349e99-ec75-30e5-b23b-7edf116b4645",
                                                "text": "These show that since 1946 the fatality rate in train and movement accidents combined has been halved, [...]."
                                            },
                                            {
                                                "example_id": "88ac3d58-aed6-40b8-95ac-cc8a97a5e38e",
                                                "sense_id": "b4349e99-ec75-30e5-b23b-7edf116b4645",
                                                "text": "The difficulty of each puzzle would increase as the number of miners increased, which would keep production to one block of transactions roughly every 10 minutes. In addition, the size of each block bounty would halve every 210,000 blocks—first from 50 bitcoins to 25, then from 25 to 12.5, and so on. Around the year 2140, the currency would reach its preordained limit of 21 million bitcoins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cfb5614-e4b7-3590-a375-222d410ff78b",
                                        "entry_id": "5cdfe89c-dbbb-3c25-b7dc-7fac00e0b7e7",
                                        "glosses": [
                                            "To divide into two halves."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4c26618f-0560-3dc4-b436-4cad4747f022",
                                        "entry_id": "5cdfe89c-dbbb-3c25-b7dc-7fac00e0b7e7",
                                        "glosses": [
                                            "To make up half of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fcdd9af-ce96-4030-8b0c-39d88cab58da",
                                                "sense_id": "4c26618f-0560-3dc4-b436-4cad4747f022",
                                                "text": "So far apart their lives are thrown / From the twin soul that halves their own."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b71ee1f6-8c6e-39c6-aa70-f48ac7de30ce",
                                        "entry_id": "5cdfe89c-dbbb-3c25-b7dc-7fac00e0b7e7",
                                        "glosses": [
                                            "To join two pieces of timber etc. by cutting away each for half its thickness at the joining place, and fitting together."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "775b5be6-93d8-3892-a73e-f8a901e6eb39",
                                        "entry_id": "5cdfe89c-dbbb-3c25-b7dc-7fac00e0b7e7",
                                        "glosses": [
                                            "In match play, to achieve a tie or draw on."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1e7c957-0a9c-423c-ac92-8cade081ac60",
                                                "sense_id": "775b5be6-93d8-3892-a73e-f8a901e6eb39",
                                                "text": "I, of course, had no difficulty in doing likewise, and we halved the hole; but the awkward fact remained that I must now gain every hole to win the match, for my opponent's score was \"nine up,\" and there only remained ten holes to play."
                                            },
                                            {
                                                "example_id": "dc460474-4575-4481-bac1-9125c7d2ad41",
                                                "sense_id": "775b5be6-93d8-3892-a73e-f8a901e6eb39",
                                                "text": "All that counts is whether you won, lost, or halved the match."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
