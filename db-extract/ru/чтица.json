                ],
                "senses": [
                    {
                        "sense_id": "76fde5b7-51bb-39f9-a4e0-25a942303d6b",
                        "entry_id": "66b3fded-c4b2-3492-8bb1-5101d5f8b315",
                        "glosses": [
                            "женск. к чтец"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f24bbdf-e258-481c-97f1-4872a9ca9576",
                                "sense_id": "76fde5b7-51bb-39f9-a4e0-25a942303d6b",
                                "text": "Приходит чтица и читает бабке нравоучительные истории по книге."
                            },
                            {
                                "example_id": "2eed71e1-4e56-481f-9b71-ceb5789e8c61",
                                "sense_id": "76fde5b7-51bb-39f9-a4e0-25a942303d6b",
                                "text": "Звезда русской декламации, уже не первый год сияющая на провинциальной филармонической сцене, прима-чтица, случайно посетившая этот лучший из миров, хрупкая Нина Реут!"
                            },
                            {
                                "example_id": "144552ab-e895-48a9-9c74-e1dfe3f9ec74",
                                "sense_id": "76fde5b7-51bb-39f9-a4e0-25a942303d6b",
                                "text": "Тем не менее он часто пользовался Нелей как чтицей, хотя его и раздражала её манера чтения."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "88e6be90-b396-4019-93d5-9729e3197d90",
                        "source_entry_id": "66b3fded-c4b2-3492-8bb1-5101d5f8b315",
                        "source_sense_id": "76fde5b7-51bb-39f9-a4e0-25a942303d6b",
                        "target_lang_word": "Leserin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leserin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "52924f13-8ad2-3f8a-8472-9236a9f5ce6d",
                                        "entry_id": "ba6776fd-52dd-37a8-9d46-b331681a144c",
                                        "glosses": [
                                            "weibliche Person, die liest"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6088d565-7755-419c-bcb7-cc9dbcfa62a9",
                                                "sense_id": "52924f13-8ad2-3f8a-8472-9236a9f5ce6d",
                                                "text": "Sein neuer Roman hat viele begeisterte Leserinnen gefunden."
                                            },
                                            {
                                                "example_id": "dc45d83e-742a-47e9-91ec-14b32224d14c",
                                                "sense_id": "52924f13-8ad2-3f8a-8472-9236a9f5ce6d",
                                                "text": "„Dies ist den Leserinnen und Lesern dieser Zeitschrift sicher mehr als bekannt.“"
                                            },
                                            {
                                                "example_id": "f0d25ab4-469a-4acd-bb3c-1441ea0092d9",
                                                "sense_id": "52924f13-8ad2-3f8a-8472-9236a9f5ce6d",
                                                "text": "„Nehmen wir einmal an, sehr verehrte Leserin, sehr geehrter Leser, Sie seien ‚Sprachler‘ im genannten Sinne: Liebhaber und Kenner der deutschen Sprache.“"
                                            },
                                            {
                                                "example_id": "f29c2a23-650f-4d6b-ab58-fb83b02a9130",
                                                "sense_id": "52924f13-8ad2-3f8a-8472-9236a9f5ce6d",
                                                "text": "„Jede Leserin, jeder Leser wird eigene Erfahrungen und eigene Einschätzungen haben.“"
                                            },
                                            {
                                                "example_id": "a08c28ad-ba25-4607-8328-c611d185416a",
                                                "sense_id": "52924f13-8ad2-3f8a-8472-9236a9f5ce6d",
                                                "text": "„Ich vertröste die Leserin auf später.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
