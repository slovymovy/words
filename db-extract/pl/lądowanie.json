                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1aeff4d8-fede-37ed-95d2-d2baf649f80e",
                                        "entry_id": "dd92376e-c010-30f1-9c0d-df8b313a999a",
                                        "glosses": [
                                            "Fase final de un vuelo, que se define como el proceso que realiza una aeronave que culmina con el contacto del aparato con la tierra."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce460311-3cd8-4ecc-a63d-339665540ec8",
                                                "sense_id": "1aeff4d8-fede-37ed-95d2-d2baf649f80e",
                                                "text": "El aterrizaje del avión fue complicado por el fuerte viento."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38ad6746-bb7c-475b-9406-3fc25ad18085",
                        "source_entry_id": "7ebb05cf-28dc-3fba-be50-cf1bb2f0ff62",
                        "source_sense_id": "40f2ec4c-2d63-3da9-8f27-a0d9431248a1",
                        "target_lang_word": "посадка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "посадка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "549e1297-e579-318f-a283-9b5c77263656",
                                        "entry_id": "0e7ba85c-1109-3570-a768-269f77d180b1",
                                        "glosses": [
                                            "действие по значению гл. сажать, посадить; размещение саженцев, семян и т. п. в земле с целью выращивания"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "564adc17-9c86-4561-91e9-d7f1a4d45e86",
                                                "sense_id": "549e1297-e579-318f-a283-9b5c77263656",
                                                "text": "Я работаю от утра до ночи. Все прививки я делаю сам, обрезку — сам, посадки — сам, всё — сам."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efcbf448-b0c4-3dc2-8069-b3382d96a546",
                                        "entry_id": "0e7ba85c-1109-3570-a768-269f77d180b1",
                                        "glosses": [
                                            "результат такого действия; посаженные деревья, растения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15a9180c-e8f1-4e7f-8f66-980fd7a44c57",
                                                "sense_id": "efcbf448-b0c4-3dc2-8069-b3382d96a546",
                                                "text": "Зеленела трава, зеленели посадки в оголённых ещё огородах, и всё было так углублено в себя, так занято собою, так глубоко погружено в молчаливую творческую думу, что, если бы у травы и у деревьев было лицо, все лица были бы обращены к земле, все лица были бы задумчивы и чужды, все уста были бы скованы огромным бездонным молчанием."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81e0f26a-b45e-31a1-a0f4-48e166626c84",
                                        "entry_id": "0e7ba85c-1109-3570-a768-269f77d180b1",
                                        "glosses": [
                                            "впуск пассажиров в вагон поезда, в самолёт и т. п. для занятия мест"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24bfa09d-c10a-42c8-a733-b9bf514ca555",
                                                "sense_id": "81e0f26a-b45e-31a1-a0f4-48e166626c84",
                                                "text": "При посадке на авиарейс в Калгари устройство, призванное определять наличие металлических предметов у пассажиров, постоянно звенело, когда она проходила через него."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "132fca53-64db-3cc2-906c-fb7ac0c5dbda",
                                        "entry_id": "0e7ba85c-1109-3570-a768-269f77d180b1",
                                        "glosses": [
                                            "спуск на землю, приземление (о летательных аппаратах)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "829a1c34-9283-4598-954e-33d5b0b1124c",
                                                "sense_id": "132fca53-64db-3cc2-906c-fb7ac0c5dbda",
                                                "text": "На беду, мотор закапризничал, и мы сделали вынужденную посадку."
                                            },
                                            {
                                                "example_id": "0ea27795-c1f0-4998-a00a-c99e981ed90d",
                                                "sense_id": "132fca53-64db-3cc2-906c-fb7ac0c5dbda",
                                                "text": "На московском аэродроме совершил посадку шестиместный пассажирский самолёт, прилетевший из Крыма."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36170346-3f16-32cb-8fc6-e78a23a0442f",
                                        "entry_id": "0e7ba85c-1109-3570-a768-269f77d180b1",
                                        "glosses": [
                                            "манера или способ держаться в седле при езде верхом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c15db0f-fc88-4e48-aa46-a6181df5b3f6",
                                                "sense_id": "36170346-3f16-32cb-8fc6-e78a23a0442f",
                                                "text": "Я долго изучал горскую посадку: ничем нельзя так польстить моему самолюбию, как признавая моё искусство в верховой езде на кавказский лад."
                                            },
                                            {
                                                "example_id": "bcfeba5d-2097-4b49-99cb-440d9b91e01f",
                                                "sense_id": "36170346-3f16-32cb-8fc6-e78a23a0442f",
                                                "text": "Красивая голова её с выбившимися чёрными волосами из-под высокой шляпы, её полные плечи, тонкая талия в чёрной амазонке и вся спокойная грациозная посадка поразили Долли."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9000ef9b-7322-3d4c-8d34-ffcf288ea33b",
                                        "entry_id": "0e7ba85c-1109-3570-a768-269f77d180b1",
                                        "glosses": [
                                            "истор., ирон. лишение свободы, тюремное заключение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cae05e0-6beb-43b7-bb3a-dfa108d406af",
                                                "sense_id": "9000ef9b-7322-3d4c-8d34-ffcf288ea33b",
                                                "text": "Поступив на работу в Марфино и узнав, что Рубин, бывший коммунист, всюду похваляется, что остался им в душе, несмотря на посадку, — Мышин вызвал его на беседу о жизни вообще и о совместной работе в частности."
                                            }
                                        ]
                                    },
