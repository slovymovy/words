                            {
                                "example_id": "0c66cb93-104f-4302-95f8-ba6c45450ec0",
                                "sense_id": "6e70bb2e-2a69-3f20-ac1b-fd6c367aabe0",
                                "text": "[…] and partly platformish, that speech still reads true in fact and spirit. But \"not half the ordeal people make out\"? Mere bravado!"
                            },
                            {
                                "example_id": "ed490951-b075-4277-9d23-70bae695ac3e",
                                "sense_id": "6e70bb2e-2a69-3f20-ac1b-fd6c367aabe0",
                                "text": "[…] platformish, multiple product sort of existence, utilizes the new Macromedia Open Architecture (MOA), which is an application programming interface, or really more of a programming framework."
                            },
                            {
                                "example_id": "d257f721-ecf8-4738-bc54-b7baf3bb994a",
                                "sense_id": "6e70bb2e-2a69-3f20-ac1b-fd6c367aabe0",
                                "text": "It was more self-righteousness and dogmatic and platformish, more \"you have to do it this way, sister, you have to do it this way.\""
                            },
                            {
                                "example_id": "792c6517-9794-43c7-b470-e8804ad4b7b9",
                                "sense_id": "6e70bb2e-2a69-3f20-ac1b-fd6c367aabe0",
                                "text": "A jagged but platformish outcrop of rock just offshore made landing there feasible when Sydney Bay's prevailing winds prevented any thought of landing across the reef."
                            }
                        ]
                    }
