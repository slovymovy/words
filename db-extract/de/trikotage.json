                                "example_id": "cee97713-5b3d-4d93-b058-27e542ddd1b4",
                                "sense_id": "c9a36a6a-09d6-38fa-8b36-88b0fd716ea0",
                                "text": "„Schließlich gründete Johann 1929 in der Jäschkestraße 5 einen Texttilladen und konnte sich später sogar ein Lager mit Trikotagen und Webwaren leisten.“"
                            }
