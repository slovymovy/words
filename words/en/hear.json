{
    "word_family": [
        "hearer",
        "hearing",
        "hearsay",
        "overhear",
        "rehear"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ac00b4c3-a617-3e6f-9fec-379fca8aecf1",
                    "sense_definition": "To perceive sounds through the ear",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was deaf for many years, but now I can finally <w>hear</w> again.",
                            "target_lang_translations": {
                                "ru": "Я был глухим много лет, но теперь я наконец-то снова могу <w>слышать</w>."
                            }
                        },
                        {
                            "text": "Can you <w>hear</w> me clearly through this microphone?",
                            "target_lang_translations": {
                                "ru": "Ты меня хорошо <w>слышишь</w> через этот микрофон?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hear me clearly",
                        "can you hear"
                    ],
                    "target_lang_definitions": {
                        "ru": "Воспринимать звуки с помощью слуха"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слышать",
                                "target_lang_sense_clarification": "обладать слухом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a83078c-2db3-3f73-95fc-ea1e64a37bb1",
                    "sense_definition": "To perceive a specific sound or something producing a sound with the ear",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I could <w>hear</w> a loud noise coming from the kitchen downstairs.",
                            "target_lang_translations": {
                                "ru": "Я <w>слышал</w> громкий шум, доносившийся из кухни внизу."
                            }
                        },
                        {
                            "text": "Did you <w>hear</w> a loud noise just a few seconds ago?",
                            "target_lang_translations": {
                                "ru": "Ты <w>слышал</w> громкий шум несколько секунд назад?"
                            }
                        }
                    ],
                    "antonyms": [
                        "mishear"
                    ],
                    "common_phrases": [
                        "hear a noise",
                        "hear a sound"
                    ],
                    "target_lang_definitions": {
                        "ru": "Воспринимать конкретный звук или шум"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слышать",
                                "target_lang_sense_clarification": "воспринимать звук в данный момент"
                            },
                            {
                                "target_lang_word": "услышать",
                                "target_lang_sense_clarification": "уловить звук"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4eef236-ebb8-3a53-a77c-fc29aae4e909",
                    "sense_definition": "To receive information about something or to come to learn of it",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "information",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was surprised to <w>hear</w> the news about their sudden wedding.",
                            "target_lang_translations": {
                                "ru": "Я был удивлен, <w>услышав</w> новости об их внезапной свадьбе."
                            }
                        },
                        {
                            "text": "Did you <w>hear</w> the news about the new park opening?",
                            "target_lang_translations": {
                                "ru": "Ты <w>слышал</w> новости об открытии нового парка?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hear the news",
                        "hear about it"
                    ],
                    "target_lang_definitions": {
                        "ru": "Получать информацию о чем-либо или узнавать о чем-то"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слышать",
                                "target_lang_sense_clarification": "знать по слухам или новостям"
                            },
                            {
                                "target_lang_word": "услышать",
                                "target_lang_sense_clarification": "узнать новость"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be5d694a-a458-3b42-93b1-c043d7d53b10",
                    "sense_definition": "To be contacted by someone, usually via message, call, or letter",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I hope to <w>hear</w> from you soon regarding my job application.",
                            "target_lang_translations": {
                                "ru": "Надеюсь вскоре <w>получить</w> от вас <w>ответ</w> по поводу моего заявления о приеме на работу."
                            }
                        },
                        {
                            "text": "I expect to <w>hear</w> from you by tomorrow morning.",
                            "target_lang_translations": {
                                "ru": "Я ожидаю <w>вестей</w> от тебя к завтрашнему утру."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hear from you",
                        "hear from them"
                    ],
                    "target_lang_definitions": {
                        "ru": "Получать известия от кого-либо (через сообщение, звонок или письмо)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "получать известия",
                                "target_lang_sense_clarification": "иметь новости от кого-то"
                            },
                            {
                                "target_lang_word": "слышать",
                                "target_lang_sense_clarification": "в контексте «слышать о ком-то»"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1035b76b-c17a-3829-b82c-eeb1c85c1939",
                    "sense_definition": "To listen to someone or something intentionally",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>hear</w> what he has to say before making a decision.",
                            "target_lang_translations": {
                                "ru": "Тебе стоит <w>выслушать</w>, что он скажет, прежде чем принимать решение."
                            }
                        },
                        {
                            "text": "Please <w>hear</w> what I have to say before you leave.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>послушай</w>, что я хочу сказать, прежде чем уйдешь."
                            }
                        }
                    ],
                    "antonyms": [
                        "turn a deaf ear"
                    ],
                    "common_phrases": [
                        "hear what I say",
                        "hear the results"
                    ],
                    "target_lang_definitions": {
                        "ru": "Намеренно выслушивать кого-либо или что-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выслушать",
                                "target_lang_sense_clarification": "внимательно слушать до конца"
                            },
                            {
                                "target_lang_word": "послушать",
                                "target_lang_sense_clarification": "уделить внимание словам"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d782c5fc-e2cb-3235-b5b1-0dea7f036254",
                    "sense_definition": "To sympathize with or understand the feelings or opinion of another",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "understanding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You are frustrated with the slow internet speed? I <w>hear</w> you.",
                            "target_lang_translations": {
                                "ru": "Тебя расстраивает медленный интернет? Я тебя <w>понимаю</w>."
                            }
                        },
                        {
                            "text": "I <w>hear</w> you loud and clear regarding your concerns.",
                            "target_lang_translations": {
                                "ru": "Я прекрасно <w>понимаю</w> твои опасения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "I hear you",
                        "hear you loud"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used as 'I hear you' or 'I hear ya'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сопереживать или понимать чувства или мнение другого человека"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "понимать",
                                "target_lang_sense_clarification": "разделять точку зрения"
                            },
                            {
                                "target_lang_word": "слышать",
                                "target_lang_sense_clarification": "внимать аргументам"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4aee3a4b-41ff-3110-a9a3-c11b9b6708ad",
                    "sense_definition": "To listen to a person or a legal case in a court of law to make a judgment",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge will <w>hear</w> the case at the end of this month.",
                            "target_lang_translations": {
                                "ru": "Судья будет <w>слушать</w> дело в конце этого месяца."
                            }
                        },
                        {
                            "text": "The court will <w>hear</w> the case next Tuesday morning.",
                            "target_lang_translations": {
                                "ru": "Суд будет <w>рассматривать</w> дело в следующий вторник утром."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hear the case",
                        "hear the evidence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разбирать судебное дело или выслушивать показания в суде"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слушать",
                                "target_lang_sense_clarification": "о судебном заседании"
                            },
                            {
                                "target_lang_word": "разбирать",
                                "target_lang_sense_clarification": "рассматривать дело"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01fee725-b872-3b5b-b63e-225df1ece7ea",
                    "sense_definition": "To listen favorably to or to grant a request or prayer",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king finally decided to <w>hear</w> her humble entreaties for mercy.",
                            "target_lang_translations": {
                                "ru": "Король наконец решил <w>внять</w> ее смиренным мольбам о помиловании."
                            }
                        },
                        {
                            "text": "The lord will <w>hear</w> my prayer in times of trouble.",
                            "target_lang_translations": {
                                "ru": "Господь <w>услышит</w> мою молитву в трудные времена."
                            }
                        }
                    ],
                    "antonyms": [
                        "cock a deaf 'un"
                    ],
                    "common_phrases": [
                        "hear my prayer",
                        "hear her entreaties"
                    ],
                    "target_lang_definitions": {
                        "ru": "Благосклонно выслушать или удовлетворить просьбу или молитву"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "услышать",
                                "target_lang_sense_clarification": "откликнуться на просьбу"
                            },
                            {
                                "target_lang_word": "внимать",
                                "target_lang_sense_clarification": "высокий стиль, о молитве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e3f0fc5-880e-3221-9158-6f67b714d7d0",
                    "sense_definition": "To study under the instruction of a specific teacher or philosopher",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In his youth, the young scholar <w>heard</w> the famous philosopher in Athens.",
                            "target_lang_translations": {
                                "ru": "В юности молодой ученый <w>слушал</w> знаменитого философа в Афинах."
                            }
                        },
                        {
                            "text": "He <w>heard</w> the master for three years before starting his own school.",
                            "target_lang_translations": {
                                "ru": "Он <w>учился</w> у мастера три года, прежде чем основать свою школу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "heard the master",
                        "heard the philosopher"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in historical or academic contexts regarding discipleship"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Учиться под руководством конкретного учителя или философа"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слушать",
                                "target_lang_sense_clarification": "посещать лекции или уроки"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "09735bdf-f888-33c5-92a1-727f03577964",
                    "sense_definition": "Used at the end of a statement to ask for confirmation or to ensure the listener is paying attention",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "confirmation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You make sure to lock the front door when you leave, <w>hear</w>?",
                            "target_lang_translations": {
                                "ru": "Обязательно запри входную дверь, когда будешь уходить, <w>слышишь</w>?"
                            }
                        },
                        {
                            "text": "Y'all come back now, <w>hear</w>?",
                            "target_lang_translations": {
                                "ru": "Возвращайтесь поскорее, <w>поняли</w>?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "you hear",
                        "now hear"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "common in Southern American English"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "informal spoken tag"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется в конце предложения для подтверждения или привлечения внимания"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слышишь",
                                "target_lang_sense_clarification": "разговорная частица"
                            },
                            {
                                "target_lang_word": "понял",
                                "target_lang_sense_clarification": "для проверки понимания"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}