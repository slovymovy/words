{
    "word_family": [
        "scatterer",
        "scattered",
        "scattering",
        "scatterbrain"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6aa81beb-7355-3aba-a80d-91bc591dd761",
                    "sense_definition": "To cause people or things to separate and move in different directions.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police arrived and the crowd began to <w>scatter</w> in all directions.",
                            "target_lang_translations": {
                                "de": "Die Polizei traf ein und die Menge begann, sich in alle Richtungen zu <w>zerstreuen</w>."
                            }
                        },
                        {
                            "text": "The wind caused the dry leaves to <w>scatter</w> across the lawn.",
                            "target_lang_translations": {
                                "de": "Der Wind ließ die trockenen Blätter über den Rasen <w>verstreuen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "disperse",
                        "spread"
                    ],
                    "antonyms": [
                        "gather",
                        "assemble"
                    ],
                    "common_phrases": [
                        "scatter in all directions"
                    ],
                    "target_lang_definitions": {
                        "de": "Personen oder Dinge dazu bringen, sich zu trennen und in verschiedene Richtungen zu bewegen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "zerstreuen",
                                "target_lang_sense_clarification": "in verschiedene Richtungen auseinandertreiben"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9f802d7-0fe4-3721-bf10-797475cc0703",
                    "sense_definition": "To throw or drop things in different places over an area.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to <w>scatter</w> the flower seeds across the garden bed.",
                            "target_lang_translations": {
                                "de": "Sie beschloss, die Blumensamen im Gartenbeet zu <w>verstreuen</w>."
                            }
                        },
                        {
                            "text": "It is traditional to <w>scatter</w> rose petals at a wedding ceremony.",
                            "target_lang_translations": {
                                "de": "Es ist Tradition, bei einer Hochzeitszeremonie Rosenblätter zu <w>streuen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "sprinkle",
                        "strew"
                    ],
                    "common_phrases": [
                        "scatter seeds"
                    ],
                    "target_lang_definitions": {
                        "de": "Dinge an verschiedenen Orten über eine Fläche verteilen oder fallen lassen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verstreuen",
                                "target_lang_sense_clarification": "über eine Fläche verteilen"
                            },
                            {
                                "target_lang_word": "streuen",
                                "target_lang_sense_clarification": "pulvrige oder körnige Substanz werfen, damit sie sich verteilt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4f170f4-6a30-36dd-bb76-865e5f308ee9",
                    "sense_definition": "To leave a place quickly, often to avoid being caught.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When the alarm went off, the thieves decided to <w>scatter</w> immediately.",
                            "target_lang_translations": {
                                "de": "Als der Alarm losging, beschlossen die Diebe, sich sofort zu <w>zerstreuen</w>."
                            }
                        },
                        {
                            "text": "We had to <w>scatter</w> before the security guard saw us.",
                            "target_lang_translations": {
                                "de": "Wir mussten uns <w>zerstreuen</w>, bevor der Wachmann uns sah."
                            }
                        }
                    ],
                    "synonyms": [
                        "flee",
                        "bolt"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Einen Ort schnell verlassen, oft um einer Entdeckung zu entgehen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "sich zerstreuen",
                                "target_lang_sense_clarification": "in verschiedene Richtungen auseinandergehen"
                            },
                            {
                                "target_lang_word": "abhauen",
                                "target_lang_sense_clarification": "umgangssprachlich für schnell fliehen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c4f405c-eaa4-3031-9413-7ef72b80360d",
                    "sense_definition": "To cause light or particles to move in different directions after hitting a surface.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The atmosphere helps to <w>scatter</w> sunlight, which makes the sky appear blue.",
                            "target_lang_translations": {
                                "de": "Die Atmosphäre hilft dabei, das Sonnenlicht zu <w>streuen</w>, was den Himmel blau erscheinen lässt."
                            }
                        },
                        {
                            "text": "Rough surfaces tend to <w>scatter</w> light more than smooth, reflective ones.",
                            "target_lang_translations": {
                                "de": "Raue Oberflächen neigen dazu, Licht stärker zu <w>streuen</w> als glatte, reflektierende."
                            }
                        }
                    ],
                    "synonyms": [
                        "deflect",
                        "diffuse"
                    ],
                    "target_lang_definitions": {
                        "de": "Licht oder Teilchen dazu bringen, sich nach dem Auftreffen auf eine Oberfläche in verschiedene Richtungen zu bewegen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "streuen",
                                "target_lang_sense_clarification": "ablenken von Strahlung aus der ursprünglichen Richtung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f1bc8a7-3903-3122-9c5a-6d7ed3452085",
                    "sense_definition": "To cause plans or hopes to fail or be destroyed.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "failure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden news served to <w>scatter</w> all our carefully laid plans.",
                            "target_lang_translations": {
                                "de": "Die plötzliche Nachricht ließ all unsere sorgfältig ausgearbeiteten Pläne <w>zerstreuen</w>."
                            }
                        },
                        {
                            "text": "Unexpected obstacles can easily <w>scatter</w> even the most ambitious goals.",
                            "target_lang_translations": {
                                "de": "Unerwartete Hindernisse können selbst die ehrgeizigsten Ziele leicht <w>zerstreuen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "dash",
                        "ruin"
                    ],
                    "common_phrases": [
                        "scatter plans"
                    ],
                    "target_lang_definitions": {
                        "de": "Pläne oder Hoffnungen zum Scheitern bringen oder zerstören."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "zerstreuen",
                                "target_lang_sense_clarification": "durch Argumente oder Ereignisse beseitigen (z.B. Zweifel)"
                            },
                            {
                                "target_lang_word": "zunichtemachen",
                                "target_lang_sense_clarification": "Pläne oder Hoffnungen zerstören"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1c2e93ec-0470-3875-97e5-1152eb32863b",
                    "sense_definition": "A small number or amount of things spread over an area.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a <w>scatter</w> of houses along the quiet country road.",
                            "target_lang_translations": {
                                "de": "Es gab eine <w>Verstreuung</w> von Häusern entlang der ruhigen Landstraße."
                            }
                        },
                        {
                            "text": "The data showed a random <w>scatter</w> of points on the graph.",
                            "target_lang_translations": {
                                "de": "Die Daten zeigten eine zufällige <w>Verstreuung</w> von Punkten auf dem Diagramm."
                            }
                        }
                    ],
                    "synonyms": [
                        "sprinkling",
                        "scattering"
                    ],
                    "common_phrases": [
                        "scatter of points"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine kleine Anzahl oder Menge von Dingen, die über ein Gebiet verteilt sind."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Verstreuung",
                                "target_lang_sense_clarification": "das Vorhandensein von Dingen an verschiedenen Orten"
                            },
                            {
                                "target_lang_word": "Ansammlung",
                                "target_lang_sense_clarification": "eine lockere Verteilung von Objekten"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}