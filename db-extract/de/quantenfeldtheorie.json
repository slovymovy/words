                "senses": [
                    {
                        "sense_id": "2d59f013-8f03-3ccb-a14e-efc214d00ef9",
                        "entry_id": "b43544bd-4128-3073-b817-df3a33f266bf",
                        "glosses": [
                            "Gebiet, in dem Prinzipien klassischer Feldtheorien (zum Beispiel der klassischen Elektrodynamik) und der Quantenmechanik zur Bildung einer erweiterten Theorie kombiniert werden."
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "8c7604a7-292b-486c-8f3d-d44094965471",
                                "sense_id": "2d59f013-8f03-3ccb-a14e-efc214d00ef9",
                                "text": "„Auf der Quantenmechanik und ihren Begriffen bauen die weiterführenden Quantenfeldtheorien auf, angefangen mit der Quantenelektrodynamik ab ca. 1930, mit denen auch die Prozesse der Erzeugung und Vernichtung von Teilchen analysiert werden können.“"
                            },
                            {
                                "example_id": "4c49a4c4-534d-4603-8a38-d896e7f569e2",
                                "sense_id": "2d59f013-8f03-3ccb-a14e-efc214d00ef9",
                                "text": "„In Gestalt des Standardmodells der Elementarteilchenphysik bilden relativistische Quantenfeldtheorien das Rückgrat der heutigen Physik der kleinsten Teilchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
