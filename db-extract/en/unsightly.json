                ],
                "senses": [
                    {
                        "sense_id": "82aeec8d-de4a-39a1-9fe6-0543f6cf66d7",
                        "entry_id": "848d1593-206c-3ffd-8f64-445e199474a8",
                        "glosses": [
                            "Displeasing to the eye."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52747858-5dd3-4f21-a408-44fd9e177db7",
                                "sense_id": "82aeec8d-de4a-39a1-9fe6-0543f6cf66d7",
                                "text": "For example, by changing the use of existing rooms, removing or replacing unsightly features, clearing obstacles to easy circulation, rearranging direction signs and generally introducing as much order as possible, most outdated station buildings can be made reasonably efficient and attractive."
                            },
                            {
                                "example_id": "89b7cb07-1b86-4972-b9ca-00b447e594a6",
                                "sense_id": "82aeec8d-de4a-39a1-9fe6-0543f6cf66d7",
                                "text": "“She had grown used to the quick speech of these people, but she wished he would not lick his lips that way. It did not make him any harder to understand, but it was unsightly.\""
                            },
                            {
                                "example_id": "76225e2d-320e-4aea-90c4-46f3fd454737",
                                "sense_id": "82aeec8d-de4a-39a1-9fe6-0543f6cf66d7",
                                "text": "The removal of unsightly graffiti on the sides of railway bridges spanning major roads in the North West is to be handed over to National Highways, to speed up the job."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e075eda7-4698-430f-bde8-0391d1cff02a",
                        "source_entry_id": "848d1593-206c-3ffd-8f64-445e199474a8",
                        "source_sense_id": "82aeec8d-de4a-39a1-9fe6-0543f6cf66d7",
