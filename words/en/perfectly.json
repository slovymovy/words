                    "sense_id": "d019e1d9-3adc-3d0f-97a1-09a105b2e3af",
                    "sense_definition": "In a flawless or ideal manner; without any mistakes.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new suit fits him <w>perfectly</w>.",
                            "target_lang_translations": {
                                "ru": "Новый костюм сидит на нём <w>идеально</w>.",
                                "zh": "这套新西装他穿起来<w>恰好</w>合适。",
                                "nl": "Het nieuwe pak past hem <w>perfect</w>.",
                                "pl": "Nowy garnitur leży na nim <w>doskonale</w>.",
                                "de": "Der neue Anzug passt ihm <w>perfekt</w>.",
                                "fr": "Le nouveau costume lui va <w>parfaitement</w>.",
                                "it": "Il nuovo vestito gli sta <w>perfettamente</w>.",
                                "cs": "Ten nový oblek mu sedí <w>dokonale</w>.",
                                "tr": "Yeni takım elbise ona <w>tam</w> oldu.",
                                "es": "El traje nuevo le queda <w>perfectamente</w>."
                            }
                        },
                        {
                            "text": "The plan worked <w>perfectly</w> and we finished on time.",
                            "target_lang_translations": {
                                "ru": "План сработал <w>безупречно</w>, и мы закончили вовремя.",
                                "zh": "计划执行得<w>完美</w>，我们按时完成了。",
                                "nl": "Het plan werkte <w>perfect</w> en we waren op tijd klaar.",
                                "pl": "Plan zadziałał <w>perfekcyjnie</w> i skończyliśmy na czas.",
                                "de": "Der Plan hat <w>einwandfrei</w> funktioniert und wir sind rechtzeitig fertig geworden.",
                                "fr": "Le plan a fonctionné <w>parfaitement</w> et nous avons fini à temps.",
                                "it": "Il piano ha funzionato <w>perfettamente</w> e abbiamo finito in tempo.",
                                "cs": "Plán fungoval <w>bezchybně</w> a skončili jsme včas.",
                                "tr": "Plan <w>kusursuzca</w> işledi ve zamanında bitirdik.",
                                "es": "El plan funcionó <w>perfectamente</w> y terminamos a tiempo."
                            }
                        }
                    ],
                    "synonyms": [
