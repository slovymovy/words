                ],
                "senses": [
                    {
                        "sense_id": "f4e0ea7b-e83d-3e60-b0c7-56662b791168",
                        "entry_id": "23294977-cabb-38be-bcf7-afeda1598aa2",
                        "glosses": [
                            "Celui qui rabat le gibier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab264cf0-ed10-43ca-b9b7-dc3f467873e7",
                                "sense_id": "f4e0ea7b-e83d-3e60-b0c7-56662b791168",
                                "text": "Et moi je savais – mais par quelle connaissance ? – que le Noir qui avait été autrefois l’un des meilleurs rabatteurs de l’Afrique Orientale reprenait son ancien métier."
                            },
                            {
                                "example_id": "706ea401-5930-4138-a5fe-c6891aae625a",
                                "sense_id": "f4e0ea7b-e83d-3e60-b0c7-56662b791168",
                                "text": "Il y a trente ans que je chasse, et je n’ai jamais vu d’aussi mauvais rabatteurs !…"
                            }
                        ]
                    },
                    {
                        "sense_id": "4acd5857-7f76-3df1-a77d-d67db57c2cfd",
                        "entry_id": "23294977-cabb-38be-bcf7-afeda1598aa2",
                        "glosses": [
                            "Celui qui se charge d’amener, par divers moyens de propagande, des clients à une entreprise financière, des adhérents à un parti, des recrues à une armée, etc."
                        ],
                        "tags": [
                            "broadly",
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "79a8632c-f3d8-431e-be4c-7e4d500ffff8",
                                "sense_id": "4acd5857-7f76-3df1-a77d-d67db57c2cfd",
                                "text": "Cette photo a été retrouvée sur le GSM d'un rabatteur de drogues anversois. Relation de Jurgen Van Kamp."
                            }
                        ]
                    },
                    {
                        "sense_id": "fda52661-42d5-35f9-8e8b-25e36aa94927",
                        "entry_id": "23294977-cabb-38be-bcf7-afeda1598aa2",
                        "glosses": [
                            "Celui qui se charge d’amener, par divers moyens de propagande, des clients à une entreprise financière, des adhérents à un parti, des recrues à une armée, etc.",
                            "Celui qui recrute des prostituées."
                        ],
                        "tags": [
                            "broadly",
                            "especially",
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "0df3f409-f19e-4639-ab58-32b1c4900e4f",
                                "sense_id": "fda52661-42d5-35f9-8e8b-25e36aa94927",
                                "text": "La gare mène à Bruyères une autre profession : le rabatteur. Il vient en train dans les campagnes pour recruter des filles de 21 ans (alors la majorité légale)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2152a0d-67f2-4838-bf93-ca9403338b80",
                        "source_entry_id": "23294977-cabb-38be-bcf7-afeda1598aa2",
                        "source_sense_id": "f4e0ea7b-e83d-3e60-b0c7-56662b791168",
                        "source_sense_description": "Celui qui rabat le gibier.",
                        "target_lang_word": "honec",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a7f2d715-a19f-4d6e-98e4-cecea6fb47d3",
                        "source_entry_id": "23294977-cabb-38be-bcf7-afeda1598aa2",
                        "source_sense_id": "4acd5857-7f76-3df1-a77d-d67db57c2cfd",
                        "source_sense_description": "Celui qui se charge d’amener des clients à une entreprise",
                        "target_lang_word": "tout",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tout",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b332974-ecf8-3409-8339-bb2355737fff",
                                        "entry_id": "f2b2f75b-8b6b-3dfd-b206-35fed4b87362",
                                        "glosses": [
                                            "Someone advertising for customers in an aggressive way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1ebd076-ea17-4bfa-82fc-2102d9a56bcc",
                                                "sense_id": "3b332974-ecf8-3409-8339-bb2355737fff",
                                                "text": "Be careful of the ticket touts outside the arena; they are famed for selling counterfeits."
                                            },
                                            {
                                                "example_id": "d12cb040-fbf7-4c0b-8f38-1613cd6098c9",
                                                "sense_id": "3b332974-ecf8-3409-8339-bb2355737fff",
                                                "text": "Paul Muniment looked at his young friend a moment. 'Do you want to know what he is? He's a tout.'\n'A tout? What do you mean?'\n'Well, a cat's-paw, if you like better.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f7f4cc4-a520-32e7-9a82-5ceca2d23190",
                                        "entry_id": "f2b2f75b-8b6b-3dfd-b206-35fed4b87362",
                                        "glosses": [
                                            "A person at a racecourse who offers supposedly inside information on which horse is likely to win."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c66f83b9-acef-485e-992c-104111c6f0df",
                                                "sense_id": "1f7f4cc4-a520-32e7-9a82-5ceca2d23190",
                                                "text": "No one, however, would have anything to do with him, as Mr. Keeson's orders in those respects were very strict ; he had often threatened any one of his employés with instant dismissal if he found him in company with one of these touts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bc5ed54-e205-37e7-860a-744c023079e5",
                                        "entry_id": "f2b2f75b-8b6b-3dfd-b206-35fed4b87362",
                                        "glosses": [
                                            "An informer in the Irish Republican Army."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19dd2bd8-75ee-4b09-b559-1868b2ec5a8d",
                                                "sense_id": "3bc5ed54-e205-37e7-860a-744c023079e5",
                                                "text": "The Derry Brigade of the IRA thought it had got rid of its informer problem when earlier that year it executed Paddy Flood as a tout, after holding him for six weeks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7027380a-bfaa-3806-adc8-4a9a4d40cd89",
                                        "entry_id": "f2b2f75b-8b6b-3dfd-b206-35fed4b87362",
                                        "glosses": [
                                            "A spy for a smuggler, thief, or the like."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "colloquial"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "tout",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ceb35548-4d9b-3398-b0f0-03dc270a3b4b",
                                        "entry_id": "a2915110-4784-315b-8b41-386fad17a0e4",
                                        "glosses": [
                                            "To flaunt, to publicize/publicise; to boast or brag about; to promote."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34862473-be8b-46d6-bd82-a8b36f220032",
                                                "sense_id": "ceb35548-4d9b-3398-b0f0-03dc270a3b4b",
                                                "text": "Mary has been touted as a potential successor to the current CEO."
                                            },
                                            {
                                                "example_id": "99729c77-0f22-4bd7-8314-c0938fe2464a",
                                                "sense_id": "ceb35548-4d9b-3398-b0f0-03dc270a3b4b",
                                                "text": "China has touted its policy of non-interference for decades."
                                            },
                                            {
                                                "example_id": "ca8bc2bc-e9e8-4090-b918-0165e651d5da",
                                                "sense_id": "ceb35548-4d9b-3398-b0f0-03dc270a3b4b",
                                                "text": "For the 75 years since a district rebellion was put down, The Games have existed as an assertion of the Capital’s power, a winner-take-all contest that touts heroism and sacrifice—participants are called “tributes”— while pitting the districts against each other."
                                            },
                                            {
                                                "example_id": "ed429989-e7f4-4e5b-baa3-529fd8692820",
                                                "sense_id": "ceb35548-4d9b-3398-b0f0-03dc270a3b4b",
                                                "text": "Newspaper articles also were generally positive in tone, although a tendency towards sensationalism means that the spread of hybrid forms is occasionally touted as the universal language of the future."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "018bb542-db75-3cad-b8aa-49d944492ab3",
                                        "entry_id": "a2915110-4784-315b-8b41-386fad17a0e4",
                                        "glosses": [
                                            "To spy out information about (a horse, a racing stable, etc.)."
                                        ],
                                        "tags": [
                                            "UK",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f3a62f8-311c-3e2f-908b-43f63e5e772c",
                                        "entry_id": "a2915110-4784-315b-8b41-386fad17a0e4",
                                        "glosses": [
                                            "To give a tip on (a racehorse) to a person, with the expectation of sharing in any winnings."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0970cc2c-9dcb-3b04-b80f-37fe8f0554d6",
                                        "entry_id": "a2915110-4784-315b-8b41-386fad17a0e4",
                                        "glosses": [
                                            "To spy out the movements of racehorses at their trials, or to get by stealth or other improper means the secrets of the stable, for betting purposes."
                                        ],
                                        "tags": [
                                            "UK",
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1a3ec98a-8887-3c83-a4c5-336f457b3527",
                                        "entry_id": "a2915110-4784-315b-8b41-386fad17a0e4",
                                        "glosses": [
                                            "To act as a tout; to give a tip on a racehorse."
                                        ],
                                        "tags": [
                                            "US",
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "abd993f5-6726-3563-9379-e692418051d1",
                                        "entry_id": "a2915110-4784-315b-8b41-386fad17a0e4",
                                        "glosses": [
                                            "To look for, try to obtain; used with for."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d427a8e1-0618-4300-ae04-c7b65b1b64e7",
                                                "sense_id": "abd993f5-6726-3563-9379-e692418051d1",
                                                "text": "To understand the new London, I lived it. I slept rough with Roma beggars and touted for work with Baltic laborers on the kerb."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44434160-4615-3bca-b605-a5774e0a8c7c",
                                        "entry_id": "a2915110-4784-315b-8b41-386fad17a0e4",
                                        "glosses": [
                                            "To look upon or watch."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a10f50d7-7fc2-43c0-a542-bb1660af2a15",
                                                "sense_id": "44434160-4615-3bca-b605-a5774e0a8c7c",
                                                "text": "Nor durst Orcanes view the Soldan's face, / But still upon the floor did pore and tout."
                                            }
                                        ]
                                    }
                                ]
                            },
