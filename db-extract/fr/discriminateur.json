                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3e121f7-47ff-379c-9c86-2d0ec35b14a1",
                                        "entry_id": "d8e9dd2a-fc8e-3db6-9644-ed5f19efad06",
                                        "glosses": [
                                            "A person who discriminates, as:",
                                            "A person who differentiates things or concepts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d250dab4-ed88-49f2-895f-647d8b82301f",
                                                "sense_id": "d3e121f7-47ff-379c-9c86-2d0ec35b14a1",
                                                "text": "keen discriminator"
                                            },
                                            {
                                                "example_id": "c6163071-1fc1-4cef-8436-26a070bd7ee3",
                                                "sense_id": "d3e121f7-47ff-379c-9c86-2d0ec35b14a1",
                                                "text": "Generally, we may say, that Mr. Smith is a very accomplished etymological scholar, a very keen discriminator, and that his illustrative examples are selected with great industry, and from a wide field of English literature […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35b61246-7645-3224-9dc0-495b98c52350",
                                        "entry_id": "d8e9dd2a-fc8e-3db6-9644-ed5f19efad06",
                                        "glosses": [
                                            "A person who discriminates, as:",
                                            "A person who acts unfairly through prejudice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdc00bac-80ba-4ac7-bd2a-193bd49e8a09",
                                                "sense_id": "35b61246-7645-3224-9dc0-495b98c52350",
                                                "text": "I am not a discriminator"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4eb6a8be-49e2-36dd-884b-43f843cb8294",
                                        "entry_id": "d8e9dd2a-fc8e-3db6-9644-ed5f19efad06",
                                        "glosses": [
                                            "A test or variable, etc. that serves to distinguish between different things."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6477c1e1-b68d-4d16-8343-e8cede360180",
                                                "sense_id": "4eb6a8be-49e2-36dd-884b-43f843cb8294",
                                                "text": "Colour is not an effective discriminator when it comes to the spiciness of food."
                                            },
                                            {
                                                "example_id": "99289bce-1310-4e15-8b5c-c1f97fa01a7e",
                                                "sense_id": "4eb6a8be-49e2-36dd-884b-43f843cb8294",
                                                "text": "Moreover, the domainness variable also plays the role of weighting discriminators to balance the relatedness of the generated images to different domains. […] Taking semantic segmentation as an example, a typical way is to append a discriminator to the segmentation model, which is used to distinguish the source and target samples."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4265ef38-2e7a-321e-85ce-9a329af1ea89",
                                        "entry_id": "d8e9dd2a-fc8e-3db6-9644-ed5f19efad06",
                                        "glosses": [
                                            "Any of several electronic devices that convert some property of a signal into an amplitude whose value is proportional to the difference between the value of the input signal and that of a standard."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b72475ea-06b4-380d-a6bd-f9bcd346dfe6",
                                        "entry_id": "d8e9dd2a-fc8e-3db6-9644-ed5f19efad06",
                                        "glosses": [
                                            "A feature of the seller's offering that differs from a competitor's offering and is important to the buyer in question."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83d0959e-c0f1-487d-b145-89a143c531e7",
                                                "sense_id": "b72475ea-06b4-380d-a6bd-f9bcd346dfe6",
                                                "text": "An especially strong warranty can be a discriminator in some marketplaces."
                                            }
                                        ]
                                    }
                                ]
                            }
