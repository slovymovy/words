                        ]
                    },
                    {
                        "translation_id": "fd756afd-b9ff-43ec-bd8d-aa1d01c02f93",
                        "source_entry_id": "03f66cbb-adeb-336e-9547-f67d8af3ae7c",
                        "source_sense_id": "a6e70d83-553a-3c1b-9749-ee90bc52578b",
                        "target_lang_word": "généralisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "généralisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5759f409-4921-35eb-9d59-965aa28f0977",
                                        "entry_id": "470120d2-8ddc-3f8c-982d-65bf9ec32db1",
                                        "glosses": [
                                            "Action de généraliser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df86c9e6-ccea-49de-9f52-7165861b054f",
                                                "sense_id": "5759f409-4921-35eb-9d59-965aa28f0977",
                                                "text": "Des hommes tels que Galilée ou Carnot, qui possédaient à un degré extraordinaire cette Intelligence des Analogies, ont ainsi créé l’Énergétique par généralisations progressives, prudentes et hardies tout ensemble, de relations expérimentales et de réalités sensibles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92078935-cd37-3109-b118-7b6583ccf074",
                                        "entry_id": "470120d2-8ddc-3f8c-982d-65bf9ec32db1",
                                        "glosses": [
                                            "Diffusion."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c0d1882-1712-4781-be62-2724b37d5de9",
                                                "sense_id": "92078935-cd37-3109-b118-7b6583ccf074",
                                                "text": "Avant la généralisation des plumes métalliques, les plumes d'oie préparées à Auvillar étaient réputées. Mais allons nous pour ressusciter Auvillar réadopter la plume d'oie?"
                                            },
                                            {
                                                "example_id": "a0434e37-4926-41a3-8685-06f529ec5760",
                                                "sense_id": "92078935-cd37-3109-b118-7b6583ccf074",
                                                "text": "A l'avenir, l'efficacité de la ceinture de sécurité se trouvera encore accrue par un autre dispositif technique, sans doute appelé à connaître une généralisation progressive. Il s'agit du sac gonflable, sorte de coussin qui se déploie instantanément en cas d'accident pour s'interposer entre l'occupant et le tableau de bord, afin de le protéger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc843204-cb68-367f-8340-ebf52ad7c3d7",
                                        "entry_id": "470120d2-8ddc-3f8c-982d-65bf9ec32db1",
                                        "glosses": [
                                            "Action visant à susciter l’adhésion la plus large possible à des principes, des règles, des valeurs dominantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "540701b0-da95-4dba-a4b9-a05b0b5b5f39",
                                                "sense_id": "cc843204-cb68-367f-8340-ebf52ad7c3d7",
                                                "text": "La destruction des systèmes de réciprocité africains par la colonisation et la généralisation de la domination du marché capitaliste conduisent à l’ethnocide, à l’« économicide » et au génocide."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e1e3d16-c3b0-47e4-9a95-c55274ddfe8f",
                        "source_entry_id": "03f66cbb-adeb-336e-9547-f67d8af3ae7c",
                        "source_sense_id": "a6e70d83-553a-3c1b-9749-ee90bc52578b",
                        "target_lang_word": "synthèse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "synthèse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0e1cdca2-6507-3ca1-8f20-d713ec1d479b",
                                        "entry_id": "8571744d-b25c-32ee-8447-8ddb7e43b8c8",
                                        "glosses": [
                                            "Recomposition des éléments d’un tout, en particulier, de la thèse et de l'antithèse."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c18dfd2c-4fd1-41ca-b7a1-626c5cca93b2",
                                                "sense_id": "0e1cdca2-6507-3ca1-8f20-d713ec1d479b",
                                                "text": "Mais la géniale synthèse de Maxwell, si elle a changé l'idée que l'on se faisait de la nature des ondes lumineuses, a laissé intacte la croyance, commune dès lors à tous les physiciens, que la lumière est formée d'ondes où l'énergie est répartie de façon continue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbf3e577-ffde-3a2e-b437-84657eb58c7a",
                                        "entry_id": "8571744d-b25c-32ee-8447-8ddb7e43b8c8",
                                        "glosses": [
                                            "Action de composer un corps avec ses éléments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd05023d-476f-47ad-b787-f48fdd71f88c",
                                                "sense_id": "bbf3e577-ffde-3a2e-b437-84657eb58c7a",
                                                "text": "Une seconde partie mentionnait la synthèse de revêtements autoréparants à base de polymères fluorés sous champ magnétique oscillant."
                                            },
                                            {
                                                "example_id": "35a71331-97a4-484d-9491-9a490e7adc13",
                                                "sense_id": "bbf3e577-ffde-3a2e-b437-84657eb58c7a",
                                                "text": "Quelle que soit la méthode de synthèse utilisée, l’alcool γ-acétopropylique se sépare et se purifie par distillation sous vide (78-80°/5 mm Hg)."
                                            },
                                            {
                                                "example_id": "8d16169d-6dc5-4d81-9fd1-f355a8655a44",
                                                "sense_id": "bbf3e577-ffde-3a2e-b437-84657eb58c7a",
                                                "text": "Les chimistes organiciens, conscient de l’aspect ludique propre aux synthèses chimiques -[…]- se sont attelés par défi à la création d’hydrocarbures dont le squelette carboné correspond aux polyèdres régulier que sont les solides platoniques."
                                            }
                                        ]
                                    },
                                    {
