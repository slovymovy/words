                        "target_lang_word": "zureden",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zureden",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "46babe8d-cef7-388b-a941-60296d8f92e6",
                                        "entry_id": "9660b7df-306e-3d0a-a73b-e1edeb2e4592",
                                        "glosses": [
                                            "jemanden ansprechen und versuchen, ihn davon zu überzeugen, etwas Bestimmtes zu tun"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "feae5df4-4c5f-449c-bc84-2ac774dd415d",
                                                "sense_id": "46babe8d-cef7-388b-a941-60296d8f92e6",
                                                "text": "Jetzt wollen wir ihm gut zureden, damit er endlich zum Arzt geht."
                                            },
                                            {
                                                "example_id": "41c02a85-fb35-4eba-8cc8-06c8efd9cc27",
                                                "sense_id": "46babe8d-cef7-388b-a941-60296d8f92e6",
                                                "text": "„Er bedankte sich bei mir und bat mich, seine Frau aufzusuchen und ihr zuzureden, daß sie sich anders benehmen möchte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "266ce630-be18-4a30-8790-708837a4910e",
                        "source_entry_id": "790eb941-5696-34d2-a9ec-9951b2d33303",
                        "source_sense_description": "to persuade someone by using flattery; to cajole",
                        "target_lang_word": "угова́ривать",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "угова́ривать",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b31efb94-d84c-306b-99a7-af230b74ee22",
                                        "entry_id": "3e2e0d33-3f1a-3b49-9134-400c6374f9e3",
                                        "glosses": [
                                            "убеждать, заставлять согласиться с кем-либо или с чем-либо, склонять к чему-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b227cee5-43b6-4d46-b900-3c63103eec83",
                                                "sense_id": "b31efb94-d84c-306b-99a7-af230b74ee22",
                                                "text": "Меня все уговаривали последовать благому примеру, ― а пуще всех сердце; но зная, что завтра достанется мне в дежурство, я не мог и не хотел согласиться."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31f0d274-18a2-39ae-8070-4379a94f3d37",
                                        "entry_id": "3e2e0d33-3f1a-3b49-9134-400c6374f9e3",
                                        "glosses": [
                                            "устар. успокаивать, утешать"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef901db8-49b3-446d-9d0c-28a41e2911fa",
                                                "sense_id": "31f0d274-18a2-39ae-8070-4379a94f3d37",
                                                "text": "Вот эта девушка будто и плачет; а одна дама, такая почтенная, уговаривает ее и обнимает, а она все плачет; да и кавалер этот неспокоен: он все ходит будто в отчаянии; не знаю, тут что-то карета сделала."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f8e082d-bc0c-33a8-b139-b9c8e21a49ca",
                                        "entry_id": "3e2e0d33-3f1a-3b49-9134-400c6374f9e3",
                                        "glosses": [
                                            "перен., жарг. выпивать полностью (бутылку спиртного)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "215c603c-6271-4b51-8bb7-903791ca8b4b",
                                                "sense_id": "1f8e082d-bc0c-33a8-b139-b9c8e21a49ca",
                                                "text": "Они выпивали и закусывали. Иногда уговаривали целую бутылку. Принимались за песню."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
