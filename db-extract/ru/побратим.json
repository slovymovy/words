                    }
                ],
                "senses": [
                    {
                        "sense_id": "45049821-f087-3527-9f9f-dcbb2458cad0",
                        "entry_id": "37fb70b1-3743-3b24-bfe8-52bfa5dd250a",
                        "glosses": [
                            "тот, кто соединён с кем-либо побратимством, то есть традиционным обрядом закрепления дружбы с приравниванием её к братским отношениям"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b9062ca-49bb-4b47-b377-f12d934965a2",
                                "sense_id": "45049821-f087-3527-9f9f-dcbb2458cad0",
                                "text": "Вспомнятся старые обиды — запаханная ненароком межа, неподеленный улов, — и сосед подымает руку на соседа, побратим на побратима."
                            }
                        ]
                    },
                    {
                        "sense_id": "c701c1f2-c968-340d-8690-ca67b87a5f1a",
                        "entry_id": "37fb70b1-3743-3b24-bfe8-52bfa5dd250a",
                        "glosses": [
                            "самый близкий, самый лучший друг"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "84801488-9d81-36d7-adc7-1fa07d45633d",
                        "entry_id": "37fb70b1-3743-3b24-bfe8-52bfa5dd250a",
                        "glosses": [
                            "о ком-, чём-либо, находящемся между собой в дружеских связях, в сотрудничестве"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc21eda2-2575-4bbe-8d7e-d5d4dfb35a3b",
                        "source_entry_id": "37fb70b1-3743-3b24-bfe8-52bfa5dd250a",
                        "target_lang_word": "Blutsbruder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blutsbruder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "067b1967-c00e-37d6-8539-879db492cae6",
                                        "entry_id": "e992a79a-6023-3fd8-a627-cc4be0fe5fb0",
                                        "glosses": [
                                            "Person, mit der man stark befreundet ist und der man seine tiefe Verbundenheit durch Vermischung von Blut ausdrückt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5da47e8e-7a71-4bec-806c-dce59347b687",
                                                "sense_id": "067b1967-c00e-37d6-8539-879db492cae6",
                                                "text": "„Sie stammen aus einer Familie und sind Blutsbrüder oder Cousins.“"
                                            },
                                            {
                                                "example_id": "77a2c16e-4005-4d9b-96c0-1f11540ac8bd",
                                                "sense_id": "067b1967-c00e-37d6-8539-879db492cae6",
                                                "text": "„Aber der Holzinger ist ein Verräter, obwohl er doch eigentlich mein Blutsbruder ist, denn wir haben uns einmal die Hand aufgeschnitten und unser Blut mit Wasser vermischt und haben es getrunken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ef87ef9-4485-490e-af16-70397f02be6a",
                        "source_entry_id": "37fb70b1-3743-3b24-bfe8-52bfa5dd250a",
                        "target_lang_word": "frère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f02ecffb-5d65-34d5-a1da-12f70fb0a001",
                                        "entry_id": "8eb7a422-0282-3e08-b163-3950a7d40c03",
                                        "glosses": [
                                            "Homme ou garçon enfant du même père et de la même mère qu’un ou plusieurs autre(s) individu(s) ; membre masculin d’une adelphie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e524ea9-5e8e-4900-a860-d1f084280814",
                                                "sense_id": "f02ecffb-5d65-34d5-a1da-12f70fb0a001",
                                                "text": "J’avais neuf ans et j’attrapais avec mon frère des sauterelles que nous faisions griller dans le jardin pour les manger."
                                            },
                                            {
                                                "example_id": "913e796d-c47c-4ea6-9805-5b154ea2e59b",
                                                "sense_id": "f02ecffb-5d65-34d5-a1da-12f70fb0a001",
                                                "text": "Les pleins frères et pleines sœurs sont des individus qui ont à la fois le même père et la même mère. Ils partagent en moyenne la moitié des gènes de leurs parents."
                                            },
                                            {
                                                "example_id": "1f05a345-0ab8-4047-9352-ae16a3607de5",
                                                "sense_id": "f02ecffb-5d65-34d5-a1da-12f70fb0a001",
                                                "text": "Contrairement à ses frères, Joseph Antoine l’aîné, Vincent et Nicolas, les deux puînés, qui marchaient dans les pas de leur géniteur, Michele ne se voyait pas toute sa vie garder les chèvres et les mulets […]"
                                            },
                                            {
                                                "example_id": "74a0f07e-e6e9-4f48-b70d-eaada376824e",
                                                "sense_id": "f02ecffb-5d65-34d5-a1da-12f70fb0a001",
                                                "text": "— Maupattu était banni de la gent gloussante et caquetante, bien qu'il piaulât comme les autres et qu'il fût issu d'un œuf identique à celui des petits frères tant choyés et défendus par la maman."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fca84e8c-a670-339a-9c82-d475aa286fac",
                                        "entry_id": "8eb7a422-0282-3e08-b163-3950a7d40c03",
                                        "glosses": [
                                            "Tous les hommes en général comme étant tous sortis d’un même père et d’une même mère, comme étant tous de la même espèce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac6637ff-4888-4696-a188-51b49a46886f",
                                                "sense_id": "fca84e8c-a670-339a-9c82-d475aa286fac",
                                                "text": "Tous les hommes sont frères ; ils apportent, en naissant, des droits égaux aux avantages que la société procure. Ils ne diffèrent entre eux que par les facultés personnelles […]"
                                            },
                                            {
                                                "example_id": "fce1dc6a-bb57-45fb-89f8-fb73b37106ad",
                                                "sense_id": "fca84e8c-a670-339a-9c82-d475aa286fac",
                                                "text": "« Mais qui donc est mon frère », te demandes-tu ? En vérité, tout être humain qui tu croises sur ta route…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "487b7ffa-bcb2-3d86-9839-e129cc720500",
                                        "entry_id": "8eb7a422-0282-3e08-b163-3950a7d40c03",
                                        "glosses": [
                                            "Tous les chrétiens, comme étant tous enfants de Dieu par le baptême."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ae55af7-700b-400e-a0af-1084f78f2eb7",
                                                "sense_id": "487b7ffa-bcb2-3d86-9839-e129cc720500",
                                                "text": "Apprends, dit-il, que, dans cette maison, consacrée à Dieu et au saint ordre du Temple, une femme juive a été amenée par un frère en religion […]"
                                            },
                                            {
                                                "example_id": "d4a120e0-29fe-4c26-a02b-23f29757af5e",
                                                "sense_id": "487b7ffa-bcb2-3d86-9839-e129cc720500",
                                                "text": "— Mes bien chers frères, je n’aurai pas aujourd’hui la joie de poursuivre avec vous ces petits entretiens dominicaux dont nous avons la pieuse habitude."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61a2beaa-f132-3cb4-8966-6cba73d9a930",
                                        "entry_id": "8eb7a422-0282-3e08-b163-3950a7d40c03",
                                        "glosses": [
                                            "Compagnon d’une même cause."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9a1fbc4-e9ab-49f8-94df-f239852b6f28",
                                                "sense_id": "61a2beaa-f132-3cb4-8966-6cba73d9a930",
                                                "text": "Avec la fumée des incendies et du sang de nos frères, cette voix s’élève vers toi, Seigneur. C’est une plainte terrible, c’est un dernier soupir."
                                            },
                                            {
                                                "example_id": "d723a611-294b-4d1e-aa7a-f91f221e8f65",
                                                "sense_id": "61a2beaa-f132-3cb4-8966-6cba73d9a930",
                                                "text": "Sous le yeux de ses frères en Mars il voulait accomplir, disait-il, ce qui jusqu’ici avait été réservé à la puissance d’OG."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6437129c-f9dd-3bd2-951f-3c237cd9535a",
                                        "entry_id": "8eb7a422-0282-3e08-b163-3950a7d40c03",
                                        "glosses": [
                                            "Choses qui ont entre elles une ressemblance, une communauté au moins apparente. Utilisé seulement pour les noms masculins."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13ddb667-6b00-4bfd-aa72-358e284d8c4b",
                                                "sense_id": "6437129c-f9dd-3bd2-951f-3c237cd9535a",
                                                "text": "Les anciens poètes disaient que le sommeil est le frère de la mort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2316aaa-ae7e-37f1-8e60-d307fd1c60f1",
                                        "entry_id": "8eb7a422-0282-3e08-b163-3950a7d40c03",
                                        "glosses": [
                                            "Terme religieux marquant l’appartenance à un ordre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26f701e9-d7a2-45ef-90f6-8b58d22b360e",
                                                "sense_id": "d2316aaa-ae7e-37f1-8e60-d307fd1c60f1",
                                                "text": "[…] des frères de charité avec leurs dalmatiques rouges, dont l’un portait une bannière et l’autre la lourde croix d’argent, riaient en dessous, s’amusaient à se bourrer le dos de coups de poing."
                                            },
                                            {
                                                "example_id": "f738eb0f-c90b-4b32-98ff-b90b0a8d4ee0",
                                                "sense_id": "d2316aaa-ae7e-37f1-8e60-d307fd1c60f1",
                                                "text": "[…] quelqu’un aurait dit aux parents du gamin : « C’est bien fait pour vous ! Si vous l’aviez mis à l’école des Frères, on lui aurait fait apprendre son catéchisme, au lieu de lui faire perdre son temps à apprendre l’histoire et la géographie de la France »."
                                            },
                                            {
                                                "example_id": "9cd2234c-5754-4c30-bb56-01c7784edfa1",
                                                "sense_id": "d2316aaa-ae7e-37f1-8e60-d307fd1c60f1",
                                                "text": "Frère convers, frère lai. → voir convers et lai"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a426fd6b-4d19-3f4c-b18a-d06bcf747c60",
                                        "entry_id": "8eb7a422-0282-3e08-b163-3950a7d40c03",
                                        "glosses": [
                                            "Membre d’un clan, d'une confrérie, etc."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
