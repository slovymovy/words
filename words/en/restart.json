{
    "word_family": [
        "start",
        "starter",
        "restarter"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "324ff5e5-12ee-3986-b9ce-08e82c67ec41",
                    "sense_definition": "To start something again after it has stopped or been interrupted.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "general_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had to <w>restart</w> the meeting because the audio system failed.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось <w>начать</w> собрание <w>заново</w>, так как аудиосистема вышла из строя.",
                                "zh": "因为音频系统故障，我们不得不<w>重新开始</w>会议。"
                            }
                        },
                        {
                            "text": "The driver managed to <w>restart</w> the engine after it stalled in traffic.",
                            "target_lang_translations": {
                                "ru": "Водителю удалось <w>перезапустить</w> двигатель после того, как он заглох в пробке.",
                                "zh": "引擎在交通中熄火后，司机设法将其<w>重启</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "recommence",
                        "resume",
                        "reboot"
                    ],
                    "common_phrases": [
                        "restart the engine",
                        "restart negotiations",
                        "restart the game"
                    ],
                    "target_lang_definitions": {
                        "ru": "Начать что-то снова после остановки или перерыва.",
                        "zh": "在停止或中断后重新开始某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возобновить",
                                "target_lang_sense_clarification": "продолжить после перерыва"
                            },
                            {
                                "target_lang_word": "перезапустить",
                                "target_lang_sense_clarification": "запустить заново (двигатель, процесс)"
                            },
                            {
                                "target_lang_word": "начать снова",
                                "target_lang_sense_clarification": "начать с начала"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "重新开始",
                                "target_lang_sense_clarification": "从头开始"
                            },
                            {
                                "target_lang_word": "重启",
                                "target_lang_sense_clarification": "重新启动机器或进程"
                            },
                            {
                                "target_lang_word": "恢复",
                                "target_lang_sense_clarification": "中断后继续进行"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "afc64eac-4f1a-3382-a653-255058b3873e",
                    "sense_definition": "To turn a computer or electronic device off and then on again.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>restart</w> your computer to complete the software installation.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>перезагрузите</w> компьютер, чтобы завершить установку программного обеспечения.",
                                "zh": "请<w>重启</w>您的计算机以完成软件安装。"
                            }
                        },
                        {
                            "text": "If the screen freezes, you should try to <w>restart</w> the device.",
                            "target_lang_translations": {
                                "ru": "Если экран зависнет, вам следует попытаться <w>перезагрузить</w> устройство.",
                                "zh": "如果屏幕卡死，你应该尝试<w>重启</w>设备。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reboot",
                        "reset"
                    ],
                    "common_phrases": [
                        "restart the computer",
                        "restart the system",
                        "force a restart"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выключить и снова включить компьютер или электронное устройство.",
                        "zh": "将计算机或电子设备关闭后再重新打开。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перезагрузить",
                                "target_lang_sense_clarification": "компьютер или систему"
                            },
                            {
                                "target_lang_word": "перезагружать",
                                "target_lang_sense_clarification": "несовершенный вид"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "重启",
                                "target_lang_sense_clarification": "计算机或系统"
                            },
                            {
                                "target_lang_word": "重新启动",
                                "target_lang_sense_clarification": "设备或程序"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fa2f3447-23db-3846-acda-1ba696ad595c",
                    "sense_definition": "The act of starting something again.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the <w>restart</w> of the program, the error message disappeared.",
                            "target_lang_translations": {
                                "ru": "После <w>перезапуска</w> программы сообщение об ошибке исчезло.",
                                "zh": "程序<w>重启</w>后，错误信息消失了。"
                            }
                        },
                        {
                            "text": "The players looked more energetic after the <w>restart</w> of the match.",
                            "target_lang_translations": {
                                "ru": "Игроки выглядели более энергичными после <w>возобновления</w> матча.",
                                "zh": "比赛<w>恢复</w>后，球员们看起来更有活力了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "recommencement",
                        "relaunch",
                        "resumption",
                        "renewal"
                    ],
                    "common_phrases": [
                        "after the restart",
                        "a fresh restart",
                        "restart of the game"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие, заключающееся в том, чтобы начать что-то заново.",
                        "zh": "重新开始某事的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перезапуск",
                                "target_lang_sense_clarification": "повторный запуск"
                            },
                            {
                                "target_lang_word": "возобновление",
                                "target_lang_sense_clarification": "продолжение действия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "重启",
                                "target_lang_sense_clarification": "程序或系统的重新启动"
                            },
                            {
                                "target_lang_word": "恢复",
                                "target_lang_sense_clarification": "比赛或活动的继续"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}