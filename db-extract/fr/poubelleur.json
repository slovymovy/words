                "senses": [
                    {
                        "sense_id": "59d89d32-e697-31d9-8944-53d19cd36426",
                        "entry_id": "417b194a-897f-386f-8b76-85be1262806a",
                        "glosses": [
                            "Éboueur, celui qui ramasse les poubelles."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "dd57af6c-6f48-48b7-8b09-39b9f259d24d",
                                "sense_id": "59d89d32-e697-31d9-8944-53d19cd36426",
                                "text": "Il se fait traiter de « fils de poubelleur » et on lui dit qu’il vient d’une cité de « pouilleux »."
                            },
                            {
                                "example_id": "d5598582-f146-4b0b-8b55-202d8bae555b",
                                "sense_id": "59d89d32-e697-31d9-8944-53d19cd36426",
                                "text": "Il a voulu entrer comme poubelleur, celui qui ramasse les poubelles mais, à la mairie, on lui a dit qu'on ne prenait que des Noirs. C'est ce que mon père raconte. Moi, à Salomé et à La Bassée, j'ai vu des poubelleurs qui étaient blancs comme nous."
                            },
                            {
                                "example_id": "e1ed7ca4-f240-4275-b4f0-99707d2c75c1",
                                "sense_id": "59d89d32-e697-31d9-8944-53d19cd36426",
                                "text": "Ensuite, si tel est votre désir, vous deviendrez un Américain à part entière. Vous aurez droit à certains boulots réservés aux Citizen, comme celui de poubelleur, facteur. Vous serez Noir américain avec tout ce que cela comporte de frustrations sous-entendues."
                            }
                        ]
                    }
