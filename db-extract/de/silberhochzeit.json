                "senses": [
                    {
                        "sense_id": "ee4fba3c-6019-36be-971e-68b180fc1ea8",
                        "entry_id": "2acc07e5-39cc-3ca7-ad7a-4c927f28252e",
                        "glosses": [
                            "Jubiläum nach 25 Ehejahren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58d051b9-41bb-48c9-9547-a7126d68643f",
                                "sense_id": "ee4fba3c-6019-36be-971e-68b180fc1ea8",
                                "text": "Ihre Silberhochzeit feierten sie zusammen mit Freunden und Verwandten."
                            },
                            {
                                "example_id": "40f245d2-43cd-47eb-ae1b-f635fcee6723",
                                "sense_id": "ee4fba3c-6019-36be-971e-68b180fc1ea8",
                                "text": "„Als sie ihre Silberhochzeit feierten, sprachen Respektspersonen viel von Moral, Treue und Beständigkeit, und alle Enkelkinder waren beeindruckt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11430e17-43d2-4f4e-bdba-a96748971609",
                        "source_entry_id": "2acc07e5-39cc-3ca7-ad7a-4c927f28252e",
                        "source_sense_id": "ee4fba3c-6019-36be-971e-68b180fc1ea8",
                        "target_lang_word": "silver wedding",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "silver wedding",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b876210-1bfa-38bb-a945-fa14f2760294",
                                        "entry_id": "711d6136-d568-3d00-a07d-fad295795664",
                                        "glosses": [
                                            "The silver anniversary of a wedding, the 25th anniversary of a marriage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7982095e-374c-4d1d-a92f-241d40617d87",
                                                "sense_id": "4b876210-1bfa-38bb-a945-fa14f2760294",
                                                "text": "The Silver Wedding! on some pensive ear\nFrom towers remote as sound the silvery bells,\nTo-day from one far unforgotten year\nA silvery faint memorial music swells."
                                            },
                                            {
                                                "example_id": "aaa27ba2-cb85-4d3b-b610-d23012a964c4",
                                                "sense_id": "4b876210-1bfa-38bb-a945-fa14f2760294",
                                                "text": "‘Perhaps you have no golden or silver wedding in England?’\n‘I confess I never heard of any thing of the kind,’ said Hamilton..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
