                },
                {
                    "sense_id": "12a52e44-e4f9-3f33-9e76-59f5c14dcd79",
                    "sense_definition": "A shot in archery or shooting that strikes the central white disc of a target.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "target",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His final arrow was a perfect <w>carton</w> that secured victory in the tournament.",
                            "target_lang_translations": {
                                "ru": "Его последняя стрела принесла идеальное <w>попадание в яблочко</w>, обеспечившее победу в турнире."
                            }
                        },
                        {
                            "text": "The judge examined the target closely before confirming that the shot was indeed a <w>carton</w>.",
                            "target_lang_translations": {
                                "ru": "Судья внимательно осмотрел мишень, прежде чем подтвердить, что выстрел действительно был <w>попаданием в яблочко</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Попадание в самый центр мишени (в яблочко)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "попадание в яблочко",
                                "target_lang_sense_clarification": "точный выстрел в центр мишени"
                            }
                        ]
                    }
                }
            ]
        },
        {
