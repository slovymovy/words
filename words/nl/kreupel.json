    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "24e25127-732c-333b-9106-9ebf3c10ba0f",
                    "sense_definition": "Slecht ter been of lichamelijk invalide, waardoor men zich moeilijk voortbeweegt.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het ongeluk bleef hij voor de rest van zijn leven <w>kreupel</w>. ",
                            "target_lang_translations": {
                                "en": "After the accident, he remained <w>lame</w> for the rest of his life."
                            }
                        },
                        {
                            "text": "Het oude paard liep een beetje <w>kreupel</w> over het erf.",
                            "target_lang_translations": {
                                "en": "The old horse walked a bit <w>lame</w> across the yard."
                            }
                        }
                    ],
                    "synonyms": [
                        "mank"
                    ],
                    "common_phrases": [
                        "kreupel lopen"
                    ],
                    "target_lang_definitions": {
                        "en": "Physically disabled or walking with difficulty due to an injury or condition."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lame",
                                "target_lang_sense_clarification": "unable to walk properly"
                            },
                            {
                                "target_lang_word": "crippled",
                                "target_lang_sense_clarification": "severely physically disabled"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8d96bf2-eb4b-30b1-9bb5-b848239366b5",
                    "sense_definition": "Gebrekkig, niet goed functionerend of gebrekkig geformuleerd.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij verontschuldigde zich met een <w>kreupel</w> excuus. ",
                            "target_lang_translations": {
                                "en": "He apologized with a <w>lame</w> excuse."
                            }
                        },
                        {
                            "text": "Zij schreef het artikel in een nogal <w>kreupel</w> Nederlands.",
                            "target_lang_translations": {
                                "en": "She wrote the article in rather <w>poor</w> Dutch."
                            }
                        }
                    ],
                    "common_phrases": [
                        "kreupel excuus"
                    ],
                    "target_lang_definitions": {
                        "en": "Inadequate, poorly functioning, or poorly expressed."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lame",
                                "target_lang_sense_clarification": "unconvincing or weak"
                            },
                            {
                                "target_lang_word": "feeble",
                                "target_lang_sense_clarification": "weak or unconvincing"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c2465fad-29ed-3312-bf6a-45a00f74b5c6",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>kreupelen</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>kreupel</w> soms door de pijn in mijn knie.",
                            "target_lang_translations": {
                                "en": "I sometimes <w>limp</w> because of the pain in my knee."
                            }
                        },
                        {
                            "text": "Als ik me verstap, <w>kreupel</w> ik nog een tijdje door.",
                            "target_lang_translations": {
                                "en": "If I misstep, I keep <w>hobbling</w> along for a while."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present form of 'kreupelen' (to limp/hobble)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "limp",
                                "target_lang_sense_clarification": "to walk with difficulty"
                            },
                            {
                                "target_lang_word": "hobble",
                                "target_lang_sense_clarification": "to walk unsteadily or with weakness"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30c3b47e-bfcd-31bb-876d-38f06de414e2",
                    "sense_definition": "Gebiedende wijs van <w>kreupelen</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Kreupel</w> niet zo en loop gewoon door!",
                            "target_lang_translations": {
                                "en": "Don't <w>limp</w> so much and just keep walking!"
                            }
                        },
                        {
                            "text": "Niet zo zeuren, <w>kreupel</w> niet zo als het meevalt!",
                            "target_lang_translations": {
                                "en": "Stop complaining, don't <w>hobble</w> like that when it's not that bad!"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative form of 'kreupelen' (to limp/hobble)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "limp",
                                "target_lang_sense_clarification": "imperative command to limp"
                            },
                            {
                                "target_lang_word": "hobble",
                                "target_lang_sense_clarification": "imperative command to hobble"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a745eaf8-6b4d-3de5-bda7-9e0c14ad07c1",
                    "sense_definition": "Tweede persoon enkelvoud tegenwoordige tijd (in inversie) van <w>kreupelen</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>kreupel</w> je zo na de training?",
                            "target_lang_translations": {
                                "en": "Why do you <w>limp</w> like that after training?"
                            }
                        },
                        {
                            "text": "Als je valt, <w>kreupel</w> je meteen de hele middag.",
                            "target_lang_translations": {
                                "en": "If you fall, you immediately <w>limp</w> for the whole afternoon."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "second-person singular present inversed"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Second-person singular present form (in inversion) of 'kreupelen' (to limp/hobble)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "limp",
                                "target_lang_sense_clarification": "you limp"
                            },
                            {
                                "target_lang_word": "hobble",
                                "target_lang_sense_clarification": "you hobble"
                            }
                        ]
                    }
                }
            ]
        }
    ]
