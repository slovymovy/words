                    {
                        "sense_id": "947967ba-9068-39da-b32a-1e4ae29ba202",
                        "entry_id": "d8abee77-d290-3f21-9d1c-5e74500dc055",
                        "glosses": [
                            "het mannelijke orgaan waar de spermacellen gemaakt worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "079756dd-e498-4e15-b772-9eb85a0c2a29",
                                "sense_id": "947967ba-9068-39da-b32a-1e4ae29ba202",
                                "text": "Wegens kanker moest er een zaadbal bij hem verwijderd worden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6343ea4-bcd7-4638-a973-5983a064aca4",
                        "source_entry_id": "d8abee77-d290-3f21-9d1c-5e74500dc055",
                        "source_sense_id": "947967ba-9068-39da-b32a-1e4ae29ba202",
                        "source_sense_description": "een orgaan waar de spermacellen gevormd worden",
                        "target_lang_word": "Hoden",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hoden",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4d2a022a-4ea9-36b9-b553-862d09455df2",
                                        "entry_id": "ebd4225c-955a-34aa-a707-aaaa2b9f24e9",
                                        "glosses": [
                                            "männliche Keimdrüse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "900a2bb0-05fc-42b3-a02c-b515aa4fdbb2",
                                                "sense_id": "4d2a022a-4ea9-36b9-b553-862d09455df2",
                                                "text": "In den Hoden wird auch das Testosteron gebildet."
                                            },
                                            {
                                                "example_id": "ff531fe2-9464-40bf-9e06-01bb760324ee",
                                                "sense_id": "4d2a022a-4ea9-36b9-b553-862d09455df2",
                                                "text": "„Dann hielt er seinen Becher unter die naturgetreu nachgebildeten Hoden und zog am Schwanz.“"
                                            },
                                            {
                                                "example_id": "43ae5577-2577-48ad-85fd-f7f419a4b933",
                                                "sense_id": "4d2a022a-4ea9-36b9-b553-862d09455df2",
                                                "text": "„Der junge Mann stand breitbeinig da, denn seine Hoden waren so geschwollen, dass sie ihm fast bis zu den Unterschenkeln reichten.“"
                                            },
                                            {
                                                "example_id": "e76f30dd-fb42-4ba2-82f3-060461eaf4c6",
                                                "sense_id": "4d2a022a-4ea9-36b9-b553-862d09455df2",
                                                "text": "„Sie lernten, zu was der Hoden nutze war, die Funktion der Eierstöcke, und was es mit den Follikeln auf sich hatte.“"
                                            },
                                            {
                                                "example_id": "2d3b9a8e-9f93-4ef0-89e5-008cb63a542d",
                                                "sense_id": "4d2a022a-4ea9-36b9-b553-862d09455df2",
                                                "text": "„Eine Schwiegermutter, die jünger aussieht als ihre künftige Schwiegertochter, ein Vater, der zittert wie der Hoden eines Teppichklopfers – ich wäre misstrauisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
