                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e53d739b-78de-3116-ba54-13d7f95b6e9a",
                        "entry_id": "04e06fcd-bee8-3203-8fbd-5a2352b41dc2",
                        "glosses": [
                            "Abbreviation of agricultural aviation."
                        ],
                        "tags": [
