                        "entry_id": "3b25fcac-0538-3a95-89f5-eea3acb27645",
                        "glosses": [
                            "лингв. процесс превращения лексических единиц с ходом эволюции языка в грамматические показатели"
                        ],
                        "tags": [],
                        "examples": [
