                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54d4a941-58ab-369a-a888-8155ff9c7275",
                                        "entry_id": "8321983f-5115-3dfd-861d-363e999e3ad1",
                                        "glosses": [
                                            "A small stick or piece of paper used to light a candle, cigarette etc by the transfer of a flame from a fire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dd5c2af-c29b-41d8-a56e-bef4a516eaf8",
                                                "sense_id": "54d4a941-58ab-369a-a888-8155ff9c7275",
                                                "text": "“In a moment, he has torn the letter into long thin strips, and rolling them up into spills he thrusts them hurriedly in amongst the other spills in the vase on the mantle-piece.”"
                                            },
                                            {
                                                "example_id": "e4aa1e79-885e-4163-a362-ca25efb514ae",
                                                "sense_id": "54d4a941-58ab-369a-a888-8155ff9c7275",
