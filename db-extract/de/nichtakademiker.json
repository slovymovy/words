                        "sense_id": "cac0cb76-67d7-33e2-8c30-643f7d645e6c",
                        "entry_id": "019c7d4c-3da7-3ae1-865b-b73bffd60d59",
                        "glosses": [
                            "erwachsene (männliche^☆) Person ohne Hochschulabschluss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "423e2e46-34d1-4427-a088-b93f511a2f69",
                                "sense_id": "cac0cb76-67d7-33e2-8c30-643f7d645e6c",
                                "text": "„Denn das Programm wendet sich speziell an Kinder von Nichtakademikern, da diese oft größere Hürden zu meistern hätten, wenn es um berufliche Wege nach dem Abitur geht - zum Beispiel weil sie nicht auf Erfahrungen ihrer Eltern zum Thema Studium zurückgreifen können.“"
                            },
                            {
                                "example_id": "5730e8ae-ddd7-40d4-9a5e-81f9120a3929",
                                "sense_id": "cac0cb76-67d7-33e2-8c30-643f7d645e6c",
                                "text": "„Ich glaube nicht, dass er viel mit Außenstehenden redet. Und mit Außenstehenden meine ich Nichtakademiker.“"
                            }
                        ],
