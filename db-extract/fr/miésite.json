                        "sense_id": "d61c5217-dbfb-32a2-971d-d94989ebc986",
                        "entry_id": "4e78a736-6906-32d8-9cb5-2fcf454cff76",
                        "glosses": [
                            "Variété de pyromorphite contenant du phosphate de chaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7d06764-d678-4d73-91ff-35dcc267f8e9",
                                "sense_id": "d61c5217-dbfb-32a2-971d-d94989ebc986",
                                "text": "Depuis quelques années, on a trouvé à Roure une variété brune, botryoïde, ayant une certaine analogie avec la miésite de Bohême ; elle est associée avec la cérusite."
                            },
                            {
                                "example_id": "6e29e0e4-9d63-40a5-b65a-ee1bcc283655",
                                "sense_id": "d61c5217-dbfb-32a2-971d-d94989ebc986",
                                "text": "On connaît déjà plusieurs phosphates et arséniates de plomb calcifères : ils ont reçu divers noms, tels que : Nussiérite, Miésite, Polysphœrite, etc."
                            },
                            {
                                "example_id": "e61e7d6b-8310-4acb-8a2e-d5b8d1992828",
                                "sense_id": "d61c5217-dbfb-32a2-971d-d94989ebc986",
                                "text": "La miésite est une pyromorphite avec du calcium, du nom du gisement allemand de Mies."
                            }
                        ]
                    }
                ],
