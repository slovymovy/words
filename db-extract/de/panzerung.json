                        ],
                        "form": "die Panzerungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ba3d9326-2c44-3148-ab90-e1a469e9a508",
                        "entry_id": "57f39249-5ba6-38fc-a7b1-1f6e6811f8f2",
                        "glosses": [
                            "verstärkte Hülle (beispielsweise bei Fahrzeugen, Tieren), die vor einem Eindringen von Waffen, Geschossen und Ähnlichem schützen soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fb9b23d-456f-40df-ab48-13ce3ae5f4a3",
                                "sense_id": "ba3d9326-2c44-3148-ab90-e1a469e9a508",
                                "text": "„In den letzten 25 Jahren ist das Gewicht der Kampfpanzer bedingt durch immer stärkere Panzerungen und größere Kanonen enorm gestiegen.“"
                            },
                            {
                                "example_id": "6f7e5843-722f-4130-8438-082f77330d40",
                                "sense_id": "ba3d9326-2c44-3148-ab90-e1a469e9a508",
                                "text": "„Die Schildkröte witterte die Gefahr und zog ihre Extremitäten ganz in die Panzerung zurück.“"
                            },
                            {
                                "example_id": "03d0076f-6e5e-4006-be62-46d5a290ef0d",
                                "sense_id": "ba3d9326-2c44-3148-ab90-e1a469e9a508",
                                "text": "„Die 8 bis 450 μm großen Organismen besitzen eine Panzerung aus Zellulose-, Kalk- oder Kieselplatten.“"
                            },
                            {
                                "example_id": "65a5ea96-f580-4535-9821-20b1fd55d699",
                                "sense_id": "ba3d9326-2c44-3148-ab90-e1a469e9a508",
                                "text": "[17. Februar 1500, Schlacht bei Hemmingstedt:] „Behindert von der schweren Panzerung ertrinkt ein Großteil der gegnerischen Soldaten.“"
                            },
                            {
                                "example_id": "87d1bca6-6143-4716-9326-9257e584d46e",
                                "sense_id": "ba3d9326-2c44-3148-ab90-e1a469e9a508",
                                "text": "„Keiner der Treffer durchschlug die Panzerung.“"
                            },
                            {
                                "example_id": "29497a4c-f21e-43cb-87e5-40b3ec032d6b",
                                "sense_id": "ba3d9326-2c44-3148-ab90-e1a469e9a508",
                                "text": "„Die Panzerung des Fahrzeuges war zwischen 10 und 16 mm dick.“"
                            },
                            {
                                "example_id": "d9a9aa90-a194-4905-ae54-2c678108608a",
                                "sense_id": "ba3d9326-2c44-3148-ab90-e1a469e9a508",
                                "text": "[30,5-cm-Geschütze:] „Die Kanonenrohre, vierzehn Meter lang, jedes dreiundfünfzigtausend Kilogramm schwer, starren parallel aus der Panzerung und sehen einander ähnlich wie Drillinge.“"
                            },
                            {
                                "example_id": "4900989e-c45e-4c94-9127-07c98f45df1e",
                                "sense_id": "ba3d9326-2c44-3148-ab90-e1a469e9a508",
                                "text": "[Zweiter Weltkrieg: Überfall auf die Sowjetunion:] „Vor allem aber der neue sowjetische T-34 erweist sich in Feuerkraft, Panzerung, Geschwindigkeit und Reichweite gegenüber allen deutschen Panzermodellen als haushoch überlegen.“"
                            },
                            {
                                "example_id": "b8055e98-4551-48fa-9494-4f6bf84be56b",
                                "sense_id": "ba3d9326-2c44-3148-ab90-e1a469e9a508",
                                "text": "„Die 5-cm-Kanone des Panzer III kann die massive, abgeschrägte Panzerung des T-34 allenfalls an den Seiten oder am Heck durchschlagen.“"
                            },
                            {
                                "example_id": "d4a86f41-9c11-4f2b-9aea-a0daffe2dfdb",
                                "sense_id": "ba3d9326-2c44-3148-ab90-e1a469e9a508",
                                "text": "„Im September 1981 feuert die die RAF eben jene auf Nato-General Frederick Kroesen ab. Der US-Amerikaner überlebt durch die Panzerung seines Wagens leicht verletzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
