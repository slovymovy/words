                "senses": [
                    {
                        "sense_id": "a278baef-7f81-375c-a309-ad0d2330d022",
                        "entry_id": "4c0e6fb1-eec7-38ac-b488-d079d216b103",
                        "glosses": [
                            "weibliche Person, die gefühlsblind ist, Gefühlslegasthenie hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60b36283-fbce-4fb5-8442-7e47a0408a7d",
                                "sense_id": "a278baef-7f81-375c-a309-ad0d2330d022",
                                "text": "„Revierleiter Haller (Hannes Hellmann) sei von der neuen Kollegin begeistert, hieß es, weil sie keine Empfindlichkeiten zeige - aber auch keine erkennbaren Emotionen. \"Seit ihrer Geburt lebt sie mit Alexithymie, ein Persönlichkeitsmerkmal, das sie zu einer absoluten Gefühlslegasthenikerin macht\", beschrieb das ZDF die Rolle. Mit ihrer kühlen, sachlichen Art könne sie die emotionale Franzi nicht vollständig ersetzen.“"
                            },
                            {
                                "example_id": "7749dc9a-2de1-457d-b260-2aaa963e9466",
                                "sense_id": "a278baef-7f81-375c-a309-ad0d2330d022",
                                "text": "„Wenn es so wäre, dann frage ich mich, ob du auch Gefühlslegasthenikerin bist. Denn du bist zwar eine Gegnerin des Stierkampfs, verstehst aber anscheinend nicht die Argumente/Gründe der Befürworter, oder nicht?“"
                            },
                            {
                                "example_id": "96c0587e-ecc5-4d79-82f6-937e9d33d2fd",
                                "sense_id": "a278baef-7f81-375c-a309-ad0d2330d022",
                                "text": "„Seit ihrer Geburt lebt sie mit Alexithymie, ein Persönlichkeitsmerkmal, das sie zu einer absoluten Gefühlslegasthenikerin macht.“"
                            },
                            {
                                "example_id": "30acefe5-6d1d-425b-befd-f82fa355712d",
                                "sense_id": "a278baef-7f81-375c-a309-ad0d2330d022",
                                "text": "Die Neue im Polizeikommissariat 21 kam mit Alexitymie zur Welt und ist daher eine absolute Gefühlslegasthenikerin."
                            },
                            {
                                "example_id": "5fd8ef3b-254e-4258-b232-5310d1795d95",
                                "sense_id": "a278baef-7f81-375c-a309-ad0d2330d022",
                                "text": "Die Alexithymie ist ein Persönlichkeitsmerkmal, das die Leidenden gefühlsblind macht, gefühlsarm oder \"sie zu einer absoluten Gefühlslegasthenikerin macht\", wie das ZDF schreibt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
