                ],
                "senses": [
                    {
                        "sense_id": "702c53b2-c8f3-32c8-8b55-eed4be7f0eb0",
                        "entry_id": "50a32a4c-9d4d-3a45-a884-9a4020264c87",
                        "glosses": [
                            "Décapotable conçue comme telle et non en dérivé d’un modèle de série."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b905bcb-1441-43e6-8cb1-38dfe6dbc29f",
                                "sense_id": "702c53b2-c8f3-32c8-8b55-eed4be7f0eb0",
                                "text": "L’Alfa giulietta est un spider coquin, amusant, à la ligne moderne mais avec une technique ancienne."
                            },
                            {
                                "example_id": "7f68c688-4bea-4235-8e42-6bf78a32eae2",
                                "sense_id": "702c53b2-c8f3-32c8-8b55-eed4be7f0eb0",
                                "text": "Fredel courait au-devant de l’auto qui, dans un glissement silencieux, venait se ranger devant le perron du Grand-Hôtel. Mais avant qu’il eût pu toucher à la portière, un chauffeur en livrée claire à parements jaunes, du même jaune que la carrosserie, sortait du spider, se précipitait."
                            }
                        ]
                    },
                    {
                        "sense_id": "c6e1e479-aa55-3bf2-8c7b-b7c1b24c9211",
                        "entry_id": "50a32a4c-9d4d-3a45-a884-9a4020264c87",
                        "glosses": [
                            "Coffre d’un coupé ou d’un cabriolet, pouvant se transformer en places passager."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa2446f5-e53a-43be-965c-75eea100b311",
                                "sense_id": "c6e1e479-aa55-3bf2-8c7b-b7c1b24c9211",
                                "text": "— Enfin, tu es dans le spider ? Bien. Maintenant, attention à la manœuvre : la nourrice de cinquante se trouve sous la banquette arrière."
                            },
                            {
                                "example_id": "f22ccd63-3cd4-4e3b-9321-5c9f896021c4",
                                "sense_id": "c6e1e479-aa55-3bf2-8c7b-b7c1b24c9211",
                                "text": "« Il est vrai qu’on ne tient que trois dans la voiture et je ne peux pas lui imposer le spider, tant il pleut. »"
                            }
                        ]
                    }
                ],
