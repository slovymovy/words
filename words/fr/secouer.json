{
    "word_family": [
        "secouade",
        "secouement",
        "secoueur",
        "secousse"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fc5e25fc-1655-32d2-a25e-7e904371e697",
                    "sense_definition": "Remuer un objet ou une personne avec force et à plusieurs reprises.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut bien <w>secouer</w> la bouteille de jus avant de la servir aux invités."
                        },
                        {
                            "text": "L'enfant <w>secoue</w> la tête pour dire qu'il n'est pas d'accord."
                        }
                    ],
                    "synonyms": [
                        "agiter"
                    ],
                    "common_phrases": [
                        "secouer la tête",
                        "secouer avant emploi"
                    ]
                },
                {
                    "sense_id": "a9197389-844c-375f-a97d-e4507b0d6163",
                    "sense_definition": "Affecter profondément sur le plan émotionnel ou affaiblir physiquement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La mauvaise nouvelle a beaucoup <w>secoué</w> toute la famille hier soir."
                        },
                        {
                            "text": "Cette grosse grippe l'a <w>secoué</w> pendant plus d'une semaine."
                        }
                    ],
                    "synonyms": [
                        "ébranler"
                    ],
                    "common_phrases": [
                        "être secoué"
                    ]
                },
                {
                    "sense_id": "0ff06d98-1958-35a8-84a8-645b4c429246",
                    "sense_definition": "Sortir de sa passivité ou de son découragement en faisant un effort pour agir.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pronominal_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est temps de te <w>secouer</w> un peu pour trouver un nouvel emploi."
                        },
                        {
                            "text": "Après quelques jours de repos, elle a décidé de se <w>secouer</w>."
                        }
                    ],
                    "common_phrases": [
                        "se secouer un peu"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "souvent employé à l'impératif"
                        }
                    ]
                },
                {
                    "sense_id": "2286c1a0-fb2b-3731-9117-df40af28ed47",
                    "sense_definition": "S'agiter vivement pour faire tomber ce qui gêne ou pour se débarrasser de l'eau.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chien mouillé se <w>secoue</w> vigoureusement en rentrant du jardin."
                        },
                        {
                            "text": "L'oiseau se <w>secoue</w> après son bain dans la fontaine du parc."
                        }
                    ]
                },
                {
                    "sense_id": "2b3e8772-c57d-31e5-832b-5e4746732523",
                    "sense_definition": "Réprimander ou brusquer quelqu'un pour l'inciter à réagir et à changer d'attitude.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur a <w>secoué</w> les élèves pour les forcer à réviser leurs examens."
                        },
                        {
                            "text": "Son responsable l'a bien <w>secoué</w> après son retard injustifié à la réunion."
                        }
                    ],
                    "common_phrases": [
                        "secouer les puces"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier pour désigner un recadrage"
                        }
                    ]
                },
                {
                    "sense_id": "ad07f107-9908-38f2-b088-24cd62407cbc",
                    "sense_definition": "S'affranchir d'une contrainte, d'une autorité pesante ou d'une mauvaise habitude.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "rejet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le peuple a fini par <w>secouer</w> le joug imposé par la dictature."
                        },
                        {
                            "text": "Elle cherche à <w>secouer</w> ses vieilles habitudes pour mener une vie plus saine."
                        }
                    ],
                    "common_phrases": [
                        "secouer le joug",
                        "secouer sa torpeur"
                    ]
                }
            ]
        }
    ]
}