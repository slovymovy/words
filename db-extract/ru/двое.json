                "senses": [
                    {
                        "sense_id": "8dad83f7-2883-301e-b338-9cd5bdc5ae74",
                        "entry_id": "88c1b52b-7a9a-3e79-a846-c68428cab32e",
                        "glosses": [
                            "количество, равное двум"
                        ],
                        "tags": [
                            "с одушевлёнными существительными муж. р., личными местоимениями во мн. ч. и без зависимого слова"
                        ],
                        "examples": [
                            {
                                "example_id": "a35fa5e7-9908-4e29-b871-cc67f17afc05",
                                "sense_id": "8dad83f7-2883-301e-b338-9cd5bdc5ae74",
                                "text": "Я там встретил двоих сослуживцев."
                            },
                            {
                                "example_id": "f5780835-6a93-46b6-92e1-20e0bff548ea",
                                "sense_id": "8dad83f7-2883-301e-b338-9cd5bdc5ae74",
                                "text": "Навстречу мне шли двое парней."
                            }
                        ]
                    },
                    {
                        "sense_id": "c15b42a3-ae00-3446-a048-f570b53ec9bc",
                        "entry_id": "88c1b52b-7a9a-3e79-a846-c68428cab32e",
                        "glosses": [
                            "два"
                        ],
                        "tags": [
                            "(обычно им. и вин. п.); с существительными, имеющими лишь множественное число"
                        ],
                        "examples": [
                            {
                                "example_id": "920fbb55-4ecc-4dc0-9983-895f29380909",
                                "sense_id": "c15b42a3-ae00-3446-a048-f570b53ec9bc",
                                "text": "У меня найдётся двое ножниц."
                            }
                        ]
                    },
                    {
                        "sense_id": "fade221e-4f29-3c71-b678-eec6b504d506",
                        "entry_id": "88c1b52b-7a9a-3e79-a846-c68428cab32e",
                        "glosses": [
                            "две пары"
                        ],
                        "tags": [
                            "(обычно им. и вин. п.); с некоторыми существительными, обозначающими па́рные объекты"
                        ],
                        "examples": [
                            {
                                "example_id": "eec07be1-d4d9-4124-869f-a73aa6aa66e5",
                                "sense_id": "fade221e-4f29-3c71-b678-eec6b504d506",
                                "text": "Надо взять с собой двое носков."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
