        "fr-extract.jsonl": [
            {
                "entry_id": "b919816f-2c8b-3688-94e8-639c2bec9050",
                "word": "aridité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a477b824-1f08-4ce5-8094-4b2587b93b4d",
                        "entry_id": "b919816f-2c8b-3688-94e8-639c2bec9050",
                        "tags": [
                            "plural"
                        ],
                        "form": "aridités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "275b5eaf-1250-3689-a9b0-4ab40ea3d503",
                        "entry_id": "b919816f-2c8b-3688-94e8-639c2bec9050",
                        "glosses": [
                            "État de ce qui est aride."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "995d8f11-57e7-4168-b44d-c4db0bc08385",
                                "sense_id": "275b5eaf-1250-3689-a9b0-4ab40ea3d503",
                                "text": "Ce ne sont plus les plaines du Sahara, comme on serait tenté de le croire, plaines sablonneuses, dépourvues de végétation, que leur aridité rend à peu près infranchissables."
                            }
                        ]
                    },
                    {
                        "sense_id": "ce0a3bf1-0499-3410-bbc1-0dcbcaa52388",
                        "entry_id": "b919816f-2c8b-3688-94e8-639c2bec9050",
                        "glosses": [
                            "État de ce qui est stérile, au propre et au figuré."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "2cd28731-40d4-41a8-b184-e330cb2502e1",
                                "sense_id": "ce0a3bf1-0499-3410-bbc1-0dcbcaa52388",
                                "text": "L’aridité d’un terroir. L’aridité de la saison. L’aridité de l’herbe brûlée par le soleil."
                            },
                            {
                                "example_id": "31c7f878-efe5-471c-b930-1eba625b64f5",
                                "sense_id": "ce0a3bf1-0499-3410-bbc1-0dcbcaa52388",
                                "text": "Il se plongeait dans l’aridité des études financières, le jargon des affaires, la jonglerie des chiffres et, lentement, ces choses, hier hermétiques, lui devenaient familières."
                            },
                            {
                                "example_id": "9c2544a9-ce5c-426e-a39c-917e08ea13dc",
                                "sense_id": "ce0a3bf1-0499-3410-bbc1-0dcbcaa52388",
                                "text": "— L’aridité d’un sujet. Une grande aridité de style. Il y a dans tous ses ouvrages une sécheresse, une aridité étrange."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a4555c1-bcd9-368b-a0f2-46c173e1722e",
                        "entry_id": "b919816f-2c8b-3688-94e8-639c2bec9050",
                        "glosses": [
                            "État d’une âme qui ne sent pas de consolation dans les exercices de piété."
                        ],
                        "tags": [
                            "Dévotion religieuse"
                        ],
                        "examples": [
                            {
                                "example_id": "4eb93b41-651c-44a4-82e3-6c702fe78564",
                                "sense_id": "6a4555c1-bcd9-368b-a0f2-46c173e1722e",
                                "text": "Elle prend l’habit, […] ; puis vient une aridité désolante qui dure trois ans et elle tient bon, éprouve les douleurs de la substitution mystique, subit les plus pénibles, les plus répugnantes des maladies pour sauver les âmes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5860575d-5c05-4842-a58a-ea580b55f01d",
                        "source_entry_id": "b919816f-2c8b-3688-94e8-639c2bec9050",
                        "target_lang_word": "Wasserknappheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wasserknappheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "25be1fe0-9cd0-31d4-b02b-b9d989ae11f7",
                                        "entry_id": "6097b347-d1dc-3a70-8fbc-713a34747e7b",
                                        "glosses": [
                                            "das fast vollständige Fehlen von Wasser"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91c16b25-e836-418e-8164-10be11750965",
                                                "sense_id": "25be1fe0-9cd0-31d4-b02b-b9d989ae11f7",
                                                "text": "„Vier Milliarden Menschen sind mindestens einen Monat pro Jahr von akuter Wasserknappheit betroffen – vor allem in afrikanischen Staaten.“"
                                            },
                                            {
                                                "example_id": "164cb122-26de-4b22-bb94-9e573fc4832a",
                                                "sense_id": "25be1fe0-9cd0-31d4-b02b-b9d989ae11f7",
                                                "text": "[Schlagzeile:] „Bericht der Unesco - Weltweite Wasserknappheit verschärft sich immer mehr“"
                                            },
                                            {
                                                "example_id": "2421d2d3-0d78-4006-a546-30980c254f4f",
                                                "sense_id": "25be1fe0-9cd0-31d4-b02b-b9d989ae11f7",
                                                "text": "„Bereits jetzt ist zehn Prozent der Weltbevölkerung von Problemen durch Wasserknappheit betroffen.“"
                                            },
                                            {
                                                "example_id": "83d5b463-8838-4c03-a11b-c6b31d9aa057",
                                                "sense_id": "25be1fe0-9cd0-31d4-b02b-b9d989ae11f7",
                                                "text": "„Wasserknappheit wird sich weltweit weiter ausbreiten und künftig auch dort auftreten, wo die Ressource derzeit noch reichlich vorhanden ist, wie in Zentralafrika, Ostasien und Teilen Südamerikas, wie die Vereinten Nationen (UN) in ihrem neuen Weltwasserbericht deutlich machen.“"
                                            },
                                            {
                                                "example_id": "7f3b10f6-9545-488f-b3c9-3a75897cd6e5",
                                                "sense_id": "25be1fe0-9cd0-31d4-b02b-b9d989ae11f7",
                                                "text": "„Ohne kontinuierlichen Abfluss von Schmelzwasser droht zunehmende Wasserknappheit für Milliarden von Menschen.“"
                                            },
                                            {
                                                "example_id": "9cfb023f-2543-44e4-9c8c-c839dd2b31c3",
                                                "sense_id": "25be1fe0-9cd0-31d4-b02b-b9d989ae11f7",
                                                "text": "[Dürre in Südeuropa im Sommer 2022:] „Die Wasserknappheit könnte noch monatelang dauern.“"
                                            },
                                            {
                                                "example_id": "bd752084-e09c-4fcc-b0a4-70ca6d6686bb",
                                                "sense_id": "25be1fe0-9cd0-31d4-b02b-b9d989ae11f7",
                                                "text": "„Mit dem trockenen und heißen Sommer verschärft sich die Wasserknappheit in Brandenburg.“"
                                            },
                                            {
                                                "example_id": "594bcd0a-a45d-4493-b3c0-01f69b50bc70",
                                                "sense_id": "25be1fe0-9cd0-31d4-b02b-b9d989ae11f7",
                                                "text": "„Problematisch ist auch der Import wasserintensiver Produkte wie zum Beispiel Obst- und Gemüsesorten aus Ländern wie Spanien, in denen heute schon Wasserknappheit herrscht.“"
                                            },
                                            {
                                                "example_id": "1290a714-5386-4738-83f8-a4bbfcd986b9",
                                                "sense_id": "25be1fe0-9cd0-31d4-b02b-b9d989ae11f7",
                                                "text": "„Avocado gelten als gesundes Superfood. Der industrielle Anbau steht aber in der Kritik, da er zu Umweltverschmutzung und Wasserknappheit in den Anbauländern führt.“"
                                            },
                                            {
                                                "example_id": "ac62421c-dbe6-4efd-8255-30abc811e6b2",
                                                "sense_id": "25be1fe0-9cd0-31d4-b02b-b9d989ae11f7",
                                                "text": "„Wir beziehen unsere Avocados aus Griechenland“ […] „Im Gegensatz zu Chile oder anderen Anbaugebieten herrscht dort keine Wasserknappheit.“"
                                            },
                                            {
                                                "example_id": "4ad6c405-c208-48b8-aa6d-6501a42851f0",
                                                "sense_id": "25be1fe0-9cd0-31d4-b02b-b9d989ae11f7",
                                                "text": "„Nicht nur Wasserknappheit, sondern auch die Zunahme von Extremwetter-Ereignissen wie Hochwasser ist eine Folge des Klimawandels.“"
                                            },
                                            {
                                                "example_id": "dc31c2c5-d21e-4801-90e8-c665ebcbd837",
                                                "sense_id": "25be1fe0-9cd0-31d4-b02b-b9d989ae11f7",
                                                "text": "„Vor allem die Landwirtschaft bekommt die Folgen von Wasserknappheit bereits zu spüren - schlechte Ernten sind nur ein Beispiel.“"
                                            },
                                            {
                                                "example_id": "0380ba7b-0538-482b-9a8b-24102317d3b5",
                                                "sense_id": "25be1fe0-9cd0-31d4-b02b-b9d989ae11f7",
                                                "text": "„Die Regierung López Obrador hatte bereits dem Getränkehersteller Constellation Brands die von früheren Regierungen erteilte Genehmigung für eine neue Brauerei im nordmexikanischen Mexicali wegen Wasserknappheit annulliert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad83cc48-d630-4c01-82a3-d1741fe06a09",
                        "source_entry_id": "b919816f-2c8b-3688-94e8-639c2bec9050",
                        "target_lang_word": "Wassermangel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wassermangel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "34532727-94a2-39d0-9415-9c17a7504548",
                                        "entry_id": "37807fd1-6eaf-300d-bba6-b7bb3605e6e3",
                                        "glosses": [
                                            "Mangel an Wasser; Wasser ist nicht in ausreichender Menge verfügbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "604a5e81-aa8d-4781-a2a3-90a6672e6349",
                                                "sense_id": "34532727-94a2-39d0-9415-9c17a7504548",
                                                "text": "Die Expeditionsteilnehmer starben durch den Wassermangel."
                                            },
                                            {
                                                "example_id": "a94e5ef9-32f1-46dc-ae15-0aecc90d6ba2",
                                                "sense_id": "34532727-94a2-39d0-9415-9c17a7504548",
                                                "text": "„Der Wassermangel führte zu Ernteeinbußen in der Landwirtschaft.“"
                                            },
                                            {
                                                "example_id": "d272bf68-531b-472e-a117-ae706f064df7",
                                                "sense_id": "34532727-94a2-39d0-9415-9c17a7504548",
                                                "text": "„Die UNO hat Ägypten mit seinem Bevölkerungswachstum von fast zwei Millionen Menschen pro Jahr schon für 2025 Wassermangel bescheinigt.“"
                                            },
                                            {
                                                "example_id": "6e0fcece-c47c-4c65-b224-ad016164cfb1",
                                                "sense_id": "34532727-94a2-39d0-9415-9c17a7504548",
                                                "text": "„Auch die Weltorganisation für Meteorologie (⁠WMO⁠) kommt in einer 2022 veröffentlichten Analyse (externer Link) zu dem Schluss, dass der fortschreitende Klimawandel den Wassermangel verschärft.“"
                                            },
                                            {
                                                "example_id": "de1261e0-ba62-4fab-873a-6f6a1b56f56f",
                                                "sense_id": "34532727-94a2-39d0-9415-9c17a7504548",
                                                "text": "„Weltweit sind bereits ein Viertel aller Städte von Wasserstress betroffen und leiden unter dauerhaftem Wassermangel.“"
                                            },
                                            {
                                                "example_id": "f99d66e7-37a8-418c-b950-9fd6684ac7b4",
                                                "sense_id": "34532727-94a2-39d0-9415-9c17a7504548",
                                                "text": "„Bundesweit gibt es bislang keinen flächendeckenden Wassermangel, jedoch deutliche regionale Defizite.“"
                                            },
                                            {
                                                "example_id": "ef9dc879-c9a0-4704-8155-2946de25f613",
                                                "sense_id": "34532727-94a2-39d0-9415-9c17a7504548",
                                                "text": "[Schlagzeile:] „Der Wassermangel in Europa ist ein Desaster mit Ansage“"
                                            },
                                            {
                                                "example_id": "2188c738-8f73-40e8-a71b-5db8c19227da",
                                                "sense_id": "34532727-94a2-39d0-9415-9c17a7504548",
                                                "text": "„Wassermangel und Dürre bedrohen Europas Umwelt und Wirtschaft nicht nur sporadisch, sondern auf Dauer.“"
                                            },
                                            {
                                                "example_id": "67e42c67-93bd-4603-a35a-a67ed75bea54",
                                                "sense_id": "34532727-94a2-39d0-9415-9c17a7504548",
                                                "text": "„Mehr als ein Viertel des EU-Territoriums ist laut der Europäischen Dürrebeobachtungsstelle (European Drought Observatory – EDO) von Wassermangel betroffen.“"
                                            },
                                            {
                                                "example_id": "70dbe6c8-cd08-4715-8342-37000014eb1a",
                                                "sense_id": "34532727-94a2-39d0-9415-9c17a7504548",
                                                "text": "„Der Wassermangel war ein wichtiger Grund dafür, dass die Invasionstruppen schnell weiter aufs Festland zogen, wo auch die Hafenstadt Valona – heute Vlora – besetzt wurde.“"
                                            },
                                            {
                                                "example_id": "4a1dd916-1f1c-4ee8-9cfa-eb4165c887b8",
                                                "sense_id": "34532727-94a2-39d0-9415-9c17a7504548",
                                                "text": "„Bei akutem Wassermangel hilft oft nur, Trinkwasser zu rationieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
