                                "target_senses": [
                                    {
                                        "sense_id": "1a2dbfd5-879c-35cc-9f0f-3f2fe0bd5d76",
                                        "entry_id": "65053089-6f07-36c5-adf5-5280450b35d5",
                                        "glosses": [
                                            "czynnik współdziałający, o podobnym działaniu do czegoś"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "280e7413-aca2-4da3-bf63-e62c27498daa",
                                                "sense_id": "1a2dbfd5-879c-35cc-9f0f-3f2fe0bd5d76",
                                                "text": "Doświadczenia przeprowadzono w pierwotnych hodowlach astrocytów i neuronów, stymulowanych odpowiednio agonistą receptora glukokortykoidowego (…) oraz agonistą jonotropowych receptorów glutaminianu"
                                            },
                                            {
                                                "example_id": "25a0c9c2-2a0e-40d0-bc8b-95536852f97f",
                                                "sense_id": "1a2dbfd5-879c-35cc-9f0f-3f2fe0bd5d76",
                                                "text": "Wpływ chronicznych łącznych podań agonistów receptorów dopaminowych D1 i D2 na poziom rotacji kontralateralnych"
                                            },
                                            {
                                                "example_id": "748b2160-d025-4949-aea2-85e7752d424f",
                                                "sense_id": "1a2dbfd5-879c-35cc-9f0f-3f2fe0bd5d76",
                                                "text": "Intensywność tych rotacji ulegała nasileniu po podaniach chronicznych obu tych związków, przy czym efekt ten był szczególnie silny w przypadku agonisty receptorów D2"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
