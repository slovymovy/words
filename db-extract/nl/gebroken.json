                                    {
                                        "sense_id": "ff9d6250-daab-3128-bf8a-75187688de6e",
                                        "entry_id": "d4167eed-3c15-3982-97e6-9bd32dfe48bc",
                                        "glosses": [
                                            "Non-functional; not functioning properly.",
                                            "Badly designed or implemented."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffbb3cb4-81d8-4094-af67-b316f1e7a24b",
                                                "sense_id": "ff9d6250-daab-3128-bf8a-75187688de6e",
                                                "text": "This is the most broken application I've seen in a long time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13d0d7c2-7112-315d-a037-6687e220e116",
                                        "entry_id": "d4167eed-3c15-3982-97e6-9bd32dfe48bc",
                                        "glosses": [
                                            "Non-functional; not functioning properly.",
                                            "Grammatically non-standard, especially as a result of being produced by a non-native speaker."
                                        ],
                                        "tags": [
                                            "of language"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f50d698-2a3b-425c-99a2-b21009b6b482",
                                                "sense_id": "13d0d7c2-7112-315d-a037-6687e220e116",
                                                "text": "His conversation was in French with Mailey and Roxton, who both spoke the language well, but he had to fall back upon broken English with Malone, who could only utter still more broken French in reply."
                                            },
                                            {
                                                "example_id": "33dd8a4b-a0a2-44f9-b128-a2a254822999",
                                                "sense_id": "13d0d7c2-7112-315d-a037-6687e220e116",
                                                "text": "Don't say it in Russian / Don't say it in German / Say it in broken English"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e146e970-6bb0-39e6-8e38-ce1f48ef1d40",
                                        "entry_id": "d4167eed-3c15-3982-97e6-9bd32dfe48bc",
                                        "glosses": [
                                            "Non-functional; not functioning properly.",
                                            "Not having gone in the way intended; saddening."
                                        ],
                                        "tags": [
                                            "US",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0662c769-a770-4407-bad8-2a39ab2d7d90",
                                                "sense_id": "e146e970-6bb0-39e6-8e38-ce1f48ef1d40",
                                                "text": "Oh man! That is just broken!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4453c40-bcce-32ab-ac66-7c6290654f35",
                                        "entry_id": "d4167eed-3c15-3982-97e6-9bd32dfe48bc",
                                        "glosses": [
                                            "Completely defeated and dispirited; shattered; destroyed."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84a1e03f-422d-454b-adc0-b78002204631",
                                                "sense_id": "a4453c40-bcce-32ab-ac66-7c6290654f35",
                                                "text": "The bankruptcy and divorce, together with the death of his son, left him completely broken."
                                            },
                                            {
                                                "example_id": "f3392ee5-b6e4-496d-967e-1058928e5713",
                                                "sense_id": "a4453c40-bcce-32ab-ac66-7c6290654f35",
                                                "text": "He said, \"Son, when you grow up / Would you be the savior of the broken / The beaten, and the damned?\""
                                            },
                                            {
                                                "example_id": "56c5bd86-84f7-4bd5-9b20-57753c439032",
                                                "sense_id": "a4453c40-bcce-32ab-ac66-7c6290654f35",
                                                "text": "And oh, maybe I see a part of me in them / The missing piece, always trying to fit in / The shattered heart, hungry for a home / No, you're not alone / I love the broken ones / I love the broken ones"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abd649a0-9d4f-3142-89d5-d195f329d77f",
                                        "entry_id": "d4167eed-3c15-3982-97e6-9bd32dfe48bc",
                                        "glosses": [
                                            "Having no money; bankrupt, broke."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "91266ebf-6d8c-3022-8799-97c01b7c2855",
                                        "entry_id": "d4167eed-3c15-3982-97e6-9bd32dfe48bc",
                                        "glosses": [
                                            "Uneven."
                                        ],
                                        "tags": [
                                            "of land"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35331c8b-caa6-477b-90ec-8185b5d6f1d7",
                                                "sense_id": "91266ebf-6d8c-3022-8799-97c01b7c2855",
                                                "text": "All that day they rode into broken land. The prairie with its grass and rolling hills was behind them, and they entered a sparse, dry, rocky country, full of draws and short cañons and ominous buttresses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cee03a6-ea5c-3777-9841-a195a196d844",
                                        "entry_id": "d4167eed-3c15-3982-97e6-9bd32dfe48bc",
                                        "glosses": [
                                            "Overpowered; overly powerful; giving a player too much power."
                                        ],
                                        "tags": [
                                            "of a tactic or option"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2377465c-6a0b-4c03-afc4-932e6966b0aa",
                                                "sense_id": "4cee03a6-ea5c-3777-9841-a195a196d844",
                                                "text": "This item is incredibly broken. I win almost every run I get to use it."
                                            }
                                        ]
                                    }
