                "senses": [
                    {
                        "sense_id": "c58eb2f3-0e60-31b8-832a-1c672b2eef77",
                        "entry_id": "8a97ed26-c24b-3d26-99a4-dd5db3692c66",
                        "glosses": [
                            "Se rembourser tout seul, grâce aux profits ou économies générées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9532a87-b47e-49a0-b8c2-05e6247235d3",
                                "sense_id": "c58eb2f3-0e60-31b8-832a-1c672b2eef77",
                                "text": "Grâce aux revenus annuels générés par votre installation photovoltaïque, celle-ci s'auto-rembourse en 3 à 6 ans selon la région dans laquelle vous habitez."
                            },
                            {
                                "example_id": "2d34b875-b49c-43d2-bcf9-45c68f87d5f0",
                                "sense_id": "c58eb2f3-0e60-31b8-832a-1c672b2eef77",
                                "text": "Concrètement, votre apport personnel est placé et les gains rapportés par ce placement permet de reconstituer le montant du crédit que vous avez emprunté ; grâce au placement de votre apport, le credit bullet permet au capital du crédit de s’auto-reconstituer et donc de s’auto-rembourser."
                            },
                            {
                                "example_id": "dcc446f2-8141-492f-adc0-58e0521c04ce",
                                "sense_id": "c58eb2f3-0e60-31b8-832a-1c672b2eef77",
                                "text": "un investissement qui s'auto-rembourse en votre absence"
                            }
                        ]
                    }
