                ],
                "senses": [
                    {
                        "sense_id": "868e8da3-cd3b-3c07-a2ce-bfaffcfbfa18",
                        "entry_id": "66d56756-147e-36cd-a837-fae61cb020f3",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dccb96f-755f-4c11-9ca2-90078291959a",
                                "sense_id": "868e8da3-cd3b-3c07-a2ce-bfaffcfbfa18",
                                "text": "Frau Kunze ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "8437e9c6-3205-4d58-a307-cc7be8423efe",
                                "sense_id": "868e8da3-cd3b-3c07-a2ce-bfaffcfbfa18",
                                "text": "Herr Kunze wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d5414177-7d51-414c-b6d5-bfd7db8f9a16",
                                "sense_id": "868e8da3-cd3b-3c07-a2ce-bfaffcfbfa18",
                                "text": "Die Kunzes fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "73d8f7d2-310f-4f2e-b793-d24462cac650",
                                "sense_id": "868e8da3-cd3b-3c07-a2ce-bfaffcfbfa18",
                                "text": "Der Kunze trägt nie die Pullover, die die Kunze ihm strickt."
                            },
                            {
                                "example_id": "22733a10-fa46-467d-b1d1-c7abb7f5d54d",
                                "sense_id": "868e8da3-cd3b-3c07-a2ce-bfaffcfbfa18",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kunze kommt, geht der Herr Kunze.“"
                            },
                            {
                                "example_id": "5818ded9-69e1-4d09-b49e-c8aeab52c1fa",
                                "sense_id": "868e8da3-cd3b-3c07-a2ce-bfaffcfbfa18",
                                "text": "Kunze kommt und geht."
                            },
                            {
                                "example_id": "de2e8635-1be2-4f4d-80ba-7a91297d9857",
                                "sense_id": "868e8da3-cd3b-3c07-a2ce-bfaffcfbfa18",
                                "text": "Kunzes kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
