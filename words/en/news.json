                {
                    "sense_id": "9f37c860-de67-33bd-9e16-f77369edeaa3",
                    "sense_definition": "Messages posted on newsgroups.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The system administrator manages the flow of Usenet <w>news</w> across the network.",
                            "target_lang_translations": {
                                "ru": "Системный администратор управляет потоком <w>новостей</w> Usenet в сети.",
                                "zh": "系统管理员负责管理网络中Usenet<w>新闻</w>的流动。"
                            }
                        },
                        {
                            "text": "Users can post <w>news</w> to specific groups based on their interests.",
                            "target_lang_translations": {
                                "ru": "Пользователи могут публиковать <w>новости</w> в определённые группы в зависимости от своих интересов.",
                                "zh": "用户可以根据自己的兴趣将<w>新闻</w>发布到特定的群组中。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Usenet news",
                        "news server",
                        "news group"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "referring to Usenet/newsgroups context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сообщения, размещаемые в группах новостей (Usenet).",
                        "zh": "发布在新闻组（Usenet）上的信息。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "новости",
                                "target_lang_sense_clarification": "сообщения в группах новостей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "新闻",
                                "target_lang_sense_clarification": "网络论坛或新闻组中的帖子"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
