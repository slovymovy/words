                        ],
                        "form": "sébiles"
                    },
                    {
                        "form_id": "8fa7f4b5-446f-4704-bccf-9259d04d0a48",
                        "entry_id": "194962f1-2a43-374a-9447-74409d2a7512",
                        "tags": [],
                        "form": "sébille"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6fd7f678-5dbe-336c-bed4-237bdfe792ea",
                        "entry_id": "194962f1-2a43-374a-9447-74409d2a7512",
                        "glosses": [
                            "Récipient de bois ou de métal rond et creux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "198858b5-1473-4ce1-ac47-15262d55b8a1",
                                "sense_id": "6fd7f678-5dbe-336c-bed4-237bdfe792ea",
                                "text": "Sébile de buis."
                            },
                            {
                                "example_id": "5a587f6b-a5d5-4b9d-949f-eca2c64a2d17",
                                "sense_id": "6fd7f678-5dbe-336c-bed4-237bdfe792ea",
                                "text": "Le ravageur puise, à l’aide d’une longue drague, le sable de rivière sous la vase ; puis le recueillant dans de grandes sébiles de bois."
                            },
                            {
                                "example_id": "7918018d-5ea9-44af-ba5a-f621b55136b1",
                                "sense_id": "6fd7f678-5dbe-336c-bed4-237bdfe792ea",
                                "text": "Après une demi-heure de conversation, le délégué des Soviets avait quinze bouts de cigarettes dans sa sébile et le ton de notre dialogue avait pris un tour plus familier."
                            },
                            {
                                "example_id": "52696dd9-18db-42ff-84b8-11e3f317edcc",
                                "sense_id": "6fd7f678-5dbe-336c-bed4-237bdfe792ea",
                                "text": "Depuis, Madeleine leur a apporté des cartes, le tapis et des jetons dans une sébile."
                            },
                            {
                                "example_id": "66e34101-ccb2-4f1c-a3ed-098c867f504d",
                                "sense_id": "6fd7f678-5dbe-336c-bed4-237bdfe792ea",
                                "text": "La salle se remplit lentement d’intéressés et de curieux, et après une demi-heure de retard le commissaire-priseur armé de son marteau d’ivoire, le clerc chargé de bordereaux, l’expert avec son catalogue et le crieur muni d’une sébile fixée au bout d’une perche, prirent place sur l’estrade avec une solennité bourgeoise."
                            },
                            {
                                "example_id": "18379c27-4661-4854-9c2c-23b3f12f1e8c",
                                "sense_id": "6fd7f678-5dbe-336c-bed4-237bdfe792ea",
                                "text": "La tante ramassa l’écu, l’essuya et le mit dans la sébille, où il devait attendre, en compagnie de plusieurs autres, sa permutation en un vieux louis."
                            }
                        ]
                    },
                    {
                        "sense_id": "091ee29f-7ffa-36e1-a13f-31bb1623deeb",
                        "entry_id": "194962f1-2a43-374a-9447-74409d2a7512",
                        "glosses": [
                            "Récipient utilisé par les mendiants pour que les passants y déposent de l’argent."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "cae30942-234a-42d8-a659-09b1157566e5",
                                "sense_id": "091ee29f-7ffa-36e1-a13f-31bb1623deeb",
                                "text": "On jette dans la sébile des billets de dix pfennigs."
                            },
                            {
                                "example_id": "407b47b0-db37-44ea-916d-dd5c1c3f67e1",
                                "sense_id": "091ee29f-7ffa-36e1-a13f-31bb1623deeb",
                                "text": "Assis sur un tabouret pliant, un chapeau informe sur la tête et la sébile aux pieds, près de ma canne blanche, j’ébauche sur un Cavagnolo d’occasion quelques airs musette qui mettent du vague à l’âme des passants et leur soutirent des pièces de monnaie."
                            },
                            {
                                "example_id": "0fa03689-ec0f-40f1-a9cf-07211720393a",
                                "sense_id": "091ee29f-7ffa-36e1-a13f-31bb1623deeb",
                                "text": "Il passa devant un mendiant à l’épaisse barbe hirsute, à la peau presque brune de crasse. Il déposa deux euros dans sa sébile, puis, revenant sur ses pas, ajouta un billet de dix euros ; l’autre eut un grognement surpris."
                            },
                            {
                                "example_id": "c619b2b1-1909-445a-b245-84ccfdd7670b",
                                "sense_id": "091ee29f-7ffa-36e1-a13f-31bb1623deeb",
                                "text": "Posté près de l’entrée du métro, un itinérant tendait un bras décharné, un gobelet de carton à la main en guise de sébile."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b0e1259-b409-4979-af41-caa34dac91c3",
                        "source_entry_id": "194962f1-2a43-374a-9447-74409d2a7512",
                        "target_lang_word": "Schale",
