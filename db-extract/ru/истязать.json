                    }
                ],
                "translations": [
                    {
                        "translation_id": "960ed193-216f-4eef-ad17-d0e5ef0cbfad",
                        "source_entry_id": "489f1514-51ec-3b4b-a8dc-8c82e975dbc5",
                        "source_sense_id": "388efe18-605c-390f-a0aa-ae5e9aa73d08",
                        "target_lang_word": "torturer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "torturer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fa5c5545-79c3-36e9-94a6-179f3223aa0e",
                                        "entry_id": "cdf725f0-ada3-38bd-868a-89c2536de6d4",
                                        "glosses": [
                                            "Faire éprouver une torture, soumettre à la torture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4c6ad3c-fcfd-4615-8d0f-9d8a9043c2f9",
                                                "sense_id": "fa5c5545-79c3-36e9-94a6-179f3223aa0e",
                                                "text": "Alors, je commençai à torturer le colporteur. Je lui arrachai, un par un, tous les ongles des mains et tous les ongles des pieds…"
                                            },
                                            {
                                                "example_id": "08092322-473c-4034-8ae6-b93bfed44347",
                                                "sense_id": "fa5c5545-79c3-36e9-94a6-179f3223aa0e",
                                                "text": "Des nuits entières, durant un mois, j'ai entendu hurler des hommes que l'on torturait, et leurs cris résonnent pour toujours dans ma mémoire."
                                            },
                                            {
                                                "example_id": "ba4c220c-ef8d-4603-ae4b-0ba2dffcbbe2",
                                                "sense_id": "fa5c5545-79c3-36e9-94a6-179f3223aa0e",
                                                "text": "Tu es physionomiste, tu as bien dû sentir qu’il n’était pas le genre à torturer des femmes. […]. Au début, je m'étais dit qu'il avait peut–être tué Holly par accident pendant une séance de jeux SM, et qu'il s'était ensuite suicidé par remords."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c0daa59-d844-3923-991d-503d831c50eb",
                                        "entry_id": "cdf725f0-ada3-38bd-868a-89c2536de6d4",
                                        "glosses": [
                                            "Tourmenter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bddb745f-eb37-4d2d-9abd-88737ff93612",
                                                "sense_id": "6c0daa59-d844-3923-991d-503d831c50eb",
                                                "text": "Cette idée me torture."
                                            },
                                            {
                                                "example_id": "2ebc829f-6f25-44f4-a319-894820acec63",
                                                "sense_id": "6c0daa59-d844-3923-991d-503d831c50eb",
                                                "text": "Elle resta jusqu’au soir à se torturer l’esprit dans tous les projets de mensonges imaginables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff9f9635-5439-34aa-94e7-d97c7cba71d3",
                                        "entry_id": "cdf725f0-ada3-38bd-868a-89c2536de6d4",
                                        "glosses": [
                                            "Tordre, déformer un objet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ece5c12-903f-49dc-a9ce-c8db9587129c",
                                                "sense_id": "ff9f9635-5439-34aa-94e7-d97c7cba71d3",
                                                "text": "Torturer un texte, le sens d’un texte, le sens d’un mot."
                                            },
                                            {
                                                "example_id": "c3bdd1a7-b0a7-4081-a12a-631f3018e738",
                                                "sense_id": "ff9f9635-5439-34aa-94e7-d97c7cba71d3",
                                                "text": "Caillette avait apporté un tube de lait concentré qu'il torturait pour qu'il lâchât d'ultimes gouttes lourdes, épaisses, beiges, sucrées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
