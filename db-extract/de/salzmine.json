                "senses": [
                    {
                        "sense_id": "5c7b44f7-6052-399a-9060-1400aa6faf44",
                        "entry_id": "044292e2-482a-3f6e-8714-05435834ce0f",
                        "glosses": [
                            "Mine/Bergwerk, in dem Salz abgebaut wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dfcaad4-16aa-4d5c-b467-54a035cb207d",
                                "sense_id": "5c7b44f7-6052-399a-9060-1400aa6faf44",
                                "text": "„Die Augen dieses Vierzehnjährigen, seine Stimme, tief wie ein Nebelhorn, klang, als habe er miterleben müssen, wie seine sämtlichen Familienangehörigen als Sklaven in den Salzminen irgendeines abgelegenen Gulag zu Tode gefoltert worden waren, von Bluthunden über Eisschollen gehetzt, mit Lederpeitschen geprügelt.“"
                            },
                            {
                                "example_id": "58f70640-e3ce-450e-a136-79350b506f3c",
                                "sense_id": "5c7b44f7-6052-399a-9060-1400aa6faf44",
                                "text": "„Peng hätte Neal am liebsten auf der Stelle eine Kugel in den Hinterkopf gejagt, oder noch besser, ihn für ein oder zwei Jahrzehnte in die Salzminen von Xinxiang verbannt, aber der ungehobelte junge Weiße war der Einzige, der das kostbare China Girl erkennen würde.“"
                            },
                            {
                                "example_id": "19e38aaa-234a-4738-85a1-a91c07483f48",
                                "sense_id": "5c7b44f7-6052-399a-9060-1400aa6faf44",
                                "text": "„Er hat mich hier zurückgelassen, in diesem Haus, wo ich mich wie in einer Salzmine fühle, so überwältigend ist der Geruch der Traurigkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
