                {
                    "sense_id": "7019f6f8-a9e0-3351-b11c-f4f5540511b3",
                    "sense_definition": "Of a sauce or liquid: thickened and intensified in flavor by boiling to evaporate water.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "culinary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef served the steak with a <w>reduced</w> red wine sauce.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар подал стейк с <w>уваренным</w> соусом из красного вина.",
                                "zh": "厨师用<w>浓缩</w>红酒酱汁搭配牛排。"
                            }
                        },
                        {
                            "text": "Add the <w>reduced</w> stock to the mixture for a richer flavor.",
                            "target_lang_translations": {
