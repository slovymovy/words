                {
                    "sense_id": "88740d0f-b564-3bdc-ae3c-4343574eb28d",
                    "sense_definition": "Personne qui vit d'aumônes et sollicite la charité publique pour subsister.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "personne_pauvre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un <w>mendiant</w> assis au coin de la rue demandait une petite pièce aux passants."
                        },
                        {
                            "text": "Cette association distribue des repas chauds pour venir en aide à chaque <w>mendiant</w> du quartier."
                        }
                    ],
                    "synonyms": [
                        "SDF"
                    ]
                },
                {
                    "sense_id": "7eaa1c13-a5bc-3fc5-8fe4-34511fde1c91",
                    "sense_definition": "Confiserie constituée d'un disque de chocolat garni de divers fruits secs ou à coque.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gastronomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour les fêtes de fin d'année, l'artisan chocolatier prépare un délicieux <w>mendiant</w> au chocolat noir."
                        },
                        {
                            "text": "J'ai offert une boîte de friandises où chaque <w>mendiant</w> était décoré d'une noisette et d'une amande."
                        }
                    ],
                    "common_phrases": [
                        "mendiant au chocolat"
                    ]
                },
                {
                    "sense_id": "cbc976d0-70b9-3f33-8d10-ac9aeea8e626",
                    "sense_definition": "Au pluriel, assortiment traditionnel de quatre fruits secs servi en Provence lors du réveillon de Noël.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gastronomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sur la table de Noël, les treize desserts traditionnels comprennent toujours les quatre <w>mendiants</w>."
                        },
                        {
                            "text": "Elle a disposé des figues et des amandes pour former le plat de <w>mendiants</w> après le dîner."
                        }
                    ],
                    "common_phrases": [
                        "quatre mendiants"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Tradition provençale"
                        }
                    ]
                },
                {
                    "sense_id": "1871c4ee-4ef6-3fc0-a895-698dc78abadc",
                    "sense_definition": "Religieux appartenant à un ordre faisant vœu de pauvreté et vivant d'aumônes.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au Moyen Âge, ce <w>mendiant</w> parcourait les villages pour prêcher et recevoir un peu de nourriture."
                        },
                        {
                            "text": "Chaque <w>mendiant</w> de ce couvent renonçait à toute possession matérielle selon les règles de son ordre."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d71bbae2-fbca-3aa3-a998-89ca37c44f2f",
                    "sense_definition": "Qui vit de mendicité ou dépend de la charité d'autrui, notamment en parlant d'ordres religieux.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les frères de cet ordre <w>mendiant</w> ne possèdent aucun bien propre et vivent uniquement de dons."
                        },
                        {
                            "text": "Plusieurs congrégations <w>mendiantes</w> se sont développées dans les villes européennes au treizième siècle."
                        }
                    ],
                    "common_phrases": [
                        "ordre mendiant",
                        "moine mendiant"
                    ]
                },
                {
                    "sense_id": "0a2668e5-194d-30ef-ab58-af79ca6fc008",
                    "sense_definition": "Qui exprime une supplication humble, qui semble quémander.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chien affamé posait sur son maître un regard <w>mendiant</w> pour obtenir un morceau de pain."
                        },
                        {
                            "text": "Elle lui adressa une prière <w>mendiante</w> dans l'espoir d'obtenir enfin son pardon."
                        }
                    ],
                    "common_phrases": [
                        "regard mendiant"
                    ]
                }
            ]
        },
