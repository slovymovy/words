                "senses": [
                    {
                        "sense_id": "80fca95c-f6a0-3560-a8f6-6ce60ac6b3ce",
                        "entry_id": "8729301b-d2dd-38e8-92ce-5c7f522bdbbc",
                        "glosses": [
                            "an der Nordsee gelegener Hafen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c1945d8-2b65-4a5b-9b30-49c984206230",
                                "sense_id": "80fca95c-f6a0-3560-a8f6-6ce60ac6b3ce",
                                "text": "„Acht bis neun Frachttage - so viel würden die Chinesen einsparen, wenn sie ihre Exportwaren nicht mehr über die Nordseehäfen, sondern über ihr Containerterminal in Piräus nach Zentraleuropa bringen könnten.“"
                            },
                            {
                                "example_id": "d4b9e5ec-f361-4e8f-beef-bdcfe0e10e66",
                                "sense_id": "80fca95c-f6a0-3560-a8f6-6ce60ac6b3ce",
                                "text": "„Allein der VW-Konzern hat im vergangenen Jahr 2,7 Millionen Wagen über die Weltmeere geschickt, rund die Hälfte davon über den Nordseehafen Emden.“"
                            },
                            {
                                "example_id": "11122e75-7062-4e8e-a5ef-d1ce74aaf425",
                                "sense_id": "80fca95c-f6a0-3560-a8f6-6ce60ac6b3ce",
                                "text": "Zu bestimmten Zeiten kommen Händler aus den Nordseehäfen, aus Hamburg, Stade, Bremerhaven, auch von der Jade her, bereisen die Akaziengegenden, kaufen an und markieren die Bäume, die zunächst gefällt werden sollen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
