                        "sense_id": "6b12e342-fe81-36ff-bf77-67dcb5d264c9",
                        "entry_id": "6f6aef2e-f771-32f2-9017-3f87d306b628",
                        "glosses": [
                            "das Futter für die Pferde"
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "2dc284ac-e685-401d-8990-a84e7afe8248",
                                "sense_id": "6b12e342-fe81-36ff-bf77-67dcb5d264c9",
                                "text": "„Für Fourage hat Bartl gesorgt, tröste ich mich, und so was macht er gründlich: Zu verhungern brauchen wir nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5bb14e96-4510-31dd-bd70-7c18ec28ea21",
                        "entry_id": "6f6aef2e-f771-32f2-9017-3f87d306b628",
                        "glosses": [
                            "die Lebensmittel beziehungsweise der Mundvorrat für die Truppe"
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "b5f6d476-b841-4d87-a831-b5c647694991",
                                "sense_id": "5bb14e96-4510-31dd-bd70-7c18ec28ea21",
                                "text": "„Wer satt werden will, muss auch auf Fourage gehen.“"
                            },
                            {
                                "example_id": "4e7738ec-116f-4d26-bd6c-ac6656bd1257",
                                "sense_id": "5bb14e96-4510-31dd-bd70-7c18ec28ea21",
                                "text": "„Es war sinnlos, weiter nach Fourage zu suchen.“"
                            }
                        ],
