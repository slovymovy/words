                                    {
                                        "sense_id": "7452f872-b9d7-3ce3-a58c-9c832a5bb775",
                                        "entry_id": "a580eae0-63d8-3578-9999-e258b6472e51",
                                        "glosses": [
                                            "A philosophical view that deems procreation as immoral."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d263dabd-f706-43fd-a299-f1ad70cccdf8",
                                                "sense_id": "7452f872-b9d7-3ce3-a58c-9c832a5bb775",
                                                "text": "Antinatalism is a negative view toward human fertility (and perhaps the fertility of other sentient life forms). Philanthropic antinatalism is the belief that humans should not have children for the good of the (unborn) children—that it is better, for humans, not to be born (Benatar, 2006)."
                                            },
                                            {
                                                "example_id": "92051595-5a43-40c9-8445-b42c519aad1e",
                                                "sense_id": "7452f872-b9d7-3ce3-a58c-9c832a5bb775",
                                                "text": "Efilism, a form of antinatalism also linked to promortalism, gets its name by spelling “life” backwards."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
