{
    "word_family": [
        "naprawiać",
        "naprawa",
        "naprawczy",
        "naprawialny",
        "nienaprawialny"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a7ea7df1-c185-3661-913b-309be8decf15",
                    "sense_definition": "Przywrócić zepsuty lub uszkodzony przedmiot do stanu używalności; usunąć usterkę.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój tata potrafi <w>naprawić</w> prawie każde urządzenie domowe.",
                            "target_lang_translations": {
                                "ru": "Мой папа может <w>починить</w> почти любой бытовой прибор.",
                                "en": "My dad can <w>fix</w> almost any household appliance."
                            }
                        },
                        {
                            "text": "Muszę oddać buty do szewca, żeby je <w>naprawił</w>.",
                            "target_lang_translations": {
                                "ru": "Мне нужно отдать обувь сапожнику, чтобы он её <w>починил</w>.",
                                "en": "I have to take my shoes to the cobbler so he can <w>repair</w> them."
                            }
                        }
                    ],
                    "synonyms": [
                        "zreperować"
                    ],
                    "antonyms": [
                        "zepsuć",
                        "uszkodzić",
                        "zniszczyć"
                    ],
                    "common_phrases": [
                        "naprawić samochód",
                        "naprawić kran",
                        "naprawić zegarek",
                        "naprawić dach"
                    ],
                    "target_lang_definitions": {
                        "ru": "Привести сломанный или поврежденный предмет в рабочее состояние; устранить неисправность.",
                        "en": "To restore a broken or damaged item to working order; to fix a fault."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "починить",
                                "target_lang_sense_clarification": "самый распространенный глагол для ремонта вещей"
                            },
                            {
                                "target_lang_word": "отремонтировать",
                                "target_lang_sense_clarification": "более формально или о крупном ремонте"
                            },
                            {
                                "target_lang_word": "исправить",
                                "target_lang_sense_clarification": "устранить дефект или неполадку"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "fix",
                                "target_lang_sense_clarification": "general term for repairing something"
                            },
                            {
                                "target_lang_word": "repair",
                                "target_lang_sense_clarification": "more formal, often for machines, vehicles, or structures"
                            },
                            {
                                "target_lang_word": "mend",
                                "target_lang_sense_clarification": "often used for clothes, shoes, or simple objects"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41fc025a-ae50-398e-bc74-8cb9b719d5a9",
                    "sense_definition": "Usunąć skutki błędu, poprawić złą sytuację lub wynagrodzić wyrządzoną krzywdę.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chciałbym <w>naprawić</w> swój błąd i przeprosić za to, co powiedziałem.",
                            "target_lang_translations": {
                                "ru": "Я хотел бы <w>исправить</w> свою ошибку и извиниться за то, что сказал.",
                                "en": "I would like to <w>rectify</w> my mistake and apologize for what I said."
                            }
                        },
                        {
                            "text": "Trudno będzie <w>naprawić</w> relacje między nimi po tak wielkiej kłótni.",
                            "target_lang_translations": {
                                "ru": "Будет трудно <w>наладить</w> отношения между ними после такой крупной ссоры.",
                                "en": "It will be difficult to <w>mend</w> relations between them after such a huge argument."
                            }
                        }
                    ],
                    "antonyms": [
                        "pogorszyć"
                    ],
                    "common_phrases": [
                        "naprawić błąd",
                        "naprawić szkodę",
                        "naprawić relacje",
                        "naprawić krzywdy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устранить последствия ошибки, улучшить плохую ситуацию или возместить причиненный ущерб.",
                        "en": "To rectify a mistake, improve a bad situation, or make amends for harm done."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исправить",
                                "target_lang_sense_clarification": "ошибку, ситуацию"
                            },
                            {
                                "target_lang_word": "наладить",
                                "target_lang_sense_clarification": "отношения, связи"
                            },
                            {
                                "target_lang_word": "загладить",
                                "target_lang_sense_clarification": "вину, причиненный вред"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "rectify",
                                "target_lang_sense_clarification": "to put right a mistake or problematic situation"
                            },
                            {
                                "target_lang_word": "fix",
                                "target_lang_sense_clarification": "informal, referring to a problem, situation, or relationship"
                            },
                            {
                                "target_lang_word": "remedy",
                                "target_lang_sense_clarification": "to provide a solution or compensate for damage"
                            },
                            {
                                "target_lang_word": "mend",
                                "target_lang_sense_clarification": "used with relationships or fences"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "302892c5-73d7-3979-b0db-03674703b9b3",
                    "sense_definition": "Odzyskać sprawność, dobry stan lub ulec poprawie (używane z zaimkiem „się”).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Z czasem ich relacje <w>się naprawiły</w> i znów zostali przyjaciółmi.",
                            "target_lang_translations": {
                                "ru": "Со временем их отношения <w>наладились</w>, и они снова стали друзьями.",
                                "en": "Over time, their relationship <w>improved</w> and they became friends again."
                            }
                        },
                        {
                            "text": "Po restarcie systemu komputer sam <w>się naprawił</w>.",
                            "target_lang_translations": {
                                "ru": "После перезагрузки системы компьютер сам <w>починился</w>.",
                                "en": "After restarting the system, the computer <w>fixed itself</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "zepsuć się",
                        "pogorszyć się"
                    ],
                    "common_phrases": [
                        "pogoda się naprawiła",
                        "wszystko się naprawi",
                        "zdrowie się naprawiło"
                    ],
                    "target_lang_definitions": {
                        "ru": "Восстановить работоспособность, хорошее состояние или улучшиться (используется с местоимением «się»).",
                        "en": "To regain working order, improve, or turn out well (reflexive, with 'się')."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наладиться",
                                "target_lang_sense_clarification": "о погоде, делах или механизмах"
                            },
                            {
                                "target_lang_word": "исправиться",
                                "target_lang_sense_clarification": "стать лучше, скорректировать поведение"
                            },
                            {
                                "target_lang_word": "починиться",
                                "target_lang_sense_clarification": "разговорное, о предметах"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "improve",
                                "target_lang_sense_clarification": "about situations, weather, or relationships"
                            },
                            {
                                "target_lang_word": "right itself",
                                "target_lang_sense_clarification": "about a system or situation returning to normal automatically"
                            },
                            {
                                "target_lang_word": "get fixed",
                                "target_lang_sense_clarification": "to become functional again"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca2cd2d1-70b1-320d-8713-08c2c4c9c0b9",
                    "sense_definition": "Nalać płynu do naczynia (znaczenie regionalne).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gospodarz chętnie <w>naprawił</w> gościom wina do kielichów.",
                            "target_lang_translations": {
                                "ru": "Хозяин охотно <w>налил</w> гостям вина в бокалы.",
                                "en": "The host gladly <w>poured</w> wine into the guests' goblets."
                            }
                        },
                        {
                            "text": "Proszę mi <w>naprawić</w> jeszcze trochę herbaty.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>налейте</w> мне еще немного чая.",
                                "en": "Please <w>pour</w> me some more tea."
                            }
                        }
                    ],
                    "synonyms": [
                        "nalać"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "używane głównie na Śląsku lub w języku dawnym"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Налить жидкость в посуду (региональное значение).",
                        "en": "To pour liquid into a vessel (regional or archaic)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "налить",
                                "target_lang_sense_clarification": "стандартный перевод"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "pour",
                                "target_lang_sense_clarification": "to dispense a drink into a cup or glass"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}