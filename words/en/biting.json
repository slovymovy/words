                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола bite.",
                        "nl": "Het tegenwoordig deelwoord en gerundium van het werkwoord bijten."
