                "senses": [
                    {
                        "sense_id": "71a88e92-8ea5-3e25-9d01-4cea376a6dd8",
                        "entry_id": "c020d027-208b-37bd-956c-af243b01658e",
                        "glosses": [
                            "Verbindung von Sprachlauten in Äußerungen/Wörtern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8718f9cd-2ec0-4ebb-99ac-02cb79593fcc",
                                "sense_id": "71a88e92-8ea5-3e25-9d01-4cea376a6dd8",
                                "text": "„Noch deutlicher werden die Unterschiede zwischen den verschiedenen Sprachen, wenn wir von den einzelnen Lauten zu den Lautkombinationen übergehen.“"
                            },
                            {
                                "example_id": "66cdb2a9-6aea-4768-8500-d7b52e274ff5",
                                "sense_id": "71a88e92-8ea5-3e25-9d01-4cea376a6dd8",
                                "text": "„Dies erhöht die Assoziierung einer Lautkombination mit der entsprechenden Buchstabenkombination.“"
                            },
                            {
                                "example_id": "c1eaaf24-f2c0-4a59-87bb-88a743565f11",
                                "sense_id": "71a88e92-8ea5-3e25-9d01-4cea376a6dd8",
                                "text": "„Die phonotaktischen Muster einer Sprache erlauben bestimmte Lautkombinationen in Wörtern und andere nicht.“"
                            },
                            {
                                "example_id": "3973c12a-7eaf-4684-9f30-34960239ba0c",
                                "sense_id": "71a88e92-8ea5-3e25-9d01-4cea376a6dd8",
                                "text": "„Das gesprochene Chinsesisch [sic!] verfügt über weniger Lautkombinationen als das Deutsche.“"
                            },
                            {
                                "example_id": "1cac285e-b3d7-4e80-9482-d1751ea1067d",
                                "sense_id": "71a88e92-8ea5-3e25-9d01-4cea376a6dd8",
                                "text": "„Ein ganz anderer Wunsch von werdenden Eltern besteht mitunter darin, Vorschläge für Vornamen mit bestimmten Laut- oder Buchstabenkombinationen zu bekommen, etwa Namen, die mit Va- oder La- beginnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
