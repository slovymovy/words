                        "glosses": [
                            "Oudgrieks dat vanaf de 4e eeuw vóór tot de 15e eeuw ná Christus voertaal in het oostelijke Middellandse Zeegebied was"
                        ],
                        "tags": [
                            "linguistics",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "6e2ecfc3-c4b9-408c-8e47-561c02b3a609",
                                "sense_id": "cd57da70-98f0-31e1-bbac-e57614c7d5fb",
                                "text": "Er bestaan ook goede Nederlandse woordenboeken, bijv. van klassiek Grieks waar ook het Koine is in verwerkt."
                            },
                            {
                                "example_id": "f3b20c65-b936-4512-99c8-cb2c967b2dd1",
                                "sense_id": "cd57da70-98f0-31e1-bbac-e57614c7d5fb",
                                "text": "De nieuwe christelijke leer - die religieus een parvenu was - ging er in zekere zin dus vandoor met het Hebreeuwse Oude Testament, maar liet dit uitmonden in een nieuwe taal, het Koine-Grieks. Maar dat Koine was alleen de taal van het oostelijk deel van het Romeinse rijk."
                            }
                        ]
                    }
