                "senses": [
                    {
                        "sense_id": "bbf5a8f5-7411-3364-bdfa-e5ce417032a1",
                        "entry_id": "4c4f6420-5cc8-3624-950a-ded15c77bd45",
                        "glosses": [
                            "mit einer Plane bedeckter Wagen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c727678-1073-4200-be2e-13117d9a0517",
                                "sense_id": "bbf5a8f5-7411-3364-bdfa-e5ce417032a1",
                                "text": "„Ihr Federbett wird im Planwagen verstaut.“"
                            },
                            {
                                "example_id": "09ac2b8b-eddd-4afb-8439-620b41596f9f",
                                "sense_id": "bbf5a8f5-7411-3364-bdfa-e5ce417032a1",
                                "text": "„Der Goldrausch war ausgebrochen und zog ganze Karawanen an Planwagen in die Ferne der Sierra Nevada und nach Alaska.“"
                            },
                            {
                                "example_id": "dc1e016c-b257-4c5f-8137-8944305d175b",
                                "sense_id": "bbf5a8f5-7411-3364-bdfa-e5ce417032a1",
                                "text": "„Als wir Albany erreichten, besuchten wir den Gouverneur, ließen ihn dreimal hochleben, bekamen ein wenig freundlichen Beifall zurück und wurden alle in Planwagen vor seiner Tür verstaut, jede Backschaft in einem.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
