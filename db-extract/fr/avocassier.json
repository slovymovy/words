                    {
                        "sense_id": "c7e132d1-fa48-32c8-b189-85564b08579e",
                        "entry_id": "d1d6eb92-2eaf-3261-abd8-d013ebb60069",
                        "glosses": [
                            "Mauvais avocat."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "aa2cb52d-0af4-4315-a5f5-669805d23a62",
                                "sense_id": "c7e132d1-fa48-32c8-b189-85564b08579e",
                                "text": "Maintenant qu’est passée la période loquace où la facilité de langage et les attitudes impressionnantes étaient une condition nécessaire pour atteindre à la prééminence politique, le contrôle tombe de plus en plus entièrement dans les mains d’une classe d’avocassiers et d’intrigants , à l’esprit souple et tenace."
                            },
                            {
                                "example_id": "2a58221d-4b43-4519-b36d-13fa94e73727",
                                "sense_id": "c7e132d1-fa48-32c8-b189-85564b08579e",
                                "text": "Etait-il déformé par la petite politique, ou subissait-il l’influence d’avocassiers tels que le gendarme Major Gratton?"
                            },
                            {
                                "example_id": "7812439e-ad33-472b-b102-57f49bae8a34",
                                "sense_id": "c7e132d1-fa48-32c8-b189-85564b08579e",
                                "text": "portraitiste attendri de ces élus qui apportent de leur Midi « le type du bon vivant avocassier et vigneron, Fallières, Loubet, Doumergue »."
                            }
                        ]
                    }
