                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8318068-4df9-4526-a59c-09c215eaf83d",
                                "sense_id": "83363f55-0853-342f-8ed4-7758729b9cfc",
                                "text": "De werkzaamheid van die machine is erg goed."
                            }
                        ]
                    },
                    {
                        "sense_id": "e518b405-e3f3-37e3-8a6b-e6f8b525da9d",
                        "entry_id": "b460eb66-df35-3c5d-a2a9-f8db94c0067c",
