                                "sense_id": "f11a87a8-9ff2-33dd-a631-b0f847012996",
                                "text": "„Kurze Zeit später endete die Besuchszeit.“"
                            },
                            {
                                "example_id": "9293d1aa-4fe3-41fa-aba8-fd3f4728f662",
                                "sense_id": "f11a87a8-9ff2-33dd-a631-b0f847012996",
                                "text": "„Die Besuchszeit war beendet und wir verabschiedeten uns.“"
