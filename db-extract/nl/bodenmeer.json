                                        "sense_id": "da53873e-2061-33d7-968f-b4f709a7ee29",
                                        "entry_id": "7fb99651-59cd-317e-9a33-b01dbae1fe3a",
                                        "glosses": [
                                            "ein See in Süddeutschland, der Schweiz und Österreich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49553e74-3b11-4798-8140-290c40863f9d",
                                                "sense_id": "da53873e-2061-33d7-968f-b4f709a7ee29",
                                                "text": "Am Bodensee liegen Deutschland, die Schweiz und Österreich."
                                            },
                                            {
                                                "example_id": "2dcc5a49-a26e-4554-b6a3-4ab152e86624",
                                                "sense_id": "da53873e-2061-33d7-968f-b4f709a7ee29",
                                                "text": "„Während im übrigen Land noch winterliches Schmuddelwetter herrscht, ist es am Bodensee schon frühlingshaft mild.“"
                                            },
                                            {
                                                "example_id": "6664b09f-c41d-47cf-b02d-7521e4ee9005",
                                                "sense_id": "da53873e-2061-33d7-968f-b4f709a7ee29",
                                                "text": "„Denkmal für die gefallenen Luftschiffer: Am 1. Juli 1900 wagte Graf Zeppelin den ersten Flug mit dem nach ihm benannten Fluggerät über den Bodensee.“"
                                            },
                                            {
                                                "example_id": "9e9fc6ba-2559-4d95-b350-e00df3c8623f",
                                                "sense_id": "da53873e-2061-33d7-968f-b4f709a7ee29",
                                                "text": "„In seiner Freizeit hat sich Bundschuh auf dem Bodensee zwischen Lindau und der Insel Mainau ausgetobt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
