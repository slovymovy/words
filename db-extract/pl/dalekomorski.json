                                    },
                                    {
                                        "sense_id": "c8a25761-ac23-3bcb-be0a-e44621c677fe",
                                        "entry_id": "926241ed-20fd-3415-b124-d5ac3da07be6",
                                        "glosses": [
                                            "Able to accommodate the largest ships."
                                        ],
                                        "tags": [
                                            "of a port"
                                        ],
                                        "examples": [
                                            {
