                                "target_senses": [
                                    {
                                        "sense_id": "fe4154b2-4f92-31f4-a78b-60e6f76e86f8",
                                        "entry_id": "0440c99b-6605-3426-b3fe-cdb8e21ccf35",
                                        "glosses": [
                                            "A dryad pursued by Apollo, who was turned into a laurel tree by the river god Peneus."
                                        ],
                                        "tags": [
                                            "Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9faa2e9-f409-43ff-8d3b-acdb95bbcaf7",
                                                "sense_id": "fe4154b2-4f92-31f4-a78b-60e6f76e86f8",
                                                "text": "Run when you will, the story shall be chang'd; / Apollo flies, and Daphne holds the chase; / The dove pursues the griffin"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21ecc6df-6d3a-3a0a-acdf-f5fbdc2e86b7",
                                        "entry_id": "0440c99b-6605-3426-b3fe-cdb8e21ccf35",
                                        "glosses": [
                                            "41 Daphne, a main belt asteroid."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "56df774a-6ad6-3f4a-ba6c-680e6a2d724a",
                                        "entry_id": "0440c99b-6605-3426-b3fe-cdb8e21ccf35",
                                        "glosses": [
                                            "A female given name from Ancient Greek."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f3e3bef-d8d7-4971-8cfc-aef788a1848c",
                                                "sense_id": "56df774a-6ad6-3f4a-ba6c-680e6a2d724a",
                                                "text": "My wife. Daphne. Yes, that was, is, her name. For some reason people have always found it faintly comic. I think it matches very well her damp, dark, myopic beauty."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
