                                                "sense_id": "6bb2831e-6ac3-34d2-9af9-551ad09b9d22",
                                                "text": "Jouir de l’extraterritorialité."
                                            },
                                            {
                                                "example_id": "0ec5d3f6-0a2e-4d9c-8c5f-8cb58dbeb935",
                                                "sense_id": "6bb2831e-6ac3-34d2-9af9-551ad09b9d22",
                                                "text": "Le bénéfice de l’extraterritorialité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "567aef31-175f-3ccb-8635-56ac259df9c1",
                                        "entry_id": "51274d82-92c8-3712-a6e0-17e22e0334e3",
                                        "glosses": [
                                            "Principe juridique qui permet aux navires d'être considérés, en matière de droit applicable, comme relevant des lois de leur territoire d'origine, quelles que soient les eaux où ils croisent."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fa2f050a-754e-399e-8e93-3ef81f891e97",
                                        "entry_id": "51274d82-92c8-3712-a6e0-17e22e0334e3",
                                        "glosses": [
                                            "Principe de droit international public qui revient pour un pays à laisser s'exercer l'autorité d'un État étranger ou d'une organisation internationale sur une partie de son territoire propre. Le fait pour un pays de faire appliquer ses propres règles sur un territoire étranger."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
