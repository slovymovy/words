                        "glosses": [
                            "mit Hieroglyphen bedeckt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d604a861-cd6a-4935-a7bc-1b7098b787da",
                                "sense_id": "fd5e80c6-6712-3441-b2bb-bd971b413c63",
                                "text": "„Das hockende Götzenbild mit seinem Tintenfischhaupt, seinem Drachenleib, Schuppenschwingen, und dem hieroglyphenbedeckten Sockel befand sich im Museum im Hyde Park, und ich betrachtete es lange und genau, dieses Stück unheilvoller, doch vorzüglicher Handarbeit, das ebenso rätselhaft und unergründlich alt war und aus dem gleichen unirdisch fremden Material wie das kleinere Exemplar von Legrasse.“"
                            }
                        ],
