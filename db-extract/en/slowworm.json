                                        "entry_id": "8fe01ec7-6d03-32ef-bb54-1037a9386520",
                                        "glosses": [
                                            "eine Echsenart innerhalb der Familie der Schleichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55fd04d4-98fd-492d-b40b-d34f324bc916",
                                                "sense_id": "11b8abf4-3107-31e7-ae92-6b99bcb588bb",
                                                "text": "Die Blindschleiche wird oft für eine Schlange gehalten."
                                            },
                                            {
                                                "example_id": "3c222709-77c8-43d1-87a5-025ae7941b48",
                                                "sense_id": "11b8abf4-3107-31e7-ae92-6b99bcb588bb",
                                                "text": "„Er zeigte mir eine Blindschleiche und erläuterte, dass sie nicht giftig sei.“"
                                            },
                                            {
                                                "example_id": "2afc7eff-02bc-4519-854c-c7ea8fbd924a",
                                                "sense_id": "11b8abf4-3107-31e7-ae92-6b99bcb588bb",
                                                "text": "„Es gibt die Blindschleiche, die gar keine Schlange ist, sondern eine Echsenart aus der Familie der Schleichen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
