                    {
                        "sense_id": "52b2f5d4-8aa9-3b38-88b8-df731de6690d",
                        "entry_id": "8029b29c-a4b1-3b87-b47e-926a483aa3d2",
                        "glosses": [
                            "Baignoire équipée d’un système de pulsion d’air et d’eau sous pression plus ou moins complexe procurant un effet massant et relaxant à son utilisateur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7e23d6d-eba2-46d9-a296-f336a3e7a7b9",
                                "sense_id": "52b2f5d4-8aa9-3b38-88b8-df731de6690d",
                                "text": "En effet, des dysfonctionnements ont commencé à apparaître ces derniers mois, avec des fermetures d’espace tels que la balnéo ou les jacuzzis extérieurs."
                            },
                            {
                                "example_id": "41a7d34d-6c9c-46f9-8264-2603a9d5baae",
                                "sense_id": "52b2f5d4-8aa9-3b38-88b8-df731de6690d",
                                "text": "Les saunas ou clubs humides proposent régulièrement des soirées mousse dans l’espace hammam ou autour du jacuzzi."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa20dcd4-f4d3-4296-9703-03d1d41bd379",
                        "source_entry_id": "8029b29c-a4b1-3b87-b47e-926a483aa3d2",
