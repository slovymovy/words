{
    "word_family": [
        "crowd",
        "crowding",
        "overcrowded",
        "overcrowding"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "92f372f1-f8c8-32f3-a88e-af7d6d32d7c2",
                    "sense_definition": "Containing a large number of people or things packed closely together.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "density",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The train is usually <w>crowded</w> and half the township seems to turn out to watch it go off.",
                            "target_lang_translations": {
                                "ru": "Поезд обычно <w>переполнен</w>, и кажется, что половина городка выходит посмотреть на его отправление."
                            }
                        },
                        {
                            "text": "We decided to leave the <w>crowded</w> city and spend our weekend in a quiet village.",
                            "target_lang_translations": {
                                "ru": "Мы решили уехать из <w>многолюдного</w> города и провести выходные в тихой деревне."
                            }
                        },
                        {
                            "text": "The <w>crowded</w> room made it very difficult for anyone to move around freely.",
                            "target_lang_translations": {
                                "ru": "В <w>переполненной</w> комнате всем было очень трудно свободно передвигаться."
                            }
                        }
                    ],
                    "synonyms": [
                        "dense",
                        "packed",
                        "compact"
                    ],
                    "antonyms": [
                        "empty",
                        "deserted",
                        "spacious"
                    ],
                    "common_phrases": [
                        "crowded city",
                        "crowded room",
                        "crowded street"
                    ],
                    "target_lang_definitions": {
                        "ru": "Содержащий большое количество людей или предметов, плотно прижатых друг к другу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переполненный",
                                "target_lang_sense_clarification": "о транспорте или помещении"
                            },
                            {
                                "target_lang_word": "многолюдный",
                                "target_lang_sense_clarification": "о городе или улице"
                            },
                            {
                                "target_lang_word": "людный",
                                "target_lang_sense_clarification": "о месте с большим количеством людей"
                            },
                            {
                                "target_lang_word": "набитый",
                                "target_lang_sense_clarification": "плотно заполненный людьми или вещами"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "99510ac7-da10-3f72-a74f-8d1478f5e7a1",
                    "sense_definition": "The simple past and past participle of <w>crowd</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "grammatical_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fans <w>crowded</w> around the stage to get a better view of the singer.",
                            "target_lang_translations": {
                                "ru": "Фанаты <w>столпились</w> вокруг сцены, чтобы лучше видеть певца."
                            }
                        },
                        {
                            "text": "Doubt and fear <w>crowded</w> his mind as he waited for the test results.",
                            "target_lang_translations": {
                                "ru": "Сомнения и страх <w>заполнили</w> его мысли, пока он ждал результатов анализов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "crowded around",
                        "crowded into"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола crowd (толпиться, тесниться)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "столпились",
                                "target_lang_sense_clarification": "о группе людей"
                            },
                            {
                                "target_lang_word": "заполнили",
                                "target_lang_sense_clarification": "о мыслях или пространстве"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}