{
    "word_family": [
        "rehearsal",
        "rehearser"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "35d8d890-cfcb-3732-b4b3-e55349fd3dee",
                    "sense_definition": "To practice a play, piece of music, or other work in private before giving a public performance.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "performance_practice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The main actors spent on average two hours a day <w>rehearsing</w> before the first night.",
                            "target_lang_translations": {
                                "ru": "Главные актеры проводили в среднем по два часа в день, <w>репетируя</w> перед премьерой."
                            }
                        },
                        {
                            "text": "The band needs to <w>rehearse</w> a play before they perform it live on stage next week.",
                            "target_lang_translations": {
                                "ru": "Группе нужно <w>отрепетировать</w> пьесу перед тем, как выступить с ней вживую на сцене на следующей неделе."
                            }
                        }
                    ],
                    "synonyms": [
                        "practice",
                        "run through"
                    ],
                    "common_phrases": [
                        "rehearse a play",
                        "rehearse a song"
                    ],
                    "target_lang_definitions": {
                        "ru": "Репетировать пьесу, музыкальное произведение или другую работу перед публичным выступлением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "репетировать",
                                "target_lang_sense_clarification": "спектакль, роль, песню"
                            },
                            {
                                "target_lang_word": "прогонять",
                                "target_lang_sense_clarification": "сцену, материал"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eee74538-6bde-3fe1-b57e-504c5f326d1e",
                    "sense_definition": "To repeat or go over something already said; to restate or recite.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "repetition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There’s no need to <w>rehearse</w> the same old argument; we’ve heard it before, and we all agree.",
                            "target_lang_translations": {
                                "ru": "Нет необходимости <w>повторять</w> один и тот же старый аргумент; мы его уже слышали и все согласны."
                            }
                        },
                        {
                            "text": "She began to <w>rehearse</w> the facts of the case to make sure she remembered everything.",
                            "target_lang_translations": {
                                "ru": "Она начала <w>излагать</w> факты дела, чтобы убедиться, что ничего не забыла."
                            }
                        }
                    ],
                    "synonyms": [
                        "repeat",
                        "reiterate",
                        "recount"
                    ],
                    "common_phrases": [
                        "rehearse the facts",
                        "rehearse the argument"
                    ],
                    "target_lang_definitions": {
                        "ru": "Повторять или пересказывать то, что уже было сказано; излагать заново."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повторять",
                                "target_lang_sense_clarification": "аргументы, слова"
                            },
                            {
                                "target_lang_word": "твердить",
                                "target_lang_sense_clarification": "одно и то же"
                            },
                            {
                                "target_lang_word": "излагать",
                                "target_lang_sense_clarification": "факты, доводы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4847099-e837-3eaf-b9d6-36d5b2f57743",
                    "sense_definition": "To carefully prepare and practice a story or explanation beforehand, often to ensure consistency or to deceive.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "preparation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Crown argued that the accused had <w>rehearsed</w> her story before speaking to the police.",
                            "target_lang_translations": {
                                "ru": "Обвинение утверждало, что подсудимая <w>отрепетировала</w> свою историю перед разговором с полицией."
                            }
                        },
                        {
                            "text": "They sat in the car to <w>rehearse</w> an alibi so that their accounts would match perfectly.",
                            "target_lang_translations": {
                                "ru": "Они сидели в машине, чтобы <w>отработать</w> алиби, дабы их показания идеально совпадали."
                            }
                        }
                    ],
                    "synonyms": [
                        "concoct",
                        "prepare"
                    ],
                    "common_phrases": [
                        "rehearse an alibi",
                        "rehearse a story"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тщательно готовить и отрабатывать историю или объяснение заранее, часто для обеспечения согласованности или обмана."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "репетировать",
                                "target_lang_sense_clarification": "историю, алиби"
                            },
                            {
                                "target_lang_word": "продумывать",
                                "target_lang_sense_clarification": "версию, оправдание"
                            },
                            {
                                "target_lang_word": "отрабатывать",
                                "target_lang_sense_clarification": "легенду, показания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8361705f-e262-3c35-a6d2-c395310c483e",
                    "sense_definition": "To train or instruct a person or group by directing their rehearsal.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "performance_practice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director <w>rehearsed</w> the cast incessantly in the days leading up to opening night.",
                            "target_lang_translations": {
                                "ru": "Режиссер непрестанно <w>гонял</w> актерский состав в дни, предшествующие премьере."
                            }
                        },
                        {
                            "text": "She spent hours trying to <w>rehearse</w> the choir until every note was absolutely perfect.",
                            "target_lang_translations": {
                                "ru": "Она часами пыталась <w>репетировать</w> с хором, пока каждая нота не зазвучала абсолютно идеально."
                            }
                        }
                    ],
                    "synonyms": [
                        "train",
                        "coach",
                        "drill"
                    ],
                    "common_phrases": [
                        "rehearse the cast",
                        "rehearse the choir"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обучать или инструктировать человека или группу, руководя их репетицией."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "репетировать с",
                                "target_lang_sense_clarification": "актерами, хором"
                            },
                            {
                                "target_lang_word": "натаскивать",
                                "target_lang_sense_clarification": "труппу, исполнителей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a50b953a-706e-38a3-a7b5-edaf35fbf2a0",
                    "sense_definition": "To narrate, relate, or recount a series of events in detail.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "repetition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness <w>rehearsed</w> the events of the night before for the listening detectives.",
                            "target_lang_translations": {
                                "ru": "Свидетель подробно <w>изложил</w> события прошлой ночи внимательно слушавшим детективам."
                            }
                        },
                        {
                            "text": "He sat by the fire to <w>rehearse</w> the story of his long journey to the eager crowd.",
                            "target_lang_translations": {
                                "ru": "Он сидел у костра, чтобы <w>пересказать</w> историю своего долгого путешествия нетерпеливой толпе."
                            }
                        }
                    ],
                    "synonyms": [
                        "narrate",
                        "relate",
                        "recount"
                    ],
                    "common_phrases": [
                        "rehearse the events",
                        "rehearse the story"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This sense of narrating or recounting is literary or dated."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подробно рассказывать, излагать или перечислять ряд событий (устаревшее или литературное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "излагать",
                                "target_lang_sense_clarification": "события, факты"
                            },
                            {
                                "target_lang_word": "пересказывать",
                                "target_lang_sense_clarification": "историю, подробности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}