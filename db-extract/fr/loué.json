                ],
                "senses": [
                    {
                        "sense_id": "3455fcd0-7693-35b3-a11c-0d056b5f3ff4",
                        "entry_id": "f1eb056d-de6e-37ca-8c26-0571e08f48f9",
                        "glosses": [
                            "Qui est l’objet de louange."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6db3248-5448-4a42-afb9-e98c123cb116",
                                "sense_id": "3455fcd0-7693-35b3-a11c-0d056b5f3ff4",
                                "text": "Dieu soit loué."
                            },
                            {
                                "example_id": "3a6d1952-943d-4f00-a34c-96042e6cfc05",
                                "sense_id": "3455fcd0-7693-35b3-a11c-0d056b5f3ff4",
                                "text": "Le soir, après la dînette que Mme Macaire lui offrait de partager avec elle sur sa table de nuit, la méditation quotidienne achevée, suivie d'un brin de causette, sœur Marie-Gabrielle quand elle avait sommeil, tout d'un coup se levait, disant :\n– « Loué soit Jésus-Christ ! » et partait.\nMme Macaire, charmante, raconte qu'elle a hérité de cette manie de la Sœur, que maintenant, si quelqu'un l'ennuie ou la retient, elle s'écrie :\n– « Loué soit Jésus-Christ ! » et s'en va."
                            }
                        ]
                    },
                    {
                        "sense_id": "d296de7a-e484-3426-9e8f-38a9348702f0",
                        "entry_id": "f1eb056d-de6e-37ca-8c26-0571e08f48f9",
                        "glosses": [
                            "Qui est l'objet d’une location."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66ac3b46-bfe7-4bfa-a6b5-37cb10cefdb1",
                                "sense_id": "d296de7a-e484-3426-9e8f-38a9348702f0",
                                "text": "Une maison louée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af290ece-18f3-446c-b5fe-6d5e56a776fa",
                        "source_entry_id": "f1eb056d-de6e-37ca-8c26-0571e08f48f9",
                        "source_sense_id": "3455fcd0-7693-35b3-a11c-0d056b5f3ff4",
                        "source_sense_description": "Objet de louange",
                        "target_lang_word": "blessed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blessed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b4b2e04-0114-3a1b-bc4c-8e94fc7417f8",
                                        "entry_id": "d4690e40-ca05-3f84-90b6-854b12033a7b",
                                        "glosses": [
                                            "Having divine aid, or protection, or other blessing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f3b3130-ac14-438c-8056-5b0da14f675e",
                                                "sense_id": "7b4b2e04-0114-3a1b-bc4c-8e94fc7417f8",
                                                "text": "Blessed are the meek: for they shall inherit the earth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d96f523e-5421-3fbd-bfa5-3bcf96196aa9",
                                        "entry_id": "d4690e40-ca05-3f84-90b6-854b12033a7b",
                                        "glosses": [
                                            "A title indicating the beatification of a person, thus allowing public veneration of those who have lived in sanctity or died as martyrs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "202b5f58-a9db-35e3-8a04-708484925b9f",
                                        "entry_id": "d4690e40-ca05-3f84-90b6-854b12033a7b",
                                        "glosses": [
                                            "Held in veneration; revered."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3adda4a-df2f-4525-b25a-dbbd7227f911",
                                                "sense_id": "202b5f58-a9db-35e3-8a04-708484925b9f",
                                                "text": "‘My blessed Public must have a pretty girl’s face. Romance isn’t romance, adventure is as dull as dishwater...to my Public...unless, every so often, a face to sink a thousand ships, or is it saps? shows up.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c41eabd-c0bf-336c-b322-c41203cb691d",
                                        "entry_id": "d4690e40-ca05-3f84-90b6-854b12033a7b",
                                        "glosses": [
                                            "Worthy of worship; holy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d9d88411-a423-3c14-9ced-ff3a4a6f5473",
                                        "entry_id": "d4690e40-ca05-3f84-90b6-854b12033a7b",
                                        "glosses": [
                                            "Elect or saved after death; hence (euphemistic) dead."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b91b96aa-9866-4c08-967c-8b28beaa1934",
                                                "sense_id": "d9d88411-a423-3c14-9ced-ff3a4a6f5473",
                                                "text": "I know—for Death, who comes for me\nFrom regions of the blest afar,\nWhere there is nothing to deceive,\nHath left his iron gate ajar, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "224461d6-2e6e-3cc9-85d9-6a487247f9a1",
                                        "entry_id": "d4690e40-ca05-3f84-90b6-854b12033a7b",
                                        "glosses": [
                                            "damned (as an intensifier or vehement denial)"
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c752127-de4b-4be1-8deb-8dc5de6257f4",
                                                "sense_id": "224461d6-2e6e-3cc9-85d9-6a487247f9a1",
                                                "text": "Not one blessed person offered to help me out."
                                            },
                                            {
                                                "example_id": "d47a96d3-c844-4d92-9ea2-caa32a4ac981",
                                                "sense_id": "224461d6-2e6e-3cc9-85d9-6a487247f9a1",
                                                "text": "I'm blessed if I'm going to drive all that way at this time of night."
                                            }
                                        ]
                                    }
                                ]
                            },
