{
    "word_family": [
        "mewl"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b1b39883-3713-31e7-8ca4-cfb5defffe55",
                    "sense_definition": "A weak, high-pitched crying or whimpering sound, like that of a young animal or baby.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I heard a faint <w>mewling</w> coming from the box left on the doorstep.",
                            "target_lang_translations": {
                                "de": "Ich hörte ein leises <w>Wimmern</w> aus der Schachtel, die auf der Türschwelle abgestellt worden war."
                            }
                        },
                        {
                            "text": "The quiet <w>mewling</w> sound woke her up in the middle of the night.",
                            "target_lang_translations": {
                                "de": "Das leise <w>Wimmern</w> weckte sie mitten in der Nacht auf."
                            }
                        }
                    ],
                    "synonyms": [
                        "whimpering",
                        "mewing",
                        "whining"
                    ],
                    "common_phrases": [
                        "faint mewling",
                        "mewling sound"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein schwaches, hohes Weinen oder Wimmern, wie das eines jungen Tieres oder Babys."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "das Wimmern",
                                "target_lang_sense_clarification": "von Babys oder kleinen Tieren"
                            },
                            {
                                "target_lang_word": "das Miauen",
                                "target_lang_sense_clarification": "von Katzen oder Kätzchen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2d83b46c-1a32-3e42-a983-d05ffd289424",
                    "sense_definition": "present participle and gerund of <w>mewl</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hungry kitten was <w>mewling</w> loudly for its mother.",
                            "target_lang_translations": {
                                "de": "Das hungrige Kätzchen <w>miaute</w> laut nach seiner Mutter."
                            }
                        },
                        {
                            "text": "A soft <w>mewling</w> baby was lying comfortably in the crib.",
                            "target_lang_translations": {
                                "de": "Ein leise <w>wimmerndes</w> Baby lag gemütlich im Bettchen."
                            }
                        }
                    ],
                    "synonyms": [
                        "whimpering",
                        "whining"
                    ],
                    "common_phrases": [
                        "mewling baby"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Partizip Präsens und Gerundium von mewl (wimmern, miezen, miauen)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "wimmernd",
                                "target_lang_sense_clarification": "Eigenschaft/Handlung von Babys oder Tieren"
                            },
                            {
                                "target_lang_word": "miauend",
                                "target_lang_sense_clarification": "Eigenschaft/Handlung von Katzen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
