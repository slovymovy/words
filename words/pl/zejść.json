    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0aa6a65f-46a5-3708-8914-68fba0812360",
                    "sense_definition": "Przemieścić się z góry na dół, zazwyczaj stawiając kroki (np. po schodach, z drabiny).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "motion_down",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muszę ostrożnie <zejść> po stromych schodach do piwnicy.",
                            "target_lang_translations": {
                                "ru": "Мне нужно осторожно <спуститься> по крутой лестнице в подвал.",
                                "en": "I need to carefully <go down> the steep stairs to the basement."
                            }
                        },
                        {
                            "text": "Czy możesz już <zejść> na dół na śniadanie?",
                            "target_lang_translations": {
                                "ru": "Ты можешь уже <спуститься> вниз на завтрак?",
                                "en": "Can you <come down> for breakfast now?"
                            }
                        }
                    ],
                    "antonyms": [
                        "wejść"
                    ],
                    "common_phrases": [
                        "zejść na dół",
                        "zejść po schodach",
                        "zejść z góry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Переместиться сверху вниз, обычно шагая (например, по лестнице).",
                        "en": "To move from top to bottom, usually by walking or taking steps (e.g. down stairs or a ladder)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спуститься",
                                "target_lang_sense_clarification": "движение вниз"
                            },
                            {
                                "target_lang_word": "сойти",
                                "target_lang_sense_clarification": "покинуть возвышенность или транспорт"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "go down",
                                "target_lang_sense_clarification": "general motion downward"
                            },
                            {
                                "target_lang_word": "come down",
                                "target_lang_sense_clarification": "toward the speaker"
                            },
                            {
                                "target_lang_word": "descend",
                                "target_lang_sense_clarification": "formal, move down"
                            },
                            {
                                "target_lang_word": "step down",
                                "target_lang_sense_clarification": "from a ladder or step"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1bd4982e-ad4d-36de-bc2d-3c89dc59339f",
                    "sense_definition": "Opuścić zajmowane miejsce, powierzchnię lub obszar; usunąć się.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "leave_place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Proszę natychmiast <zejść> z trawnika, tu nie wolno deptać trawy.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, немедленно <сойдите> с газона, здесь нельзя топтать траву.",
                                "en": "Please <get off> the lawn immediately, walking on the grass is not allowed here."
                            }
                        },
                        {
                            "text": "Musisz mi <zejść> z drogi, bo niosę ciężkie pudła.",
                            "target_lang_translations": {
                                "ru": "Ты должен <уйти> с моей дороги, потому что я несу тяжелые коробки.",
                                "en": "You have to <get out of> my way because I'm carrying heavy boxes."
                            }
                        }
                    ],
                    "antonyms": [
                        "wejść"
                    ],
                    "common_phrases": [
                        "zejść z drogi",
                        "zejść z oczu",
                        "zejść z boiska",
                        "zejść ze sceny"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покинуть занимаемое место, поверхность или область; отойти в сторону.",
                        "en": "To leave an occupied place, surface, or area; to move out of the way."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сойти",
                                "target_lang_sense_clarification": "покинуть поверхность (газон, сцену)"
                            },
                            {
                                "target_lang_word": "уйти",
                                "target_lang_sense_clarification": "освободить место, уйти с дороги"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "get off",
                                "target_lang_sense_clarification": "leave a surface, e.g. grass or stage"
                            },
                            {
                                "target_lang_word": "step off",
                                "target_lang_sense_clarification": "step away from a surface"
                            },
                            {
                                "target_lang_word": "get out of the way",
                                "target_lang_sense_clarification": "clear a path"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3006a854-e685-36fb-bb73-89f6e66fb7db",
                    "sense_definition": "Zniknąć, zostać usuniętym lub odpaść (używane w kontekście plam, farby, skóry lub paznokci).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "disappear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ta tłusta plama nie chce <zejść> z mojej ulubionej koszuli.",
                            "target_lang_translations": {
                                "ru": "Это жирное пятно не хочет <сходить> с моей любимой рубашки.",
                                "en": "This greasy stain won't <come out> of my favorite shirt."
                            }
                        },
                        {
                            "text": "Po intensywnym opalaniu <zeszła> mi skóra z pleców.",
                            "target_lang_translations": {
                                "ru": "После интенсивного загара у меня <слезла> кожа со спины.",
                                "en": "After intense sunbathing, the skin on my back <peeled off>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "skóra zeszła",
                        "plama zeszła",
                        "paznokieć zszedł"
                    ],
                    "target_lang_definitions": {
                        "ru": "Исчезнуть, удалиться (о пятнах) или отделиться слоями (о коже, ногтях).",
                        "en": "To disappear, wash off, or come off (used of stains, paint, skin, or nails)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сойти",
                                "target_lang_sense_clarification": "исчезнуть (о пятне, краске)"
                            },
                            {
                                "target_lang_word": "слезть",
                                "target_lang_sense_clarification": "отделиться (о коже, ногте)"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "come out",
                                "target_lang_sense_clarification": "of a stain"
                            },
                            {
                                "target_lang_word": "come off",
                                "target_lang_sense_clarification": "of paint, a nail, or dirt"
                            },
                            {
                                "target_lang_word": "peel off",
                                "target_lang_sense_clarification": "of skin"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b1e2045-91ba-3e4b-8e05-fc7054e35735",
                    "sense_definition": "Obniżyć cenę, wartość lub wymagania.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "value",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sprzedawca nie chciał <zejść> z ceny ani o złotówkę.",
                            "target_lang_translations": {
                                "ru": "Продавец не хотел <сбросить> цену ни на злотый.",
                                "en": "The seller didn't want to <lower> the price by even a single zloty."
                            }
                        },
                        {
                            "text": "Jeśli nikt się nie zgłosi, firma będzie musiała <w>zejść</w> z wymagań wobec kandydatów.",
                            "target_lang_translations": {
                                "ru": "Если никто не откликнется, компании придётся <w>снизить</w> требования к кандидатам.",
                                "en": "If no one applies, the company will have to <w>lower</w> its requirements for candidates."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zejść z ceny",
                        "zejść z kosztów"
                    ],
                    "target_lang_definitions": {
                        "ru": "Снизить цену, стоимость или требования.",
                        "en": "To reduce a price, value, or lower requirements."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снизить",
                                "target_lang_sense_clarification": "уменьшить (расходы)"
                            },
                            {
                                "target_lang_word": "сбросить",
                                "target_lang_sense_clarification": "разг. уменьшить цену"
                            },
                            {
                                "target_lang_word": "уступить",
                                "target_lang_sense_clarification": "согласиться на меньшую цену"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "lower",
                                "target_lang_sense_clarification": "reduce prices or demands"
                            },
                            {
                                "target_lang_word": "come down",
                                "target_lang_sense_clarification": "decrease one's price or terms"
                            },
                            {
                                "target_lang_word": "drop",
                                "target_lang_sense_clarification": "reduce price or requirements"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f7da8a4-bf23-35bb-904f-b789d5ff8be1",
                    "sense_definition": "Umrzeć (często używane w kontekście nagłej śmierci).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "die",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Słyszałem, że stary sąsiad <zszedł> na zawał w zeszłym tygodniu.",
                            "target_lang_translations": {
                                "ru": "Я слышал, что старый сосед <умер> от инфаркта на прошлой неделе.",
                                "en": "I heard that the old neighbor <died> of a heart attack last week."
                            }
                        },
                        {
                            "text": "Pacjent nagle <zszedł> podczas operacji mimo wysiłków lekarzy.",
                            "target_lang_translations": {
                                "ru": "Пациент внезапно <скончался> во время операции, несмотря на усилия врачей.",
                                "en": "The patient suddenly <passed away> during surgery despite the doctors' efforts."
                            }
                        }
                    ],
                    "synonyms": [
                        "umrzeć"
                    ],
                    "common_phrases": [
                        "zejść na zawał",
                        "zejść z tego świata"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Умереть (часто используется в контексте внезапной смерти).",
                        "en": "To pass away or die, especially suddenly."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "умереть",
                                "target_lang_sense_clarification": "общий термин"
                            },
                            {
                                "target_lang_word": "скончаться",
                                "target_lang_sense_clarification": "официальный или уважительный термин"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "die",
                                "target_lang_sense_clarification": "cease living"
                            },
                            {
                                "target_lang_word": "pass away",
                                "target_lang_sense_clarification": "polite, die"
                            },
                            {
                                "target_lang_word": "drop dead",
                                "target_lang_sense_clarification": "colloquial, die suddenly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f070f6b-85ca-3e4a-84a8-cce789f12166",
                    "sense_definition": "Spotkać się w jednym miejscu lub zbiec się w jednym punkcie (wymaga użycia zaimka 'się').",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "converge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na wieczorne zebranie <w>zeszli się</w> prawie wszyscy mieszkańcy wsi.",
                            "target_lang_translations": {
                                "ru": "На вечернее собрание <w>сошлись</w> почти все жители деревни.",
                                "en": "Almost all the villagers <w>gathered</w> for the evening meeting."
                            }
                        },
                        {
                            "text": "Musimy się <zejść> w połowie drogi, żeby przekazać paczkę.",
                            "target_lang_translations": {
                                "ru": "Мы должны <встретиться> на полпути, чтобы передать посылку.",
                                "en": "We have to <meet> halfway to hand over the parcel."
                            }
                        }
                    ],
                    "synonyms": [
                        "zebrać się",
                        "spotkać się"
                    ],
                    "common_phrases": [
                        "drogi się zeszły"
                    ],
                    "target_lang_definitions": {
                        "ru": "Встретиться в одном месте или соединиться в одной точке (требует возвратной частицы).",
                        "en": "To gather or meet in one place, or to converge (used with the reflexive pronoun 'się')."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сойтись",
                                "target_lang_sense_clarification": "соединиться в одной точке"
                            },
                            {
                                "target_lang_word": "встретиться",
                                "target_lang_sense_clarification": "о людях"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "gather",
                                "target_lang_sense_clarification": "assemble in one place"
                            },
                            {
                                "target_lang_word": "meet up",
                                "target_lang_sense_clarification": "come together"
                            },
                            {
                                "target_lang_word": "converge",
                                "target_lang_sense_clarification": "come together at a point"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64392334-7302-3966-9891-fe598921f9e1",
                    "sense_definition": "Zostać szybko sprzedanym (o towarze).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cały towar <zszedł> nam w ciągu jednej godziny.",
                            "target_lang_translations": {
                                "ru": "Весь товар <разошелся> у нас в течение одного часа.",
                                "en": "All our stock <sold out> within an hour."
                            }
                        },
                        {
                            "text": "Świeże bułki <zeszły> na pniu zaraz po otwarciu piekarni.",
                            "target_lang_translations": {
                                "ru": "Свежие булочки <разошлись> мгновенно сразу после открытия пекарни.",
                                "en": "Fresh bread rolls <flew off the shelves> right after the bakery opened."
                            }
                        }
                    ],
                    "synonyms": [
                        "rozejść się"
                    ],
                    "common_phrases": [
                        "zejść na pniu"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть быстро распроданным (о товаре).",
                        "en": "To sell out quickly or find buyers fast (of goods)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разойтись",
                                "target_lang_sense_clarification": "быть раскупленным"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "sell out",
                                "target_lang_sense_clarification": "be entirely purchased"
                            },
                            {
                                "target_lang_word": "fly off the shelves",
                                "target_lang_sense_clarification": "idiomatic, sell very fast"
                            },
                            {
                                "target_lang_word": "go",
                                "target_lang_sense_clarification": "be sold"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec128a12-350d-3195-b539-67d065299f36",
                    "sense_definition": "Wzejść, wykiełkować (o roślinach).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sprout",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zboże na polu już dawno <zeszło> po wiosennych deszczach.",
                            "target_lang_translations": {
                                "ru": "Зерно на поле уже давно <взошло> после весенних дождей.",
                                "en": "The grain in the field has long since <sprouted> after the spring rains."
                            }
                        },
                        {
                            "text": "Czekamy, aż posadzona marchewka w końcu <zejdzie>.",
                            "target_lang_translations": {
                                "ru": "Мы ждем, когда посаженная морковь наконец <взойдет>.",
                                "en": "We are waiting for the planted carrots to finally <come up>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "gwara, np. Bukowina"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прорасти, дать всходы (о растениях).",
                        "en": "To sprout, germinate, or emerge (of crops or plants)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взойти",
                                "target_lang_sense_clarification": "о посевах"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "sprout",
                                "target_lang_sense_clarification": "begin to grow"
                            },
                            {
                                "target_lang_word": "come up",
                                "target_lang_sense_clarification": "emerge above the soil"
                            },
                            {
                                "target_lang_word": "germinate",
                                "target_lang_sense_clarification": "begin to develop from a seed"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5e12e29e-e11e-36c3-aa78-369b151ca352",
                    "sense_definition": "Forma słowa <w>zejście</w> (rzeczownik, dopełniacz liczby mnogiej).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W tym projekcie nie przewidziano dwóch osobnych <zejść> do garażu.",
                            "target_lang_translations": {
                                "ru": "В этом проекте не предусмотрено двух отдельных <спусков> в гараж.",
                                "en": "This design did not provide for two separate <entrances> down to the garage."
                            }
                        },
                        {
                            "text": "Unikaj gwałtownych <zejść> pod wodę bez wyrównania ciśnienia.",
                            "target_lang_translations": {
                                "ru": "Избегай резких <погружений> под воду без выравнивания давления.",
                                "en": "Avoid rapid underwater <descents> without equalizing pressure."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "dopełniacz liczby mnogiej"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма существительного 'zejście' (спуск/выход) в родительном падеже множественного числа.",
                        "en": "Form of the noun 'zejście' (descent, exit, passageway down; genitive plural)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спусков",
                                "target_lang_sense_clarification": "форма слова спуск"
                            },
                            {
                                "target_lang_word": "сходов",
                                "target_lang_sense_clarification": "форма слова сход"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "descents",
                                "target_lang_sense_clarification": "plural, downward passages or actions of going down"
                            },
                            {
                                "target_lang_word": "entrances",
                                "target_lang_sense_clarification": "plural, passageways down"
