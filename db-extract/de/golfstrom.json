                ],
                "senses": [
                    {
                        "sense_id": "b898d663-c8ef-3bb5-ac8a-82bbdd2405a7",
                        "entry_id": "75c19ca6-62e4-3f2a-9a4f-4e94a3ccf71e",
                        "glosses": [
                            "warme Meeresströmung im Atlantischen Ozean"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13e32b15-d6dc-47d0-a671-04a36687b55f",
                                "sense_id": "b898d663-c8ef-3bb5-ac8a-82bbdd2405a7",
                                "text": "„Der Golfstrom hat sich zwei- bis dreimal so rasch erwärmt wie der Atlantische Ozean.“"
                            },
                            {
                                "example_id": "ad74b8d6-282a-424b-b442-d28f5faf5a14",
                                "sense_id": "b898d663-c8ef-3bb5-ac8a-82bbdd2405a7",
                                "text": "Der Golfstrom ist wichtig für das milde Klima in Westeuropa. Nun deutet eine Studie darauf hin, dass sich die Strömung abschwächt. Ursache sei der Klimawandel, vermuten die Forscher."
                            },
                            {
                                "example_id": "1b8ebb9b-4b43-40d8-ad32-b02d44fc386f",
                                "sense_id": "b898d663-c8ef-3bb5-ac8a-82bbdd2405a7",
                                "text": "„Der Golfstrom, der an der Insel vorbeistreift, macht die Winter im Flachland milde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a743954-8b95-4ff0-81d3-16d167cadb0e",
                        "source_entry_id": "75c19ca6-62e4-3f2a-9a4f-4e94a3ccf71e",
                        "source_sense_id": "b898d663-c8ef-3bb5-ac8a-82bbdd2405a7",
                        "source_sense_description": "warme Meeresströmung im Atlantischen Ozean",
                        "target_lang_word": "Gulf Stream",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gulf Stream",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ed3e42e-e747-3499-96b9-f1d5e086ba81",
                                        "entry_id": "7816bb3a-5210-3078-8d51-9edd0db0ccc4",
                                        "glosses": [
                                            "The warm ocean current issuing from the Gulf of Mexico, flowing northeastwards along the coast of North America to the Grand Banks where it breaks eastwards across the Atlantic Ocean and helps to maintain warm temperatures along the western coasts of the British Isles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c9512ec-ff01-451a-b70f-45ed54701285",
                        "source_entry_id": "75c19ca6-62e4-3f2a-9a4f-4e94a3ccf71e",
                        "source_sense_id": "b898d663-c8ef-3bb5-ac8a-82bbdd2405a7",
                        "source_sense_description": "warme Meeresströmung im Atlantischen Ozean",
                        "target_lang_word": "Gulf Stream",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gulf Stream",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ccf7eae7-b6c1-3151-bde8-0537af98f2be",
                                        "entry_id": "09fa87ad-f246-3d04-b771-e2231ee00b26",
                                        "glosses": [
                                            "Grand courant marin d’eau chaude qui part du golfe du Mexique et se dirige sur les rivages septentrionaux de l’Europe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f7bc852-4a2f-4290-ae8c-b42b246b1c6c",
                                                "sense_id": "ccf7eae7-b6c1-3151-bde8-0537af98f2be",
                                                "text": "Bien qu’elle confine au cercle polaire, l’Islande est située presque entièrement dans la zone tempérée ; on pourrait croire qu’elle jouit d’un climat insulaire et uniforme, grâce surtout à l’influence du Gulf-Stream qui adoucit la température de la Norwége."
                                            },
                                            {
                                                "example_id": "23271b40-23d7-4c63-bfdd-d41b9cc66ec5",
                                                "sense_id": "ccf7eae7-b6c1-3151-bde8-0537af98f2be",
                                                "text": "Le Gulf Stream baigne la côte bretonne, ce fleuve-pirate d’eau tiède, dans l’Atlantique, en provenance des Caraïbes, à qui l’on doit les mimosas, les lauriers-roses et les géraniums – même si l’on triche un peu en rentrant les pots à la saison froide."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
