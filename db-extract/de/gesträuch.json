                "senses": [
                    {
                        "sense_id": "1d0fce31-9cac-33ca-b779-1db53dffc3e3",
                        "entry_id": "de6635ed-8ef9-3e51-a683-8eb5794a6692",
                        "glosses": [
                            "shrubbery (cluster of shrubs, usually wild-growing)"
                        ],
                        "tags": [
                            "collective",
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "62b6394b-b7d4-4bdd-9982-f482347cb9e4",
                                "sense_id": "1d0fce31-9cac-33ca-b779-1db53dffc3e3",
                                "text": "Inmitten grün’ und klaren, seichten Wogen, / Unter wiegend’ Seegras, im Gesträuch tief verborgen, / Wo lehmig’ Kies zum Grund des Sees niedergeht, / Des im Wasser Herrschend’ Reich besteht.",
                                "translation": "Amidst green and clear, shallow waves, / Under swaying seaweed, deeply hidden in the shrubbery, / Where loamy gravel sinks down to the ground of the lake, / There is the realm of him who rules in the water.",
                                "english": "Amidst green and clear, shallow waves, / Under swaying seaweed, deeply hidden in the shrubbery, / Where loamy gravel sinks down to the ground of the lake, / There is the realm of him who rules in the water."
                            }
                        ]
                    }
                ],
