                        "glosses": [
                            "de hulp die wordt verleend bij ongewenste gebeurtenissen in een organisatie, die de veiligheid en/of gezondheid van de werknemers en andere aanwezigen bedreigen (zoals brand en ongevallen)"
                        ],
