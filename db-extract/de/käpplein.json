                        "examples": [
                            {
                                "example_id": "40eac1d8-4823-47f1-b7e2-ddc80e16d3dd",
                                "sense_id": "2781aaf0-0ca0-348a-bdee-59eff8956ba0",
                                "text": "„Es waren ein Paar zierliche Samtpantoffeln für die Mutter und ein gesticktes Käpplein für den Vater, nebst zwei Blumenstöcken und einem Kuchen.“"
                            },
                            {
                                "example_id": "3b273580-3d79-464e-9f7e-acd148bf0849",
                                "sense_id": "2781aaf0-0ca0-348a-bdee-59eff8956ba0",
                                "text": "„Einen Hut besaß der Geselle nicht, sondern bloß ein flottes barettähnliches Käpplein von schwarzem Sammet, mit rotem Rande und mit Goldschnur baspoliert.“"
                            }
                        ],
