                "senses": [
                    {
                        "sense_id": "8e368ccc-240c-3334-b11c-b58eb6ba7cf9",
                        "entry_id": "be2e5064-402a-30a2-962e-3b32d288aa19",
                        "glosses": [
                            "(als astronomische Maßeinheit verwendeter) Radius der Sonne, etwa 700.000 Kilometer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25604104-0e82-4d98-976c-010b1f913220",
                                "sense_id": "8e368ccc-240c-3334-b11c-b58eb6ba7cf9",
                                "text": "„Mit einem Radius von 600 Millionen Kilometern, also fast 800 Sonnenradien, handelt es sich [bei Antares] um einen Roten Überriesen. Stünde er an Stelle der Sonne, würde er sogar die Umlaufbahn des Mars in seinem Volumen einschließen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fce32032-2bed-4987-84ec-19c2b38dbd51",
                        "source_entry_id": "be2e5064-402a-30a2-962e-3b32d288aa19",
