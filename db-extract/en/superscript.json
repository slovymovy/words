                        "target_lang_word": "Hochzahl",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hochzahl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5404732b-dbe8-345f-8e39-e834ffa8c6ec",
                                        "entry_id": "85da3c3e-b73d-3333-8610-2147bb1fbbfa",
                                        "glosses": [
                                            "hochgestellte Zahl, die den Grad einer Potenz oder Wurzel angibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed3935bd-3fe4-40cd-8a68-8f840086bae0",
                                                "sense_id": "5404732b-dbe8-345f-8e39-e834ffa8c6ec",
                                                "text": "Heute berechnen wir Gleichungssysteme mit einer Variablen in der Hochzahl."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6f791877-ad27-3f83-8980-486333a6c995",
                                        "entry_id": "85da3c3e-b73d-3333-8610-2147bb1fbbfa",
                                        "glosses": [
                                            "hochgestellte Zahl, zum Beispiel vor oder hinter einem Wort oder einer Zahl"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7349d5c-e03f-4791-9cf5-f93bccbb8d7f",
                                                "sense_id": "6f791877-ad27-3f83-8980-486333a6c995",
                                                "text": "Wie schreibe ich eine Hochzahl wie bei ¹⁴C mit meiner Tastatur?"
                                            },
                                            {
                                                "example_id": "a0595a0d-23d4-49cd-a152-299c36c65fe0",
                                                "sense_id": "6f791877-ad27-3f83-8980-486333a6c995",
                                                "text": "„Hochzahlen und Fußnotenziffern werden ohne Leerschritt angeschlossen.“"
                                            },
                                            {
                                                "example_id": "7dd3b64d-d151-452a-951d-aa2981204d4a",
                                                "sense_id": "6f791877-ad27-3f83-8980-486333a6c995",
                                                "text": "„Das Fußnotenzeichen (Exponent, Hochzahl) gehört bei wörtlichem Zitat direkt hinter die abschließenden Anführungsstriche.“"
                                            },
                                            {
                                                "example_id": "e5db5988-a56d-4d0b-b23b-cc6ec241c16b",
                                                "sense_id": "6f791877-ad27-3f83-8980-486333a6c995",
                                                "text": "„Also Zitate bitte in Anführungszeichen setzen, kursiv markieren und mit Hochzahl kenntlich zu machen.“"
                                            },
                                            {
                                                "example_id": "afe362ab-7f42-4c0b-8a22-a72105116436",
                                                "sense_id": "6f791877-ad27-3f83-8980-486333a6c995",
                                                "text": "„[…] Hochzahlen (für Anmerkungen) ohne Klammer hinter den schließenden Anführungszeichen, und zwar vor Komma, Semikolon und Doppelpunkt, aber hinter dem Punkt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
