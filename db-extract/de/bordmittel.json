                "senses": [
                    {
                        "sense_id": "eb2447db-f0b8-3b85-979c-18fbac3f92b0",
                        "entry_id": "a200445c-7018-3c07-8534-b9cbb6606818",
                        "glosses": [
                            "(meist eingeschränkte) Möglichkeiten an Bord eines Schiffes (beispielsweise um etwas zu reparieren)"
                        ],
                        "tags": [
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "08b9fd4d-5f5b-4bd4-a53b-460c2255919d",
                                "sense_id": "eb2447db-f0b8-3b85-979c-18fbac3f92b0",
                                "text": "„Doch die Seekrankheit wich bereits am nächsten Tag dem Reiz des Abenteuers, mit solch einem kleinen Schiff den Atlantik zu überqueren. Vor allem, als ein Unterwant bricht, aber mit Bordmitteln repariert werden kann.“"
                            },
                            {
                                "example_id": "38efd7ff-b6a1-479b-9d1f-e9e6ba037d95",
                                "sense_id": "eb2447db-f0b8-3b85-979c-18fbac3f92b0",
                                "text": "„Den ganzen Satz Ölzeug wegen eines Lochs aufgeben? Muss nicht sein, zumindest provisorisch lässt sich Ölzeug mit Bordmitteln reparieren“"
                            },
                            {
                                "example_id": "4a31ba6b-48b0-4039-a73b-998646dd2631",
                                "sense_id": "eb2447db-f0b8-3b85-979c-18fbac3f92b0",
                                "text": "„Aber die Wetterprognosen lassen gerade für diesen Bereich in der nächsten Zeit weiteren Regen erwarten, und eine vernünftige Beseitigung des Lecks im Deck von SAUSEBRAUS ist nicht mit Bordmitteln, nur in Berlin wieder möglich.“"
                            },
                            {
                                "example_id": "5bb7e71f-1aa7-4808-8618-4ee77ea9e811",
                                "sense_id": "eb2447db-f0b8-3b85-979c-18fbac3f92b0",
                                "text": "„September 2020. Die Crew einer deutschen Yacht stellt auf dem Weg von England zu den Azoren einen Wassereinbruch fest, der mit Bordmitteln offenbar nicht unter Kontrolle zu bekommen ist.“"
                            },
                            {
                                "example_id": "4ef7ca14-10cf-49ae-ae7d-df21c25c6a5a",
                                "sense_id": "eb2447db-f0b8-3b85-979c-18fbac3f92b0",
                                "text": "„Ein regelmäßiger Blick in den Motorraum kann helfen, Probleme früh zu erkennen. Meistens lassen sie sich dann mit Bordmitteln lösen“"
                            },
                            {
                                "example_id": "ff1b980a-1683-4d83-934f-98b3c1719567",
                                "sense_id": "eb2447db-f0b8-3b85-979c-18fbac3f92b0",
                                "text": "„Die Unterhaltung der Schiffsgeschütze ist, soweit Bordmittel nicht ausreichen, Sache der Artillerieressorts der Werften.“"
                            },
                            {
                                "example_id": "a1857d9f-9ac7-4900-af02-f14163c31c53",
                                "sense_id": "eb2447db-f0b8-3b85-979c-18fbac3f92b0",
                                "text": "„Das Marinearsenal mit Standorten in Wilhelmshaven, Kiel und nun auch Rostock hat den Auftrag, die Einsatzbereitschaft der Deutschen Marine sicherzustellen.“ […] „Die Dienststelle nimmt alle Reparatur- und Instandsetzungsarbeiten vor, die von der Marine mit Bordmitteln nicht erledigt werden können.“"
                            },
                            {
                                "example_id": "9653ac4f-e043-4a13-a654-65211fd22aff",
                                "sense_id": "eb2447db-f0b8-3b85-979c-18fbac3f92b0",
                                "text": "„In einem Laderaum war Calciumhypochlorid mit organischen Farbstoffen gestaut. Der ausgebrochenen Brand breitete sich so schnell aus, daß die Feuerbekämpfung mit Bordmitteln wirkungslos blieb.“"
                            },
                            {
                                "example_id": "d04d0387-a6bd-478f-90ee-161ca608ff34",
                                "sense_id": "eb2447db-f0b8-3b85-979c-18fbac3f92b0",
                                "text": "„Reichen die Bordmittel hiezu nicht aus, so hat man sich an die Werkstätten am Lande oder an das Werkstättenschiff zu wenden. Wenn sich weder das eine noch das andere in der Nähe befindet, und das Ventil mit Bordmitteln nicht hergestellt werden kann, so ist dasselbe ganz zu zerlegen, zu entfernen und die Oeffnung mittelst eines Holzpfropfes zu schliessen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b98e21ae-d0c4-37e7-aaeb-f3e6075be275",
                        "entry_id": "a200445c-7018-3c07-8534-b9cbb6606818",
                        "glosses": [
                            "eigene Möglichkeiten, bestehende Mittel"
                        ],
                        "tags": [
                            "nur Plural; abgeleitet aus [1]"
                        ],
                        "examples": [
                            {
                                "example_id": "3142f91b-e6d4-46bb-945c-9482e1faa013",
                                "sense_id": "b98e21ae-d0c4-37e7-aaeb-f3e6075be275",
                                "text": "[Rennfahrer Jacky] „Ickx konnte die Pumpe mit Bordmitteln reparieren und den Porsche zurück an die Box bringen.“"
                            },
                            {
                                "example_id": "88f62129-ce27-4fb7-8018-0bb93789cd64",
                                "sense_id": "b98e21ae-d0c4-37e7-aaeb-f3e6075be275",
                                "text": "„Die eingetroffene Polizeistreife versuchte vor Ort mit eigenen Bordmitteln den Brand zu löschen.“"
                            },
                            {
                                "example_id": "1e860d25-38b7-40b7-b1fa-df9b5317895d",
                                "sense_id": "b98e21ae-d0c4-37e7-aaeb-f3e6075be275",
                                "text": "[Fotoverwaltung:] „Auf so mancher Festplatte liegen Fotos überall verstreut und unbeschriftet.“ […] „Mit viel Disziplin bekommen Hobby-Fotografen den Wust an Bildern auch mit Bordmitteln in den Griff.“"
                            },
                            {
                                "example_id": "c41fe5fa-202f-4d21-a5ca-b8ce0cca3d19",
                                "sense_id": "b98e21ae-d0c4-37e7-aaeb-f3e6075be275",
                                "text": "[Linux:] „Inzwischen haben die Entwickler die Bash zu einer ernst zu nehmenden Programmiersprache aufgebohrt, die schon mit Bordmitteln so manches Standardtool abhängt.“"
                            },
                            {
                                "example_id": "5e30e262-fb02-40cd-9b1e-8827b173d61e",
                                "sense_id": "b98e21ae-d0c4-37e7-aaeb-f3e6075be275",
                                "text": "[Windows 10:] „Leider ist es mit Bordmitteln nicht mehr möglich, DVDs abzuspielen. Hier hilft der kostenlose VLC Media Player, den man aber nachträglich installieren muss.“"
                            },
                            {
                                "example_id": "cf812ef1-78ea-44c3-b09a-5f72b98c2409",
                                "sense_id": "b98e21ae-d0c4-37e7-aaeb-f3e6075be275",
                                "text": "„Windows 10: Backups mit Bordmitteln erstellen“ – „Wer seine Dateien auf einem Windows-PC absichern will, muss kein Programm installieren. Auch mit Bordmitteln kommen Sie zum Backup.“"
                            },
                            {
                                "example_id": "04c551cd-0888-4922-a1c1-86cc454a72c9",
                                "sense_id": "b98e21ae-d0c4-37e7-aaeb-f3e6075be275",
                                "text": "[Cyberangriff auf österreichisches Außenministerium:] „Diese Turla-Scripts greifen nämlich auf die „Bordmittel“ jeder Windows-Maschine zurück: von ausführbaren Dateien wie cmd.exe über das .NET Framework bis hin zu Java.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
