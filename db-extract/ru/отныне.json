        "ru-extract.jsonl": [
            {
                "entry_id": "4034c8e5-de5c-34a7-9ece-2f2cae5a45cf",
                "word": "отныне",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "289ff144-407e-3378-aa81-137f2c846432",
                        "entry_id": "4034c8e5-de5c-34a7-9ece-2f2cae5a45cf",
                        "glosses": [
                            "с этого времени, начиная с этого момента"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93184875-a598-4f00-b28c-ed2cfcdea924",
                                "sense_id": "289ff144-407e-3378-aa81-137f2c846432",
                                "text": "И сказал Симону Иисус: не бойся; отныне будешь ловить человеков."
                            },
                            {
                                "example_id": "7ce1c24e-ed47-4874-9060-987567a7dff1",
                                "sense_id": "289ff144-407e-3378-aa81-137f2c846432",
                                "text": "Все чувствовали, что тяжесть спала с сердец и что отныне ничего другого не остается, как благоденствовать."
                            },
                            {
                                "example_id": "c4340037-8d3a-4d68-93af-2741ecc3a712",
                                "sense_id": "289ff144-407e-3378-aa81-137f2c846432",
                                "text": "Между прочим, она объявила, что готова основать свой журнал и посвятить ему отныне всю свою жизнь."
                            },
                            {
                                "example_id": "8a440679-455c-4530-940f-3993877bb0ea",
                                "sense_id": "289ff144-407e-3378-aa81-137f2c846432",
                                "text": "Собери всех своих самых лучших людей, у которых ты знаешь самую крепкую веру, и явитесь там рано утром отныне на третий день."
                            },
                            {
                                "example_id": "a4273400-65eb-404d-959f-c4f000f91d8d",
                                "sense_id": "289ff144-407e-3378-aa81-137f2c846432",
                                "text": "Главная перемена состоит в том, что высшее образование отныне доступно в сущности всем и каждому, способному его вместить."
                            },
                            {
                                "example_id": "3368ca81-aa49-44a5-bce5-772c1dc84d3b",
                                "sense_id": "289ff144-407e-3378-aa81-137f2c846432",
                                "text": "Отныне загадочная функция гипофиза — мозгового придатка — разъяснена."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b1038775-9a38-4505-94c4-72d20a691cac",
                        "source_entry_id": "4034c8e5-de5c-34a7-9ece-2f2cae5a45cf",
                        "source_sense_id": "289ff144-407e-3378-aa81-137f2c846432",
                        "target_lang_word": "henceforth",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "henceforth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e3c2786-77b7-3d98-8632-d6201a0ca7f6",
                                        "entry_id": "cd435c67-fc19-380e-9437-ef9860d4124c",
                                        "glosses": [
                                            "From now on; from this time on."
                                        ],
                                        "tags": [
                                            "formal",
                                            "not-comparable",
                                            "temporal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d466c282-8947-4e33-a80f-68de012eb400",
                                                "sense_id": "6e3c2786-77b7-3d98-8632-d6201a0ca7f6",
                                                "text": "I will try to do a better job, henceforth, now that I know the proper technique!"
                                            },
                                            {
                                                "example_id": "076230ea-4b0f-4ee9-898d-c02478ddaf5e",
                                                "sense_id": "6e3c2786-77b7-3d98-8632-d6201a0ca7f6",
                                                "text": "My thanes and kinsmen,/Henceforth be earls, the first that ever Scotland /In such an honour named"
                                            },
                                            {
                                                "example_id": "d23453d5-b1af-484b-aaae-4183313a2f55",
                                                "sense_id": "6e3c2786-77b7-3d98-8632-d6201a0ca7f6",
                                                "text": "Henceforth, you shall be known as Darth...Vader."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51f6c79b-546f-397c-b74e-7835e836ffac",
                                        "entry_id": "cd435c67-fc19-380e-9437-ef9860d4124c",
                                        "glosses": [
                                            "Further within this document."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c441834-d67b-4041-9595-c2aaa035505e",
                        "source_entry_id": "4034c8e5-de5c-34a7-9ece-2f2cae5a45cf",
                        "source_sense_id": "289ff144-407e-3378-aa81-137f2c846432",
