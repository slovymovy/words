                "senses": [
                    {
                        "sense_id": "3a2b2612-d3e3-3ee3-9699-4c88d5976859",
                        "entry_id": "d5955fd4-da08-3346-a84b-d42446b36641",
                        "glosses": [
                            "Relatif aux rives."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "efcc6e48-3506-4b60-b084-b6870f70b216",
                                "sense_id": "3a2b2612-d3e3-3ee3-9699-4c88d5976859",
                                "text": "McQueen et Miller (1972) ont mesuré l’humidité et la tension de l’eau dans le sol sous une végétation ripuaire afin de décrire les mécanismes de rétention et de migration de l’eau"
                            },
                            {
                                "example_id": "3905c4b8-c9e5-41ad-bf35-a94c1c7f6a30",
                                "sense_id": "3a2b2612-d3e3-3ee3-9699-4c88d5976859",
                                "text": "En modifiant l'hydrologie et les flux de matériaux, l'homme a généré une déstabilisation de l'ensemble de la rivière dans laquelle la végétation ripuaire joue un rôle de catalyseur des mécanismes et de relais entre les différentes composantes de notre système."
                            },
                            {
                                "example_id": "246f1128-c792-4e08-82d8-625657ad3196",
                                "sense_id": "3a2b2612-d3e3-3ee3-9699-4c88d5976859",
                                "text": "Les forêts riveraines sont les formations arborescentes et arbustives aux berges de l’oued, même dans sa vallée. Elles apparaissent soit sous forme de forêt galerie, soit sous forme d’arbustes ripuaires."
                            }
                        ]
                    }
