                "senses": [
                    {
                        "sense_id": "989a77e6-1296-3bdb-8223-fa110f936a3e",
                        "entry_id": "2c01f327-8f15-3856-bdca-5c79341f4de7",
                        "glosses": [
                            "Be- und Entlüftung eines Raumes oder Gebäudes in der Nacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "193e4646-556a-453c-8317-198c0fa71ed0",
                                "sense_id": "989a77e6-1296-3bdb-8223-fa110f936a3e",
                                "text": "„Das Verfahren der Nachtlüftung nutzt die kühle Nachtluft, um thermische Gebäudemassen während der Nacht herunterzukühlen.“"
                            },
                            {
                                "example_id": "8ca06353-8999-412f-b954-72610289f94d",
                                "sense_id": "989a77e6-1296-3bdb-8223-fa110f936a3e",
                                "text": "„Ähnlich wie bei der Nachtlüftung wird die Speicherfähigkeit der Decke genutzt, um die Wärme nachts abzuführen und den Raum tagsüber passiv zu kühlen.“"
                            },
                            {
                                "example_id": "6b07f0ec-88e0-4f48-944c-eaee30a267f9",
                                "sense_id": "989a77e6-1296-3bdb-8223-fa110f936a3e",
                                "text": "„Die Nachtlüftung erfolgt durch einen Abluftventilator am Dach.“"
                            },
                            {
                                "example_id": "07fb8534-6fc6-4b18-81c5-22cd5992b020",
                                "sense_id": "989a77e6-1296-3bdb-8223-fa110f936a3e",
                                "text": "„Bei Nichtwohngebäuden muss dahingegen eine in Ansatz gebrachte Nachtlüftung durch ein mechanisches Lüftungssystem übernommen werden.“"
                            },
                            {
                                "example_id": "bbae5bcf-8139-4085-8a75-ead8804b3f50",
                                "sense_id": "989a77e6-1296-3bdb-8223-fa110f936a3e",
                                "text": "„Die Nachtlüftung ist rein passiv über manuell zu öffnende Oberlichter (maximal 4000 cm²Öffnungsquerschnitt) mit Ablüftung über die Bürotüren und eine automatisch öffnende Rauchabzugsklappe im Dachbereich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
