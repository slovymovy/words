                                        "glosses": [
                                            "Synonyme de gynécocratie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d313276-c4c3-4b38-9865-0d9e7cf75a97",
                                                "sense_id": "2367bcb8-3351-3030-bf33-c3007a124fda",
                                                "text": "En fait, qu’il s'agisse de la domination masculine ancestrale, d’une égalité associée à un communisme primitif ou encore d’une gynocratie (pouvoir des femmes sans matriarcat) préhistorique, les réponses à ces questions restent du domaine de l’interprétation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a73e548c-7e32-4250-a838-1023f2c24876",
