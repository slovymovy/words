                    },
                    {
                        "sense_id": "5456c122-895e-3820-820e-08a11967ec8f",
                        "entry_id": "d464078b-aebd-319b-ac9e-b8cacdede386",
                        "glosses": [
                            "Able to be borne or carried; portable."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "b7ac99bb-9733-4dcd-ab78-2e050f07ad21",
                                "sense_id": "5456c122-895e-3820-820e-08a11967ec8f",
                                "text": "A joint cause is neither necessary nor sufficient for an effect—for example, any one of six pallbearers is a joint cause of carrying a coffin bearable by four."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b989d7a-bf0c-44eb-98ea-572e1adc1a97",
                        "source_entry_id": "d464078b-aebd-319b-ac9e-b8cacdede386",
                        "source_sense_description": "able to be borne",
                        "target_lang_word": "snesitelný",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
