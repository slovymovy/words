                ],
                "senses": [
                    {
                        "sense_id": "6d558cac-67af-3f45-860d-ef64f620b781",
                        "entry_id": "65f1a987-01c1-31a2-9b90-4b0e9f05713b",
                        "glosses": [
                            "für ein Fenster ausgesparte Öffnung in einer Mauer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7dc97e42-0337-4ce7-a8a9-24c9dc4b50fe",
                                "sense_id": "6d558cac-67af-3f45-860d-ef64f620b781",
                                "text": "„Bevor sie fort müssen in ihr für die Nacht verschlossenes Lager, schleppen die Männer vom Dachboden, aus Abstellkammern oder Kellerverschlägen herbei, was da aufbewahrt liegt: eine alte Couch, Tisch und Stühle, einen Kanonenofen samt Rohr, das in die Fensterhöhle hinausgeleitet wird, Holz zum Heizen.“"
                            },
                            {
                                "example_id": "ca9f6df2-afb0-4c2d-bd16-68ffeb02e429",
                                "sense_id": "6d558cac-67af-3f45-860d-ef64f620b781",
                                "text": "„Auch in den Luken und den Fensterhöhlen wurden Köpfe sichtbar, die mit angespannten Mienen hinausspähten.“"
                            },
                            {
                                "example_id": "53a8d701-a426-4997-8585-d089a0c77af7",
                                "sense_id": "6d558cac-67af-3f45-860d-ef64f620b781",
                                "text": "„Man sah an den Fensterhöhlen dunkle Gestalten, die Decken davorhängten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
