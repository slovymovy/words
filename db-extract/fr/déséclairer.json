                        "glosses": [
                            "Rendre moins éclairé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37f878b5-b161-46eb-bdd8-297c3b3cb664",
                                "sense_id": "8cafa6ba-162d-3137-b11b-48cc660ef7e2",
                                "text": "Je crois que, loin d’éclairer davantage l’humanité, il faut la déséclairer par la communauté des saints."
                            },
                            {
                                "example_id": "5ad6faea-1c40-48b2-8aeb-09acc53f16fc",
                                "sense_id": "8cafa6ba-162d-3137-b11b-48cc660ef7e2",
                                "text": "Un lointain classicisme le guide, lampe de mineur qu’il porte sur la nuque comme pour déséclairer le chemin tout fait."
                            }
                        ]
                    },
                    {
                        "sense_id": "e897e656-a6bd-3545-89af-30c720b2b90f",
                        "entry_id": "c793c7ca-a529-3e23-ace1-246b4f79ce32",
                        "glosses": [
                            "Rendre moins clair."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c328872f-ffcc-4f60-853d-ed196959913d",
                                "sense_id": "e897e656-a6bd-3545-89af-30c720b2b90f",
                                "text": "Cela dit, il est absolument évident que Stendhal et Balzac, par-delà des manipulations scripturales de calendriers tiennent d’abord à ce que les choses soient claires et n’éprouvent nul besoin de les obscurcir, de les déséclairer."
                            }
                        ]
