                "senses": [
                    {
                        "sense_id": "956e9296-32eb-3b56-9d8c-e951fc7d3c07",
                        "entry_id": "8bd60b89-6d53-3c36-8365-344017605338",
                        "glosses": [
                            "Activité du mentor."
                        ],
                        "tags": [
                            "Travail"
                        ],
                        "examples": [
                            {
                                "example_id": "0bb1aeb6-7d15-4f1f-8569-ac08322c903d",
                                "sense_id": "956e9296-32eb-3b56-9d8c-e951fc7d3c07",
                                "text": "Jacques Chirac est devenu député de la Corrèze en 1967 sous le mentorat de Georges Pompidou."
                            },
                            {
                                "example_id": "eae38c16-cfd9-4da8-bf74-ce85333e3156",
                                "sense_id": "956e9296-32eb-3b56-9d8c-e951fc7d3c07",
                                "text": "Toutefois, la principale raison d’être de la structure et du processus de mentorat était d’offrir un soutien individuel continu et indépendant du point de vue organisationnel pour épauler les boursiers entre les séances en résidence."
                            },
                            {
                                "example_id": "272276ca-6ab3-414d-81b3-80f4c92c7246",
                                "sense_id": "956e9296-32eb-3b56-9d8c-e951fc7d3c07",
                                "text": "Il s’agira notamment de « l’intensification des programmes de mentorat pour soutenir la prochaine génération d’infirmiers », d’expérimenter des méthodes de recrutement plus sûres et de mener des recherches sur les conditions de travail de ce secteur."
                            }
                        ]
                    }
                ],
