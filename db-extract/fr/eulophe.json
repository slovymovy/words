                "senses": [
                    {
                        "sense_id": "376200ea-407f-3311-b6d8-3475c8e210eb",
                        "entry_id": "f05547fc-079d-34ed-850b-a60eb4a6a547",
                        "glosses": [
                            "Genre monospécifique de gallinacés de la famille des phasianidés habitant les forêts de conifères en altitude du sud-ouest de l'Himalaya, et des montagnes de Chine et de Mongolie, caractérisé par une silhouette de faisan, un plumage cryptique gris argenté, une longue huppe fournie ainsi qu'une longue queue pointue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c717a9d-4fdd-41c4-a850-cda22a4517b1",
                                "sense_id": "376200ea-407f-3311-b6d8-3475c8e210eb",
                                "text": "Les bois hébergent également la Pie-Grièche Bucéphale, le Merle de Fea et l’Eulophe Koklass, bien que cette dernière espèce soit extrêmement difficile à observer."
                            }
                        ]
                    },
                    {
                        "sense_id": "65f39461-5fe0-3c0e-9a3b-8c54844d744a",
                        "entry_id": "f05547fc-079d-34ed-850b-a60eb4a6a547",
                        "glosses": [
                            "Genre de très petits insectes hyménoptères (Eulophus), parasitoïdes de larves et chenilles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55463c26-612d-4ca8-93e0-1f4176e62646",
                                "sense_id": "65f39461-5fe0-3c0e-9a3b-8c54844d744a",
                                "text": "Eulophus, genre d’insectes de l’ordre des Hyménoptères, établi par Geoffroy, et qui ne diffère de celui de cynips, du même auteur, que par ses antennes branchues, et formant un joli panache; c'est de là que vient le nom d’eulophe."
                            }
                        ]
                    },
                    {
                        "sense_id": "b3af6426-67d3-3976-a08a-73e396fbc17f",
                        "entry_id": "f05547fc-079d-34ed-850b-a60eb4a6a547",
                        "glosses": [
                            "Genre de plantes ombellifères nord-américaines, aujourd’hui nommé Perideridia."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "b0d08047-f39f-41b1-94e0-ba215546c196",
                                "sense_id": "b3af6426-67d3-3976-a08a-73e396fbc17f",
                                "text": "L’eulophe américain (Eulophus americanus) porte aujourd’hui le nom scientifique de Perideridia americana."
                            },
                            {
                                "example_id": "1aacf77a-9220-4872-90e9-36c47ba2f8d6",
                                "sense_id": "b3af6426-67d3-3976-a08a-73e396fbc17f",
                                "text": "La ville de Yampa, dans le Colorado, porte le nom amérindien d’un eulophe (Perideridia gairdneri) aux racines comestibles."
                            },
                            {
                                "example_id": "1b6de87a-3ada-4c2d-ba2e-dad76d6bceca",
                                "sense_id": "b3af6426-67d3-3976-a08a-73e396fbc17f",
                                "text": "EULOPHE. Eulophus. Genre de la famille des Ombellifères et de la Pentandrie Digynie, Lin., établi par Nuttal …"
                            }
                        ]
                    }
