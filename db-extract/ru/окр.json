                                        "sense_id": "a63577d8-5d9f-3b1a-ba1b-b4d8b98c9e54",
                                        "entry_id": "a9d28d7f-8b65-3094-8313-b109d904b6ce",
                                        "glosses": [
                                            "Trouble obsessionnel compulsif."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93663ad2-027e-4ccf-807e-6aae05404731",
                                                "sense_id": "a63577d8-5d9f-3b1a-ba1b-b4d8b98c9e54",
                                                "text": "Et quand les membres de la famille rentrent de l’extérieur, «cela génère du stress supplémentaire pour ces personnes qui ont donc instauré un rituel de nettoyage». Ce TOC est l’un des héritages du tragique épisode de 2003."
                                            },
                                            {
                                                "example_id": "ad3e590e-a894-495c-a81e-728d3607d496",
                                                "sense_id": "a63577d8-5d9f-3b1a-ba1b-b4d8b98c9e54",
                                                "text": "Certains psychiatres les rapprochent des gens qui ont des troubles obsessionnels compulsifs (TOC)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "afcc6e98-ce8d-4f29-b851-54303ec39060",
                        "source_entry_id": "299e11c7-3bfc-3403-b8df-16ed50893813",
                        "source_sense_description": "Олимпийский комитет России",
                        "target_lang_word": "ROC",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ROC",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff17a469-2c29-3802-90d3-2355030558a0",
                                        "entry_id": "eedd8a20-3817-3028-8c47-57dabd3a3f5d",
                                        "glosses": [
                                            "Initialism of Republic of China (all senses)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6b764c6-0d38-4f55-8557-16811d5f22a3",
                                                "sense_id": "ff17a469-2c29-3802-90d3-2355030558a0",
                                                "text": "Near-synonym: China"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76e86788-0f43-3d7d-9a6f-7c02d3a119f8",
                                        "entry_id": "eedd8a20-3817-3028-8c47-57dabd3a3f5d",
                                        "glosses": [
                                            "Initialism of Republic of China (all senses).",
                                            "Taiwan ROC."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ba9d1d1-2a68-404a-9814-02718a8b50fc",
                                                "sense_id": "76e86788-0f43-3d7d-9a6f-7c02d3a119f8",
                                                "text": "Former U.S. Senator George McGovern said that during his one-week visit to the ROC he met many friendly, optimistic and energetic people, and called the Republic of China an \"energetic\" country.\nHe said he hopes his visit will help to promote understanding between the ROC and liberals in the United States."
                                            },
                                            {
                                                "example_id": "6961991f-c1d6-4727-b542-12d3993dd1b0",
                                                "sense_id": "76e86788-0f43-3d7d-9a6f-7c02d3a119f8",
                                                "text": "This book suggests that the gradual increase of transactions and communications between the two Chinas since 1987 should contribute to the ‘normalization’ of relations between the two Chinas. Nevertheless, these transactions and communications are not expected to lead to the political reunification of the two Chinas in the foreseeable future due to four main obstacles: the PRC’s intention to localize and isolate the ROC internationally; the PRC’s refusal to exclude the use of military force against the ROC; the difference between the two Chinas’ living standards and political philosophies; and the Taiwan Independence Movement."
                                            },
                                            {
                                                "example_id": "44519cf4-c3c2-4318-ab46-891d92de7e6c",
                                                "sense_id": "76e86788-0f43-3d7d-9a6f-7c02d3a119f8",
                                                "text": "Prevented by internal and external influences, this ideal of placing the sovereignty in the hands of the people was not carried out immediately after the establishment of the Republic of China. With the changes of time, particularly with the relocation of the ROC government to Taiwan, we have gradually carried it out at last, but only after having licked our wounds and built our strength for forty years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a018912f-9cf8-3fca-a322-c305b06dd61c",
                                        "entry_id": "eedd8a20-3817-3028-8c47-57dabd3a3f5d",
                                        "glosses": [
                                            "Initialism of Republic of China (all senses).",
                                            "A former sovereign state of China, 1912–1949; dissolved by the declaration of the People's Republic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7358f496-1ccd-3a16-97f9-af0032f1c795",
                                        "entry_id": "eedd8a20-3817-3028-8c47-57dabd3a3f5d",
                                        "glosses": [
                                            "The \\\"Rest of Canada\\\", i.e. Canada excluding the province of Quebec."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bed8ff8c-737a-44ff-90ca-c33c16c92574",
                                                "sense_id": "7358f496-1ccd-3a16-97f9-af0032f1c795",
                                                "text": "[T]he old and tired purveyors of separatism in Québec continue to harp on what they contend Québec is not—essentially, “not the ROC”—in order to peddle their snake oil."
                                            },
                                            {
                                                "example_id": "79f72a96-838e-4586-9704-d8e5fb258272",
                                                "sense_id": "7358f496-1ccd-3a16-97f9-af0032f1c795",
                                                "text": "If Quebeckers believe that voting PQ means putting a knife to Canada’s throat, they should think again. The ROC is fed up with these threats."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf98bd4d-7c48-3502-860e-2aab267126b3",
                                        "entry_id": "eedd8a20-3817-3028-8c47-57dabd3a3f5d",
                                        "glosses": [
                                            "Abbreviation of Republic of (the) Congo, Congo-Brazzaville."
                                        ],
