{
    "word_family": [
        "derision",
        "derisive",
        "derisory"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "900db92c-29c6-3c53-a2e1-b0b67f9fedf3",
                    "sense_definition": "To laugh at or mock someone or something harshly; to ridicule or treat with contempt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mockery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Critics were quick to <w>deride</w> the new policy as a complete failure before it even had a chance to work.",
                            "target_lang_translations": {
                                "tr": "Eleştirmenler, yeni politikayı daha işe yarama şansı bile bulamadan tam bir başarısızlık olarak <w>alay konusu etmekte</w> gecikmediler."
                            }
                        },
                        {
                            "text": "It is cruel to <w>deride</w> someone's efforts when they are trying their best to learn a new skill.",
                            "target_lang_translations": {
                                "tr": "Birisi yeni bir beceri öğrenmek için elinden gelenin en iyisini yapmaya çalışırken onun çabalarını <w>küçümsemek</w> zalimcedir."
                            }
                        }
                    ],
                    "synonyms": [
                        "ridicule",
                        "scoff",
                        "sneer",
                        "taunt",
                        "jeer"
                    ],
                    "antonyms": [
                        "praise",
                        "respect",
                        "admire",
                        "compliment"
                    ],
                    "common_phrases": [
                        "deride someone's efforts",
                        "deride the idea"
                    ],
                    "target_lang_definitions": {
                        "tr": "Birini veya bir şeyi sert bir şekilde alaya almak, küçümsemek veya küçük düşürmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "alay etmek",
                                "target_lang_sense_clarification": "Birinin davranışlarıyla veya fikirleriyle dalga geçmek."
                            },
                            {
                                "target_lang_word": "küçümsemek",
                                "target_lang_sense_clarification": "Birini veya bir şeyi değersiz görmek."
                            },
                            {
                                "target_lang_word": "aşağılamak",
                                "target_lang_sense_clarification": "Birinin onurunu kıracak şekilde davranmak."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5bba1ef-0677-38e8-b311-5cfa64eba767",
                    "sense_definition": "To laugh in a harshly mocking manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mockery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cynical onlookers began to <w>deride</w> at the speaker's earnest presentation.",
                            "target_lang_translations": {
                                "tr": "Alaycı izleyiciler, konuşmacının samimi sunumuyla <w>alay etmeye</w> başladılar."
                            }
                        },
                        {
                            "text": "Instead of offering constructive feedback, they chose to <w>deride</w> at his misfortune.",
                            "target_lang_translations": {
                                "tr": "Yapıcı geri bildirim sunmak yerine, onun talihsizliğiyle <w>alay etmeyi</w> seçtiler."
                            }
                        }
                    ],
                    "synonyms": [
                        "jeer",
                        "scoff",
                        "sneer"
                    ],
                    "common_phrases": [
                        "deride at others"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "used intransitively with 'at'"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Sert ve alaycı bir tavırla gülmek veya dalga geçmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "alaycı bir şekilde gülmek",
                                "target_lang_sense_clarification": "Küçümseyici bir tavırla gülme eylemi."
                            },
                            {
                                "target_lang_word": "istihza etmek",
                                "target_lang_sense_clarification": "Alaycı bir dille eleştirmek veya gülmek."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}