    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9786af20-ea6e-3bc9-9a62-f577e85e22f6",
                    "sense_definition": "Wearing clothes.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to get <w>dressed</w> before we leave for the party.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно <w>одеться</w>, прежде чем мы уедем на вечеринку.",
                                "zh": "我们出发去派对前，你需要<w>穿好衣服</w>。"
                            }
                        },
                        {
                            "text": "He was <w>dressed</w> in a smart black suit.",
                            "target_lang_translations": {
                                "ru": "Он был <w>одет</w> в элегантный черный костюм.",
                                "zh": "他<w>穿着</w>一套帅气的黑色西装。"
                            }
                        }
                    ],
                    "synonyms": [
                        "clothed"
                    ],
                    "antonyms": [
                        "undressed",
                        "naked"
                    ],
                    "common_phrases": [
                        "get dressed",
                        "well dressed",
                        "fully dressed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одетый; тот, на ком есть одежда.",
                        "zh": "穿着衣服的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одетый",
                                "target_lang_sense_clarification": "носящий одежду"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "穿着",
                                "target_lang_sense_clarification": "处于穿衣状态"
                            },
                            {
                                "target_lang_word": "打扮",
                                "target_lang_sense_clarification": "指穿着的样式或状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4439c974-27e5-3dc4-8398-16be21b1a376",
                    "sense_definition": "Prepared for eating, especially by the addition of specific condiments or dressing.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "food_prep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>dressed</w> salad was served with fresh bread.",
                            "target_lang_translations": {
                                "ru": "<w>Заправленный</w> салат подали со свежим хлебом.",
                                "zh": "那份<w>拌好调料的</w>沙拉配着新鲜面包一起上桌了。"
                            }
                        },
                        {
                            "text": "We ordered a <w>dressed</w> crab for the main course.",
                            "target_lang_translations": {
                                "ru": "Мы заказали <w>разделанного</w> краба на горячее.",
                                "zh": "我们点了一道<w>处理好的</w>螃蟹作为主菜。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dressed salad",
                        "dressed crab"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приготовленный к подаче на стол (заправленный соусом или разделанный).",
                        "zh": "指食物经过处理，如拌入调料或预先切分好以便食用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заправленный",
                                "target_lang_sense_clarification": "о салате или блюде с соусом"
                            },
                            {
                                "target_lang_word": "разделанный",
                                "target_lang_sense_clarification": "о рыбе, крабе или птице"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拌好的",
                                "target_lang_sense_clarification": "指加了调料的沙拉等"
                            },
                            {
                                "target_lang_word": "处理过的",
                                "target_lang_sense_clarification": "指经过预处理的食材"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76897e77-1650-3f45-a2e9-45aea8e31b22",
                    "sense_definition": "Having been subjected to a preparatory process or treatment; treated, prepared.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "material_prep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wall was constructed from carefully <w>dressed</w> stone.",
                            "target_lang_translations": {
                                "ru": "Стена была построена из тщательно <w>отёсанного</w> камня.",
                                "zh": "这面墙是用精心<w>修整过的</w>石块砌成的。"
                            }
                        },
                        {
                            "text": "They used <w>dressed</w> leather to make the fine book covers.",
                            "target_lang_translations": {
                                "ru": "Они использовали <w>выделанную</w> кожу для изготовления изящных книжных обложек.",
                                "zh": "他们用<w>加工过的</w>皮革制作了精美的书皮。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dressed stone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подвергшийся специальной обработке; обработанный.",
                        "zh": "指材料经过特定的加工或修整。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обработанный",
                                "target_lang_sense_clarification": "общий термин"
                            },
                            {
                                "target_lang_word": "отёсанный",
                                "target_lang_sense_clarification": "о камне"
                            },
                            {
                                "target_lang_word": "выделанный",
                                "target_lang_sense_clarification": "о коже"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "加工过的",
                                "target_lang_sense_clarification": "经过处理的材料"
                            },
                            {
                                "target_lang_word": "修整过的",
                                "target_lang_sense_clarification": "指石材等经过打磨或切割"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "935d0e92-ea4b-37ed-bbf3-d430e2c82a67",
                    "sense_definition": "Simple past and past participle of <w>dress</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>dressed</w> quickly and ran to catch the bus.",
                            "target_lang_translations": {
                                "ru": "Она быстро <w>оделась</w> и побежала, чтобы успеть на автобус.",
                                "zh": "她很快<w>穿好衣服</w>，跑去赶公交车了。"
                            }
                        },
                        {
                            "text": "The nurse cleaned and <w>dressed</w> the wound.",
                            "target_lang_translations": {
                                "ru": "Медсестра промыла и <w>перевязала</w> рану.",
                                "zh": "护士清理并<w>包扎</w>了伤口。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола dress.",
                        "zh": "动词 dress 的过去式或过去分词，表示穿衣或包扎。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оделся",
                                "target_lang_sense_clarification": "надел одежду"
                            },
                            {
                                "target_lang_word": "перевязал",
                                "target_lang_sense_clarification": "наложил повязку на рану"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "穿上",
                                "target_lang_sense_clarification": "穿衣服的动作"
                            },
                            {
                                "target_lang_word": "包扎",
                                "target_lang_sense_clarification": "处理伤口"
                            }
                        ]
                    }
                }
            ]
        }
    ]
