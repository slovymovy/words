                "senses": [
                    {
                        "sense_id": "a0ac62dc-3789-3977-883c-1db8e35df521",
                        "entry_id": "e10ec8e9-fe1d-3e4e-ad6a-4836dbe1fdb0",
                        "glosses": [
                            "прост. дворовая собака"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "306172f9-8ec0-4f84-ae85-1ae7a7187478",
                                "sense_id": "a0ac62dc-3789-3977-883c-1db8e35df521",
                                "text": "И пришёл к Айболиту барбос: «Меня курица клюнула в нос!»"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75d13450-54a8-4174-8021-1333a156e7e9",
                        "source_entry_id": "e10ec8e9-fe1d-3e4e-ad6a-4836dbe1fdb0",
                        "source_sense_id": "a0ac62dc-3789-3977-883c-1db8e35df521",
                        "target_lang_word": "mongrel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mongrel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2227291-d797-353c-8069-f33c337979dc",
                                        "entry_id": "34a06d29-6fc4-38f5-8925-4c22f8a17aba",
                                        "glosses": [
                                            "Someone or something of mixed kind or uncertain origin, especially a dog."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "002cd8d9-539f-4391-88af-24763837cc71",
                                                "sense_id": "f2227291-d797-353c-8069-f33c337979dc",
                                                "text": "That dog is a mongrel; who knows what breed it could be!"
                                            },
                                            {
                                                "example_id": "4c0e88b5-cd85-47c2-b1cc-043affb498ca",
                                                "sense_id": "f2227291-d797-353c-8069-f33c337979dc",
                                                "text": "America is an improbable idea. A mongrel nation built of ever-changing disparate parts, it is held together by a notion, the notion that all men are created equal, though everyone knows that most men consider themselves better than someone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "103d6bb6-1798-387a-81ba-ea37c54a70c8",
                                        "entry_id": "34a06d29-6fc4-38f5-8925-4c22f8a17aba",
                                        "glosses": [
                                            "Someone or something of mixed kind or uncertain origin, especially a dog.",
                                            "A mixed-race person."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "ethnic",
                                            "offensive",
                                            "often",
                                            "slur"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e6e127f6-2822-317c-ba41-37560c184b39",
                                        "entry_id": "34a06d29-6fc4-38f5-8925-4c22f8a17aba",
                                        "glosses": [
                                            "A thuggish, obnoxious, or contemptible person; (often preceded by \\\"poor\\\") a pitiable person."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85d19b32-ef45-4dd2-adbe-e08ad9c7cb9b",
                                                "sense_id": "e6e127f6-2822-317c-ba41-37560c184b39",
                                                "text": "\"Yanto bloody Evans!\" Jack stuttered with rage. \"Yanto bloody Evans! That... that... bloody mongrel! D'you know who he is? He's the one who knocked me back for a bit of extra timber before the roof fell in on me!\""
                                            },
                                            {
                                                "example_id": "14f45a9e-3296-445c-8fbd-2a9c156d2457",
                                                "sense_id": "e6e127f6-2822-317c-ba41-37560c184b39",
                                                "text": "But somebody's got to tell these mums and dads why their kids died, why this mongrel thinks he can wipe them out like a dirty rag."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b3eba05-617c-3185-947f-fc9b01c7e5c1",
                                        "entry_id": "34a06d29-6fc4-38f5-8925-4c22f8a17aba",
                                        "glosses": [
                                            "An erect penis; an erection."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "mongrel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b29c23cd-8c5c-3f4a-8d42-7b607d086da4",
                                        "entry_id": "206a76b2-484c-3555-9eb4-8c0ff2468b03",
                                        "glosses": [
                                            "Of mixed breed, nature, or origin; of or like a mongrel."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a047fc96-0b2e-4475-9868-7c929e440eae",
                                                "sense_id": "b29c23cd-8c5c-3f4a-8d42-7b607d086da4",
                                                "text": "English spelling is often regarded as confusing and unpredictable due to the mongrel nature of that language."
                                            },
                                            {
                                                "example_id": "e25fc126-6fcd-4bbc-bb43-035aec4a934f",
                                                "sense_id": "b29c23cd-8c5c-3f4a-8d42-7b607d086da4",
                                                "text": "a mongrel dog"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
