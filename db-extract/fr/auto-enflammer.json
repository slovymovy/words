                        "examples": [
                            {
                                "example_id": "7373951c-c5cd-4fc1-80f7-61c2486cdd35",
                                "sense_id": "f63c9d55-8ac8-35fc-9a55-0a5dc3410c4c",
                                "text": "Le point éclair est la température pour laquelle les vapeurs générées par le pétrole peuvent s’auto-enflammer."
                            },
