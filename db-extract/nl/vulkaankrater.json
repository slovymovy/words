                                        "sense_id": "56837d42-e99d-3348-9ef1-606a035f54fe",
                                        "entry_id": "834004d4-1248-3864-bae5-4d0c6497a74b",
                                        "glosses": [
                                            "To collapse catastrophically; to become devastated or completely destroyed."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b123d13e-1349-4eb0-b2b3-840c6fbe5511",
                                                "sense_id": "56837d42-e99d-3348-9ef1-606a035f54fe",
                                                "text": "Yup, John McCain said to me the economy “is about to crater.” You folks worried about the economy? Whoo! Not me."
                                            },
                                            {
                                                "example_id": "7aabc15d-0c25-4f3f-afc4-b927f09db6a7",
                                                "sense_id": "56837d42-e99d-3348-9ef1-606a035f54fe",
                                                "text": "Uber said on Thursday that its ride-hailing business had cratered in the second quarter as people traveled less in the pandemic."
                                            },
                                            {
                                                "example_id": "2e012d80-c96c-49d5-8fc0-aa70ea1d7676",
                                                "sense_id": "56837d42-e99d-3348-9ef1-606a035f54fe",
                                                "text": "The potential agreement comes after months of disputes that have created existential challenges for Twitter, cratering its share price, demoralizing its employees and spooking the advertisers it relies on for revenue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "753345f9-dd10-3fcc-a6e3-c68bb3ad9ec4",
                                        "entry_id": "834004d4-1248-3864-bae5-4d0c6497a74b",
                                        "glosses": [
                                            "To crash or fall."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e65467a9-8983-4983-8c1e-0fae2bcabbb9",
                                                "sense_id": "753345f9-dd10-3fcc-a6e3-c68bb3ad9ec4",
                                                "text": "He cratered into that snow bank about five seconds after his first lesson."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fd749fb-9e69-36a7-b4e1-e9c1d70f3419",
                                        "entry_id": "834004d4-1248-3864-bae5-4d0c6497a74b",
                                        "glosses": [
                                            "To die from fall damage."
                                        ],
