                            {
                                "example_id": "61ec5c3f-04c1-4efe-9359-b95788e59723",
                                "sense_id": "ed81e9fc-0eb4-398a-a97e-c9912ef2fc89",
                                "text": "„Manche Reisenden gefallen sich in fremdem Land in der Rolle von Zoobesuchern vorm Affenkäfig.“"
                            },
                            {
                                "example_id": "494344c0-8d88-4e95-840e-91d34c0b611c",
                                "sense_id": "ed81e9fc-0eb4-398a-a97e-c9912ef2fc89",
                                "text": "„Zoobesucher müssen sich noch gedulden, bis sie den kleinen Affen sehen können: Der Zoo ist wegen der Ausgangssperre noch bis mindestens zum 11. Mai gesperrt.“"
                            }
                        ],
