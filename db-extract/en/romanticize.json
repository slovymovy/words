                "senses": [
                    {
                        "sense_id": "95e385dc-4e09-37a5-928b-b03470b5987d",
                        "entry_id": "0eb0132a-666f-340c-a863-2f0f57784ad8",
                        "glosses": [
                            "To interpret, view, or portray something in a romantic (unrealistic, idealized) manner."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "8156a75f-108d-4db0-a4be-1ced43e63b41",
                                "sense_id": "95e385dc-4e09-37a5-928b-b03470b5987d",
                                "text": "While we might have a tendency to romanticize the past, the reality is that cooking was often a monotonous, arduous, thankless task required to keep the family fed."
                            }
                        ]
                    },
                    {
                        "sense_id": "13674c80-98b0-366d-bbc4-56b769f7d6ba",
                        "entry_id": "0eb0132a-666f-340c-a863-2f0f57784ad8",
                        "glosses": [
                            "To think or act in a romantic manner."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2093f8e2-690a-4df7-9496-ec4dc7cb1a28",
                        "source_entry_id": "0eb0132a-666f-340c-a863-2f0f57784ad8",
                        "source_sense_description": "to view something in a romantic manner",
                        "target_lang_word": "romantiseren",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "romantiseren",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "37492082-6333-3f8c-9653-db3b475e8405",
                                        "entry_id": "aa755d38-4a01-3528-be72-cc22b9469a7c",
                                        "glosses": [
                                            "iets mooier en rooskleuriger voorstellen dan het in werkelijkheid is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "294b170d-bc58-4f31-a301-c837315250e7",
                                                "sense_id": "37492082-6333-3f8c-9653-db3b475e8405",
                                                "text": "Wat ik wel weet, is dat het leven vijfhonderd jaar geleden in deze contreien veel gewelddadiger en gevaarlijker was dan nu. Er was veel meer geweld, er waren veel meer moorden en verkrachtingen. Tegelijk romantiseren we die tijden ook. Mijn boeken willen entertainen zonder concessies te doen aan de realiteit. Ik steek geen belerend vingertje op. Ik wil vertellen, je moet er niet meer achter zoeken. Uiteindelijk is het allemaal escapisme. En daar is niks mis mee.’"
                                            },
                                            {
                                                "example_id": "cfa8d17a-e417-47ce-87fe-0f2f58be428d",
                                                "sense_id": "37492082-6333-3f8c-9653-db3b475e8405",
                                                "text": "Heel veel mensen romantiseren het werk in de horeca, maar het is gewoon hard werken en je richten naar de wensen van de klanten."
                                            },
                                            {
                                                "example_id": "cc1c31f3-6ec9-4008-9b9a-20d929a14040",
                                                "sense_id": "37492082-6333-3f8c-9653-db3b475e8405",
                                                "text": "‘Maar ik ben er achter gekomen dat thru-hiking’ soms een slechte keuze kan zijn. ‘Section hiking’ (gedurende langere tijd in delen lopen) is voor mij een veel betere optie. Thru-hiking is geromantiseerd en voor dromers. Uiteindelijk gaat het erom wat het beste bij je past. Voor mij gaat het om de ervaring."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f75386a8-be29-4cf3-b319-033dbe2bb581",
                        "source_entry_id": "0eb0132a-666f-340c-a863-2f0f57784ad8",
                        "source_sense_description": "to view something in a romantic manner",
                        "target_lang_word": "romantiser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "romantiser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f1be4f2c-b76f-3ee1-bbb9-55d646091d82",
                                        "entry_id": "0d77e187-cc1a-3f17-b583-55dfeb38212d",
                                        "glosses": [
                                            "Rendre romantique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "be58e9a2-1377-32d9-adea-aa7429fdbcf7",
                                        "entry_id": "0d77e187-cc1a-3f17-b583-55dfeb38212d",
                                        "glosses": [
                                            "Donner le caractère de roman."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2be95a4-1ad5-486b-9a17-ef58434c9bc9",
                                                "sense_id": "be58e9a2-1377-32d9-adea-aa7429fdbcf7",
                                                "text": "Schiller, romantisant l’histoire [dans don Carlos]"
                                            },
                                            {
                                                "example_id": "217a07ab-4638-492c-8498-ec99194846c5",
                                                "sense_id": "be58e9a2-1377-32d9-adea-aa7429fdbcf7",
                                                "text": "Dans un tiroir fermé à clef, un cahier d’écolier portait à chaque page, griffonné rageusement de haut en bas : « Vive la République ! » Michel seul, romantisant sans doute cet hurluberlu, vit en lui un enterré vivant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a402b4a-c28c-44e6-be80-b59f97132fe6",
                        "source_entry_id": "0eb0132a-666f-340c-a863-2f0f57784ad8",
                        "source_sense_description": "to view something in a romantic manner",
                        "target_lang_word": "romantisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "romantisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "defd5e22-7891-35d3-8a72-4d97fc0a285d",
                                        "entry_id": "c3602cff-b1fd-30b1-9631-68696c93c258",
                                        "glosses": [
                                            "etwas im Stil der Romantik gestalten oder darstellen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce0f09db-ab95-4319-81f3-032f5a8c51ae",
                                                "sense_id": "defd5e22-7891-35d3-8a72-4d97fc0a285d",
                                                "text": "Befürchtet wird freilich, daß ein romantisierender Neo-Historismus aufkommt, der die kritischen Errungenschaften der Aufklärung preisgibt."
                                            },
                                            {
                                                "example_id": "7f1a2c91-d27c-465d-a36b-d719079fedce",
                                                "sense_id": "defd5e22-7891-35d3-8a72-4d97fc0a285d",
                                                "text": "Es ist vorwiegend ein romantisierender, an die deutsche Neogotik sich anlehnender Jugendstil, mit viel Fachwerkanspielungen, aber auch mit Einfluß der russischen Datschen-Architektur."
                                            },
                                            {
                                                "example_id": "cfee5e3e-288d-4db3-bbfc-6afcab374518",
                                                "sense_id": "defd5e22-7891-35d3-8a72-4d97fc0a285d",
                                                "text": "In der Architektur sind romantisierende Tendenzen im historisierenden Schlossbau und in der Vorliebe zur Schaffung künstlicher Ruinen festzustellen."
                                            },
                                            {
                                                "example_id": "35e80c08-7ddf-4a78-875f-24a41f079bab",
                                                "sense_id": "defd5e22-7891-35d3-8a72-4d97fc0a285d",
                                                "text": "Die Erfahrungen im Exil haben ihn sensibilisiert für gegenaufklärerische, irrationalistische und romantisierende Strömungen."
                                            },
                                            {
                                                "example_id": "31caf497-15b4-4796-b98e-4276e354e38a",
                                                "sense_id": "defd5e22-7891-35d3-8a72-4d97fc0a285d",
                                                "text": "„Die Welt romantisieren heißt, sie als Kontinuum wahrzunehmen, in dem alles mit allem zusammenhängt. Erst durch diesen poetischen Akt der Romantisierung wird die ursprüngliche Totalität der Welt als ihr eigentlicher Sinn im Kunstwerk ahnbar und mitteilbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6abf18c9-fac5-3f68-9f5c-0660fd8067e7",
                                        "entry_id": "c3602cff-b1fd-30b1-9631-68696c93c258",
                                        "glosses": [
                                            "etwas idealisiert betrachten oder wiedergeben"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8b4bd4d-04aa-44e9-afb4-4ba6e59584f8",
                                                "sense_id": "6abf18c9-fac5-3f68-9f5c-0660fd8067e7",
                                                "text": "In seinem „Thesaurus der untergegangenen Berufe“ wird der vorindustrielle Alltag nicht romantisiert, sondern realistisch beschrieben."
                                            },
                                            {
                                                "example_id": "427a5d99-4c30-467a-9f0e-b0584883ffdb",
                                                "sense_id": "6abf18c9-fac5-3f68-9f5c-0660fd8067e7",
                                                "text": "„Menschen, die nie wirkliche Armut erlebt haben“, schreibt er, „romantisieren oft die Armut. …“"
                                            },
                                            {
                                                "example_id": "30b5d3f2-28fc-4bcf-bcb0-cf9e77d06552",
                                                "sense_id": "6abf18c9-fac5-3f68-9f5c-0660fd8067e7",
                                                "text": "Während die Zahl der Landwirte sinkt, romantisieren Konsumenten das kleinbäuerliche Idyll."
                                            },
                                            {
                                                "example_id": "29c080b7-bc98-4b07-9ebe-69103f4bee1a",
                                                "sense_id": "6abf18c9-fac5-3f68-9f5c-0660fd8067e7",
                                                "text": "Wir neigen dazu, den Tod von Tieren zu übersehen, ihn zu trivialisieren oder zu romantisieren. Wir romantisieren ihn, wenn wir die Frage des Tiere-Tötens dem Bereich der blinden, doch vermeintlich auch irgendwie erhabenen und harmonischen Natur zuschlagen wollen."
                                            },
                                            {
                                                "example_id": "48eef8ce-82e0-4444-b9e8-0a958acd8a54",
                                                "sense_id": "6abf18c9-fac5-3f68-9f5c-0660fd8067e7",
                                                "text": "Es wird gesungen, getanzt, romantisiert und schuhgeplattelt, als ob es die reale Welt da draußen mit Beziehungs-, Existenz- und Wirtschaftskrisen gar nicht gebe."
                                            },
                                            {
                                                "example_id": "102a5470-a939-4b62-9f2b-34a9b1b3e656",
                                                "sense_id": "6abf18c9-fac5-3f68-9f5c-0660fd8067e7",
                                                "text": "„Ich will Leiden nicht romantisieren – genug ist schließlich genung –, aber wer nicht leiden kann, wird nicht erwachsen, wird nicht herausfinden, wer er ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
