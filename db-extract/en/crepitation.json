                                "example_id": "3a8a4d83-575a-4ba0-af8a-7814ecb38889",
                                "sense_id": "e87cd2f9-2a10-3441-9c44-62ab2ed307f1",
                                "text": "Silence again, save for the crepitation of the flames, the fall of an ember, the murmur of the current."
