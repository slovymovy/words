                ],
                "senses": [
                    {
                        "sense_id": "af70f29e-ddb3-3e2e-a6bd-1ef4d9da4bda",
                        "entry_id": "68df3972-3452-39d3-ad71-978ff1365557",
                        "glosses": [
                            "Schuh, der für die Verwendung in der kalten Jahreszeit besonders gut geeignet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d45aea1-743b-448f-9d7e-ecc3ed6f2faf",
                                "sense_id": "af70f29e-ddb3-3e2e-a6bd-1ef4d9da4bda",
                                "text": "„Damit hatte ich gerechnet: Dass ich einen Winterschuh brauchte, stand ja außer Frage.“"
                            },
                            {
                                "example_id": "ae61b2b4-39fd-4218-ac5c-fd9726eac5d3",
                                "sense_id": "af70f29e-ddb3-3e2e-a6bd-1ef4d9da4bda",
                                "text": "„Ein Winterschuh absolviert derweil bei minus 17 Grad Celsius den Kältetest in einer Tiefkühltruhe.“"
                            },
                            {
                                "example_id": "0062c900-25a1-4b5d-9a7a-6f380af01177",
                                "sense_id": "af70f29e-ddb3-3e2e-a6bd-1ef4d9da4bda",
                                "text": "„Da das Hosenende in einem Winterschuh steckte, fand Otto auf meinem Fußknöchel in der Hose seine Ruhe.“"
                            },
                            {
                                "example_id": "a6855583-1280-4a7e-95f1-904b0bba1d1d",
                                "sense_id": "af70f29e-ddb3-3e2e-a6bd-1ef4d9da4bda",
                                "text": "„Dass alle Kinder warme Winterschuhe besaßen und Johanna und Fried Wintermäntel, fiel ihm zum Glück nicht auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
