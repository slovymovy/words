            "senses": [
                {
                    "sense_id": "351f3f55-2db9-3438-aa5a-4fa78605c055",
                    "sense_definition": "D'une valeur ou d'une quantité insignifiante au point d'en paraître ridicule.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "insignifiance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a vendu sa vieille voiture pour une somme <w>dérisoire</w> à son voisin."
                        },
                        {
                            "text": "Le salaire proposé pour ce poste à responsabilités reste tout à fait <w>dérisoire</w>."
                        }
                    ],
                    "common_phrases": [
                        "somme dérisoire",
                        "prix dérisoire"
                    ]
                },
                {
                    "sense_id": "b20a412b-7404-390f-aa13-458f4186281b",
                    "sense_definition": "Vain, inutile ou impuissant face à une situation insurmontable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inutilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Leurs efforts <w>dérisoires</w> pour éteindre l'incendie n'ont pas suffi à sauver la grange."
                        },
                        {
                            "text": "Devant l'immensité de la tempête en mer, notre embarcation paraissait bien <w>dérisoire</w>."
                        }
                    ],
                    "common_phrases": [
                        "efforts dérisoires"
                    ]
                },
                {
                    "sense_id": "11e308fd-f6fc-39b3-a428-f4a18306c60a",
                    "sense_definition": "Qui exprime ou contient de la dérision.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "moquerie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'acteur arborait un sourire <w>dérisoire</w> pour se moquer ouvertement de son adversaire."
                        },
                        {
                            "text": "Elle répondait à chaque critique sérieuse par une remarque <w>dérisoire</w> et méprisante."
                        }
                    ],
