                "translations": [
                    {
                        "translation_id": "97e09137-1f67-4d07-a3d7-08d86ef68d20",
                        "source_entry_id": "5f0fa75b-2afa-3c35-9bad-f62e1e334499",
                        "source_sense_id": "5ca32014-0f9a-356f-94af-4e55c086291e",
