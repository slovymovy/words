                "senses": [
                    {
                        "sense_id": "69760e3d-fa01-3a31-a601-4c7d1bde0d79",
                        "entry_id": "7fa44533-ef4d-3764-934b-13c24b7dddf7",
                        "glosses": [
                            "Konstruktion (aus Holz), an der einzelne Postsäcke so aufgehängt wurden, dass sie oben offen waren und leicht befüllt werden konnten"
                        ],
                        "tags": [
                            "Postwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "91ecb30c-1c23-4ebe-9e39-f1d96fdeb7aa",
                                "sense_id": "69760e3d-fa01-3a31-a601-4c7d1bde0d79",
                                "text": "„Fast vergessene Arbeitsmittel wie Stempeltisch, Beutelgestell, Schnürösen und Bundschließen versetzen den Besucher in die zurückliegenden Jahre und spiegeln die Arbeitsabläufe wider.“"
                            },
                            {
                                "example_id": "abcd0dda-1e85-427a-bcaf-a28d7779555d",
                                "sense_id": "69760e3d-fa01-3a31-a601-4c7d1bde0d79",
                                "text": "„Besondere Begeisterung erweckten der erstmals ausreichend große Raum und — das Beutelgestell.“"
                            },
                            {
                                "example_id": "1135f887-7328-42c6-a37d-7581386d3186",
                                "sense_id": "69760e3d-fa01-3a31-a601-4c7d1bde0d79",
                                "text": "„Auf dem Aussacktisch in der Mitte des BpW lagen Briefbunde und Grobsendungen bereit zum Abwurf in die vorgesehenen Orts- und Verteilbeutel, aufgehängt in einem Beutelgestell.“"
                            },
                            {
                                "example_id": "5711330b-aaaf-4677-b7e9-58f8d5a226e6",
                                "sense_id": "69760e3d-fa01-3a31-a601-4c7d1bde0d79",
                                "text": "„In dem Wagen ist das Beutelgestell für die Zeitungssäcke der räumlichen Verteilung wegen von dem für die Briefsäcke getrennt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
