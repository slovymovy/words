                "senses": [
                    {
                        "sense_id": "9911b530-8723-3746-8e61-333c8ee8ed0a",
                        "entry_id": "d37ccf68-5c75-3e41-8d57-076782827a5a",
                        "glosses": [
                            "Reproduire avec un miméographe un modèle d’impression."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96c4aa05-0cc0-41d2-a39f-a149aceebbaa",
                                "sense_id": "9911b530-8723-3746-8e61-333c8ee8ed0a",
                                "text": "Mais celle que je cite en particulier m'est arrivée pendant qu'il était à mon bureau, et j'ai fait miméographier le passage intéressant."
                            },
                            {
                                "example_id": "fab57db5-dfac-4dc1-947e-531df780a767",
                                "sense_id": "9911b530-8723-3746-8e61-333c8ee8ed0a",
                                "text": "Tous ils me pressèrent de faire éditer, après mise à jour, les cours que j'avais fait miméographier à leur intention."
                            }
                        ]
                    }
