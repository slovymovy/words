                                                "sense_id": "a539ac69-efa3-31e0-902b-30eb72ed34b7",
                                                "text": "Der Verkehr auf der A 54 hat sich wieder beruhigt."
                                            },
                                            {
                                                "example_id": "6d53febd-bd1f-4f66-976a-1e1e75af6854",
                                                "sense_id": "a539ac69-efa3-31e0-902b-30eb72ed34b7",
                                                "text": "Gen Abend hatte sich der Wirbelsturm beruhigt."
