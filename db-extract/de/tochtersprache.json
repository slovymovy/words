                "senses": [
                    {
                        "sense_id": "a5f41064-d43f-31a2-b328-39c099c8b5f1",
                        "entry_id": "730f59e8-eec0-3fae-8a76-0b9171dd468e",
                        "glosses": [
                            "Linguistik, speziell Historische Linguistik: jüngere Sprache, die durch die historische Entwicklung aus einer älteren hervorgegangen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dce9343c-bfe0-4460-8bbb-c64a2eaa0081",
                                "sense_id": "a5f41064-d43f-31a2-b328-39c099c8b5f1",
                                "text": "Französisch ist eine der Tochtersprachen des Lateinischen. Das heutige Deutsch ist Tochtersprache von Frühneuhochdeutsch, Mittelhochdeutsch, Althochdeutsch, Germanisch und Indogermanisch/ Indoeuropäisch."
                            },
                            {
                                "example_id": "c0ee73f9-a370-40d1-be0a-2c72b9ffa576",
                                "sense_id": "a5f41064-d43f-31a2-b328-39c099c8b5f1",
                                "text": "Eine Sprachfamilie besteht aus einer Grundsprache/Ursprache und ihren Tochtersprachen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5701ba4f-c9e9-4434-bc90-d67c2d9a6122",
                        "source_entry_id": "730f59e8-eec0-3fae-8a76-0b9171dd468e",
                        "source_sense_id": "a5f41064-d43f-31a2-b328-39c099c8b5f1",
                        "target_lang_word": "daughter language",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "daughter language",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b66ea72-9a6f-3710-aac8-13a3c01a7765",
                                        "entry_id": "18e95dbe-e05d-3225-af6b-b82ac424c7f1",
                                        "glosses": [
                                            "A language which genetically descends from an earlier parent language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "218c8a74-5a7d-4da9-a694-2c8896bd8a02",
                                                "sense_id": "7b66ea72-9a6f-3710-aac8-13a3c01a7765",
                                                "text": "English is a daughter language of Old English."
                                            },
                                            {
                                                "example_id": "1788511c-2f0b-4b68-a44c-02f09c8c0429",
                                                "sense_id": "7b66ea72-9a6f-3710-aac8-13a3c01a7765",
                                                "text": "French, Spanish, Italian and Portuguese are daughter languages of Latin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "907484b5-edd6-45f2-9c53-377d9358730f",
                        "source_entry_id": "730f59e8-eec0-3fae-8a76-0b9171dd468e",
                        "source_sense_id": "a5f41064-d43f-31a2-b328-39c099c8b5f1",
                        "target_lang_word": "langue fille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "langue fille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b794f62e-4f79-3354-9f50-357f03f721b6",
                                        "entry_id": "92a1224f-07f2-38cb-adf5-ce7147b6a9c1",
                                        "glosses": [
                                            "Langue descendante (d’une langue donnée)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e27ad104-0a9f-4ec9-b22c-fb5e82853a86",
                                                "sense_id": "b794f62e-4f79-3354-9f50-357f03f721b6",
                                                "text": "On me citera peut-être les langues filles du latin, qui diffèrent dans leurs formes de celles dont elles sont dérivées."
                                            },
                                            {
                                                "example_id": "ffb8a680-5cc6-4da9-88aa-57f4994d6753",
                                                "sense_id": "b794f62e-4f79-3354-9f50-357f03f721b6",
                                                "text": "La différence entre ces deux conceptions consiste en ce que, selon la thèse A, le latin vulgaire est une langue sœur du latin classique, alors que, selon la thèse B, le latin vulgaire est une langue fille du latin classique, c’est-à-dire que le latin vulgaire, différencié dans le temps et l’espace, constitue une étape intermédiaire entre le latin classique et les langues romanes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
