                        "entry_id": "519ecb81-c3a5-380f-a499-8d879ef6377c",
                        "glosses": [
                            "Joueur de djembé. Ce titre est généralement réservé aux maîtres percussionnistes ayant une longue pratique de l'instrument."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2eaffec0-aa07-48d4-acfe-df010a5d0231",
                                "sense_id": "55753a41-0c0b-33e9-9dda-55765152be02",
                                "text": "Mamady Keita, l'un des grands maîtres de la percussion africaine (un djembefola), rentre au pays, à Balandugu, dans la région de Malinké (Guinée)."
                            },
                            {
                                "example_id": "4355fcae-2800-4da2-930e-421de9e84458",
                                "sense_id": "55753a41-0c0b-33e9-9dda-55765152be02",
                                "text": "Le djembefola soliste Famoudou Konaté y a joué de 1959 à 1985 avant d'embrasser une carrière de professeur de djembé et de musicien."
                            },
                            {
                                "example_id": "889a8a3d-0d45-4029-abe1-2bfa78df65d0",
                                "sense_id": "55753a41-0c0b-33e9-9dda-55765152be02",
                                "text": "Journal d'une djembefola: Ma déroutante quête du djembé."
                            }
                        ]
                    }
