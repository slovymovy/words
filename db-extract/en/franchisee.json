                        "entry_id": "45cd7469-f62d-3a10-af06-745657115fed",
                        "glosses": [
                            "A holder of a franchise; a person who is granted a franchise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b2be0e0-1fe3-4f94-bb7e-c8d2f0a3cc71",
                                "sense_id": "cfce1426-0103-340b-bb87-c7d990a513a1",
                                "text": "The critical milestone is the December 2020 timetable, when new franchisee East Midlands Railway is due to start operating electric trains southwards from Corby into London St Pancras."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0220de8b-385e-472b-a2f7-eb333b66a733",
                        "source_entry_id": "45cd7469-f62d-3a10-af06-745657115fed",
                        "source_sense_id": "cfce1426-0103-340b-bb87-c7d990a513a1",
                        "source_sense_description": "holder of a franchise",
                        "target_lang_word": "franchisenemer",
