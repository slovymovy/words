                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17663503-c7a9-4011-aaf5-d13b7785e039",
                                                "sense_id": "7be07910-7897-3cfa-9e5e-42af0161e969",
                                                "text": "De man maakte onwillekeurige bewegingen."
                                            },
                                            {
                                                "example_id": "2878a0f4-f991-4164-a470-1628d9cb69fc",
                                                "sense_id": "7be07910-7897-3cfa-9e5e-42af0161e969",
                                                "text": "' 'Ha!' Pamela schaterde het uit en ik moest onwillekeurig glimlachen; het was opwindend om het te vertellen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "886e3310-fffa-3b61-a103-d82177caf285",
                                        "entry_id": "7f54aa2a-95af-3911-82d7-7f8e8e86ea82",
                                        "glosses": [
                                            "zonder bewustzijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e98d68e-5adb-49d0-b73c-40ae5a10a406",
                                                "sense_id": "886e3310-fffa-3b61-a103-d82177caf285",
                                                "text": "Chie's enige moeder is nu die rollende, glanzende bol, die zichzelf onwillekeurig eenmaal per jaar om de zon heen gooit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
