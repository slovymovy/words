                        "entry_id": "2e03fd28-5ebc-3915-9d9e-a36e4c8ce497",
                        "glosses": [
                            "Any of various animals having ten legs or similar appendages, especially mollusks such as squid and cuttlefish."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "83db62b6-e872-3e34-8f64-655c3c12382a",
                        "entry_id": "2e03fd28-5ebc-3915-9d9e-a36e4c8ce497",
                        "glosses": [
                            "Any crustacean, of the order Decapoda, such as crabs or lobsters."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "810578c3-14da-3a6b-ab10-85a5d2bfc945",
                        "entry_id": "2e03fd28-5ebc-3915-9d9e-a36e4c8ce497",
                        "glosses": [
                            "A nickname for either the 0-10-0 or 2-10-0 train configurations. Sometimes capitalized."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44287e4b-1678-4df3-8fbe-96073b741d74",
                                "sense_id": "810578c3-14da-3a6b-ab10-85a5d2bfc945",
                                "text": "Naturally, odd pairs of engines and solitary examples lend themselves admirably to nicknames: for example, the Great Eastern 0-10-0 tank \"Decapod\", and the Lickey Incline banker, \"Big Bertha\", recently withdrawn from service."
                            }
                        ]
                    }
                ],
