                    "sense_definition": "Сравнительная степень прилагательного <w>далёкий</w>; более отдалённый.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "spatial_comp",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Цель казалась <w>дальше</w>, чем была на самом деле.",
                            "target_lang_translations": {
                                "en": "The goal seemed <w>further</w> than it actually was.",
                                "zh": "目标看起来比实际上要<w>远</w>。"
