{
    "word_family": [
        "ominous",
        "ominously",
        "ominousness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "563c85ac-622b-3c94-ab4c-31bde1a9b0b5",
                    "sense_definition": "An event, sign, or phenomenon believed to foretell good or evil in the future.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sign_of_future",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many sailors believed that the sudden storm was a bad <w>omen</w> for their journey.",
                            "target_lang_translations": {
                                "nl": "Veel zeelieden geloofden dat de plotselinge storm een slecht <w>voorteken</w> was voor hun reis."
                            }
                        },
                        {
                            "text": "The successful launch of the new product was seen as a good <w>omen</w> for the company.",
                            "target_lang_translations": {
                                "nl": "De succesvolle lancering van het nieuwe product werd gezien als een goed <w>voorteken</w> voor het bedrijf."
                            }
                        }
                    ],
                    "synonyms": [
                        "portent",
                        "augury",
                        "sign",
                        "presage",
                        "harbinger",
                        "foretoken"
                    ],
                    "common_phrases": [
                        "good omen",
                        "bad omen",
                        "ill omen"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een gebeurtenis, teken of verschijnsel waarvan men gelooft dat het iets goeds of slechts in de toekomst voorspelt."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "voorteken",
                                "target_lang_sense_clarification": "algemeen teken dat naar de toekomst wijst"
                            },
                            {
                                "target_lang_word": "omen",
                                "target_lang_sense_clarification": "formeel of literair synoniem voor voorteken"
                            },
                            {
                                "target_lang_word": "voorbode",
                                "target_lang_sense_clarification": "aankondiging of vroege aanwijzing van iets"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8b320be9-e008-38f2-8552-6b9f797cba63",
                    "sense_definition": "To serve as an omen of; to foreshadow or portend something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sign_of_future",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gathering dark clouds seemed to <w>omen</w> a violent tempest.",
                            "target_lang_translations": {
                                "nl": "De samenpakkende donkere wolken leken een hevige storm te <w>voorspellen</w>."
                            }
                        },
                        {
                            "text": "Her nervous hesitation appeared to <w>omen</w> trouble ahead for the entire project.",
                            "target_lang_translations": {
                                "nl": "Haar nerveuze aarzeling leek moeilijkheden <w>aan te kondigen</w> voor het hele project."
                            }
                        }
                    ],
                    "synonyms": [
                        "portend",
                        "foreshadow",
                        "presage",
                        "bode",
                        "augur",
                        "betoken"
                    ],
                    "target_lang_definitions": {
                        "nl": "Dienen als voorteken van; iets vooraf aankondigen of voorspellen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "voorspellen",
                                "target_lang_sense_clarification": "vooraf duiden wat er gaat gebeuren"
                            },
                            {
                                "target_lang_word": "aankondigen",
                                "target_lang_sense_clarification": "de voorbode zijn van"
                            },
                            {
                                "target_lang_word": "bode zijn van",
                                "target_lang_sense_clarification": "als voorteken dienen voor"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a07d85ae-715f-3b59-be24-907eb683f3b6",
                    "sense_definition": "To predict, foretell, or divine from signs or portents.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sign_of_future",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient priest sought to <w>omen</w> the outcome of the battle by studying bird flights.",
                            "target_lang_translations": {
                                "nl": "De oude priester probeerde de uitkomst van de strijd te <w>voorspellen</w> door de vlucht van vogels te bestuderen."
                            }
                        },
                        {
                            "text": "They tried to <w>omen</w> future harvests by observing patterns in the winter frost.",
                            "target_lang_translations": {
                                "nl": "Ze probeerden toekomstige oogsten te <w>voorspellen</w> door patronen in de wintervorst waar te nemen."
                            }
                        }
                    ],
                    "synonyms": [
                        "divine",
                        "prognosticate",
                        "foretell",
                        "predict"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used historically or in literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "De toekomst voorspellen of aflezen uit tekenen of voortekenen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "voorspellen",
                                "target_lang_sense_clarification": "toekomst voorspellen aan de hand van tekenen"
                            },
                            {
                                "target_lang_word": "waarzeggen",
                                "target_lang_sense_clarification": "uit tekens de toekomst proberen te lezen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}