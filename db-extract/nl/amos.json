                            {
                                "target_word": "Amos",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2989bd70-d5e2-30ef-bbc5-891c89923eef",
                                        "entry_id": "e1b6737f-c783-37d5-8f5b-d1aa99177008",
                                        "glosses": [
                                            "Prophète hébreu, pasteur à Têques."
                                        ],
                                        "tags": [
                                            "Anthroponyme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3197d103-e414-4919-9b4f-61ea76f733e6",
                                                "sense_id": "2989bd70-d5e2-30ef-bbc5-891c89923eef",
                                                "text": "Car voici ce que dit Amos : Jéroboam mourra par l’épée, et Israël sera emmené captif hors de son pays."
                                            },
                                            {
                                                "example_id": "d09ec535-584d-4680-b0c8-40a0f521aae4",
                                                "sense_id": "2989bd70-d5e2-30ef-bbc5-891c89923eef",
                                                "text": "Le cri d’Amos, l’humeur d’Achille\nGonfle sa narine et lui sied ;\nLa mesure du vers d’Eschyle,\nC’est le battement de son pied."
                                            },
                                            {
                                                "example_id": "89f3c11b-7d35-43ad-a7fa-4af5c8e28ca0",
                                                "sense_id": "2989bd70-d5e2-30ef-bbc5-891c89923eef",
                                                "text": "Fénelon si tendre, presque newmanien dans ce qu’il a de meilleur, et tout à coup prophète, et prophète aussi dur qu’Amos ou Malachie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e1b166c-9352-3170-ab65-95239b1be73e",
                                        "entry_id": "e1b6737f-c783-37d5-8f5b-d1aa99177008",
                                        "glosses": [
                                            "Trentième-septième livre de l’Ancien Testament, contenant les révélations de ce prophète."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Amos",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6cd0e6e6-de7e-3843-b0e1-e9e1dd82138a",
                                        "entry_id": "156ded66-cbf4-3d2c-acee-9abddb5393c5",
                                        "glosses": [
                                            "Ville canadienne du Québec située dans la MRC d’Abitibi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53317612-b236-413d-ab30-266f6ed3ed4a",
                                                "sense_id": "6cd0e6e6-de7e-3843-b0e1-e9e1dd82138a",
                                                "text": "Même si le Docteur Arrudaa a jugé que les risques que posait l’Halloween étaient faibles à condition de respecter, certaines règles, Amos et Rouyn-Noranda, en Abitibi-Témiscamingue, ont interdit le porte-à-porte cette année."
                                            },
                                            {
                                                "example_id": "c9ef1c1f-cb46-4adf-bda1-b07d62ec4f32",
                                                "sense_id": "6cd0e6e6-de7e-3843-b0e1-e9e1dd82138a",
                                                "text": "Les pompiers d’Amos sont intervenus vendredi pour un sauvetage sur glace, sur la rivière Harricana, près du centre-ville d’Amos."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
