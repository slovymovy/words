                    {
                        "translation_id": "9271c439-8f45-4b69-baa1-a7ffaeccb665",
                        "source_entry_id": "8dbd397a-620a-3822-825d-f1f07364d346",
                        "source_sense_id": "aba7c1cb-2e56-315b-bda0-f00efc471073",
                        "source_sense_description": "the capital city of Syria",
                        "target_lang_word": "Дама́ск",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Дама́ск",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "70cb524d-6b41-37f5-9fcc-5b2f3dbf3047",
                                        "entry_id": "54663549-eb68-32af-807a-740df7629e67",
                                        "glosses": [
                                            "геогр. город, столица и второй по величине город Сирии; центр мухафазы Дамаск [2]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14712476-0fc8-431c-a74f-d07cf750d0d8",
                                                "sense_id": "70cb524d-6b41-37f5-9fcc-5b2f3dbf3047",
                                                "text": "Она заставила меня прочитать мой экспромт при гостях, и гости одобрили его, хотя и спросили, почему действие происходит в Дамаске, а не в Пскове, и на улице, а не в Пушкинском театре, где устраивается бал-маскарад."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56b636ed-912c-365c-b611-55af9f025a73",
                                        "entry_id": "54663549-eb68-32af-807a-740df7629e67",
                                        "glosses": [
                                            "геогр. мухафаза на юго-западе Сирии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bac1b33-d50e-4941-b492-91db1700863c",
                                                "sense_id": "56b636ed-912c-365c-b611-55af9f025a73",
                                                "text": "Она заставила меня прочитать мой экспромт при гостях, и гости одобрили его, хотя и спросили, почему действие происходит в Дамаске, а не в Пскове, и на улице, а не в Пушкинском театре, где устраивается бал-маскарад."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2db08b97-6da7-37db-a5ed-6d18975fd1b2",
                                        "entry_id": "54663549-eb68-32af-807a-740df7629e67",
                                        "glosses": [
                                            "перен. полит. правительство, руководство Сирии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b94f68f-10bd-4de6-9d8a-a541e0148c24",
                                                "sense_id": "2db08b97-6da7-37db-a5ed-6d18975fd1b2",
                                                "text": "Таким образом, подчеркнул генерал, Дамаск сотрудничает со сторонниками прежнего иракского режима, что значительно дестабилизирует ситуацию."
                                            }
                                        ]
                                    }
                                ]
