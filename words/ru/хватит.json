                    "sense_id": "f039d339-20dd-3647-8a23-e8341cab70a8",
                    "sense_definition": "Форма будущего времени третьего лица единственного числа глагола <w>хватить</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Нам <хватит> еды на всю неделю.",
                            "target_lang_translations": {
                                "en": "We will have <enough> food for the whole week.",
                                "zh": "我们这一周的食物<w>够</w>了。",
                                "nl": "We hebben voor de hele week <w>genoeg</w> eten.",
                                "pl": "Jedzenia <w>wystarczy</w> nam na cały tydzień.",
                                "de": "Das Essen wird uns für die ganze Woche <w>reichen</w>.",
                                "fr": "Nous aurons assez de nourriture pour toute la semaine, cela <w>suffira</w>.",
                                "it": "Ci <basterà> il cibo per tutta la settimana.",
                                "cs": "Jídla nám na celý týden <w>bude stačit</w>.",
                                "tr": "Bütün hafta için yemeğimiz <w>yetecek</w>.",
                                "es": "Nos <w>bastará</w> la comida para toda la semana."
                            }
                        },
                        {
                            "text": "Этого количества бензина не <хватит>, чтобы доехать до города.",
                            "target_lang_translations": {
                                "en": "This amount of gasoline <will not be enough> to reach the city.",
                                "zh": "这点汽油<w>不够</w>开到城里。",
                                "nl": "Deze hoeveelheid benzine zal niet <w>genoeg</w> zijn om de stad te bereiken.",
                                "pl": "Tej ilości benzyny nie <w>wystarczy</w>, żeby dojechać do miasta.",
                                "de": "Diese Menge Benzin wird nicht <w>ausreichen</w>, um die Stadt zu erreichen.",
                                "fr": "Cette quantité d'essence ne <w>suffira</w> pas pour atteindre la ville.",
                                "it": "Questa quantità di benzina non <basterà> per arrivare in città.",
                                "cs": "Tohle množství benzínu <w>nebude stačit</w> na to, abychom dojeli do města.",
                                "tr": "Bu benzin miktarı şehre ulaşmaya <w>yetmeyecek</w>.",
                                "es": "Esta cantidad de gasolina no <w>bastará</w> para llegar a la ciudad."
                            }
                        }
                    ],
                    "common_phrases": [
