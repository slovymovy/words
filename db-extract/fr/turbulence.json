        "fr-extract.jsonl": [
            {
                "entry_id": "503ff519-5d72-3c59-980d-d2c76e378d4e",
                "word": "turbulence",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "04bf3955-98d5-4b1a-ae08-20306de1ac5c",
                        "entry_id": "503ff519-5d72-3c59-980d-d2c76e378d4e",
                        "tags": [
                            "plural"
                        ],
                        "form": "turbulences"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "695009af-a9fc-3f1c-98b1-04ecf6930864",
                        "entry_id": "503ff519-5d72-3c59-980d-d2c76e378d4e",
                        "glosses": [
                            "Caractère de celui qui est turbulent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3800d75-6bed-40f0-96e3-57bfce6faddf",
                                "sense_id": "695009af-a9fc-3f1c-98b1-04ecf6930864",
                                "text": "[…] ; s'ils marchent, c'est posément et pour affaires; et ils ne conçoivent rien à notre turbulence et à nos promenades en long et en large; toujours assis, ils passent des journées entières rêvant, les jambes croisées, la pipe à la bouche, […]."
                            },
                            {
                                "example_id": "19268a99-43fe-41c9-b51a-66623048c476",
                                "sense_id": "695009af-a9fc-3f1c-98b1-04ecf6930864",
                                "text": "En effet, si les armées des rois mérovingiens étaient d’ordinaire sans discipline, celle-là passait en turbulence farouche tout ce qu’on avait vu depuis l’époque des grandes invasions."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c22ebfe-1251-3d1c-bee7-cbb1c2c95ed6",
                        "entry_id": "503ff519-5d72-3c59-980d-d2c76e378d4e",
                        "glosses": [
                            "État d’un fluide, liquide ou gaz, dans lequel la vitesse présente en tout point un caractère tourbillonnaire."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "87fcb165-9459-4d33-a95a-fc4b3e318335",
                                "sense_id": "2c22ebfe-1251-3d1c-bee7-cbb1c2c95ed6",
                                "text": "Le silure dépasse sa proie pour provoquer une turbulence qui va la déséquilibrer puis revient vers elle pour l'engamer en ouvrant largement la gueule, créant ainsi un appel d'eau qui aspirera la victime."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49768a9d-50ba-4c83-a35d-2ba0b7681cae",
                        "source_entry_id": "503ff519-5d72-3c59-980d-d2c76e378d4e",
                        "source_sense_description": "caractère agité",
                        "target_lang_word": "骚乱",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "bee81f8b-abb1-4a12-a7c5-7b0aaff97641",
                        "source_entry_id": "503ff519-5d72-3c59-980d-d2c76e378d4e",
                        "source_sense_description": "état tourbillonnaire d'un fluide",
                        "target_lang_word": "Turbulenz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Turbulenz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5d420282-7a3a-3f08-b54c-1847690f8ecd",
                                        "entry_id": "89dbf9b8-fc3d-395d-9c32-934a7c6dd81a",
                                        "glosses": [
                                            "die turbulente Entwicklung von etwas"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "516137d5-a6a0-4d0e-a348-183f5c5e7572",
                                                "sense_id": "5d420282-7a3a-3f08-b54c-1847690f8ecd",
                                                "text": "Wegen der gestrigen Kursschwankung an der Börse entstand bei den Aktionären jede Menge Turbulenz."
                                            },
                                            {
                                                "example_id": "3a34bd9c-8b7e-462c-b70e-eaad3717be82",
                                                "sense_id": "5d420282-7a3a-3f08-b54c-1847690f8ecd",
                                                "text": "„Nach den Turbulenzen auf den Kapitalmärkten warnt Linkenchefin Janine Wissler vor dem Vorhaben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ba5720db-434d-3ba3-ab77-d646c43354ad",
                                        "entry_id": "89dbf9b8-fc3d-395d-9c32-934a7c6dd81a",
                                        "glosses": [
                                            "ungeordnete Luftverwirbelung, hervorgerufen durch Wetter, Wolken oder Luftfahrzeuge"
                                        ],
                                        "tags": [
                                            "Luftfahrt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49e473c9-a98e-48bc-aa40-a89fe3a78086",
                                                "sense_id": "ba5720db-434d-3ba3-ab77-d646c43354ad",
                                                "text": "Durch das Aufeinandertreffen von Kalt-, und Warmluft in den Wolken entstehen Luftverwirbelungen auch Turbulenzen genannt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "271195b5-682f-3c79-8ae6-ca79ac5ae7e8",
                                        "entry_id": "89dbf9b8-fc3d-395d-9c32-934a7c6dd81a",
                                        "glosses": [
                                            "Wirbelbildung in sich bewegenden/strömenden Flüssigkeiten oder Gasen"
                                        ],
                                        "tags": [
                                            "Strömungslehre"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdb560f1-0c90-42e9-893c-47158ef57456",
                                                "sense_id": "271195b5-682f-3c79-8ae6-ca79ac5ae7e8",
                                                "text": "Ein Hurrikan entwickelt extrem große Turbulenzen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71e18bf6-b3f4-4193-884c-4efc36ad8858",
                        "source_entry_id": "503ff519-5d72-3c59-980d-d2c76e378d4e",
                        "source_sense_description": "état tourbillonnaire d'un fluide",
                        "target_lang_word": "turbulence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "turbulence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9177deb6-b454-323e-9225-8236a9ab77f9",
                                        "entry_id": "099d069a-503f-3b35-b894-5489452db528",
                                        "glosses": [
                                            "The state or fact of being turbulent or agitated; tempestuousness, disturbance."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88c33367-eddf-4846-abcc-b778f7483845",
                                                "sense_id": "9177deb6-b454-323e-9225-8236a9ab77f9",
                                                "text": "Turbulence was everywhere, within every blade of grass, every drop of dew on a leaf, every cloud in the sky, and every star beyond. The turbulence was purposeless, but in huge quantities of purposeless turbulence, purpose took shape."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b411fc7-2db6-3e1a-8241-ecb42a8a612e",
                                        "entry_id": "099d069a-503f-3b35-b894-5489452db528",
                                        "glosses": [
                                            "Disturbance in a gas or fluid, characterized by evidence of internal motion or unrest."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "86270554-3c19-38aa-922e-5578da474454",
                                        "entry_id": "099d069a-503f-3b35-b894-5489452db528",
                                        "glosses": [
                                            "Specifically, a state of agitation or disturbance in the air which is disruptive to an aircraft."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7e239cda-15ed-3826-9248-c55e882ae8bf",
                                        "entry_id": "099d069a-503f-3b35-b894-5489452db528",
                                        "glosses": [
                                            "An instance or type of such state or disturbance."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbc9ec71-e361-4d0c-89b2-2506fb108427",
                                                "sense_id": "7e239cda-15ed-3826-9248-c55e882ae8bf",
                                                "text": "In a brief and abashed Tory conference speech, Kwarteng admitted it had been a “tough day” – hours after rowing back on the tax cut for high earners. He said his economic plan had caused “a little turbulence”."
                                            }
                                        ]
                                    }
