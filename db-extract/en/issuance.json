                                    {
                                        "sense_id": "3fdbd1b0-b600-3587-8d08-3798515e9c89",
                                        "entry_id": "7318973c-595c-381e-91c6-a07508ff80ec",
                                        "glosses": [
                                            "příčestí trpné množného čísla mužského životného rodu slovesa vystavit"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78ba456b-ab0b-449f-8575-957d1c0dfa79",
                                                "sense_id": "3fdbd1b0-b600-3587-8d08-3798515e9c89",
                                                "text": "Britská policie se domnívá, že bývalý dvojí agent Sergej Skripal a jeho dcera byli poprvé vystaveni nervové látce právě u vchodových dveří jejich domu."
