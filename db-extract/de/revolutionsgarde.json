                    {
                        "form_id": "961eb88f-7705-4dcb-a09d-f623940948a9",
                        "entry_id": "80d850f6-5485-34e6-ba5c-43dcafb4f5bb",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Revolutionsgarden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e0c709df-b54e-362c-9dbf-772755112ede",
                        "entry_id": "80d850f6-5485-34e6-ba5c-43dcafb4f5bb",
                        "glosses": [
                            "(para)militärische Einheit mit revolutionären Zielen"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "d6b9a172-4c34-4c31-9f4e-651a9c4c474f",
                                "sense_id": "e0c709df-b54e-362c-9dbf-772755112ede",
                                "text": "„Die iranischen Revolutionsgarden, die für den Abschuss der Drohne verantwortlich sind, spielen eine zentrale Rolle in der Außenpolitik Teherans und haben auch erheblichen Einfluss im Innern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bce91db6-b72e-3d16-9d38-c64a025ef0f0",
                        "entry_id": "80d850f6-5485-34e6-ba5c-43dcafb4f5bb",
                        "glosses": [
                            "paramilitärische Einheit im Iran"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "d4eb9e43-9c44-4f5f-9519-cc05c12a6c6c",
                                "sense_id": "bce91db6-b72e-3d16-9d38-c64a025ef0f0",
                                "text": "„Die iranischen Revolutionsgarden, die für den Abschuss der Drohne verantwortlich sind, spielen eine zentrale Rolle in der Außenpolitik Teherans und haben auch erheblichen Einfluss im Innern.“"
                            },
                            {
                                "example_id": "218334c1-106a-49cd-b495-5928bfb212ac",
                                "sense_id": "bce91db6-b72e-3d16-9d38-c64a025ef0f0",
                                "text": "„›Aus meiner Sicht ist es notwendig, dass die EU die Revolutionsgarden auf die Terrorliste setzt‹, sagte Generalsekretär Bijan Djir-Sarai. Er verwies dabei auch auf die aktuellen Hinrichtungen in dem Land.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "f56ba174-fb26-3e45-bcbd-0967f4da6dda",
                        "entry_id": "80d850f6-5485-34e6-ba5c-43dcafb4f5bb",
                        "glosses": [
                            "militärische Einheit in Libyen"
                        ],
                        "tags": [
                            "historical",
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "7e7b709d-a80c-43ea-a945-c76cffb43bcb",
                                "sense_id": "f56ba174-fb26-3e45-bcbd-0967f4da6dda",
                                "text": "„Die Revolutionsgarden in Libyen sind der Sicherheitspolizei der DDR nicht unähnlich.“"
                            },
                            {
                                "example_id": "b0e43bc1-060b-4d2d-a891-9bf203fdaed1",
                                "sense_id": "f56ba174-fb26-3e45-bcbd-0967f4da6dda",
                                "text": "„Mansur Dao ist ehemaliger Kommandeur der libyschen Revolutionsgarde und ein Cousin Gaddafis.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
