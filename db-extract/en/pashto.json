                    {
                        "translation_id": "d859e90e-9c70-4ee0-b186-d1d6770a4326",
                        "source_entry_id": "0c43eb8a-4568-3216-a039-efc72e21edf8",
                        "source_sense_id": "7bea453e-f2bc-3d34-a196-33a3e63d09a6",
                        "source_sense_description": "official language of Afghanistan and Khyber Pakhtunkhwa, Pakistan",
                        "target_lang_word": "Paschtu",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Paschtu",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b76dd8b-1fbc-3786-a24a-4f8ba005e250",
                                        "entry_id": "6407a1d6-24a2-3210-ab2e-acf5e4651ee1",
                                        "glosses": [
                                            "eine der Amtssprachen Afghanistans"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77090595-2035-4ad3-b36e-9a90984afebd",
                                                "sense_id": "2b76dd8b-1fbc-3786-a24a-4f8ba005e250",
                                                "text": "Paschtu wird in arabischer Schrift geschrieben und besitzt ein eigenes Alphabet."
                                            },
                                            {
                                                "example_id": "a02fdb3e-bcb9-4943-b774-7f38efc46bab",
                                                "sense_id": "2b76dd8b-1fbc-3786-a24a-4f8ba005e250",
                                                "text": "„Zudem wird bemängelt, dass er nur auf Paschtu - neben Dari eine der beiden offiziellen Sprachen des Landes - verfasst ist.“"
                                            },
                                            {
                                                "example_id": "71861765-2319-4aed-be2a-9cfdf660c16c",
                                                "sense_id": "2b76dd8b-1fbc-3786-a24a-4f8ba005e250",
                                                "text": "„Die wichtigsten und am weitesten verbreiteten Sprachen sind zum einen die lingua franca Dari, die afghanische Variante des Persischen, zum anderen Paschtu, die Sprache der Paschtunen.“"
                                            },
                                            {
                                                "example_id": "ac7e2f86-6e30-4109-b599-365198f90ded",
                                                "sense_id": "2b76dd8b-1fbc-3786-a24a-4f8ba005e250",
                                                "text": "„Er sprach natürlich Paschtu, die Sprache der Afghanen, und konnte mir unterwegs Unterricht erteilen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7feac787-04a6-4a50-a8f5-ccec2640d904",
                        "source_entry_id": "0c43eb8a-4568-3216-a039-efc72e21edf8",
                        "source_sense_id": "7bea453e-f2bc-3d34-a196-33a3e63d09a6",
                        "source_sense_description": "official language of Afghanistan and Khyber Pakhtunkhwa, Pakistan",
                        "target_lang_word": "Paschto",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Paschto",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01e1bd35-af3b-3b12-9035-5f299666bccf",
                                        "entry_id": "3c7f7c9c-2282-3594-a14e-df7d95280688",
                                        "glosses": [
                                            "eine der Amtssprachen Afghanistans"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bed7e7b2-d1d7-4349-92ee-8befd9379683",
                                                "sense_id": "01e1bd35-af3b-3b12-9035-5f299666bccf",
                                                "text": "„Einem anderen Argument zufolge sei der Vertrag damals nur auf Englisch und nicht auch auf Persisch oder Paschto abgefasst worden, was den internationalen völkerrechtlichen Standards nicht entspreche.“"
                                            },
                                            {
                                                "example_id": "f0668f87-79d1-43dd-bdc2-478b4d8483ed",
                                                "sense_id": "01e1bd35-af3b-3b12-9035-5f299666bccf",
                                                "text": "„Von deren Kindern kannten nur noch wenige ihre Muttersprache – sie waren froh, wenn sie Paschto mit einem Akzent lernen konnten, der ihre Herkunft nicht verriet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40d31281-5769-49d7-a257-7626258c9b69",
