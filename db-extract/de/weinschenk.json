                            {
                                "example_id": "1e8cab11-37a1-449f-a0b1-8c83598e2efd",
                                "sense_id": "b05d7a19-a119-3df7-b9e4-5dc6bb3b074a",
                                "text": "„Jeder Wirth oder Weinschenk erhält das Recht, sich beim Ausschenken seiner Getränke eines um 10 % kleineren Maasses zu bedienen, als dass das gesetzliche Maass ist.“"
                            }
