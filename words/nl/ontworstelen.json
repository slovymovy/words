    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7b255973-8363-3c9a-9b14-4a2c39e89f9c",
                    "sense_definition": "zich met veel moeite of strijd bevrijden van een greep, situatie of invloed",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bevrijden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij nam enige seconden de tijd om zich aan haar invloed te <w>ontworstelen</w>.",
                            "target_lang_translations": {
                                "de": "Er nahm sich einige Sekunden Zeit, um sich ihrem Einfluss zu <w>entwinden</w>."
                            }
                        },
                        {
                            "text": "Het jonge land probeerde zich aan de greep van de bezetter te <w>ontworstelen</w>.",
                            "target_lang_translations": {
                                "de": "Das junge Land versuchte, sich dem Griff des Besatzers zu <w>entreißen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontkomen",
                        "vrijkomen"
                    ],
                    "antonyms": [
                        "bezwijken"
                    ],
                    "common_phrases": [
                        "zich aan de greep ontworstelen",
                        "zich ontworstelen aan"
                    ],
                    "target_lang_definitions": {
                        "de": "sich unter großer Anstrengung oder Kampf aus einem Griff, einer Situation oder einem Einfluss befreien"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "sich entwinden",
                                "target_lang_sense_clarification": "sich aus einem Griff oder Einfluss befreien"
                            },
                            {
                                "target_lang_word": "sich entreißen",
                                "target_lang_sense_clarification": "sich gewaltsam oder mit Mühe befreien"
                            },
                            {
                                "target_lang_word": "sich frei ringen",
                                "target_lang_sense_clarification": "durch Ringen die Freiheit erlangen"
                            },
                            {
                                "target_lang_word": "sich befreien",
                                "target_lang_sense_clarification": "allgemein aus einer Zwangslage entkommen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8308bec-7093-3e55-874a-f4cdfc6448f7",
                    "sense_definition": "door zware inspanning of strijd aan iets of iemand afdwingen of ontnemen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ontnemen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat hij nodig had, <w>ontworstelde</w> hij met veel moeite aan de harde grond.",
                            "target_lang_translations": {
                                "de": "Was er brauchte, <w>rang</w> er dem harten Boden mit viel Mühe <w>ab</w>."
                            }
                        },
                        {
                            "text": "De rebellen <w>ontworstelden</w> de machtige generaal uiteindelijk de overwinning.",
                            "target_lang_translations": {
                                "de": "Die Rebellen <w>rissen</w> dem mächtigen General schließlich den Sieg <w>ab</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "afpersen",
                        "ontfutselen",
                        "ontnemen"
                    ],
                    "common_phrases": [
                        "aan de grond ontworstelen"
                    ],
                    "target_lang_definitions": {
                        "de": "durch schwere Mühen oder Kampf jemandem oder etwas abringen oder entreißen"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "abringen",
                                "target_lang_sense_clarification": "durch Mühe oder Kampf erlangen"
                            },
                            {
                                "target_lang_word": "entreißen",
                                "target_lang_sense_clarification": "gewaltsam wegnehmen"
                            },
                            {
                                "target_lang_word": "abkämpfen",
                                "target_lang_sense_clarification": "im Kampf abgewinnen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
