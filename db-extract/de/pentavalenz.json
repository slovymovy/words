                "senses": [
                    {
                        "sense_id": "94912e6a-6fcd-32cd-9bbb-1848cded45a3",
                        "entry_id": "766b60b7-deb6-3904-b74e-9e2b20e7e987",
                        "glosses": [
                            "Eigenschaft, mit fünf anderen Atomen eine chemische Bindung eingehen zu können"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "45e23435-e7c3-48c5-a507-7e3140f613b3",
                                "sense_id": "94912e6a-6fcd-32cd-9bbb-1848cded45a3",
                                "text": "„Funktionell besitzt das IgM-Molekül eine Pentavalenz, jede seiner Untereinheiten (7 S IgM) ist jedoch monomer.“"
                            },
                            {
                                "example_id": "760bb253-0da5-4651-aaf9-1731763199b1",
                                "sense_id": "94912e6a-6fcd-32cd-9bbb-1848cded45a3",
                                "text": "„Zweitens sind Verbindungen beobachtet worden, welche auf eine mögliche Steigerung der Pentavalenz der Elemente der Stickstoffgruppe bis auf Heptavalenz deuten.“"
                            },
                            {
                                "example_id": "58e2dcd5-b03e-44c9-a268-6ee51de8ea7d",
                                "sense_id": "94912e6a-6fcd-32cd-9bbb-1848cded45a3",
                                "text": "„Antimon verbindet sich mit Chlor und mit Fluor in zwei der Trivalenz und Pentavalenz des Antimons entsprechenden Verhältnissen, mit den übrigen Halogenen nur in einem Verhältniss, der Trivalenz des Antimons entsprechend.“"
                            },
                            {
                                "example_id": "6cce3506-72f1-4e0d-8d18-639a17cacf10",
                                "sense_id": "94912e6a-6fcd-32cd-9bbb-1848cded45a3",
                                "text": "„Das Didympentoxyd, welches als Beweis für die Pentavalenz des Didyms angeführt ist, ist ein Oxyd des Wasserstoff hyperoxydtypus.“"
                            },
                            {
                                "example_id": "9b2157fc-0ea7-485b-94e9-d252725edd5a",
                                "sense_id": "94912e6a-6fcd-32cd-9bbb-1848cded45a3",
                                "text": "„Wir sehen bier sehr deutlich, in welcher Weise man aus der Pentavalenz des Arsens die scheinbare Trivalenz erklären kann.“"
                            },
                            {
                                "example_id": "c8c0f7af-67d3-40a6-b4f6-45fb91b6b956",
                                "sense_id": "94912e6a-6fcd-32cd-9bbb-1848cded45a3",
                                "text": "„Eine solche Verbindung sei für das Bor in dem Boroxytrichlorid von Councler vermeintlicher Weise aufgefunden worden, welche die Pentavalenz des Bors erweisen soll.“"
                            },
                            {
                                "example_id": "ca263f29-ba41-45ad-a459-38d39f7e17c3",
                                "sense_id": "94912e6a-6fcd-32cd-9bbb-1848cded45a3",
                                "text": "„Die Pentavalenz dos Stickstoffs, Phosphors, Arsens und Antimons wird wohl von keinem Chemiker mehr erusthaft bestritten, eben sowenig die Tetravalonz des Tellurs.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
