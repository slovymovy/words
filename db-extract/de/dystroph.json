                ],
                "senses": [
                    {
                        "sense_id": "9085a223-d6df-30bf-9180-f43c63773fd0",
                        "entry_id": "5a46cc5e-fc7b-367a-8690-18597c8facd1",
                        "glosses": [
                            "auf Dystrophie beruhend, Dystrophie hervorrufend, durch Dystrophie verursacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c18f65d1-b816-4e8b-a463-265fdfd91362",
                                "sense_id": "9085a223-d6df-30bf-9180-f43c63773fd0",
                                "text": "„In Deutschland gibt es etwa 600 Patienten mit einer dystrophen Form der Epidermolysis bullosa.“"
                            },
                            {
                                "example_id": "b3886148-d38a-4c12-b1e0-785c14bce54a",
                                "sense_id": "9085a223-d6df-30bf-9180-f43c63773fd0",
                                "text": "„Durch Messungen an 33 dystrophen Kindern im Jahre 1985 an der Universitäts-Frauenklinik Kiel stellten wir fest, daß das Wachstum des Femur und des Humerus weniger verzögert ist als das des Kopfes und des Thorax.“"
                            },
                            {
                                "example_id": "177716c1-9ffd-4912-a70a-c7f75799b884",
                                "sense_id": "9085a223-d6df-30bf-9180-f43c63773fd0",
                                "text": "„Der Resistanceindex der uterinen Arterien erlaubt mit einer Sensitivität von 64% und einer Spezifität von 84% die Risikoerkennung einer dystrophen Fetalentwicklung (Tabelle 22).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "db7eec27-ecf5-318a-9ffa-f7db729c482c",
                        "entry_id": "5a46cc5e-fc7b-367a-8690-18597c8facd1",
                        "glosses": [
                            "(als See) arm an Sauerstoff und reich an Säure"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63d92402-5767-4f81-a3ef-05b982558738",
                                "sense_id": "db7eec27-ecf5-318a-9ffa-f7db729c482c",
                                "text": "„In der Hydrobiologie bezeichnen wir Gewässer, die Humusstoffe enthalten und braune Farbe zeigen, als dystroph oder moorig.“"
                            },
                            {
                                "example_id": "8b3dc64f-0af0-40cc-9777-91e22d64d9ff",
                                "sense_id": "db7eec27-ecf5-318a-9ffa-f7db729c482c",
                                "text": "„Die Heidegewässer im umfassenden Sinn sind durchaus nicht einheitlich: Sie sind nur: zum Teil oligotroph, ein nicht geringer Teil. ist als mesotroph, ein anderer als dystroph zu bezeichnen […].“"
                            }
                        ],
