                {
                    "sense_id": "1fef59b4-a296-3ce5-999a-0fe1b7866d8f",
                    "sense_definition": "Tour malicieux ou plaisanterie faite pour faire rire aux dépens de quelqu'un.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "plaisanterie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants aiment faire une <w>farce</w> à leur professeur le premier avril.",
                            "target_lang_translations": {
                                "en": "Children love playing a <w>prank</w> on their teacher on April Fools' Day.",
                                "ru": "Дети любят устроить своему учителю <w>розыгрыш</w> первого апреля.",
                                "de": "Kinder lieben es, ihrem Lehrer am 1. April einen <w>Streich</w> zu spielen.",
                                "es": "A los niños les encanta gastarle una <w>broma</w> a su profesor el primero de abril.",
                                "zh": "孩子们喜欢在四月一日这天对老师搞个<w>恶作剧</w>。"
                            }
                        },
                        {
                            "text": "Il a acheté des coussins péteurs dans un magasin de <w>farces</w> et attrapes.",
                            "target_lang_translations": {
                                "en": "He bought whoopee cushions from a <w>joke</w> shop.",
                                "ru": "Он купил в магазине <w>приколов</w> подушки, издающие пукающие звуки.",
                                "de": "Er hat Furzkissen in einem Laden für <w>Scherzartikel</w> gekauft.",
                                "es": "Compró cojines de pedos en una tienda de <w>bromas</w> y trucos.",
                                "zh": "他在一家专卖<w>恶作剧</w>道具的商店里买了几个放屁坐垫。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blague",
                        "plaisanterie",
                        "tour"
                    ],
                    "common_phrases": [
                        "faire une farce",
                        "farces et attrapes"
                    ],
                    "target_lang_definitions": {
                        "en": "A mischievous trick or joke played on someone to make others laugh at their expense.",
                        "ru": "Озорная проделка или шутка, устроенная над кем-либо ради смеха окружающих.",
                        "de": "Ein harmloser, oft witziger Streich, mit dem man jemanden zum Narren hält und andere zum Lachen bringt.",
                        "es": "Engaño o travesura hecha para divertir a otros a costa de alguien.",
                        "zh": "为了戏弄某人、博人一笑而耍的小花招或玩笑。"
                    },
                    "translations": {
