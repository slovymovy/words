                    {
                        "form_id": "787bbe55-36d9-4a2a-a24f-d9896a7d8413",
                        "entry_id": "74df6e0d-b3e4-315f-8d5c-3d80a65b36be",
                        "tags": [
                            "past"
                        ],
                        "form": "amated"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "80a38745-c4f1-3e62-8450-e7a2ff58e3bc",
                        "entry_id": "74df6e0d-b3e4-315f-8d5c-3d80a65b36be",
                        "glosses": [
                            "To dishearten, dismay."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "6935c86c-6109-476c-a769-fd76347da8b3",
                                "sense_id": "80a38745-c4f1-3e62-8450-e7a2ff58e3bc",
                                "text": "Shall I accuse the hidden cruell fate, / And mightie causes wrought in heauen aboue, / Or the blind God, that doth me thus amate, / For hoped loue to winne me certaine hate?"
                            },
                            {
                                "example_id": "1fe05e4b-bb67-45ac-967b-a8357b0cebe0",
                                "sense_id": "80a38745-c4f1-3e62-8450-e7a2ff58e3bc",
                                "text": "Upon the walls the pagans old and young / Stood hush'd and still, amated and amazed."
                            },
                            {
                                "example_id": "3388bc6d-f3c2-43a9-8905-2a7061fcb6e3",
                                "sense_id": "80a38745-c4f1-3e62-8450-e7a2ff58e3bc",
                                "text": "The Silures, to amate the new general, rumoured the overthrow greater than was true."
                            },
                            {
                                "example_id": "08685f3e-167e-4ca2-984a-d712fb0a0344",
                                "sense_id": "80a38745-c4f1-3e62-8450-e7a2ff58e3bc",
                                "text": "For the last […], he will be much amazed, he will be much amated."
                            },
                            {
                                "example_id": "f1614443-4eff-4ba0-9c50-e45c9e2e5f3e",
                                "sense_id": "80a38745-c4f1-3e62-8450-e7a2ff58e3bc",
                                "text": "Thou didst die / A half-blown flow'ret which cold blasts amate."
                            }
                        ]
                    }
                ],
