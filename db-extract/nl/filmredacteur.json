                        "examples": [
                            {
                                "example_id": "84ed4b08-17c0-48fa-9538-69322761529b",
                                "sense_id": "a5f11cb9-7a9d-37c9-b450-2d19a6951b93",
                                "text": "Volgens Noa Johannes, filmredacteur bij NPO3, die de film trouwens 'Marvelicious' noemt, is het succes van de film te danken aan meerdere aspecten. Maar is één aspect toch wel het belangrijkst: de identificatie met de acteurs. \"De superhelden komen heel dicht bij de mensen. Hoewel het superhelden zijn, hebben ze veel menselijke trekjes.\""
                            },
                            {
                                "example_id": "4a51a8b4-e26e-4806-b8e0-2cd048ff35b2",
                                "sense_id": "a5f11cb9-7a9d-37c9-b450-2d19a6951b93",
                                "text": "Jan Blokker begon zijn journalistieke loopbaan in 1952 als leerling-verslaggever bij Het Parool. Daarna ging hij aan de slag als filmredacteur bij het Algemeen Handelsblad. Vanaf 1967 werkte hij voor de Volkskrant waar hij tussen 1979 en 1985 adjunct-hoofdredacteur was. Daarvoor was hij tien jaar eindredacteur televisie bij de VPRO."
                            }
                        ]
                    }
