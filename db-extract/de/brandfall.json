                "senses": [
                    {
                        "sense_id": "3e169bcd-91ba-3165-b652-23eb039aefa1",
                        "entry_id": "2a7b2810-57da-3265-b916-ff71f597c909",
                        "glosses": [
                            "Situation, in der ein Feuer ausgebrochen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd3d2a7a-fc77-450b-9df2-efcbda792a64",
                                "sense_id": "3e169bcd-91ba-3165-b652-23eb039aefa1",
                                "text": "„Sehen Sie sich beim Betreten des Gebäudes die Fluchtwege an, damit Sie diese im Brandfall schnell und sicher finden!“"
                            },
                            {
                                "example_id": "516c188a-fd07-4f29-98d9-77836fc94d4c",
                                "sense_id": "3e169bcd-91ba-3165-b652-23eb039aefa1",
                                "text": "„Warnen Sie Ihre Mitarbeiter und sonstige Personen und bedenken Sie, dass Festnetztelefone im Brandfall außer Betrieb sein könnten. “"
                            },
                            {
                                "example_id": "3d087128-a310-4f64-8034-27da5f6f94dc",
                                "sense_id": "3e169bcd-91ba-3165-b652-23eb039aefa1",
                                "text": "„Die Entrauchung des Gebäudes übernimmt ein Entrauchungsventilator mit einer Förderleistung von 33.000m³/h, welcher im Brandfall automatisch über die Brandmeldeanlage angesteuert wird.“"
                            },
                            {
                                "example_id": "90df094f-46a7-4343-8085-91ed9ebfaecc",
                                "sense_id": "3e169bcd-91ba-3165-b652-23eb039aefa1",
                                "text": "„In der Brandschutzordnung sind die Verhaltensregeln zur Brandverhütung, die organisatorischen Maßnahmen des vorbeugenden Brandschutzes und die Verhaltensregeln im Brandfall festzulegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
