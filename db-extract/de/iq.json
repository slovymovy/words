                                "example_id": "7e122736-b2ec-4076-978f-a73a9708837d",
                                "sense_id": "9a0838fc-3e83-3475-9d3b-92c0ef5a554c",
                                "text": "Dein IQ ist sehr hoch."
                            },
                            {
                                "example_id": "3e55b97c-04ce-45d3-97c4-1de10d6d8ad1",
                                "sense_id": "9a0838fc-3e83-3475-9d3b-92c0ef5a554c",
                                "text": "„Man braucht nämlich einen IQ von mindestens hundertdreißig, um sich in dem Labyrinth von Gebäude zurechtzufinden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
