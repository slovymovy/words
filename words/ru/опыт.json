{
    "word_family": [
        "опытный",
        "опытность"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0b605619-4d23-35be-b304-bca178340f32",
                    "sense_definition": "Совокупность знаний и практических навыков, приобретённых в течение жизни или профессиональной деятельности.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "knowledge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У этого врача огромный <w>опыт</w> лечения сложных заболеваний.",
                            "target_lang_translations": {
                                "en": "This doctor has huge <w>experience</w> in treating complex diseases.",
                                "zh": "这位医生在治疗复杂疾病方面有丰富的<w>经验</w>。"
                            }
                        },
                        {
                            "text": "Без <w>опыта</w> работы молодому специалисту трудно найти хорошее место.",
                            "target_lang_translations": {
                                "en": "Without work <w>experience</w>, it is difficult for a young specialist to find a good position.",
                                "zh": "没有工作<w>经验</w>，年轻的专业人士很难找到好职位。"
                            }
                        }
                    ],
                    "synonyms": [
                        "навык",
                        "практика",
                        "мастерство",
                        "стаж"
                    ],
                    "antonyms": [
                        "неопытность",
                        "безопытность",
                        "неискушённость"
                    ],
                    "common_phrases": [
                        "опыт работы",
                        "жизненный опыт",
                        "обмен опытом",
                        "многолетний опыт",
                        "горький опыт"
                    ],
                    "target_lang_definitions": {
                        "en": "Knowledge or skill acquired over a period of time through practice or work.",
                        "zh": "通过实践或工作在一段时间内获得的知识或技能。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "experience",
                                "target_lang_sense_clarification": "accumulated knowledge/skill"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "经验",
                                "target_lang_sense_clarification": "积累的知识或技能"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "222a5ec7-736f-3713-89d2-116592da65f0",
                    "sense_definition": "Научное воспроизведение какого-либо явления с целью его исследования; эксперимент.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На уроке химии учитель показал нам интересный <w>опыт</w> с реактивами.",
                            "target_lang_translations": {
                                "en": "In chemistry class, the teacher showed us an interesting <w>experiment</w> with reagents.",
                                "zh": "在化学课上，老师给我们演示了一个有趣的化学<w>实验</w>。"
                            }
                        },
                        {
                            "text": "Учёные проводят сложный <w>опыт</w> для проверки новой теории.",
                            "target_lang_translations": {
                                "en": "Scientists are conducting a complex <w>experiment</w> to test a new theory.",
                                "zh": "科学家们正在进行一项复杂的<w>实验</w>来验证新理论。"
                            }
                        }
                    ],
                    "synonyms": [
                        "эксперимент",
                        "испытание",
                        "проверка"
                    ],
                    "common_phrases": [
                        "проводить опыт",
                        "ставить опыт",
                        "химический опыт",
                        "научный опыт"
                    ],
                    "target_lang_definitions": {
                        "en": "A scientific procedure undertaken to make a discovery, test a hypothesis, or demonstrate a known fact.",
                        "zh": "为进行研究、检验假设或演示已知事实而进行的科学程序。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "experiment",
                                "target_lang_sense_clarification": "scientific test"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "实验",
                                "target_lang_sense_clarification": "科学测试"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6df76f6d-8e35-3947-a92e-23eafb457d28",
                    "sense_definition": "Важное событие или переживание, которое человек испытал в своей жизни.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "knowledge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Поездка в горы стала для нас незабываемым <w>опытом</w>.",
                            "target_lang_translations": {
                                "en": "The trip to the mountains became an unforgettable <w>experience</w> for us.",
                                "zh": "这次山地之旅对我们来说是一次难忘的<w>经历</w>。"
                            }
                        },
                        {
                            "text": "Это был полезный <w>опыт</w>, который научил меня быть осторожнее.",
                            "target_lang_translations": {
                                "en": "It was a useful <w>experience</w> that taught me to be more careful.",
                                "zh": "这是一次有益的<w>经历</w>，它教会了我更加谨慎。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "личный опыт",
                        "уникальный опыт",
                        "негативный опыт"
                    ],
                    "target_lang_definitions": {
                        "en": "Something that happens to you that affects how you feel; an event or occurrence.",
                        "zh": "发生在个人身上并影响其感受的事件或经历。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "experience",
                                "target_lang_sense_clarification": "event or occurrence"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "经历",
                                "target_lang_sense_clarification": "个人遭遇或事件"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}