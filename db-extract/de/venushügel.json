                        "cross_references": [
                            {
                                "target_word": "mons pubis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d77a5b1-1ab1-332f-a191-fdfda085f92a",
                                        "entry_id": "6742aae7-faff-3b4b-9095-1fee4234589c",
                                        "glosses": [
                                            "A fleshy protuberance over the pubic bones that becomes covered with hair during puberty."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "778a23a4-a3c9-4380-91de-0c9c8d0e687f",
                        "source_entry_id": "c8964ed5-e61f-38e8-917a-8fb007dcb8f2",
                        "source_sense_id": "dbc0cc59-03b2-320e-98db-ee57503981fe",
                        "source_sense_description": "leichte Erhebung über dem weiblichen Schambein",
                        "target_lang_word": "mont de Vénus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mont de Vénus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2760f80b-e452-3f5f-b6ea-43fae113cf03",
                                        "entry_id": "c9e05f09-0f12-3cf9-86eb-62cd7eaac61a",
                                        "glosses": [
                                            "Bas-ventre de la femme qui se couvre de poils au moment de la puberté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23770226-77fe-4af6-bac9-3fc05aab07a7",
                                                "sense_id": "2760f80b-e452-3f5f-b6ea-43fae113cf03",
                                                "text": "À diverses reprises, je stimulai mon imagination à l’aide d’une photographie de la prestigieuse Écossaise, où elle était représentée en une longue tunique pailletée lui moulant tout le corps, y compris le mont de Vénus, et lui laissant un bras, une épaule et une aisselle entièrement dénudés."
                                            },
                                            {
                                                "example_id": "b78fb44e-354d-4999-a27b-908c8624112d",
                                                "sense_id": "2760f80b-e452-3f5f-b6ea-43fae113cf03",
                                                "text": "Qui est-ce qui veut me laisser faire, in naturalibus,\nUn petit peu d’alpinisme sur son mont de Vénus ?"
                                            },
                                            {
                                                "example_id": "ee7dbea0-78fe-493a-8e85-acda48b7f060",
                                                "sense_id": "2760f80b-e452-3f5f-b6ea-43fae113cf03",
                                                "text": "Alpiniste débutant, j’escaladais son mont de Vénus par la face ombragée. Je foulais par la pensée une cambrousse dense et ébouriffée aux reflets plutôt roux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ddf7018a-b668-3f3f-afb5-8810a951cf57",
                                        "entry_id": "c9e05f09-0f12-3cf9-86eb-62cd7eaac61a",
                                        "glosses": [
                                            "Partie charnue de la main située sous le pouce."
                                        ],
                                        "tags": [
                                            "Chiromancie"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
