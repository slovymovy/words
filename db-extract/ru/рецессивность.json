                                    {
                                        "sense_id": "3b326962-71b9-3161-b34c-a708577e45e8",
                                        "entry_id": "c6a155c3-bb10-3437-bece-18438420ae6f",
                                        "glosses": [
                                            "tendenza di un carattere ereditario a restare latente in un individuo eterozigote per tale carattere, e ad essere mascherato nel fenotipo dal carattere dominante determinato dall’altro allele"
                                        ],
