                                "target_senses": [
                                    {
                                        "sense_id": "a24168f7-e94c-398c-b565-50dbd844a5bf",
                                        "entry_id": "465cb75f-e859-3d39-98f5-ca7400afc7cf",
                                        "glosses": [
                                            "The action of the verb to smile."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4249eed-10fc-46c1-89d9-3c743574c55c",
                                                "sense_id": "a24168f7-e94c-398c-b565-50dbd844a5bf",
                                                "text": "Smiling takes fewer muscles than frowning."
                                            },
                                            {
                                                "example_id": "7641c417-9e8a-4e91-935a-8ade8abe0295",
                                                "sense_id": "a24168f7-e94c-398c-b565-50dbd844a5bf",
                                                "text": "We […] shall ascend to our Father's home of holiness, to enjoy perpetually the smilings of his face […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "smiling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a76ae51d-96bd-3d79-96d4-2808391c2d36",
                                        "entry_id": "dabe6838-7a7c-330d-be5b-3bba63a979d9",
                                        "glosses": [
                                            "present participle and gerund of smile"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "338080a8-d486-4a78-b8c5-04300f31b99e",
                                                "sense_id": "a76ae51d-96bd-3d79-96d4-2808391c2d36",
                                                "text": "They were smiling at the children."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "smiling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a562342b-1c54-3da7-a1a5-ed942d4725ec",
                                        "entry_id": "f5fc173a-a99f-3247-9106-f6b455f07fc2",
                                        "glosses": [
                                            "That smiles or has a smile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5f571bb-dbed-401e-9e83-d266cbbb94ce",
                                                "sense_id": "a562342b-1c54-3da7-a1a5-ed942d4725ec",
                                                "text": "smiling children"
                                            },
                                            {
                                                "example_id": "f168a540-10bb-4034-a48e-54ea8c8d9add",
                                                "sense_id": "a562342b-1c54-3da7-a1a5-ed942d4725ec",
                                                "text": "Serene, smiling, enigmatic, she faced him with no fear whatever showing in her dark eyes. The clear light of the bright autumn morning had no terrors for youth and health like hers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
