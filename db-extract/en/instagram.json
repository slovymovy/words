                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "666cc0ae-5c7a-4971-9805-a02735b71c5e",
                        "entry_id": "5c3e29e9-ff12-3f60-ad08-dd828eea219f",
                        "tags": [
                            "plural"
                        ],
                        "form": "Instagrams"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a6a180c9-2aa4-3bcf-8b57-ba95b31bc30f",
                        "entry_id": "5c3e29e9-ff12-3f60-ad08-dd828eea219f",
                        "glosses": [
                            "A user's profile or account on this service."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc9b3b1b-9398-4688-9b81-ca06751c1f81",
                                "sense_id": "a6a180c9-2aa4-3bcf-8b57-ba95b31bc30f",
                                "text": "Have you seen her Instagram lately?"
                            },
                            {
                                "example_id": "c62ee718-9b80-4c89-b912-71411e4dbedf",
                                "sense_id": "a6a180c9-2aa4-3bcf-8b57-ba95b31bc30f",
                                "text": "She's been blowing up my Instagram!"
                            }
                        ]
                    },
                    {
                        "sense_id": "43a3560a-39ed-3913-945c-86d232cb2e5c",
                        "entry_id": "5c3e29e9-ff12-3f60-ad08-dd828eea219f",
                        "glosses": [
                            "A photograph or video shared on this service."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "191f6659-90d3-4971-bd42-14480f1e8309",
                                "sense_id": "43a3560a-39ed-3913-945c-86d232cb2e5c",
                                "text": "I saw one of her Instagrams last week, but I haven't talked to her since then."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "96a2b8c8-a15b-344e-aed8-c3d1a67c4e85",
                "word": "Instagram",
                "pos": "verb",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d37dd857-0b24-4c62-805d-732f1e8a4e7e",
