                    "frequency": "Low",
                    "semantic_group_id": "phonetics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Native speakers frequently <w>elide</w> unstressed vowels when speaking quickly in informal situations."
                        },
                        {
                            "text": "In casual English conversation, speakers often <w>elide</w> the final consonant sound of certain words."
                        }
                    ],
                    "common_phrases": [
