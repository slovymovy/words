                        "examples": [
                            {
                                "example_id": "fdf21ed7-91d9-452e-bd55-7ecce0d1f820",
                                "sense_id": "1480be57-cefe-3ae4-8a1a-b67d613711c1",
                                "text": "\"Do, papa, come into my new bed-room!\" she exclaimed, \"it is such a delightful one; I like it much better than the cabin, it is so large, and has such a curious window, but it has no tables or chairs, or washhand stand; and when I awoke this morning, I could not think where I was, and I called out, ' Nurse, nurse, where am I, and why is the ship not moving, and how curious the cabin has grown, and where is my washhand stand?'"
                            },
                            {
                                "example_id": "218a15cd-d32d-444e-9291-4f3b2ee4388f",
                                "sense_id": "1480be57-cefe-3ae4-8a1a-b67d613711c1",
                                "text": "If, on rising in the morning, the reader perceives that the water in his washhand ewer has frozen, he may rest assured that the heat with which the ice was combined as water, has departed, and is playing its part elsewhere."
                            },
                            {
                                "example_id": "68c61548-fcd0-4c5d-8035-64b9c4d1c2c1",
                                "sense_id": "1480be57-cefe-3ae4-8a1a-b67d613711c1",
                                "text": "Was the washhand basin opposite the door"
                            },
                            {
                                "example_id": "87c2ec4d-d011-4752-95a4-fb32e845dcd0",
                                "sense_id": "1480be57-cefe-3ae4-8a1a-b67d613711c1",
                                "text": "I listened; and this was what he said:\" If you put your hand into your washhand jug , you will find a key that will unlock your door."
                            },
                            {
                                "example_id": "fdb77de4-c3b3-46c9-a13c-bfa421ad78c3",
                                "sense_id": "1480be57-cefe-3ae4-8a1a-b67d613711c1",
                                "text": "Maria visited one of the cubicles, and used a wash-hand sink, before eventually rejoining her guide to inform him she would be lunching in the hotel's restaurant overlooking Central Park."
                            }
                        ]
                    }
