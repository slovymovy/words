                    "sense_definition": "A girl or an unmarried young woman.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight swore to protect the fair <w>maid</w> from all danger.",
                            "target_lang_translations": {
                                "ru": "Рыцарь поклялся защищать прекрасную <w>деву</w> от любой опасности.",
                                "zh": "骑士发誓要保护那位美丽的<w>少女</w>免受一切危险。"
                            }
                        },
                        {
                            "text": "She was chosen to be the <w>maid</w> of honor at her sister's wedding.",
                            "target_lang_translations": {
                                "ru": "Её выбрали <w>подружкой</w> невесты на свадьбе сестры.",
