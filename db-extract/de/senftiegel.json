                "senses": [
                    {
                        "sense_id": "b310deab-352d-3837-b20b-c9650af9bd96",
                        "entry_id": "69898069-57bf-31f6-9477-d0b1f267bba1",
                        "glosses": [
                            "kleines Behältnis zur Aufbewahrung und zum Servieren von Senf"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "907cad9b-6352-49ca-8394-b3e33deb9384",
                                "sense_id": "b310deab-352d-3837-b20b-c9650af9bd96",
                                "text": "„Einen Senftiegel aus Holz, in einem kleinen Silbergestell, natürlich englisches Erzeugnis, man kann das sofort sehen.“"
                            },
                            {
                                "example_id": "68bd66f5-10b5-4bc0-8fa0-d000b20aac77",
                                "sense_id": "b310deab-352d-3837-b20b-c9650af9bd96",
                                "text": "„Sowohl gewöhnlicher als Kräuter- oder Sardellen-Senf wird im Senftiegel oder einer Senfschale mit Deckel und Glaslöffel, besonders bei frischem Schweinfleische und Rindsbraten, auf den Tisch gegeben.“"
                            },
                            {
                                "example_id": "64785864-7c45-4bc9-be00-6c4d207b96c1",
                                "sense_id": "b310deab-352d-3837-b20b-c9650af9bd96",
                                "text": "„Er zog am Morgen einen langen, schwarzen Rock an, blickte düster, ließ den Senftiegel in Ruhe und grüßte mich kaum.“"
                            },
                            {
                                "example_id": "04d76fb7-5571-457b-8e14-e67c35bd4644",
                                "sense_id": "b310deab-352d-3837-b20b-c9650af9bd96",
                                "text": "„Nachdenklich marschiert er in die Küche, haut zwei Paar Frankfurter ins Wasser, stellt den Senftiegel auf den Tisch und sucht nach dem Gebäck vom Vortag.“"
                            },
                            {
                                "example_id": "daaa1280-5576-4dcb-bf20-752257523aed",
                                "sense_id": "b310deab-352d-3837-b20b-c9650af9bd96",
                                "text": "„Wir fanden, daß Senftiegel, aus denen im Laufe von zwei Monaten täglich Senf genommen wurde, nach Ablauf dieser Zeit denselben Geschmack besaßen wie am Anfange ihrer Eröffnung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ebc168a-a311-49d2-bdf9-58f7faf66cd4",
