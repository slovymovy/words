                    {
                        "sense_id": "4c94b268-f78c-3fb1-8728-4ad6c0a3a920",
                        "entry_id": "227806ed-a66f-3205-997d-a25f10f7e1d0",
                        "glosses": [
                            "sytuacja, w której liczba ludności przekracza znacząco pojemność środowiska"
