{
    "word_family": [
        "rock"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "74db49da-d9be-370a-a3e0-006e045188f1",
                    "sense_definition": "A fundamental principle or foundation upon which something is built.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "foundation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Trust is the <w>bedrock</w> of any healthy relationship.",
                            "target_lang_translations": {
                                "ru": "Доверие — это <w>основа</w> любых здоровых отношений."
                            }
                        },
                        {
                            "text": "These values form the <w>bedrock</w> of our company culture.",
                            "target_lang_translations": {
                                "ru": "Эти ценности составляют <w>фундамент</w> нашей корпоративной культуры."
                            }
                        }
                    ],
                    "synonyms": [
                        "foundation",
                        "basis",
                        "cornerstone"
                    ],
                    "common_phrases": [
                        "bedrock of society",
                        "bedrock of democracy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Фундаментальный принцип или основа, на которой что-либо строится."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "основа",
                                "target_lang_sense_clarification": "фундаментальная база или принцип"
                            },
                            {
                                "target_lang_word": "фундамент",
                                "target_lang_sense_clarification": "переносное значение, основа чего-либо"
                            },
                            {
                                "target_lang_word": "краеугольный камень",
                                "target_lang_sense_clarification": "основополагающий элемент"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3d56441-fbb8-39cb-b790-7627158fefb3",
                    "sense_definition": "The solid rock layer located beneath the soil and loose surface materials.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The builders had to dig deep to reach the <w>bedrock</w> for the foundation.",
                            "target_lang_translations": {
                                "ru": "Строителям пришлось копать глубоко, чтобы добраться до <w>коренной породы</w> для фундамента."
                            }
                        },
                        {
                            "text": "The river eroded the soil until the <w>bedrock</w> was visible.",
                            "target_lang_translations": {
                                "ru": "Река размыла почву, пока не обнажилась <w>коренная порода</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Слой твердой горной породы, залегающий под почвой и рыхлыми поверхностными отложениями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коренная порода",
                                "target_lang_sense_clarification": "геологический термин для обозначения твердого основания"
                            },
                            {
                                "target_lang_word": "подстилающая порода",
                                "target_lang_sense_clarification": "геологический слой, лежащий в основании"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3723395b-c591-3a00-b5fd-0a7f274eb14a",
                    "sense_definition": "The skeletal structure of a body.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient <w>bedrock</w> of the creature was preserved in the mud.",
                            "target_lang_translations": {
                                "ru": "Древний <w>остов</w> существа сохранился в иле."
                            }
                        },
                        {
                            "text": "He felt the <w>bedrock</w> of his frame ache after the long hike.",
                            "target_lang_translations": {
                                "ru": "После долгого похода он чувствовал, как ноет весь его <w>скелет</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "skeleton",
                        "bones"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in a poetic or literary sense to refer to bones."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Скелетная структура тела (используется в поэтическом или литературном смысле)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скелет",
                                "target_lang_sense_clarification": "анатомическая основа тела"
                            },
                            {
                                "target_lang_word": "остов",
                                "target_lang_sense_clarification": "литературное обозначение каркаса или скелета"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2200f446-c17b-348b-8f1f-9be104315261",
                    "sense_definition": "To set or establish something firmly upon a solid foundation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "foundation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new policy was <w>bedrocked</w> in years of careful research.",
                            "target_lang_translations": {
                                "ru": "Новая политика была <w>основана</w> на годах тщательных исследований."
                            }
                        },
                        {
                            "text": "Their friendship is <w>bedrocked</w> in mutual respect and shared history.",
                            "target_lang_translations": {
                                "ru": "Их дружба <w>базируется</w> на взаимном уважении и общей истории."
                            }
                        }
                    ],
                    "synonyms": [
                        "ground",
                        "base",
                        "establish"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устанавливать или основывать что-либо прочно на твердом фундаменте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "основывать",
                                "target_lang_sense_clarification": "создавать на прочной базе"
                            },
                            {
                                "target_lang_word": "базировать",
                                "target_lang_sense_clarification": "опирать на что-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}