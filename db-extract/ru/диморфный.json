                                    {
                                        "sense_id": "35396748-a6bb-3472-8c87-947602223ac4",
                                        "entry_id": "a1b47f6d-5753-3bb1-ae06-f9f1b3a3d07b",
                                        "glosses": [
                                            "Qui peut prendre deux formes différentes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "322b34f0-86d4-424b-94dc-6df076451589",
                                                "sense_id": "35396748-a6bb-3472-8c87-947602223ac4",
                                                "text": "Cette espèce dimorphe signalée par ROUY (…) dans les « lacs ou mares des Vosges, mais paraissant y être toujours stérile » se rencontre en divers points de notre dition : étang Pellevin, étang des Gouttes."
                                            },
                                            {
                                                "example_id": "e7adb387-77b7-4089-94e3-975abd234b8c",
                                                "sense_id": "35396748-a6bb-3472-8c87-947602223ac4",
                                                "text": "Les abeilles femelles sont dimorphes : la reine et les ouvrières."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "852146ef-f686-391b-93ee-c37d85659266",
                                        "entry_id": "a1b47f6d-5753-3bb1-ae06-f9f1b3a3d07b",
                                        "glosses": [
                                            "Qui peut cristalliser sous deux états différents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a987c14-3e4b-4ba3-98a4-abd39e8c3060",
                                                "sense_id": "852146ef-f686-391b-93ee-c37d85659266",
                                                "text": "Le soufre est un corps dimorphe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dimorphe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4320efd5-db43-3575-a1b2-c650766c8458",
                                        "entry_id": "59d3efa7-5fb4-3fba-b918-af308b62576f",
                                        "glosses": [
                                            "Minéral ayant la même composition chimique mais qui cristallise de façon différente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2adb368-ed62-41fe-8d90-683f39cec189",
                                                "sense_id": "4320efd5-db43-3575-a1b2-c650766c8458",
                                                "text": "La cavansite est un dimorphe de la pentagonite. Ces deux minéraux ont la même composition chimique mais cristallisent avec des structures différentes."
                                            },
                                            {
                                                "example_id": "32fa5466-0a3f-40fe-85c8-12e978f5ace8",
                                                "sense_id": "4320efd5-db43-3575-a1b2-c650766c8458",
                                                "text": "A ces trois espèces de biarséniures se rattachent les minéraux les plus connus du groupe et les plus répandus dans la nature ; puis un dimorphe monoclinique de la safflorite , la clinosafflorite CoAs,…."
                                            }
                                        ]
                                    }
