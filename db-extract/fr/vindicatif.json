                                        "glosses": [
                                            "Vindictive or wanting vengeance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbad329b-b539-4afd-baf8-828d2024c666",
                                                "sense_id": "6873939d-85ac-3050-8cef-bee32edc1e2d",
                                                "text": "His chains now broken, the prisoner turned a vengeful eye toward his former captors."
                                            },
                                            {
                                                "example_id": "cb0d0b30-ee2e-4898-87c1-1f8825d42370",
                                                "sense_id": "6873939d-85ac-3050-8cef-bee32edc1e2d",
                                                "text": "A vengeful mother-of-three has been jailed for 168 days after being convicted of killing a neighbour's kitten by microwaving the 10-week-old pet."
