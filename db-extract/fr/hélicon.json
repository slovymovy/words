                "entry_id": "7f8cd44c-e74f-3c16-8069-6c7e4cea192c",
                "word": "Hélicon",
                "pos": "name",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7cdec5fb-f8d1-4a35-9a6e-e71f95160015",
