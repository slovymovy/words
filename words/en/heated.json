    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a3d72eaa-08bf-33c5-b84b-89c5dbfb84be",
                    "sense_definition": "Made warm or hot by some means.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "temperature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to swim in the <w>heated</w> pool despite the cold weather.",
                            "target_lang_translations": {
                                "ru": "Мы решили поплавать в бассейне <w>с подогревом</w>, несмотря на холодную погоду.",
                                "zh": "尽管天气寒冷，我们还是决定去那个<w>有加热功能的</w>游泳池游泳。"
                            }
                        },
                        {
                            "text": "The bathroom has <w>heated</w> floors that feel nice in the morning.",
                            "target_lang_translations": {
                                "ru": "В ванной комнате полы <w>с подогревом</w>, по которым приятно ходить по утрам.",
                                "zh": "浴室里有<w>供暖的</w>地板，早晨踩上去感觉很舒服。"
                            }
                        }
                    ],
                    "synonyms": [
                        "warmed"
                    ],
                    "antonyms": [
                        "unheated"
                    ],
                    "common_phrases": [
                        "heated pool",
                        "heated seats",
                        "heated room",
                        "heated towel rail"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный теплым или горячим искусственным путем; имеющий систему отопления или подогрева.",
                        "zh": "通过某种方式使变暖或变热的；具有加热系统的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "с подогревом",
                                "target_lang_sense_clarification": "о бассейне, полах, сиденьях"
                            },
                            {
                                "target_lang_word": "отапливаемый",
                                "target_lang_sense_clarification": "о помещении"
                            },
                            {
                                "target_lang_word": "нагретый",
                                "target_lang_sense_clarification": "общий смысл"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有加热功能的",
                                "target_lang_sense_clarification": "指设备或设施自带加热系统"
                            },
                            {
                                "target_lang_word": "供暖的",
                                "target_lang_sense_clarification": "指房间或空间有供暖设施"
                            },
                            {
                                "target_lang_word": "加热过的",
                                "target_lang_sense_clarification": "指物体被加热的状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbf76bc3-6bae-3ffd-a6dc-e7c8e828847d",
                    "sense_definition": "Very agitated, angry, or impassioned.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They had a <w>heated</w> argument about politics during dinner.",
                            "target_lang_translations": {
                                "ru": "За ужином у них возник <w>горячий</w> спор о политике.",
                                "zh": "晚饭时，他们就政治问题进行了一场<w>激烈的</w>争论。"
                            }
                        },
                        {
                            "text": "The council meeting turned into a <w>heated</w> discussion regarding the budget.",
                            "target_lang_translations": {
                                "ru": "Заседание совета переросло в <w>бурную</w> дискуссию по поводу бюджета.",
                                "zh": "理事会会议演变成了一场关于预算的<w>激烈</w>讨论。"
                            }
                        }
                    ],
                    "synonyms": [
                        "intense",
                        "passionate",
                        "fiery",
                        "angry"
                    ],
                    "common_phrases": [
                        "heated argument",
                        "heated discussion",
                        "heated debate",
                        "heated exchange"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень эмоциональный, напряженный, гневный или страстный (обычно о споре или дискуссии).",
                        "zh": "非常激动、愤怒或充满激情的（通常指争论或讨论）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горячий",
                                "target_lang_sense_clarification": "о споре"
                            },
                            {
                                "target_lang_word": "бурный",
                                "target_lang_sense_clarification": "о дискуссии, обсуждении"
                            },
                            {
                                "target_lang_word": "накалённый",
                                "target_lang_sense_clarification": "об атмосфере"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "激烈的",
                                "target_lang_sense_clarification": "指争论或讨论非常紧张"
                            },
                            {
                                "target_lang_word": "火药味十足的",
                                "target_lang_sense_clarification": "形容气氛紧张、充满冲突"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7d27c0a6-5b4d-35cd-a0da-740b3da4c897",
                    "sense_definition": "Simple past and past participle of <w>heat</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>heated</w> the soup in the microwave for two minutes.",
                            "target_lang_translations": {
                                "ru": "Она <w>разогрела</w> суп в микроволновке в течение двух минут.",
                                "zh": "她用微波炉把汤<w>热</w>了两分钟。"
                            }
                        },
                        {
                            "text": "The sun <w>heated</w> the pavement until it was too hot to touch.",
                            "target_lang_translations": {
                                "ru": "Солнце <w>нагрело</w> асфальт так, что до него невозможно было дотронуться.",
                                "zh": "太阳把人行道<w>晒热</w>了，烫得没法碰。"
                            }
                        }
