                ],
                "senses": [
                    {
                        "sense_id": "adf6c4c4-5931-3c82-a509-b56ea8d6e23a",
                        "entry_id": "d261d23d-5ce7-357f-ae13-a575a6398608",
                        "glosses": [
                            "van een ruimte dat je er moeilijk kunt ademhalen, dat het er stinkt en er geen frisse lucht is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c435546b-1ad0-400c-9696-88782b2a76f3",
                                "sense_id": "adf6c4c4-5931-3c82-a509-b56ea8d6e23a",
                                "text": "Het is een klein, bedompt café waar affiches hangen van een experimentele theatergroep die het etablissement frequenteerde in de periode 1980-1985."
                            },
                            {
                                "example_id": "95f4fc42-1f55-45d7-b538-e72433b3b624",
                                "sense_id": "adf6c4c4-5931-3c82-a509-b56ea8d6e23a",
                                "text": "Sociëteit is een groot woord voor de twee bedompte zaaltjes op de begane grond van het gezamenlijke verenigingsgebouw. Uitbreiden is geen optie, want ernaast zit de Bikini, een studentendiscotheek die wordt uitgebaat door het RSC, dat ook de hele bovenverdieping bezet."
                            },
                            {
                                "example_id": "d49a082f-58d8-477e-b624-41017ef76db3",
                                "sense_id": "adf6c4c4-5931-3c82-a509-b56ea8d6e23a",
                                "text": "De geruststellende geur van in hout getrokken tabaksrook deed denken aan coffeeshop Rainblow City in de vroege ochtend, haar toevluchtsoord voor als ze geen burgers stond te grillen in de bedompte keuken van Hbibs snackbar."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7585b8c1-4ccd-461b-8dc3-85a583379bee",
                        "source_entry_id": "d261d23d-5ce7-357f-ae13-a575a6398608",
                        "source_sense_id": "adf6c4c4-5931-3c82-a509-b56ea8d6e23a",
                        "source_sense_description": "van een ruimte dat je er moeilijk kunt ademhalen, dat het er stinkt en er geen frisse lucht is",
                        "target_lang_word": "airless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "airless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e73ef64d-cc65-3bcb-b003-93298c6f62b5",
                                        "entry_id": "69caa1a9-3de5-3f47-a0c3-e49217151a9b",
                                        "glosses": [
                                            "Lacking or being without air."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "54e85dd4-2307-315c-8236-437fcdb4bbc6",
                                        "entry_id": "69caa1a9-3de5-3f47-a0c3-e49217151a9b",
                                        "glosses": [
                                            "Lacking air circulation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "288afef7-ce80-4180-b58a-dccfdc877bff",
                                                "sense_id": "54e85dd4-2307-315c-8236-437fcdb4bbc6",
                                                "text": "[…] St. Bede's at this period of its history was perhaps the poorest and most miserable parish in the East End of London. Close-packed, crushed by the buttressed height of the railway viaduct, rendered airless by huge walls of factories, it at once banished lively interest from a stranger's mind and left only a dull oppression of the spirit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2894c1ea-f597-3169-8815-4a795e9af6e7",
                                        "entry_id": "69caa1a9-3de5-3f47-a0c3-e49217151a9b",
                                        "glosses": [
                                            "With air that is stale."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "89aafd11-65f8-3872-8e53-a893eb7e87a7",
                                        "entry_id": "69caa1a9-3de5-3f47-a0c3-e49217151a9b",
                                        "glosses": [
                                            "Suffering from asphyxia."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b6432f82-5321-33b8-91c3-286592b44d56",
                                        "entry_id": "69caa1a9-3de5-3f47-a0c3-e49217151a9b",
                                        "glosses": [
                                            "Stifling; dead; lacking vitality or excitement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a32c0bab-9f7b-4df2-8787-b75ecba742a2",
                                                "sense_id": "b6432f82-5321-33b8-91c3-286592b44d56",
                                                "text": "The worst that can—and has—been said about Memento is that it’s an airless gimmick, visually undistinguished, and not even all that sophisticated when the puzzle pieces are finally put together."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5cb2760-e374-4a94-a62f-1f0a62d01822",
                        "source_entry_id": "d261d23d-5ce7-357f-ae13-a575a6398608",
                        "source_sense_id": "adf6c4c4-5931-3c82-a509-b56ea8d6e23a",
                        "source_sense_description": "van een ruimte dat je er moeilijk kunt ademhalen, dat het er stinkt en er geen frisse lucht is",
                        "target_lang_word": "stuffy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stuffy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc335dc0-bf33-3541-ac47-c3d680109def",
                                        "entry_id": "79f5dcc8-4bc9-37c6-8859-4162c99825ec",
                                        "glosses": [
                                            "Poorly ventilated; partially plugged."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d1ce4fc-9f04-4b7f-ad83-ac335feb04c1",
                                                "sense_id": "bc335dc0-bf33-3541-ac47-c3d680109def",
                                                "text": "I can’t smell very well today – I have a stuffy nose."
                                            },
                                            {
                                                "example_id": "97c7aa81-6447-41a2-aff3-bac192ec718c",
                                                "sense_id": "bc335dc0-bf33-3541-ac47-c3d680109def",
                                                "text": "Let’s go outside – it’s getting stuffy in here."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36e3e627-d318-373a-875e-f1a662c4535c",
                                        "entry_id": "79f5dcc8-4bc9-37c6-8859-4162c99825ec",
                                        "glosses": [
                                            "Uncomfortably warm without sufficient air circulation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65ddaf56-e743-4dc8-9f17-6d0265139fd3",
                                                "sense_id": "36e3e627-d318-373a-875e-f1a662c4535c",
                                                "text": "Abby Jimenez\nLike my life was a stuffy room, and you’re the breeze that came in when the window opened."
                                            },
                                            {
                                                "example_id": "82ad9ba1-d640-4707-9d08-f7f05b0cf885",
                                                "sense_id": "36e3e627-d318-373a-875e-f1a662c4535c",
                                                "text": "If Euston is not typically English, St. Pancras is. Its façade is a nightmare of improbable Gothic. It is fairly plastered with the aesthetic ideals of 1868, and the only beautiful thing about it is Barlow's roof. It is haunted by the stuffier kind of ghost. Yet there is something about the ordered whole of St. Pancras that would make demolition a terrible pity."
                                            },
                                            {
                                                "example_id": "bb8d14bd-9d15-4c98-93a3-5a12ad195059",
                                                "sense_id": "36e3e627-d318-373a-875e-f1a662c4535c",
                                                "text": "We all sat in stuffy classrooms and had men in tweedy sportscoats ruin our afternoons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0eeeb640-a837-37a8-8490-d06f908d0f8a",
                                        "entry_id": "79f5dcc8-4bc9-37c6-8859-4162c99825ec",
                                        "glosses": [
                                            "Stout; mettlesome; resolute."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "132d2eae-96b8-3d7a-8c33-6e4bbc9dc696",
                                        "entry_id": "79f5dcc8-4bc9-37c6-8859-4162c99825ec",
                                        "glosses": [
                                            "Angry and obstinate; sulky."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c3dd590c-f7f3-3eb3-934c-4fb028561a93",
                                        "entry_id": "79f5dcc8-4bc9-37c6-8859-4162c99825ec",
                                        "glosses": [
                                            "Boring, old-fashioned, uninteresting, over-formal, pompous, very conventional."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8375e05-1959-48da-9613-00654aa5e272",
                                                "sense_id": "c3dd590c-f7f3-3eb3-934c-4fb028561a93",
                                                "text": "The stuffy professor droned on as the class lost interest."
                                            },
                                            {
                                                "example_id": "07828128-ca70-4504-a6ea-63f9f6114145",
                                                "sense_id": "c3dd590c-f7f3-3eb3-934c-4fb028561a93",
                                                "text": "It could be argued that the rise of the socially conscious model reflects a very 2017 archetype: the “woke” young woman, who looks set to define femininity this decade in the same way that the lager-swilling ladette did in the 90s. It is also symptomatic of a broader cultural “awokening” that has reached the stuffiest institutions; even the royal family has recently relaxed its upper lip."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2b63173-1378-386c-baf0-375a8d77cc05",
                                        "entry_id": "79f5dcc8-4bc9-37c6-8859-4162c99825ec",
                                        "glosses": [
                                            "Stout; sturdy."
                                        ],
                                        "tags": [
                                            "Scotland"
                                        ],
                                        "examples": []
                                    }
                                ]
