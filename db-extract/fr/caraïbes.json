            },
            {
                "entry_id": "76184d3f-370b-351a-bb5f-1c8c83e25e10",
                "word": "Caraïbes",
                "pos": "name",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dc0551cb-ee61-4dc5-a275-186ccd843f75",
                        "entry_id": "76184d3f-370b-351a-bb5f-1c8c83e25e10",
                        "tags": [],
                        "form": "Caraïbe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e4c319df-4674-3fc9-9cfe-15d48be43355",
                        "entry_id": "76184d3f-370b-351a-bb5f-1c8c83e25e10",
                        "glosses": [
                            "Région de l’Atlantique Nord constituée de la mer des Caraïbes et des terres et îles adjacentes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a825ccd8-4cae-4720-a89b-37ec6253fcbe",
                                "sense_id": "e4c319df-4674-3fc9-9cfe-15d48be43355",
                                "text": "Le suc d’une certaine plante appelée par les Caraïbes touloula, et par les Français herbes aux flèches, est, dit-on, le seul remède contre les plaies faites par les flèches empoisonnées avec le suc de mancenilier."
                            },
                            {
                                "example_id": "03ad6244-ebf1-4717-96c9-195b44cdadb6",
                                "sense_id": "e4c319df-4674-3fc9-9cfe-15d48be43355",
                                "text": "Ça caille en ce moment. Moi, j’étais en vacances dans les Caraïbes, 30°C à l’ombre... C’est toujours agréable quand on a très chaud de savoir que les autres se les pèlent...On profite mieux."
                            },
                            {
                                "example_id": "a3a136ea-61c5-4c65-b321-fe062d72c0eb",
                                "sense_id": "e4c319df-4674-3fc9-9cfe-15d48be43355",
                                "text": "La rockeuse d’héroïne devient à son tour croqueuse de diamant et s’abîme en des délires successifs, peut-être pour oublier sa condition de Sous-développée, elle l’enfant gâtée des Caraïbes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8cff17c6-5a62-4cb3-a752-4e397f4c910a",
                        "source_entry_id": "76184d3f-370b-351a-bb5f-1c8c83e25e10",
                        "source_sense_id": "e4c319df-4674-3fc9-9cfe-15d48be43355",
                        "target_lang_word": "Karibik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Karibik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "36eecee4-5141-3cf8-9db6-60320f228df4",
                                        "entry_id": "803b247f-f02b-334b-a6e3-011dc699e46a",
                                        "glosses": [
                                            "südöstlicher Teil des Amerikanischen Mittelmeers mit der Inselwelt dieses Meeres"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d368d4b-329d-4c32-8b00-c6832433452b",
                                                "sense_id": "36eecee4-5141-3cf8-9db6-60320f228df4",
                                                "text": "Sie sind auf einer Kreuzfahrt in die Karibik."
                                            },
                                            {
                                                "example_id": "3e805b20-19f7-4231-b624-f98569ea7a25",
                                                "sense_id": "36eecee4-5141-3cf8-9db6-60320f228df4",
                                                "text": "Viele internationale Popstars stammen aus der Karibik."
                                            },
                                            {
                                                "example_id": "c634e37d-411e-4253-b474-ad85f3764f6d",
                                                "sense_id": "36eecee4-5141-3cf8-9db6-60320f228df4",
                                                "text": "„Zuvor waren gut 150 Jahre lang aus den Mutterländern Europas immer neue Gruppen von Abenteurern in die Karibik geströmt.“"
                                            },
                                            {
                                                "example_id": "ae9139e9-ab1f-4595-b392-9e2b8fc3b5c0",
                                                "sense_id": "36eecee4-5141-3cf8-9db6-60320f228df4",
                                                "text": "„Die Urbevölkerung war bereits von den Spaniern vertrieben oder versklavt und in die spanischen Kolonien der Karibik verschleppt worden.“"
                                            },
                                            {
                                                "example_id": "7f8704ff-9922-4706-8427-1fb0c421e459",
                                                "sense_id": "36eecee4-5141-3cf8-9db6-60320f228df4",
                                                "text": "„Doch die Welser waren unerfahren, und andere hatten den Markt in der Karibik bereits unter sich aufgeteilt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
