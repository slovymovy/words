            "pos": "verb",
            "senses": [
                {
                    "sense_id": "14b0845f-13d4-31d2-8b6a-d0db0e3bf98e",
                    "sense_definition": "Reprendre des relations personnelles, sociales ou diplomatiques qui avaient été interrompues.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "relations",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs années de silence, elle souhaite enfin <w>renouer</w> les liens avec sa sœur.",
                            "target_lang_translations": {
                                "en": "After several years of silence, she finally wants to <w>renew</w> ties with her sister.",
                                "ru": "После нескольких лет молчания она наконец хочет <w>восстановить</w> отношения с сестрой.",
                                "de": "Nach mehreren Jahren des Schweigens möchte sie endlich die Verbindung zu ihrer Schwester <w>wiederaufnehmen</w>.",
                                "es": "Después de varios años de silencio, ella por fin quiere <w>retomar</w> los lazos con su hermana.",
                                "zh": "经过好几年的沉默，她终于想和她的姐妹<w>恢复</w>联系。"
                            }
                        },
                        {
                            "text": "Les deux pays ont décidé de <w>renouer</w> le dialogue afin de négocier un accord de paix durable.",
                            "target_lang_translations": {
                                "en": "The two countries have decided to <w>resume</w> dialogue in order to negotiate a lasting peace agreement.",
                                "ru": "Две страны решили <w>возобновить</w> диалог, чтобы договориться о прочном мирном соглашении.",
                                "de": "Die beiden Länder haben beschlossen, den Dialog <w>wiederaufzunehmen</w>, um ein dauerhaftes Friedensabkommen auszuhandeln.",
                                "es": "Los dos países han decidido <w>reanudar</w> el diálogo para negociar un acuerdo de paz duradero.",
                                "zh": "两国决定<w>重启</w>对话，以便谈判一项持久的和平协议。"
                            }
                        }
                    ],
                    "synonyms": [
                        "se réconcilier"
                    ],
                    "antonyms": [
                        "rompre",
                        "se brouiller"
                    ],
                    "common_phrases": [
                        "renouer le contact",
                        "renouer des liens",
                        "renouer le dialogue"
                    ],
                    "target_lang_definitions": {
                        "en": "To resume personal, social or diplomatic relations that had been broken off.",
                        "ru": "Возобновить прерванные личные, общественные или дипломатические отношения.",
                        "de": "Persönliche, gesellschaftliche oder diplomatische Beziehungen wieder aufnehmen, die zuvor abgebrochen waren.",
                        "es": "Volver a entablar relaciones personales, sociales o diplomáticas que se habían interrumpido.",
                        "zh": "重新建立或恢复中断的个人、社会或外交关系。"
                    },
