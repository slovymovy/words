                                "target_lang_sense_clarification": "лишенный света"
                            },
                            {
                                "target_lang_word": "мрачный",
                                "target_lang_sense_clarification": "плохо освещенный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69aafd22-5467-36cd-b220-7cd443c2420b",
                    "sense_definition": "een kleur hebbend die weinig licht terugkaatst; niet licht van kleur",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "kleur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij draagt vandaag een <w>donkere</w> broek en een witte trui.",
                            "target_lang_translations": {
                                "en": "She is wearing <w>dark</w> pants and a white sweater today.",
                                "ru": "Сегодня на ней <w>темные</w> брюки и белый свитер."
                            }
                        },
                        {
                            "text": "De jongen heeft <w>donker</w> haar en bruine ogen.",
                            "target_lang_translations": {
                                "en": "The boy has <w>dark</w> hair and brown eyes.",
                                "ru": "У мальчика <w>темные</w> волосы и карие глаза."
                            }
                        }
                    ],
                    "antonyms": [
                        "licht"
                    ],
                    "common_phrases": [
                        "donker haar",
                        "donkere kleuren"
                    ],
                    "target_lang_definitions": {
                        "en": "having a color that reflects little light; not light in color",
                        "ru": "имеющий цвет, который отражает мало света; не светлый по цвету"
                    },
