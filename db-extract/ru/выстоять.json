                "senses": [
                    {
                        "sense_id": "757f4604-a7e9-312d-a0eb-4ce5d0e2bb67",
                        "entry_id": "b479bb4b-6e3a-3581-8105-199c6db720fb",
                        "glosses": [
                            "to stand (for a long time), to remain standing"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a8cf3b1-06c1-409b-b15d-eed548e9378a",
                                "sense_id": "757f4604-a7e9-312d-a0eb-4ce5d0e2bb67",
                                "text": "Сего́дня мы вы́стояли два часа́ за биле́тами на конце́рт.",
                                "translation": "Today we stood for two hours (to buy) tickets for the concert.",
                                "english": "Today we stood for two hours (to buy) tickets for the concert."
                            }
                        ]
                    },
                    {
                        "sense_id": "6f00daed-799d-30d8-a8e5-34e6f8941589",
                        "entry_id": "b479bb4b-6e3a-3581-8105-199c6db720fb",
                        "glosses": [
                            "to withstand, to bear (difficulty), to resist (an enemy), to survive"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e86c662b-50fd-4794-8b3d-1c61b729122b",
                                "sense_id": "6f00daed-799d-30d8-a8e5-34e6f8941589",
                                "text": "Они́ вы́стояли и победи́ли в э́той войне́.",
                                "translation": "They survived and won in this war.",
                                "english": "They survived and won in this war."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
