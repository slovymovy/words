                },
                {
                    "sense_id": "2b6353a9-1ed5-30f5-ab88-b60727ee741b",
                    "sense_definition": "A placeholder procedure that has the signature of the planned procedure but does not yet implement the intended behavior.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing_and_writing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The developer wrote a temporary <w>stub</w> to test the main program flow.",
                            "target_lang_translations": {
                                "ru": "Разработчик написал временную <w>заглушку</w> для тестирования основного потока программы.",
                                "zh": "开发人员编写了一个临时的<w>桩</w>来测试程序的主流程。"
                            }
                        },
                        {
                            "text": "Even though the <w>stub</w> is a dummy, it allows us to compile the code.",
                            "target_lang_translations": {
                                "ru": "Даже несмотря на то, что эта <w>заглушка</w> пустая, она позволяет нам скомпилировать код.",
                                "zh": "尽管这个<w>存根</w>只是个占位符，但它允许我们编译代码。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "method stub",
                        "code stub"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical jargon in software development"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Временная процедура-заглушка в программировании, которая имеет сигнатуру планируемой функции, но еще не реализует ее поведение.",
                        "zh": "编程中用于测试的临时占位程序，仅有函数签名而无具体实现。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заглушка",
                                "target_lang_sense_clarification": "в коде"
                            },
                            {
                                "target_lang_word": "стаб",
                                "target_lang_sense_clarification": "жаргон программистов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "桩",
                                "target_lang_sense_clarification": "软件测试中的占位代码"
                            },
                            {
                                "target_lang_word": "存根",
                                "target_lang_sense_clarification": "程序接口的临时实现"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3a02c47-7630-3ea2-937c-2a203ed8b8df",
                    "sense_definition": "A row heading in a table (with horizontal reference, whereas a column heading has vertical reference).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "typography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The left column of the table contains the <w>stub</w> for each row.",
                            "target_lang_translations": {
