            "senses": [
                {
                    "sense_id": "2efa2d80-5d7a-3ae0-96ba-762cb18ec77b",
                    "sense_definition": "seinen Weg zu Fuß fortsetzen, besonders nach einer Pause oder Unterbrechung",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fortbewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach einer kurzen Rast am Brunnen <w>gingen</w> die Wanderer zügig <w>weiter</w>."
                        },
                        {
                            "text": "Bitte <w>gehen</w> Sie <w>weiter</w>, da Sie sonst den gesamten Weg versperren."
                        }
                    ],
                    "synonyms": [
                        "fortbewegen",
                        "weiterlaufen"
                    ],
                    "antonyms": [
                        "stehenbleiben"
                    ],
                    "common_phrases": [
                        "einfach weitergehen",
                        "zu Fuß weitergehen"
                    ]
                },
                {
                    "sense_id": "8fa70f93-20b6-366b-b501-204df3c211dc",
                    "sense_definition": "zeitlich fortgesetzt werden, andauern oder sich weiterentwickeln",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verlauf",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Niemand wusste genau, wie die Besprechung nach dem Streit <w>weitergehen</w> sollte."
                        },
                        {
                            "text": "Wenn das so <w>weitergeht</w>, werden wir das Projekt nicht rechtzeitig beenden."
                        }
                    ],
                    "synonyms": [
                        "andauern",
                        "fortbestehen",
                        "fortdauern"
                    ],
                    "antonyms": [
                        "aufhören"
                    ],
                    "common_phrases": [
                        "so weitergehen",
                        "wie geht es weiter"
                    ]
                },
                {
                    "sense_id": "38bae850-f925-3862-bfbd-4df192f40f72",
                    "sense_definition": "ein juristisches Verfahren vor einer nächsthöheren gerichtlichen Instanz fortführen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "recht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach dem Urteil entschied die Verteidigung, bis zum Oberlandesgericht <w>weiterzugehen</w>."
                        },
                        {
                            "text": "Wenn die Gegenseite den Beschluss anficht, werden wir zur nächsten Instanz <w>weitergehen</w>."
                        }
                    ],
                    "common_phrases": [
                        "zur nächsten Instanz weitergehen"
                    ]
                }
            ]
        },
