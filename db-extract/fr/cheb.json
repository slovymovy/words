                "translations": [
                    {
                        "translation_id": "2e38b8a4-6861-4443-afe0-11485b328fcd",
                        "source_entry_id": "bea2c426-f114-3344-b6cb-d4ac60278171",
                        "source_sense_id": "019f6d54-75fa-3897-96a5-b1a14eae14a3",
                        "source_sense_description": "regional (Maghreb): jung",
                        "target_lang_word": "jung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9d016d98-4ab2-3174-8503-227669ab5d6a",
                                        "entry_id": "f2a9fd69-c3d5-37b9-ac78-44d388aa4a26",
                                        "glosses": [
                                            "niedrigen Alters"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f536ba45-04a9-41d9-8a7c-fb2bd79e38d2",
                                                "sense_id": "9d016d98-4ab2-3174-8503-227669ab5d6a",
                                                "text": "Das ist aber ein junger Mensch!"
                                            },
                                            {
                                                "example_id": "e13fbc87-10bc-4426-aeee-df67f0c8e41c",
                                                "sense_id": "9d016d98-4ab2-3174-8503-227669ab5d6a",
                                                "text": "„Die Freud, die wir euch machen könn, / Die wird sich wol befinden: / Jetzund seid ihr ein Maidlein jung, / Bis Jahr geht ihr mit Kinde.“"
                                            },
                                            {
                                                "example_id": "abcfd18d-b6a2-461c-86a8-763a4c282e39",
                                                "sense_id": "9d016d98-4ab2-3174-8503-227669ab5d6a",
                                                "text": "„Die Herzen bebten über die Kühnheit des jungen, schönen, wagemutigen Paares.“"
                                            },
                                            {
                                                "example_id": "079d2fd4-fef9-484c-863d-3d94103058f2",
                                                "sense_id": "9d016d98-4ab2-3174-8503-227669ab5d6a",
                                                "text": "„Dieses den jungen Goethe ergreifende Verlangen, sich in den unendlichen Luftraum zu stürzen und über den schauerlichen Abgründen zu schweben, frei zu werden wie der Adler im Äther, beflügelt und bewegt auch die heutigen Delta- und Gleitschirmpiloten, die dank des opferbereiten Wagemuts Lilienthals und anderer Flugpioniere diesen Traum heute zu realisieren vermögen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aafeb400-80e9-33d1-bd7f-a5aee15679d7",
                                        "entry_id": "f2a9fd69-c3d5-37b9-ac78-44d388aa4a26",
                                        "glosses": [
                                            "in einem frühen Entwicklungsstadium befindlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52b39e80-9f12-4f32-b554-a7d36bb9f20d",
                                                "sense_id": "aafeb400-80e9-33d1-bd7f-a5aee15679d7",
                                                "text": "„Die Herzen bebten über die Kühnheit des jungen, schönen, wagemutigen Paares.“"
                                            },
                                            {
                                                "example_id": "fdfab21e-b3a9-40a4-af0c-8c1d0a40f657",
                                                "sense_id": "aafeb400-80e9-33d1-bd7f-a5aee15679d7",
                                                "text": "„Dieses den jungen Goethe ergreifende Verlangen, sich in den unendlichen Luftraum zu stürzen und über den schauerlichen Abgründen zu schweben, frei zu werden wie der Adler im Äther, beflügelt und bewegt auch die heutigen Delta- und Gleitschirmpiloten, die dank des opferbereiten Wagemuts Lilienthals und anderer Flugpioniere diesen Traum heute zu realisieren vermögen.“"
                                            },
                                            {
                                                "example_id": "277aa6ec-9a26-4685-a1ac-1c65f62dc87d",
                                                "sense_id": "aafeb400-80e9-33d1-bd7f-a5aee15679d7",
                                                "text": "Das ist ein junges Unternehmen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d25d2676-ebc7-3efb-8525-00e9c56b3602",
                                        "entry_id": "f2a9fd69-c3d5-37b9-ac78-44d388aa4a26",
                                        "glosses": [
                                            "zu einer späteren Zeit gehörig (meist Superlativ)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1652ad6c-f1ea-41a1-bd0f-063b8ebdcdcc",
                                                "sense_id": "d25d2676-ebc7-3efb-8525-00e9c56b3602",
                                                "text": "Es sind die jüngsten Ereignisse."
                                            },
                                            {
                                                "example_id": "ac750f1a-6c56-44c6-a81a-14c20c75a8e1",
                                                "sense_id": "d25d2676-ebc7-3efb-8525-00e9c56b3602",
                                                "text": "„Neben dem rechtsextremistischen Gewaltpotenzial gehörten die Abgründe an Häme und Hass inmitten unserer Gesellschaft gegenüber denen, die in unserem Land Verantwortung übernähmen, zu den beklemmenden Erfahrungen der jüngsten Tage, sagte Schäuble.“"
                                            },
                                            {
                                                "example_id": "1551f81c-80a7-4f96-abd1-11b92311458d",
                                                "sense_id": "d25d2676-ebc7-3efb-8525-00e9c56b3602",
                                                "text": "„Venezuela gilt damit als erster Staat in der jüngeren Vergangenheit, der gletscherfrei wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
