                                                "example_id": "dea86cea-66ad-4f22-9dc3-515dcb79a92d",
                                                "sense_id": "c8535b86-f173-3860-b085-5bf12877b45c",
                                                "text": "„Die Leute haben auf Klappstühlen bis zum Morgen vor der Kasse gewartet, um noch eine Karte zu ergattern.“"
                                            },
                                            {
                                                "example_id": "30483658-01fc-417e-b33a-1efa20eee71d",
                                                "sense_id": "c8535b86-f173-3860-b085-5bf12877b45c",
                                                "text": "„Gustav hatte sich einen Klappstuhl mitgebracht, und Renate hatte ihren schicken neuen Bikini an.“"
                                            },
                                            {
                                                "example_id": "117400a5-6bb8-4bfc-981d-5bc936610a15",
                                                "sense_id": "c8535b86-f173-3860-b085-5bf12877b45c",
                                                "text": "„Er sass schweigend am Fuss der Anhöhe auf seinem Klappstuhl, den Kopf gesenkt, die Ellbogen auf den Knien.“"
                                            }
                                        ],
