                "senses": [
                    {
                        "sense_id": "75d5a61b-63e4-31e2-b2c3-44e720e0a637",
                        "entry_id": "21964e2a-77d1-3f7a-9010-de4ee2ac4280",
                        "glosses": [
                            "Que l’on peut écraser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69f8e365-7511-443c-b2a3-c8b39dc328a1",
                                "sense_id": "75d5a61b-63e4-31e2-b2c3-44e720e0a637",
                                "text": "Le champion des Médicis, dans l’accès de sa colère, répliqua par une nouvelle invective, où Philelphe est appelé bouc puant, monstre cornu, boute-feu exécrable et écrasable."
                            },
                            {
                                "example_id": "b0996673-23d0-423c-b07b-880fb28eaecf",
                                "sense_id": "75d5a61b-63e4-31e2-b2c3-44e720e0a637",
                                "text": "La race irlandaise n’est devenue la race la plus écrasée et la plus écrasable de l’Europe, que pour être demeurée pendant des siècles étrangère au maniement du fusil de chasse."
                            },
                            {
                                "example_id": "531b1102-7354-4a2e-ac3d-8d01c3f3df8b",
                                "sense_id": "75d5a61b-63e4-31e2-b2c3-44e720e0a637",
                                "text": "Dans les conditions ci-dessus, si l’on vient à inciser l’enveloppe fibreuse du foie, on remarque que son tissu est mou, onctueux au toucher, facilement écrasable et se réduisant en bouillie sous la pression des doigts."
                            },
                            {
                                "example_id": "5fbd052a-d31d-40cb-be72-ab931096e752",
                                "sense_id": "75d5a61b-63e4-31e2-b2c3-44e720e0a637",
                                "text": "Le Prince téméraire était forcé de se retirer en perdant beaucoup de monde, et notre armée toute vive restait entière pour faire face à l’abominable crapule de Mecklembourg, désormais facilement écrasable."
                            }
                        ]
                    },
                    {
                        "sense_id": "78192b23-00b9-36f1-a0d6-d5481a891745",
                        "entry_id": "21964e2a-77d1-3f7a-9010-de4ee2ac4280",
                        "glosses": [
                            "Flexible, que l’on peut écraser sans trop de dommages et qui reprend sa forme initiale."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "c6360d88-8083-445c-8208-06da547e84be",
                                "sense_id": "78192b23-00b9-36f1-a0d6-d5481a891745",
                                "text": "Des chapeaux écrasables."
                            },
                            {
                                "example_id": "df6160b3-3038-4de2-bc39-1aa9cf503986",
                                "sense_id": "78192b23-00b9-36f1-a0d6-d5481a891745",
                                "text": "L'ISO 8029:2007 spécifie les exigences relatives aux tuyaux d'eau thermoplastiques écrasables."
                            }
                        ]
                    }
