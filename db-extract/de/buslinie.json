                "senses": [
                    {
                        "sense_id": "28f2f250-9691-3322-89ab-da79f9de399a",
                        "entry_id": "9a326322-4434-3ba7-9d2b-10f5dfe567df",
                        "glosses": [
                            "Verkehrsverbindung, die von Bussen bedient wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1808ab81-f1b9-4004-a2db-079049b1f915",
                                "sense_id": "28f2f250-9691-3322-89ab-da79f9de399a",
                                "text": "„Die Buslinie 10 wurde über Schloss- und Löhrrondell und Herz-Jesu-Kirche bis zum Hauptbahnhof geführt, was natürlich gegenüber der ersten Nachkriegssituation eine erhebliche Verbesserung bedeutete.“"
                            },
                            {
                                "example_id": "8554213a-c3d0-4dcc-a76e-7d61a4e5695f",
                                "sense_id": "28f2f250-9691-3322-89ab-da79f9de399a",
                                "text": "„Die Buslinie soll ab 2023 oder 2024 komplett mit Wasserstoffbussen betrieben werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
