                "senses": [
                    {
                        "sense_id": "a4092f53-5413-3e1b-b3fa-28e5f6980ffa",
                        "entry_id": "f136bb6d-28c9-30d1-a299-4c162239a7aa",
                        "glosses": [
                            "Kunstrichtung, die sich durch eine fotorealistische Übersteigerung der Wirklichkeit auszeichnet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b88d9a37-abdf-4a27-a949-b6bfa926fbfc",
                                "sense_id": "a4092f53-5413-3e1b-b3fa-28e5f6980ffa",
                                "text": "„Ihr charakteristischer Stil ist der Hyperrealismus, ein Versuch, all das festzuhalten, was ein Foto kann, und viel mehr - was man unterbewusst über eine Szene weiß und sie nicht offenbart; was das Herz über das Motiv vor den Augen empfindet; wie die Vergangenheit in die Gegenwart reicht und die Zukunft real, aber noch verschleiert darüber schwebt; was jeder Moment auf der Erde bedeuten könnte, sofern er überhaupt eine Bedeutung hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
