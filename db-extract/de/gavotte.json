                        "entry_id": "7b5fb7de-3057-3fc0-8af8-c1535949d8c5",
                        "glosses": [
                            "ursprünglich aus Frankreich stammender Tanz, der mäßig schnell im 2/2- oder 4/4-Takt getanzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c486c535-ee12-460a-9a1a-1c5c4553dca3",
                                "sense_id": "b7fe0e8d-f3c7-3967-8273-1ca7a163f25d",
                                "text": "Heute tanzen wir Gavotte."
                            },
                            {
                                "example_id": "3fba45d0-f579-4cbc-b563-7572290938fc",
                                "sense_id": "b7fe0e8d-f3c7-3967-8273-1ca7a163f25d",
                                "text": "„Sie stimmte eine Gavotte an, die sie während der letzten Monate geübt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
