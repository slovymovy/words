                    }
                ],
                "senses": [
                    {
                        "sense_id": "69fadc47-3fff-3b1c-a3e7-c0af1e307ccb",
                        "entry_id": "2d709c1c-1de0-3730-b8f1-43f93eccacea",
                        "glosses": [
                            "Tal mit einem Fluss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "120752ec-72da-45fe-970c-48366e8a8278",
                                "sense_id": "69fadc47-3fff-3b1c-a3e7-c0af1e307ccb",
                                "text": "„Der Feind, den man von dem gegenüberliegenden Berge aus in der Ferne erkennen konnte, war unten, von der Brücke aus, noch nicht sichtbar, weil der Gesichtskreis unten im Flusstal durch die gegenüberliegende, etwa eine halbe Werst entfernte Anhöhe begrenzt wurde.“"
                            },
                            {
                                "example_id": "3b50101b-f5c0-4280-b52f-8c5c9f03aa8d",
                                "sense_id": "69fadc47-3fff-3b1c-a3e7-c0af1e307ccb",
                                "text": "„Ein weiteres Zentrum früher Siedlungen fand Julio C. Tello 1937 im Flusstal des Sechin in der Nähe der Stadt Sechin in der Provinz Ancash.“"
                            },
                            {
                                "example_id": "7ff595f6-d5a6-4af2-9419-ce20f027030f",
                                "sense_id": "69fadc47-3fff-3b1c-a3e7-c0af1e307ccb",
                                "text": "„Die übrigen 7 Prozent gehören verschiedenen Minderheiten an, die in den Grenzregionen und in den anderen Ökozonen der Flusstäler leben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
