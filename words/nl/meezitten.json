            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f795ef92-3970-3458-a4e7-6f8a6407336e",
                    "sense_definition": "een gunstig verloop hebben of succesvol zijn door geluk",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geluk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het heeft hem de laatste tijd echt niet <w>meegezeten</w> met zijn nieuwe baan.",
                            "target_lang_translations": {
                                "en": "Things really haven't <w>gone his way</w> lately with his new job."
                            }
                        },
                        {
                            "text": "Als alles een beetje <w>meezit</w>, kunnen we volgende week al verhuizen naar ons nieuwe huis.",
                            "target_lang_translations": {
                                "en": "If everything <w>goes well</w>, we can already move into our new house next week."
                            }
                        }
                    ],
                    "synonyms": [
                        "meelopen",
                        "meevallen",
                        "boffen"
                    ],
                    "antonyms": [
                        "tegenzitten"
                    ],
                    "common_phrases": [
                        "als het meezit",
                        "een beetje meezitten"
                    ],
                    "target_lang_definitions": {
                        "en": "to have a favorable outcome or be successful due to good luck"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to go well",
                                "target_lang_sense_clarification": "referring to circumstances or events"
                            },
                            {
                                "target_lang_word": "to be lucky",
                                "target_lang_sense_clarification": "having things go one's way"
                            },
                            {
                                "target_lang_word": "to go one's way",
                                "target_lang_sense_clarification": "when events favor someone"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bbf82dfb-577d-3b7e-9505-8060f324a831",
                    "sense_definition": "gunstiger zijn dan verwacht of onverwachte steun bieden bij het bereiken van een doel",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geluk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De schipper is te laat uitgevaren, maar boft dat de weersomstandigheden hem <w>meezitten</w>.",
                            "target_lang_translations": {
                                "en": "The skipper set sail too late, but is lucky that the weather conditions <w>are in his favor</w>."
                            }
                        },
                        {
                            "text": "Tijdens de wedstrijd bleek dat de wind ons flink zou <w>meezitten</w> op het laatste stuk.",
                            "target_lang_translations": {
                                "en": "During the race, it turned out that the wind would <w>be on our side</w> significantly on the final stretch."
                            }
                        }
                    ],
                    "synonyms": [
                        "gunstig gezind zijn"
                    ],
                    "antonyms": [
                        "tegenwerken"
                    ],
                    "common_phrases": [
                        "het weer zit mee"
                    ],
                    "target_lang_definitions": {
                        "en": "to be more favorable than expected or provide unexpected support in achieving a goal"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to be in one's favor",
                                "target_lang_sense_clarification": "referring to external conditions like weather"
                            },
                            {
                                "target_lang_word": "to be on one's side",
                                "target_lang_sense_clarification": "referring to luck or conditions"
                            },
                            {
                                "target_lang_word": "to cooperate",
                                "target_lang_sense_clarification": "metaphorically, of circumstances or weather"
                            }
                        ]
                    }
                }
            ]
        }
    ]
