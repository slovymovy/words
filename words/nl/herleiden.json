{
    "word_family": [
        "herleiding",
        "herleidbaar"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1ebf54df-d7bc-3b40-956a-8d1ff0c9c2d8",
                    "sense_definition": "De oorsprong of oorzaak van iets opsporen en daartoe terugvoeren.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "herleiden_oorsprong",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Men kan de oorzaak van dit probleem gemakkelijk <w>herleiden</w> tot een menselijke fout.",
                            "target_lang_translations": {
                                "fr": "On peut facilement <w>ramener</w> la cause de ce problème à une erreur humaine."
                            }
                        },
                        {
                            "text": "De politie probeert het spoor te <w>herleiden</w> tot de oorspronkelijke bron.",
                            "target_lang_translations": {
                                "fr": "La police tente de <w>remonter</w> la piste jusqu'à la source originale."
                            }
                        }
                    ],
                    "synonyms": [
                        "terugvoeren",
                        "traceren"
                    ],
                    "common_phrases": [
                        "herleiden tot"
                    ],
                    "target_lang_definitions": {
                        "fr": "Trouver l'origine ou la cause de quelque chose et y faire remonter."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "ramener",
                                "target_lang_sense_clarification": "à une cause ou une origine"
                            },
                            {
                                "target_lang_word": "tracer",
                                "target_lang_sense_clarification": "suivre la piste jusqu'à l'origine"
                            },
                            {
                                "target_lang_word": "remonter",
                                "target_lang_sense_clarification": "faire remonter à une source"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bea5b99c-90a9-3c42-8176-b4459c81bce8",
                    "sense_definition": "Uit bekende feiten of gegevens een conclusie trekken; afleiden.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "herleiden_redenering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Uit deze cijfers valt een duidelijke trend te <w>herleiden</w>.",
                            "target_lang_translations": {
                                "fr": "On peut <w>déduire</w> une tendance claire de ces chiffres."
                            }
                        },
                        {
                            "text": "Je kunt uit zijn reactie niet zomaar zijn ware bedoelingen <w>herleiden</w>.",
                            "target_lang_translations": {
                                "fr": "On ne peut pas simplement <w>déduire</w> ses véritables intentions de sa réaction."
                            }
                        }
                    ],
                    "synonyms": [
                        "afleiden",
                        "concluderen"
                    ],
                    "common_phrases": [
                        "te herleiden zijn"
                    ],
                    "target_lang_definitions": {
                        "fr": "Tirer une conclusion à partir de faits ou de données connus; déduire."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "déduire",
                                "target_lang_sense_clarification": "tirer une conclusion logicielle"
                            },
                            {
                                "target_lang_word": "déduire",
                                "target_lang_sense_clarification": "conclure d'après des faits"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "973757cb-4a62-30db-b61a-f4de6a00f3c7",
                    "sense_definition": "Iets vereenvoudigen of terugbrengen tot een basissituatie, vorm of getal (bijv. in de wiskunde).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "herleiden_wiskunde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet deze ingewikkelde formule eerst <w>herleiden</w> tot de eenvoudigste vorm.",
                            "target_lang_translations": {
                                "fr": "Tu dois d'abord <w>réduire</w> cette formule complexe à sa forme la plus simple."
                            }
                        },
                        {
                            "text": "De breuk laat zich eenvoudig <w>herleiden</w>.",
                            "target_lang_translations": {
                                "fr": "La fraction se laisse facilement <w>simplifier</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "vereenvoudigen",
                        "terugbrengen"
                    ],
                    "common_phrases": [
                        "herleiden tot een breuk"
                    ],
                    "target_lang_definitions": {
                        "fr": "Simplifier ou réduire quelque chose à une forme, une situation ou un nombre de base (par ex. en mathématiques)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "réduire",
                                "target_lang_sense_clarification": "simplifier une expression mathématique"
                            },
                            {
                                "target_lang_word": "simplifier",
                                "target_lang_sense_clarification": "ramener à une forme plus simple"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}