                                        ]
                                    },
                                    {
                                        "sense_id": "99d606f8-3f4d-335c-9e61-d5a601c76845",
                                        "entry_id": "a25f6fc8-3d08-3750-b793-b083772d0391",
                                        "glosses": [
                                            "The pelvic region of the human body."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5bb22d1-13dc-497a-bfde-2132236eea3b",
                                                "sense_id": "99d606f8-3f4d-335c-9e61-d5a601c76845",
                                                "text": "Elvis was swinging his pelvis around and the ladies were swooning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdd3bc0e-eb43-3092-bae1-5a9d40c8485a",
                                        "entry_id": "a25f6fc8-3d08-3750-b793-b083772d0391",
                                        "glosses": [
                                            "A funnel-shaped cavity, especially such a cavity in the kidney into which urine passes towards the ureter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0060b6e4-2f9a-4162-baea-ee71efddf792",
                                                "sense_id": "bdd3bc0e-eb43-3092-bae1-5a9d40c8485a",
                                                "text": "Near-synonyms: infundibulum, choana, cornu"
                                            },
                                            {
                                                "example_id": "5a21ec40-74ec-49d4-abdf-779514030f7c",
                                                "sense_id": "bdd3bc0e-eb43-3092-bae1-5a9d40c8485a",
