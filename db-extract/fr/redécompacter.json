                "senses": [
                    {
                        "sense_id": "4216c3b5-b241-3e12-8f37-d41a352f776e",
                        "entry_id": "acf12778-5ef8-3faa-ad5c-d247d3f16966",
                        "glosses": [
                            "Décompacter après avoir compacté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96265393-e8d0-41b3-9606-2c47dd32d20b",
                                "sense_id": "4216c3b5-b241-3e12-8f37-d41a352f776e",
                                "text": "Remède : redécompacter l'archive et vérifier que tous les fichiers sont là."
                            },
                            {
                                "example_id": "d94bd53b-7db3-42cf-a42d-49c0d1deeb5b",
                                "sense_id": "4216c3b5-b241-3e12-8f37-d41a352f776e",
                                "text": "Quand j'essaie de redécompacter le fichier.sit résultant, StuffitExpander me répond que ce fichier n'est ni compacté ni codé."
                            },
                            {
                                "example_id": "cde5f23b-e8bf-4578-8c31-64747ea48ce4",
                                "sense_id": "4216c3b5-b241-3e12-8f37-d41a352f776e",
                                "text": "Il est également possible de compacter (PackTime) les deux dates entier long, les soustraire et redécompacter (UnpackTime) le résultat."
                            }
                        ]
                    }
