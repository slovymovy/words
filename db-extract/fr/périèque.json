                    {
                        "sense_id": "87036d38-3ae6-3501-8660-46ce01798e0a",
                        "entry_id": "100c24d2-3e41-3b5b-940b-628674c7e4db",
                        "glosses": [
                            "Habitant de la Grèce qui n’était ni esclave, ni citoyen, qui pouvait exercer n’importe quel métier, s’enrichir, mais ne participait pas à la vie politique de la cité."
                        ],
                        "tags": [
                            "Ancient-Greek"
                        ],
                        "examples": [
                            {
                                "example_id": "3dbfa2c8-b5ff-4bba-b7c7-fafe587fb7ec",
                                "sense_id": "87036d38-3ae6-3501-8660-46ce01798e0a",
                                "text": "Des Théréens et de leurs périèques, il fit une part; une seconde des Péloponésiens et des Crétois; et une troisième de tous les insulaires."
                            }
                        ]
                    }
