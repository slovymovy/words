                    },
                    {
                        "sense_id": "83839470-4d87-3a0f-ac04-0ae41f0c3c12",
                        "entry_id": "27de5edc-3a96-391f-b74c-9cbe53dde4e5",
                        "glosses": [
                            "Personne qui s’occupe de futilités."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "ef81dab6-e00a-4ae5-93b2-55489e6e37a5",
                                "sense_id": "83839470-4d87-3a0f-ac04-0ae41f0c3c12",
                                "text": "J’aime bien ce jeune homme tout franc et tout net et qui promet plus qu’un tas de fanfrelucheurs."
                            },
                            {
                                "example_id": "a39f177f-e9bb-4f91-bd5a-197854e342d5",
                                "sense_id": "83839470-4d87-3a0f-ac04-0ae41f0c3c12",
                                "text": "Fées fainéantes, jouisseuses ! Saint-Nom-la-Bretèche leur carrière, le rebord d’aubépines, des buissons énormes, en pente, les pâquerettes, mousse, glycines, vous voyez ce genre ! Des franfrelucheuses !"
                            }
                        ]
                    }
