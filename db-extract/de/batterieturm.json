                "senses": [
                    {
                        "sense_id": "3818cdad-2b27-3a04-88ee-c3c4b047efc3",
                        "entry_id": "36bbcd78-cba6-3ad4-b8ce-8ed9a85d3f19",
                        "glosses": [
                            "besonders mauerstarker Turm in einer Verteidigungsanlage in dem die Schusswaffen der Batterie lagerten und zusätzlich, zur Verteidigung mit Kanonen bzw. Geschützen ausgestattet war"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfa4b69a-f385-4dfa-9bf0-f76ac6fb9577",
                                "sense_id": "3818cdad-2b27-3a04-88ee-c3c4b047efc3",
                                "text": "„Im 15. Jh. wurde der Batterieturm zur besseren Verteidigung der Südwestflanke der Burg errichtet.“"
                            },
                            {
                                "example_id": "161ca76a-b552-493f-bb5d-6c64b3572707",
                                "sense_id": "3818cdad-2b27-3a04-88ee-c3c4b047efc3",
                                "text": "„Der 45 m hohe Batterieturm stammt aus den Anfängen des 15. Jahrhunderts“"
                            },
                            {
                                "example_id": "9a957964-3250-4c70-b261-3a7e49f5ba93",
                                "sense_id": "3818cdad-2b27-3a04-88ee-c3c4b047efc3",
                                "text": "„Der zweimal vorkragende runde Batterieturm (1518-23), weist querrechteckige Schießscharten mit dahinterliegenden Geschützkammern auf.“"
                            }
                        ],
