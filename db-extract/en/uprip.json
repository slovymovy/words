                "senses": [
                    {
                        "sense_id": "d307a71d-d414-38d4-969c-7b8daa1873fc",
                        "entry_id": "3e731cb7-b4f6-3fd1-b6bb-0aa761981b16",
                        "glosses": [
                            "To rip up; to tear apart."
                        ],
                        "tags": [
                            "obsolete",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "505925bd-0260-42b7-894a-892776dfaa5e",
                                "sense_id": "d307a71d-d414-38d4-969c-7b8daa1873fc",
                                "text": "Occasionally they force their way into a cabin and uprip its contents."
                            },
                            {
                                "example_id": "52352299-be06-4e3a-9b16-c453f32c644f",
                                "sense_id": "d307a71d-d414-38d4-969c-7b8daa1873fc",
                                "text": "Yet, saving Juan, who in manly wise / Withstood the shameful deed, no man was slain; / His bosom was upripped in woeful guise, / And from its habitance his heart was ta'en."
                            },
                            {
                                "example_id": "33a3f6eb-138a-4c60-a0aa-36207f65b3de",
                                "sense_id": "d307a71d-d414-38d4-969c-7b8daa1873fc",
                                "text": "So fresh the stroke and cut and wound of them / Upripped across her mind and gaped and torn / Along her staggered, unrecovered heart."
                            }
                        ]
                    }
                ],
