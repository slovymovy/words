                        "examples": [
                            {
                                "example_id": "6ec5e293-f959-4bc5-9e15-7b43747fcc70",
                                "sense_id": "2074559c-6fdc-368b-991a-a53581900f9b",
                                "text": "„Er verbrachte dann die halbe Zeit des Spaziergangs in den verfallenen Bezirken aus der Kolonialzeit nordwestlich seines Elternhauses, wo der Hügel zu der tieferen Erhebung von Stampers Hill hinabreicht, dessen Getto- und Negerviertel sich um den Platz scharen, wo vor der Revolution die Postkutsche nach Boston abfuhr.“"
                            },
                            {
                                "example_id": "02dc4b55-39b5-4dd8-81da-725dc497e0de",
                                "sense_id": "2074559c-6fdc-368b-991a-a53581900f9b",
                                "text": "„Vettern und Verwandte der Familie Heisteke hatten sich gegen ihn verschworen - zweimal wurde er mit Pistolen und Messern bedroht, dann zog er sich zurück, die Angst im Nacken, als ginge er auf Streife in einem Negerviertel von Los Angeles, hinter sich das Getuschel und die Pfiffe der Oklahoma-Bullen, die dort während der Nachtschicht regierten; grünes College-Würstchen, Niggerschisser, Feigling.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
