                "senses": [
                    {
                        "sense_id": "05ba3ff7-89b4-345c-a586-f00569475a38",
                        "entry_id": "c8a4366f-70dd-3c5c-97e7-19f3f6212719",
                        "glosses": [
                            "jemand, der etwas kenntnisreich genießt, insbesondere gerne gut isst und trinkt"
                        ],
                        "tags": [
                            "Austrian German",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "94bca2c9-f798-4ee3-bc61-f4d91762f2a3",
                                "sense_id": "05ba3ff7-89b4-345c-a586-f00569475a38",
                                "text": "„Zufriedene Gäste in der vollen Gaststube wurden zum Markenzeichen für den Kasbachhof, der jeden Genussspecht zu überzeugen wusste.“"
                            },
                            {
                                "example_id": "bd854798-3795-4232-8f53-559769042cdf",
                                "sense_id": "05ba3ff7-89b4-345c-a586-f00569475a38",
                                "text": "„Und dass am Wendepunkt der Runde eine Einkehr steht, wird keinen Genussspecht stören.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
