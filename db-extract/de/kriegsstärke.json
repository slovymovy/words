                "senses": [
                    {
                        "sense_id": "5012b954-ff96-35ec-9cd0-74841a9b8ae0",
                        "entry_id": "a31e168d-e7a8-363c-b1aa-203e5e178ffe",
                        "glosses": [
                            "Zustand der Rüstung hinsichtlich Material und Personal für einen Einsatz in kriegerischen Auseinandersetzungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4244d31-ac22-4969-a746-74cf43310c9d",
                                "sense_id": "5012b954-ff96-35ec-9cd0-74841a9b8ae0",
                                "text": "„Wo die Amerikaner immer neue Divisionen heranführen konnten, alle voll ausgerüstet und in Kriegsstärke, ließen sich die Verluste an Menschen und Material auf deutscher Seite nicht mehr wettmachen.“"
                            },
                            {
                                "example_id": "30d2d14c-0ad4-44da-b278-803d47add695",
                                "sense_id": "5012b954-ff96-35ec-9cd0-74841a9b8ae0",
                                "text": "„In seiner Abwesenheit war er zum Rittmeister befördert worden, und als das Regiment auf Kriegsstärke gebracht wurde, bekam er wieder seine alte Schwadron.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e2cef65-3f74-4175-a3e0-84f70d1d124c",
                        "source_entry_id": "a31e168d-e7a8-363c-b1aa-203e5e178ffe",
                        "source_sense_id": "5012b954-ff96-35ec-9cd0-74841a9b8ae0",
                        "target_lang_word": "force de frappe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "force de frappe",
