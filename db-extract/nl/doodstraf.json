                        "target_lang_word": "capital punishment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "capital punishment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5d8b9c7-f51c-3acf-a76e-e3f0d423849d",
                                        "entry_id": "62bf2090-37da-31f0-b19e-b86b3c5b90eb",
                                        "glosses": [
                                            "The practice of putting a person to death as a punishment for a crime."
                                        ],
