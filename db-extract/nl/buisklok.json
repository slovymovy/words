                        "cross_references": [
                            {
                                "target_word": "chime",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ed25ac6-aa28-3a3f-a69d-a05ece27e608",
                                        "entry_id": "eaa9ede3-a6ac-3eba-a222-ec90c28b0a7f",
                                        "glosses": [
                                            "A musical instrument producing a sound when struck, similar to a bell (e.g. a tubular metal bar) or actually a bell. Often used in the plural to refer to the set: the chimes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2abd5511-c0a5-48a0-95a3-f8d2316d2492",
                                                "sense_id": "3ed25ac6-aa28-3a3f-a69d-a05ece27e608",
                                                "text": "Hugo had a recording of someone playing the chimes against a background of surf noise that she found calming."
                                            },
                                            {
                                                "example_id": "d1b368bc-e29f-4872-b5c5-548ddcc502f0",
                                                "sense_id": "3ed25ac6-aa28-3a3f-a69d-a05ece27e608",
                                                "text": "Sylvia was a chime player in the school orchestra."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc1277f6-cfcc-39b0-bbc3-27d21ddd37f4",
                                        "entry_id": "eaa9ede3-a6ac-3eba-a222-ec90c28b0a7f",
                                        "glosses": [
                                            "An individual ringing component of such a set."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "264fbe84-1a42-4c2f-83f1-c0fe4a342bf7",
                                                "sense_id": "dc1277f6-cfcc-39b0-bbc3-27d21ddd37f4",
                                                "text": "Peter removed the C♯ chime from its mounting so that he could get at the dust that had accumulated underneath."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e62823a4-56b7-3799-83b8-6991baaf0f09",
                                        "entry_id": "eaa9ede3-a6ac-3eba-a222-ec90c28b0a7f",
                                        "glosses": [
                                            "A small bell or other ringing or tone-making device as a component of some other device."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "504a923b-d87b-4fa5-a745-61973a5fd3d6",
                                                "sense_id": "e62823a4-56b7-3799-83b8-6991baaf0f09",
                                                "text": "The professor had stuffed a wad of gum into the chime of his doorbell so that he wouldn't be bothered."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7f1463e-b0e7-3f15-9d19-36fb003c5572",
                                        "entry_id": "eaa9ede3-a6ac-3eba-a222-ec90c28b0a7f",
                                        "glosses": [
                                            "The sound of such an instrument or device."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1aaaa4b6-5adf-474a-9260-cbaa88c4e69d",
                                                "sense_id": "d7f1463e-b0e7-3f15-9d19-36fb003c5572",
                                                "text": "The copier gave a chime to indicate that it had finished printing."
                                            },
                                            {
                                                "example_id": "9eca8077-b236-4054-a286-429dd9173170",
                                                "sense_id": "d7f1463e-b0e7-3f15-9d19-36fb003c5572",
                                                "text": "Chimes sing Sunday morn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b50c51a4-0049-33c3-a5c7-6fbc1fc09a28",
                                        "entry_id": "eaa9ede3-a6ac-3eba-a222-ec90c28b0a7f",
                                        "glosses": [
                                            "A small hammer or other device used to strike a bell."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7bc0d86-7c22-468d-b0cf-3143cb0bbb58",
                                                "sense_id": "b50c51a4-0049-33c3-a5c7-6fbc1fc09a28",
                                                "text": "Strike the bell with the brass chime hanging on the chain next to it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chime",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1bd6df65-6d27-3a80-895e-b1552f73aecb",
                                        "entry_id": "51ffeb00-0535-3e61-b48c-f4fbc07281c3",
                                        "glosses": [
                                            "To make the sound of a chime."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc3d829b-895c-464a-8587-b4b5b667e9e3",
                                                "sense_id": "1bd6df65-6d27-3a80-895e-b1552f73aecb",
                                                "text": "The microwave chimed to indicate that it was done cooking."
                                            },
                                            {
                                                "example_id": "1ac22865-3d87-4687-99c1-b8ef477af9be",
                                                "sense_id": "1bd6df65-6d27-3a80-895e-b1552f73aecb",
                                                "text": "I got up for lunch as soon as the wall clock began chiming noon."
                                            },
                                            {
                                                "example_id": "4172fdc8-1da5-4598-81b1-e52666224f71",
                                                "sense_id": "1bd6df65-6d27-3a80-895e-b1552f73aecb",
                                                "text": "An interesting feature of the church is the invisible clock, which you can hear thumping away as you enter. Constructed in 1525, it is one of the oldest timepieces in England. It chimes the hours and the quarters, and every three hours it plays a hymn. But it has no faces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51bf4ac0-61ac-3d2d-a665-1d14f1e55aaf",
                                        "entry_id": "51ffeb00-0535-3e61-b48c-f4fbc07281c3",
                                        "glosses": [
                                            "To cause to sound in harmony; to play a tune, as upon a set of bells; to move or strike in harmony."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffbb7501-4732-4af4-b8ca-872eee37bdf2",
                                                "sense_id": "51bf4ac0-61ac-3d2d-a665-1d14f1e55aaf",
                                                "text": "And chime their sounding hammers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5227853-8a10-3765-ac04-40b128f481f4",
                                        "entry_id": "51ffeb00-0535-3e61-b48c-f4fbc07281c3",
                                        "glosses": [
                                            "To utter harmoniously; to recite rhythmically."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0225d41d-1fc5-4969-a53d-58e4da78b329",
                                                "sense_id": "b5227853-8a10-3765-ac04-40b128f481f4",
                                                "text": "Chime his childish verse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d083e9ab-0913-3c9c-bd83-9b639ee654e6",
                                        "entry_id": "51ffeb00-0535-3e61-b48c-f4fbc07281c3",
                                        "glosses": [
                                            "To agree; to correspond."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34974ad2-d54d-4612-a9dc-13c4bb80b1fd",
                                                "sense_id": "d083e9ab-0913-3c9c-bd83-9b639ee654e6",
                                                "text": "The other lab's results chimed with mine, so I knew we were on the right track with the research."
                                            },
                                            {
                                                "example_id": "c096d171-25ad-4b5c-8a5a-18f90ccfc14f",
                                                "sense_id": "d083e9ab-0913-3c9c-bd83-9b639ee654e6",
                                                "text": "Everything chimed in with such a humor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "963c50bd-d0c4-311c-b8c0-b8113d2018d0",
                                        "entry_id": "51ffeb00-0535-3e61-b48c-f4fbc07281c3",
                                        "glosses": [
                                            "To make a rude correspondence of sounds; to jingle, as in rhyming."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53dd36a7-5beb-4243-b20a-d1fbb63c2a36",
                                                "sense_id": "963c50bd-d0c4-311c-b8c0-b8113d2018d0",
                                                "text": "It shall not keep one settled pace of time,\nIn the same tune it shall not always chime"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chime",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9109b02e-b523-3fc1-a7ef-f27b826625e2",
                                        "entry_id": "a8c6e27f-9aa5-3203-99c8-10477cbeb444",
                                        "glosses": [
                                            "Alternative form of chine (“edge of a cask; part of a ship; etc.”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d2d3917-b2c8-43c7-bd4b-def8e9ccadf3",
                                                "sense_id": "9109b02e-b523-3fc1-a7ef-f27b826625e2",
                                                "text": "Let the chimes meet so that the chime of one cask shall not work into the head of the next."
                                            },
                                            {
                                                "example_id": "6857e6b0-b00f-4bb0-b9ed-0d13c68107d5",
                                                "sense_id": "9109b02e-b523-3fc1-a7ef-f27b826625e2",
                                                "text": "The chime, or smooth curved surface of the cask, is produced by a dexterous use of the adze."
                                            },
                                            {
                                                "example_id": "dbc0be6c-ab8a-4e6a-aca0-ed797af14054",
                                                "sense_id": "9109b02e-b523-3fc1-a7ef-f27b826625e2",
                                                "text": "Instead of rolling the barrel on the chime, it is a common practice to lay it on its side and give it a push."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
