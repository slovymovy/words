                        "examples": [
                            {
                                "example_id": "0f35ab79-ffd7-47df-b311-d6e13c92951d",
                                "sense_id": "7b14f13f-1991-3014-8130-6a710303c91f",
                                "text": "„Allein in Großbritannien werden die von Gliederfüßer verursachten Ernteeinbußen auf etwa 2,8 Milliarden Euro jährlich geschätzt.“"
                            },
                            {
                                "example_id": "8488cad4-53e2-42cd-96de-6f46b758372e",
                                "sense_id": "7b14f13f-1991-3014-8130-6a710303c91f",
                                "text": "„Biozide finden in vielen Bereichen des alltäglichen Lebens ihre Anwendung, um wirtschaftlichen und materiellen Schäden vorzubeugen, angefangen beim Pflanzenschutz zur Bekämpfung von schädlingsbedingten Ernteeinbußen (Pflanzenschutzmittel) bis hin zum Material- und Vorratschutz (Insektizideinsatz) und der Steigerung der hygienischen Sicherheit.“"
                            }
                        ],
