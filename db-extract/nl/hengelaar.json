                                            {
                                                "example_id": "e42885a0-c9db-4f81-9576-c505dee87ff6",
                                                "sense_id": "0c9b0e17-3ceb-3f1d-b493-b1aaa5685d86",
                                                "text": "A throng of anglers lined the trout stream on opening day of trout season."
                                            }
