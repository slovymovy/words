            {
                "entry_id": "d17eaa1f-8acd-37ff-887d-2adbd93b5dc6",
                "word": "Zed",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c862bdc9-ab26-4614-8526-2704e59d1425",
                        "entry_id": "d17eaa1f-8acd-37ff-887d-2adbd93b5dc6",
                        "tags": [
                            "plural"
                        ],
                        "form": "Zeds"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "586d77c2-2c49-3aef-a5bd-74181c5b6a1a",
                        "entry_id": "d17eaa1f-8acd-37ff-887d-2adbd93b5dc6",
                        "glosses": [
                            "Alternative form of Z (“a member of Generation Z”)."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "9547bdbb-b752-458a-a7e7-2a30ec4049dd",
                                "sense_id": "586d77c2-2c49-3aef-a5bd-74181c5b6a1a",
                                "text": "Youth jargon is in constant flux. What may be all the go today, may disappear tomorrow. Herein some of the slang may be recognisable to Y-ers but not Zeds and vice versa."
                            },
                            {
                                "example_id": "639472a4-7aa2-490f-b3ae-9badf25b19bb",
                                "sense_id": "586d77c2-2c49-3aef-a5bd-74181c5b6a1a",
                                "text": "While Millennials started using computers for games, word processing, and rudimentary e-mail, Zeds have been fully immersed in social media from an early age."
                            },
                            {
                                "example_id": "5886aa4e-f964-4436-8453-f59afef6eef2",
                                "sense_id": "586d77c2-2c49-3aef-a5bd-74181c5b6a1a",
                                "text": "In today’s changing environment, new generations (e.g. Millennials and Zeds) learn differently."
                            }
                        ]
                    },
                    {
                        "sense_id": "f83afc2e-0917-33f5-8896-e0f3474c4a2d",
                        "entry_id": "d17eaa1f-8acd-37ff-887d-2adbd93b5dc6",
                        "glosses": [
                            "Alternative letter-case form of zed."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": []
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
