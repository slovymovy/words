                "senses": [
                    {
                        "sense_id": "f2c35dff-9a76-3e05-9baa-bf5ea99bfd1a",
                        "entry_id": "d9276a5e-1c8d-33ec-9382-85632f637148",
                        "glosses": [
                            "прост., бран. женщина (обычно немолодая) с неприятной внешностью и плохим характером"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9ebf033-8d9e-4caf-a000-1b89b933d171",
                                "sense_id": "f2c35dff-9a76-3e05-9baa-bf5ea99bfd1a",
                                "text": "От стола подняла на меня глаза женщина вилковских лет, грымза в очках, похожая на заведующую отделом кадров."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "87fa4fad-57de-4e36-ba51-903efbbd322b",
                        "source_entry_id": "d9276a5e-1c8d-33ec-9382-85632f637148",
                        "source_sense_id": "f2c35dff-9a76-3e05-9baa-bf5ea99bfd1a",
                        "target_lang_word": "shrew",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shrew",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e85e4754-6457-3c64-946d-51d2e239ba29",
                                        "entry_id": "ec31b70f-2762-3aa0-a7b3-78f007c5e5b1",
                                        "glosses": [
                                            "Any of numerous small, mouselike, chiefly nocturnal, mammals of the family Soricidae."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0fb9dfc9-90c6-3217-88f4-d7aa1c80ba09",
                                        "entry_id": "ec31b70f-2762-3aa0-a7b3-78f007c5e5b1",
                                        "glosses": [
                                            "Certain other small mammals that resemble true shrews."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0e3c30a7-95ed-3f19-9f2f-48ca21c952eb",
                                        "entry_id": "ec31b70f-2762-3aa0-a7b3-78f007c5e5b1",
                                        "glosses": [
                                            "An ill-tempered, nagging woman: a scold."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42f1381c-8562-42aa-bff1-e960e3f0b999",
                                                "sense_id": "0e3c30a7-95ed-3f19-9f2f-48ca21c952eb",
                                                "text": "The clerk had, I'm afraid, a shrew of a wife—shrill, vehement, and fluent. 'Rogue,' 'old miser,' 'old sneak,' and a great many worse names, she called him."
                                            },
                                            {
                                                "example_id": "7b8dfc5d-cfaf-45a2-92b2-f3d56342aa21",
                                                "sense_id": "0e3c30a7-95ed-3f19-9f2f-48ca21c952eb",
                                                "text": "His wife was a shrew with warts on her face and she spoke to him sharply when others were present, but Simcha did not complain."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shrew",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10b3b882-45cc-3caa-8438-7c41f7512174",
                                        "entry_id": "f83f7fc0-4352-37d7-9ba4-1b12b82537da",
                                        "glosses": [
                                            "To beshrew; to curse."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc1bc33a-2bef-4bcd-8b1e-ea574b2387cd",
                                                "sense_id": "10b3b882-45cc-3caa-8438-7c41f7512174",
                                                "text": "I shrew myself."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3cf31a7-1c3e-4e90-9f9e-102148b22836",
                        "source_entry_id": "d9276a5e-1c8d-33ec-9382-85632f637148",
                        "source_sense_id": "f2c35dff-9a76-3e05-9baa-bf5ea99bfd1a",
                        "target_lang_word": "hag",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hag",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "acb1df1d-0fc5-329d-a723-d0523e4c4aac",
                                        "entry_id": "36bee186-ba89-3a9e-9dd0-d61bff2f2ea9",
                                        "glosses": [
                                            "A witch, sorceress, or enchantress; a female wizard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02d9c44e-6518-4f42-a132-cf69469a33ba",
                                                "sense_id": "acb1df1d-0fc5-329d-a723-d0523e4c4aac",
                                                "text": "And that olde hag that with a staffe his staggering lymbes dooth stay"
                                            },
                                            {
                                                "example_id": "fbb4b2b8-a018-4f2e-aa1f-2fd9dab0b4cb",
                                                "sense_id": "acb1df1d-0fc5-329d-a723-d0523e4c4aac",
                                                "text": "Such unaccountable masses of shades and shadows, that at first you almost thought some ambitious young artist, in the time of the New England hags, had endeavored to delineate chaos bewitched."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3598b56-ece7-3de5-9483-830bce1e7c29",
                                        "entry_id": "36bee186-ba89-3a9e-9dd0-d61bff2f2ea9",
                                        "glosses": [
                                            "An ugly old woman."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abf3e45e-4fb2-4e19-982e-6d315f91ef1f",
                                                "sense_id": "d3598b56-ece7-3de5-9483-830bce1e7c29",
                                                "text": "The elder women were literally \"old hags\" - lean and shrivelled, and excessively ugly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "684d2d50-8966-3441-9e71-88728789c06a",
                                        "entry_id": "36bee186-ba89-3a9e-9dd0-d61bff2f2ea9",
                                        "glosses": [
                                            "An evil woman."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1530d28-a699-494d-ae74-623488ecbbdb",
                                                "sense_id": "684d2d50-8966-3441-9e71-88728789c06a",
                                                "text": "I don't plan to stop drinking. But... I don't wanna forget. I can't turn away anymore. So, if I'm gonna die, well, it might as well be driving my sword through the heart of that murderous hag."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5458c50a-1655-3036-be3c-79c082bf4b4b",
                                        "entry_id": "36bee186-ba89-3a9e-9dd0-d61bff2f2ea9",
                                        "glosses": [
                                            "A woman over the age of 30 years."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af37f8f9-ba62-44e8-833e-b3f023a13236",
                                                "sense_id": "5458c50a-1655-3036-be3c-79c082bf4b4b",
                                                "text": "– What is that hag trend that is going on?"
                                            },
                                            {
                                                "example_id": "73fadf00-e77f-4368-a897-ebb2f09c2e63",
                                                "sense_id": "5458c50a-1655-3036-be3c-79c082bf4b4b",
                                                "text": "– The trend, hagmaxxing, is when younger men pursue relationships with hags."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a1f2a19-ae86-3f13-920e-ed6086f33b9f",
                                        "entry_id": "36bee186-ba89-3a9e-9dd0-d61bff2f2ea9",
                                        "glosses": [
                                            "A fury; a she-monster."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8d0eb18-5cd6-4f3e-a41d-5276d796e9a6",
                                                "sense_id": "6a1f2a19-ae86-3f13-920e-ed6086f33b9f",
                                                "text": "Fourth of the cursed knot of hags is she / Or rather all the other three in one; / Hell's shop of slaughter she does oversee, / And still assist the execution"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa618693-fce7-3e09-8d01-c42786e044ae",
                                        "entry_id": "36bee186-ba89-3a9e-9dd0-d61bff2f2ea9",
                                        "glosses": [
                                            "A hagfish; one of various eel-like fish of the family Myxinidae, allied to the lamprey, with a suctorial mouth, labial appendages, and a single pair of gill openings."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "60764c43-15dc-3d11-bf28-582d3aff86f6",
                                        "entry_id": "36bee186-ba89-3a9e-9dd0-d61bff2f2ea9",
                                        "glosses": [
                                            "A hagdon or shearwater; one of various sea birds of the genus Puffinus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5ca2abf1-d58c-36d8-95c9-31c6ebf14aec",
                                        "entry_id": "36bee186-ba89-3a9e-9dd0-d61bff2f2ea9",
                                        "glosses": [
                                            "An appearance of light and fire on a horse's mane or a person's hair."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be5f3c40-e61c-4185-a520-26d853808522",
                                                "sense_id": "5ca2abf1-d58c-36d8-95c9-31c6ebf14aec",
                                                "text": "Flamma lambentes (or those we call Haggs) are made of Sweat or some other Vapour issuing out of the Head; a not-unusuall sight amongst us when we ride by night in the Summer time: They are extinguisht, like flames, by shaking the Horse Mains"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92dd812f-0ad8-36b1-88d0-ead9aff3372c",
                                        "entry_id": "36bee186-ba89-3a9e-9dd0-d61bff2f2ea9",
                                        "glosses": [
                                            "The fruit of the hagberry, Prunus padus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c530ac76-69dd-34e1-b3ac-0f9c0a5b77ed",
                                        "entry_id": "36bee186-ba89-3a9e-9dd0-d61bff2f2ea9",
                                        "glosses": [
                                            "Sleep paralysis."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hag",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "955b962f-5267-3d4f-8a6f-c1d4ceea7a80",
                                        "entry_id": "16184b19-75a1-3227-b6b8-14cc48558e0b",
                                        "glosses": [
                                            "A small wood, or part of a wood or copse, which is marked off or enclosed for felling, or which has been felled."
                                        ],
                                        "tags": [
                                            "Northern-England"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37d84c2d-7a9d-43a8-a990-ff324dccc549",
                                                "sense_id": "955b962f-5267-3d4f-8a6f-c1d4ceea7a80",
                                                "text": "This said, he led me over hoults and hags; / Through thorns and bushes scant my legs I drew"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbe596da-6306-3188-803d-eaff3815ff02",
                                        "entry_id": "16184b19-75a1-3227-b6b8-14cc48558e0b",
                                        "glosses": [
                                            "A marshy hollow, especially an area of peat lying lower than surrounding moorland, formed by erosion of a gully or cutting and often having steep edges."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "857bf2ab-67d9-49d0-b670-fb5a5b767ba0",
                                                "sense_id": "bbe596da-6306-3188-803d-eaff3815ff02",
                                                "text": "And they likewise ordained […] that all the warp should be thrown into the Common wayes, to fill up haggs and lakes, where need was, upon a great penalty, where it should ly neer the Common rode."
                                            },
                                            {
                                                "example_id": "4e8fbf38-6e6c-4ed8-bdef-4e9bc9e77fb6",
                                                "sense_id": "bbe596da-6306-3188-803d-eaff3815ff02",
                                                "text": "[…] upon wet brae-sides, peat-haggs, and flow-mosses, […]"
                                            },
                                            {
                                                "example_id": "2758c847-7727-40de-8843-b3fb05cb5a12",
                                                "sense_id": "bbe596da-6306-3188-803d-eaff3815ff02",
                                                "text": "The uplands are generally mossy, resting on clay of a yellow colour, covered by moss of various depths, which often break into what are called hags, or flow-moss."
                                            },
                                            {
                                                "example_id": "4ecdaa30-bacd-4316-95c7-8989e2a76cd7",
                                                "sense_id": "bbe596da-6306-3188-803d-eaff3815ff02",
                                                "text": "[…] I had made sure to find him in the hag o' Coars-Neuk Moor, […]"
                                            },
                                            {
                                                "example_id": "031ec32f-f1c6-4788-a9f3-a465140231e1",
                                                "sense_id": "bbe596da-6306-3188-803d-eaff3815ff02",
                                                "text": "The strongest nag that crosses th' hagg / Wi wots ta Fullod mill."
                                            },
                                            {
                                                "example_id": "c653bd38-8ca3-4325-bc47-d41e5c13cab2",
                                                "sense_id": "bbe596da-6306-3188-803d-eaff3815ff02",
                                                "text": "[…] the murky flag / Flaps on Turftennant's rushy hag.\""
                                            },
                                            {
                                                "example_id": "933a8b45-bc78-461b-8633-f15fcfe92dee",
                                                "sense_id": "bbe596da-6306-3188-803d-eaff3815ff02",
                                                "text": "The shallow slow-running groughs fed the hag with a trickle of coppery water."
                                            },
                                            {
                                                "example_id": "0d07a68e-da82-42f2-a9e4-944fc88e2f1f",
                                                "sense_id": "bbe596da-6306-3188-803d-eaff3815ff02",
                                                "text": "The winter snow has collected amongst the eroded peat hags and is being actively reshaped into deep dunes and linear ripples by the strong winds whipping across the summit ridge. In the winter light, large sandblasted granite tors, sugar-coated with ice, stand out[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hag",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21ab6c70-e4c6-34b8-9135-73f30ae02b80",
                                        "entry_id": "085d7440-88a5-36b6-a490-af2be5fa1757",
                                        "glosses": [
                                            "To cut or erode (as) a hag (a hollow into moorland)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "646e4899-4327-4174-b339-1c7bc5ab3638",
                                                "sense_id": "21ab6c70-e4c6-34b8-9135-73f30ae02b80",
                                                "text": "hag […] is that part in mosses which is naturally or artificially cut, hollowed, hagged, or hacked; naturally by water runlets forming hollows, and artificially by, among other means, the cutting and removal of peat."
                                            },
                                            {
                                                "example_id": "769d871b-839f-4b54-9d43-25a76cca17d9",
                                                "sense_id": "21ab6c70-e4c6-34b8-9135-73f30ae02b80",
                                                "text": "Covenanters too met often on our moss-hagged moors."
                                            },
                                            {
                                                "example_id": "12c114ca-bb0c-4c4f-83e1-5f6bff36a365",
                                                "sense_id": "21ab6c70-e4c6-34b8-9135-73f30ae02b80",
                                                "text": "[…] on one occasion, where the bog had been cut away, a stump was discovered which bore evident marks of having been hagged [hacked]."
                                            },
                                            {
                                                "example_id": "aea94f2e-64b9-4093-b3b9-901e05358fe5",
                                                "sense_id": "21ab6c70-e4c6-34b8-9135-73f30ae02b80",
                                                "text": "Crowberry is particularly abundant on hagged peat and in cotton grass mires; it prefers drier ground, […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hag",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64497aba-4c9c-32b7-ae5a-ba4edeef43ad",
                                        "entry_id": "09d9400b-fe4c-325a-8e15-953ca346db08",
                                        "glosses": [
                                            "To harass; to weary with vexation."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c2724b6-e881-4dc2-8f42-2955e1f281e2",
                                                "sense_id": "64497aba-4c9c-32b7-ae5a-ba4edeef43ad",
