{
    "word_family": [
        "bukking",
        "gebuig",
        "vooroverbukken"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "556329ca-8210-35a3-a06d-58ae8d9713bd",
                    "sense_definition": "het lichaam naar voren en beneden buigen, vaak om iets van de grond te pakken of om ergens onderdoor te gaan",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fysieke beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>bukte</w> zich om met zijn hand bij de gevallen pen te komen.",
                            "target_lang_translations": {
                                "en": "He <w>stooped</w> down to reach the fallen pen with his hand."
                            }
                        },
                        {
                            "text": "Je moet even <w>bukken</w> om niet tegen de lage balk aan te stoten.",
                            "target_lang_translations": {
                                "en": "You have to <w>duck</w> for a moment so you don't hit the low beam."
                            }
                        }
                    ],
                    "synonyms": [
                        "buigen",
                        "neerbuigen"
                    ],
                    "antonyms": [
                        "opstaan",
                        "strekken"
                    ],
                    "common_phrases": [
                        "diep bukken",
                        "moeten bukken",
                        "bukken voor"
                    ],
                    "target_lang_definitions": {
                        "en": "to bend the body forward and downward, often to pick something up from the ground or to pass under something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stoop",
                                "target_lang_sense_clarification": "to bend the body forward and down"
                            },
                            {
                                "target_lang_word": "bend down",
                                "target_lang_sense_clarification": "to lower oneself by bending"
                            },
                            {
                                "target_lang_word": "duck",
                                "target_lang_sense_clarification": "to lower the head or body quickly to avoid something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e031ab62-0afd-394b-9bd0-b67464afc5a8",
                    "sense_definition": "zich onderdanig opstellen of toegeven aan de eisen of wil van een ander",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuurlijk gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb niet zoveel zin meer om te moeten <w>bukken</w> en buigen voor de goede smaak.",
                            "target_lang_translations": {
                                "en": "I don't feel like having to <w>bow</w> and scrape for the sake of good taste anymore."
                            }
                        },
                        {
                            "text": "Het volk weigerde te <w>bukken</w> voor de eisen van de dictator.",
                            "target_lang_translations": {
                                "en": "The people refused to <w>bow</w> to the dictator's demands."
                            }
                        }
                    ],
                    "synonyms": [
                        "zwichten",
                        "onderwerpen",
                        "toegeven"
                    ],
                    "antonyms": [
                        "verzetten",
                        "weerstaan"
                    ],
                    "common_phrases": [
                        "bukken en buigen",
                        "bukken voor iemand"
                    ],
                    "target_lang_definitions": {
                        "en": "to adopt a submissive attitude or to give in to the demands or will of another"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bow",
                                "target_lang_sense_clarification": "to submit or yield to authority"
                            },
                            {
                                "target_lang_word": "stoop",
                                "target_lang_sense_clarification": "to lower one's standards or dignity"
                            },
                            {
                                "target_lang_word": "submit",
                                "target_lang_sense_clarification": "to accept or yield to a superior force"
                            },
                            {
                                "target_lang_word": "give in",
                                "target_lang_sense_clarification": "to cease fighting or arguing"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}