                ],
                "senses": [
                    {
                        "sense_id": "d49483bf-17b9-3aab-a075-de0df7de0a23",
                        "entry_id": "a2112600-512f-3137-a345-e22d82926c49",
                        "glosses": [
                            "État de ce qui est à priori."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5711c36f-59d2-4aea-acc4-ada48384b85c",
                                "sense_id": "d49483bf-17b9-3aab-a075-de0df7de0a23",
                                "text": "L'apriorité siewerthienne de la connaissance ne signifie donc pas une production « purement formelle »."
                            },
                            {
                                "example_id": "06989bcd-9188-4e2c-b370-48fd15269d4a",
                                "sense_id": "d49483bf-17b9-3aab-a075-de0df7de0a23",
                                "text": "Ainsi, la possibilité de la conception d’un objet d’expérience a priori trouve-t-elle sa justification dans l’apriorité d’une représentation contenant tout objet possible."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "56f65715-89f3-46ab-a69f-3e8c46472387",
                        "source_entry_id": "a2112600-512f-3137-a345-e22d82926c49",
