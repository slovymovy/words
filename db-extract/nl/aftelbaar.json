                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6b4537e-6193-4f63-b04d-e4fa6f1c79ea",
                                "sense_id": "247e4b26-6984-323f-9e6f-9ec0416cc3c8",
                                "text": "Een aftelbaar oneindige verzameling bevat oneindig veel elementen die te nummeren zijn (de natuurlijke getallen, de zandkorrels op aarde, et cetera); een overaftelbare verzameling bevat oneindig veel elementen die niet meer te nummeren zijn (het aantal punten op een lijnstuk, de reële getallen, et cetera)."
                            }
                        ]
                    }
