                ],
                "senses": [
                    {
                        "sense_id": "430548e3-7cc3-371b-90a8-dd46cf75c7a5",
                        "entry_id": "4bc74ad6-9ddf-3b06-aab3-0eb954d1e290",
                        "glosses": [
                            "lid van een prehistorisch volk en spreker van het Proto-Indo-Europees"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "753e28ab-31a9-32bd-a2ce-023b8137bede",
                        "entry_id": "4bc74ad6-9ddf-3b06-aab3-0eb954d1e290",
                        "glosses": [
                            "persoon van gemengd Indonesische en Europese (veelal Nederlandse) afkomst, dan wel een (Europese) Nederlandse man die geassimileerd is in de Indonesische samenleving (door een relatie met een inheemse vrouw)"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "8f3e3968-531b-47bf-912d-75a13343d824",
                                "sense_id": "753e28ab-31a9-32bd-a2ce-023b8137bede",
                                "text": "De vraag, wie in de practijk tot de bevolkingsgroep van Indo-Europeanen kunnen worden gerekend, is, voor wat de algemeen-economische ontwikkeling der Indische maatschappij betreft, veeleer van sociaal-politieken dan van anthropologischen aard.\nTot hen behooren in de eerste plaats de Indo’s, de z.g. mengbloeden of gemengdbloedigen van Europeesche èn Inlandsche afkomst. Ook worden daartoe gerekend de in Ned.-Indië geboren Europeanen van Nederlandsche nationaliteit, niet van Inlandsche afkomst. Als derde categorie wordt wel eens aangemerkt die der „blijvers” onder de „pur-sang” Europeesche mannelijke ingezetenen; zij n.1. die, elders geboren, in Ned.-Indië hun tweede vaderland hebben gevonden en veelal met Indische, c.q. Inlandsche of Indo-Chineesche, vrouwen zijn gehuwd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a74214a-1913-451a-bbe0-6b61a6fd8483",
                        "source_entry_id": "4bc74ad6-9ddf-3b06-aab3-0eb954d1e290",
                        "source_sense_id": "430548e3-7cc3-371b-90a8-dd46cf75c7a5",
                        "source_sense_description": "lid van een prehistorisch volk en spreker van het Proto-Indo-Europees",
                        "target_lang_word": "Indo-European",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Indo-European",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f64ec535-ea3c-309b-9e3c-e3d918488354",
                                        "entry_id": "cd0aaad4-8e9b-33f6-bf45-34a0cceedced",
                                        "glosses": [
                                            "A major language family which includes many of the native languages of Europe, Western Asia and India, with notable Indic, Iranian and European sub-branches."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bf624b77-5685-3820-afd8-8aa3241e13b2",
                                        "entry_id": "cd0aaad4-8e9b-33f6-bf45-34a0cceedced",
                                        "glosses": [
                                            "Proto-Indo-European: the hypothetical parent language of the Indo-European language family."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Indo-European",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a6606dd-1244-37fe-a82b-d34e9117327f",
                                        "entry_id": "58b49434-3c34-3ba0-8ff6-a29ed71d864a",
                                        "glosses": [
                                            "A member of the original ethnolinguistic group hypothesized to have spoken Proto-Indo-European and thus to have been the ancestor for most of India and Western Eurasia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fc6e9c1-7f17-4287-9850-6ac93c5ab6e0",
                                                "sense_id": "0a6606dd-1244-37fe-a82b-d34e9117327f",
                                                "text": "Two theories of the origins of the Indo-Europeans currently compete. M. Gimbutas believes that early Indo-Europeans entered southeastern Europe from the Pontic Steppes starting ca. 4500 B.C. and spread from there. C. Renfrew equates early Indo-Europeans with early farmers who entered southeastern Europe from Asia Minor ca. 7000 BC and spread through the continent."
                                            },
                                            {
                                                "example_id": "3d311564-56b4-4359-94fc-01518b208277",
                                                "sense_id": "0a6606dd-1244-37fe-a82b-d34e9117327f",
                                                "text": "Thus, although at least one term for ‘alder’ can be reconstructed to PIE, the wide distribution of this tree prevents it from being diagnostic of the earlier location of the Indo-Europeans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "480c9886-2edd-34bc-98a1-1734ae9dcf2e",
                                        "entry_id": "58b49434-3c34-3ba0-8ff6-a29ed71d864a",
                                        "glosses": [
                                            "A speaker of any Indo-European language (though especially an ancient one), or a member of an Indo-European culture, who is regarded as a continuation of the Proto-Indo-Europeans in terms of language, ancestry, or cultural affinity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a59081d1-8b89-4321-87b9-2428b1d1948f",
                                                "sense_id": "480c9886-2edd-34bc-98a1-1734ae9dcf2e",
                                                "text": "To the same direction points a recent revelation made by Professor Henning who identifies the Gutians or Kutians and Tukres of the ancient Near East that occur in the cuneiform inscriptions of the end of the 3rd millennium B.C. with historical Kuchi-Tocharians, this being the earliest appearance of the Indo-Europeans in history (cf. W. Henning, the first Indo-Europeans in history, \"Society and History.\" […])."
                                            },
                                            {
                                                "example_id": "fc253d46-1b32-4e98-a71d-e3580570d837",
                                                "sense_id": "480c9886-2edd-34bc-98a1-1734ae9dcf2e",
                                                "text": "We Indo-Europeans are crazy about three! We see the world as earth, sky, water. We see things as having a beginning, a middle, and an end. Do you want a third example? Sure you do—you're Indo-European!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a616fb69-1f9f-3d8f-b629-0268a1c5b764",
                                        "entry_id": "58b49434-3c34-3ba0-8ff6-a29ed71d864a",
                                        "glosses": [
                                            "A European living in India or the Indies."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc2b41b4-e571-4a54-9666-e56fb120b224",
                                                "sense_id": "a616fb69-1f9f-3d8f-b629-0268a1c5b764",
                                                "text": "The sale of looted items persisted for a month, and quick profits were made by burghers and Indo-Europeans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78ce6a74-0303-3009-9448-f9daf3fd74ff",
                                        "entry_id": "58b49434-3c34-3ba0-8ff6-a29ed71d864a",
                                        "glosses": [
                                            "A person of mixed European and Indian or Indonesian ancestry."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncommon"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Indo-European",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64e584df-3cf8-3c87-a6f9-49abe780c4ea",
                                        "entry_id": "3a989d28-03ac-3d13-8201-d98287d44e55",
                                        "glosses": [
                                            "Of or relating to the family of languages originally spoken in Europe and Western Asia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f38aadb8-5afd-42c1-9fe6-8e7246743e18",
                                                "sense_id": "64e584df-3cf8-3c87-a6f9-49abe780c4ea",
                                                "text": "Of the great Indo-European family of languages the general principal was also that of one name for each individual[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47fa0a36-60d7-353d-a2a1-61fa807c8f81",
                                        "entry_id": "3a989d28-03ac-3d13-8201-d98287d44e55",
                                        "glosses": [
                                            "Of or relating to the hypothetical parent language of the Indo-European language family."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b0e0fc3a-2ff8-3119-afa6-1a9f8601c0c2",
                                        "entry_id": "3a989d28-03ac-3d13-8201-d98287d44e55",
                                        "glosses": [
                                            "Of or relating to the hypothetical group of peoples that spread early Indo-European languages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80a47ac6-a9bc-4f95-9573-0131ab6ab8ea",
                                                "sense_id": "b0e0fc3a-2ff8-3119-afa6-1a9f8601c0c2",
                                                "text": "As there is no evidence for Indo-European apiculture, we have to reckon with foreign origin for κηρός […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9eff63c-5b1b-34a2-8298-ea7c2e6efab8",
                                        "entry_id": "3a989d28-03ac-3d13-8201-d98287d44e55",
                                        "glosses": [
                                            "Of or relating to persons of mixed European and Indian or Indonesian ancestry."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncommon"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
