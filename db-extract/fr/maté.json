                                                "sense_id": "53be6f23-aa2e-3634-86d3-23839d27792e",
                                                "text": "We spent a month in Buenos Aires drinking nothing but maté and Fernet with soda."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f10e40f2-1923-313a-b449-c9e25d5e048d",
                                        "entry_id": "f6c84b7d-9e9e-38ad-ab38-b0401a08fed6",
                                        "glosses": [
                                            "A cup of this drink."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8eceae1e-1439-32a8-b8f7-124bb6c759f4",
