                "entry_id": "d2f1bd05-36bd-33de-8308-01412345559b",
                "word": "stierengevecht",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "83185c40-e29f-4b99-b56d-caa41d162c76",
                        "entry_id": "d2f1bd05-36bd-33de-8308-01412345559b",
                        "tags": [
