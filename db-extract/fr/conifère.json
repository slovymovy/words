                "forms": [
                    {
                        "form_id": "0728462a-a5b8-4c71-b17c-4bdffc5e01e0",
                        "entry_id": "5212b268-25fd-3a41-98a6-cdf4746ba291",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "conifères"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b52b2524-ebf1-3cda-b6ee-f417d0b884f2",
                        "entry_id": "5212b268-25fd-3a41-98a6-cdf4746ba291",
                        "glosses": [
                            "Qui porte des cônes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f7c7487-fecf-43fa-b85f-4bc24db73b46",
                                "sense_id": "b52b2524-ebf1-3cda-b6ee-f417d0b884f2",
                                "text": "L’air plus frais qu’on y respirait, les ondulations des crêtes recouvertes de verdure et d’arbres conifères, nous donnaient l’espoir d’avoir à suivre désormais des chemins moins pénibles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3efcea59-a3c1-4c03-96fd-bb2c598d489f",
                        "source_entry_id": "5212b268-25fd-3a41-98a6-cdf4746ba291",
                        "source_sense_id": "b52b2524-ebf1-3cda-b6ee-f417d0b884f2",
                        "target_lang_word": "Nadelbaum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nadelbaum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "72a723c1-dd97-365a-8edb-a124ac739781",
                                        "entry_id": "1acf37d0-692a-33f2-9cbd-157791824a57",
                                        "glosses": [
                                            "nacktsamiger Baum, der harte, sehr schmale Blätter (genannt Nadeln) trägt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5dad089-6e11-4f0c-bf0f-8d6941a4d4df",
                                                "sense_id": "72a723c1-dd97-365a-8edb-a124ac739781",
                                                "text": "Die Tamariske ist kein Nadelbaum."
                                            },
                                            {
                                                "example_id": "00dfcfb3-95b6-47a4-8c80-27a13dc43b48",
                                                "sense_id": "72a723c1-dd97-365a-8edb-a124ac739781",
                                                "text": "„Die Nadelbäume waren so umfangreich, daß es zweifelhaft schien, ob dieses Stück Land tatsächlich zu den niederen Breiten gehörte, wie Cyrus Smith es vermutete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bed9b239-08e3-479d-b657-73acfba90261",
                        "source_entry_id": "5212b268-25fd-3a41-98a6-cdf4746ba291",
                        "source_sense_id": "b52b2524-ebf1-3cda-b6ee-f417d0b884f2",
                        "target_lang_word": "coniferous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coniferous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "793b0007-b824-35b2-83c8-a2aa95ddea42",
                                        "entry_id": "a47ea6b0-5bd5-3f93-8f80-cb2a5d1b1218",
                                        "glosses": [
                                            "Bearing cones, as the pine and cypress."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba182236-2fac-3099-9b62-f745d007b7c0",
                                        "entry_id": "a47ea6b0-5bd5-3f93-8f80-cb2a5d1b1218",
                                        "glosses": [
                                            "Of, or pertaining to, a conifer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0846070-3376-4c65-b406-f0a731b2a8e4",
                                                "sense_id": "ba182236-2fac-3099-9b62-f745d007b7c0",
                                                "text": "During the first part of the oligocratic stage, leaching of brown soils produces acid podzols that favour coniferous woodlands and heaths."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b11508d-42ce-4d11-bfd2-0087a28a23f8",
                        "source_entry_id": "5212b268-25fd-3a41-98a6-cdf4746ba291",
                        "source_sense_id": "b52b2524-ebf1-3cda-b6ee-f417d0b884f2",
                        "target_lang_word": "conífero",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conífero",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "ad5b045f-97fc-3108-85bc-2e3e05947315",
                                        "entry_id": "7c54a186-d258-371d-bd64-9d84afcfd659",
                                        "glosses": [
                                            "Aplícase a árboles y arbustos dicotiledóneos, de hojas lineales y persistentes, fruto cónico, y ramas que también presentan un contorno cónico; como el ciprés, el pino y la sabina."
                                        ],
                                        "tags": [
                                            "usado también en plural como taxón"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "644ec2c6-89d4-4d0b-a68a-47534b6f6bfe",
                        "source_entry_id": "5212b268-25fd-3a41-98a6-cdf4746ba291",
                        "source_sense_id": "b52b2524-ebf1-3cda-b6ee-f417d0b884f2",
                        "target_lang_word": "хвойный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "хвойный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "09600ef3-5ddc-35b8-8fbe-d0c236ffbbb7",
                                        "entry_id": "b10c5191-5aca-3f02-a556-52fae177f717",
                                        "glosses": [
                                            "связанный, соотносящийся по значению с существительным хвоя"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e911044-23a8-4bbc-b6de-8e6235004561",
                                                "sense_id": "09600ef3-5ddc-35b8-8fbe-d0c236ffbbb7",
                                                "text": "И, путаясь в этом беззвучном хоре, струился неиссякаемый, головокружительный, хмельной дух хвойной смолы."
                                            },
                                            {
                                                "example_id": "2bc79a06-7ab3-4a06-a7c9-5f8963b565d6",
                                                "sense_id": "09600ef3-5ddc-35b8-8fbe-d0c236ffbbb7",
                                                "text": "А почки сосны применяются как мочегонное средство и для приготовления хвойных ванн, которыми лечат нервные заболевания."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39b59073-6aea-3c48-8314-28aacd25940a",
                                        "entry_id": "b10c5191-5aca-3f02-a556-52fae177f717",
                                        "glosses": [
                                            "имеющий узкие и упругие в виде хвои листья"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39dea3e5-feec-4689-a696-455a885c36b8",
                                                "sense_id": "39b59073-6aea-3c48-8314-28aacd25940a",
                                                "text": "Деревья, с хвоями вместо листьев, называются хвойными."
                                            },
                                            {
                                                "example_id": "cf6a8ba1-2912-414b-8fa2-fe873786baa0",
                                                "sense_id": "39b59073-6aea-3c48-8314-28aacd25940a",
                                                "text": "А из всех деревьев самыми лучшими оказались хвойные — ель, сосна, пихта."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb11c282-615f-398f-858e-7ff913d9e539",
                                        "entry_id": "b10c5191-5aca-3f02-a556-52fae177f717",
                                        "glosses": [
                                            "состоящий из деревьев с такими листьями"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5691966-48b3-471b-a3d2-5ec292d8cc22",
                                                "sense_id": "eb11c282-615f-398f-858e-7ff913d9e539",
                                                "text": "Сами горы покрыты хвойными лесами, состоящими из сосны и лиственицы, а в иных местах, в особенности на так называемых россыпях, т. е. рассыпавшихся от выветривания горных породах, совершенно обнажены."
                                            },
                                            {
                                                "example_id": "a7ef40e9-6af4-4c89-ac06-bd847249d7fe",
                                                "sense_id": "eb11c282-615f-398f-858e-7ff913d9e539",
                                                "text": "Карабкаясь по хвойному склону, по осыпающимся бурым камням, задыхаясь от нетерпения, весь в поту, с пересохшей глоткой, Семён Иванович добрался до места, где в глубокой выемке снова появилось шоссе."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a61c1e8-fc8e-3f05-9417-6e6b0e2fefd6",
                                        "entry_id": "b10c5191-5aca-3f02-a556-52fae177f717",
                                        "glosses": [
                                            "состоящий из листьев таких деревьев"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48f20fab-9d9f-4697-8e68-6d7c42bd3c4c",
                                                "sense_id": "9a61c1e8-fc8e-3f05-9417-6e6b0e2fefd6",
                                                "text": "Под ногами, на мягком хвойном настиле, похрустывали сучки и шишки и по этому похрустыванию, да по сумеречно-белому пятну платья Саша узнавал шедшую рядом с ним Анну Сергеевну."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b05d4a82-2dc5-329b-b978-20bbf80dd07e",
                                        "entry_id": "b10c5191-5aca-3f02-a556-52fae177f717",
                                        "glosses": [
                                            "состоящий из ветвей таких деревьев"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79e75883-65aa-49d7-a89a-582b2b6aa348",
                                                "sense_id": "b05d4a82-2dc5-329b-b978-20bbf80dd07e",
                                                "text": "Машина позорно остановилась посреди улицы, не дойдя ста метров до кафедры, увитой хвойными гирляндами в честь отважных автомобилистов."
                                            },
                                            {
                                                "example_id": "44282e0e-b630-4e69-b31e-b5efc3b2e060",
                                                "sense_id": "b05d4a82-2dc5-329b-b978-20bbf80dd07e",
                                                "text": "Хохрин, разметавшись на хвойном ложе настланных на горячие камни веток, крепко спит, мне же что-то не хочется спать."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c97e2c6-6156-3c93-973d-34bf902cd50b",
                                        "entry_id": "b10c5191-5aca-3f02-a556-52fae177f717",
                                        "glosses": [
                                            "свойственный таким деревьям, характерный для них"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8edab2a8-55d4-4398-a490-a2bafbb7f667",
                                                "sense_id": "9c97e2c6-6156-3c93-973d-34bf902cd50b",
                                                "text": "Когда я подходил к лазарету, новые бараки блестели на солнце своими тяжёлыми, круглыми брёвнами и издавали хвойный запах."
                                            },
                                            {
                                                "example_id": "08663e23-b369-4b85-aab6-946bbd461809",
                                                "sense_id": "9c97e2c6-6156-3c93-973d-34bf902cd50b",
                                                "text": "Ехать было недурно — удобные сани, шустрая лошадь, не холодно, лунная, хотя и облачная ночь, красивые хвойные виды."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8f0f084-90b5-35fb-b5c1-e3193f0ca26f",
                                        "entry_id": "b10c5191-5aca-3f02-a556-52fae177f717",
                                        "glosses": [
                                            "добываемый, изготовляемый из древесины или листьев таких деревьев"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e1f5690-ab6f-4126-9955-a3e0501fa24d",
                                                "sense_id": "e8f0f084-90b5-35fb-b5c1-e3193f0ca26f",
                                                "text": "Купил в «Москвотопе» 2 ½ кубических метра (то же, что {{{1}}} 1 кв. сажень) хвойных дров за 20 р. с доставкой."
                                            },
                                            {
                                                "example_id": "40b9db2c-0a52-4361-85bb-14a3ce3211c8",
                                                "sense_id": "e8f0f084-90b5-35fb-b5c1-e3193f0ca26f",
                                                "text": "Она любила посвящать Лялю в свои дела, когда сама принимала ванну: вода была слегка подкрашена хвойным экстрактом, цветом напоминала зеленоватую морскую, и Клавдия в ванне походила на розовую Венеру в перламутровой раковине какого-нибудь мастера эпохи Возрожденья."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "719d2c2d-0663-3434-8246-8446aed69bce",
                                        "entry_id": "b10c5191-5aca-3f02-a556-52fae177f717",
                                        "glosses": [
                                            "свойственный древесине или листьям таких деревьев"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5521092e-33bb-4d8c-b24e-e3fbc301e596",
                                                "sense_id": "719d2c2d-0663-3434-8246-8446aed69bce",
                                                "text": "Здесь часто пахнет хвойным деревенским дымом — в сквозной полумгле сеней разжигается самовар сосновыми шишками."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "9229e8b7-b24b-3a45-ab0a-a028fa5639d5",
                "word": "conifère",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b6e01909-b07f-408c-92e6-e8fd77fc6ee4",
                        "entry_id": "9229e8b7-b24b-3a45-ab0a-a028fa5639d5",
                        "tags": [
                            "plural"
                        ],
                        "form": "conifères"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "71ff5e59-4206-34c3-8306-51e2dcd25246",
                        "entry_id": "9229e8b7-b24b-3a45-ab0a-a028fa5639d5",
                        "glosses": [
                            "Plante ligneuse, arbre ou arbuste, de la famille des Conifères ou Gymnospermes, dont le type est le sapin."
                        ],
                        "tags": [
                            "Ethnobiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "05e75a11-b0e2-4a8f-8739-7f876dee3e0b",
                                "sense_id": "71ff5e59-4206-34c3-8306-51e2dcd25246",
                                "text": "Dans la pénombre, sous les branches des grands conifères, le passage des petits amoureux inquiète la mésange noire, le bec-croisé et le bouvreuil."
                            },
                            {
                                "example_id": "a989ca51-eea7-4bc9-bafc-b71cdb0daba2",
                                "sense_id": "71ff5e59-4206-34c3-8306-51e2dcd25246",
                                "text": "À la rigueur on peut voir des liens entre une plante herbacée et un arbre de la forêt. Il est possible que l’humus produit par les feuilles de Conifères conviennent à ces plantes, mais l’inverse est insoutenable."
                            },
                            {
                                "example_id": "e2bd3914-8937-43e0-bfef-c0f8f650eda6",
