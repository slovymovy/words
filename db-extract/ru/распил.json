                        "form": "распи́ле"
                    },
                    {
                        "form_id": "98d8e0c1-9f04-492b-8896-17f9e866a411",
                        "entry_id": "22b42b15-05af-31e8-9be5-e91d4052abde",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "распи́лах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c1bd5c03-64ab-3d13-bf60-65340be6369c",
                        "entry_id": "22b42b15-05af-31e8-9be5-e91d4052abde",
                        "glosses": [
                            "спец. действие по значению гл. распиливать, распилить; тот или иной способ распиливания"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "242cc80e-207f-40da-b133-9130b9851291",
                                "sense_id": "c1bd5c03-64ab-3d13-bf60-65340be6369c",
                                "text": ".. распил фундаментных блоков, монолитных конструкций на отдельные транспортабельные части .."
                            }
                        ]
                    },
                    {
                        "sense_id": "4c9df4c1-7b91-3659-b40c-e9cdd614e533",
                        "entry_id": "22b42b15-05af-31e8-9be5-e91d4052abde",
                        "glosses": [
                            "спец. место, где (дерево, доска, бревно) распилено, место разреза"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "879ae41a-95b6-4d3d-8d29-019a8de33906",
                                "sense_id": "4c9df4c1-7b91-3659-b40c-e9cdd614e533",
                                "text": "Оружие было распилено пополам. В распил засунута записка…"
                            },
                            {
                                "example_id": "0f083c57-0b97-465a-9e0b-698b88a1cfcb",
                                "sense_id": "4c9df4c1-7b91-3659-b40c-e9cdd614e533",
                                "text": "Сначала пила не попадала в распил и выскакивала, скользя по дереву."
                            }
                        ]
                    },
                    {
                        "sense_id": "99fae5f8-c177-332b-a378-20b67c5ef35e",
                        "entry_id": "22b42b15-05af-31e8-9be5-e91d4052abde",
                        "glosses": [
                            "жарг. раздел, делёжка денег, власти, влияния и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3680df92-d62a-40e4-98ce-5db33e8d4237",
                                "sense_id": "99fae5f8-c177-332b-a378-20b67c5ef35e",
                                "text": "Постатейный «распил» бюджетных денег начется после первого чтения."
                            },
                            {
                                "example_id": "540660a5-8c8f-48f8-b928-0e2ab2bc3bb9",
                                "sense_id": "99fae5f8-c177-332b-a378-20b67c5ef35e",
                                "text": "Также часто бывает, что руководитель организации не является собственником бизнеса, и сам участвует в распиле, зачастую организовывая подставные фирмы, через которые направляются финансовые потоки в целях затруднения работы следствия."
                            }
                        ]
                    },
                    {
                        "sense_id": "e7694211-73a1-30dd-9bc8-1c115095311f",
                        "entry_id": "22b42b15-05af-31e8-9be5-e91d4052abde",
                        "glosses": [
                            "неол., жарг. импортированный автомобиль, кузов которого разделён на две части по стойкам лобового или заднего стекла (багажного отсека) и полу для уменьшения таможенного сбора"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "078cb04e-8848-4eee-876f-0269037b3470",
                                "sense_id": "e7694211-73a1-30dd-9bc8-1c115095311f",
                                "text": "«Распилами» и «конструкторами» называются японские автомобили, которые ввезли на территорию России в качестве запчастей, а затем собрали и зарегистрировали в ГИБДД как транспортные средства. Они появились на дорогах Приморья в 2009 году, после принятия правительством заградительных пошлин на ввоз иномарок."
                            }
                        ]
                    }
                ],
