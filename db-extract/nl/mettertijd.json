                                "target_senses": [
                                    {
                                        "sense_id": "ffdf6b41-8c39-3538-b4d2-bf7d0de33f5f",
                                        "entry_id": "de7b45c5-8116-332d-8df3-b3236f495ac0",
                                        "glosses": [
                                            "From a historic or evolutionary perspective."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b873fdb9-8fe3-4090-83e4-17f528787049",
                                                "sense_id": "ffdf6b41-8c39-3538-b4d2-bf7d0de33f5f",
                                                "text": "\"This graph shows the population of California over time.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea304835-b1ed-3fef-b17d-1b939be581b4",
                                        "entry_id": "de7b45c5-8116-332d-8df3-b3236f495ac0",
                                        "glosses": [
                                            "Occurring gradually, as the time passes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46de6d52-0dd9-4908-925f-d3f1bf6b76f2",
                                                "sense_id": "ea304835-b1ed-3fef-b17d-1b939be581b4",
                                                "text": "There are surely relationships in which romantic passion dies over time; the price of abandoning them is often less than the price of endless years spent in resuscitation efforts."
                                            },
                                            {
                                                "example_id": "221def6e-5f25-4d8f-82b6-c8167cb27de9",
                                                "sense_id": "ea304835-b1ed-3fef-b17d-1b939be581b4",
                                                "text": "It also appears that the older with less education score initially better than the young with higher education, but over time, the young appear to surpass them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44e45e7e-df67-4167-ba66-6fe1ba6766dc",
                        "source_entry_id": "a03dca77-01af-3f1b-bbd1-45f28dd2cb97",
                        "source_sense_id": "5c56b443-70c1-3807-9f8e-7d749bc0b471",
                        "source_sense_description": "na verloop van (een zekere) tijd",
                        "target_lang_word": "in time",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "in time",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "081c2e95-cc55-3fe0-983f-6aa12f87772e",
                                        "entry_id": "aa8e3ecc-ab88-3bfc-8403-0b0cf3841334",
                                        "glosses": [
                                            "At or before the time assigned."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b74e5f32-72a0-49b6-8b78-a7c23e185a61",
                                                "sense_id": "081c2e95-cc55-3fe0-983f-6aa12f87772e",
                                                "text": "I would have died had I not been gottten to hospital in time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56c501b1-3e83-3782-9ab3-ac532325ed82",
                                        "entry_id": "aa8e3ecc-ab88-3bfc-8403-0b0cf3841334",
                                        "glosses": [
                                            "Sufficiently early."
                                        ],
                                        "tags": [
                                            "with for"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03add0ad-47de-4d84-8229-dc19f2ce0450",
                                                "sense_id": "56c501b1-3e83-3782-9ab3-ac532325ed82",
                                                "text": "You've got here in time for tea — I was just making some."
                                            },
                                            {
                                                "example_id": "74ae60d1-874f-48a7-99cd-10348ef37471",
                                                "sense_id": "56c501b1-3e83-3782-9ab3-ac532325ed82",
                                                "text": "But out of sight is out of mind. And that[…]means that many old sewers have been neglected and are in dire need of repair. If that repair does not come in time, the result is noxious and potentially hazardous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f87e922-2d8e-3de9-a64b-8d1702f81595",
                                        "entry_id": "aa8e3ecc-ab88-3bfc-8403-0b0cf3841334",
                                        "glosses": [
                                            "As time passes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c671f0f-6b7b-4000-9c8e-780cc6fd9afb",
                                                "sense_id": "3f87e922-2d8e-3de9-a64b-8d1702f81595",
                                                "text": "In time, it got easier to deal with her death."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "066763ad-340c-3def-9732-2525863def39",
                                        "entry_id": "aa8e3ecc-ab88-3bfc-8403-0b0cf3841334",
                                        "glosses": [
                                            "In rhythm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14290d03-47ea-43ea-a7fe-02c5e771a8e1",
                                                "sense_id": "066763ad-340c-3def-9732-2525863def39",
                                                "text": "Am I in time (to/with the music)?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5097c18-9aa0-3c4f-82ee-31d3a35008a3",
                                        "entry_id": "aa8e3ecc-ab88-3bfc-8403-0b0cf3841334",
                                        "glosses": [
                                            "At the same rhythm as."
                                        ],
                                        "tags": [
                                            "in time with"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32052ed4-51e5-4ebd-a78a-c333729e20df",
                                                "sense_id": "c5097c18-9aa0-3c4f-82ee-31d3a35008a3",
                                                "text": "The door of the twins' room opposite was open; a twenty-watt night-light threw a weak yellow glow into the passageway. David could hear the twins breathing in time with each other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43e19e59-0918-3965-9396-97477c1f378c",
                                        "entry_id": "aa8e3ecc-ab88-3bfc-8403-0b0cf3841334",
                                        "glosses": [
                                            "In the correct tempo."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
