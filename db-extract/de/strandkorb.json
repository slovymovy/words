                ],
                "senses": [
                    {
                        "sense_id": "9eb70f84-4e24-3687-89e4-a9e5ea487cc7",
                        "entry_id": "895c60b0-4223-36c3-9da0-7c25e0dd4215",
                        "glosses": [
                            "schwerer beweglicher Sonnen- und Windschutz am Strand, der außen geflochten und innen gepolstert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a00617fb-b503-485a-8c19-2bab146f8b98",
                                "sense_id": "9eb70f84-4e24-3687-89e4-a9e5ea487cc7",
                                "text": "Die Strandkörbe in den Nordseebädern sind recht teuer."
                            },
                            {
                                "example_id": "6f408da1-afea-47eb-b902-3f981707ac2a",
                                "sense_id": "9eb70f84-4e24-3687-89e4-a9e5ea487cc7",
                                "text": "Wir setzten uns am liebsten in einen Strandkorb und schauten den anderen beim Baden zu."
                            },
                            {
                                "example_id": "e2afc8f3-92d6-4bc6-aad7-9df10d0a4f52",
                                "sense_id": "9eb70f84-4e24-3687-89e4-a9e5ea487cc7",
                                "text": "„Abends saß ich mit Reemis im Strandkorb."
                            },
                            {
                                "example_id": "9c53a7ec-2393-4ace-b940-04eb0f186221",
                                "sense_id": "9eb70f84-4e24-3687-89e4-a9e5ea487cc7",
                                "text": "„Während die Mädchen im Strandkorb schmorten, machten die Jungs Musik auf zwei Grammophonen: lief eines, wurde für das andere eine Platte herausgesucht.“"
                            },
                            {
                                "example_id": "9bfd88f2-90e6-4077-893e-453d1bc0b831",
                                "sense_id": "9eb70f84-4e24-3687-89e4-a9e5ea487cc7",
                                "text": "„Der Strandkorb ist eine uneinnehmbare Festung, vom Rest der Welt durch eine Mauer aus Sand und einen Graben getrennt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
