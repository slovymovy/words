        "nl-extract.jsonl": [
            {
                "entry_id": "e3be52ae-75dd-3dbf-9924-5bed4303e7ea",
                "word": "überhaupt",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9f2dfa46-bc97-3516-b87c-d16e8ccac8e1",
                        "entry_id": "e3be52ae-75dd-3dbf-9924-5bed4303e7ea",
                        "glosses": [
                            "alles in aanmerking genomen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0ae8092-138a-4e86-9aac-311d262b5adb",
                                "sense_id": "9f2dfa46-bc97-3516-b87c-d16e8ccac8e1",
                                "text": "‘Ik werk bij een audiovisueel productiebedrijf dat onder meer tv-commercials maakt. Veel bedrijven zeggen deze dagen hun shoots bij ons af. Maar het werk dat vandaag moet gebeuren, kon niet thuis worden gedaan. Ik hoorde gisteren überhaupt pas laat van de genomen maatregelen. Ik had tot laat gewerkt en daarna waren we gaan eten met collega’s."
                            },
                            {
                                "example_id": "38581fec-d53b-4382-b8a1-9d4af5879dec",
                                "sense_id": "9f2dfa46-bc97-3516-b87c-d16e8ccac8e1",
                                "text": "' 'Maar waarom zou je de wereld überhaupt een plezier willen doen? En ik kan je verzekeren dat je het nooit echt fijn zou vinden als je zelf schilderde."
                            },
                            {
                                "example_id": "d67c583b-a0ae-4fcc-a6de-ebed65783377",
                                "sense_id": "9f2dfa46-bc97-3516-b87c-d16e8ccac8e1",
                                "text": "Het woordje ‘er’ heeft een imagoprobleem. (…) Er is vaak nauwelijks chocola van te maken. Waarom moet je zeggen, ‘er is iets ergs gebeurd’, en niet, ‘iets ergs is gebeurd’? Waarom zeg je over je kinderen: ‘ik heb er vijf’, en niet ‘ik heb vijf?’ Wat betekent het woord überhaupt in die zinnen?"
                            }
                        ]
                    },
                    {
                        "sense_id": "ded021d6-833a-36b4-86be-d16c9a8fc97d",
                        "entry_id": "e3be52ae-75dd-3dbf-9924-5bed4303e7ea",
                        "glosses": [
                            "ongeacht de context"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97ecdedb-1df3-4482-960d-851942fdc370",
                                "sense_id": "ded021d6-833a-36b4-86be-d16c9a8fc97d",
                                "text": "Dat kan überhaupt niet."
                            },
                            {
                                "example_id": "52e53c2d-4b5e-4352-88d4-72e63f6268fe",
                                "sense_id": "ded021d6-833a-36b4-86be-d16c9a8fc97d",
                                "text": "i9 Daarna was het effect wel zo'n beetje uitgewerkt - een derde kind bracht überhaupt geen gelukspiek meer teweeg."
                            },
                            {
                                "example_id": "d652469c-c430-41d3-9df4-7fe247020c6e",
                                "sense_id": "ded021d6-833a-36b4-86be-d16c9a8fc97d",
                                "text": "Zou ik het überhaupt durven, of zou ik halverwege de nacht mijn biezen pakken en verder trekken op zoek naar de eerstvolgende tent langs de trail? Op de derde avond was het grote moment aangebroken: helemaal alleen in mijn tent de nacht doorbrengen."
                            },
                            {
                                "example_id": "f8199ab9-bf1c-4d0d-bdf4-6a78e93dfd01",
                                "sense_id": "ded021d6-833a-36b4-86be-d16c9a8fc97d",
                                "text": "En ik denk aan de indruk die eerste keren überhaupt kunnen maken."
                            },
                            {
                                "example_id": "54ed31a0-d923-4640-a1dc-23a0d04af426",
                                "sense_id": "ded021d6-833a-36b4-86be-d16c9a8fc97d",
                                "text": "Het is op dit moment de mode in chiquere, hippe restaurants om enkel de losse ingrediënten te vermelden, meestal afgewisseld met een sluisteken: 'Makreel | Venkel | Sesam | Mosterd | Schelvislever'. In echt heel exclusieve restaurants (bijvoorbeeld NOMA in Kopenhagen) krijg je überhaupt geen kaart te zien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a37747a5-b34b-4e32-852e-4a058e270a20",
                        "source_entry_id": "e3be52ae-75dd-3dbf-9924-5bed4303e7ea",
                        "source_sense_description": "ongeacht de omstandigheden",
                        "target_lang_word": "überhaupt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "überhaupt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4c017164-8b8f-37f9-b145-e894036b950f",
                                        "entry_id": "af09178a-5ca5-34fa-a015-44a55b83c50a",
                                        "glosses": [
                                            "nicht nur im Speziellen, sondern auch im Allgemeinen geltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75eae28f-ed81-416d-a0bc-27a13ac11396",
                                                "sense_id": "4c017164-8b8f-37f9-b145-e894036b950f",
                                                "text": "Du bist nicht nur heute nicht willkommen, du bist hier überhaupt nicht willkommen!"
                                            },
                                            {
                                                "example_id": "6eeea106-1110-4d5a-9575-60a1fb50e555",
                                                "sense_id": "4c017164-8b8f-37f9-b145-e894036b950f",
                                                "text": "„Neben dem früheren Museum für Verkehr und Bau sowie dem Meereskundlichen Museum hatte die Deutsche Luftfahrt-Sammlung mit über 100 Motorfliegern bis dahin eine der bedeutendsten historischen Flugschauen überhaupt dargestellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "64a871d0-4b83-3677-96cb-774d43583160",
                                        "entry_id": "af09178a-5ca5-34fa-a015-44a55b83c50a",
                                        "glosses": [
                                            "ganz und gar (nicht)"
                                        ],
                                        "tags": [
                                            "eine Aussage",
                                            "meist eine Verneinung",
                                            "bekräftigend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93c77271-29f2-4a09-a65d-84e4d696c30e",
                                                "sense_id": "64a871d0-4b83-3677-96cb-774d43583160",
                                                "text": "Er hat wieder mal überhaupt nichts verstanden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d589482e-2eb3-34d4-9842-bc12fa235905",
                                        "entry_id": "af09178a-5ca5-34fa-a015-44a55b83c50a",
                                        "glosses": [
                                            "außerdem, überdies"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01980a35-1fe3-4fed-b6db-914c7359ea33",
                                                "sense_id": "d589482e-2eb3-34d4-9842-bc12fa235905",
                                                "text": "Und überhaupt hat sie sich viel zu sehr darüber aufgeregt."
                                            },
                                            {
                                                "example_id": "3c00179f-41ac-44cc-a7e5-f2888d90275f",
                                                "sense_id": "d589482e-2eb3-34d4-9842-bc12fa235905",
                                                "text": "„Überhaupt sind alle Fürsten und ihre Paladine, die auf jener Seite stehen, von beneidenswerter Schönheit, lauter Adonisse, Lohengrine oder Siegfriede.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8e43bd5b-5663-3397-8fc5-9078295b2b4b",
                                        "entry_id": "af09178a-5ca5-34fa-a015-44a55b83c50a",
                                        "glosses": [
                                            "verwendet, um den Sachverhalt anzuzweifeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "430c3662-111e-436c-9928-b235f8de63f7",
                                                "sense_id": "8e43bd5b-5663-3397-8fc5-9078295b2b4b",
                                                "text": "Hat er es denn überhaupt gesehen?"
                                            },
                                            {
                                                "example_id": "0dcc8d89-14ad-428b-9f17-ff07cdf5c8ab",
                                                "sense_id": "8e43bd5b-5663-3397-8fc5-9078295b2b4b",
                                                "text": "„Es liegt nahe, sich zu fragen, ob man als Nichtbeteiligter in Bezug auf Extrembergsteigen überhaupt eine Meinung entwickeln kann, die relevant ist, als nie annähernd in diese Situationen Hineinversetzter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b938378-51da-4140-9557-ab0170507437",
                        "source_entry_id": "e3be52ae-75dd-3dbf-9924-5bed4303e7ea",
                        "source_sense_description": "ongeacht de omstandigheden",
                        "target_lang_word": "at all",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "at all",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d583b225-aea1-35b7-97db-58245ad07832",
                                        "entry_id": "c4328a21-6176-323e-bd53-fdae4d48fbda",
                                        "glosses": [
                                            "Indicating degree, quantity or frequency greater than zero: to the slightest degree, in any way, at any time or in any circumstance."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5261caf-6a37-451f-a4f8-f5f5fdbe6e64",
                                                "sense_id": "d583b225-aea1-35b7-97db-58245ad07832",
                                                "text": "After a while he descended the steps into the road again and he stood there and looked all about him and listened for any sound at all but there was nothing."
                                            },
                                            {
                                                "example_id": "dc8ba8ac-7bd4-4557-97d6-b9d6197727d2",
                                                "sense_id": "d583b225-aea1-35b7-97db-58245ad07832",
                                                "text": "You mustn't speak to her at all."
                                            },
                                            {
                                                "example_id": "fb18d547-3f1b-4bcd-8902-3dc6997ca895",
                                                "sense_id": "d583b225-aea1-35b7-97db-58245ad07832",
                                                "text": "Can you see anyone at all?"
                                            },
                                            {
                                                "example_id": "33e58b70-7a11-447a-9309-755b17519338",
                                                "sense_id": "d583b225-aea1-35b7-97db-58245ad07832",
                                                "text": "Are you at all bothered by the noise?"
                                            },
                                            {
                                                "example_id": "ceaf6d11-6564-40e9-a204-a46338a87f3e",
                                                "sense_id": "d583b225-aea1-35b7-97db-58245ad07832",
                                                "text": "Let me know if you are at all concerned."
                                            },
                                            {
                                                "example_id": "ca2a599a-5f0e-40da-85ed-1098df6681c5",
                                                "sense_id": "d583b225-aea1-35b7-97db-58245ad07832",
                                                "text": "Were you angry that he was laughing too hard, or that he was laughing at all?"
                                            },
                                            {
                                                "example_id": "deaa2734-d8a9-47e4-a199-1fbd40473ce3",
                                                "sense_id": "d583b225-aea1-35b7-97db-58245ad07832",
                                                "text": "My speech didn't seem to go down well at all."
                                            },
                                            {
                                                "example_id": "04104c70-47e6-4ad7-a378-1883a1740fe8",
                                                "sense_id": "d583b225-aea1-35b7-97db-58245ad07832",
                                                "text": "I'm glad that she didn't stay long, but sorry that she came at all."
                                            },
                                            {
                                                "example_id": "d8014388-846d-4799-afff-5bb5d583275a",
                                                "sense_id": "d583b225-aea1-35b7-97db-58245ad07832",
                                                "text": "This is the only one of the issues for which I am at all responsible."
                                            },
                                            {
                                                "example_id": "676802c6-557a-43ba-a269-c35a1d3efc78",
                                                "sense_id": "d583b225-aea1-35b7-97db-58245ad07832",
                                                "text": "If it’s at all possible, I'll try and do it."
                                            },
                                            {
                                                "example_id": "6d763a88-4b64-43af-b420-895f97693dab",
                                                "sense_id": "d583b225-aea1-35b7-97db-58245ad07832",
                                                "text": "Here's neither buſh, nor ſhrub to beare off any weather at all: and another Storme brewing, I heare it ſing ith' winde: yond ſame blacke cloud, yond huge one, lookes like a foule bumbard that would ſhed his licquor: if it ſhould thunder, as it did before, I know not where to hide my head: yond ſame cloud cannot chooſe but fall by paile-fuls."
                                            },
                                            {
                                                "example_id": "14f20b00-4a7d-4077-9739-cd1b50431999",
                                                "sense_id": "d583b225-aea1-35b7-97db-58245ad07832",
                                                "text": "He did not seem to think that he at all deserved a medal from the Humane and Magnanimous Societies."
                                            },
                                            {
                                                "example_id": "4203d7df-9880-4289-a74d-9678f532e1fa",
                                                "sense_id": "d583b225-aea1-35b7-97db-58245ad07832",
                                                "text": "The judge, by the way, was the King; and as he wore his crown over the wig, (look at the frontispiece if you want to see how he did it), he did not look at all comfortable, and it was certainly not becoming."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26deb622-70b8-40b3-88a4-4315c7be0abd",
                        "source_entry_id": "e3be52ae-75dd-3dbf-9924-5bed4303e7ea",
                        "source_sense_description": "ongeacht de omstandigheden",
                        "target_lang_word": "at any rate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "at any rate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a367db5-a8db-3b28-8acf-b9a82dc84774",
                                        "entry_id": "bd3127c2-a278-3ff8-8bbd-1aba117fbcf5",
                                        "glosses": [
                                            "In any case, anyway, anyhow, regardless; used to discard or qualify a previous thought."
                                        ],
                                        "tags": [
                                            "conjunctive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c8d25d6-cfd0-4e94-b0b9-2060a5dcc690",
                                                "sense_id": "8a367db5-a8db-3b28-8acf-b9a82dc84774",
                                                "text": "Jim broke the window — or maybe it was John? At any rate, the window’s broken now."
                                            },
                                            {
                                                "example_id": "5a40c9cf-b769-49cd-abaa-5d4e7b982cf7",
                                                "sense_id": "8a367db5-a8db-3b28-8acf-b9a82dc84774",
                                                "text": "He's stinking rich — or, at any rate, pretty well off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52b462d6-fddf-3c55-8248-591eaf7b1847",
                                        "entry_id": "bd3127c2-a278-3ff8-8bbd-1aba117fbcf5",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see at, any, rate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ddbff14-bb89-4939-aa9a-8c68858b2917",
                                                "sense_id": "52b462d6-fddf-3c55-8248-591eaf7b1847",
                                                "text": "Mr Chairman, I'd point out here that taxation without representation is an affront at any rate, low or high, but it is especially galling at the rate that Mr Smith proposes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
