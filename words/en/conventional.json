{
    "word_family": [
        "convention",
        "conventionally",
        "unconventional",
        "nonconventional",
        "conventionality",
        "conventionalism",
        "conventionalize"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "04f359f8-43ac-3c6c-9981-cea1f9e0a7c6",
                    "sense_definition": "Following accepted standards, customs, or generally accepted principles and methods.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "standard_norms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor suggested <w>conventional</w> treatment before trying experimental drugs.",
                            "target_lang_translations": {
                                "ru": "Врач предложил <w>традиционное</w> лечение, прежде чем пробовать экспериментальные препараты.",
                                "zh": "医生建议先采用<w>常规</w>治疗，再尝试实验性药物。"
                            }
                        },
                        {
                            "text": "She challenged <w>conventional</w> wisdom with her new scientific theory.",
                            "target_lang_translations": {
                                "ru": "Она бросила вызов <w>общепринятому</w> мнению своей новой научной теорией.",
                                "zh": "她用新的科学理论挑战了<w>传统</w>观念。"
                            }
                        }
                    ],
                    "synonyms": [
                        "typical",
                        "canonical"
                    ],
                    "antonyms": [
                        "unconventional",
                        "nonconventional",
                        "atypical"
                    ],
                    "common_phrases": [
                        "conventional wisdom",
                        "conventional method",
                        "conventional medicine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Следующий принятым стандартам, обычаям или общепринятым принципам.",
                        "zh": "遵循公认的标准、习俗或普遍接受的原则和方法的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "общепринятый",
                                "target_lang_sense_clarification": "широко признанный"
                            },
                            {
                                "target_lang_word": "традиционный",
                                "target_lang_sense_clarification": "основанный на обычаях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "常规的",
                                "target_lang_sense_clarification": "符合普遍接受的标准、做法或原则"
                            },
                            {
                                "target_lang_word": "传统的",
                                "target_lang_sense_clarification": "基于传统或惯例"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3fa1937-d137-38e8-8567-914e4809d620",
                    "sense_definition": "Ordinary and normal; not unusual or special.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "standard_norms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He leads a very <w>conventional</w> life with a steady job and a family.",
                            "target_lang_translations": {
                                "ru": "Он ведет очень <w>традиционный</w> образ жизни: стабильная работа и семья.",
                                "zh": "他过着非常<w>普通</w>的生活，有一份稳定的工作，也有家庭。"
                            }
                        },
                        {
                            "text": "They wear <w>conventional</w> clothes that do not attract any attention.",
                            "target_lang_translations": {
                                "ru": "Они носят <w>обычную</w> одежду, которая не привлекает внимания.",
                                "zh": "他们穿着很<w>普通</w>的衣服，一点也不引人注意。"
                            }
                        }
                    ],
                    "synonyms": [
                        "typical"
                    ],
                    "antonyms": [
                        "out of the ordinary",
                        "unconventional"
                    ],
                    "common_phrases": [
                        "conventional clothes",
                        "conventional lifestyle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обычный и нормальный; ничем не примечательный.",
                        "zh": "普通而正常的；并不罕见或特别的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обычный",
                                "target_lang_sense_clarification": "ничем не выделяющийся"
                            },
                            {
                                "target_lang_word": "консервативный",
                                "target_lang_sense_clarification": "приверженный традициям (о стиле жизни, одежде)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "普通的",
                                "target_lang_sense_clarification": "普通、正常，不特别"
                            },
                            {
                                "target_lang_word": "寻常的",
                                "target_lang_sense_clarification": "常见而不引人注意"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7301ffd9-f771-325c-864d-ed549d814dd1",
                    "sense_definition": "Lacking originality or imagination; boring and predictable.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "standard_norms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie had a <w>conventional</w> plot that offered no surprises to the audience.",
                            "target_lang_translations": {
                                "ru": "У фильма был <w>шаблонный</w> сюжет, который не преподнес зрителям никаких сюрпризов.",
                                "zh": "这部电影的情节很<w>老套</w>，没有给观众带来任何惊喜。"
                            }
                        },
                        {
                            "text": "His writing style is too <w>conventional</w> to stand out in the competition.",
                            "target_lang_translations": {
                                "ru": "Его стиль письма слишком <w>стандартный</w>, чтобы выделиться в конкурсе.",
                                "zh": "他的写作风格太<w>老套</w>了，很难在比赛中脱颖而出。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stereotypical"
                    ],
                    "antonyms": [
                        "imaginative"
                    ],
                    "common_phrases": [
                        "conventional plot",
                        "conventional design"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишенный оригинальности или воображения; скучный и предсказуемый.",
                        "zh": "缺乏原创性或想象力的；乏味而且可预测的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шаблонный",
                                "target_lang_sense_clarification": "избитый, неоригинальный"
                            },
                            {
                                "target_lang_word": "стандартный",
                                "target_lang_sense_clarification": "типичный, без изюминки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "老套的",
                                "target_lang_sense_clarification": "缺乏新意，容易让人觉得陈旧"
                            },
                            {
                                "target_lang_word": "公式化的",
                                "target_lang_sense_clarification": "按固定套路，缺乏创意"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c2d7a04-3dcb-3b76-a99d-927e5d9e7ad7",
                    "sense_definition": "Relating to weapons or warfare that do not use nuclear, biological, or chemical agents.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The treaty limits the number of <w>conventional</w> weapons each country can possess.",
                            "target_lang_translations": {
                                "ru": "Договор ограничивает количество <w>обычных</w> вооружений, которыми может обладать каждая страна.",
                                "zh": "该条约限制各国可拥有的<w>常规</w>武器数量。"
                            }
                        },
                        {
                            "text": "The army deployed <w>conventional</w> forces to the border region.",
                            "target_lang_translations": {
                                "ru": "Армия перебросила <w>обычные</w> вооруженные силы в приграничный регион.",
                                "zh": "军方把<w>常规</w>部队部署到了边境地区。"
                            }
                        }
                    ],
                    "antonyms": [
                        "nuclear"
                    ],
                    "common_phrases": [
                        "conventional weapons",
                        "conventional warfare",
                        "conventional forces"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к оружию или военным действиям без использования ядерных, биологических или химических средств.",
                        "zh": "与不使用核、生物或化学手段的武器或战争有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обычный",
                                "target_lang_sense_clarification": "неядерный (о вооружении)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "常规的",
                                "target_lang_sense_clarification": "指非核、非生物、非化学武器或作战方式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9076386c-73b1-3dbb-b269-e466a5c0d3b5",
                    "sense_definition": "Using synthetic fertilizers and pesticides rather than organic methods.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Conventional</w> farming often produces higher yields but may harm the soil.",
                            "target_lang_translations": {
                                "ru": "<w>Традиционное</w> земледелие часто дает более высокие урожаи, но может навредить почве.",
                                "zh": "<w>常规</w>农业往往产量更高，但可能会损害土壤。"
                            }
                        },
                        {
                            "text": "Many consumers are switching from <w>conventional</w> produce to organic options.",
                            "target_lang_translations": {
                                "ru": "Многие потребители переходят с <w>обычных</w> продуктов на органические.",
                                "zh": "许多消费者正从<w>常规</w>农产品转向有机产品。"
                            }
                        }
                    ],
                    "antonyms": [
                        "organic"
                    ],
                    "common_phrases": [
                        "conventional farming",
                        "conventional agriculture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Использующий синтетические удобрения и пестициды, а не органические методы.",
                        "zh": "指使用合成肥料和杀虫剂，而不是采用有机方法的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "традиционный",
                                "target_lang_sense_clarification": "не органический (о сельском хозяйстве)"
                            },
                            {
                                "target_lang_word": "обычный",
                                "target_lang_sense_clarification": "промышленный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "常规的",
                                "target_lang_sense_clarification": "指使用化肥和农药而非有机方法的农业"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8662857a-b76d-38b6-b954-8d48e04ea683",
                    "sense_definition": "In accordance with a bidding convention in card games.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player made a <w>conventional</w> bid to signal the strength of their hand.",
                            "target_lang_translations": {
                                "ru": "Игрок сделал <w>условную</w> заявку, чтобы показать силу своей руки.",
                                "zh": "这名牌手作出了一个<w>约定性</w>叫牌，以表明自己手牌的强弱。"
                            }
                        },
                        {
                            "text": "Understanding <w>conventional</w> plays is essential for advanced bridge strategy.",
                            "target_lang_translations": {
                                "ru": "Понимание <w>условных</w> ходов необходимо для продвинутой стратегии в бридже.",
                                "zh": "理解<w>约定性</w>打法对高级桥牌策略至关重要。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "card games"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Соответствующий условным правилам (конвенциям) в карточных играх.",
                        "zh": "在纸牌游戏中，符合某种叫牌约定或约定规则的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "условный",
                                "target_lang_sense_clarification": "имеющий специальное значение в игре"
                            },
                            {
                                "target_lang_word": "конвенционный",
                                "target_lang_sense_clarification": "термин в бридже"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "约定性的",
                                "target_lang_sense_clarification": "在桥牌等纸牌游戏中，按约定规则具有特殊含义"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5d9903e3-8294-3d1f-8be0-99a989cae217",
                    "sense_definition": "A type of bond or security that pays the holder a fixed cash payment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Investors bought <w>conventionals</w> to ensure a steady income stream.",
                            "target_lang_translations": {
                                "ru": "Инвесторы покупали <w>обычные облигации</w>, чтобы обеспечить стабильный поток доходов.",
                                "zh": "投资者买入<w>固定利率债券</w>，以确保稳定的收入来源。"
                            }
                        },
                        {
                            "text": "The market for <w>conventionals</w> remained stable despite the economic downturn.",
                            "target_lang_translations": {
                                "ru": "Рынок <w>обычных облигаций</w> оставался стабильным, несмотря на экономический спад.",
                                "zh": "尽管经济不景气，<w>固定利率债券</w>市场仍保持稳定。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "finance"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тип облигации или ценной бумаги с фиксированной денежной выплатой.",
                        "zh": "一种向持有人支付固定现金收益的债券或证券。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обычная облигация",
                                "target_lang_sense_clarification": "финансовый инструмент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "固定利率债券",
                                "target_lang_sense_clarification": "按固定金额向持有人支付收益的一类债券或证券"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}