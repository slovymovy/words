                ],
                "translations": [
                    {
                        "translation_id": "b24c33bf-a4b2-4815-9faf-c53f26887a41",
                        "source_entry_id": "7b19f33b-f590-3c50-bd46-e95a04eeca41",
                        "source_sense_id": "70c7c0cb-b64f-3df8-84b1-8431e2b026bc",
                        "target_lang_word": "évaporer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "évaporer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8e7f0bf3-2fbc-3f42-ad2c-28cab77ce2c1",
                                        "entry_id": "bf4c0d93-dda7-39be-b0dd-9121ed4e33c8",
                                        "glosses": [
                                            "Se transformer en vapeur."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f27e3d0-9c10-4a6a-9bf3-ab4cfafda0f5",
                                                "sense_id": "8e7f0bf3-2fbc-3f42-ad2c-28cab77ce2c1",
                                                "text": "Le potelot, ou sulfure de molybdène natif, exposé au feu dans un vaisseau ouvert, exhale du soufre, & s'évapore presque tout entier en fumée blanche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fafb6e77-6fbe-3c68-954b-f7574142d4cd",
                                        "entry_id": "bf4c0d93-dda7-39be-b0dd-9121ed4e33c8",
                                        "glosses": [
                                            "Se dissiper."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7496f85-deba-4009-8f6c-a88c510b85bf",
                                                "sense_id": "fafb6e77-6fbe-3c68-954b-f7574142d4cd",
                                                "text": "En ce moment, les pièces trop chaudes s’attiédissent, l’odeur particulière aux bureaux s’évapore, le silence revient."
                                            },
                                            {
                                                "example_id": "59a27171-853f-4d0f-94d4-27675a1ecb43",
                                                "sense_id": "fafb6e77-6fbe-3c68-954b-f7574142d4cd",
                                                "text": "Au milieu de ces vaines subtilités, la raison, le bon sens s’évapore."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dd6588d-d130-3ec8-8a8f-43e2de936c90",
                                        "entry_id": "bf4c0d93-dda7-39be-b0dd-9121ed4e33c8",
                                        "glosses": [
                                            "Disparaitre sans laisser de trace."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84153f63-8984-4c31-929c-df89cbdc72b5",
                                                "sense_id": "4dd6588d-d130-3ec8-8a8f-43e2de936c90",
                                                "text": "Il était devenu si taciturne et si sauvage que ses camarades de ferme le croyaient un peu fou. Ils l'appelaient entre eux « l’innocent ». C'est le mot dont se servent les Bretons pour désigner ceux dont l’intelligence s’est évaporée et ils les croient visités de Dieu."
                                            },
                                            {
                                                "example_id": "ab59d85b-1dee-42cf-92e1-798154f24fc2",
                                                "sense_id": "4dd6588d-d130-3ec8-8a8f-43e2de936c90",
                                                "text": "La semaine s'évapora avec une rapidité déroutante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0df6f529-bdaa-38c8-876c-aea2f26939f3",
                                        "entry_id": "bf4c0d93-dda7-39be-b0dd-9121ed4e33c8",
                                        "glosses": [
                                            "Faire se dissiper."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ce84a70-0291-48e4-b3d9-e07f74025b35",
                                                "sense_id": "0df6f529-bdaa-38c8-876c-aea2f26939f3",
                                                "text": "Évaporer sa bile, sa mauvaise humeur."
                                            },
                                            {
                                                "example_id": "b0df6dce-375c-42b0-875c-36835767622e",
                                                "sense_id": "0df6f529-bdaa-38c8-876c-aea2f26939f3",
                                                "text": "Faire évaporer une liqueur à feu lent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4436cbd-582f-36db-b431-4ae21ed75aeb",
                                        "entry_id": "bf4c0d93-dda7-39be-b0dd-9121ed4e33c8",
                                        "glosses": [
                                            "Montrer de la légèreté, une certaine légèreté, se dissiper."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
