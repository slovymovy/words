                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee0260fa-6777-49d4-bdf5-1deb46eb5a68",
                                "sense_id": "3c1e15b4-6703-3e18-abae-53b07563cbd6",
                                "text": "„Als der erste Aufruf zum Mittagsgebet aus den Lautsprechern der Moschee an der Hauptstraße dröhnte, gingen Bob und Kolt an der Rückseite des Fabrikgrundstücks in Position.“"
                            },
                            {
                                "example_id": "829719a5-97bd-4821-8d55-0cc0066244ba",
                                "sense_id": "3c1e15b4-6703-3e18-abae-53b07563cbd6",
                                "text": "„Die Trauerhalle der Männer im Jugendclub von Anata öffnete erst in einigen Stunden, nach dem Mittagsgebet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
