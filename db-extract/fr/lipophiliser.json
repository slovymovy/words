                "senses": [
                    {
                        "sense_id": "8d09bd94-404e-391c-b180-d6b056d847d4",
                        "entry_id": "f250df24-4039-3c0a-b6c5-f187a14b6348",
                        "glosses": [
                            "Donner un caractère lipophile à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e122ada0-dd84-4700-9766-8bdfccd3b45f",
                                "sense_id": "8d09bd94-404e-391c-b180-d6b056d847d4",
                                "text": "Afin de lipophiliser les sucres, les différents paramètres de la réaction permettant la synthèse biocatalysée d’un alkyl-sucroéther par condensation d’un sucre et d’un alcool gras en présence d'une phase aqueuse limitée et d’une bêta-glucosidase sont étudiés : influence de l’eau et de l’activité de l’eau, rapport molaire des substrats mis en oeuvre, quantité de biocatalyseur, influence de la température."
                            },
                            {
                                "example_id": "f683013d-1314-4444-a731-3a246109e65b",
                                "sense_id": "8d09bd94-404e-391c-b180-d6b056d847d4",
                                "text": "Une autre tentative consiste à lipophiliser ces AHA en greffant par estérification un composé lipophile (alcool gras, chaínes alkyles)."
                            }
                        ]
                    }
