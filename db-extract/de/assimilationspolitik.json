                ],
                "senses": [
                    {
                        "sense_id": "5498bf92-97fc-3c82-b1b4-1f36312348df",
                        "entry_id": "fdf18814-28a2-3b09-b42c-b9022094ed61",
                        "glosses": [
                            "Politik eines Staates, die die Assimilation/Anpassung von Minderheiten an die Mehrheit zum Ziel hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b94b162-ecee-4726-a4aa-026096b954b2",
                                "sense_id": "5498bf92-97fc-3c82-b1b4-1f36312348df",
                                "text": "„Eine Assimilationspolitik müsste verfolgt werden, die darauf abzielt, dass Immigranten nicht Menschen zweiter Klasse bleiben.“"
                            },
                            {
                                "example_id": "72cfb99b-6703-4d9f-8d94-7692efc7eecc",
                                "sense_id": "5498bf92-97fc-3c82-b1b4-1f36312348df",
                                "text": "Mit der Assimilationspolitik war es jedoch nicht getan und es gab einen Wandel zur Politik des Pluralismus."
                            },
                            {
                                "example_id": "1dc76ea5-2080-42b3-ac34-ecd083bbec47",
                                "sense_id": "5498bf92-97fc-3c82-b1b4-1f36312348df",
                                "text": "Das Problem der Assimilationspolitik lag darin, dass zwar den verschiedenen ethnischen Gruppen Rechte zugesprochen waren, die Gruppen jedoch nicht in der ganzen Gesellschaft verwurzelt waren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
