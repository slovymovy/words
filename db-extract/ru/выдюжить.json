                "senses": [
                    {
                        "sense_id": "11403e10-5c22-3fe8-80c1-7505d3e426ae",
                        "entry_id": "68642f3b-508b-3780-a691-cbf67a3b4080",
                        "glosses": [
                            "прост. выдержать, вытерпеть, выстоять"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1afc3069-972e-4d50-8d57-5fead13d0b82",
                                "sense_id": "11403e10-5c22-3fe8-80c1-7505d3e426ae",
                                "text": "Борются у нас, известно, взамок. У кого, значит, спина не хрустнет да ноги выдюжат."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f3e41c80-bad6-47e6-81fc-03d20b5df395",
                        "source_entry_id": "68642f3b-508b-3780-a691-cbf67a3b4080",
                        "source_sense_id": "11403e10-5c22-3fe8-80c1-7505d3e426ae",
                        "target_lang_word": "endure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "endure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5361b57-1526-3f2b-9e45-723e7829f8e2",
                                        "entry_id": "29b01286-adeb-31c6-b202-2d69f6a8b63b",
                                        "glosses": [
                                            "To continue or carry on, despite obstacles or hardships; to persist."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3368038-b06a-49d2-894e-d609e434e247",
                                                "sense_id": "b5361b57-1526-3f2b-9e45-723e7829f8e2",
                                                "text": "The singer's popularity endured for decades."
                                            },
                                            {
                                                "example_id": "eaff8192-7abd-4de9-a04b-7d275ee88600",
                                                "sense_id": "b5361b57-1526-3f2b-9e45-723e7829f8e2",
                                                "text": "[…] The life that almost dies in me:\nThat dies not, but endures with pain,\n⁠And slowly forms the firmer mind,\n⁠Treasuring the look it cannot find,\nThe words that are not heard again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e56fa9a3-47fe-3b67-8333-b40cd7dc7536",
                                        "entry_id": "29b01286-adeb-31c6-b202-2d69f6a8b63b",
                                        "glosses": [
                                            "To tolerate or put up with something unpleasant."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "299ec86c-b7ff-34e0-9614-6c17a980e085",
                                        "entry_id": "29b01286-adeb-31c6-b202-2d69f6a8b63b",
                                        "glosses": [
                                            "To last."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5c2ccb5-eb9c-4dd6-93c1-aaee62794d4f",
                                                "sense_id": "299ec86c-b7ff-34e0-9614-6c17a980e085",
                                                "text": "Our love will endure forever."
                                            },
                                            {
                                                "example_id": "ec9338cd-81dc-4d78-979e-a6b12c1e6685",
                                                "sense_id": "299ec86c-b7ff-34e0-9614-6c17a980e085",
                                                "text": "He ſhall leane vpon his houſe, but it ſhall not ſtand: he ſhal hold it faſt, but it ſhall not endure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52baf6d0-2f2f-3f39-9a6a-08a69cbbd676",
                                        "entry_id": "29b01286-adeb-31c6-b202-2d69f6a8b63b",
                                        "glosses": [
                                            "To remain firm, as under trial or suffering; to suffer patiently or without yielding; to bear up under adversity; to hold out."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75dfeafc-528c-43ae-b5ee-2291b47b47a8",
                                                "sense_id": "52baf6d0-2f2f-3f39-9a6a-08a69cbbd676",
                                                "text": "Can thine heart indure, or can thine hands be ſtrong in the dayes that I ſhall deale with thee?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd370a61-c7f6-3566-b807-3670daa91f02",
                                        "entry_id": "29b01286-adeb-31c6-b202-2d69f6a8b63b",
                                        "glosses": [
                                            "To suffer patiently."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d11e7ff1-f77a-47a0-b6b7-e206a4a29fa6",
                                                "sense_id": "cd370a61-c7f6-3566-b807-3670daa91f02",
                                                "text": "He endured years of pain."
                                            },
                                            {
                                                "example_id": "f9a7b2c1-c545-4c39-a1c7-3fcb5bdf1186",
                                                "sense_id": "cd370a61-c7f6-3566-b807-3670daa91f02",
                                                "text": "Dirk Kuyt sandwiched a goal in between Carroll's double as City endured a night of total misery, with captain Carlos Tevez limping off early on with a hamstring strain that puts a serious question mark over his participation in Saturday's FA Cup semi-final against Manchester United at Wembley."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3309cbcc-1413-3cc8-b3e1-63706da90af7",
                                        "entry_id": "29b01286-adeb-31c6-b202-2d69f6a8b63b",
                                        "glosses": [
                                            "To indurate."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
