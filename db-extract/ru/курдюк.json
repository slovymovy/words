                ],
                "senses": [
                    {
                        "sense_id": "d46a8b7c-10bd-3754-ba24-f93a08358608",
                        "entry_id": "69f81613-53cf-3f17-8a14-89068dc7535c",
                        "glosses": [
                            "жировое отложение в задней части туловища, у хвоста, у курдючных овец"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9f2e80c-d01c-4fe3-9fb6-fb9d09071d53",
                                "sense_id": "d46a8b7c-10bd-3754-ba24-f93a08358608",
                                "text": "Есть особого рода бараны, отличающиеся огромностью своих курдюков."
                            },
                            {
                                "example_id": "eab35388-6bad-46a1-b49e-61b51330ca5c",
                                "sense_id": "d46a8b7c-10bd-3754-ba24-f93a08358608",
                                "text": "У мясных лавок висели на крючьях, украшенные красными бумажными розами, туши молодых барашков с большими широкими курдюками."
                            },
                            {
                                "example_id": "9fc97620-6d04-413e-804d-46415db90673",
                                "sense_id": "d46a8b7c-10bd-3754-ba24-f93a08358608",
                                "text": "На площади перед главной мечетью задымили костры, в котлах зашипели бараньи курдюки, рис и накрошенная баранина."
                            }
                        ]
                    }
                ],
