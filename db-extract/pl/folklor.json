                "senses": [
                    {
                        "sense_id": "0d9e0e3f-9eab-37b2-b363-a2ea52e59e04",
                        "entry_id": "83be81e8-08b5-3123-89cc-049bce4caec6",
                        "glosses": [
                            "ogół ludowej kultury i twórczości artystycznej, jak baśnie, pieśni, obrzędy, stroje, architektura, kuchnia itp."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22a625af-7097-4b8c-8e20-eb1a6624cd48",
                                "sense_id": "0d9e0e3f-9eab-37b2-b363-a2ea52e59e04",
                                "text": "Wiara w utopce była na tyle mocno zakorzeniona, iż swój oddźwięk znalazła w folklorze chrześcijańskim."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b2592e3c-ae0b-4ea4-bbd2-1d437aad12e4",
                        "source_entry_id": "83be81e8-08b5-3123-89cc-049bce4caec6",
                        "source_sense_id": "0d9e0e3f-9eab-37b2-b363-a2ea52e59e04",
                        "target_lang_word": "folklore",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "folklore",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4beb8b29-6e70-3dbe-9a3f-89b5e89866be",
                                        "entry_id": "64c5a375-d715-38f3-9e87-973824c55e71",
                                        "glosses": [
                                            "The tales, legends, superstitions, and traditions of a particular ethnic population."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3521c093-099c-437b-9c12-538f7ce043c6",
                                                "sense_id": "4beb8b29-6e70-3dbe-9a3f-89b5e89866be",
                                                "text": "[T]here is no true American music but the wild sweet melodies of the Negro slave; the American fairy tales and folk-lore are Indian and African; and, all in all, we black men seem the sole oasis of simple faith and reverence in a dusty desert of dollars and smartness."
                                            },
                                            {
                                                "example_id": "bdb0740c-beee-42e9-a2d4-ddca9f66b207",
                                                "sense_id": "4beb8b29-6e70-3dbe-9a3f-89b5e89866be",
                                                "text": "Why has not England a great mythology? Our folklore has never advanced beyond daintiness, and the greater melodies about our country-side have all issued through the pipes of Greece."
                                            },
                                            {
                                                "example_id": "a9473c76-69e7-443d-b044-87c22bec75c6",
                                                "sense_id": "4beb8b29-6e70-3dbe-9a3f-89b5e89866be",
                                                "text": "“Lisieux is a little town in Normandy,” she said. “I was there a few days with your father, one summer, long ago. It’s a country full of old stories, folklore, and traditions; and the people still believe in the Old Scratch pretty literally. […]”"
                                            },
                                            {
                                                "example_id": "db9ccae2-bb5d-4e2d-93d3-e3408f5fead3",
                                                "sense_id": "4beb8b29-6e70-3dbe-9a3f-89b5e89866be",
                                                "text": "Crossing the ridge she stood at last upon the brink of Kor-ul-GRYF—the horror place of the folklore of her race."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f972e68b-91cd-3d61-a68f-9ad7ebf5a0d3",
                                        "entry_id": "64c5a375-d715-38f3-9e87-973824c55e71",
                                        "glosses": [
                                            "The tales, superstitions etc. of any particular group or community."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "289ea09a-3100-47db-9f6c-47e9c8b47b32",
                                                "sense_id": "f972e68b-91cd-3d61-a68f-9ad7ebf5a0d3",
                                                "text": "A selection of longer items of hacker folklore and humor is included in Appendix A, Hacker Folklore."
                                            },
                                            {
                                                "example_id": "656e60ab-a0cd-47b5-b240-cb13269c539c",
                                                "sense_id": "f972e68b-91cd-3d61-a68f-9ad7ebf5a0d3",
                                                "text": "Foxes boss Rodgers had a smile that illuminated Wembley as he joined Leicester's players in joyous scenes of celebration after the manager and his players had written their name into the club's folklore."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0d9c11b-4bf1-3eb6-ad20-c4debbd48627",
                                        "entry_id": "64c5a375-d715-38f3-9e87-973824c55e71",
                                        "glosses": [
                                            "The collective of proofs or techniques which are widely known among mathematicians, but have never been formally published."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f682064-a7e7-446c-9a1f-c322468cd98f",
                        "source_entry_id": "83be81e8-08b5-3123-89cc-049bce4caec6",
                        "source_sense_id": "0d9e0e3f-9eab-37b2-b363-a2ea52e59e04",
                        "target_lang_word": "folk",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "folk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "744b294d-467e-36f1-b4b0-f06accf373f7",
                                        "entry_id": "4554fa66-845f-3dc1-abea-1322bff63a1d",
                                        "glosses": [
                                            "A people; a tribe or nation; the inhabitants of a region, especially the native inhabitants."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec53dbc3-164c-4752-961e-633607a5ea37",
                                                "sense_id": "744b294d-467e-36f1-b4b0-f06accf373f7",
                                                "text": "The organization of each folk, as such, sprang mainly from war."
                                            },
                                            {
                                                "example_id": "7ba35a66-e152-4685-8b89-e5a8842c1753",
                                                "sense_id": "744b294d-467e-36f1-b4b0-f06accf373f7",
                                                "text": "We thus arrive at a most unexpected imbroglio. The French have become a Germanic folk and the Germanic folk have become Gaulish!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "110e3e0d-65cd-306f-8ab1-c6add681f6a4",
                                        "entry_id": "4554fa66-845f-3dc1-abea-1322bff63a1d",
                                        "glosses": [
                                            "People, persons."
                                        ],
                                        "tags": [
                                            "collective",
                                            "countable",
                                            "plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fadd8aa-af2c-4ff7-8894-eb19c54095a9",
                                                "sense_id": "110e3e0d-65cd-306f-8ab1-c6add681f6a4",
                                                "text": "There were a lot of folk in the streets."
                                            },
                                            {
                                                "example_id": "25b5da8c-baa4-42ba-8c13-0d6857bc2b36",
                                                "sense_id": "110e3e0d-65cd-306f-8ab1-c6add681f6a4",
                                                "text": "Young folk, old folk, everybody come / To our little Sunday School, and have a lot of fun."
                                            },
                                            {
                                                "example_id": "461d22d3-ba91-4295-8e69-573e6a28633a",
                                                "sense_id": "110e3e0d-65cd-306f-8ab1-c6add681f6a4",
                                                "text": "“[…] the awfully hearty sort of Christmas cards that people do send to other people that they don't know at all well. You know. The kind that have mottoes[…]. And then, when you see [the senders], you probably find that they are the most melancholy old folk with malignant diseases. […]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d12004fe-fe45-3f48-b3a7-fe247d76eb62",
                                        "entry_id": "4554fa66-845f-3dc1-abea-1322bff63a1d",
                                        "glosses": [
                                            "One’s relatives, especially one’s parents."
                                        ],
                                        "tags": [
                                            "collective",
                                            "countable",
                                            "plural",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c187d03-3623-46db-9eab-9eb5b62ecbfb",
                                                "sense_id": "d12004fe-fe45-3f48-b3a7-fe247d76eb62",
                                                "text": "I need to call my folks back home."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05d318bf-d658-3bbc-94cd-95c45dcc2b5a",
                                        "entry_id": "4554fa66-845f-3dc1-abea-1322bff63a1d",
                                        "glosses": [
                                            "Ellipsis of folk music."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
