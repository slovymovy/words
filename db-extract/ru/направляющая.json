                            {
                                "target_word": "rail",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83ecbc33-d5e1-3923-9845-1ec8520a542b",
                                        "entry_id": "5fcbb0ab-0364-3a25-967a-84c4bb224f92",
                                        "glosses": [
                                            "To complain violently (against, about)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3bc3ba5-de04-4c23-ba47-7e5b097c6b3e",
                                                "sense_id": "83ecbc33-d5e1-3923-9845-1ec8520a542b",
                                                "text": "Till thou canst raile the seale from off my bond\nThou but offend'st thy Lungs to speake so loud:\nRepaire thy wit good youth, or it will fall\nTo endlesse ruine. I stand heere for Law."
                                            },
                                            {
                                                "example_id": "94e46f4c-10fc-4363-996a-4a8b867da743",
                                                "sense_id": "83ecbc33-d5e1-3923-9845-1ec8520a542b",
                                                "text": "He always said: “Let them rail on; he laughs best who laughs last.”"
                                            },
                                            {
                                                "example_id": "7bfe7132-e99b-41ec-9bcb-2c8e82550794",
                                                "sense_id": "83ecbc33-d5e1-3923-9845-1ec8520a542b",
                                                "text": "The Major’s fury clothed and reclothed itself in words as frantically as a woman up in town for one day’s shopping tries on a succession of garments. He reviled and railed at fate and the general scheme of things, he pitied himself with a strong, deep pity too poignant for tears, he condemned every one with whom he had ever come in contact to endless and abnormal punishments."
                                            },
                                            {
                                                "example_id": "0c285990-ebc0-4c37-a7a7-e872d4fb9530",
                                                "sense_id": "83ecbc33-d5e1-3923-9845-1ec8520a542b",
                                                "text": "Chief Joyi railed against the white man, whom he believed had deliberately sundered the Xhosa tribe, dividing brother from brother."
                                            },
                                            {
                                                "example_id": "2d52203e-f00d-4eac-adff-a17369e61024",
                                                "sense_id": "83ecbc33-d5e1-3923-9845-1ec8520a542b",
                                                "text": "The Queen may be celebrating her jubilee but the Queen's English Society, which has railed against the misuse and deterioration of the English language, is to fold."
                                            }
                                        ]
                                    }
                                ]
                            },
