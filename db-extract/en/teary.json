                    {
                        "translation_id": "ec6baff4-3f53-4d83-a3fe-e3d67c75a6dc",
                        "source_entry_id": "26773af8-d838-38b1-b94f-086ad513540e",
                        "source_sense_description": "filled with tears",
                        "target_lang_word": "larmoyant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "larmoyant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c766489c-8b6d-3cff-8bbf-4eddf60020c5",
                                        "entry_id": "9f59d31e-d0a7-3540-9fa4-afd0fda6d1ff",
                                        "glosses": [
                                            "weinerlich, rührselig, mit übertrieben viel Gefühl und Selbstmitleid"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "literary",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87208e1f-b911-431b-a93f-e5567c955627",
                                                "sense_id": "c766489c-8b6d-3cff-8bbf-4eddf60020c5",
                                                "text": "„Die Menschen der neuen Bundesländer sind durchaus nicht larmoyant, aber sie sind dünnhäutig.“"
                                            },
                                            {
                                                "example_id": "f4748748-c8e0-4716-ba18-8de7006a5bcc",
                                                "sense_id": "c766489c-8b6d-3cff-8bbf-4eddf60020c5",
                                                "text": "„Ein Mann der larmoyanten Abschiedszeremonien ist er nicht.“"
                                            },
                                            {
                                                "example_id": "056bb9b2-2072-4956-8ef4-8a8baca2f5b2",
                                                "sense_id": "c766489c-8b6d-3cff-8bbf-4eddf60020c5",
                                                "text": "„Fasil Isländer läßt den Leser näher an sich heran, erlaubt ihm einen Blick auf eigene Widersprüche, die nicht larmoyant und selbstbezogen, sondern selbstironisch vorgetragen werden.“"
                                            },
                                            {
                                                "example_id": "d3fd9336-dd59-4025-bc35-d13b4f0fb68a",
                                                "sense_id": "c766489c-8b6d-3cff-8bbf-4eddf60020c5",
                                                "text": "„Wer damals die larmoyanten Reaktionen der Dortmunder auf die verspielte Trophäe erlebte, konnte sich bloss wundern [, denn] Wut über das eigene Unvermögen wäre die adäquatere Reaktion gewesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
