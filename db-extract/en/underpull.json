                "senses": [
                    {
                        "sense_id": "f35f9fa1-d455-3f5d-bf5d-2f4de259916b",
                        "entry_id": "12c4b0f2-5b84-30f5-9576-13df1e5979dd",
                        "glosses": [
                            "To exert one's influence secretly."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "465fdda1-80c7-4304-b9ba-6370f47e37f9",
                                "sense_id": "f35f9fa1-d455-3f5d-bf5d-2f4de259916b",
                                "text": "His Lordship, while he was a Student, and during his Incapacity to practise aboveboard, was contented to underpull, as they call it, and managed diverse Suits for his Country Friends and Relations[…]"
                            },
                            {
                                "example_id": "ae3bab9f-2688-421f-8c6a-22e4740ea207",
                                "sense_id": "f35f9fa1-d455-3f5d-bf5d-2f4de259916b",
                                "text": "It may have been that the lower ranks of the apprenticii, in the words of The Compleat Solicitor, underpulled causes during the long term of study then necessary before the rank of utter barrister was attained."
                            }
                        ]
                    },
                    {
                        "sense_id": "788eaec9-a872-3380-b185-63bbac94658d",
                        "entry_id": "12c4b0f2-5b84-30f5-9576-13df1e5979dd",
                        "glosses": [
                            "To pull (any sense) insufficiently."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac67f5bf-9f1d-4e68-95ff-d33f677d94ba",
                                "sense_id": "788eaec9-a872-3380-b185-63bbac94658d",
                                "text": "The common failing is to underpull in these early hours because of fear of overpull ."
                            },
                            {
                                "example_id": "45a76f61-26ee-4b3e-a9ec-16583b22e549",
                                "sense_id": "788eaec9-a872-3380-b185-63bbac94658d",
                                "text": "The tendency is usually to underpull, rather than to exceed the standard tension."
                            },
                            {
                                "example_id": "fb27b2d2-0b4e-4647-8da1-1954ddc4cc5d",
                                "sense_id": "788eaec9-a872-3380-b185-63bbac94658d",
                                "text": "DOE regs allow customers to underpull one month and make up for it the next year, so long as it all events out within the year."
                            },
                            {
                                "example_id": "c3489142-4b3a-4364-9c0a-649091ed1641",
                                "sense_id": "788eaec9-a872-3380-b185-63bbac94658d",
                                "text": "One point to keep in mind is never to underpull in a headwind."
                            }
                        ]
                    }
                ],
