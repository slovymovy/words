                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02260523-400b-4e1d-a3a4-800077e408bd",
                                "sense_id": "f528d4f8-e5a6-312c-a5d8-1caff958b09e",
                                "text": "Zij mag zichzelf daarbij - naar het woord van een onzer collega's - een klinkend getuigenis geven van goed gedrag: onze zittingen zijn vier jaar lang vrij gebleven van elke vreemde inmenging en niet een onfatsoenlijk of inciviek woord is hier gesproken geworden."
                            }
                        ]
                    },
                    {
                        "sense_id": "09b7b03c-c792-321a-9a99-aa48c8463e43",
                        "entry_id": "47ec8189-d1f5-31a5-aaf4-e56477a38a1f",
                        "glosses": [
                            "buitengewoon onmaatschappelijk"
                        ],
