                "senses": [
                    {
                        "sense_id": "f51eb357-cb0f-3707-bbbe-2221d63da115",
                        "entry_id": "659a3cba-afd0-3732-a213-15c77eaac51e",
                        "glosses": [
                            "jeden z gatunków muzycznych"
                        ],
                        "tags": [],
