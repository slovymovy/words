                "senses": [
                    {
                        "sense_id": "8bcc5e8c-816b-3c4b-af35-ab3670e85bf8",
                        "entry_id": "f7197311-3c01-35d9-ba77-ee4c41030d9f",
                        "glosses": [
                            "Salle secondaire séparée de la salle principale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91e139f8-2d5b-40f5-8280-468c24e60b09",
                                "sense_id": "8bcc5e8c-816b-3c4b-af35-ab3670e85bf8",
                                "text": "Comme tout bistro qui se respecte, celui-ci réservait aux habitués une arrière-salle et deux étages de chambres meublées […]."
                            },
                            {
                                "example_id": "b883558f-92ad-4a0a-a265-44962c5d5519",
                                "sense_id": "8bcc5e8c-816b-3c4b-af35-ab3670e85bf8",
                                "text": "Et il faut que notre expérience s'incline devant les idées préconçues et les principes d'un tas de crétins, envoyés à la Chambre parce qu'ils ont bien déliré pendant les trois semaines d'une période électorale dans les arrière-salles de café."
                            },
                            {
                                "example_id": "c34a052c-52cc-46a3-ab1d-5b9ce61bc3f3",
                                "sense_id": "8bcc5e8c-816b-3c4b-af35-ab3670e85bf8",
                                "text": "Gabriel Morange désigna celle de droite, à la poitrine plus opulente. Elle lui adressa un sourire noirci par la noix d'arec et l'attira vers l'arrière-salle où elle s'allongea."
                            }
                        ]
                    }
