                "senses": [
                    {
                        "sense_id": "471f75c7-44d4-341b-98bb-786988b8b8be",
                        "entry_id": "1eb0092f-1904-320a-bae8-5eec3321043c",
                        "glosses": [
                            "Zustand, bei dem etwas schlecht beleuchtet/von wenig Licht erhellt ist; Zustand relativer Dunkelheit"
                        ],
                        "tags": [
                            "meist Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "6e731b46-b1f2-48f2-b4e8-19986afc6da1",
                                "sense_id": "471f75c7-44d4-341b-98bb-786988b8b8be",
                                "text": "„Der Besuch unter Tage ist begehrt – jeden Tag fahren zwei Besuchergruppen ein –, doch auf Dauer muss es anstrengend sein, im Streb zu hocken: arg für den Rücken und die Knie, dazu die Düsterkeit, der Lärm.“"
                            },
                            {
                                "example_id": "e7d5a2e3-b82c-4399-849f-a9b9d0d26580",
                                "sense_id": "471f75c7-44d4-341b-98bb-786988b8b8be",
                                "text": "„Die ungeheure Größe des Gebäudes, seine Düsterkeit und sein tödliches Schweigen ließen einen erschauern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
