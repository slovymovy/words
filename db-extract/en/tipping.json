                        ],
                        "examples": [
                            {
                                "example_id": "0acd6995-c074-403a-a4ce-e2047e7b446d",
                                "sense_id": "7e9ca65c-f8fc-39c5-b293-a61017647b27",
                                "text": "Hat-tippings and cap-doffings are of course of a different nature to more elaborate verbal greetings. In etiquette manuals they may be described as incentives to a conversation, but in practice they seem to have been quite ceremonial."
                            }
                        ]
                    },
                    {
                        "sense_id": "30e3780f-c437-37c7-8e05-47f34b1dbb70",
                        "entry_id": "48d7b6ae-30fb-32d2-a209-cd61a55fbbe6",
                        "glosses": [
                            "The dumping of rubbish."
