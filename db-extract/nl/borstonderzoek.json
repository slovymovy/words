                        "examples": [
                            {
                                "example_id": "d0ca11b0-87cf-4b8b-8175-3e7348561fe0",
                                "sense_id": "0e08f0a7-b0a5-3ecb-932a-70ce25a266e3",
                                "text": "Het Alexander Monro Ziekenhuis in Bilthoven, gespecialiseerd in borstkanker, ondervroeg 400 vrouwen naar hun kennis van borstonderzoek. Daaruit kwam naar voren dat het vaak aan kennis ontbreekt."
                            },
                            {
                                "example_id": "e4f5843f-27e2-4245-9230-c20cbf764dd1",
                                "sense_id": "0e08f0a7-b0a5-3ecb-932a-70ce25a266e3",
                                "text": "Bij een patiënte voerde hij borstonderzoek uit zonder handschoenen te dragen. Bij een man haalde hij met een injectienaald zaadcellen uit de testikels van de man, terwijl die niet was verdoofd."
                            },
                            {
                                "example_id": "f4584e08-b58a-4d9f-8f47-9c83f29f8f2f",
                                "sense_id": "0e08f0a7-b0a5-3ecb-932a-70ce25a266e3",
                                "text": "In Nederland worden vrouwen van 50 tot 75 jaar iedere twee jaar uitgenodigd voor een borstonderzoek."
                            }
                        ]
                    }
