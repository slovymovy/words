                "senses": [
                    {
                        "sense_id": "69230bfe-1767-3a7d-8c4a-60eb3db6abab",
                        "entry_id": "dcf41888-de47-3cf5-b3c5-f3ca04da5437",
                        "glosses": [
                            "Weg, der über festen Grund (Land) fuhrt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8fda433-5885-4fc6-b1cd-28812edcd27a",
                                "sense_id": "69230bfe-1767-3a7d-8c4a-60eb3db6abab",
                                "text": "„Im Süden schließen sich die von der amerikanischen Kordillere geprägten Hochländer von Chiapas, Guatemala, El Salvador und Honduras an und stellen die Landverbindungen ins nördliche Mesoamerika und nach Zentralamerika her.“"
                            },
                            {
                                "example_id": "972775fb-dab5-4ae6-bd9d-3256b0bbfd4e",
                                "sense_id": "69230bfe-1767-3a7d-8c4a-60eb3db6abab",
                                "text": "„Zwischen Asien und Amerika entstand so eine Landverbindung, früher »Beringbrücke« genannt.“"
                            },
                            {
                                "example_id": "95922215-e855-4505-9ed6-30a4fd018101",
                                "sense_id": "69230bfe-1767-3a7d-8c4a-60eb3db6abab",
                                "text": "„In seinem ersten Winter, als das Städtchen im Schnee versunken war und Ari sich beinahe von der Dunkelheit und der Einsamkeit hatte unterkriegen lassen, war die einzige Landverbindung des Fjordes zur Außenwelt der Tunnel Strákagöng gewesen, der bei starkem Schneefall regelmäßig gesperrt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
