                "senses": [
                    {
                        "sense_id": "0820d1c6-d88f-378f-ad23-75a7f8675b0a",
                        "entry_id": "39f47ed9-8918-31bb-acff-837df148e5f4",
                        "glosses": [
                            "ein historisches Cello, das an der Schulter gespielt wurde"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "4a4cb7b0-c65b-4138-8a4e-308f82130f19",
                                "sense_id": "0820d1c6-d88f-378f-ad23-75a7f8675b0a",
                                "text": "„Ich bin überzeugt, dass alle Concerti von Bach in einfacher Besetzung zu spielen sind und dass bei ihm alles, was »Violoncello« heißt, buchstäblich für das »Schultercello« gedacht ist.“"
                            },
                            {
                                "example_id": "9f0aa040-1c33-42fa-8171-8ec21dc27547",
                                "sense_id": "0820d1c6-d88f-378f-ad23-75a7f8675b0a",
                                "text": "„Seit einigen Jahren widmet er sich auch dem Spiel der durch Dmitry Badiarov, nach aktuellen Gesichtspunkten rekonstruierten Violoncello da spalla, einem Schultercello welches in naher Verwandtschaft zur Viola pomposa steht.“"
                            },
                            {
                                "example_id": "6b1e3058-f83f-4d1c-813b-662689ac516f",
                                "sense_id": "0820d1c6-d88f-378f-ad23-75a7f8675b0a",
                                "text": "„Der belgische Barockgeiger und Dirigent Sigiswald Kuijken ließ 2003 von dem Geigenbauer und Musiker Dmitry Badiarov einen Nachbau des sogenannten Violoncello da spalla, dem Schultercello, entwickeln, den er und zahlreiche andere Musiker, nach mehreren erfolgten Verbesserungen, in verschiedenen Bachwerken, in Solosuiten für Violoncello und zahlreichen Cellokonzerten erfolgreich einsetzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
