                "senses": [
                    {
                        "sense_id": "e346340c-4239-34a3-92bb-93b9617dd3e6",
                        "entry_id": "c2ce2998-0c2f-3283-be54-20f0681b4765",
                        "glosses": [
                            "een ronde of ovale brok materiaal dat bestaat uit de onverteerde resten van dieren die door een uil zijn gegeten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fce2cfd-8501-4d85-a38e-13c115ea61da",
                                "sense_id": "e346340c-4239-34a3-92bb-93b9617dd3e6",
                                "text": "De boswachter heeft uilenballen verzameld bij de nestkast van een kerkuil; de kids mogen die uitpluizen. Omdat uilen botjes en haren niet kunnen verteren braken ze die weer uit. Vooral de schedeltjes die erin zitten zijn handig om erachter te komen wat de uil allemaal gegeten heeft."
                            },
                            {
                                "example_id": "aeb5c68c-5bf5-4997-8e1b-a2888e6fbaf7",
                                "sense_id": "e346340c-4239-34a3-92bb-93b9617dd3e6",
                                "text": "Wie dat wil, mag een uilenbal uitpluizen."
                            },
                            {
                                "example_id": "0e4a6938-eeff-4738-becc-72165ddc8b16",
                                "sense_id": "e346340c-4239-34a3-92bb-93b9617dd3e6",
                                "text": "Uilenbal is braaf avontuur: De titel van deze weinig geraffineerde kindermusical verraadt dat het geen goed idee was van de 8-jarige Meral om die wilde huismuis mee te nemen op schoolkamp. Ze kon niet anders: haar moeder dreigde het beestje tijdens haar afwezigheid te vergiftigen."
                            }
                        ]
                    },
                    {
                        "sense_id": "61ca1ada-86ce-3831-a898-ac98c166bf5b",
                        "entry_id": "c2ce2998-0c2f-3283-be54-20f0681b4765",
                        "glosses": [
                            "domoor, vervelend iemand"
                        ],
                        "tags": [
