                "senses": [
                    {
                        "sense_id": "fcffa695-2d97-3abd-90fd-1b38fcadfd4f",
                        "entry_id": "06556be8-aeb5-3ef1-9c0d-9170db4ec124",
                        "glosses": [
                            "Sohn oder Lehrling eines Schusters"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "4f2c464c-2a6f-4686-be83-6d82c3514690",
                                "sense_id": "fcffa695-2d97-3abd-90fd-1b38fcadfd4f",
                                "text": "Der Schusterjunge bringt morgen die Stiefel vorbei."
                            },
                            {
                                "example_id": "843e1e99-2b57-4286-af9f-9583137316e9",
                                "sense_id": "fcffa695-2d97-3abd-90fd-1b38fcadfd4f",
                                "text": "„In diesem Augenblick passiert dem Schusterjungen mit lautem Krach etwas Menschliches.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "63e45459-2598-331c-9fdb-f60e3925c692",
                        "entry_id": "06556be8-aeb5-3ef1-9c0d-9170db4ec124",
                        "glosses": [
                            "eine alleinstehende Zeile am Ende einer Druckseite, die gleichzeitig die erste Zeile eines neuen Absatzes ist"
                        ],
                        "tags": [
                            "Typographie"
                        ],
                        "examples": [
                            {
                                "example_id": "866eb6a8-a072-4bd1-85bd-86226d77f82b",
                                "sense_id": "63e45459-2598-331c-9fdb-f60e3925c692",
                                "text": "Schusterjunge und Hurenkind muss nun wirklich nicht jeder kennen."
                            },
                            {
                                "example_id": "dea67876-5f3c-40c4-b331-f33690b9822e",
                                "sense_id": "63e45459-2598-331c-9fdb-f60e3925c692",
                                "text": "„Heute als klassische Druckfehler bekannte Lapsus wie Schusterjungen und Hurenkinder hingegen begegnen zumindest in der deutschen Fassung des »Mechanismus« gar nicht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "271c03eb-aae8-3761-803d-2e1fbec8350b",
                        "entry_id": "06556be8-aeb5-3ef1-9c0d-9170db4ec124",
                        "glosses": [
