                                "target_lang_sense_clarification": "walking heavily or laboriously"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e118ab8-ef16-3505-b125-58459fcf2984",
                    "sense_definition": "op een handige of soms dubieuze manier proberen geld te verdienen of zaken te regelen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "hosselen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In die arme wijk moet iedereen dagelijks <w>ploeteren</w> om de eindjes aan elkaar te knopen.",
