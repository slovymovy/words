                        "examples": [
                            {
                                "example_id": "45282c5d-f983-4d16-a446-bc4a55036c86",
                                "sense_id": "08cba160-c504-32ac-a53f-73f5914a5233",
                                "text": "Met Jill heeft Marga een sterke band gekregen. \"Dat gebeurde toen ze schoorvoetend vertelde dat ze warme gevoelens voor haar vriendin Saskia koestert. Ik heb haar in mijn armen gesloten. Een prachtmeid.”"
                            },
                            {
                                "example_id": "ad6416ce-c949-4cc8-8027-bfe81fe8f65f",
                                "sense_id": "08cba160-c504-32ac-a53f-73f5914a5233",
                                "text": "Er komen veel reacties op de foto waaronder 'wat een prachtmeid'en 'just like her mom'."
                            },
                            {
                                "example_id": "7820c90f-7e38-41df-8c81-374358cff5b4",
                                "sense_id": "08cba160-c504-32ac-a53f-73f5914a5233",
                                "text": "Overbuurman Leopold Stordiau leerde Diana Winkel kennen als 'gewoon een prachtmeid'."
                            },
                            {
                                "example_id": "74b1a1b3-fb22-40b8-ac4f-8ab5d83d5512",
                                "sense_id": "08cba160-c504-32ac-a53f-73f5914a5233",
                                "text": "Saskia is wat lompig, maar Typex heeft haar gecombineerd met de trekken van Kate Winslet, ook een vrouw met meerdere gezichten. Hij vindt haar een prachtmeid."
                            }
                        ]
                    }
