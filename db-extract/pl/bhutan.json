                "translations": [
                    {
                        "translation_id": "c2f249c4-cb33-44d7-947e-67360419cb4c",
                        "source_entry_id": "2ea457ac-cf44-375d-9e4a-0f100770876e",
                        "source_sense_id": "d0098df8-a3d2-3a3c-addd-e947f72b7cf7",
                        "target_lang_word": "Bhutan",
                        "target_lang_code": "en",
