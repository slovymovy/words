    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "72ea55e3-ceb5-3e2c-b8c3-59276d645594",
                    "sense_definition": "An electronic or mechanical device used for performing mathematical calculations.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "computing_devices",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Students are allowed to use a pocket <w>calculator</w> during the final math exam.",
                            "target_lang_translations": {
                                "ru": "Студентам разрешено пользоваться карманным <w>калькулятором</w> во время выпускного экзамена по математике."
                            }
                        },
                        {
                            "text": "I used an electronic <w>calculator</w> to quickly find the total cost of the items.",
                            "target_lang_translations": {
                                "ru": "Я воспользовался электронным <w>калькулятором</w>, чтобы быстро найти общую стоимость товаров."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pocket calculator",
                        "electronic calculator",
                        "scientific calculator",
                        "graphing calculator"
                    ],
                    "target_lang_definitions": {
                        "ru": "Электронное или механическое устройство, используемое для выполнения математических вычислений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "калькулятор",
                                "target_lang_sense_clarification": "электронное устройство"
                            },
                            {
                                "target_lang_word": "счётная машина",
                                "target_lang_sense_clarification": "механическое устройство"
                            },
                            {
                                "target_lang_word": "арифмометр",
                                "target_lang_sense_clarification": "старинная механическая машина"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "236d6694-1edd-39d6-8cdb-157de5894894",
                    "sense_definition": "A person who performs mathematical calculations as a job or task.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "human_roles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Before modern computers existed, a human <w>calculator</w> would process complex equations by hand.",
                            "target_lang_translations": {
                                "ru": "До появления современных компьютеров живой <w>счётчик</w> обрабатывал сложные уравнения вручную."
                            }
                        },
                        {
                            "text": "She worked as a professional <w>calculator</w> for the engineering firm during the war.",
                            "target_lang_translations": {
                                "ru": "Во время войны она работала профессиональным <w>расчётчиком</w> в инженерной фирме."
                            }
                        }
                    ],
                    "synonyms": [
                        "reckoner"
                    ],
                    "common_phrases": [
                        "human calculator"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to a historical profession before electronic computers."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, чьей работой или задачей является выполнение математических расчетов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "счётчик",
                                "target_lang_sense_clarification": "человек, производящий подсчёты"
                            },
                            {
                                "target_lang_word": "расчётчик",
                                "target_lang_sense_clarification": "специалист по техническим расчётам"
                            },
                            {
                                "target_lang_word": "калькулятор",
                                "target_lang_sense_clarification": "устаревшее название профессии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28fed7a7-cb2e-3d83-baed-bb6a750bb30d",
                    "sense_definition": "A person who schemes or plots carefully, often in a cold or selfish manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "personality_traits",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was known as a cold-blooded <w>calculator</w> who would do anything to get a promotion.",
                            "target_lang_translations": {
                                "ru": "Он был известен как хладнокровный и <w>расчётливый человек</w>, готовый на всё ради повышения."
                            }
                        },
                        {
                            "text": "The shrewd <w>calculator</w> weighed every possible outcome before making his next move.",
                            "target_lang_translations": {
                                "ru": "Проницательный <w>прагматик</w> взвесил все возможные исходы, прежде чем сделать следующий шаг."
                            }
                        }
                    ],
                    "common_phrases": [
                        "shrewd calculator",
                        "cold-blooded calculator"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который тщательно строит планы или интриги, часто холодным или эгоистичным образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расчётливый человек",
                                "target_lang_sense_clarification": "действующий по расчёту"
                            },
                            {
                                "target_lang_word": "прагматик",
                                "target_lang_sense_clarification": "человек, ищущий выгоду"
                            },
                            {
                                "target_lang_word": "интриган",
                                "target_lang_sense_clarification": "человек, строящий козни"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4d1bfed-3381-3bd0-91c4-794e00968229",
                    "sense_definition": "A book or set of mathematical tables used for reference.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "reference_materials",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The navigator consulted a ready <w>calculator</w> to determine the ship's position.",
                            "target_lang_translations": {
                                "ru": "Навигатор сверился с готовой <w>таблицей расчётов</w>, чтобы определить положение корабля."
                            }
                        },
                        {
                            "text": "Old libraries often contain a printed <w>calculator</w> for interest rates and currency conversions.",
                            "target_lang_translations": {
                                "ru": "В старых библиотеках часто встречаются печатные <w>счётные таблицы</w> для процентных ставок и конвертации валют."
                            }
                        }
                    ],
                    "synonyms": [
                        "ready reckoner"
                    ],
                    "common_phrases": [
                        "ready calculator"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English to refer to books."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Книга или набор математических таблиц, используемых для справок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "таблицы расчётов",
                                "target_lang_sense_clarification": "справочные таблицы"
                            },
                            {
                                "target_lang_word": "счётная таблица",
                                "target_lang_sense_clarification": "математический справочник"
                            }
                        ]
                    }
                }
            ]
        }
    ]
