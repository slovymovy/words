{
    "word_family": [
        "squishy"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5c411f05-ac69-31e1-ad28-874ad69dee78",
                    "sense_definition": "To squeeze, compress, or crush something, especially if it is soft or moist.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "compression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sandwich tasted fine, even though it had got <w>squished</w> in his lunchbox.",
                            "target_lang_translations": {
                                "cs": "Ten sendvič chutnal dobře, i když byl v krabičce na svačinu <w>rozmáčknutý</w>."
                            }
                        },
                        {
                            "text": "She <w>squished</w> the insect on her arm before flicking it away.",
                            "target_lang_translations": {
                                "cs": "Hmyz na paži <w>rozmáčkla</w> a pak ho setřásla."
                            }
                        }
                    ],
                    "synonyms": [
                        "condense",
                        "squash",
                        "compress"
                    ],
                    "common_phrases": [
                        "squish together"
                    ],
                    "target_lang_definitions": {
                        "cs": "Stlačit, zmáčknout nebo rozdrtit něco, zejména pokud je to měkké nebo vlhké."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "rozmáčknout",
                                "target_lang_sense_clarification": "rozdrcení nebo deformace měkkého předmětu"
                            },
                            {
                                "target_lang_word": "zmáčknout",
                                "target_lang_sense_clarification": "obecné stlačení"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9364ca9b-7802-3aaf-a2c6-c56e5eb493a4",
                    "sense_definition": "To be compressed or squeezed into a smaller space or shape.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "compression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soft moss <w>squished</w> between my toes as I walked.",
                            "target_lang_translations": {
                                "cs": "Měkký mech mi při chůzi <w>čvachtal</w> mezi prsty u nohou."
                            }
                        },
                        {
                            "text": "The mud <w>squished</w> under our boots with every step we took.",
                            "target_lang_translations": {
                                "cs": "Bláto nám s každým krokem <w>čvachtalo</w> pod botami."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Být stlačen nebo vtěsnán do menšího prostoru či tvaru."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "čvachtat",
                                "target_lang_sense_clarification": "zvuk a pohyb měkkého materiálu pod tlakem"
                            },
                            {
                                "target_lang_word": "stlačit se",
                                "target_lang_sense_clarification": "zmenšení objemu pod tlakem"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fdedd788-24bd-3e7d-9450-44336dd9ddc1",
                    "sense_definition": "The sound or action of something moist being squeezed or crushed.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I heard a loud <w>squish</w> when I stepped into the deep mud.",
                            "target_lang_translations": {
                                "cs": "Když jsem šlápl do hlubokého bláta, ozvalo se hlasité <w>čvachtnutí</w>."
                            }
                        },
                        {
                            "text": "The wet boots made a <w>squish</w> sound on the kitchen floor.",
                            "target_lang_translations": {
                                "cs": "Mokré boty vydávaly na kuchyňské podlaze <w>čvachtavý</w> zvuk."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Zvuk nebo akce, při které je něco vlhkého stlačeno nebo rozdrceno."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "čvachtání",
                                "target_lang_sense_clarification": "zvuk vznikající při šlápnutí do bláta nebo mokra"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f58ed82d-35bb-3e12-9772-9d4b9a969217",
                    "sense_definition": "A non-romantic and platonic infatuation with someone.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She developed a <w>squish</w> on her new classmate because they shared the same hobbies.",
                            "target_lang_translations": {
                                "cs": "Vytvořila si <w>platonické okouzlení</w> ke svému novému spolužákovi, protože měli stejné koníčky."
                            }
                        },
                        {
                            "text": "Having a <w>squish</w> is different from a crush because it is purely platonic.",
                            "target_lang_translations": {
                                "cs": "Mít <w>platonické okouzlení</w> je jiné než mít zamilovanost, protože je to čistě platonické."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used in modern internet and social contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Ne-romantické a platonické okouzlení někým."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "platonické okouzlení",
                                "target_lang_sense_clarification": "ne-romantická náklonnost"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14e6211f-9e68-3738-b74e-fa8298b6aefe",
                    "sense_definition": "A person who holds moderate political views, often used as a derogatory term.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hardline party members often dismiss the <w>squishes</w> as being too weak.",
                            "target_lang_translations": {
                                "cs": "Radikální členové strany často označují tyto <w>měkkoty</w> za příliš slabé."
                            }
                        },
                        {
                            "text": "The candidate was labeled a <w>squish</w> for refusing to take a firm stance.",
                            "target_lang_translations": {
                                "cs": "Kandidát byl označen za <w>měkkotu</w>, protože odmítl zaujmout pevný postoj."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used in political discourse."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Osoba s umírněnými politickými názory, často používané jako hanlivý výraz."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "měkkota",
                                "target_lang_sense_clarification": "politicky slabý nebo nerozhodný člověk"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f9d2bef-00ac-3f6c-820e-6bc6abd8c860",
                    "sense_definition": "A term for marmalade.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spread some <w>squish</w> on her morning toast.",
                            "target_lang_translations": {
                                "cs": "Namazala si na ranní toast trochu <w>marmelády</w>."
                            }
                        },
                        {
                            "text": "The local shop sells a delicious homemade <w>squish</w>.",
                            "target_lang_translations": {
                                "cs": "V místním obchodě prodávají vynikající domácí <w>marmeládu</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British English, dated or dialectal usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Výraz pro marmeládu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "marmeláda",
                                "target_lang_sense_clarification": "ovocná zavařenina"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}