                        "sense_id": "05a1ed8b-4875-3763-899b-fa08f9e363be",
                        "entry_id": "0cf0682b-0490-37a5-9f30-d73c92cbbb6b",
                        "glosses": [
                            "bedrijf waar kippen worden gehouden"
                        ],
                        "tags": [
                            "veeteelt"
                        ],
                        "examples": [
                            {
                                "example_id": "d47b1606-3e1f-4097-8b7f-cdfcfd10bc0b",
                                "sense_id": "05a1ed8b-4875-3763-899b-fa08f9e363be",
                                "text": "In de Friese plaats Niawier heeft een brand gewoed in twee grote kippenschuren. De brandweer wist te voorkomen dat een derde schuur bij hetzelfde pluimveebedrijf in de as werd gelegd."
                            },
                            {
                                "example_id": "c8221567-c6ea-456a-a9a7-53d378d18d82",
                                "sense_id": "05a1ed8b-4875-3763-899b-fa08f9e363be",
                                "text": "Jaarlijks komen er volgens de krant zo'n half miljard vleeskuikens uit het ei. Dat gebeurt in grote broedkasten. Pas als alle eieren zijn uitgekomen gaan de vogeltjes op transport naar een pluimveebedrijf."
                            }
                        ]
                    }
