                "senses": [
                    {
                        "sense_id": "474b60a0-039a-3835-8222-afb90269f8ac",
                        "entry_id": "5c5b4108-5662-3458-9119-24d4acd7c7be",
                        "glosses": [
                            "weibliche Person, die eigenverantwortlich einen Gastronomiebetrieb leitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa1470be-31b5-4b10-ba3d-5c2ea3154d43",
                                "sense_id": "474b60a0-039a-3835-8222-afb90269f8ac",
                                "text": "„Die Schenke gehörte einer jungen Gastwirtin, einer sehr reichen Witwe. Der Gastwirtin gefiel Jánošík, und er knüpfte mit ihr ein Gespräch an.“"
                            },
                            {
                                "example_id": "992562a6-1a17-4de0-9f77-afbcf23d024a",
                                "sense_id": "474b60a0-039a-3835-8222-afb90269f8ac",
                                "text": "„Wie uns die ältere Gastwirtin später berichtete, artikulierte sich der Junge mit nur wenigen einzelnen Worten.“"
                            },
                            {
                                "example_id": "9fb6ffc7-2eca-4e4a-a653-243a4a131f1c",
                                "sense_id": "474b60a0-039a-3835-8222-afb90269f8ac",
                                "text": "„Ich fügte mich in mein Schicksal und ging mit ihm weiter nach Somma, wo die Gastwirtin, eine seltene Schönheit, uns ein Mittagessen auftischte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
