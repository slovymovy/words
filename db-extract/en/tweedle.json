    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "207e5104-7051-3145-9019-9d7dee86eb18",
                "word": "tweedle",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2287f6ce-8bb3-4aba-9c3e-0f4dcc03ddeb",
                        "entry_id": "207e5104-7051-3145-9019-9d7dee86eb18",
                        "tags": [
                            "plural"
                        ],
                        "form": "tweedles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "55f5480f-51dc-3746-9d62-4e33a57e7ac5",
                        "entry_id": "207e5104-7051-3145-9019-9d7dee86eb18",
                        "glosses": [
                            "A sound of the kind made by a fiddle."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c9980175-12ba-39d0-9341-37d2a893279a",
                        "entry_id": "207e5104-7051-3145-9019-9d7dee86eb18",
                        "glosses": [
                            "A confidence trick in which fake jewellery is sold as genuine."
                        ],
                        "tags": [
                            "UK",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "33dd244f-a8a1-4086-8658-bff6c90a7b12",
                                "sense_id": "c9980175-12ba-39d0-9341-37d2a893279a",
                                "text": "Reggie had a way with him. People trusted him, and he could always pick up a few pounds when he needed them from the jargoons and the tweedle."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "8db1abdd-1f2f-3dbd-a20d-ce8f46586bf3",
                "word": "tweedle",
                "pos": "verb",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "67f4e86a-129d-4991-bd5a-1aed78101aef",
                        "entry_id": "8db1abdd-1f2f-3dbd-a20d-ce8f46586bf3",
                        "tags": [
                            "present",
                            "singular",
                            "third-person"
                        ],
                        "form": "tweedles"
                    },
                    {
                        "form_id": "4b254e6a-c8bb-427b-aac4-203c57c3facb",
                        "entry_id": "8db1abdd-1f2f-3dbd-a20d-ce8f46586bf3",
                        "tags": [
                            "participle",
                            "present"
                        ],
                        "form": "tweedling"
                    },
                    {
                        "form_id": "7e0b0441-53a0-44f0-b216-a573bbd2d669",
                        "entry_id": "8db1abdd-1f2f-3dbd-a20d-ce8f46586bf3",
                        "tags": [
                            "participle",
                            "past"
                        ],
                        "form": "tweedled"
                    },
                    {
                        "form_id": "767a39ef-6dc6-4011-bca6-5149777e421e",
                        "entry_id": "8db1abdd-1f2f-3dbd-a20d-ce8f46586bf3",
                        "tags": [
                            "past"
                        ],
                        "form": "tweedled"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "66e6cab5-c2ff-31e5-894f-d67d92a88187",
                        "entry_id": "8db1abdd-1f2f-3dbd-a20d-ce8f46586bf3",
                        "glosses": [
                            "To handle lightly; said with reference to awkward playing on a fiddle."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b866c8d3-5146-4fb9-b076-c3c924589d95",
                                "sense_id": "66e6cab5-c2ff-31e5-894f-d67d92a88187",
                                "text": "“Neaw, owd lad,” said he, as he screwed, first one peg, then another, and tweedled over little fits of wailing prelude, to get the tones he wanted."
                            },
                            {
                                "example_id": "567e5158-991f-4dd6-a0f2-5a729636c447",
                                "sense_id": "66e6cab5-c2ff-31e5-894f-d67d92a88187",
                                "text": "Hark, —his tortured catgut squals He tickles every string, to every note He bends his pliant neck.—The fond yielding Maid Is tweedled into Love."
                            }
                        ]
                    },
                    {
                        "sense_id": "c88a1e36-e479-33dd-a70c-9b0f3f0cabfa",
                        "entry_id": "8db1abdd-1f2f-3dbd-a20d-ce8f46586bf3",
                        "glosses": [
                            "To influence as if by fiddling; to coax; to allure."
                        ],
                        "tags": [
                            "broadly",
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "732ef061-893c-461a-99bb-504ed313b1a3",
                                "sense_id": "c88a1e36-e479-33dd-a70c-9b0f3f0cabfa",
                                "text": "A fiddler brought in with him a body of lusty young fellows, whom he had tweedled into the service."
                            },
                            {
                                "example_id": "359dd1e2-5fdd-497e-8dc4-e2039d72c992",
                                "sense_id": "c88a1e36-e479-33dd-a70c-9b0f3f0cabfa",
                                "text": "But I tweedled him into letting you try, and here you are, a real member of the company."
                            }
                        ]
                    },
                    {
                        "sense_id": "4c1c112f-3edc-353b-bcd6-0df1a08130b9",
                        "entry_id": "8db1abdd-1f2f-3dbd-a20d-ce8f46586bf3",
                        "glosses": [
                            "To twiddle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe0bfd07-737a-4c2b-88e9-c7c4c2151422",
                                "sense_id": "4c1c112f-3edc-353b-bcd6-0df1a08130b9",
                                "text": "As it was, he tweedled the letter about in his hands for about five minutes, in a musing mood, and then stepped with it into Mr. Gammon's room."
                            },
                            {
                                "example_id": "d1d40799-ed76-4a0b-b915-9ed9bf8143e5",
                                "sense_id": "4c1c112f-3edc-353b-bcd6-0df1a08130b9",
                                "text": "Bob Pirgivie now tweedled his thumbs in double quick time, and rapidly sent around queer horizontal glances under his shaggy brows."
                            },
                            {
                                "example_id": "0494a54d-aca9-4ec9-8bda-7bbfba0dff81",
                                "sense_id": "4c1c112f-3edc-353b-bcd6-0df1a08130b9",
                                "text": "He blinked slowly and tweedled his long brown mustache between his fingers."
                            },
                            {
                                "example_id": "f8e40df0-a69d-4f3e-b92e-ad3a187eadfc",
                                "sense_id": "4c1c112f-3edc-353b-bcd6-0df1a08130b9",
                                "text": "Mary noticed Gaby absently tweedling the green ribbon hanging from her coat's buttonhole."
                            },
                            {
                                "example_id": "3ed3b735-acf1-433a-a10a-abfd22db490e",
                                "sense_id": "4c1c112f-3edc-353b-bcd6-0df1a08130b9",
                                "text": "John Hammerkein, the bulky, slow-voiced communications officer, tweedled knobs in the far corner, under the bulletin board where the field's traffic pattern was posted."
                            },
                            {
                                "example_id": "1b02b027-2264-4617-9c29-319ce0ba5ca5",
                                "sense_id": "4c1c112f-3edc-353b-bcd6-0df1a08130b9",
                                "text": "he (Driver) leaned back in his easy chair and playfully tweedled the ears of his devoted dog, who was curled up cat-like fashion in his master's lap."
                            }
                        ]
                    },
                    {
                        "sense_id": "54fcd757-b827-3a4e-bb4d-42af863f333f",
                        "entry_id": "8db1abdd-1f2f-3dbd-a20d-ce8f46586bf3",
                        "glosses": [
                            "To sell fake jewellery as genuine."
                        ],
                        "tags": [
                            "UK",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "dd66ef88-ddb2-4d65-b7b6-c7e31b8f83c2",
                                "sense_id": "54fcd757-b827-3a4e-bb4d-42af863f333f",
                                "text": "I am afraid that the knowing author of the “cracking a-crib” book would be flummoxed by tweedling."
                            },
                            {
                                "example_id": "c342fed2-8cfd-4f4f-a319-ee48051b6f18",
                                "sense_id": "54fcd757-b827-3a4e-bb4d-42af863f333f",
                                "text": "Girls, smokes, bit of smack, mossing, tweedling; a very democratic villain, Mr Salvatore."
                            }
                        ]
                    },
                    {
                        "sense_id": "0af39816-7fa0-34e3-b17d-0e197c2d9ba5",
                        "entry_id": "8db1abdd-1f2f-3dbd-a20d-ce8f46586bf3",
                        "glosses": [
                            "To make a shrill or trilling sound"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea1df8d0-0abe-449a-b6d6-d9c5fddbf23d",
                                "sense_id": "0af39816-7fa0-34e3-b17d-0e197c2d9ba5",
                                "text": "Yesterday I dined at the Percivals, and tweedled away upon a lovely harpsichord, and I was not bid to “mind my time.”"
                            },
                            {
                                "example_id": "eb2c687e-d339-4835-9c13-45d831085398",
                                "sense_id": "0af39816-7fa0-34e3-b17d-0e197c2d9ba5",
                                "text": "Something tweedled, and Temple jumped. Every new car had its own literal bells and whistles that told you to take the key out of the ignition, or put your seat belt on, or to turn off your headlights."
                            },
                            {
                                "example_id": "4407f5c3-c5f2-4b75-8577-cd0448da2830",
                                "sense_id": "0af39816-7fa0-34e3-b17d-0e197c2d9ba5",
                                "text": "From deep inside my purse, my cell phone tweedled the opening bars of “Start Me Up.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "458abcca-9842-389c-af74-f17f90ab1bdb",
                        "entry_id": "8db1abdd-1f2f-3dbd-a20d-ce8f46586bf3",
                        "glosses": [
                            "To say in a high-pitched voice."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1f2c42c-dde7-43aa-8451-0eb601e3524e",
                                "sense_id": "458abcca-9842-389c-af74-f17f90ab1bdb",
                                "text": "Hurt that the Churts and I were exchanging fatuities over yet another second-rate painting instead of tweedling appreciatively over the extraordinary and beautiful child she was rocking on the other side of the room?"
                            },
                            {
                                "example_id": "1487bdc0-ee3c-4fe2-a77f-f84812f23039",
                                "sense_id": "458abcca-9842-389c-af74-f17f90ab1bdb",
                                "text": "\"Oh, bien sur. Monsieur Raphael has only the kindest things to say,\" Azter tweedled. “Always.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "e1f531db-53d9-3620-8fc3-512f17b1dd1d",
                        "entry_id": "8db1abdd-1f2f-3dbd-a20d-ce8f46586bf3",
                        "glosses": [
                            "To trifle or play."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e35611f0-8cb4-40b0-8bdd-07f99fe993f3",
                                "sense_id": "e1f531db-53d9-3620-8fc3-512f17b1dd1d",
                                "text": "That exemption was not intended to be a hair splitting elusive hope to be tweedled away by administrative interpretation."
                            },
                            {
                                "example_id": "7077a2ab-1694-4583-97c9-9a38f868866d",
                                "sense_id": "e1f531db-53d9-3620-8fc3-512f17b1dd1d",
                                "text": "Intellectual tweedling is not within my character."
                            },
                            {
                                "example_id": "914153d3-4b69-4053-95c3-5291ff8ac8da",
                                "sense_id": "e1f531db-53d9-3620-8fc3-512f17b1dd1d",
                                "text": "There aren't many things that make playwriting easy, but the fluency of the English language is a tremendous help. Now if you choose to write in Ur Chinese, you haven't got that, you've only got the meaning of what is being said. And that was bracing, after years of tweedling round with words."
                            },
                            {
                                "example_id": "79c6c2b4-7c47-4b07-b832-ae08a28a0dbf",
                                "sense_id": "e1f531db-53d9-3620-8fc3-512f17b1dd1d",
                                "text": "The organization is not to be tweedled with."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e3fff17-d7be-3c10-8272-935768c7af6a",
                        "entry_id": "8db1abdd-1f2f-3dbd-a20d-ce8f46586bf3",
                        "glosses": [
                            "To go; to proceed without much enthusiasm."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0154830c-6c3d-4bc6-8a1b-e66b944a0c6b",
                                "sense_id": "1e3fff17-d7be-3c10-8272-935768c7af6a",
                                "text": "You all have undoubtedly noticed men in the rural pursuits tweedling along through life and finally end it all identical with what it was when they began: no better, no worse."
                            },
                            {
                                "example_id": "6258c25b-e764-4541-ab19-fe04671bab38",
                                "sense_id": "1e3fff17-d7be-3c10-8272-935768c7af6a",
                                "text": "moving slowly but moving nonetheless; and close enough that if I quit and he kept tweedling along, he would finish with more miles than I and I'd be even more depressed long after I stopped shivering. He did keep tweedling along, but so did I."
                            },
                            {
                                "example_id": "6dc2b0ac-7f6f-450f-92b7-05a095cb786a",
                                "sense_id": "1e3fff17-d7be-3c10-8272-935768c7af6a",
                                "text": "What was discretion but chickenheartedness and a capitulation to age? If I tweedled back to Saratoga without doing anything, then I might as well kiss Rosemary good-bye."
                            },
                            {
                                "example_id": "aa8564c5-f944-41e7-bf0c-7fe2a21906e6",
                                "sense_id": "1e3fff17-d7be-3c10-8272-935768c7af6a",
                                "text": "In the first part of the scene, the Frenchman dominates the monkey while tweedling along blithely as his Saint-Dominguan servants look with confusion on what surrounds them."
                            }
                        ]
                    },
                    {
                        "sense_id": "71988489-3cb1-3da2-8934-6b375cdf91c9",
                        "entry_id": "8db1abdd-1f2f-3dbd-a20d-ce8f46586bf3",
                        "glosses": [
                            "To move or speak in unison (like Tweedledum and Tweedledee)"
                        ],
                        "tags": [
                            "of two people"
                        ],
                        "examples": [
                            {
                                "example_id": "9c7976e9-8e72-4ecf-aed3-36437eb58fe7",
                                "sense_id": "71988489-3cb1-3da2-8934-6b375cdf91c9",
                                "text": "\"I shall feel myself a failure as a chaperone surely,\" remarked Mrs.Green. \"We think you a tremendous success,\" tweedled the twins."
                            },
                            {
                                "example_id": "91c41eac-dca5-4f81-9b23-462c7d8d8d26",
                                "sense_id": "71988489-3cb1-3da2-8934-6b375cdf91c9",
                                "text": "“Why, they're tweedling now, \" said little Frankie and sure enough they were, and tweedling in perfect unison too, without any expression whatsoever.“"
                            },
                            {
                                "example_id": "bf48ce91-6044-4381-adb5-0200af075d56",
                                "sense_id": "71988489-3cb1-3da2-8934-6b375cdf91c9",
                                "text": "\"[…] cold storage,” soothed Page Allison. “Not a chance,” tweedled the twins."
                            }
                        ]
                    }
                ],
