                                        "glosses": [
                                            "tropischer Wirbelsturm im Indischen Ozean oder im Südpazifik"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7df6ac56-c59d-4d66-be09-2c519a513cc0",
                                                "sense_id": "4102532a-e131-349f-bdaa-0ec7f3aaa837",
                                                "text": "Ein Zyklon droht die Küstenstadt zu treffen."
                                            },
                                            {
                                                "example_id": "97a54ea6-96c6-4798-8ff4-13f424a95f0a",
                                                "sense_id": "4102532a-e131-349f-bdaa-0ec7f3aaa837",
                                                "text": "„Im Auge des Zyklons herrscht Ruhe.“"
                                            },
                                            {
                                                "example_id": "1d8b1eca-426f-4414-8c83-2f03378d3a7a",
                                                "sense_id": "4102532a-e131-349f-bdaa-0ec7f3aaa837",
                                                "text": "„Sie wurde von dieser Angst angesteckt und zitterte, als sollte sie von einem jähen Zyklon erfaßt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
