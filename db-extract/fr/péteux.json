        "fr-extract.jsonl": [
            {
                "entry_id": "5a8d2701-8513-374c-a8aa-355d3a7119aa",
                "word": "péteux",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d0c4adb8-b9d9-4578-aa0a-142cc571aed4",
                        "entry_id": "5a8d2701-8513-374c-a8aa-355d3a7119aa",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "péteuse"
                    },
                    {
                        "form_id": "6069a7bd-b40c-4afb-96a5-19f5620ea845",
                        "entry_id": "5a8d2701-8513-374c-a8aa-355d3a7119aa",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "péteuses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "19111772-0b8e-3a65-8006-bf741c50b756",
                        "entry_id": "5a8d2701-8513-374c-a8aa-355d3a7119aa",
                        "glosses": [
                            "Peureux, pleutre."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "1853b157-1b82-4795-b6cf-551085c2410d",
                                "sense_id": "19111772-0b8e-3a65-8006-bf741c50b756",
                                "text": "Il y a une femme malade. Il faut que je la sorte et que je la mette au soleil pour la réchauffer et pour empêcher que cette bande de péteux ne crève de peur."
                            },
                            {
                                "example_id": "1b91f154-e87d-4caa-b84f-67da003097b1",
                                "sense_id": "19111772-0b8e-3a65-8006-bf741c50b756",
                                "text": "Chalumot, c’est mon copain, d’accord, mais j’avais repéré, avant, qu’il était à la hauteur, lui. Plus qu’toi, qui t’crois l’caïd parce que t’es d’La Boissière. Sauf qu’avec Moustache t’es drôlement péteux !"
                            },
                            {
                                "example_id": "2d552b3d-2493-4d20-828d-d291d0a68787",
                                "sense_id": "19111772-0b8e-3a65-8006-bf741c50b756",
                                "text": "Toujours prêts comme ils disent à foutre le bordel, au restau, à la cafétéria, devant les portes des amphis, mais bien sages à l’intérieur, un de mes étonnements. Pourtant j’en avais vu des blablateurs de première dans mon café, et des agités sur leur scooter, des péteux en réalité, je ne pensais pas en trouver à la fac, naïveté."
                            },
                            {
                                "example_id": "e9bae9d1-ef7b-4440-885a-805c583ed1d9",
                                "sense_id": "19111772-0b8e-3a65-8006-bf741c50b756",
                                "text": "Il est si péteux qu’il s’est laissé faire sans rien dire."
                            },
                            {
                                "example_id": "86aab38e-453e-4f00-a200-cdd1b65de12e",
                                "sense_id": "19111772-0b8e-3a65-8006-bf741c50b756",
                                "text": "Je commence à en avoir plein le dos de votre comportement de péteux ! Vous allez me faire le plaisir de me faire une bonne insulte, et de vous foutre en rogne une bonne fois pour toutes !"
                            }
                        ]
                    },
                    {
                        "sense_id": "82f7ea06-b5ea-35eb-af12-92975b53be39",
                        "entry_id": "5a8d2701-8513-374c-a8aa-355d3a7119aa",
                        "glosses": [
                            "Prétentieux et snob, qui se la pète."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a7d1d97-ab41-49c9-ad05-53a8f51f4e0d",
                        "source_entry_id": "5a8d2701-8513-374c-a8aa-355d3a7119aa",
                        "source_sense_id": "19111772-0b8e-3a65-8006-bf741c50b756",
                        "source_sense_description": "(France) Peureux, pleutre",
                        "target_lang_word": "ängstlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ängstlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64b5117c-5530-3df9-81a6-a7b5d42fdc20",
                                        "entry_id": "10a2f5f0-0396-3165-9c1e-9a0166b9d16a",
                                        "glosses": [
                                            "von Angst ergriffen, erfüllt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a568197-0069-4c44-ba60-2f7f001eac3b",
                                                "sense_id": "64b5117c-5530-3df9-81a6-a7b5d42fdc20",
                                                "text": "„… allmählich verschwanden die Menschen, ich armes Kind irrte ängstlich umher, stand endlich vor der Weidenhecke eines wüsten Bauerhofes und sah dort einen Mann, der mit dem Spaten die Erde aufwühlte, und neben ihm ein häßlich hämisches Weib, das etwas wie einen abgeschnittenen Menschenkopf in der Schürze hielt, …“ (Heinrich Heine:Heinrich Heine: „Ideen. Das Buch Le Grand“)"
                                            },
                                            {
                                                "example_id": "c5db7cae-8d27-458f-812b-c8d2653518d0",
                                                "sense_id": "64b5117c-5530-3df9-81a6-a7b5d42fdc20",
                                                "text": "Nun sei doch nicht so ängstlich, der Hund tut dir nichts!"
                                            },
                                            {
                                                "example_id": "18fa6369-5a38-49d1-a054-bdbac6cba1ec",
                                                "sense_id": "64b5117c-5530-3df9-81a6-a7b5d42fdc20",
                                                "text": "Sie warf ihrem Vater einen ängstlichen Blick zu."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "af2b0f15-2311-308c-9511-e311fe1fccf7",
                                        "entry_id": "10a2f5f0-0396-3165-9c1e-9a0166b9d16a",
                                        "glosses": [
                                            "peinlich genau, akkurat"
                                        ],
                                        "tags": [
                                            "adverbiell"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "def51077-74aa-4af9-80f9-014f7225adca",
                                                "sense_id": "af2b0f15-2311-308c-9511-e311fe1fccf7",
                                                "text": "Peter ist immer so ängstlich bemüht, ja kein Frage zu verpassen."
                                            },
                                            {
                                                "example_id": "85e31e26-0561-4376-b290-86c8905d3a3e",
                                                "sense_id": "af2b0f15-2311-308c-9511-e311fe1fccf7",
                                                "text": "Der Revisor ist ängstlich bestrebt, keinen Fehler zu machen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "66dd821f-20c7-3a94-acdf-3a3f29c8903e",
                                        "entry_id": "10a2f5f0-0396-3165-9c1e-9a0166b9d16a",
                                        "glosses": [
                                            "nicht so eilig, nicht so genau"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e804bc20-fb11-4edf-9523-ef6829169e4f",
                                                "sense_id": "66dd821f-20c7-3a94-acdf-3a3f29c8903e",
                                                "text": "Das ist jetzt nicht so ängstlich mit der Post, die kann auch morgen raus."
                                            },
                                            {
                                                "example_id": "2f73b0aa-aa9c-4392-aade-d90aeda3d57a",
                                                "sense_id": "66dd821f-20c7-3a94-acdf-3a3f29c8903e",
                                                "text": "Du musst nicht so ängstlich mit der Temperaturwahl sein, ein paar Grad mehr oder weniger spielen hier keine Rolle."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
