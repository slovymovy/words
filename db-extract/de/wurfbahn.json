                        "sense_id": "38e29e73-31ec-3e4f-8c30-65caec858e34",
                        "entry_id": "2de24b34-686f-3aff-ba47-23c6b866d369",
                        "glosses": [
                            "Bahn, die ein geworfenes Objekt beschreibt"
                        ],
                        "tags": [
                            "Mechanik"
                        ],
                        "examples": [
                            {
                                "example_id": "2dd0c704-ad6f-42b6-8f41-71ef9c54ac7a",
                                "sense_id": "38e29e73-31ec-3e4f-8c30-65caec858e34",
                                "text": "„Ob Stein, Ball, Speer, Pfeil oder Gewehrkugel: Ein Projektil in einer ballistischen Wurfbahn mit hoher Genauigkeit ins Ziel zu lenken, erfordert komplexe Planungs- und Rechenarbeit im Gehirn (siehe Grafik oben: „Modell-Welten im Kopf\").“"
                            },
                            {
                                "example_id": "d48d1071-4cee-4f0f-a49f-6d4415b396e3",
                                "sense_id": "38e29e73-31ec-3e4f-8c30-65caec858e34",
                                "text": "„Landet die Disc im Gebüsch oder blockiert z.B. ein Baum die Wurfbahn, so muss der Spieler trotzdem von diesem Punkt werfen und darf Äste oder ähnliches vor sich Befindliche nicht aus der Wurfbahn halten, während geworfen wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
