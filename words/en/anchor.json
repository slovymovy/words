{
    "word_family": [
        "anchorage",
        "anchorman",
        "anchorwoman",
        "reanchor",
        "unanchor"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7397f510-069b-3c8d-9c50-3384cdcffe1a",
                    "sense_definition": "A heavy metal object attached to a chain or rope and dropped from a boat into the water to prevent the boat from moving.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "nautical_tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain ordered the crew to drop <w>anchor</w> in the calm bay.",
                            "target_lang_translations": {
                                "ru": "Капитан приказал команде бросить <w>якорь</w> в спокойной бухте.",
                                "zh": "船长命令船员在平静的海湾抛<w>锚</w>。"
                            }
                        },
                        {
                            "text": "We waited at <w>anchor</w> until the storm passed.",
                            "target_lang_translations": {
                                "ru": "Мы стояли на <w>якоре</w>, пока шторм не прошел.",
                                "zh": "我们一直下<w>锚</w>停泊，直到风暴过去。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "drop anchor",
                        "weigh anchor",
                        "at anchor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тяжелый металлический предмет, прикрепленный к цепи или веревке, который сбрасывают с лодки в воду, чтобы предотвратить движение лодки.",
                        "zh": "一种系在链条或绳索末端，从船上抛入水中以防止船只移动的重金属物体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "якорь",
                                "target_lang_sense_clarification": "морской термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "锚",
                                "target_lang_sense_clarification": "航海术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a379f29c-f522-3f8e-8c81-fe9699938db3",
                    "sense_definition": "A person who presents and coordinates a live television or radio news programme.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "broadcasting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The news <w>anchor</w> reported on the election results with great professionalism.",
                            "target_lang_translations": {
                                "ru": "<w>Ведущий</w> новостей сообщил о результатах выборов с большим профессионализмом.",
                                "zh": "新闻<w>主播</w>非常专业地报道了选举结果。"
                            }
                        },
                        {
                            "text": "She worked as a local <w>anchor</w> before moving to a national network.",
                            "target_lang_translations": {
                                "ru": "Она работала местной <w>ведущей</w> до перехода на национальный канал.",
                                "zh": "在进入全国性电视网之前，她曾担任地方台的<w>主播</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "news anchor",
                        "television anchor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который ведет и координирует теле- или радиопрограмму новостей в прямом эфире.",
                        "zh": "负责主持和协调电视或广播新闻直播节目的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ведущий",
                                "target_lang_sense_clarification": "программы"
                            },
                            {
                                "target_lang_word": "телеведущий",
                                "target_lang_sense_clarification": "на телевидении"
                            },
                            {
                                "target_lang_word": "диктор",
                                "target_lang_sense_clarification": "новостей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "主播",
                                "target_lang_sense_clarification": "新闻节目主持人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e23079f1-e5ac-313a-805d-bc806d1d3248",
                    "sense_definition": "A person or thing that provides strength, stability, or security in a difficult situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stability_figurative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her grandmother remained the <w>anchor</w> of the family throughout the crisis.",
                            "target_lang_translations": {
                                "ru": "Ее бабушка оставалась <w>опорой</w> семьи на протяжении всего кризиса.",
                                "zh": "在整个危机期间，她的祖母始终是这个家庭的<w>支柱</w>。"
                            }
                        },
                        {
                            "text": "Faith served as an <w>anchor</w> for him during the hardest times of his life.",
                            "target_lang_translations": {
                                "ru": "Вера служила ему <w>якорем</w> в самые тяжелые времена его жизни.",
                                "zh": "信仰在他人生最艰难的时刻成为了他的<w>精神寄托</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "anchor of the family"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или вещь, обеспечивающие силу, стабильность или безопасность в трудной ситуации.",
                        "zh": "在困难情况下提供力量、稳定性或安全感的人或事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опора",
                                "target_lang_sense_clarification": "переносное значение"
                            },
                            {
                                "target_lang_word": "якорь",
                                "target_lang_sense_clarification": "символ надежды"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "支柱",
                                "target_lang_sense_clarification": "比喻义"
                            },
                            {
                                "target_lang_word": "精神寄托",
                                "target_lang_sense_clarification": "比喻义"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "471150e1-f2fe-3f6b-bf6e-81404e28a203",
                    "sense_definition": "A large, popular store in a shopping centre that attracts many customers, helping to support other smaller shops.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "business",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mall developers are looking for a major department store to serve as an <w>anchor</w>.",
                            "target_lang_translations": {
                                "ru": "Застройщики торгового центра ищут крупный универмаг, который послужит <w>якорем</w>.",
                                "zh": "商场开发商正在寻找一家大型百货公司作为<w>主力店</w>。"
                            }
                        },
                        {
                            "text": "Without a strong <w>anchor</w>, the new shopping complex might struggle to get foot traffic.",
                            "target_lang_translations": {
                                "ru": "Без сильного <w>якорного арендатора</w> новому торговому комплексу будет сложно привлечь посетителей.",
                                "zh": "如果没有强大的<w>主力店</w>，这个新的购物中心可能很难吸引客流。"
                            }
                        }
                    ],
                    "synonyms": [
                        "anchor tenant"
                    ],
                    "common_phrases": [
                        "anchor store"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупный популярный магазин в торговом центре, который привлекает много покупателей, помогая поддерживать другие, более мелкие магазины.",
                        "zh": "购物中心内吸引大量顾客并带动其他小型店铺经营的大型热门商店。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "якорный арендатор",
                                "target_lang_sense_clarification": "бизнес"
                            },
                            {
                                "target_lang_word": "магазин-якорь",
                                "target_lang_sense_clarification": "в торговом центре"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "主力店",
                                "target_lang_sense_clarification": "商业术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40732e5e-0f5a-367f-922c-65be5c438d57",
                    "sense_definition": "The final runner in a relay race.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our fastest sprinter ran as the <w>anchor</w> and secured the gold medal.",
                            "target_lang_translations": {
                                "ru": "Наш самый быстрый спринтер бежал <w>замыкающим</w> и обеспечил золотую медаль.",
                                "zh": "我们跑得最快的短跑选手担任<w>最后一棒</w>，锁定了金牌。"
                            }
                        },
                        {
                            "text": "Being the <w>anchor</w> puts a lot of pressure on an athlete to finish strong.",
                            "target_lang_translations": {
                                "ru": "Роль <w>замыкающего</w> оказывает большое давление на спортсмена, требуя сильного финиша.",
                                "zh": "作为<w>最后一棒</w>，运动员在冲刺阶段承受着巨大的压力。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "relay anchor",
                        "anchor leg"
                    ],
                    "target_lang_definitions": {
                        "ru": "Последний бегун в эстафете.",
                        "zh": "接力赛中的最后一棒选手。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замыкающий",
                                "target_lang_sense_clarification": "в эстафете"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "最后一棒",
                                "target_lang_sense_clarification": "体育术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7532cd6b-52cb-3b46-b3f8-7bfa0f3ec89b",
                    "sense_definition": "A specific marked point in a digital document or webpage that can be the target of a hyperlink.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Clicking the link takes you directly to the <w>anchor</w> at the bottom of the page.",
                            "target_lang_translations": {
                                "ru": "Нажатие на ссылку перенаправляет вас прямо к <w>якорю</w> внизу страницы.",
                                "zh": "点击链接会直接跳转到页面底部的<w>锚点</w>。"
                            }
                        },
                        {
                            "text": "You need to set an <w>anchor</w> in the text so users can jump to this section easily.",
                            "target_lang_translations": {
                                "ru": "Вам нужно установить <w>якорь</w> в тексте, чтобы пользователи могли легко перейти к этому разделу.",
                                "zh": "你需要在文本中设置一个<w>锚点</w>，以便用户能轻松跳转到这一节。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "anchor tag",
                        "text anchor"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Специально отмеченная точка в цифровом документе или на веб-странице, которая может быть целью гиперссылки.",
                        "zh": "数字文档或网页中作为超链接目标的特定标记点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "якорь",
                                "target_lang_sense_clarification": "веб-разработка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "锚点",
                                "target_lang_sense_clarification": "网页开发"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4dad9c2-b592-3de3-bf7b-47051ca7dd5e",
                    "sense_definition": "The brakes of a vehicle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slang_brakes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He slammed on the <w>anchors</w> to avoid hitting the deer crossing the road.",
                            "target_lang_translations": {
                                "ru": "Он ударил по <w>тормозам</w>, чтобы не сбить оленя, перебегавшего дорогу.",
                                "zh": "他猛地<w>刹车</w>，以避免撞到过马路的鹿。"
                            }
                        },
                        {
                            "text": "The traffic suddenly stopped, and everyone had to jump on the <w>anchors</w>.",
                            "target_lang_translations": {
                                "ru": "Движение внезапно остановилось, и всем пришлось давить на <w>тормоза</w>.",
                                "zh": "车流突然停下，每个人都不得不猛踩<w>刹车</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "slam on the anchors"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "used in informal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тормоза транспортного средства.",
                        "zh": "车辆的制动装置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тормоза",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "刹车",
                                "target_lang_sense_clarification": "口语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3562834a-1de9-3836-ac32-efe816f53e98",
                    "sense_definition": "To fasten something firmly to a fixed position so that it cannot move.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stability_figurative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must <w>anchor</w> the bookshelf to the wall for safety.",
                            "target_lang_translations": {
                                "ru": "Вы должны <w>прикрепить</w> книжную полку к стене для безопасности.",
                                "zh": "为了安全起见，你必须把书架<w>固定</w>在墙上。"
                            }
                        },
                        {
                            "text": "The tent was securely <w>anchored</w> to the ground to withstand the wind.",
                            "target_lang_translations": {
                                "ru": "Палатка была надежно <w>закреплена</w> на земле, чтобы выдержать ветер.",
                                "zh": "帐篷被牢牢地<w>锚定</w>在地面上以抵御风力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fix",
                        "affix"
                    ],
                    "common_phrases": [
                        "anchor securely",
                        "anchor to the ground"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прочно прикрепить что-либо к фиксированному положению, чтобы оно не могло двигаться.",
                        "zh": "将某物牢固地固定在特定位置，使其无法移动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закреплять",
                                "target_lang_sense_clarification": "фиксировать"
                            },
                            {
                                "target_lang_word": "прикреплять",
                                "target_lang_sense_clarification": "к чему-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "固定",
                                "target_lang_sense_clarification": "使物体不动"
                            },
                            {
                                "target_lang_word": "锚定",
                                "target_lang_sense_clarification": "牢固连接"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47620f45-64bc-35b7-8c54-2eaed4f87b96",
                    "sense_definition": "To lower an anchor into the water to stop a ship or boat from moving.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nautical_tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We <w>anchored</w> off the coast and swam to the shore.",
                            "target_lang_translations": {
                                "ru": "Мы <w>встали на якорь</w> у побережья и поплыли к берегу.",
                                "zh": "我们在离岸不远处<w>抛锚</w>，然后游向岸边。"
                            }
                        },
                        {
                            "text": "The ship <w>anchored</w> in the harbour for the night.",
                            "target_lang_translations": {
                                "ru": "Корабль <w>бросил якорь</w> в гавани на ночь.",
                                "zh": "船只在港口<w>停泊</w>过夜。"
                            }
                        }
                    ],
                    "synonyms": [
                        "drop anchor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Опустить якорь в воду, чтобы остановить движение корабля или лодки.",
                        "zh": "抛下锚以停止船只移动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стать на якорь",
                                "target_lang_sense_clarification": "о судне"
                            },
                            {
                                "target_lang_word": "бросить якорь",
                                "target_lang_sense_clarification": "действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抛锚",
                                "target_lang_sense_clarification": "动作"
                            },
                            {
                                "target_lang_word": "停泊",
                                "target_lang_sense_clarification": "船只状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b5b2f3a-129e-3e30-9584-8b0123f245dd",
                    "sense_definition": "To present and coordinate a television or radio news programme.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "broadcasting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has <w>anchored</w> the evening news for over ten years.",
                            "target_lang_translations": {
                                "ru": "Она <w>вела</w> вечерние новости более десяти лет.",
                                "zh": "她<w>主持</w>晚间新闻已经超过十年了。"
                            }
                        },
                        {
                            "text": "He was chosen to <w>anchor</w> the special coverage of the royal wedding.",
                            "target_lang_translations": {
                                "ru": "Его выбрали <w>вести</w> специальный репортаж о королевской свадьбе.",
                                "zh": "他被选中<w>主持</w>关于皇室婚礼的特别报道。"
                            }
                        }
                    ],
                    "synonyms": [
                        "host",
                        "present"
                    ],
                    "common_phrases": [
                        "anchor the news"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вести и координировать теле- или радиопрограмму новостей.",
                        "zh": "主持和协调电视或广播新闻节目。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вести",
                                "target_lang_sense_clarification": "программу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "主持",
                                "target_lang_sense_clarification": "节目"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62bc5a2f-8825-3151-b003-66ce7dd117a8",
                    "sense_definition": "To provide emotional stability or a firm basis for someone or something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "stability_figurative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His calm presence <w>anchored</w> her during the chaotic event.",
                            "target_lang_translations": {
                                "ru": "Его спокойное присутствие <w>поддерживало</w> ее во время хаотичного события.",
                                "zh": "在他冷静的陪伴下，她在混乱的事件中得到了<w>支撑</w>。"
                            }
                        },
                        {
                            "text": "The argument was <w>anchored</w> in solid facts and research.",
                            "target_lang_translations": {
                                "ru": "Аргумент <w>основывался</w> на твердых фактах и исследованиях.",
                                "zh": "这一论点是<w>立足</w>于扎实的事实和研究之上的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "support"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обеспечивать эмоциональную стабильность или твердую основу для кого-либо или чего-либо.",
                        "zh": "为某人或某事提供情感稳定性或坚实的基础。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поддерживать",
                                "target_lang_sense_clarification": "эмоционально"
                            },
                            {
                                "target_lang_word": "основываться",
                                "target_lang_sense_clarification": "на фактах"
                            }
                        ],
                        "zh": [
