{
    "word_family": [
        "vleien",
        "vleier",
        "vleierij",
        "vleiend"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ad770a28-558b-3138-b699-b1243a4f104d",
                    "sense_definition": "trots en blij door complimenten of lof; zich vereerd voelend",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik voelde me erg <w>gevleid</w> toen de directeur mijn werk prees.",
                            "target_lang_translations": {
                                "en": "I felt very <w>flattered</w> when the director praised my work."
                            }
                        },
                        {
                            "text": "Zij reageerde met een <w>gevleide</w> glimlach op zijn mooie woorden.",
                            "target_lang_translations": {
                                "en": "She responded with a <w>flattered</w> smile to his beautiful words."
                            }
                        }
                    ],
                    "synonyms": [
                        "vereerd",
                        "gestreeld"
                    ],
                    "antonyms": [
                        "beledigd"
                    ],
                    "common_phrases": [
                        "zich gevleid voelen",
                        "erg gevleid zijn"
                    ],
                    "target_lang_definitions": {
                        "en": "feeling proud and pleased by compliments or praise; feeling honored"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flattered",
                                "target_lang_sense_clarification": "feeling pleased by compliments or attention"
                            },
                            {
                                "target_lang_word": "honored",
                                "target_lang_sense_clarification": "feeling proud and privileged"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "30e77851-0c37-3c1d-b127-59ca4051accb",
                    "sense_definition": "voltooid deelwoord van <w>vleien</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij heeft haar de hele avond <w>gevleid</w> om zijn zin te krijgen.",
                            "target_lang_translations": {
                                "en": "He <w>flattered</w> her all evening to get his way."
                            }
                        },
                        {
                            "text": "De kat heeft zich spinnend tegen haar been <w>gevleid</w>.",
                            "target_lang_translations": {
                                "en": "The cat <w>snuggled</w> against her leg, purring."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "past participle of 'vleien' (to flatter, or to nestle/snuggle)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flattered",
                                "target_lang_sense_clarification": "praised insincerely or pleased with compliments"
                            },
                            {
                                "target_lang_word": "snuggled",
                                "target_lang_sense_clarification": "nestled or pressed closely for comfort"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}