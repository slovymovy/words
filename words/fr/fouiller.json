    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2685a113-316f-3f94-9d51-ce00d5900ed5",
                    "sense_definition": "Chercher avec minutie dans un lieu, un meuble ou un contenant pour trouver quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "recherche_materielle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a longuement <w>fouillé</w> dans son sac à main pour retrouver ses clés."
                        },
                        {
                            "text": "Les enquêteurs ont <w>fouillé</w> de fond en comble toute la maison sans rien trouver."
                        }
                    ],
                    "synonyms": [
                        "chercher"
                    ],
                    "common_phrases": [
                        "fouiller dans son sac",
                        "fouiller de fond en comble"
                    ]
                },
                {
                    "sense_id": "6e3752cf-8cd6-33f9-b185-41fce76182a4",
                    "sense_definition": "Examiner le corps ou les vêtements d'une personne pour vérifier si elle dissimule des objets interdits.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "recherche_materielle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les agents de sécurité ont <w>fouillé</w> les spectateurs avant l'entrée dans la salle de concert."
                        },
                        {
                            "text": "Chaque voyageur doit accepter de se faire <w>fouiller</w> au passage de la douane."
                        }
                    ],
                    "common_phrases": [
                        "fouiller au corps"
                    ]
                },
                {
                    "sense_id": "16a606f9-eb12-32d9-a263-dd8f8b28fb7a",
                    "sense_definition": "Explorer et analyser en détail des documents, des souvenirs ou un sujet pour y trouver des informations.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "recherche_intellectuelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'historien a <w>fouillé</w> les archives municipales pour documenter l'histoire du village."
                        },
                        {
                            "text": "Il <w>fouillait</w> sa mémoire pour tenter de se souvenir du prénom de cet ancien collègue."
                        }
                    ],
                    "synonyms": [
                        "rechercher"
                    ],
                    "common_phrases": [
                        "fouiller dans les archives",
                        "fouiller sa mémoire"
                    ]
                },
                {
                    "sense_id": "9b637bc8-c70d-39bd-9cfa-253eab2adc36",
                    "sense_definition": "Creuser méthodiquement la terre dans le but de mettre au jour des vestiges ou des objets enfouis.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "recherche_materielle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les archéologues ont <w>fouillé</w> ce terrain antique pendant plusieurs mois consécutifs."
                        },
                        {
                            "text": "L'équipe scientifique <w>fouille</w> le sol à la recherche d'ossements préhistoriques."
                        }
                    ],
                    "common_phrases": [
                        "fouiller le sol"
                    ]
                },
                {
                    "sense_id": "73c9faa0-776d-3b13-a6c6-ebb95d1c3931",
                    "sense_definition": "Espérer en vain ou attendre inutilement quelque chose que l'on n'obtiendra jamais.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attente_vaine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si tu crois qu'il va te donner son argent, tu peux toujours te <w>fouiller</w>."
                        },
                        {
                            "text": "Il espérait obtenir une réduction immédiate mais le vendeur lui a fait comprendre qu'il pouvait se <w>fouiller</w>."
                        }
                    ],
                    "common_phrases": [
                        "pouvoir se fouiller"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier ou populaire"
                        }
                    ]
                }
            ]
        }
    ]
