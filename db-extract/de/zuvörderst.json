                                "sense_id": "d585ba3c-e87a-356d-9a0e-62628d2d99de",
                                "text": "Pflege und Erziehung der Kinder sind das natürliche Recht der Eltern und die zuvörderst ihnen obliegende Pflicht."
                            },
                            {
                                "example_id": "de4fee3e-4396-4f51-982e-47cc4cdfb2c5",
                                "sense_id": "d585ba3c-e87a-356d-9a0e-62628d2d99de",
                                "text": "Die Bundesregierung hat sich zuvörderst um die Probleme der bedrohten Banken gekümmert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
