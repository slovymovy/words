                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "scientific_scale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Students must study <w>gross</w> anatomy before they move on to cellular biology.",
                            "target_lang_translations": {
                                "ru": "Студенты должны изучить <w>макроскопическую</w> анатомию, прежде чем переходить к клеточной биологии.",
                                "zh": "学生在学习细胞生物学之前，必须先学习<w>宏观</w>解剖学。"
                            }
