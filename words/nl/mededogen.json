                    "sense_definition": "Een gevoel van diep medeleven en barmhartigheid met het lijden van anderen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rechter toonde <w>mededogen</w> en gaf de jonge dader een mildere straf.",
                            "target_lang_translations": {
                                "en": "The judge showed <w>mercy</w> and gave the young offender a lighter sentence."
                            }
                        },
                        {
                            "text": "Zij keek met veel <w>mededogen</w> naar de dakloze man op de hoek van de straat.",
                            "target_lang_translations": {
                                "en": "She looked with great <w>compassion</w> at the homeless man on the street corner."
                            }
                        }
                    ],
                    "synonyms": [
                        "barmhartigheid",
                        "compassie",
                        "deernis",
