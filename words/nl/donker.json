                                "target_lang_sense_clarification": "тяжелое душевное состояние"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cd701e45-7b38-3606-a483-fd769601cd12",
                    "sense_definition": "vorm van het werkwoord <w>donkeren</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>donker</w> de kamer door de gordijnen te sluiten.",
                            "target_lang_translations": {
                                "en": "I <w>darken</w> the room by closing the curtains.",
                                "ru": "Я <w>затемняю</w> комнату, закрывая шторы."
                            }
                        },
                        {
                            "text": "Als ik de lichten uitdoe, <w>donker</w> ik de hele ruimte.",
                            "target_lang_translations": {
                                "en": "When I turn off the lights, I <w>darken</w> the entire space.",
                                "ru": "Когда я выключаю свет, я <w>погружаю во тьму</w> все пространство."
                            }
