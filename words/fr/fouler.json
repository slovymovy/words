    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1716d8fe-4825-338b-ad5b-e8b41eb16bc6",
                    "sense_definition": "Blesser une articulation par un étirement violent sans luxation ni fracture.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "blessure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est tombé dans les escaliers et s'est <w>foulé</w> la cheville droite."
                        },
                        {
                            "text": "Pendant son entraînement de tennis, elle a glissé et s'est <w>foulé</w> le poignet."
                        }
                    ],
                    "synonyms": [
                        "tordre"
                    ],
                    "common_phrases": [
                        "se fouler la cheville",
                        "se fouler le poignet"
                    ]
                },
                {
                    "sense_id": "ad772e1d-8ae4-3ed7-81a8-3167da006fb8",
                    "sense_definition": "Poser les pieds sur un lieu, marcher sur une surface.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "marcher",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'explorateur est très fier de <w>fouler</w> cette terre inconnue pour la première fois."
                        },
                        {
                            "text": "Ils adorent <w>fouler</w> l'herbe fraîche pieds nus dès le début du printemps."
                        }
                    ],
                    "synonyms": [
                        "arpenter",
                        "parcourir",
                        "piétiner"
                    ],
                    "common_phrases": [
                        "fouler le sol",
                        "fouler aux pieds"
                    ]
                },
                {
                    "sense_id": "b6834c06-782f-3bd3-badc-f0a4e50f394c",
                    "sense_definition": "Faire un effort ou se donner de la peine.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour rédiger ce devoir, il ne s'est vraiment pas <w>foulé</w>."
                        },
                        {
                            "text": "Ne te <w>foule</w> surtout pas, je vais tout ranger moi-même !"
                        }
                    ],
                    "synonyms": [
                        "fatiguer"
                    ],
                    "common_phrases": [
                        "ne pas se fouler",
                        "pas trop se fouler"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "souvent à la forme négative"
                        }
                    ]
                },
                {
                    "sense_id": "43ce2840-8001-3c98-bec2-a61d2827dcd5",
                    "sense_definition": "Presser ou écraser des matières avec les pieds ou un mécanisme pour les tasser ou en extraire le jus.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "presser",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cette région viticole, les vignerons aiment encore <w>fouler</w> le raisin selon la coutume."
                        },
                        {
                            "text": "Les ouvriers devaient longuement <w>fouler</w> les draps de laine afin d'épaissir le tissu."
                        }
                    ],
                    "synonyms": [
                        "écraser",
                        "presser"
                    ],
                    "common_phrases": [
                        "fouler le raisin",
                        "fouler la vendange"
                    ]
                },
                {
                    "sense_id": "a476350a-aeb2-3647-92dc-70eb932ebb40",
                    "sense_definition": "Opprimer durement une population ou un pays par des exigences excessives ou des violences.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "opprimer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les envahisseurs venaient régulièrement <w>fouler</w> ces provinces dévastées par la famine."
                        },
                        {
                            "text": "Le tyran continuait de <w>fouler</w> le peuple sous le poids d'impôts intolérables."
                        }
                    ],
                    "synonyms": [
                        "accabler",
                        "écraser",
                        "opprimer"
                    ],
                    "antonyms": [
                        "ménager",
                        "soulager"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "sens littéraire vieilli"
                        }
                    ]
                }
            ]
        }
