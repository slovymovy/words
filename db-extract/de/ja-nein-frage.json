                "senses": [
                    {
                        "sense_id": "248e7bab-bb85-3e7e-94d5-674d89897987",
                        "entry_id": "7c3cbe3b-b4e1-385e-9ab4-626854708312",
                        "glosses": [
                            "anderer Ausdruck für Entscheidungsfrage: Frage, auf die hin in der Antwort eine Entscheidung getroffen werden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b51145cb-fd32-47f7-b7a7-b20ba02377b8",
                                "sense_id": "248e7bab-bb85-3e7e-94d5-674d89897987",
                                "text": "\"Kommst Du heute?\" ist eine Ja-Nein-Frage; Antwortmöglichkeiten sind: \"Ja\", \"Nein\", \"Vielleicht\" und dergleichen."
                            },
                            {
                                "example_id": "df2eebd5-c840-4eb4-8f88-cbbbcf12ba81",
                                "sense_id": "248e7bab-bb85-3e7e-94d5-674d89897987",
                                "text": "Die deutsche Sprache kennt die Antwortpartikeln ja. nein und doch; in der Einwort-Antwort auf die Ja-Nein-Frage werden allerdings auch Modalwörter, wie sicher ('jistě'), abtönungsähnliche Partikeln, wie allerdings ('ovšem') oder immerhin, sowie Satzadverbien […] verwendet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
