                        "entry_id": "9064d3f4-ff9e-3757-acf9-7a007446d6a0",
                        "glosses": [
                            "Préposé aux écritures, employé de bureau, écrivain sans talent."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "3cf93265-a08d-4542-bdb6-22dd1778016e",
                                "sense_id": "6cd87a57-7c47-3c3b-a10f-a8804135e2ed",
                                "text": "Il faut que j'aie la peau de Tarfilape, ce scribouilleur nuageux qui fait pisser de rire les montagnes."
                            },
                            {
                                "example_id": "f47a372e-2d4a-4f5c-ab42-fe894043a176",
                                "sense_id": "6cd87a57-7c47-3c3b-a10f-a8804135e2ed",
                                "text": "Ce qui auparavant était limpide – «La mer n'a pas cessé de descendre/Il faut de l'eau pour éteindre la cendre» – arrive avec le même auteur, le même scribouilleur de musique et de mixage."
                            }
                        ]
                    }
