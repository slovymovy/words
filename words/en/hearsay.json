{
    "word_family": [
        "hear"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "005406cd-76d1-364a-857b-b035e175c8f4",
                    "sense_definition": "Information heard from others that cannot be proven to be true.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rumor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The news was based on <w>hearsay</w> rather than facts."
                        },
                        {
                            "text": "Do not believe everything you hear, as much of it is just <w>hearsay</w>."
                        }
                    ],
                    "synonyms": [
                        "gossip",
                        "rumor"
                    ],
                    "common_phrases": [
                        "based on hearsay",
                        "mere hearsay"
                    ]
                },
                {
                    "sense_id": "4b93ca2e-299a-36e6-920e-470d98a94ee4",
                    "sense_definition": "Evidence in a legal case based on reports from others rather than personal knowledge.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal_evidence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer asked the judge to dismiss the <w>hearsay</w> evidence."
                        },
                        {
                            "text": "The witness testimony was rejected because it was considered <w>hearsay</w>."
                        }
                    ],
                    "synonyms": [
                        "report"
                    ],
                    "common_phrases": [
                        "dismiss hearsay",
                        "inadmissible hearsay"
                    ]
                },
                {
                    "sense_id": "5652bd4f-29f2-3ac1-a91b-0b57aef81679",
                    "sense_definition": "An out-of-court statement used in court to prove a fact, which is generally not allowed as evidence.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_evidence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defense attorney objected to the statement as <w>hearsay</w>."
                        },
                        {
                            "text": "The judge explained why the <w>hearsay</w> rule prevents such statements from being used."
                        }
                    ]
                }
            ]
        }
    ]
}