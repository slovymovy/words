                                "example_id": "04c0203b-2ce7-4eff-aa67-2992a1a97537",
                                "sense_id": "7b264bf9-d9f1-326d-91df-b81cac2bd4d5",
                                "text": "Het linnengoed is in de 17de eeuw een belangrijk onderdeel van de bruidsschat van de vrouw. Luxueus, verzorgd linnen is een statussymbool, de graadmeter voor de welstand van een gezin.",
                                "translation": "In the seventeenth century linen was an important part of a woman's dowry. Luxurious, well-cared for linen was a status symbol and an outward sign of a family's prosperity.",
                                "english": "In the seventeenth century linen was an important part of a woman's dowry. Luxurious, well-cared for linen was a status symbol and an outward sign of a family's prosperity."
                            }
                        ]
                    }
