                        "examples": [
                            {
                                "example_id": "2bdfae48-d185-4636-a7ca-f5f65be27125",
                                "sense_id": "3c491303-e404-3e92-9066-5c003e492c35",
                                "text": "„Man lobte ihre guten Schulleistungen und wie mühelos sie den Dialekt ihrer Umgebung angenommen hätten.“"
                            },
                            {
                                "example_id": "c5554308-5322-4b35-ae39-e1bd903d2436",
                                "sense_id": "3c491303-e404-3e92-9066-5c003e492c35",
                                "text": "„Die Schulleistungen ließen keinerlei Schlüsse auf literarische Begabung zu.“"
                            },
                            {
                                "example_id": "e957ce83-b5f5-444d-999b-41784a88292d",
                                "sense_id": "3c491303-e404-3e92-9066-5c003e492c35",
                                "text": "„Bei den monatlichen Examen, die seine Mutter zur Überprüfung der Schulleistungen ansetzte, fiel er regelmäßig durch.“"
                            }
                        ],
