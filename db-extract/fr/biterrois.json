                        "sense_id": "67140895-a049-38cb-9502-3bea3e05b90e",
                        "entry_id": "0f0bdb01-5f09-3a58-8ede-1b0beb0c4b74",
                        "glosses": [
                            "Natif ou habitant de Béziers, commune française située dans le département de l’Hérault."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98a47dea-0de5-4211-be0b-ddc48f9b16ec",
                                "sense_id": "67140895-a049-38cb-9502-3bea3e05b90e",
                                "text": "Et elle accueillit avec une larme de pitié et de tendresse le petit Biterrois dans le grand berceau où dormait son troisième, à peu près du même âge, et qui dut désormais se contenter d’une seule gourde."
                            },
                            {
                                "example_id": "47d16bd6-6e46-4386-a6cf-2db705d805a1",
                                "sense_id": "67140895-a049-38cb-9502-3bea3e05b90e",
                                "text": "Jusqu’à sa défaite, dimanche, face à son compatriote Ugo Humbert, au Challenger de Bordeaux, le Biterrois était encore le meilleur Français en lice sur le circuit."
                            }
                        ]
                    }
