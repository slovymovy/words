{
    "word_family": [
        "girl",
        "girlhood",
        "girlish",
        "girliness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "098867f2-8ab1-3239-9a16-69f267168795",
                    "sense_definition": "Characteristic of a stereotypical girl, very effeminate, gentle, or unmasculine.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "feminine_characteristics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decorated her bedroom with pink curtains and other <w>girly</w> things.",
                            "target_lang_translations": {
                                "ru": "Она украсила свою спальню розовыми шторами и другими <w>девчачьими</w> вещами.",
                                "zh": "她用粉色的窗帘和其他<w>女孩子气</w>的装饰品布置了卧室。"
                            }
                        },
                        {
                            "text": "I am frustrated about the definitions of what is considered a <w>girly</w> toy and what is not.",
                            "target_lang_translations": {
                                "ru": "Меня расстраивают определения того, что считается <w>девчачьей</w> игрушкой, а что нет.",
                                "zh": "我很苦恼于人们对什么是<w>女孩子气</w>的玩具、什么不是的定义。"
                            }
                        }
                    ],
                    "synonyms": [
                        "feminine",
                        "girlish",
                        "womanly"
                    ],
                    "antonyms": [
                        "masculine",
                        "tomboyish",
                        "mannish"
                    ],
                    "common_phrases": [
                        "girly things",
                        "girly girl"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характерный для стереотипной девочки; очень женственный, нежный или немужественный.",
                        "zh": "具有典型女孩特征的；非常女性化的、温柔的或缺乏男子气概的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "девчачий",
                                "target_lang_sense_clarification": "свойственный девочкам"
                            },
                            {
                                "target_lang_word": "девичий",
                                "target_lang_sense_clarification": "относящийся к девочкам или девушкам"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "女孩子气的",
                                "target_lang_sense_clarification": "形容具有女孩特征的"
                            },
                            {
                                "target_lang_word": "女性化的",
                                "target_lang_sense_clarification": "形容风格偏向女性的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4fb475e5-44f6-3d79-aa91-1dcaf25d9fd7",
                    "sense_definition": "Of, or pertaining to, a young, attractive woman, especially one who is scantily clad.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sensual_or_provocative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had a <w>girly</w> calendar hanging on the wall of his garage.",
                            "target_lang_translations": {
                                "ru": "У него в гараже на стене висел календарь <w>с полуобнаженными девушками</w>.",
                                "zh": "他车库的墙上挂着一本<w>性感美女</w>挂历。"
                            }
                        },
                        {
                            "text": "The magazine was criticized for publishing <w>girly</w> pictures that were deemed inappropriate.",
                            "target_lang_translations": {
                                "ru": "Журнал критиковали за публикацию <w>эротических</w> картинок, которые сочли неуместными.",
                                "zh": "该杂志因刊登被认为不妥的<w>性感美女</w>照片而受到批评。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "girly calendar",
                        "girly magazine"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used to describe pin-up style media"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к молодой привлекательной женщине, особенно полуобнаженной.",
                        "zh": "指年轻迷人的女性，尤指衣着暴露的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "с полуобнаженными девушками",
                                "target_lang_sense_clarification": "о календарях, журналах"
                            },
                            {
                                "target_lang_word": "эротический",
                                "target_lang_sense_clarification": "с изображением красивых девушек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "性感美女的",
                                "target_lang_sense_clarification": "指带有女性性感形象的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c4695a7-39ca-3d43-a5bd-8082f7256172",
                    "sense_definition": "Weak, delicate, or lacking toughness; wussy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weakness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He refused to use the pink cup, calling it a <w>girly</w> cup.",
                            "target_lang_translations": {
                                "ru": "Он отказался пользоваться розовой чашкой, назвав ее <w>девчачьей</w>.",
                                "zh": "他拒绝使用那个粉色的杯子，说那是<w>娘娘腔</w>用的杯子。"
                            }
                        },
                        {
                            "text": "Our meatfest included no <w>girly</w> utensils, just our hands and teeth.",
                            "target_lang_translations": {
                                "ru": "Наш мясной пир обошелся без всяких <w>неженок</w> в виде столовых приборов — только руки и зубы.",
                                "zh": "我们的肉食盛宴不需要任何<w>娇气</w>的餐具，直接上手用牙咬。"
                            }
                        }
                    ],
                    "synonyms": [
                        "effeminate",
                        "unmanly"
                    ],
                    "antonyms": [
                        "manly",
                        "masculine",
                        "butch"
                    ],
                    "common_phrases": [
                        "girly drink"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used pejoratively"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Слабый, нежный или лишенный стойкости; немужественный, «бабский».",
                        "zh": "软弱、娇气或缺乏韧性的；没男子气概的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "девчачий",
                                "target_lang_sense_clarification": "в пренебрежительном смысле, немужественный"
                            },
                            {
                                "target_lang_word": "бабский",
                                "target_lang_sense_clarification": "разговорное, неодобрительное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "娘娘腔的",
                                "target_lang_sense_clarification": "贬义，形容缺乏男子气概"
                            },
                            {
                                "target_lang_word": "娇气的",
                                "target_lang_sense_clarification": "形容软弱、不坚强"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "7c8ad66b-a2d0-390d-9e49-1bae3f9ce6ec",
                    "sense_definition": "In the manner of a girl.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "manner_of_a_girl",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They sat on the bed and started to talk <w>girly</w> about their favorite actors.",
                            "target_lang_translations": {
                                "ru": "Они уселись на кровать и начали <w>по-девчачьи</w> болтать о своих любимых актерах.",
                                "zh": "她们坐在床上，开始<w>像女孩子一样</w>聊起她们最喜欢的演员。"
                            }
                        },
                        {
                            "text": "He was accused of fighting <w>girly</w> during the practice match.",
                            "target_lang_translations": {
                                "ru": "Его обвинили в том, что во время тренировочного матча он дрался <w>как девчонка</w>.",
                                "zh": "他被指责在练习赛中打架<w>像个女孩子</w>一样。"
                            }
                        }
                    ],
                    "synonyms": [
                        "girlily",
                        "girlishly"
                    ],
                    "common_phrases": [
                        "talk girly",
                        "act girly"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal adverbial usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "По-девичьи, как девочка.",
                        "zh": "以女孩的方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "по-девчачьи",
                                "target_lang_sense_clarification": "как свойственно девочкам"
                            },
                            {
                                "target_lang_word": "по-девичьи",
                                "target_lang_sense_clarification": "в манере девочек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "像女孩子一样地",
                                "target_lang_sense_clarification": "形容行为举止像女孩"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ec3ba818-a42a-3939-8a0b-8d1290fa4775",
                    "sense_definition": "An informal term of address for a girl or young woman.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "addressing_females",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hey <w>girly</w>, what are you planning to do this weekend?",
                            "target_lang_translations": {
                                "ru": "Привет, <w>девчонка</w>, какие планы на выходные?",
                                "zh": "嘿，<w>小姑娘</w>，你这周末打算做什么？"
                            }
                        },
                        {
                            "text": "She greeted her best friend with a cheerful shout of hello <w>girly</w>.",
                            "target_lang_translations": {
                                "ru": "Она поприветствовала свою лучшую подругу веселым криком: «Привет, <w>подружка</w>!»",
                                "zh": "她热情地向闺蜜打招呼：“嘿，<w>美女</w>！”"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hey girly"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used as a friendly term of address"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разговорное обращение к девочке или молодой женщине.",
                        "zh": "对女孩或年轻女性的非正式称呼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "девочка",
                                "target_lang_sense_clarification": "в качестве дружеского обращения"
                            },
                            {
                                "target_lang_word": "девчонка",
                                "target_lang_sense_clarification": "неформальное обращение"
                            },
                            {
                                "target_lang_word": "подружка",
                                "target_lang_sense_clarification": "дружеское обращение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小姑娘",
                                "target_lang_sense_clarification": "非正式称呼"
                            },
                            {
                                "target_lang_word": "美女",
                                "target_lang_sense_clarification": "现代口语中对年轻女性的亲昵称呼"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}