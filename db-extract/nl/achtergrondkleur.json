                "senses": [
                    {
                        "sense_id": "6eba9dec-b15b-368f-aeeb-c50bb1400445",
                        "entry_id": "1c3650d7-d4df-3a02-b0e1-6c04318ee592",
                        "glosses": [
                            "de kleur van het veld waarop tekst of afbeeldingen getoond worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "771538f2-51be-43b5-8ca0-82ad3811862c",
                                "sense_id": "6eba9dec-b15b-368f-aeeb-c50bb1400445",
                                "text": "Facebookgebruikers kunnen voortaan nog kleurrijker vertellen wat ze aan het doen zijn of wat ze vinden. Het is namelijk mogelijk een achtergrondkleur achter de status te zetten. Tot nu toe kende Facebook alleen zwarte letters en blauwe links op een witte achtergrond."
                            },
                            {
                                "example_id": "bab9fd53-743b-4786-986f-2c216bb5063b",
                                "sense_id": "6eba9dec-b15b-368f-aeeb-c50bb1400445",
                                "text": "Het bureaublad met de groenblauwe achtergrondkleur, de startknop en de taakbalk: allemaal in handen van foute regimes. 'Net als de iconen 'deze computer', 'mijn documenten'en 'prullenbak'. Daarmee proberen hackers nu onze democratie te ondermijnen', zegt Wilfred Rietdijk, strategisch adviseur bij Defensie. 'Ze verspreiden fakenews, manipuleren Nederlandse burgers en wakkeren polarisatie aan. Erg pijnlijk, want zonder Windows 95 was dat nooit mogelijk geweest.'"
                            }
                        ]
                    }
