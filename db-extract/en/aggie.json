                        "entry_id": "dd501756-5232-3851-a0e0-c8fe776db7c1",
                        "glosses": [
                            "A diminutive of the female given names Agnes or Agatha."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e781875-d4b1-474d-a5cb-cc36428a8e37",
                                "sense_id": "6ed15290-e488-3afb-97db-b7622d8712ec",
                                "text": "\"Why do you call Mrs. Stone Aggie? Agnes is such a beautiful name, it is a shame to nick it in that way.\" Then, quickly regretting his impatience, he added, \"You would not have been jealous, would you, Jenny?\""
                            }
                        ]
