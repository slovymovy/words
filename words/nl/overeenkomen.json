    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "21d4b23b-7cc9-3bd0-9d68-0ecbe74107c6",
                    "sense_definition": "gelijk zijn aan iets anders of passen bij een bepaalde beschrijving of verwachting",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "overeenstemming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De resultaten van het experiment <w>komen overeen</w> met de voorspellingen van de theorie.",
                            "target_lang_translations": {
                                "en": "The results of the experiment <w>match</w> the predictions of the theory.",
                                "ru": "Результаты эксперимента <w>соответствуют</w> предсказаниям теории."
                            }
                        },
                        {
                            "text": "Zijn acties <w>komen</w> helaas niet altijd <w>overeen</w> met zijn woorden.",
                            "target_lang_translations": {
                                "en": "Unfortunately, his actions do not always <w>align</w> with his words.",
                                "ru": "Его действия, к сожалению, не всегда <w>согласуются</w> с его словами."
                            }
                        }
                    ],
                    "synonyms": [
                        "overeenstemmen",
                        "stroken",
                        "kloppen"
                    ],
                    "antonyms": [
                        "verschillen",
                        "afwijken"
                    ],
                    "common_phrases": [
                        "overeenkomen met de werkelijkheid",
                        "overeenkomen met de feiten"
                    ],
                    "target_lang_definitions": {
                        "en": "To be identical to something else or to match a specific description or expectation.",
                        "ru": "Быть идентичным чему-либо другому или соответствовать определенному описанию или ожиданию"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "match",
                                "target_lang_sense_clarification": "to be equal to or correspond with"
                            },
                            {
                                "target_lang_word": "correspond",
                                "target_lang_sense_clarification": "to be in agreement or similarity"
                            },
                            {
                                "target_lang_word": "align",
                                "target_lang_sense_clarification": "to be consistent with"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "соответствовать",
                                "target_lang_sense_clarification": "быть в согласии с чем-либо"
                            },
                            {
                                "target_lang_word": "совпадать",
                                "target_lang_sense_clarification": "быть одинаковым"
                            },
                            {
                                "target_lang_word": "согласовываться",
                                "target_lang_sense_clarification": "не противоречить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bdd5edd7-4c8d-369f-94be-d4bd8237b9f9",
                    "sense_definition": "hetzelfde standpunt innemen of een gezamenlijk besluit nemen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "overeenstemming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We kunnen elkaar ontmoeten en proberen een oplossing te vinden waar we allemaal mee <w>overeenkomen</w>.",
                            "target_lang_translations": {
                                "en": "We can meet and try to find a solution that we all <w>agree</w> on.",
                                "ru": "Мы можем встретиться и попытаться найти решение, с которым мы все <w>согласимся</w>."
                            }
                        },
                        {
                            "text": "De twee partijen konden het niet <w>overeenkomen</w> over de prijs van het huis.",
                            "target_lang_translations": {
                                "en": "The two parties could not <w>reach an agreement</w> on the price of the house.",
                                "ru": "Две стороны не смогли <w>договориться</w> о цене дома."
                            }
                        }
                    ],
                    "synonyms": [
                        "akkoord gaan",
                        "het eens worden",
                        "afspreken"
                    ],
                    "antonyms": [
                        "verschillen van mening",
                        "botsen"
                    ],
                    "common_phrases": [
                        "het eens overeenkomen",
                        "overeenkomen over de prijs"
                    ],
                    "target_lang_definitions": {
                        "en": "To take the same point of view or reach a joint decision.",
                        "ru": "Придерживаться одной и той же точки зрения или принять совместное решение"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "agree",
                                "target_lang_sense_clarification": "to have the same opinion"
                            },
                            {
                                "target_lang_word": "reach an agreement",
                                "target_lang_sense_clarification": "to come to a mutual decision"
                            },
                            {
                                "target_lang_word": "concur",
                                "target_lang_sense_clarification": "to be of the same mind"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "договариваться",
                                "target_lang_sense_clarification": "приходить к соглашению"
                            },
                            {
                                "target_lang_word": "соглашаться",
                                "target_lang_sense_clarification": "принимать общую позицию"
                            },
                            {
                                "target_lang_word": "сходиться в мнениях",
                                "target_lang_sense_clarification": "иметь одинаковый взгляд"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "baf18c28-820b-38a0-8fec-73c47ba41e18",
                    "sense_definition": "dezelfde functie of waarde hebben als iets in een ander systeem",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vergelijking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De Cyrillische Ф <w>komt overeen</w> met onze letter F.",
                            "target_lang_translations": {
                                "en": "The Cyrillic Ф <w>corresponds</w> to our letter F.",
                                "ru": "Кириллическая Ф <w>соответствует</w> нашей букве F."
                            }
                        },
                        {
                            "text": "Deze oude munteenheid zou vandaag de dag <w>overeenkomen</w> met ongeveer tien euro.",
                            "target_lang_translations": {
                                "en": "This old currency would <w>be equivalent</w> to about ten euros today.",
                                "ru": "Эта старая валюта сегодня <w>равнялась</w> бы примерно десяти евро."
                            }
                        }
                    ],
                    "synonyms": [
                        "corresponderen",
                        "gelijkstaan aan"
                    ],
                    "common_phrases": [
                        "overeenkomen met een symbool"
                    ],
                    "target_lang_definitions": {
                        "en": "To have the same function or value as something in a different system.",
                        "ru": "Иметь ту же функцию или значение, что и что-то в другой системе"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "correspond to",
                                "target_lang_sense_clarification": "to be equivalent to in another system"
                            },
                            {
                                "target_lang_word": "be equivalent to",
                                "target_lang_sense_clarification": "to have the same value or meaning"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "соответствовать",
                                "target_lang_sense_clarification": "быть эквивалентом в другой системе"
                            },
                            {
                                "target_lang_word": "равняться",
                                "target_lang_sense_clarification": "быть равным по значению"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1fc23285-4f77-39d1-b4d5-dfb5b94afb7e",
                    "sense_definition": "een officiële of bindende afspraak maken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "afspraak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die wetswijziging is <w>overeengekomen</w> op de conferentie in Nice.",
                            "target_lang_translations": {
                                "en": "That legislative change was <w>agreed upon</w> at the conference in Nice.",
                                "ru": "Это изменение в законе было <w>согласовано</w> на конференции в Ницце."
                            }
                        },
                        {
                            "text": "In het contract zijn we <w>overeengekomen</w> dat de huur elke maand op tijd wordt betaald.",
                            "target_lang_translations": {
                                "en": "In the contract, we <w>stipulated</w> that the rent is paid on time every month.",
                                "ru": "В контракте мы <w>условились</w>, что арендная плата будет вноситься вовремя каждый месяц."
                            }
                        }
                    ],
                    "synonyms": [
                        "afspreken",
                        "vastleggen",
                        "bedingen"
                    ],
                    "common_phrases": [
                        "schriftelijk overeenkomen",
                        "een regeling overeenkomen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak gebruikt in zakelijke of juridische context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To make an official or binding agreement.",
                        "ru": "Заключить официальное или обязательное соглашение"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "agree upon",
                                "target_lang_sense_clarification": "to settle on a specific point"
                            },
                            {
                                "target_lang_word": "stipulate",
                                "target_lang_sense_clarification": "to specify as a condition of an agreement"
                            },
                            {
                                "target_lang_word": "contract",
                                "target_lang_sense_clarification": "to enter into a formal agreement"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "согласовывать",
                                "target_lang_sense_clarification": "утверждать условия"
                            },
                            {
                                "target_lang_word": "уславливаться",
                                "target_lang_sense_clarification": "договариваться о правилах"
                            },
                            {
                                "target_lang_word": "закреплять в договоре",
                                "target_lang_sense_clarification": "официально фиксировать"
                            }
                        ]
                    }
                }
            ]
        }
    ]
