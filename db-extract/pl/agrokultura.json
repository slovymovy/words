                "translations": [
                    {
                        "translation_id": "e00a26cf-4bfa-462f-bbbe-0d4995d1c5ac",
                        "source_entry_id": "f97e24ee-8046-3d40-bf6f-408bc8ea0ce5",
                        "source_sense_id": "a604c6f6-4a37-3b61-b8d6-177617b2ccb9",
