                                        "sense_id": "641a55cc-d141-3867-9fa3-9d7968f53998",
                                        "entry_id": "5a899dfd-ad95-3022-bc10-3c8ef104fcaa",
                                        "glosses": [
                                            "An artificial chemical compound."
