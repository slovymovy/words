                                "example_id": "f5c7ea24-7f9b-4268-9462-cf5d960530ca",
                                "sense_id": "8e8aa228-fffa-379d-93b9-77da2f31f59a",
                                "text": "Ada, on the grass, kept trying to make an anadem of marguerites for the dog while Lucette looked on, munching a crumpet."
                            },
                            {
                                "example_id": "e57cb931-052d-47cf-9c4d-ec8018efa1e7",
                                "sense_id": "8e8aa228-fffa-379d-93b9-77da2f31f59a",
                                "text": "As she held high the Staff, she caught the early sunlight. Her hair shone about her like an anadem, and the golden Ranyhyn bore her up like an offering to the wide day."
                            }
                        ]
