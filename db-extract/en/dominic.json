                                            {
                                                "example_id": "df4488f7-4ad1-479a-8ae0-183a66d5091b",
                                                "sense_id": "27f52b58-a04d-3af8-a065-54a4d9a89d1a",
                                                "text": "Frau Dominik ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "879d8807-47a7-44c7-9068-5175cedc5cd3",
                                                "sense_id": "27f52b58-a04d-3af8-a065-54a4d9a89d1a",
                                                "text": "Herr Dominik wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "b6f8e7a6-5c3a-4c0a-b1af-9e7f95738a60",
                                                "sense_id": "27f52b58-a04d-3af8-a065-54a4d9a89d1a",
                                                "text": "Die Dominiks fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "b121540d-d884-491c-b5a8-c2756b967d5e",
                                                "sense_id": "27f52b58-a04d-3af8-a065-54a4d9a89d1a",
                                                "text": "Der Dominik trägt nie die Schals, die die Dominik ihm strickt."
                                            },
                                            {
                                                "example_id": "f9f6d40a-7045-42af-9720-ee346a10c2a4",
                                                "sense_id": "27f52b58-a04d-3af8-a065-54a4d9a89d1a",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Dominik kommt, geht der Herr Dominik.“"
                                            },
                                            {
                                                "example_id": "8a143c1b-c302-4a89-92f5-fe53b15b2737",
                                                "sense_id": "27f52b58-a04d-3af8-a065-54a4d9a89d1a",
                                                "text": "Dominik kommt und geht."
                                            },
                                            {
                                                "example_id": "bff38982-cb37-4f24-a6d9-d1179b4b0719",
                                                "sense_id": "27f52b58-a04d-3af8-a065-54a4d9a89d1a",
                                                "text": "Dominiks kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
