                        "sense_id": "9af5f724-2f70-30c0-9798-7fb555c26b0f",
                        "entry_id": "fcb0adef-65c6-34c8-9168-1a4023addf4d",
                        "glosses": [
                            "Voiture cahotante, rude, ayant des problèmes de suspension."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "3d9b470b-45a6-49e7-8d7e-e3eb51a0fa96",
                                "sense_id": "9af5f724-2f70-30c0-9798-7fb555c26b0f",
                                "text": "Nous partîmes dans un méchant tapecu."
                            },
                            {
                                "example_id": "52b3da74-c7ac-4e69-977f-6b0074ccd466",
                                "sense_id": "9af5f724-2f70-30c0-9798-7fb555c26b0f",
                                "text": "Comme l’oncle Octave de poétique mémoire, il aimait les voyages, et se plaisait à parcourir l’Europe, seul, à cheval ou dans un léger tapecu de son invention."
                            }
                        ]
                    },
                    {
                        "sense_id": "20e4b482-5ca3-3566-964a-b18720f3ecfd",
                        "entry_id": "fcb0adef-65c6-34c8-9168-1a4023addf4d",
                        "glosses": [
                            "Petite voile située à l’extrémité arrière d’une embarcation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0485e6e-d79d-4420-81f6-1fb2bf9924aa",
                                "sense_id": "20e4b482-5ca3-3566-964a-b18720f3ecfd",
                                "text": "On fait lofer le yacht en mettant la barre dessous; ou traverse les écoutes de foc; la grande voile est établie haut et boulée au vent et le tapecu rentré; la flèche en cul est aussi établie; alors le navire dérive."
                            }
                        ]
                    }
