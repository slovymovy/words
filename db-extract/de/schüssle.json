                ],
                "senses": [
                    {
                        "sense_id": "86d33338-30b4-3e50-8815-3badbc594bcd",
                        "entry_id": "14380589-8b0b-3398-b757-5b2919728586",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23146af8-78dc-4485-a00b-227ea067c4b9",
                                "sense_id": "86d33338-30b4-3e50-8815-3badbc594bcd",
                                "text": "Frau Schüssle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a5cd7e8d-b048-4d3c-9ec1-d5f3e8c8a578",
                                "sense_id": "86d33338-30b4-3e50-8815-3badbc594bcd",
                                "text": "Herr Schüssle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a592821d-fbf4-4db7-ad4e-315e2117674c",
                                "sense_id": "86d33338-30b4-3e50-8815-3badbc594bcd",
                                "text": "Die Schüssles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "89de12c8-aa48-4faa-8ee2-39403a273bf6",
                                "sense_id": "86d33338-30b4-3e50-8815-3badbc594bcd",
                                "text": "Der Schüssle trägt nie die Pullover, die die Schüssle ihm strickt."
                            },
                            {
                                "example_id": "4709f6c4-ecbc-4c93-8a83-621b52e27b2e",
                                "sense_id": "86d33338-30b4-3e50-8815-3badbc594bcd",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schüssle kommt, geht der Herr Schüssle.“"
                            },
                            {
                                "example_id": "ddb19c3c-f0cf-49cc-8c23-a3514235c485",
                                "sense_id": "86d33338-30b4-3e50-8815-3badbc594bcd",
                                "text": "Schüssle kommt und geht."
                            },
                            {
                                "example_id": "b4df05d2-8833-4c3b-aec3-f5f2fdcff131",
                                "sense_id": "86d33338-30b4-3e50-8815-3badbc594bcd",
                                "text": "Schüssles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
