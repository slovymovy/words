                    ]
                },
                {
                    "sense_id": "3d35598f-3679-3ef4-a66c-abe44b81409f",
                    "sense_definition": "Personne ou entité manquant d'envergure, de puissance ou d'influence dans son domaine.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "figure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce pays reste un géant économique mais demeure un <w>nain</w> politique sur la scène mondiale."
                        },
                        {
                            "text": "Face aux grandes multinationales du secteur, notre petite entreprise fait figure de <w>nain</w>."
                        }
                    ],
                    "synonyms": [
                        "minus"
                    ],
                    "antonyms": [
                        "géant"
                    ],
                    "common_phrases": [
