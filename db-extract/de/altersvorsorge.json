                "senses": [
                    {
                        "sense_id": "9baee3ef-6ab4-3d8b-9d44-16a3082f659b",
                        "entry_id": "9992fc37-47aa-3a39-b9ad-6b6690384ae6",
                        "glosses": [
                            "Gesamtheit der Maßnahmen zur Sicherung des Lebensstandards nach dem Ausscheiden aus dem Berufsleben"
                        ],
                        "tags": [
                            "meist Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "ccab7b4c-2f95-425e-a154-466733c93784",
                                "sense_id": "9baee3ef-6ab4-3d8b-9d44-16a3082f659b",
                                "text": "„Hätte ich Geld dafür genommen, wäre das Thema Altersvorsorge für mich heute erledigt.“"
                            },
                            {
                                "example_id": "a0d84e88-5f62-49b0-8f3e-4d0c35c5d663",
                                "sense_id": "9baee3ef-6ab4-3d8b-9d44-16a3082f659b",
                                "text": "„Immobilien gelten als krisensichere Altersvorsorge und gerade vor dem Hintergrund historisch günstiger Baugeldzinsen kann es sich lohnen, über eine vermietete Immobilie langfristig Vermögen aufzubauen.“"
                            }
                        ],
