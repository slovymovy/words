{
    "word_family": [
        "clownish",
        "clownery",
        "clownishly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b58b690f-2753-333e-b794-d546fa21d032",
                    "sense_definition": "A comic entertainer, often working in a circus, who wears a traditional costume and exaggerated makeup.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "performer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>clown</w> made all the children laugh with his funny tricks.",
                            "target_lang_translations": {
                                "ru": "<w>Клоун</w> рассмешил всех детей своими забавными фокусами.",
                                "zh": "那个<w>小丑</w>用他滑稽的把戏逗得孩子们哈哈大笑。"
                            }
                        },
                        {
                            "text": "She decided to dress up as a circus <w>clown</w> for the costume party.",
                            "target_lang_translations": {
                                "ru": "Она решила нарядиться цирковым <w>клоуном</w> на костюмированную вечеринку.",
                                "zh": "她决定在化装舞会上打扮成马戏团<w>小丑</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "circus clown",
                        "sad clown"
                    ],
                    "target_lang_definitions": {
                        "ru": "Цирковой артист в традиционном костюме и гриме, развлекающий публику шутками и трюками.",
                        "zh": "在马戏团等场合表演，穿着传统服装并化着夸张妆容，通过滑稽动作和把戏娱乐观众的艺人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клоун",
                                "target_lang_sense_clarification": "артист цирка"
                            },
                            {
                                "target_lang_word": "паяц",
                                "target_lang_sense_clarification": "устаревшее или книжное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小丑",
                                "target_lang_sense_clarification": "马戏团表演者"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da884963-1801-311c-ab1e-8360279b0928",
                    "sense_definition": "A person who behaves in a funny or silly way, often to make others laugh.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was known as the class <w>clown</w> because he was always telling jokes.",
                            "target_lang_translations": {
                                "ru": "Его называли классным <w>клоуном</w>, потому что он постоянно рассказывал анекдоты.",
                                "zh": "他被称为班里的<w>活宝</w>，因为他总是讲笑话。"
                            }
                        },
                        {
                            "text": "Stop acting like a <w>clown</w> and listen to what I am saying.",
                            "target_lang_translations": {
                                "ru": "Перестань вести себя как <w>клоун</w> и послушай, что я говорю.",
                                "zh": "别再像个<w>小丑</w>一样胡闹了，听我说。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fool",
                        "jester",
                        "joker"
                    ],
                    "common_phrases": [
                        "class clown",
                        "act like a clown"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который ведёт себя смешно или несерьёзно, часто чтобы рассмешить других.",
                        "zh": "行为滑稽、举止轻浮，常为了逗乐他人而做出怪异举动的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шут",
                                "target_lang_sense_clarification": "тот, кто паясничает"
                            },
                            {
                                "target_lang_word": "клоун",
                                "target_lang_sense_clarification": "в переносном смысле"
                            },
                            {
                                "target_lang_word": "паяц",
                                "target_lang_sense_clarification": "кривляка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小丑",
                                "target_lang_sense_clarification": "比喻行为滑稽的人"
                            },
                            {
                                "target_lang_word": "活宝",
                                "target_lang_sense_clarification": "指爱搞怪、逗人发笑的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dbedae6e-3b13-3cd2-898c-9eabed664dd7",
                    "sense_definition": "A stupid, incompetent, or annoying person.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "insult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I cannot believe some <w>clown</w> parked his car right in front of my driveway.",
                            "target_lang_translations": {
                                "ru": "Не могу поверить, что какой-то <w>клоун</w> припарковал свою машину прямо перед моим выездом.",
                                "zh": "真不敢相信，竟然有个<w>蠢货</w>把车停在了我的车道正前方。"
                            }
                        },
                        {
                            "text": "Don't let that <w>clown</w> handle the project or he will ruin everything.",
                            "target_lang_translations": {
                                "ru": "Не позволяй этому <w>клоуну</w> заниматься проектом, иначе он всё испортит.",
                                "zh": "别让那个<w>蠢货</w>负责这个项目，否则他会把一切都搞砸的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fool"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "derogatory"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Глупый, некомпетентный или раздражающий человек.",
                        "zh": "指代愚蠢、无能或令人讨厌的人（贬义）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клоун",
                                "target_lang_sense_clarification": "оскорбление"
                            },
                            {
                                "target_lang_word": "придурок",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "蠢货",
                                "target_lang_sense_clarification": "贬义，指无能的人"
                            },
                            {
                                "target_lang_word": "小丑",
                                "target_lang_sense_clarification": "贬义，指令人不齿的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbadf81a-f907-3927-b6e9-96eaa7da06e0",
                    "sense_definition": "A clownfish.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bright orange <w>clown</w> swam safely among the stinging tentacles of the anemone.",
                            "target_lang_translations": {
                                "ru": "Ярко-оранжевая <w>рыба-клоун</w> безопасно плавала среди жалящих щупалец актинии.",
                                "zh": "那条鲜艳的橙色<w>小丑鱼</w>在海葵带刺的触手中安全地游动。"
                            }
                        },
                        {
                            "text": "We saw a tomato <w>clown</w> in the aquarium tank.",
                            "target_lang_translations": {
                                "ru": "Мы видели томатного <w>клоуна</w> в аквариуме.",
                                "zh": "我们在水族箱里看到了一条番茄<w>小丑鱼</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tomato clown"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "short for clownfish"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Рыба-клоун.",
                        "zh": "一种生活在海葵中的热带鱼类，即海葵鱼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рыба-клоун",
                                "target_lang_sense_clarification": "вид рыбы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小丑鱼",
                                "target_lang_sense_clarification": "鱼类名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "59db3d73-90db-3e98-ab2c-1129e5e0d401",
                    "sense_definition": "A peasant or rustic person; someone with coarse manners.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "historical_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wealthy merchant looked down upon the poor <w>clown</w> working in the fields.",
                            "target_lang_translations": {
                                "ru": "Богатый купец свысока смотрел на бедного <w>мужика</w>, работающего в поле.",
                                "zh": "富商瞧不起在田里干活的贫穷<w>乡巴佬</w>。"
                            }
                        },
                        {
                            "text": "In the play, the character is portrayed as a rude <w>clown</w> with no education.",
                            "target_lang_translations": {
                                "ru": "В пьесе этот персонаж изображен грубым <w>простаком</w> без образования.",
                                "zh": "在剧中，这个角色被刻画成一个没受过教育的粗鲁<w>乡巴佬</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Деревенщина, грубый или неотесанный человек (устаревшее значение).",
                        "zh": "指代乡下人、粗鲁或没受过教育的人（古语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "деревенщина",
                                "target_lang_sense_clarification": "простолюдин"
                            },
                            {
                                "target_lang_word": "мужик",
                                "target_lang_sense_clarification": "устаревшее, крестьянин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乡巴佬",
                                "target_lang_sense_clarification": "指粗俗的乡下人"
                            },
                            {
                                "target_lang_word": "粗人",
                                "target_lang_sense_clarification": "指举止粗鲁的人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dbac7b8f-a60c-32d5-8104-dc0d0a9cb528",
                    "sense_definition": "To behave in a silly or playful way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "act_silly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children started to <w>clown</w> around as soon as the teacher left the room.",
                            "target_lang_translations": {
                                "ru": "Дети начали <w>дурачиться</w>, как только учитель вышел из комнаты.",
                                "zh": "老师一离开教室，孩子们就开始<w>搞怪</w>起来。"
                            }
                        },
                        {
                            "text": "He loves to <w>clown</w> for the camera whenever someone takes a picture.",
                            "target_lang_translations": {
                                "ru": "Он обожает <w>паясничать</w> перед камерой, когда его фотографируют.",
                                "zh": "每当有人拍照时，他都喜欢对着镜头<w>耍宝</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "clown around"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вести себя глупо или игриво; паясничать.",
                        "zh": "举止滑稽、爱搞怪或表现得不严肃。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дурачиться",
                                "target_lang_sense_clarification": "вести себя несерьезно"
                            },
                            {
                                "target_lang_word": "паясничать",
                                "target_lang_sense_clarification": "кривляться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "搞怪",
                                "target_lang_sense_clarification": "行为滑稽"
                            },
                            {
                                "target_lang_word": "耍宝",
                                "target_lang_sense_clarification": "故意做出滑稽动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d95e8f87-a98f-313c-986a-89a0d62f285a",
                    "sense_definition": "To ridicule or make fun of someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ridicule",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He got <w>clowned</w> by his friends for wearing that ridiculous outfit.",
                            "target_lang_translations": {
                                "ru": "Друзья <w>высмеяли</w> его за этот нелепый наряд.",
                                "zh": "他因为穿了那身滑稽的衣服而被朋友们<w>嘲笑</w>。"
                            }
                        },
                        {
                            "text": "They tried to <w>clown</w> him, but he just laughed along with them.",
                            "target_lang_translations": {
                                "ru": "Они пытались <w>поиздеваться</w> над ним, но он просто посмеялся вместе с ними.",
                                "zh": "他们试图<w>戏弄</w>他，但他只是跟着他们一起笑。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Высмеивать или дразнить кого-либо.",
                        "zh": "嘲笑、戏弄或使某人出丑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высмеивать",
                                "target_lang_sense_clarification": "делать посмешищем"
                            },
                            {
                                "target_lang_word": "стебать",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "嘲笑",
                                "target_lang_sense_clarification": "取笑某人"
                            },
                            {
                                "target_lang_word": "戏弄",
                                "target_lang_sense_clarification": "捉弄某人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}