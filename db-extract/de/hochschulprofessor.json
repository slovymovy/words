                "senses": [
                    {
                        "sense_id": "93f5a8db-b044-3fa8-b364-8aac6bfa8354",
                        "entry_id": "5f79b95e-3146-358e-abce-c55b6c5756e8",
                        "glosses": [
                            "Professor an einer Hochschule"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6ee1633-078a-4d08-996c-3bdac6c06dd9",
                                "sense_id": "93f5a8db-b044-3fa8-b364-8aac6bfa8354",
                                "text": "„\"Die Umstellung auf den Euro wird Europas Banken zwischen 133 und 159 Mrd. S kosten\", behauptete der deutsche Hochschulprofessor Leo Schuster.“"
                            },
                            {
                                "example_id": "d4334964-b4fc-458f-a911-6ce6e135b71e",
                                "sense_id": "93f5a8db-b044-3fa8-b364-8aac6bfa8354",
                                "text": "„Die Schüler wurden von Hochschulprofessoren, Lehrern und Mitarbeitern von Firmen bei ihrer Projektarbeit begleitet und unterstützt.“"
                            },
                            {
                                "example_id": "73844a14-8611-411e-b689-0517f0f42521",
                                "sense_id": "93f5a8db-b044-3fa8-b364-8aac6bfa8354",
                                "text": "„Hat er Pech und lehrt er nur an einer Einrichtung namens Hochschule, muß er sich gefallen lassen, Hochschulprofessor genannt zu werden, da helfen weder eine C3 noch eine C4.“"
                            },
                            {
                                "example_id": "eb801344-143e-4f92-8078-e43c9ddc437b",
                                "sense_id": "93f5a8db-b044-3fa8-b364-8aac6bfa8354",
                                "text": "„Aus einem Handwerker kann man nicht plötzlich einen Hochschulprofessor machen, die neue Identität muss auf eine gewisse Weise zur Person passen.“"
                            },
                            {
                                "example_id": "8df3b016-b829-4e59-a3b9-74b8a2d820ff",
                                "sense_id": "93f5a8db-b044-3fa8-b364-8aac6bfa8354",
                                "text": "„Denn Karlheinz Stephan war einer der ersten Bürgermeister, die sich für die Idee interessierten, für die der Heilbronner Hochschulprofessor damals Partner suchte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
