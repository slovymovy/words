                "senses": [
                    {
                        "sense_id": "4ba5d138-12f2-3880-b2fd-a568cf4fdb80",
                        "entry_id": "2c3e9dd0-e186-3103-953e-3a767e6f41dc",
                        "glosses": [
                            "Pairing of organisms for copulation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ebc5d16-884d-43bf-937c-04d9b3b15b45",
                                "sense_id": "4ba5d138-12f2-3880-b2fd-a568cf4fdb80",
                                "text": "The progeny of backcrosses and intercrosses will form some incrosses and some matings of other types."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e1ab167-1e0b-37db-95f1-06054f437843",
                        "entry_id": "2c3e9dd0-e186-3103-953e-3a767e6f41dc",
                        "glosses": [
                            "Sexual union; copulation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5b5de15-2488-461a-b0cf-f34767215038",
                                "sense_id": "3e1ab167-1e0b-37db-95f1-06054f437843",
                                "text": "Earless ghost swift moths become “invisible” to echolocating bats by forming mating clusters close (less than half a meter) above vegetation and effectively blending into the clutter of echoes that the bat receives from the leaves and stems around them."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2146110-717f-4111-8f73-a29ba08cb47f",
                        "source_entry_id": "2c3e9dd0-e186-3103-953e-3a767e6f41dc",
                        "source_sense_description": "pairing of organisms for copulation",
                        "target_lang_word": "accouplement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accouplement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "26da1171-5b99-39d4-b5ed-f156c857df6f",
                                        "entry_id": "1c6b1f06-5c76-3dc1-aca3-b03be7883ef6",
                                        "glosses": [
                                            "Assemblage."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf1fe985-ea2a-445a-95f4-5e9459305b2e",
                                                "sense_id": "26da1171-5b99-39d4-b5ed-f156c857df6f",
                                                "text": "Voilà un étrange accouplement d’idées, de mots, de lettres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55d8db92-d390-3543-afe0-d30e43efa046",
                                        "entry_id": "1c6b1f06-5c76-3dc1-aca3-b03be7883ef6",
                                        "glosses": [
                                            "Conjonction du mâle et de la femelle pour la reproduction."
                                        ],
                                        "tags": [
                                            "Reproduction"
                                        ],
                                        "note": "En ce sens, il ne s’emploie guère qu’en parlant des animaux",
                                        "examples": [
                                            {
                                                "example_id": "7659522a-56cc-4227-9c42-1ba387312c42",
                                                "sense_id": "55d8db92-d390-3543-afe0-d30e43efa046",
                                                "text": "La psychanalyse en fut pour ses frais qui vit dans l’accouplement inconfortable de la machine à coudre et du parapluie, sur une table de dissection, un coupable fantasme fornicatoire."
                                            },
                                            {
                                                "example_id": "59b36660-fefd-4df5-8b70-9b95bf6d2421",
                                                "sense_id": "55d8db92-d390-3543-afe0-d30e43efa046",
                                                "text": "L’accouplement d’un chien et d’une chienne."
                                            },
                                            {
                                                "example_id": "c496188b-55a6-4bde-90fd-8ec659005f77",
                                                "sense_id": "55d8db92-d390-3543-afe0-d30e43efa046",
                                                "text": "Le mulet vient de l’accouplement d’un âne et d’une jument, et le bardot de l’accouplement d’un cheval et d’une ânesse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f4e645f-b1a3-3c40-9655-026e78a8dadf",
                                        "entry_id": "1c6b1f06-5c76-3dc1-aca3-b03be7883ef6",
                                        "glosses": [
                                            "Assemblage par couple, en parlant des animaux, des choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fd92b37-e8d1-4035-bbda-ecc2e98f7874",
                                                "sense_id": "6f4e645f-b1a3-3c40-9655-026e78a8dadf",
                                                "text": "Accouplement de bœufs pour la charrue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43cc8b0c-3bad-3787-9be5-99ba779562bb",
                                        "entry_id": "1c6b1f06-5c76-3dc1-aca3-b03be7883ef6",
                                        "glosses": [
                                            "Formation d'un couple, en parlant des humains."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "489d044d-6df1-4221-99b7-2f7d1b6bd324",
                                                "sense_id": "43cc8b0c-3bad-3787-9be5-99ba779562bb",
                                                "text": "Les prêtres s'entendent à merveille pour procurer de riches dots aux nobles appau­vris, au point qu'on a pu accuser l’Église de considérer le mariage comme un accouplement de gentilshommes vivant en marlous et de bourgeoises réduites au rôle de marmites."
                                            },
                                            {
                                                "example_id": "7e3a72c7-a0be-4e55-9d1f-551349ad4a04",
                                                "sense_id": "43cc8b0c-3bad-3787-9be5-99ba779562bb",
                                                "text": "Un homme disgracié de la nature trouvera sans difficulté à épouser une jeune fille même belle s’il a « le sac » : ce sont là des accouplements particulièrement immoraux, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3de2625f-cd1f-3498-8c32-f8ca14d153a9",
                                        "entry_id": "1c6b1f06-5c76-3dc1-aca3-b03be7883ef6",
                                        "glosses": [
                                            "Rapport sexuel, indépendamment d'une visée reproductive, sentimentale ou spirituelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "663d2887-7769-41fa-bde2-973da50dcbac",
                                                "sense_id": "3de2625f-cd1f-3498-8c32-f8ca14d153a9",
                                                "text": "Satan poussait dans les feux de la lubricité cavalcadante et dévorante ses troupeaux de nonnes charnues et de moines ityphalliques, gymnasiarques de l'amour et virtuoses des accouplements monstrueux."
                                            },
                                            {
                                                "example_id": "53afe022-e09b-4765-b099-d8e59e24b5f0",
                                                "sense_id": "3de2625f-cd1f-3498-8c32-f8ca14d153a9",
                                                "text": "L'être humain ne peut pas vivre sans respirer, mais il peut vivre sans s'accoupler. (Le terme généralement employé est celui d'union sexuelle. Mais il peut y avoir accouplement sans qu'il y ait union. C'est même presque toujours le cas.)"
                                            },
                                            {
                                                "example_id": "601d4ec0-681d-421d-9fe5-d823114e4575",
                                                "sense_id": "3de2625f-cd1f-3498-8c32-f8ca14d153a9",
                                                "text": "Elle repense à ce comédien qui, pendant qu'elle ajustait son costume, lui contait avec force détails l’accouplement zoophilique auquel il avait assisté sous un chapiteau en compagnie d'une trentaine d'autres gringos."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
