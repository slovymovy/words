                        ],
                        "examples": [
                            {
                                "example_id": "f23a19e4-042e-4b77-ab5e-715cdd91d676",
                                "sense_id": "8d1d4ad2-938f-3904-8451-24f834aa0dff",
                                "text": "The Portrat right, the Type, the Figure true, / And very viue Anatomie of wit: / To monſtrate theſe, the Miſſes we commit."
                            },
                            {
                                "example_id": "4715caf6-f2d1-4a73-bf4c-954b64341ba0",
                                "sense_id": "8d1d4ad2-938f-3904-8451-24f834aa0dff",
                                "text": "[Y]et he ought to punish all idolatrous formes of worship, because the light of nature is sufficient to monstrate the absurdnesse and impiety thereof; […]"
                            },
                            {
                                "example_id": "cceb671a-7db2-4d22-8ee8-a4851e4c4abd",
                                "sense_id": "8d1d4ad2-938f-3904-8451-24f834aa0dff",
                                "text": "To MONSTRATE, [montrer, F[rench] monſtratum, L[atin]] to ſhew."
                            },
                            {
                                "example_id": "ddcb1f38-dd42-49ee-80da-5162959a8d4b",
                                "sense_id": "8d1d4ad2-938f-3904-8451-24f834aa0dff",
                                "text": "But the very young one / who walks apart / whose wide-lidded eyes monstrate immeasurable fatigue—his greatcoat fits superbly at the waist and its tailored skirts have distinction; […]"
                            }
                        ]
                    }
