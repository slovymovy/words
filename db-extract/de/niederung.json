                        ]
                    },
                    {
                        "translation_id": "81cb75a0-c3ca-4926-9209-61ac17685fd8",
                        "source_entry_id": "7dd33e94-d0c5-3e86-8641-9c080eaf5446",
                        "source_sense_id": "7e2eec4e-daec-3573-8b35-5fe552a44adb",
                        "source_sense_description": "niedrig gelegenes Gelände, besonders an Gewässern",
                        "target_lang_word": "plaine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plaine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "78b46faf-1461-30f9-924e-c7bc47e4ca0d",
                                        "entry_id": "319a14e8-18fd-31db-8ae2-78c1960e89ac",
                                        "glosses": [
                                            "Espace géographique caractérisé par une surface plane, avec des pentes relativement faibles."
                                        ],
                                        "tags": [
                                            "Géographie physique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbca81cf-aae6-410d-bf63-4f6a00a565fd",
                                                "sense_id": "78b46faf-1461-30f9-924e-c7bc47e4ca0d",
                                                "text": "Ici même, sur ce dernier ourlet du plateau de Lorette, qui commande le plaine de Douai-Liévin et le bassin de Lens […] la lutte fut infernale."
                                            },
                                            {
                                                "example_id": "97d3d30b-11b0-469f-8292-f6bd11a98485",
                                                "sense_id": "78b46faf-1461-30f9-924e-c7bc47e4ca0d",
                                                "text": "Avant l’arrivée des Magyars, les Slaves méridionaux occupaient toute la plaine danubienne et le noyau de leur puissance était situé entre le Rab, le Danube et la Drave."
                                            },
                                            {
                                                "example_id": "131db0db-cfb7-4f17-8a3b-7cbfa1e28178",
                                                "sense_id": "78b46faf-1461-30f9-924e-c7bc47e4ca0d",
                                                "text": "Par surcroît, chaque été, des plaines du Bas-Languedoc (Hérault, Aude) montent par les drailles du Larzac et de la Montagne-Noire, vers les montagnes et jusqu’aux abords de l’Aubrac, 200 000 moutons."
                                            },
                                            {
                                                "example_id": "a459ff4b-48b4-4c3a-9de0-06b9d7241978",
                                                "sense_id": "78b46faf-1461-30f9-924e-c7bc47e4ca0d",
                                                "text": "Les plaines remontent à la plus haute antiquité. Les principales sont la Hollande, la plaine Monceau et le désert égyptien. Elles sont nées de l’absence de montagnes et se distinguent, suivant les spécialistes, par leur horizontalité."
                                            },
                                            {
                                                "example_id": "2e71e872-3f70-4d11-8681-6ee46a73aa7c",
                                                "sense_id": "78b46faf-1461-30f9-924e-c7bc47e4ca0d",
                                                "text": "À l’inverse, l’étendue de telle plaine divisée en une mosaïque de parcelles culturalement distinctes se verra différenciée par des contenus, eux aussi dotés d’attributs géométriques et de surface."
                                            },
                                            {
                                                "example_id": "6e5f5654-4e10-44c1-b124-537166f8373d",
                                                "sense_id": "78b46faf-1461-30f9-924e-c7bc47e4ca0d",
                                                "text": "Le nouveau campement est établi à une douzaine de kilomètres de l’ancien, dans une plaine ondulée et verdoyante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da4ecec5-86f4-3454-a7f9-7daac2d0ea4e",
                                        "entry_id": "319a14e8-18fd-31db-8ae2-78c1960e89ac",
                                        "glosses": [
                                            "Grande surface unie."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "092e2726-a620-449e-ae10-ceb57840b231",
                                                "sense_id": "da4ecec5-86f4-3454-a7f9-7daac2d0ea4e",
                                                "text": "Le lac formait une immense plaine d’eau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e8bd406-7d09-3b92-9059-4c8718e00bb0",
                                        "entry_id": "319a14e8-18fd-31db-8ae2-78c1960e89ac",
                                        "glosses": [
                                            "Sous la Convention, députés d’opinion modérée, parti que formaient ces députés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cbc6a62-b8f5-4bde-a90b-c21c2fbf113d",
                                                "sense_id": "6e8bd406-7d09-3b92-9059-4c8718e00bb0",
                                                "text": "Il siégeait à la plaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bd28b07-aadc-3b5f-b738-704bfc5a4aee",
                                        "entry_id": "319a14e8-18fd-31db-8ae2-78c1960e89ac",
                                        "glosses": [
                                            "Moitié occidentale du département des Vosges, dépourvue de montagnes, par opposition aux Hautes-Vosges."
                                        ],
                                        "tags": [
                                            "Vosges"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d99675f1-8e51-4524-aa51-5701ba113405",
                                                "sense_id": "7bd28b07-aadc-3b5f-b738-704bfc5a4aee",
                                                "text": "Je viens de la plaine."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "plaine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "01df422f-f195-365a-8c6b-8acb94715686",
                                        "entry_id": "5e17e93f-b796-35e4-a7b2-ada4bf56167b",
                                        "glosses": [
                                            "Champagne réduite dont la ligne supérieure est droite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80ba5a77-baf2-4fa0-93a6-c6299b492f56",
                                                "sense_id": "01df422f-f195-365a-8c6b-8acb94715686",
                                                "text": "D’azur au château essoré d’argent, de deux tours couvertes et girouettées du même, le tout maçonné de sable, posé sur une motte aussi d’argent sur une plaine coupée ondée d’or et d’azur. (cf. illustration)"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "plaine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "78b4f1ee-a1d1-3fb8-bc6b-439b9ba6916d",
                                        "entry_id": "6401cfbe-8057-3c67-b689-a8b2d6da0838",
                                        "glosses": [
                                            "Espèce d’érable nord-américain."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe1109c4-dd77-4972-91b7-707d94493c46",
                                                "sense_id": "78b4f1ee-a1d1-3fb8-bc6b-439b9ba6916d",
                                                "text": "Mais la classification botanique populaire s’est enrichie chez nous de plusieurs dénominations nouvelles, dont je citerai les suivantes : la plaine, pour désigner l’une des espèces de l’érable ; la catherinette, ainsi que parfois nous nommons ici la mûre ou la ronce ; la surette, qui n’est autre que l’oseille."
                                            }
                                        ]
                                    }
