                        "target_lang_word": "microbrasserie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "microbrasserie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd5261ff-f71e-3617-b8e6-39c41886f5e1",
                                        "entry_id": "0a20cef6-8e46-3399-b29c-605a91a25b62",
                                        "glosses": [
                                            "Brasserie de petite taille par rapport à l’ensemble du marché."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70a6ebe6-2b42-4006-80e4-73bc9da6a9f3",
                                                "sense_id": "fd5261ff-f71e-3617-b8e6-39c41886f5e1",
                                                "text": "Unibroue a été une des premières microbrasseries québécoises."
                                            },
                                            {
                                                "example_id": "02921ef5-2169-41bb-91ff-fa6589a6f145",
                                                "sense_id": "fd5261ff-f71e-3617-b8e6-39c41886f5e1",
                                                "text": "[…] la douzaine de microbrasseries n’occupent tout de même que 5 à 7 % du marché [au Québec] […]."
                                            },
                                            {
                                                "example_id": "4579984d-4fbb-48b3-8d6f-411492e5c0e6",
                                                "sense_id": "fd5261ff-f71e-3617-b8e6-39c41886f5e1",
                                                "text": "Alors qu’elles s’étaient que quelques-unes il y a 20 ans, elles sont des douzaines aujourd’hui. Établies un peu partout au Québec, ces microbrasseries brassent des centaines de bières originales pour le plus grand plaisir des dégustateurs."
                                            },
                                            {
                                                "example_id": "5a3787a5-f2ae-482b-a6b3-30e4b793faec",
                                                "sense_id": "fd5261ff-f71e-3617-b8e6-39c41886f5e1",
                                                "text": "Le Sergent Recruteur est une microbrasserie qui se targue aujourd’hui d’être et de vouloir rester artisanale."
                                            },
                                            {
                                                "example_id": "9d98c8c1-3fdf-45d3-aae4-42f45d370671",
                                                "sense_id": "fd5261ff-f71e-3617-b8e6-39c41886f5e1",
                                                "text": "[…] une bière au cassis (intéressante mais à l’amertume un peu forte) brassée spécialement pour La Monnaguette par l’audacieuse microbrasserie La Barberie."
                                            },
                                            {
                                                "example_id": "72705ab1-c951-4a91-8229-59e81db53a44",
                                                "sense_id": "fd5261ff-f71e-3617-b8e6-39c41886f5e1",
                                                "text": "Ainsi, la microbrasserie écossaise Brewdog, fondée en 2007 par deux personnes, en emploie 2 600 en 2023 réparties dans 65 pays, dont l’Inde. A une échelle moindre, Ninkasi et la Brasserie du Mont-Blanc sont très présents sur les rayonnages français."
                                            }
                                        ]
                                    }
                                ]
                            }
