                    "frequency": "VeryLow",
                    "semantic_group_id": "blessure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chevalier revint <w>navré</w> du tournoi après avoir reçu un coup de lance."
                        },
                        {
                            "text": "Les médecins s'empressèrent de soigner le soldat grièvement <w>navré</w> sur le champ de bataille."
