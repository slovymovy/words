                    {
                        "translation_id": "0c4d77b6-2f9f-4fa9-9660-5e4431a8341a",
                        "source_entry_id": "d0efb84a-82d6-3b75-acb3-0a560bc799be",
                        "source_sense_description": "zoology: of animal with regulated temperature",
                        "target_lang_word": "warmbloedig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "warmbloedig",
