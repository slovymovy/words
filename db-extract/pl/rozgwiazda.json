                                "target_senses": [
                                    {
                                        "sense_id": "c0d49ac9-5c13-3984-97dc-33fcdaa03ac1",
                                        "entry_id": "da7a2df9-c8c0-3bd8-8eb0-d458168af90c",
                                        "glosses": [
                                            "Any of various echinoderms (not in fact fish) with usually five arms, many of which eat bivalves or corals by everting their stomach."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e447c7e-1f7a-4963-abad-4d7d61cd64fa",
                                                "sense_id": "c0d49ac9-5c13-3984-97dc-33fcdaa03ac1",
                                                "text": "Near-synonym: Asteroidea"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdcfe9c9-8403-3614-a4cd-55f3eeeace35",
                                        "entry_id": "da7a2df9-c8c0-3bd8-8eb0-d458168af90c",
                                        "glosses": [
                                            "Any many-armed or tentacled sea invertebrate, whether cnidarian, echinoderm, or cephalopod."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d06ede4-3f5c-4454-b643-6a8d9fc16faf",
                                                "sense_id": "fdcfe9c9-8403-3614-a4cd-55f3eeeace35",
                                                "text": "But the largest of the star-fish kind is that sea monster called kruken, kraken or krabben. [...] As this enormous sea-animal in all probability may be reckoned of the polype, or of the star-fish, kind, it seems that the parts which are seen rising at its pleasure, and are called arms, are properly the tentacula, or feeding instruments, called horns as well as arms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac43489c-ac24-3215-aaac-903454b0aa38",
                                        "entry_id": "da7a2df9-c8c0-3bd8-8eb0-d458168af90c",
                                        "glosses": [
                                            "A woman (or, less commonly, a gay man) who reluctantly takes part in sexual intercourse, and lies on the back while spreading the limbs."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "44e3fa34-03be-3847-9da1-ff44bf862395",
                                        "entry_id": "da7a2df9-c8c0-3bd8-8eb0-d458168af90c",
                                        "glosses": [
                                            "The anus."
                                        ],
                                        "tags": [
                                            "slang",
                                            "usually",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff62a727-00f3-4b10-8324-ed847b54d316",
                                                "sense_id": "44e3fa34-03be-3847-9da1-ff44bf862395",
                                                "text": "Hands separated my ass cheeks while some pervert rimmed my puckered brown starfish."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "starfish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3360a6d8-0e11-3dff-9bd3-1b02206c26e5",
                                        "entry_id": "0607a96e-b0f3-362e-b271-71dcae5fddd1",
                                        "glosses": [
                                            "To assume a splayed-out shape, like that of a starfish."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b66b517d-27bc-4dfe-bec8-83a7d2a09766",
                                                "sense_id": "3360a6d8-0e11-3dff-9bd3-1b02206c26e5",
                                                "text": "\"Oh you damn bastard, why won't you let anybody love you,\" and then, before I could stop her, she threw herself between us and the glowing suitcase, starfishing in the blaze of light as he blew up."
                                            },
                                            {
                                                "example_id": "635cf7b1-7ed1-484c-b5ec-611a515730c3",
                                                "sense_id": "3360a6d8-0e11-3dff-9bd3-1b02206c26e5",
                                                "text": "The freckle on her eye starfished out and the sun began to move over her face like it does below the surface of water."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93beeb72-1d01-33e5-bb34-057389ed1ecb",
                                        "entry_id": "0607a96e-b0f3-362e-b271-71dcae5fddd1",
                                        "glosses": [
                                            "To assume a splayed-out shape, like that of a starfish.",
                                            "While floating on water"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "43008de8-d98b-31a6-9004-8252c601b4a3",
                                        "entry_id": "0607a96e-b0f3-362e-b271-71dcae5fddd1",
                                        "glosses": [
                                            "To form into a splayed-out shape, like that of a starfish."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4280f5bf-2077-4602-a8c6-c686bce2d85d",
                                                "sense_id": "43008de8-d98b-31a6-9004-8252c601b4a3",
                                                "text": "The sea roared up her nostrils, tunnelled into her ears, and flung her forward, then back, the current pulling her fingers apart, starfishing her hands."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
