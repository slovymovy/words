                        "form": "die Verlogenheit"
                    },
                    {
                        "form_id": "2275f523-bfc3-4045-8888-5d8179e7b78b",
                        "entry_id": "224da276-d2dc-389a-b849-2485cd45298a",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Verlogenheiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c07a4f6f-68cc-3e16-96c5-d624dfd96c4b",
                        "entry_id": "224da276-d2dc-389a-b849-2485cd45298a",
                        "glosses": [
                            "Eigenschaft einer Person, Unwahres vorzutäuschen, öfter zu lügen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bdcc939-173f-4eef-b191-409422471f09",
                                "sense_id": "c07a4f6f-68cc-3e16-96c5-d624dfd96c4b",
                                "text": "„Um bei dem Beispiel Stalins zu bleiben, so war neben seiner Grausamkeit eine seiner charakteristischsten Eigenschaften seine Verlogenheit.“"
                            },
                            {
                                "example_id": "45ba40c2-2ed5-4f66-b094-da092a42fea4",
                                "sense_id": "c07a4f6f-68cc-3e16-96c5-d624dfd96c4b",
                                "text": "„Ich konnte die kaputten Halbwüchsigen nicht mehr ertragen, ihre Verschlagenheit, ihre Großmäuligkeit, ihre Frechheit, ihre Faulheit, ihre Bösartigkeit, ihre Verlogenheit und ihre Gerissenheit.“"
                            },
                            {
                                "example_id": "075ebcc1-4741-47d6-8c7d-111f29c82339",
                                "sense_id": "c07a4f6f-68cc-3e16-96c5-d624dfd96c4b",
                                "text": "„Sobald man an der Oberfläche von Politik und Wirtschaft etwas am Glanz kratzt, stößt man auf ein unentwirrbares Geflecht von Korruption und Verlogenheit.“"
                            },
                            {
                                "example_id": "d71cc732-9a0c-4b3c-9438-40721b8307fa",
                                "sense_id": "c07a4f6f-68cc-3e16-96c5-d624dfd96c4b",
                                "text": "„Er war sich klar darüber, daß sich auch seine Richter, die ihn zu diesem Fehlschwur gezwungen hatten, der Verlogenheit der Situation bewußt waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f7dd43d3-2ccb-452f-8b1d-fc5a49c0a95b",
                        "source_entry_id": "224da276-d2dc-389a-b849-2485cd45298a",
                        "source_sense_id": "c07a4f6f-68cc-3e16-96c5-d624dfd96c4b",
                        "source_sense_description": "Eigenschaft einer Person, Unwahres vorzutäuschen, öfter zu lügen",
                        "target_lang_word": "mendacity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mendacity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b78c57e-1085-3b36-b525-a3a70fda1837",
                                        "entry_id": "90bc80f7-6d68-3b5a-8825-b1a4fce00caf",
                                        "glosses": [
                                            "The fact or condition of being untruthful; dishonesty."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed959003-929a-479d-9a2b-cb0a1dcafb07",
                                                "sense_id": "6b78c57e-1085-3b36-b525-a3a70fda1837",
                                                "text": "Mendacity is not a uniform offence: it changes its colour according to the nature and substance of the offence to which it is rendered or endeavoured to be rendered subservient. Mendacity, employed in drawing down upon an innocent head the destroying sword of justice, is murder: murder, encompassed with all its correspondent terror. Mendacity, employed in the obtainment of money, is but depredation. Yet, while predatory mendacity is punished with death, the punishment for the murderous mendacity is in comparison but a flea-bite."
                                            },
                                            {
                                                "example_id": "ae7501bd-880c-43c2-8185-258b45edcfe3",
                                                "sense_id": "6b78c57e-1085-3b36-b525-a3a70fda1837",
                                                "text": "[…] Treating the assertion of the witness as the effect, he [Pierre-Simon Laplace] considers as its two possible causes, the veracity or mendacity of the witness on the particular occasion, that is, the truth or falsity of the fact."
                                            },
                                            {
                                                "example_id": "2ed4f9b0-cb50-4b2f-afd3-b370235faaba",
                                                "sense_id": "6b78c57e-1085-3b36-b525-a3a70fda1837",
                                                "text": "Big Daddy: […] Think of all the lies I got to put up with!—Pretenses! Ain't that mendacity? Having to pretend stuff you don't think or feel or have any idea of?"
                                            },
                                            {
                                                "example_id": "0de18395-958c-4da0-89e8-df4a03777383",
                                                "sense_id": "6b78c57e-1085-3b36-b525-a3a70fda1837",
                                                "text": "So now the hard Brexiters say, with astonishingly cynical mendacity, that Britain would be better off going it alone."
                                            },
                                            {
                                                "example_id": "32f0ac6a-ac83-4509-b5ca-02c6cf67dc99",
                                                "sense_id": "6b78c57e-1085-3b36-b525-a3a70fda1837",
                                                "text": "A shifty or unreliable politician may hide their mendacity behind deceit, fabrication on confabulation, or by rehearsed counter-attack that simply ignores the questions but makes imputations against the other."
                                            },
                                            {
                                                "example_id": "a91e40e4-04d2-49b9-aaf4-e07d5d0f3dd5",
                                                "sense_id": "6b78c57e-1085-3b36-b525-a3a70fda1837",
                                                "text": "And when presidential counsellor Kellyanne Conway coined the phrase “alternative facts” a few days after Trump’s inauguration in early 2017, the mendacity of the incoming administration appeared to be all but official."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd4190df-30f4-3cd6-beb4-b44e31ab01e3",
                                        "entry_id": "90bc80f7-6d68-3b5a-8825-b1a4fce00caf",
                                        "glosses": [
                                            "A deceit, falsehood, or lie."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01920edd-c701-4ba5-a702-735e90d21c7b",
                                                "sense_id": "dd4190df-30f4-3cd6-beb4-b44e31ab01e3",
                                                "text": "The scandalous bronze-lacker age, of hungry animalisms, spiritual impotencies and mendacities, will have to run its course, till the Pit swallow it."
                                            },
                                            {
                                                "example_id": "71f4dd5d-acea-49c2-af91-bb19d0936da1",
                                                "sense_id": "dd4190df-30f4-3cd6-beb4-b44e31ab01e3",
                                                "text": "Though the rebels had utterly failed in their purposes, having accomplished nothing but the temporary disabling of two lightly armed vessels, and had retreated before the approach of the only formidable vessel there, they formally, and with a mendacity equalled only by some of their own efforts in that direction, proclaimed that they had \"driven out of sight, for a time, the entire hostile fleet,\" and that the blockade of the port of Charleston was raised."
                                            },
                                            {
                                                "example_id": "d6ce6c61-87c2-4f39-a86c-6ff7e33dac25",
                                                "sense_id": "dd4190df-30f4-3cd6-beb4-b44e31ab01e3",
                                                "text": "He would have you believe that every error we make is deliberate, that journalists have somehow ginned up a unified conspiracy of lies and mendacities against him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c45fc0a-ed0d-4b38-a0d4-6d93cac1b5ec",
                        "source_entry_id": "224da276-d2dc-389a-b849-2485cd45298a",
                        "source_sense_id": "c07a4f6f-68cc-3e16-96c5-d624dfd96c4b",
                        "source_sense_description": "Eigenschaft einer Person, Unwahres vorzutäuschen, öfter zu lügen",
                        "target_lang_word": "hypocrisy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hypocrisy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca88c147-93b2-3ed9-8775-b32191239e0e",
                                        "entry_id": "6c83e06e-fc8c-397b-9c40-8bcb975166bc",
                                        "glosses": [
                                            "The contrivance of a false appearance of virtue or goodness, while concealing real character or inclinations, especially with respect to religious and moral beliefs; hence in general sense, dissimulation, pretence, sham."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31075058-ad03-47b9-bf62-ebdd0313c7ac",
                                                "sense_id": "ca88c147-93b2-3ed9-8775-b32191239e0e",
                                                "text": "political hypocrisy"
                                            },
                                            {
                                                "example_id": "770d7719-4297-40be-a0cc-0d5f835fa782",
                                                "sense_id": "ca88c147-93b2-3ed9-8775-b32191239e0e",
                                                "text": "He condemned the hypocrisy of politicians who broke their own laws."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c0567de-4505-3417-9cc9-bc3d3cad9b87",
                                        "entry_id": "6c83e06e-fc8c-397b-9c40-8bcb975166bc",
                                        "glosses": [
                                            "The claim or pretense of having beliefs, standards, qualities, behaviours, virtues, motivations, etc. which one does not really have."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87329f87-8458-49d3-8097-9349bee93b90",
                                                "sense_id": "9c0567de-4505-3417-9cc9-bc3d3cad9b87",
                                                "text": "rank hypocrisy"
                                            },
                                            {
                                                "example_id": "267a85cc-f06c-4cdc-963e-c273013969db",
                                                "sense_id": "9c0567de-4505-3417-9cc9-bc3d3cad9b87",
                                                "text": "charge of hypocrisy"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45dffe3d-9f1a-3719-a1a1-baf07453151f",
                                        "entry_id": "6c83e06e-fc8c-397b-9c40-8bcb975166bc",
                                        "glosses": [
                                            "The practice of engaging in the same behaviour or activity for which one criticises another; moral self-contradiction whereby the behavior of one or more people belies their own claimed or implied possession of certain beliefs, standards or virtues."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1cfb1c5a-b232-3aa9-acec-bf5edd0241cf",
                                        "entry_id": "6c83e06e-fc8c-397b-9c40-8bcb975166bc",
                                        "glosses": [
                                            "An instance of hypocrisy."
                                        ],
                                        "tags": [
                                            "countable",
