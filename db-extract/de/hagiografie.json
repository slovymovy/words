                ],
                "senses": [
                    {
                        "sense_id": "38520202-12a9-3f52-82f8-3f9de77405a6",
                        "entry_id": "b896d443-43d8-3361-bfd7-09c974440768",
                        "glosses": [
                            "Erforschung und Lebensbeschreibung der Heiligen; mittelalterliche Beschreibungen von Heiligen-, Mönchs- und Asketenleben"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "8f8672c7-0b57-4549-95d6-59eb56193e7f",
                                "sense_id": "38520202-12a9-3f52-82f8-3f9de77405a6",
                                "text": "Die aus dem europäischen Mittelalter überlieferten Schriften werden im weiten Sinne als Hagiografie bezeichnet."
                            },
                            {
                                "example_id": "eb19d326-05fa-47ea-b907-720f5c0b46c2",
                                "sense_id": "38520202-12a9-3f52-82f8-3f9de77405a6",
                                "text": "Das bekannteste Sammelwerk der Hagiografie ist die lateinische „Legenda aurea“ (Goldene Legende) des Jacobus de Voragine."
                            },
                            {
                                "example_id": "055fdeb9-84c1-4c7e-af22-0e45fa2d872c",
                                "sense_id": "38520202-12a9-3f52-82f8-3f9de77405a6",
                                "text": "Die Hagiografie war die wichtigste biographische Quellengattung des Mittelalters."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d758dba4-9ea3-4d9d-b68a-fdc540ce5f90",
                        "source_entry_id": "b896d443-43d8-3361-bfd7-09c974440768",
                        "source_sense_id": "38520202-12a9-3f52-82f8-3f9de77405a6",
                        "target_lang_word": "hagiography",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hagiography",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9366c969-3c51-3aba-9d4a-29f73aaa149a",
                                        "entry_id": "1bcbb0f3-920d-3bda-82d2-d0b10e815e9f",
                                        "glosses": [
                                            "The study of saints and the documentation of their lives."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06ffb3b0-57a0-4143-99e8-de3972346d77",
                                                "sense_id": "9366c969-3c51-3aba-9d4a-29f73aaa149a",
                                                "text": "The second half of the eleventh century saw a notable surge of interest in hagiography throughout England, which meant that many of the Anglo-Saxon saints of earlier eras were furnished, often for the first time, with a Latin Vita."
                                            },
                                            {
                                                "example_id": "b0e3f736-70fa-47ee-8408-a005210df283",
                                                "sense_id": "9366c969-3c51-3aba-9d4a-29f73aaa149a",
                                                "text": "Jacques LeGoff remarks, 'Hagiography tells us much about the mental infrastructure [of the middle ages]: the interpenetration between the tangible world and the supernatural world, the common nature of the corporeal and psychic, are the conditions which make miracles and related phenomena possible."
                                            },
                                            {
                                                "example_id": "1deef74b-d69d-46e1-b8e5-4e45fa2e3f95",
                                                "sense_id": "9366c969-3c51-3aba-9d4a-29f73aaa149a",
                                                "text": "Charters, wills, and monastic rules offer evidence for this transformation, but it is hagiography and its double-scoped discourse that illuminates it best, and we will start with a vita that pursued the question of peroperty and prestige more comprehensively than the rest, the Vita Sadalbergae."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c02765ee-495e-39d9-81f8-a49ce9779084",
                                        "entry_id": "1bcbb0f3-920d-3bda-82d2-d0b10e815e9f",
                                        "glosses": [
                                            "A biography of a saint."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e4ac2618-67bc-3ce1-89e5-2ff1c60d40a7",
                                        "entry_id": "1bcbb0f3-920d-3bda-82d2-d0b10e815e9f",
                                        "glosses": [
                                            "A biography which expresses reverence and respect for its subject."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e15a1596-148f-4506-9fec-97e76acef847",
                                                "sense_id": "e4ac2618-67bc-3ce1-89e5-2ff1c60d40a7",
                                                "text": "Churchill revisionism, of course, is almost as much of a cottage industry as Churchill hagiography."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88036bdc-7769-3e70-bf40-43a72fcfe71d",
                                        "entry_id": "1bcbb0f3-920d-3bda-82d2-d0b10e815e9f",
                                        "glosses": [
                                            "A biography which is uncritically supportive of its subject, often including embellishments or propaganda."
                                        ],
                                        "tags": [
                                            "countable",
                                            "derogatory",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94b1fa8a-ceed-4055-8eab-834ebb96d924",
                                                "sense_id": "88036bdc-7769-3e70-bf40-43a72fcfe71d",
                                                "text": "For an obsequious hagiography of [William] Byrd, see L. Wright 1940. For a more critical assessment, see Lockridge 1987, 1992."
                                            },
                                            {
                                                "example_id": "f1d9554f-f4e0-4be2-82ca-8c38f1a21f2f",
                                                "sense_id": "88036bdc-7769-3e70-bf40-43a72fcfe71d",
                                                "text": "This 'cultivated characteriology' (ibid., p. 117) is one that she suggests has been reduced to the cult of the theorist's personality in many of the hagiographies written about Foucault, missing how he cultivated his ethos or characteriology in order to persuade, seduce, unsettle, question, and so forth."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41a3abec-5754-4169-b9d4-93bf4ae5e608",
                        "source_entry_id": "b896d443-43d8-3361-bfd7-09c974440768",
                        "source_sense_id": "38520202-12a9-3f52-82f8-3f9de77405a6",
                        "target_lang_word": "hagiographie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hagiographie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bfbcbac6-2b42-3d71-b7d6-748666c4beef",
                                        "entry_id": "8c1d8024-c51c-33c3-b7ea-47cdaee7d3f5",
                                        "glosses": [
                                            "Traité sur les choses saintes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5811d945-ef9c-4c2d-93ac-79185c85c013",
                                                "sense_id": "bfbcbac6-2b42-3d71-b7d6-748666c4beef",
                                                "text": "Ce miracle, ignoré du clergé local au XVIIᵉ siècle, est sûrement le produit de l’imagination de certains spécialistes en hagiographie."
                                            },
                                            {
                                                "example_id": "6106dc2b-b80a-47b5-897b-e60755c00d3a",
                                                "sense_id": "bfbcbac6-2b42-3d71-b7d6-748666c4beef",
                                                "text": "Entre tant de particularités que la Bretagne possède en propre, l’hagiographie locale est sûrement la plus singulière. Quand on visite à pied le pays, une chose frappe au premier coup d’œil. Les églises paroissiales, où se fait le culte du dimanche, ne diffèrent pas essentiellement de celles des autres pays. Que si l’on parcourt la campagne, au contraire, on rencontre souvent dans une seule paroisse jusqu’à dix et quinze chapelles, petites maisonnettes n’ayant le plus souvent qu’une porte et une fenêtre, et dédiées à un saint dont on n’a jamais entendu parler dans le reste de la chrétienté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c23264af-e5dc-3756-af14-4088bd00eb8f",
                                        "entry_id": "8c1d8024-c51c-33c3-b7ea-47cdaee7d3f5",
                                        "glosses": [
                                            "Biographie d’un ou plusieurs saints."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9daef2b2-354f-4a04-bb5b-9f1214a06c57",
                                                "sense_id": "c23264af-e5dc-3756-af14-4088bd00eb8f",
                                                "text": "Le récit de la vie de Rolende, tel que le faisait Octave, est très éloigné du romanesque plat de l’hagiographie apocryphe du XVIIIᵉ siècle, La princesse fugitive ou la vie de Sainte Rolende, et de la prose de sacristie des brochures qu’on distribue à l’église. Un poète a passé par là."
                                            },
                                            {
                                                "example_id": "c1f87a48-f1f3-4fda-b43c-d2d02d5384dc",
                                                "sense_id": "c23264af-e5dc-3756-af14-4088bd00eb8f",
                                                "text": "C’est pourquoi l’hagiographie insiste si souvent sur l’origine noble du saint, que sa conversion rend plus noble encore."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62a032c7-b76d-3377-9b07-a59f6aa45e08",
                                        "entry_id": "8c1d8024-c51c-33c3-b7ea-47cdaee7d3f5",
                                        "glosses": [
                                            "Biographie très ou trop louangeuse."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02b5e2a9-f8cd-4ca3-a153-a93a3db6f3c5",
                                                "sense_id": "62a032c7-b76d-3377-9b07-a59f6aa45e08",
                                                "text": "Que faire du passé des dictateurs et de leurs tortionnaires encore vivants ? Voilà qu’un pays s’offre le courage de regarder sa mémoire au lieu d’en faire une hagiographie."
                                            },
                                            {
                                                "example_id": "7927a70e-addd-497f-896a-e5d0fefa8040",
                                                "sense_id": "62a032c7-b76d-3377-9b07-a59f6aa45e08",
                                                "text": "Tandis que les heurs et malheurs des autres membres du groupe passent par pertes et profits, comme dans tout film de fan virant à l’hagiographie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8605ed9f-f7fa-4a92-b3f0-52336bb4ff95",
                        "source_entry_id": "b896d443-43d8-3361-bfd7-09c974440768",
                        "source_sense_id": "38520202-12a9-3f52-82f8-3f9de77405a6",
