                                "target_senses": [
                                    {
                                        "sense_id": "a710540d-8288-36d2-b5e7-a877fe123f2d",
                                        "entry_id": "56a2fd21-9ae5-38b9-9e37-ccc470961d18",
                                        "glosses": [
                                            "A teenager who imitated the beatniks."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2bf1b7b9-1b2e-3ed6-899f-ad7148272b77",
                                        "entry_id": "56a2fd21-9ae5-38b9-9e37-ccc470961d18",
                                        "glosses": [
                                            "One who chooses not to conform to prevailing social norms: especially one who subscribes to values or actions such as acceptance or self-practice of recreational drug use, liberal or radical sexual mores, advocacy of communal living, strong pacifism or anti-war sentiment, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "61a47bf9-82fd-33ea-bb2f-2f7524ce76cb",
                                        "entry_id": "56a2fd21-9ae5-38b9-9e37-ccc470961d18",
                                        "glosses": [
                                            "A person who keeps an unkempt or sloppy appearance and has unusually long hair (for males), and is thus often stereotyped as a deadbeat."
                                        ],
                                        "tags": [
                                            "modern",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "25a9e7aa-58f6-37da-9a4b-bb7f6f4ddbf7",
                                        "entry_id": "56a2fd21-9ae5-38b9-9e37-ccc470961d18",
                                        "glosses": [
                                            "Someone who dresses in a hippie style."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cef05e36-999c-3989-9fb0-33297d018f2b",
                                        "entry_id": "56a2fd21-9ae5-38b9-9e37-ccc470961d18",
                                        "glosses": [
                                            "One who is hip."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hippie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ee2f36e-cc48-33f6-81b7-4eb6311d560f",
                                        "entry_id": "d3735f13-929a-324a-bb4f-499db36a68e8",
                                        "glosses": [
                                            "Of or pertaining to hippies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "862e91a2-8e3d-44fe-9caa-ff76533d5420",
                                                "sense_id": "5ee2f36e-cc48-33f6-81b7-4eb6311d560f",
                                                "text": "That dress looks very hippie."
                                            },
                                            {
                                                "example_id": "b0799aa2-e4c3-4f53-9891-805665213053",
                                                "sense_id": "5ee2f36e-cc48-33f6-81b7-4eb6311d560f",
                                                "text": "The drug-taking he's writing about is less hippie than punk: it's about speed and smack and pills as much as hallucinogens and weed, about compulsion as well as escape."
                                            },
                                            {
                                                "example_id": "b7dc1f9a-9d09-4413-b938-cb7a805a1df0",
                                                "sense_id": "5ee2f36e-cc48-33f6-81b7-4eb6311d560f",
                                                "text": "You have to understand I worked in a very hippie nightclub for years, and the majority of the staff did not even like the Grateful Dead."
                                            },
                                            {
                                                "example_id": "b37353ef-b6c7-40a2-8adb-00a95b5b0c85",
                                                "sense_id": "5ee2f36e-cc48-33f6-81b7-4eb6311d560f",
                                                "text": "And then I discovered LSD, you can't get much more hippie than that."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a705f042-4fc1-3189-83a2-1d5b8d63d829",
                                        "entry_id": "d3735f13-929a-324a-bb4f-499db36a68e8",
                                        "glosses": [
                                            "Not conforming to generally accepted standards."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "706ffcc0-0ba1-4160-98c0-5ddb8e3a4b1b",
                                                "sense_id": "a705f042-4fc1-3189-83a2-1d5b8d63d829",
                                                "text": "They used a bunch of hippie compression formats instead of the usual RAR and ZIP."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d4f749a-7ad0-45f7-b765-99756cda2b92",
                        "source_entry_id": "b871dfc4-8f16-37f3-9491-cbe7b31fb10b",
                        "source_sense_id": "1d132bc1-8f07-302c-8ac4-47f34fb2cd4d",
                        "source_sense_description": "Person aus einer Jugendbewegung der 1960er und 1970er Jahre",
                        "target_lang_word": "хиппи",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "хиппи",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "37fbff4e-3a70-39ac-96c2-c75aa79aca16",
                                        "entry_id": "54b8b5e7-e5bd-33cd-922a-1a364ee8beb7",
                                        "glosses": [
                                            "неодуш. неформальное движение бунтарски настроенной молодёжи, возникшее на Западе в 60-е годы XX в., отличавшееся нарочитым пренебрежением к общепринятым нормам жизни и выражающее свой протест обществу и его морали утверждением собственной свободы путём ухода от общества, семьи, цивилизации"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4584baa4-98fe-4f94-be39-1f8411d67474",
                                                "sense_id": "37fbff4e-3a70-39ac-96c2-c75aa79aca16",
                                                "text": "В Москве уже достаточно сформировалось движение хиппи со своими лидерами, подпольными «хатами», «плешками», концертами и «сэшенами» в разных хитрых клубах."
                                            },
                                            {
                                                "example_id": "83bc155b-1c82-492f-87eb-f7fbf50a3ca5",
                                                "sense_id": "37fbff4e-3a70-39ac-96c2-c75aa79aca16",
                                                "text": "Но светлый дух хиппи витал над нами — деньги были не модны."
                                            },
                                            {
                                                "example_id": "b667955b-a025-49d7-a396-1840ca25a4a2",
                                                "sense_id": "37fbff4e-3a70-39ac-96c2-c75aa79aca16",
                                                "text": "Я бы добавил сюда и многочисленных проповедников неоиндуизма, чьи «духовные школы» были весьма модны среди западной молодёжи в эпоху хиппи, да подчас и сегодня."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b60da82e-5f12-31d4-af07-d9132659b8a4",
                                        "entry_id": "54b8b5e7-e5bd-33cd-922a-1a364ee8beb7",
                                        "glosses": [
                                            "представитель этого движения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7b795fb-bb6f-472b-b48d-3741d8f8ad6a",
                                                "sense_id": "b60da82e-5f12-31d4-af07-d9132659b8a4",
                                                "text": "Полицейский внушает что-то мотоциклисту — босому, бородатому хиппи…"
                                            },
                                            {
                                                "example_id": "f8ab7143-dbce-4714-a2d5-b60bf79abf8c",
                                                "sense_id": "b60da82e-5f12-31d4-af07-d9132659b8a4",
                                                "text": "Хиппи мы не были — это подразумевает абсолютно бездеятельное начало, а мы всё-таки музыку сочиняли."
                                            },
                                            {
                                                "example_id": "92d418e8-c298-4650-98f8-37859f719743",
                                                "sense_id": "b60da82e-5f12-31d4-af07-d9132659b8a4",
                                                "text": "Егор был в то время хиппи, ездил автостопом по стране, «тусовался» — тогда это слово было принадлежностью хипповского сленга, труднопонимаемо, и всуе цивильными гражданами не употреблялось."
                                            },
                                            {
                                                "example_id": "ce8ec3b4-fa71-487a-9cb3-b63850e6c472",
                                                "sense_id": "b60da82e-5f12-31d4-af07-d9132659b8a4",
                                                "text": "Душевная тонкость, требовательность характера выдавали в ней больше тургеневскую девушку, чем современную хиппи."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92b4e1ab-ee11-3262-a191-4ad8c0c32675",
                                        "entry_id": "54b8b5e7-e5bd-33cd-922a-1a364ee8beb7",
                                        "glosses": [
                                            "разг. тот, кто нарочито небрежно или претенциозно одевается и экстравагантно ведёт себя"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdd3ee7a-19d5-4d7b-9583-e84946475532",
                                                "sense_id": "92b4e1ab-ee11-3262-a191-4ad8c0c32675",
                                                "text": "И отчасти жалкой, несмотря на вызывающий наряд: сегодня она была одета как хиппи."
                                            },
                                            {
                                                "example_id": "b083954d-7c14-4b3a-bca6-f3cc08cb878d",
                                                "sense_id": "92b4e1ab-ee11-3262-a191-4ad8c0c32675",
                                                "text": "В своём вызывающе дорогом и вызывающе консервативном костюме он выделялся среди разноцветной богемной публики как первый хиппи среди оксфордских выпускников."
                                            },
                                            {
                                                "example_id": "54e74a80-189e-480b-ac4c-d044fbb66287",
                                                "sense_id": "92b4e1ab-ee11-3262-a191-4ad8c0c32675",
                                                "text": "Трактовка образа Дункан как «первой хиппи», бросающей вызов обществу, оказалась весьма созвучна настроениям, охватившим левую интеллигенцию в 60-е годы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
