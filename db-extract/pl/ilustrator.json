                                        "entry_id": "390ef112-b61c-3543-8d90-45d8281c0e0c",
                                        "glosses": [
                                            "(männliche) Person, die hobbymäßig oder beruflich Bilder zeichnet oder erstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9e5c639-129a-4249-b02a-24818087671e",
                                                "sense_id": "b6c19450-e304-355d-8540-cfd6e85812c8",
                                                "text": "Er ist als Zeichner kleiner Kurzgeschichten bekannt geworden."
                                            },
                                            {
                                                "example_id": "6b10738b-9c4f-4c81-81ed-7611800e22ad",
                                                "sense_id": "b6c19450-e304-355d-8540-cfd6e85812c8",
                                                "text": "„Die Bekanntschaft mit den dortigen Redakteurinnen und Zeichnern soll ihm später noch einmal sehr nützlich werden.“"
                                            },
                                            {
                                                "example_id": "09a422ba-7e5a-4b88-a68f-aebe10465673",
                                                "sense_id": "b6c19450-e304-355d-8540-cfd6e85812c8",
                                                "text": "„Der Zeichner stand in beredter Stummheit neben ihm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "32257e4d-9a16-317c-b244-c25f2be3dd9b",
                                        "entry_id": "390ef112-b61c-3543-8d90-45d8281c0e0c",
                                        "glosses": [
                                            "Urheber einer Zeichnung, der nicht ständig, vielleicht nur einmal zeichnet beziehungsweise gezeichnet hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1adede74-0aa6-4af4-aa02-3ad4ad775132",
                                                "sense_id": "32257e4d-9a16-317c-b244-c25f2be3dd9b",
                                                "text": "Wer mag wohl der Zeichner dieses Werks gewesen sein?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ee92c852-4f85-3ae3-95f3-f632f4bf724e",
                                        "entry_id": "390ef112-b61c-3543-8d90-45d8281c0e0c",
                                        "glosses": [
                                            "Inhaber einer Schuldverschreibung"
