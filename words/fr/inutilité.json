                    "frequency": "Middle",
                    "semantic_group_id": "inutilite_caractere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'est rapidement rendu compte de l'<w>inutilité</w> de ses démarches administratives."
                        },
                        {
                            "text": "Face à l'ampleur de la crise, il éprouvait un profond sentiment d'<w>inutilité</w>."
                        }
                    ],
                    "synonyms": [
                        "inefficacité",
                        "superfluité",
                        "vanité"
                    ],
                    "antonyms": [
                        "utilité"
                    ],
                    "common_phrases": [
                        "sentiment d'inutilité"
                    ]
                },
                {
                    "sense_id": "7af42b3e-d409-3c7c-820e-756d8e73a682",
                    "sense_definition": "Chose, propos ou action qui manque d'utilité et présente un caractère superflu.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "inutilite_chose",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa chambre était encombrée de bibelots et d'autres <w>inutilités</w> achetées en brocante."
                        },
                        {
                            "text": "Ne perds pas ton temps précieux avec de telles <w>inutilités</w> au travail."
                        }
                    ],
                    "synonyms": [
                        "futilité",
                        "bagatelle",
                        "superfluité"
                    ],
                    "common_phrases": [
                        "amas d'inutilités",
                        "dépenser pour des inutilités"
                    ]
                },
                {
                    "sense_id": "bf8bedc5-5299-3e3d-97f2-fcd6a2792bfb",
                    "sense_definition": "État d'une personne à laquelle on ne donne pas d'emploi ou d'occasion d'exercer ses capacités.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "inutilite_inaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce brillant ingénieur souffrait d'être ainsi laissé dans l'<w>inutilité</w> par ses supérieurs."
                        },
                        {
                            "text": "Elle refusait de sombrer dans l'<w>inutilité</w> et cherchait constamment de nouveaux projets."
