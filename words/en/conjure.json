{
    "word_family": [
        "conjuration",
        "conjurer",
        "conjurement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "271d2278-1bb7-3f8d-8cc1-524ca9829dc4",
                    "sense_definition": "To bring an image, memory, or idea to mind.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The music can <w>conjure</w> up memories of childhood.",
                            "target_lang_translations": {
                                "de": "Die Musik kann Kindheitserinnerungen <w>heraufbeschwören</w>."
                            }
                        },
                        {
                            "text": "She tried to <w>conjure</w> up an image of her old hometown, but the details were fading.",
                            "target_lang_translations": {
                                "de": "Sie versuchte, ein Bild ihrer alten Heimatstadt <w>heraufzubeschwören</w>, aber die Details verblassten."
                            }
                        }
                    ],
                    "synonyms": [
                        "envisage",
                        "imagine",
                        "picture",
                        "visualize"
                    ],
                    "common_phrases": [
                        "conjure up memories",
                        "conjure up an image"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Bild, eine Erinnerung oder eine Vorstellung wachrufen oder ins Gedächtnis rufen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "heraufbeschwören",
                                "target_lang_sense_clarification": "Erinnerungen oder Gefühle wachrufen"
                            },
                            {
                                "target_lang_word": "hervorrufen",
                                "target_lang_sense_clarification": "Eindrücke oder Vorstellungen wecken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b6fc7a7-f5e4-3348-afea-94c690e74de4",
                    "sense_definition": "To perform magic tricks or invoke supernatural forces.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magician began to <w>conjure</w> trick after trick on stage.",
                            "target_lang_translations": {
                                "de": "Der Magier begann, auf der Bühne einen Trick nach dem anderen zu <w>zaubern</w>."
                            }
                        },
                        {
                            "text": "He started <w>conjuring</w> at the age of 15, and is now a famous stage magician.",
                            "target_lang_translations": {
                                "de": "Er begann im Alter von 15 Jahren zu <w>zaubern</w> und ist heute ein berühmter Bühnenmagier."
                            }
                        }
                    ],
                    "common_phrases": [
                        "conjure tricks"
                    ],
                    "target_lang_definitions": {
                        "de": "Zaubertricks vorführen oder übernatürliche Kräfte beschwören."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "zaubern",
                                "target_lang_sense_clarification": "Zaubertricks vorführen oder Magie anwenden"
                            },
                            {
                                "target_lang_word": "herbeirufen",
                                "target_lang_sense_clarification": "Geister oder übernatürliche Wesen beschwören"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e958208d-5958-3aac-9caf-c9de9fc7499a",
                    "sense_definition": "To appeal to someone solemnly or earnestly; to implore.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>conjure</w> you to speak the truth in this matter.",
                            "target_lang_translations": {
                                "de": "Ich <w>flehe</w> dich <w>an</w>, in dieser Angelegenheit die Wahrheit zu sagen."
                            }
                        },
                        {
                            "text": "She <w>conjured</w> him to stay and help the family.",
                            "target_lang_translations": {
                                "de": "Sie <w>flehte</w> ihn <w>an</w>, zu bleiben und der Familie zu helfen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in formal or literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Jemanden feierlich oder inständig anflehen bzw. beschwören."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "anflehen",
                                "target_lang_sense_clarification": "inständig um etwas bitten"
                            },
                            {
                                "target_lang_word": "ersuchen",
                                "target_lang_sense_clarification": "förmlich und dringlich bitten"
                            },
                            {
                                "target_lang_word": "bitten",
                                "target_lang_sense_clarification": "jemanden ansprechen und um etwas ersuchen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8ced58f6-c9d8-3084-83ee-22ea4f6eb817",
                    "sense_definition": "The practice of magic or trickery.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They believed in the power of traditional <w>conjure</w> and herbal remedies.",
                            "target_lang_translations": {
                                "de": "Sie glaubten an die Kraft traditioneller <w>Zauberei</w> und pflanzlicher Heilmittel."
                            }
                        },
                        {
                            "text": "Stories of southern <w>conjure</w> were passed down through generations.",
                            "target_lang_translations": {
                                "de": "Geschichten über die südstaatliche <w>Magie</w> wurden über Generationen weitergegeben."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily used in specific cultural contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Die Ausübung von Magie, Zauberei oder spirituellen Praktiken."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Zauberei",
                                "target_lang_sense_clarification": "Praxis magischer Rituale oder Tricks"
                            },
                            {
                                "target_lang_word": "Magie",
                                "target_lang_sense_clarification": "übernatürliche Praxis oder Zauberkraft"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}