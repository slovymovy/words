                            },
                            {
                                "target_lang_word": "剪除",
                                "target_lang_sense_clarification": "修剪去掉枝叶等"
                            },
                            {
                                "target_lang_word": "割除",
                                "target_lang_sense_clarification": "割断去除"
                            }
