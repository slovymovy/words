                                        "sense_id": "59f767ae-fe40-382f-b145-a5057ad749da",
                                        "entry_id": "5109a434-6854-32a9-9e48-db233f961514",
                                        "glosses": [
                                            "in ariden Gebieten und Wüsten verbreitete Gattung der Springmäuse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12b09eae-f92b-4666-82d5-85c511da78cc",
                                                "sense_id": "59f767ae-fe40-382f-b145-a5057ad749da",
                                                "text": "„Das hier sind die Leute, die nachts ins Krankenhaus wanken und behaupten, sie seien ausgerutscht und auf eine Zucchini gefallen, auf eine Glühbirne, eine Barbiepuppe, auf Billardkugeln, auf eine Wüstenspringmaus.“"
                                            }
                                        ],
