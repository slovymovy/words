        "pl-extract.jsonl": [
            {
                "entry_id": "75dd3b0e-3618-30d0-8680-dda19a9e6461",
                "word": "neuroprzekaźnik",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "14ba41e8-157e-3e25-907a-bec470d863a4",
                        "entry_id": "75dd3b0e-3618-30d0-8680-dda19a9e6461",
                        "glosses": [
                            "substancja wydzielana przez synapsy komórek nerwowych, która umożliwia przekazywanie sygnałów pomiędzy komórkami nerwowymi"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9e23191-efd9-4864-a6c1-7e6df1833631",
                        "source_entry_id": "75dd3b0e-3618-30d0-8680-dda19a9e6461",
                        "source_sense_id": "14ba41e8-157e-3e25-907a-bec470d863a4",
                        "target_lang_word": "neurotransmitter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neurotransmitter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95b8e4f8-7af0-3a8e-8ee6-f19babfd5c5d",
                                        "entry_id": "1d82cb5a-81a8-3936-9779-adcb17168da7",
                                        "glosses": [
                                            "Any substance, such as acetylcholine or dopamine, responsible for sending nerve signals across a synapse between two neurons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4c9ec71-7169-4d40-8bac-da332f70b02c",
                                                "sense_id": "95b8e4f8-7af0-3a8e-8ee6-f19babfd5c5d",
                                                "text": "Anyway, my neurotransmitters are scrambled and they're going to stay scrambled. But I can do okay as long as other people don't know about me."
                                            },
                                            {
                                                "example_id": "1e766571-5e3a-4084-8a88-9a6d90ecf126",
                                                "sense_id": "95b8e4f8-7af0-3a8e-8ee6-f19babfd5c5d",
                                                "text": "Together with this is the influence of an infinite number of neurotransmitters, neurohormones, environmental hazards, and accidental programmings."
                                            },
                                            {
                                                "example_id": "b6328af3-8a3c-43f3-bc1e-44e2cc4abeb0",
                                                "sense_id": "95b8e4f8-7af0-3a8e-8ee6-f19babfd5c5d",
                                                "text": "The class of antidepressants most commonly associated with sexual dysfunction is selective serotonin reuptake inhibitors, or SSRIs, which treat depression by ultimately increasing levels of the neurotransmitter serotonin in the brain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "139c2fe2-8109-4960-a5cb-c17c982384d2",
                        "source_entry_id": "75dd3b0e-3618-30d0-8680-dda19a9e6461",
                        "source_sense_id": "14ba41e8-157e-3e25-907a-bec470d863a4",
                        "target_lang_word": "neurotransmetteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neurotransmetteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "749217f0-0363-3072-9ef8-ac37cec1b770",
                                        "entry_id": "25c246d5-bdfb-3ec7-8bfd-2c1d67f4bfa5",
                                        "glosses": [
                                            "Composé chimique libéré par les neurones agissant sur d’autres neurones ou plus rarement sur d’autres types de cellules (comme les cellules musculaires)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d7e9786-341a-4375-8619-fa4eb13a7100",
                                                "sense_id": "749217f0-0363-3072-9ef8-ac37cec1b770",
                                                "text": "Les plus répandus de ces neurotransmetteurs sont l’acétylcholine, l’acide gamma-amino-butyrique (GABA), l’acide glutamique, la noradrénaline, la glycine, la dopamine, la sérotonine."
                                            },
                                            {
                                                "example_id": "2c101d87-68ce-4e1d-894c-f487ba6e3409",
                                                "sense_id": "749217f0-0363-3072-9ef8-ac37cec1b770",
                                                "text": "Le Suvorexant inhibe l’action des neurotransmetteurs orexines qui jouent un rôle essentiel pour le maintien de l’éveil. Il n’endort pas, il « déséveille »."
                                            },
                                            {
                                                "example_id": "67bda382-edcb-484a-ab41-ac9bf18747cc",
                                                "sense_id": "749217f0-0363-3072-9ef8-ac37cec1b770",
                                                "text": "Le neurotransmetteur endogène du système sympathique est la noradrénaline et celui du système parasympathique est l’acétylcholine."
                                            },
                                            {
                                                "example_id": "cc21bef3-f9b1-4e0e-a1db-289507ab2844",
                                                "sense_id": "749217f0-0363-3072-9ef8-ac37cec1b770",
                                                "text": "Cette vitamine contribue à la synthèse de nombreux composés de l’organisme : tissu conjonctif (peau, os, muscles, etc.), neurotransmetteurs (dopamine, sérotonine, mélatonine) impliqués dans la régulation de l’humeur et les fonctions cognitives."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d54963b1-ec65-4c49-8557-aa863e82b0ca",
                        "source_entry_id": "75dd3b0e-3618-30d0-8680-dda19a9e6461",
                        "source_sense_id": "14ba41e8-157e-3e25-907a-bec470d863a4",
                        "target_lang_word": "Neurotransmitter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Neurotransmitter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6f819302-41f8-3495-9d8e-d493e0aa73a3",
                                        "entry_id": "9f79d8a4-b91b-395f-a1aa-a62c6ec1a69c",
                                        "glosses": [
                                            "Botenstoff im Nervensystem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b071904-10f8-4b7b-ba20-340523deaf2c",
                                                "sense_id": "6f819302-41f8-3495-9d8e-d493e0aa73a3",
                                                "text": "Neurotransmitter sind heterogene biochemische Stoffe, welche die Information von einer Nervenzelle zur anderen über die Kontaktstelle der Nervenzellen, der Synapse, weitergeben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
