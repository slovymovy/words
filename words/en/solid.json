                        "closed up"
                    ],
                    "antonyms": [
                        "hyphenated",
                        "spaced"
                    ],
                    "common_phrases": [
                        "solid word",
                        "solid compound"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "linguistics/typography"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пишется как одно слово без пробелов и дефисов.",
                        "tr": "Boşluk veya tire kullanılmadan tek bir kelime olarak yazılan."
                    },
                    "translations": {
