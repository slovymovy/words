                "senses": [
                    {
                        "sense_id": "072fb2b0-95c5-3817-ad50-026a1a6888d6",
                        "entry_id": "00c2d686-7440-3e95-b574-fb4a1de2ac9b",
                        "glosses": [
                            "elektronischer Schlossöffner, zum Beispiel Autoschlüssel zum Öffnen und Schließen eines Fahrzeuges per Funk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc71d9af-9c2b-47ad-9275-f50da521f0e3",
                                "sense_id": "072fb2b0-95c5-3817-ad50-026a1a6888d6",
                                "text": "„Der Fob ist dabei die physische Fernbedienung, die beim Auto dabei ist, um etwa auch auf- und zuzusperren.“"
                            },
                            {
                                "example_id": "d8386e2c-0f8b-4553-bbc8-4901dc8f00dc",
                                "sense_id": "072fb2b0-95c5-3817-ad50-026a1a6888d6",
                                "text": "„Unter optimalen Bedingungen kannst du dein Smart Lock aus rund 15 Metern Entfernung mit deinem Fob steuern.“"
                            },
                            {
                                "example_id": "ee946266-d2d7-4a9e-a93c-07df7098dabc",
                                "sense_id": "072fb2b0-95c5-3817-ad50-026a1a6888d6",
                                "text": "„Die Technik, um einen Fob zu öffnen und die Batterie, die du brauchst, unterscheiden sich etwas, je nach dem spezifischen Schlüssel-Fob, den du besitzt.“"
                            },
                            {
                                "example_id": "ef9c88a3-77ad-483f-a104-b60dd2c648de",
                                "sense_id": "072fb2b0-95c5-3817-ad50-026a1a6888d6",
                                "text": "„Es mochte sein, dass Fobs in der Welt, in der die Menschen Tore mit elektrischem Antrieb und Hybridautos besaßen, alltäglich waren, aber Squib hatte einen Riesenspaß daran, den RFID-Transponder so oft wie nur möglich zu betätigen, denn er war der Erste, den er jemals in der Hand hielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f971b05-6b9f-4213-ad2c-e15c74e40b70",
