{
    "word_family": [
        "tremor",
        "tremulous",
        "tremblingly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b95925e6-0d61-3075-8a2d-47fef45b851c",
                    "sense_definition": "To shake, quiver, or vibrate involuntarily, often from cold, fear, or emotion.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His hands began to <w>tremble</w> with excitement as he opened the letter. ",
                            "target_lang_translations": {
                                "ru": "Его руки начали <w>дрожать</w> от волнения, когда он открывал письмо."
                            }
                        },
                        {
                            "text": "She was <w>trembling</w> with fear when she heard the loud sound outside.",
                            "target_lang_translations": {
                                "ru": "Она <w>дрожала</w> от страха, когда услышала громкий звук снаружи."
                            }
                        }
                    ],
                    "synonyms": [
                        "quail"
                    ],
                    "common_phrases": [
                        "tremble with fear",
                        "tremble with cold",
                        "voice began to tremble"
                    ],
                    "target_lang_definitions": {
                        "ru": "Невольно трястись, дрожать или вибрировать, часто от холода, страха или волнения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дрожать",
                                "target_lang_sense_clarification": "совершать мелкие колебательные движения, испытывать дрожь от холода или эмоций"
                            },
                            {
                                "target_lang_word": "трястись",
                                "target_lang_sense_clarification": "быть охваченным дрожью, сильным волнением или страхом"
                            },
                            {
                                "target_lang_word": "трепетать",
                                "target_lang_sense_clarification": "быть охваченным внутренней или мелкой дрожью"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24d7353d-f371-3872-9ab7-a0230f21de00",
                    "sense_definition": "To feel great fear or apprehension; to dread something.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Even the bravest men <w>tremble</w> before the mighty power of nature.",
                            "target_lang_translations": {
                                "ru": "Даже самые храбрые люди <w>трепещут</w> перед могущественной силой природы."
                            }
                        },
                        {
                            "text": "She could only <w>tremble</w> at the thought of losing her home.",
                            "target_lang_translations": {
                                "ru": "Ей оставалось только <w>трепетать</w> при мысли о потере дома."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tremble at the thought"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывать сильный страх, опасение; ужасаться чему-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трепетать",
                                "target_lang_sense_clarification": "испытывать глубокий страх или трепет перед чем-либо"
                            },
                            {
                                "target_lang_word": "дрожать",
                                "target_lang_sense_clarification": "бояться, испытывать страх перед чем-то"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "56c850d5-9d04-3e3c-9d0b-28ee0106c7ba",
                    "sense_definition": "An act or instance of shaking, quivering, or vibrating.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt a slight <w>tremble</w> in her hands after working all day.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала легкую <w>дрожь</w> в руках после работы в течение всего дня."
                            }
                        },
                        {
                            "text": "A sudden <w>tremble</w> ran through the ground during the earthquake.",
                            "target_lang_translations": {
                                "ru": "Внезапное <w>дрожание</w> прошло по земле во время землетрясения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "slight tremble"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или проявление тряски, дрожания или вибрации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дрожь",
                                "target_lang_sense_clarification": "частое судорожное сокращение мышц, мелкое колебание"
                            },
                            {
                                "target_lang_word": "дрожание",
                                "target_lang_sense_clarification": "процесс совершения мелких колебательных движений"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7ba87f8e-0003-373f-95ea-224b8694e745",
                    "sense_definition": "A family surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Tremble</w> was invited to speak at the historical conference.",
                            "target_lang_translations": {
                                "ru": "Мистера <w>Трембла</w> пригласили выступить на исторической конференции."
                            }
                        },
                        {
                            "text": "We met the <w>Tremble</w> family during our vacation in England.",
                            "target_lang_translations": {
                                "ru": "Мы познакомились с семьей <w>Трембл</w> во время отпуска в Англии."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Семейная фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Трембл",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}