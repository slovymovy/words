                    "sense_definition": "Choisir ou acheter un article, un produit ou un service.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "achat_choix",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au restaurant, je vais <w>prendre</w> le poisson grillé avec des légumes."
                        },
                        {
                            "text": "Si cette veste vous plaît vraiment, vous devriez la <w>prendre</w>."
