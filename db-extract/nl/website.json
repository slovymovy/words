                "senses": [
                    {
                        "sense_id": "66458bd6-09e2-35d9-8456-e793753b4bd7",
                        "entry_id": "cb6f5376-8196-3618-aa44-a4be583a63ce",
                        "glosses": [
                            "plaats waar zich informatie bevindt op het internet, aangeduid met een URL"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "223608b0-765d-4816-b540-d6996ac55de7",
                                "sense_id": "66458bd6-09e2-35d9-8456-e793753b4bd7",
                                "text": "Welk bedrijf heeft de website voor u gemaakt?"
                            },
                            {
                                "example_id": "2d72daf9-14c9-4c46-935c-7040903202b7",
                                "sense_id": "66458bd6-09e2-35d9-8456-e793753b4bd7",
                                "text": "En het NOS Jeugdjournaal maakt een speciale website over 75 jaar vrijheid. Zo kun je nog beter begrijpen waarom we blijven vieren dat we in Nederland in vrijheid leven."
                            },
                            {
                                "example_id": "27a8ea23-6071-453a-80fd-91fa323fae50",
                                "sense_id": "66458bd6-09e2-35d9-8456-e793753b4bd7",
                                "text": "Dus aangekomen in een gehucht-met-wifi in Noord-Oregon (Big Lake Youth Camp) zocht ik een website waar ik fondsen mee kon gaan werven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0bd00b92-64f2-4d5e-a413-2d9d7cc0014d",
                        "source_entry_id": "cb6f5376-8196-3618-aa44-a4be583a63ce",
                        "source_sense_id": "66458bd6-09e2-35d9-8456-e793753b4bd7",
                        "source_sense_description": "plaats waar zich informatie bevindt op het internet, aangeduid met een URL",
                        "target_lang_word": "Webseite",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Webseite",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aeb3f69d-092e-3461-9740-b02ef591f5ea",
                                        "entry_id": "94d502d8-5471-3f0b-9624-c913b649a0f0",
                                        "glosses": [
                                            "einzelne Hypertext-Seite, die in einem Webbrowser aufgerufen werden kann"
                                        ],
                                        "tags": [
                                            "Netzwerktechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84c560a8-680f-4b3d-8a9d-87ce82395b2f",
                                                "sense_id": "aeb3f69d-092e-3461-9740-b02ef591f5ea",
                                                "text": "Im Internet existieren Milliarden von Webseiten."
                                            },
                                            {
                                                "example_id": "a0d5333a-782b-425c-94f8-7a69a146ee48",
                                                "sense_id": "aeb3f69d-092e-3461-9740-b02ef591f5ea",
                                                "text": "Ich muss mir noch ein Lesezeichen auf diese Webseite setzen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "46747005-75f9-3e23-9480-31de5d79d7ef",
                                        "entry_id": "94d502d8-5471-3f0b-9624-c913b649a0f0",
                                        "glosses": [
                                            "eine Website, also eine Sammlung von Hypertext-Seiten unter einer Domain, die mit Menüs und Hyperlinks zu einer Einheit zusammengefasst sind"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f730205d-dbcd-4c0d-bc68-b1f170cb5299",
                                                "sense_id": "46747005-75f9-3e23-9480-31de5d79d7ef",
                                                "text": "„Wir reagieren auf diesen ganzen Internethype, indem wir unsere Webseite ausbauen und einen Webshop einbinden.“"
                                            },
                                            {
                                                "example_id": "a17984f1-11c8-4e99-b082-e686786e60b9",
                                                "sense_id": "46747005-75f9-3e23-9480-31de5d79d7ef",
                                                "text": "„Die Webseiten der großen Airlines WOW und Iceland Air brechen zusammen.“"
                                            },
                                            {
                                                "example_id": "4e88d756-9d88-4469-a32d-22007b4157fe",
                                                "sense_id": "46747005-75f9-3e23-9480-31de5d79d7ef",
                                                "text": "„So ist es nicht weiter verwunderlich, dass auch für die Erzählforschung im Internet weltweit abertausende von Webseiten zur Verfügung stehen.“"
                                            },
                                            {
                                                "example_id": "de1a9909-468f-4edb-9303-26f37be45fed",
                                                "sense_id": "46747005-75f9-3e23-9480-31de5d79d7ef",
                                                "text": "„Wer sich die Webseite des irischen Tourismusverbands ansieht, bekommt einen anderen Eindruck.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
