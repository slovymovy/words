                "senses": [
                    {
                        "sense_id": "5ab3826c-7718-3365-94fc-4a1ad5d6e4d2",
                        "entry_id": "d012cef2-c744-373d-9037-8587c2ca8bfa",
                        "glosses": [
                            "удобрить навозом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbb2505a-339a-494c-8943-c78cdc2a0638",
                                "sense_id": "5ab3826c-7718-3365-94fc-4a1ad5d6e4d2",
                                "text": "― Надо делить поле на три по́ля, на три смены: посеять на будущий год озимую рожь, сжать её, опять унавозить и до зимы́ вспахать успеть."
                            }
                        ]
                    },
                    {
                        "sense_id": "a45d9286-9fdf-3319-b805-8ac7fc38dd5e",
                        "entry_id": "d012cef2-c744-373d-9037-8587c2ca8bfa",
                        "glosses": [
                            "перен. испортить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e5870fd-80e7-4b93-b8cd-932c03a7d11a",
                                "sense_id": "a45d9286-9fdf-3319-b805-8ac7fc38dd5e",
                                "text": "Не для того же я страдал, чтобы собой, злодействами и страданиями моими унавозить кому-то будущую гармонию."
                            }
                        ]
                    }
