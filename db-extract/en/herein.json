                "senses": [
                    {
                        "sense_id": "36161751-886d-3f35-8c6d-1eb0469dbfd0",
                        "entry_id": "89cc4603-8a88-3532-b798-742ad671527f",
                        "glosses": [
                            "In this; within this content, context, or thing."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "c5ed1c32-37f3-4d12-80c3-549c287d0f87",
                                "sense_id": "36161751-886d-3f35-8c6d-1eb0469dbfd0",
                                "text": "[…] that if he be not fully satisfied herein, or doubt that the rest of the associates shall not like of the delivery of them to her Majesty in this good manner […]"
                            },
                            {
                                "example_id": "27c99cc8-99e8-4e84-8f00-5ad85098a9f4",
                                "sense_id": "36161751-886d-3f35-8c6d-1eb0469dbfd0",
                                "text": "I also claim making the touguing hand-plane in such a manner as to enable the workman to make therewith tongues of various thicknesses, substantially, in the manner herein set forth, whereby I prevent the necessity of providing different tools to tongue planks of different thicknesses."
                            },
                            {
                                "example_id": "62f1000d-6c63-43ac-998b-067c0d969212",
                                "sense_id": "36161751-886d-3f35-8c6d-1eb0469dbfd0",
                                "text": "The equational theories developed herein are ordinary conditional equational theories."
                            },
                            {
                                "example_id": "5488c6d8-7b6c-4e95-a719-d2d197d942ab",
                                "sense_id": "36161751-886d-3f35-8c6d-1eb0469dbfd0",
                                "text": "Were you a party to any suit terminated within the year immediately preceding the filing of the original petition herein?"
                            }
                        ]
                    }
                ],
