                ],
                "senses": [
                    {
                        "sense_id": "969d9c28-3b16-3693-850d-03a391581662",
                        "entry_id": "483c831d-98d0-329b-bc17-c2b802f7e52c",
                        "glosses": [
                            "Action de chlorurer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25dfe75a-5437-4aa3-9bf2-4128df845e86",
                                "sense_id": "969d9c28-3b16-3693-850d-03a391581662",
                                "text": "Même en n’isolant pas l’acétodichlorhydrine intermédiaire, et en se contentant de recueillir, après la chloruration, ce qui passe au-dessous de 113° sous 20 mm. (il reste ainsi dans le résidu de l’acétate de monochlorhydrine) et en alcoolysant ce distillat, le rendement n’est que de 33 %."
                            },
                            {
                                "example_id": "47e6aace-d234-41db-897c-21d7c111897a",
                                "sense_id": "969d9c28-3b16-3693-850d-03a391581662",
                                "text": "Première série d’essais : chloruration directe des gaz sans emploi de catalyseurs et de source particulière de chaleur."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d35f639-7e78-34eb-90ff-1114a91f7e7e",
                        "entry_id": "483c831d-98d0-329b-bc17-c2b802f7e52c",
                        "glosses": [
                            "Résultat de cette action, quantité de chlorure dans un liquide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfbc1eda-205f-4f35-adb2-1c128ac65411",
                                "sense_id": "7d35f639-7e78-34eb-90ff-1114a91f7e7e",
                                "text": "Vingt-quatre essais faits pendant la traversée du canal de Suez ont permis de tracer sur une autre partie de la carte la courbe de la chloruration."
                            }
                        ]
                    }
                ],
