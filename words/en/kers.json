            "senses": [
                {
                    "sense_id": "091d4ef7-1bdb-30ce-bbc6-942e3e425ebe",
                    "sense_definition": "Acronym for kinetic energy recovery system: an automotive system that converts kinetic energy during braking into stored electrical or mechanical energy to boost acceleration.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The driver activated the <w>KERS</w> unit on the straightaway to overtake his rival.",
                            "target_lang_translations": {
                                "nl": "De coureur activeerde het <w>KERS</w>-systeem op het rechte stuk om zijn rivaal in te halen."
                            }
                        },
                        {
                            "text": "Engineers redesigned the <w>KERS</w> to improve overall battery efficiency during braking.",
                            "target_lang_translations": {
                                "nl": "Ingenieurs herontwierpen het <w>KERS</w> om de algehele batterij-efficiëntie tijdens het remmen te verbeteren."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Acroniem voor 'kinetic energy recovery system': een autosysteem dat kinetische energie bij het remmen omzet in opgeslagen elektrische of mechanische energie voor extra acceleratie."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "KERS",
                                "target_lang_sense_clarification": "energieterugwinningssysteem in de motorsport"
                            },
                            {
                                "target_lang_word": "kinetisch energieterugwinningssysteem",
                                "target_lang_sense_clarification": "volledige benaming van de technologie"
                            }
                        ]
                    }
                },
