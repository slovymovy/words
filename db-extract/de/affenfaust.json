                                        "entry_id": "beafa7bb-c3c2-39ff-b538-36ef9919a919",
                                        "glosses": [
                                            "Alternative form of monkey's paw."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "attributive",
                                            "idiomatic",
