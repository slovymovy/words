                "senses": [
                    {
                        "sense_id": "62bbc694-1ef8-3f59-811c-aa9429280e1a",
                        "entry_id": "c7bca01b-d6c4-3dd4-b2ff-ae8d26d3e14f",
                        "glosses": [
                            "motorcycle"
                        ],
                        "tags": [
                            "Switzerland",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "a29f5e78-d29a-4eae-bd0f-6d1687be02c1",
                                "sense_id": "62bbc694-1ef8-3f59-811c-aa9429280e1a",
                                "text": "Mein Töff hatte ich in die Garage gestellt, ich hab die Haustür leise aufgesperrt, und da seh ich die ganze Familie unter einer Petroleumlampe um einen runden Tisch im Zimmer sitzen.",
                                "translation": "I had parked my motorbike in the garage, quietly unlocked the front door, and there I saw the whole family sitting around a round table in the room under a kerosene lamp.",
                                "english": "I had parked my motorbike in the garage, quietly unlocked the front door, and there I saw the whole family sitting around a round table in the room under a kerosene lamp."
                            },
                            {
                                "example_id": "8e5f89d8-528e-4933-8bd1-513800791429",
                                "sense_id": "62bbc694-1ef8-3f59-811c-aa9429280e1a",
                                "text": "Mein Töff hatte Stummellenker und war frisiert, sodass er, wenn ich viel Zeit hatte und es geradeaus ging, etwa 175 km/h drauf hatte.",
                                "translation": "My motorbike had clip-on handlebars and was tuned so that when I had plenty of time and was going straight, it could do about 175 km/h.",
                                "english": "My motorbike had clip-on handlebars and was tuned so that when I had plenty of time and was going straight, it could do about 175 km/h."
                            }
                        ]
                    }
                ],
