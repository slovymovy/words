                                "target_senses": [
                                    {
                                        "sense_id": "9fc453e6-07ea-3171-b4ff-ef81d2174b00",
                                        "entry_id": "61a7a541-4c78-3c66-8bef-bd64808f2a5e",
                                        "glosses": [
                                            "Angehöriger des antiken, gleichnamigen, iranischen Volkes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec11bf6e-e64b-48f7-80b9-809d7cfbfe80",
                                                "sense_id": "9fc453e6-07ea-3171-b4ff-ef81d2174b00",
                                                "text": "„Nach dem Tod des Crassus, der im Jahr 53 v.Chr. bei Carrhae gegen die Parther gefallen war, lockerte sich die Allianz zwischen Pompeius und Caesar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
