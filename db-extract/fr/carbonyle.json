                ],
                "senses": [
                    {
                        "sense_id": "ec27e700-0f35-3ac8-8304-9d528e4c2e37",
                        "entry_id": "6b0f762b-623f-312b-8b26-0ad9d2b16c74",
                        "glosses": [
                            "Groupement chimique ne comprenant qu’un atome de carbone et un atome d’oxygène, de formule -CO-, et que l’on retrouve dans les acides carboxyliques, les aldéhydes et les cétones principalement."
                        ],
                        "tags": [
                            "Chimie organique"
                        ],
                        "examples": [
                            {
                                "example_id": "2c330ec8-85f2-4541-be70-d03fd7ac5a27",
                                "sense_id": "ec27e700-0f35-3ac8-8304-9d528e4c2e37",
                                "text": "L’énol ou l’enolatc est généré à partir d’un carbonyle, souvent un aldéhyde ou une cétone, sous l’action d'un acide ou d’une base."
                            }
                        ]
                    },
                    {
                        "sense_id": "c1ed1e7e-2760-30d1-9474-12f7cebd6264",
                        "entry_id": "6b0f762b-623f-312b-8b26-0ad9d2b16c74",
                        "glosses": [
                            "Autre nom du produit de traitement du bois nommé créosote"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ad7704a-602a-40d9-beb6-ad7419f064ad",
                                "sense_id": "c1ed1e7e-2760-30d1-9474-12f7cebd6264",
                                "text": "Très vite, le bois saturé de carbonyl et lavé par les pluies, devint soyeux comme une peau de loutre."
                            }
                        ]
                    }
                ],
                "translations": [
