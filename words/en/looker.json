{
    "word_family": [
        "look",
        "lookout"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "933b77c3-1bd1-38e6-a365-a3b546680d77",
                    "sense_definition": "A remarkably attractive or good-looking person or thing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Everyone at the party agreed that his date was quite a <w>looker</w>.",
                            "target_lang_translations": {
                                "ru": "Все на вечеринке согласились, что его спутница — настоящая <w>красавица</w>."
                            }
                        },
                        {
                            "text": "Wow, your new man is much more of a <w>looker</w> than your last one!",
                            "target_lang_translations": {
                                "ru": "Ого, твой новый парень гораздо больший <w>красавчик</w>, чем предыдущий!"
                            }
                        }
                    ],
                    "synonyms": [
                        "beautiful person"
                    ],
                    "common_phrases": [
                        "quite a looker",
                        "a real looker"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used casually to describe an attractive person"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень привлекательный, красивый человек или вещь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "красавец",
                                "target_lang_sense_clarification": "о мужчине"
                            },
                            {
                                "target_lang_word": "красавица",
                                "target_lang_sense_clarification": "о женщине"
                            },
                            {
                                "target_lang_word": "симпатяга",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ca1d7f6-a5d1-3c1d-8868-2fc406ce3376",
                    "sense_definition": "A person who looks, watches, or observes something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "observer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The speaker noticed several curious <w>lookers</w> in the front row.",
                            "target_lang_translations": {
                                "ru": "Докладчик заметил в первом ряду несколько любопытных <w>слушателей и зрителей</w>."
                            }
                        },
                        {
                            "text": "A sudden noise in the street drew several eager <w>lookers</w> toward the window.",
                            "target_lang_translations": {
                                "ru": "Внезапный шум на улице привлек к окну несколько любопытных <w>зевак</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто смотрит, наблюдает или разглядывает что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наблюдатель",
                                "target_lang_sense_clarification": "тот, кто следит взглядом"
                            },
                            {
                                "target_lang_word": "зевака",
                                "target_lang_sense_clarification": "любопытный зритель"
                            },
                            {
                                "target_lang_word": "зритель",
                                "target_lang_sense_clarification": "тот, кто смотрит"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f698904-5686-3d6b-952c-6182a37a56af",
                    "sense_definition": "A person who browses goods or properties without any serious intention of buying.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A good real estate agent will screen and separate potential buyers from <w>lookers</w> at the door.",
                            "target_lang_translations": {
                                "ru": "Хороший риелтор сразу на входе отсеет и отделит потенциальных покупателей от <w>просто пришедших посмотреть</w>."
                            }
                        },
                        {
                            "text": "The store clerk ignored casual <w>lookers</w> and focused on paying customers.",
                            "target_lang_translations": {
                                "ru": "Продавец игнорировал случайных <w>зевак</w> и сосредоточился на реальных покупателях."
                            }
                        }
                    ],
                    "synonyms": [
                        "tyre kicker"
                    ],
                    "common_phrases": [
                        "just lookers"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in sales or retail contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который разглядывает товары или недвижимость без серьезного намерения купить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "просто смотрящий",
                                "target_lang_sense_clarification": "не планирующий покупку"
                            },
                            {
                                "target_lang_word": "зевака",
                                "target_lang_sense_clarification": "праздношатающийся посетитель"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6285e7d-d48b-3201-99bc-8f2c955ed884",
                    "sense_definition": "One having a specified appearance or visual style.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With its sleek lines, the new sports coupe is an impressive <w>looker</w> on the road.",
                            "target_lang_translations": {
                                "ru": "Благодаря плавным линиям новое спортивное купе на дороге <w>смотрится впечатляюще</w>."
                            }
                        },
                        {
                            "text": "The designer proved to be an odd <w>looker</w> in that flamboyant vintage suit.",
                            "target_lang_translations": {
                                "ru": "В этом вычурном винтажном костюме дизайнер <w>выглядел весьма странно</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот или то, что имеет определенный внешний вид или визуальный стиль."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зрелище",
                                "target_lang_sense_clarification": "об объекте с определенным видом"
                            },
                            {
                                "target_lang_word": "вид",
                                "target_lang_sense_clarification": "внешний облик"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "c8056e7f-8b42-3ef0-94e3-2349c39c99ec",
                    "sense_definition": "A surname transferred from the nickname or occupational name.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Dr. <w>Looker</w> published several influential articles on linguistics.",
                            "target_lang_translations": {
                                "ru": "Доктор <w>Лукер</w> опубликовал несколько влиятельных статей по лингвистике."
                            }
                        },
                        {
                            "text": "The package arrived at the front desk addressed to a Mr. <w>Looker</w>.",
                            "target_lang_translations": {
                                "ru": "На стойку регистрации доставили посылку на имя мистера <w>Лукера</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия английского происхождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Лукер",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}