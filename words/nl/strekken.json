                    "frequency": "Middle",
                    "semantic_group_id": "bereik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het prachtige natuurgebied <w>strekt</w> zich uit tot aan de verre horizon.",
                            "target_lang_translations": {
                                "en": "The beautiful nature reserve <w>stretches</w> out to the distant horizon."
                            }
                        },
                        {
                            "text": "Hun politieke macht <w>strekte</w> tot ver buiten de grenzen van het land.",
                            "target_lang_translations": {
