                ],
                "senses": [
                    {
                        "sense_id": "cf86a24d-e696-3212-9bd6-f68af83931b2",
                        "entry_id": "3424af68-336f-3318-8255-76ca7226d1af",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c6a365d-d5a0-4f21-9b3c-f3c48e64a102",
                                "sense_id": "cf86a24d-e696-3212-9bd6-f68af83931b2",
                                "text": "L’homogénéité et la compétitivité de la division séduisent également le Finistérien Valentin Henry (129 matchs de L2), qui va entamer sa deuxième saison à Sochaux, à 28 ans."
                            },
                            {
                                "example_id": "cfccbdce-a47e-4271-ab66-f1dbf5509c4f",
                                "sense_id": "cf86a24d-e696-3212-9bd6-f68af83931b2",
                                "text": "À côté du restaurant de 40 couverts, créé il y a cinq ans par les chefs australiens James Henry et Shaun Kelly, dans la résidence de la comtesse Du Barry, se trouvent un enclos à cochons et un poulailler en plein air."
                            },
                            {
                                "example_id": "10fd91e2-02b5-4830-b035-7055e3625f10",
                                "sense_id": "cf86a24d-e696-3212-9bd6-f68af83931b2",
                                "text": "Les manifestants ont demandé au Premier ministre Ariel Henry de rendre des comptes de sa gestion à la tête du pays et de faire son possible pour «dégangstériser» le pays afin de rendre possible la libre circulation des gens et des biens."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "3e2fb631-f465-3f4a-a2f4-2ecaf242fc27",
                "word": "Henry",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "93e04700-b706-3b13-ae97-4b07cd4b4718",
                        "entry_id": "3e2fb631-f465-3f4a-a2f4-2ecaf242fc27",
                        "glosses": [
                            "Prénom masculin ; variante de Henri."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa0343c9-9ce7-42eb-8fb2-90fe566a6e7c",
                                "sense_id": "93e04700-b706-3b13-ae97-4b07cd4b4718",
                                "text": "Dans la bibliothèque se côtoyaient Henry James en Penguin, Le Prince des marées dédicacé par Pat Conroy, une biographie de Sylvia Plath, tous les romains d’Iris Murdoch."
                            },
                            {
                                "example_id": "e44e892d-e92d-4659-add6-002e21a1c3f2",
                                "sense_id": "93e04700-b706-3b13-ae97-4b07cd4b4718",
                                "text": "Le dos appuyé contre le montant vérolé de la fenêtre, Henry tendit l’oreille."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
