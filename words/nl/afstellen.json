                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dismiss",
                                "target_lang_sense_clarification": "to officially end someone's employment or service"
                            },
                            {
                                "target_lang_word": "discharge",
                                "target_lang_sense_clarification": "to release from military or official duty"
                            },
                            {
