                                        "entry_id": "571b4864-0eb9-35b3-9590-6ee56e8cb369",
                                        "glosses": [
                                            "een gedetailleerde omschrijving of vermelding van eigenschappen, kwaliteiten, voorwaarden, eisen enz."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6114027c-e60f-4647-a851-0d09cb242f68",
                                                "sense_id": "f2823818-acbe-38c7-a0d0-5c18b11b0979",
                                                "text": "Bij aflevering van de machine zal worden nagegaan of aan alle technische specificaties is voldaan."
                                            },
                                            {
                                                "example_id": "dbac4c5b-fcf6-4351-9e01-29cd598194f7",
                                                "sense_id": "f2823818-acbe-38c7-a0d0-5c18b11b0979",
                                                "text": "Maandenlang had ik alle specificaties van tenten bestudeerd: gewicht, ruimte, kosten, duurzaamheid, dubbelwandig, enkelwandig, vrijstaand, camouflagemotief, cuben fiber en nylon."
                                            }
                                        ]
                                    }
                                ]
