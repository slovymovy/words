                        "examples": [
                            {
                                "example_id": "af0582a3-c702-4791-a706-d15b89095620",
                                "sense_id": "c884e283-b605-3b67-a3e4-73d6b533a7f7",
                                "text": "„1792 teilt Goethe seine Erinnerungen an die erste Harzreise mit.“"
                            },
                            {
                                "example_id": "4fb4a209-6534-4217-ab8f-b027823aa18d",
                                "sense_id": "c884e283-b605-3b67-a3e4-73d6b533a7f7",
                                "text": "„Alles paßte vorzüglich zusammen, mit Ausnahme zweier Ausrüstungsgegenstände, von denen der eine, mit Rücksicht auf eine Harzreise, des Guten zu wenig, der andere aber entschieden zu viel tat.“"
                            }
                        ],
