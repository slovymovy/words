                    {
                        "translation_id": "aa54dbf6-c11b-4ab4-82e8-15ba5cf6e213",
                        "source_entry_id": "7dad7a2e-6240-3ba4-84a8-e895fb2b9e3d",
                        "source_sense_description": "Saint Petersburg — see also Saint Petersburg",
                        "target_lang_word": "Pétrograd",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pétrograd",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f348a5f0-23c3-3280-b5dc-d1d12490b793",
                                        "entry_id": "35abdf1b-1de5-3955-917b-c4bdfbb14f57",
                                        "glosses": [
                                            "Nom que porta Saint-Pétersbourg de 1914 à 1924."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28b9c6af-5914-4b1f-b4f9-b1d4d7e7ff9d",
                                                "sense_id": "f348a5f0-23c3-3280-b5dc-d1d12490b793",
                                                "text": "Zinoviev préside l’Internationale communiste et le Soviet de Pétrograd qu’il rebaptise Léningrad […]"
                                            },
                                            {
                                                "example_id": "bf7050ce-19bf-470f-a3fb-e6ce200cad0b",
                                                "sense_id": "f348a5f0-23c3-3280-b5dc-d1d12490b793",
                                                "text": "Son éloignement de Pétrograd le mettait au désespoir. Il se rendait parfaitement compte que, seule, sa présence sur les lieux lui permettrait d’agir efficacement et de faire entendre raison aux membres récalcitrants du Comité central."
                                            },
                                            {
                                                "example_id": "ec4b14d5-69b8-4e2c-84ed-9957ef5a8296",
                                                "sense_id": "f348a5f0-23c3-3280-b5dc-d1d12490b793",
                                                "text": "Il est vrai que les maximalistes paraissent avoir pris dans le Soviet de Pétrograd, une importance nouvelle et que Tchernov n'a pas cessé d'être un ardent zimmerwaldiste."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11b99278-b1b3-40ae-84fc-7d7e60f33cc4",
                        "source_entry_id": "7dad7a2e-6240-3ba4-84a8-e895fb2b9e3d",
