                    {
                        "sense_id": "f9c62ed9-5cc8-3500-ac23-b07c79a87342",
                        "entry_id": "e8a2ebd5-fe7b-3603-be5e-1b3596dbc262",
                        "glosses": [
                            "Chanson, air traditionnellement chanté par les gondoliers vénitiens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d5511f0-d881-4841-9d26-e7c70d40be35",
                                "sense_id": "f9c62ed9-5cc8-3500-ac23-b07c79a87342",
                                "text": "La dame lui dit de chanter une barcarole."
                            },
                            {
                                "example_id": "cbc259a3-1ab9-4ce2-a1f9-f36307efa1d7",
                                "sense_id": "f9c62ed9-5cc8-3500-ac23-b07c79a87342",
                                "text": "Un peu plus loin, dans l’oratoire, un quatrième piano accompagnait dix à douze pensionnaires au moins, qui prenaient leur leçon et chantaient en chœur une barcarole dont je me rappelle trois mots : « fraîche brise » et « Venise. »"
                            }
                        ]
                    },
