                    {
                        "sense_id": "1193efdc-5bdd-3123-bf05-69e9c569794b",
                        "entry_id": "338b0a02-1cd9-3d40-9952-66b6bbdbcf46",
                        "glosses": [
                            "vom Menschen in ein anderes Gebiet „verbrachtes“ oder „verschlepptes“ Floren- oder Faunenelement"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff492695-f9b7-40f9-a98f-81b69a7b7ddd",
                                "sense_id": "1193efdc-5bdd-3123-bf05-69e9c569794b",
                                "text": "„Die vom Menschen verbreiteten Pflanzen (Anthropophyten) und Tiere (Anthropozoen) werden zusammen als Anthropochoren bezeichnet.“"
                            },
                            {
                                "example_id": "358786eb-307f-4b54-a011-955f56ca5406",
                                "sense_id": "1193efdc-5bdd-3123-bf05-69e9c569794b",
                                "text": "„Die Anthropochoren umfassen somit alle Ackerunkräuter, sowie die gesamte Ruderal- und Adventivflora.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
