                                    {
                                        "sense_id": "67927c53-6c09-3c11-98fb-8eea33855f01",
                                        "entry_id": "18383699-b761-3b42-b341-d2f4641d05d3",
                                        "glosses": [
                                            "To lubricate with vaseline."
