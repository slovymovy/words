                        "sense_id": "4f4038d0-0bab-3785-b089-b185ddbd2072",
                        "entry_id": "e0fd4569-cb9f-3d1a-b9a4-3edf01e8ae16",
                        "glosses": [
                            "Alternative spelling of lacy."
