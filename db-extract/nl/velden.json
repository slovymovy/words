                "senses": [
                    {
                        "sense_id": "ad02c1c9-8b04-3075-81d4-06c3fa9a2541",
                        "entry_id": "24b1ccfd-6b40-3b19-afb6-49e2743de77c",
                        "glosses": [
                            "meervoud van het zelfstandig naamwoord veld"
                        ],
                        "tags": [
                            "form-of",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "60021679-fae9-4085-a9da-d7aab0962672",
                                "sense_id": "ad02c1c9-8b04-3075-81d4-06c3fa9a2541",
                                "text": "'Vind je het mooi?' Ze keken alle drie naar het schilderij, naar de golvende lappendeken van velden, de surrealistische intensiteit van de kleuren, het witte huis waar hij vroeger doorheen had gedwaald en dat nu van iemand anders was."
                            },
                            {
                                "example_id": "99ec4f0f-816a-41ea-8767-8ea6c2c63c79",
                                "sense_id": "ad02c1c9-8b04-3075-81d4-06c3fa9a2541",
                                "text": "Het lijkt wel de levende belichaming van Isaacs geschilderde velden."
                            },
                            {
                                "example_id": "7c1d92a1-fff4-4561-b236-c83e79669dc3",
                                "sense_id": "ad02c1c9-8b04-3075-81d4-06c3fa9a2541",
                                "text": "De geur van de velden vol salie en rozemarijn, hagedissen die als kleine geheimpjes over de muren schoten, met schokkerige en neurotische bewegingen, zich voortdurend bewust van de roofvogels in de lucht."
                            }
                        ]
                    }
                ],
