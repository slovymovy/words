                                "target_senses": [
                                    {
                                        "sense_id": "bda2d208-97eb-3d5c-bf54-eefc86231a28",
                                        "entry_id": "d023be3f-6301-34bb-8669-d61dd821c567",
                                        "glosses": [
                                            "Outil de menuisier, qui sert à aplanir, à unir la surface du bois et qui est formé d’une sorte de ciseau ajusté obliquement dans un cadre de bois qui laisse dépasser le tranchant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61c56104-63b6-4d09-8250-0f5b92b37790",
                                                "sense_id": "bda2d208-97eb-3d5c-bf54-eefc86231a28",
                                                "text": "Passer le rabot sur une planche."
                                            },
                                            {
                                                "example_id": "38422aa1-68bc-4190-9335-e35a5448df46",
                                                "sense_id": "bda2d208-97eb-3d5c-bf54-eefc86231a28",
                                                "text": "Donner un coup de rabot."
                                            },
                                            {
                                                "example_id": "018d47f9-91a1-463f-addb-2c5be233d37d",
                                                "sense_id": "bda2d208-97eb-3d5c-bf54-eefc86231a28",
                                                "text": "Polir, aplanir une pièce de bois avec le rabot."
                                            },
                                            {
                                                "example_id": "abc519e1-b81e-4522-a84e-cc6ac02264b2",
                                                "sense_id": "bda2d208-97eb-3d5c-bf54-eefc86231a28",
                                                "text": "Ce rabot ne mord pas !"
                                            },
                                            {
                                                "example_id": "8bc12e35-7728-49b0-82ac-4b1c4d7aa19a",
                                                "sense_id": "bda2d208-97eb-3d5c-bf54-eefc86231a28",
                                                "text": "Aussi vrai que je m’appelle Bélisaire et que j’ai mon rabot dans la main en ce moment, si le père Thiers s’imagine que la bonne leçon qu’il vient de nous donner aura servi à quelque chose, c’est qu’il ne connaît pas le peuple de Paris."
                                            },
                                            {
                                                "example_id": "55979838-b62b-4b4e-989e-fd64b876fc8e",
                                                "sense_id": "bda2d208-97eb-3d5c-bf54-eefc86231a28",
                                                "text": "Il savait bien que plus jamais ces rabots, ces ciseaux à bois, ces burins ou ces mèches ne lui serviraient à rien, mais il continuait de les soigner comme il avait toujours fait, par habitude."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85925846-ce45-388a-8b6e-2e5ed1410a39",
                                        "entry_id": "d023be3f-6301-34bb-8669-d61dd821c567",
                                        "glosses": [
                                            "Outil de menuisier du même usage que le précédent, mais constitué d'un cylindre qui tourne à grande vitesse dans lequel sont fixées deux lames tranchantes. Il en existe des modèles à main et des modèles fixes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c3200915-5024-31a3-bc58-0d3d71cd6797",
                                        "entry_id": "d023be3f-6301-34bb-8669-d61dd821c567",
                                        "glosses": [
                                            "Corriger, fignoler, terminer un ouvrage le plus souvent littéraire (texte, poème, roman, etc…)"
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d64762bb-81df-4bee-acfd-7547ab55474e",
                                                "sense_id": "c3200915-5024-31a3-bc58-0d3d71cd6797",
                                                "text": "Passer le rabot sur un ouvrage en vers, en prose, y donner un coup de rabot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8b6af4e-e276-37ff-b311-495263e17f36",
                                        "entry_id": "d023be3f-6301-34bb-8669-d61dd821c567",
                                        "glosses": [
                                            "Outil dont on se sert pour aplanir et polir les métaux ou pour y faire des filets et des moulures."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e98b0424-b750-3308-a73e-a2ab38544269",
                                        "entry_id": "d023be3f-6301-34bb-8669-d61dd821c567",
                                        "glosses": [
                                            "Outil employé par les clicheurs pour dresser les pages de clichés utilisées lors de l'impression de documents."
                                        ],
                                        "tags": [
                                            "Imprimerie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f74f3a13-128e-388a-94d6-b30730f1541d",
                                        "entry_id": "d023be3f-6301-34bb-8669-d61dd821c567",
                                        "glosses": [
                                            "Outil servant à polir le marbre ou les miroirs."
