                ],
                "senses": [
                    {
                        "sense_id": "816892af-cc00-3744-a82f-b70c8a3790d9",
                        "entry_id": "edcf5dac-700b-349d-bebc-e885bed1ee35",
                        "glosses": [
                            "Porte d’entrée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f71c88fd-24e0-4904-815d-c9f8fa87e845",
                                "sense_id": "816892af-cc00-3744-a82f-b70c8a3790d9",
                                "text": "Der Besucher klingelte an der Eingangstür und wurde hereingelassen.",
                                "translation": "Le visiteur sonna à la porte d’entrée et se fit accueillir."
                            },
                            {
                                "example_id": "87ae082c-ab2f-4f01-bf1e-b07549c201ea",
                                "sense_id": "816892af-cc00-3744-a82f-b70c8a3790d9",
                                "text": "Als die Familie Schmidt nach Hause kaum, sahen sie, dass die Eingangstür aufgebrochen war.",
                                "translation": "À peine la famille Schmidt de retour à la maison, elle s’aperçut que la porte d’entrée était défoncée."
                            },
                            {
                                "example_id": "3fdfc36c-ae75-4c87-b1df-b559157c27c9",
                                "sense_id": "816892af-cc00-3744-a82f-b70c8a3790d9",
                                "text": "Sie wies auf die Kartons und Plastiksäcke, die sich vor der Küche türmten und die Eingangstür halb verstellten.",
                                "translation": "Elle montra du doigt les cartons et les sacs plastique qui s’accumulaient devant la cuisine et bloquaient à moitié la porte d’entrée."
                            },
                            {
                                "example_id": "8b36b656-16fa-45a5-81bf-73ea3509e65c",
                                "sense_id": "816892af-cc00-3744-a82f-b70c8a3790d9",
                                "text": "Am Portal des gründerzeitlichen Eckhauses beißt sich ein blauer Schriftzug sehr schön mit dem giftigen Grün der Eingangstür.",
                                "translation": "Sur le portail de la maison d’angle datant de l’époque fondatrice, l’inscription bleue se mariait très bien avec le vert acidulé de la porte d’entrée."
                            }
                        ]
                    }
                ],
