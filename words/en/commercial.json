                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old hotel was a favorite stop for every <w>commercial</w> passing through the town.",
                            "target_lang_translations": {
                                "ru": "Старый отель был любимым местом остановки для каждого <w>коммивояжёра</w>, проезжающего через город.",
                                "tr": "Eski otel, kasabadan geçen her <w>pazarlamacının</w> en sevdiği duraktı."
                            }
                        },
                        {
                            "text": "He worked as a <w>commercial</w> for a textile company in the early twentieth century.",
                            "target_lang_translations": {
