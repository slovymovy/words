    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ef05b363-2984-3177-b2c4-489b926cf66a",
                    "sense_definition": "Wiedzieć, co coś znaczy; pojmować treść wypowiedzi, tekstu lub istotę sytuacji za pomocą umysłu.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cognitive_understanding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Niestety nie <w>rozumiem</w>, co do mnie mówisz po francusku.",
                            "target_lang_translations": {
                                "ru": "К сожалению, я не <w>понимаю</w>, что ты мне говоришь по-французски.",
                                "en": "Unfortunately, I don't <w>understand</w> what you are saying to me in French.",
                                "zh": "很遗憾，我<w>听不懂</w>你对我说的那句法语。"
                            }
                        },
                        {
                            "text": "Czy uczniowie <w>rozumieją</w> ten trudny temat z matematyki?",
                            "target_lang_translations": {
                                "ru": "<w>Понимают</w> ли ученики эту сложную тему по математике?",
                                "en": "Do the students <w>understand</w> this difficult math topic?",
                                "zh": "学生们<w>理解</w>这个很难的数学知识点吗？"
                            }
                        },
                        {
                            "text": "Dopiero teraz <w>rozumiem</w>, jak bardzo się myliłem.",
                            "target_lang_translations": {
                                "ru": "Только сейчас я <w>понимаю</w>, как сильно я ошибался.",
                                "en": "Only now do I <w>understand</w> how wrong I was.",
                                "zh": "直到现在我才<w>明白</w>自己错得有多离谱。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pojmować",
                        "chwytać",
                        "łapać",
                        "kumać",
                        "kapować"
                    ],
                    "common_phrases": [
                        "rozumieć bez słów",
                        "nic nie rozumieć",
                        "rozumieć po polsku"
                    ],
                    "target_lang_definitions": {
                        "ru": "Знать, что что-то значит; постигать смысл высказывания, текста или суть ситуации с помощью разума.",
                        "en": "To know what something means; to grasp the content of a statement, text, or the essence of a situation using the mind.",
                        "zh": "了解或领会某事的含义；通过思考掌握话语、文本的内容或局势的实质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "понимать",
                                "target_lang_sense_clarification": "постигать смысл"
                            },
                            {
                                "target_lang_word": "осознавать",
                                "target_lang_sense_clarification": "отдавать себе отчет"
                            },
                            {
                                "target_lang_word": "соображать",
                                "target_lang_sense_clarification": "разг. понимать"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "understand",
                                "target_lang_sense_clarification": "to comprehend the meaning of something"
                            },
                            {
                                "target_lang_word": "grasp",
                                "target_lang_sense_clarification": "to mentally seize or understand a concept"
                            },
                            {
                                "target_lang_word": "comprehend",
                                "target_lang_sense_clarification": "to fully understand or grasp thoroughly"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "明白",
                                "target_lang_sense_clarification": "了解、清楚其含义"
                            },
