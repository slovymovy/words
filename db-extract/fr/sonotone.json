                "senses": [
                    {
                        "sense_id": "3a4bc675-336c-3590-b436-592359346610",
                        "entry_id": "839eea6a-c979-3496-95a6-f2ba13e63d9c",
                        "glosses": [
                            "Appareil auditif placé sur l’oreille comportant un amplificateur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dce8d29f-4965-4c42-95b4-176f0c534841",
                                "sense_id": "3a4bc675-336c-3590-b436-592359346610",
                                "text": "Ce dernier est affecté d’une surdité partielle qui le contraint à se servir d’un sonotone."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1cf700ce-73b7-4459-88b7-4510f5c2e1a7",
                        "source_entry_id": "839eea6a-c979-3496-95a6-f2ba13e63d9c",
                        "source_sense_id": "3a4bc675-336c-3590-b436-592359346610",
                        "target_lang_word": "Knopf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Knopf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eb0ab02d-f7d2-391c-8765-467f46fd82ce",
                                        "entry_id": "a8e0a594-f792-3b9c-abd9-fdc0468c6ec9",
                                        "glosses": [
                                            "Gegenstand, der durch das Stecken durch ein Knopfloch ein Kleidungsstück verschließt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d425e26-2ae6-426b-a5ed-a09622651c79",
                                                "sense_id": "eb0ab02d-f7d2-391c-8765-467f46fd82ce",
                                                "text": "Ich muss schon wieder Knöpfe annähen."
                                            },
                                            {
                                                "example_id": "d797e6e5-2b9d-4c5f-8a88-88526a23d660",
                                                "sense_id": "eb0ab02d-f7d2-391c-8765-467f46fd82ce",
                                                "text": "Ich kriege den obersten Knopf nicht zu."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ce6e7836-a37a-3487-8ed9-2752ce29be8a",
                                        "entry_id": "a8e0a594-f792-3b9c-abd9-fdc0468c6ec9",
                                        "glosses": [
                                            "Bedienelement von Geräten, das durch Druck oder durch Drehen ein Ereignis auslöst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5b5c9f6-769b-41a7-ae11-c11eb3e84c5e",
                                                "sense_id": "ce6e7836-a37a-3487-8ed9-2752ce29be8a",
                                                "text": "Drück ja nicht den roten Knopf!"
                                            },
                                            {
                                                "example_id": "1785cbc9-2da6-427f-9417-50217bdf72ce",
                                                "sense_id": "ce6e7836-a37a-3487-8ed9-2752ce29be8a",
                                                "text": "Im kalten Krieg gab es wohl wirklich den sogenannten roten Knopf, mit dem eine Seite eine Atombombe hätte losschicken können und somit wohl den dritten Weltkrieg ausgelöst hätte."
                                            },
                                            {
                                                "example_id": "6155e75d-6d23-4956-b5a6-08b636942ca3",
                                                "sense_id": "ce6e7836-a37a-3487-8ed9-2752ce29be8a",
                                                "text": "An der Kamera ist jetzt alles soweit eingestellt, du brauchst nur noch auf den Knopf drücken."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "09cff685-aec0-35c8-9355-a92ec14e053f",
                                        "entry_id": "a8e0a594-f792-3b9c-abd9-fdc0468c6ec9",
                                        "glosses": [
                                            "Bedienelement einer grafischen Benutzeroberfläche"
                                        ],
                                        "tags": [
                                            "GUI"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f3571db-af06-4ad3-90e3-6e9af0ae4ef3",
                                                "sense_id": "09cff685-aec0-35c8-9355-a92ec14e053f",
                                                "text": "Wenn du auf diesen Knopf hier klickst, wird die Datei gespeichert."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "ca531521-29d6-3f38-8943-7247016efd78",
                                        "entry_id": "a8e0a594-f792-3b9c-abd9-fdc0468c6ec9",
                                        "glosses": [
                                            "kugelartiger Griff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "590f52b9-d54a-4c4f-8b20-f0fd2e718cb8",
                                                "sense_id": "ca531521-29d6-3f38-8943-7247016efd78",
                                                "text": "Ich hätte gerne neue Knöpfe aus Messing für die Kommode."
                                            },
                                            {
                                                "example_id": "352d261d-a432-41a1-9c42-599068869b39",
                                                "sense_id": "ca531521-29d6-3f38-8943-7247016efd78",
                                                "text": "Mein Opa hat einen Spazierstock mit einem Knopf aus Silber."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "ed7c81e8-ea5c-3e90-87dc-027fd1edd57d",
                                        "entry_id": "a8e0a594-f792-3b9c-abd9-fdc0468c6ec9",
                                        "glosses": [
                                            "kleines Kind"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4ff68d9-779c-496b-8353-70db6b0d6fc9",
                                                "sense_id": "ed7c81e8-ea5c-3e90-87dc-027fd1edd57d",
                                                "text": "Na, du kleiner Knopf!"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "28337d28-64ce-3b92-90bb-927bc3fd84d9",
                                        "entry_id": "a8e0a594-f792-3b9c-abd9-fdc0468c6ec9",
                                        "glosses": [
                                            "»Es ist auf einem Entscheidungspunkte«, von Knopf als Schwertknauf"
                                        ],
                                        "tags": [
                                            "in der Redewendung Spitz auf Knopf stehen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebc817db-21dd-4a0b-8e38-07b1e1dcc6a7",
                                                "sense_id": "28337d28-64ce-3b92-90bb-927bc3fd84d9",
                                                "text": "Hinter verschlossenen Türen wird heiß diskutiert, und es steht Spitz auf Knopf."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "8ded9d6e-9abe-3ade-b720-30e219953628",
                                        "entry_id": "a8e0a594-f792-3b9c-abd9-fdc0468c6ec9",
                                        "glosses": [
                                            "Im-Ohr-Ohrhörer, kleiner Kopfhörer, der im Ohr getragen wird; auch für Hörgerät"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46bbdbac-085c-4438-bbfd-3c668e1661d6",
                                                "sense_id": "8ded9d6e-9abe-3ade-b720-30e219953628",
                                                "text": "Nimm den Knopf aus dem Ohr! Ich rede mit dir!"
                                            },
                                            {
                                                "example_id": "59b3cfc0-c3c7-4d6c-b214-92662c751f12",
                                                "sense_id": "8ded9d6e-9abe-3ade-b720-30e219953628",
                                                "text": "Wem ein Hörgerät peinlich ist, kann den neuen Knopf im Ohr wählen, den garantiert keiner mehr sieht."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "31125957-5758-3085-b153-d9310c439261",
                                        "entry_id": "a8e0a594-f792-3b9c-abd9-fdc0468c6ec9",
                                        "glosses": [
                                            "Knoten"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "Swiss Standard German",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8dc93542-aee6-4c8d-a82d-baa9c39bdf8d",
                                                "sense_id": "31125957-5758-3085-b153-d9310c439261",
                                                "text": "Erst macht man in das Fadenende einen Knopf, damit der Faden besser im Gewebe hält."
                                            },
                                            {
                                                "example_id": "9088ce22-e1b8-4333-9160-7dd2b6e89b43",
                                                "sense_id": "31125957-5758-3085-b153-d9310c439261",
                                                "text": "„Nach vier Toren in den ersten vier Frühjahrsspielen hatte man den Eindruck, dass dem Beric-Nachfolger endlich der Knopf aufgegangen sei, nun hat der Kroate aber schon vier Spiele nicht mehr getroffen.“"
                                            },
                                            {
                                                "example_id": "604b0821-6ecc-42d9-9679-61d9f7e94e38",
                                                "sense_id": "31125957-5758-3085-b153-d9310c439261",
                                                "text": "„Er benötigt Selbstvertrauen, ihm muss der Knopf aufgehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    }
                                ]
                            }
                        ]
                    },
