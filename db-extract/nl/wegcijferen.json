                        "sense_id": "6b92599c-b165-37e3-9de1-79f16ebfd6b6",
                        "entry_id": "a6d1852e-1f18-3feb-b1aa-9bc483d26494",
                        "glosses": [
                            "kan niet weggecijferd worden: iets of iemand is van groot belang, ook als je probeert het weg te redeneren"
