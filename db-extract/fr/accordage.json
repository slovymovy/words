            {
                "entry_id": "3cc1d5ee-0f83-3add-916f-e726081abeab",
                "word": "accordage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "82101a5b-ad82-4249-ab60-0cd60473e06b",
                        "entry_id": "3cc1d5ee-0f83-3add-916f-e726081abeab",
                        "tags": [
