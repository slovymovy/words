                "senses": [
                    {
                        "sense_id": "cbd32375-67fb-3fb6-b73c-ef5b82b834f1",
                        "entry_id": "5eeb7268-a2e0-3190-9826-7dac407fc83b",
                        "glosses": [
                            "To howl loudly or prolongedly in lamentation or joy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbd62727-ace7-4d8f-be7e-008b62c29190",
                                "sense_id": "cbd32375-67fb-3fb6-b73c-ef5b82b834f1",
                                "text": "Should I ever marry, Watson, I should hope to inspire my wife with some feeling which would prevent her from being walked off by a housekeeper when my corpse was lying within a few yards of her. It was badly stage-managed; for even the rawest investigators must be struck by the absence of the usual feminine ululation."
                            },
                            {
                                "example_id": "e8c11256-2a3b-43e2-a8b1-72c849c0fccc",
                                "sense_id": "cbd32375-67fb-3fb6-b73c-ef5b82b834f1",
                                "text": "Women dance in tight circles, ululating with joy, while groups of men sit nearby watching."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b07a428-f985-3d62-ba67-36cea3ff8259",
                        "entry_id": "5eeb7268-a2e0-3190-9826-7dac407fc83b",
                        "glosses": [
                            "To produce a rapid and prolonged series of sharp noises with one's voice."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
