                ],
                "senses": [
                    {
                        "sense_id": "c5be94bf-49ce-340f-9eea-b0b84338822c",
                        "entry_id": "1b2b8d1f-ebc8-3c68-bcb1-5d2b37f682ed",
                        "glosses": [
                            "Person, mit der man eine laufbezogene Freundschaft pflegt; häufig jemand, mit dem man regelmäßig gemeinsam läuft"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "f8c83613-6937-4746-b2af-3b43ef339dd8",
                                "sense_id": "c5be94bf-49ce-340f-9eea-b0b84338822c",
                                "text": "„Am Sonntagmorgen trafen sich 5 Lauffreunde zum gemeinsamen langen Lauf über 30 Kilometer.“"
                            },
                            {
                                "example_id": "32c997cf-6a86-4fad-9c08-2c2807d14727",
                                "sense_id": "c5be94bf-49ce-340f-9eea-b0b84338822c",
                                "text": "„Ganz toll, dass wir so viele Lauffreunde aus nah und fern getroffen haben.“"
                            },
                            {
                                "example_id": "e0954698-0546-47bf-99ca-9476b0aaf5db",
                                "sense_id": "c5be94bf-49ce-340f-9eea-b0b84338822c",
                                "text": "„Am späten Mittwochabend traten unsere Lauffreunde Katrin, Anna und Frank begeistert ihren Rückweg ins Eichsfeld an.“"
                            },
                            {
                                "example_id": "61f73ce4-7692-4c13-a7f8-70643c228c30",
                                "sense_id": "c5be94bf-49ce-340f-9eea-b0b84338822c",
                                "text": "„Gesagt – getan – um 19 Uhr trafen sich neun Lauffreunde und gründeten den neuen Verein.“"
                            },
                            {
                                "example_id": "e8fc1ff4-8551-42f2-8ab3-90f1a8af5e8e",
                                "sense_id": "c5be94bf-49ce-340f-9eea-b0b84338822c",
                                "text": "„Auch unser Lauffreund Marko war dabei, vermutlich übte die Aussicht auf eine Weinverkostung an den zahlreichen Verpflegungsstellen eine besondere Anziehungskraft aus.“"
                            },
                            {
                                "example_id": "2c939660-8901-4d2e-9876-fedceeea4799",
                                "sense_id": "c5be94bf-49ce-340f-9eea-b0b84338822c",
                                "text": "„Wir danken unseren engagierten Vereinsmitgliedern und freuen uns auf tolle Begegnungen mit vielen Lauffreunden aus der Region.“"
                            },
                            {
                                "example_id": "c8a6e34a-e226-4834-8187-30d0099cee3d",
                                "sense_id": "c5be94bf-49ce-340f-9eea-b0b84338822c",
                                "text": "„Obwohl Dauerregen kurz vor dem Start einsetzte und der Waldboden im Laufe von 6 Stunden zunehmend matschiger wurde, ließen sich die Lauffreunde nicht von guten Leistungen abhalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
