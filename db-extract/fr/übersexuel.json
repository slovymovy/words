                "senses": [
                    {
                        "sense_id": "2c8c8268-08cc-3f71-84d0-0a34fbd6ec41",
                        "entry_id": "d9b3c618-b2ad-3000-aa7e-8db7c759a31b",
                        "glosses": [
                            "Homme qui entretient son apparence virile sans être macho."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8413f042-175e-4d70-aa10-570b9d4f87c4",
                                "sense_id": "2c8c8268-08cc-3f71-84d0-0a34fbd6ec41",
                                "text": "Les nouveaux codes masculins de l’übersexuel allient la virilité du métrosexuel et l’instinct paternel du retrosexuel qui caractérisait jusqu'à présent les nouveaux pères quinquagénaires."
                            },
                            {
                                "example_id": "4db2df42-64bc-4dab-be39-033816298c36",
                                "sense_id": "2c8c8268-08cc-3f71-84d0-0a34fbd6ec41",
                                "text": "Le métrosexuel n’est plus. Vive l’übersexuel!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6433ab41-c299-4479-8399-093e69df6c88",
                        "source_entry_id": "d9b3c618-b2ad-3000-aa7e-8db7c759a31b",
                        "source_sense_id": "2c8c8268-08cc-3f71-84d0-0a34fbd6ec41",
                        "target_lang_word": "ubersexual",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ubersexual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f2772e5-87ca-3e0c-8c3d-e0e786a72f01",
                                        "entry_id": "1a9c1af5-cb54-3b61-a016-b8cb90f9af3d",
                                        "glosses": [
                                            "A heterosexual male displaying confidence and concern for others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b7bbfd4-daf6-4563-a6a2-443ffd8f0f41",
                                                "sense_id": "6f2772e5-87ca-3e0c-8c3d-e0e786a72f01",
                                                "text": "First it was Metrosexuals. Now it's Ubersexuals. Everyone wants to tell men how they should dress, groom themselves and behave."
                                            },
                                            {
                                                "example_id": "9d32f291-66c5-4558-b82f-a254aec06496",
                                                "sense_id": "6f2772e5-87ca-3e0c-8c3d-e0e786a72f01",
                                                "text": "Unlike the effeminate metrosexual, the ubersexual’s sexuality is not in question.[…] And he won't mind being grouped with the trendsetters' top three ubersexuals Bono, George Clooney and Bill Clinton."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ubersexual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "82c0c7bb-3975-329d-87b6-a10ad5f8015c",
                                        "entry_id": "349f223e-d092-382b-bd48-50e0bcc8d045",
                                        "glosses": [
                                            "Having the qualities of an ubersexual."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32546895-6556-4364-9d10-9e7068e3c263",
                                                "sense_id": "82c0c7bb-3975-329d-87b6-a10ad5f8015c",
                                                "text": "A comparative study across 13 nations showed that a majority of Indian men were displaying signs of schizophrenia, torn between traditional machoism and the sensitive new age ubersexual male."
                                            },
                                            {
                                                "example_id": "92914108-387f-4d90-a013-be6e9d166f2e",
                                                "sense_id": "82c0c7bb-3975-329d-87b6-a10ad5f8015c",
                                                "text": "In the midst of “the crisis,” men tend not to acknowledge or embrace new masculinities — despite discourses regarding metrosexual or ubersexual masculinities — but rather retrench themselves into traditional, essentialized and hegemonic masculine images and embodied performances."
                                            },
                                            {
                                                "example_id": "53be7732-c951-4edc-97cc-a02611af6832",
                                                "sense_id": "82c0c7bb-3975-329d-87b6-a10ad5f8015c",
                                                "text": "So far he’s redecorated my apartment in the most awesome jungle motif, and we can wear each other's clothes. He’s mad ubersexual. We haven’t had sex yet, but it’s only been six months, […]"
                                            },
                                            {
                                                "example_id": "1cb0a32a-b3ee-465b-b9e9-199e1a2e5601",
                                                "sense_id": "82c0c7bb-3975-329d-87b6-a10ad5f8015c",
                                                "text": "Peter was übersexual, gorgeous, sensitive, and holistic, yet manly—check his motorcycle!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
