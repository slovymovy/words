    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b0559346-9b63-3f16-a22b-50e3bbf156bf",
                "word": "sophistry",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9c1fbff8-cba1-4f41-8a70-2f4f3925cbbb",
                        "entry_id": "b0559346-9b63-3f16-a22b-50e3bbf156bf",
                        "tags": [
                            "plural"
                        ],
                        "form": "sophistries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b4757e69-9b91-39e6-93c4-91e88226f897",
                        "entry_id": "b0559346-9b63-3f16-a22b-50e3bbf156bf",
                        "glosses": [
                            "The actions or arguments of a sophist."
                        ],
                        "tags": [
                            "historical",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "fff8f596-de9e-4556-b7ce-9cc8013a9c6e",
                                "sense_id": "b4757e69-9b91-39e6-93c4-91e88226f897",
                                "text": "Such conduct is at any rate not sophistical, if Aristotle be right in describing sophistry as the art of making money."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c8a90cd-f396-308f-981c-f997f881bdc4",
                        "entry_id": "b0559346-9b63-3f16-a22b-50e3bbf156bf",
                        "glosses": [
                            "Plausible yet fallacious argumentations or reasoning."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "305330d2-e228-38b1-b3ce-309ba4952eb5",
                        "entry_id": "b0559346-9b63-3f16-a22b-50e3bbf156bf",
                        "glosses": [
                            "An argument that seems plausible, but is fallacious or misleading, especially one devised deliberately to be so; a sophism."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "088720ef-daef-4b6b-ba7f-829bb4ea98df",
                                "sense_id": "305330d2-e228-38b1-b3ce-309ba4952eb5",
                                "text": "And so he reasoned until the first generous impulse to proclaim the truth and relinquish his titles and his estates to their rightful owner was forgotten beneath the mass of sophistries which self-interest had advanced."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca4d80e6-ed5f-4f68-86ac-2a8a57e3130a",
                        "source_entry_id": "b0559346-9b63-3f16-a22b-50e3bbf156bf",
                        "source_sense_description": "actions of a sophist",
