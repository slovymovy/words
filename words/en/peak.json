                        ],
                        "zh": [
                            {
                                "target_lang_word": "帽檐",
                                "target_lang_sense_clarification": "帽子前部遮阳的部分"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "05753215-ce41-3b00-a4c4-7692fc8d8fb8",
                    "sense_definition": "Used to describe the time when something is at its highest level or greatest extent.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "abstract_maximum",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hotel prices are much higher during the <w>peak</w> season.",
                            "target_lang_translations": {
                                "ru": "Цены в отелях намного выше в <w>пиковый</w> сезон.",
                                "fr": "Les prix des hôtels sont beaucoup plus élevés pendant la saison <w>de pointe</w>.",
                                "zh": "旅游<w>旺季</w>的酒店价格要高得多。"
                            }
                        },
                        {
                            "text": "We advise customers to avoid traveling during <w>peak</w> hours.",
                            "target_lang_translations": {
                                "ru": "Мы советуем клиентам избегать поездок в часы <w>пик</w>.",
                                "fr": "Nous conseillons aux clients d'éviter de voyager pendant les heures <w>de pointe</w>.",
                                "zh": "我们建议客户避开交通<w>高峰</w>时段出行。"
                            }
                        }
                    ],
                    "synonyms": [
                        "maximum",
                        "highest",
                        "top"
                    ],
                    "antonyms": [
                        "off-peak"
                    ],
                    "common_phrases": [
                        "peak season",
                        "peak hours",
                        "peak time",
                        "peak performance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для описания времени, когда что-либо находится на высшем уровне или имеет наибольший размах.",
                        "fr": "Utilisé pour décrire la période où quelque chose est à son niveau le plus élevé ou à son intensité maximale.",
                        "zh": "用于描述某事物处于最高水平或最大程度的时间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пиковый",
                                "target_lang_sense_clarification": "относящийся к максимуму нагрузки"
                            },
                            {
                                "target_lang_word": "максимальный",
                                "target_lang_sense_clarification": "наивысший"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "de pointe",
                                "target_lang_sense_clarification": "période de forte activité"
                            },
                            {
                                "target_lang_word": "maximal",
                                "target_lang_sense_clarification": "au plus haut niveau"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "高峰",
                                "target_lang_sense_clarification": "指繁忙或高强度的时期"
                            },
                            {
                                "target_lang_word": "旺季",
                                "target_lang_sense_clarification": "指旅游或商业的高峰期"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8703cc8-1535-3dfb-89f0-c422e99e251a",
                    "sense_definition": "Representing the most extreme, typical, or quintessential example of a type or behavior.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_maximum",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wearing socks with sandals is <w>peak</w> dad fashion.",
                            "target_lang_translations": {
                                "ru": "Носки с сандалиями — это <w>верх</w> отцовской моды.",
                                "fr": "Porter des chaussettes avec des sandales, c'est le <w>summum</w> de la mode des papas.",
                                "zh": "凉鞋配袜子简直是老爸时尚的<w>极致</w>。"
                            }
                        },
                        {
                            "text": "That awkward interview was <w>peak</w> television.",
                            "target_lang_translations": {
                                "ru": "Это неловкое интервью было <w>верхом</w> телевидения.",
                                "fr": "Cette interview gênante était le <w>summum</w> de la télévision.",
                                "zh": "那场尴尬的采访简直是电视节目的<w>极致</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "quintessential",
                        "archetypical",
                        "ultimate"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "often used in internet culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Представляющий собой самый крайний, типичный или совершенный пример типа или поведения.",
                        "fr": "Représentant l'exemple le plus extrême, typique ou parfait d'un type ou d'un comportement.",
                        "zh": "代表某种类型或行为最极端、典型或完美的例子。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "верх",
                                "target_lang_sense_clarification": "высшая степень чего-либо"
                            },
                            {
                                "target_lang_word": "типичный",
                                "target_lang_sense_clarification": "характерный пример"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "le summum",
                                "target_lang_sense_clarification": "le degré le plus élevé"
                            },
                            {
                                "target_lang_word": "l'apogée",
                                "target_lang_sense_clarification": "le point culminant"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "极致",
                                "target_lang_sense_clarification": "最高程度的体现"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7c479414-2dac-363c-add0-71bba55f3f29",
                    "sense_definition": "To reach the highest point, value, or level.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "abstract_maximum",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Temperatures are expected to <w>peak</w> at thirty degrees this afternoon.",
                            "target_lang_translations": {
                                "ru": "Ожидается, что температура <w>достигнет пика</w> в тридцать градусов сегодня днём.",
                                "fr": "Les températures devraient <w>atteindre un pic</w> de trente degrés cet après-midi.",
                                "zh": "预计今天下午气温将<w>达到高峰</w>，达到三十度。"
                            }
                        },
                        {
                            "text": "Her interest in the hobby <w>peaked</w> last year and has since declined.",
                            "target_lang_translations": {
                                "ru": "Её интерес к хобби <w>достиг пика</w> в прошлом году и с тех пор снизился.",
                                "fr": "Son intérêt pour ce passe-temps a <w>culminé</w> l'année dernière et a décliné depuis.",
                                "zh": "她对这项爱好的兴趣在去年<w>达到顶点</w>，此后便有所下降。"
                            }
                        }
                    ],
                    "synonyms": [
                        "culminate",
                        "climax",
                        "top out"
                    ],
                    "antonyms": [
                        "bottom out"
                    ],
                    "common_phrases": [
                        "peak early",
                        "peak at"
                    ],
                    "target_lang_definitions": {
                        "ru": "Достигать высшей точки, значения или уровня.",
                        "fr": "Atteindre le point, la valeur ou le niveau le plus élevé.",
                        "zh": "达到最高点、价值或水平。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "достигать пика",
                                "target_lang_sense_clarification": "доходить до высшей точки"
                            },
                            {
                                "target_lang_word": "достигать максимума",
                                "target_lang_sense_clarification": "доходить до предела"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "atteindre un pic",
                                "target_lang_sense_clarification": "arriver au point culminant"
                            },
                            {
                                "target_lang_word": "culminer",
                                "target_lang_sense_clarification": "atteindre son maximum"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "达到高峰",
                                "target_lang_sense_clarification": "到达最高点"
                            },
                            {
                                "target_lang_word": "达到顶点",
                                "target_lang_sense_clarification": "达到最高水平"
                            }
                        ]
                    }
                }
            ]
        },
        {
