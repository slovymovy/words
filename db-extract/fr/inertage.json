                                "target_senses": [
                                    {
                                        "sense_id": "22dc4d20-ebad-331b-abe6-9d588a040428",
                                        "entry_id": "e8d5a40a-be71-3bee-b6f4-2c789e00b1ab",
                                        "glosses": [
                                            "The filling of the ullage of a fuel tank with an inert gas to reduce the risk of explosion."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "055225bc-ffc2-42f5-8e89-09be0a7b3fc8",
                                                "sense_id": "22dc4d20-ebad-331b-abe6-9d588a040428",
                                                "text": "With regard to fuel tank inerting, the FAA letter stated that its research on ground-based inerting indicated that the costs associated with the needed ground equipment are significantly less than what was estimated by the FTHWG and, further, that analysis indicated that ground-based inerting would reduce the fleetwide average flammability exposure for affected CWTs to about 2 percent. The FAA indicated that it planned to conduct ground and flight tests to determine how long ground-based inerting would remain effective during flight and whether vent system modifications would be required to ensure its effectiveness. The FAA stated that it is also establishing an ARAC working group to gather additional data on the practicality of both ground-based and on-board inerting methods."
                                            }
                                        ]
                                    }
                                ]
