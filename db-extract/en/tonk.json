                "senses": [
                    {
                        "sense_id": "b00a7c74-05fc-3413-afe7-62fd6c4f64b4",
                        "entry_id": "6b22ffd1-1171-3877-8d03-2a7456d7c3d2",
                        "glosses": [
                            "An illegal immigrant of any country."
                        ],
                        "tags": [
                            "US",
                            "derogatory",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "05e10c9c-7b5c-4a7e-9d6b-6b31ab822bca",
                                "sense_id": "b00a7c74-05fc-3413-afe7-62fd6c4f64b4",
                                "text": "1990: United States. Congress. Senate. Committee on the Judiciary, Confirmation Hearings on Federal Appointments: Hearings Before the Committee - An agent, Larry Moy, when asked to define the derivation of the term “tonk,” replied: “...it's the sound of flashlight hitting somebody's head, tonk\". [This \"derivation\" is incorrect - see Etymology]"
                            },
                            {
                                "example_id": "163a96e0-c20c-492f-9eb5-47dc628319bb",
                                "sense_id": "b00a7c74-05fc-3413-afe7-62fd6c4f64b4",
                                "text": "1998: Cirenio Rodriguez & Enrique T Trueba, Leadership, education and political action, in Ethnic Identity and Power: Cultural Contexts of Political Action in School and Society - \"Catch as many tonks as you guys can. Safely. An alien is not worth busting a leg.\""
                            },
                            {
                                "example_id": "0c0d477a-363a-489e-9433-d11a63423798",
                                "sense_id": "b00a7c74-05fc-3413-afe7-62fd6c4f64b4",
                                "text": "2005: EMF (poster on The QandO Blog in response to Illegal immigration made easy, read at https://web.archive.org/web/20060528001651/http://www.qando.net/details.aspx?Entry=789 on 27 May 2006) - The pissed off Arizona land owner who snipes the tonks with a high powered rifle."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
