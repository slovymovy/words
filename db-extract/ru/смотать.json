                        "cross_references": [
                            {
                                "target_word": "dévider",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "66a95bf3-bea2-39e8-80b3-9e32f0b6f4b8",
                                        "entry_id": "2bfee117-93a8-3a1c-9d00-5a606538c5fd",
                                        "glosses": [
                                            "Mettre en écheveau le fil qui est sur le fuseau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a35e8853-37ea-4550-bce4-956a3dcfeb70",
                                                "sense_id": "66a95bf3-bea2-39e8-80b3-9e32f0b6f4b8",
                                                "text": "Lorsque les fils peignés doivent être livrés en écheveaux, ce qui arrive pour les laines de bonneterie, elles sont alors dévidées sur des dévidoirs."
                                            },
                                            {
                                                "example_id": "1fba5a31-6ec9-45dd-bc22-8dd072fa3ce7",
                                                "sense_id": "66a95bf3-bea2-39e8-80b3-9e32f0b6f4b8",
                                                "text": "Alexis rendait de petits services à Mme Loiseau, tendait les mains pour dévider la laine détricotée, […]"
                                            },
                                            {
                                                "example_id": "70260ce3-29f2-4063-81ca-df4425fd36e4",
                                                "sense_id": "66a95bf3-bea2-39e8-80b3-9e32f0b6f4b8",
                                                "text": "Les villages qui dévident la soie achètent les cocons aux sériciculteurs et revendent les produits semi-ouvrés aux villages filateurs, qui eux laissent à un quatrième groupe le soin du tissage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85430f1d-be90-37dd-bb15-25d0383fabb0",
                                        "entry_id": "2bfee117-93a8-3a1c-9d00-5a606538c5fd",
                                        "glosses": [
                                            "Mettre en peloton le fil qui est en écheveau ou en bobines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96c2642d-5e63-4985-83ee-b735c50cb45b",
                                                "sense_id": "85430f1d-be90-37dd-bb15-25d0383fabb0",
                                                "text": "Elle a dévidé trois écheveaux dont elle n’a fait qu’un peloton."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d83eda6-3ad0-312b-a48d-bd7caf4a0724",
                                        "entry_id": "2bfee117-93a8-3a1c-9d00-5a606538c5fd",
                                        "glosses": [
                                            "Dérouler le fil enroulé sur une bobine."
                                        ],
                                        "tags": [
                                            "Plus généralement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d771eb6-715a-4596-aed5-e8754702c532",
                                                "sense_id": "5d83eda6-3ad0-312b-a48d-bd7caf4a0724",
                                                "text": "Gaspard entendit le bruit de la chaîne d’ancre qui se dévidait dans l’écubier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb7577ba-a7d8-3659-b3b6-000508eda28a",
                                        "entry_id": "2bfee117-93a8-3a1c-9d00-5a606538c5fd",
                                        "glosses": [
                                            "Dérouler en esprit."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2873ea2-7c20-49fa-b43e-89e5b125b083",
                                                "sense_id": "cb7577ba-a7d8-3659-b3b6-000508eda28a",
                                                "text": "Comme une île déserte\nQue recouvre la mer\nMes vagues se dévident\nSans toi, sans toi"
                                            },
                                            {
                                                "example_id": "faf49657-b22e-41b6-bbb0-00b8347651e1",
                                                "sense_id": "cb7577ba-a7d8-3659-b3b6-000508eda28a",
                                                "text": "Je prendrai ce mot et je déviderai toutes les pensées, toutes les images qui s’accrochaient à lui."
                                            },
                                            {
                                                "example_id": "3bcf705b-c0ce-420a-916b-ac9808b56039",
                                                "sense_id": "cb7577ba-a7d8-3659-b3b6-000508eda28a",
                                                "text": "Quelle réunion ! La ruche ! Le bouillon ! Tout le monde est là. Bird qui fait des gammes au fond du bus, Miles à la recherche du son qui le rendra célèbre, chacun dévidant avec furie la pelote de son destin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
