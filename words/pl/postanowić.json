                            },
                            {
                                "target_lang_word": "resolve",
                                "target_lang_sense_clarification": "to firmly determine to do something"
                            },
                            {
                                "target_lang_word": "make up one's mind",
                                "target_lang_sense_clarification": "to reach a decision"
