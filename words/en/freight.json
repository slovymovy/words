{
    "word_family": [
        "freighter"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5067d471-3836-34a1-99f3-d9ebaadd3290",
                    "sense_definition": "Goods, products, or items that are transported in bulk by truck, train, ship, or aircraft.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "transport_goods",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The truck driver checked his vehicle to ensure the <w>freight</w> was secure before leaving.",
                            "target_lang_translations": {
                                "ru": "Водитель грузовика проверил машину перед выездом, чтобы убедиться, что <w>груз</w> надежно закреплен.",
                                "zh": "卡车司机在出发前检查了车辆，以确保<w>货物</w>固定稳妥。"
                            }
                        },
                        {
                            "text": "Much of the <w>freight</w> arriving at the port consists of electronics and machinery.",
                            "target_lang_translations": {
                                "ru": "Большая часть <w>груза</w>, прибывающего в порт, состоит из электроники и оборудования.",
                                "zh": "抵达港口的许多<w>货物</w>都是电子产品和机械设备。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cargo",
                        "load",
                        "shipment",
                        "consignment",
                        "haul"
                    ],
                    "common_phrases": [
                        "carry freight",
                        "heavy freight",
                        "freight traffic",
                        "handle freight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Товары, продукты или предметы, перевозимые оптом на грузовиках, поездах, кораблях или самолетах.",
                        "zh": "通过卡车、火车、船舶或飞机批量运输的货物、产品或物品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "груз",
                                "target_lang_sense_clarification": "перевозимые предметы или товары"
                            },
                            {
                                "target_lang_word": "фрахт",
                                "target_lang_sense_clarification": "груз, перевозимый по найму (обычно морем)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "货物",
                                "target_lang_sense_clarification": "运输中的商品或物品"
                            },
                            {
                                "target_lang_word": "货运",
                                "target_lang_sense_clarification": "指代被运输的物品本身"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "85339cfd-79d5-3213-a4b5-e2538509a1b4",
                    "sense_definition": "The system or process of transporting goods, usually by water, land, or air.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "transport_system",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sending the heavy package by air <w>freight</w> is faster but much more expensive.",
                            "target_lang_translations": {
                                "ru": "Отправка тяжелой посылки авиа<w>перевозкой</w> быстрее, но намного дороже.",
                                "zh": "通过航空<w>货运</w>寄送这个沉重的包裹速度更快，但费用要高得多。"
                            }
                        },
                        {
                            "text": "The company specializes in rail <w>freight</w> and moves goods across the entire continent.",
                            "target_lang_translations": {
                                "ru": "Компания специализируется на железнодорожных <w>перевозках</w> и перемещает товары по всему континенту.",
                                "zh": "该公司专门从事铁路<w>货运</w>，将货物运往整个大陆。"
                            }
                        }
                    ],
                    "synonyms": [
                        "transport",
                        "transportation",
                        "shipping",
                        "haulage"
                    ],
                    "common_phrases": [
                        "air freight",
                        "sea freight",
                        "rail freight",
                        "freight charges"
                    ],
                    "target_lang_definitions": {
                        "ru": "Система или процесс транспортировки товаров, обычно по воде, суше или воздуху.",
                        "zh": "通常通过水路、陆路或空路运输货物的系统或过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перевозка",
                                "target_lang_sense_clarification": "процесс перемещения грузов"
                            },
                            {
                                "target_lang_word": "транспортировка",
                                "target_lang_sense_clarification": "доставка товаров"
                            },
                            {
                                "target_lang_word": "фрахт",
                                "target_lang_sense_clarification": "в контексте морских или авиаперевозок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "货运",
                                "target_lang_sense_clarification": "货物运输的系统或业务"
                            },
                            {
                                "target_lang_word": "运输",
                                "target_lang_sense_clarification": "货物搬运的过程"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2248ee75-c387-3c08-bb17-bc61a6d67679",
                    "sense_definition": "A train used specifically for carrying goods rather than passengers.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "transport_vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had to wait at the crossing for ten minutes while a long <w>freight</w> passed by.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось ждать на переезде десять минут, пока мимо проходил длинный <w>товарный поезд</w>.",
                                "zh": "我们在道口等了十分钟，才让一列长长的<w>货运列车</w>通过。"
                            }
                        },
                        {
                            "text": "Two westbound <w>freights</w> were delayed on the tracks due to the heavy storm.",
                            "target_lang_translations": {
                                "ru": "Два <w>товарных поезда</w>, идущих на запад, задержались на путях из-за сильного шторма.",
                                "zh": "由于暴风雨，两列向西行驶的<w>货运列车</w>在轨道上延误了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "freight train"
                    ],
                    "antonyms": [
                        "passenger train"
                    ],
                    "common_phrases": [
                        "hop a freight",
                        "slow freight",
                        "westbound freight"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поезд, используемый специально для перевозки грузов, а не пассажиров.",
                        "zh": "专门用于运送货物而非乘客的火车。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "товарный поезд",
                                "target_lang_sense_clarification": "железнодорожный состав для грузов"
                            },
                            {
                                "target_lang_word": "товарняк",
                                "target_lang_sense_clarification": "разговорное название грузового поезда"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "货运列车",
                                "target_lang_sense_clarification": "专门运货的火车"
                            },
                            {
                                "target_lang_word": "货车",
                                "target_lang_sense_clarification": "指代铁路货运车厢或列车"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d05aba0-5354-34e0-913a-d42a53d07d5c",
                    "sense_definition": "The money paid for the transportation of goods.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "transport_cost",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The merchant refused to pay the <w>freight</w> until the goods were delivered safely.",
                            "target_lang_translations": {
                                "ru": "Торговец отказался оплачивать <w>фрахт</w>, пока товары не будут доставлены в целости.",
                                "zh": "商人拒绝在货物安全送达前支付<w>运费</w>。"
                            }
                        },
                        {
                            "text": "We calculated that the <w>freight</w> for this shipment would cost more than the goods themselves.",
                            "target_lang_translations": {
                                "ru": "Мы подсчитали, что <w>плата за перевозку</w> этой партии будет стоить больше, чем сами товары.",
                                "zh": "我们计算出，这批货物的<w>运费</w>比货物本身的价值还要高。"
                            }
                        }
                    ],
                    "synonyms": [
                        "carriage",
                        "shipping charge",
                        "shipping cost"
                    ],
                    "common_phrases": [
                        "pay the freight",
                        "freight rates",
                        "cost of freight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Деньги, уплачиваемые за транспортировку товаров.",
                        "zh": "为运输货物所支付的费用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фрахт",
                                "target_lang_sense_clarification": "плата за перевозку груза"
                            },
                            {
                                "target_lang_word": "плата за провоз",
                                "target_lang_sense_clarification": "стоимость доставки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "运费",
                                "target_lang_sense_clarification": "运输货物的成本"
                            },
                            {
                                "target_lang_word": "货运费",
                                "target_lang_sense_clarification": "支付给承运人的费用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31aaeba0-da3a-37ef-8761-a1f9c2f3757b",
                    "sense_definition": "A heavy emotional or cultural burden or meaning associated with something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical_burden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old house carried a lot of emotional <w>freight</w> for the family who lived there.",
                            "target_lang_translations": {
                                "ru": "Старый дом нес в себе тяжелый эмоциональный <w>груз</w> для семьи, которая там жила.",
                                "zh": "对于住在那里的家庭来说，这座老房子承载着沉重的心理<w>负担</w>。"
                            }
                        },
                        {
                            "text": "Certain words carry historical <w>freight</w> that can change how a message is received.",
                            "target_lang_translations": {
                                "ru": "Определенные слова несут исторический <w>груз</w>, который может изменить восприятие сообщения.",
                                "zh": "某些词汇带有历史<w>内涵</w>，这可能会改变信息被接收的方式。"
                            }
                        }
                    ],
                    "synonyms": [
                        "baggage",
                        "burden",
                        "weight"
                    ],
                    "common_phrases": [
                        "emotional freight",
                        "cultural freight",
                        "carry freight"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "figurative"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тяжелое эмоциональное или культурное бремя или значение, связанное с чем-либо.",
                        "zh": "与某事物相关的沉重情感或文化负担或意义。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "груз",
                                "target_lang_sense_clarification": "переносное значение: бремя, тяжесть"
                            },
                            {
                                "target_lang_word": "бремя",
                                "target_lang_sense_clarification": "тяжелая ноша (эмоциональная)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "负担",
                                "target_lang_sense_clarification": "引申为心理或文化上的重担"
                            },
                            {
                                "target_lang_word": "内涵",
                                "target_lang_sense_clarification": "指词语或事物所承载的深层意义"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0d579de0-ba60-34dd-a9fb-a2cb36050e44",
                    "sense_definition": "To transport goods in bulk by air, sea, or land.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "action_transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to <w>freight</w> the equipment to the island rather than fly it.",
                            "target_lang_translations": {
                                "ru": "Компания решила <w>отправить</w> оборудование на остров <w>грузом</w> (по морю), а не самолетом.",
                                "zh": "公司决定通过海运<w>运输</w>设备到岛上，而不是空运。"
                            }
                        },
                        {
                            "text": "Farmers <w>freight</w> their fresh produce to the city markets early every morning.",
                            "target_lang_translations": {
                                "ru": "Фермеры <w>перевозят</w> свои свежие продукты на городские рынки рано утром.",
                                "zh": "农民每天清晨将新鲜农产品<w>运输</w>到城市市场。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ship",
                        "transport",
                        "haul",
                        "convey"
                    ],
                    "common_phrases": [
                        "freight goods",
                        "freight cargo"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перевозить товары оптом по воздуху, морю или суше.",
                        "zh": "通过空运、海运或陆运批量运输货物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перевозить",
                                "target_lang_sense_clarification": "транспортировать груз"
                            },
                            {
                                "target_lang_word": "отправлять грузом",
                                "target_lang_sense_clarification": "посылать через грузовую компанию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "运输",
                                "target_lang_sense_clarification": "运送货物"
                            },
                            {
                                "target_lang_word": "货运",
                                "target_lang_sense_clarification": "作为动词使用，指进行货运操作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4c11b53-76c4-3fe8-9843-527e85279186",
                    "sense_definition": "To load a vehicle or vessel with cargo.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "action_load",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crew worked through the night to <w>freight</w> the ship with supplies for the voyage.",
                            "target_lang_translations": {
                                "ru": "Команда работала всю ночь, чтобы <w>нагрузить</w> корабль припасами для плавания.",
                                "zh": "船员们通宵工作，为船只<w>装载</w>航行所需的补给品。"
                            }
                        },
                        {
                            "text": "She made small toy boats and <w>freighted</w> them with pebbles before setting them afloat.",
                            "target_lang_translations": {
                                "ru": "Она делала маленькие игрушечные лодочки и <w>нагружала</w> их галькой, прежде чем пустить по воде.",
                                "zh": "她制作了小玩具船，并在放水前用鹅卵石将它们<w>装满</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "load",
                        "lade"
                    ],
                    "antonyms": [
                        "unload"
                    ],
                    "target_lang_definitions": {
                        "ru": "Загружать транспортное средство или судно грузом.",
                        "zh": "将货物装载到运输工具或船只上。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нагружать",
                                "target_lang_sense_clarification": "наполнять грузом"
                            },
                            {
                                "target_lang_word": "грузить",
                                "target_lang_sense_clarification": "помещать груз на судно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "装载",
                                "target_lang_sense_clarification": "将货物放入运输工具"
                            },
                            {
                                "target_lang_word": "装货",
                                "target_lang_sense_clarification": "进行装载货物的动作"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0d6b5efb-9cfa-39d6-8ef5-545463419177",
                    "sense_definition": "Loaded or burdened with something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "adj_laden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient vessel arrived at the dock, fully <w>freight</w> with spices from the east.",
                            "target_lang_translations": {
                                "ru": "Древнее судно прибыло в док, полностью <w>нагруженное</w> специями с востока.",
                                "zh": "那艘古老的船只抵达码头时，船上<w>装满</w>了来自东方的香料。"
                            }
                        },
                        {
                            "text": "Every ship <w>freight</w> with gold was a target for the pirates in those waters.",
                            "target_lang_translations": {
                                "ru": "Каждый корабль, <w>нагруженный</w> золотом, был мишенью для пиратов в тех водах.",
                                "zh": "每一艘<w>载有</w>黄金的船只都是那片海域海盗的目标。"
                            }
                        }
                    ],
                    "synonyms": [
                        "laden",
                        "loaded",
                        "fraught"
                    ],
                    "antonyms": [
                        "empty"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нагруженный или обремененный чем-либо.",
                        "zh": "装载或负担着某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нагруженный",
                                "target_lang_sense_clarification": "полный чего-либо"
                            },
                            {
                                "target_lang_word": "полный",
                                "target_lang_sense_clarification": "содержащий большое количество"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "装满",
                                "target_lang_sense_clarification": "形容载有大量物品"
                            },
                            {
                                "target_lang_word": "载有",
                                "target_lang_sense_clarification": "承载着某物"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}