                "translations": [
                    {
                        "translation_id": "b15e980d-61e2-43bb-9011-48d67248cb90",
                        "source_entry_id": "82b2df99-cd83-36b7-b4b7-8a8c9780b37e",
                        "source_sense_id": "5904da8d-f169-390e-bbe2-146634debb62",
