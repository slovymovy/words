                "senses": [
                    {
                        "sense_id": "ef38d33f-c186-3ab5-87b2-d54d0eec8354",
                        "entry_id": "78cca421-8a54-3fbc-825a-2e41e762566c",
                        "glosses": [
                            "Ausscheidung von nicht nutzbaren Stoffen aus dem Verdauungstrakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "527b6c6b-eec9-4726-8e09-387e9b71dc75",
                                "sense_id": "ef38d33f-c186-3ab5-87b2-d54d0eec8354",
                                "text": "Das gesammte Geschäft der Verdauung oder Intestinalnahrung theilt sich in Aufnahme der Nahrungsstoffe, eigentliche Verdauung derselben (Digestion), und Ausscheidung der unverwendbaren Reste (Egestion); …"
                            },
                            {
                                "example_id": "3444605d-74dd-4da2-a52a-240f0d17aa2b",
                                "sense_id": "ef38d33f-c186-3ab5-87b2-d54d0eec8354",
                                "text": "Parallel dazu werden Mutanten mit Defizienzen in der Bildung, Prozessierung und Egestion von Phagosomen isoliert und genetisch kartiert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
