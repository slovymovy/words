        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b467fd5f-12dc-302b-846f-8a703116017b",
                "word": "filioque",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "092c1258-615a-381e-9b56-60567e64d8e2",
                        "entry_id": "b467fd5f-12dc-302b-846f-8a703116017b",
                        "glosses": [
                            "The use of the Latin word filioque (“and from the son”) in the Western form of the Nicene Creed, to indicate that the Holy Spirit proceeds from both the Father and the Son (as opposed to the Eastern Orthodox Churches which believe the Spirit proceeds from the Father alone)."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5f2c6c5a-7411-4d8e-8c58-07eb6155fb23",
                                "sense_id": "092c1258-615a-381e-9b56-60567e64d8e2",
                                "text": "But in 867 an assertion of papal authority led to a formal split. Photius, the Patriarch of Constantinople, attacked the filioque, which was beginning to draw papal support, and summoned a council that excommunicated the Pope."
                            },
                            {
                                "example_id": "5d1be0ea-d772-43c0-ae53-479937164fc9",
                                "sense_id": "092c1258-615a-381e-9b56-60567e64d8e2",
                                "text": "Another issue was the promotion of that troublesome addition to the Nicene Creed, the Filioque or double procession in the Trinity of the Spirit from Father and Son, which had taken its cue from Augustine's writing on the Trinity."
                            },
                            {
                                "example_id": "4c12dc53-33dc-4c0e-8fef-d3875148d79a",
                                "sense_id": "092c1258-615a-381e-9b56-60567e64d8e2",
                                "text": "The Second Council of Lyon […] only succeeded in confirming and defining a key item of Catholic theology, the filioque, which has barred the way to reconciliation ever since."
                            }
                        ]
                    }
                ],
