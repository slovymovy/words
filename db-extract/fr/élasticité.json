        "fr-extract.jsonl": [
            {
                "entry_id": "0854f566-144d-3ca2-b5f8-7ef9f7f28a82",
                "word": "élasticité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "76490edf-35f0-4b2e-b27c-5930a745ffaa",
                        "entry_id": "0854f566-144d-3ca2-b5f8-7ef9f7f28a82",
                        "tags": [
                            "plural"
                        ],
                        "form": "élasticités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "65b56a7e-2799-313a-97ef-f325ca5fb257",
                        "entry_id": "0854f566-144d-3ca2-b5f8-7ef9f7f28a82",
                        "glosses": [
                            "Propriété qu’ont les corps solides d’accepter une déformation temporaire et de reprendre leur forme dès que les causes de cette déformation ont cessé d’agir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e519cf13-b40f-4a1f-806a-329e856056e6",
                                "sense_id": "65b56a7e-2799-313a-97ef-f325ca5fb257",
                                "text": "Le médecin répondit par une description pathologique effrayante ; il expliqua comment l’élasticité donnée par la nature dans la jeunesse aux muscles, aux os, n’existait plus à un certain âge, surtout chez les femmes que leur profession avait rendues sédentaires pendant longtemps comme mademoiselle Rogron."
                            },
                            {
                                "example_id": "3cdc48c2-a7e7-48d1-9fc8-80dfb14af8ea",
                                "sense_id": "65b56a7e-2799-313a-97ef-f325ca5fb257",
                                "text": "L'humidité donne de la souplesse et de l'élasticité aux fils, et c'est en vue de la facilité du travail que les filateurs maintiennent l'air de leurs salles de préparation et de métier à filer à un degré hygrométrique suffisant."
                            },
                            {
                                "example_id": "68fb712f-26a9-4be3-9c6a-8c40c52565c0",
                                "sense_id": "65b56a7e-2799-313a-97ef-f325ca5fb257",
                                "text": "Je me livrais souvent à la pêche. L'humidité avait enlevé beaucoup d'élasticité à mon arc et je préférais harponner les dorades lorsqu'elles passaient à ma portée."
                            }
                        ]
                    },
                    {
                        "sense_id": "ab0b951a-85d9-37cb-9b73-054fc0b8a921",
                        "entry_id": "0854f566-144d-3ca2-b5f8-7ef9f7f28a82",
                        "glosses": [
                            "Propriété qu’ont les corps solides d’accepter une déformation temporaire et de reprendre leur forme dès que les causes de cette déformation ont cessé d’agir.",
                            "Dans le domaine de la fatigue des matériaux, désigne une sollicitation restant dans le domaine élastique (c'est-à-dire sans déformation plastique)."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "d167cd32-56fe-4d58-ab99-6911bb8b0303",
                                "sense_id": "ab0b951a-85d9-37cb-9b73-054fc0b8a921",
                                "text": "Les comportements asymptotiques des structures élasto-visco-plastiques soumises à des chargements mécaniques cycliques sont : élasticité, adaptation, accommodation et rochet."
                            }
                        ]
                    },
                    {
                        "sense_id": "d0ec10dd-6638-3664-93dc-6f46b4eddbc1",
                        "entry_id": "0854f566-144d-3ca2-b5f8-7ef9f7f28a82",
                        "glosses": [
                            "Propriété qu’ont les corps solides d’accepter une déformation temporaire et de reprendre leur forme dès que les causes de cette déformation ont cessé d’agir.",
                            "Propriété qu'ont les gaz et les liquides d'accepter une variation temporaire de leur volume, et de reprendre leur volume initial lorsque les causes de cette variation ont cessé d'agir"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "43bee2dc-30be-3c12-accd-1a29a2263a50",
                        "entry_id": "0854f566-144d-3ca2-b5f8-7ef9f7f28a82",
                        "glosses": [
                            "Mesure de cette propriété."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ea2fd84-0469-451d-86ff-8cd24a871876",
                                "sense_id": "43bee2dc-30be-3c12-accd-1a29a2263a50",
                                "text": "Tous les matériaux sont élastiques. Ceux qui sont communément qualifiés ainsi sont ceux dont l’élasticité est notable."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb6974ea-3e0c-3ff5-b688-5f6ac97c2359",
                        "entry_id": "0854f566-144d-3ca2-b5f8-7ef9f7f28a82",
                        "glosses": [
                            "Faculté de s’élargir."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b32f3c40-59ca-4f24-9a54-aefa515e14f9",
                                "sense_id": "eb6974ea-3e0c-3ff5-b688-5f6ac97c2359",
                                "text": "L’élasticité du budget."
                            },
                            {
                                "example_id": "f60c3898-cda2-43d4-abf6-bfbf53379913",
                                "sense_id": "eb6974ea-3e0c-3ff5-b688-5f6ac97c2359",
                                "text": "L’élasticité d’un principe, d’une mesure."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc125908-feb7-30d0-85ec-9d13c2c6c49a",
                        "entry_id": "0854f566-144d-3ca2-b5f8-7ef9f7f28a82",
                        "glosses": [
                            "État de l’âme qui se relève après un découragement, un abattement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e769520d-ed3e-4180-8da0-748cfebdc411",
                                "sense_id": "bc125908-feb7-30d0-85ec-9d13c2c6c49a",
                                "text": "La bonne fortune rendit à son esprit toute son élasticité."
                            },
                            {
                                "example_id": "be68a71c-90e0-4db4-b922-ff64160496c1",
                                "sense_id": "bc125908-feb7-30d0-85ec-9d13c2c6c49a",
                                "text": "L’élasticité d’une conscience."
                            }
                        ]
                    },
                    {
                        "sense_id": "09708a12-a8fe-3731-84c5-a5597ae2ab20",
                        "entry_id": "0854f566-144d-3ca2-b5f8-7ef9f7f28a82",
                        "glosses": [
                            "Variation d'une grandeur provoquée par la variation d'une autre grandeur."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "9482baa3-6d4c-405a-9010-e086dd3118ce",
                                "sense_id": "09708a12-a8fe-3731-84c5-a5597ae2ab20",
                                "text": "On observe qu'une augmentation de prix de 1 % entraîne une baisse des quantités demandées de 7 %, la demande est donc élastique."
                            },
                            {
                                "example_id": "fa5aeb6b-c0d8-4408-82c6-190281108641",
                                "sense_id": "09708a12-a8fe-3731-84c5-a5597ae2ab20",
                                "text": "Les économistes contemporains ont largement étendu la portée du concept d’élasticité en l’employant dans d’autres situations que l’étude de la demande."
                            }
                        ]
                    }
                ],
                "translations": [
