                    {
                        "sense_id": "34bfc6b5-5564-3a2e-a8ac-c9aa90959583",
                        "entry_id": "3384bcb2-bb60-327f-9e9d-e649781789e5",
                        "glosses": [
                            "een term uit de rechtspraak die duidt op een gemaakte fout in de procedure, volgens art. 359a Sv."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84f4c900-c8a2-41e9-9336-c4a9e0f7e102",
                                "sense_id": "34bfc6b5-5564-3a2e-a8ac-c9aa90959583",
                                "text": "De Zimbabwaanse activist Evan Mawarire, een prominent tegenstander van president Robert Mugabe, is vrijgelaten. De rechter bepaalde dat de welbespraakte predikant, dankzij de sociale media erg populair in Zimbabwe, de cel mocht verlaten wegens vormfouten, aldus zijn advocaat Harrison Nkomo."
                            },
                            {
                                "example_id": "6e33a8b9-673a-4510-a805-5908f20da154",
                                "sense_id": "34bfc6b5-5564-3a2e-a8ac-c9aa90959583",
                                "text": "De vader die eind vorige maand in het Belgische Soumagne zijn dochters van acht en elf jaar ombracht en daarna zelfmoord probeerde te plegen, is donderdag vanwege een vormfout vrijgelaten. Dat heeft zijn advocaat laten weten."
                            }
                        ]
                    }
