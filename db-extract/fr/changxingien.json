                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Changhsingian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f40fe562-b171-3dc6-b1a7-33a528af56c2",
                                        "entry_id": "21a0ce3e-eb29-394e-a963-23817cd9719c",
                                        "glosses": [
                                            "A subdivision of the Permian period."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1193d24e-869e-43d8-8e3d-97d65c4ac56f",
                                                "sense_id": "f40fe562-b171-3dc6-b1a7-33a528af56c2",
                                                "text": "There is no evidence for a large drop in PCO2, and independent proxy data indicate only a minor temperature decrease of a few degrees Celsius during the Changhsingian (22), suggesting that these mechanisms alone cannot explain the pH increase (fig. S5)."
                                            },
                                            {
                                                "example_id": "ef9abb6b-b2c4-4fe6-bb82-18099d44496a",
                                                "sense_id": "f40fe562-b171-3dc6-b1a7-33a528af56c2",
                                                "text": "Anoxic/euxinic benthic marine conditions prevailed throughout the middle Wuchiapingian to the early Changhsingian at Shangsi, which persisted for 3.9 Myr (256.974–253.073 Ma). This long-term middle Wuchiapingian-early Changhsingian anoxia event could be correlated both regionally and globally, and was caused by paleogeographic restrictions, relative high sea levels, high marine productivities, and possible global climate changes."
                                            }
                                        ]
                                    }
                                ]
                            }
