                "senses": [
                    {
                        "sense_id": "4e3b33f7-9d68-3264-b9b7-3295a3e11ca6",
                        "entry_id": "75a0400e-5efd-3a0c-af4f-dc618b3c5231",
                        "glosses": [
                            "получить некоторые сведения, приобрести некоторые знания, получить представление о ком-либо, о чём-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35a148bc-f79e-4ba3-956c-1e177cbb29ab",
                                "sense_id": "4e3b33f7-9d68-3264-b9b7-3295a3e11ca6",
                                "text": "Иногда я удерживала у себя то или другое животное лишь несколько дней — только для того, чтобы с ним ознакомиться или сделать с него несколько рисунков."
                            }
                        ]
                    }
                ],
