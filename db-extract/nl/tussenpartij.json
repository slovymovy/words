                    },
                    {
                        "sense_id": "949b2590-2231-353d-a73f-65f8fd8fdf0d",
                        "entry_id": "5d7e87aa-44df-3d43-96f4-a31a02fe6da6",
                        "glosses": [
                            "organisatie die probeert te bemiddelen tussen twee strijdende partijen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c45e4860-4796-48ce-b5bf-5037f97a65e6",
                                "sense_id": "949b2590-2231-353d-a73f-65f8fd8fdf0d",
                                "text": "Jarenlange gesprekken tussen de drie betrokken landen met verschillende bemiddelaars, waaronder de Amerikanen, hebben geen oplossing opgeleverd. Bij de ronde van vorige week, met de Afrikaanse Unie als tussenpartij, ging het niet anders."
                            }
                        ]
                    },
                    {
                        "sense_id": "4ae5f61b-b404-3002-9a4f-2a494200c942",
                        "entry_id": "5d7e87aa-44df-3d43-96f4-a31a02fe6da6",
                        "glosses": [
                            "partij die bemiddelt tussen twee economische partijen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "584c5af5-d272-4e49-ace1-862447446bed",
                                "sense_id": "4ae5f61b-b404-3002-9a4f-2a494200c942",
                                "text": "Ook internationaal geld overmaken kan veel efficiënter en goedkoper zonder tussenpartij. Dat gebeurt ook al, bijvoorbeeld in EL Salvador. Hét argument van de Salvadoraanse president om recent Bitcoin te omarmen was de grote Salvadoraanse enclave in de Verenigde Staten. Zij maken hoge kosten om geld naar huis te sturen."
                            },
                            {
                                "example_id": "a8ff26c4-dab4-4104-b0ab-21134a90bb23",
                                "sense_id": "4ae5f61b-b404-3002-9a4f-2a494200c942",
                                "text": "Want dat is waar stablecoins vooral voor worden gebruikt: als betalingsmiddel waarmee je snel en goedkoop andere cryptomunten kan kopen en verkopen zonder dat er een tussenpartij zoals een bank voor nodig is. Zoals The New York Times het zegt: stablecoins vormen een brug tussen geld uit de oude wereld en crypto uit de nieuwe wereld."
                            }
                        ]
                    }
