        "de-extract.jsonl": [
            {
                "entry_id": "6a80a245-3d54-3a3e-9c1c-ff2dd9b2a0fe",
                "word": "winegrower",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "584bcdd8-5631-38ee-be57-ecd320a00409",
                        "entry_id": "6a80a245-3d54-3a3e-9c1c-ff2dd9b2a0fe",
                        "glosses": [
                            "der Winzer, der Weinbauer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7716dae9-9bd5-406b-b1bf-95443628bf2f",
                                "sense_id": "584bcdd8-5631-38ee-be57-ecd320a00409",
                                "text": "\"… Together, we have convinced leading German and international winegrowers to present their high-class wines on board our trains.\"",
                                "translation": "„… Gemeinsam haben wir deutsche und internationale Spitzenwinzer überzeugen können, ihre hochwertigen Weine an Bord zu präsentieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "58455db1-93ad-477e-ac86-256b6a98032c",
                        "source_entry_id": "6a80a245-3d54-3a3e-9c1c-ff2dd9b2a0fe",
                        "source_sense_id": "584bcdd8-5631-38ee-be57-ecd320a00409",
                        "source_sense_description": "Weinbau: der Winzer, der Weinbauer",
                        "target_lang_word": "Winzer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Winzer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1a76cce9-fa0b-3931-842b-8640131d35df",
                                        "entry_id": "65fe7d71-9043-3e4d-bf2b-43c2e8b44c4a",
                                        "glosses": [
                                            "Person, die beruflich Wein an- und teilweise auch ausbaut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dee3acd-d13b-46f4-b1ab-6d35b5d9796c",
                                                "sense_id": "1a76cce9-fa0b-3931-842b-8640131d35df",
                                                "text": "„Günther Jauch wird Winzer. Bald schon wird ihm das Weingut von Othegraven im 600-Seelen-Örtchen Kanzem an der Saar gehören.“"
                                            },
                                            {
                                                "example_id": "29384e2e-5c17-4917-9bb1-b01bd3e788be",
                                                "sense_id": "1a76cce9-fa0b-3931-842b-8640131d35df",
                                                "text": "„Die Winzer von Saale und Unstrut rechnen mit erheblichen Ertragseinbußen. Sie befürchten im Vergleich zu den Vorjahren Ausfälle zwischen 70 und 80 Prozent.“"
                                            },
                                            {
                                                "example_id": "894b4b38-cdcf-4483-8088-03ad21052ba1",
                                                "sense_id": "1a76cce9-fa0b-3931-842b-8640131d35df",
                                                "text": "„Der Winzer war braungebrannt und jung und sah aus wie eine widernatürliche Kreuzung zwischen Adonis uns Apoll.“"
                                            },
                                            {
                                                "example_id": "ba4aabb4-650e-45a0-8cfa-176a78be45e7",
                                                "sense_id": "1a76cce9-fa0b-3931-842b-8640131d35df",
                                                "text": "„In diesem Zusammenhang müssen wir aus übervollem Herzen ein Wort des Dankes und der Bewunderung an unsere wackeren Winzer richten, denen wir unser edelstes Teil verdanken: den Wein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c759168-16f4-4c86-8001-302468c4f779",
                        "source_entry_id": "6a80a245-3d54-3a3e-9c1c-ff2dd9b2a0fe",
                        "source_sense_id": "584bcdd8-5631-38ee-be57-ecd320a00409",
                        "source_sense_description": "Weinbau: der Winzer, der Weinbauer",
                        "target_lang_word": "Weinbauer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weinbauer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ba962af-5ac6-35a3-a01c-ba8b253b1168",
                                        "entry_id": "92896e25-4f9a-3737-b708-5b78ee3c52a8",
                                        "glosses": [
                                            "Person, die Wein beruflich an- und ausbaut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a64c782e-d51e-46f3-acb7-54f34c501dd5",
                                                "sense_id": "1ba962af-5ac6-35a3-a01c-ba8b253b1168",
                                                "text": "„Wilhelm Pfälzer war ein angesehener Weinbauer aus der Gegend, großgewachsen, um die Fünfzig, das schüttere Haar über die Glatze nach hinten gekämmt.“"
                                            },
                                            {
                                                "example_id": "82f6945d-d87c-4284-8d77-2c056047fac1",
                                                "sense_id": "1ba962af-5ac6-35a3-a01c-ba8b253b1168",
                                                "text": "„Blut und Wein - erst der Weinbauer dieses Landes ließ sie ganz zusammenfließen.“"
                                            },
                                            {
                                                "example_id": "ff287485-2cef-44ee-97d5-dc0a7b972784",
                                                "sense_id": "1ba962af-5ac6-35a3-a01c-ba8b253b1168",
                                                "text": "„Etwa 6000 Hektar wurden im 16. Jahrhundert von Weinbauern bewirtschaftet, und das Anbaugebiet erstreckte sich bis Wittenberg.“"
                                            },
                                            {
                                                "example_id": "d26c8210-21f8-4f7a-98ef-b3d36d67d4cc",
                                                "sense_id": "1ba962af-5ac6-35a3-a01c-ba8b253b1168",
                                                "text": "„Er sei eben »ein Franzos«, sagten einige in der Wirtschaft, wohlhabende Zecher und Weinbauern mit rot gedrechselten Nasen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
