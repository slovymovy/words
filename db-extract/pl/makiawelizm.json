                "senses": [
                    {
                        "sense_id": "18d533c1-9442-3f0a-af25-a86d5e84250f",
                        "entry_id": "4506a857-4344-3b54-a2f1-bf8f3d65bc24",
                        "glosses": [
                            "doktryna polityczna i strategia postępowania opisana przez Niccolò Machiavellego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d7aa75b-2ec2-4e21-8341-30d6ddcc1af2",
                                "sense_id": "18d533c1-9442-3f0a-af25-a86d5e84250f",
                                "text": "Tego polityka cechuje makiawelizm w najczystszej postaci."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "250b7d5c-e104-3b86-8d80-b885b70dbc50",
                        "entry_id": "4506a857-4344-3b54-a2f1-bf8f3d65bc24",
                        "glosses": [
                            "postawa cyniczna, obłudna, pozbawiona skrupułów; wiara w to, że cel uświęca środki"
                        ],
                        "tags": [
                            "psychology"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5df74be4-d96c-4cf9-901c-aa7d1fe73733",
                        "source_entry_id": "4506a857-4344-3b54-a2f1-bf8f3d65bc24",
                        "source_sense_id": "18d533c1-9442-3f0a-af25-a86d5e84250f",
                        "target_lang_word": "Machiavellianism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Machiavellianism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f01e8089-2fe3-360c-b446-333c0d932466",
                                        "entry_id": "0d2d5e7d-94d0-3282-bf1d-f680f15b90ae",
                                        "glosses": [
                                            "The political philosophy of Machiavelli, especially the realist doctrine which emphasizes the maintenance of the state above ethical concerns."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b6a3037-920f-4f97-bbce-497d25d85902",
                                                "sense_id": "f01e8089-2fe3-360c-b446-333c0d932466",
                                                "text": "\"Machiavellianism is a radical type of political realism that is applied to both domestic and international affairs.\""
                                            },
                                            {
                                                "example_id": "be2e1bf6-2860-4a2d-9d17-a06f18b9f5bf",
                                                "sense_id": "f01e8089-2fe3-360c-b446-333c0d932466",
                                                "text": "Let us turn, finally, to the war itself, and ask ourselves if it can be understood as the victory of decency over Machiavellianism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "535e22c3-c872-3d5c-989f-68dc4382aa62",
                                        "entry_id": "0d2d5e7d-94d0-3282-bf1d-f680f15b90ae",
                                        "glosses": [
                                            "A political maneuver that exemplifies the philosophy. Unsavory government politics."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "23fa69aa-309a-384f-a36d-48cf605cfe08",
                                        "entry_id": "0d2d5e7d-94d0-3282-bf1d-f680f15b90ae",
                                        "glosses": [
                                            "A psychological construct centered on interpersonal manipulation, lack of empathy, cold affect, and indifference to morality."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4d4a5f2-1ecf-4c3f-8ec5-8cc9ab2bdbbf",
                                                "sense_id": "23fa69aa-309a-384f-a36d-48cf605cfe08",
                                                "text": "Machiavellianism refers to interpersonal strategies that advocate self-interest, deception, and manipulation, so it would seem inherently related to core psychopathy and narcissism."
                                            },
                                            {
                                                "example_id": "8f169b8e-cb5a-493e-92f9-2a00bfa5fb08",
                                                "sense_id": "23fa69aa-309a-384f-a36d-48cf605cfe08",
                                                "text": "A cluster of dark personality traits named the “dark tetrad” (psychopathy, narcissism, Machiavellianism, sadism) has attracted the interest of researchers studying personality and decision making."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bfee8a5f-d4ef-49bd-8f4b-8611ff7647ec",
                        "source_entry_id": "4506a857-4344-3b54-a2f1-bf8f3d65bc24",
                        "source_sense_id": "18d533c1-9442-3f0a-af25-a86d5e84250f",
                        "target_lang_word": "Machiavellism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Machiavellism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a690bfbb-3202-3e68-8d01-209152358520",
                                        "entry_id": "279a82cd-a08f-3565-8797-b767f49a6ce3",
                                        "glosses": [
                                            "Machiavellianism"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "003045b8-afd9-4996-8f18-432057af4c0a",
                                                "sense_id": "a690bfbb-3202-3e68-8d01-209152358520",
                                                "text": "The theory and practice dealt with in this essay are all related to what I call Machiavellism, by which I mean the disregard of moral scruples in politics, that is, the political use, limited only by expediency, of every kind of deception and force."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7232cf2c-1fcc-429e-b1c8-05393a4ccd53",
                        "source_entry_id": "4506a857-4344-3b54-a2f1-bf8f3d65bc24",
                        "source_sense_id": "18d533c1-9442-3f0a-af25-a86d5e84250f",
                        "target_lang_word": "machiavélisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "machiavélisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "09e9078e-a801-329d-836b-047342a6f5ce",
                                        "entry_id": "54dca99e-21a7-3cec-9a25-ed8e63e94a6c",
                                        "glosses": [
                                            "Système politique de Nicolas Machiavel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d4e44b09-fa4c-313c-9bd4-e8afdb2059fc",
                                        "entry_id": "54dca99e-21a7-3cec-9a25-ed8e63e94a6c",
                                        "glosses": [
                                            "Principes et actions où il entre de la mauvaise foi, de la perfidie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8201830-08e1-4fa0-824f-d19a79420f5f",
                                                "sense_id": "d4e44b09-fa4c-313c-9bd4-e8afdb2059fc",
                                                "text": "À première vue, il semble bien chimérique de croire à un tel machiavélisme."
                                            },
                                            {
                                                "example_id": "2bd37334-5df7-4507-a5dc-fd7eb91eac11",
                                                "sense_id": "d4e44b09-fa4c-313c-9bd4-e8afdb2059fc",
                                                "text": "Toutes les ruses, il les imagine et les déploie avec un machiavélisme qui parfois lui pèse."
                                            },
                                            {
                                                "example_id": "e34d9d50-6745-4533-8e0a-c8c6428bd884",
                                                "sense_id": "d4e44b09-fa4c-313c-9bd4-e8afdb2059fc",
                                                "text": "Mais personne n’ose dire que le facteur central de l’histoire des années 1920-1939 fut purement et simplement l’incompétence technique des classes dirigeantes et des gouvernements occidentaux. Leurs opposants préfèrent croire au machiavélisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "550d63eb-af8f-4a5a-bd4b-285c3e4aa64e",
                        "source_entry_id": "4506a857-4344-3b54-a2f1-bf8f3d65bc24",
                        "source_sense_id": "18d533c1-9442-3f0a-af25-a86d5e84250f",
                        "target_lang_word": "Machiavellismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Machiavellismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4786feb4-36c5-37dd-a426-e60b77df0942",
                                        "entry_id": "495b7ef0-5c43-319c-b631-0d42dfc72091",
                                        "glosses": [
                                            "Lehre, die dem Machtinteresse den Vorrang gegenüber der Moral gibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d2fff7d-145f-4759-a76a-df93fda80679",
                                                "sense_id": "4786feb4-36c5-37dd-a426-e60b77df0942",
                                                "text": "„Aber der unverantwortliche Machiavellismus vieler Beteiligten sorgte dafür, daß es nicht bei halbwegs kontrollierbaren Rivalitäten blieb.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
