                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4eca4d41-bb01-4caa-b2e6-fde74545c728",
                                "sense_id": "8772784f-32da-30ad-9d2c-e59574e2eeae",
                                "text": "Замусорился сток, не иначе: вода не стекает."
                            }
                        ]
                    },
                    {
                        "sense_id": "bcd2dd03-b86a-3b38-a4a0-b817b081bac4",
