                        ],
                        "examples": [
                            {
                                "example_id": "3fafe924-3e5e-4c28-8672-ee09a16e7585",
                                "sense_id": "3eb9c0a0-d917-33d8-b6e7-25d8d2ad80fc",
                                "text": "В совокупности эти поправки должны существенно упростить возврат денег населению."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ad2f1b5-1b6a-3955-9ea2-b21668e492e5",
                        "entry_id": "7a885bb6-64f3-38df-8109-87e98dee7f72",
                        "glosses": [
                            "является важным, значимым"
                        ],
                        "tags": [
                            "в знач. сказуемого"
                        ],
                        "examples": [
                            {
                                "example_id": "307c8ed5-5e34-461f-9818-28397fcaf15a",
                                "sense_id": "0ad2f1b5-1b6a-3955-9ea2-b21668e492e5",
                                "text": "Для исследователей было очень существенно, что препарат не влияет на иммунную систему."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "45d89826-e9ac-48a3-8fc4-d258f430cb26",
                        "source_entry_id": "7a885bb6-64f3-38df-8109-87e98dee7f72",
