                "senses": [
                    {
                        "sense_id": "88fc3fb9-18e4-3773-a00b-467312255071",
                        "entry_id": "c0c02caa-f7cb-3844-867d-0684564ba59e",
                        "glosses": [
                            "Donner un caractère sauvage à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf05a74a-7cb6-4d27-a107-bc21024981a0",
                                "sense_id": "88fc3fb9-18e4-3773-a00b-467312255071",
                                "text": "Nous avons donc droit à un bel étalage de sévices musicaux assez barbares dans le fond et sadiques dans la forme, forme qui épouse les contours d’une sorte de Crossover salement velu de Crust métallisé et de Death sauvagifié."
                            },
                            {
                                "example_id": "cef94c8e-d3bf-44f4-9357-78bf8072360b",
                                "sense_id": "88fc3fb9-18e4-3773-a00b-467312255071",
                                "text": "Pour \"sauvagifier\" le SP77, il faut monter des lampes à haut gain en V3 et V4."
                            },
                            {
                                "example_id": "f435d6db-7aa9-4bd0-acf1-1aef9007c597",
                                "sense_id": "88fc3fb9-18e4-3773-a00b-467312255071",
                                "text": "le psychorigide est très difficile à sauvagifier sans dégâts."
                            },
                            {
                                "example_id": "64975b08-8738-4e97-886e-cb3bcd85c3f3",
                                "sense_id": "88fc3fb9-18e4-3773-a00b-467312255071",
                                "text": "On change de versant, on repasse par l'étage smog, puis, dré dans l'pentu, on rentre dans le dur, sur du sentier qui, enfin, se sauvagifie."
                            }
                        ]
                    }
