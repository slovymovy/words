{
    "word_family": [
        "tincture",
        "tint"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "15cc06ca-f337-3082-8b83-54e04f1575ad",
                    "sense_definition": "A small added amount of color or a slight trace of a quality or feeling.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "color_trace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sunset sky had a faint <w>tinge</w> of pink as the sun began to disappear.",
                            "target_lang_translations": {
                                "cs": "Obloha při západu slunce měla slabý <w>nádech</w> růžové, když slunce začalo mizet."
                            }
                        },
                        {
                            "text": "Her voice held a <w>tinge</w> of sadness when she spoke about her childhood home.",
                            "target_lang_translations": {
                                "cs": "V jejím hlase byl <w>nádech</w> smutku, když mluvila o svém domově z dětství."
                            }
                        }
                    ],
                    "synonyms": [
                        "tincture",
                        "cast"
                    ],
                    "common_phrases": [
                        "slight tinge"
                    ],
                    "target_lang_definitions": {
                        "cs": "Malé přidané množství barvy nebo slabý náznak určité vlastnosti či pocitu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "nádech",
                                "target_lang_sense_clarification": "slabý náznak barvy nebo vlastnosti"
                            },
                            {
                                "target_lang_word": "odstín",
                                "target_lang_sense_clarification": "jemná barevná odchylka"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7f3e7fc-78f5-325b-b394-573fb4c62aab",
                    "sense_definition": "The specific shade or degree of vividness of a color.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "color_trace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist carefully adjusted the <w>tinge</w> of the paint to match the ocean water.",
                            "target_lang_translations": {
                                "cs": "Umělec pečlivě upravil <w>odstín</w> barvy, aby odpovídal mořské vodě."
                            }
                        },
                        {
                            "text": "The chemical reaction caused the liquid to take on a deep yellow <w>tinge</w>.",
                            "target_lang_translations": {
                                "cs": "Chemická reakce způsobila, že kapalina získala sytě žlutý <w>nádech</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "teint"
                    ],
                    "target_lang_definitions": {
                        "cs": "Konkrétní odstín nebo stupeň sytosti barvy."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "odstín",
                                "target_lang_sense_clarification": "varianta základní barvy"
                            },
                            {
                                "target_lang_word": "tón",
                                "target_lang_sense_clarification": "barevná nuance"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fbe5424b-e037-3b78-9aeb-cbf4f92d5220",
                    "sense_definition": "To add a small amount of color or a slight quality to something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "color_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The setting sun <w>tinged</w> the clouds with brilliant shades of orange and purple.",
                            "target_lang_translations": {
                                "cs": "Zapadající slunce <w>obarvilo</w> mraky zářivými odstíny oranžové a fialové."
                            }
                        },
                        {
                            "text": "A drop of ink <w>tinged</w> the clear water with a swirl of blue.",
                            "target_lang_translations": {
                                "cs": "Kapka inkoustu <w>obarvila</w> čistou vodu modrým vírem."
                            }
                        }
                    ],
                    "synonyms": [
                        "tinct"
                    ],
                    "target_lang_definitions": {
                        "cs": "Dodat něčemu malé množství barvy nebo slabou vlastnost."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "obarvit",
                                "target_lang_sense_clarification": "dodat barvu"
                            },
                            {
                                "target_lang_word": "dodat nádech",
                                "target_lang_sense_clarification": "lehce ovlivnit vzhled nebo charakter"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1fe6a34c-b7b3-3aa4-944d-6aa7bbb56c2c",
                    "sense_definition": "To influence or affect something slightly with a particular quality or emotion.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His excitement was <w>tinged</w> with anxiety about the upcoming presentation.",
                            "target_lang_translations": {
                                "cs": "Jeho nadšení bylo <w>poznamenáno</w> úzkostí z nadcházející prezentace."
                            }
                        },
                        {
                            "text": "The political debate was <w>tinged</w> with personal attacks from both sides.",
                            "target_lang_translations": {
                                "cs": "Politická debata byla <w>poznamenána</w> osobními útoky z obou stran."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tinged with"
                    ],
                    "target_lang_definitions": {
                        "cs": "Mírně ovlivnit nebo poznamenat něco určitou vlastností či emocí."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "poznamenat",
                                "target_lang_sense_clarification": "ovlivnit určitým rysem"
                            },
                            {
                                "target_lang_word": "dodat nádech",
                                "target_lang_sense_clarification": "lehce zabarvit emočně"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2bc8507c-e7e0-3346-bf40-9866f9fe119a",
                    "sense_definition": "To change slightly in shade or quality due to an external addition.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "color_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old photograph had <w>tinged</w> to a sepia tone over many decades.",
                            "target_lang_translations": {
                                "cs": "Stará fotografie během mnoha desetiletí <w>získala</w> sépiový nádech."
                            }
                        },
                        {
                            "text": "The metal surface <w>tinged</w> slightly after being exposed to the humid air.",
                            "target_lang_translations": {
                                "cs": "Kovový povrch po vystavení vlhkému vzduchu mírně <w>změnil odstín</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Mírně změnit odstín nebo kvalitu v důsledku vnějšího vlivu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "získat nádech",
                                "target_lang_sense_clarification": "změnit barvu vlivem času či prostředí"
                            },
                            {
                                "target_lang_word": "změnit odstín",
                                "target_lang_sense_clarification": "barevná proměna"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}