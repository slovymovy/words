{
    "word_family": [
        "hang",
        "hanger",
        "hangman",
        "hangover",
        "hangout",
        "overhang"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "59031dcd-d775-3bd3-87dd-acb968761bff",
                    "sense_definition": "The present participle of the verb <w>hang</w>, used to describe an action in progress or a state of suspension.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "suspension_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>hanging</w> the wet clothes on the line to dry.",
                            "target_lang_translations": {
                                "ru": "Она <w>вешает</w> мокрую одежду на веревку, чтобы высушить.",
                                "zh": "她正在把湿衣服<w>挂</w>在绳子上晾干。"
                            }
                        },
                        {
                            "text": "We were just <w>hanging</w> around the park waiting for our friends.",
                            "target_lang_translations": {
                                "ru": "Мы просто <w>болтались</w> в парке, ожидая наших друзей.",
                                "zh": "我们只是在公园里<w>闲逛</w>，等着我们的朋友。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени от глагола \"hang\", используемое для описания действия в процессе или состояния подвешенности.",
                        "zh": "动词 hang 的现在分词，用于描述正在进行的行为或悬挂的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вися́щий",
                                "target_lang_sense_clarification": "находящийся в висячем положении"
                            },
                            {
                                "target_lang_word": "вешающий",
                                "target_lang_sense_clarification": "совершающий действие по развешиванию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挂",
                                "target_lang_sense_clarification": "悬挂或放置物品"
                            },
                            {
                                "target_lang_word": "闲逛",
                                "target_lang_sense_clarification": "无所事事地待着"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "130c4f8f-5229-3917-b0f8-a936d91c6fc8",
                    "sense_definition": "Suspended from above with no support from below.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "suspension_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>hanging</w> baskets on the porch are full of beautiful red flowers.",
                            "target_lang_translations": {
                                "ru": "<w>Подвесные</w> корзины на крыльце полны красивых красных цветов.",
                                "zh": "门廊上的<w>吊</w>篮里开满了美丽的红花。"
                            }
                        },
                        {
                            "text": "Be careful not to hit your head on the <w>hanging</w> lights in the hallway.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, не ударься головой о <w>висячие</w> светильники в коридоре.",
                                "zh": "小心别让走廊里<w>悬挂的</w>灯撞到头。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hanging basket",
                        "hanging garden",
                        "hanging valley"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подвешенный сверху, не имеющий опоры снизу.",
                        "zh": "从上方悬挂，下方没有支撑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вися́чий",
                                "target_lang_sense_clarification": "свисающий вниз"
                            },
                            {
                                "target_lang_word": "подвесной",
                                "target_lang_sense_clarification": "прикрепленный к чему-либо сверху"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "悬挂的",
                                "target_lang_sense_clarification": "处于悬空状态的"
                            },
                            {
                                "target_lang_word": "吊",
                                "target_lang_sense_clarification": "悬挂在空中的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dad6fd60-1cb6-30d3-92bd-0306fd0e1d1d",
                    "sense_definition": "Extremely unattractive, ugly, or disgusting.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am not going out with him because his behavior is absolutely <w>hanging</w>.",
                            "target_lang_translations": {
                                "ru": "Я не пойду с ним гулять, потому что его поведение абсолютно <w>мерзкое</w>.",
                                "zh": "我不会和他出去，因为他的行为简直太<w>恶心</w>了。"
                            }
                        },
                        {
                            "text": "That old sofa looks <w>hanging</w> and needs to be thrown away immediately.",
                            "target_lang_translations": {
                                "ru": "Этот старый диван выглядит <w>ужасно</w> и его нужно немедленно выбросить.",
                                "zh": "那张旧沙发看起来太<w>糟糕</w>了，得赶紧扔掉。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "British"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Крайне непривлекательный, уродливый или отвратительный.",
                        "zh": "极其不吸引人、丑陋或令人作呕。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мерзкий",
                                "target_lang_sense_clarification": "вызывающий отвращение"
                            },
                            {
                                "target_lang_word": "отстойный",
                                "target_lang_sense_clarification": "очень плохой (слэнг)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "恶心",
                                "target_lang_sense_clarification": "令人厌恶的"
                            },
                            {
                                "target_lang_word": "糟糕",
                                "target_lang_sense_clarification": "非常差劲的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "283c7abc-9dc9-3221-8006-1f979ae48e15",
                    "sense_definition": "The act of killing a person by suspending them by the neck with a rope.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge sentenced the criminal to death by <w>hanging</w> for his crimes.",
                            "target_lang_translations": {
                                "ru": "Судья приговорил преступника к смертной казни через <w>повешение</w> за его преступления.",
                                "zh": "法官因其罪行判处该罪犯<w>绞刑</w>。"
                            }
                        },
                        {
                            "text": "Public <w>hanging</w> was a common form of punishment in previous centuries.",
                            "target_lang_translations": {
                                "ru": "Публичное <w>повешение</w> было распространенной формой наказания в прошлые века.",
                                "zh": "公开<w>绞刑</w>在过去几个世纪是一种常见的惩罚方式。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "death by hanging",
                        "public hanging"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт лишения человека жизни путем подвешивания за шею в петле.",
                        "zh": "通过用绳子套住脖子将人吊起而处死的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пове́шение",
                                "target_lang_sense_clarification": "вид смертной казни"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "绞刑",
                                "target_lang_sense_clarification": "一种死刑方式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f3ca4d9-7c30-30a2-9e41-f49ad8e93916",
                    "sense_definition": "A decorative object, such as a curtain or tapestry, that is draped or suspended on a wall.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "suspension_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The large wall <w>hanging</w> made the stone room feel much warmer and cozier.",
                            "target_lang_translations": {
                                "ru": "Большой настенный <w>гобелен</w> делал каменную комнату намного теплее и уютнее.",
                                "zh": "那块巨大的<w>挂毯</w>让石屋感觉温暖舒适多了。"
                            }
                        },
                        {
                            "text": "She bought some embroidered silk <w>hangings</w> to decorate the entrance hall.",
                            "target_lang_translations": {
                                "ru": "Она купила несколько вышитых шелковых <w>драпировок</w>, чтобы украсить прихожую.",
                                "zh": "她买了一些丝绸刺绣<w>壁挂</w>来装饰门厅。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wall hanging"
                    ],
                    "target_lang_definitions": {
                        "ru": "Декоративный предмет, такой как занавес или гобелен, повешенный на стену.",
                        "zh": "装饰性物品，如窗帘或挂毯，悬挂在墙上。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гобеле́н",
                                "target_lang_sense_clarification": "стенной ковер с изображением"
                            },
                            {
                                "target_lang_word": "драпиро́вка",
                                "target_lang_sense_clarification": "декоративная ткань, уложенная складками"
                            },
                            {
                                "target_lang_word": "настенное панно",
                                "target_lang_sense_clarification": "украшение на стену"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挂毯",
                                "target_lang_sense_clarification": "墙上的装饰织物"
                            },
                            {
                                "target_lang_word": "壁挂",
                                "target_lang_sense_clarification": "墙上的装饰品"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}