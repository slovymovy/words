                        "examples": [
                            {
                                "example_id": "743c436f-1df8-4b34-8494-cf1adf9434a1",
                                "sense_id": "0ed1619f-946e-34f9-b827-1d770e7e97b4",
                                "text": "Überschwänglichkeiten waren nie ihre Sache gewesen."
                            }
                        ],
                        "sense_index_json": "\"2\""
