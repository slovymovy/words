                                "example_id": "a7e733d4-3a69-4814-85d0-b3d50364efce",
                                "sense_id": "87883ee3-af47-3278-8f46-5a2cd9473af8",
                                "text": "You cannot enter the hall without a ticket."
                            }
                        ]
