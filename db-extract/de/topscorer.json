                "senses": [
                    {
                        "sense_id": "421808fe-49a1-3568-9674-774fe6dbe77d",
                        "entry_id": "3e0400b9-2d7c-37c6-980a-1d16c1b30278",
                        "glosses": [
                            "Sportler, der innerhalb eines Wettbewerbs oder einer Mannschaft zusammengerechnet am meisten Punkte/Tore/Torvorlagen oder Ähnliches hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf7e365a-fa1a-4f10-90fd-47d8f1c81328",
                                "sense_id": "421808fe-49a1-3568-9674-774fe6dbe77d",
                                "text": "„Er war bei der Weltmeisterschaft 1978 in Prag und beim Olympiaturnier 1984 in Sarajevo jeweils Topscorer und hält in der Eishockey-Bundesliga, die heute Deutsche Eishockey-Liga heißt, immer noch zahlreiche Rekorde.“"
                            },
                            {
                                "example_id": "07aadd9f-1889-4771-8491-dbe5ee0c7431",
                                "sense_id": "421808fe-49a1-3568-9674-774fe6dbe77d",
                                "text": "„Die USA müssen bei den Olympischen Spielen in Rio de Janeiro auf einen weiteren NBA-Star verzichten. Stephen Curry, der aktuell in der Finalserie der nordamerikanischen Basketballliga spielende Topscorer der Golden State Warriors, sagte am Montagabend seine Teilnahme ab.“"
                            },
                            {
                                "example_id": "dc4910e3-1556-4864-9baa-48cd7ac7da13",
                                "sense_id": "421808fe-49a1-3568-9674-774fe6dbe77d",
                                "text": "„In der 28. Minute spielte Gladbachs Topscorer Raffael einen Pass in die Tiefe auf Fabian Johnson, der im Strafraum im Fallen zum Schuss kam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
