                ],
                "senses": [
                    {
                        "sense_id": "ed3811d2-493b-3543-9584-9e25d0dc0fb7",
                        "entry_id": "342dfabb-b77d-3650-91ff-7c495f7f5705",
                        "glosses": [
                            "ohne Sonnenschein, keinen Sonnenschein aufweisend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dbec8e9-ebec-4a21-b017-723e85613399",
                                "sense_id": "ed3811d2-493b-3543-9584-9e25d0dc0fb7",
                                "text": "„Er ließ den Kopf in den Nacken fallen und jaulte hinauf in den blauen, sonnenlosen Himmel.“"
                            },
                            {
                                "example_id": "606ddd23-d9e0-429c-9a63-78205198ed6e",
                                "sense_id": "ed3811d2-493b-3543-9584-9e25d0dc0fb7",
                                "text": "„In einem Steinkreis auf dem schmierigen, sonnenlosen Lehm brannte ein Feuer; ein alter Mann hockte davor.“"
                            },
                            {
                                "example_id": "2536d354-1a06-44af-9b4a-15ddfde8604d",
                                "sense_id": "ed3811d2-493b-3543-9584-9e25d0dc0fb7",
                                "text": "„Sir Roderick lernte die sonnenlosen Gärten und in die Höhe strebenden Eiben zu lieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b7e41db-aa3e-4ad0-831b-08d08af84a07",
                        "source_entry_id": "342dfabb-b77d-3650-91ff-7c495f7f5705",
