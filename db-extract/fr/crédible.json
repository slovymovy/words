        "fr-extract.jsonl": [
            {
                "entry_id": "62abf8a0-ee4c-340e-9e0a-357effdf0a21",
                "word": "crédible",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7e1777c8-9817-4211-bfb2-e27aaffe3e3d",
                        "entry_id": "62abf8a0-ee4c-340e-9e0a-357effdf0a21",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "crédibles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bdff62da-5595-3de3-8fe8-b139788a0c74",
                        "entry_id": "62abf8a0-ee4c-340e-9e0a-357effdf0a21",
                        "glosses": [
                            "Qu’on peut croire ; à qui on peut se fier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af27005c-1b67-479d-aefc-b74b82eee3f4",
                                "sense_id": "bdff62da-5595-3de3-8fe8-b139788a0c74",
                                "text": "Dans un rapport très attendu sur la région chinoise du Xinjiang publié mercredi, l’ONU a évoqué de possibles « crimes contre l’humanité » et fait état de « preuves crédibles » de tortures et de violences sexuelles à l’égard de la minorité ouïgoure."
                            }
                        ]
                    },
                    {
                        "sense_id": "ec9e5318-519c-32c2-888d-fe6dc35c41a5",
                        "entry_id": "62abf8a0-ee4c-340e-9e0a-357effdf0a21",
                        "glosses": [
                            "Qui est vraisemblable ; qui a l’apparence de la réalité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8482a13-03cd-41bc-bfd9-facf5ec37628",
                                "sense_id": "ec9e5318-519c-32c2-888d-fe6dc35c41a5",
                                "text": "Et puis il y a Tanya. Elle est jolie Tanya. Pas crédible ni talentueuse mais jolie. Et en peau de bête. Tout le temps. Et puis parfois elle est nue."
                            },
                            {
                                "example_id": "181dbea0-a2ec-483d-9b2f-705e9e6b6f09",
                                "sense_id": "ec9e5318-519c-32c2-888d-fe6dc35c41a5",
                                "text": "Totalement crédible en Marylin Monroe, elle pourrait même décrocher un Oscar pour sa performance dans cette adaptation du best-seller de Joyce Caroll Oates."
                            },
                            {
                                "example_id": "48ab79f4-966e-4646-9a3e-ca9f45779481",
                                "sense_id": "ec9e5318-519c-32c2-888d-fe6dc35c41a5",
                                "text": "Une nouvelle trajectoire budgétaire « crédible » doit être présentée en septembre à la Commission européenne, qui a ouvert une procédure de déficit excessif visant la France, l’entêtement des gouvernements macronistes à ne pas augmenter les impôts ayant conduit à un dérapage des finances publiques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6aee28f4-6252-4d87-8b26-20421be9be93",
                        "source_entry_id": "62abf8a0-ee4c-340e-9e0a-357effdf0a21",
                        "target_lang_word": "glaubwürdig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glaubwürdig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4f0af104-4372-3ca9-aee7-d961824e7208",
                                        "entry_id": "6bfd2ff1-9aaf-3e06-94fe-a8f7c9bde5ea",
                                        "glosses": [
                                            "so, dass man ihm glauben kann"
                                        ],
                                        "tags": [
                                            "von Personen oder Berichten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c72a22f6-2da8-44a8-81e6-5ca261e77180",
                                                "sense_id": "4f0af104-4372-3ca9-aee7-d961824e7208",
                                                "text": "Die Aussagen der Nachbarin schienen dem Polizisten wenig glaubwürdig."
                                            },
                                            {
                                                "example_id": "f2970fbf-0899-45fc-857d-96497823cbed",
                                                "sense_id": "4f0af104-4372-3ca9-aee7-d961824e7208",
                                                "text": "John Harrison, ein Assistenzprofessor an der S. Rajaratnam School of International Studies in Singapur, hält die Terrorwarnung für glaubwürdig."
                                            },
                                            {
                                                "example_id": "5a0603e9-5977-44f1-96f3-6a8b36ff756b",
                                                "sense_id": "4f0af104-4372-3ca9-aee7-d961824e7208",
                                                "text": "Der Angriff habe laut dem US-Militär allerdings auf glaubwürdigen Geheimdienstinformationen basiert und sei lediglich ein Akt der Selbstverteidigung gewesen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32a29b5e-1f73-4e8b-8f88-87ea038623fa",
                        "source_entry_id": "62abf8a0-ee4c-340e-9e0a-357effdf0a21",
                        "target_lang_word": "believable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "believable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e98a564-38ea-3325-84e5-5b20414e99d8",
                                        "entry_id": "fe213c1c-dc6e-31ce-8c8d-f20215a4d229",
                                        "glosses": [
                                            "Capable of being believed; credible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b892aa8-5937-4d07-b0ec-9f589f7cbb73",
                                                "sense_id": "5e98a564-38ea-3325-84e5-5b20414e99d8",
                                                "text": "believable answer"
                                            },
                                            {
                                                "example_id": "a79cc55a-6097-45eb-8a00-860dd58ec1cb",
                                                "sense_id": "5e98a564-38ea-3325-84e5-5b20414e99d8",
                                                "text": "believable account"
                                            },
                                            {
                                                "example_id": "d9eeac40-a63d-4237-8284-ff9e11b53cf6",
                                                "sense_id": "5e98a564-38ea-3325-84e5-5b20414e99d8",
                                                "text": "believable story"
                                            },
                                            {
                                                "example_id": "4d23765b-6d2e-4948-913c-ff69585754bf",
                                                "sense_id": "5e98a564-38ea-3325-84e5-5b20414e99d8",
                                                "text": "So far as cartoons are concerned these days, nothing—not even sewage works—is sacred, and everything is thereby readabler and believabler."
                                            },
                                            {
                                                "example_id": "7a1ec15b-2bad-44c9-85df-b7713f873281",
                                                "sense_id": "5e98a564-38ea-3325-84e5-5b20414e99d8",
                                                "text": "Blanche’s quavering voice and fluttering hands are indispensable elements that make it easy for her to be played in a pat and stiff manner, but Fischer has tapped deeper qualities in this acutely neurotic but tragic antiheroine to make her not only believabler, but sympathetic as well."
                                            },
                                            {
                                                "example_id": "b26f0022-b023-4273-9552-a7cd74164f12",
                                                "sense_id": "5e98a564-38ea-3325-84e5-5b20414e99d8",
                                                "text": "Like Dr Crane, I too dreamt of the day when I might see my name staring back at me in Easons, and it’s scarcely believable that the day has come. Even scarcerly believabler is the way it came about."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "472a0b7f-572c-4b16-a721-e82bfd63ad3f",
                        "source_entry_id": "62abf8a0-ee4c-340e-9e0a-357effdf0a21",
