                        ],
                        "form": "отпря́нувши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3e09764a-cb98-3e07-96c9-79bd292070e2",
                        "entry_id": "46cce991-c09e-3b85-acbd-c0f88f347727",
                        "glosses": [
                            "быстрым, резким движением отодвинуться, отклониться, отскочить от кого-либо, чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa065be8-f6ce-4b13-a2be-23949202ee21",
                                "sense_id": "3e09764a-cb98-3e07-96c9-79bd292070e2",
                                "text": "Лота едва сдержалась, чтобы не отпрянуть."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5cd5c92e-9d75-42a3-9d97-a942d3323e6e",
                        "source_entry_id": "46cce991-c09e-3b85-acbd-c0f88f347727",
                        "source_sense_id": "3e09764a-cb98-3e07-96c9-79bd292070e2",
                        "target_lang_word": "reculer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reculer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d0870c2-779a-3078-b75a-480705608afb",
                                        "entry_id": "6eaaa168-50bb-334c-96a9-9a978bf44782",
                                        "glosses": [
                                            "Tirer ou pousser un objet en arrière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b539d44-242b-45ee-bee7-ba6758a6afa9",
                                                "sense_id": "9d0870c2-779a-3078-b75a-480705608afb",
                                                "text": "Reculez un peu votre chaise."
                                            },
                                            {
                                                "example_id": "32716574-5ee0-47c1-b65d-45fa5a51d946",
                                                "sense_id": "9d0870c2-779a-3078-b75a-480705608afb",
                                                "text": "Reculez la table."
                                            },
                                            {
                                                "example_id": "88e8273a-f83a-4683-b45a-d0545f3623d1",
                                                "sense_id": "9d0870c2-779a-3078-b75a-480705608afb",
                                                "text": "Reculez-vous de là."
                                            },
                                            {
                                                "example_id": "8d33a4ef-59a9-4a58-9310-ae2ce2e39c56",
                                                "sense_id": "9d0870c2-779a-3078-b75a-480705608afb",
                                                "text": "Il se recula bien loin d’eux."
                                            },
                                            {
                                                "example_id": "5278aaa1-1bf8-4fa7-b0ab-e5493d6a2e6c",
                                                "sense_id": "9d0870c2-779a-3078-b75a-480705608afb",
                                                "text": "Reculer une muraille, une haie, un fossé Les reporter plus loin."
                                            },
                                            {
                                                "example_id": "a9e4ac74-8c6c-4019-80e0-fdc554cc18d2",
                                                "sense_id": "9d0870c2-779a-3078-b75a-480705608afb",
                                                "text": "Il faut reculer de deux mètres cette muraille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f56392c6-35e2-3add-911b-1dae24bf5f59",
                                        "entry_id": "6eaaa168-50bb-334c-96a9-9a978bf44782",
                                        "glosses": [
                                            "Porter plus loin, déplacer les limites, les frontières."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebcdc77e-2479-4d58-b549-4b5ae05a3f3e",
                                                "sense_id": "f56392c6-35e2-3add-911b-1dae24bf5f59",
                                                "text": "— Mais nous sommes déjà dans les faubourgs. Les maisons s'espacent, se reculent, s'adossent à la rivière ou à la montagne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a622661b-cc63-3acf-8766-3e67fddf1e33",
                                        "entry_id": "6eaaa168-50bb-334c-96a9-9a978bf44782",
                                        "glosses": [
                                            "Éloigner quelqu’un du but qu’il se propose, retarder, ajourner une affaire."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "314ed33b-317b-4943-ad3b-01b4b46c8ca4",
                                                "sense_id": "a622661b-cc63-3acf-8766-3e67fddf1e33",
                                                "text": "Nous reculons dans le temps d'une République. Nous sommes sous la Troisième qui tire à sa fin. M. Albert Lebrun en est le président."
                                            },
                                            {
                                                "example_id": "0f37a38d-2a1c-43fa-b133-662e39b8e57f",
                                                "sense_id": "a622661b-cc63-3acf-8766-3e67fddf1e33",
                                                "text": "Cet événement a fort reculé ses projets, a reculé ses affaires, l’a fort reculé."
                                            },
                                            {
                                                "example_id": "884412f2-edda-48a7-b960-3f10095f60a1",
                                                "sense_id": "a622661b-cc63-3acf-8766-3e67fddf1e33",
                                                "text": "L’odeur poisseuse, l’aspect désespéré du lieu le reculèrent jusqu’à penser qu’il eût aussi bien pu pousser la porte, là-haut, et de pied ferme attendre le jeune homme dans la chambre."
                                            },
                                            {
                                                "example_id": "048eda4e-9a37-40da-a9b6-a47b2ce04e1e",
                                                "sense_id": "a622661b-cc63-3acf-8766-3e67fddf1e33",
                                                "text": "Ce succès recula sa perte."
                                            },
                                            {
                                                "example_id": "b3efed55-ef2d-4228-80c0-3285cdbd43a8",
                                                "sense_id": "a622661b-cc63-3acf-8766-3e67fddf1e33",
                                                "text": "Il a reculé ses paiements de six mois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f39827a-5991-3cd7-b1b4-ccda3be31a30",
                                        "entry_id": "6eaaa168-50bb-334c-96a9-9a978bf44782",
                                        "glosses": [
                                            "Sodomiser de nouveau."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b954ebe-8164-49a4-af28-40c11d21366a",
                                                "sense_id": "2f39827a-5991-3cd7-b1b4-ccda3be31a30",
                                                "text": "Jamais ils n’ont rien enculé, reculé, basculé, masculé, rien du tout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcfdb85e-8187-3260-8976-93bc60e869d3",
                                        "entry_id": "6eaaa168-50bb-334c-96a9-9a978bf44782",
                                        "glosses": [
                                            "Aller en arrière."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc5d64a3-5129-42f5-b0d8-47f254aa4bfc",
                                                "sense_id": "dcfdb85e-8187-3260-8976-93bc60e869d3",
                                                "text": "Pour arrêter le cheval étant au pas, au trot ou au galop […] et même pour reculer, la tension des rênes, la pression des jambes, la position des mains et des jambes sont les mêmes, c’est-à-dire que les mains doivent être à la même hauteur et les jambes également en arrière."
                                            },
                                            {
                                                "example_id": "9f9484bf-1069-4fe0-bff4-f073facde6b3",
                                                "sense_id": "dcfdb85e-8187-3260-8976-93bc60e869d3",
                                                "text": "Aussitôt l’intrus recula, baissa les yeux et, relevant les pans de sa pèlerine, affecta de se chauffer."
                                            },
                                            {
                                                "example_id": "0b535ece-eacd-4d80-939e-bb1482b02d0b",
                                                "sense_id": "dcfdb85e-8187-3260-8976-93bc60e869d3",
                                                "text": "Recule vite, cherche le dur, le sec, ou tu es perdu. Tu croira t’échapper en avançant […] Tu t’enfonces davantage […]"
                                            },
                                            {
                                                "example_id": "9d47fce8-a805-4e8a-aabf-d298ab29a2a0",
                                                "sense_id": "dcfdb85e-8187-3260-8976-93bc60e869d3",
                                                "text": "Toujours positionnés sur leur ligne, les héros ne reculent jamais devant l'ennemi. Entre le 23 et le 25 mai 1940, le 6ᵉ RSA perd 99 spahis à Sy, parmi lesquels figurent des tués tels que Saïd Ben Dechina, Mohamed Djoudi, les admirables Hamadi et Lambarek..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a630fac3-375c-3c22-9a04-69b75c8cf717",
                                        "entry_id": "6eaaa168-50bb-334c-96a9-9a978bf44782",
                                        "glosses": [
                                            "Régresser, en parlant des affaires et des personnes."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e254abf-9649-449f-9ed2-7405d8e4ee8e",
                                                "sense_id": "a630fac3-375c-3c22-9a04-69b75c8cf717",
                                                "text": "Ce sont eux qui, dans l'élevage gâtineau, tiennent la vedette et la tiendront jusqu'au jour où les perfectionnements apportés aux méthodes culturales les feront reculer au point d'en amener la quasi-disparition."
                                            },
                                            {
                                                "example_id": "a07ef0da-cfb0-4c08-a691-82d934fdefa1",
                                                "sense_id": "a630fac3-375c-3c22-9a04-69b75c8cf717",
                                                "text": "Vos affaires reculent au lieu d’avancer. — Souvent c’est reculer que de ne point avancer."
                                            },
                                            {
                                                "example_id": "6257b31d-3835-4dc6-83b1-8ee98a02793f",
                                                "sense_id": "a630fac3-375c-3c22-9a04-69b75c8cf717",
                                                "text": "Il est trop avancé pour reculer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fe2857f-5ede-3aa1-af28-e8d81c901b32",
                                        "entry_id": "6eaaa168-50bb-334c-96a9-9a978bf44782",
                                        "glosses": [
                                            "Ne pas soutenir avec fermeté ses droits, ses opinions."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed88838e-6e3f-493f-8def-2ecad0df9e73",
                                                "sense_id": "5fe2857f-5ede-3aa1-af28-e8d81c901b32",
                                                "text": "Il aimerait mieux se faire tuer que de reculer."
                                            },
                                            {
                                                "example_id": "41622503-e8ee-4e5a-befc-cc130b593f43",
                                                "sense_id": "5fe2857f-5ede-3aa1-af28-e8d81c901b32",
                                                "text": "Cinquante francs d'amende par exemplaire saisi, c'est de quoi faire reculer les plus intrépides."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d225c75-ecd6-3634-ad0f-464c71094006",
                                        "entry_id": "6eaaa168-50bb-334c-96a9-9a978bf44782",
                                        "glosses": [
                                            "Différer, éviter de faire quelque chose qu’on exige ou qu’on désire de nous."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55160116-c6d8-4dfd-b2b2-8e942aba2502",
                                                "sense_id": "6d225c75-ecd6-3634-ad0f-464c71094006",
                                                "text": "Eh! bien, ne reculant devant aucune tâche si fastidieuse fût-elle, ils pourvoiront, d'eux-mêmes, à la diffusion de ces ouvrages, en s'en faisant les traducteurs."
                                            },
                                            {
                                                "example_id": "be61a1f2-4893-4c2d-9a7d-edb2dc71cb34",
                                                "sense_id": "6d225c75-ecd6-3634-ad0f-464c71094006",
                                                "text": "Je voudrais qu’il me rendît ses comptes, mais il recule toujours."
                                            },
                                            {
                                                "example_id": "f48c0623-78df-44dd-80c5-bddb56f5718a",
                                                "sense_id": "6d225c75-ecd6-3634-ad0f-464c71094006",
                                                "text": "Il n’y a plus moyen de reculer."
                                            },
                                            {
                                                "example_id": "4cafbdbd-0a91-4920-a88d-6e1f27f76686",
                                                "sense_id": "6d225c75-ecd6-3634-ad0f-464c71094006",
                                                "text": "Je l’ai tellement pressé, qu’il ne peut plus reculer."
                                            },
                                            {
                                                "example_id": "a3b81eea-93df-41f6-8163-0c70ac307758",
                                                "sense_id": "6d225c75-ecd6-3634-ad0f-464c71094006",
                                                "text": "Quelque proposition que vous lui fassiez, il est homme à ne pas reculer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5cc480d2-bd62-4e30-9a71-6048072abe75",
                        "source_entry_id": "46cce991-c09e-3b85-acbd-c0f88f347727",
                        "source_sense_id": "3e09764a-cb98-3e07-96c9-79bd292070e2",
                        "target_lang_word": "se dérober",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "se dérober",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a8a39e8-a91f-39f1-acaa-d74d1053fb29",
                                        "entry_id": "6ba14962-ab28-38f3-a55e-97314054517d",
                                        "glosses": [
                                            "Se soustraire à quelque chose de déplaisant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6af3fc64-10ad-426e-a412-7d0a24a84b57",
                                                "sense_id": "7a8a39e8-a91f-39f1-acaa-d74d1053fb29",
                                                "text": "La Galiana, idolâtrée par son père, vivait le plus agréablement du monde dans cette charmante retraite, s’occupant de musique, de poésie et de danse. Son travail le plus pénible était de se dérober aux galanteries et aux adorations de ses poursuivants."
                                            },
                                            {
                                                "example_id": "40117d81-2702-4c15-bb5b-d0054a272742",
                                                "sense_id": "7a8a39e8-a91f-39f1-acaa-d74d1053fb29",
                                                "text": "Plus le pouvoir se dérobe sur de tels sujets essentiels et plus il devient envahissant sur les questions accessoires."
                                            },
                                            {
                                                "example_id": "554aa34c-71b6-4a6f-affd-b6807b1df4bf",
                                                "sense_id": "7a8a39e8-a91f-39f1-acaa-d74d1053fb29",
                                                "text": "Les causes de ce phénomène se dérobent à l’intelligence humaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcab722a-3a02-30cd-adc4-df63196f3776",
                                        "entry_id": "6ba14962-ab28-38f3-a55e-97314054517d",
                                        "glosses": [
                                            "Se retirer d’une compagnie sans dire mot, sans être aperçu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a31706d2-a1a9-49dc-b7a7-ac5d280fcc8c",
                                                "sense_id": "dcab722a-3a02-30cd-adc4-df63196f3776",
                                                "text": "Se dérober à la discussion."
                                            },
                                            {
                                                "example_id": "11838fe0-dac5-4384-9bf1-bdf84eb2c600",
                                                "sense_id": "dcab722a-3a02-30cd-adc4-df63196f3776",
                                                "text": "Se dérober pour ne pas fumer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c9fda23-ae03-3426-b892-62a891b9ad3f",
                                        "entry_id": "6ba14962-ab28-38f3-a55e-97314054517d",
                                        "glosses": [
                                            "Échapper volontairement à la discussion, la fuir ou esquiver une difficulté."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbbee8ee-59a9-4307-93c7-3ca12eb720f3",
                                                "sense_id": "4c9fda23-ae03-3426-b892-62a891b9ad3f",
                                                "text": "— Midi ! interrompit le chevalier qui tressaillit. Mais je suis attendu aujourd'hui à midi, à l'hôtellerie des Trois-Monarques par ce jeune faquin qui s'appelle le marquis de Cinq-Mars. Il va croire que je me dérobe ! Mordieu ! Cogolin, ma rapière, mon cheval !"
                                            },
                                            {
                                                "example_id": "ba2ef79e-9db7-414f-9a9e-1559dd245f44",
                                                "sense_id": "4c9fda23-ae03-3426-b892-62a891b9ad3f",
                                                "text": "« Tu te dérobes ? » Tout est là, dans ce « tu te dérobes ? » à cause d’un tee-shirt. Dramatiser ce qui n’a aucun sens. « Tu te dérobes ? » Tout un code social qui accompagnait ces quelques lettres : appartenance, force du groupe, crainte de la disgrâce. « Tu te dérobes ? » Pas du Bruant, ni du Poulbot, mais la langue des aristos de la rue. Mes Guermantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7e4919f-493b-314d-afd0-043db52ceb99",
                                        "entry_id": "6ba14962-ab28-38f3-a55e-97314054517d",
                                        "glosses": [
                                            "S’échapper de dessous celui qui le monte, tout à coup, par un mouvement irrégulier, en parlant d’un cheval."
                                        ],
                                        "tags": [
                                            "Manège"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2c22852-790b-4457-835c-5a722b9a5b14",
                                                "sense_id": "d7e4919f-493b-314d-afd0-043db52ceb99",
                                                "text": "Ce cheval se dérobe de dessous son cavalier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4d86d4e-8bff-32de-b7ff-4f55977d309c",
                                        "entry_id": "6ba14962-ab28-38f3-a55e-97314054517d",
                                        "glosses": [
                                            "Vaciller, en peinant à soutenir, en parlant des jambes."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b90abf9c-a1ca-4bca-838e-aa5eb774854c",
                                                "sense_id": "b4d86d4e-8bff-32de-b7ff-4f55977d309c",
                                                "text": "D’émotion, les genoux se dérobent sous lui."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
