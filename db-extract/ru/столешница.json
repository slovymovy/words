                "senses": [
                    {
                        "sense_id": "583c1d77-be5a-351e-8b3e-361925d3c322",
                        "entry_id": "de985894-c0f7-3539-8f2d-b91b1dc6ea8d",
                        "glosses": [
                            "верхняя доска, крышка стола"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df7ffe8e-e957-477f-a264-697f5802b324",
                                "sense_id": "583c1d77-be5a-351e-8b3e-361925d3c322",
                                "text": "Золу сеют, муку по столешнице раскатывают, угли перекидывают, в воде брызгаются."
                            },
                            {
                                "example_id": "e09b75fe-93fc-4f55-af21-3d6cbb308a08",
                                "sense_id": "583c1d77-be5a-351e-8b3e-361925d3c322",
                                "text": "Несмотря на относительную вышину табурета, голова сидевшего на нём человека возвышалась над столом таким образом, что его подбородок приходился почти в уровень со столешницей."
                            }
                        ]
                    }
                ],
