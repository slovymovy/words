                        "glosses": [
                            "Nom des membres d’une confrérie secrète et mystique dont les adeptes se prétendent magiciens, la Rose-Croix."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1be895e-9582-46e9-aa81-da92bc2a2218",
                                "sense_id": "60a85ff9-ffa5-36ed-b948-1595f1e1a427",
                                "text": "Les rose-croix."
                            },
                            {
                                "example_id": "92088919-8565-461a-8740-73fe3fa10a9c",
                                "sense_id": "60a85ff9-ffa5-36ed-b948-1595f1e1a427",
                                "text": "— J’ai, répondit M. Roux, un capitaine tout jeune qui observe, au contraire, la plus exquise politesse. C’est un esthète, un rose-croix."
                            }
                        ]
                    },
