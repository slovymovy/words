                    {
                        "translation_id": "b9215004-1fcb-41aa-b862-e8b59508bc53",
                        "source_entry_id": "991135ab-6e01-3501-9d88-2c7d63a35572",
                        "source_sense_id": "a38e3e80-d337-380b-b821-1d62bb3b5304",
                        "target_lang_word": "Aspik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aspik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2d3b9b90-238b-3532-af73-a69f41aa72c9",
                                        "entry_id": "d36b7b29-c6fa-3d2d-9614-0a3bb021d155",
                                        "glosses": [
                                            "säuerliches Gallert aus Gelatine oder Kalbsknochen zum Überzug von Speisen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5958817-733b-48d6-9150-fdfd5ae17675",
                                                "sense_id": "2d3b9b90-238b-3532-af73-a69f41aa72c9",
                                                "text": "„Der königliche Haushofmeister Johann Rottenhöfer weist darin an, wie in Aspik eingelegte winzige Forellen die Tafel verschönern - und das Ganze wie ein Aquarium aussieht.“"
                                            },
                                            {
                                                "example_id": "02b474e8-24d9-4972-92aa-e9c09271f30e",
                                                "sense_id": "2d3b9b90-238b-3532-af73-a69f41aa72c9",
                                                "text": "„Und eine genaue Analyse zeigt: Dieser Minikubus enthält zwischen einem Teigboden und dem Aspik tatsächlich ein Stück Sardelle im Milligrammbereich.“"
                                            },
                                            {
                                                "example_id": "f859a74d-aaff-40db-af74-a2304d98f777",
                                                "sense_id": "2d3b9b90-238b-3532-af73-a69f41aa72c9",
                                                "text": "„Serviert wird estnische Küche: Sült (Fleisch in Aspik), Mulgikapsas (fettiges Sauerkraut) und Kama, eine süße Nachspeise.“"
                                            },
                                            {
                                                "example_id": "0e1cc0d9-8ab6-47ec-9d7f-4c83d5ce0742",
                                                "sense_id": "2d3b9b90-238b-3532-af73-a69f41aa72c9",
                                                "text": "„Ich griff sofort nach einer der Hühnerkeulen in Portwein und Aspik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fc32b171-2137-4945-8ccb-c728ebc81f5e",
                        "source_entry_id": "991135ab-6e01-3501-9d88-2c7d63a35572",
                        "source_sense_id": "a38e3e80-d337-380b-b821-1d62bb3b5304",
                        "target_lang_word": "aspic",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aspic",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e70c77fb-49c6-34cf-8ddc-980995f78d33",
                                        "entry_id": "11e0e464-4b04-3245-9093-492f9a19898d",
                                        "glosses": [
                                            "Serpent, proche du naja ou du cobra, répandu dans toute l’Afrique et très venimeux, l’aspic de Cléopâtre ou cobra égyptien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebda8746-0dfb-4886-ba29-02f67b8587db",
                                                "sense_id": "e70c77fb-49c6-34cf-8ddc-980995f78d33",
                                                "text": "Confier ma vie à ce type équivaut à me faire mordre le mollet par un aspic…"
                                            },
                                            {
                                                "example_id": "0cd09a43-c386-432d-88b4-f67884231600",
                                                "sense_id": "e70c77fb-49c6-34cf-8ddc-980995f78d33",
                                                "text": "La reine Cléopâtre s’est fait mordre par un aspic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3338906-5335-3844-91a4-9ed3e4c8d0f3",
                                        "entry_id": "11e0e464-4b04-3245-9093-492f9a19898d",
                                        "glosses": [
                                            "Vipère d’Europe de l'ouest, la vipère aspic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2109f116-d9f4-4c9d-8a33-cc9ad70624e8",
                                                "sense_id": "a3338906-5335-3844-91a4-9ed3e4c8d0f3",
                                                "text": "L'aspic d'or qu'elle avait détaché de son bras sifflait en glissant sous les voûtes."
                                            },
                                            {
                                                "example_id": "5c1e6c65-ae78-4461-a5b4-467ae55cf796",
                                                "sense_id": "a3338906-5335-3844-91a4-9ed3e4c8d0f3",
                                                "text": "Cela ne mène, peut-être, pas à grand-chose mais il est en tout cas certain que, si je dis « Cléopâtre », je pense tout d’abord à l’aspic caché dans un panier de figues (comme la plupart des gens, j’ai horreur des serpents), ensuite aux lions par lesquels elle faisait dévorer ses amants."
                                            },
                                            {
                                                "example_id": "72fd68d5-5277-4cdd-bf97-5db71757142b",
                                                "sense_id": "a3338906-5335-3844-91a4-9ed3e4c8d0f3",
                                                "text": "L’aspic a un corps massif et un museau retroussé."
                                            },
                                            {
                                                "example_id": "5edce18b-f1b2-414f-b156-1d34b7bce5e6",
                                                "sense_id": "a3338906-5335-3844-91a4-9ed3e4c8d0f3",
                                                "text": "Il fut mordu par un aspic."
                                            },
                                            {
                                                "example_id": "f9a1ba02-c107-49e4-94ac-48096d604825",
                                                "sense_id": "a3338906-5335-3844-91a4-9ed3e4c8d0f3",
                                                "text": "Ils te porteront sur les mains, De peur que ton pied ne heurte contre une pierre.Tu marcheras sur le lion et sur l'aspic"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b28fc35-d023-3521-a626-106f533d105e",
                                        "entry_id": "11e0e464-4b04-3245-9093-492f9a19898d",
                                        "glosses": [
                                            "Personne très médisante. Grâce à leur venin, ces serpents ont toujours symbolisé la calomnie. L’aspic des voleurs n’est que la vipère des honnêtes gens."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2170e829-0cdb-4e50-bdb1-84cb6c10482c",
                                                "sense_id": "0b28fc35-d023-3521-a626-106f533d105e",
                                                "text": "Un aspic, une langue d’aspic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0230789c-0fc4-3cc1-8f04-1541ce0b34cd",
                                        "entry_id": "11e0e464-4b04-3245-9093-492f9a19898d",
                                        "glosses": [
                                            "Entrée froide moulée utilisant de la gelée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "021d7a38-4926-40cf-99d0-f0c58313a0da",
                                                "sense_id": "0230789c-0fc4-3cc1-8f04-1541ce0b34cd",
                                                "text": "Œufs en gelée, cornets, aspics et barquettes, ballottines, galantines, pâtés, chauds-froids, daubes, terrines, confits, tourtes, tartes, frangipanes : toutes ces dames avaient rempli avec zèle leurs devoirs sociaux."
                                            },
                                            {
                                                "example_id": "dda046c4-781e-497c-80d6-c6a244da743d",
                                                "sense_id": "0230789c-0fc4-3cc1-8f04-1541ce0b34cd",
                                                "text": "Nicolas se remit à sa tâche, qui consistait en le démoulage d'aspics de filets de sole, contisés de lames de truffes, destinés à garnir le hors-d'oeuvre de poisson."
                                            },
                                            {
                                                "example_id": "0951af49-64ed-4215-adc2-2a8da1a5bdeb",
                                                "sense_id": "0230789c-0fc4-3cc1-8f04-1541ce0b34cd",
                                                "text": "J’ai dégusté dans les Cévennes, un aspic de cailles aux châtaignes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4436bc9d-d9bb-3916-8156-01962406243e",
                                        "entry_id": "11e0e464-4b04-3245-9093-492f9a19898d",
                                        "glosses": [
                                            "Un avare."
                                        ],
                                        "tags": [
                                            "dated",
                                            "rare",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "aspic",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "98a27db9-2672-33e9-9fd6-b2322ea495b3",
                                        "entry_id": "278394b9-d0e7-3f68-abd9-0b7d236a5cfd",
                                        "glosses": [
                                            "Synonyme de lavande aspic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21d82f59-d034-409d-be42-506a973de558",
                                                "sense_id": "98a27db9-2672-33e9-9fd6-b2322ea495b3",
                                                "text": "Le sol n'était qu'une immense dalle de calcaire bleuté, sillonnée de fentes toutes brodées de thym, de rue et d'aspic…"
                                            },
                                            {
                                                "example_id": "7dc584fa-d597-4134-90ca-9b2e71c3fe99",
                                                "sense_id": "98a27db9-2672-33e9-9fd6-b2322ea495b3",
                                                "text": "Sur les plateaux de la garrigue, le thym, le romarin, le cade et le kermès gardent leurs feuilles éternelles autour de l’aspic toujours bleu."
                                            },
                                            {
                                                "example_id": "cc0cc04b-7ed5-47e9-8870-669832adc8b7",
                                                "sense_id": "98a27db9-2672-33e9-9fd6-b2322ea495b3",
                                                "text": "Qu’est-elle maintenant, Sylvius, cette femme d’autrefois à jamais endormie ? Une cendre légère dispersée dans la vallée, un souffle dans la fraîcheur des matins, un parfum qui se joint au parfum de l’aspic, quand fleurissent les jours glorieux du printemps."
                                            },
                                            {
                                                "example_id": "52175741-52f6-4607-b86a-5b8495192c79",
                                                "sense_id": "98a27db9-2672-33e9-9fd6-b2322ea495b3",
                                                "text": "L’odeur de l’essence d’aspic est camphrée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
