                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9640dcdc-6682-44b2-aa48-e0d4fc188ece",
                        "entry_id": "bab05db1-5bd3-35cd-bdb1-0c9ba1fc3bc3",
                        "tags": [
