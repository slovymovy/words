                                                "text": "To prove that the Americans ought not to be free, we are obliged to depreciate the value of freedom itself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34be71d2-6a1a-345b-a7b8-4921b54f932b",
                                        "entry_id": "89648799-2951-3e87-891e-5a8a2b583224",
                                        "glosses": [
                                            "To decline in value over time."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "02366c74-9843-3afe-94a5-86b64622af30",
                                        "entry_id": "89648799-2951-3e87-891e-5a8a2b583224",
                                        "glosses": [
                                            "To belittle or disparage."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51154774-2d4e-4b27-a42d-895aae4dbef4",
                                                "sense_id": "02366c74-9843-3afe-94a5-86b64622af30",
                                                "text": "They depreciated him because he was the youngest on the team."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5be50ec8-d97c-4ded-b386-82b2578242f5",
                        "source_entry_id": "03dc9453-5a78-338b-8414-861a33e153f0",
                        "source_sense_description": "лишать ценности, делать малоценным",
                        "target_lang_word": "cheapen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cheapen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba8b6374-07f5-3455-ac4a-b6af607c1c2b",
                                        "entry_id": "cca4a199-0f3a-3196-9f78-3cee0629a99b",
                                        "glosses": [
                                            "To decrease the value or price of; to make cheaper."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abb4a905-9a40-4da9-b8c2-218799638d71",
                                                "sense_id": "ba8b6374-07f5-3455-ac4a-b6af607c1c2b",
                                                "text": "Now, covered concrete troughs to house the cables are laid parallel with the railway lines, cheapening maintenance because of improved accessibility for inspection and repair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fd83a10-fc8f-38ae-a194-b86c253ec7cd",
                                        "entry_id": "cca4a199-0f3a-3196-9f78-3cee0629a99b",
                                        "glosses": [
                                            "To make vulgar."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "994e24bc-7d0f-4ebe-9781-5c5b48e7871e",
                                                "sense_id": "5fd83a10-fc8f-38ae-a194-b86c253ec7cd",
                                                "text": "The pace of the season can't help but cheapen these scenes, but I can’t deny that it's a blast. I’ve been critical of both the relative depopulation of the cast in this final run and the speedy, schematic narrative that checks off high points and moves on without really building to them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7b356ae-0aec-30e6-96f5-df030edfad62",
                                        "entry_id": "cca4a199-0f3a-3196-9f78-3cee0629a99b",
                                        "glosses": [
                                            "To become cheaper."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e8b0588e-877b-3222-808d-23d3d672309e",
                                        "entry_id": "cca4a199-0f3a-3196-9f78-3cee0629a99b",
                                        "glosses": [
                                            "To bargain for, ask the price of."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee8665d1-63d9-4edc-b082-c0a9847931d6",
                                                "sense_id": "e8b0588e-877b-3222-808d-23d3d672309e",
                                                "text": "I should like to have seen that noble old madcap Peterborough in his boots (he actually had the audacity to walk about Bath in boots!), with his blue ribbon and stars, and a cabbage under each arm, and a chicken in his hand, which he had been cheapening for his dinner."
                                            },
                                            {
                                                "example_id": "4d956bbb-ad09-4a63-a0db-91fb1a2eccec",
                                                "sense_id": "e8b0588e-877b-3222-808d-23d3d672309e",
                                                "text": "The maid was on the step, cheapening fish with a virulent lady who had a sieve-full to dispose of."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9d3bdc4-2799-4cc3-9365-03b2053bc7e3",
                        "source_entry_id": "03dc9453-5a78-338b-8414-861a33e153f0",
                        "source_sense_description": "лишать ценности, делать малоценным",
                        "target_lang_word": "déprécier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déprécier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2fb731bc-d872-3212-aaa4-c55c6872d703",
                                        "entry_id": "e9e0c21b-e594-3ea6-9049-31d66c58ca78",
                                        "glosses": [
                                            "Rabaisser une chose, une personne en l’estimant au-dessous de son prix, de sa valeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "244578c7-feb6-4d8b-ade5-d79c1c597ccc",
                                                "sense_id": "2fb731bc-d872-3212-aaa4-c55c6872d703",
                                                "text": "L’auteur de l’extrait en question ne se seroit jamais douté qu’on eût voulu lui supposer l’intention de déprécier le mérite de l’ouvrage de M. de Necker."
                                            },
                                            {
                                                "example_id": "bba2851e-f02b-4636-94d2-e9bf276766a7",
                                                "sense_id": "2fb731bc-d872-3212-aaa4-c55c6872d703",
                                                "text": "Avant d’en venir à déprécier le livre, le libelliste commençait par déprécier l’auteur."
                                            },
                                            {
                                                "example_id": "38584a01-666f-4c42-b04c-ebb047f32def",
                                                "sense_id": "2fb731bc-d872-3212-aaa4-c55c6872d703",
                                                "text": "La plupart de nos erreurs viennent de la facilité avec laquelle notre esprit exagère ou déprécie l’importance d’un objet, parce qu’il ne sait pas se rendre un compte exact de l’éloignement ou du rapprochement relatif de cet objet."
                                            },
                                            {
                                                "example_id": "d5494cbf-0df5-45a5-9f5c-5e9222be3a21",
                                                "sense_id": "2fb731bc-d872-3212-aaa4-c55c6872d703",
                                                "text": "« Tu sais, avait dit Mme Verdurin à son mari, je crois que nous faisons fausse route quand par modestie nous déprécions ce que nous offrons au docteur. C’est un savant qui vit en dehors de l’existence pratique, il ne connaît pas par lui-même la valeur des choses et il s’en rapporte à ce que nous lui en disons. »"
                                            },
                                            {
                                                "example_id": "86904d32-a22b-4979-982b-290153ec9743",
                                                "sense_id": "2fb731bc-d872-3212-aaa4-c55c6872d703",
                                                "text": "Ce qui est, elle ne le voit pas, elle s'applique à ne pas le voir, elle refuse de le voir. Elle le refuse. Elle le déprécie d'abord pour elle et ensuite pour vous. Elle voit tout en mal et s'obstine à vous désenchanter. Rien n'est bien, rien ne lui sufﬁt, rien ne la satisfait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b498e413-69ca-33c2-813f-14adebec4770",
                                        "entry_id": "e9e0c21b-e594-3ea6-9049-31d66c58ca78",
                                        "glosses": [
                                            "Perdre de la valeur. En particulier dans les marché des changes: se déprécier."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5f86158-8eab-46b9-9388-a385d5ab1b37",
                                                "sense_id": "b498e413-69ca-33c2-813f-14adebec4770",
                                                "text": "Une période de croissance lente sera nécessaire avant que les tensions inflationnistes ne se dissipent et que la Banque centrale puisse abaisser les taux d’intérêt, permettant ainsi au taux de change de se déprécier."
                                            },
                                            {
                                                "example_id": "9c401a1f-2884-468d-8f21-ce3d433753fc",
                                                "sense_id": "b498e413-69ca-33c2-813f-14adebec4770",
                                                "text": "Ainsi l’ensemble des utilisateurs du système accordent au bitcoin leur confiance, c’est un acte de foi dans le fait que ce bien sera accepté dans les échanges et un acte d’espérance dans le fait qu’il ne se dépréciera pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16a53c55-3a52-37af-ae12-79e5d1cdd61b",
                                        "entry_id": "e9e0c21b-e594-3ea6-9049-31d66c58ca78",
                                        "glosses": [
                                            "Agir de sorte que l’on soit déprécié dans le regard d’autrui ou dans le sien propre, en parlant des personnes."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce3e5850-0d0e-43b7-8168-198856fc8853",
                                                "sense_id": "16a53c55-3a52-37af-ae12-79e5d1cdd61b",
                                                "text": "Il détestait la voir se déprécier ainsi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ccb11c8-a4ad-3629-b7af-32899d97ea42",
                                        "entry_id": "e9e0c21b-e594-3ea6-9049-31d66c58ca78",
                                        "glosses": [
                                            "Rendre obsolète, déconseiller l’emploi de quelque chose."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d535288d-9812-4797-a1b5-24cbed55372c",
                                                "sense_id": "6ccb11c8-a4ad-3629-b7af-32899d97ea42",
                                                "text": "La fonction dépréciée unescape() calcule une nouvelle chaîne de caractères et remplace les séquences d'échappement hexadécimales par les caractères qu'elles représentent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
