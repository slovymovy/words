                "forms": [],
                "senses": [
                    {
                        "sense_id": "a656b9e4-5d01-3710-b404-5ddd2887b8c6",
                        "entry_id": "eb6bb1e2-a182-3d46-b85b-1b3f26740e0f",
                        "glosses": [
                            "present participle and gerund of drizzle."
                        ],
                        "tags": [
                            "form-of",
                            "gerund",
