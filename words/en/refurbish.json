{
    "word_family": [
        "refurbishment",
        "furbish"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b0f1175e-16f6-30f0-882e-3bcfec962c95",
                    "sense_definition": "To rebuild, replenish, or restore something to its original or better working order and appearance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "restore",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to <w>refurbish</w> the old kitchen to make it look modern and clean.",
                            "target_lang_translations": {
                                "ru": "Мы решили <w>отремонтировать</w> старую кухню, чтобы она выглядела современной и чистой."
                            }
                        },
                        {
                            "text": "The company plans to <w>refurbish</w> old apartments and sell them at a higher price.",
                            "target_lang_translations": {
                                "ru": "Компания планирует <w>обновлять</w> старые квартиры и продавать их по более высокой цене."
                            }
                        }
                    ],
                    "synonyms": [
                        "mangonize"
                    ],
                    "common_phrases": [
                        "refurbish the kitchen",
                        "refurbish old apartments"
                    ],
                    "target_lang_definitions": {
                        "ru": "Восстанавливать, обновлять или приводить что-либо в первоначальный или лучший вид и рабочее состояние."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обновлять",
                                "target_lang_sense_clarification": "придавать вид нового путем починки или замены частей"
                            },
                            {
                                "target_lang_word": "восстанавливать",
                                "target_lang_sense_clarification": "приводить в прежнее хорошее состояние"
                            },
                            {
                                "target_lang_word": "отремонтировать",
                                "target_lang_sense_clarification": "сделать ремонт, обновить помещение или технику"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a832499c-2db2-3964-95cb-f196f817dbaa",
                    "sense_definition": "An act of <w>refurbishing</w>; a refurbishment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "restore",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My bedroom is looking very old and definitely needs a quick <w>refurbish</w>.",
                            "target_lang_translations": {
                                "ru": "Моя спальня выглядит очень старой, и ей определенно нужен быстрый <w>ремонт</w>."
                            }
                        },
                        {
                            "text": "They closed the library for a complete <w>refurbish</w> that will take three months.",
                            "target_lang_translations": {
                                "ru": "Библиотеку закрыли на полное <w>обновление</w>, которое займет три месяца."
                            }
                        }
                    ],
                    "common_phrases": [
                        "needs a refurbish",
                        "complete refurbish"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally as a noun instead of 'refurbishment'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс обновления, ремонта или восстановления; косметический ремонт."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ремонт",
                                "target_lang_sense_clarification": "обновление или починка помещения"
                            },
                            {
                                "target_lang_word": "обновление",
                                "target_lang_sense_clarification": "приведение в более современный или свежий вид"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}