{
    "word_family": [
        "turreted"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "74f75f71-01de-3e90-89ab-8e9505023ff8",
                    "sense_definition": "A small tower, often ornamental, located at the corner of a building or castle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tower",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old castle had a tall <w>turret</w> at each corner.",
                            "target_lang_translations": {
                                "zh": "这座古老的城堡每个角落都有一座高高的<w>角楼</w>。"
                            }
                        },
                        {
                            "text": "The Victorian house featured a decorative <w>turret</w> overlooking the garden.",
                            "target_lang_translations": {
                                "zh": "这座维多利亚风格的房子有一个俯瞰花园的装饰性<w>小塔</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cupola"
                    ],
                    "common_phrases": [
                        "castle turret"
                    ],
                    "target_lang_definitions": {
                        "zh": "建筑物或城堡角落上的小型塔楼，通常具有装饰性。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "角楼",
                                "target_lang_sense_clarification": "指城堡或城墙角落的塔楼。"
                            },
                            {
                                "target_lang_word": "小塔",
                                "target_lang_sense_clarification": "指建筑物上较小的塔状结构。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc61299a-b927-34e1-93ec-8004aada7b26",
                    "sense_definition": "An armored, rotating structure on a ship, tank, or aircraft that houses guns.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tank commander rotated the <w>turret</w> to aim at the target.",
                            "target_lang_translations": {
                                "zh": "坦克指挥官旋转<w>炮塔</w>以瞄准目标。"
                            }
                        },
                        {
                            "text": "The ship's main <w>turret</w> was heavily armored for protection.",
                            "target_lang_translations": {
                                "zh": "这艘船的主<w>炮塔</w>装有厚重的装甲以提供保护。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tank turret"
                    ],
                    "target_lang_definitions": {
                        "zh": "安装在舰船、坦克或飞机上，用于容纳火炮并可旋转的装甲结构。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "炮塔",
                                "target_lang_sense_clarification": "军事装备中用于安装火炮的旋转结构。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "576ec483-4bc8-3af2-b38a-a5a71afc6fcc",
                    "sense_definition": "A tall, movable tower used in historical warfare to approach and attack fortified walls.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tower",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The army pushed the massive siege <w>turret</w> toward the city walls.",
                            "target_lang_translations": {
                                "zh": "军队将巨大的<w>攻城塔</w>推向城墙。"
                            }
                        },
                        {
                            "text": "Soldiers climbed the wooden <w>turret</w> to reach the top of the ramparts.",
                            "target_lang_translations": {
                                "zh": "士兵们爬上木制<w>攻城塔</w>以到达城墙顶部。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to historical siege warfare."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "古代战争中用于接近并攻击防御工事的高大移动式塔楼。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "攻城塔",
                                "target_lang_sense_clarification": "古代攻城时使用的移动式高塔。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8aff3d55-bc1e-3dd1-9016-bd40e3bd7112",
                    "sense_definition": "A metal post on a circuit board used for mounting electronic components.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician soldered the wire directly to the <w>turret</w> on the board.",
                            "target_lang_translations": {
                                "zh": "技术员将导线直接焊接在电路板的<w>接线柱</w>上。"
                            }
                        },
                        {
                            "text": "Vintage amplifiers often use a <w>turret</w> board for point-to-point wiring.",
                            "target_lang_translations": {
                                "zh": "老式放大器通常使用<w>接线柱</w>板进行点对点布线。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "电路板上用于安装电子元件的金属柱。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "接线柱",
                                "target_lang_sense_clarification": "电路中用于连接导线或元件的金属柱。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a7d85e2-8f9a-30e1-b68a-e84f0d82f6e8",
                    "sense_definition": "The raised central part of a passenger train roof designed for light and ventilation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old passenger car featured a classic <w>turret</w> roof design.",
                            "target_lang_translations": {
                                "zh": "这节旧客车车厢采用了经典的<w>天窗顶</w>设计。"
                            }
                        },
                        {
                            "text": "Light streamed into the carriage through the windows in the <w>turret</w>.",
                            "target_lang_translations": {
                                "zh": "光线透过<w>天窗顶</w>的窗户射入车厢。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "客运列车车顶中央隆起的部分，用于采光和通风。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "天窗顶",
                                "target_lang_sense_clarification": "指车厢顶部用于采光通风的隆起结构。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de349719-1326-319d-9923-f8d512497063",
                    "sense_definition": "A rotating tool holder on a machine, such as a lathe, that allows for quick tool changes.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The machinist indexed the <w>turret</w> to select the next cutting tool.",
                            "target_lang_translations": {
                                "zh": "机械师转动<w>刀塔</w>以选择下一个切削刀具。"
                            }
                        },
                        {
                            "text": "A multi-tool <w>turret</w> significantly increases the efficiency of the lathe.",
                            "target_lang_translations": {
                                "zh": "多刀位<w>刀塔</w>显著提高了车床的加工效率。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "机床（如车床）上可旋转的刀具架，用于快速更换刀具。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "刀塔",
                                "target_lang_sense_clarification": "数控机床或车床上用于安装和切换刀具的旋转部件。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}