                "senses": [
                    {
                        "sense_id": "192928a8-e13a-3733-87f1-7dba41fe72ad",
                        "entry_id": "69e399c7-d666-39e0-9fc4-d11c502e6dca",
                        "glosses": [
                            "illegaler Angriff auf Computersysteme durch Hacker"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "731c588d-bd8d-4d92-a92c-c5c824f96720",
                                "sense_id": "192928a8-e13a-3733-87f1-7dba41fe72ad",
                                "text": "„Die EU nimmt beim Kampf gegen Internetkriminalität die Privatwirtschaft in die Pflicht. So sollen Unternehmen verpflichtet werden, eigene Sicherheitsmaßnahmen gegen Hackerangriffe zu ergreifen.“"
                            },
                            {
                                "example_id": "9f557fd0-fa06-4603-bada-3fea235da516",
                                "sense_id": "192928a8-e13a-3733-87f1-7dba41fe72ad",
                                "text": "„Wegen eines Hackerangriffs auf Facebook ist ein britischer Informatikstudent zu acht Monaten Haft verurteilt worden.“"
                            },
                            {
                                "example_id": "b43a07b6-0d42-4369-8908-ae6746c7115c",
                                "sense_id": "192928a8-e13a-3733-87f1-7dba41fe72ad",
                                "text": "„Am Donnerstag hat die ÖVP ein Hintergrundgespräch zum angeblichen Hackerangriff auf ihre Parteizentrale gegeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
