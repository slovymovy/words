                {
                    "sense_id": "27a75035-aba3-35bc-bbdf-0c448a2fb012",
                    "sense_definition": "met een sierlijke knoop of lus vastmaken",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vastmaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet je <w>veters</w> goed <w>strikken</w> voordat je gaat hardlopen.",
                            "target_lang_translations": {
