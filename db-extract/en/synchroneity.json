                        "examples": [
                            {
                                "example_id": "f145ec9f-39d3-4b46-80d8-e68a7bfb6032",
                                "sense_id": "bf92a9e0-cb13-3ed8-9bf2-604c8cb21055",
                                "text": "Artist and audience are bound together in a three-legged race, sometimes reluctant partners, sometimes joyful in synchroneity."
                            },
                            {
                                "example_id": "c64f4798-8261-4211-a96b-898a3e5f77bd",
                                "sense_id": "bf92a9e0-cb13-3ed8-9bf2-604c8cb21055",
                                "text": "Variously generated temperature curves for different localities do not always exhibit clear synchroneities."
                            },
                            {
                                "example_id": "1a8f3dab-18e7-4cdf-aee3-8de9b9931069",
                                "sense_id": "bf92a9e0-cb13-3ed8-9bf2-604c8cb21055",
                                "text": "This widespread synchroneity of climate anomalies suggests a relatively rapid global reorganization of the ocean–atmosphere system."
                            }
