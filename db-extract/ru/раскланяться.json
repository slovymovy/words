                        "glosses": [
                            "to bow (e.g. of a gentleman or performer)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c8edaa4-37e0-4251-afe6-475238e502dc",
                                "sense_id": "fc4f4c40-c4f8-3fb9-853f-61b50b3a6be2",
                                "text": "Бы́вший суде́бный сле́дователь гала́нтно раскла́нялся, осторо́жно взя́лся за дверну́ю ру́чку и исче́з, оста́вив на моё́м столе́ своё́ произведе́ние.",
                                "translation": "The former investigating magistrate bowed gallantly, gingerly grasped the door handle and vanished, leaving his story on my desk.",
                                "english": "The former investigating magistrate bowed gallantly, gingerly grasped the door handle and vanished, leaving his story on my desk."
                            }
                        ]
