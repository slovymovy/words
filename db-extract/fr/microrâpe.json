                        "examples": [
                            {
                                "example_id": "901c2344-a26e-4e22-93f1-156f7d21dbe3",
                                "sense_id": "32704520-d629-370f-a815-8d777b98fa30",
                                "text": "Dans quel autre lieu parisien pourriez-vous trouver de minuscules séche-linges pliants à suspendre au dessus de la baignoire, des petites serviettes de bain rugueuses pour se lisser la couenne, des microrâpes à gingembre et mille autres petits gadgets si pratiques au quotidien ?"
                            },
                            {
                                "example_id": "36ea8c91-5813-45e3-bafc-ababef9877ba",
                                "sense_id": "32704520-d629-370f-a815-8d777b98fa30",
                                "text": "Si vous utilisez une maille fine au lieu d’une microrâpe, frottez-la aussi doucement que possible pour éviter d’enlever plus que le mucus, car la partie inférieure est amère et immangeable."
                            },
                            {
                                "example_id": "e3945049-6a71-40a8-8c4f-732d9d63fd99",
                                "sense_id": "32704520-d629-370f-a815-8d777b98fa30",
                                "text": "Nettoyer le citron et récupérer le zeste à l’aide d’une microrâpe."
                            }
                        ]
                    }
