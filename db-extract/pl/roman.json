                            {
                                "target_word": "Romain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fc61738c-bd7e-3fed-b212-f75b51265898",
                                        "entry_id": "ec2b4a33-08ce-338b-b917-4043f16e4721",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cdf7edc-1969-4652-a8a6-cd7f2e474483",
                                                "sense_id": "fc61738c-bd7e-3fed-b212-f75b51265898",
                                                "text": "J'imagine que, tout au long de leurs amours intermittentes, toujours traversées et toujours renaissantes, Romain et Meg, puis Romain et Margault avaient eu, l'un et l'autre, chacun de son côté, beaucoup à se pardonner et à se faire pardonner."
                                            },
                                            {
                                                "example_id": "4c7cad9a-052d-47f8-b3f8-e89d3692d280",
                                                "sense_id": "fc61738c-bd7e-3fed-b212-f75b51265898",
                                                "text": "Je l'ai vu la nouvelle meuf de Romain."
                                            },
                                            {
                                                "example_id": "87f811c6-f6a8-41ec-9b2e-86f865d80d77",
                                                "sense_id": "fc61738c-bd7e-3fed-b212-f75b51265898",
                                                "text": "Romain Valadier-Picard et Cédric Revol, engagés dans la catégorie des moins de 60 kg, ont tous deux été éliminés au deuxième tour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
