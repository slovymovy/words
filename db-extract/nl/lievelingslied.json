                    {
                        "sense_id": "a6fb3e1d-8339-3fb9-aaca-5b0e9cf5a80a",
                        "entry_id": "f140e7f3-0acf-3211-b9a2-ab174920083d",
                        "glosses": [
                            "lied dat men het liefste beluistert of zingt"
