                                        "sense_id": "0d88c93f-9f95-3627-a992-5d439f6e0add",
                                        "entry_id": "09b0d17a-8c78-3d85-a765-360fda52a2b1",
                                        "glosses": [
                                            "Abondance de répétitions, de développements, d’ornements, généralement considérée comme excessive, critiquée pour sa lourdeur, son obscurité, son emphase."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e3a8500-9035-4cc2-8bc7-0a9036cfe127",
                                                "sense_id": "0d88c93f-9f95-3627-a992-5d439f6e0add",
                                                "text": "Il faut éviter les redondances dans ce qu’on écrit."
                                            },
                                            {
                                                "example_id": "94e7d19d-40e3-4483-b6d4-bc67bf460996",
                                                "sense_id": "0d88c93f-9f95-3627-a992-5d439f6e0add",
                                                "text": "— À considérer leur capacité crânienne, leur angle facial, et telles autres caractéristiques, énonça-t-il avec sa redondance habituelle, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10b25869-2685-32a4-bb38-7c284aa94bcf",
                                        "entry_id": "09b0d17a-8c78-3d85-a765-360fda52a2b1",
                                        "glosses": [
                                            "Caractère d’un message, d’un code, présentant des répétitions, des éléments excédentaires par rapport au nombre de signes strictement nécessaires à la transmission de l’information et permettant ainsi une compréhension et une fiabilité meilleures."
                                        ],
                                        "tags": [
                                            "Communication"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef819b16-c5da-4779-85ab-439aed47a75b",
                                                "sense_id": "10b25869-2685-32a4-bb38-7c284aa94bcf",
                                                "text": "La correction de ce type d’erreurs nécessite une redondance plus importante, qui peut être obtenue par l’usage de codes correcteurs d’erreurs ou par répétition du message."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f7180c1-0bd9-3650-9ad5-6f5b320efa65",
                                        "entry_id": "09b0d17a-8c78-3d85-a765-360fda52a2b1",
                                        "glosses": [
                                            "Doublement (ou plus) d’un système de contrôle, de pilotage, etc. pour améliorer sa fiabilité."
