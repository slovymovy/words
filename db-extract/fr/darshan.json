                        "entry_id": "13c32371-9d87-3e50-b746-7c51434275e5",
                        "glosses": [
                            "Moment où le dévot est en contact visuel direct avec l’idole d’un dieu, un avatar, un maître spirituel vivant ou la représentation d’un maître défunt."
                        ],
                        "tags": [
                            "Hinduism"
                        ],
                        "examples": [
                            {
                                "example_id": "79c9fea5-5f63-48f3-8bf7-b8e9d6190ba6",
                                "sense_id": "d7b49055-0cf9-3101-8a7d-686c2f0356d9",
                                "text": "Voir le darshan d'un sage, d’une représentation divine, d’un lieu, etc., c’est en recevoir la bénédiction par le fait de le voir."
                            },
                            {
                                "example_id": "5470ac38-b0b6-4222-9770-6a80dd54034d",
                                "sense_id": "d7b49055-0cf9-3101-8a7d-686c2f0356d9",
                                "text": "Le moment du darshan avec Mère Meera se déroule d'une façon précise."
                            }
                        ]
                    },
                    {
                        "sense_id": "699d107b-2872-3c2d-88ba-cfa09f2710d9",
