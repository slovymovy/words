                    {
                        "sense_id": "3db7a131-183a-3e19-96e1-497fac7686d0",
                        "entry_id": "dc837d98-97f3-3ee7-a83d-19d268732b7a",
                        "glosses": [
                            "podstawowa jednostka masy w układzie SI, oznaczana kg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "307eece8-d654-4993-95b1-0eb2d3b92f37",
                                "sense_id": "3db7a131-183a-3e19-96e1-497fac7686d0",
                                "text": "W sklepie kupiłem dwa kilogramy cukru i kilogram mąki."
                            },
                            {
                                "example_id": "39cbdfd5-5652-48c4-b501-63ba434a48d4",
                                "sense_id": "3db7a131-183a-3e19-96e1-497fac7686d0",
                                "text": "Przez miesiąc schudłem pięć kilogramów."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "82fff332-758c-361d-9fda-3f70cc605f04",
                        "entry_id": "dc837d98-97f3-3ee7-a83d-19d268732b7a",
                        "glosses": [
                            "podstawowa jednostka siły w ciężarowym układzie jednostek miar, oznaczana kgf, kp lub kG"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
