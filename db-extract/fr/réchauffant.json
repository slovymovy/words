                        "tags": [],
                        "examples": [
                            {
                                "example_id": "923b5efc-bcce-4e27-b2ff-ee156bcdcc49",
                                "sense_id": "6c38caad-71bb-3c19-9c44-be8b199b258b",
                                "text": "Qu’il fait bon vivre, autour de ces plats réchauffants,\nDans l’ordre et dans la paix de l’honnête famille,\nA la table où vous rit une troupe d’enfants."
                            },
                            {
                                "example_id": "19054282-31b9-40f6-acfb-e0d4761b1255",
                                "sense_id": "6c38caad-71bb-3c19-9c44-be8b199b258b",
                                "text": "Nous nous assîmes sur un talus, ployant le dos sous les rayons réchauffants, comme fait un chat sous la main qui le caresse."
                            }
                        ]
                    },
                    {
                        "sense_id": "ee85031b-943d-3fa8-8fc3-e6d0f4eb0431",
