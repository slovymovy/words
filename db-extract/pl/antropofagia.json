                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4166ff38-731a-3fb1-ace2-094237a1457c",
                                        "entry_id": "78a443eb-061b-3873-a0a6-d06bb296c45c",
                                        "glosses": [
                                            "Verzehr von Menschenfleisch durch Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d990ef8-cbfc-42c7-aba8-ff283eb930a6",
                                                "sense_id": "4166ff38-731a-3fb1-ace2-094237a1457c",
                                                "text": "„Er hat ein kleines Buch über Literatur und Kannibalismus geschrieben, darin entfaltet er die Geschichte der Anthropophagie von James Cook bis Bret Easton Ellis.“"
                                            },
                                            {
                                                "example_id": "ec6d6fa8-cd03-415a-beb0-4cdccc88e247",
                                                "sense_id": "4166ff38-731a-3fb1-ace2-094237a1457c",
                                                "text": "„Meistens aber handelt es sich um pure Volksfantasie, wenn irgendwo in Afrika von Anthropophagie geraunt wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f6195bd-06a5-4b6f-b753-873a6a840a76",
                        "source_entry_id": "b72f3b21-81dc-321f-9197-bc2db7776504",
                        "source_sense_id": "2ecb9d6f-3db1-35ba-9c3d-d3240c9c2c74",
                        "target_lang_word": "антропофагия",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
