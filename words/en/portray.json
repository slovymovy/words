{
    "word_family": [
        "portrait",
        "portrayal",
        "portraiture",
        "portrayer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7f2392cb-9c17-3556-b827-21cb1533ee95",
                    "sense_definition": "To play a role or act as a character in a film, play, or other performance.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actor will <w>portray</w> a famous historical figure in his upcoming biographical movie.",
                            "target_lang_translations": {
                                "ru": "Актер <w>сыграет</w> известную историческую личность в своем предстоящем биографическом фильме.",
                                "tr": "Aktör, yakında çıkacak biyografik filminde ünlü bir tarihi kişiliği <w>canlandıracak</w>."
                            }
                        },
                        {
                            "text": "She was chosen to <w>portray</w> the lead role because of her incredible emotional range.",
                            "target_lang_translations": {
                                "ru": "Ее выбрали на <w>исполнение</w> главной роли из-за ее невероятного эмоционального диапазона.",
                                "tr": "İnanılmaz duygusal derinliği nedeniyle başrolü <w>oynaması</w> için seçildi."
                            }
                        }
                    ],
                    "synonyms": [
                        "play",
                        "enact",
                        "represent",
                        "depict"
                    ],
                    "common_phrases": [
                        "portray the lead role",
                        "portray a character",
                        "portray a villain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Играть роль или выступать в качестве персонажа в фильме, спектакле или другом представлении.",
                        "tr": "Bir film, oyun veya başka bir performansta bir rolü oynamak veya bir karakteri canlandırmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "играть",
                                "target_lang_sense_clarification": "роль"
                            },
                            {
                                "target_lang_word": "изображать",
                                "target_lang_sense_clarification": "персонажа на сцене или в кино"
                            },
                            {
                                "target_lang_word": "исполнять роль",
                                "target_lang_sense_clarification": "в спектакле или фильме"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "canlandırmak",
                                "target_lang_sense_clarification": "bir karakteri veya rolü oynamak"
                            },
                            {
                                "target_lang_word": "oynamak",
                                "target_lang_sense_clarification": "bir rolü üstlenmek"
                            },
                            {
                                "target_lang_word": "rolünü üstlenmek",
                                "target_lang_sense_clarification": "bir karakteri temsil etmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f147aa1-6587-396a-b53d-a7d95a6d25d4",
                    "sense_definition": "To describe or represent someone or something in a particular way using words or images.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The media often <w>portray</w> the politician as a hero, ignoring his many controversial decisions.",
                            "target_lang_translations": {
                                "ru": "СМИ часто <w>изображают</w> этого политика героем, игнорируя его многочисленные спорные решения.",
                                "tr": "Medya, birçok tartışmalı kararını görmezden gelerek siyasetçiyi genellikle bir kahraman gibi <w>gösteriyor</w>."
                            }
                        },
                        {
                            "text": "It is unfair to <w>portray</w> the situation as a simple conflict when it is actually very complex.",
                            "target_lang_translations": {
                                "ru": "Несправедливо <w>представлять</w> ситуацию как простой конфликт, когда на самом деле она очень сложная.",
                                "tr": "Aslında çok karmaşık olan bir durumu basit bir çatışma gibi <w>tasvir etmek</w> haksızlıktır."
                            }
                        }
                    ],
                    "synonyms": [
                        "depict",
                        "describe",
                        "characterize",
                        "present"
                    ],
                    "common_phrases": [
                        "portray as",
                        "accurately portray",
                        "unfairly portray"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывать или представлять кого-либо или что-либо определенным образом с помощью слов или изображений.",
                        "tr": "Birini veya bir şeyi kelimeler veya görseller kullanarak belirli bir şekilde tanımlamak veya sunmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изображать",
                                "target_lang_sense_clarification": "представлять в каком-либо свете"
                            },
                            {
                                "target_lang_word": "описывать",
                                "target_lang_sense_clarification": "давать характеристику"
                            },
                            {
                                "target_lang_word": "представлять",
                                "target_lang_sense_clarification": "в определенном виде"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tasvir etmek",
                                "target_lang_sense_clarification": "birini veya bir durumu betimlemek"
                            },
                            {
                                "target_lang_word": "göstermek",
                                "target_lang_sense_clarification": "birini belirli bir şekilde yansıtmak"
                            },
                            {
                                "target_lang_word": "sunmak",
                                "target_lang_sense_clarification": "bir durumu belirli bir bakış açısıyla aktarmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f65aadb5-0192-329e-b00f-82788eb0b8ef",
                    "sense_definition": "To create a likeness of a person or thing through painting, drawing, or other visual arts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist decided to <w>portray</w> the king on horseback to emphasize his power and authority.",
                            "target_lang_translations": {
                                "ru": "Художник решил <w>изобразить</w> короля верхом на лошади, чтобы подчеркнуть его силу и власть.",
                                "tr": "Sanatçı, kralın gücünü ve otoritesini vurgulamak için onu at üzerinde <w>resmetmeye</w> karar verdi."
                            }
                        },
                        {
                            "text": "In this series of sketches, she managed to <w>portray</w> the landscape with remarkable detail.",
                            "target_lang_translations": {
                                "ru": "В этой серии набросков ей удалось <w>запечатлеть</w> пейзаж с поразительной детализацией.",
                                "tr": "Bu eskiz serisinde, manzarayı dikkat çekici bir detayla <w>betimlemeyi</w> başardı."
                            }
                        }
                    ],
                    "synonyms": [
                        "depict",
                        "paint",
                        "draw",
                        "sketch"
                    ],
                    "common_phrases": [
                        "portray in a painting",
                        "vividly portray"
                    ],
                    "target_lang_definitions": {
                        "ru": "Создавать подобие человека или предмета с помощью живописи, рисунка или других видов изобразительного искусства.",
                        "tr": "Resim, çizim veya diğer görsel sanatlar aracılığıyla bir kişinin veya nesnenin benzerini oluşturmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изображать",
                                "target_lang_sense_clarification": "в искусстве"
                            },
                            {
                                "target_lang_word": "рисовать",
                                "target_lang_sense_clarification": "создавать изображение"
                            },
                            {
                                "target_lang_word": "запечатлеть",
                                "target_lang_sense_clarification": "на картине или рисунке"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "resmetmek",
                                "target_lang_sense_clarification": "sanatsal olarak çizmek veya boyamak"
                            },
                            {
                                "target_lang_word": "çizmek",
                                "target_lang_sense_clarification": "bir nesneyi görselleştirmek"
                            },
                            {
                                "target_lang_word": "betimlemek",
                                "target_lang_sense_clarification": "görsel olarak ifade etmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3bc280e2-47cd-3ef9-9587-89c1f144ad44",
                    "sense_definition": "To show or represent a specific emotion or quality through one's appearance or expression.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His tired eyes <w>portray</w> the deep exhaustion he has felt after weeks of hard work.",
                            "target_lang_translations": {
                                "ru": "Его усталые глаза <w>выражают</w> глубокое истощение, которое он чувствовал после недель тяжелой работы.",
                                "tr": "Yorgun gözleri, haftalarca süren sıkı çalışmadan sonra hissettiği derin tükenmişliği <w>yansıtıyor</w>."
                            }
                        },
                        {
                            "text": "The statues in the cathedral <w>portray</w> a sense of eternal peace and solemnity.",
                            "target_lang_translations": {
                                "ru": "Статуи в соборе <w>передают</w> ощущение вечного покоя и торжественности.",
                                "tr": "Katedraldeki heykeller, sonsuz bir huzur ve ciddiyet duygusunu <w>ifade ediyor</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "manifest",
                        "show",
                        "reflect"
                    ],
                    "antonyms": [
                        "hide",
                        "conceal"
                    ],
                    "common_phrases": [
                        "portray an image",
                        "portray a look"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Показывать или выражать определенную эмоцию или качество через внешний вид или выражение лица.",
                        "tr": "Dış görünüş veya ifade yoluyla belirli bir duyguyu veya niteliği göstermek veya yansıtmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выражать",
                                "target_lang_sense_clarification": "чувство или состояние"
                            },
                            {
                                "target_lang_word": "отражать",
                                "target_lang_sense_clarification": "внутреннее состояние"
                            },
                            {
                                "target_lang_word": "передавать",
                                "target_lang_sense_clarification": "атмосферу или эмоцию"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yansıtmak",
                                "target_lang_sense_clarification": "bir duygu veya durumu dışa vurmak"
                            },
                            {
                                "target_lang_word": "ifade etmek",
                                "target_lang_sense_clarification": "bir duyguya tercüman olmak"
                            },
                            {
                                "target_lang_word": "dışa vurmak",
                                "target_lang_sense_clarification": "bir durumu görünür kılmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eaca30d6-5cf4-39eb-80ba-38a8c2497fdb",
                    "sense_definition": "To decorate or embellish something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "decoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient walls were <w>portrayed</w> with intricate gold patterns that shimmered in the candlelight.",
                            "target_lang_translations": {
                                "ru": "Древние стены были <w>украшены</w> замысловатыми золотыми узорами, мерцавшими в свете свечей.",
                                "tr": "Antik duvarlar, mum ışığında parıldayan karmaşık altın desenlerle <w>süslenmişti</w>."
                            }
                        },
                        {
                            "text": "He sought to <w>portray</w> the hall with banners representing every family in the kingdom.",
                            "target_lang_translations": {
                                "ru": "Он стремился <w>декорировать</w> зал знаменами, представляющими каждую семью в королевстве.",
                                "tr": "Salonu, krallıktaki her aileyi temsil eden sancaklarla <w>bezemeye</w> çalıştı."
                            }
                        }
                    ],
                    "synonyms": [
                        "adorn",
                        "decorate",
                        "embellish"
                    ],
                    "antonyms": [
                        "strip",
                        "deface"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "this sense is no longer in common use"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Украшать или декорировать что-либо (устаревшее значение).",
                        "tr": "Bir şeyi süslemek veya bezemek (eski kullanım)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "украшать",
                                "target_lang_sense_clarification": "декорировать"
                            },
                            {
                                "target_lang_word": "расписывать",
                                "target_lang_sense_clarification": "стены или поверхности"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "süslemek",
                                "target_lang_sense_clarification": "dekoratif hale getirmek"
                            },
                            {
                                "target_lang_word": "bezemek",
                                "target_lang_sense_clarification": "bir yüzeyi süslerle donatmak"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}