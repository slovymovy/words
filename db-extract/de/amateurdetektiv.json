                "senses": [
                    {
                        "sense_id": "e5d59121-b290-3229-9c32-767ec6fc8e5f",
                        "entry_id": "bf21290c-7665-36a9-b20b-e4bb4ead1d5b",
                        "glosses": [
                            "Person, die als Amateur/nicht beruflich Detektivarbeit nachgeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdc6dccd-3e39-4d77-be1f-cb0f11f33ddd",
                                "sense_id": "e5d59121-b290-3229-9c32-767ec6fc8e5f",
                                "text": "„Verdammte Amateurdetektive.“"
                            },
                            {
                                "example_id": "c16f6c05-4f13-4c0b-9cfb-6581500b5488",
                                "sense_id": "e5d59121-b290-3229-9c32-767ec6fc8e5f",
                                "text": "„C. Auguste Dupin, der Amateurdetektiv in Edgar Allan Poes Klassiker Die Morde in der Rue Morgue von 1841, könnte der erste Mensch der Kriminalgeschichte sein, der ein Täterprofil aufgrund seiner Beobachtung von Verhaltensmustern erstellte.“"
                            },
                            {
                                "example_id": "0376d226-3234-4398-ae2f-33728b902f5c",
                                "sense_id": "e5d59121-b290-3229-9c32-767ec6fc8e5f",
                                "text": "„Er ist ein Priester, und in seiner Freizeit so etwas wie ein Amateurdetektiv.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
