                                        "glosses": [
                                            "The part of a fungus fruiting body which produces spore-bearing cells."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0694ecb8-c353-4e2d-97fb-7be59220243f",
                                                "sense_id": "39deed0a-6ecf-3e06-bd79-4ff56e61cd66",
                                                "text": "The Agaricales have basidiocarps which are fleshy to subfleshy or rarely, almost leathery (but if the latter then the hymenophore is not poroid)."
                                            }
                                        ]
                                    }
                                ]
                            }
