                        "examples": [
                            {
                                "example_id": "2b52f297-687f-42d0-9bdb-29c21f7b9b45",
                                "sense_id": "87d29814-09cb-312d-bc65-4f225e153a74",
                                "text": "Suddenly the flag lieutenant grabbed an air vice-marshal's daughter by the hand and dragged her past the Charltons […] Flags was always doing something of this sort, and although Paul did not know him, he disliked it […]"
                            },
                            {
                                "example_id": "d0a815d3-89d3-46bc-8f36-33d2069241c9",
                                "sense_id": "87d29814-09cb-312d-bc65-4f225e153a74",
                                "text": "[…] up the Flag Lieutenant to inform him that a cow would have to accompany the distinguished passenger. \"Flags\" was rather horrified at this, so Louis, overworked and slightly irritable, said, \"Very well — no damn cow, no damn general — […]"
                            }
                        ]
                    }
                ],
