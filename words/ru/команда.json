    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b3de1a91-1b3d-392c-8b4d-1b0db793ef4e",
                    "sense_definition": "Спортивный коллектив, группа спортсменов во главе с капитаном, выступающих вместе в соревнованиях.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "group_of_people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Наша футбольная <w>команда</w> выиграла важный матч.",
                            "target_lang_translations": {
                                "en": "Our football <w>team</w> won an important match.",
                                "zh": "我们的足球<w>队</w>赢了一场重要的比赛。"
                            }
                        },
                        {
                            "text": "Мой брат мечтает попасть в сборную <w>команду</w> страны.",
                            "target_lang_translations": {
                                "en": "My brother dreams of getting into the national <w>team</w>.",
                                "zh": "我弟弟梦想进入国家<w>队</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "футбольная команда",
                        "капитан команды",
                        "играть в команде",
                        "сборная команда"
                    ],
                    "target_lang_definitions": {
                        "en": "A sports group, a group of athletes led by a captain, competing together.",
                        "zh": "体育运动中，由队长带领、共同参加比赛的运动员群体。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "team",
                                "target_lang_sense_clarification": "sports group"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "队伍",
                                "target_lang_sense_clarification": "体育运动团体"
                            },
                            {
                                "target_lang_word": "队",
                                "target_lang_sense_clarification": "体育运动团体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b97747e4-cb75-36b0-aeeb-cf0505546fbd",
                    "sense_definition": "Устный приказ или сигнал начать какое-либо действие.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "order",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Солдаты побежали вперёд по <w>команде</w> офицера.",
                            "target_lang_translations": {
                                "en": "The soldiers ran forward at the officer's <w>command</w>.",
                                "zh": "士兵们在军官的<w>口令</w>下向前冲去。"
                            }
                        },
                        {
                            "text": "Собака хорошо знает <w>команду</w> «сидеть».",
                            "target_lang_translations": {
                                "en": "The dog knows the 'sit' <w>command</w> well.",
                                "zh": "这只狗很熟悉“坐下”这个<w>指令</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "приказ",
                        "распоряжение",
                        "указание",
                        "сигнал"
                    ],
                    "antonyms": [
                        "исполнение"
                    ],
                    "common_phrases": [
                        "дать команду",
                        "по команде",
                        "ждать команды",
                        "выполнять команду"
                    ],
                    "target_lang_definitions": {
                        "en": "A verbal order or signal to start an action.",
                        "zh": "开始某项行动的口头指令或信号。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "command",
                                "target_lang_sense_clarification": "order or signal"
                            },
                            {
                                "target_lang_word": "order",
                                "target_lang_sense_clarification": "instruction"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "口令",
                                "target_lang_sense_clarification": "口头指令"
                            },
                            {
                                "target_lang_word": "指令",
                                "target_lang_sense_clarification": "行动信号"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb6e48b6-4a46-3f5b-9145-8a94d718e5ea",
                    "sense_definition": "Группа людей, объединённых общей работой, целью или деятельностью.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "group_of_people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы любим работать в <w>команде</w> над сложными проектами.",
                            "target_lang_translations": {
                                "en": "We love working in a <w>team</w> on complex projects.",
                                "zh": "我们喜欢以<w>团队</w>形式合作处理复杂的项目。"
                            }
                        },
                        {
                            "text": "У нас очень дружная <w>команда</w> программистов.",
                            "target_lang_translations": {
                                "en": "We have a very friendly <w>team</w> of programmers.",
                                "zh": "我们有一个非常团结的程序员<w>团队</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "группа"
                    ],
                    "common_phrases": [
                        "работать в команде",
                        "дружная команда",
                        "член команды",
                        "пожарная команда"
                    ],
                    "target_lang_definitions": {
                        "en": "A group of people united by common work, goal, or activity.",
                        "zh": "因共同工作、目标或活动而结合在一起的一群人。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "team",
                                "target_lang_sense_clarification": "group working together"
                            },
                            {
                                "target_lang_word": "crew",
                                "target_lang_sense_clarification": "group of workers"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "团队",
                                "target_lang_sense_clarification": "共同工作的群体"
                            },
                            {
                                "target_lang_word": "小组",
                                "target_lang_sense_clarification": "工作群体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63dd71e1-26f5-34d7-b197-25517ed256a8",
                    "sense_definition": "Личный состав корабля или судна.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_of_people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вся <w>команда</w> корабля вышла на палубу для построения.",
                            "target_lang_translations": {
                                "en": "The entire ship's <w>crew</w> came out on deck for formation.",
                                "zh": "全体<w>船员</w>都来到甲板上集合。"
                            }
                        },
                        {
                            "text": "Капитан строго следил за дисциплиной своей <w>команды</w>.",
                            "target_lang_translations": {
                                "en": "The captain strictly monitored the discipline of his <w>crew</w>.",
                                "zh": "船长严格监督着他<w>船员</w>的纪律。"
                            }
                        }
                    ],
                    "synonyms": [
                        "экипаж"
                    ],
                    "common_phrases": [
                        "команда корабля",
                        "команда судна",
                        "спасение команды"
                    ],
                    "target_lang_definitions": {
