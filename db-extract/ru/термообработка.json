                                "target_senses": [
                                    {
                                        "sense_id": "970be3bb-b487-3c9c-9d20-05653a5e6f77",
                                        "entry_id": "80be68a7-a0ae-3e20-9592-92558757f4a1",
                                        "glosses": [
                                            "Traitement de substances, matériaux ou pièces par exposition à un profil défini de température dans le temps, dans le but d’en modifier les propriétés."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d86f451-7a0f-4bfb-8301-7c2dcabfc31d",
                                                "sense_id": "970be3bb-b487-3c9c-9d20-05653a5e6f77",
                                                "text": "Il existe plusieurs techniques ou procédés de traitement thermique du bois."
                                            },
                                            {
                                                "example_id": "02e59fac-db02-41f9-8e76-e27b7d335290",
                                                "sense_id": "970be3bb-b487-3c9c-9d20-05653a5e6f77",
                                                "text": "En métallurgie, la trempe est un traitement thermique qui consiste à refroidir rapidement un métal, à une vitesse suffisante pour emprisonner des éléments chimiques qui ont diffusé dans le solide cristallin à haute température. Elle suit un traitement thermique à une température de changement de phase ou bien de mise en solution de composés chimiques, selon le matériau, appliqué pendant le temps nécessaire à la transformation de toute la masse chauffée."
                                            }
                                        ]
                                    }
