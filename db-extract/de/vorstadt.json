                        ],
                        "form": "die Vorstadt"
                    },
                    {
                        "form_id": "801a5d66-5e0a-450a-908b-40429007e9a5",
                        "entry_id": "8ece2414-f2ef-3429-9271-fb3060b57da6",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Vorstädte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "74445fc3-9168-363e-805f-6160c46e955c",
                        "entry_id": "8ece2414-f2ef-3429-9271-fb3060b57da6",
                        "glosses": [
                            "städtischer Bezirk außerhalb der Kernstadt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e56706a2-323a-4d13-b81e-068553451e41",
                                "sense_id": "74445fc3-9168-363e-805f-6160c46e955c",
                                "text": "„Inzwischen hatte der Bus die Straße, die von der Küstenebene ins judäische Bergland hinaufführt, verlassen und erreichte nun Jerusalems westliche Vorstädte.“"
                            },
                            {
                                "example_id": "d3cbd47b-b621-4444-b0d5-44f96fa363ce",
                                "sense_id": "74445fc3-9168-363e-805f-6160c46e955c",
                                "text": "„Schon in der Vorstadt standen Händler am Straßenrand und priesen laut ihre Waren an.“"
                            },
                            {
                                "example_id": "795c282c-1863-41e5-b44b-bd7d74fb6baf",
                                "sense_id": "74445fc3-9168-363e-805f-6160c46e955c",
                                "text": "„Als er durch eine völlig fremde Vorstadt fuhr, wo keiner von ihnen je gewesen war, sah er sie plötzlich inmitten einer wimmelnden Menschenmenge aus der entgegengesetzten Richtung auf einem Fahrrad kommen wie er.“"
                            },
                            {
                                "example_id": "ec49bbfa-6826-483a-b6f5-99a7a91c2aab",
                                "sense_id": "74445fc3-9168-363e-805f-6160c46e955c",
                                "text": "„Ich sah wieder aus dem Fenster, hinter dem sich die Landschaft langsam wandelte, die Vorstadt sich ausdünnte und Feldern und Wäldern wich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55654223-1e21-4c60-bd1c-52ce7d781b15",
                        "source_entry_id": "8ece2414-f2ef-3429-9271-fb3060b57da6",
                        "source_sense_id": "74445fc3-9168-363e-805f-6160c46e955c",
                        "source_sense_description": "städtischer Bezirk außerhalb der Kernstadt",
                        "target_lang_word": "banlieue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "banlieue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9bb660c4-d1d7-3c31-a575-0d7c5b10ee04",
                                        "entry_id": "0e04b36d-5995-3f09-9173-cc995b0f9013",
                                        "glosses": [
                                            "Étendue de pays qui entoure une ville et qui en est souvent une dépendance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9bfa825-e8d9-45c9-94cb-972e19d11643",
                                                "sense_id": "9bb660c4-d1d7-3c31-a575-0d7c5b10ee04",
                                                "text": "C’était la vilaine limite où l’on commence, par la laideur de la banlieue, à entrer dans l’activité du tourbillon de Paris."
                                            },
                                            {
                                                "example_id": "0a867cee-4138-40b7-bf7d-ae0c957de793",
                                                "sense_id": "9bb660c4-d1d7-3c31-a575-0d7c5b10ee04",
                                                "text": "Dans les environs immédiats de Zurich […], la campagne est devenue la banlieue…, laquelle banlieue, comme toutes celles des grandes villes, n’est qu’une interminable défilade de bâtisses vulgaires, d’usines et de cités ouvrières."
                                            },
                                            {
                                                "example_id": "7d39541a-65a4-433b-ae10-f3f1b4b96408",
                                                "sense_id": "9bb660c4-d1d7-3c31-a575-0d7c5b10ee04",
                                                "text": "Nous rencontrons dans la banlieue de pauvres jardinets où les indigènes cultivent quelques légumes, et qu’ils ornent de saules, de sureaux et de groseilliers ; […]."
                                            },
                                            {
                                                "example_id": "0ce3c042-b1df-462d-ab45-f87f49cdc004",
                                                "sense_id": "9bb660c4-d1d7-3c31-a575-0d7c5b10ee04",
                                                "text": "A sept kilomètres de Sedan, la petite commune de Rubécourt-et-Lamécourt pouvait sembler, il y a une vingtaine d'années, destinée à devenir la banlieue de cette cité industrielle de 25 000 habitants. […]. Mais ici, le terrain à bâtir a manqué : […]."
                                            },
                                            {
                                                "example_id": "0eff3691-b3ac-46bc-9d1e-cd1ce8a3f7a7",
                                                "sense_id": "9bb660c4-d1d7-3c31-a575-0d7c5b10ee04",
                                                "text": "L’opposition souvent faite entre banlieues françaises, réputées populaires et terres d’exclusion, et les banlieues anglo-saxonnes, réputées pavillonnaires et peuplées par les classes moyennes ou riches, est largement fausse. À Paris, la banlieue qui s’est d’abord développée, dans la première moitié du 19ᵉ siècle, est la banlieue bourgeoise (Maisons-Laffitte, Le Vésinet…), et c’est pour la desservir que le chemin de fer est apparu (ligne de Paris à Saint-Germain-en-Laye)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c92c397-15a5-393f-9a72-22e55862e75c",
                                        "entry_id": "0e04b36d-5995-3f09-9173-cc995b0f9013",
                                        "glosses": [
                                            "Espace populaire urbain habité principalement par une population en précarité économique et issue d’une immigration récente."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd4cc192-1bb5-4e93-a43a-dd7bc25ee24c",
                                                "sense_id": "8c92c397-15a5-393f-9a72-22e55862e75c",
                                                "text": "“Meufs de (la) cité” sur France.tv : “Le pays d’origine de ces filles, c’est la banlieue”"
                                            },
                                            {
                                                "example_id": "0a204cbd-571f-46cb-abfd-61b14d4cb245",
                                                "sense_id": "8c92c397-15a5-393f-9a72-22e55862e75c",
                                                "text": "De l’autre, ce sont les conflits autour de la définition et du contrôle (c’est-à-dire de l’appropriation) d’espaces d’appartenance collective — ce qu’on appelle de plus en plus, sans précision, « les banlieues », ou « les quartiers » (le pluriel sert à distinguer implicitement cette notion, purement politique, du concept spatial qu’est la banlieue ou le quartier…)."
                                            },
                                            {
                                                "example_id": "5145ae33-75bf-4c9d-97aa-a20ab91b29b5",
                                                "sense_id": "8c92c397-15a5-393f-9a72-22e55862e75c",
                                                "text": "L’autre jour, un ado, dans les clichés de la mode débile des banlieues, parlait à base de « yo » et de « wesh », ne sachant exprimer sa douleur abdominale : le nouveau beauf en quelque sorte !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49bf947a-7ba5-43b7-b008-841c49c2d781",
                        "source_entry_id": "8ece2414-f2ef-3429-9271-fb3060b57da6",
                        "source_sense_id": "74445fc3-9168-363e-805f-6160c46e955c",
