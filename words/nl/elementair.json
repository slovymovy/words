                    "sense_id": "5dbfaef3-80cd-39ab-b172-49e4da7b721c",
                    "sense_definition": "betrekking hebbend op de basis of de eerste beginselen van iets",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "basis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In deze <w>elementaire</w> cursus natuurkunde worden de wetten van Newton behandeld.",
                            "target_lang_translations": {
                                "en": "In this <w>elementary</w> physics course, Newton's laws are covered."
                            }
                        },
                        {
                            "text": "Het is een <w>elementair</w> onderdeel van onze democratie dat iedereen zijn mening mag uiten.",
                            "target_lang_translations": {
                                "en": "It is a <w>fundamental</w> part of our democracy that everyone is allowed to express their opinion."
                            }
                        },
                        {
                            "text": "Sommige organisaties vergeten zelfs de meest <w>elementaire</w> voorzorgsmaatregelen te nemen.",
                            "target_lang_translations": {
                                "en": "Some organizations forget to take even the most <w>basic</w> precautions."
                            }
                        }
                    ],
                    "synonyms": [
