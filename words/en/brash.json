{
    "word_family": [
        "brashness",
        "brashly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5e29ffa9-3a82-34db-a14c-3b5f4ee73d3d",
                    "sense_definition": "Overly bold, self-assertive, or impudent in an insensitive or disrespectful way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "boldness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>brash</w> young executive interrupted his senior colleagues throughout the meeting.",
                            "target_lang_translations": {
                                "de": "Die <w>dreiste</w> junge Führungskraft unterbrach ihre älteren Kollegen während des gesamten Meetings."
                            }
                        },
                        {
                            "text": "Her <w>brash</w> attitude irritated many people who were used to polite conversation.",
                            "target_lang_translations": {
                                "de": "Ihre <w>forsche</w> Art irritierte viele Leute, die an höfliche Konversationen gewöhnt waren."
                            }
                        }
                    ],
                    "synonyms": [
                        "cocky",
                        "brazen",
                        "audacious"
                    ],
                    "common_phrases": [
                        "brash young man",
                        "brash attitude",
                        "brash manner"
                    ],
                    "target_lang_definitions": {
                        "de": "Übermäßig forsch, dreist oder aufdringlich; unverschämt oder taktlos auftretend."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "dreist",
                                "target_lang_sense_clarification": "ohne Respekt oder Zurückhaltung"
                            },
                            {
                                "target_lang_word": "forsch",
                                "target_lang_sense_clarification": "übermäßig forsch, energisch bis anmaßend"
                            },
                            {
                                "target_lang_word": "vorlaut",
                                "target_lang_sense_clarification": "ungehörig frech oder unbedacht sprechend"
                            },
                            {
                                "target_lang_word": "nassforsch",
                                "target_lang_sense_clarification": "arrogant und ungehobelt forsch"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "162c2b20-66c1-3dff-96d8-42a2a386557e",
                    "sense_definition": "Hasty, reckless, or impetuous; acting without sufficient forethought.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "boldness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not make any <w>brash</w> decisions while you are still angry about the situation.",
                            "target_lang_translations": {
                                "de": "Triff keine <w>voreiligen</w> Entscheidungen, solange du noch wütend über die Situation bist."
                            }
                        },
                        {
                            "text": "Quitting his job without another offer lined up was a singularly <w>brash</w> move.",
                            "target_lang_translations": {
                                "de": "Seinen Job zu kündigen, ohne ein anderes Angebot in Aussicht zu haben, war ein ausgesprochen <w>unbesonnener</w> Schritt."
                            }
                        }
                    ],
                    "synonyms": [
                        "reckless",
                        "foolhardy"
                    ],
                    "common_phrases": [
                        "brash decision",
                        "brash act"
                    ],
                    "target_lang_definitions": {
                        "de": "Voreilig, unbesonnen oder unüberlegt; ohne gründliches Nachdenken handelnd."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "voreilig",
                                "target_lang_sense_clarification": "übereilt, ohne Überlegung"
                            },
                            {
                                "target_lang_word": "unbesonnen",
                                "target_lang_sense_clarification": "leichtsinnig oder vorschnell handelnd"
                            },
                            {
                                "target_lang_word": "überstürzt",
                                "target_lang_sense_clarification": "zu hastig und unüberlegt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f416c12f-1e6e-3c85-9a27-72796a4f168c",
                    "sense_definition": "Tastelessly bright, loud, or showy in appearance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shop was decorated with <w>brash</w> neon signs that clashed with the historic street.",
                            "target_lang_translations": {
                                "de": "Das Geschäft war mit <w>grellen</w> Neonschildern dekoriert, die sich mit der historischen Straße bissen."
                            }
                        },
                        {
                            "text": "He preferred understated elegance rather than wearing clothes with <w>brash</w> colors.",
                            "target_lang_translations": {
                                "de": "Er bevorzugte dezente Eleganz, anstatt Kleidung in <w>knalligen</w> Farben zu tragen."
                            }
                        }
                    ],
                    "synonyms": [
                        "garish",
                        "gaudy",
                        "flashy",
                        "loud"
                    ],
                    "common_phrases": [
                        "brash colors"
                    ],
                    "target_lang_definitions": {
                        "de": "Geschmacklos leuchtend, auffällig oder schreiend bunt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "knallig",
                                "target_lang_sense_clarification": "sehr leuchtend oder auffallend bunt"
                            },
                            {
                                "target_lang_word": "schrill",
                                "target_lang_sense_clarification": "optisch extrem grell oder aufdringlich"
                            },
                            {
                                "target_lang_word": "grell",
                                "target_lang_sense_clarification": "unangenehm hell oder intensiv farbig"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67b0be30-92c2-37f6-9183-fe4fa95cbc27",
                    "sense_definition": "Brittle or easily snapped, especially of timber or vegetables.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Carpenters avoided using <w>brash</w> timber because it tended to fracture under heavy strain.",
                            "target_lang_translations": {
                                "de": "Zimmerleute vermieden es, <w>sprödes</w> Bauholz zu verwenden, da es unter starker Belastung zum Brechen neigte."
                            }
                        },
                        {
                            "text": "The dried twigs were dry and <w>brash</w>, breaking cleanly when bent.",
                            "target_lang_translations": {
                                "de": "Die Zweige waren trocken und <w>brüchig</w> und brachen sauber entzwei, wenn man sie bog."
                            }
                        }
                    ],
                    "common_phrases": [
                        "brash timber"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical or dialectal usage regarding wood quality"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Spröde, brüchig oder leicht brechend, insbesondere bei Holz."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "brüchig",
                                "target_lang_sense_clarification": "leicht brechend oder rissig"
                            },
                            {
                                "target_lang_word": "spröde",
                                "target_lang_sense_clarification": "unelastisch und schnell splitternd"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bc19ddf8-c59e-3b13-b427-e03218e99b0a",
                    "sense_definition": "A collection of loose hedge clippings, twigs, or fallen leaves.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fragments",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener gathered the hedge <w>brash</w> into a pile to prepare for burning.",
                            "target_lang_translations": {
                                "de": "Der Gärtner sammelte das <w>Hecken-Schnittgut</w> auf einem Haufen, um es für das Verbrennen vorzubereiten."
                            }
                        },
                        {
                            "text": "Beneath the trees lay a thick carpet of loose twigs and forest <w>brash</w>.",
                            "target_lang_translations": {
                                "de": "Unter den Bäumen lag ein dicker Teppich aus losen Zweigen und <w>Waldreisig</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly British forestry and gardening term"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ansammlung von Hecken- oder Baumschnitt, Zweigen oder Reisig."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Reisig",
                                "target_lang_sense_clarification": "abgebrochene oder geschnittene dünne Zweige"
                            },
                            {
                                "target_lang_word": "Schnittgut",
                                "target_lang_sense_clarification": "beim Stutzen von Hecken und Bäumen anfallendes Astwerk"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee32645f-09ac-3031-9de9-763b17abec94",
                    "sense_definition": "Loose, angular rock fragments or rubble lying beneath alluvial soils.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fragments",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The excavators had to dig through layers of stone <w>brash</w> before reaching solid bedrock.",
                            "target_lang_translations": {
                                "de": "Die Bagger mussten sich durch Schichten aus losem <w>Gesteinsschutt</w> graben, bevor sie festes Grundgestein erreichten."
                            }
                        },
                        {
                            "text": "Geologists identified the stony layer as limestone <w>brash</w> common in the valley.",
                            "target_lang_translations": {
                                "de": "Geologen identifizierten die steinige Schicht als <w>Kalksteinschutt</w>, der im Tal häufig vorkommt."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Lockeres, kantiges Gesteinsmaterial oder Schutt unter Bodenschichten."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Schutt",
                                "target_lang_sense_clarification": "lockere Gesteinstrümmer"
                            },
                            {
                                "target_lang_word": "Geröll",
                                "target_lang_sense_clarification": "Ansammlung von Steinen oder Gesteinsfragmenten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b5ec806-2901-3feb-b57d-9d432ed0f64b",
                    "sense_definition": "A mass of floating, broken fragments of ice on water.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fragments",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The exploration ship pushed through floating <w>brash</w> as it entered the freezing bay.",
                            "target_lang_translations": {
                                "de": "Das Forschungsschiff schob sich durch treibendes <w>Trümmereis</w>, als es in die eisige Bucht einfuhr."
                            }
                        },
                        {
                            "text": "Thick ice <w>brash</w> made navigating the small rescue boat extremely hazardous.",
                            "target_lang_translations": {
                                "de": "Dichtes <w>Treibeis</w> machte die Steuerung des kleinen Rettungsboots extrem gefährlich."
                            }
                        }
                    ],
                    "common_phrases": [
                        "brash ice"
                    ],
                    "target_lang_definitions": {
                        "de": "Auf dem Wasser treibende Masse aus zerkleinertem Treibeis oder Eistrümmern."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Trümmereis",
                                "target_lang_sense_clarification": "zerbrochene, auf dem Wasser treibende Eisstücke"
                            },
                            {
                                "target_lang_word": "Treibeis",
                                "target_lang_sense_clarification": "zerstossene, schwimmende Eismasse"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa0efecc-7ce0-3d12-95ab-86db24f8d0d3",
                    "sense_definition": "A sudden skin rash, or a transient fit of sickness or digestive discomfort.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient experienced an uncomfortable water <w>brash</w> shortly after eating.",
                            "target_lang_translations": {
                                "de": "Der Patient verspürte kurz nach dem Essen unangenehmes saures <w>Aufstoßen</w>."
                            }
                        },
                        {
                            "text": "A sudden skin <w>brash</w> appeared on his arms after handling the garden weeds.",
                            "target_lang_translations": {
                                "de": "Ein plötzlicher <w>Hautausschlag</w> zeigte sich auf seinen Armen, nachdem er mit dem Unkraut im Garten hantiert hatte."
                            }
                        }
                    ],
                    "common_phrases": [
                        "water brash"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "now largely restricted to medical terms like water brash"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Plötzlicher Hautausschlag oder ein kurzer Anfall von Magenbeschwerden bzw. Sodbrennen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Hautausschlag",
                                "target_lang_sense_clarification": "plötzliche Rötung oder Reizung der Haut"
                            },
                            {
                                "target_lang_word": "Sodbrennen",
                                "target_lang_sense_clarification": "saurer Magensaftrückfluss (insbesondere bei water brash)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3824143f-2ea5-3975-a22a-03b7a44c96ca",
                    "sense_definition": "A sudden, brief burst or shower of rain.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We ran into the nearest barn to shelter from a sudden <w>brash</w> of heavy rain.",
                            "target_lang_translations": {
                                "de": "Wir rannten in die nächste Scheune, um vor einem plötzlichen schweren <w>Regenschauer</w> Schutz zu suchen."
                            }
                        },
                        {
                            "text": "The brief <w>brash</w> passed quickly, leaving the fields damp under the afternoon sun.",
                            "target_lang_translations": {
                                "de": "Die kurze <w>Husche</w> zog rasch vorüber und hinterließ feuchte Felder unter der Nachmittagssonne."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "chiefly northern English and Scottish"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein plötzlicher, kurzer Regenschauer."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Regenschauer",
                                "target_lang_sense_clarification": "kurzer, heftiger Niederschlag"
                            },
                            {
                                "target_lang_word": "Husche",
                                "target_lang_sense_clarification": "kurzer Regenguss"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86eaa254-04ca-3c21-aa75-d32712ae3177",
                    "sense_definition": "A sudden physical attack, rush, or assault.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fortress garrison successfully resisted a violent <w>brash</w> from the enemy troops.",
                            "target_lang_translations": {
                                "de": "Die Festungsbesatzung wehrte einen heftigen <w>Ansturm</w> der feindlichen Truppen erfolgreich ab."
                            }
                        },
                        {
                            "text": "He managed to dodge the first sudden <w>brash</w> of his opponent in the skirmish.",
                            "target_lang_translations": {
                                "de": "Es gelang ihm, dem ersten plötzlichen <w>Angriff</w> seines Gegners im Scharmützel auszuweichen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rare and historical"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein plötzlicher physischer Angriff oder Ansturm."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Ansturm",
                                "target_lang_sense_clarification": "plötzliches Vorstürmen oder Angreifen"
                            },
                            {
                                "target_lang_word": "Angriff",
                                "target_lang_sense_clarification": "Überfall oder Attacke"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "76a908c7-6e1a-368b-8f94-69c02e24e3b1",
                    "sense_definition": "To disturb, unsettle, or vex someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The unexpected visitors seemed to <w>brash</w> the elderly host during his evening rest.",
                            "target_lang_translations": {
                                "de": "Die unerwarteten Besucher schienen den älteren Gastgeber bei seiner Abendruhe zu <w>beunruhigen</w>."
                            }
                        },
                        {
                            "text": "Constant interruptions served only to <w>brash</w> her while she tried to concentrate.",
                            "target_lang_translations": {
                                "de": "Ständige Unterbrechungen führten nur dazu, sie zu <w>verärgern</w>, während sie versuchte, sich zu konzentrieren."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rare and dialectal"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Jemanden beunruhigen, ärgern oder aufregen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "beunruhigen",
                                "target_lang_sense_clarification": "aus der Fassung bringen"
                            },
                            {
                                "target_lang_word": "verärgern",
                                "target_lang_sense_clarification": "Unmut oder Zorn hervorrufen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "979e20bc-a71c-317c-a33b-99f2d6c93302",
                    "sense_definition": "A surname transferred from the nickname or occupational origins.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Professor <w>Brash</w> published several influential studies on Celtic archaeology during his career.",
                            "target_lang_translations": {
                                "de": "Professor <w>Brash</w> veröffentlichte im Laufe seiner Karriere mehrere einflussreiche Studien zur keltischen Archäologie."
                            }
                        },
                        {
                            "text": "The detective interviewed Mr. <w>Brash</w> regarding the missing documents from the office.",
                            "target_lang_translations": {
                                "de": "Der Detektiv befragte Herrn <w>Brash</w> zu den aus dem Büro verschwundenen Dokumenten."
                            }
                        }
                    ],
                    "traits": [
