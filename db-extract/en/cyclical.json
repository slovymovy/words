                    {
                        "translation_id": "53bcee95-bdfc-49b3-93e1-7fc28b369e48",
                        "source_entry_id": "6eaf4bbc-8645-3ac3-aea6-4ee1a179eb59",
                        "source_sense_description": "recurring at regular intervals — see also cyclic",
                        "target_lang_word": "zyklisch",
