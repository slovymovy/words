                    },
                    {
                        "translation_id": "6259aafa-ebdc-470a-bdb0-1700c7f742cd",
                        "source_entry_id": "57475da5-4248-38e8-85f0-4a0ccffe4596",
                        "source_sense_id": "b66ad01e-b3ee-31b7-9a9a-38ebeec2ebfa",
                        "target_lang_word": "Wortschwall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wortschwall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3bddeeb6-3ea0-3423-a130-1537a5d87d78",
                                        "entry_id": "f45a2ab9-ebd6-3303-94de-ec7817b8a7c3",
                                        "glosses": [
                                            "ununterbrochener, wortreicher Redefluss"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "441cbeef-912c-4dfc-98ca-e664e954c86f",
                                                "sense_id": "3bddeeb6-3ea0-3423-a130-1537a5d87d78",
                                                "text": "„Er sprach viel und schnell, und dieser Wortschwall stand in auffälligem Gegensatz zu der Aura der Tüchtigkeit, die sein Reich charakterisierte.“"
                                            },
                                            {
                                                "example_id": "b3e41175-b79a-410c-af5d-442c4da642eb",
                                                "sense_id": "3bddeeb6-3ea0-3423-a130-1537a5d87d78",
                                                "text": "„Schon in den ersten Minuten wurde mir klar, dass es eine ganze Weile dauern würde, bis ich aus diesem Wortschwall etwas Verständliches herausfiltern könnte.“"
                                            },
                                            {
                                                "example_id": "7cc3a979-7743-44bc-a403-5d87ea4803ad",
                                                "sense_id": "3bddeeb6-3ea0-3423-a130-1537a5d87d78",
                                                "text": "„Ich höre ihren Diskussionen zu, ich denke an Lauenstein, an den Wortschwall, an die Tatenlosigkeit, an die Feigheit.“"
                                            },
                                            {
                                                "example_id": "126e0501-67be-4b5a-9ef6-785710620a7f",
                                                "sense_id": "3bddeeb6-3ea0-3423-a130-1537a5d87d78",
                                                "text": "„Eine häßliche, aber aufgeweckte Frau hatte bei mir vorgesprochen und mich mit einem echt italienischen Wortschwall gebeten, ich möge mich beim Magistrat dafür einsetzen, daß man der Truppe, der sie angehöre, die Spielerlaubnis erteile.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e007e35c-5116-41c0-b8e8-d5d4da0c859b",
                        "source_entry_id": "57475da5-4248-38e8-85f0-4a0ccffe4596",
                        "source_sense_id": "b66ad01e-b3ee-31b7-9a9a-38ebeec2ebfa",
                        "target_lang_word": "Redseligkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Redseligkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f814ac59-68e4-3019-a12f-8f698a7a70a8",
                                        "entry_id": "eac94cde-89f9-3801-a6ca-41881d2aac7f",
                                        "glosses": [
                                            "Eigenschaft, gern und viel zu reden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95429a27-e0c6-468c-87c1-19bc83e38ec0",
                                                "sense_id": "f814ac59-68e4-3019-a12f-8f698a7a70a8",
                                                "text": "Aufgrund seiner Redseligkeit ist er ein gefürchteter Kunde."
                                            },
                                            {
                                                "example_id": "60b4a866-595a-4508-bc6b-e5103392bbc7",
                                                "sense_id": "f814ac59-68e4-3019-a12f-8f698a7a70a8",
                                                "text": "„Grenfeld orderte mit einer seit Jahren eingeübten Handbewegung zwei Whiskeys und hoffte auf die einsetzende Redseligkeit seines Kollegen.“"
                                            },
                                            {
                                                "example_id": "a0d4c379-823d-4e5a-a8ee-0b4507ffd55b",
                                                "sense_id": "f814ac59-68e4-3019-a12f-8f698a7a70a8",
                                                "text": "„Schließlich gilt auch der Niederdeutsche dem Oberdeutschen als bedächtig und trocken, eher zur Wortkargheit als zur Redseligkeit geneigt.“"
                                            },
                                            {
                                                "example_id": "c99328fe-ce0e-4451-bf95-8c81695cbd12",
                                                "sense_id": "f814ac59-68e4-3019-a12f-8f698a7a70a8",
                                                "text": "„Ihre Redseligkeit brachte mich zum Lachen.“"
                                            },
                                            {
                                                "example_id": "30c4b3db-2180-4682-ae3b-c7df5b21e982",
                                                "sense_id": "f814ac59-68e4-3019-a12f-8f698a7a70a8",
                                                "text": "„Tüchtigkeit und Redseligkeit passen nicht zusammen, da ist etwas schief.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d54a78a-2ddc-4758-8556-be2b2e64cb9e",
                        "source_entry_id": "57475da5-4248-38e8-85f0-4a0ccffe4596",
                        "source_sense_id": "b66ad01e-b3ee-31b7-9a9a-38ebeec2ebfa",
                        "target_lang_word": "verbosité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verbosité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6b6460a1-d722-3afc-bbf8-263230862787",
                                        "entry_id": "bb8477c1-76e8-372d-b529-ef57b39adaaf",
                                        "glosses": [
                                            "Caractère, défaut de ce qui est verbeux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f8963dc-289e-4c15-9135-2a662b72e6c3",
                                                "sense_id": "6b6460a1-d722-3afc-bbf8-263230862787",
                                                "text": "Elle pensait que cette verbosité épineuse n’était que l’appareil de défense d’une trop tendre amande."
                                            },
                                            {
                                                "example_id": "e21715c5-505b-4c85-9331-cb212b912b53",
                                                "sense_id": "6b6460a1-d722-3afc-bbf8-263230862787",
                                                "text": "Verbeux à la manière italienne qui prend souvent la verbosité pour l’éloquence, le faste pour la richesse, l’agitation pour le mouvement, la fébrilité pour le transport divin."
                                            },
                                            {
                                                "example_id": "f86ea4b4-7376-4d0c-9fab-529ec8f09cbc",
                                                "sense_id": "6b6460a1-d722-3afc-bbf8-263230862787",
                                                "text": "La verbosité de cet avocat, de son éloquence."
                                            },
                                            {
                                                "example_id": "5d8ea3d8-b910-4471-83c5-d85a68bc7855",
                                                "sense_id": "6b6460a1-d722-3afc-bbf8-263230862787",
                                                "text": "Ce mémoire est d’une verbosité insupportable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
