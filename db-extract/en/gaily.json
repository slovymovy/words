                    },
                    {
                        "translation_id": "2fb5b9ff-9400-4499-8a92-0ce6526a583c",
                        "source_entry_id": "4e7d4ee9-09fb-3c3f-ba35-1dc61836bcd9",
                        "source_sense_description": "merrily",
                        "target_lang_word": "gaiement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gaiement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "746b8040-f387-3ebe-823d-a1ec89504095",
                                        "entry_id": "1200bf09-b26a-31d2-91d4-82b069e14d05",
                                        "glosses": [
                                            "D’une manière gaie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "641e4e88-5c73-4dda-bd79-562499de1f57",
                                                "sense_id": "746b8040-f387-3ebe-823d-a1ec89504095",
                                                "text": "Et nous nous promenons là tout gaiement, jusqu'à la route qui descend vers le canal […]"
                                            },
                                            {
                                                "example_id": "ba05437b-0809-4c26-81a0-0cd14a0feb8f",
                                                "sense_id": "746b8040-f387-3ebe-823d-a1ec89504095",
                                                "text": "Voilà l'image de ma vie :je devrais fredonner gaiement sous la douche, tout à la joie de ce jour nouveau, et je m'engonce dans l’amère moiteur de maussades ruminements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f375998-10f7-3d0b-becd-36a81232ac99",
                                        "entry_id": "1200bf09-b26a-31d2-91d4-82b069e14d05",
                                        "glosses": [
                                            "Rapidement, d'un bon train."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04b98bd5-52c8-4971-a792-a1b3ba93f483",
                                                "sense_id": "7f375998-10f7-3d0b-becd-36a81232ac99",
                                                "text": "Aller gaiement : Aller son train."
                                            },
                                            {
                                                "example_id": "f2a7a3cf-3a9f-4f54-8b84-670fe56d7974",
                                                "sense_id": "7f375998-10f7-3d0b-becd-36a81232ac99",
                                                "text": "Allez-y gaiement ! Que l’orbe d’argent\nCroisse sur vos fronts son reflet changeant ;\nBien avant dans la nuit, à la Saint-Jean\nDansez la villanelle !"
                                            },
                                            {
                                                "example_id": "31c1bac9-f97f-40be-9558-fbfcc5440040",
                                                "sense_id": "7f375998-10f7-3d0b-becd-36a81232ac99",
                                                "text": "Tout cela nous avait même paru un bizarre assemblage de choses : un village d’Algérie, une soirée d’hiver très froide, et une pauvre noce campagnarde défilant gaiement en musique, au crépuscule, devant des Bédouins et des chameaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
