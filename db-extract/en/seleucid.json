        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "024e4ade-d05a-39d2-a526-e556949f504e",
                "word": "Seleucid",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "583c78e6-9433-3e7b-87bd-87f5005e59dc",
                        "entry_id": "024e4ade-d05a-39d2-a526-e556949f504e",
                        "glosses": [
                            "Relating to the Greek-Macedonian dynasty which ruled (312–63 BCE) an empire created by Seleucus out of the eastern conquests of Alexander the Great."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "29df66bd-ae76-481f-a211-9712d94a7120",
                                "sense_id": "583c78e6-9433-3e7b-87bd-87f5005e59dc",
                                "text": "An extraordinary material reflection of close Ptolemaic-Seleucid relations was the gift, in 190 BCE or shortly thereafter, of a Ptolemaic gold mnaeion, the largest regularly minted gold issue in the Greek world, conveyed by some high Ptolemaic official to a similarly situated Seleucid counterpart, […]"
                            },
                            {
                                "example_id": "b2e7dc0a-c016-4037-86bd-435f8883584b",
                                "sense_id": "583c78e6-9433-3e7b-87bd-87f5005e59dc",
                                "text": "The Seleucid and Dendera Zodiacs are illustrations of the pictograph tradition from the 5th phase, showing the zodiac plus the four ‘parazodiacal’ animals (crow, serpent, eagle, and southern fish)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6cc4d83-2cd5-4b64-8d6e-b6ce4661092a",
                        "source_entry_id": "024e4ade-d05a-39d2-a526-e556949f504e",
                        "source_sense_id": "583c78e6-9433-3e7b-87bd-87f5005e59dc",
                        "source_sense_description": "relating to the dynasty",
                        "target_lang_word": "séleucide",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "séleucide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "94868658-279a-36b7-bc03-40b160b5c5e6",
                                        "entry_id": "bc87e29d-c13a-3c65-8924-28e3fa79e1e6",
                                        "glosses": [
                                            "Relatif à la dynastie de l’époque hellénistique des Séleucides."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81d07026-69af-48de-907f-da7a9cbae507",
                                                "sense_id": "94868658-279a-36b7-bc03-40b160b5c5e6",
                                                "text": "Le monnayage d’Auguste est particulièrement bien représenté à Reims, tout comme les échanges, sans doute indirects et de toute façon plus tardifs, avec des contrées lointaines telles que Nicomédie, ville d’Asie Mineure, ou la Syrie des rois séleucides, par exemple."
                                            },
                                            {
                                                "example_id": "de7275d9-a471-415a-a989-1ab272986959",
                                                "sense_id": "94868658-279a-36b7-bc03-40b160b5c5e6",
                                                "text": "Les textes d’époque séleucide consistent principalement en de grandes listes d’inverses, ces tables répondant probablement aux besoins induits par le développement de l’astronomie mathématique. Par exemple, une tablette d’époque séleucide, provenant d’Uruk et exposée au Musée du Louvre (AO 6456), contient presque tous les nombres inversibles en base 60 commençant par 1 ou 2 et comportant jusqu’à 6 positions sexagésimales."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
