                        "tags": [],
                        "examples": [
                            {
                                "example_id": "862a9a76-6524-4962-aea2-42dd2a510f63",
                                "sense_id": "d8cb57ad-285c-3368-a2e3-5c4396a4e8c8",
                                "text": "Even the technical terms of abstruse science have been allowed to mingle with the lispings of the nursery."
