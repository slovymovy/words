{
    "word_family": [
        "seducer",
        "seduction",
        "seductive",
        "seductress"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8a98f85f-988d-3409-baf0-50740fdefa6d",
                    "sense_definition": "To win over, attract, or charm someone, often by presenting something highly appealing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many young artists are <w>seduced</w> by the promise of quick fame and fortune in the big city.",
                            "target_lang_translations": {
                                "ru": "Многих молодых художников <w>соблазняет</w> обещание быстрой славы и богатства в большом городе."
                            }
                        },
                        {
                            "text": "The beautiful scenery and peaceful atmosphere of the island can easily <w>seduce</w> any traveler.",
                            "target_lang_translations": {
                                "ru": "Красивые пейзажи и мирная атмосфера острова могут легко <w>прельстить</w> любого путешественника."
                            }
                        }
                    ],
                    "synonyms": [
                        "beguile",
                        "allure",
                        "entrance"
                    ],
                    "antonyms": [
                        "repel",
                        "disgust"
                    ],
                    "common_phrases": [
                        "seduced by the promise",
                        "seduce the audience"
                    ],
                    "target_lang_definitions": {
                        "ru": "Привлекать, очаровывать или манить кого-либо, часто предлагая что-то крайне привлекательное."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соблазнять",
                                "target_lang_sense_clarification": "привлекать чем-то заманчивым"
                            },
                            {
                                "target_lang_word": "соблазнить",
                                "target_lang_sense_clarification": "привлечь, прельстить"
                            },
                            {
                                "target_lang_word": "прельщать",
                                "target_lang_sense_clarification": "притягивать к себе, манить"
                            },
                            {
                                "target_lang_word": "прельстить",
                                "target_lang_sense_clarification": "подчинить своему обаянию, очаровать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d24c2e0d-b107-3439-b23f-9e0694cc3847",
                    "sense_definition": "To entice or persuade someone to engage in a sexual relationship.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sexual_enticement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the movie, the older woman attempts to <w>seduce</w> the young college graduate.",
                            "target_lang_translations": {
                                "ru": "В фильме пожилая женщина пытается <w>соблазнить</w> молодого выпускника колледжа."
                            }
                        },
                        {
                            "text": "He tried to <w>seduce</w> her with romantic music, dim lighting, and a home-cooked dinner.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>обольстить</w> её романтической музыкой, приглушенным светом и домашним ужином."
                            }
                        }
                    ],
                    "synonyms": [
                        "debauch",
                        "vamp"
                    ],
                    "common_phrases": [
                        "try to seduce"
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонять или убеждать кого-либо вступить в сексуальные отношения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соблазнять",
                                "target_lang_sense_clarification": "добиваться интимной близости"
                            },
                            {
                                "target_lang_word": "соблазнить",
                                "target_lang_sense_clarification": "добиться сексуального обладания"
                            },
                            {
                                "target_lang_word": "обольщать",
                                "target_lang_sense_clarification": "склонять к сожительству"
                            },
                            {
                                "target_lang_word": "обольстить",
                                "target_lang_sense_clarification": "склонить к близости, соблазнить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "964be464-2230-3a1e-98df-e895d75121fc",
                    "sense_definition": "To lead someone astray from duty, accepted principles, or proper moral conduct.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "corrupt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young soldier was <w>seduced</w> by the enemy's propaganda and ended up betraying his country.",
                            "target_lang_translations": {
                                "ru": "Молодой солдат был <w>совращен</w> вражеской пропагандой и в итоге предал свою страну."
                            }
                        },
                        {
                            "text": "We must ensure that greed does not <w>seduce</w> our leaders into making dishonest decisions.",
                            "target_lang_translations": {
                                "ru": "Мы должны сделать так, чтобы жадность не <w>соблазнила</w> наших лидеров на принятие нечестных решений."
                            }
                        }
                    ],
                    "synonyms": [
                        "lead astray",
                        "corrupt",
                        "misguide"
                    ],
                    "common_phrases": [
                        "seduced by power"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сбивать кого-либо с пути долга, принятых принципов или надлежащего морального поведения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совращать",
                                "target_lang_sense_clarification": "склонять к предосудительным поступкам, сбивать с пути"
                            },
                            {
                                "target_lang_word": "совратить",
                                "target_lang_sense_clarification": "сбить с правильного жизненного пути, склонить к греху"
                            },
                            {
                                "target_lang_word": "соблазнить",
                                "target_lang_sense_clarification": "склонить к чему-либо предосудительному"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ed6eb47-4436-3e1f-96ca-4664eb4fa8ee",
                    "sense_definition": "To have sexual intercourse with someone.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sexual_enticement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The novel describes a scandalous affair where a nobleman managed to <w>seduce</w> the housekeeper.",
                            "target_lang_translations": {
                                "ru": "В романе описывается скандальный роман, в котором дворянину удалось <w>соблазнить</w> экономку."
                            }
                        },
                        {
                            "text": "He was accused of using his position of authority to <w>seduce</w> several of his subordinates.",
                            "target_lang_translations": {
                                "ru": "Его обвинили в использовании своего служебного положения для того, чтобы <w>совратить</w> нескольких своих подчиненных."
                            }
                        }
                    ],
                    "synonyms": [
                        "sleep with",
                        "go to bed with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вступать в сексуальную связь с кем-либо, обычно путем соблазнения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соблазнить",
                                "target_lang_sense_clarification": "добиться обладания кем-либо"
                            },
                            {
                                "target_lang_word": "совратить",
                                "target_lang_sense_clarification": "добиться полового контакта"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}