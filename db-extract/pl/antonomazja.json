                                        "entry_id": "9413ff9e-db76-3507-a19a-9c1a43ca9179",
                                        "glosses": [
                                            "The substitution of an epithet or title in place of a proper noun."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rhetoric",
