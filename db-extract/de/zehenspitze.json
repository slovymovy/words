                    }
                ],
                "senses": [
                    {
                        "sense_id": "1d49de5b-4725-35b0-af1a-27fc0af12be8",
                        "entry_id": "8f1c0570-6bbb-3a8c-b2f3-44e294d4dddc",
                        "glosses": [
                            "vorderster Bereich einer Zehe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20546dbd-8b17-41e8-a28a-f1b87674cc0c",
                                "sense_id": "1d49de5b-4725-35b0-af1a-27fc0af12be8",
                                "text": "„Auf Zehenspitzen betrat ich den Kellervorhof und hielt Ausschau nach einem Lichtschimmer.“"
                            },
                            {
                                "example_id": "d0297306-9f54-4dd6-8437-79cf5d38f990",
                                "sense_id": "1d49de5b-4725-35b0-af1a-27fc0af12be8",
                                "text": "„Auf Zehenspitzen schlich sie in sein Zimmer hinüber.“"
                            },
                            {
                                "example_id": "78678855-86c7-4dab-be96-2fc3b6dbf22c",
                                "sense_id": "1d49de5b-4725-35b0-af1a-27fc0af12be8",
                                "text": "„Vorsichtig auf Zehenspitzen schlich sich Wyndham an die Bar heran und goß sich ein ansehnliches Quantum Whisky mit Wasser ein.“"
                            },
                            {
                                "example_id": "167c0509-a8e2-44ab-b224-1ae4cfb4823d",
                                "sense_id": "1d49de5b-4725-35b0-af1a-27fc0af12be8",
                                "text": "„Sie kippelte mit dem Stuhl und spielte mit den Holzschuhen, die an ihren Zehenspitzen baumelten.“"
                            },
                            {
                                "example_id": "13bfad46-1e24-4c89-933b-6f08a67659b7",
                                "sense_id": "1d49de5b-4725-35b0-af1a-27fc0af12be8",
                                "text": "„Ida ging, das Suppentablett in Händen, auf Zehenspitzen zum Krankenzimmer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "36ba3ab4-4b6f-4fb4-8d62-ff46208edb2c",
                        "source_entry_id": "8f1c0570-6bbb-3a8c-b2f3-44e294d4dddc",
                        "source_sense_id": "1d49de5b-4725-35b0-af1a-27fc0af12be8",
                        "source_sense_description": "vorderster Bereich einer Zehe",
                        "target_lang_word": "tiptoe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tiptoe",
