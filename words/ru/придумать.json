                },
                {
                    "sense_id": "65a8ac5a-eead-386c-81f8-515fb20157e4",
                    "sense_definition": "Сочинить или создать в воображении то, чего не было на самом деле.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Писатель <придумал> интересный сюжет для своего нового фантастического романа.",
                            "target_lang_translations": {
                                "en": "The writer <thought up> an interesting plot for his new sci-fi novel.",
                                "es": "El escritor <pensó> un argumento interesante para su nueva novela de ciencia ficción.",
                                "fr": "L'écrivain a <imaginé> une intrigue intéressante pour son nouveau roman de science-fiction."
                            }
                        },
                        {
                            "text": "Не нужно <придумывать> оправдания, лучше просто скажи мне правду.",
                            "target_lang_translations": {
                                "en": "You don't need to <make up> excuses, better just tell me the truth.",
                                "es": "No hace falta que te <inventes> excusas, es mejor que simplemente me digas la verdad.",
                                "fr": "Tu n'as pas besoin d'<inventer> d'excuses, tu ferais mieux de me dire la vérité."
                            }
                        }
                    ],
                    "synonyms": [
                        "сочинить",
                        "выдумать",
                        "вообразить"
                    ],
                    "common_phrases": [
                        "придумать историю",
                        "придумать сказку",
                        "придумать причину",
                        "придумать отговорку"
                    ],
                    "target_lang_definitions": {
                        "en": "To compose or create something in the imagination that did not actually exist.",
                        "es": "Componer o crear en la imaginación algo que no existía en la realidad.",
                        "fr": "Composer ou créer dans son imagination ce qui n'existait pas en réalité."
                    },
