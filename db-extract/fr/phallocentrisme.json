            {
                "entry_id": "e5b53b66-07d1-33f4-8de3-ed0c5651a3da",
                "word": "phallocentrisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "93d17525-eda8-413b-a9a0-a0c425cde8b5",
                        "entry_id": "e5b53b66-07d1-33f4-8de3-ed0c5651a3da",
                        "tags": [
