                "senses": [
                    {
                        "sense_id": "5d1a1e85-c851-36d4-87c0-ef1a1237e05b",
                        "entry_id": "da9dab6a-4c64-3544-9ede-3f6dc9444a14",
                        "glosses": [
                            "eenmaal per week, elke week terugkerend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2ebca79-9b9e-4f64-8987-b379a9cc92fc",
                                "sense_id": "5d1a1e85-c851-36d4-87c0-ef1a1237e05b",
                                "text": "Behalve Guthook raadpleegde ik ook af en toe het Water Report, een door vrijwilligers wekelijks bijgewerkt pdf-bestand dat de actuele waterstand aangeeft."
                            },
                            {
                                "example_id": "3090418f-577f-40dd-be1a-41aac2882801",
                                "sense_id": "5d1a1e85-c851-36d4-87c0-ef1a1237e05b",
                                "text": "Verkopers van de automaten zien dat jongeren vooral worden geïnspireerd door sociale media. Op TikTok en Instagram staan honderden filmpjes van jongeren die laten zien hoe het werkt. Zo ziet Brouwer dat het vrij laagdrempelig is om zoiets te beginnen, en in de meeste gevallen krijg je wekelijks de omzet gestort op je rekening."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb6f34fd-6ac3-42da-83b5-84c7a74da6a5",
                        "source_entry_id": "da9dab6a-4c64-3544-9ede-3f6dc9444a14",
                        "source_sense_id": "5d1a1e85-c851-36d4-87c0-ef1a1237e05b",
                        "source_sense_description": "elke week",
