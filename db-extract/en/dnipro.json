                    },
                    {
                        "translation_id": "b44ce9bd-32cd-492d-8bbe-a0f03876f445",
                        "source_entry_id": "c1ee4b9f-09fa-319f-a46e-e50751a02c43",
                        "source_sense_description": "city",
                        "target_lang_word": "Dnipro",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dnipro",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a26e87c9-2315-3ca1-8874-a61339b0e64e",
                                        "entry_id": "ab588d01-66b0-3a87-a16b-aefd88cde7d3",
                                        "glosses": [
                                            "Ville d’Ukraine, capitale administrative de l’oblast de Dnipropetrovsk."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdb13797-78ba-409b-b609-de392fe23baa",
                                                "sense_id": "a26e87c9-2315-3ca1-8874-a61339b0e64e",
                                                "text": "À Dnipro, la troisième plus grande ville d’Ukraine, une armée de volontaires travaille sans relâche pour tenter de contrecarrer l’avancée des troupes russes."
                                            },
                                            {
                                                "example_id": "ecd14373-a6b6-426d-a627-477672dcd867",
                                                "sense_id": "a26e87c9-2315-3ca1-8874-a61339b0e64e",
                                                "text": "Cette expérience, qui rappelle les précédents d'Alep et Grozny, devrait peser sur l'appétence à s'engager dans d'autres combats de ce type, pour des agglomérations plus importantes comme Kharkiv, Zaporojié ou Dnipro."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "793a9f01-47b4-31f3-b019-f5f1e97f57a5",
                                        "entry_id": "ab588d01-66b0-3a87-a16b-aefd88cde7d3",
                                        "glosses": [
                                            "Synonyme de Dniepr ; fleuve traversant la Biélorussie, la Russie et l’Ukraine pour se jeter dans la mer Noire."
                                        ],
                                        "tags": [
                                            "Cours d’eau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33e9919b-a6d9-4a86-8201-f972c91344b1",
                                                "sense_id": "793a9f01-47b4-31f3-b019-f5f1e97f57a5",
                                                "text": "La percée dans le sud est la plus importante depuis le début de la guerre : plusieurs villages situés le long du fleuve stratégique Dnipro sont retombés aux mains des Ukrainiens lundi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
