                        "sense_id": "6c4615eb-a5ee-3e92-ae86-11f7eac0b864",
                        "entry_id": "372ed413-93dc-39d7-9556-b103d6c51045",
                        "glosses": [
                            "A tree, mentioned in Luke's Gospel, and thought to be the black mulberry."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70876229-415d-4bb8-9ce7-f3a1c1046116",
                                "sense_id": "6c4615eb-a5ee-3e92-ae86-11f7eac0b864",
                                "text": "The lorde ſayde: yf ye had fayth lyke a grayne off muſtard ſede / and ſhulde ſaye vnto thys ſycamyne tree / plucke thy ſilfe vppe by the rotes / and plant thy ſilfe in the ſee: he ſhoulde obey you."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "972d135a-9f12-4b61-83c0-2653f20a8fad",
                        "source_entry_id": "372ed413-93dc-39d7-9556-b103d6c51045",
                        "source_sense_id": "6c4615eb-a5ee-3e92-ae86-11f7eac0b864",
                        "source_sense_description": "a type of tree",
                        "target_lang_word": "Maulbeerbaum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Maulbeerbaum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8d26d5ac-8f08-3851-9080-24038bfcac02",
                                        "entry_id": "25778c60-bebc-3551-b618-5d36f37d47ae",
                                        "glosses": [
                                            "als Baum oder Strauch wachsende, sommergrüne Kulturpflanze (Morus) mit Kätzchen, Maulbeeren als Früchte und herzförmigen Blättern, die der Seidenraupe als Nahrung dienen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af030b92-181f-42ac-8efd-b74b87eb1153",
                                                "sense_id": "8d26d5ac-8f08-3851-9080-24038bfcac02",
                                                "text": "„Die Ausstellung möchte aber nicht nur auf die Geschichte des Seidenbaus in Brandenburg, sondern insbesondere auch die Faszination der Seide als Naturprodukt und die enge Beziehung von Maulbeerbaum, Seidenraupe und Seide darstellen.“"
                                            },
                                            {
                                                "example_id": "ef493371-f82a-4ac4-93c8-cca05c0becb4",
                                                "sense_id": "8d26d5ac-8f08-3851-9080-24038bfcac02",
                                                "text": "„Ich kotzte an den Baum, und es tat mir so leid um das ganze teure Essen, dass ich kotzte und weinte. Dann lag alles da am Maulbeerbaum und glitzerte.“"
                                            },
                                            {
                                                "example_id": "163b35c1-dd65-49bc-8f3f-75ad85025fca",
                                                "sense_id": "8d26d5ac-8f08-3851-9080-24038bfcac02",
                                                "text": "„Hassan hat versprochen, unter dem alten Maulbeerbaum auf mich zu warten.“"
                                            },
                                            {
                                                "example_id": "91b3cc8d-60e9-400f-a249-84fac87dc721",
                                                "sense_id": "8d26d5ac-8f08-3851-9080-24038bfcac02",
                                                "text": "„Am Ende unserer Straße in Eden Park, direkt in einer Kurve, wo die Straße den höchsten Punkt erreicht, stand ein riesiger Maulbeerbaum, der aus einem Vorgarten herausgewachsen war.“"
                                            },
                                            {
                                                "example_id": "4e441099-3663-4ba6-bdff-d06431fa6e97",
                                                "sense_id": "8d26d5ac-8f08-3851-9080-24038bfcac02",
                                                "text": "„Durch Haine mit wilden Oliven, Maulbeerbäumen und Myrte gelangt man in alte Eichenwälder und schließlich über die Baumgrenze hinaus auf schneebedeckte Gipfel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
