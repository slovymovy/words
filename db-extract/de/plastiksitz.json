                        "examples": [
                            {
                                "example_id": "1c788b7f-cb15-43ac-af58-71a21bf3dbc3",
                                "sense_id": "bc64d590-18ec-37eb-b15f-c0815054fe98",
                                "text": "„Auf dem harten Plastiksitz im Innern sitzend sah er, wie die Augen des Fahrers ihn im Rückspiegel durchbohrten - ein stummer Schrei, der Jack zwang, den Blick abzuwenden und aus dem Fenster nach draußen zu schauen.“"
                            },
                            {
                                "example_id": "286e0815-8d29-4c76-b2a7-ecac19a54c49",
                                "sense_id": "bc64d590-18ec-37eb-b15f-c0815054fe98",
                                "text": "„Die Plastiksitze sind so heiß, dass man sich wie in der Hölle fühlt, wenn man sie anfasst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
