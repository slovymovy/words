                "senses": [
                    {
                        "sense_id": "47edb61e-c16e-3517-ab78-ba82f8c073a9",
                        "entry_id": "0e2561f4-dbbb-3198-9bd1-b62bf6023523",
                        "glosses": [
                            "Kennwert, der die Durchschnittsrendite aller inländischen, bereits emittierten Anleihen erster Bonität (vor allem Staatsanleihen) angibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da72470f-4001-4caa-92cb-36e73a27511f",
                                "sense_id": "47edb61e-c16e-3517-ab78-ba82f8c073a9",
                                "text": "Die Umlaufrendite wird regelmäßig von der Bundesbank veröffentlicht."
                            },
                            {
                                "example_id": "b8380224-bd00-4ddb-987f-3bc90e32d182",
                                "sense_id": "47edb61e-c16e-3517-ab78-ba82f8c073a9",
                                "text": "„Bei einigen Genossenschaftsbanken sind die Zinsen von Riester-Banksparplänen an die Umlaufrendite gekoppelt. Diese spiegelt das Zinsniveau von Bundeswertpapieren unterschiedlicher Laufzeiten wider.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
