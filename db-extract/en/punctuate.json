                ],
                "senses": [
                    {
                        "sense_id": "9f9c0006-85fe-3cf4-9296-6407c9d16499",
                        "entry_id": "7712a5f7-76b3-3a81-8b29-647aa4cf2187",
                        "glosses": [
                            "To add punctuation to."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c23245cd-14f6-4a1d-8974-ca449caf61f5",
                                "sense_id": "9f9c0006-85fe-3cf4-9296-6407c9d16499",
                                "text": "That occurrence of \"its\" needs to be punctuated as \"it's\"."
                            }
                        ]
                    },
                    {
                        "sense_id": "e97d62da-aa0c-3da7-8289-a4a1b82b087c",
                        "entry_id": "7712a5f7-76b3-3a81-8b29-647aa4cf2187",
                        "glosses": [
                            "To add or to interrupt at regular intervals."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "71b63425-4d8c-4bb3-a431-875867bdf0c0",
                                "sense_id": "e97d62da-aa0c-3da7-8289-a4a1b82b087c",
                                "text": "My father punctuated his tirade with thumps on the desk."
                            },
                            {
                                "example_id": "59f17d19-c4ba-4c97-a6bc-a34d18ca34d4",
                                "sense_id": "e97d62da-aa0c-3da7-8289-a4a1b82b087c",
                                "text": "Most soldiers would testify that the everyday experience of war is long stretches of boredom punctuated by sudden, terrifying spells of disorder."
                            }
                        ]
                    },
                    {
                        "sense_id": "a3a01aff-9d20-3bb4-ac3e-3d0b91a0a7f4",
                        "entry_id": "7712a5f7-76b3-3a81-8b29-647aa4cf2187",
                        "glosses": [
                            "To emphasize; to stress."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "812ba6b1-afa6-498e-89e7-0ed7a78bdf09",
                        "source_entry_id": "7712a5f7-76b3-3a81-8b29-647aa4cf2187",
                        "source_sense_description": "add punctuation to",
                        "target_lang_word": "ponctuer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ponctuer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6b81559e-853c-3efe-8268-077826b9733a",
                                        "entry_id": "d8d81d49-b6f4-32c8-89ff-bdef18f26103",
                                        "glosses": [
                                            "Mettre des points, des virgules et d’autres signes de ponctuation dans un discours écrit, pour distinguer les phrases et les différents membres dont elles sont composées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc368e9a-2fcb-4f58-9c2a-47761f20c38e",
                                                "sense_id": "6b81559e-853c-3efe-8268-077826b9733a",
                                                "text": "— Un verre ! fait-il, mais en ponctuant d'une chiée de points d’exclamation, tant tellement que si je les reproduisais ici, tu croirais une ligne à haute tension à travers la Beauce."
                                            },
                                            {
                                                "example_id": "4f684f9b-4b11-402a-ab8f-eca4e4fc7ee7",
                                                "sense_id": "6b81559e-853c-3efe-8268-077826b9733a",
                                                "text": "Tous les éditeurs ne ponctuent pas ce passage de la même manière. — Ce livre est généralement mal ponctué."
                                            },
                                            {
                                                "example_id": "471a5557-8f84-464e-9438-f08aa086ffdd",
                                                "sense_id": "6b81559e-853c-3efe-8268-077826b9733a",
                                                "text": "Quand une période n’est pas bien ponctuée, la lecture en est difficile. — La plupart des anciens manuscrits ne sont pas ponctués."
                                            },
                                            {
                                                "example_id": "4e0947fd-3ffa-4fbf-8200-48591392ad78",
                                                "sense_id": "6b81559e-853c-3efe-8268-077826b9733a",
                                                "text": "Il ne sait pas ponctuer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b79866ab-fd0d-397b-927c-43463d7341be",
                                        "entry_id": "d8d81d49-b6f4-32c8-89ff-bdef18f26103",
                                        "glosses": [
                                            "Marquer quelque chose, l'accompagner par une manifestation sonore qui l'accentue ou le caractérise."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "836ac3d0-ab85-4352-871e-edc86f8dd99e",
                                                "sense_id": "b79866ab-fd0d-397b-927c-43463d7341be",
                                                "text": "Ses incantations vénéneuses s’accompagnaient de beignes choisies qui ponctuaient ses doux poèmes. À la surprenante, en fin de tirade. À la ligne. Pan ! Dans la gueule."
                                            },
                                            {
                                                "example_id": "feb9ad89-46cd-4af5-a4dd-12cf35cc251e",
                                                "sense_id": "b79866ab-fd0d-397b-927c-43463d7341be",
                                                "text": "Les coups de tonnerre ponctuaient le silence de la nuit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bdd4934-16db-3c60-8395-ae8fb3f28607",
                                        "entry_id": "d8d81d49-b6f4-32c8-89ff-bdef18f26103",
                                        "glosses": [
                                            "Marquer les repos, diviser les phrases, dans la composition musicale."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bb421fdb-0a87-31f4-900b-c65c57689cd1",
                                        "entry_id": "d8d81d49-b6f4-32c8-89ff-bdef18f26103",
                                        "glosses": [
                                            "Entrecouper par des applaudissements ou des acclamations."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c631531-afe8-49e5-b98f-9a096031a918",
                                                "sense_id": "bb421fdb-0a87-31f4-900b-c65c57689cd1",
                                                "text": "Des hourras ponctuèrent le discours du Prince, qui, à la fin, entonna une hymne que tous les hommes reprirent avec lui : « Ein fester Burg ist unser Gott ! C’est un rempart que notre Dieu ! »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "280bf3c1-4bb2-3151-a417-1fb9d0b577b5",
                                        "entry_id": "d8d81d49-b6f4-32c8-89ff-bdef18f26103",
                                        "glosses": [
                                            "Être répandu."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "663f45b4-8443-48c7-aeed-8a1a544c2951",
                                                "sense_id": "280bf3c1-4bb2-3151-a417-1fb9d0b577b5",
                                                "text": "[La paraffine industrielle] Apportée par la marée sous forme de boulettes blanches, jaunes, grises ou rosâtres, elle s’éparpille sur le sable ou ponctue les rochers, tels des petits paquets de pâte à modeler."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "927de60b-2eec-47fe-a682-91737c082a2c",
                        "source_entry_id": "7712a5f7-76b3-3a81-8b29-647aa4cf2187",
