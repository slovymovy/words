                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b6be9cb-b080-4c2d-99f0-e9a7ff70daa0",
                                                "sense_id": "f9ec67e9-4617-35c4-b9e7-e451d4181f0a",
                                                "text": "This measure stems from the observation that productive morphological rules are likely to produce occasionalisms, whereas unproductive rules are not likely to do so. Occasionalisms are thus particularly important for determining productivity."
                                            }
                                        ]
                                    }
