{
    "word_family": [
        "flute",
        "fluted",
        "flutist",
        "flautist"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fab8015b-bd91-3caf-b73c-b3295bbde661",
                    "sense_definition": "present participle and gerund of <w>flute</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mason spent several days carefully <w>fluting</w> the stone pillars.",
                            "target_lang_translations": {
                                "ru": "Каменщик провел несколько дней, аккуратно <w>высекая каннелюры на</w> каменных колоннах."
                            }
                        },
                        {
                            "text": "A songbird was <w>fluting</w> a lovely melody from high in the trees.",
                            "target_lang_translations": {
                                "ru": "Высоко в кронах деревьев певчая птица <w>выводила флейтой</w> прекрасную мелодию."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "причастие настоящего времени или герундий глагола flute"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "каннелирующий",
                                "target_lang_sense_clarification": "делающий желобки"
                            },
                            {
                                "target_lang_word": "выводящий трели",
                                "target_lang_sense_clarification": "поющий, свистящий"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7f2e892f-9a98-3146-a3ab-29ab4aae1d25",
                    "sense_definition": "A decorative series of parallel, usually vertical grooves carved into a surface, especially on a column.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "groove",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The classical <w>fluting</w> on the marble columns gave the ancient temple an elegant appearance.",
                            "target_lang_translations": {
                                "ru": "Классические <w>каннелюры</w> на мраморных колоннах придавали древнему храму элегантный вид."
                            }
                        },
                        {
                            "text": "Dust had gathered deeply inside the <w>fluting</w> of the wooden pillars.",
                            "target_lang_translations": {
                                "ru": "Пыль глубоко забилась в <w>желобки</w> деревянных колонн."
                            }
                        }
                    ],
                    "synonyms": [
                        "grooving",
                        "corrugation",
                        "channelling"
                    ],
                    "common_phrases": [
                        "classical fluting",
                        "delicate fluting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Декоративный ряд параллельных, обычно вертикальных желобков на поверхности, особенно на колоннах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "каннелюры",
                                "target_lang_sense_clarification": "вертикальные желобки на колонне"
                            },
                            {
                                "target_lang_word": "рифление",
                                "target_lang_sense_clarification": "параллельные бороздки"
                            },
                            {
                                "target_lang_word": "желобки",
                                "target_lang_sense_clarification": "выемки на поверхности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f1848fc-8954-39f3-9adf-22988405a255",
                    "sense_definition": "A clear, high-pitched musical sound reminiscent of a flute.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gentle <w>fluting</w> of the songbird echoed softly through the quiet forest.",
                            "target_lang_translations": {
                                "ru": "Нежные <w>флейтовые звуки</w> певчей птицы тихо разносились по безмолвному лесу."
                            }
                        },
                        {
                            "text": "We listened intently to the sweet <w>fluting</w> carried across the valley by the wind.",
                            "target_lang_translations": {
                                "ru": "Мы внимательно слушали сладостный <w>свист</w>, разносимый ветром по долине."
                            }
                        }
                    ],
                    "synonyms": [
                        "piping",
                        "whistling",
                        "chirping"
                    ],
                    "common_phrases": [
                        "gentle fluting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чистый, высокий мелодичный звук, напоминающий звучание флейты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "флейтовые звуки",
                                "target_lang_sense_clarification": "звучание, напоминающее флейту"
                            },
                            {
                                "target_lang_word": "свист",
                                "target_lang_sense_clarification": "мелодичное пение или свист птицы"
                            },
                            {
                                "target_lang_word": "трель",
                                "target_lang_sense_clarification": "чистый мелодичный звук"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5052f141-614b-3d51-ad6f-71810a7459d0",
                    "sense_definition": "The action or craft of carving or creating parallel grooves on a surface.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "groove",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stonemason perfected the art of <w>fluting</w> after many years of dedicated apprenticeship.",
                            "target_lang_translations": {
                                "ru": "Каменщик отточил искусство <w>каннелирования</w> после долгих лет преданного ученичества."
                            }
                        },
                        {
                            "text": "Careful <w>fluting</w> was required to ensure every groove on the column remained uniform.",
                            "target_lang_translations": {
                                "ru": "Требовалось тщательное <w>высекание желобков</w>, чтобы каждая бороздка на колонне оставалась ровной."
                            }
                        }
                    ],
                    "synonyms": [
                        "grooving",
                        "channeling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс вырезания или создания параллельных желобков и канавок на поверхности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "каннелирование",
                                "target_lang_sense_clarification": "вырезание каннелюр на колоннах"
                            },
                            {
                                "target_lang_word": "рифление",
                                "target_lang_sense_clarification": "нанесение бороздок или рифлей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "241351f7-96ef-3cfb-a945-c17442a64660",
                    "sense_definition": "A series of small, rounded pleats or ruffles used as ornamental trimming on clothing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historical dress featured intricate <w>fluting</w> along the collar and cuffs.",
                            "target_lang_translations": {
                                "ru": "Историческое платье украшала сложная <w>гофрировка</w> по воротнику и манжетам."
                            }
                        },
                        {
                            "text": "She carefully ironed the <w>fluting</w> on the vintage silk blouse.",
                            "target_lang_translations": {
                                "ru": "Она аккуратно разгладила <w>складки</w> на винтажной шелковой блузке."
                            }
                        }
                    ],
                    "synonyms": [
                        "ruffle",
                        "frill",
                        "pleating"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ряд мелких округлых складок или рюшей, используемых для отделки одежды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гофрировка",
                                "target_lang_sense_clarification": "мелкие параллельные складки на ткани"
                            },
                            {
                                "target_lang_word": "плиссировка",
                                "target_lang_sense_clarification": "отделка складками"
                            },
                            {
                                "target_lang_word": "рюши",
                                "target_lang_sense_clarification": "волнистая отделка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66a5acb4-cbe1-32a5-b202-3763c537f042",
                    "sense_definition": "The geological erosion process that produces rounded, parallel channels on exposed rock surfaces.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wind and running water caused pronounced <w>fluting</w> across the exposed granite cliffs.",
                            "target_lang_translations": {
                                "ru": "Ветер и потоки воды привели к образованию отчетливого <w>бороздования</w> на открытых гранитных утесах."
                            }
                        },
                        {
                            "text": "Geologists studied the distinct <w>fluting</w> visible on the ancient glacier-carved bedrock.",
                            "target_lang_translations": {
                                "ru": "Геологи исследовали четкое ледниковое <w>рифление</w>, заметное на древней коренной породе."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Геологический процесс эрозии, приводящий к образованию параллельных округлых желобков на скальных поверхностях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рифление",
                                "target_lang_sense_clarification": "борозды и желобки ледникового или ветрового происхождения"
                            },
                            {
                                "target_lang_word": "бороздование",
                                "target_lang_sense_clarification": "эрозионные желобки на скалах"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bb02907f-b0fa-3de3-b8ab-c083f9c17491",
                    "sense_definition": "Producing a clear, melodic sound resembling that of a flute.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actor spoke with a rich, <w>fluting</w> voice that charmed everyone in the audience.",
                            "target_lang_translations": {
                                "ru": "Актер говорил богатым, <w>флейтовым</w> голосом, который очаровал всех в зале."
                            }
                        },
                        {
                            "text": "She woke up to the pleasant, <w>fluting</w> calls of thrushes outside her bedroom window.",
                            "target_lang_translations": {
                                "ru": "Она проснулась под приятные, <w>мелодичные</w> трели дроздов за окном спальни."
                            }
                        }
                    ],
                    "synonyms": [
                        "flutelike",
                        "piping",
                        "melodious"
                    ],
                    "common_phrases": [
                        "fluting voice",
                        "fluting tone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издающий чистый, мелодичный звук, похожий на звучание флейты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "флейтовый",
                                "target_lang_sense_clarification": "похожий на звук флейты"
                            },
                            {
                                "target_lang_word": "свистящий",
                                "target_lang_sense_clarification": "чистый и звонкий"
                            },
                            {
                                "target_lang_word": "мелодичный",
                                "target_lang_sense_clarification": "чистый, приятный на слух"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}