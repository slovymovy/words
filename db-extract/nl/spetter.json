                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "48be4cd7-f007-4623-8d9e-8337930c5a70",
                                "sense_id": "5cf43dd2-a426-3fa7-9202-cc227c77293e",
                                "text": "Wat een spetter zeg!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b8be2f6-5418-44ce-8ff6-f87a11b4b293",
                        "source_entry_id": "c1539833-b6d9-3aff-8c56-77564a62f853",
                        "source_sense_id": "24f13dfa-9da1-3632-a338-b39dba9dc37b",
                        "source_sense_description": "een weggeslingerde druppel",
                        "target_lang_word": "Spritzer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spritzer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4a4e76b5-6a45-3c0d-a1c6-01d9a1ebfa93",
                                        "entry_id": "631dabda-82c3-3756-82d1-f5680acc9a0f",
                                        "glosses": [
                                            "schnell bewegter Strahl einer Flüssigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ba81229-4adc-4efd-8752-75b289e3ecce",
                                                "sense_id": "4a4e76b5-6a45-3c0d-a1c6-01d9a1ebfa93",
                                                "text": "„An dem kleinen, fast versunkenen Wrack ließ die Nordsee Wassergarben aufspringen, so scharf, so hoch, daß wir unsere Spritzer abbekamen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "eb3f35fc-ceac-32ca-85fe-ff4f7b1cb97c",
                                        "entry_id": "631dabda-82c3-3756-82d1-f5680acc9a0f",
                                        "glosses": [
                                            "kleine Menge einer Flüssigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e669487f-3ac9-48d2-b46a-92b9209bf62b",
                                                "sense_id": "eb3f35fc-ceac-32ca-85fe-ff4f7b1cb97c",
                                                "text": "An den Salat gehört noch ein Spritzer Zitrone."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1c742e76-0ec3-37eb-a3d9-c62987403d05",
                                        "entry_id": "631dabda-82c3-3756-82d1-f5680acc9a0f",
                                        "glosses": [
                                            "Fleck von einer kleinen Flüssigkeitsmenge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d10cd6e5-b554-4b82-a6a8-eef96b4fe1b4",
                                                "sense_id": "1c742e76-0ec3-37eb-a3d9-c62987403d05",
                                                "text": "Mein Hemd hat einen Spritzer Rotwein abbekommen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "f96c8cf2-091d-3cba-9c28-8db110c663e6",
                                        "entry_id": "631dabda-82c3-3756-82d1-f5680acc9a0f",
                                        "glosses": [
                                            "Person, die etwas spritzt"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b5749e3-977a-4ddd-9ab4-9bf9cb2ae8ce",
                        "source_entry_id": "c1539833-b6d9-3aff-8c56-77564a62f853",
                        "source_sense_id": "24f13dfa-9da1-3632-a338-b39dba9dc37b",
                        "source_sense_description": "een weggeslingerde druppel",
                        "target_lang_word": "spatter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spatter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a774b3c-159a-3b14-81c2-8525129a952d",
                                        "entry_id": "5bdfbbd6-ee38-3c5e-9f61-2ea8ba0f6bd9",
                                        "glosses": [
                                            "To splash (someone or something) with small droplets."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4ece041-023c-4a15-bc2e-80941f025779",
                                                "sense_id": "4a774b3c-159a-3b14-81c2-8525129a952d",
                                                "text": "When my wet chihuahua shook himself, I was spattered with smelly water."
                                            },
                                            {
                                                "example_id": "9ca0945c-a718-4cac-b93d-a59f712a7586",
                                                "sense_id": "4a774b3c-159a-3b14-81c2-8525129a952d",
                                                "text": "His axel-tree, and chariot wheeles, all spatterd with the blood\nHurl’d from the steeds houes, and the strakes."
                                            },
                                            {
                                                "example_id": "8f4437cf-0e97-4880-8b1c-06be16786891",
                                                "sense_id": "4a774b3c-159a-3b14-81c2-8525129a952d",
                                                "text": "The old Welshman came home toward daylight, spattered with candle-grease, smeared with clay, and almost worn out."
                                            },
                                            {
                                                "example_id": "a001e6ba-4af6-4b80-8b08-55f2233142ef",
                                                "sense_id": "4a774b3c-159a-3b14-81c2-8525129a952d",
                                                "text": "He began to blow at the surface of the tea. He blew too hard and the tea spattered the skirt of Nurse Clock’s uniform."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b374a6a-d257-3970-a0a6-c7bbac6cead5",
                                        "entry_id": "5bdfbbd6-ee38-3c5e-9f61-2ea8ba0f6bd9",
                                        "glosses": [
                                            "To cover, or lie upon (something) by having been scattered, as if by splashing."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f978756-c20b-409d-9b67-7359cbacc6d6",
                                                "sense_id": "8b374a6a-d257-3970-a0a6-c7bbac6cead5",
                                                "text": "[…] she seem’d to have woven the Rainbow into a loose Robe, which being so rarified that she might be seen through it, and also spatter’d with radiant Jewells in the forms of Starrs […]"
                                            },
                                            {
                                                "example_id": "f8a27c10-bc01-46ee-8a10-41aa3333388e",
                                                "sense_id": "8b374a6a-d257-3970-a0a6-c7bbac6cead5",
                                                "text": "The low, whitewashed houses between the red and green acacia trees are spattered with shell-holes […]"
                                            },
                                            {
                                                "example_id": "faaedcf8-4cf0-4a6a-ae86-b8ebda33b204",
                                                "sense_id": "8b374a6a-d257-3970-a0a6-c7bbac6cead5",
                                                "text": "1955, Samuel Beckett and Patrick Bowles (translators), Molloy by Samuel Beckett, in Three Novels, London: Calder, 1994, p. 128,\nThe roof’s serrated ridge, the single chimney-stack with its four flues, stood out faintly against the sky spattered with a few dim stars."
                                            },
                                            {
                                                "example_id": "8be74581-4bcf-4ad8-86bf-df4318f0e467",
                                                "sense_id": "8b374a6a-d257-3970-a0a6-c7bbac6cead5",
                                                "text": "Patches of light sifting through them [the trees] spattered the concrete walks with sunshine."
                                            },
                                            {
                                                "example_id": "3a3a1c5f-9049-4ecb-a83d-b18defe57fa4",
                                                "sense_id": "8b374a6a-d257-3970-a0a6-c7bbac6cead5",
                                                "text": "Then they began to climb, steering to open uplands spattered with yellow cinquefoil […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e305cf8-4e5b-30c5-b65c-975eaa3ce9c0",
                                        "entry_id": "5bdfbbd6-ee38-3c5e-9f61-2ea8ba0f6bd9",
                                        "glosses": [
                                            "To distribute (a liquid) by sprinkling; to sprinkle around."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df296ad8-6270-4a77-939f-3d6b50c5b357",
                                                "sense_id": "1e305cf8-4e5b-30c5-b65c-975eaa3ce9c0",
                                                "text": "Streaks of DeHaven’s real face can be seen through the trademark face as the clown slams the hood shut in the spattered rain."
                                            },
                                            {
                                                "example_id": "6e17b859-ae08-4736-a9dc-6ae63e6c5713",
                                                "sense_id": "1e305cf8-4e5b-30c5-b65c-975eaa3ce9c0",
                                                "text": "to spatter blood"
                                            },
                                            {
                                                "example_id": "eab45782-1aeb-405b-98ca-4ff8b3e57750",
                                                "sense_id": "1e305cf8-4e5b-30c5-b65c-975eaa3ce9c0",
                                                "text": "Perhaps ev’n I, reserv’d by angry Fate\nThe last sad Relick of my ruin’d State,\n(Dire Pomp of sov’reign Wretchedness!) must fall,\nAnd stain the Pavement of my regal Hall;\nWhere famish’d Dogs, late Guardians of my Door,\nShall lick their mangled Master’s spatter’d Gore."
                                            },
                                            {
                                                "example_id": "223ca85d-58ea-4bd9-a8e1-ef3f5e26123d",
                                                "sense_id": "1e305cf8-4e5b-30c5-b65c-975eaa3ce9c0",
                                                "text": "O God, that I were in some wide field\nWith nothing but my battle-axe and him\nTo spatter his brains!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb331a1f-0b01-3a79-9dbf-2fc1933dbc2a",
                                        "entry_id": "5bdfbbd6-ee38-3c5e-9f61-2ea8ba0f6bd9",
                                        "glosses": [
                                            "To send out or disperse (something) as if in droplets."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c46861c-0edc-4886-8bed-2d3a30a2aa7f",
                                                "sense_id": "bb331a1f-0b01-3a79-9dbf-2fc1933dbc2a",
                                                "text": "The cabman spattered his few words of English."
                                            },
                                            {
                                                "example_id": "6e7ccf71-676b-4e52-a697-f1f387d482b2",
                                                "sense_id": "bb331a1f-0b01-3a79-9dbf-2fc1933dbc2a",
                                                "text": "[…] they had seen him, at the sound of the alarm, rush like a madman from his window in Gant’s shop, leaving the spattered fragments of a watch upon his desk […]"
                                            },
                                            {
                                                "example_id": "34609bca-6c06-407a-85d8-1250ad2f373f",
                                                "sense_id": "bb331a1f-0b01-3a79-9dbf-2fc1933dbc2a",
                                                "text": "[…] a man with a machine gun sits in a cage suspended from the ceiling and moving like a trolley spatters bullets into the cells."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61f8e2d5-805e-3185-9644-7e298cc97de9",
                                        "entry_id": "5bdfbbd6-ee38-3c5e-9f61-2ea8ba0f6bd9",
                                        "glosses": [
                                            "To send out small droplets; to splash in small droplets (on or against something)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3117b68b-3274-42c8-97bc-871fb0acbc55",
                                                "sense_id": "61f8e2d5-805e-3185-9644-7e298cc97de9",
                                                "text": "Make sure the pieces of fish are dry before you put them into the hot oil so that it doesn’t spatter."
                                            },
                                            {
                                                "example_id": "d9f425bb-843c-40d8-8467-dc930c148c87",
                                                "sense_id": "61f8e2d5-805e-3185-9644-7e298cc97de9",
                                                "text": "they fondly thinking to allay\nThir appetite with gust, instead of Fruit\nChewd bitter Ashes, which th’ offended taste\nWith spattering noise rejected:"
                                            },
                                            {
                                                "example_id": "8fe8b459-c233-4290-9559-7618fd062d25",
                                                "sense_id": "61f8e2d5-805e-3185-9644-7e298cc97de9",
                                                "text": "Where the headquarters tent sags, water drips down and spatters on the table."
                                            },
                                            {
                                                "example_id": "bda8f8a1-b76d-438a-b5f2-3be36ff3c1fc",
                                                "sense_id": "61f8e2d5-805e-3185-9644-7e298cc97de9",
                                                "text": "Later, the two priests left together, […] their hoods pulled up because it had begun to spatter with rain."
                                            },
                                            {
                                                "example_id": "de5af0a4-1018-4bf6-a612-f63fa0d8744b",
                                                "sense_id": "61f8e2d5-805e-3185-9644-7e298cc97de9",
                                                "text": "Most mornings he roasted lamb, turning it on a spit, where it spattered and dripped […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7197b2db-ab66-3b6b-9b69-15d90e3d7353",
                                        "entry_id": "5bdfbbd6-ee38-3c5e-9f61-2ea8ba0f6bd9",
                                        "glosses": [
                                            "To injure by aspersion; to defame."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea587097-c136-46fa-b6ee-06e904216407",
                                                "sense_id": "7197b2db-ab66-3b6b-9b69-15d90e3d7353",
                                                "text": "1647, John Hall, “A Genethliacon to the Infant Muse of his dearest Friend” in Poems, London: J. Rothwell,\nLet envy spatter what it can,\nThis Embryon will prove a man."
                                            },
                                            {
                                                "example_id": "58f72d33-0fdd-46e4-821b-a5062a5a8e6a",
                                                "sense_id": "7197b2db-ab66-3b6b-9b69-15d90e3d7353",
                                                "text": "1728, John Gay, The Beggar’s Opera, Dublin: George Risk et al., Act II, Scene 13, “Good-morrow, Gossip Joan,” p. 42,\nWhy how now, Madam Flirt?\nIf you thus must chatter;\nAnd are for flinging Dirt,\nLet’s try who best can spatter;"
                                            },
                                            {
                                                "example_id": "01401423-dcd2-4591-bd86-f3d8fe867c0d",
                                                "sense_id": "7197b2db-ab66-3b6b-9b69-15d90e3d7353",
                                                "text": "1770, George Saville Carey, “To a Friend” in Analects in Verse and Prose, London: P. Shatwell et al., Volume 2, p. 171,\nI Wrote a letter long ago,\nBut did not like it, you must know,\nSo rather chose to take my time,\nAnd write my own defence in rhime,\nThough not in your be-crabbed stile,\nTo spatter, threaten, and revile;"
                                            },
                                            {
                                                "example_id": "cc17fe90-0025-45b0-8989-a7fe0136f6a8",
                                                "sense_id": "7197b2db-ab66-3b6b-9b69-15d90e3d7353",
                                                "text": "[…] there is nothing but may be represented upon some principle or other apparently worthy, without the wretched necessity of having recourse to spatter and vilify others."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "spatter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22126315-cbae-3bef-b1b2-ce3b112fed6b",
                                        "entry_id": "37a2926b-5b19-34e9-afbc-7e4e4a3d14e6",
                                        "glosses": [
                                            "A spray or shower of droplets hitting a surface."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01ad6159-f91d-42c5-953e-40f54d58ef30",
                                                "sense_id": "22126315-cbae-3bef-b1b2-ce3b112fed6b",
                                                "text": "1763, Richard Bentley, Patriotism, a Mock-Heroic, London: M. Hinxman, Canto 5, pp. 65-66,\nAs a rough Water-Dog, New-England’s Breed,\nFresh plaister’d from some Pond with Mud and Weed,\nRound from his Fleece the dirty Puddle shakes\nRejoicing in the Spatter that he makes:"
                                            },
                                            {
                                                "example_id": "a2608b9c-8ca9-4485-9836-c3b695d9915b",
                                                "sense_id": "22126315-cbae-3bef-b1b2-ce3b112fed6b",
                                                "text": "Ivar turned the mare and urged her into a sliding trot. Her feet sent back a continual spatter of mud."
                                            },
                                            {
                                                "example_id": "1071ed27-c372-4caf-8e2a-02060b4b0b73",
                                                "sense_id": "22126315-cbae-3bef-b1b2-ce3b112fed6b",
                                                "text": "She crosses the plaza, receives a quick spatter from the fountain […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "149023dc-2bdb-35ef-8670-f3c3b5b80210",
                                        "entry_id": "37a2926b-5b19-34e9-afbc-7e4e4a3d14e6",
                                        "glosses": [
                                            "A spot or spots of a substance spattered on a surface."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36f64a7a-eb6a-430c-850d-22f5b7ad5ca2",
                                                "sense_id": "149023dc-2bdb-35ef-8670-f3c3b5b80210",
                                                "text": "There was what looked like a spatter of blood on one wall."
                                            },
                                            {
                                                "example_id": "84580658-b9ab-42e1-a30b-3a003eca1886",
                                                "sense_id": "149023dc-2bdb-35ef-8670-f3c3b5b80210",
                                                "text": "[…] I groped from step to step, collecting the shattered earthenware, and drying the spatters of milk from the banister with my pocket-handkerchief."
                                            },
                                            {
                                                "example_id": "8d64ee0e-2454-4876-85ed-8024584f1ed7",
                                                "sense_id": "149023dc-2bdb-35ef-8670-f3c3b5b80210",
                                                "text": "[…] they led the way in through the huge arch, over the icy ground that was filthy with the spatter of the birds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcb83d7f-e85f-338d-8db1-489b0a084eec",
                                        "entry_id": "37a2926b-5b19-34e9-afbc-7e4e4a3d14e6",
                                        "glosses": [
                                            "The sound of droplets hitting a surface."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62791da8-fe63-4ffd-8fb1-5063498a95a9",
                                                "sense_id": "bcb83d7f-e85f-338d-8db1-489b0a084eec",
                                                "text": "As Henry lay awake that first night the hiss and spatter of the rain against his window seemed to have a personal grudge against him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "361c3a62-c36b-31d1-bad3-c3ca30ffc90e",
                                        "entry_id": "37a2926b-5b19-34e9-afbc-7e4e4a3d14e6",
                                        "glosses": [
                                            "A burst or series of sounds resembling the sound of droplets hitting a surface."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cccdfb63-a180-4248-bd2d-9ba769a8773b",
                                                "sense_id": "361c3a62-c36b-31d1-bad3-c3ca30ffc90e",
                                                "text": "[Father Roman] had shriven many simple souls on the battlefields of the Republic, kneeling by the dying on hillsides, in the long grass, in the gloom of the forests, to hear the last confession with the smell of gunpowder smoke in his nostrils, the rattle of muskets, the hum and spatter of bullets in his ears."
                                            },
                                            {
                                                "example_id": "77774e58-fd51-4f94-b989-4f4376bc05be",
                                                "sense_id": "361c3a62-c36b-31d1-bad3-c3ca30ffc90e",
                                                "text": "The rapid handing out of the diplomas brought frequent applause—bits, spatters, volleys, as the case might be."
                                            },
                                            {
                                                "example_id": "99e85368-cd91-446e-a25e-91392f4ed7fc",
                                                "sense_id": "361c3a62-c36b-31d1-bad3-c3ca30ffc90e",
                                                "text": "He went through the darkened parlor with its low early evening spatter of conversation."
                                            },
                                            {
                                                "example_id": "87f654d6-d306-48f7-9517-38b4756fd618",
                                                "sense_id": "361c3a62-c36b-31d1-bad3-c3ca30ffc90e",
                                                "text": "[…] punctuated by the roar of great automobiles, overtaking gangsters, the spatter of tommy-guns mowing them down […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c185f31b-6cfd-37ed-abbb-3caa64ab3fb5",
                                        "entry_id": "37a2926b-5b19-34e9-afbc-7e4e4a3d14e6",
                                        "glosses": [
                                            "A collection of objects scattered like droplets splashed onto a surface."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d91b08b2-a3f6-4863-9910-d024a7f25295",
                                                "sense_id": "c185f31b-6cfd-37ed-abbb-3caa64ab3fb5",
                                                "text": "1988, Don DeLillo, Libra, New York: Viking, Part 2, “12 August,” p. 270,\nThe attendant had a droopy lower lip, a rust-tone complexion with a spatter of freckles across the cheekbones […]"
                                            },
                                            {
                                                "example_id": "42457084-1a80-4c7c-9a5f-6d86bb4c02cb",
                                                "sense_id": "c185f31b-6cfd-37ed-abbb-3caa64ab3fb5",
                                                "text": "It was untidy; the quarters of someone not used to looking after herself; to seat himself he removed the stained cup and plate and a spatter of envelopes, sheets of opened letters, withered apple-peel, old Sunday paper, from a chair."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "647baf3e-3ad2-4bcf-b2f3-fb571fb801cf",
                        "source_entry_id": "c1539833-b6d9-3aff-8c56-77564a62f853",
                        "source_sense_id": "24f13dfa-9da1-3632-a338-b39dba9dc37b",
                        "source_sense_description": "een weggeslingerde druppel",
                        "target_lang_word": "éclaboussure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éclaboussure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "58ecbee3-7165-343e-ba08-393e9a750e23",
                                        "entry_id": "fca2d0cd-7f1d-3271-956a-bd74966f202e",
                                        "glosses": [
                                            "Boue qui a rejailli sur quelqu’un ou sur quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16c31cab-e7b6-4fdc-a116-c3e748f15356",
                                                "sense_id": "58ecbee3-7165-343e-ba08-393e9a750e23",
                                                "text": "Le sang coula, des éclaboussures jaillirent sur les mains de Silvère, qui fut subitement dégrisé."
                                            },
                                            {
                                                "example_id": "a9e4b675-1578-4340-8ba0-5dd0323de04b",
                                                "sense_id": "58ecbee3-7165-343e-ba08-393e9a750e23",
                                                "text": "Il crut reconnaître sur ces murailles des éraflures de pointes d'épée, sur les dalles lavées, des éclaboussures noirâtres."
                                            },
                                            {
                                                "example_id": "ebee8ec3-c46d-4984-bb8e-974294842c77",
                                                "sense_id": "58ecbee3-7165-343e-ba08-393e9a750e23",
                                                "text": "Il avança avec précaution, risquant prudemment ses talons hésitants, évitant les mares et les éclaboussures."
                                            },
                                            {
                                                "example_id": "89286dee-9165-45a6-bf96-13b05595e1de",
                                                "sense_id": "58ecbee3-7165-343e-ba08-393e9a750e23",
                                                "text": "Les sauterelles d’autrefois, comme des éclaboussures, jaillissaient en rond sous mes pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3671749b-c664-3379-919d-1ac52fe5ec08",
                                        "entry_id": "fca2d0cd-7f1d-3271-956a-bd74966f202e",
                                        "glosses": [
                                            "Conséquence que l'on subit par ricochet."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89ee5bf2-ec77-4e14-9324-87360422498b",
                                                "sense_id": "3671749b-c664-3379-919d-1ac52fe5ec08",
                                                "text": "à se mêler de cette fâcheuse affaire, il en a reçu des éclaboussures."
                                            },
                                            {
                                                "example_id": "137b45a6-0219-462a-91c0-94ff5d77f19e",
                                                "sense_id": "3671749b-c664-3379-919d-1ac52fe5ec08",
                                                "text": "Restait Adélaïde. Pour rien au monde, Pierre ne voulait continuer à demeurer avec elle. Elle le compromettait. C’était par elle qu’il aurait désiré commencer. Mais il se trouvait pris entre deux alternatives fort embarrassantes : la garder, et alors recevoir les éclaboussures de sa honte, s’attacher au pied un boulet qui arrêterait l’élan de son ambition ; la chasser, et à coup sûr se faire montrer au doigt comme un mauvais fils, ce qui aurait dérangé ses calculs de bonhomie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
