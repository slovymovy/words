                    {
                        "form_id": "1bc98ee6-ccb2-4738-a332-be97f48f7b2c",
                        "entry_id": "386f5799-92b9-3031-9e44-b0d2b2552893",
                        "tags": [
                            "accusative",
                            "definite",
