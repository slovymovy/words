                "senses": [
                    {
                        "sense_id": "1f224af9-2f9f-3901-a756-acf7ade56c56",
                        "entry_id": "eb2f47db-29c1-3c40-8bf0-719ee33ffa32",
                        "glosses": [
                            "tasteless; insipid"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "7af383d4-115f-4d7b-96cc-f7f58a6668bc",
                                "sense_id": "1f224af9-2f9f-3901-a756-acf7ade56c56",
                                "text": "[…] they might after give the expressed and less useful part of the cods and remaining pulp unto their swine: which, being no gustless or unsatisfying offal, might be well desired by the prodigal in his hunger."
                            },
                            {
                                "example_id": "3ccccae0-e3e7-4d5b-b3c9-d39858c2a1a1",
                                "sense_id": "1f224af9-2f9f-3901-a756-acf7ade56c56",
                                "text": "Again, it is a base abject temper, speaks a mind sunk and lost in carnality, and that, having dethroned and abjured reason, hath abandoned itself to the hurry of vile appetite and sold its liberty and sovereignty for the insipid, gustless pleasures of sense."
                            },
                            {
                                "example_id": "5d2e5f79-232a-46e2-8c3a-186150e3bdb4",
                                "sense_id": "1f224af9-2f9f-3901-a756-acf7ade56c56",
                                "text": "Graceful and smooth-tongued, the model wife moves through her two scenes with the level charm belonging to Mr. Phillips's gustless but mellow blank verse, to the accentless but even-knit pattern of his plot."
                            },
                            {
                                "example_id": "160fd5cd-3533-40f2-9d88-78dc74474702",
                                "sense_id": "1f224af9-2f9f-3901-a756-acf7ade56c56",
                                "text": "She placed her hands on her hips and her stout boots wide apart and bent her body and gaped her mouth and stared at this man who was as gustless as skimmed milk and unsatisfying as water."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
