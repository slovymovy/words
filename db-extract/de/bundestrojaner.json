                "senses": [
                    {
                        "sense_id": "db0eb7f7-5c61-3067-b318-07cf8b1f4c57",
                        "entry_id": "578a7d20-b999-3832-a793-9eccde6f0cd4",
                        "glosses": [
                            "Trojaner, der von diversen deutschen Behörden eingesetzt wird, um heimlich die Nutzung von Computern zu protokollieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d364b350-38e3-4257-b974-920b9a4b568b",
                                "sense_id": "db0eb7f7-5c61-3067-b318-07cf8b1f4c57",
                                "text": "„Der Chaos Computer Club hatte am vergangenen Wochenende mehrere Exemplare des sogenannten Bundestrojaners gefunden.“"
                            },
                            {
                                "example_id": "50f5bafe-f730-4c42-ac10-cc86a41ee416",
                                "sense_id": "db0eb7f7-5c61-3067-b318-07cf8b1f4c57",
                                "text": "„Für die Ermöglichung der damals als Bundestrojaner und Online-Durchsuchung thematisierten erweiterten Kompetenzen für Fahnder wollte er zeitweilig sogar das Grundgesetz ändern.“"
                            },
                            {
                                "example_id": "acb046b4-01b0-486b-80ad-c379ed91b007",
                                "sense_id": "db0eb7f7-5c61-3067-b318-07cf8b1f4c57",
                                "text": "Bei den sogenannten Bundestrojanern handelt es sich um Spähprogramme, die die Kommunikation von Verdächtigen auf deren Computern abfangen sollen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
