                        "examples": [
                            {
                                "example_id": "49ed2abf-0d92-4c61-8831-3fc956e62fdf",
                                "sense_id": "2b3ca607-a21b-3e4a-ba09-6ee4dd4bb126",
                                "text": "„Zweck (Funktion) von Politik ist es, Recht (allgemeinverbindliche Entscheidungen) herzustellen.“"
                            },
                            {
                                "example_id": "4dd64090-9b78-4521-a033-1167f1ba3a9f",
                                "sense_id": "2b3ca607-a21b-3e4a-ba09-6ee4dd4bb126",
                                "text": "Der Bundesminister für Arbeit oder die oberste Arbeitsbehörde eines Landes können einen Branchen-Tarifvertrag für allgemeinverbindlich erklären."
