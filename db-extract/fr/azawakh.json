                        "sense_id": "d873863a-b2ab-3524-8668-99c18554289e",
                        "entry_id": "74588d4d-156a-3f35-8236-fc0ae481ef95",
                        "glosses": [
                            "Race de grand chien lévrier, originaire du Niger et du Mali, en Afrique de l’Ouest, longiligne, à poil court et fin, à robe fauve et blanche."
                        ],
                        "tags": [
                            "Cynologie"
                        ],
                        "examples": [
                            {
                                "example_id": "113a9845-316b-4ca2-a074-5b82032128dc",
                                "sense_id": "d873863a-b2ab-3524-8668-99c18554289e",
                                "text": "Qu’ils soient sloughi, azawakh, saluki, whippet ou levrette d’Italie, les lévriers ont en commun des membres qui n’en finissent pas, une élégance naturelle et, contre toute attente, de la robustesse."
                            }
                        ]
                    }
