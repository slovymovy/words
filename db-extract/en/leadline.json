                        "glosses": [
                            "A weighted line for holding down the lower edge of a gillnet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "319de1e2-f6ea-4f59-9e85-94bc1b9092ea",
                                "sense_id": "fe56bcab-bfc6-308f-98b2-75e0f1b2bc36",
                                "text": "To attach the bridles, start measuring from the point on the gavel 16 metres from the floatline wheree you have seized the end of the leadline."
                            },
                            {
                                "example_id": "602ea29e-5810-4bbe-beaf-4282616195f7",
                                "sense_id": "fe56bcab-bfc6-308f-98b2-75e0f1b2bc36",
                                "text": "The hold was empty, without a net, corkline, leadline or buoy to be found."
                            },
                            {
                                "example_id": "9d8f9121-44c5-4340-8a67-70c32f27c1d9",
                                "sense_id": "fe56bcab-bfc6-308f-98b2-75e0f1b2bc36",
                                "text": "Generally, there will be equal selvedges to the floatline and leadline."
                            }
                        ]
