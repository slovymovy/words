                ],
                "senses": [
                    {
                        "sense_id": "71a9ba6c-73dd-38f1-9c92-bc8bba75affc",
                        "entry_id": "c4ada168-625a-35c5-ad7a-70f09bb3bb3e",
                        "glosses": [
                            "Conforme à la philosophie de Thomas Hobbes, qui défend le penchant naturel de l'être humain pour son intérêt individuel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3c2d609-1c5f-45d8-8083-07c9013f665d",
                                "sense_id": "71a9ba6c-73dd-38f1-9c92-bc8bba75affc",
                                "text": "Que fait en effet tout souverain rationnel, nous demande Gregory La Cava d'un air entendu? Esclave de la mécanique hobbesienne au même titre que ses sujets les plus humbles, il tend à œuvrer prioritairement dans le but de garder sa couronne."
                            },
                            {
                                "example_id": "d6b6d115-09f7-47b7-986b-01606b8177d4",
                                "sense_id": "71a9ba6c-73dd-38f1-9c92-bc8bba75affc",
                                "text": "Je ne vois pas pourquoi un président devrait professer une conception hobbesienne de la société. La guerre de tous contre tous, ça n’existe pas."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "202d9897-5583-4062-b963-20bcda96e0ba",
                        "source_entry_id": "c4ada168-625a-35c5-ad7a-70f09bb3bb3e",
                        "source_sense_id": "71a9ba6c-73dd-38f1-9c92-bc8bba75affc",
                        "target_lang_word": "Hobbesian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hobbesian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28e585c9-5fc2-390c-8b44-32b90ebb2adb",
                                        "entry_id": "9f7d6fb7-c7a5-39a6-8e7b-d770abf636cf",
                                        "glosses": [
                                            "Of, relating to, or influenced by Thomas Hobbes or his philosophical theories."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "deddabbf-fcd3-478e-98dd-df9f9ee96948",
                                                "sense_id": "28e585c9-5fc2-390c-8b44-32b90ebb2adb",
                                                "text": "a Hobbesian theory of the state"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a60d65fa-7021-34b3-ae38-5edb8ba54030",
                                        "entry_id": "9f7d6fb7-c7a5-39a6-8e7b-d770abf636cf",
                                        "glosses": [
                                            "Involving unrestrained, selfish, and uncivilized competition."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86c0c687-4a9d-4e32-b8ae-f7f19e925bd1",
                                                "sense_id": "a60d65fa-7021-34b3-ae38-5edb8ba54030",
                                                "text": "a cutthroat, Hobbesian environment"
                                            },
                                            {
                                                "example_id": "d71c5749-4c01-44ff-9045-73a70b6d2d60",
                                                "sense_id": "a60d65fa-7021-34b3-ae38-5edb8ba54030",
                                                "text": "In Hammett's writings, the social is constructed as a vast Hobbesian landscape of grim functionaries and desperate scrabblers […]"
                                            },
                                            {
                                                "example_id": "2ef3feed-091b-4342-8b3c-961d9c810c8c",
                                                "sense_id": "a60d65fa-7021-34b3-ae38-5edb8ba54030",
                                                "text": "Yet the focus on pushing for the best result has also fueled what current and former Uber employees describe as a Hobbesian environment at the company, in which workers are sometimes pitted against one another and where a blind eye is turned to infractions from top performers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Hobbesian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc8a2292-b34f-3812-a165-ee3e6b98a935",
                                        "entry_id": "9e219ce6-4f5b-3081-84f6-48705996c920",
                                        "glosses": [
                                            "A follower of the theories of Thomas Hobbes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "897e17a5-6177-46aa-a640-821606ad9b22",
                                                "sense_id": "fc8a2292-b34f-3812-a165-ee3e6b98a935",
                                                "text": "Hobbesians purport to describe social order as it is: a constant, iron-fisted effort to crush enemies and to incapacitate criminals."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a2a3fcf-fcdd-4a60-adfc-f9a6fb710212",
                        "source_entry_id": "c4ada168-625a-35c5-ad7a-70f09bb3bb3e",
                        "source_sense_id": "71a9ba6c-73dd-38f1-9c92-bc8bba75affc",
                        "target_lang_word": "Hobbsian",
