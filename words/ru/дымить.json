            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a5c32ecc-da46-37f8-92e0-5c8c747326ac",
                    "sense_definition": "Производить дым, плохо гореть с выделением большого количества дыма.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Старая печь постоянно <w>дымит</w> при растопке.",
                            "target_lang_translations": {
                                "de": "Der alte Ofen <w>qualmt</w> beim Anheizen ständig."
                            }
                        },
                        {
                            "text": "Из трубы <w>дымит</w> густой черный дым.",
                            "target_lang_translations": {
                                "de": "Aus dem Schornstein <w>raucht</w> dichter schwarzer Rauch."
                            }
                        }
                    ],
                    "common_phrases": [
                        "печь дымит",
                        "труба дымит"
                    ],
                    "target_lang_definitions": {
                        "de": "Rauch abgeben oder erzeugen, oft aufgrund einer unvollständigen Verbrennung."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "rauchen",
                                "target_lang_sense_clarification": "allgemeiner Begriff für das Ausstoßen von Rauch"
                            },
                            {
                                "target_lang_word": "qualmen",
                                "target_lang_sense_clarification": "stark rauchen, oft bei einer Fehlfunktion oder schlechtem Brennmaterial"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d96325f-2139-3d2a-a464-bd061a0e8757",
                    "sense_definition": "Разговорное выражение для процесса курения табака.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "smoking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он любит <w>дымить</w> трубкой на веранде по вечерам.",
                            "target_lang_translations": {
                                "de": "Er liebt es, abends auf der Veranda Pfeife zu <w>paffen</w>."
                            }
                        },
                        {
                            "text": "Не стоит <w>дымить</w> в закрытом помещении.",
                            "target_lang_translations": {
                                "de": "Man sollte in geschlossenen Räumen nicht <w>qualmen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "курить",
                        "смолить"
                    ],
                    "common_phrases": [
                        "дымить папиросой",
                        "дымить сигаретой"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Разговорный стиль"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Umgangssprachlicher Ausdruck für das Rauchen von Tabakwaren."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "qualmen",
                                "target_lang_sense_clarification": "umgangssprachlich für intensiv rauchen"
                            },
                            {
                                "target_lang_word": "paffen",
                                "target_lang_sense_clarification": "umgangssprachlich für das Rauchen von Pfeifen oder Zigarren"
                            }
                        ]
                    }
                }
            ]
        }
    ]
