                "word": "publireportage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "293d446e-6aa2-4374-a361-ab80264ed91e",
                        "entry_id": "6a9f8345-6c35-399f-ba96-bf8882822834",
                        "tags": [
                            "plural"
                        ],
                        "form": "publireportages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "93bb31e7-5a84-3d6a-afc6-3f91e1b1c5f4",
                        "entry_id": "6a9f8345-6c35-399f-ba96-bf8882822834",
                        "glosses": [
                            "Message publicitaire écrit ou télévisé, présenté sous la forme d’un reportage et qui permet de tenir au consommateur des propos plus détaillés que par les messages classiques tout en dissimulant le caractère promotionnel de ces propos."
                        ],
                        "tags": [
                            "Publicité"
                        ],
                        "examples": [
                            {
                                "example_id": "bcbe4142-eb7a-4aca-ae14-91e839f885ac",
                                "sense_id": "93bb31e7-5a84-3d6a-afc6-3f91e1b1c5f4",
                                "text": "Les publi-reportages, ces textes qui entretiennent la confusion entre journalisme et publicité, sont vieux comme la presse, quand il ne s’agit pas purement et simplement d’articles de commande ou de communiqués de presse à peine réécrits."
                            },
                            {
                                "example_id": "3d9a84dc-69fe-49de-baa0-97c80d0106f2",
                                "sense_id": "93bb31e7-5a84-3d6a-afc6-3f91e1b1c5f4",
                                "text": "Tout sourire dans sa parka rouge, « la survivante » pose en une de « Paris Match » (23/11), à l’occasion d’un voyage en Laponie s’étirant sur pas moins de huit pages ! Un beau publireportage…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e8044c6f-c492-4b2e-8995-55d2ca2ff751",
                        "source_entry_id": "6a9f8345-6c35-399f-ba96-bf8882822834",
                        "source_sense_id": "93bb31e7-5a84-3d6a-afc6-3f91e1b1c5f4",
                        "target_lang_word": "infomercial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infomercial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87b4bef3-1358-37e2-82ba-ecd30257d671",
                                        "entry_id": "0b7923d7-294f-3069-85f2-5183782d2124",
                                        "glosses": [
                                            "A program-length television commercial, typically between thirty minutes and one hour long, that advertises a product or service by presenting supposedly impartial information about it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c3b04ed-0f39-452e-aef9-a4d20e829fde",
                                                "sense_id": "87b4bef3-1358-37e2-82ba-ecd30257d671",
                                                "text": "Dionne and I were both named after great singers of the past who now do infomercials."
                                            },
                                            {
                                                "example_id": "173e6e88-216b-42fa-953a-7fef651cebd0",
                                                "sense_id": "87b4bef3-1358-37e2-82ba-ecd30257d671",
                                                "text": "Known for wearing her signature headdress and speaking in a thick Caribbean accent, Miss Cleo was the queen of psychic infomercials."
                                            },
                                            {
                                                "example_id": "03127ffd-d957-421d-94a0-10c8ff1c0d80",
                                                "sense_id": "87b4bef3-1358-37e2-82ba-ecd30257d671",
                                                "text": "“The number of product placements this season is hilarious to the point that it’s basically a giant infomercial,” one user posted."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
