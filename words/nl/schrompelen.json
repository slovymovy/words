                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude appels lagen al weken in de schaal en begonnen langzaam te <w>schrompelen</w>.",
                            "target_lang_translations": {
                                "en": "The old apples had been in the bowl for weeks and were slowly starting to <w>shrivel</w>."
                            }
                        },
                        {
                            "text": "Door de extreme hitte en droogte zal de oogst op het land snel <w>schrompelen</w>.",
                            "target_lang_translations": {
                                "en": "Due to the extreme heat and drought, the harvest on the land will quickly <w>wither</w>."
                            }
                        }
