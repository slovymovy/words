                                        "sense_id": "80b3a929-736c-3712-b4cc-4425cec4915e",
                                        "entry_id": "e2268c65-c4c7-3ab0-8d8f-eb4c2adccf9d",
                                        "glosses": [
                                            "The resettlement of a group of people."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "82690d64-f789-3f32-970d-95a1db532af4",
                                        "entry_id": "e2268c65-c4c7-3ab0-8d8f-eb4c2adccf9d",
                                        "glosses": [
                                            "A surgical operation in which an organ is moved from a donor to a recipient; an organ transplant.",
                                            "The medicosurgical specialty (field) concerned with such operations."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2ff3218f-b668-3f2f-9266-6433f8836276",
                                        "entry_id": "e2268c65-c4c7-3ab0-8d8f-eb4c2adccf9d",
                                        "glosses": [
                                            "A surgical operation in which an organ is moved from a donor to a recipient; an organ transplant.",
                                            "A particular instance of such an operation (a single procedure): a transplant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eb68d9ee-6393-3baa-a7d8-4b3515de468b",
                                        "entry_id": "e2268c65-c4c7-3ab0-8d8f-eb4c2adccf9d",
                                        "glosses": [
                                            "The uprooting of a tree and planting it in a new location."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5172bd5-b4f1-40e5-92c7-9e42d254a207",
                                                "sense_id": "eb68d9ee-6393-3baa-a7d8-4b3515de468b",
                                                "text": "There is no tree admits of transplantation so well as the Elm, for a tree of twenty years growth will admit of a remove."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2c7751c-280a-4815-bfbc-65b5740221b5",
                        "source_entry_id": "08d9ce4b-b817-3a20-bef9-afb90023f50e",
                        "target_lang_word": "transplant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transplant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "350842fc-ad2f-3512-8e88-4bba8f372e18",
                                        "entry_id": "a7e04316-a0a6-36b9-b51d-62c3d8311001",
                                        "glosses": [
                                            "To uproot (a growing plant), and plant it in another place."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c964037-bebe-4fba-8837-d652391a0f27",
                                                "sense_id": "350842fc-ad2f-3512-8e88-4bba8f372e18",
                                                "text": "Vanilla itself was transplanted from Madagascar, the main source of the spice, to Polynesia a century ago."
                                            },
                                            {
                                                "example_id": "86cde354-ddd0-4fdb-8f52-49df16036e41",
                                                "sense_id": "350842fc-ad2f-3512-8e88-4bba8f372e18",
                                                "text": "A book entitled Emerging Indonesia has on its cover photographs of a sunrise over palm trees, bent women in coolie hats transplanting rice, a wooden bull burning at a Balinese cremation, and a liquid nitrogen plant belching black smoke into a clear, undefiled tropical sky."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8affcc62-a082-34e8-a706-ac31054c7aa7",
                                        "entry_id": "a7e04316-a0a6-36b9-b51d-62c3d8311001",
                                        "glosses": [
                                            "To remove (something) and establish its residence in another place; to resettle or relocate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be1f2b9c-095a-4dc1-a4b3-1415cb6351ae",
                                                "sense_id": "8affcc62-a082-34e8-a706-ac31054c7aa7",
                                                "text": "Mention must be made of the Valdres Folk Museum, situated just outside the town—one of those fascinating open-air museums for which Scandinavia is justly famed, to which have been transplanted a number of ancient buildings, such as farmhouses and storehouses, full of appropriate furniture, costumes and other exhibits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd2e27de-c135-3c6f-952b-583da6bb12a2",
                                        "entry_id": "a7e04316-a0a6-36b9-b51d-62c3d8311001",
                                        "glosses": [
                                            "To transfer (tissue or an organ) from one body to another, or from one part of a body to another."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "transplant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7b8ae9a-960b-352b-ace3-9199da980abd",
                                        "entry_id": "9393f7ea-4b36-33eb-b86d-8eaa9c2c85a5",
                                        "glosses": [
                                            "An act of uprooting and moving (something), especially and archetypically a plant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "22c9715c-8ec9-3039-b0a3-c6da389214bb",
                                        "entry_id": "9393f7ea-4b36-33eb-b86d-8eaa9c2c85a5",
                                        "glosses": [
                                            "Anything that is transplanted, especially and archetypically a plant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0076716f-edde-3d1c-b26e-4660b5cc6dcf",
                                        "entry_id": "9393f7ea-4b36-33eb-b86d-8eaa9c2c85a5",
                                        "glosses": [
                                            "An operation (procedure) in which tissue or an organ is transplanted: an instance of transplantation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5eb24ab8-ddd0-3e34-add7-6a4b399a2c4f",
                                        "entry_id": "9393f7ea-4b36-33eb-b86d-8eaa9c2c85a5",
                                        "glosses": [
                                            "A transplanted organ or tissue: a graft."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1669e55c-dc18-33b2-9d98-4c976f4f2c49",
                                        "entry_id": "9393f7ea-4b36-33eb-b86d-8eaa9c2c85a5",
                                        "glosses": [
                                            "Someone who is not native to their area of residence."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a431acc-1157-4e06-b067-259e3d729343",
                                                "sense_id": "1669e55c-dc18-33b2-9d98-4c976f4f2c49",
                                                "text": "The Seigneur summoned the island's doctor, a young transplant from London named Peter Counsell, who determined that Mrs. Beaumont had suffered a stroke."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "720efaf7-f914-4fe4-bfc4-e59acaf088f8",
                        "source_entry_id": "08d9ce4b-b817-3a20-bef9-afb90023f50e",
                        "target_lang_word": "transplantation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transplantation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3d19878b-d469-3dee-92db-d28da31ba807",
                                        "entry_id": "d0c26ca1-2b93-35de-b851-87479b71f93f",
                                        "glosses": [
                                            "Action de transplanter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "440d9253-8a05-44a2-8aa8-64f6c6c08e07",
                                                "sense_id": "3d19878b-d469-3dee-92db-d28da31ba807",
                                                "text": "MM. E. Burnouf et Lassen […] ont démontré que, du sixième siècle avant notre ère, datait la transplantation du bouddhisme à Ceylan ; …."
                                            },
                                            {
                                                "example_id": "61e471af-1693-46e6-97f5-69df43370649",
                                                "sense_id": "3d19878b-d469-3dee-92db-d28da31ba807",
                                                "text": "Mais, dans le Puy-de-Dôme tout au moins, il n'y a point que des inconvénients à cette transplantation de tant de ruraux en ville."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "037455f0-b7d5-31f2-84a7-4fed2462ae09",
                                        "entry_id": "d0c26ca1-2b93-35de-b851-87479b71f93f",
                                        "glosses": [
                                            "Action de déplanter, pour replanter dans un lieu différent."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21f7b08f-13d1-4c2b-9198-bbbcfacbe670",
                                                "sense_id": "037455f0-b7d5-31f2-84a7-4fed2462ae09",
                                                "text": "On opère de préférence la transplantation par un temps humide ou couvert, où l’évaporation est peu active."
                                            },
                                            {
                                                "example_id": "79d16a4b-a91a-42e5-a7e8-f7dd39559cf8",
                                                "sense_id": "037455f0-b7d5-31f2-84a7-4fed2462ae09",
                                                "text": "Le grand avantage du D.D. dans les cultures maraîchères semble être que l’on peut traiter à des doses élevées qui permettent d’obtenir des pépinières bien désinfectées, ce qui empêche une infestation des planches saines par transplantation de plantules déjà infectées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e46341b-4ce9-3580-a6af-b4a8c7988d54",
                                        "entry_id": "d0c26ca1-2b93-35de-b851-87479b71f93f",
                                        "glosses": [
                                            "Action de prélever un organe sur un individu, et de le greffer ensuite sur un autre."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
