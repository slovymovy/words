                                                "example_id": "789eda8f-535f-45d6-8421-209663959077",
                                                "sense_id": "6a79a0cc-6a81-3a93-a244-962b99ae2f1a",
                                                "text": "Bankmanager sind während der Finanzkrise in den Ruf geraten, raffgierig und skrupellos zu sein."
                                            },
                                            {
                                                "example_id": "e165c43f-5b9a-4c56-bbfe-0686da4089a3",
                                                "sense_id": "6a79a0cc-6a81-3a93-a244-962b99ae2f1a",
                                                "text": "„Damien Hirst und sein in Formaldehyd gelagerter Tigerhai werden zum Symbol einer dekadenten, raffgierigen Kunstwelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7730b784-e2bf-4148-be56-4002537fbe85",
