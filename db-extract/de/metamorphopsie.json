                "senses": [
                    {
                        "sense_id": "7f157eaf-334f-397e-a64b-f38eab90c4cd",
                        "entry_id": "8d5e96b8-8649-3be7-a487-99e9e12fe1a1",
                        "glosses": [
                            "Sehstörung, bei der die Umgebung beziehungsweise Dinge verändert und/oder verzerrt wahrgenommen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db0a4a83-1b25-4afb-9bd8-202620bc5216",
                                "sense_id": "7f157eaf-334f-397e-a64b-f38eab90c4cd",
                                "text": "„Die Metamorphopsie ist eine Störung, bei der Form und Farbe eines Gegenstands verzerrt wahrgenommen werden.“"
                            },
                            {
                                "example_id": "cec62eb4-3999-4fb9-b7f2-5beda57119be",
                                "sense_id": "7f157eaf-334f-397e-a64b-f38eab90c4cd",
                                "text": "„Die Schwellung führt zu einer Lageveränderung der Rezeptorzellen und damit zu einer möglichen Refraktionsänderung hin zu positiveren Werten sowie zu einer als Metamorphopsie bezeichneten Wahrnehmung von ‚verbogenen‘ Linien oder Kanten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f1fdb53-5841-4de1-b6f2-cdf13ca360a8",
                        "source_entry_id": "8d5e96b8-8649-3be7-a487-99e9e12fe1a1",
                        "source_sense_id": "7f157eaf-334f-397e-a64b-f38eab90c4cd",
                        "target_lang_word": "метаморфопсия",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "метаморфопсия",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "cb674ad6-f43e-3cff-b94f-f4df89c75b1d",
                                        "entry_id": "1beecb39-0966-3760-8e90-372d212a6aeb",
                                        "glosses": [
                                            "психиатр. нарушение восприятия формы и размеров визуально воспринимаемых объектов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d49415d-d9fd-47cc-adf0-bd18a2e11437",
                                                "sense_id": "cb674ad6-f43e-3cff-b94f-f4df89c75b1d",
                                                "text": "Явления метаморфопсии нередко фигурируют в зрительных обманах восприятия, что может рассматриваться как косвенное доказательство симптомообразования метаморфопсии на основе растройств самоосознования. Чаще всего метаморфопсии встречаются при шизофрении, органических повреждениях головного мозга, во время фокальных приступов эпилепсии, опьянении психоделическими субстанциями."
                                            },
                                            {
                                                "example_id": "a89e528e-93d2-4c1f-87b1-a6b8ea51af06",
                                                "sense_id": "cb674ad6-f43e-3cff-b94f-f4df89c75b1d",
                                                "text": "Здесь в особенности приходится считаться с возможностью поражения области интерпариетальной борозды, имеющей значение для синтеза ощущений относящихся к различным органам чувств. Петцль, Каминер и Гоф показали, что при поражении этой зоны наблюдаются различные явления, входящие в понятие метаморфопсии — такого рода расстройство восприятия, когда искажается форма воспринимаемых объектов, например ноги кажутся кривыми, глаза — косыми, предметы — слишком большими или слишком маленькими."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
