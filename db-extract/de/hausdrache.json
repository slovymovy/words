                                    {
                                        "sense_id": "e85e4754-6457-3c64-946d-51d2e239ba29",
                                        "entry_id": "ec31b70f-2762-3aa0-a7b3-78f007c5e5b1",
                                        "glosses": [
                                            "Any of numerous small, mouselike, chiefly nocturnal, mammals of the family Soricidae."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0fb9dfc9-90c6-3217-88f4-d7aa1c80ba09",
                                        "entry_id": "ec31b70f-2762-3aa0-a7b3-78f007c5e5b1",
                                        "glosses": [
                                            "Certain other small mammals that resemble true shrews."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0e3c30a7-95ed-3f19-9f2f-48ca21c952eb",
                                        "entry_id": "ec31b70f-2762-3aa0-a7b3-78f007c5e5b1",
                                        "glosses": [
                                            "An ill-tempered, nagging woman: a scold."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42f1381c-8562-42aa-bff1-e960e3f0b999",
                                                "sense_id": "0e3c30a7-95ed-3f19-9f2f-48ca21c952eb",
                                                "text": "The clerk had, I'm afraid, a shrew of a wife—shrill, vehement, and fluent. 'Rogue,' 'old miser,' 'old sneak,' and a great many worse names, she called him."
                                            },
                                            {
                                                "example_id": "7b8dfc5d-cfaf-45a2-92b2-f3d56342aa21",
                                                "sense_id": "0e3c30a7-95ed-3f19-9f2f-48ca21c952eb",
                                                "text": "His wife was a shrew with warts on her face and she spoke to him sharply when others were present, but Simcha did not complain."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shrew",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10b3b882-45cc-3caa-8438-7c41f7512174",
                                        "entry_id": "f83f7fc0-4352-37d7-9ba4-1b12b82537da",
                                        "glosses": [
                                            "To beshrew; to curse."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc1bc33a-2bef-4bcd-8b1e-ea574b2387cd",
                                                "sense_id": "10b3b882-45cc-3caa-8438-7c41f7512174",
                                                "text": "I shrew myself."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b32d58b4-06c9-4020-aee8-78a8412a890e",
                        "source_entry_id": "82bce7b2-fb13-3c61-8573-1eb1c6f7b3b5",
                        "source_sense_id": "587ab6ca-a3dd-35fa-ad7d-ca680faef683",
                        "source_sense_description": "streitsüchtige, zänkische im gleichen Haushalt lebende Frau",
                        "target_lang_word": "mégère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mégère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "de453498-eb8e-342f-a6a3-6c1ab9e76d88",
                                        "entry_id": "446e25ad-8454-35fa-b265-372126b21258",
                                        "glosses": [
                                            "Femme méchante et emportée, par allusion à l’une des Érinyes."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48cfde59-e92a-4671-9843-73fbdcd2ef42",
                                                "sense_id": "de453498-eb8e-342f-a6a3-6c1ab9e76d88",
                                                "text": "On se les figurerait volontiers comme des mégères au regard hardi, au geste forcené, et l’on se tromperait fort : jamais plus doux visage de madone, paupières plus veloutées, sourires plus tendres, ne se sont inclinés sur un enfant Jésus."
                                            },
                                            {
                                                "example_id": "696e5fee-38bb-4ff5-b315-a1fcfd3f0236",
                                                "sense_id": "de453498-eb8e-342f-a6a3-6c1ab9e76d88",
                                                "text": "Il y avait tout de même chez elle un fond de délicatesse, une loyauté dans les procédés […], qui suffisent à mettre des abîmes entre elle et une mégère comme la Verdurin."
                                            },
                                            {
                                                "example_id": "541dcebb-efea-4e13-9f47-d5b69dab6921",
                                                "sense_id": "de453498-eb8e-342f-a6a3-6c1ab9e76d88",
                                                "text": "C’est une vraie mégère."
                                            },
                                            {
                                                "example_id": "b2bcf1f8-32e0-4b9e-976b-052f5980dff1",
                                                "sense_id": "de453498-eb8e-342f-a6a3-6c1ab9e76d88",
                                                "text": "Il a épousé une mégère."
                                            },
                                            {
                                                "example_id": "fd8f3da3-929f-49c4-b827-7544474c5ced",
                                                "sense_id": "de453498-eb8e-342f-a6a3-6c1ab9e76d88",
                                                "text": "Il y avait dans cette foule de hideuses mégères."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71e0b7a1-7bf4-38b8-877f-3c848a66bd2f",
                                        "entry_id": "446e25ad-8454-35fa-b265-372126b21258",
                                        "glosses": [
                                            "Insecte lépidoptère, papillon de jour de la famille des Nymphalidés, dont les ailes sont de couleur jaune orangé marqué de lignes marron avec des ocelles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb1db66c-1788-4aab-9343-b647780e72ce",
                                                "sense_id": "71e0b7a1-7bf4-38b8-877f-3c848a66bd2f",
                                                "text": "La chenille de la mégère se nourrit sur les graminées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
