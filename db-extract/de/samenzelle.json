                            {
                                "example_id": "7af980d2-ffe7-4602-a0a2-74d1ce23d8d5",
                                "sense_id": "a974bc20-3ec7-3a41-ad5b-a7023bb4794c",
                                "text": "Die Vereinigung von Ei- und Samenzelle wird Gametogamie genannt."
