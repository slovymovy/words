        "fr-extract.jsonl": [
            {
                "entry_id": "f06a60d3-732b-39b0-a17a-b4a66b7a7146",
                "word": "notablement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "78c8bf10-11f8-3cd9-9821-dbf0fd48d720",
                        "entry_id": "f06a60d3-732b-39b0-a17a-b4a66b7a7146",
                        "glosses": [
                            "D’une manière notable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bc2cf02-5436-4dbb-87ed-4968c0efb999",
                                "sense_id": "78c8bf10-11f8-3cd9-9821-dbf0fd48d720",
                                "text": "Cette action contribua notablement à sa gloire."
                            }
                        ]
                    },
                    {
                        "sense_id": "bb3a26df-b12d-3f95-bbba-8df8e85aca06",
                        "entry_id": "f06a60d3-732b-39b0-a17a-b4a66b7a7146",
                        "glosses": [
                            "Significativement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f69c46f7-68f8-4b00-8b4d-00c61813e64a",
                                "sense_id": "bb3a26df-b12d-3f95-bbba-8df8e85aca06",
                                "text": "Le bassin entier de la Brenne, à l'ouest de la route de Châteauroux à Lothiers, est notablement plus bas que les plateaux correspondants des bords de l'Indre ou de la Creuse."
                            },
                            {
                                "example_id": "7824e206-1a0e-44b1-932a-b79b2aa45e90",
                                "sense_id": "bb3a26df-b12d-3f95-bbba-8df8e85aca06",
                                "text": "Nous avons eu entre les mains des sextants japonais, construits en métal léger, pendant la guerre, qui étaient notablement rongés par les embruns. De telles défectuosités ne se produisent plus maintenant, grâce à des parkérisations ou à des traitements très soignés du métal."
                            },
                            {
                                "example_id": "7aa06fa3-720a-4c01-9e6a-1655809438a9",
                                "sense_id": "bb3a26df-b12d-3f95-bbba-8df8e85aca06",
                                "text": "À cause de la diffraction, on ne peut pas diaphragmer notablement un objectif formant ses images sur un petit capteur."
                            }
                        ]
                    }
                ],
