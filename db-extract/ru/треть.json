                                            {
                                                "example_id": "55901c17-3738-42fe-bfb6-4fe99f587145",
                                                "sense_id": "f64f6af6-fdf1-3a1f-9cd4-2a5457891019",
                                                "text": "Ein Drittel des Kuchens werde ich sofort essen, die anderen zwei Drittel hebe ich für meine Kinder auf."
                                            },
                                            {
                                                "example_id": "53adc257-9ddf-43be-bde5-a7b082ffce96",
                                                "sense_id": "f64f6af6-fdf1-3a1f-9cd4-2a5457891019",
                                                "text": "Ein Drittel der Wähler ist noch unentschlossen."
                                            },
                                            {
                                                "example_id": "4d6a6fe9-6f84-4380-b55c-37a7c38befe4",
                                                "sense_id": "f64f6af6-fdf1-3a1f-9cd4-2a5457891019",
                                                "text": "33,33 % sind (fast) ein Drittel."
                                            },
                                            {
                                                "example_id": "c0795a6e-7faa-447b-bb19-01caff05d041",
                                                "sense_id": "f64f6af6-fdf1-3a1f-9cd4-2a5457891019",
                                                "text": "„Es gibt ganz konkrete historische Gründe dafür, dass Ostdeutschland bis heute erst gute zwei Drittel der westdeutschen Wirtschaftskraft erreicht.“"
                                            },
                                            {
                                                "example_id": "a8fff51c-c698-433d-bbd3-43a98e82c3d9",
                                                "sense_id": "f64f6af6-fdf1-3a1f-9cd4-2a5457891019",
                                                "text": "„Das Lesen auf dem Land und lange auch das in den Städten richtete sich – so die einfachen Leute überhaupt alphabetisiert waren – bis ins erste Drittel des 18. Jahrhunderts hauptsächlich auf Erbauungsbücher und die Bibel.“"
                                            },
                                            {
                                                "example_id": "fb22242b-c330-46f3-aa78-6c2415fec264",
                                                "sense_id": "f64f6af6-fdf1-3a1f-9cd4-2a5457891019",
                                                "text": "„So entfällt mehr als ein Drittel des Zuwachses auf die Q-Modelle.“"
                                            },
                                            {
                                                "example_id": "8f6eecca-53a1-4858-b32f-b8330fdbd019",
                                                "sense_id": "f64f6af6-fdf1-3a1f-9cd4-2a5457891019",
                                                "text": "„Man kann ja nicht zwei Drittel von Tag und Nacht oder den Winter überhaupt verschlafen; der Mensch ist kein Murmeltier.“"
                                            },
                                            {
                                                "example_id": "3b44578d-6aea-4ce9-9fa9-987343865474",
                                                "sense_id": "f64f6af6-fdf1-3a1f-9cd4-2a5457891019",
                                                "text": "„Die Nachfrage sei um einen Drittel angestiegen.“"
                                            },
                                            {
                                                "example_id": "87f1185e-f3ca-47ea-bfba-df275d0b1f90",
                                                "sense_id": "f64f6af6-fdf1-3a1f-9cd4-2a5457891019",
                                                "text": "„Die privaten Haushalte verbrauchen in der Schweiz gut einen Drittel des Stroms.“"
                                            },
                                            {
                                                "example_id": "11746352-bfc8-48bd-a267-d6eea4ed481d",
                                                "sense_id": "f64f6af6-fdf1-3a1f-9cd4-2a5457891019",
                                                "text": "„Wie das Statistische Bundesamt mitteilte, haben sich die Preise für Backwaren von 2019 bis 2023 um gut ein Drittel erhöht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
