                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bad luck",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d520753f-22fa-3aee-8971-906874f4682e",
                                        "entry_id": "67d4a23a-2d9c-3ff5-873d-188165b82f2e",
                                        "glosses": [
                                            "An undesirable turn of events (such as an accident); misfortune."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e06099e-bdc5-42cc-9525-6f7d53ce92e2",
                                                "sense_id": "d520753f-22fa-3aee-8971-906874f4682e",
                                                "text": "McCarthy will point to their bad luck but the statistics now show that Wolves have lost four league matches and have claimed one point from a possible 15 - so it may prove to be another difficult season for the Midlands side."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "276f8936-e454-4f39-9648-619b7b20d375",
                        "source_entry_id": "8d3ef968-0495-37cb-a546-4805e1637502",
                        "source_sense_id": "f8b52f98-63b5-39f8-adb2-d7af45691b4b",
                        "source_sense_description": "de conditie waarin er tegenslag te verwerken is die niet door eigen schuld veroorzaakt is",
                        "target_lang_word": "malchance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "malchance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f6a9631d-f3c1-3c96-983b-c5758e78bdce",
                                        "entry_id": "a832c47a-9351-3507-b52c-04671295c687",
                                        "glosses": [
                                            "Mauvaise chance, suite de mésaventures, revers dus à un hasard malheureux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d57436f2-f1d1-411e-b9fb-d4f34dcb02fd",
                                                "sense_id": "f6a9631d-f3c1-3c96-983b-c5758e78bdce",
                                                "text": "Quelle ne fut pas notre malchance: le générateur de notre poste, qui est escamotable, […], lorsqu'il n'est pas nécessaire de recharger les accumulateurs, se coinça sur son rail de sortie: […]."
                                            },
                                            {
                                                "example_id": "25c0eb48-5393-4aef-812e-1c48bc4e936c",
                                                "sense_id": "f6a9631d-f3c1-3c96-983b-c5758e78bdce",
                                                "text": "Quelle malchance persistante! — C’est une malchance d’être arrivé ce jour-là."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "744ba5ce-aec6-438b-b7a6-594de8a4a341",
                        "source_entry_id": "8d3ef968-0495-37cb-a546-4805e1637502",
                        "source_sense_id": "f8b52f98-63b5-39f8-adb2-d7af45691b4b",
                        "source_sense_description": "de conditie waarin er tegenslag te verwerken is die niet door eigen schuld veroorzaakt is",
                        "target_lang_word": "guigne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guigne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bdc39c2b-2335-3feb-b413-19aa326b3221",
                                        "entry_id": "55c2c2e2-53c1-3579-b661-8aa997e05f37",
                                        "glosses": [
                                            "Malchance, poisse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "751ab836-61ff-42a3-a6c9-49af28ed41f9",
                                                "sense_id": "bdc39c2b-2335-3feb-b413-19aa326b3221",
                                                "text": "Porter la guigne."
                                            },
                                            {
                                                "example_id": "16a7aa63-3b48-4203-b902-2030e619c3e2",
                                                "sense_id": "bdc39c2b-2335-3feb-b413-19aa326b3221",
                                                "text": "Les paysans, naïvement lâches et fangeusement égoïstes, impénétrables au sentiment de la Patrie et tout à fait étrangers à l’idée de Race, ne virent, en somme, dans la guerre, qu’un funeste coup du sort, une guigne noire qu’il s’agissait de conjurer, chacun pour soi, par toutes les crapuleries et les manigances."
                                            },
                                            {
                                                "example_id": "5b9f27e4-718d-478f-b7cb-2367acdedd4a",
                                                "sense_id": "bdc39c2b-2335-3feb-b413-19aa326b3221",
                                                "text": "Sans relâche ni trêve, la guigne, une guigne affreusement verdâtre, s’était acharnée sur lui, une de ces guignes comme on n’en compte pas trois dans le siècle le plus fertile en guignes."
                                            },
                                            {
                                                "example_id": "b4571dc2-5d43-43cf-8de9-fc72dcdef6c6",
                                                "sense_id": "bdc39c2b-2335-3feb-b413-19aa326b3221",
                                                "text": "— Un curé ! la guigne, alors !"
                                            },
                                            {
                                                "example_id": "a34c9670-085a-4d6a-a7f0-d9a91071b346",
                                                "sense_id": "bdc39c2b-2335-3feb-b413-19aa326b3221",
                                                "text": "– Je n’ai jamais eu une guigne pareille. La petite vient de me faire capot trois fois d’affilée."
                                            },
                                            {
                                                "example_id": "7c57a2dd-dda1-4747-beec-3e8f85339474",
                                                "sense_id": "bdc39c2b-2335-3feb-b413-19aa326b3221",
                                                "text": "Je restais là comme un dadais\nElle était belle comme un cygne\nEt moi j’avais une de ces guignes\nÇa n’était pas ce que je croyais."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "guigne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "528d3d83-1c56-3ea7-87b6-1973b9dc2e00",
                                        "entry_id": "91cd3e6c-8b8c-39c9-a968-8f60fad13cb1",
                                        "glosses": [
                                            "Cerise douce à chair molle, rouge foncé à noire et insipide, principalement utilisée dans l’industrie alimentaire et entrant dans la composition du guignolet, un apéritif liquoreux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b686996-e07e-44cd-af2c-3b1749a41c29",
                                                "sense_id": "528d3d83-1c56-3ea7-87b6-1973b9dc2e00",
                                                "text": "Les guignes, chair commune, noire, meurtrie de baisers"
                                            },
                                            {
                                                "example_id": "a52748db-5828-47ad-b5c2-1fdd812454ea",
                                                "sense_id": "528d3d83-1c56-3ea7-87b6-1973b9dc2e00",
                                                "text": "Mais il reste heureusement assez de magnifiques cerises (les guignes) pour permettre à une illustre maison de fabriquer son guignolet, triomphe de la distillerie angevine."
                                            },
                                            {
                                                "example_id": "7c02afa1-ed0e-49e3-8748-503de72d876f",
                                                "sense_id": "528d3d83-1c56-3ea7-87b6-1973b9dc2e00",
                                                "text": "En expliquant sa recette de confiture de guignes, Nostradamus fait ainsi l’éloge de villes et de régions françaises renommées dans ce domaine."
                                            },
                                            {
                                                "example_id": "55d77896-26de-4ffa-ad03-63b5ee005154",
                                                "sense_id": "528d3d83-1c56-3ea7-87b6-1973b9dc2e00",
                                                "text": "La barbe noire du passant, son cheval rouge comme guigne, sa pâleur de vampire distingué ne déplurent pas à la jeune fille, mais elle l’oubliait au moment où il s’enquit d’elle."
                                            },
                                            {
                                                "example_id": "929d881b-26f3-427b-93ef-97d5e3c3c375",
                                                "sense_id": "528d3d83-1c56-3ea7-87b6-1973b9dc2e00",
                                                "text": "Elle s’était pendu, par gaminerie, des guignes aux oreilles, des guignes noires qui sautaient sur ses joues, quand elle se penchait, toute sonore de rires."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "guigne",
                                "target_lang_code": "fr",
                                "target_senses": [
