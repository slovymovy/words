                                    },
                                    {
                                        "sense_id": "599f0ee6-08ca-3f5e-b80f-9d01af3e304f",
                                        "entry_id": "f73978e2-ced8-3e67-87ff-5aa2e088cedd",
                                        "glosses": [
                                            "so beschaffen, dass man darin nicht unangenehm auffällt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58751b34-ea58-4c13-ac12-05a538767689",
                                                "sense_id": "599f0ee6-08ca-3f5e-b80f-9d01af3e304f",
                                                "text": "Neben seinen bizarren Laufsteg-Kreationen entwirft er auch sehr tragbare Mode."
                                            },
                                            {
                                                "example_id": "6f30b74c-ac75-4293-83f7-221797681235",
                                                "sense_id": "599f0ee6-08ca-3f5e-b80f-9d01af3e304f",
                                                "text": "„Alber Elbaz, mit seinen Lanvin-Frauenkollektionen ein Meister der fließenden Silhouette, lässt das jetzt wieder aufleben. Und beschert uns so mit seinem Eighties-Revival die modernsten und gleichzeitig schönsten und tragbarsten Anzüge der Saison.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9787fc09-c199-352f-94fe-8dbcb386b6bb",
                                        "entry_id": "f73978e2-ced8-3e67-87ff-5aa2e088cedd",
                                        "glosses": [
                                            "wert, ertragen oder unterstützt zu werden"
                                        ],
                                        "tags": [
                                            "Personen",
                                            "nur negiert oder eingeschränkt durch eine Wendung wie „gerade noch“"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bced605-54fa-4429-89fb-348f2ff16e1d",
                                                "sense_id": "9787fc09-c199-352f-94fe-8dbcb386b6bb",
                                                "text": "Nach seinen dubiosen Geschäften ist er für uns als Geschäftsführer nicht mehr tragbar."
                                            }
