                "senses": [
                    {
                        "sense_id": "35407515-379d-3cd8-a821-7a2aa6bcc5a8",
                        "entry_id": "7f9012ce-a77a-36bd-9fbe-2b8858336754",
                        "glosses": [
                            "Gefühl der Bindung / Zusammengehörigkeit einer Gruppe von Menschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f7241be-c4f7-4db0-a6fe-4de1cac8456d",
                                "sense_id": "35407515-379d-3cd8-a821-7a2aa6bcc5a8",
                                "text": "„Es ist schon ein anderes Wir-Gefühl im Dorf.“"
                            },
                            {
                                "example_id": "95e5d453-f5fb-479d-a0a7-b6f0240ac27d",
                                "sense_id": "35407515-379d-3cd8-a821-7a2aa6bcc5a8",
                                "text": "„Gelingt es, das Wir-Gefühl einer Gruppe zu steigern, so eint sie sich auf ein kollektiv gültiges Muster des Fühlens. So wie Bewegungen können auch Gefühle synchronisiert werden - die zentrale Erkenntnis Segers.“"
                            },
                            {
                                "example_id": "36240349-e35a-4530-91f9-c0e56d18e84f",
                                "sense_id": "35407515-379d-3cd8-a821-7a2aa6bcc5a8",
                                "text": "„Die Forscher schließen aus dem Experiment, dass Gruppen mit starkem Wir-Gefühl besonders zu Selbstüberschätzung neigen.“"
                            },
                            {
                                "example_id": "ca0bb824-d048-4dca-a7b8-4a1631f6bd15",
                                "sense_id": "35407515-379d-3cd8-a821-7a2aa6bcc5a8",
                                "text": "„80 Prozent der Befragten gaben an, dass für sie ein \"Wir-Gefühl\" wichtig ist. Allerdings glaubt nur ein Viertel, dass dieses Gefühl auch für die Mitmenschen bedeutsam ist.“"
                            },
                            {
                                "example_id": "87c62850-e16b-41ff-847d-0ddb35289a60",
                                "sense_id": "35407515-379d-3cd8-a821-7a2aa6bcc5a8",
                                "text": "„Hat man immer weniger Sex, und leidet zumindest einer der Partner darunter, zerfällt auch das Wir-Gefühl schneller.“"
                            },
                            {
                                "example_id": "5b90f36c-2e81-4ad7-a115-9948bc023472",
                                "sense_id": "35407515-379d-3cd8-a821-7a2aa6bcc5a8",
                                "text": "„Es ist ein nachdenkliches Album [des Musikers H. Grönemeyer], das […] an ein Wir-Gefühl gegen Hass, Hetze und Rechtspopulismus appelliert.“"
                            },
                            {
                                "example_id": "90a159d2-ae42-4278-96be-1097a943329b",
                                "sense_id": "35407515-379d-3cd8-a821-7a2aa6bcc5a8",
                                "text": "„Als St.-Pauli-Trainer hatte es der 45-Jährige wie kaum ein Zweiter verstanden, den schmalen Grat zwischen kumpelhaft und autoritär zu meistern. Die richtigen Worte zur richtigen Zeit und das berühmte \"Wir-Gefühl\" schaffen, das soll auch jetzt ein Schlüssel zum Erfolg sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
