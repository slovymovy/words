                "senses": [
                    {
                        "sense_id": "94d4d3f1-54a6-3575-adb2-e8b46aa3d6c9",
                        "entry_id": "f151d354-853b-3db5-8271-30d043c1b7ff",
                        "glosses": [
                            "Messgerät für elektrische Ladungen und Spannungen"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "07a54a0c-36d5-48eb-885d-79ace5644aac",
                                "sense_id": "94d4d3f1-54a6-3575-adb2-e8b46aa3d6c9",
                                "text": "„Der durch die Belichtung entstehende Photostrom läßt sich somit durch die während eines bestimmten Zeitraumes erfolgende Aufladung des Elektrometers messen.“"
                            },
                            {
                                "example_id": "9adeb3cd-c769-42bf-82be-127bf2aff66f",
                                "sense_id": "94d4d3f1-54a6-3575-adb2-e8b46aa3d6c9",
                                "text": "„Die innere Röhre wird mit Quecksilber gefüllt, so daß der Kontakt mit dem Elektrometer durch Eintauchen eines Drahtes in die innere Röhre hergestellt werden kann.“"
                            },
                            {
                                "example_id": "b4194df1-cb37-4e0c-b673-a8c6098f13d5",
                                "sense_id": "94d4d3f1-54a6-3575-adb2-e8b46aa3d6c9",
                                "text": "„Nach einiger Zeit wird wieder abgeschirmt und die Spannung wird mitdem Elektrometer bestimmt, woraus man den Vertikalstrom berechnen kann.“"
                            },
                            {
                                "example_id": "e4750997-b43a-47dc-8d50-7d7bbae8706d",
                                "sense_id": "94d4d3f1-54a6-3575-adb2-e8b46aa3d6c9",
                                "text": "„Die hauptsächlichste Anwendung des Elektrometers im Laboratorium besteht in der Vergleichung elektromotorischer Kräfte von Elementen im ungeschlossenen Stromkreis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
