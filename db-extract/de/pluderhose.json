                ],
                "senses": [
                    {
                        "sense_id": "488821ce-fd43-3584-8ffc-4bdd1afc4723",
                        "entry_id": "e21753b5-c26c-3a0e-9016-24a9d64baa55",
                        "glosses": [
                            "besonders weite, bauschige, (knie-)lange Hose"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "484f1c07-cce5-4640-9902-23ec81714d15",
                                "sense_id": "488821ce-fd43-3584-8ffc-4bdd1afc4723",
                                "text": "„Ein glatzköpfiger Clown in Pluderhose kommt von vorne auf ihn zu und hält ihm eine unsichtbaren Zigarette hin.“"
                            },
                            {
                                "example_id": "2d68edd2-e7c2-44e1-a45c-b139347fd800",
                                "sense_id": "488821ce-fd43-3584-8ffc-4bdd1afc4723",
                                "text": "„Wie alle jungen Inderinnen trägt sie einen bunten Chudidar, ein knielanges Oberteil mit Schal und Pluderhose.“"
                            },
                            {
                                "example_id": "6e812865-f28a-42e3-82a4-011cdc16fd66",
                                "sense_id": "488821ce-fd43-3584-8ffc-4bdd1afc4723",
                                "text": "„Er ist Bauer, trägt die landesübliche Pluderhose, eine weiße Kappe und einen frisch gestutzten Vollbart.“"
                            },
                            {
                                "example_id": "533b770e-8579-4402-a9cf-7a784364ad62",
                                "sense_id": "488821ce-fd43-3584-8ffc-4bdd1afc4723",
                                "text": "„Wer schon lange keine Beute mehr gemacht und seine Pluderhosen versetzt oder verspielt hat, kann sich mit einem Rock behelfen, einem um den Leib geschlungenen bunten Stofffetzen über nackten Waden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
