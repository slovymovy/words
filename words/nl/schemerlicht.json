                                "target_lang_sense_clarification": "soft light at dawn or dusk"
                            },
                            {
                                "target_lang_word": "half-light",
                                "target_lang_sense_clarification": "dim natural lighting"
                            },
                            {
                                "target_lang_word": "dusk",
                                "target_lang_sense_clarification": "fading light at sunset"
                            }
                        ]
