                                    },
                                    {
                                        "sense_id": "be9353fe-24e7-3acf-9cb8-c9435791c4a2",
                                        "entry_id": "34f8f252-e962-3360-a24e-6bf64946393a",
                                        "glosses": [
                                            "Relatif à Rivière-Bleue, municipalité québécoise ^([1])."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4eccbe2c-1f2a-3402-8fd6-c090d8fa4105",
                                        "entry_id": "34f8f252-e962-3360-a24e-6bf64946393a",
                                        "glosses": [
                                            "Relatif à Rivière-Pentecôte, ancienne municipalité québécoise, désormais secteur de la ville de Port-Cartier. On dit plutôt pentecôtois ^([1])."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "945a8e5a-2281-364a-af5c-f9433823a83a",
                                        "entry_id": "34f8f252-e962-3360-a24e-6bf64946393a",
                                        "glosses": [
                                            "Relatif à Saint-Joseph-de-la-Rive, ancienne municipalité de village québécoise, désormais secteur de la municipalité des Éboulements ^([1])."
                                        ],
