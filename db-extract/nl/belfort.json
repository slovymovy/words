                    {
                        "sense_id": "9652c126-107f-31dd-824c-8dc00a787799",
                        "entry_id": "a7cf09a4-e277-3a14-b631-1655f4eb72a6",
                        "glosses": [
                            "een stedelijke wachttoren met een stormklok"
                        ],
                        "tags": [
                            "Middle-Ages"
                        ],
                        "examples": [
                            {
                                "example_id": "15a3413c-445a-4933-9204-2c95f2fc2c71",
                                "sense_id": "9652c126-107f-31dd-824c-8dc00a787799",
                                "text": "Met een belfort toonde de stedelijke burgerij haar welvaart en macht."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eaa21434-350e-4beb-8a9c-c043beb39243",
                        "source_entry_id": "a7cf09a4-e277-3a14-b631-1655f4eb72a6",
                        "source_sense_id": "9652c126-107f-31dd-824c-8dc00a787799",
                        "source_sense_description": "een stedelijke wachttoren met een stormklok",
                        "target_lang_word": "Belfried",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Belfried",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "52b7b22d-6139-3ff6-88ac-49457efe175e",
                                        "entry_id": "23ff9c14-857e-3e12-a771-654f74297b71",
                                        "glosses": [
                                            "nichtkirchlicher Glockenturm (beispielsweise an einem Rathaus oder einer Markthalle), wie er typisch für Belgien und Nordfrankreich ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96c33426-cd9a-424a-8ee8-6e3e9d349ef0",
                                                "sense_id": "52b7b22d-6139-3ff6-88ac-49457efe175e",
                                                "text": "„Doch während des Aalster Karnevals regnet es etwa 2000 zuckersüße Zwiebeln vom Belfried herab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c015df4-655f-4083-878d-0bd4adae8c86",
                        "source_entry_id": "a7cf09a4-e277-3a14-b631-1655f4eb72a6",
                        "source_sense_id": "9652c126-107f-31dd-824c-8dc00a787799",
                        "source_sense_description": "een stedelijke wachttoren met een stormklok",
                        "target_lang_word": "Glockenturm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Glockenturm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2f05d98f-c24d-3d85-bc45-5e08c0328660",
                                        "entry_id": "3125d892-a752-3c3e-a77c-3d52a03886bb",
                                        "glosses": [
                                            "freistehender Turm, in dem Glocken aufgehängt sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5882ecb5-ee6a-45a4-b212-b2962e8f4f15",
                                                "sense_id": "2f05d98f-c24d-3d85-bc45-5e08c0328660",
                                                "text": "„Bei gemauerten Glockentürmen gibt es auch solche, die im oberen Teil die Glocke und im Unterbau eine Kapelle beinhalten“"
                                            },
                                            {
                                                "example_id": "bdc57965-51c1-415c-b3ad-812ab40d1df6",
                                                "sense_id": "2f05d98f-c24d-3d85-bc45-5e08c0328660",
                                                "text": "„Neben der Pfarrkirche St. Nikolaus befindet sich der freistehende Glockenturm, zugleich Torturm und mittelalterlicher Eingang zum Burgbering.“"
                                            },
                                            {
                                                "example_id": "0526ab4b-228a-4dc2-a672-cace5a954f90",
                                                "sense_id": "2f05d98f-c24d-3d85-bc45-5e08c0328660",
                                                "text": "„Im Jahre 1688 wurde der erste richtige Glockenturm neben einem bereits bestehenden Glockenhaus errichtet.“"
                                            },
                                            {
                                                "example_id": "9abe6f9c-c182-4e04-9afc-832e182999a4",
                                                "sense_id": "2f05d98f-c24d-3d85-bc45-5e08c0328660",
                                                "text": "„Der Grundstein zu diesem Wyker Wahrzeichen wurde 1886 gelegt, nachdem ein hölzerner Vorläufer sowie der erste Glockenturm von 1701 Opfer eines Sturms wurden.“"
                                            },
                                            {
                                                "example_id": "fab61728-e5c5-4e38-8b06-366b8d1681e2",
                                                "sense_id": "2f05d98f-c24d-3d85-bc45-5e08c0328660",
                                                "text": "„Die Kirche hieß Sankt Ansgar, und sie hatte einen durchlöcherten Glockenturm ganz aus Beton, in dem hoch oben ein paar einzelne Glocken hingen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2e30dc4d-7cb1-3955-81ff-ee845c41788e",
                                        "entry_id": "3125d892-a752-3c3e-a77c-3d52a03886bb",
                                        "glosses": [
                                            "im Zusammenhang mit einer Kapelle oder Kirche erbauter Turm mit Glocken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1afcb399-716c-40c9-b80c-c3f4dcd4ee91",
                                                "sense_id": "2e30dc4d-7cb1-3955-81ff-ee845c41788e",
                                                "text": "„Ein altes, gemütliches Schulhaus war da, dicht beim Glockenturm der Kirche, an der Innenseite der Friedhofsmauer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae876d39-172c-49aa-a2f0-ff5cbd0d57ec",
                        "source_entry_id": "a7cf09a4-e277-3a14-b631-1655f4eb72a6",
                        "source_sense_id": "9652c126-107f-31dd-824c-8dc00a787799",
                        "source_sense_description": "een stedelijke wachttoren met een stormklok",
                        "target_lang_word": "belfry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "belfry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7d4d88b-3096-3473-a23a-76f201c1bd79",
                                        "entry_id": "87830ffd-4b15-3e6e-8d6f-f45d33095a3b",
                                        "glosses": [
                                            "A tower or steeple typically containing bells, especially as part of a church."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f33b9e76-a6b0-446a-9892-308f57ef50b6",
                                                "sense_id": "b7d4d88b-3096-3473-a23a-76f201c1bd79",
                                                "text": "“You know, this house does have a belfry filled with local bats. Maybe Laszlo went up there.” “Oh, so like my darling perverted husband, to sniff out the local bordello immediately upon arrival. [chuckles] Could you take me to the belfry?”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29e706b4-dfdb-3aab-a88e-4e962d56d20f",
                                        "entry_id": "87830ffd-4b15-3e6e-8d6f-f45d33095a3b",
                                        "glosses": [
                                            "A part of a large tower or steeple, specifically for containing bells."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bae38117-c5ae-4d2d-ba63-06cc7cd79ef4",
                                                "sense_id": "29e706b4-dfdb-3aab-a88e-4e962d56d20f",
                                                "text": "From the belfries far and near the funereal deathbell tolled unceasingly while all around the gloomy precincts rolled the ominous warning of a hundred muffled drums punctuated by the hollow booming of pieces of ordnance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "daabb30c-e164-3da5-bf81-00a97c428dc9",
                                        "entry_id": "87830ffd-4b15-3e6e-8d6f-f45d33095a3b",
                                        "glosses": [
                                            "A shed."
                                        ],
                                        "tags": [
                                            "dialectal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d8508dab-64ab-31a7-8a84-d0f2bf6e25dd",
                                        "entry_id": "87830ffd-4b15-3e6e-8d6f-f45d33095a3b",
                                        "glosses": [
                                            "A movable tower used in sieges."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b86b1c5a-4669-313a-af47-b7f0d79c6893",
                                        "entry_id": "87830ffd-4b15-3e6e-8d6f-f45d33095a3b",
                                        "glosses": [
                                            "An alarm-tower; a watchtower possibly containing an alarm-bell."
                                        ],
                                        "tags": [
