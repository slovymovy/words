                "senses": [
                    {
                        "sense_id": "71539bd7-29cd-38d9-a688-6a5c8c45e8d6",
                        "entry_id": "f25bdb6e-42ec-3929-ae39-168cc5407c08",
                        "glosses": [
                            "свойство по значению прилагательного целесообразный; соответствие каким-либо целям, правильность, разумность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "555fed8a-bee7-4b1d-ae69-2306bd5a9fbb",
                                "sense_id": "71539bd7-29cd-38d9-a688-6a5c8c45e8d6",
                                "text": "Среди них очень заметное место принадлежит смысловым играм, целесообразность которых вполне очевидна: ребенок как бы тренируется для будущей умственной деятельности."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5133e151-69fc-4a84-8d9a-09d4b1b3b118",
                        "source_entry_id": "f25bdb6e-42ec-3929-ae39-168cc5407c08",
                        "source_sense_id": "71539bd7-29cd-38d9-a688-6a5c8c45e8d6",
                        "target_lang_word": "reasonability",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reasonability",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1dcca1fe-3a6c-30ef-9b84-88f44143d3bd",
                                        "entry_id": "ad92e4b0-fdc5-3c83-9862-a6b005aef06d",
                                        "glosses": [
                                            "The state or quality of being reasonable; reasonableness."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7aa9459a-6555-4443-a0ba-47c44d61b2e3",
                                                "sense_id": "1dcca1fe-3a6c-30ef-9b84-88f44143d3bd",
                                                "text": "1897, Judson Harmon, \"Brief for the United States in the Case of the United States of America v. The Trans-Missouri Freight Association,\" The Yale Law Journal, vol. 6, no. 6, p. 323n.,\nThe very difficult inquiry as to the reasonability of such agreements was an inadequate protection."
                                            },
                                            {
                                                "example_id": "69784250-1cc7-4afb-8b23-4f573a81e79c",
                                                "sense_id": "1dcca1fe-3a6c-30ef-9b84-88f44143d3bd",
                                                "text": "Epistemic reasonability could be understood in terms of the general requirement to try to have the largest possible set of logically independent beliefs that is such that the true beliefs outnumber the false beliefs."
                                            },
                                            {
                                                "example_id": "ccae09a4-f6d0-4cac-a4b1-f1c466dabb84",
                                                "sense_id": "1dcca1fe-3a6c-30ef-9b84-88f44143d3bd",
                                                "text": "2003, F. R. Anscombe, \"Quiet Contributor: The Civic Career and Times of John W. Tukey,\" Statistical Science, vol. 18, no. 3, p. 302 (quoting National Academy of Sciences president Philip Handler),\n\"The nation and the Academy can count themselves fortunate that your integrated intelligence, insight, sound judgment, good taste, and unflappable reasonability were all available.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ef792ee-6d8d-463b-a2c3-6f8d89d89f55",
                        "source_entry_id": "f25bdb6e-42ec-3929-ae39-168cc5407c08",
                        "source_sense_id": "71539bd7-29cd-38d9-a688-6a5c8c45e8d6",
                        "target_lang_word": "suitability",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suitability",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b17cf399-dac3-3476-9c39-c795bb1554f8",
                                        "entry_id": "11f7aa03-78b6-3b9c-a8c0-07f94f3ab3de",
                                        "glosses": [
                                            "The quality of being suitable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ef9f253-7215-4256-88c0-d19579d63fd3",
                                                "sense_id": "b17cf399-dac3-3476-9c39-c795bb1554f8",
                                                "text": "As he knows little about the particular issues, his criterion must be consistency with his other views, suitability to combine them into a coherent picture of the world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
