                        "translation_id": "d9f5463a-a31b-4ca1-a473-f43080e4315c",
                        "source_entry_id": "f5a7cfbe-b6ea-3f46-aa70-33cdf8a22e5b",
                        "source_sense_id": "9cea3c69-ec38-39d7-b364-7eb6e8aa464b",
                        "target_lang_word": "hyperthermia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hyperthermia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c947d493-81bb-3728-b57f-634c56cc6418",
                                        "entry_id": "84e3d584-0901-3d18-aa21-5763828cf7bd",
                                        "glosses": [
                                            "The condition of having an abnormally high body temperature caused by a failure of the heat-regulating mechanisms of the body to deal with the heat coming from the environment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79a826bf-21db-457e-b46e-e3e8dbf2ebf1",
                                                "sense_id": "c947d493-81bb-3728-b57f-634c56cc6418",
                                                "text": "Autopsy results revealed that Braydon was generally malnourished and thin. His cause of death was hyperthermia due to the extreme heat, which would have “caused extreme discomfort and difficulty breathing as he died.”"
                                            },
                                            {
                                                "example_id": "2f2f76b4-415f-4262-bbf9-64c6bad6fbe0",
                                                "sense_id": "c947d493-81bb-3728-b57f-634c56cc6418",
                                                "text": "Hyperthermia, that's just a word. The reality is different. You can't breathe. Sweating doesn't work. You're being roasted, like meat in an oven, and you can feel that."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a679c8cf-6552-3aa3-befb-2e324b64063f",
                                        "entry_id": "84e3d584-0901-3d18-aa21-5763828cf7bd",
                                        "glosses": [
                                            "The therapeutic application of heat to a patient, especially as treatment to cancer."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "09b1e2a7-debc-4ba5-b250-e83d7be8260e",
                        "source_entry_id": "f5a7cfbe-b6ea-3f46-aa70-33cdf8a22e5b",
                        "source_sense_id": "9cea3c69-ec38-39d7-b364-7eb6e8aa464b",
                        "target_lang_word": "hyperthermie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hyperthermie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bbbeb444-1410-3964-8996-d1b5a0cabb91",
                                        "entry_id": "493fbe4d-3710-356e-988d-61c0cc92df4c",
                                        "glosses": [
                                            "Augmentation anormale de la température du corps."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4cf4d63-1449-4fef-bf0d-a8a6398cd515",
                                                "sense_id": "bbbeb444-1410-3964-8996-d1b5a0cabb91",
                                                "text": "L’hyperthermie peut intervenir lors d’une exposition prolongée au soleil."
                                            },
                                            {
                                                "example_id": "3eb2f09a-2102-40ab-8fe6-41074e38309c",
                                                "sense_id": "bbbeb444-1410-3964-8996-d1b5a0cabb91",
                                                "text": "Selon lui, la plupart des décès supplémentaires sont dus à des hyperthermies. Les demandes d’ambulance ont augmenté d’environ 25% pour atteindre 10.000 par jour, et les problèmes cardiaques et d’asthme sont en hausse."
                                            },
                                            {
                                                "example_id": "eff32f2c-e083-4c28-876f-9c0f45171142",
                                                "sense_id": "bbbeb444-1410-3964-8996-d1b5a0cabb91",
                                                "text": "Sous l’effet de cette hyperthermie, le rythme cardiaque s’accélère, la respiration et la ventilation pulmonaires aussi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
