                        ],
                        "form": "facétieuse"
                    },
                    {
                        "form_id": "9cdd1fe4-9c2b-4ecf-90de-fe23a610a398",
                        "entry_id": "5e45869e-655b-3d12-95b3-d9871f5df4b5",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "facétieuses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "099f6ff5-041a-3628-ae75-6ae14f8f7f7e",
                        "entry_id": "5e45869e-655b-3d12-95b3-d9871f5df4b5",
                        "glosses": [
                            "Qui tient de la facétie, de la plaisanterie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efe3920a-077e-46df-ab89-3700cff2cffe",
                                "sense_id": "099f6ff5-041a-3628-ae75-6ae14f8f7f7e",
                                "text": "À l’aide du jus très noir de la noix géante appelée huito, une main facétieuse avait écrit un mot, un seul : Welcome !"
                            }
                        ]
                    },
                    {
                        "sense_id": "d417b520-3557-30cd-821f-e30c85b76be9",
                        "entry_id": "5e45869e-655b-3d12-95b3-d9871f5df4b5",
                        "glosses": [
                            "Qui se plaît à dire ou à faire des facéties."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d89244fd-e806-4667-8f7c-f80d16c2d473",
                                "sense_id": "d417b520-3557-30cd-821f-e30c85b76be9",
                                "text": "[L’hippopotame] était plus facétieux que méchant et sa grande joie était de retourner les pirogues d’un coup de nez, puis de regarder les Noirs se débattre dans l’eau."
                            },
                            {
                                "example_id": "f321ba79-3f9c-44c4-927c-b69455c8bfeb",
                                "sense_id": "d417b520-3557-30cd-821f-e30c85b76be9",
                                "text": "La facétieuse déesse Ame no Uzume no Mikoto imagine alors un stratagème pour contraindre Amaterasu à sortir de sa cachette et se lance dans un véritable strip-tease : […]."
                            },
                            {
                                "example_id": "1e208154-cb80-4817-8f9c-2a6eb1d57c1f",
                                "sense_id": "d417b520-3557-30cd-821f-e30c85b76be9",
                                "text": "Encore quelques savoureuses aventures de Trang Quynh, le facétieux. Des histoires où le bon sens se marie avec la malice pour le plus grand bonheur de tous ceux qui les ont entendus racontées à travers les siècles…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8afb8bc-0fe3-43b5-bc08-1d7f1d7d479e",
                        "source_entry_id": "5e45869e-655b-3d12-95b3-d9871f5df4b5",
                        "target_lang_word": "ulkig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ulkig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "df929626-dd5d-3a8e-8a51-d05faf798e8d",
                                        "entry_id": "5ce6e2a4-e0df-34de-8b08-8245622fc89c",
                                        "glosses": [
                                            "spaßig, witzig, zum Lachen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "187f93b5-bdfa-4103-b2e3-ff0bbf5c982c",
                                                "sense_id": "df929626-dd5d-3a8e-8a51-d05faf798e8d",
                                                "text": "Seine Kleidungsstücke passten farblich überhaupt nicht zusammen, das sah ulkig aus."
                                            },
                                            {
                                                "example_id": "0b3d8355-9883-4f57-af50-0692f6f282f9",
                                                "sense_id": "df929626-dd5d-3a8e-8a51-d05faf798e8d",
                                                "text": "Der Clown ist sehr ulkig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "39a91b73-d68e-3776-a605-2accca3f3dd2",
                                        "entry_id": "5ce6e2a4-e0df-34de-8b08-8245622fc89c",
                                        "glosses": [
                                            "eigenartig, merkwürdig, nicht unbedingt zum Lachen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bc9eec6-7710-4bf6-acf5-1b591964bb55",
                                                "sense_id": "39a91b73-d68e-3776-a605-2accca3f3dd2",
                                                "text": "Letztens ist mir eine ganz ulkige Sache passiert."
                                            },
                                            {
                                                "example_id": "9588ff95-f6a5-4991-8d19-eda6baa00bec",
                                                "sense_id": "39a91b73-d68e-3776-a605-2accca3f3dd2",
                                                "text": "Sie ist schon eine ulkige Nudel, die gratuliert keinem zum Geburtstag."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b536df4e-b5c8-4af7-8e23-e9356861978d",
                        "source_entry_id": "5e45869e-655b-3d12-95b3-d9871f5df4b5",
