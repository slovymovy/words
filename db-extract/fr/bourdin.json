                        "examples": [
                            {
                                "example_id": "ec52a72a-7f30-43ad-b3cf-e74285447cf1",
                                "sense_id": "e2615ede-0cbc-33fa-9713-5b0361cee14f",
                                "text": "On retrouve chez Abramow un héritage lisible de Guy Bourdin (1928-1991), immense photographe des années 1970, dont les cadrages acrobatiques, et les couleurs éclatantes, rendaient les mannequins à la fois ultrasexys et parfaitement puissantes."
                            },
                            {
                                "example_id": "510c6b97-aced-4349-b9aa-5bed100ed7c1",
                                "sense_id": "e2615ede-0cbc-33fa-9713-5b0361cee14f",
                                "text": "Thibault Bourdin, lui aussi, en a fait les frais."
                            },
                            {
                                "example_id": "1bd892a0-036f-4214-8efc-7a6a753d4f8e",
                                "sense_id": "e2615ede-0cbc-33fa-9713-5b0361cee14f",
                                "text": "Accusé de tentative d’agression sexuelle, Jean-Jacques Bourdin est écarté de l’antenne de BFMTV et RMC."
                            }
                        ]
                    }
                ],
