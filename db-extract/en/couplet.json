                                                "example_id": "626361e6-622a-4231-b07d-b6bfaeadab25",
                                                "sense_id": "f1cf4c5e-f24a-3136-94ae-42481663cc96",
                                                "text": "„Der Vater benötigt zum Vortragen eines seiner Couplets eine überlange, bunte Weste.“"
                                            }
