                "senses": [
                    {
                        "sense_id": "d8752c79-508d-3399-bf25-b1b8675b527c",
                        "entry_id": "d2fd0a7d-3830-3dc7-9fd2-b7620f12babd",
                        "glosses": [
                            "Variante de gréciser."
                        ],
                        "tags": [
                            "alt-of",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "66768a71-bc64-4d7c-9d8b-5cd9d608e85f",
                                "sense_id": "d8752c79-508d-3399-bf25-b1b8675b527c",
                                "text": "& ils n’ont pas imaginé que le bœuf sauvage décrit par Aristote, sous le nom de bonasus pouvoit être l’un ou l’autre de ces bœufs, dont ils venoient de latiniser & de græciser les noms Germains."
                            },
                            {
                                "example_id": "8f58e499-b57d-478c-ad96-dff0caa76104",
                                "sense_id": "d8752c79-508d-3399-bf25-b1b8675b527c",
                                "text": "Capnion s’appelait proprement Reuchlin, mot qui veut dire en allemand la fumée ; les savans de ces temps avoient contracté l’habitude de latiniser ou de græciser leur nom."
                            }
                        ]
                    }
