                "senses": [
                    {
                        "sense_id": "c485ef9d-fbfa-379a-a142-cc25608b69ab",
                        "entry_id": "c5529211-6f65-307d-a665-9a17e95eb70f",
                        "glosses": [
                            "найти, выбрать удобное, подходящее для чего-либо время"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a7b24ce-8bae-44f8-a157-2005369f8525",
                                "sense_id": "c485ef9d-fbfa-379a-a142-cc25608b69ab",
                                "text": "Тима старался чем-то отвлечь его, выиграть время, чтобы потом улучить удобный момент и обезоружить негодяя."
                            },
                            {
                                "example_id": "410db64c-b0b0-43cc-aac3-6bc5a38e8821",
                                "sense_id": "c485ef9d-fbfa-379a-a142-cc25608b69ab",
                                "text": "Она хотела улучить минутку поговорить с ним наедине, но он поспешил уйти от неё, сказав, что ему нужно в контору."
                            }
                        ]
                    }
