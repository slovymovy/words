                                            {
                                                "example_id": "3e5d7f06-256e-4191-a4e0-ec310d8c7ab2",
                                                "sense_id": "7e46d40b-e032-3113-a216-458bb8c98e1c",
                                                "text": "The Botanical Gardens are in a delightful situation on the river bank."
                                            },
                                            {
                                                "example_id": "d4c32702-09bd-4e86-83e6-f9ce53949978",
                                                "sense_id": "7e46d40b-e032-3113-a216-458bb8c98e1c",
                                                "text": "[…]he being naturally an underground animal by birth and breeding, the situation of Badger's house exactly suited him and made him feel at home; while the Rat, who slept every night in a bedroom the windows of which opened on a breezy river, naturally felt the atmosphere still and oppressive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bce44f09-d3cd-3177-b925-d08d0f14a38d",
                                        "entry_id": "727180a0-7d76-3b96-b595-2b67f0c8c4d8",
                                        "glosses": [
