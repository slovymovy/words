                "senses": [
                    {
                        "sense_id": "b288076d-b0de-396d-921c-d4713ecefe9b",
                        "entry_id": "11f25b47-24c0-3343-ac20-b8c8f365a6dc",
                        "glosses": [
                            "Donner un caractère endémique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc22e405-37cf-44b4-becd-04419d2c73a7",
                                "sense_id": "b288076d-b0de-396d-921c-d4713ecefe9b",
                                "text": "En gros, j’identifierais ces facteurs comme je les perçois, selon les catégories suivantes : le sexisme ordinaire : recréer et endémiciser des inégalités préexistantes, les ‘on t’aura à l’usure’ : combattre la même chose encore et encore ; le viol ; l’apologie du viol."
                            },
                            {
                                "example_id": "0f1cb94b-0959-4bc3-bc16-ff208a225e4b",
                                "sense_id": "b288076d-b0de-396d-921c-d4713ecefe9b",
                                "text": "«volume» de la traite plus faible vers Moyen Orient et Asie insuffisant pour «endémiciser» même si petites épidémies possibles"
                            },
                            {
                                "example_id": "ff14420f-388d-4664-83a1-c206a31039de",
                                "sense_id": "b288076d-b0de-396d-921c-d4713ecefe9b",
                                "text": "Il est cependant vraisemblable que le virus va s’endémiciser dans la région."
                            }
                        ]
                    }
