                ],
                "senses": [
                    {
                        "sense_id": "bc27dd86-b7d8-3096-b403-8438f895dd65",
                        "entry_id": "34770502-f96f-34f6-9a98-507e9463362a",
                        "glosses": [
                            "met betrekking tot tuberculose"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92ef08bd-f418-4e7d-bf27-87f3f050ecc9",
                                "sense_id": "bc27dd86-b7d8-3096-b403-8438f895dd65",
                                "text": "Een ontsteking aan het baarmoederslijmvlies ten gevolge van een tuberculeuze infectie heet tuberculeuze endometritis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "47f0d0ff-df6a-45a7-ae0e-210a0a956c78",
                        "source_entry_id": "34770502-f96f-34f6-9a98-507e9463362a",
                        "source_sense_id": "bc27dd86-b7d8-3096-b403-8438f895dd65",
                        "source_sense_description": "met betrekking tot tuberculose",
                        "target_lang_word": "tubercular",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tubercular",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6544c3e1-3076-3e53-a15e-24d6c786336c",
                                        "entry_id": "4548848e-7869-33e6-af29-ce59bd69821b",
                                        "glosses": [
                                            "Of, pertaining to, or having tuberculosis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd0a8063-779a-4aa8-bbdf-7558b150ddc3",
                                                "sense_id": "6544c3e1-3076-3e53-a15e-24d6c786336c",
                                                "text": "As he grew older, his tubercular thinness tended toward emaciation."
                                            },
                                            {
                                                "example_id": "8bdb51eb-16cc-4b38-b1a4-e58cbbcb8926",
                                                "sense_id": "6544c3e1-3076-3e53-a15e-24d6c786336c",
                                                "text": "He set up business in Sydney, the little capital city of one of the middle Southern states, lived soberly and industriously under the attentive eye of a folk still raw with defeat and hostility, and finally, his good name founded and admission won, he married a gaunt tubercular spinstress, ten years his elder, but with a nest egg and an unshakable will to matrimony."
                                            },
                                            {
                                                "example_id": "5d4b12de-0028-4c35-b017-09f726af6cb6",
                                                "sense_id": "6544c3e1-3076-3e53-a15e-24d6c786336c",
                                                "text": "There had been, too, all the long weeks of Rosie’s tubercular dying to go through."
                                            },
                                            {
                                                "example_id": "36af8363-f681-4528-80e9-024779223bc2",
                                                "sense_id": "6544c3e1-3076-3e53-a15e-24d6c786336c",
                                                "text": "2012, Will Self, “Kafka’s Wound, A digital essay” London Review of Books website,\nThe adult Kafka – the Kafka vermiculated by tubercular bacilli after having been played on for decades, as a demonic organist might press fleshy keys and pull bony stops, by his own relentless neurasthenia – reached a mystical appreciation of his youthful velleity, characterising it as a desire both to expertly hammer together a table and at the same time ‘do nothing’."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2370f02-f892-3301-8653-d6b2b6d9ffc6",
                                        "entry_id": "4548848e-7869-33e6-af29-ce59bd69821b",
                                        "glosses": [
                                            "Relating to or reminiscent of the wheezing sounds associated with the breathing of tuberculosis patients."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3225bcf6-5e7a-4c0c-ad1d-c860ea08baaa",
                                                "sense_id": "e2370f02-f892-3301-8653-d6b2b6d9ffc6",
                                                "text": "The engine heaved. […] The thing sounded like a tubercular tugboat engine without a muffler."
                                            },
                                            {
                                                "example_id": "7b4667e2-d6a1-445b-aac1-93a90adaecde",
                                                "sense_id": "e2370f02-f892-3301-8653-d6b2b6d9ffc6",
                                                "text": "Crows on the roof beat their wings and made their low tubercular moan."
                                            },
                                            {
                                                "example_id": "daba99d5-671b-4248-ab5c-48bda5cba4ed",
                                                "sense_id": "e2370f02-f892-3301-8653-d6b2b6d9ffc6",
                                                "text": "His voice? A raspy, nasal and welcoming instrument, with a tubercular kind of charisma."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9f840c1-cd02-39ff-8498-3823561d22fb",
                                        "entry_id": "4548848e-7869-33e6-af29-ce59bd69821b",
                                        "glosses": [
                                            "Having, being, or relating to tubercles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc5b74da-de43-4562-b937-21cfe8d89cf8",
                                                "sense_id": "c9f840c1-cd02-39ff-8498-3823561d22fb",
                                                "text": "“ORANGE ORCHID” “SPOTTED ORCHID” […] Dorsal appendage of the hood of column smooth, tubercular and notched at the end."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tubercular",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2be3aa03-c917-33b7-8752-40f091f5a016",
                                        "entry_id": "a889bdbc-506b-3efb-8ddd-2f3059769590",
                                        "glosses": [
                                            "A person who has tuberculosis."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96e720ba-040a-4447-9ccb-50241a7307cf",
                                                "sense_id": "2be3aa03-c917-33b7-8752-40f091f5a016",
                                                "text": "They are the tuberculars, the psychiatrics, and the older men suffering from chronic conditions. All of those men are totally disabled."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad9b9e37-7def-4383-bd52-a81c01b8b026",
                        "source_entry_id": "34770502-f96f-34f6-9a98-507e9463362a",
                        "source_sense_id": "bc27dd86-b7d8-3096-b403-8438f895dd65",
                        "source_sense_description": "met betrekking tot tuberculose",
                        "target_lang_word": "tuberculeux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tuberculeux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bd83d67a-622b-3664-87ef-60a56cd7104c",
                                        "entry_id": "07c34122-21c9-3856-bec5-2290fec8d91c",
                                        "glosses": [
                                            "Tuberculé ; comportant des excroissances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ca5f929-c377-41f9-ab77-f872cad8b2f5",
                                                "sense_id": "bd83d67a-622b-3664-87ef-60a56cd7104c",
                                                "text": "Les espèces dont la gousse est courbée en faucille, ridée ou tuberculeuse sur les côtés, et dont le dos se prolonge en une aile large et membraneuse, qui entoure presque tout le fruit."
                                            },
                                            {
                                                "example_id": "390867f6-940c-4e49-a52f-0d3d6755db7e",
                                                "sense_id": "bd83d67a-622b-3664-87ef-60a56cd7104c",
                                                "text": "Fruits très finement tuberculeux"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "338d7f95-35dd-3c05-bd90-d63af80e09a6",
                                        "entry_id": "07c34122-21c9-3856-bec5-2290fec8d91c",
                                        "glosses": [
                                            "Tubéreux ; qui est de la nature du tubercule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e28c07bb-eb4f-43e7-9243-de1723471679",
                                                "sense_id": "338d7f95-35dd-3c05-bd90-d63af80e09a6",
                                                "text": "Les réserves sont des sucres non réducteurs et des sucres réducteurs. M. Leclerc du Sablon place dans cette catégorie les racines tuberculeuses — quelquefois employées pour la fabrication de l’alcool — de l’Asphodelus albus. C’est dans le même groupe qu’on peut ranger la carotte, qui renferme du glucose à côté du saccharose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5288b1b-ca42-3b10-b405-c37efbdc97e5",
                                        "entry_id": "07c34122-21c9-3856-bec5-2290fec8d91c",
                                        "glosses": [
                                            "Qui a rapport à la tuberculose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65b02b9a-fa04-4443-956c-f7afc6a75a12",
                                                "sense_id": "c5288b1b-ca42-3b10-b405-c37efbdc97e5",
                                                "text": "Mlle X…, de Genève, 13 ans ; plaie sur la tempe considérée par plusieurs médecins comme étant d'origine tuberculeuse ; depuis un an et demi, cette plaie résiste aux différents traitements ordonnés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "960f5e79-0795-3cd9-bdf4-9bb94f96df43",
                                        "entry_id": "07c34122-21c9-3856-bec5-2290fec8d91c",
                                        "glosses": [
                                            "Qui est atteint de la tuberculose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22357a69-b861-4eed-8071-b236a1103338",
                                                "sense_id": "960f5e79-0795-3cd9-bdf4-9bb94f96df43",
                                                "text": "Tout le monde ne peut pas avoir deux poumons, non plus, pas vrai ? Mais c’est pour vous dire que les gosses d’aujourd’hui sont bien heureux… Le mien, le médecin prétend qu’il est un peu tuberculeux, laissez donc, si c’est ça, il ne sera pas soldat : autant de gagné."
                                            },
                                            {
                                                "example_id": "a7247c03-ef0c-4da9-bb09-5e584423afd0",
                                                "sense_id": "960f5e79-0795-3cd9-bdf4-9bb94f96df43",
                                                "text": "Ici un vieillard tuberculeux tisonnant un poêle et prolongeant son agonie tout en criblant innocemment de ses bacilles les tout petits confiés à sa garde."
                                            },
                                            {
                                                "example_id": "ce76c1eb-2f47-46e0-be87-65c9ede13fda",
                                                "sense_id": "960f5e79-0795-3cd9-bdf4-9bb94f96df43",
                                                "text": "En ce qui concerne les animaux vendus pour la boucherie et reconnus tuberculeux après abattage, le vendeur n'est tenu qu'au remboursement de la valeur des viandes saisies."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tuberculeux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "df0d9dbb-acdc-3c5b-9e9f-65ab8a7bc1bf",
                                        "entry_id": "22583b89-bd54-3242-98bd-6d28a19bf9f2",
                                        "glosses": [
                                            "Personne atteinte de tuberculose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b28f7067-64c8-4c6b-be7c-a139c44183e4",
                                                "sense_id": "df0d9dbb-acdc-3c5b-9e9f-65ab8a7bc1bf",
                                                "text": "Il est de toute évidence qu'il eût fallu, au contraire, accorder aux tuberculeux des surpensions, à la condition expresse qu'ils se résignassent à la claustration du sanatorium."
                                            },
                                            {
