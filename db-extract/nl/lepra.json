        "nl-extract.jsonl": [
            {
                "entry_id": "dbe5dde8-4b93-31d7-9203-45244183cf6f",
                "word": "lepra",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "30b4822a-344a-3da4-8dbb-624788c214b2",
                        "entry_id": "dbe5dde8-4b93-31d7-9203-45244183cf6f",
                        "glosses": [
                            "infectieziekte, veroorzaakt door de bacteriën Mycobacterium leprae of Mycobacterium lepromatosis\\nDe ziekte leidt tot huidafwijkingen en schade aan perifere zenuwen en geeft in veel culturen aanleiding tot ernstige stigmatisering."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bf5d8c3-dfa7-46fd-8d85-aa15f9c844fd",
                                "sense_id": "30b4822a-344a-3da4-8dbb-624788c214b2",
                                "text": "Als leidmotief loopt door het verhaal de boassie, de gevreesde lepra."
                            },
                            {
                                "example_id": "a8886b02-d7ae-41c5-b3b3-94c077e49ca4",
                                "sense_id": "30b4822a-344a-3da4-8dbb-624788c214b2",
                                "text": "De benaming ‘leprozen’ voor de lijders aan lepra burgerde in Gouda overigens pas in de loop van de zestiende eeuw in."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a764aea3-21e4-4108-898e-e7e79b87f109",
                        "source_entry_id": "dbe5dde8-4b93-31d7-9203-45244183cf6f",
                        "source_sense_id": "30b4822a-344a-3da4-8dbb-624788c214b2",
                        "target_lang_word": "Lepra",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lepra",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fd0a7501-2054-3fca-b982-b29fcf2a4193",
                                        "entry_id": "354dec55-054b-3c64-9a34-371b5df04e05",
                                        "glosses": [
                                            "chronische bakterielle Infektionskrankheit der Haut, Schleimhäute und Nervenzellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "388cf38d-2dad-4085-9dd8-59f51ec6e38a",
                                                "sense_id": "fd0a7501-2054-3fca-b982-b29fcf2a4193",
                                                "text": "Es wird nicht mehr lange dauern, bis sich wieder Krankheiten ähnlich der Pest und der Lepra auszubreiten beginnen."
                                            },
                                            {
                                                "example_id": "3fbae744-079e-464b-8659-a7a2a22445f9",
                                                "sense_id": "fd0a7501-2054-3fca-b982-b29fcf2a4193",
                                                "text": "Jährlich infizieren sich immer noch 700.000 Menschen mit Lepra."
                                            },
                                            {
                                                "example_id": "b0017372-2f7e-449a-9d34-a7b2ba07bed8",
                                                "sense_id": "fd0a7501-2054-3fca-b982-b29fcf2a4193",
                                                "text": "„Im Jahr 1873 hatte der norwegische Arzt und Zoologe Gerhard Hendrik Hansen den Erreger der Lepra beschrieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "557dab9d-fefe-4bb1-8541-bd99445257d8",
                        "source_entry_id": "dbe5dde8-4b93-31d7-9203-45244183cf6f",
                        "source_sense_id": "30b4822a-344a-3da4-8dbb-624788c214b2",
                        "target_lang_word": "Aussatz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aussatz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d7a21e43-93c9-3062-a9bc-6ef7f2634dd4",
                                        "entry_id": "35631f6c-7e57-303f-a6a0-3ed94280464e",
                                        "glosses": [
                                            "chronische bakterielle Infektionskrankheit der Haut, Schleimhäute und Nervenzellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e51e737-3e42-46fb-8d99-eec1227183cf",
                                                "sense_id": "d7a21e43-93c9-3062-a9bc-6ef7f2634dd4",
                                                "text": "„Selbst in Europa, wo der Aussatz meist den längst verschwundenen Geißeln des Mittelalters zugeordnet wird, gibt es 16 000 Fälle, also doppelt soviele wie gegenwärtig an Aids Erkrankte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b03b2553-e34a-471b-a667-6e118196123e",
                        "source_entry_id": "dbe5dde8-4b93-31d7-9203-45244183cf6f",
                        "source_sense_id": "30b4822a-344a-3da4-8dbb-624788c214b2",
                        "target_lang_word": "leprosy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leprosy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "33e3c945-e3d4-33f6-8bdb-9787fff7275c",
                                        "entry_id": "b04a9dfd-ae5e-3f5c-b1d2-e8590db91bcb",
                                        "glosses": [
                                            "An infectious disease caused by the bacterium Mycobacterium leprae, gradually producing nerve damage and patches of skin necrosis and historically handled by permanently quarantining its sufferers."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13a72310-c137-4f8e-ac35-c60f3418019a",
                                                "sense_id": "33e3c945-e3d4-33f6-8bdb-9787fff7275c",
                                                "text": "Leprosy seems to have spread from India to the Middle East by early antiquity and from there to Europe during the time of the Roman Empire."
                                            },
                                            {
                                                "example_id": "6d30970c-e09e-4de3-a3b5-d545f21725b3",
                                                "sense_id": "33e3c945-e3d4-33f6-8bdb-9787fff7275c",
                                                "text": "Then is it surely a leprosy"
                                            },
                                            {
                                                "example_id": "c128b190-81b3-467c-91c6-219ddd9e4c27",
                                                "sense_id": "33e3c945-e3d4-33f6-8bdb-9787fff7275c",
                                                "text": "The great London doctors knew nothing about leprosy and cared less."
                                            },
                                            {
                                                "example_id": "83d8d19e-f94f-42f5-aec8-7a917b2ad717",
                                                "sense_id": "33e3c945-e3d4-33f6-8bdb-9787fff7275c",
                                                "text": "The new drug—diaminodiphenylsulphone... offers the first certain cure... and leprosy can be cured in six months"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e9efe4d-8c2f-3ce5-bc19-78cd39d9054d",
                                        "entry_id": "b04a9dfd-ae5e-3f5c-b1d2-e8590db91bcb",
                                        "glosses": [
                                            "Similar contagious skin diseases causing light patches of scaly skin, particularly psoriasis, syphilis, vitiligo, scabies, and (biblical) the various diseases considered \\\"tzaraath\\\" in the Old Testament."
                                        ],
                                        "tags": [
                                            "proscribed",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e752ea7b-8b9c-3124-a90c-8e0484188dbe",
                                        "entry_id": "b04a9dfd-ae5e-3f5c-b1d2-e8590db91bcb",
                                        "glosses": [
                                            "Anything considered similarly permanent, harmful, and communicable, particularly when such a thing should be handled by avoidance or isolation of its victims."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6994699-9465-46a4-963a-f76f0408ca29",
                                                "sense_id": "e752ea7b-8b9c-3124-a90c-8e0484188dbe",
                                                "text": "Sin is a spiritual leprosy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "781350fc-200d-3400-a17e-4bd1b7b9630d",
                                        "entry_id": "b04a9dfd-ae5e-3f5c-b1d2-e8590db91bcb",
                                        "glosses": [
                                            "A contagious disease causing similar effects in animals, particularly",
                                            "Ellipsis of murine leprosy or feline leprosy (“diseases caused in rodents and cats by Mycobacterium lepraemurium”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b8d37329-60b5-35ff-8c68-2a4dcd5a5b76",
                                        "entry_id": "b04a9dfd-ae5e-3f5c-b1d2-e8590db91bcb",
                                        "glosses": [
                                            "A contagious disease causing similar effects in animals, particularly",
                                            "Synonym of mange and glanders in horses."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6638ae86-43d6-3381-a98a-e98e16282556",
