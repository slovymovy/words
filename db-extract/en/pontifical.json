                        ],
                        "examples": [
                            {
                                "example_id": "82464c1f-94f7-4983-96f8-ec4ef7c16e67",
                                "sense_id": "39e6c15a-14d0-31c1-8b28-cf9b5af72c73",
                                "text": "Now had they brought the work by wondrous art / Pontifical, a ridge of pendent rock / Over the vexed abyss."
                            }
