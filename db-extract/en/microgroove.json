                        "cross_references": [
                            {
                                "target_word": "microsillon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6ba336ec-573c-3897-9f02-1ced642dce99",
                                        "entry_id": "2691ccf3-0d03-3b6d-81b7-15e28b98a6aa",
                                        "glosses": [
                                            "Sillon microscopique d'un disque microsillon que parcourt la tête de lecture d'un tourne-disque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f6736b4-4bbe-4fe2-913a-9fe079eb6f2a",
                                                "sense_id": "6ba336ec-573c-3897-9f02-1ced642dce99",
                                                "text": "Les nouveaux disques «microsillon» n'exigent désormais que quelques casiers pour un même nombre d'œuvres enregistrées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5039fe4-87c9-32b3-a635-5ed3f111078e",
                                        "entry_id": "2691ccf3-0d03-3b6d-81b7-15e28b98a6aa",
                                        "glosses": [
                                            "Disque (support sur lequel on enregistre la voix)"
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11942ba5-1451-415e-8c31-a20cc19498d4",
                                                "sense_id": "b5039fe4-87c9-32b3-a635-5ed3f111078e",
                                                "text": "À une époque où les artistes de jazz apparaissent de plus en plus souvent sur scène, il peut sembler surprenant qu'il ait fallu attendre 1956 pour voir réalisé un microsillon contenant l'enregistrement d'un récital de Garner."
                                            },
                                            {
                                                "example_id": "201be9cd-aa12-4d67-90d6-ccb0d4322454",
                                                "sense_id": "b5039fe4-87c9-32b3-a635-5ed3f111078e",
                                                "text": "Puis très rapidement, dès 48, survient le microsillon. Columbia et Capitol déposent respectivement les brevets du 33 tours de dix pouces (25 cm) et le 45 tours de 7 pouces (17 cm)."
                                            },
                                            {
                                                "example_id": "15b6eef7-5fd8-47ad-b913-22577b2d0e40",
                                                "sense_id": "b5039fe4-87c9-32b3-a635-5ed3f111078e",
                                                "text": "La durée du microsillon de gomme-laque (3 minutes) a imposé à la musique moderne sa brièveté harassante."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
