                    }
                ],
                "senses": [
                    {
                        "sense_id": "bc2623da-e57d-3170-a14f-2ab234636a40",
                        "entry_id": "08a5aa57-3ac2-3e93-a744-5dc33e55480c",
                        "glosses": [
                            "Bien pourvu de machines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc0f9821-f9c7-4812-8000-ea05d7b26b69",
                                "sense_id": "bc2623da-e57d-3170-a14f-2ab234636a40",
                                "text": "Une table machinée, table équipée de mécanismes adaptés pour l’exécution de tours de prestidigitation."
                            },
                            {
                                "example_id": "ce713943-93b8-4bac-bc94-e6d6a9a14c1d",
                                "sense_id": "bc2623da-e57d-3170-a14f-2ab234636a40",
                                "text": "Un théâtre bien machiné, un théâtre bien pourvu en machinerie."
                            }
                        ]
                    },
                    {
                        "sense_id": "f62d22dc-9370-322b-9b3b-693d24afffab",
                        "entry_id": "08a5aa57-3ac2-3e93-a744-5dc33e55480c",
                        "glosses": [
                            "Obscurément agencé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "346cb2cb-1003-4d82-8235-6b558b6d02b1",
                                "sense_id": "f62d22dc-9370-322b-9b3b-693d24afffab",
                                "text": "Le notaire avait une canne machinée, qui se dévissait par le haut ; il y glissait ses billets doux, et, quand il voulait correspondre avec ma femme, il me disait : \"Muserolle, le ciel est nébuleux, prêtez-moi donc un parapluie, je vous laisse ma canne.\" Et il partait."
                            },
                            {
                                "example_id": "7cb15535-51e7-481d-b7e2-3ef03a461be2",
                                "sense_id": "f62d22dc-9370-322b-9b3b-693d24afffab",
                                "text": "Quoi qu’il en soit, il s’était produit des faits positifs, tangibles, on en conviendra, et il n’y avait plus moyen de vivre en un pays si extraordinairement machiné."
                            },
                            {
                                "example_id": "d5be1e42-828d-4043-9e03-b0f415212b8b",
                                "sense_id": "f62d22dc-9370-322b-9b3b-693d24afffab",
                                "text": "Une approche menaçante semblait s’embusquer derrière cette ombre machinée, dans ce paquet de vaisseaux noués autour d’un cœur noir."
                            },
                            {
                                "example_id": "4af2c9ef-f7c7-4afb-9e97-69174641adb0",
                                "sense_id": "f62d22dc-9370-322b-9b3b-693d24afffab",
                                "text": "Mais je ne crois pas au hasard et les coïncidences prouvent peut-être que nos vies sont réellement machinées."
                            }
                        ]
                    }
                ],
