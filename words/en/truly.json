    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "b58bc59a-c623-3b8b-b7f0-b473f8b1ce2e",
                    "sense_definition": "In a genuine, sincere, or actual way; really.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am <w>truly</w> sorry for the mistake I made yesterday.",
                            "target_lang_translations": {
                                "ru": "Мне <w>искренне</w> жаль из-за ошибки, которую я совершил вчера.",
                                "zh": "对于昨天犯的错，我<w>真诚地</w>感到抱歉。"
                            }
                        },
                        {
                            "text": "She <w>truly</w> believes that she can win the competition.",
                            "target_lang_translations": {
                                "ru": "Она <w>по-настоящему</w> верит, что может выиграть соревнование.",
                                "zh": "她<w>确实</w>相信自己能赢得比赛。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sincerely",
                        "honestly",
                        "actually",
                        "in point of fact",
                        "really",
                        "genuinely"
                    ],
                    "common_phrases": [
                        "yours truly",
                        "truly sorry",
                        "truly grateful",
                        "truly believe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искренне, неподдельно или на самом деле.",
                        "zh": "以真诚、真实或实际的方式；确实地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "и́скренне",
                                "target_lang_sense_clarification": "выражая подлинные чувства и мысли"
                            },
                            {
                                "target_lang_word": "по-настоя́щему",
                                "target_lang_sense_clarification": "неподдельно, реально"
                            },
                            {
                                "target_lang_word": "на са́мом де́ле",
                                "target_lang_sense_clarification": "в действительности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "真诚地",
                                "target_lang_sense_clarification": "表达真实的感情或态度"
                            },
                            {
                                "target_lang_word": "确实",
                                "target_lang_sense_clarification": "强调事实的真实性"
                            },
                            {
                                "target_lang_word": "真正地",
                                "target_lang_sense_clarification": "非虚假地，实际地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b49814c-7d96-3d6b-ad4c-eeccf7fdb94a",
                    "sense_definition": "To a very high degree; extremely.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The view from the top of the mountain is <w>truly</w> beautiful.",
                            "target_lang_translations": {
                                "ru": "Вид с вершины горы <w>поистине</w> прекрасен.",
                                "zh": "山顶的景色<w>非常</w>美。"
                            }
                        },
                        {
                            "text": "It was a <w>truly</w> amazing experience for everyone involved.",
                            "target_lang_translations": {
                                "ru": "Это был <w>по-настоящему</w> удивительный опыт для всех участников.",
                                "zh": "这对所有参与者来说都是一次<w>实在</w>令人惊叹的经历。"
                            }
                        }
                    ],
                    "synonyms": [
                        "extremely",
                        "very",
                        "exceedingly",
                        "really",
                        "remarkably"
                    ],
                    "common_phrases": [
                        "truly amazing",
                        "truly great",
                        "truly beautiful"
                    ],
                    "target_lang_definitions": {
                        "ru": "В очень высокой степени; чрезвычайно.",
                        "zh": "达到非常高的程度；极其。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "по-настоя́щему",
                                "target_lang_sense_clarification": "очень, реально"
                            },
                            {
                                "target_lang_word": "действи́тельно",
                                "target_lang_sense_clarification": "в самом деле"
                            },
                            {
                                "target_lang_word": "пои́стине",
                                "target_lang_sense_clarification": "употребляется для усиления (высокий стиль)"
