                        "cross_references": [
                            {
                                "target_word": "saprophage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ef86cd3c-6d73-36fc-9075-1fe122e20310",
                                        "entry_id": "50042c75-8693-3a0e-9b5f-4bf6d15d2317",
                                        "glosses": [
                                            "Qui se nourrit de matière en décomposition."
                                        ],
                                        "tags": [
                                            "Physiologie végétale"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6dab59b-14a4-447a-bd20-e4663b56e151",
                                                "sense_id": "ef86cd3c-6d73-36fc-9075-1fe122e20310",
                                                "text": "La macro-faune comprend des animaux coprophages (comme le bousier), nécrophages (comme le vautour, le marabout à sac, le chacal, la hyène) et saprophages (du grec sapros : pourri, en décomposition), comme les lombrics, qu’Aristote appelait « les intestins de la terre »."
                                            },
                                            {
                                                "example_id": "ab1929fb-6fe5-4715-ace1-da00bbd8248d",
                                                "sense_id": "ef86cd3c-6d73-36fc-9075-1fe122e20310",
                                                "text": "Nous sommes redevables du miel aux abeilles, de la soie aux chenilles de Bombyx mori, aux insectes pollinisateurs de la fécondation des fleurs — et donc de la production de fruits, de légumes, de plantes de grandes cultures (à l’exception des céréales) et de fourrages pour les animaux (luzerne, trèfle) — et à nombre d’autres espèces de la destruction de leurs comparses ravageurs des récoltes (destruction des pucerons par les coccinelles, par exemple) et de la décomposition des déchets organiques (insectes coprophages et saprophages)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "saprophage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "67027a4c-1b94-3038-8465-bddcac446d0b",
                                        "entry_id": "a5b4260f-f0b3-33bc-be4a-43f235a1d691",
                                        "glosses": [
                                            "Organisme qui se nourrit de matière en décomposition."
                                        ],
                                        "tags": [
                                            "Physiologie végétale"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbba4842-f7d0-4b06-9d89-b88a6b7caf75",
                                                "sense_id": "67027a4c-1b94-3038-8465-bddcac446d0b",
                                                "text": "Chaque micro-organisme et chaque organisme jouent un rôle : les saprophages ou détritivores mangent des débris végétaux et animaux, les nécrophages mangent des cadavres, les coprophages consomment des excréments et les carnivores, des animaux vivants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
