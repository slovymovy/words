                                "target_word": "Widerwärtigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d7734552-aa68-36b1-9ad7-4bff8c12be02",
                                        "entry_id": "fe30e2ba-69c3-3090-a2ce-d5eddaba07b9",
                                        "glosses": [
                                            "Eigenschaft von etwas, als außerordentlich unangenehm empfunden zu werden"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "36069f48-3948-3e6d-80ed-76fd6e013c38",
                                        "entry_id": "fe30e2ba-69c3-3090-a2ce-d5eddaba07b9",
                                        "glosses": [
                                            "etwas, das als außerordentlich unangenehm empfunden wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09831453-e9b2-4e4d-888c-f3024937f78b",
                                                "sense_id": "36069f48-3948-3e6d-80ed-76fd6e013c38",
                                                "text": "„Ich watete durch Schneematsch und kämpfte gegen den Sturm, unterdessen überschüttete mich der Verkehr auf der Nördlichen Ringstraße mit Widerwärtigkeiten.“"
                                            },
                                            {
                                                "example_id": "4c8d1642-8224-45ac-94d4-49826a4806ab",
                                                "sense_id": "36069f48-3948-3e6d-80ed-76fd6e013c38",
                                                "text": "„Die meisten Menschen bemerken nur die erotische Merkwürdigkeit, die für sie eine Widerwärtigkeit ist, eine widerwärtige Farce.“"
                                            },
                                            {
                                                "example_id": "89f21148-9904-4ed8-8852-32fee0176ba7",
                                                "sense_id": "36069f48-3948-3e6d-80ed-76fd6e013c38",
                                                "text": "„Von dem Augenblick an, da ich mich aus Mangel an Charakterstärke mit Melulla eingelassen hatte, fielen alle Widerwärtigkeiten geradezu über mich her.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
