                    }
                },
                {
                    "sense_id": "8eb957eb-3c9c-3c69-81aa-a828e20e82a2",
                    "sense_definition": "Gebiedende wijs van <w>flikkeren</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Flikker</w> die rommel nu eindelijk eens in de vuilnisbak!",
                            "target_lang_translations": {
                                "en": "<w>Throw</w> that rubbish into the trash can once and for all!"
                            }
                        },
                        {
                            "text": "<w>Flikker</w> op en laat me met rust!",
                            "target_lang_translations": {
                                "en": "<w>Piss off</w> and leave me alone!"
                            }
                        }
                    ],
                    "common_phrases": [
