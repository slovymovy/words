                "senses": [
                    {
                        "sense_id": "5e9e7ca6-4ad7-3159-b8db-96044920f0ac",
                        "entry_id": "04dfb0b2-6c50-3dac-81e9-39b6e10b4f57",
                        "glosses": [
                            "Variante de malaisien."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "1671bae1-6c86-4956-a0a2-5bed42e6e209",
                                "sense_id": "5e9e7ca6-4ad7-3159-b8db-96044920f0ac",
                                "text": "En effet, la « Vision 2020 » […] version la plus achevée du projet malaysien, fixe non seulement pour objectif l’accès au statu de pays développé à l’horizon 2020, mais aussi l’unification de la société plurielle en une « nation malaysienne »."
                            },
                            {
                                "example_id": "eeebb244-7954-4404-9dbd-85742e81e4e5",
                                "sense_id": "5e9e7ca6-4ad7-3159-b8db-96044920f0ac",
                                "text": "La réussie économique du voisin malaysien donnait pourtant à réfléchir."
                            },
                            {
                                "example_id": "975535d5-7573-41d5-87f6-0dbae5d74ca4",
                                "sense_id": "5e9e7ca6-4ad7-3159-b8db-96044920f0ac",
                                "text": "Par ailleurs, les bookmakers malaysiens auraient également tenté de truquer la rencontre Colombie-Argentine (5-0) de septembre 1993."
                            }
                        ]
                    }
                ],
