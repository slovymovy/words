                                    },
                                    {
                                        "sense_id": "3609b553-2de9-34cb-96e9-ea3fbcfddff1",
                                        "entry_id": "f44860ff-511b-3974-98c1-4d2b90a94784",
                                        "glosses": [
                                            "The situation where a resource, a network destination, etc., is advertised as being available and then unavailable (or available by different routes) in rapid succession."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "728472a9-77dd-349f-9cf4-10b8eb9e8cff",
                                        "entry_id": "f44860ff-511b-3974-98c1-4d2b90a94784",
                                        "glosses": [
                                            "The unlicensed racing of horses or greyhounds."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc46352c-588a-4781-9458-01dc3becff68",
                                                "sense_id": "728472a9-77dd-349f-9cf4-10b8eb9e8cff",
                                                "text": "Greyhound racing had its origins in whippet racing, which was derived in turn from hare coursing. By the early twentieth century, however, a form of dog racing held in 'flapping tracks' was a common pastime in the wastelands near working-class areas of industrial cities."
                                            },
                                            {
                                                "example_id": "562a1f1b-eae7-45ec-8c8d-ec6280cb0bda",
                                                "sense_id": "728472a9-77dd-349f-9cf4-10b8eb9e8cff",
                                                "text": "Flapping is racing which is not licensed by the Jockey Club. […] Anyone found participating in, or even attending, flapping races is liable to be warned off."
                                            },
                                            {
                                                "example_id": "cab8ace1-87ec-47e1-af7d-09a7fb7b0f82",
                                                "sense_id": "728472a9-77dd-349f-9cf4-10b8eb9e8cff",
                                                "text": "Flapping is the arse end of greyhound racing, the lowest of the low. Part sport, part fairground attraction, flapping is the bare-knuckle fighting of dog racing."
                                            }
                                        ]
                                    }
                                ]
                            },
