                "senses": [
                    {
                        "sense_id": "54280ac4-52ca-35db-b0dd-d9f1c7639e41",
                        "entry_id": "fd79744e-e7ea-35e5-bdea-a332523faba0",
                        "glosses": [
                            "südlicher Teil Asiens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5e5ba04-d73f-4517-b589-1b0d721e1256",
                                "sense_id": "54280ac4-52ca-35db-b0dd-d9f1c7639e41",
                                "text": "Geologisch wird ein großer Teil von Südasien, da er eine eigene tektonische Platte darstellt, auch als Indischer Subkontinent bezeichnet."
                            },
                            {
                                "example_id": "d2c43510-5d4d-4c86-8929-0a4336d56a99",
                                "sense_id": "54280ac4-52ca-35db-b0dd-d9f1c7639e41",
                                "text": "„Zwischen 1641 und 1667 unternimmt er sechs große Expeditionen nach Südasien.“"
                            },
                            {
                                "example_id": "ac7494af-94d8-4d36-aab2-eb9d4400765e",
                                "sense_id": "54280ac4-52ca-35db-b0dd-d9f1c7639e41",
                                "text": "„Danach verursachte sie immer wieder regionale Auseinandersetzungen, die auf Südasien beschränkt blieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
