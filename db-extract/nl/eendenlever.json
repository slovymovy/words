                        "entry_id": "04218383-feb1-394e-8d97-1734ab01adb2",
                        "glosses": [
                            "orgaan dat een grote rol speelt in de stofwisseling van een watervogel uit de familie eendachtigen Anatidae, na het slachten vaak gegeten als delicatesse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12fd5b4d-b7eb-4de3-9bd5-0321dea32dac",
                                "sense_id": "6ec9becf-2cf7-3c28-a431-0b869088968a",
                                "text": "Een recept met eendenlever."
                            },
                            {
                                "example_id": "840fd867-4dcd-4853-b0bb-4dac148a43c7",
                                "sense_id": "6ec9becf-2cf7-3c28-a431-0b869088968a",
                                "text": "We hebben hier een enorm ruime wijnkaart en zes chefs die menu’s samenstellen met kreeft of eendenlever of ossenhaas."
                            },
                            {
                                "example_id": "1161608f-10e3-47d7-ba0d-80d0b89f263b",
                                "sense_id": "6ec9becf-2cf7-3c28-a431-0b869088968a",
                                "text": "Over oscillococcinum bestaan hilarische verhalen van kwakzalverbestrijders. Het komt er op neer dat het een homeopathisch middel is, gemaakt van eendenlever en -hart."
                            }
                        ]
                    }
