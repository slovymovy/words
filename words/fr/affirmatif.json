    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cdec2408-beb1-3361-884d-9d01bde2bda2",
                    "sense_definition": "Qui exprime ou constate un fait de façon positive, en parlant d'un énoncé, par opposition à ce qui nie.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "grammaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur demande aux élèves de transformer cette phrase à la forme <w>affirmative</w>."
                        },
                        {
                            "text": "Nous attendons toujours une réponse <w>affirmative</w> de la direction pour lancer les travaux."
                        }
                    ],
                    "synonyms": [
                        "positif"
                    ],
                    "antonyms": [
                        "négatif"
                    ],
                    "common_phrases": [
                        "forme affirmative",
                        "phrase affirmative",
                        "réponse affirmative"
                    ]
                },
                {
                    "sense_id": "d641b2ea-7401-350f-be6e-40b94d1f4600",
                    "sense_definition": "Qui est catégorique, qui assure ou soutient avec certitude la réalité d'une chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "certitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le témoin s'est montré très <w>affirmatif</w> en décrivant le suspect devant les enquêteurs."
                        },
                        {
                            "text": "Bien que la situation soit complexe, le médecin reste <w>affirmatif</w> quant à la guérison."
                        }
                    ],
                    "synonyms": [
                        "catégorique",
                        "formel"
                    ],
                    "common_phrases": [
                        "être affirmatif",
                        "rester affirmatif"
                    ]
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "0c05e5e6-e159-3cdb-90e1-2fe84e16fba8",
                    "sense_definition": "Sert à signifier un accord ou une réponse positive, notamment dans les communications radio ou militaires.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le pilote a rapidement répondu à la tour de contrôle : « <w>Affirmatif</w>, piste bien dégagée ! »"
                        },
                        {
                            "text": "Le commandant demanda si la zone était sécurisée et le soldat répondit : « <w>Affirmatif</w> ! »"
                        }
                    ],
                    "synonyms": [
                        "oui"
                    ],
                    "antonyms": [
                        "négatif"
                    ]
                }
            ]
        }
    ]
