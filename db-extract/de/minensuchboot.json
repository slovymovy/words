                "senses": [
                    {
                        "sense_id": "1a76922d-78d3-317e-b1c1-84e02fbc8d09",
                        "entry_id": "846aa617-143f-3cf5-be62-8428be09e39f",
                        "glosses": [
                            "Schiff, dessen Aufgabe es ist, Minen auf See zu suchen und zu beseitigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1db96a37-f022-4e7d-984d-c1524914ceb1",
                                "sense_id": "1a76922d-78d3-317e-b1c1-84e02fbc8d09",
                                "text": "„Bei einem Personalumfang von 15.000 bis 20.000 Mann sollte die neue Marine vor allem über kleinere Fahrzeuge wie Minensuchboote, Schnellboote, Geleitboote und große Torpedoboote verfügen.“"
                            },
                            {
                                "example_id": "eb051aeb-a2c6-4eba-8a0d-a7e251ec76d5",
                                "sense_id": "1a76922d-78d3-317e-b1c1-84e02fbc8d09",
                                "text": "„Auf die Häftlinge, die im Wasser trieben, soll nach dem Untergang von Minensuchbooten aus geschossen worden sein, die zur Rettung der Wachmannschaften und der beiden Schiffsbesatzungen eingesetzt worden waren.“"
                            },
                            {
                                "example_id": "d59726a2-dcf8-4395-809f-9d115f5f9b55",
                                "sense_id": "1a76922d-78d3-317e-b1c1-84e02fbc8d09",
                                "text": "„Erstaunlich ist das schon, daß die Möwen einlaufende Schiffe nach Typen voneinander unterscheiden können wie nach Köhlers Flottenkalender – zum Beispiel U-Boote von Minensuchbooten.“"
                            },
                            {
                                "example_id": "760adc82-73af-4c51-9b85-6466ea68e8c4",
                                "sense_id": "1a76922d-78d3-317e-b1c1-84e02fbc8d09",
                                "text": "„»Mit grausigen Gefühlen« bestiegen die Götzlacker die Minensuchboote, die ihnen zugewiesen wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
