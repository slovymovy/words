                    {
                        "translation_id": "580f515c-8342-405b-94f9-8c4f172af4fa",
                        "source_entry_id": "83711a40-e1fc-39da-9cda-616bf532eec9",
                        "source_sense_id": "c0d9f6e6-e796-3320-b9ef-14576441bb35",
                        "target_lang_word": "Steigerung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Steigerung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "46c7addc-b388-39fc-9dc1-19e2ad577756",
                                        "entry_id": "fb9c46ef-bf47-3c3f-a476-201802c14c0b",
                                        "glosses": [
                                            "Vergrößerung von etwas"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c1c491e-5293-4675-bf94-4dc0839a6107",
                                                "sense_id": "46c7addc-b388-39fc-9dc1-19e2ad577756",
                                                "text": "Der Staat profitiert von einer Steigerung der Wirtschaftskraft durch höhere Steuereinnahmen."
                                            },
                                            {
                                                "example_id": "341dbd09-4dba-412c-a9cb-9267054f0f1b",
                                                "sense_id": "46c7addc-b388-39fc-9dc1-19e2ad577756",
                                                "text": "„Das Bungeespringen, das zutreffender ‚Bungeefallen’ heißen müsste, stellt eine Steigerung des beschriebenen Fallerlebens dar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2c728c33-7692-3cb6-953f-ef1f267df4a8",
                                        "entry_id": "fb9c46ef-bf47-3c3f-a476-201802c14c0b",
                                        "glosses": [
                                            "Paradigma in der Grammatik zum Ausdruck von graduellen Unterschieden dessen, was im Adjektiv oder in einigen Adverbien benannt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d7e5ca8-ae18-4c2f-a8f3-0dc4fb41d832",
                                                "sense_id": "2c728c33-7692-3cb6-953f-ef1f267df4a8",
                                                "text": "Neben der Steigerung gibt es auch die Komparation mit Gradpartikeln wie „sehr“."
                                            },
                                            {
                                                "example_id": "d7cbc90e-06ed-4f35-9ef4-1e8a4ad86935",
                                                "sense_id": "2c728c33-7692-3cb6-953f-ef1f267df4a8",
                                                "text": "\"schön - schöner - am schönsten\" ist die Steigerung des Adjektivs \"schön\"."
                                            },
                                            {
                                                "example_id": "ca938b67-679b-4f51-bf51-58e8702e1f45",
                                                "sense_id": "2c728c33-7692-3cb6-953f-ef1f267df4a8",
                                                "text": "Steigerung wird von den meisten Linguisten als eine Form der Flexion angesehen."
                                            },
                                            {
                                                "example_id": "7bb3f120-9c04-4d44-bcd3-0718864f6d29",
                                                "sense_id": "2c728c33-7692-3cb6-953f-ef1f267df4a8",
                                                "text": "„Bei der Steigerung (Komparation) des Adjektivs gibt es drei Stufen.“"
                                            },
                                            {
                                                "example_id": "6ae6fbe7-d3ed-48ae-9a3d-0ff03225aeba",
                                                "sense_id": "2c728c33-7692-3cb6-953f-ef1f267df4a8",
                                                "text": "„Ruth Römer, die Beginnsetzerin der deutschen Werbesprachforschung in den sechziger Jahren, hat als axiomatisch gültige Strategie von Werbung die sprachliche Aufwertung erkannt, die überall und immer mit Hochwertwörtern und Steigerungen arbeitet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
