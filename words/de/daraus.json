            "senses": [
                {
                    "sense_id": "6c881a34-c5d6-3626-8566-1a5be98c1eb7",
                    "sense_definition": "aus einem genannten Gegenstand, Behältnis oder Ort heraus",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "lokal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das ist eine schöne Tasse, ich trinke jeden Morgen Kaffee <w>daraus</w>."
                        },
                        {
                            "text": "In der Kiste liegen viele Werkzeuge, nimm bitte einen Schraubenzieher <w>daraus</w>."
                        }
                    ],
                    "common_phrases": [
