                "senses": [
                    {
                        "sense_id": "7d8f56c6-a895-3744-9bcb-8abb3039613e",
                        "entry_id": "fd7ee9ea-26d4-3ccd-8580-ba6e6c0d20f9",
                        "glosses": [
                            "To remove the crown from; thus, to deprive of royal status."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "0256e795-40be-4a89-a566-e47df1f433f6",
                                "sense_id": "7d8f56c6-a895-3744-9bcb-8abb3039613e",
                                "text": "He discrowned, in rapid succession, one after another of the United States' most, accomplished and admirable commanders."
                            },
                            {
                                "example_id": "44eab7b7-c1e1-4df2-be92-9611e45f00db",
                                "sense_id": "7d8f56c6-a895-3744-9bcb-8abb3039613e",
                                "text": "\"Never attempt to discrown the king.\""
                            },
                            {
                                "example_id": "af0f30df-ed21-4cb6-8caa-273353479e97",
                                "sense_id": "7d8f56c6-a895-3744-9bcb-8abb3039613e",
                                "text": "Not, even indirectly, the discrowned Turk, for if he were not banned by his crimes he would still be doomed by his incapacity."
                            }
                        ]
                    }
                ],
