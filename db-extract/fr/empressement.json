        "fr-extract.jsonl": [
            {
                "entry_id": "8a897a0a-2f21-32f4-bef0-185e3beb1b58",
                "word": "empressement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b4409ff7-4483-4b3b-a6fb-4a0c7a0dc2c5",
                        "entry_id": "8a897a0a-2f21-32f4-bef0-185e3beb1b58",
                        "tags": [
                            "plural"
                        ],
                        "form": "empressements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ffb2744d-a68c-3c38-b642-bb28088bcb15",
                        "entry_id": "8a897a0a-2f21-32f4-bef0-185e3beb1b58",
                        "glosses": [
                            "Action de s’empresser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72bd668a-e32d-4a86-8d0f-e639795f79d4",
                                "sense_id": "ffb2744d-a68c-3c38-b642-bb28088bcb15",
                                "text": "Des manières agréables et la sûreté de son commerce le faisaient rechercher avec empressement; […]."
                            },
                            {
                                "example_id": "cb219937-12d5-4b4b-9219-4d42bc3c3de4",
                                "sense_id": "ffb2744d-a68c-3c38-b642-bb28088bcb15",
                                "text": "Loin de répondre aux empressements de son ami, elle fut comme un cadavre à peine animé."
                            },
                            {
                                "example_id": "8125eb86-af04-4697-b303-957874962ffb",
                                "sense_id": "ffb2744d-a68c-3c38-b642-bb28088bcb15",
                                "text": "L’empressement des envoyés des puissances pour venir adresser leurs félicitations à la cour des Tuileries avait été extrême."
                            },
                            {
                                "example_id": "e3b6f92b-6f5e-4f06-8a5e-2b37e31a32b8",
                                "sense_id": "ffb2744d-a68c-3c38-b642-bb28088bcb15",
                                "text": "À chaque instant, des gens passaient, messieurs et dames, qui venaient à elle et lui disaient bonjour, avec une légère chaleur, comme à quelqu’un qu’on n’a pas vu depuis longtemps. Ah ! on devait bien l’aimer, si j’en jugeais à tous ces empressements."
                            },
                            {
                                "example_id": "16d3a831-e5d0-49cf-81f6-0991051475a0",
                                "sense_id": "ffb2744d-a68c-3c38-b642-bb28088bcb15",
                                "text": "Dans la salle à manger, marron et or, pleine de lumières, je me suis assis à la table d’hôte. C’est un scintillement général, un brouhaha, le grand empressement vide du début des repas."
                            },
                            {
                                "example_id": "4150826d-b2bf-444f-b37b-aa577d90d7ba",
                                "sense_id": "ffb2744d-a68c-3c38-b642-bb28088bcb15",
                                "text": "On se figure sans peine l’empressement que je mis à me rendre à une invitation qui me permettait de voir le Sultan, sa cour, son armée et une région à peu près inexplorée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac9ad96c-6ec9-4b10-8cc1-d62e04e768af",
                        "source_entry_id": "8a897a0a-2f21-32f4-bef0-185e3beb1b58",
                        "source_sense_id": "ffb2744d-a68c-3c38-b642-bb28088bcb15",
                        "target_lang_word": "Bereitwilligkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "23bd3b31-e58a-4af6-be32-d89257283b79",
                        "source_entry_id": "8a897a0a-2f21-32f4-bef0-185e3beb1b58",
                        "source_sense_id": "ffb2744d-a68c-3c38-b642-bb28088bcb15",
                        "target_lang_word": "readiness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "readiness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9f85a53-2ec1-3ed7-8154-0b742fbe0f12",
                                        "entry_id": "f2cbe200-d30a-3f76-87e0-499a882576ae",
                                        "glosses": [
                                            "The state or degree of being ready; preparedness."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39ed05f0-ceb5-4c49-af8b-12bf5fbd6ae3",
                                                "sense_id": "f9f85a53-2ec1-3ed7-8154-0b742fbe0f12",
                                                "text": "readiness for civil emergencies"
                                            },
                                            {
                                                "example_id": "821ef2a0-c5a5-4b35-bf48-814591f6ba8d",
                                                "sense_id": "f9f85a53-2ec1-3ed7-8154-0b742fbe0f12",
                                                "text": "We expressed our readiness, and in ten minutes were in the station wagon, rolling rapidly down the long drive, for it was then after nine. We passed on the way the van of the guests from Asquith."
                                            },
                                            {
                                                "example_id": "985d550f-2018-46bb-a42d-e5dcc74cb65b",
                                                "sense_id": "f9f85a53-2ec1-3ed7-8154-0b742fbe0f12",
                                                "text": "Euston is so traditionally a part of the London scene that many will lament the passing of the old station when rebuilding is complete in readiness for the new electric service, which will probably be by multiple-units between Euston and Wolverhampton."
                                            },
                                            {
                                                "example_id": "ce7b6001-d7f9-4e4c-be9c-07f941d93865",
                                                "sense_id": "f9f85a53-2ec1-3ed7-8154-0b742fbe0f12",
                                                "text": "England had won just two of their previous six matches prior to facing Spain and manager Sarina Wiegman had been questioned about their readiness to defend their European title in Switzerland this summer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6364804-c4af-3918-95bb-4cad0e8b6414",
                                        "entry_id": "f2cbe200-d30a-3f76-87e0-499a882576ae",
                                        "glosses": [
                                            "Willingness."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5cbe7ac7-a30b-42b3-95ef-847f0c61d0fc",
                                                "sense_id": "f6364804-c4af-3918-95bb-4cad0e8b6414",
                                                "text": "his readiness to help"
                                            },
                                            {
                                                "example_id": "3b8d64a8-fcd9-4bd4-b84d-cf2dbf19fd04",
                                                "sense_id": "f6364804-c4af-3918-95bb-4cad0e8b6414",
                                                "text": "It was a long, enduring scream — one that would send her back into a time and into a childhood which had been forgotten with the readiness that we forget unpleasant moments in our lives."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98ce070c-bab1-439b-94e0-10734d0c582b",
                        "source_entry_id": "8a897a0a-2f21-32f4-bef0-185e3beb1b58",
                        "source_sense_id": "ffb2744d-a68c-3c38-b642-bb28088bcb15",
                        "target_lang_word": "alacrity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alacrity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9375df45-fbd9-3ae8-ae64-41bd594c742f",
                                        "entry_id": "11c17f0d-e1f1-36b8-a44f-e48c80d6142e",
                                        "glosses": [
                                            "Eagerness; liveliness; enthusiasm."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e97a375b-abdd-4b9f-b03c-40246169fe68",
                                                "sense_id": "9375df45-fbd9-3ae8-ae64-41bd594c742f",
                                                "text": "Besides, a wealthy man, well at ease, may pray to God quietly and merrily with alacrity and great quietness of mind, whereas he who lieth groaning in his grief cannot endure to pray nor can he hardly think upon anything but his pain."
                                            },
                                            {
                                                "example_id": "c28ea45e-c1fc-4903-bfd8-7f4c1c31ab50",
                                                "sense_id": "9375df45-fbd9-3ae8-ae64-41bd594c742f",
                                                "text": "I have not that alacrity of spirit / Nor cheer of mind that I was wont to have."
                                            },
                                            {
                                                "example_id": "dfb0cfc0-2378-40ea-bd38-af41c828442c",
                                                "sense_id": "9375df45-fbd9-3ae8-ae64-41bd594c742f",
                                                "text": "\"I'll get into the clothes this minute, if they're here,\" said Sam, with great alacrity."
                                            },
                                            {
                                                "example_id": "1fa0c88b-93dd-4b03-a50c-32c1e21bc68c",
                                                "sense_id": "9375df45-fbd9-3ae8-ae64-41bd594c742f",
                                                "text": "You have an overgrown alacrity\nFor saying nothing much and hearing less […]"
                                            },
                                            {
                                                "example_id": "04bc9594-512f-4c1c-a148-2d47ce60b6d5",
                                                "sense_id": "9375df45-fbd9-3ae8-ae64-41bd594c742f",
                                                "text": "This evening, however, he was struck by the beaming alacrity of the aide-de-camp's greeting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f37b3d6a-1a7a-3faf-aeb5-86e104e7e235",
                                        "entry_id": "11c17f0d-e1f1-36b8-a44f-e48c80d6142e",
                                        "glosses": [
                                            "Promptness; speed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88fd5672-6958-4451-a1d6-2cb65977e9a2",
                                                "sense_id": "f37b3d6a-1a7a-3faf-aeb5-86e104e7e235",
                                                "text": "Governments show thus how successfully men can be imposed on, even impose on themselves, for their own advantage. […] Yet this government never of itself furthered any enterprise, but by the alacrity with which it got out of its way."
                                            },
                                            {
                                                "example_id": "66a8aaf5-9aca-4d55-9bbc-f6d334c0a3ee",
                                                "sense_id": "f37b3d6a-1a7a-3faf-aeb5-86e104e7e235",
                                                "text": "He had a uniform jacket with one button off, and seeing a white man on the path, hoisted his weapon to his shoulder with alacrity."
                                            },
                                            {
                                                "example_id": "fec68568-756b-4dbd-b558-053f9ff3056c",
                                                "sense_id": "f37b3d6a-1a7a-3faf-aeb5-86e104e7e235",
                                                "text": "Not just that, but if the inlet of a turbopump impeller runs dry, it would overspeed with blinding alacrity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "283109d4-fe05-4fb1-821c-99e29983d559",
                        "source_entry_id": "8a897a0a-2f21-32f4-bef0-185e3beb1b58",
