                    {
                        "translation_id": "0dd4f00a-5003-482c-85b0-76efd5149e30",
                        "source_entry_id": "be996b9f-ba5f-3eaa-9b27-3af5292cd6b3",
                        "source_sense_id": "b0b6c164-e36b-333c-a94a-5a7133cca02e",
                        "source_sense_description": "die kommunale Verwaltungsbehörde",
                        "target_lang_word": "gmina",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gmina",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "ab25b0ff-c407-3c6e-945c-4909a0e7e618",
                                        "entry_id": "e7aef8cb-16af-3c26-87e6-f2a37fce2b51",
                                        "glosses": [
                                            "podstawowa i zarazem najmniejsza jednostka samorządu terytorialnego"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4675625-2e97-4840-88ac-4e75af83a949",
                                                "sense_id": "ab25b0ff-c407-3c6e-945c-4909a0e7e618",
                                                "text": "Wójt Kłodawy nie chce odwołać skarbniczki gminy oskarżonej o kradzież pieniędzy. Czeka na wyrok, choć skarbniczka przyznała się do winy"
                                            },
                                            {
                                                "example_id": "e14dd047-c018-4395-846a-d2e67dce5b86",
                                                "sense_id": "ab25b0ff-c407-3c6e-945c-4909a0e7e618",
                                                "text": "W wyniku referendum został odwołany - prawo demokracji. Ale paradoksalnie wójt miał przestać pracować dla gminy w czasie, gdy z powodzeniem finalizował kilka najważniejszych inwestycji."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "8487e15e-59a1-3f49-9626-f022b474fbb4",
                                        "entry_id": "e7aef8cb-16af-3c26-87e6-f2a37fce2b51",
                                        "glosses": [
                                            "wspólnota wyznaniowa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bdccfe7-266d-49ba-8ca1-420debd58de7",
                                                "sense_id": "8487e15e-59a1-3f49-9626-f022b474fbb4",
                                                "text": "Po powstaniach Machabeuszów i Bar Kochby udawały się na obczyznę nowe fale uchodźców, które zasilały wydatnie dawniejsze emigracyjne gminy żydowskie"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0736c64-aedf-4d41-ab6f-168c311524f2",
                        "source_entry_id": "be996b9f-ba5f-3eaa-9b27-3af5292cd6b3",
                        "source_sense_id": "016a6062-3a37-3bb6-93ee-8fb38bb26b04",
                        "source_sense_description": "Gebäude, in welchem sich diese Verwaltungsbehörde befindet",
                        "target_lang_word": "town hall",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "town hall",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9f75fa7d-867b-393f-bea5-056f1688685a",
                                        "entry_id": "16485f42-b916-3122-bde9-b07ed6f040f1",
                                        "glosses": [
                                            "A building that houses the local government offices of a town."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "baa89b99-09f3-48a5-8296-0e91d45a4ef9",
                                                "sense_id": "9f75fa7d-867b-393f-bea5-056f1688685a",
                                                "text": "Then he commenced to talk, really talk. and inside of two flaps of a herring's fin he had me mesmerized, like Eben Holt's boy at the town hall show. He talked about the ills of humanity, and the glories of health and Nature and service and land knows what all."
                                            },
                                            {
                                                "example_id": "ea0a6c83-e538-464b-88fd-e20f2ef1ef52",
                                                "sense_id": "9f75fa7d-867b-393f-bea5-056f1688685a",
                                                "text": "They enjoyed music from a live saxophonist during the journey before visiting Braintree Town Hall for refreshments and Christmas cake."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46e5f597-6f77-397c-ace1-4099b18d15e4",
                                        "entry_id": "16485f42-b916-3122-bde9-b07ed6f040f1",
                                        "glosses": [
                                            "The town council."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cc69bc6d-a07e-31c2-bc7d-8b8fcd491286",
                                        "entry_id": "16485f42-b916-3122-bde9-b07ed6f040f1",
                                        "glosses": [
                                            "A widely accessible meeting, particularly where the audience is allowed to interact with the speakers."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "023b94a9-9985-4dfb-b1c6-d8b06fa3e2b7",
                                                "sense_id": "cc69bc6d-a07e-31c2-bc7d-8b8fcd491286",
                                                "text": "The president plans to speak to a town hall of employees at its headquarters on Monday."
                                            },
                                            {
                                                "example_id": "5f864569-e154-4f06-bdb4-b7c1c076c194",
                                                "sense_id": "cc69bc6d-a07e-31c2-bc7d-8b8fcd491286",
                                                "text": "\" […] Sure, you can come down to City Hall when we have a Town Hall Meeting. Write to Maureen Connelly and she'll arrange it. […]\""
                                            },
                                            {
                                                "example_id": "7b9aea50-8d41-4179-916b-b3051fd41e95",
                                                "sense_id": "cc69bc6d-a07e-31c2-bc7d-8b8fcd491286",
                                                "text": "And in just a few minutes, we'll bring you tonight's town hall debate from here at Washington University in Saint Louis."
                                            },
                                            {
                                                "example_id": "8f2b9297-838d-476f-8bc5-14ea7d680af7",
                                                "sense_id": "cc69bc6d-a07e-31c2-bc7d-8b8fcd491286",
                                                "text": "The Form 2s are planning to host a town hall meeting with the women of Mara Moja and other local communities to teach the women more effective hygiene practices […]"
                                            },
                                            {
                                                "example_id": "6f466fa1-cc29-4d30-be0a-d59b1d9ef3b8",
                                                "sense_id": "cc69bc6d-a07e-31c2-bc7d-8b8fcd491286",
                                                "text": "That pushback from inside the administration was combined with rising public anger about the cuts that exploded at several lawmakers’ town halls in recent weeks."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
