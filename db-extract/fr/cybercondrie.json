                                        "entry_id": "845f7852-c892-37d9-a99c-14dc209c8cf0",
                                        "glosses": [
                                            "Anxiety concerning one's health, caused by visiting medical websites."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddaa7578-f0a0-4bd1-9aef-76337e91cb68",
                                                "sense_id": "738904d3-8632-3c3f-b21d-12a572164e84",
                                                "text": "[Sam] Altman’s mother, a dermatologist named Connie Gibstine, told me, “Sam does keep an awful lot tied up inside. He’ll call and say he has a headache—and he’ll have Googled it, so there’s some cyber-chondria in there, too."
                                            },
                                            {
                                                "example_id": "85651163-f4a1-475d-b0bc-33e875091b1e",
                                                "sense_id": "738904d3-8632-3c3f-b21d-12a572164e84",
                                                "text": "Using “Dr Google” for health purposes is controversial. Some have expressed concerns that it can lead to inaccurate diagnoses, bad advice on where to seek treatment (triage), and increased anxiety (cyberchondria)."
                                            }
                                        ]
                                    }
                                ]
                            }
