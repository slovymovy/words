                            {
                                "example_id": "11ca1d5b-edaf-47cd-b6ac-2386db16d42b",
                                "sense_id": "1ead123d-d6f3-3bcf-bee4-21b3071df7f0",
                                "text": "Polska tożsamość jest nierozerwalnie związana z morzem wypijanej co roku wódki"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
