                                    {
                                        "sense_id": "3693df0c-5589-33f9-8511-90079d6e86de",
                                        "entry_id": "f2765403-cc2f-3155-8b1f-30fe3579ebef",
                                        "glosses": [
                                            "A person who is a member of a gang or criminal organization."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5b7c5325-873b-300a-ae32-9a1698757418",
                                        "entry_id": "f2765403-cc2f-3155-8b1f-30fe3579ebef",
                                        "glosses": [
                                            "A violent, aggressive, or truculent person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8d99ec1-f55b-4fc8-a96e-646084400c62",
                                                "sense_id": "5b7c5325-873b-300a-ae32-9a1698757418",
                                                "text": "They call you a land of license—free but to thug and thief."
                                            },
                                            {
                                                "example_id": "4465883e-47d2-4334-a9ff-ff9d1371b2eb",
                                                "sense_id": "5b7c5325-873b-300a-ae32-9a1698757418",
                                                "text": "I pushed up out of my chaise and headed for the miniten court. Leah handed me her thug as I walked past her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f50a1b71-f34d-3d72-96f4-341442249f63",
                                        "entry_id": "f2765403-cc2f-3155-8b1f-30fe3579ebef",
                                        "glosses": [
                                            "A criminal that extorts people."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "040c2d15-c8ee-3873-accd-c91765447eab",
                                        "entry_id": "f2765403-cc2f-3155-8b1f-30fe3579ebef",
                                        "glosses": [
                                            "A person who use intimidation to coerce others."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3df40006-b52c-358b-8d14-85c1c8739a2c",
                                        "entry_id": "f2765403-cc2f-3155-8b1f-30fe3579ebef",
                                        "glosses": [
                                            "One of a band of assassins formerly active in northern India who worshipped Kali and sacrificed their victims to her."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f14ec2e2-b8b3-3b88-96f5-a6c1665c1020",
                                        "entry_id": "f2765403-cc2f-3155-8b1f-30fe3579ebef",
                                        "glosses": [
                                            "One who, usually as a result of social disadvantage, has turned to committing crimes (e.g. selling drugs, robbery, assault, etc.) to make a living; a gangsta."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "57d53d2e-357a-38ef-bb78-57f3f8323860",
                                        "entry_id": "f2765403-cc2f-3155-8b1f-30fe3579ebef",
                                        "glosses": [
                                            "An overvigorous plant that spreads and dominates the flowerbed."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "62facc42-cbca-3978-8655-5821f5716654",
                                        "entry_id": "f2765403-cc2f-3155-8b1f-30fe3579ebef",
