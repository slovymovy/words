                "senses": [
                    {
                        "sense_id": "24680f0f-6948-3620-83ca-167a8a2e9be7",
                        "entry_id": "9b1a4efb-6e27-379c-aa87-9deda2f6bc1e",
                        "glosses": [
                            "Ètat de celui ou de celle qui est geek."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0391bfb-224d-4575-a6d8-1a12949e0179",
                                "sense_id": "24680f0f-6948-3620-83ca-167a8a2e9be7",
                                "text": "N'écrivant des chansons pratiquement qu'au sujet de la guerre, son nom provient d'une arme issue du summum de la geekitude, le jeu Warhammer. Le groupe a même utilisé des artistes de Warhammer pour ses pochettes, […]."
                            },
                            {
                                "example_id": "3a240ec2-f716-4116-8341-3f823a4f6809",
                                "sense_id": "24680f0f-6948-3620-83ca-167a8a2e9be7",
                                "text": "Elle s’est hasardée à l’intérieur de ma chambre, comme si elle craignait que le décor ne s’anime et l’attaque, ou lui transmette le virus de la geekitude, ou quelque chose du genre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4fb401e3-1438-4c06-83fe-7806831390b6",
                        "source_entry_id": "9b1a4efb-6e27-379c-aa87-9deda2f6bc1e",
                        "source_sense_id": "24680f0f-6948-3620-83ca-167a8a2e9be7",
                        "target_lang_word": "geekitude",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geekitude",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0085d839-37b3-38d9-99c4-f283a7436254",
                                        "entry_id": "81872ef8-d359-3692-bf64-a6c779894f6c",
                                        "glosses": [
                                            "The quality of being a geek."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b3343e1-78db-49c4-9e67-a8a5a9a20785",
                                                "sense_id": "0085d839-37b3-38d9-99c4-f283a7436254",
                                                "text": "[H]e looked like such a geek. He had these huge feet and hands, and he looked like a total dork. The mighty staff at Marvel must have realized this, so they gave the beastie boy a whole new image, dropping his utter geekitude and transforming him into the blue-furred bad boy that has really hit it big with The Avengers, X-Factor, and X-Men fans."
                                            },
                                            {
                                                "example_id": "0e046a7a-4994-4e93-ad31-dec226589eb1",
                                                "sense_id": "0085d839-37b3-38d9-99c4-f283a7436254",
                                                "text": "“What does this cone have to do with your work?” Nora’s puzzled look revealed that Dad had just surpassed her in geekitude. Which, unfortunately, only made him more determined to explain."
                                            },
                                            {
                                                "example_id": "4999f483-bf74-4a6f-a632-657d9245f5f7",
                                                "sense_id": "0085d839-37b3-38d9-99c4-f283a7436254",
                                                "text": "When Del Rey first told me they were sending me, I asked longtime pal and local cartoonist celebrity Stephen J. Notley what the hell Comicon was. Imagine the Shaw Conference Centre, he said, stacked, packed and latched with literally hundreds of booths bursting with the biggest assortment of fanboyish delights assemblable. The Mecca of manga, the Gethsemane of Geekitude."
                                            },
                                            {
                                                "example_id": "28710ebe-9d00-46b7-b6af-723145514fc2",
                                                "sense_id": "0085d839-37b3-38d9-99c4-f283a7436254",
                                                "text": "We trash talk each other all the time in Robotics Club. But we’re united in our unabashed geekitude."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
