                    "frequency": "Middle",
                    "semantic_group_id": "institution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouvernement prévoit de <w>créer</w> de nouveaux emplois dans la région."
                        },
                        {
