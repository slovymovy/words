                        "examples": [
                            {
                                "example_id": "515722f3-92ae-4b86-99fb-98fdccb4345a",
                                "sense_id": "81b1dd6c-9708-3e65-bab7-9901d7af48ea",
                                "text": "Hoeness volgt Alfred Schreuder op, die in juni ondanks prima resultaten en in goed overleg met de clubleiding besloot te vertrekken. Hoffenheim plaatste zich onder interim-coach Matthias Kaltenbach als nummer zes van de Bundesliga voor de Europa League."
                            },
                            {
                                "example_id": "ea83cc38-3f90-461a-84c4-7daadf028def",
                                "sense_id": "81b1dd6c-9708-3e65-bab7-9901d7af48ea",
                                "text": "Frank de Boer vertrekt bij Atlanta United. Het doorlopende contract van de Nederlander is in overleg met de clubleiding per direct ontbonden. Onder leiding van De Boer verloor Atlanta alledrie de groepsduels van het 'MLS is Back'-toernooi."
                            },
                            {
                                "example_id": "77231dac-3837-4c4a-96fd-1b66ce789220",
                                "sense_id": "81b1dd6c-9708-3e65-bab7-9901d7af48ea",
                                "text": "Direct na de bekendmaking van het conceptprogramma van de KNVB was de clubleiding al niet te spreken."
                            }
                        ]
                    }
