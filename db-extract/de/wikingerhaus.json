                "senses": [
                    {
                        "sense_id": "64f8258d-3700-34db-84fc-71b1849fb0c0",
                        "entry_id": "90ae07de-4bab-3812-8258-840c6c6bc01b",
                        "glosses": [
                            "Gebäude, Räumlichkeit, Unterkunft der Wikinger"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0ed76f5-4e0d-43e2-a6ef-76848c51090a",
                                "sense_id": "64f8258d-3700-34db-84fc-71b1849fb0c0",
                                "text": "„Nachgebautes Wikingerhaus aus Grassoden an der Straße 586 am Haukadalsvatn.“"
                            },
                            {
                                "example_id": "cf09d1e8-5285-4f4c-9a6e-847fe9087cfb",
                                "sense_id": "64f8258d-3700-34db-84fc-71b1849fb0c0",
                                "text": "„Eine Menge schweres Heben und möglicherweise auch die Arbeit mit schwerem Gerät, können beim Bau eines Wikingerhauses notwendig sein.“"
                            },
                            {
                                "example_id": "3dc25c61-e279-43f0-8801-7b2b57768e46",
                                "sense_id": "64f8258d-3700-34db-84fc-71b1849fb0c0",
                                "text": "„Solche Wikingerhäuser konnten bis zu 50 Meter lang sein, waren aber nur fünf Meter breit.“"
                            },
                            {
                                "example_id": "ad340b32-e6f0-4818-9bce-20a932717dfc",
                                "sense_id": "64f8258d-3700-34db-84fc-71b1849fb0c0",
                                "text": "„Das Wikingerhaus im \"Jungen Museum Speyer\" aufgebaut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
