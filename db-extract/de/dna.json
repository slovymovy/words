                                                "sense_id": "261f0c4d-564c-3ba6-ade2-98196b6b34c1",
                                                "text": "il DNA è presente in quasi tutte le nostre cellule"
                                            },
                                            {
                                                "example_id": "2d7d1403-53e4-443c-a65f-b77f0b98bd84",
                                                "sense_id": "261f0c4d-564c-3ba6-ade2-98196b6b34c1",
                                                "text": "il DNA mitocondriale (quello femminile) si trova nei mitocondri, organelli del citoplasma della cellula"
                                            }
                                        ]
                                    },
