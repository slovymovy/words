                        "glosses": [
                            "vertrouwensagent die de familie van slachtoffers en ongevallen bijstaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0387b1be-4b5d-4b1f-80c2-fae8d615f19c",
                                "sense_id": "cd715444-3ec5-3790-a621-4984740f225c",
                                "text": "De nabestaanden van de twee slachtoffers hebben van hun familierechercheur tot op de dag van vandaag geen bericht gehad dat hun familielid gevonden is. Er bestaat geen twijfel aan dat ze aan boord waren. Zo zette Gary Slok vlak voor hij op 17 juli opsteeg nog een foto van zichzelf en zijn moeder in het vliegtuig op Facebook."
                            },
                            {
                                "example_id": "27a773a1-e361-4bd9-9465-561e9cdf63b2",
                                "sense_id": "cd715444-3ec5-3790-a621-4984740f225c",
                                "text": "Het zijn spullen die tussen 7 augustus en 31 maart in Nederland zijn aangekomen. Mensen die voorwerpen van een omgekomen familielid herkennen, kunnen dat kenbaar maken. De eigendommen worden dan overgedragen door een familierechercheur."
                            },
                            {
                                "example_id": "870fa272-ac39-4e1b-8a03-093ad456c994",
                                "sense_id": "cd715444-3ec5-3790-a621-4984740f225c",
                                "text": "Artsen krijgen veel verzoeken van nabestaanden. Die vragen de medische gegevens van omgekomen familieleden op. Dat doen ze op verzoek van een familierechercheur. Alle nabestaanden hebben zo'n politieman die ze begeleidt."
                            }
                        ]
                    }
