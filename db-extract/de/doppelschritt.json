                ],
                "senses": [
                    {
                        "sense_id": "78e80f91-b2ca-35dc-8f68-5b92bc112389",
                        "entry_id": "26569261-3a88-39e9-98d9-65df29e28bcf",
                        "glosses": [
                            "zwei Schritte (im Sinne von Aktionen), die parallel, in einem Zuge durchgeführt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38b65944-9ff4-459a-ba5e-c9befbda2cf7",
                                "sense_id": "78e80f91-b2ca-35dc-8f68-5b92bc112389",
                                "text": "„Die Ablösung von den Führern von gestern, verbunden mit der Hinwendung zu den Themen von morgen, ist der strategische Doppelschritt, der Erfolg verspricht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "693db185-826d-3385-8901-c2eace094bda",
                        "entry_id": "26569261-3a88-39e9-98d9-65df29e28bcf",
                        "glosses": [
                            "beschleunigter Schritt, Eiltempo"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e4756e0-beb3-4832-82b9-eb4f7e7c22a2",
                                "sense_id": "693db185-826d-3385-8901-c2eace094bda",
                                "text": "„[…] er hätte jetzt den Doppelschritt anschlagen und dem Regiment nachziehen sollen. Allein der Musketier dachte: ‚Brauchen sie mich nimmer, so brauch ich sie auch nimmer.‘“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "90003cba-b10f-3bd3-80f8-1bbe3e5525d6",
                        "entry_id": "26569261-3a88-39e9-98d9-65df29e28bcf",
                        "glosses": [
                            "Zugmöglichkeit für einen Bauern, der noch auf seinem Ausgangsfeld steht"
                        ],
                        "tags": [
                            "Schach"
                        ],
                        "examples": [
                            {
                                "example_id": "a6a6b355-2685-40d2-9e4e-39be46311c31",
                                "sense_id": "90003cba-b10f-3bd3-80f8-1bbe3e5525d6",
                                "text": "„1. c4 (die erste Überraschung: Short ist sonst ein glühender Verfechter des Doppelschritts des e-Bauern).“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "0b8c450b-9b20-394b-bf60-25fd91cb0bf6",
                        "entry_id": "26569261-3a88-39e9-98d9-65df29e28bcf",
                        "glosses": [
                            "römisches Längenmaß (passus): 1,482 Meter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcb029e9-78bf-4a24-85ac-fe58fb1fd559",
                                "sense_id": "0b8c450b-9b20-394b-bf60-25fd91cb0bf6",
                                "text": "„Der Burghügel […], ein verhältnismäßig bedeutender Fels von 188 Fuß Höhe und an der Unterfläche einem Umfang von reichlich 2000 Doppelschritten, griff in diese Mauer an ihrem südlichen Ende ein, ähnlich wie die Felswand des Kapitols in den römischen Stadtwall.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "d542095b-5fa6-313b-8235-01e537484eb8",
                        "entry_id": "26569261-3a88-39e9-98d9-65df29e28bcf",
                        "glosses": [
                            "eine bestimmte Schrittfolge beim Tanzen, beim Kampfsport"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"5\""
                    }
