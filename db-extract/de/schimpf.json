                ],
                "senses": [
                    {
                        "sense_id": "3c50b1a4-7765-3191-b6bc-6992e02823b7",
                        "entry_id": "47429e48-50c9-37d3-a509-4d1997df5f0f",
                        "glosses": [
                            "Verletzung der Selbstachtung"
                        ],
                        "tags": [
                            "gehoben"
                        ],
                        "examples": [
                            {
                                "example_id": "ac4add6f-01d7-4783-92ce-ed700aa882b5",
                                "sense_id": "3c50b1a4-7765-3191-b6bc-6992e02823b7",
                                "text": "„In Blanky stieg der Zorn hoch. Einen solchen Schimpf hatte ihm noch niemand angetan, solange er auf See fuhr.“"
                            },
                            {
                                "example_id": "1b62be09-98b2-45cd-a06f-f0f9b554a281",
                                "sense_id": "3c50b1a4-7765-3191-b6bc-6992e02823b7",
                                "text": "„Ich war ganz untröstlich, weil dieser Schimpf auch seine komische Seite hatte und mich lächerlich machte; und das hielt ich für ehrenrühriger als ein Verbrechen.“"
                            },
                            {
                                "example_id": "0b9a5183-abb8-4dcc-aae8-d1cbf5fd9b34",
                                "sense_id": "3c50b1a4-7765-3191-b6bc-6992e02823b7",
                                "text": "„Der Schimpf, den Sie dem Offizier angetan haben, wird Ihnen teuer zu stehen kommen, Herr Wirt!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16a80b92-339a-4136-b04d-8c8a230f76f6",
                        "source_entry_id": "47429e48-50c9-37d3-a509-4d1997df5f0f",
                        "source_sense_id": "3c50b1a4-7765-3191-b6bc-6992e02823b7",
                        "source_sense_description": "gehoben, meist Singular: Verletzung der Selbstachtung",
                        "target_lang_word": "urážka",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "urážka",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "3605f3fa-d033-3da5-b75e-db60893dee1e",
                                        "entry_id": "4b039e0e-ae2e-3d66-a7b8-834161526822",
                                        "glosses": [
                                            "výrok, chování nebo čin, který snižuje čest či důstojnost druhého člověka"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5dea9cd-48d5-4c64-a8c2-249c250f9e99",
                                                "sense_id": "3605f3fa-d033-3da5-b75e-db60893dee1e",
                                                "text": "Nehodí se odmlouvat starším, jelikož povinnost velí respektovat je za každou cenu. Nehodí se bránit sebe nebo své děti před urážkami ze strany osob stejného věku, jelikož povinnost velí zachovat si důstojnost i pod nepřátelskou palbou."
                                            },
                                            {
                                                "example_id": "5f44f954-1acf-40cb-ab8c-3770b2596b99",
                                                "sense_id": "3605f3fa-d033-3da5-b75e-db60893dee1e",
                                                "text": "Vše to trvalo pouze několik vteřin; rázné zaklení převozníkovo a vzájemná výměna hrubozrných urážek byly jediným dozvukem netušeného výjevu."
                                            },
                                            {
                                                "example_id": "022c0850-88bd-4043-ba79-af7a9e19b40c",
                                                "sense_id": "3605f3fa-d033-3da5-b75e-db60893dee1e",
                                                "text": "Tohle si od vás nenechám líbít, za takovou urážku zaplatíte!"
                                            },
                                            {
                                                "example_id": "c0f39d15-8bf6-43ae-aea0-0b2c813dbb9e",
                                                "sense_id": "3605f3fa-d033-3da5-b75e-db60893dee1e",
                                                "text": "A Kodet, jehož sněhobílá košile byla potřísněna krví (dostal do nosu), se svlékl a košili si teatrálně pod tou pumpou pral. Přitom nás, kteří jsme koukali z okna, častoval urážkami. Bůhvíproč mi ta jeho slova připadala hodná zaznamenání a zapsal jsem si je na kousek papíru, který jsem po probuzení našel v kapse."
                                            }
                                        ]
                                    }
                                ]
                            },
