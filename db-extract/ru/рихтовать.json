                                                "example_id": "a515dbc3-6e69-4e40-a36d-a36f0b5cd4da",
                                                "sense_id": "985bf13c-7e85-375a-8658-e8337b4f67c0",
                                                "text": "Er richtet das Schreiben dann direkt an den Bürgermeister."
                                            },
