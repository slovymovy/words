                                            {
                                                "example_id": "fa1dfb65-4b0d-45a1-9b31-60c018e75e09",
                                                "sense_id": "1bc214a9-6c2a-3b79-b50f-88526e71d1a8",
                                                "text": "Der Arzt gab nach vielen gescheiterten Annäherungsversuchen und Therapien mit dem Psychopathen auf, weil ihm die Geduld nicht reichte."
                                            },
                                            {
                                                "example_id": "83d96b14-7cc8-4e2b-a9b6-5ca206cafeb0",
                                                "sense_id": "1bc214a9-6c2a-3b79-b50f-88526e71d1a8",
                                                "text": "„Sie fürchtete fortan die Rache des Psychopathen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "222dc717-2d81-31f0-9b02-605bf89da80e",
                                        "entry_id": "874226c8-0a34-3b2f-9321-098a31988917",
                                        "glosses": [
                                            "unter einer Persönlichkeits- oder Verhaltensstörung leidender Mensch"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ce99c21-8950-49d8-bf1c-e926de954e9c",
                                                "sense_id": "222dc717-2d81-31f0-9b02-605bf89da80e",
                                                "text": "„In einer amerikanischen Metastudie sind über sechshundert Psychopathen, Straftäter und gewaltbereite Menschen untersucht worden.“"
                                            },
                                            {
                                                "example_id": "5661c3aa-6f14-4328-ac0b-35187d7727df",
                                                "sense_id": "222dc717-2d81-31f0-9b02-605bf89da80e",
                                                "text": "„Der Psychopath vom Ergisstova konnte zur Hölle fahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0b9670db-ed1d-3a9d-8d3d-d2408314b931",
                                        "entry_id": "874226c8-0a34-3b2f-9321-098a31988917",
                                        "glosses": [
                                            "völlig verrückter, abgedrehter, gelegentlich auch ein (extrem-)eigenwilliger Mensch"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ed21f94-be99-4cdd-b713-45eeaab3435d",
                                                "sense_id": "0b9670db-ed1d-3a9d-8d3d-d2408314b931",
                                                "text": "„In einer amerikanischen Metastudie sind über sechshundert Psychopathen, Straftäter und gewaltbereite Menschen untersucht worden.“"
                                            },
                                            {
                                                "example_id": "7b12c413-69db-4354-9dfa-0bfb5996d281",
                                                "sense_id": "0b9670db-ed1d-3a9d-8d3d-d2408314b931",
                                                "text": "Der Typ ist ein totaler Psychopath!"
                                            },
                                            {
                                                "example_id": "3d6aad47-c516-44f4-8ed0-060d945737cc",
                                                "sense_id": "0b9670db-ed1d-3a9d-8d3d-d2408314b931",
                                                "text": "„Es gebe auch heutzutage noch genug Psychopathen, die behaupteten, von Außerirdischen in deren Raumschiff entführt oder sogar vergewaltigt worden zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
