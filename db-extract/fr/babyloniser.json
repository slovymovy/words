                        "glosses": [
                            "Donner un caractère babylonien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c91e1d7f-b780-4f5b-8a72-67fd448a6487",
                                "sense_id": "ad59dc2e-d332-346f-9182-a0ba691fd4aa",
                                "text": "Une fois plongé dans ce mysticisme divinatoire, on peut babyloniser n’importe quel usage dont le motif n’est pas assez clair."
                            },
                            {
                                "example_id": "bd2bb2bf-3708-4a5d-a486-4dfb5a2c8a57",
                                "sense_id": "ad59dc2e-d332-346f-9182-a0ba691fd4aa",
                                "text": "Il fut décidé qu’on louerait les vastes salons du grand hôtel transatlantique, qu’un tapissier serait chargé de babyloniser ou de niniviser."
                            }
                        ]
