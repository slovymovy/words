                "senses": [
                    {
                        "sense_id": "ae3260eb-1be1-38f9-b1b2-3868aefa9138",
                        "entry_id": "b33f0c0f-aa66-36c7-9b1b-06b5833b36f1",
                        "glosses": [
                            "(feierliche) Ernennung, Berufung in ein bestimmtes Amt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "319eed9b-40c4-4c33-8cdb-63db0c895969",
                                "sense_id": "ae3260eb-1be1-38f9-b1b2-3868aefa9138",
                                "text": "„Früher trafen sich zur Inauguration des Dreigestirns ein paar ältere Honoratioren.“"
                            },
                            {
                                "example_id": "e0f943fa-b25d-4df1-b589-422a05b791c5",
                                "sense_id": "ae3260eb-1be1-38f9-b1b2-3868aefa9138",
                                "text": "Heute findet die feierliche Inauguration von Prof. Dr. Christoph Markschies als Präsident der Humboldt-Universität zu Berlin um 18 Uhr im Auditorium maximum, Hauptgebäude, Unter den Linden 6, statt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d97f7283-8283-4a62-a38a-b8b94e7bf716",
