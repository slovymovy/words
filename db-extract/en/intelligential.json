                        "examples": [
                            {
                                "example_id": "2d90f5dd-3e26-4aca-8593-dc540fcd1b6e",
                                "sense_id": "2f8bbe49-1261-3a68-859e-c567b774c749",
                                "text": "[…] in at his mouth\nThe Devil entered; and his brutal sense,\nIn heart or head, possessing, soon inspired\nWith act intelligential; but his sleep\nDisturbed not, waiting close the approach of morn."
                            },
                            {
                                "example_id": "30fdcdc5-c06c-4d7c-8506-7d2085fdfee8",
                                "sense_id": "2f8bbe49-1261-3a68-859e-c567b774c749",
                                "text": "Nor demonstration physical alone,\nOr more intelligential and abstruse,\nPersuades me to this faith; but from that truth\nIt cometh to me rather, which is shed\nThrough Moses, the rapt Prophets, and the Psalms."
                            },
                            {
                                "example_id": "0f024d64-4140-4546-b1a9-21e9831adc02",
                                "sense_id": "2f8bbe49-1261-3a68-859e-c567b774c749",
                                "text": "In the line of light bringers who pass from hand to hand the torch of intelligential fire, there are men of most unequal stature, and a giant may stoop to take the precious flambeau from a dwarf."
                            }
                        ]
                    }
