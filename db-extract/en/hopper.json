                        "target_lang_word": "Trichter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trichter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3cadcfd3-3520-3024-b140-8fded6576949",
                                        "entry_id": "89b5c28c-b74e-35cd-9c55-1c32bf1da088",
                                        "glosses": [
                                            "kegelförmiges, oben weites und unten enges Rohr zum Einfüllen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5669ce6e-9925-4093-9944-1eea854d7251",
                                                "sense_id": "3cadcfd3-3520-3024-b140-8fded6576949",
                                                "text": "Mit Hilfe des Trichters füllt sie die kochendheiße Suppe in die Thermoskanne."
                                            },
                                            {
                                                "example_id": "00fb0f94-6705-4860-bdf8-e414d1db71f3",
                                                "sense_id": "3cadcfd3-3520-3024-b140-8fded6576949",
                                                "text": "Die Trichter -- (Christian Morgenstern, Wikisource-Quellentext „Die Trichter“)",
                                                "translation": "w."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "85909f70-6455-3721-b8f5-90a7124139a6",
                                        "entry_id": "89b5c28c-b74e-35cd-9c55-1c32bf1da088",
                                        "glosses": [
                                            "kegelförmiges, oben weites und unten enges Rohr zum Einfüllen",
                                            "von Flüssigkeiten und Pulvern in enghalsige Gefäße"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "4881a334-7a52-355b-bf28-5810f537422d",
                                        "entry_id": "89b5c28c-b74e-35cd-9c55-1c32bf1da088",
                                        "glosses": [
                                            "kegelförmiges, oben weites und unten enges Rohr zum Einfüllen",
                                            "von Getreide in eine Mühle (in der Regel vierkantig)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "382b8016-b1f9-4be6-97af-95a9fa546c79",
                                                "sense_id": "4881a334-7a52-355b-bf28-5810f537422d",
                                                "text": "„Die Innereien der Mühle, der laufende und der ruhende Mühlstein, die Trichter und Regulatoren waren in gemeinsamer Anstrengung schnell fertiggestellt worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "aca96477-d972-3fac-97ae-fa164d30c357",
                                        "entry_id": "89b5c28c-b74e-35cd-9c55-1c32bf1da088",
                                        "glosses": [
                                            "ein Gegenstand, der die Form eines Trichters hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1387467-af51-4ed7-a33f-9630c844eb56",
                                                "sense_id": "aca96477-d972-3fac-97ae-fa164d30c357",
                                                "text": "Der Trichter hat einen Durchmesser von mehr als 5 Metern."
                                            },
                                            {
                                                "example_id": "29a24d9b-efc2-48e5-90d4-ec9c27d78dad",
                                                "sense_id": "aca96477-d972-3fac-97ae-fa164d30c357",
                                                "text": "Im Unterschied zu den übrigen Seen im Permafrostboden der Region, weise der Grund des Tscheko-Sees die Form eines gut 50 Meter tiefen Trichters auf und sei von relativ jungem, instabilem Sediment bedeckt."
                                            },
                                            {
                                                "example_id": "7a85aa59-a32d-41b4-b1ef-673b21609b6a",
                                                "sense_id": "aca96477-d972-3fac-97ae-fa164d30c357",
                                                "text": "„Die Züge wurden vor der Einfahrt ins polnische Staatsgebiet, das sich von der Hafenstadt Danzig wie ein Trichter in den Süden zog, verplombt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
