                "senses": [
                    {
                        "sense_id": "e99e628a-a932-3fcb-8de2-8983af3b3ca4",
                        "entry_id": "a571b456-f9b5-32d2-9d2f-1ad7222abc46",
                        "glosses": [
                            "Relatif ou propre à la Maurétanie tingitane, à la Tingitane."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bc7f34c-706c-4051-ae0d-e7c6e1e10135",
                                "sense_id": "e99e628a-a932-3fcb-8de2-8983af3b3ca4",
                                "text": "Il ressort de l’étude de la mise en place du cadre tribal que la population de la péninsule tingitane a des origines historico-géographiques très diverses."
                            },
                            {
                                "example_id": "4b13c30a-3180-4216-8324-8e8c41858dde",
                                "sense_id": "e99e628a-a932-3fcb-8de2-8983af3b3ca4",
                                "text": "Laissons pour l’instant la question de savoir s’il faut se les représenter comme des pasteurs nomades venant faire paître leurs troupeaux sur le territoire tingitan."
                            },
                            {
                                "example_id": "d6bb1247-357a-404e-93fa-4b6058aa5a79",
                                "sense_id": "e99e628a-a932-3fcb-8de2-8983af3b3ca4",
                                "text": "Le débat pouvait donc paraître clos lorsqu’en 1969 M. Raymond Thouvenot rouvrit le dossier de la « basilique » de Lixus, considérée comme un vestige insigne du christianisme tingitan."
                            }
                        ]
                    },
                    {
                        "sense_id": "0130fdee-fe28-3864-af7f-5edaba90524d",
                        "entry_id": "a571b456-f9b5-32d2-9d2f-1ad7222abc46",
                        "glosses": [
                            "Relatif à la péninsule d’Afrique du Nord séparant l’océan Atlantique et la mer Méditerranée où se situe la ville de Tanger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cf5cdb3-3f4d-49c5-8f38-d2168fe30213",
                                "sense_id": "0130fdee-fe28-3864-af7f-5edaba90524d",
                                "text": "Le projet de création du Parc Naturel de Bouhachem (qui représente la zone d’étude) est localisé à l’extrémité ouest de la chaîne montagneuse du Rif, dans la péninsule tingitane et couvre une superficie d’environ 90.000 ha."
                            }
                        ]
                    }
