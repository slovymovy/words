                                "target_senses": [
                                    {
                                        "sense_id": "9e62d487-8f2f-324c-8444-a005d2e11071",
                                        "entry_id": "9a3731e6-5627-35e5-9676-b582699ca8c0",
                                        "glosses": [
                                            "Music that combines West African musical styles (such as traditional Yoruba music and highlife) with American funk, jazz, and soul influences, with a focus on chanted vocals, complex intersecting rhythms, and percussion."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2ec90fc-59b8-47e8-b07f-c6e56dcc0bfe",
                        "source_entry_id": "3f407f6a-1788-379b-a186-73fa0239a6a5",
                        "source_sense_id": "c29cd7aa-da16-3217-abf5-76dfb5467c31",
                        "source_sense_description": "Musikrichtung, die westafrikanische Musik mit amerikanischem Funk und Jazz kombiniert",
                        "target_lang_word": "afrobeat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "afrobeat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee2bcefe-75d2-3013-be88-e3fc977bcf6a",
                                        "entry_id": "92331804-b219-32df-9748-9b3525c06617",
                                        "glosses": [
                                            "Mélange de musique traditionnelle nigériane, de jazz, de highlife, de funk, et de chant accompagné de percussions et de styles vocaux, popularisé en Afrique dans les années 1970."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4bb06d2-2797-4afb-bbf8-ba4190817d0c",
                                                "sense_id": "ee2bcefe-75d2-3013-be88-e3fc977bcf6a",
                                                "text": "Comme le rock, le reggae ou le hip-hop, l’afrobeat, expression musicale de la révolte contre l’injustice, est aussi un style de vie, une façon de résister aux difficultés quotidiennes."
                                            },
                                            {
                                                "example_id": "ece34d57-ab94-4462-b680-4e4363ec8535",
                                                "sense_id": "ee2bcefe-75d2-3013-be88-e3fc977bcf6a",
                                                "text": "On écoutait de la musique toute la journée et je découvrais de nouveaux styles comme le highlife, l’afrobeat, le funk, la soul, la rumba."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
