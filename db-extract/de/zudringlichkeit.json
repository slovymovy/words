                "senses": [
                    {
                        "sense_id": "bd4513b8-a0a7-35a5-b05b-8f128ee5b47a",
                        "entry_id": "687d981e-30b3-3451-b48d-d33f2d09e328",
                        "glosses": [
                            "Verhalten, eine Person gegen ihren Willen intensiv zu belästigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb7a0758-3ee6-40db-923f-864a503563d3",
                                "sense_id": "bd4513b8-a0a7-35a5-b05b-8f128ee5b47a",
                                "text": "„Von nun an marschiere ich dreimal täglich nach Rumbske mit dem Bündel auf dem Arm, das zugleich mich vor Zudringlichkeiten beschützt.“"
                            },
                            {
                                "example_id": "0068c2b6-8b60-46e0-9971-ea3754473e70",
                                "sense_id": "bd4513b8-a0a7-35a5-b05b-8f128ee5b47a",
                                "text": "„Der in seinem Gesichte ausgesprochene und dem Briten so eigentümliche Zug von schneidendem Hohne war im hohen Grade unedel, selbst wenn wir die ungestüme Zudringlichkeit der Indianerin zu seiner Entschuldigung gelten lassen wollen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
