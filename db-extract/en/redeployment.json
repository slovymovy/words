                                            {
                                                "example_id": "04101df2-00da-4a95-ab0b-9ba20547a11e",
                                                "sense_id": "5e104d6a-edd5-3393-9631-19e00b1d9878",
                                                "text": "Contrairement à la perception classique qui prévoit que le redéploiement d’actifs se fait au bénéfice des actionnaires, les dirigeants poursuivraient de fait leurs propres objectifs."
                                            }
                                        ]
