                ],
                "senses": [
                    {
                        "sense_id": "bfd16e95-419b-350d-a43a-68447dd4ade6",
                        "entry_id": "7292d08b-da6c-3d23-a4dc-b6a2fb9da3b4",
                        "glosses": [
                            "taki, który nie może latać"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f6b4edb-b499-465e-bdb4-ef0739477bc9",
                                "sense_id": "bfd16e95-419b-350d-a43a-68447dd4ade6",
                                "text": "Mija dzień, dwa, tydzień, trzeci tydzień, czwarty, wciąż wysyłam depesze i wciąż przychodzi odpowiedź, że pogoda nielotna, nie mogliśmy wysłać"
                            },
                            {
                                "example_id": "1b73fa23-362d-454b-89a6-271689ce4bd0",
                                "sense_id": "bfd16e95-419b-350d-a43a-68447dd4ade6",
                                "text": "Zaciągając pętlę na ciałach nielotnych, acz ruchliwych papug ściągałem je przemocą na ziemię"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a79b506-0ef5-4b87-8dcb-00a89a8df691",
                        "source_entry_id": "7292d08b-da6c-3d23-a4dc-b6a2fb9da3b4",
                        "source_sense_id": "bfd16e95-419b-350d-a43a-68447dd4ade6",
                        "target_lang_word": "flightless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flightless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d24e7753-6347-3638-b780-d886aced4edd",
                                        "entry_id": "a3c9ad60-800a-395d-ac9c-866edbc25061",
                                        "glosses": [
                                            "Unable to fly.",
                                            "Describing kinds of birds that normally cannot fly, such as the penguin, ostrich, and emu."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "985cc6e8-5dcd-4b54-b915-08a244840ce1",
                                                "sense_id": "d24e7753-6347-3638-b780-d886aced4edd",
                                                "text": "Near-synonyms: apterous, wingless"
                                            },
                                            {
                                                "example_id": "1b390af0-907b-483f-907b-6407033a8e95",
                                                "sense_id": "d24e7753-6347-3638-b780-d886aced4edd",
                                                "text": "The indigenous fauna of Australia and New Zealand featured an especially interesting array of flightless birds."
                                            },
                                            {
                                                "example_id": "d79e5b44-566b-400a-b2d7-d81f9b483635",
                                                "sense_id": "d24e7753-6347-3638-b780-d886aced4edd",
                                                "text": "America has its bald eagle and New Zealand has its kiwi, a flightless brown bird."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "729f6d78-8912-336c-b8eb-2972a3ff22dd",
                                        "entry_id": "a3c9ad60-800a-395d-ac9c-866edbc25061",
                                        "glosses": [
                                            "Unable to fly.",
                                            "Describing an individual bird that normally would be able to fly but in this case cannot, such as an injured sparrow."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b4eb6c3-8cba-4374-a5c8-a364b84d3cd1",
                                                "sense_id": "729f6d78-8912-336c-b8eb-2972a3ff22dd",
                                                "text": "The animal shelter has a flightless sparrow named Shiny, who seems to make up for his disability by being an avid runner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49da9f56-4f3f-31e9-81c5-d09861547d45",
                                        "entry_id": "a3c9ad60-800a-395d-ac9c-866edbc25061",
                                        "glosses": [
                                            "Unable to fly.",
                                            "Suddenly deprived of a scheduled (airline) flight by its cancellation."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "not-comparable",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba91d7a9-13cb-484e-b69c-9ed61467dcc4",
                                                "sense_id": "49da9f56-4f3f-31e9-81c5-d09861547d45",
                                                "text": "Oh great, some wind is blowing in Chicago, so now I'm flightless in Seattle, because this airline can't cope!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
