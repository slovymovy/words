                    },
                    {
                        "translation_id": "ae640fe8-1d12-4f91-81e7-dd2462da7f6a",
                        "source_entry_id": "546d82f7-9631-319b-8fd0-f3b575705cd0",
                        "source_sense_id": "de4efa23-da6e-3c1e-bb6f-364d91f4e8f0",
