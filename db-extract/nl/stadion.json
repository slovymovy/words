                                    {
                                        "sense_id": "f881b73c-f56c-3186-95d1-c4b3a043abb8",
                                        "entry_id": "b58dbae1-f139-369e-911d-1492eeec323d",
                                        "glosses": [
                                            "große bauliche Anlage mit einem zentralen Spielfeld, einer dieses umgebenden Laufbahn, die als Austragungsort für öffentliche Sportwettkämpfe genutzt wird, deren Zuschauer das sportliche Geschehen von Steh- oder Sitzplätzen auf den Rängen aus verfolgen können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ab238a5-1196-463b-afa8-3aeaa75feefd",
                                                "sense_id": "f881b73c-f56c-3186-95d1-c4b3a043abb8",
                                                "text": "Wir gehen zum Fußball ins Stadion."
                                            },
                                            {
                                                "example_id": "1b02068f-8640-4229-803c-dcfa6e262655",
                                                "sense_id": "f881b73c-f56c-3186-95d1-c4b3a043abb8",
                                                "text": "„Das Heimspiel des Fußball-Zweitligisten VfL Osnabrück gegen Schalke 04 am Samstag droht wegen baulicher Mängel an der Dachkonstruktion des Stadions auszufallen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c89c7435-c165-3620-bc05-46c43b4b7d6a",
                                        "entry_id": "b58dbae1-f139-369e-911d-1492eeec323d",
                                        "glosses": [
                                            "altgriechisches Längenmaß von 185 Meter (1/8 römische Meile)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1cc8e71-bd9a-4f3f-a639-4e22f732b3c7",
                                                "sense_id": "c89c7435-c165-3620-bc05-46c43b4b7d6a",
                                                "text": "Die Mathematiker endlich, die die Größe des Umfangs [der Erde] zu berechnen suchen, nehmen ungefähr 400 000 Stadien an. (Aristoteles: Vom Himmel)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "373263fa-316a-4cbc-842a-17d9e5c0bc66",
                        "source_entry_id": "7f19d43c-8b56-3b26-8301-14b8018f6514",
                        "source_sense_id": "6fb6cb30-34a1-3da8-adeb-e0a20bd8008b",
                        "target_lang_word": "arena",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arena",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e27f179-00ad-3f3d-a104-d2759742bdb3",
                                        "entry_id": "a0ed8f9e-0ad1-3d92-a690-b37733e30890",
                                        "glosses": [
                                            "An enclosed area, often outdoor, for the presentation of sporting events (sports arena) or other spectacular events; earthen area, often oval, specifically for rodeos (North America) or circular area for bullfights (especially Hispanic America)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5ff0b7a-64ee-4a22-aceb-4feccf2e37c8",
                                                "sense_id": "7e27f179-00ad-3f3d-a104-d2759742bdb3",
                                                "text": "A large crowd filled the seats of the arena."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7554a8e7-6b6e-30a7-8528-fdd43d999087",
                                        "entry_id": "a0ed8f9e-0ad1-3d92-a690-b37733e30890",
                                        "glosses": [
                                            "The building housing such an area; specifically, a very large, often round building, often topped with a dome, designated for indoor sporting or other major events, such as concerts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40968dfa-a82a-4c3d-a567-e7e273021f2e",
                                                "sense_id": "7554a8e7-6b6e-30a7-8528-fdd43d999087",
                                                "text": "The arena is grey with white beams."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "beac34f1-55b5-3208-bc02-f98e8faa6d58",
                                        "entry_id": "a0ed8f9e-0ad1-3d92-a690-b37733e30890",
                                        "glosses": [
                                            "The sand-covered centre of an amphitheatre where contests were held in Ancient Rome."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58b88c0b-88f0-4c48-a466-99cb1b9f292d",
                                                "sense_id": "beac34f1-55b5-3208-bc02-f98e8faa6d58",
                                                "text": "The gladiators entered the arena."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9a441c8-3bfc-319f-8d93-2b9e98fb3e0e",
                                        "entry_id": "a0ed8f9e-0ad1-3d92-a690-b37733e30890",
                                        "glosses": [
                                            "A realm in which events take place; an area of interest, study, behaviour, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2fe36eb-87aa-4949-9c7d-415d709e6b5c",
                                                "sense_id": "c9a441c8-3bfc-319f-8d93-2b9e98fb3e0e",
                                                "text": "The company was a player in the maritime insurance arena."
                                            },
                                            {
                                                "example_id": "f09faa6d-f367-4e47-92c4-c7840908d89b",
                                                "sense_id": "c9a441c8-3bfc-319f-8d93-2b9e98fb3e0e",
                                                "text": "But transects have also been utilised in a large variety of arenas, including surveying the contents of Amerindian earthen mounds, determining levels of anti-rabies vaccinations in village dogs, and examining ecological factors under the canopy of trees growing in agricultural areas."
                                            },
                                            {
                                                "example_id": "b3013aa3-fd3c-41d0-9097-703d4bb8b541",
                                                "sense_id": "c9a441c8-3bfc-319f-8d93-2b9e98fb3e0e",
                                                "text": "To Musk, his vast fortune is a mere side effect of his ability not just to see but to do things others cannot, in arenas where the stakes are existential."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8684093d-b9a6-4297-bf37-9e7ff8b60a23",
                        "source_entry_id": "7f19d43c-8b56-3b26-8301-14b8018f6514",
                        "source_sense_id": "6fb6cb30-34a1-3da8-adeb-e0a20bd8008b",
                        "target_lang_word": "stadium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stadium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "65a10d85-26b9-3a83-b57b-7066b0ebc483",
                                        "entry_id": "ea36a8ec-ea62-3ae4-9ffe-60a608f94a77",
                                        "glosses": [
                                            "A venue where sporting events are held."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09bd82e4-a665-4e75-bb8e-8ef4577324f6",
                                                "sense_id": "65a10d85-26b9-3a83-b57b-7066b0ebc483",
                                                "text": "He is going for a cricket match at the stadium."
                                            },
                                            {
                                                "example_id": "83b60883-cf00-4776-8c2c-d1a2b0d2c887",
                                                "sense_id": "65a10d85-26b9-3a83-b57b-7066b0ebc483",
                                                "text": "In a convulsion that has caught many in Brazil and beyond by surprise, waves of protesters denounced their leaders for dedicating so many resources to cultivating Brazil’s global image by building stadiums for international events, when basic services like education and health care remain woefully inadequate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b76b47b-45fe-3877-b5e6-f00e23e00c8e",
                                        "entry_id": "ea36a8ec-ea62-3ae4-9ffe-60a608f94a77",
                                        "glosses": [
                                            "An Ancient Greek racecourse, especially, the Olympic course for foot races."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ad867b3c-f1f7-3faa-8760-eae6af602cfa",
                                        "entry_id": "ea36a8ec-ea62-3ae4-9ffe-60a608f94a77",
                                        "glosses": [
                                            "Synonym of stadion, a Greek unit of length equivalent to about 185 m."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66761452-a5f0-4807-89e5-a42626bbbb8c",
                                                "sense_id": "ad867b3c-f1f7-3faa-8760-eae6af602cfa",
                                                "text": "Dionysiodorus[…]sent a letter ad superos after he was dead, from the centre of the earth, to signify what distance the same centre was from the superficies of the same, viz. 42,000 stadiums […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16f2565a-23e0-3dcb-be0e-f0dad18c7aa7",
                                        "entry_id": "ea36a8ec-ea62-3ae4-9ffe-60a608f94a77",
                                        "glosses": [
                                            "A kind of telemeter for measuring the distance of an object of known dimensions, by observing the angle it subtends."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "84d371a3-becd-31be-884c-fc949f9002b6",
                                        "entry_id": "ea36a8ec-ea62-3ae4-9ffe-60a608f94a77",
                                        "glosses": [
                                            "A graduated rod used to measure the distance of the place where it stands from an instrument having a telescope, by observing the number of the graduations of the rod that are seen between certain parallel wires (stadia wires) in the field of view of the telescope."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "61dc63ab-94b5-3baa-8617-963e31f373bb",
                                        "entry_id": "ea36a8ec-ea62-3ae4-9ffe-60a608f94a77",
                                        "glosses": [
                                            "A life stage of an organism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21f62400-8d47-43cf-8e9e-b2ee3054c420",
                        "source_entry_id": "7f19d43c-8b56-3b26-8301-14b8018f6514",
                        "source_sense_id": "6fb6cb30-34a1-3da8-adeb-e0a20bd8008b",
                        "target_lang_word": "stade",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stade",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9c01dbe1-aa5f-3295-af8c-ead92df4c9d9",
                                        "entry_id": "f2628e1c-7861-3c8f-86c0-1398e709ab51",
                                        "glosses": [
                                            "Mesure de longueur valant à peu près 180 mètres."
                                        ],
                                        "tags": [
                                            "Ancient-Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12943539-b1ad-4dc9-b5ca-4c7af4f90ab8",
                                                "sense_id": "9c01dbe1-aa5f-3295-af8c-ead92df4c9d9",
                                                "text": "Le stade grec ou italique, stade primitif, stadion, dont 8 ⅓ formaient le mille, se divisait en 6 plèthres = 10 amma = 60 acènes = 100 orgyies = 120 bême-diploun ou pas doubles = 240 bême-aploun = 400 coudées naturelles = 600 pieds.\nLe stade olympique faisait 400 coudées olympiques = 600 pieds olympiques.\nLe stade pythique ou delphique de 1000 pieds delphiques était de même valeur que le stade olympique."
                                            },
                                            {
                                                "example_id": "29035f0c-6f08-47ad-ada3-65205c9980c3",
                                                "sense_id": "9c01dbe1-aa5f-3295-af8c-ead92df4c9d9",
                                                "text": "Aristote, d’après certains savants de son époque, considérait le stade, ou coudée égyptienne au temps de Sésostris, comme formant la cent millième partie du pôle à l’équateur."
                                            },
                                            {
                                                "example_id": "5089429d-3665-4e47-b599-eed8d16f5375",
                                                "sense_id": "9c01dbe1-aa5f-3295-af8c-ead92df4c9d9",
                                                "text": "Or, depuis Abydos jusqu’à la côte opposée, il y a un trajet de sept stades."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc75145a-885c-3462-b9f1-676c5da0a3dd",
                                        "entry_id": "f2628e1c-7861-3c8f-86c0-1398e709ab51",
                                        "glosses": [
                                            "Carrière ou enceinte ayant cette longueur et où les Grecs s’exerçaient à la course."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b356a17b-0c6a-4c5e-a904-4f60ba9300c1",
                                                "sense_id": "dc75145a-885c-3462-b9f1-676c5da0a3dd",
                                                "text": "Il est probable que, sans avoir construit d’édifices qui puissent se comparer aux cirques-hippodromes romains, les artistes grecs de la force et de l'agilité se sont produits autant sur les places publiques que dans les stades, comme celui d'Olympie, […]."
                                            },
                                            {
                                                "example_id": "64ad2462-abe2-48a0-aaeb-93b606c8a172",
                                                "sense_id": "dc75145a-885c-3462-b9f1-676c5da0a3dd",
                                                "text": "Courir dans le stade."
                                            },
                                            {
                                                "example_id": "d4cbf5c5-b074-43b1-ab42-e751d6332b47",
                                                "sense_id": "dc75145a-885c-3462-b9f1-676c5da0a3dd",
                                                "text": "Gagner le prix du stade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ada7e14-0fb5-3dec-afa7-81b011b008c0",
                                        "entry_id": "f2628e1c-7861-3c8f-86c0-1398e709ab51",
                                        "glosses": [
                                            "Bâtiment qui entoure ce terrain de sport où se déroulent des compétitions sportives."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf89cf79-2703-4710-a388-217ffbd3f7f4",
                                                "sense_id": "9ada7e14-0fb5-3dec-afa7-81b011b008c0",
                                                "text": "Le stade de France."
                                            },
                                            {
                                                "example_id": "7c6ddbd4-9bf2-4331-a059-0ccdce0610c0",
                                                "sense_id": "9ada7e14-0fb5-3dec-afa7-81b011b008c0",
                                                "text": "Il les partage avec ses frères et son père car, à la maison, on n’a plus les moyens financiers de se rendre au stade"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9c35e89-806a-3c5b-a791-98fa959bf4d4",
                                        "entry_id": "f2628e1c-7861-3c8f-86c0-1398e709ab51",
                                        "glosses": [
                                            "Période ou degré d’une maladie intermittente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfdedf14-90c5-4952-99c4-40ba24bea4c5",
                                                "sense_id": "f9c35e89-806a-3c5b-a791-98fa959bf4d4",
                                                "text": "Cette maladie est à un stade avancé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56c63309-372c-3790-9cfe-b1d6f0806d62",
                                        "entry_id": "f2628e1c-7861-3c8f-86c0-1398e709ab51",
                                        "glosses": [
                                            "Degré ou palier dans une évolution."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02fe7ea3-b0b8-4b62-98bc-a07b58229946",
                                                "sense_id": "56c63309-372c-3790-9cfe-b1d6f0806d62",
                                                "text": "L’efficacité parasitaire des adultes peut se trouver limitée par la rupture de la coïncidence spatio-temporelle entre le stade réceptif des hôtes (œufs en cours d’embryogenèse) et le stade agressif du parasitoïde (Nenon, 1974)."
                                            },
                                            {
                                                "example_id": "13ea9427-b18c-4ab8-9c6d-12cb7cd38dd7",
                                                "sense_id": "56c63309-372c-3790-9cfe-b1d6f0806d62",
                                                "text": "Une partie des larves des deuxième et troisième stades et toutes celles du quatrième stade hivernèrent."
                                            },
                                            {
                                                "example_id": "87189cac-374d-4e81-a86a-0dce6921e71e",
                                                "sense_id": "56c63309-372c-3790-9cfe-b1d6f0806d62",
                                                "text": "Le médecin traitant et le pneumologue en particulier ont donc un rôle important, en liaison avec le médecin du travail pour intervenir à tous les stades de la prévention primaire, secondaire et tertiaire vis-à-vis des risques respiratoires d’origine professionnelle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
