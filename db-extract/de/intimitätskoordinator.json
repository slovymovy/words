                "senses": [
                    {
                        "sense_id": "9f3bf3a1-403b-3739-b0f9-999f06c0156a",
                        "entry_id": "026cbf28-b630-37d1-bf90-9ad10b17f1f1",
                        "glosses": [
                            "Person, die Mitglieder im Theater oder in Film- beziehungsweise Fernsehproduktionen (wie Schauspieler) bei der Darstellung intimer Szenen betreut und berät, um einen von Respekt und Sicherheit geprägten Umgang zu ermöglichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5284a240-e1f8-44ed-aef6-493571f42f89",
                                "sense_id": "9f3bf3a1-403b-3739-b0f9-999f06c0156a",
                                "text": "„Intimitätskoordinatoren sind vor allem dazu da, das Wohlbefinden der Schauspieler in Sex- und Liebesszenen sicherzustellen.“"
                            },
                            {
                                "example_id": "58cd171a-e4fb-40bb-98df-75a484a34f29",
                                "sense_id": "9f3bf3a1-403b-3739-b0f9-999f06c0156a",
                                "text": "„Den Effekt von Intimitätskoordinatoren am Set für solche expliziten Szenen beschreibt Schauspielerin Kristen Stewart als ausgesprochen positiv.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "18bf5a4b-165c-482f-8b91-3cec6f36bb29",
                        "source_entry_id": "026cbf28-b630-37d1-bf90-9ad10b17f1f1",
                        "source_sense_id": "9f3bf3a1-403b-3739-b0f9-999f06c0156a",
