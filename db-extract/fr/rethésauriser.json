                "senses": [
                    {
                        "sense_id": "d020eedd-c61c-39d3-b760-99edc14924f1",
                        "entry_id": "0907a242-30c7-3109-9356-342d81abcc11",
                        "glosses": [
                            "Thésauriser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a9054f2-1760-4ab6-a1c0-58ad2912b861",
                                "sense_id": "d020eedd-c61c-39d3-b760-99edc14924f1",
                                "text": "A ce moment-là, ces titres introduits sur le marché seront rethésaurisés, valorisés à hauteur des règles du marché, (...)"
                            },
                            {
                                "example_id": "d76ff966-de38-4842-8c75-bb172d291096",
                                "sense_id": "d020eedd-c61c-39d3-b760-99edc14924f1",
                                "text": "Mis à part les cas de guerre ou de pillage, où s’opèrent de brusques déthésaurisations de richesses (métaux précieux, soieries, chevaux, armes…), dispersées ou rethésaurisées ailleurs, les échanges matériels répondent normalement à une offre et à une demande."
                            },
                            {
                                "example_id": "6e814e27-95e0-41b2-aa8a-0173038f9939",
                                "sense_id": "d020eedd-c61c-39d3-b760-99edc14924f1",
                                "text": "L'ARGENT A DISPARU ET ON RECOMMENCE A RETHESAURISER."
                            }
                        ]
                    }
