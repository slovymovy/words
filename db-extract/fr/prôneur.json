                        "entry_id": "b6760a2d-c8b8-38ab-a7a1-3f343babff3f",
                        "glosses": [
                            "Personne qui prononce un prône."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "73f3227e-7e1d-47bb-932b-1539b414f7a8",
                                "sense_id": "5700a117-4f20-3ab5-bebd-fbc42e59d10f",
                                "text": "Prôneur ne se dit plus de celui qui fait un prône ; ainsi, on ne dit pas d’un curé que c’est un excellent prôneur."
                            }
                        ]
                    },
                    {
                        "sense_id": "c018000f-db7f-340e-8c7e-722990f7cc50",
                        "entry_id": "b6760a2d-c8b8-38ab-a7a1-3f343babff3f",
                        "glosses": [
                            "Celui qui loue avec excès ou à l'inverse fait des remontrances."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "c93250f7-2530-4c92-a549-119f58b2a328",
                                "sense_id": "c018000f-db7f-340e-8c7e-722990f7cc50",
                                "text": "Aussi, dans les bureaux, Baudoyer avait en Dutocq et Godard deux prôneurs."
                            },
                            {
                                "example_id": "7e89791b-450c-4532-8491-d96b6ed4ef4f",
                                "sense_id": "c018000f-db7f-340e-8c7e-722990f7cc50",
                                "text": "Cependant le héros pudibond se rengorge comme un paon, et lève arrogamment la crête, lorsque son prôneur impudent ose égaler aux dieux le plus méprisable des faquins."
                            }
                        ]
                    }
