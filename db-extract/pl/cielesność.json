                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90650aa7-3c88-4f94-b8c1-0ed15314b5ff",
                        "source_entry_id": "ed108979-da3e-3c1c-a3b2-4f1fde0380a2",
                        "source_sense_id": "aa42d462-95b5-3317-98e7-81bd0d522c5b",
                        "target_lang_word": "Körperlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Körperlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "133d0ca2-09e8-385b-bf96-2f44d384b99a",
                                        "entry_id": "efbed2fe-056a-376f-859a-5cf517f122a0",
                                        "glosses": [
                                            "die körperliche Beschaffenheit, das Körperhafte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1de69119-b408-4334-9f97-5da4d87f111c",
                                                "sense_id": "133d0ca2-09e8-385b-bf96-2f44d384b99a",
                                                "text": "Es müsste also eigentlich heißen: Sum ergo cogito. Denn ohne Körperlichkeit gibt es kein Denken."
                                            },
                                            {
                                                "example_id": "6fc60b31-204e-45cf-bb64-98e3097d13a6",
                                                "sense_id": "133d0ca2-09e8-385b-bf96-2f44d384b99a",
                                                "text": "„Der Freikletterer bewegt sich in steiler Wand: Er verzichtet auch bei höchsten Schwierigkeitsgraden auf technische Hilfsmittel und setzt sich mit seiner reinen Körperlichkeit, der Kraft und Geschmeidigkeit seiner Muskeln, der Haltefähigkeit seiner Finger und Zehen, dem natürlichen Fels, seinen glatten Wänden, gefurchten Rillen, sperrigen Überhängen aus.“"
                                            },
                                            {
                                                "example_id": "03b6f17d-7215-4ff5-ba82-4df12411bf41",
                                                "sense_id": "133d0ca2-09e8-385b-bf96-2f44d384b99a",
                                                "text": "Fernab von seriellen oder kombinatorischen Erfüllungsgedichten mancher ehemals „experimenteller“ Literatur weiß die wirklich innovative Lyrik von heute mit neuer Sprachlust an die Arbeit zu gehen, werden lyrische Bilder in einer spürbaren Körperlichkeit vor das Auge des Lesers gezaubert, der sich darauf einlässt."
                                            },
                                            {
                                                "example_id": "a42a61ae-763d-4f81-956e-1644f26cd63c",
                                                "sense_id": "133d0ca2-09e8-385b-bf96-2f44d384b99a",
                                                "text": "Das sind die in die Augen fallenden Bestandtheile des Telluriums, die wir ohne alle wissenschaftlichen Erklärungen eben nur angegeben haben, um die Vorstellung des in voller Körperlichkeit vor uns stehenden Instrumentes oder Apparates zu erleichtern."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "33b28e5a-d4db-3265-8ecb-0b4c11001023",
                                        "entry_id": "efbed2fe-056a-376f-859a-5cf517f122a0",
                                        "glosses": [
                                            "die Anziehungskraft, die Wirkung, das Sinnliche eines Körpers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1021cca8-c0ec-49f9-b022-d61db49a0524",
                                                "sense_id": "33b28e5a-d4db-3265-8ecb-0b4c11001023",
                                                "text": "Damals und damals überall hätte ich die Aufmunterung gebraucht. Ich war ja schon niedergedrückt durch Deine blosse Körperlichkeit."
                                            },
                                            {
                                                "example_id": "4a1b12b9-da35-4c1e-ac95-5c5854f6889e",
                                                "sense_id": "33b28e5a-d4db-3265-8ecb-0b4c11001023",
                                                "text": "Die zu behandelnden Themengebiete reichen von der Darstellung von Lust und Erotik über weibliche Adoleszenz, Schwangerschaft und Mutterschaft, lesbische Sexualität bis zu sexueller Gewalt – von Entdeckung und „Erfindung“ des weiblichen Körpers bis zu Formen der Negation und Repression von Körperlichkeit und Sexualität."
                                            },
                                            {
                                                "example_id": "239495ef-439b-417c-a4fd-7a3d18464490",
                                                "sense_id": "33b28e5a-d4db-3265-8ecb-0b4c11001023",
                                                "text": "Hier plaidirt eine Gruppe rechtschaffener Männer dafür, daß die Frau nur für die körperliche Nachwelt geschaffen sei, eine Anschauung, aus der man folgern sollte, daß das mit einer robusten Körperlichkeit ausgestattete Weib die Incarnation des Frauenthums darstelle."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
