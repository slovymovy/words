                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "147de92d-f6dd-402c-b576-f5baf6ed89a4",
                                                "sense_id": "1760441d-ee43-3233-9485-73c4a99f0699",
