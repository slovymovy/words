                                "example_id": "0c1840a5-a13b-4f79-bd2d-2c75a088a5b7",
                                "sense_id": "f73615e4-25fb-3510-9f5b-00a86ed11749",
                                "text": "Allerorten herrscht dieser Tage Trübsal."
                            },
                            {
                                "example_id": "f25f5b85-8e83-4b0b-a766-a06c34838303",
                                "sense_id": "f73615e4-25fb-3510-9f5b-00a86ed11749",
                                "text": "Diese neuen Automobile sind nun allerorten anzutreffen."
                            },
                            {
                                "example_id": "8b79212c-1f2b-4518-a2c4-64d42ee3a602",
                                "sense_id": "f73615e4-25fb-3510-9f5b-00a86ed11749",
                                "text": "Auf meiner Wanderschaft war ich allerorten sehr willkommen."
                            },
                            {
                                "example_id": "3d6d84b9-2694-4285-a200-515cad050c83",
                                "sense_id": "f73615e4-25fb-3510-9f5b-00a86ed11749",
                                "text": "„Kaugummikauen ist gesellschaftsfähig geworden – und damit zum Problem für Stadtreinigungen allerorten.“"
                            }
                        ],
