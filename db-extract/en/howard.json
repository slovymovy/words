                "senses": [
                    {
                        "sense_id": "ae21ece3-b4fa-3cce-897b-c07fc3e01efe",
                        "entry_id": "ea9d6606-f035-3222-aaae-ab7bee71722c",
                        "glosses": [
                            "A surname originating as a patronymic."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "69c20035-6033-468f-81af-a24c1d36638d",
                                "sense_id": "ae21ece3-b4fa-3cce-897b-c07fc3e01efe",
                                "text": "Henry Howard, the most noble Earl of Surry, who flourishing in the time of King Henry the 8.th, as his name is sufficiently famous for the martial exploits of that family for many generations, so deserves he, had he his due, the particular fame of learning, wit, and poetic fancy"
                            }
                        ]
                    },
                    {
                        "sense_id": "a0b85ff5-85cb-32c8-8f3e-1d981b94a1d0",
                        "entry_id": "ea9d6606-f035-3222-aaae-ab7bee71722c",
                        "glosses": [
                            "A male given name from the Germanic languages, transferred back from the surname. Short form: Howie."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "03a8e2a9-5b4e-4bce-9729-974615284384",
                                "sense_id": "a0b85ff5-85cb-32c8-8f3e-1d981b94a1d0",
                                "text": "\"King Howard Kashpaw, Junior,\" said his new teacher. \"Which one of those names would you like to be called?\"\nHe had never thought about it.\n\"Howard,\" he was surprised to hear himself answer. It was that simple. After that he was Howard at school. - - -\n\"\"He don't call himself Little King anymore,\" Lynette said from the kitchen. \"He thinks his name's Howard.\"\n\"Howard?\"\nThe boy looked at me and nodded.\n\"He won't claim his dad no more,\" said King, standing in the doorway. \"He's too good.\""
                            },
                            {
                                "example_id": "239d7991-621b-4ad0-adcc-774ad033490e",
                                "sense_id": "a0b85ff5-85cb-32c8-8f3e-1d981b94a1d0",
                                "text": "“For most of human history, the question of whether or not life exists elsewhere has belonged only within the philosophical realm,” said Howard Chen, study author and Ph.D candidate at Northwestern University."
                            }
                        ]
