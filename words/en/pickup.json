                                "target_lang_sense_clarification": "техника соблазнения"
                            },
                            {
                                "target_lang_word": "подкат",
                                "target_lang_sense_clarification": "сленг"
                            },
                            {
                                "target_lang_word": "съём",
                                "target_lang_sense_clarification": "грубый сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "搭讪",
                                "target_lang_sense_clarification": "主动交谈"
                            },
                            {
                                "target_lang_word": "撩人",
                                "target_lang_sense_clarification": "带有挑逗意味"
                            }
                        ]
