                        ],
                        "form": "der Allmacht"
                    },
                    {
                        "form_id": "d86f9b9b-8cba-40d3-9ed3-f27ee6984927",
                        "entry_id": "36b5841d-9b0b-359e-ae17-15040a0cc428",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Allmacht"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ab6fd184-64e1-30fc-9186-f73f1a996dd3",
                        "entry_id": "36b5841d-9b0b-359e-ae17-15040a0cc428",
                        "glosses": [
                            "unbegrenzte Macht; die Fähigkeit, alles zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b83c2ff-d4f0-4064-9fdb-101438164e6d",
                                "sense_id": "ab6fd184-64e1-30fc-9186-f73f1a996dd3",
                                "text": "Kombiniert man die Allmacht und Allgüte Gottes vor dem Hintergrund der Schlechtigkeit in der Welt, so ergibt sich ein Rechtfertigungsproblem."
                            },
                            {
                                "example_id": "b3d1aedc-d571-4eb0-8d18-f6e03cc0e32d",
                                "sense_id": "ab6fd184-64e1-30fc-9186-f73f1a996dd3",
                                "text": "„Ein letztes Mal bäumen sich lokale Fürsten nun noch gegen Tafaris klar erkennbaren Weg zur Allmacht auf.“"
                            },
                            {
                                "example_id": "5424e1e2-14be-45de-8cab-6617d46f34a3",
                                "sense_id": "ab6fd184-64e1-30fc-9186-f73f1a996dd3",
                                "text": "„Denn da ist etwas, was er zu sagen hat, was er erlebt, gesehn, erforscht hat – etwas durchaus nicht Naives, sondern Furchtbares, wovon er weiß, daß es allem sentimentalen und idealen Geschwätz zum Trotz die tiefere, die echtere Wahrheit ist – die Allmacht der Geschlechtlichkeit, der Begierde, des Egoismus, der Lieblosigkeit unter Menschen, der Verderbtheit mit einem Wort, die die angebliche Welt Gottes in ein Mörder- und Lusthaus verwandelt.“"
                            },
                            {
                                "example_id": "70b7343c-9be5-4467-a8e0-b504fb164a1e",
                                "sense_id": "ab6fd184-64e1-30fc-9186-f73f1a996dd3",
                                "text": "„Weißt du noch, Luzifer ist ein gefallener Engel, der Rebell, der sich mit der Allmacht des Himmels nicht abfinden wollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d290924d-77bb-4f5a-901d-bcf55952ff2d",
                        "source_entry_id": "36b5841d-9b0b-359e-ae17-15040a0cc428",
                        "source_sense_id": "ab6fd184-64e1-30fc-9186-f73f1a996dd3",
                        "source_sense_description": "Religion: unbegrenzte Macht; die Fähigkeit, alles zu können",
                        "target_lang_word": "omnipotence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "omnipotence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cba5f189-ba69-332f-8d63-a39ffd8212c4",
                                        "entry_id": "ecb2de18-ca1e-318a-88ed-dbe74d92a24f",
                                        "glosses": [
                                            "Unlimited power; commonly attributed to a deity or deities."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58539b3f-02cd-45f0-b185-944b93e24e0d",
                                                "sense_id": "cba5f189-ba69-332f-8d63-a39ffd8212c4",
                                                "text": "One purpose of the Freedom of Information Act is to make our society less of a police state. Until the CIA's omnipotence is seriously challenged, however, the xeroxed papers in my hand have little meaning. For now, they remind me of nothing less than the simple fact that evil forces still control our society."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5af9211-b133-4b11-8159-2d8a42e170ee",
                        "source_entry_id": "36b5841d-9b0b-359e-ae17-15040a0cc428",
                        "source_sense_id": "ab6fd184-64e1-30fc-9186-f73f1a996dd3",
                        "source_sense_description": "Religion: unbegrenzte Macht; die Fähigkeit, alles zu können",
                        "target_lang_word": "omnipotence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "omnipotence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "367cc4ed-1e96-38ab-b501-85ba05cea855",
                                        "entry_id": "d5320c80-bde6-3f06-9920-0790decfd8f5",
                                        "glosses": [
                                            "Toute-puissance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92ab886e-4c19-4ff3-95dc-ccd8b4d18f12",
                                                "sense_id": "367cc4ed-1e96-38ab-b501-85ba05cea855",
                                                "text": "Ce pamphlet contre l’homme que Diderot n’osa pas publier, le Neveu de Rameau ; ce livre, débraillé tout exprès pour montrer des plaies, est seul comparable à ce pamphlet dit sans aucune arrière-pensée, où le mot ne respecta même point ce que le penseur discute encore, où l’on ne construisit qu’avec des ruines, où l’on nia tout, où l’on n’admira que ce que le scepticisme adopte : l’omnipotence, l’omniscience, l’omniconvenance de l’argent."
                                            },
                                            {
                                                "example_id": "45797aeb-cc17-4741-bc2a-017b29782cb5",
                                                "sense_id": "367cc4ed-1e96-38ab-b501-85ba05cea855",
                                                "text": "Les bourreaux doivent savourer la même omnipotence, se livrer à pareille furie, goûter une égale joie de meurtrir sans remords."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55ad9a31-afc1-3d49-a163-4780bf8fbf4b",
                                        "entry_id": "d5320c80-bde6-3f06-9920-0790decfd8f5",
                                        "glosses": [
                                            "Faculté de décider souverainement en certaines matières."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7622c8d7-ea17-451b-95b0-6c492738b277",
                                                "sense_id": "55ad9a31-afc1-3d49-a163-4780bf8fbf4b",
                                                "text": "L’omnipotence du jury."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "224511e0-e490-49e8-9d4f-a1df6e7267da",
                        "source_entry_id": "36b5841d-9b0b-359e-ae17-15040a0cc428",
                        "source_sense_id": "ab6fd184-64e1-30fc-9186-f73f1a996dd3",
                        "source_sense_description": "Religion: unbegrenzte Macht; die Fähigkeit, alles zu können",
                        "target_lang_word": "prépotence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prépotence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "60deabb0-0f4d-33b8-b25f-71dbbf34fa77",
                                        "entry_id": "1e185048-89ac-3a44-9d1d-1ceb7c0cea31",
                                        "glosses": [
                                            "Pouvoir supérieur, supériorité de puissance avec une idée d’abus, d’absolutisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed96360a-753a-48f0-b464-986ceac7ca3b",
                                                "sense_id": "60deabb0-0f4d-33b8-b25f-71dbbf34fa77",
                                                "text": "Ôtez cette prépotence maritale, ôtez le dévouement de la beauté à la force, vous retombez dans le concubinat, vous détruisez le mariage."
                                            },
                                            {
                                                "example_id": "0bff0b7b-f5a5-4dfe-8a67-3c7b469c559d",
                                                "sense_id": "60deabb0-0f4d-33b8-b25f-71dbbf34fa77",
                                                "text": "Loin de voir dans ces marques d’adoration un danger de folie ou de prépotence pour l’homme qui les accepte, j’y découvrais un frein, l’obligation de se dessiner d’après quelque modèle éternel, d’associer à la puissance humaine une part de suprême sapience."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1c00ce7-2b80-478f-872d-a06aefb6a8d3",
                        "source_entry_id": "36b5841d-9b0b-359e-ae17-15040a0cc428",
                        "source_sense_id": "ab6fd184-64e1-30fc-9186-f73f1a996dd3",
                        "source_sense_description": "Religion: unbegrenzte Macht; die Fähigkeit, alles zu können",
                        "target_lang_word": "toute-puissance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "toute-puissance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "10a2f8a4-6068-3744-bd53-c1559a58d5b3",
                                        "entry_id": "6b09eed9-a529-3fa9-b922-670c7f1ac608",
                                        "glosses": [
                                            "Puissance absolue et illimitée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13933a98-8f65-4598-988f-a809b648c12c",
                                                "sense_id": "10a2f8a4-6068-3744-bd53-c1559a58d5b3",
                                                "text": "Il sait, fit-elle d’une voix ferme, qu’il ne peut atteindre au bonheur de l’amour que lorsque je lui aurai donné la toute-puissance de la royauté ; à ce moment-là seulement, Concino me tuera."
                                            },
                                            {
                                                "example_id": "a8025ad0-b8b2-47c4-a6cd-b0e119554943",
                                                "sense_id": "10a2f8a4-6068-3744-bd53-c1559a58d5b3",
                                                "text": "M. de Chemillé, vieux libertin, vous dirait que, dans le cas qui nous a retenus, il n'y a aucune intervention surhumaine, mais la manifestation de la toute-puissance de l'Amour, qui règne sur l'univers immense."
                                            },
                                            {
                                                "example_id": "e3b25162-8403-4cc1-86d2-35bbf10885a4",
                                                "sense_id": "10a2f8a4-6068-3744-bd53-c1559a58d5b3",
                                                "text": "Ce moment particulier de toute-puissance des médias s’est refermé. Aujourd’hui, le prétendu premier pouvoir est mal en point."
                                            },
                                            {
                                                "example_id": "5af9daf6-c9e6-4e77-a861-a02e845a4d36",
                                                "sense_id": "10a2f8a4-6068-3744-bd53-c1559a58d5b3",
                                                "text": "Le mythe de la toute-puissance paternelle joue un rôle fondamental dans la constitution de l'identité masculine."
                                            },
                                            {
                                                "example_id": "078a4497-0661-42f8-9261-7f9835b4cfc3",
                                                "sense_id": "10a2f8a4-6068-3744-bd53-c1559a58d5b3",
                                                "text": "Ikarus l’admet : provoquer la mort lui donne un sentiment de toute-puissance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df9c8ed0-5ec4-3ce4-a605-6828f5cee191",
                                        "entry_id": "6b09eed9-a529-3fa9-b922-670c7f1ac608",
                                        "glosses": [
                                            "Celui qui a une puissance absolue et illimitée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcede403-9a54-4da3-8a43-176c1945c5ad",
                                                "sense_id": "df9c8ed0-5ec4-3ce4-a605-6828f5cee191",
                                                "text": "Saccard avait remarqué que la jolie madame Michelin, qui se glissait si humblement par les portes entrebâillées, était une toute-puissance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
