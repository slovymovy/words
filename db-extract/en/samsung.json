                "senses": [
                    {
                        "sense_id": "9db840e0-866f-38aa-b624-6a37ea49f194",
                        "entry_id": "95cfc209-528a-31c4-9c75-af51055a4bb5",
                        "glosses": [
                            "A South Korean conglomerate company which manufactures electronics and ships."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1efb203-a48e-42f9-bb8b-f6e7678494c9",
                                "sense_id": "9db840e0-866f-38aa-b624-6a37ea49f194",
                                "text": "[Some of] them, potentially, are the Sonys and Samsungs of tomorrow. Some companies try to lure customers to their booths with food: a soft ice cream machine maker plies passersby with free cones, a wine fountain maker touts cups of sour red."
                            },
                            {
                                "example_id": "176b9495-aab4-4034-beb1-aa8b3fd59fea",
                                "sense_id": "9db840e0-866f-38aa-b624-6a37ea49f194",
                                "text": "Now they are required to be profitable and may find that North Korea is not worth the risk. Perhaps North Korea will need to found its own Hyundais and Samsungs and hire South Koreans as executives and consultants."
                            },
                            {
                                "example_id": "f4550dcb-fc97-4e50-b53d-7fa7dfcdb3a1",
                                "sense_id": "9db840e0-866f-38aa-b624-6a37ea49f194",
                                "text": "But without its own respected brands, its Toyotas and Samsungs, China will always languish at the lower end of the value chain."
                            },
                            {
                                "example_id": "edab54c1-4b70-403d-9c32-902abbe00ce6",
                                "sense_id": "9db840e0-866f-38aa-b624-6a37ea49f194",
                                "text": "The Sonys, Sanyos, and Samsungs of the world — not to mention Chinese upstarts — all have access to the same huge pool of chips, liquid crystal displays, audio pickups, power supplies, and packaging."
                            }
                        ]
                    }
                ],
