                        "cross_references": [
                            {
                                "target_word": "épirote",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2bb39e46-8647-3931-95d1-7bc7a62332ff",
                                        "entry_id": "3b76edb5-db10-3fe1-bfae-31c0ad468846",
                                        "glosses": [
                                            "Relatif à l’Épire, en Grèce, ou à ses habitants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f608a005-04c6-49da-8c37-92d83fa4dabc",
                                                "sense_id": "2bb39e46-8647-3931-95d1-7bc7a62332ff",
                                                "text": "Un élément est sûr : en s’embarquant pour l’Épire, Pyrrhos laisse une garnison à Tarente et son fils Hélénos et si celui-ci est ensuite rappelé par son père, la garnison épirote dirigée par Milon protège Tarente jusqu’à la mort de Pyrrhos (272)."
                                            },
                                            {
                                                "example_id": "ba8bb162-f30b-4608-bfd4-f828f99c96e5",
                                                "sense_id": "2bb39e46-8647-3931-95d1-7bc7a62332ff",
                                                "text": "Quant à sa toilette c’était celle des femmes d’Epirote c’est à dire un caleçon de satin blanc broché de fleurs roses et qui laissait à découvert deux pieds d’enfant qu’on eut crus de marbre de Paros…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "épirote",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1894ae25-3751-3cc3-9dd4-2c0e809793b5",
                                        "entry_id": "3cb5bac7-0903-3c02-b9cb-ec82264af29a",
                                        "glosses": [
                                            "Dialecte grec parlé en Épire."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7651a52c-2124-4511-8c3e-a9d1e4c37e66",
                                                "sense_id": "1894ae25-3751-3cc3-9dd4-2c0e809793b5",
                                                "text": "Kakosouli était le village principal de cette confédération [de clans montagnards] : « kako » signifie « mauvais » mais il prend le sens de « fort, solide, sérieux » en épirote."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
