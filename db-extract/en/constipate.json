                                        "examples": [
                                            {
                                                "example_id": "984c8093-58c7-4caa-9b16-0ef735065cf4",
                                                "sense_id": "db0a3453-5e9a-3efc-a866-4f7e0cca647f",
                                                "text": "In der Konsequenz überbieten sich die Reiseanbieter damit, jede Europareise mit Highlights zu überfüllen."
                                            },
                                            {
                                                "example_id": "7bad186b-fe0a-4b5e-8df5-eeac212f97f1",
                                                "sense_id": "db0a3453-5e9a-3efc-a866-4f7e0cca647f",
                                                "text": "Ausnahmezustand im Norden – Touristen überfüllen die Strände an den deutschen Küsten."
                                            },
                                            {
                                                "example_id": "1063473e-c0a5-4816-99c5-76dd8ed2b20b",
                                                "sense_id": "db0a3453-5e9a-3efc-a866-4f7e0cca647f",
                                                "text": "Jeder Dritte (32,8 Prozent) regt sich darüber auf, dass seine Mitmenschen am Hotelbüffet die Teller habgierig bis zum Rand überfüllen und dann doch nicht aufessen."
                                            },
                                            {
                                                "example_id": "b0af551f-874b-4ce1-a865-5d2127d43c63",
                                                "sense_id": "db0a3453-5e9a-3efc-a866-4f7e0cca647f",
                                                "text": "Einige wenige Objekte, die den jeweiligen Raum nicht überfüllen, lassen Ihnen genügend Raum, die einzelnen Gestaltungselemente bewusst zu genießen."
                                            }
                                        ],
