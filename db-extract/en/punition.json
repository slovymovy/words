                        "examples": [
                            {
                                "example_id": "6c26f7ad-0021-431e-b885-c5f4177b0e59",
                                "sense_id": "19f10574-2907-3e92-b157-bc6831efd51d",
                                "text": "Yee judges vpon earth, let our iuste punitions\nTeach you to shake off bribes, and kepe your handes pure."
                            },
                            {
                                "example_id": "486e6f7e-a4c2-4da7-a328-3b0535b98e24",
                                "sense_id": "19f10574-2907-3e92-b157-bc6831efd51d",
                                "text": "The corrections of the scholars consist of penitences and punitions; the former are, keeping a boy standing, or on his knees, or in an ignominious place; the latter are pensums (i. e. impositions), or, rarely, the use of a leather thong on the hand."
                            }
                        ]
                    }
