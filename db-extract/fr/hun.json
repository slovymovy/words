            {
                "entry_id": "2417381c-5253-3e26-815a-27bf6b2e8aa3",
                "word": "Hun",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "83716370-8f31-480d-be82-69c10228e005",
                        "entry_id": "2417381c-5253-3e26-815a-27bf6b2e8aa3",
                        "tags": [
                            "plural"
                        ],
                        "form": "Huns"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d98bb3bd-69da-3a20-aaeb-6726784d643c",
                        "entry_id": "2417381c-5253-3e26-815a-27bf6b2e8aa3",
                        "glosses": [
                            "Personne du peuple nomade originaire de l’Eurasie centrale dont la présence en Europe est attestée à partir du IVᵉ siècle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea93e26f-de9b-4674-b4f2-7fa0a20f0890",
                                "sense_id": "d98bb3bd-69da-3a20-aaeb-6726784d643c",
                                "text": "La chanson « Attila le Hun » de Hervé Christiani m’a inspiré la nouvelle éponyme."
                            },
                            {
                                "example_id": "0351e198-36fa-41a3-b5f8-5b195a62917e",
                                "sense_id": "d98bb3bd-69da-3a20-aaeb-6726784d643c",
                                "text": "Ils étaient toujours plus nombreux, comme si tout Rome s’était rassemblé dans le parc pour voir le Hun enfermé dans la cage."
                            },
                            {
                                "example_id": "dc960ac2-3ae1-48f9-ae34-f751aadc5b80",
                                "sense_id": "d98bb3bd-69da-3a20-aaeb-6726784d643c",
                                "text": "Bientôt les Huns apparurent sur la rive droite, et, le même jour, on vit l’incendie s’allumer sur tout l’horizon, c’est-à-dire depuis Colonia Agrippina, jusqu’à Aliso."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95c8824e-87ae-43b4-a366-908cbe250130",
                        "source_entry_id": "2417381c-5253-3e26-815a-27bf6b2e8aa3",
                        "source_sense_id": "d98bb3bd-69da-3a20-aaeb-6726784d643c",
                        "target_lang_word": "Hunne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hunne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "189627ae-c004-336a-b3e2-8d15896a081f",
                                        "entry_id": "3f5aa939-93b6-3384-97c0-9eed342ae071",
                                        "glosses": [
                                            "Angehöriger eines Reitervolkes der Völkerwanderungszeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e89fbbc7-f09c-40d7-8aef-334ec79f8bdf",
                                                "sense_id": "189627ae-c004-336a-b3e2-8d15896a081f",
                                                "text": "Unter ihrem König Attila eroberten die Hunnen weite Teile Europas."
                                            },
                                            {
                                                "example_id": "a0d2af33-703a-4d99-b565-662e6647df65",
                                                "sense_id": "189627ae-c004-336a-b3e2-8d15896a081f",
                                                "text": "„Die größte Unruhe entstand jedoch um die Mitte des 5. Jahrhunderts, als die Hunnen in Westeuropa erschienen.“"
                                            },
                                            {
                                                "example_id": "149a2560-79b6-41ab-9abb-6ece7637669b",
                                                "sense_id": "189627ae-c004-336a-b3e2-8d15896a081f",
                                                "text": "„Als »Hunnen« bezeichneten die antiken Autoren wahllos alle, die sie nicht kannten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
