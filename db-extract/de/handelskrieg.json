                "senses": [
                    {
                        "sense_id": "63194756-9ccc-379a-bcc0-710274358ac3",
                        "entry_id": "a2cff980-8488-3ef5-9539-7090755d0eff",
                        "glosses": [
                            "zwischenstaatliche Auseinandersetzung, um die Wirtschaft des jeweils anderen zu schwächen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48a0b2f4-2bea-4b9c-8efe-1e8b7dc8ce39",
                                "sense_id": "63194756-9ccc-379a-bcc0-710274358ac3",
                                "text": "Zur Zeit herrscht ein partieller Handelskrieg zwischen Russland und dem Westen."
                            },
                            {
                                "example_id": "ab6b2535-7cea-4bc7-8d24-1f5d94a0063f",
                                "sense_id": "63194756-9ccc-379a-bcc0-710274358ac3",
                                "text": "[Paul Krugmann, Professor für Volkswirtschaftslehre an der Princeton University:] „»[…] In der EU laufen viele Dinge falsch, aber die Kommission weiß immerhin, wie man Handelskriege [Anmerkung: gegen die USA] führt. Das würde sehr schnell sehr hässlich werden.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "acb7f424-9c1a-34d0-87b8-d952f898c78b",
                        "entry_id": "a2cff980-8488-3ef5-9539-7090755d0eff",
                        "glosses": [
                            "Kriegführung gegen die Wirtschaftskraft des Kriegsgegners"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26b1b383-c60a-46e1-8ba0-ab28058c0eaa",
                                "sense_id": "acb7f424-9c1a-34d0-87b8-d952f898c78b",
                                "text": "„Daraufhin wurde ein Handelskrieg mit 21 Ubooten begonnen, von denen 14 westlich der Britischen Inseln operierten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
