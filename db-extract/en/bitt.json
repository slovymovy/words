                                        "entry_id": "358a916b-c3ef-3875-b3fe-84f8dce7f862",
                                        "glosses": [
                                            "морск. отлитая вместе с основанием па́рная металлическая тумба, служащая для закрепления тросов при швартовке"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
