                        "sense_id": "4d2fa085-0560-339e-b686-fad2acd53f9a",
                        "entry_id": "ba12102c-3a34-3f30-a180-ca2da5fb5104",
                        "glosses": [
                            "narząd płciowy męski wewnętrzny, przylegający od góry do jądra"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f1617b6-ff7b-49ce-9ec3-82cf2fbf6e7d",
                                "sense_id": "4d2fa085-0560-339e-b686-fad2acd53f9a",
                                "text": "Oprócz magazynowania plemników najądrze również produkuje wydzielinę o kwaśnym odczynie, która powoduje ich dojrzewanie i unieruchomienie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95c00429-4c13-41e0-b21d-010832868a13",
                        "source_entry_id": "ba12102c-3a34-3f30-a180-ca2da5fb5104",
                        "source_sense_id": "4d2fa085-0560-339e-b686-fad2acd53f9a",
                        "target_lang_word": "epididymis",
