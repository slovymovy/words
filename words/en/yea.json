{
    "word_family": [
        "yea-sayer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fe9a1c86-42e6-3e97-a095-30a217967caf",
                    "sense_definition": "An affirmative vote, or a person who casts such a vote.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "voting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee chairman asked for the <w>yeas</w> and nays to be counted.",
                            "target_lang_translations": {
                                "ru": "Председатель комитета попросил подсчитать голоса <w>за</w> и против.",
                                "zh": "委员会主席要求清点<w>赞成票</w>和反对票。"
                            }
                        },
                        {
                            "text": "With fifty <w>yeas</w> and only ten nays, the motion passed easily.",
                            "target_lang_translations": {
                                "ru": "С пятьюдесятью голосами <w>за</w> и лишь десятью против, предложение было легко принято.",
                                "zh": "有五十张<w>赞成票</w>而反对票仅十张，该动议轻松通过。"
                            }
                        }
                    ],
                    "antonyms": [
                        "nay"
                    ],
                    "common_phrases": [
                        "yeas and nays"
                    ],
                    "target_lang_definitions": {
                        "ru": "Голос в поддержку предложения или человек, голосующий «за».",
                        "zh": "投票时的赞成票，或投赞成票的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "голос за",
                                "target_lang_sense_clarification": "при голосовании"
                            },
                            {
                                "target_lang_word": "да",
                                "target_lang_sense_clarification": "утвердительный ответ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "赞成票",
                                "target_lang_sense_clarification": "投票时的支持票"
                            },
                            {
                                "target_lang_word": "赞成者",
                                "target_lang_sense_clarification": "投赞成票的人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "f36c02bd-cf72-36f1-b52f-d5a6119950cc",
                    "sense_definition": "To this extent or degree; used to indicate size or height, usually accompanied by a hand gesture.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The grass in the overgrown field was about <w>yea</w> high.",
                            "target_lang_translations": {
                                "ru": "Трава на заросшем поле была примерно <w>вот такой</w> высоты.",
                                "zh": "荒地里的草长得大约有<w>这么</w>高。"
                            }
                        },
                        {
                            "text": "I remember him when he was just a small boy, only <w>yea</w> tall.",
                            "target_lang_translations": {
                                "ru": "Я помню его, когда он был еще маленьким мальчиком, всего лишь <w>вот такого</w> роста.",
                                "zh": "我记得他还是个小男孩的时候，只有<w>这么</w>高。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "yea high",
                        "yea big"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вот настолько; используется для указания размера или высоты, обычно сопровождается жестом руки.",
                        "zh": "达到某种程度或大小；通常伴随手势来表示高度或尺寸。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вот так",
                                "target_lang_sense_clarification": "указание размера жестом"
                            },
                            {
                                "target_lang_word": "вот столько",
                                "target_lang_sense_clarification": "о количестве или размере"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "这么",
                                "target_lang_sense_clarification": "表示程度或大小"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d5aca17-badf-33a3-8770-ded07259183e",
                    "sense_definition": "Yes; indeed; truly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "affirmation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I shall do it, <w>yea</w>, and I will do it with all my heart.",
                            "target_lang_translations": {
                                "ru": "Я сделаю это, <w>да</w>, и сделаю это от всего сердца.",
                                "zh": "我会去做，<w>诚然</w>，我会全心全意地去做。"
                            }
                        },
                        {
                            "text": "Let your answer be <w>yea</w> or nay, without equivocation.",
                            "target_lang_translations": {
                                "ru": "Пусть ваш ответ будет <w>да</w> или нет, без увиливаний.",
                                "zh": "你的回答应该是“是”或“否”，不要含糊其辞。"
                            }
                        }
                    ],
                    "synonyms": [
                        "yes",
                        "aye",
                        "yep",
                        "yup"
                    ],
                    "antonyms": [
                        "nay",
                        "no"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "common in biblical or very formal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Да; действительно; истинно (устаревшее или библейское).",
                        "zh": "是的；确实；诚然（古语或庄重语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "да",
                                "target_lang_sense_clarification": "торжественное утверждение"
                            },
                            {
                                "target_lang_word": "воистину",
                                "target_lang_sense_clarification": "устаревшее"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "诚然",
                                "target_lang_sense_clarification": "庄重的肯定"
                            },
                            {
                                "target_lang_word": "确实",
                                "target_lang_sense_clarification": "强调真实性"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "5e304b63-75fe-34da-9961-9c28bfd7f8c2",
                    "sense_definition": "An informal spelling of the word 'yeah', used to express agreement.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "affirmation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Yea</w>, I think I can make it to the party tonight.",
                            "target_lang_translations": {
                                "ru": "<w>Да</w>, думаю, я смогу прийти на вечеринку сегодня вечером.",
                                "zh": "<w>对</w>，我想我今晚能去参加聚会。"
                            }
                        },
                        {
                            "text": "Oh <w>yea</w>, that sounds like a great idea.",
                            "target_lang_translations": {
                                "ru": "О <w>да</w>, это звучит как отличная идея.",
                                "zh": "哦<w>对</w>，那听起来是个好主意。"
                            }
                        }
                    ],
                    "synonyms": [
                        "yeah",
                        "yep",
                        "yes",
                        "yup"
                    ],
                    "antonyms": [
                        "no"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "alternative spelling of yeah"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in text messaging"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неформальный вариант написания слова 'yeah', выражающий согласие.",
                        "zh": "yeah 的非正式拼写，用于表示同意。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "да",
                                "target_lang_sense_clarification": "согласие"
                            },
                            {
                                "target_lang_word": "ага",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "对",
                                "target_lang_sense_clarification": "表示同意"
                            },
                            {
                                "target_lang_word": "嗯",
                                "target_lang_sense_clarification": "口语化的应答"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "5935c107-6d00-3743-ac78-c84196dac279",
                    "sense_definition": "Not only this, but also; used to introduce a stronger or more explicit statement.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "conjunction_emphasis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a good man, <w>yea</w>, a saint among us.",
                            "target_lang_translations": {
                                "ru": "Он хороший человек, <w>более того</w>, святой среди нас.",
                                "zh": "他是个好人，<w>甚至</w>可以说是我们当中的圣人。"
                            }
                        },
                        {
                            "text": "We are friends, <w>yea</w>, we are more like brothers.",
                            "target_lang_translations": {
                                "ru": "Мы друзья, <w>даже</w> больше, мы как братья.",
                                "zh": "我们是朋友，<w>更确切地说</w>，我们更像是兄弟。"
                            }
                        }
                    ],
                    "synonyms": [
                        "yes"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        },
                        {
                            "trait_type": "dated",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Не только это, но и; используется для усиления или уточнения утверждения.",
                        "zh": "不仅如此，而且；用于引出更强或更明确的陈述。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "более того",
                                "target_lang_sense_clarification": "вводное слово"
                            },
                            {
                                "target_lang_word": "даже",
                                "target_lang_sense_clarification": "усиление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "甚至",
                                "target_lang_sense_clarification": "表示递进"
                            },
                            {
                                "target_lang_word": "更确切地说",
                                "target_lang_sense_clarification": "用于进一步说明"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}