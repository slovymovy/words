                                        "sense_id": "a459697f-a272-3f3f-bb13-1543d8d9dca5",
                                        "entry_id": "0be8080e-62c6-3095-be20-e8e1355fabe7",
                                        "glosses": [
                                            "To finish in the top three at an event or competition."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cced292f-99a9-4f86-90e0-98787dfc4b21",
                                                "sense_id": "a459697f-a272-3f3f-bb13-1543d8d9dca5",
                                                "text": "The swimmer podiumed three times at the Olympics."
                                            },
                                            {
                                                "example_id": "4561259b-6f6e-48f2-8eb8-5f59de6efcca",
                                                "sense_id": "a459697f-a272-3f3f-bb13-1543d8d9dca5",
                                                "text": "Vocab-wise, medalling and PB-ing are now totally part-and-parcelled, and most experts in South Korea believe podiumed, finalled and all-comered are not far off lexiconing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84a88445-f261-4289-984d-e1c86ca5bf64",
                        "source_entry_id": "c57c0b03-101e-34f2-82e1-207fa3391c69",
                        "source_sense_id": "250e0959-f2aa-36f2-96fb-b8b38fae3cd8",
