                "senses": [
                    {
                        "sense_id": "74ec264a-f8d2-3518-8669-c82686189b44",
                        "entry_id": "fda1e93e-8cba-3a98-9b64-7966af0677fb",
                        "glosses": [
                            "To tackle (a player) using a shoestring tackle (“one made near the ground, close to a player's shoes”)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6f6cbe02-0476-379d-b068-29e71288c871",
                        "entry_id": "fda1e93e-8cba-3a98-9b64-7966af0677fb",
                        "glosses": [
                            "To catch (a ball) using a shoestring catch (“one made near the ground, close to a player's shoes”)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4153f8f9-8e3a-4e4c-a0b8-4578755ddf7f",
                                "sense_id": "6f6cbe02-0476-379d-b068-29e71288c871",
                                "text": "We didn't score in our half of the eighth, but it was only because Ernie's line drive was shoestringed by the Giant left fielder, with Rusty Howarth on second."
                            },
                            {
                                "example_id": "567aaf88-4500-48b2-a3e8-89d1ecb1bf9c",
                                "sense_id": "6f6cbe02-0476-379d-b068-29e71288c871",
                                "text": "Most outfielders say that short-hopping a ball so that it looks as if it was caught is more an accident than an art form, but Coach Joe Nossek of the Indians actually tells his charges to hold up the ball after shoestringing it on the off chance that the umpire might be fooled."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
