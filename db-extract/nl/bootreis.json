                            {
                                "example_id": "2eb34e69-d1e6-4522-b8de-c403951d13d7",
                                "sense_id": "2fa1726a-7e93-3186-a1db-bd67e1058be1",
                                "text": "Vroeger maakte je een bootreis van vele weken naar Indonesië, terwijl je tegenwoordig er binnen een dag bent met een vliegtuig."
                            }
