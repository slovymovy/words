                ],
                "senses": [
                    {
                        "sense_id": "8e2bb41e-e513-3204-99d6-ca6764b3351a",
                        "entry_id": "8dc498e1-9012-38c8-8ebe-2103a9865370",
                        "glosses": [
                            "To predict a future event; to hint at something that will happen (especially as a literary device)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a28ff6f2-5b11-4e67-8794-225168ad1815",
                                "sense_id": "8e2bb41e-e513-3204-99d6-ca6764b3351a",
                                "text": "There can be, if I forebode aright, no power, short of the Divine mercy, to disclose, whether by uttered words, or by type or emblem, the secrets that may be buried with a human heart."
                            }
                        ]
                    },
                    {
                        "sense_id": "b98cd8bf-2b5d-39ab-b43d-ab0fdc9809e0",
                        "entry_id": "8dc498e1-9012-38c8-8ebe-2103a9865370",
                        "glosses": [
                            "To be prescient of (some ill or misfortune); to have an inward conviction of, as of a calamity which is about to happen; to augur despondingly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "631e452d-68f8-4b1c-ad08-0260a4276a90",
                                "sense_id": "b98cd8bf-2b5d-39ab-b43d-ab0fdc9809e0",
                                "text": "Sullen, desponding, and foreboding nothing but wars and desolation, as the certain consequence of Caesar's death."
                            },
                            {
                                "example_id": "40d95d6e-d105-445c-a59a-62b50f2dc8cc",
                                "sense_id": "b98cd8bf-2b5d-39ab-b43d-ab0fdc9809e0",
                                "text": "Here sits he shaping wings to fly: / His heart forebodes a mystery: / He names the name Eternity."
                            },
                            {
                                "example_id": "46a0aac9-da56-484a-930e-693a44e3e33c",
                                "sense_id": "b98cd8bf-2b5d-39ab-b43d-ab0fdc9809e0",
                                "text": "Walter was disturbed by a low rap at the door. It was so indistinct and hesitating, that, at first, he thought himself mistaken; a second summons, however, led him to rise and open to his visitor. It was the very person that he foreboded—Mr. Curl."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "627f6658-db96-4f73-b346-4fc70227e66e",
                        "source_entry_id": "8dc498e1-9012-38c8-8ebe-2103a9865370",
                        "source_sense_description": "to predict a future event; to hint at something that will happen (especially as a literary device)",
                        "target_lang_word": "voraussehen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voraussehen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "76680306-fc43-3035-9cae-842fc8bbc01f",
                                        "entry_id": "8317a96e-1eb7-3f54-81f8-c8211bb710a7",
                                        "glosses": [
                                            "ein Ereignis in der Zukunft bereits vorher ahnen / erkennen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc38d875-4bc3-46bd-8d3b-c50a8aa996aa",
                                                "sense_id": "76680306-fc43-3035-9cae-842fc8bbc01f",
                                                "text": "Der Klimawandel lässt sich nicht mehr voraussehen, denn wir sind bereits mitten drin."
                                            },
                                            {
                                                "example_id": "ff81a6c1-570b-414d-bc24-4debe0d66a1b",
                                                "sense_id": "76680306-fc43-3035-9cae-842fc8bbc01f",
                                                "text": "Wenn ich heute Abend nach Hause komme, sehe ich jetzt schon voraus, wie meine Frau mit dem Nudelholz hinter der Tür steht."
                                            },
                                            {
                                                "example_id": "4ed13914-3739-4101-92eb-da7e7e5d94c4",
                                                "sense_id": "76680306-fc43-3035-9cae-842fc8bbc01f",
                                                "text": "Kann man voraussehen, wer eine Krankheit, Krebs, Demenz, usw., bekommt?"
                                            },
                                            {
                                                "example_id": "f15174aa-f3bc-407a-ad14-5eb49242f2d2",
                                                "sense_id": "76680306-fc43-3035-9cae-842fc8bbc01f",
                                                "text": "Wer konnte denn voraussehen, dass der Dow Jones 10%-Punkte fällt."
                                            },
                                            {
                                                "example_id": "a3d6a4a9-a388-4180-b33f-11177910b5d0",
                                                "sense_id": "76680306-fc43-3035-9cae-842fc8bbc01f",
                                                "text": "Den Fall der Berliner Mauer hat niemand vorausgesehen."
                                            },
                                            {
                                                "example_id": "4e073756-4603-49fc-a03f-6b4014636a21",
                                                "sense_id": "76680306-fc43-3035-9cae-842fc8bbc01f",
                                                "text": "[Der Autor Kurt] Tucholsky gehörte damit zu den Ersten, die das Scheitern der Republik und das Aufkommen der Nazis vorausahnten: \"Es ist erstaunlich, in welcher Präzision er schon damals die Szenarien vorausgesehen hat, die sich dann tatsächlich auch abgespielt haben\", sagt [Tucholsky-Biograf Rolf] Hosfeld […]"
                                            },
                                            {
                                                "example_id": "a91931f1-f31a-4700-a6f5-af444af49a16",
                                                "sense_id": "76680306-fc43-3035-9cae-842fc8bbc01f",
                                                "text": "„'Niemand, den ich kenne, hat ein Amerika vorausgesehen wie das, in dem wir heute leben', sagte er [der 85-jährige Autor Philip Roth] in dem per E-Mail geführten Interview.“"
                                            },
                                            {
                                                "example_id": "40922a1c-d68e-482c-b2c4-a90c2e20c596",
                                                "sense_id": "76680306-fc43-3035-9cae-842fc8bbc01f",
                                                "text": "„Aber dafür sah man immerhin die Erfindung des Handys voraus. 'Die Bürger der drahtlosen Zeit werden überall mit ihrem ‚Empfänger‘ herumgehen', lese ich in »Die Welt in 100 Jahren«, 'einerlei, wo er auch sein wird, er wird bloß den ‚Stimm-Zeiger‘ auf die betreffende Nummer einzustellen brauchen, die er zu sprechen wünscht, und der Gerufene wird sofort seinen Hörer vibrieren oder das Signal geben können, wobei es in seinem Belieben stehen wird, ob er hören oder die Verbindung abbrechen will.'“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e49f8a83-fc1d-46ab-bb8d-5ba7a1d89c09",
                        "source_entry_id": "8dc498e1-9012-38c8-8ebe-2103a9865370",
