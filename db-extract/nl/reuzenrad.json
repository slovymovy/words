                    {
                        "sense_id": "b4148f3d-9bca-3492-ba7a-f386402ee456",
                        "entry_id": "22d5cd8c-3177-32be-8ec2-c0be884118fe",
                        "glosses": [
                            "kermisattractie met zitplaatsen die gelijkmatig rondom aan een huizenhoog wiel hangen dat draait om een horizontale as"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c92092ee-b7f8-48f5-bde9-0797d080da06",
                                "sense_id": "b4148f3d-9bca-3492-ba7a-f386402ee456",
                                "text": "Dirk Hut, van oorsprong Groninger, stond beneden op het platform en kon het zwiepende gevaarte maar nét ontwijken. Daarbij kwam hij hard tussen afgebroken onderdelen van het reuzenrad terecht."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bfb4ffe3-2bd2-4755-a528-82571328beae",
                        "source_entry_id": "22d5cd8c-3177-32be-8ec2-c0be884118fe",
                        "source_sense_id": "b4148f3d-9bca-3492-ba7a-f386402ee456",
                        "source_sense_description": "kermisattractie",
                        "target_lang_word": "Riesenrad",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Riesenrad",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7302b232-c19c-3850-8304-a567183eba03",
                                        "entry_id": "bbb9bc5b-064e-3652-9c24-e3e30fdebd07",
                                        "glosses": [
                                            "radförmiges Fahrgeschäft, welches Mitfahrende an seinem Umfang auf eine Position mit guter Aussicht hebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f0baecd-2f9b-4ae4-ba0a-04056e1a8413",
                                                "sense_id": "7302b232-c19c-3850-8304-a567183eba03",
                                                "text": "Ich liebe es mit dem Riesenrad zu fahren."
                                            },
                                            {
                                                "example_id": "c777f5e7-3625-485e-9ae0-7ad6971f148c",
                                                "sense_id": "7302b232-c19c-3850-8304-a567183eba03",
                                                "text": "„Als ich das Riesenrad vor mir aufragen sah, wurde mir klar, dass genauso wie sich das Riesenrad drehte, so ging auch unser Leben weiter, mit kleinen Stopps, ehe es nicht mehr weiter ging.“"
                                            },
                                            {
                                                "example_id": "e44c3a6d-5867-4c47-9806-b3e97f8f9068",
                                                "sense_id": "7302b232-c19c-3850-8304-a567183eba03",
                                                "text": "„Das Riesenrad kreiste über dem Mittelweg, eine Windmühle aus Licht, rundherum, rundherum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
