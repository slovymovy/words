                        ],
                        "examples": [
                            {
                                "example_id": "1e6ec8c6-0ee1-4466-8844-52777bc7d4b6",
                                "sense_id": "11a7e44d-c887-3c41-94f7-712b6fe1808b",
                                "text": "Wichtige Pflichtfiguren sind die Bogenachter, die Dreier und Gegendreier, die Schlangenbogenachter (hierbei läuft man auf einem Bein eineinhalb Kreise), die Wenden und die Gegenwenden."
                            },
                            {
                                "example_id": "7900bf80-3534-4567-a0b5-29b368b8e86a",
                                "sense_id": "11a7e44d-c887-3c41-94f7-712b6fe1808b",
                                "text": "„Gegenwende und Wende dagegen werden auf der gleichen Kante gelaufen, wobei die Wendung bei der Wende im Sinne der Dreierwendung, die bei der Gegenwende im Sinne der Gegendreierwendung geschieht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
